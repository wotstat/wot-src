msgid "systemError/closeBtn"
msgstr "Закрыть"

msgid "systemError/failLoadingRecources"
msgstr "Произошла ошибка при загрузке ресурсов. Проверка целостности данных запустится автоматически после закрытия этого окна.\nПодробнее: https://lesta.ru/support/ru/products/mt/article/15285/"

msgid "systemError/failLoadingResourceWithMods"
msgstr "Произошла ошибка при загрузке ресурсов. Возможна несовместимость с одним из установленных модов. Работа клиента будет завершена.\nРешение: запустите игру в безопасном режиме без модификаций или очистите папку с модами."

msgid "systemError/gameTitle"
msgstr "Мир танков"

msgid "systemError/outOfMemory"
msgstr "Произошла ошибка при выделении виртуальной памяти для процесса.\nРешение: необходимо использовать 64-битную версию Windows.\nПодробнее: https://lesta.ru/support/ru/products/mt/article/15260/"

msgid "systemError/outOfMemoryWin64"
msgstr "Произошла ошибка при выделении памяти для процесса.\nРешение: необходимо включить файл подкачки или увеличить его размер.\nПодробнее: https://lesta.ru/support/ru/products/mt/article/15190/"

msgid "systemError/restartBtn"
msgstr "Перезапуск игры"

msgid "systemError/text"
msgstr "Произошла ошибка, связанная с работой видеокарты.\nОбычно она возникает из-за сбоя видеодрайвера; попробуйте обновить драйверы,\nпроверьте настройки видеокарты или перезапустите игру."

msgid "systemError/title"
msgstr "Ошибка"
