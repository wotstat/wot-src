msgid "portal_intro/phrase_1"
msgstr "Двенадцать экспедиций..."

msgid "portal_intro/phrase_2"
msgstr "И все они доказали лишь одно..."

msgid "portal_intro/phrase_3"
msgstr "Нас ждёт катастрофа."

msgid "portal_intro/phrase_4"
msgstr "Никто не знает о потенциале Разлома больше, чем я."

msgid "portal_intro/phrase_5"
msgstr "И я говорю, он должен быть закрыт."

msgid "portal_intro/phrase_6"
msgstr "Вся надежда — на вас."
