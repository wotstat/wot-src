msgstr "?empty?"

msgid "portal/title"
msgstr "Разлом"

msgid "portal/tooltip/body"
msgstr "Событие продлится:\nс %(start)s по %(end)s."

msgid "reward/portal_medal/description"
msgstr "Тому, кто прошёл все круги преисподней и одолел последнего врага. Выдаётся за\nпобеду над Ратте на последнем уровне Разлома."

msgid "reward/portal_medal/name"
msgstr "Укрощая Ратте"

msgid "reward/portal_style/description"
msgstr "Тому, кто шаг за шагом шёл к цели, не позволяя испытаниям погасить огонь в своём сердце. Выдаётся за усиление всех машин до предела."

msgid "reward/portal_style/name"
msgstr "Неугасимый"
