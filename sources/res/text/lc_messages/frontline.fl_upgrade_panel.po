msgid "alert"
msgstr "You cannot choose a Combat Reserve during active fighting."

msgid "description/one/reserve"
msgstr "Repeatedly choosing the %(reserve_name)s Reserve\nwill improve its characteristics."

msgid "description/second/reserve"
msgstr "Repeatedly choosing the %(first_reserve_name)s or %(second_reserve_name)s Reserve\nwill improve the characteristics of the one selected."

msgid "number_1"
msgstr "1st"

msgid "number_2"
msgstr "2nd"

msgid "number_3"
msgstr "3rd"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Deploys an active minefield in the selected area for a certain period of time."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Causes considerable damage to enemy vehicles within a small radius."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Stuns enemy vehicles and causes medium damage within a large radius."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Adds a bonus to the major qualification of the player's crew and allied crews."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Provides a bonus to capture speed, capture blocking, and resupply."

msgid "shortDescription/reserve/reconAbility"
msgstr "Spots enemy vehicles and minefields."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restores a certain percentage of your vehicle's hit points."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Conceals all vehicles inside and behind the smoke."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Provides a bonus to concealment and view range. Reduces the concealment of enemy vehicles."

msgid "title"
msgstr "The %(number_name)s Reserve Slot Available"
