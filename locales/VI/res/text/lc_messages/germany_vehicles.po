msgid "T-15_descr"
msgstr "Chiếc xe tăng hạng nhẹ thử nghiệm này được phát triển bởi nhà máy Škoda trong năm 1941-1943 với tổng cộng 5 nguyên mẫu được chế tạo. Chiếc xe này chưa từng được sản xuất hàng loạt và cũng không đi vào phục vụ."

msgid "T-15_long_special"
msgstr "Đây là một trong những xe trinh sát tốt nhất so với cấp của nó: Tốc độ di chuyển nhanh, cơ động, kích thước nhỏ gọn, tầm nhìn và tầm tín hiệu xa. Dù vậy, Pz. T 15 không có súng uy lực, vì thế chỉ nên tập trung vào nhiệm vụ do thám."

msgid "T-15_short"
msgstr "Pz. T 15"

msgid "T-15_short_special"
msgstr "Tầm nhìn và tầm tín hiệu xa, tốc độ di chuyển và cơ động tốt"

msgid "T-25"
