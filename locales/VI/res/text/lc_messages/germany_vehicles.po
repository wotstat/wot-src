msgid "PzIV_ausf43"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_ausf_F"
msgstr "Pz.Kpfw. III/IV Ausf. A"

msgid "PzIV_ausf_F_short"
msgstr "Pz.Kpfw. III/IV\nAusf. A"

