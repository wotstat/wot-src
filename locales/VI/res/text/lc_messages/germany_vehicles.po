msgid "PzIII_Ausf_A_short"
msgstr "Pz.Kpfw. III\nAusf. A"

msgid "PzIII_IV"
msgstr "Pz.Kpfw. III/IV"

msgid "PzIII_IV_descr"
msgstr "Một dự án xe mới với giáp nghiêng, dùng các bộ phận của Pz.Kpfw. III và Pz.Kpfw. IV được thông qua vào ngày 04/01/1944. Tháng 03/1944, một thỏa thuận cho 3 nguyên mẫu được ký kết, nhưng chương trình này đã bị ngừng lại vào ngày 12/07. Chỉ một pháo chống tăng sử dụng nền tảng tương tự đã đi vào giai đoạn sản xuất hàng loạt."

msgid "PzIII_IV_short"
msgstr "Pz. III/IV"

msgid "PzII_J"
msgstr "Pz.Kpfw. II Ausf. J"

msgid "PzII_J_descr"
msgstr "Xe tăng trinh sát gia cường giáp bảo vệ. Đây chính là kết quả của quá trình đẩy mạnh phát triển Pz.Kpfw. II. Tháng 10/1939, một lô tiền-sản-xuất được đặt hàng, và nguyên mẫu đầu tiên hoàn thành chế tạo vào tháng 07/1940. Từ năm 1943 đến 1944, Sư đoàn Thiết giáp (Panzer Division) Số 12 sử dụng 7 chiếc Pz.Kpfw. II Ausf. J tại Mặt trận Phía Đông. Có tổng cộng 22 xe tăng trên đã được sản xuất."

msgid "PzII_J_short"
msgstr "Pz. II J"

msgid "PzII_ausf_J"
msgstr "Pz.Kpfw. II Ausf. J"

msgid "PzIIturm_ausf_J"
