msgid "PzIV_Ausf_1940"
msgstr "Pz.Kpfw. IV Ausf. G"

msgid "PzIV_Hydro"
msgstr "Pz.Kpfw. IV hydrostat."

msgid "PzIV_Hydro_descr"
msgstr "Quá trình phát triển các xe tích hợp hệ thống dẫn động thủy tĩnh đặt phía sau được khởi động từ năm 1944 ở Đức. Khung gầm của Pz. IV Ausf. G được dùng cho các đợt thử nghiệm liên quan. Nguyên mẫu đầu tiên được chế tạo vào cuối tháng 10/1944. Chỉ một xe duy nhất được sản xuất."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

