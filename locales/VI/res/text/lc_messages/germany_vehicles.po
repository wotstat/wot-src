msgstr "Pz.Kpfw. III/IV Ausf. B"

msgid "PzIV_ausf_H_short"
msgstr "Pz.Kpfw. III/IV\nAusf. B"

msgid "PzIV_descr"
msgstr "Được chế tạo với số lượng lớn hơn bất kỳ chiếc tăng nào khác trong lực lượng Panzerwaffe. Xuất xưởng từ tháng 10/1937 đến tháng 03/1945, với tổng sản lượng 8519 chiếc tính cả các xe chỉ huy. Kể từ tháng 05/1942, mẫu tăng này được trang bị súng nòng dài."

msgid "PzIV_schmalturm"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_schmalturm_descr"
msgstr "Vào tháng 11/1944, công ty Krupp giới thiệu một số dự án tiên tiến nhằm nâng cấp vũ khí cho xe tăng và pháo chống tăng đang phục vụ biên chế lục quân. Trong số đó, có một dự án lắp đặt tháp pháo Schmalturm của Panther lên Pz IV Ausf. J. Tuy nhiên, nó đã bị hủy bỏ do sẽ làm quá tải hệ thống xích và quá trình sản xuất Pz IV bị ngừng lại."

msgid "PzIV_schmalturm_long_special"
msgstr "Sở hữu tháp pháo của xe Panther và hỏa lực mạnh, quân địch chắc chắn sẽ phải nể sợ. Đây là một chiếc tăng hỗ trợ tuyệt vời, sẵn sàng gây thiệt hại từ bất kỳ khoảng cách nào."

msgid "PzIV_schmalturm_short"
msgstr "Pz. IV S."

msgid "PzIV_schmalturm_short_special"
msgstr "Súng chính xác, xuyên tốt và tốc độ bắn nhanh"

msgid "PzIV_short"
msgstr "Pz. IV"

msgid "PzIVturm"
msgstr "Pz.Kpfw. V/IV"

msgid "PzI_ausf_C"
msgstr "Pz.Kpfw. I Ausf. C"

msgid "PzI_ausf_C_descr"
msgstr "Đơn đặt hàng đầu tiên dành cho chiếc tăng này xuất hiện vào năm 1939. Theo dự tính ban đầu, Pz.Kpfw. I Ausf. C sẽ đóng vai trò làm phương tiện trinh sát tốc độ cao cho các đơn vị không vận. Quá trình sản xuất hàng loạt bắt đầu vào đầu năm 1942. Đến đầu 1943, 2 chiếc Pz.Kpfw. I Ausf. C được triển khai với Sư đoàn Tăng Số 1. 38 chiếc tăng khác được triển khai cùng Tập đoàn Tăng Dự bị Số 58 vào mùa hè năm 1944."

msgid "PzI_ausf_C_short"
msgstr "Pz. I C"

msgid "PzI_descr"
msgstr "Pz. I Ausf. A là chiếc tăng sản xuất hàng loạt đầu tiên của Đức. Năm 1935, thiết kế của nó được cải tiến, bao gồm thân xe kéo dài và động cơ mạnh hơn—Pz. I Ausf. B. Tính cả số lượng chế tạo hàng loạt của mẫu Ausf. B, có tổng cộng 675 chiếc Pz. I đã xuất xưởng. Vũ khí tiêu chuẩn của chúng khá yếu, nhưng một số tăng đã được nâng cấp tại trận địa trong Nội Chiến Tây Ban Nha để có thể mang súng 20-mm."

msgid "PzI_short"
msgstr "Pz. I"

msgid "PzJgd_ketten_I"
msgstr "Panzerjäger I"

msgid "PzJgd_ketten_II"
msgstr "Panzerjäger I verstärkteketten"

msgid "PzV-IVketten"
msgstr "Pz.Kpfw. V/IV"

msgid "PzVIB_Tiger_II_F"
msgstr "Tiger II (H)"

msgid "PzVIB_Tiger_II_FL"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_FL_short"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_F_descr"
msgstr "Là chiếc tăng giáp dày nhất và sở hữu súng chống tăng uy lực nhất. Nhược điểm của nó là hệ thống xích bị quá tải và ở khối động cơ-bộ truyền động, cũng như tổng trọng lượng quá lớn. Khi giao tranh với xe địch ở tầm xa, Tiger II có lợi thế về hỏa lực và giáp bảo vệ. Tuy nhiên, do trọng lượng xe quá lớn, động cơ và bộ truyền động dễ hỏng hóc, cộng với số lượng xuất xưởng ít ỏi, Tiger II không gây được ảnh hưởng đáng kể nào đến kết cục của cuộc chiến."

msgid "PzVIB_Tiger_II_F_short"
msgstr "Tiger II (H)"

msgid "PzVI_Anfangsturm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H2"

msgid "PzVI_Anfangsturm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H\nAusf. H2"

msgid "PzVI_MapsTraining_Player_HT_2"
msgstr "Tiger I (tr.)"

msgid "PzVI_Porsche_Turm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_Porsche_Turm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger\nAusf. E"

msgid "PzVI_Standardketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H1"

msgid "PzVI_Vetstaerktketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "Quá trình phát triển Tiger I bắt đầu từ năm 1937 bởi công ty Henschel. Nó đi vào sản xuất hàng loạt từ năm 1942, với tổng số 1354 xe đã được chế tạo. Chiếc tăng này lần đầu tham chiến ở trận đánh Leningrad, và luôn đứng đầu tiền tuyến từ Tunisia cho đến Kursk. Mặc dù quá trình sản xuất bị dừng lại vào mùa hè năm 1944, Tiger I vẫn tiếp tục tham gia các hoạt động quân sự quan trọng cho đến cuối cuộc chiến."

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

msgid "PzV_PzIV_CN"
msgstr "Pz.Kpfw. V Berge-Panther"

msgid "PzV_PzIV_CN_descr"
msgstr "Chiếc xe này do Đại đội Bảo dưỡng và Tái chế thuộc Tiểu đoàn Panzerjäger Hạng Nặng Số 653 chế tạo, dựa trên nền tảng của Bergepanther ARV kết hợp với tháp pháo Pz. IV."

msgid "PzV_PzIV_CN_short"
msgstr "Pz. V BP"

msgid "PzV_PzIV_ausf_Alfa"
msgstr "Pz.Kpfw. V/IV Alpha"

msgid "PzV_PzIV_ausf_Alfa_CN"
msgstr "Pz. V Berge-Panther Alpha"

msgid "PzV_PzIV_ausf_Alfa_CN_descr"
msgstr "Chiếc xe này do Đại đội Bảo dưỡng và Tái chế thuộc Tiểu đoàn Panzerjäger Hạng Nặng Số 653 chế tạo, dựa trên nền tảng của Bergepanther ARV kết hợp với tháp pháo Pz. IV."

msgid "PzV_PzIV_ausf_Alfa_CN_short"
msgstr "Pz. V BP A"

msgid "PzV_PzIV_ausf_Alfa_descr"
msgstr "Chiếc xe này do Đại đội Bảo dưỡng và Tái chế thuộc Tiểu đoàn Panzerjäger Hạng Nặng Số 653 chế tạo, dựa trên nền tảng của Bergepanther ARV kết hợp với tháp pháo Pz. IV."

msgid "PzV_PzIV_ausf_Alfa_short"
msgstr "Pz. V/IV A"

msgid "PzV_PzIV_descr"
msgstr "Chiếc xe này do Đại đội Bảo dưỡng và Tái chế thuộc Tiểu đoàn Panzerjäger Hạng Nặng Số 653 chế tạo, dựa trên nền tảng của Bergepanther ARV kết hợp với tháp pháo Pz. IV."

msgid "PzV_PzIV_short"
msgstr "Pz. V/IV"

msgid "Pz_IV_AusfA"
msgstr "Pz.Kpfw. IV Ausf. A"

msgid "Pz_IV_AusfA_descr"
msgstr "Trong quá trình phát triển của mình, Pz.Kpfw. IV Ausf. A được phân loại là tăng hạng nặng. Đây cũng là phiên bản đầu của chiếc tăng Đức có số lượng sản xuất hàng loạt nhiều nhất. Pz.Kpfw. IV Ausf. A bắt đầu được phát triển từ năm 1935 và chế tạo quy mô lớn vào mùa thu năm 1937. Pz.Kpfw. IV luôn thuộc diện sẵn sàng nâng cấp: Chiếc tăng trong game là một bản chuyển tiếp giữa phiên bản Ausf. A và Ausf. B. Ba chiếc Pz.Kpfw. IV đầu tiên nhập biên chế năm 1938. Có tổng cộng 35 bản chỉnh sửa Ausf. A đã được sản xuất; chúng phục vụ trong biên chế cho đến mùa xuân năm 1941."

msgid "Pz_IV_AusfA_short"
msgstr "Pz. IV A"

msgid "Pz_IV_AusfD"
msgstr "Pz.Kpfw. IV Ausf. D"

msgid "Pz_IV_AusfD_descr"
msgstr "Dự án chỉnh sửa Pz IV bắt đầu vào tháng 10-1939. Chiếc xe đã được cải thiện giáp và có thêm mặt nạ súng dày hơn phía ngoài. Người ta đã sản xuất hàng loạt nó cho tới tháng 5-1940, với tổng cộng 229 chiếc xuất xưởng."

msgid "Pz_IV_AusfD_short"
msgstr "Pz. IV D"

msgid "Pz_Sfl_IVb"
msgstr "Pz.Sfl. IVb"

msgid "Pz_Sfl_IVb_descr"
msgstr "Một nguyên mẫu pháo tự hành trang bị lựu pháo 105-mm. Phiên bản gốc được phát triển bởi hãng Krupp vào năm 1939. Đến năm 1940, người ta tiến hành một số thay đổi trong dự án. Hai nguyên mẫu đầu tiên được chế tạo vào ngày 07/01/1942. Cùng năm đó, loạt nguyên mẫu gồm 10 pháo tự hành cũng xuất xưởng: 6 xe đi vào phục vụ biên chế lục quân, trong khi 4 chiếc còn lại được bàn giao cho các đơn vị huấn luyện của Wehrmacht."

msgid "Pz_Sfl_IVb_short"
msgstr "Pz.Sfl. IVb"

msgid "Pz_Sfl_IVc"
msgstr "Pz.Sfl. IVc"

msgid "Pz_Sfl_IVc_descr"
msgstr "Một dự án xe phòng không lắp súng phòng không 88-mm. Quá trình phát triển bắt đầu tại Đức vào năm 1941. Chiếc xe này dựa trên khung gầm của Pz.Sfl.IVc. Các yêu cầu tác chiến của nó đã bị thay đổi liên tục khiến khẩu Flak 41 đến năm 1944 mới được lắp đặt. Theo dự tính, Pz.Sfl. IVc sẽ là mẫu cơ sở cho nhiều biến thể với các loại vũ khí khác nhau. Tuy nhiên, kế hoạch này chưa bao giờ trở thành hiện thực. Chỉ có 3 nguyên mẫu từng được chế tạo."

