msgid "entryPoint/tooltip/description"
msgstr "Đây là những hộp đặc biệt chứa đồ mới và độc. Chúng có thể sở hữu từ Cửa hàng trong game."

msgid "entryPoint/tooltip/timerText"
msgstr "Sự kiện sẽ hết sau"

msgid "eventName/lowerCase"
msgstr "God's Blessing"

msgid "eventName/upperCase"
msgstr "GOD'S BLESSING"

msgid "guaranteed/tooltip/description1/"
msgstr "Nếu đã được sở hữu mọi chiếc rồi, bạn sẽ được Chosen Lootbox thay vào đó."

msgid "infoPage/footer/description/compensation"
msgstr "Nếu đã sở hữu mọi xe từ các hộp rồi, bạn sẽ nhận được Chosen Lootbox làm phần thưởng thay phương tiện."

msgid "infoPage/footer/description/guaranteed"
msgstr "Mỗi %(guaranteed0)s Celestial, %(guaranteed1)s Heaven Help và %(guaranteed2)s Chosen Lootbox chắc chắn đem lại một xe. Nếu mở chúng mà không xuất hiện chiếc nào như thế, bạn sẽ ẵm về một chiếc chưa sở hữu khi khui hộp thứ %(guaranteed0)s/%(guaranteed1)s/%(guaranteed2)s (tương ứng theo loại hộp). Lúc điều đó xảy ra, bộ đếm sẽ tính lại từ đầu."

msgid "infoPage/footer/title/compensation"
msgstr "Đền bù"

msgid "infoPage/footer/title/guaranteed"
msgstr "Phần thưởng Chắc chắn"

msgid "infoPage/header/rewards/description"
msgstr "Chỉ 1 phần thưởng mỗi nhóm có thể xuất hiện"
