msgid "advanced/ARMOR_PIERCING"
msgstr "Loại đạn phổ biến nhất và chỉ gây thiệt hại khi xuyên qua giáp xe. Đạn này có thể nảy bật ra nếu trúng giáp ở một góc lớn. Sức xuyên của đạn Xuyên Giáp (AP) tỉ lệ nghịch với khoảng cách bay."

msgid "advanced/ARMOR_PIERCING_CR"
msgstr "Đặc trưng với tốc độ bay nhanh và chỉ gây thiệt hại khi xuyên qua giáp xe. Đạn này có thể nảy bật ra nếu trúng giáp ở một góc lớn. Sức xuyên của đạn Xuyên Giáp Hỗn hợp Cứng (APCR) tỉ lệ nghịch với khoảng cách bay."

msgid "advanced/ARMOR_PIERCING_CR_NOT_PIERCING_DAMAGE"
msgstr "Ngoài ưu và nhược cơ bản theo loại của nó, đạn này có xác suất cao hơn nếu nói về khả năng gây thiệt hại ngay cả khi không xuyên giáp địch."

msgid "advanced/ARMOR_PIERCING_CR_TRAY"
msgstr "Đạn mâm hình sao có cả ưu lẫn nhược. Sát thương mà chúng gây ra phụ thuộc khoảng cách tới mục tiêu. Thiệt hại cao nhất nằm trong tầm 50 mét."

msgid "advanced/ARMOR_PIERCING_NOT_PIERCING_DAMAGE"
msgstr "Ngoài ưu và nhược cơ bản theo loại của nó, đạn này có xác suất cao hơn nếu nói về khả năng gây thiệt hại ngay cả khi không xuyên giáp địch."

msgid "advanced/ARMOR_PIERCING_TRAY"
msgstr "Đạn mâm hình sao có cả ưu lẫn nhược. Sát thương mà chúng gây ra phụ thuộc khoảng cách tới mục tiêu. Thiệt hại cao nhất nằm trong tầm 50 mét."

msgid "advanced/HIGH_EXPLOSIVE"
msgstr "Gây ra thiệt hại ngay cả khi không xuyên giáp. Xác suất sát thương cao hơn, nhưng có thể rất nhỏ. Phát nổ khi chạm giáp xe hoặc vật cản. Không thể nảy bật khỏi giáp."

msgid "advanced/HIGH_EXPLOSIVE_MODERN"
msgstr "Có thể gây ra thiệt hại cho sức kháng cự, mô-đun trong và sát thương kíp lái, ngay cả khi không xuyên giáp. Xác suất sát thương cao hơn so với các loại đạn khác, dù lượng thiệt hại nhiều lúc không lớn. Có thể đâm qua các lớp vật liệu mỏng và một số vật thể phá hủy được, nhưng sẽ mất đi một khoản xuyên giáp. Phát nổ nếu không xuyên giáp."

msgid "advanced/HOLLOW_CHARGE"
msgstr "Đặc trưng với sức xuyên rất lớn nhưng bị giảm đi đáng kể nếu trúng các tấm chắn hoặc lưới thép. Đạn Nổ Mạnh Chống Tăng (HEAT) chỉ gây thiệt hại sau khi xuyên được giáp xe. Hiện tượng nảy bật đạn khá hiếm. Sức xuyên của đạn HEAT không bị giảm theo khoảng cách."

msgid "advanced/LOW_CHARGE_SHOT/fireMode"
msgstr "Cơ chế đặc biệt"

msgid "advanced/LOW_CHARGE_SHOT/fireRate"
msgstr "cho phép bắn sớm hơn"

msgid "advanced/LOW_CHARGE_SHOT/footer"
msgstr "%(fireMode)s của súng xe này %(fireRate)s với tham số đạn biến hóa."

msgid "advanced/additionalInvisibilityDevice"
msgstr "Hiệu quả phụ thuộc vào loại xe. Tăng độ ẩn giấu của phương tiện đứng yên hoặc đang di chuyển. Hữu ích khi do thám chủ động, cũng như trinh sát thụ động từ các vị trí nguy hiểm."

msgid "advanced/aimingStabilizer"
msgstr "Hỗ trợ quá trình ngắm: Giảm độ phân tán tâm ngắm khi bắn, xoay tháp pháo hoặc di chuyển xe."

msgid "advanced/antifragmentationLining"
msgstr "Giảm thiệt hại do đâm/húc và đạn Nổ mạnh (HE) nếu không xuyên, giảm thời gian kíp lái bị choáng cũng như giảm xác suất sát thương lính tăng."

msgid "advanced/autoExtinguishers"
msgstr "Tự động dập lửa trong xe ngay tại thời điểm bắt cháy. Ngoài ra, nó còn làm giảm xác suất bốc lửa."

msgid "advanced/camouflageNet"
msgstr "Giảm nguy cơ bị phát hiện sau khi xe dừng di chuyển được một khoảng thời gian ngắn. Hiệu quả này sẽ bị mất nếu xe tiến lên, lùi lại, hoặc xoay thân (trừ các xe với hệ thống giảm xóc thủy–khí ở chế độ Tác xạ)."

msgid "advanced/coatedOptics"
msgstr "Tăng tầm nhìn của xe bạn, giúp phát hiện địch sớm hơn."

msgid "advanced/commander"
msgstr "Ảnh hưởng đến tầm nhìn. Cải thiện đôi chút hiệu quả của các thành viên khác trong kíp lái."

msgid "advanced/commandersView"
msgstr "Giảm độ ẩn giấu của xe địch đứng yên và đang di chuyển sau cành lá."

msgid "advanced/demountKit/common"
msgstr "Gỡ thiết bị tiêu chuẩn hoặc Thiết bị Bao cấp mà không cần dùng đến các loại tiền tệ trong game."

msgid "advanced/driver"
msgstr "Ảnh hưởng đến độ cơ động của xe."

msgid "advanced/economyBonds"
msgstr "Loại tiền tệ đặc biệt hiếm dùng để mua nhiều thứ độc đáo."

msgid "advanced/economyConvertExp"
msgstr "Nguồn lực game này có thể được dùng để nghiên cứu xe hoặc mô-đun bất kỳ, cũng như đào tạo kíp lái."

msgid "advanced/economyCredits"
msgstr "Loại tiền tệ chính trong game. Kiếm được qua các trận đánh hoặc mua bằng vàng."

msgid "advanced/economyGold"
msgstr "Một loại tiền tệ Premium, có thể được sử dụng cho nhiều mục đích."

msgid "advanced/economyPremium"
msgstr "Đem lại thêm 50% XP và bạc sau mỗi trận, cũng như nhiều lựa chọn khác."

msgid "advanced/economyPremium/header"
msgstr "Tài khoản Premium WoT"

msgid "advanced/economyTankExperience"
msgstr "Tài nguyên game này có thể kiếm được qua các trận đánh. Kinh nghiệm được dùng để nghiên cứu mô-đun và xe mới."

msgid "advanced/enhancedAimDrives"
msgstr "Giảm thời gian ngắm của vòng tròn tiêu điểm."

