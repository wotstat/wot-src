msgstr "Chỉ số này ảnh hưởng đến gia tốc, tốc độ tối đa và tốc độ xoay thân xe ở cơ chế Turbo."

msgid "tank_params/desc/explosionRadius"
msgstr "Bán kính sát thương sau khi đạn HE phát nổ, thể hiện khả năng gây thiệt hại ở một khoảng cách tính từ điểm va chạm."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Thời gian cộng thêm vào quá trình tái nạp Cassette còn lại sau khi bắn viên cuối"

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Tốc độ xe như định nghĩa trong đặc tính kỹ thuật."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "Bonus cho sát thương trung bình mỗi phút ở mức hiệu quả tái nạp cao nhất."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Số mức hiệu quả tái nạp nhiều nhất có thể tích lũy."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "Thời lượng hiệu lực của một mức hiệu quả tái nạp trước khi hết hạn."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "Số mức hiệu quả tái nạp nhận được khi bắn đạn diệt một xe địch."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "Số mức hiệu quả tái nạp nhận được cho mỗi phát trúng xe địch đã bị phát hiện."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "Thời lượng reload súng được giảm theo mỗi mức hiệu quả tái nạp."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "Khoản phạt cho độ phân tán khi quay súng ở cơ chế Turbo."

msgid "tank_params/desc/gunYawLimits"
msgstr "Góc quay ngang tối đa của súng (sang trái và sang phải so với vị trí mặc định) khi thân xe không di chuyển."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "Bonus sát thương trung bình với mỗi mức nhiệt tích được."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Thời gian xe không thể bắn hoặc đổi đạn."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Thời gian xe có thể duy trì mức nhiệt cao nhất trước khi sạc quá nhiệt."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Thời gian cần để đạt mỗi mức nhiệt."

msgid "tank_params/desc/heatingPerShot"
msgstr "Lượng nhiệt mà súng sinh ra mỗi phát."

msgid "tank_params/desc/hullArmor"
msgstr "Bề dày giáp thân xe: Theo thứ tự phía Trước / Hông / Sau."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "Khoản phạt cho độ phân tán khi xoay thân ở cơ chế Turbo."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Thông số này biểu thị lượng thiệt hại gây ra lúc đâm/húc. Khi va chạm, hệ thống sẽ cân nhắc độ dày giáp tại điểm tiếp xúc, chênh lệch trọng lượng và tốc độ giữa các xe."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Thông số này biểu thị lượng thiệt hại cho hệ giảm xóc do đâm/húc. Khi va chạm, hệ thống sẽ cân nhắc độ dày giáp tại điểm tiếp xúc, chênh lệch trọng lượng và tốc độ xe."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Thể hiện khả năng ẩn giấu của xe khi đang di chuyển. Thông số này càng cao, xe càng khó bị phát hiện. Được hiển thị theo thứ tự sau: Đối với xe đang di chuyển / Đối với xe đang di chuyển sau khi bắn."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Thể hiện khả năng ẩn giấu của xe khi đứng yên. Thông số này càng cao, xe càng khó bị phát hiện. Được hiển thị theo thứ tự sau: Đối với xe không di chuyển / Đối với xe không di chuyển sau khi bắn."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "Lượng sạc Afterburner phóng ion được tạo ra mỗi giây khi chạy quá 40 km/h trong cơ chế Turbo."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Tham số này ảnh hưởng đến thời lượng hoạt động của Afterburner phóng ion sau khi kích hoạt."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Chỉ số này ảnh hưởng đến gia tốc, tốc độ tối đa và tốc độ xoay thân xe sau khi kích hoạt Afterburner phóng ion."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "Tốc độ nhận được thêm sau khi kích hoạt Afterburner phóng ion."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "Lượng sạc Afterburner phóng ion được tạo ra mỗi giây trong cơ chế Turbo."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Sát thương trung bình một phát sạc-đơn gây ra sau khi xuyên giáp. Sát thương thực tế có thể dao động +/- 25% so với giá trị trung bình."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Thời gian trước khi nạp lại hoàn toàn mà trong lúc đó không thể bắn các phát sạc-đơn."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Mức tăng phân tán của súng khi bắn một phát sạc-đơn. Đặc trưng bởi độ lệch tối đa so với điểm ngắm ở khoảng cách 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Độ dày giáp trung bình một phát sạc-đơn xuyên được, đã tính góc thường hóa (góc đạn tới chạm giáp). Giá trị thực tế có thể dao động +/- 25% so với trung bình."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Mức tăng số phát mỗi phút khi bắn các viên sạc-đơn (so với khai hỏa thông thường)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Tốc độ của phát sạc-đơn."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Số mức chính xác nhiều nhất có thể tích lũy."

msgid "tank_params/desc/maxHealth"
msgstr "Sức kháng cự của xe, tính theo đơn vị HP."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "Góc tối đa mà bánh xe có thể quay. Ảnh hưởng đến độ cơ động và khả năng điều khiển xe."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "Khoản phạt cho độ phân tán khi di chuyển ở cơ chế Turbo."

msgid "tank_params/desc/overheatDuration"
msgstr "Thời gian cần để súng quá nhiệt nguội hoàn toàn. Súng không thể sử dụng trong lúc này."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "Lượng sạc Sight cơ-điện Coincidence được tạo mỗi giây ở cơ chế Tiếp chiến."

msgid "tank_params/desc/piercingPower"
msgstr "Độ dày giáp có thể xuyên thủng được bởi một viên đạn tiêu chuẩn, tính cả góc thường hóa của nó."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Tốc độ xoay thân xe quanh trục của nó, và tốc độ đổi hướng khi đang di chuyển (khả năng cơ động)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "Thời gian chuyển đổi giữa các cơ chế phụ thuộc vào tình trạng động cơ. Động cơ bị hư hại sẽ cần nhiều thời gian hơn khi chuyển đổi. Động cơ bị hỏng đồng nghĩa với việc không thể chuyển đổi."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "Thời gian chuyển đổi giữa các cơ chế phụ thuộc vào tình trạng động cơ. Động cơ bị hư hại sẽ cần nhiều thời gian hơn khi chuyển đổi. Động cơ bị hỏng đồng nghĩa với việc không thể chuyển đổi."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Tốc độ nghiêng thân lên xuống khi xe ở cơ chế Lô-cốt."

msgid "tank_params/desc/pitchLimits"
msgstr "Góc tối đa theo chiều dọc mà súng có thể dịch chuyển khi so với thân xe và tính cả hệ giảm xóc của nó."

msgid "tank_params/desc/powerModeDuration"
msgstr "Thời gian cần để đạt tốc độ tiến và công suất động cơ cao nhất ở cơ chế Direct Drive."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Thời gian cần để kích hoạt cơ chế Direct Drive."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "Bonus cho phân tán ở 100 m với làm nóng hoàn toàn."

msgid "tank_params/desc/preheatDmgCap"
msgstr "Bonus sát thương trung bình với làm nóng hoàn toàn."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Vượt tốc độ này sẽ ngăn việc làm nóng và có thể khiến nó bị giảm."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Thời gian cần để xe làm nóng hoàn toàn từ 0."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Thời gian để xe hạ về 0 từ mức làm nóng hoàn toàn."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Trong khoảng trễ này, quá trình làm nóng của xe không tăng cũng không giảm."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "Mức sạc tối đa có thể đạt tới mà không cần tắt bộ giới hạn limiter."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "Lượng sạc bị mất sau khi khai hỏa."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "Lượng sạc được tự động tạo ra mỗi giây."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "Lượng sạc mất đi mỗi giây sau khi bộ limiter được kích hoạt, cho tới lúc đạt giới hạn."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "Khoảng trễ mà sau đó bộ giới hạn limiter có thể bật/tắt được tiếp."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "Khoản phạt thời gian ngắm khi vượt quá giới hạn."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "Bonus sát thương trung bình ở trạng thái sạc-đầy khi vượt quá giới hạn."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "Giá trị gia tăng đột ngột mà sát thương từ các phát bắn gây ra khi vượt quá giới hạn."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "Khoản phạt độ phân tán ở 100 m khi vượt quá giới hạn."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "Bonus sát thương trung bình ở trạng thái sạc tối đa khi bộ giới hạn limiter hoạt động."

msgid "tank_params/desc/radioDistance"
msgstr "Thông tin liên lạc nội bộ giữa đồng minh về vị trí của các xe thiết giáp. Khoảng cách giao tiếp của riêng từng xe được đại diện bằng một vòng tròn với bán kính có giá trị bằng thông số này. Khi các vòng tròn đan vào nhau, thông tin sẽ được chia sẻ ở bất cứ khoảng cách nào."

msgid "tank_params/desc/reactivationDelay"
msgstr "Thời gian Cooldown cần có khi Booster có thể kích hoạt tiếp sau khi xài."

msgid "tank_params/desc/reactivationLimit"
msgstr "Mức nhiệt cao nhất có thể đạt trước khi Booster không khả dụng để kích hoạt lại."

msgid "tank_params/desc/relativeArmor"
msgstr "Một bộ các thông số thể hiện khả năng chống lại thiệt hại của xe."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Một bộ các thông số thể hiện hiệu quả trong việc ẩn giấu xe khi nó đứng yên, đang di chuyển và sau khi khai hỏa. Sử dụng ngụy trang sẽ làm tăng thông số ẩn giấu này."

msgid "tank_params/desc/relativeMobility"
msgstr "Một bộ các thông số thể hiện khả năng xe có thể thay đổi vị trí của nó nhanh hay chậm lúc trên chiến trường."

msgid "tank_params/desc/relativePower"
msgstr "Một bộ các thông số thể hiện hiệu quả trong việc tiêu diệt xe địch."

msgid "tank_params/desc/relativeVisibility"
msgstr "Một bộ các thông số thể hiện hiệu quả trong việc phát hiện xe địch."

msgid "tank_params/desc/reloadTime"
msgstr "Số đạn bắn ra mỗi phút."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Bonus cho thời gian tái nạp của súng khi Sight đang hoạt động."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Thời gian cần để tái nạp đạn cho súng (hoặc cả hai nòng trên các xe có hệ thống súng đôi) sau khi bắn."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
msgstr "Thời gian nạp đạn vào súng sau khai khỏa (chế độ bắn đơn/bắn song song)."

msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
msgstr "Giảm tốc độ lùi của xe khi Booster đang hoạt động."

msgid "tank_params/desc/rocketAccelerationEnginePower"
msgstr "Thông số này ảnh hưởng đến khả năng tăng tốc, tốc độ tối đa và tốc độ xoay thân của xe."

msgid "tank_params/desc/rocketAccelerationReuseAndDuration"
msgstr "Bộ áp phản lực làm tăng công suất động cơ và tốc độ tối đa. Khi kích hoạt, nó làm giảm khả năng bẻ lái và không thể tự tay tắt đi."

msgid "tank_params/desc/rocketAccelerationSpeedLimits"
msgstr "Tốc độ danh nghĩa của xe với bộ áp phản lực được kích hoạt."

msgid "tank_params/desc/secondaryAvgDamage"
msgstr "Sát thương trung bình một viên đạn của vũ khí phụ gây ra sau khi xuyên giáp. Giá trị thực tế có thể dao động +/- 25% so với trung bình."

msgid "tank_params/desc/secondaryAvgPiercingPower"
msgstr "Độ dày giáp trung bình một viên đạn của vũ khí phụ xuyên được, đã tính góc thường hóa (góc đạn tới chạm giáp). Giá trị thực tế có thể dao động +/- 25% so với trung bình."

msgid "tank_params/desc/secondaryReloadTimeSecs"
msgstr "Thời gian tái nạp vũ khí phụ sau khi bắn."

msgid "tank_params/desc/secondaryTotalBurstSize"
msgstr "Số viên đạn khả dụng cho vũ khí phụ trong mỗi lần kích hoạt."

msgid "tank_params/desc/shellCalibrationAvgDamage"
msgstr "Bonus sát thương được nhận sau khi bắn xuyên giáp một xe địch."

msgid "tank_params/desc/shellCalibrationAvgPenetration"
msgstr "Bonus xuyên giáp được nhận sau khi bắn trúng nhưng không xuyên một xe địch."

msgid "tank_params/desc/shellLoadingTime"
msgstr "Thời gian cần để nạp đạn lúc đầu trận và chuyển giữa các loại đạn khác nhau."

msgid "tank_params/desc/shellParamsSwitchingTime"
msgstr "Thời gian cần để chuyển giữa chế độ bắn Hiệu chuẩn và Thường."

msgid "tank_params/desc/shotDispersionAngle"
msgstr "Độ phân tán của súng được biểu diễn bằng độ lệch đạn lớn nhất so với điểm ngắm ở cự li 100 m."

msgid "tank_params/desc/shotDispersionAngle/twinGun"
msgstr "Độ phân tán của súng được biểu diễn bằng độ lệch đạn lớn nhất so với điểm ngắm ở cự li 100 m (chế độ thường/đặc biệt)."

msgid "tank_params/desc/shotDispersionAngle/withDualAccuracy"
msgstr "Biểu thị độ lớn mà đạn có thể bay lệch khỏi điểm ngắm, tính theo mét, ở mỗi 100 mét đến mục tiêu. Giá trị cơ bản (cái đầu) là cho nòng bị nóng, giá trị tốt hơn (cái thứ hai) là của nòng đã nguội đủ."

msgid "tank_params/desc/sightPointerConsealmentFoliage"
msgstr "Giảm dần mức ẩn giấu của xe đối phương sau thực vật trong vùng quét hệ thống IRST."

msgid "tank_params/desc/sightPointerConsealmentMoving"
msgstr "Giảm dần mức ẩn giấu của xe đối phương đang di chuyển trong vùng quét hệ thống IRST."

msgid "tank_params/desc/sightPointerDeployTime"
msgstr "Thời gian cần sau lúc bắt đầu trận trước khi IRST có thể dùng lần đầu."

msgid "tank_params/desc/sightPointerDuration"
msgstr "Thời lượng quét của IRST."

msgid "tank_params/desc/sightPointerReloadTime"
msgstr "Thời gian cần trước khi IRST có thể kích hoạt tiếp sau lúc xài."

msgid "tank_params/desc/sightPointerRotationSpeed"
msgstr "Giảm tốc độ quay tháp pháo khi IRST hoạt động."

msgid "tank_params/desc/sightPointerSectorAngleEnd"
msgstr "Độ rộng vùng quét của IRST vào cuối thời lượng quét."

msgid "tank_params/desc/sightPointerSectorAngleStart"
msgstr "Độ rộng vùng quét của IRST lúc bắt đầu thời lượng của nó."

msgid "tank_params/desc/sightPointerSelfSpottingTime"
msgstr "Thời gian xe của bạn bị phát hiện sau khi bản thân soi ra một kẻ địch chưa lộ diện bằng IRST."

msgid "tank_params/desc/sightPointerViewRange"
msgstr "Tăng dần tầm nhìn trong vùng quét của IRST."

msgid "tank_params/desc/speedLimits"
msgstr "Tốc độ xe như định nghĩa trong đặc tính kỹ thuật."

msgid "tank_params/desc/stagedJetBoostersChargeDuration"
msgstr "Thời lượng Boost tối đa sau khi kích hoạt Thruster."

msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "Số lần có thể dùng Thruster mỗi trận."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Thời gian hồi phục sau khi sử dụng, trước lúc có thể kích hoạt tiếp."

msgid "tank_params/desc/stagedJetBoostersEnginePower"
msgstr "Bonus gia tốc xe khi kích hoạt Thruster."

msgid "tank_params/desc/stagedJetBoostersRotationSpeed"
msgstr "Bonus tốc độ xoay thân khi kích hoạt Thruster."

msgid "tank_params/desc/stagedJetBoostersSpeedLimits"
msgstr "Tốc độ xe như định nghĩa trong đặc tính kỹ thuật."

msgid "tank_params/desc/stagedJetBoostersTopSpeed"
msgstr "Bonus tốc độ tối đa khi kích hoạt Thruster."

msgid "tank_params/desc/stationaryReloadSwitchOffTime"
msgstr "Thời gian trước lúc tháp pháo được mở khóa và xe có thể bắn tiếp sau khi tái nạp bị gián đoạn."

msgid "tank_params/desc/stationaryReloadSwitchOnTime"
msgstr "Thời gian để liên kết tháp pháo với thùng đạn ngoài và bắt đầu tái nạp."

msgid "tank_params/desc/stunMaxDuration"
