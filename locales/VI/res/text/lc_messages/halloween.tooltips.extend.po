msgid "Contact/status/inBattle/halloween"
msgstr "Trong trận Babylon: Dark Tower"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Bắn một phát súng gây thiệt hại và làm choáng cho mục tiêu cùng mọi xe địch nội trong bán kính 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Bắn một phát súng khôi phục sức kháng cự bằng cách cướp HP từ mục tiêu và các xe địch nội trong bán kính 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "advanced/hw_damageShield"
msgstr "Bảo vệ khỏi bất cứ thiệt hại nào (trừ đâm/húc, ngập nước và va chạm) trong 7 giây."

msgid "advanced/hw_fastReload"
msgstr "Tăng tốc độ bắn / nạp lại băng đạn."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Hồi phục sức kháng cự, dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hại."

msgid "advanced/hw_invisibility"
msgstr "Tạm thời tàng hình xe của bạn trước mắt địch, khôi phục HP, sửa mô-đun, dập lửa, loại bỏ hiệu ứng choáng và cứu mọi thành viên kíp lái bị thương."

msgid "advanced/hw_teamRepairKit"
msgstr "Sửa mô-đun hư hại, dập lửa, loại bỏ hiệu ứng choáng và hồi phục một lượng HP cho xe đồng đội nội trong bán kính tác dụng."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Khả năng Chiến đấu giúp bạn đánh hiệu quả hơn trong các trận Babylon: Dark Tower, hoàn tất Mục tiêu và đoạt thưởng giá trị. Để trang bị chúng, hãy click vào một trong những ô Khả năng Chiến đấu."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Ô Khả năng Chiến đấu"

msgid "hwShell/alt/description"
msgstr "%(bold)s có thể tìm thấy trong trận với xác suất nhất định sau khi diệt một kẻ địch."

msgid "hwShell/alt/description/bold"
msgstr "Đạn thay thế"
