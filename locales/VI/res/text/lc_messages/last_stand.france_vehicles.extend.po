msgid "F110_Lynx_6x6_LS_BOT"
msgstr "Trapper"

msgid "F110_Lynx_6x6_LS_BOT_descr"
msgstr "Quá trình phát triển tiếp sau của xe bọc thép Panhard AML với hệ thống giảm xóc sáu-bánh-lái, tháp pháo mới và vũ trang uy lực hơn."

msgid "F110_Lynx_6x6_LS_BOT_short"
msgstr "Trapper"

msgid "F17_AMX_13_90_LS_BOT"
msgstr "Corrupted Hornet"

msgid "F17_AMX_13_90_LS_BOT_descr"
msgstr "Một xe nhanh và cơ động với hệ thống nạp đạn theo băng 5 viên."

msgid "F17_AMX_13_90_LS_BOT_short"
msgstr "Corrupted"

msgid "F71_AMX_30_prototype_LS_BOT"
msgstr "Guard A.P. AMX 30"

msgid "F71_AMX_30_prototype_LS_BOT_descr"
msgstr "Được phát triển như một phần của cuộc chạy đua chế tạo xe tăng đa nhiệm chủ lực của các nước châu Âu. Rốt cuộc, AMX 30 có khả năng di chuyển, công suất động cơ và cự ly giao chiến chống tăng hiệu quả vượt trội hơn mọi chiếc xe khác (trừ Leopard 1). Vỏ bọc thép của xe khá mỏng, nhưng người ta cho rằng các tiến bộ kỹ thuật về đạn chống tăng khiến giáp bảo vệ luôn luôn tụt hậu: Khả năng sống sót lúc này sẽ dựa vào độ cơ động và hỏa lực."

msgid "F71_AMX_30_prototype_LS_BOT_short"
msgstr "Guard"

msgid "F73_M4A1_Revalorise_LS_BOT"
msgstr "Guard M4A1 Rev."

msgid "F73_M4A1_Revalorise_LS_BOT_descr"
msgstr "Vào những năm 1950, hàng loạt bản chỉnh sửa của M4 Sherman được cung cấp cho Pháp như một phần thuộc chương trình MDAP. Các đơn vị thiết kế trong nước bắt đầu hiện đại hóa chiếc xe này nhằm mục đích tăng cường hỏa lực. Ý tưởng trên dẫn tới chương trình hiện đại hóa dành cho các Lực lượng Phòng thủ Israel (Sherman M51). Chiếc tăng này chưa bao giờ phục vụ trong biên chế quân đội Pháp. Hiện vẫn không rõ có bao nhiêu nguyên mẫu đã được chế tạo."

msgid "F73_M4A1_Revalorise_LS_BOT_short"
msgstr "Guard"

msgid "F74_AMX_M4_1949_LS_BOT"
msgstr "Guard AMX M4 49"

msgid "F74_AMX_M4_1949_LS_BOT_descr"
msgstr "Một tăng hạng nặng ban đầu được biết đến với cái tên \"Dự án 141\". Do Pháp cần nhiều tăng hạng nặng hiện đại hơn, quá trình phát triển chiếc xe này bắt đầu ngay lập tức sau Thế Chiến II. Chỉ tồn tại trên bản vẽ."

msgid "F74_AMX_M4_1949_LS_BOT_short"
msgstr "Guard"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT"
msgstr "Guard AMX M4 54"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_descr"
msgstr "Một phiên bản của tăng hạng nặng AMX M4 dựa trên Project 141 với giáp tốt hơn. Theo kế hoạch, thân xe phía trước còn có thể được bổ sung thêm một lớp giáp dày 280 mm. Chỉ tồn tại trên bản vẽ."

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_short"
msgstr "Guard"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT"
msgstr "Guard AMX M4 51"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_descr"
msgstr "Project 141 là một phiên bản của tăng hạng nặng AMX M4 với giáp tốt hơn. Quá trình phát triển bắt đầu vào tháng 11/1949 nhưng chưa bao giờ được chế tạo. Dự án này cũng bao gồm rất nhiều giá trị tính toán cho các thân xe khác nhau trên cùng một khung gầm."

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_short"
msgstr "Guard"

