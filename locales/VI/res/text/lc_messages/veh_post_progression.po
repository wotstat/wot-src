msgid "slides/additionalEquipment/description"
msgstr "%(accent)Thiết đặt Phụ trợ%(/accent) là một phần của cấu hình xe, bao gồm %(accent)thiết bị và ứng dụng kỹ thuật%(/accent). Sau khi truy cập được Cấu hình Khác, bạn có thể %(accent)đổi qua lại giữa các cấu hình%(/accent) của Thiết đặt Phụ trợ trong lúc chờ đếm ngược trước trận."

msgid "slides/additionalEquipment/title"
msgstr "THIẾT ĐẶT PHỤ TRỢ"

msgid "slides/alternativeEquipment/description"
msgstr "Sau khi đạt đến Cấp Biến thể Dã chiến nhất định, một %(accent)Cấu hình Khác%(/accent) sẽ khả dụng cho xe của bạn, cũng như xuất hiện phương án chuẩn bị %(accent)thêm một bộ thiết bị, đạn, vật phẩm và ứng dụng kỹ thuật nữa%(/accent) trong Ga-ra. Nó không thay thế cấu hình chính nhưng mở khóa cơ hội mới. Bạn có thể đánh giá bản đồ và thành phần phe mình lúc chờ đếm ngược trước trận để %(accent)lựa chọn một trong hai%(/accent) cấu hình xe. Điều này cho phép chuẩn bị tốt hơn cho những tình huống khả dĩ sắp phải đương đầu."

msgid "slides/alternativeEquipment/title"
msgstr "CẤU HÌNH KHÁC CHO XE"

msgid "slides/baseModifications/description"
msgstr "%(accent)Biến thể Cơ bản%(/accent) mang lại lợi ích cho %(accent)một trong các đặc tính xe%(/accent) và mở khóa Sửa đổi Kép. Những biến thể này có thể lắp đặt miễn phí, nhưng bạn cần XP Chiến đấu cũng như XP Tự do để nghiên cứu chúng."

msgid "slides/baseModifications/title"
msgstr "BIẾN THỂ CƠ BẢN"

msgid "slides/extraModification/description"
msgstr "%(accent)Biến thể Đặc biệt%(/accent) mở khóa Cấu hình Khác đối với xe tương ứng và cho phép %(accent)chỉ định danh mục%(/accent) của ô thiết bị thứ hai (xe Cấp VIII–X). Bạn có thể tái định danh mục ô đã chọn bằng cách dùng bạc."

msgid "slides/extraModification/title"
msgstr "BIẾN THỂ ĐẶC BIỆT: VAI TRÒ Ô"

msgid "slides/fieldModernization/description"
msgstr "Biến thể Dã chiến là khả năng thực hiện nhiều điều chỉnh tinh vi cho xe tương ứng tùy theo vai trò, cũng như %(accent)thay đổi đặc tính của nó%(/accent) bằng hàng loạt %(accent)sửa đổi%(/accent). Mỗi biến thể tiếp theo được mở khóa sau khi nghiên cứu cái trước."

msgid "slides/fieldModernization/infoTitle"
msgstr "BIẾN THỂ DÃ CHIẾN"

msgid "slides/fieldModernization/title"
msgstr "THAY ĐỔI ĐẶC TÍNH XE"

msgid "slides/modificationTree/description"
msgstr "Sơ đồ Biến thể khả dụng cho xe nghiên cứu được và Sưu tập %(accent)Cấp VI–X%(/accent) đã đạt %(accent)trạng thái \"Elite\"%(/accent). Biến thể đối với xe đặc biệt, phần thưởng và Premium khả dụng ngay sau khi mua."

msgid "slides/modificationTree/infoTitle"
msgstr "NGHIÊN CỨU BIẾN THỂ"

msgid "slides/modificationTree/title"
msgstr "NGHIÊN CỨU BIẾN THỂ"

msgid "slides/pairedModifications/description"
msgstr "%(accent)Sửa đổi Kép cải thiện một%(/accent) đặc tính của xe trong khi %(accent)làm giảm cái khác%(/accent). Bạn cần XP Chiến đấu hoặc Tự do để nghiên cứu biến thể, và bạc để lắp đặt chúng. Người chơi có thể %(accent)hủy bỏ (gỡ khỏi xe)%(/accent) biến thể %(accent)một cách miễn phí%(/accent).\nKhi xe bị bán đi, Biến thể Cơ bản và Đặc biệt được lưu, nhưng Sửa đổi Kép sẽ bị hủy bỏ."

msgid "slides/pairedModifications/title"
msgstr "SỬA ĐỔI KÉP"

msgid "slides/requiredEquipment/description"
msgstr "%(accent)Thiết đặt Cốt yếu%(/accent) là một phần của cấu hình xe, bao gồm %(accent)đạn và vật phẩm%(/accent). Sau khi truy cập được Cấu hình Khác, bạn có thể %(accent)đổi qua lại giữa các cấu hình%(/accent) của Thiết đặt Cốt yếu trong lúc chờ đếm ngược trước trận."

msgid "slides/requiredEquipment/title"
msgstr "THIẾT ĐẶT CỐT YẾU"

msgid "slides/roleInBattle/description"
msgstr "Không như loại xe, vai trò xe phản ánh chính xác hơn về %(accent)chiến thuật đánh%(/accent) tối ưu, cũng như quyết định %(accent)Sơ đồ Biến thể%(/accent) nào sẽ khả dụng cho phương tiện cụ thể."

msgid "slides/roleInBattle/title"
msgstr "VAI TRÒ CỦA XE TRONG TRẬN"

msgid "slides/specialModifications/description/1/text"
msgstr "Biến thể làm thay đổi đặc tính xe, mở khóa %(accent)truy cập Cấu hình Khác%(/accent), cũng như cho phép chỉ định một danh mục đối với %(accent)ô thiết bị thứ hai%(/accent)."

msgid "slides/specialModifications/description/2/text"
msgstr "Cấu hình Khác là bộ %(accent)thiết bị, đạn, vật phẩm và ứng dụng kỹ thuật %(/accent) thứ hai. Bạn có thể chuyển qua lại giữa các cấu hình."

