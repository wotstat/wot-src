msgid "hint/LSH_FIRE"
msgstr "Khói làm phức tạp hóa việc phát hiện xe địch và thông tin liên lạc truyền đạt vị trí của chúng. Lửa gây thiệt hại cho xe."

msgid "hint/LSH_FOG"
msgstr "Sương mù làm phức tạp hóa việc phát hiện xe địch và thông tin liên lạc truyền đạt vị trí của chúng."

msgid "hint/LSH_RAIN"
msgstr "Mưa to làm phức tạp hóa việc phát hiện xe địch và thông tin liên lạc truyền đạt vị trí của chúng."

msgid "hint/LSH_SANDSTORM"
msgstr "Bão cát làm phức tạp hóa việc phát hiện xe địch và thông tin liên lạc truyền đạt vị trí của chúng."

msgid "hint/LSH_SMOKE"
msgstr "Khói làm phức tạp hóa việc phát hiện xe địch và thông tin liên lạc truyền đạt vị trí của chúng."

msgid "hint/PPH_AIMING_01"
msgstr "Di chuyển xe và tháp pháo làm giảm <font color='#EE7000'>độ chính xác của súng</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Vòng tròn quanh tâm ngắm thể hiện <font color='#EE7000'>độ chính xác của súng</font>. Đợi một chút để bắn chuẩn hơn."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Ngắm Tự động</font> đã được bật. Click chuột phải để hủy bỏ."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Ngắm Tự động luôn nhằm súng của bạn <font color='#EE7000'>vào giữa</font> xe mục tiêu"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Căn cứ của bạn <font color='#EE7000'>đang bị cướp!</font> Nếu không phản ứng, phe địch sẽ thắng trận."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Mỗi xe địch có tiến độ chiếm đóng <font color='#EE7000'>của riêng nó</font>"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Cướp</font> căn cứ địch là một trong nhiều cách thắng trận"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Khi bản thân chịu thiệt hại, tiến độ chiếm đóng của bạn <font color='#EE7000'>sẽ bị tính lại từ đầu</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Khi rời khỏi vòng tròn căn cứ, tiến độ chiếm đóng của bạn <font color='#EE7000'>sẽ bị mất</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Nhiều xe cùng chiếm sẽ cướp căn cứ <font color='#EE7000'>nhanh hơn</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Tuy nhiên, sau chiếc <font color='#EE7000'>thứ ba</font>, tốc độ cướp căn cứ không thể nhanh hơn được nữa"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Sắp cướp xong căn cứ địch!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Phe của bạn đang thắng cuộc đua chiếm căn cứ!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Mô-đun xe bị hư hại nghiêm trọng! Khôi phục nó bằng <font color='#EE7000'>Bộ Sửa chữa</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Mô-đun xe bị hư hại nghiêm trọng! Khôi phục nó bằng <font color='#EE7000'>Bộ Sửa chữa</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Thành viên kíp lái đã bị thương! Chữa trị ngay bằng <font color='#EE7000'>Bộ Cứu thương</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Thành viên kíp lái đã bị thương! Chữa trị ngay bằng <font color='#EE7000'>Bộ Cứu thương</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Kíp lái đã bị choáng! Chữa trị ngay bằng <font color='#EE7000'>Bộ Cứu thương</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Hỏa hoạn trong xe! Dùng ngay <font color='#EE7000'>Bình Chữa Cháy</font> ở bảng dưới đáy."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Hỏa hoạn trong xe! <font color='#EE7000'>Bình Chữa Cháy</font> Tự động đã kích hoạt."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Mô-đun xe bị hư hại nghiêm trọng! Trang bị <font color='#EE7000'>một Bộ Sửa chữa</font> trước khi vào trận sẽ khắc phục vấn đề này."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Thành viên kíp lái đã bị thương! Trang bị <font color='#EE7000'>một Bộ Cứu thương</font> trước khi vào trận sẽ khắc phục vấn đề này."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Hỏa hoạn trong xe! Trang bị <font color='#EE7000'>một Bình Chữa Cháy</font> trước khi vào trận sẽ khắc phục vấn đề này."

msgid "hint/PPH_OTHER_01"
msgstr "Bạn đã bị <font color='#EE7000'>phát hiện</font>—nổ súng có thể làm lộ vị trí của mình!"

msgid "hint/PPH_OTHER_02"
msgstr "Xe đã bị phá hủy. Bạn có thể bấm <font color='#EE7000'>Esc</font> để rời trận mà không ăn phạt."

msgid "hint/PPH_OTHER_03"
msgstr "Xe đã bị phá hủy. Bạn có thể click nút chuột để <font color='#EE7000'>xem</font> đồng đội của mình."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Biểu tượng bóng đèn</font> báo hiệu bạn đã bị địch phát hiện!"

msgid "hint/PPH_OTHER_05"
msgstr "Súng vẫn đang <font color='#EE7000'>nạp đạn</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Bạn chỉ có thể khai hỏa nếu vòng tròn quanh tâm ngắm <font color='#EE7000'>đầy màu xanh lục</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Bạn có thể cuộn con lăn chuột để vào <font color='#EE7000'>chế độ Sniper</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Bạn có thể cuộn con lăn chuột để <font color='#EE7000'>thoát</font> chế độ Sniper"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Vòng trong tâm ngắm xanh lục</font> thể hiện xác suất cao để xuyên giáp địch"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Tuy vậy, ngay cả khi vòng trong tâm ngắm có màu xanh lục, khả năng xuyên giáp <font color='#EE7000'>không phải một trăm phần trăm</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Súng không phải chính xác 100%, các phát bắn <font color='#EE7000'>có thể lệch khỏi trung tâm</font> vòng ngắm"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Vòng trong tâm ngắm hiển thị xác suất xuyên giáp địch. <font color='#EE7000'>Bật nó trong mục Thiết lập</font>."

msgid "penetration/chance/high"
msgstr "Xác suất cao"

msgid "penetration/chance/low"
msgstr "Xác suất thấp"

msgid "penetration/chance/medium"
msgstr "Xác suất vừa"
