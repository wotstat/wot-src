msgid "fullStats/alive"
msgstr "Người Sống sót"

msgid "fullStats/deathZone/closed/description"
msgstr "Khu vực Chết"

msgid "fullStats/deathZone/warning/description"
msgstr "Khu vực Sắp chết"

msgid "fullStats/description"
msgstr "Mục tiêu chính là trở thành người chơi (hoặc Trung đội) cuối cùng còn trụ lại. Thu thập các nguồn lực, nâng cấp xe của bạn và sống sót!"

msgid "fullStats/destroyed"
msgstr "Do bản thân diệt"

msgid "fullStats/icons/airDrop/description"
msgstr "Hàng thả dù: XP, hồi phục sức kháng cự, sửa mô-đun, sạc mọi Khả năng Chiến đấu, đạn dược."

msgid "fullStats/icons/corpseLoot/description"
msgstr "Chiến lợi phẩm: XP, hồi phục sức kháng cự, sửa mô-đun, sạc một số Khả năng Chiến đấu, đạn dược."

msgid "fullStats/icons/defaultLoot/description"
msgstr "Hàng tiếp tế: XP, xác suất sạc Khả năng Chiến đấu, đạn dược."

msgid "fullStats/icons/extendedLoot/description"
msgstr "Vật phẩm: XP, hồi phục sức kháng cự, sửa mô-đun, sạc Khả năng Chiến đấu, đạn dược."

msgid "fullStats/stPatrick/icons/corpseLoot/description"
msgstr "Chiến lợi phẩm: XP, hồi phục sức kháng cự, sửa mô-đun, sạc một số Khả năng Chiến đấu, đạn dược."

msgid "fullStats/stPatrick/icons/extendedLoot/description"
msgstr "Vật phẩm: XP, hồi phục HP, sửa mô-đun, cơ hội sạc một số Khả năng Chiến đấu, đạn dược."

msgid "fullStats/stPatrick/icons/shamrocks/description"
msgstr "Ấn May mắn có trong mọi loại Chiến lợi phẩm. Chúng có thể được quy đổi lấy phần thưởng sau trận ở Cửa hàng Cỏ ba lá."

msgid "fullStats/subTitle"
msgstr "Chiến đấu giành các nguồn lực có giá trị với một luật duy nhất: \"Không-có-luật-gì-cả\"."

msgid "fullStats/title"
msgstr "Săn Thiết giáp"
