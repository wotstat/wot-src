msgid "abilities/special/shortDescription/accuracyStacks"
msgstr "Tăng chính xác cho phát kế tiếp, ổn định tốt khi full chuẩn."

msgid "abilities/special/shortDescription/battleFury"
msgstr "Mỗi phát trúng xe địch sẽ tăng tốc độ nạp đạn vào súng trong một khoảng thời gian nhất định."

msgid "abilities/special/shortDescription/chargeShot"
msgstr "Tích nhiệt lên để cú bắn sau thấm đau hơn."

msgid "abilities/special/shortDescription/chargeableBurst"
msgstr "Cassette bắn Burst cho phép xả hai viên liền nhau cực nhanh."

msgid "abilities/special/shortDescription/concentrationMode"
msgstr "Tối đa hóa ổn định khi di chuyển và xoay, giúp bắn chuẩn hơn."

msgid "abilities/special/shortDescription/extraShotClip"
msgstr "Tự động tái nạp ở viên cuối, vốn vẫn có thể bắn trong lúc đang nạp."

msgid "abilities/special/shortDescription/heatingZonesGun"
msgstr "Một hệ thống làm mát chủ động, giúp cải thiện độ chính xác khi súng nguội dần."

msgid "abilities/special/shortDescription/improvedRamming"
msgstr "Tăng thiệt hại đâm/húc gây ra cho xe địch."

msgid "abilities/special/shortDescription/lowChargeShot"
msgstr "Một cơ chế súng đặc biệt cho phép bắn sớm hơn, cái giá là hỏa lực hiệu quả kém đi."

msgid "abilities/special/shortDescription/overheatGun"
msgstr "Hệ thống cho phép bắn liên thanh mà không cần chờ nạp đạn và kiểm soát cách súng sinh nhiệt khi khai hỏa."

msgid "abilities/special/shortDescription/overheatStacks"
msgstr "Đứng yên hoặc đi chậm giúp tăng sát thương và độ chính xác cho phát bắn kế tiếp."

msgid "abilities/special/shortDescription/pillboxSiegeMode"
msgstr "Tăng mạnh chính xác và tốc độ nạp đạn, nhưng giảm đáng kể khả năng cơ động."

msgid "abilities/special/shortDescription/powerMode"
msgstr "Tăng công suất động cơ, tích lũy tốc độ tối đa khi xe di chuyển càng lâu."

msgid "abilities/special/shortDescription/propellantAfterburnerGun"
msgstr "Hệ thống tích tụ năng lượng để tăng sát thương. Mức sạc càng cao, sát thương càng lớn."

msgid "abilities/special/shortDescription/rechargeableNitro"
msgstr "Các bộ áp Booster có thể kích hoạt bất cứ lúc nào để đột ngột bứt tốc."

msgid "abilities/special/shortDescription/stagedJetBoosters"
msgstr "Các khối cấp lực đẩy (Thruster) nhiên liệu rắn, tăng (Boost) khả năng bứt tốc, linh hoạt và điều động."

msgid "abilities/special/shortDescription/stanceDance"
msgstr "Sạc một trong hai khả năng đặc biệt: Tăng tốc độ hoặc cải thiện chính xác cho súng."

msgid "abilities/special/shortDescription/stationaryReload"
msgstr "Cho phép gián đoạn quá trình tái nạp và bắn trả kịp thời trong những khoảnh khắc quan trọng."

msgid "abilities/special/shortDescription/supportWeapon"
msgstr "Một số vũ khí phụ giúp tăng hỏa lực bên cạnh súng chính."

msgid "abilities/special/shortDescription/targetDesignator"
msgstr "Tăng thời gian địch bị lộ hình và thiệt hại phải chịu, hoặc làm nổi vị trí của nó bằng chỉ báo đặc biệt."

msgid "abilities/special/shortDescription/twinGun"
msgstr "Cho phép bắn đồng thời cả hai súng, nhưng thời gian nạp đạn sẽ lâu hơn."

msgid "abilities/special/shortDescription/wheeledDash"
msgstr "Một cơ chế đặc biệt giúp tăng công suất động cơ, khả năng tăng tốc và tốc độ tối đa trong khoảng thời gian ngắn."

msgid "characteristics/abilities/special/description/accuracyStacks"
msgstr "Đứng yên hoặc chạy chậm dưới một tốc độ nhất định giúp xe của bạn hiệu chỉnh Device tính đạn đạo Analog, tích lũy mức chính xác, khiến phát bắn kế tiếp chuẩn hơn. Vượt quá giới hạn tốc độ sẽ làm tạm dừng quá trình tích lũy cho tới lúc giảm tốc. Ở mức chính xác cao nhất, súng xe gần như ổn định hoàn hảo, phân tán cực thấp khi di chuyển hoặc xoay tháp pháo/thân. Hiệu ứng mất đi lúc khai hỏa."

msgid "characteristics/abilities/special/description/battleFury"
msgstr "Mỗi lần trúng địch lộ thiên bằng một viên đạn, bạn sẽ nhận một mức hiệu quả tái nạp, giúp tạm thời tăng tốc reload cho súng. Các mức độ sẽ cộng dồn theo từng phát trúng. Diệt xe địch bằng đạn sẽ cho thêm mức hiệu quả tái nạp."

msgid "characteristics/abilities/special/description/chargeShot"
msgstr "Nếu súng đã được nạp, bạn có thể bắt đầu làm nóng phát tiếp theo để tăng sát thương—mức nhiệt càng cao, Bonus cho sát thương trung bình càng lớn. Không thể đổi đạn trong khi làm nóng. Ở mức nhiệt cao nhất, đồng hồ sẽ đếm thời gian để bóp cò—nếu không bắn trước khi nó đếm hết, bạn sẽ tạm thời không thể khai hỏa trong vài giây."

msgid "characteristics/abilities/special/description/chargeableBurst"
msgstr "Đạt hai phát trúng-xuyên giáp xe địch kích hoạt cơ chế Burst, nạp một Cassette cho phép giải phóng hai viên nhanh liên tiếp với phát tiếp theo."

msgid "characteristics/abilities/special/description/concentrationMode"
msgstr "Gyro cân bằng khí nén giúp ổn định tối đa khi di chuyển thân và tháp pháo trong thời gian ngắn, cho phép vừa chạy vừa bắn chính xác hơn, phản ứng nhanh trước mối đe dọa bất ngờ."

msgid "characteristics/abilities/special/description/extraShotClip"
msgstr "Hệ thống tự động bắt đầu nạp Cassette mới khi còn một viên trong cái hiện tại. Nếu bắn viên cuối trong lúc đang nạp Cassette mới, thời gian reload sẽ bị kéo thêm vài giây. Bấm phím tắt \"Nạp lại Băng Đạn\" để bỏ hết, chỉ giữ viên cuối. Bấm phím tắt đó hai lần để nạp lại từ đầu một Cassette đã đầy."

msgid "characteristics/abilities/special/description/heatingZonesGun"
msgstr "Hệ thống giúp súng luôn mát, cho phép bắn chính xác cao. Khi khai hỏa, súng sẽ nóng lên, nhưng bắt đầu được làm nguội và trở lại thông số tối ưu trong lúc nạp đạn. Nhiệt độ càng cao, súng càng thay đổi vài thông số."

msgid "characteristics/abilities/special/description/improvedRamming"
msgstr "Xe này được cấu hình đặc biệt để đâm/húc, với nhiều cải tiến gây sát thương đâm/húc lớn hơn cho địch."

msgid "characteristics/abilities/special/description/lowChargeShot"
msgstr "Súng của xe này có thể bắn sớm: Các phát sạc đơn, khai hỏa trong khi nạp lại, có hiệu quả kém hơn; ngược lại, các phát sạc đầy tiêu chuẩn, được bắn sau lúc nạp xong, có tham số đạn đạo tối ưu."

msgid "characteristics/abilities/special/description/overheatGun"
msgstr "Súng này có thể bắn liên thanh mà không phải dừng chờ nạp viên tiếp theo. Tuy nhiên, mỗi phát đều sinh nhiệt: Càng nóng sẽ càng thay đổi thông số. Khai hỏa lâu khiến nòng quá nóng, không thể bắn cho đến khi nguội."

msgid "characteristics/abilities/special/description/overheatStacks"
msgstr "Đứng yên hoặc di chuyển chậm để tích nhiệt làm nóng, tăng sát thương và độ chính xác cho phát tiếp theo. Vượt quá giới hạn tốc độ sẽ dần làm giảm Bonus, trong khi việc bắn hoặc đổi đạn sẽ lập tức reset nó. Ở mức làm nóng cao nhất, xuyên giáp xe địch có ít HP hơn sát thương trung bình của bạn—tính cả Bonus làm nóng đã tích lũy—sẽ gây nổ gác đạn, lập tức phá hủy phương tiện đó."

msgid "characteristics/abilities/special/description/pillboxSiegeMode"
msgstr "Trong cơ chế này, độ chính xác, tốc độ nạp đạn, góc nâng/hạ của súng được tăng đáng kể, nhưng khả năng di chuyển (tốc độ tiến/lùi và dịch thân ngang/dọc) bị giới hạn nghiêm trọng. Các giá trị phần trăm được đưa ra để so với chế độ Tác xạ."

msgid "characteristics/abilities/special/description/powerMode"
msgstr "Cơ chế Direct Drive đẩy mạnh công suất động cơ và tốc độ tiến tối đa. Càng lái về trước lâu, tốc độ càng tích lũy, giúp đi mây về gió trên trận địa."

msgid "characteristics/abilities/special/description/propellantAfterburnerGun"
msgstr "Theo thời gian, hệ thống tự động tích lũy sạc điện tích, một phần sẽ được tiêu hao để tăng sát thương khi bắn. Sạc càng cao, sát thương cộng thêm càng lớn. Mặc định, hệ thống chỉ lưu trữ điện tích đến một giới hạn nhất định. Tắt giới hạn này cho phép sạc cao hơn nữa, mang lại sát thương cộng thêm lớn hơn nhiều, nhưng làm giảm độ mượt vận hành súng."

msgid "characteristics/abilities/special/description/rechargeableNitro"
msgstr "Booster Nhiên liệu Lỏng cung cấp một lượt tăng công suất động cơ để chiếm ưu thế vị trí trên trận địa—nhưng giới hạn tốc độ lùi và xoay xe. Chúng có thể bật/tắt bất cứ lúc nào, trừ trường hợp đã đạt giới hạn kích hoạt lại. Booster hoạt động sẽ nóng lên và bất khả dụng nếu chưa nguội, nghĩa là không thể dùng liên tục—vượt mức nhiệt tới hạn sẽ tạm thời vô hiệu hóa hoàn toàn. Hãy tính nước đi cẩn thận để không bị úp sọt."

msgid "characteristics/abilities/special/description/stagedJetBoosters"
msgstr "Các khối cấp lực đẩy (Thruster) nhiên liệu rắn, tăng (Boost) khả năng bứt tốc, linh hoạt và điều động của xe trong vài giây. Khác với bộ áp phản lực thông thường, hai Thruster trái–phải có thể hoạt động độc lập, cho phép xoay thân nhanh hơn và không hạn chế khả năng lùi. Chúng có thể kích hoạt được nhiều lần trong trận, nhưng cần thời gian hồi phục trước khi dùng tiếp."

msgid "characteristics/abilities/special/description/stanceDance"
msgstr "Tùy cơ chế đang tác dụng và mức sạc, xe có thể kích hoạt một trong hai khả năng: Afterburner phóng ion hoặc Sight cơ-điện Coincidence.\nAfterburner phóng ion tạm thời tăng công suất máy và tốc độ tiến/lùi tối đa. Sight cơ-điện Coincidence tạm thời giảm phân tán khi di chuyển, xoay thân/xoay súng; tăng chính xác; giảm nhẹ thời gian tái nạp."

msgid "characteristics/abilities/special/description/stationaryReload"
msgstr "Module tiếp đạn External cho phép gián đoạn quá trình tái nạp và bắt đầu bắn bất cứ lúc nào, miễn là còn một viên lên nòng. Trong lúc reload, tháp pháo cùng các thùng đạn ngoài của xe sẽ bị khóa, tạm thời không thể ngắm hoặc khai hỏa trừ khi ngắt quá trình này."

msgid "characteristics/abilities/special/description/supportWeapon"
msgstr "Xe này được trang bị bộ vũ khí phụ có chu trình nạp riêng, độc lập với súng chính, cho phép gây thêm thiệt hại vào thời điểm then chốt."

msgid "characteristics/abilities/special/description/targetDesignator"
msgstr "Laser Chốt Mục tiêu thêm hiệu ứng đặc biệt cho phát bắn tiếp theo, áp dụng vào bất kỳ kẻ địch nào ăn đạn. Hiệu ứng tùy thuộc mục tiêu có đang bị phát hiện tại thời điểm trúng hay không. Bắn trúng đối phương đã bị phát hiện sẽ đánh dấu nó—lộ hình lâu hơn, ăn đòn thấm hơn; bắn trúng kẻ thù chưa bị phát hiện: Làm nổi vị trí của nó bằng chỉ báo đặc biệt."

msgid "characteristics/abilities/special/description/twinGun"
msgstr "Gấp đôi sát thương, bắn đầm tay, đổi lại ì ạch, lệch tâm, xoay pháo rùa bò, ngắm lâu như nghỉ Tết. Hợp cận chiến, xồ vào!"

msgid "characteristics/abilities/special/description/wheeledDash"
msgstr "Sửa đổi cơ khí này nâng đáng kể khả năng tăng tốc, công suất động cơ và tốc độ tiến/lùi tối đa trong khoảng thời gian ngắn, cho phép phản ứng nhanh, khiến đối thủ bất ngờ bằng những pha cơ động linh hoạt. Giữ tốc độ cao sẽ tăng tốc hồi phục cơ chế."

msgid "characteristics/abilities/special/notes"
msgstr "Mọi giá trị được hiển thị là cao nhất có thể đối với xe. Ứng dụng kỹ thuật, thiết bị và vật phẩm có thể ảnh hưởng đến chúng nhưng sẽ không hiện ở đây."

