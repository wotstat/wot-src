msgid "abilities/common/description/autoLoaderGun"
msgstr "Cho phép bắn sê-ri đạn từ băng magazine từng viên một, với mỗi vòng tự động nạp lại theo thời gian."

msgid "abilities/common/description/autoLoaderGunBoost"
msgstr "Cho phép bắn sê-ri đạn từ băng magazine từng viên một, với mỗi vòng tự động nạp lại theo thời gian. Cung cấp Bonus cho tốc độ nạp viên tiếp theo trong khi reload."

msgid "abilities/common/description/autoShootGun"
msgstr "Bắn cả tràng liên thanh dồn sát thương mạnh, đổi lại xuyên kém và dễ lệch. Cận chiến là hiệu quả nhất."

msgid "abilities/common/description/damageMutable"
msgstr "Bắn đạn mâm hình sao, sát thương cao nhất trong bán kính 50 m. Xa hơn thì yếu dần, cận chiến chuẩn bài."

msgid "abilities/common/description/dualAccuracy"
msgstr "Hệ thống làm mát đặc biệt cho cơ chế ngắm kép: Nạp xong chờ tí, chính xác hơn hẳn. Chuẩn hơn sẽ có vòng ngắm nhỏ xíu hiện lên."

msgid "abilities/common/description/dualGun"
msgstr "Hệ thống súng đôi, bắn riêng hay bắn kép đều được. Cả loạt sát thương khủng, nhưng nạp đạn lâu hơn hẳn!"

msgid "abilities/common/description/hydraulicChassis"
msgstr "Cho phép thân xe thay đổi góc nâng, tạo cơ hội bắn từ nhiều vị trí hơn trong trận. Kích hoạt tùy nhiều điều kiện khác nhau."

msgid "abilities/common/description/hydraulicWheeledChassis"
msgstr "Dời bánh phụ, tăng tốc cực cao – đổi lại, lẹt đẹt khi đánh lái. Hợp để chạy xa, ập vào như trộm chó."

msgid "abilities/common/description/magazineGun"
msgstr "Cho phép bắn sê-ri đạn từ băng magazine, sau đó cần reload toàn bộ. Sốc sát thương cao, nhưng khiến xe như cá nằm trên thớt trong khi nạp lại. Chỉ có thể nạp cả băng cùng một lúc."

msgid "abilities/common/description/overheatGun"
msgstr "Súng này có thể bắn liên thanh mà không phải dừng chờ nạp viên tiếp theo. Tuy nhiên, mỗi phát đều sinh nhiệt: Càng nóng sẽ càng thay đổi thông số. Khai hỏa lâu khiến nòng quá nóng, không thể bắn cho đến khi nguội."

msgid "abilities/common/description/rocketAcceleration"
msgstr "Bật lên là máy gào, tốc chạy xé gió – phóng hơn ma đuổi! Nhưng lái khó như say rượu, đã bật là khỏi tắt thủ công."

msgid "abilities/common/description/siegeMode"
msgstr "Khi được kích hoạt, cơ chế đặc biệt này làm tăng và/hoặc thay đổi một số đặc tính chiến đấu cụ thể. Tốt nhất nên kích hoạt nếu đã vào vị trí và sẵn sàng nghênh chiến."

msgid "abilities/common/description/stun"
msgstr "Nổ gần làm địch choáng, không trúng vẫn ngáo, xe chạy chậm, bắn lệch, nạp lâu. Bị choáng sẽ hiện biểu tượng – thấy là đấm."

msgid "abilities/common/description/trackWithinTrack"
msgstr "Cho phép xe dù đứt xích vẫn lết tiếp nhưng chậm. Đứt thêm cái bên ngoài nữa càng làm giảm tốc độ, nhưng xoay với nhích vẫn được."

msgid "abilities/common/description/turboshaftEngine"
msgstr "Cho phép xe đi nhanh hơn nhiều nhưng giảm đáng kể các thông số vận hành súng."

msgid "abilities/common/description/twinGun"
msgstr "Khi được kích hoạt, cơ chế đặc biệt này giúp sát thương gấp đôi, cũng như tăng và/hoặc thay đổi một số đặc tính chiến đấu cụ thể. Tốt nhất nên dùng cận chiến."

msgid "abilities/common/name/autoLoaderGun"
msgstr "Tái nạp tự động"

msgid "abilities/common/name/autoLoaderGunBoost"
msgstr "Tái nạp tự động cải tiến"

msgid "abilities/common/name/autoShootGun"
msgstr "Autocannon"

msgid "abilities/common/name/damageMutable"
msgstr "Súng rãnh xoắn sâu"

msgid "abilities/common/name/dualAccuracy"
msgstr "Súng nguội"

msgid "abilities/common/name/dualGun"
msgstr "Súng đôi"

msgid "abilities/common/name/hydraulicChassis"
msgstr "Hệ giảm xóc thủy–khí"

msgid "abilities/common/name/hydraulicWheeledChassis"
msgstr "Chế độ siêu nhanh"

msgid "abilities/common/name/magazineGun"
msgstr "Hệ thống nạp tự động"

msgid "abilities/common/name/overheatGun"
msgstr "Autocannon Kiểm Thermal Overheat"

msgid "abilities/common/name/rocketAcceleration"
msgstr "Áp phản lực"

msgid "abilities/common/name/siegeMode"
msgstr "Chế độ tác xạ"

msgid "abilities/common/name/stun"
msgstr "Choáng"

msgid "abilities/common/name/trackWithinTrack"
msgstr "Xích phụ"

msgid "abilities/common/name/turboshaftEngine"
msgstr "Chế độ tăng áp"

msgid "abilities/common/name/twinGun"
msgstr "Chế độ bắn song song"

msgid "abilities/special/description/accuracyStacks"
msgstr "Bằng cách đứng yên hoặc di chuyển chậm, bạn dần xây dựng các mức chính xác để cải thiện phát bắn tiếp theo.\nỞ mức chính xác cao nhất, súng vận hành mượt, phân tán thấp ngay cả khi di chuyển hoặc xoay tháp pháo/thân xe."

msgid "abilities/special/description/battleFury"
msgstr "Mỗi lần trúng địch bằng một viên đạn, bạn sẽ nhận một mức hiệu quả tái nạp, giúp tạm thời tăng tốc reload cho súng. Các mức độ sẽ cộng dồn theo từng phát trúng. \nDiệt xe địch bằng đạn sẽ cho thêm mức hiệu quả tái nạp."

msgid "abilities/special/description/chargeShot"
msgstr "Nếu súng đã được nạp, bạn có thể bắt đầu làm nóng phát tiếp theo để tăng sát thương—mức nhiệt càng cao, hiệu quả càng lớn.\nỞ mức nhiệt cao nhất, sẽ có vài giây để bóp cò—nếu không, bạn sẽ tạm thời không thể bắn."

msgid "abilities/special/description/chargeableBurst"
msgstr "Đạt hai phát trúng-xuyên giáp xe địch kích hoạt cơ chế Burst, nạp một Cassette cho phép giải phóng hai viên nhanh liên tiếp với phát tiếp theo để gây thiệt hại cực lớn."

msgid "abilities/special/description/concentrationMode"
msgstr "Gyro cân bằng khí nén giúp ổn định tối đa khi di chuyển, xoay thân và tháp pháo, cho phép bắn chính xác hơn, phản ứng nhanh trước mối đe dọa bất ngờ, giao chiến hiệu quả từ chỗ nấp."

msgid "abilities/special/description/extraShotClip"
msgstr "Hệ thống tự động bắt đầu nạp Cassette mới khi còn một viên trong băng hiện tại, giúp sẵn sàng nghênh chiến. Bạn vẫn có thể bắn viên cuối trong quá trình này, nhưng làm vậy sẽ tăng thêm vài giây tái nạp."

msgid "abilities/special/description/heatingZonesGun"
msgstr "Hệ thống giúp súng luôn mát, cho phép bắn chính xác cao. Khi khai hỏa, súng sẽ nóng lên, nhưng bắt đầu được làm nguội và trở lại thông số tối ưu trong lúc nạp đạn. Nhiệt độ càng cao, súng càng thay đổi vài thông số."

msgid "abilities/special/description/improvedRamming"
msgstr "Dựa trên kinh nghiệm thiết kế từ các mẫu trước đó, chiếc xe này được cấu hình Đặc biệt cho các cuộc tấn công đâm chết người. Các gia cố cấu trúc cho phép nó gây ra nhiều thiệt hại hơn khi đâm vào xe đối phương, mang lại lợi thế trong cận chiến."

msgid "abilities/special/description/lowChargeShot"
msgstr "Súng của xe này có thể bắn sớm: Các phát sạc đơn, khai hỏa trong khi nạp lại, có hiệu quả kém hơn; ngược lại, các phát sạc đầy tiêu chuẩn, được bắn sau lúc nạp xong, có tham số đạn đạo tối ưu."

msgid "abilities/special/description/overheatGun"
msgstr "Súng này có thể bắn liên thanh mà không phải dừng chờ nạp viên tiếp theo. Tuy nhiên, mỗi phát đều sinh nhiệt: Càng nóng sẽ càng thay đổi thông số. Khai hỏa lâu khiến nòng quá nóng, không thể bắn cho đến khi nguội."

msgid "abilities/special/description/overheatStacks"
msgstr "Đứng yên hoặc di chuyển chậm để tích nhiệt làm nóng, tăng sát thương và độ chính xác cho phát tiếp theo. Ở mức làm nóng cao nhất, xuyên kẻ địch ít HP hơn sát thương trung bình của bạn sẽ gây nổ gác đạn, phá hủy phương tiện."

msgid "abilities/special/description/pillboxSiegeMode"
msgstr "Cơ chế này biến xe của bạn thành ụ súng kiên cố, chính xác vượt trội và nạp đạn nhanh hơn. Đổi lại, sự cơ động—tốc độ tiến/lùi và xoay ngang/dọc—bị hạn chế nghiêm trọng."

msgid "abilities/special/description/powerMode"
msgstr "Cơ chế này đẩy mạnh công suất động cơ và tốc độ tiến tối đa. Càng lái về trước lâu, tốc độ càng tích lũy, giúp đi mây về gió trên trận địa."

msgid "abilities/special/description/propellantAfterburnerGun"
msgstr "Hệ thống tích lũy điện tích theo thời gian; mức sạc càng cao, sát thương cộng thêm càng lớn. Điện tích bị giới hạn bởi một bộ limiter, có thể tắt đi để tăng Bonus sát thương lớn hơn, nhưng đánh đổi bằng độ mượt khi vận hành súng."

msgid "abilities/special/description/rechargeableNitro"
msgstr "Kích hoạt Booster nhiên liệu lỏng bất cứ lúc nào để bứt tốc khi cần nhất. Bộ áp sẽ nóng lên và phải để nguội trước khi dùng tiếp, còn nếu quá tới hạn nhiệt thì xác định — tạm tắt luôn."

msgid "abilities/special/description/stagedJetBoosters"
msgstr "Các khối cấp lực đẩy (Thruster) nhiên liệu rắn, tăng (Boost) khả năng bứt tốc, linh hoạt và điều động của xe trong vài giây. Hai Thruster trái–phải có thể hoạt động độc lập, cho phép xoay thân nhanh hơn và không hạn chế khả năng lùi."

msgid "abilities/special/description/stanceDance"
msgstr "Tùy cơ chế đang tác dụng và mức sạc, xe có thể kích hoạt một trong hai khả năng: \nAfterburner phóng ion: Tăng công suất máy và tốc độ. \nSight cơ-điện Coincidence: Giảm phân tán và thời gian nạp đạn, tăng chính xác."

msgid "abilities/special/description/stationaryReload"
msgstr "Module này giúp bạn luôn sẵn sàng nghênh chiến bằng cách cho phép gián đoạn quá trình tái nạp bất cứ lúc nào nếu còn ít nhất một viên đã lên nòng. Bấm phím tắt tương ứng để làm thế, chờ tí, bắn, rồi trở lại nạp thủ công hoặc kệ cho băng tự nạp khi hết đạn."

msgid "abilities/special/description/supportWeapon"
msgstr "Bấm phím kích hoạt để bắn vũ khí phụ vào mục tiêu. Hỏa lực bổ trợ này có chu kỳ nạp riêng, độc lập với súng chính."

msgid "abilities/special/description/targetDesignator"
msgstr "Phát tiếp theo sẽ áp dụng một hiệu ứng dựa trên trạng thái lộ hình của địch. Bắn trúng đối phương đã bị phát hiện sẽ đánh dấu nó—lộ hình lâu hơn, ăn đòn thấm hơn. Bắn trúng kẻ thù chưa bị phát hiện: Làm nổi vị trí của nó bằng chỉ báo đặc biệt."

msgid "abilities/special/description/twinGun"
msgstr "Gấp đôi sát thương, bắn đầm tay, đổi lại ì ạch, lệch tâm, xoay pháo rùa bò, ngắm lâu như nghỉ Tết. Hợp cận chiến, xồ vào!"

msgid "abilities/special/description/wheeledDash"
msgstr "Sửa đổi cơ khí này nâng đáng kể khả năng tăng tốc, công suất động cơ và tốc độ tiến/lùi tối đa trong khoảng thời gian ngắn, cho phép phản ứng nhanh, khiến đối thủ bất ngờ bằng những pha cơ động linh hoạt."

