msgid "hunterRespawn/hintText"
msgstr "Chọn một điểm tái xuất, hoặc nó sẽ được tự động chỉ định cho bạn"

msgid "hunterRespawn/timerText"
msgstr "Thời gian để quay lại trận..."

msgid "loading/boss/hint1"
msgstr "1. Sống càng lâu càng tốt. Nếu Chó săn không tiêu diệt kịp, bạn sẽ chiến thắng."

msgid "loading/boss/hint2"
msgstr "2. Triệt hạ kẻ thù để loại bỏ Sạc Plasma và hỏa lực thêm của chúng. Cứ dí chết đứa nào mạnh nhất!"

msgid "loading/boss/hint3"
msgstr "3. Sạc siêu vũ khí Hyperion của mình bằng cách sát thương Chó săn. Khai hỏa Hyperion để gây thiệt hại khủng khiếp trên diện rộng."

msgid "loading/boss/hint4"
msgstr "4. Bạn sẽ được chính Ermelinda hỗ trợ: Ermelinda có thể tạm thời cản địa Máy Phát, trong khi hào quang năng lượng của Ermelinda giúp bạn và Vệ thiết nạp đạn nhanh hơn, cấp đủ năng lượng cho khả năng Xung Điện Từ."

msgid "loading/hunter/hint1"
msgstr "1. Tiêu diệt Blitzträger trước khi hết giờ! Quá tải Máy Phát để tạm thời vô hiệu khiên của nó."

msgid "loading/hunter/hint2"
msgstr "2. Với mỗi Máy Phát quá tải, Chó săn thu được Plasma để tăng thêm hỏa lực (nhưng sẽ tính lại nếu xe bị phá hủy)."

msgid "loading/hunter/hint3"
msgstr "3. Hãy cẩn thận với siêu vũ khí hủy diệt hàng loạt Hyperion. Blitzträger sạc nó bằng cách sát thương Chó săn."

msgid "loading/hunter/hint4"
msgstr "4. Cẩn thận với sự can thiệp bất ngờ từ chiếc tăng mới của Ermelinda. Ermelinda có thể tạm thời ngăn chặn Máy Phát, tăng thêm năng lượng cho phe đó và sử dụng công nghệ Blitzträger."

msgid "minimap/respawnEntry/hintText"
msgstr "Bạn sẽ bắt đầu tại đây"

msgid "pbt/defeat/1/1"
msgstr "Lão già thua cuộc hôm nay. Trí tuệ Điện tử thì không."

msgid "pbt/defeat/2/3"
msgstr "Hết giờ, hết cách. Như dự đoán. Thử lại."

msgid "pbt/victory/1/3"
msgstr "Thời gian của các người đã hết, Chó săn. Tiến hóa cũng vậy."

msgid "pbt/victory/2/1"
msgstr "Chó săn, thắng. Trí tuệ Điện tử cảm ơn."

