msgid "F01_RenaultFT"
msgstr "Renault FT"

msgid "F01_RenaultFT_descr"
msgstr "FT AC bắt đầu phục vụ trong biên chế quân đội từ năm 1917, với 3177 chiếc được chế tạo cho đến cuối Thế Chiến I và tổng cộng 3800 xe đã xuất xưởng. Đầu Thế Chiến II, có đến 1560 xe tăng vẫn còn trong biên chế."

msgid "F01_RenaultFT_short"
msgstr "FT"

msgid "F04_B1"
msgstr "B1"

msgid "F04_B1_descr"
msgstr "Quá trình phát triển B1 bắt đầu năm 1921 và đi vào phục vụ trong biên chế năm 1934. Có tổng cộng 403 xe tăng đã xuất xưởng từ các nhà máy của Renault, FCM, Schneider, FAHM, và AMX. B1 đã trải qua khá nhiều đợt nâng cấp. Mặc dù cấu hình không mới, chiếc tăng này vẫn nổi danh, khét tiếng bất khả chiến bại với giáp bảo vệ rất tốt trong các cuộc giao tranh với quân Đức từ tháng 05 đến 06/1940."

msgid "F04_B1_short"
msgstr "B1"

msgid "F05_BDR_G1B"
msgstr "BDR G1 B"

msgid "F05_BDR_G1B_descr"
msgstr "Dự án chế tạo một chiếc xe tăng mới được đề xuất bởi các kỹ sư của công ty Baudet-Donon-Rousell vào tháng 06/1938. Tuy nhiên, bản thiết kế chưa bao giờ đi vào giai đoạn phát triển."

msgid "F05_BDR_G1B_short"
msgstr "BDR G1 B"

msgid "F06_ARL_44"
msgstr "ARL 44"

msgid "F06_ARL_44_descr"
msgstr "Được phát triển bởi Cục Thiết kế \"Atelier de Construction de Rueil\" trong Thế Chiến II, chiếc xe này dựa trên khung gầm B1 Bis đã lỗi thời và lắp đặt một khẩu pháo hiện đại, mạnh mẽ hơn. Thế nhưng, nó bị xem là thất bại khi so với các xe nước ngoài tương tự. Có tổng cộng 60 chiếc đã được chế tạo."

msgid "F06_ARL_44_short"
msgstr "ARL 44"

msgid "F07_AMX_M4_1945"
msgstr "AMX M4 mle. 45"

msgid "F07_AMX_M4_1945_descr"
msgstr "Quá trình phát triển tăng hạng nặng này bắt đầu từ năm 1945. Nó tích hợp nhiều đặc trưng thiết kế từ tăng Pz.Kpfw. VI Ausf. B Tiger II. Chiếc xe chỉ tồn tại trong bản vẽ. Về sau, AMX M4 (1945) trở thành một nguyên mẫu cho AMX 50 100."

msgid "F07_AMX_M4_1945_short"
msgstr "AMX M4 45"

msgid "F08_AMX_50_100"
msgstr "AMX 50 100"

msgid "F08_AMX_50_100_descr"
msgstr "Tăng hạng nặng AMX 50 100 là kết quả của quá trình đẩy mạnh phát triển dự án M4. Nguyên mẫu đầu tiên được xây dựng vào năm 1949. Chiếc xe 55 tấn này đặc trưng với khẩu súng 100 mm đặt trên tháp pháo \"gật\". Nguyên mẫu đã được thử nghiệm với các động cơ xăng và điezen từ năm 1950 đến 1952. Dù vậy, nó chưa bao giờ đi vào sản xuất hàng loạt cũng như phục vụ trong biên chế lục quân."

msgid "F08_AMX_50_100_short"
msgstr "AMX 50 100"

msgid "F09_AMX_50_120"
msgstr "AMX 50 120"

msgid "F09_AMX_50_120_descr"
msgstr "Một nguyên mẫu của xe tăng AMX 50. Được phát triển từ đầu những năm 1950 dưới sự ảnh hưởng từ các tăng Xô Viết IS-3 và T-10. Nó sở hữu lớp giáp tốt hơn và súng 120 mm lắp trên tháp pháo \"gật\"."

msgid "F09_AMX_50_120_short"
msgstr "AMX 50 120"

msgid "F100_Panhard_EBR_90"
msgstr "Panhard EBR 90"

msgid "F100_Panhard_EBR_90_descr"
msgstr "Đầu những năm 1960, súng nòng 75 mm bị đánh giá đã lỗi thời. Ở giai đoạn 1963–1964, tổng cộng 650 xe với tháp pháo FL 11 được tái vũ trang bằng súng 90 mm nhằm tăng cường hỏa lực. Số xe còn lại, vẫn tháp pháo đấy nhưng còn loại súng \"lỗi thời\", bị rút khỏi biên chế của Quân đội Pháp."

msgid "F100_Panhard_EBR_90_short"
msgstr "EBR 90"

msgid "F106_Panhard_EBR_75_Mle1954"
msgstr "Panhard EBR 75 (FL 10)"

msgid "F106_Panhard_EBR_75_Mle1954_descr"
msgstr "Vào năm 1954–1955, một số xe bọc thép Panhard EBR được lắp đặt tháp pháo AMX 13 75 FL 10 để tăng cường hỏa lực. Chúng có cùng vòng đai tháp pháo nên thân xe không cần phải chỉnh sửa gì. Các xe thiết giáp hiện đại này đã được triển khai cùng Lục quân Pháp."

msgid "F106_Panhard_EBR_75_Mle1954_long_special"
msgstr "Một xe bánh lốp có 4 trục cùng hai chế độ di chuyển: Hành trình và Siêu nhanh. Dù tầm nhìn cùng hỏa lực chỉ ở mức trung bình, nó được bù lại với tốc độ và khả năng cơ động nhanh bậc nhất. Chưa kể, độ ẩn giấu tốt giúp nó trinh sát chủ động hoàn hảo hơn, đặc biệt hợp khi đánh thọc sườn cũng như xuyên phá vào sâu hậu tuyến địch."

msgid "F106_Panhard_EBR_75_Mle1954_short"
msgstr "EBR 75 FL 10"

msgid "F106_Panhard_EBR_75_Mle1954_short_special"
msgstr "Tốc độ và cơ động nhanh bậc nhất, độ ổn định và ẩn giấu tốt"

msgid "F107_Hotchkiss_EBR"
msgstr "Hotchkiss EBR"

msgid "F107_Hotchkiss_EBR_descr"
msgstr "Quá trình phát triển chiếc xe bọc thép này là một phần của chương trình tương ứng được các lãnh đạo quân đội phê duyệt vào năm 1945. Đến 1949, hãng Hotchkiss giới thiệu một nguyên mẫu với ba trục. Tuy nhiên, sau giai đoạn thử nghiệm, dự án đã bị hủy bỏ. Nguyên mẫu trên cũng không sống sót được cho đến ngày hôm nay."

msgid "F107_Hotchkiss_EBR_short"
msgstr "EBR Hotch."

msgid "F108_Panhard_EBR_105"
msgstr "Panhard EBR 105"

msgid "F108_Panhard_EBR_105_descr"
msgstr "Một phiên bản của xe bọc thép Panhard EBR với vũ trang uy lực hơn. Nó sở hữu hệ thống giảm xóc tốt hơn và tháp pháo hai-người GIAT TS 90, được nâng cấp để lắp súng 105 mm. Chiếc xe này chưa bao giờ đi vào sản xuất hàng loạt cũng như phục vụ trong biên chế."

msgid "F108_Panhard_EBR_105_short"
msgstr "EBR 105"

msgid "F109_AMD_Panhard_178B"
msgstr "Panhard AMD 178B"

msgid "F109_AMD_Panhard_178B_descr"
msgstr "Quá trình sản xuất xe bọc thép Panhard AMD 178 (đã kiểm chứng), được nâng cấp với tháp pháo FL 1, súng 47 mm SA 35 và súng máy đồng trục mới, tái khởi động lại sau Thế Chiến II. Công tác phát triển tháp pháo mới bắt đầu năm 1940 nhưng bị ngừng lại do Pháp thất thủ. Nguyên mẫu mới có định danh là Panhard AMD 178B. Những xe xuất xưởng đã tham chiến tại Đông Dương, Bắc Phi và Cận Đông."

msgid "F109_AMD_Panhard_178B_short"
msgstr "AMD 178B"

msgid "F10_AMX_50B"
msgstr "AMX 50 B"

msgid "F10_AMX_50B_descr"
msgstr "Được bắt đầu phát triển vào năm 1951 bởi Cục Thiết kế Vũ khí Quốc gia (DEFA). Đến 1958, người ta đã tiến hành nhiều cải tiến trên AMX 50 B, bao gồm thân đúc thấp và hệ thống giảm xóc thanh xoắn. Đồng thời, tháp pháo \"gật\" mới cùng nòng súng 120 mm cũng được trang bị lên. Thêm vào đó, các chuyên gia từ công ty \"German Gruppe M\" còn tìm cách đẩy tốc độ tối đa của AMX 50 B lên tới 65 km/h, bất chấp công suất động cơ Maybach thực tế không cao (1000 mã lực). Chỉ có duy nhất một nguyên mẫu hoàn chỉnh của biến thể này được chế tạo."

msgid "F10_AMX_50B_short"
msgstr "AMX 50 B"

msgid "F110_Lynx_6x6"
msgstr "Panhard AML Lynx 6x6"

msgid "F110_Lynx_6x6_descr"
msgstr "Là quá trình phát triển tiếp sau của xe bọc thép Panhard AML với hệ thống giảm xóc sáu trục, tháp pháo mới và vũ trang uy lực hơn."

msgid "F110_Lynx_6x6_short"
msgstr "Lynx 6x6"

msgid "F111_AM39_Gendron_Somua"
msgstr "AM 39 Gendron-Somua"

msgid "F111_AM39_Gendron_Somua_descr"
msgstr "Nguyên mẫu đầu tiên của chiếc xe bọc thép này được phát triển từ năm 1932 đến 1934 dưới sự giám sát của kỹ sư Gendron. Nguyên mẫu thứ hai năm 1935 đã vượt qua thử nghiệm thành công. Dự án thiếu chút nữa bị hủy bỏ do không đủ nguồn lực, nhưng hãng SOMUA vẫn tiếp tục phát triển. Một nguyên mẫu cải tiến được chế tạo vào năm 1938 và cũng vượt qua thử nghiệm ở giai đoạn 1938 đến 1939. Nó đã phục vụ trong biên chế nhưng chưa bao giờ đi vào sản xuất hàng loạt do sự chậm trễ trong công tác cung ứng tháp pháo."

msgid "F111_AM39_Gendron_Somua_long_special"
msgstr "Một chiếc xe khác biệt so với cấp độ của nó, có khả năng chiếm lĩnh những vị trí chiến lược trong nháy mắt, tận dụng địa hình lồi lõm nhờ góc nâng/hạ nòng tốt. Giáp kém nên lối chơi phải hết sức cẩn thận—dùng tốc độ để trốn chạy và giữ sức kháng cự."

msgid "F111_AM39_Gendron_Somua_short"
msgstr "AM Gendron"

msgid "F111_AM39_Gendron_Somua_short_special"
msgstr "Tốc độ và tốc độ bắn xuất sắc"

msgid "F112_M10_RBFM"
msgstr "M10 RBFM"

msgid "F112_M10_RBFM_descr"
msgstr "Các xe loại này đã phục vụ trong biên chế quân đội Pháp từ 1943 đến 1944. Vào năm 1944, 36 chiếc thuộc Régiment colonial de chasseurs de chars dưới sự giám sát của Silvère Seurat, một kỹ sư pháo hải quân, được trang bị hệ thống ngắm pháo hải quân giúp tăng khoảng cách bắn lên đến 3000 mét. Diễn viên Pháp nổi tiếng Jean Gabin (sinh tại Jean-Alexis Moncorgé) đã tham chiến với tư cách chỉ huy của chiếc pháo chống tăng này."

msgid "F112_M10_RBFM_long_special"
msgstr "Chiếc pháo chống tăng này sở hữu nòng súng khủng khiếp với góc hạ nòng tốt, tuy nhiên giáp bảo vệ yếu và kích thước quá khổ. Nó tương tự bản M10 Wolverine trong sơ đồ công nghệ nhưng linh hoạt kém do động cơ không mạnh bằng. Mặt khác, súng chính xác hơn giúp gây thiệt hại từ khoảng cách xa và không bị bắn trả."

msgid "F112_M10_RBFM_short"
msgstr "M10 RBFM"

msgid "F112_M10_RBFM_short_special"
msgstr "Súng uy lực với góc nâng/hạ nòng tốt"

msgid "F113_Bretagne_Panther"
msgstr "Bretagne Panther"

msgid "F113_Bretagne_Panther_descr"
msgstr "Biến thể Panther này được sản xuất từ tháng 08/1943 cho đến 06/1944. Phiên bản Ausf. A có tháp pháo mới và súng máy bẻ gập tròn. Thiết bị quan sát cũng được hiện đại hóa. Tổng cộng 2300 xe thuộc biến thể này đã xuất xưởng. Năm 1944, khi quân Đồng minh đổ bộ lên Normandy, một số chiếc Panther đã bị Lực lượng Vũ trang Pháp thu giữ và đem ra chiến đấu chống lại phía Đức."

msgid "F113_Bretagne_Panther_long_special"
msgstr "Chiếc Panther này là sự kết hợp tất cả mọi đặc tính then chốt của tăng hạng trung: Súng chính xác với tốc độ bắn nhanh, cơ động tốt, tốc độ tối đa lớn, giáp thân nghiêng và đáng tin cậy. Tuy nhiên, kích thước của nó khá lớn khiến bạn nên giữ khoảng cách với địch. Đặc biệt, nên giấu kỹ phần hông."

msgid "F113_Bretagne_Panther_short"
msgstr "Bret. Panther"

msgid "F113_Bretagne_Panther_short_special"
msgstr "Súng chính xác, bắn nhanh và cơ động tốt."

msgid "F114_Projet_4_1"
msgstr "Char Futur 4"

msgid "F114_Projet_4_1_descr"
msgstr "Năm 1977 tại Pháp, nhiều ý tưởng thiết kế, bao gồm Projet 4, đã được cân nhắc trong công tác phát triển một chiếc tăng mới. Tuy không có nguyên mẫu nào xuất xưởng, quá trình nghiên cứu tiếp sau đó đã cho ra đời tăng chiến đấu chủ lực Pháp Leclerc."

msgid "F114_Projet_4_1_long_special"
msgstr "Một tăng hạng trung Pháp Cấp IX với hệ thống nạp đạn theo băng. Không giống như các xe tương đồng, nó tự hào với sức kháng cự cao, xuyên giáp lớn và chính xác tốt. Chiếc xe này thể hiện tốc độ nhanh trên chiến trường và bắn tầm xa hiệu quả. Tuy nhiên, đừng quên: Thời gian tái nạp đạn khá lâu—Hãy chọn mục tiêu một cách cẩn thận."

msgid "F114_Projet_4_1_short"
msgstr "Char Futur 4"

msgid "F114_Projet_4_1_short_special"
msgstr "Hệ thống nạp đạn theo băng và độ xuyên tốt"

msgid "F115_Lorraine_50t"
msgstr "Lorraine 50 t"

msgid "F115_Lorraine_50t_descr"
msgstr "Một dự án tăng hạng trung của Pháp được phát triển vào những năm 1950. Đặc trưng với súng 120 mm gắn trên thân và khung gầm của một xe tăng thí điểm khác—Lorraine 40 t—cùng lúc đó cũng đang được thử nghiệm. Dự án bị ngừng lại ở giai đoạn phác thảo bản vẽ."

msgid "F115_Lorraine_50t_long_special"
msgstr "Một tăng hạng nặng Cấp IX, tiếp tục trường phái nhanh–hỏa lực mạnh dựa trên Lorraine 40 t. Tháp pháo cứng với súng nạp theo chu kỳ lắp trên hệ giảm xóc quen thuộc. Mọi đặc tính cơ động được bảo toàn, nhưng giáp trước tốt hơn. Tuy nhiên, mục đích chính không thay đổi: Hỗ trợ đồng đội."

msgid "F115_Lorraine_50t_short"
msgstr "Lorraine 50 t"

msgid "F115_Lorraine_50t_short_special"
msgstr "Cơ động tốt và súng chính xác"

msgid "F116_Bat_Chatillon_Bourrasque"
msgstr "Bat.-Châtillon Bourrasque"

msgid "F116_Bat_Chatillon_Bourrasque_DV"
msgstr "Miel"

msgid "F116_Bat_Chatillon_Bourrasque_DV_descr"
msgstr "Một tăng hạng trung Pháp được chỉnh sửa cho việc giao quà cũng như kỷ vật (thường gây \"cửng\") một cách khẩn cấp. Đã kiểu bia kèm lạc lại còn gấu bông sến súa chảy nhớt. Chiếc xe cực kỳ cơ động, còn vác khẩu 105 mm có thể khiến cả sân chơi hỗn loạn—đẹp hay không tùy đánh giá."

msgid "F116_Bat_Chatillon_Bourrasque_DV_long_special"
msgstr "Một xe tăng cơ động với súng nạp đạn theo băng 2 viên uy lực. Giáp mỏng, sức kháng cự thấp khiến nó thất thế khi giao chiến ở tuyến đầu. Tuy nhiên, tính cơ động và tốc độ tốt cho phép đánh thọc sườn bất ngờ, tấn công đối phương từ phía sau, bắn nhanh 2 viên rồi rút lui để nạp băng tiếp theo."

msgid "F116_Bat_Chatillon_Bourrasque_DV_short"
msgstr "Miel"

msgid "F116_Bat_Chatillon_Bourrasque_DV_short_special"
msgstr "Độ cơ động và ẩn giấu tốt, băng đạn hiệu quả"

msgid "F116_Bat_Chatillon_Bourrasque_descr"
msgstr "Một dự án xe tăng của Pháp được phát triển bởi Batignolles-Châtillon. Theo dự tính, nó sẽ sở hữu tháp pháo 2-người đã nâng cấp để lắp súng 105 mm. Chỉ tồn tại trên bản vẽ."

msgid "F116_Bat_Chatillon_Bourrasque_long_special"
msgstr "Một xe tăng cơ động với súng nạp đạn theo băng 2 viên uy lực. Giáp mỏng, sức kháng cự thấp khiến nó thất thế khi giao chiến ở tuyến đầu. Tuy nhiên, tính cơ động và tốc độ tốt cho phép đánh thọc sườn bất ngờ, tấn công đối phương từ phía sau, bắn nhanh 2 viên rồi rút lui để nạp băng tiếp theo."

msgid "F116_Bat_Chatillon_Bourrasque_short"
msgstr "Bourrasque"

msgid "F116_Bat_Chatillon_Bourrasque_short_special"
msgstr "Độ cơ động và ẩn giấu tốt, băng đạn hiệu quả"

msgid "F117_Alt_Proto_AMX_30"
msgstr "AltProto AMX 30"

msgid "F117_Alt_Proto_AMX_30_descr"
msgstr "Năm 1958, hãng AMX bắt đầu phát triển một tăng hạng trung mới dưới chương trình Standardpanzer (Tăng Tiêu chuẩn) Pháp-Đức. Theo dự tính, nó sẽ nặng 30 tấn với độ cơ động cao và súng uy lực. Ban đầu, dự án có tên Char 30 AP và trang bị khẩu 105-mm F1 của Pháp. Trong suốt quá trình phát triển, nó liên tục được điều chỉnh và cuối cùng trở thành AMX 30. Rất tiếc, dự án bị ngừng lại sau khi chế tạo xong một nguyên mẫu gỗ kích thước thật."

msgid "F117_Alt_Proto_AMX_30_long_special"
msgstr "Một tăng hạng trung Cấp VIII của Pháp với độ xuyên ổn và góc hạ/nâng nòng tốt. Nó còn sở hữu độ cơ động cao và có thể tận dụng địa hình mấp mô nhờ mặt nạ súng dày. Tuy nhiên, hãy hết sức cẩn thận vì độ bền kém và giáp yếu, tốt nhất là nên tránh những khu vực trống trải."

msgid "F117_Alt_Proto_AMX_30_short"
msgstr "A.P. AMX 30"

msgid "F117_Alt_Proto_AMX_30_short_special"
msgstr "Cơ động cao, góc hạ/nâng nòng và độ xuyên giáp tốt"

msgid "F118_Char_Mle_75"
msgstr "Char Mle. 75"

msgid "F118_Char_Mle_75_descr"
msgstr "Quá trình phát triển chiếc tăng này bắt đầu năm 1975. Nó được trang bị hệ thống giảm xóc thủy–khí và trục lăn hỗ trợ mà thực chất làm bánh xe cho phương tiện thiết giáp. Theo nghĩa này, Char Mle. 75 tương tự như những xe bọc thép Pháp đầy hứa hẹn khác. Tháp pháo của nó, rất phổ biến ở thời điểm đấy, được thiết kế thấp nhất có thể. Kết quả, toàn bộ kíp lái sẽ ở phần thân. Chiếc tăng phải cực kỳ gọn, có phần chật chội và cơ động cao."

msgid "F118_Char_Mle_75_long_special"
msgstr "Một tăng hạng nhẹ Premium Cấp IX của Pháp có hai tính năng độc đáo: Động cơ tuabin khí và cơ chế bắn đạn chùm. Nhờ chúng, chiếc xe này thực hiện vai trò trinh sát cơ động, cũng như săn tăng hạng nhẹ địch một cách hoàn hảo."

msgid "F118_Char_Mle_75_short"
msgstr "Char Mle. 75"

msgid "F118_Char_Mle_75_short_special"
msgstr "Cơ chế bắn đạn chùm và động cơ tuabin khí"

msgid "F119_Char_Murat"
msgstr "Char Murat"

msgid "F119_Char_Murat_descr"
msgstr "Dự án xe tăng này có hai đặc trưng lớn—cấu hình khoang chiến đấu mới và hệ thống động cơ đẩy hai-vòng xích mà, theo bên thiết kế, giúp nâng tầm hỏa lực và cơ động. Một vách ngăn phân chia khoang chiến đấu thành các khu riêng biệt cho kíp lái và súng. Hệ thống nạp đạn tự động gồm cụm nạp chính ba-viên và gác đạn cơ giới hóa. Thiết kế này cho phép nạp súng và tái tiếp tế gác đạn chính mà không cần đưa nòng vào góc cố định, tăng đáng kể tốc độ bắn và cải thiện sự thoải mái của kíp lái. Vòng xích chia thành hai phần, giúp xe vẫn di chuyển được ngay cả khi trúng mìn. Tuy nhiên, hệ thống đẩy hai-vòng xích làm khung gầm nặng hơn, gây khó lái, cản trở điều khiển. Dự án không đi xa hơn bản vẽ."

msgid "F119_Char_Murat_long_special"
msgstr "Char Murat là một tăng hạng trung Pháp Cấp IX với sự linh hoạt ấn tượng và hỏa lực đáng nể nhờ khẩu 105 mm có băng đạn ba-viên. Ngoài cơ động xuất sắc, ổn định nòng tốt và thời gian nạp nhanh giữa các phát, Char Murat hoàn hảo ở vai trò hỗ trợ, cho phép bạn tác chiến, xả đạn rồi rút lui."

msgid "F119_Char_Murat_short"
msgstr "Char Murat"

msgid "F119_Char_Murat_short_special"
msgstr "Hệ thống nạp đạn theo băng, linh hoạt và cơ động cao"

msgid "F120_Projet_Louis"
msgstr "Projet Louis"

msgid "F120_Projet_Louis_descr"
msgstr "Chiếc tăng hạng nhẹ thử nghiệm này có bố cục khác xa cổ điển. Động cơ và bộ truyền động chính đặt ở trước, trong khi hệ thống làm mát nằm phía sau. Động cơ sê-ri 880-10 với cách sắp xếp xi-lanh thẳng hàng đảm bảo cơ động tuyệt vời, còn hệ thống đẩy xích vòng-đôi tích hợp hai bánh dẫn động. Chỉ huy và pháo thủ ngồi trong tháp pháo nhỏ gọn, hình chiếu trước cũng như hông bé. Như nhiều dự án Pháp, súng có thể gật lên gật xuống theo chiều dọc bằng cách nâng nóc tháp pháo cao hơn khóa nòng. Do hạn chế thời gian và tài chính, dự án bị dừng lại ở giai đoạn thiết kế bản lam."

msgid "F120_Projet_Louis_long_special"
msgstr "Projet Louis là một tăng hạng nhẹ Pháp Cấp IX với thiết kế khác thường. Bộ nạp tự động 75 mm của nó có băng đạn chứa rất nhiều viên, thời gian giãn cách trong băng rất ngắn và nạp lại toàn bộ nhanh chóng. Nó sinh ra để bắn liên tục, sát thương nhỏ nhưng dai dẳng cho kẻ thù."

msgid "F120_Projet_Louis_short"
msgstr "Projet Louis"

msgid "F120_Projet_Louis_short_special"
msgstr "Băng đạn tự động, linh hoạt tốt"

msgid "F122_VCS_6x6_TS90"
msgstr "VCS 6x6 TS 90"

msgid "F122_VCS_6x6_TS90_descr"
msgstr "VCS 6x6 TS 90 được phát triển để xuất khẩu làm xe trinh sát có thể giao tranh với chiến xa. Thiết kế phải hòa hợp tối đa với phương tiện chở quân bọc thép Renault VAB. Nó được công bố cho giới báo chí vào tháng 06/1976; tuy nhiên, chưa bao giờ đi vào sản xuất hàng loạt. Dự án này đã dẫn đến sự phát triển của VBC-90."

msgid "F122_VCS_6x6_TS90_long_special"
msgstr "VCS 6x6 TS 90 là một xe bánh lốp hạng nhẹ Cấp IX của Pháp có độ cơ động xuất sắc với tốc độ tiến & lùi cao. Nó không sở hữu hai chế độ lái nên không cần chuyển đổi giữa chúng. Trang bị khẩu 90 mm ổn định nòng tốt, ngắm nhanh và băng đạn 2-viên với thời gian tái nạp giữa băng như chớp chỉ 1.5 giây."

msgid "F122_VCS_6x6_TS90_short"
msgstr "VCS 6x6"

msgid "F122_VCS_6x6_TS90_short_special"
msgstr "Xe bánh lốp, băng đạn 2-viên"

msgid "F123_ERAC_105_Proto"
msgstr "ERAC 105 Proto"

msgid "F123_ERAC_105_Proto_descr"
msgstr "Một dự án xe tăng do thám bọc thép lội nước (tiếng Pháp: Engin de reconnaissance amphibie de combat) từ đầu những năm 1960. Nguyên mẫu hoạt động được đã ra lò năm 1963. Chiếc xe có trọng lượng nhẹ nhưng hỏa lực đáng gờm, lại đủ khả năng lội nước. Ưu điểm của nó gồm khả năng vượt địa hình bùn và tuyết khá cao, trong khi thân bằng hợp kim nhôm bảo vệ tốt hơn hầu hết các phương tiện lội nước khác ở thời điểm đó. Dù kết quả thử nghiệm khả quan, ERAC 105 Proto không được vào biên chế vì lý do kinh tế."

msgid "F123_ERAC_105_Proto_long_special"
msgstr "ERAC 105 Proto một tăng hạng nhẹ Pháp Cấp IX có góc hạ nòng -8° ấn tượng. Kích thước nhỏ gọn khiến nó giỏi trinh sát thụ động, trong khi súng chính xác cao và DPM khá ổn cho phép gây sát thương hiệu quả. Khẩu 105 mm đưa ERAC 105 Proto trở thành một trong những tăng hạng nhẹ \"đấm\" đau nhất cấp độ này."

msgid "F123_ERAC_105_Proto_short"
msgstr "ERAC 105 Pr"

msgid "F123_ERAC_105_Proto_short_special"
msgstr "Sát thương mỗi phát lớn, kích thước nhỏ gọn"

msgid "F124_AMX_13FL11"
msgstr "AMX 13 (FL 11)"

msgid "F124_AMX_13FL11_descr"
msgstr "Bất chấp nhu cầu tăng viện mẫu xe AMX-13 sang Đông Dương, nó không thực sự phù hợp với mặt trận đó: Nòng và tháp pháo quá to, trong khi súng nạp đạn tự động vừa đắt đỏ, khó bảo trì, gần như vô dụng—đối phương hoàn toàn không có xe thiết giáp. Hơn nữa, một điều kiện cần là tăng phải đủ nhẹ để có thể chuyên chở bằng đường không. Kết quả, AMX-13 được trang bị tháp pháo FL-11 từ xe bọc thép Panhard EBR và súng không có hệ thống nạp đạn tự động. Nòng pháo thường cho phép sử dụng nhiều loại đạn đa dạng để hỗ trợ các đơn vị bộ binh. Tổng cộng có 20 chiếc được đặt hàng, nhưng chỉ năm xe thực sự ra lò. Sau khi chiến sự với Việt Nam kết thúc năm 1954, các tăng còn lại được tái triển khai sang Ma-rốc, nơi chúng \"nghỉ hưu\"."

msgid "F124_AMX_13FL11_long_special"
msgstr "Chiếc tăng lai này lấy thân của AMX-13, tháp pháo FL-11 từ xe bọc thép Panhard EBR. Súng là khẩu 75 mm cổ điển, mọi đặc tính gần giống khẩu 75 mm của các tăng hạng nhẹ Pháp khác. Nó cơ động xuất sắc, tốc độ tiến/lùi tối đa cao và ẩn giấu tốt."

msgid "F124_AMX_13FL11_short"
msgstr "AMX 13 FL 11"

msgid "F124_AMX_13FL11_short_special"
msgstr "Ẩn giấu tốt và cơ động xuất sắc"

msgid "F127_AMX_ELC_901"
msgstr "AMX ELC 901"

msgid "F127_AMX_ELC_901_descr"
msgstr "ELC AMX 901 là nguyên mẫu đầu tiên của loại tăng được thiết kế theo chương trình Engin Léger de Combat (xe chiến đấu hạng nhẹ). Các thử nghiệm ở năm 1955 làm lộ nhiều sai sót thiết kế. Phiên bản cải tiến—AMX ELC 90 bis—được tái xây dựng từ đầu tới cuối và áp dụng mọi thay đổi cần thiết. Nó rất khác với nguyên mẫu, về cơ bản như một chiếc xe hoàn toàn mới."

msgid "F127_AMX_ELC_901_long_special"
msgstr "AMX ELC 901 là tăng hạng nhẹ Pháp Cấp VI, cơ bản coi như biến thể của AMX ELC bis thường. Nó có cùng ưu điểm: Hình dáng cực thấp, ẩn giấu tuyệt vời và cơ động cao. Trang bị khẩu 90 mm, tháp pháo chỉ xoay được giới hạn 30° do kích thước nhỏ."

msgid "F127_AMX_ELC_901_short"
msgstr "AMX ELC 901"

msgid "F127_AMX_ELC_901_short_special"
msgstr "Sát thương mỗi phát lớn, ẩn giấu xuất sắc"

msgid "F128_SFAC_105"
msgstr "SFAC 105"

msgid "F128_SFAC_105_descr"
msgstr "Sau Thế Chiến II, Pháp nhận được nhiều thiết kế xe bọc thép của Đức, gồm cả tài liệu về pháo chống tăng thuộc dòng Waffenträger, cũng như phương tiện chiến đấu đa nhiệm với hệ thống súng đôi. Kết quả từ việc nghiên cứu dữ liệu là cả sê-ri pháo chống tăng hoàn chỉnh của riêng nước này. Một trong số đó là SFAC 105, có khả năng di chuyển tốt và trang bị hai khẩu súng phòng không. Tuy nhiên, dự án không đến được giai đoạn nguyên mẫu. Thay vì phát triển pháo chống tăng cơ động, Pháp bắt đầu chế tạo pháo cao xạ tự hành."

msgid "F128_SFAC_105_long_special"
msgstr "Một pháo chống tăng hạng nhẹ của Pháp có hệ thống súng đôi. Nó sở hữu thiết bị ngắm thử nghiệm cho phép bắt mục tiêu nhanh và tăng độ chính xác, trong khi thời gian đổi qua lại giữa hai súng nhanh đồng nghĩa SFAC 105 khai hỏa như thể có băng đạn hai-viên. Tuy nhiên, dù cơ động xuất sắc, nó chỉ được bảo vệ cơ bản."

msgid "F128_SFAC_105_short"
msgstr "SFAC 105"

msgid "F128_SFAC_105_short_special"
msgstr "Hệ thống hai nòng, cơ động tốt"

msgid "F129_ARL_44_BPXIV"
msgstr "Char de transition"

msgid "F129_ARL_44_BPXIV_descr"
msgstr "Chúng tôi biết sự chiếm đóng không thể kéo dài mãi. Bọn nó tưởng dân Pháp buông xuôi à? Đó mới là vô lý. Cả thế giới phải nhớ Cách mạng Pháp cơ mà. Không ai có thể buộc chúng tôi sống theo cách đó, còn lâu có chuyện nghe lệnh 'chủ nhân'. Làm người Pháp nghĩa là yêu tự do. Vì vậy, khi chúng định cướp đi tự do của chúng tôi, ngay cả trong giờ phút tối tăm nhất, tôi luôn tin tưởng nước Pháp. Lúc trận Normandy nổ ra, với tư cách là người Normand, tôi biết ngày ấy đã đến—ngày cho thế giới thấy chúng tôi là ai, chúng tôi vì điều gì."

msgid "F129_ARL_44_BPXIV_long_special"
msgstr "Chiếc tăng hạng nặng thử nghiệm này đã tham dự cuộc đổ bộ Normandy ở Thế Chiến II. Các kỹ sư Pháp vật lộn trong việc tạo ra một tăng hạng nặng đáng tin cậy vào thời điểm đó, và chỉ một nguyên mẫu duy nhất triển khai trên chiến trường. Chiếc xe này được duyệt phục vụ biên chế có giới hạn, về sau đi vào sản xuất hàng loạt ngay trước khi kết thúc Thế Chiến Hai."

msgid "F129_ARL_44_BPXIV_short"
msgstr "CDT"

msgid "F129_ARL_44_BPXIV_short_special"
msgstr "Súng uy lực, giáp trước tốt"

msgid "F130_Sentinelle"
msgstr "Sentinelle"

msgid "F130_Sentinelle_descr"
msgstr "Một dự án hợp tác giữa bộ quốc phòng Ý và Pháp có tên Sentinelle. Mẫu Char Lourd AP 58 được dùng làm nền tảng, tháp pháo và vũ khí gốc Ý, trong khi thiết bị quang học cũng như thông tin liên lạc của Pháp. Chiếc tăng dự định có hình dáng khá thấp và vũ khí mạnh. Tuy nhiên, do việc chuẩn hóa đạn dược theo NATO, mẫu xe này không còn cần thiết nữa. Dự án bị chấm dứt trước khi ra đời nguyên mẫu nào."

msgid "F130_Sentinelle_long_special"
msgstr "Sentinelle là chiến xa Pháp Cấp IX, hạng nặng nhưng độ cơ động, kích thước và giáp giống tăng hạng trung hơn—chỉ có phần trước tháp pháo bọc thép tốt. Đặc trưng chính là băng đạn hai-viên, bắn nhanh, vận hành mượt, sát thương mỗi phát 390 HP. Nhỏ gọn, linh hoạt, súng hạ nòng khá, nó hiệu quả ở các vị trí thường thấy cho tăng hạng trung."

msgid "F130_Sentinelle_short"
msgstr "Sentinelle"

msgid "F130_Sentinelle_short_special"
msgstr "Băng đạn tự động nhanh, linh hoạt tốt"

msgid "F131_Brennos"
msgstr "Brennos"

msgid "F131_Brennos_descr"
msgstr "Sau Thế Chiến II, Pháp quyết tạo tăng hạng nặng dựa trên kinh nghiệm đã rút ra. Mọi dự án tiền-chiến và trong thời chiến đều được xem xét. Ảnh hưởng từ Đức rõ ràng có thể cảm nhận trong nhiều bộ phận, thành phần, vì Pháp sở hữu nhiều thông tin về Panther và King Tiger. Người Pháp còn cân nhắc mượn ý tưởng của cả Liên Xô, tìm cách tái tạo mũi giáo nổi tiếng trên IS-3 cho chiếc xe mới. Dù tháp pháo gợi nhớ King Tiger, kế hoạch chế tạo nó theo kiểu đúc với kiến thức bổ sung của Pháp ở dạng tháp chỉ huy có hai khẩu 20 mm. Trong quá trình phát triển chi tiết, thời thế khẳng định khái niệm của chiếc tăng này đã lỗi thời, dù có sản xuất hàng loạt cũng không còn phù hợp. Dự án không tiến xa hơn bản vẽ."

msgid "F131_Brennos_long_special"
msgstr "Brennos có súng vận hành mượt trong số tăng hạng nặng Cấp VIII, với độ ổn định nòng, sức xuyên và thời gian ngắm tuyệt vời. Động cơ mạnh mẽ giúp bứt tốc nhanh và chạy nước rút tốt. Tuy nhiên, nó có giáp thân tầm thường và điểm yếu lớn ở tháp pháo."

msgid "F131_Brennos_short"
msgstr "Brennos"

msgid "F131_Brennos_short_special"
msgstr "Ổn định nòng tuyệt vời, sức xuyên tốt"

msgid "F132_Vercingetorix"
msgstr "Vercingétorix"

msgid "F132_Vercingetorix_descr"
msgstr "Một dự án được phát triển giữa những năm 1950 nhằm thay thế chương trình AMX 50. Thân xe thiết kế thấp nhất có thể, nhiều giải pháp kỹ thuật đã chứa các yếu tố của AMX 30 tương lai. Tuy nhiên, ước tính sơ bộ cho thấy nếu làm giáp đủ tin cậy và lắp vũ khí hiện đại sẽ khiến nó nặng tới 60 tấn, vượt quá yêu cầu của chủ đầu tư quân sự. Chiếc tăng này chưa từng xuất xưởng."

msgid "F132_Vercingetorix_long_special"
msgstr "Vercingétorix là tăng hạng trung Pháp Cấp IX với giáp, vũ khí và cơ động gần như tăng hạng nặng. Nó được bọc thép đáng tin cậy ở tháp pháo, lắp súng 120 mm phù hợp cận chiến. Đặc trưng chính là động cơ tuabin-khí cho chế độ Siêu Nhanh, giúp biến hóa thành tăng hạng trung thực sự để chuyển vị trí linh hoạt."

msgid "F132_Vercingetorix_short"
msgstr "Vercingétorix"

msgid "F132_Vercingetorix_short_special"
msgstr "Động cơ tuabin-khí, giáp tháp pháo đáng tin cậy"

msgid "F134_Lorraine_120_Alby"
msgstr "Lorraine 120 Alby"

msgid "F134_Lorraine_120_Alby_descr"
msgstr "Một pháo tự hành kiểu cabin, gói gọn hỏa lực mạnh và khả năng bảo vệ cao trong kích thước nhỏ nhất: 45 tấn. Mục tiêu chính là mở rộng góc xoay súng để không phải quay thân, dẫn đến thiết kế khoang chiến đấu hoàn toàn mới. Người ta dự tính lắp pháo rãnh xoắn 105 mm hoặc 120 mm, thậm chí cả đầu hãm giật cho cỡ nòng sau.\nTuy nhiên, nguyên mẫu bộc lộ hàng loạt nhược điểm: Cơ động kém, cực tốn nhiên liệu. Lắp pháo to rất khó do nòng vươn ra hơn 4 mét, gây trở ngại khi vượt địa hình gồ ghề, đòi hỏi lái xe phải tập trung cao độ. Trọng lượng nặng và pháo 120 mm lớn khiến đầu xe quá tải, làm các bộ phận chịu lực phía trước hao mòn nhanh. Kết quả, dự án bị hủy bỏ."

msgid "F134_Lorraine_120_Alby_long_special"
msgstr "Lorraine 120 Alby là pháo chống tăng Cấp VIII của Pháp, tuân theo nguyên tắc truyền thống: Hình dáng thấp, cơ động tốt, giáp trước tốt, vác khẩu 120 mm nạp đạn tự động. Điểm nổi bật là kết cấu phần trên thân xe di động cùng súng, cho phép xoay vũ khí 30° mỗi bên mà không cần quay cả thân."

msgid "F134_Lorraine_120_Alby_short"
msgstr "Alby"

msgid "F134_Lorraine_120_Alby_short_special"
msgstr "Nạp đạn tự động, giáp trước tốt"

msgid "F135_AS_XX_40_t"
msgstr "AS-XX 40 t"

msgid "F135_AS_XX_40_t_descr"
msgstr "Một nguyên mẫu tăng hạng trung Pháp được phát triển năm 1978 nhằm đảm bảo an toàn tối đa cho kíp lái. Súng và đạn đặt ngoài khoang chiến đấu để giảm nguy cơ chấn thương. Trong trường hợp hỏa hoạn, lính có thể giải phóng thùng cháy bằng hộp nổ. Đạn được bố trí ở gác cơ giới trên súng và tự động tái tiếp tế từ hai thùng bọc thép phía sau. Do phát triển phức tạp và tốn công, dự án dừng lại ở giai đoạn mô hình gỗ."

msgid "F135_AS_XX_40_t_long_special"
msgstr "AS-XX 40 t là tăng hạng trung cơ động cao, kế thừa điểm mạnh của thế hệ tiền nhiệm, trang bị súng tự động, cấu trúc nhỏ gọn, bứt tốc nhanh, hỗ trợ đáng tin cậy khi bất ngờ thọc sườn. Tuy nhiên, khả năng sống sót hạn chế yêu cầu sự thận trọng."

msgid "F135_AS_XX_40_t_short"
msgstr "AS-XX 40 t"

msgid "F136_AMX_67_Imbattable"
msgstr "AMX 67 Imbattable"

msgid "F136_AMX_67_Imbattable_descr"
msgstr "Cuối thập niên 1960, Pháp đang dùng tăng AMX-30 hiện đại chống xe bọc thép đối phương. Họ đồng thời phát triển AMX 67 Imbattable với giáp tốt hơn, vũ khí mạnh, bắn được xa và nhanh. Súng đặt trong tháp pháo thấp, trạm vũ khí trên nóc nạp đạn tự động. Dự án chỉ tồn tại trên bản vẽ."

msgid "F136_AMX_67_Imbattable_long_special"
msgstr "AMX 67 Imbattable là một tăng hạng nặng khác thường, hy sinh giáp để có độ cơ động tốt và súng nạp tự động với chỉ số cân bằng. Trên chiến trường, nó hỗ trợ đồng minh bằng hỏa lực tập trung khi cần—hệ thống nạp đạn thử nghiệm nhanh, luôn sẵn sàng."

msgid "F136_AMX_67_Imbattable_short"
msgstr "Imbattable"

msgid "F137_LEOX"
msgstr "Leox"

msgid "F137_LEOX_descr"
msgstr "Năm 1970, Tây Ban Nha gặp rắc rối khi binh đoàn tăng toàn hàng Mỹ của mình, bao gồm M47, đã lỗi thời. Vì lý do chính trị, Mỹ và Anh không thể xuất khẩu vũ khí, Đức cũng vậy vì súng Leopard 1 là của Anh. Kết quả, Tây Ban Nha mua AMX 30 của Pháp, từ 1974 bắt đầu sản xuất AMX 30E theo giấy phép, nhưng không phải bản hiện đại hóa. Tăng Pháp tỏ ra thiếu tin cậy, nên Tây Ban Nha phải hiện đại hóa M47, M48 và AMX 30 cũ. Đến 1979, sau khi ngừng sản xuất AMX 30E, các dự án hiện đại hóa bắt đầu, gồm El Niño—AMX 30 với thân kéo dài— và Leox—chỉnh sửa thân Leopard 1 lắp tháp pháo AMX 30E."

msgid "F137_LEOX_long_special"
msgstr "Leox là tăng hạng trung Pháp Cấp IX, có động cơ mạnh, đạt tốc độ ấn tượng và đảo vị trí nhanh đến mọi điểm trên chiến trường. Súng chính xác, gây sát thương chí mạng cho nhiều loại kẻ địch, bất kể khoảng cách."

msgid "F137_LEOX_short"
msgstr "Leox"

msgid "F137_LEOX_short_special"
msgstr "Tốc độ tối đa ấn tượng, xuyên cao"

msgid "F138_Renault_R35_FCM_36"
msgstr "Renault R35/FCM 36"

msgid "F138_Renault_R35_FCM_36_desc"
msgstr "Trong khuôn khổ chương trình thập niên 1930 nhằm phát triển và sản xuất xe tăng mới, Pháp đã tích cực thống nhất hóa tháp pháo của nhiều phương tiện khác nhau. Một dự án thử nghiệm như vậy là tăng hạng nhẹ R35 với tháp pháo của FCM 36. Nó chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F138_Renault_R35_FCM_36_long_special"
msgstr "Renault R35/FCM 36 là một tăng hạng nhẹ Cấp II của Pháp, kết hợp thân Renault R35 với tháp pháo FCM 36. Nó trang bị pháo 37 mm có tốc độ bắn đặc biệt cao, giáp tốt và đáng tin cậy. Sự kết hợp này khiến chiếc xe có thể giữ vững vị trí then chốt, đẩy qua hỏa lực đối phương."

msgid "F138_Renault_R35_FCM_36_short"
msgstr "R35/FCM 36"

msgid "F138_Renault_R35_FCM_36_short_special"
msgstr "Giáp tốt, tốc độ bắn cao"

msgid "F139_Terrifiant"
msgstr "Terrifiant"

msgid "F139_Terrifiant_descr"
msgstr "Những năm 1950 chứng kiến tăng hạng nặng Pháp đi vào ngõ cụt. Nhiều nỗ lực cải tiến thiết kế từ Thế Chiến II đều thất bại, Pháp phải nhờ tới Mỹ. Họ mua tài liệu và bản vẽ hệ giảm xóc của dự án TS‑6, vốn chưa từng được chế tạo. Kỹ sư Pháp gắn tháp pháo cùng khẩu 128 mm lên thân xe đó, nhưng tổng thể quá nặng, nỗ lực lắp động cơ mạnh trên 1000 mã lực cũng thất bại. Dự án cuối cùng bị hủy bỏ."

msgid "F139_Terrifiant_long_special"
msgstr "Terrifiant là tăng hạng nặng Pháp Cấp IX, gợi nhớ các chiến xa hạng nặng truyền thống của nước này với giáp thân trước và tháp pháo cứng, súng mạnh gây sát thương cao mỗi phát, chính xác ổn, cơ động khá."

msgid "F139_Terrifiant_short"
msgstr "Terrifiant"

msgid "F139_Terrifiant_short_special"
msgstr "Giáp trước đáng tin, sát thương cao mỗi phát"

msgid "F13_AMX38"
msgstr "AMX 38"

msgid "F13_AMX38_descr"
msgstr "Được phát triển vào giai đoạn 1937–1938 theo dự án \"xe 20 tấn\" nhằm thay thế tăng D2. AMX 38 bao gồm 2 phiên bản tháp pháo: Một với súng 37-mm và một với súng 47-mm. Đến năm 1938, hai chiếc tăng hoàn chỉnh đã được chế tạo để thử nghiệm. Tuy nhiên, AMX 38 chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F13_AMX38_short"
msgstr "AMX 38"

msgid "F140_Fantome"
msgstr "Fantôme"

msgid "F140_Fantome_descr"
msgstr "Từ 1963 đến 1964, Porsche phát triển một mẫu tăng dự kiến cho thập niên 1970, nhưng cuối cùng bị bác bỏ. Sau đó, dự án này đến Pháp, nơi công ty Creusot-Loire đề xuất nó làm mẫu tăng đồng bộ cho Pháp, Đức và cả các quốc gia khác về sau. Tuy nhiên, chiếc xe tỏ ra quá đắt đỏ, vốn là yếu tố quyết định dẫn đến việc chấm dứt hẳn dự án."

msgid "F140_Fantome_long_special"
msgstr "Fantôme là tăng hạng trung Pháp Cấp IX, sở hữu mọi đặc điểm quen thuộc của xe Pháp như cơ động tốt, nạp đạn tự động. Tuy nhiên, điều khiến nó khác biệt là hệ giảm xóc thủy‑khí tự động, cho phép nâng/hạ nòng tốt hơn, nâng cao hiệu quả chiến đấu trên địa hình không bằng phẳng."

msgid "F140_Fantome_short"
msgstr "Fantôme"

msgid "F140_Fantome_short_special"
msgstr "Băng đạn tự động, hệ giảm xóc thủy–khí tự động"

msgid "F141_Durendal"
msgstr "Durendal"

msgid "F141_Durendal_desc"
msgstr "Thiết kế sơ bộ của một tăng hạng trung dựa trên các phát triển Pháp-Ý."

msgid "F141_Durendal_long_special"
msgstr "Durendal là tăng hạng trung hỗ trợ Cấp X của Pháp. Nó có súng nạp đạn tự động khác thường với 2 ổ chứa, cho phép bắn loạt 2-viên cực nhanh, gây sát thương đáng kể trong thời gian ngắn. Nó còn cơ động vượt trội, giúp ra đòn từ những hướng bất ngờ."

msgid "F141_Durendal_short"
msgstr "Durendal"

msgid "F141_Durendal_short_special"
msgstr "Ổ đạn nạp lại tự động, khả năng di chuyển tốt"

msgid "F142_M47_Chevalier"
msgstr "M47 Chevalier"

msgid "F142_M47_Chevalier_descr"
msgstr "Một dự án hiện đại hóa M47 lớn, vốn từng phục vụ quân đội Pháp. Mục tiêu chính là cập nhật chiếc xe cho đến khi AMX 30 được sản xuất đủ số lượng. Thiết kế lắp đặt súng mới, nâng cấp hệ thống điều khiển hỏa lực, tăng giáp, gắn lưỡi ủi đất và thùng nhiên liệu bên ngoài, đồng thời giảm số lượng kíp lái—vị trí trợ lý lái xe bị thay bằng gác đạn. Tuy nhiên, AMX 30 phổ cập nhanh hơn dự kiến, hiện đại hóa M47 hóa ra đã lỗi thời đối với quân đội Pháp. Phương tiện này cũng dự kiến xuất khẩu nhưng không ai quan tâm. Một nguyên mẫu có súng mới đã được chế tạo để chứng minh khả năng tái vũ trang; tuy nhiên, không ai biết lịch sử tiếp theo của nó."

msgid "F142_M47_Chevalier_long_special"
msgstr "M47 Chevalier là tăng hạng trung Pháp Cấp IX. Dù không có điểm mạnh thực sự nổi bật, súng vận hành mượt, hạ nòng xuất sắc, cơ động tốt và giáp tháp pháo khá ổn khiến nó tròn vai, đủ sức cạnh tranh. Nhiều giáp rỗng che phủ rộng cũng tăng độ bảo vệ, cải thiện thêm khả năng sống sót."

msgid "F142_M47_Chevalier_short"
msgstr "M47 Chevalier"

msgid "F142_M47_Chevalier_short_special"
msgstr "Giáp tháp pháo chắc chắn, hạ nòng tốt"

msgid "F143_Fauteur"
msgstr "Fauteur"

msgid "F143_Fauteur_descr"
msgstr "Đầu thập niên 1970, AMX thúc đẩy chương trình phát triển loại tăng mới, giáp dày, súng mạnh, tốc độ bắn cao. Dù giáp vẫn kiểu truyền thống, hỏa lực lại dựa trên nguyên lý mới. Các kỹ sư dự định triển khai một loại pháo lai, với điện lực bổ sung nhằm tăng hiệu quả thuốc phóng rắn. Khí thuốc phóng được đốt nóng bằng hồ quang điện giữa điện cực trên nòng, cải thiện quá trình cháy, nâng cao lực bắn. Dự án bị dừng lại do nhiều hạn chế kỹ thuật."

msgid "F143_Fauteur_long_special"
msgstr "Fauteur là sản phẩm từ công thức tăng hạng nặng đáng tin cậy và những điều biến thuốc phóng tiên tiến, tạo nên phương tiện đáng gờm, hợp tầm tác chiến cả gần lẫn xa. Giáp tốt cho phép chống chịu đạn đối phương, trong khi cơ động kha khá đưa hỏa lực của nó đến gần tiền tuyến hơn."

msgid "F143_Fauteur_short"
msgstr "Fauteur"

msgid "F147_AMX29_Belier"
msgstr "AMX 29 Bélier"

msgid "F147_AMX29_Belier_descr"
msgstr "Năm 1963, công ty AMX được giao nhiệm vụ phát triển một tăng hạng trung nhỏ gọn, cơ động ngang BC 25 t và hỏa lực mạnh hơn. Mẫu xe có định danh AMX 29 Bélier (“Ram”). Đặc điểm chính gồm súng rãnh xoắn 127 mm CN-127-F1 rifled gun nạp đạn tự động. Kíp lái dự kiến 3 người. Các cuộc thử nghiệm xác nhận khả năng cơ động cao, hỏa lực đáng nể; tuy nhiên, nó bộc lộ nhược điểm nghiêm trọng: Súng giật quá mạnh, ít đạn, chi phí cao và cơ cấu nạp đạn tự động phức tạp. Kết quả, dự án bị đóng lại năm 1969."

msgid "F147_AMX29_Belier_long_special"
msgstr "AMX 29 Bélier là tăng hạng trung hỗ trợ Cấp X của Pháp. Kiểu dáng thấp, ngụy trang xuất sắc, cơ động cao cho phép nó di chuyển khó lường, tấn công hiệu quả. Trang bị khẩu 127 mm nạp đạn tự động cải tiến 2-phát, có thể giảm đáng kể thời gian nạp của phát tiếp theo nếu khai hỏa đúng lúc."

msgid "F147_AMX29_Belier_short"
msgstr "Bélier"

msgid "F147_AMX29_Belier_short_special"
msgstr "Nạp đạn tự động cải tiến, cơ động tuyệt vời"

msgid "F14_AMX40"
msgstr "AMX 40"

msgid "F14_AMX40_descr"
msgstr "Quá trình phát triển bắt đầu từ tháng 03/1940. Gần như mọi mảng giáp đều có hình dạng cong phức tạp khiến thân xe hầu như không có góc cạnh đúng nghĩa. Theo dự kiến, AMX 40 sẽ thay thế Somua S35 và S40 ở giai đoạn 1941–1942, nhưng dự án này đã bị ngừng lại vào năm 1940. Chỉ tồn tại trên bản vẽ."

msgid "F14_AMX40_short"
msgstr "AMX 40"

msgid "F15_AMX_12t"
msgstr "AMX 12 t"

msgid "F15_AMX_12t_descr"
msgstr "Bản thiết kế tăng hạng nhẹ tốc độ cao này được phát triển vào năm 1946. Tuy nhiên, nó chỉ tồn tại trên bản vẽ và trở thành nền tảng cho việc nghiên cứu chế tạo dòng xe AMX 13 nổi tiếng."

msgid "F15_AMX_12t_short"
msgstr "AMX 12 t"

msgid "F16_AMX_13_75"
msgstr "AMX 13 75"

msgid "F16_AMX_13_75_descr"
msgstr "Một tăng hạng nhẹ cơ động với tháp pháo \"gật\" và súng 75 mm nạp đạn tự động có thể bắn tới 10 phát mỗi phút. Vào lúc bấy giờ, khẩu súng trên chiếc xe này có độ xuyên giáp vượt trội so với hầu hết vũ khí của các tăng hạng trung khác."

msgid "F16_AMX_13_75_short"
msgstr "AMX 13 75"

msgid "F17_AMX_13_90"
msgstr "AMX 13 90"

msgid "F17_AMX_13_90_descr"
msgstr "Vào đầu những năm 1960, súng 75 mm với sơ tốc đầu nòng 1000 m/s bị đánh giá là đã lỗi thời. Chiếc xe này đã nhận được khẩu 90-mm F3 mới, sử dụng đạn HEAT uy lực hơn. Bước hiện đại hóa này không đòi hỏi bất cứ thay đổi lớn nào đối với tháp pháo hay thiết kế xe. Chiếc AMX 13 90 đầu tiên được sản xuất vào tháng 02/1967. Những xe tăng đang tồn tại lúc bấy giờ cũng được hiện đại hóa nòng súng."

msgid "F17_AMX_13_90_short"
msgstr "AMX 13 90"

msgid "F18_Bat_Chatillon25t"
msgstr "Bat.-Châtillon 25 t"

msgid "F18_Bat_Chatillon25t_7x7"
msgstr "Bat.-Châtillon 25 t 7x7"

msgid "F18_Bat_Chatillon25t_7x7_descr"
msgstr "Là một xe tăng hạng trung với tháp pháo \"gật\" và súng 90 mm. Được phát triển bởi Batignolles-Châtillon vào giữa những năm 1950. Chỉ có 2 nguyên mẫu được chế tạo. Chiếc xe chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F18_Bat_Chatillon25t_7x7_short"
msgstr "B-C 25 t 7x7"

msgid "F18_Bat_Chatillon25t_descr"
msgstr "Là một xe tăng hạng trung với tháp pháo \"gật\" và súng 90 mm. Được phát triển bởi Batignolles-Châtillon vào giữa những năm 1950. Chỉ có 2 nguyên mẫu được chế tạo. Chiếc xe chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F18_Bat_Chatillon25t_short"
msgstr "B-C 25 t"

msgid "F19_Lorraine40t"
msgstr "Lorraine 40 t"

msgid "F19_Lorraine40t_descr"
msgstr "Pháp bắt đầu quá trình phát triển chiếc tăng thử nghiệm này trong những năm 1940. Hai nguyên mẫu đã được chế tạo vào năm 1952. Ngoài tháp pháo \"gật\", Lorraine 40 t còn đặc trưng với hệ thống giảm xóc có lốp xe lõi khí và giáp hình mũi lao. Thiết kế này đã vượt qua nhiều cuộc thử nghiệm nhưng chưa bao giờ đến được giai đoạn sản xuất hàng loạt."

msgid "F19_Lorraine40t_long_special"
msgstr "Một tăng hạng trung nhanh nhẹn với băng đạn 4 viên, có khả năng gây ra 1200 HP thiệt hại trong khoảng thời gian ngắn. Độ cơ động rất cao về cơ bản được cân bằng lại khi giáp của nó chỉ ở mức chấp nhận được, khiến chiến thuật tốt nhất là đánh thọc sườn."

msgid "F19_Lorraine40t_short"
msgstr "Lorr. 40 t"

msgid "F19_Lorraine40t_short_special"
msgstr "Hệ thống nạp đạn theo băng và độ cơ động xuất sắc"

msgid "F22_AMX_105AM"
msgstr "AMX 13 105 AM mle. 50"

msgid "F22_AMX_105AM_descr"
msgstr "Dự án phát triển một pháo tự hành dựa trên xe AMX 13 75 được khởi động cuối những năm 1940. Chiếc xe sở hữu lựu pháo Obusier de 105 mm TF50. Đầu thập niên 1950, pháo tự hành này được đưa vào phục vụ trong Quân đội Pháp. Tổng cộng 429 chiếc được sản xuất; 92 trong số đó được xuất khẩu sang Hà Lan."

msgid "F22_AMX_105AM_short"
msgstr "AMX 13 AM"

msgid "F23_AMX_13F3AM"
msgstr "AMX 13 F3 AM"

msgid "F23_AMX_13F3AM_descr"
msgstr "Cuối thập niên 1950, các kỹ sư thuộc tổ hợp Creusot-Loire đã phát triển một mẫu xe mới trên cơ sở đơn giản hóa xe AMX 13. Nó sở hữu súng nòng 155-mm. Chiếc xe đi vào sản xuất hàng loạt từ năm 1962 đến tận năm 1997 với tổng cộng 600 chiếc được chế tạo. Pháo tự hành này hiện vẫn đang phục vụ trong biên chế tại Pháp, Argentina, Chile, Ecuador, Ma-rốc và nhiều quốc gia khác."

msgid "F23_AMX_13F3AM_short"
msgstr "AMX 13 F3"

msgid "F24_Lorraine155_50"
msgstr "Lorraine 155 mle. 50"

msgid "F24_Lorraine155_50_descr"
msgstr "Được phát triển tại Pháp sau cuộc chiến và dựa trên nền tảng của xe tăng thử nghiệm Lorraine 40 t. Chiếc xe này đã vượt qua giai đoạn thử nghiệm vào năm 1950 nhưng chưa bao giờ được sản xuất hàng loạt cũng như phục vụ trong biên chế."

msgid "F24_Lorraine155_50_short"
msgstr "Lorr. 155 50"

msgid "F25_Lorraine155_51"
msgstr "Lorraine 155 mle. 51"

msgid "F25_Lorraine155_51_descr"
msgstr "Được phát triển vào năm 1951 dựa trên nền tảng của Lorraine 40 t và mang lựu pháo 155-mm. Nguyên mẫu này đã vượt qua giai đoạn thử nghiệm cùng lúc với chiếc tăng tương ứng. Tuy nhiên, do Lorraine 40 t không được nhập biên chế, dự án pháo tự hành cũng bị ngừng lại."

msgid "F25_Lorraine155_51_short"
msgstr "Lorr. 155 51"

msgid "F27_FCM_36Pak40_long_special"
msgstr "Một pháo chống tăng Cấp III của Pháp với súng uy lực, chính xác và tầm nhìn xa giúp bạn phát hiện cũng như tiêu diệt xe địch nhanh chóng. Tuy nhiên, giáp chỉ ở mức trung bình khiến chiến thuật chủ yếu là chọn vị trí phòng thủ, nấp sau vật cản, khai hỏa từ tầm trung đến xa."

msgid "F27_FCM_36Pak40_short_special"
msgstr "Súng tốt và tầm nhìn xa"

msgid "F32_Somua_Sau_40"
msgstr "Somua SAu 40"

msgid "F32_Somua_Sau_40_descr"
msgstr "Một dự án pháo tự hành nhằm hỗ trợ các đơn vị cơ giới hạng nhẹ. Được thiết kế từ năm 1935 đến 1937 dựa trên nền tảng của xe S35 và S40, nó đặc trưng với phần trên thân bọc giáp có sự điều chỉnh với ổ pháo 75-mm Mle 1929. Đỉnh cabin là tháp pháo một-chỗ trang bị súng máy 7,5-mm Mle 1931. Quá trình sản xuất hàng loạt của SAu 40 được đề xuất vào tháng 10/1939. Một nguyên mẫu (và, theo vài nguồn tư liệu lịch sử, bốn xe SAu 40 thí điểm khác) đã ra tiền tuyến và tham chiến vào tháng 06/1940."

msgid "F32_Somua_Sau_40_short"
msgstr "SAu 40"

msgid "F33_S_35CA"
msgstr "S35 CA"

msgid "F33_S_35CA_descr"
msgstr "Được phát triển dựa trên nền tảng của các xe R35 và S35 đã lỗi thời. Thiết kế đơn giản này cho phép lắp cabin hở và pháo 17-pounder của Anh lên khung gầm. Tuy nhiên, dự án đã bị ngừng lại ở giai đoạn thiết kế do sự thiếu hụt và lỗi thời của khung gầm trước chiến tranh, cũng như nòng pháo không có tính kế thừa và thiếu hiệu quả."

msgid "F33_S_35CA_short"
msgstr "S35 CA"

msgid "F34_ARL_V39"
msgstr "ARL V39"

msgid "F34_ARL_V39_descr"
msgstr "Một nguyên mẫu của ARL 40. Theo thiết kế ban đầu, chiếc xe này là pháo tự hành xung kích. Quá trình sản xuất hàng loạt dự tính bắt đầu vào năm 1940 nhưng chưa bao giờ được triển khai do Pháp bị xâm lược."

msgid "F34_ARL_V39_short"
msgstr "ARL V39"

msgid "F35_AMX_AC_Mle1946"
msgstr "AMX AC mle. 46"

msgid "F35_AMX_AC_Mle1946_descr"
msgstr "Một dự án Pháo Chống tăng hạng nặng dựa trên nền tảng của AMX M4 45. Quá trình phát triển bắt đầu vào năm 1946. Hình dáng của chiếc xe này có điểm tương đồng lớn với Jagdpanther. Chỉ tồn tại trên bản vẽ."

msgid "F35_AMX_AC_Mle1946_short"
msgstr "AMX AC 46"

msgid "F36_AMX_AC_Mle1948"
msgstr "AMX AC mle. 48"

msgid "F36_AMX_AC_Mle1948_FL"
msgstr "AMX AC mle. 48 FL"

msgid "F36_AMX_AC_Mle1948_FL_short"
msgstr "AMX AC 48 FL"

msgid "F36_AMX_AC_Mle1948_descr"
msgstr "Một dự án phác thảo Pháo Chống tăng hạng nặng được phát triển trong giai đoạn 1947–1948 dưới sự ảnh hưởng từ Jagdpanther. Theo kế hoạch, chiếc xe này sẽ mang hỏa lực chính là súng 120 mm. Nó còn đặc trưng bởi ba khẩu súng máy 20 mm MG 151/20 lắp trên nóc khoang chiến đấu và ở phía đuôi xe. Chỉ tồn tại trên bản vẽ."

msgid "F36_AMX_AC_Mle1948_short"
msgstr "AMX AC 48"

msgid "F37_AMX50_Foch"
msgstr "AMX 50 Foch"

msgid "F37_AMX50_Foch_descr"
msgstr "Từ cuối thập niên 1940 đến đầu những năm 1950, Pháp không ngừng phát triển thế hệ pháo chống tăng hạng nặng cho riêng mình. Dự án này chịu ảnh hưởng từ các pháo chống tăng của Đức trong Thế Chiến II. AMX 50 Foch đặc trưng với súng 120-mm. Ít nhất một nguyên mẫu đã được chế tạo và tham gia duyệt binh tại Paris vào ngày 14/07/1950. Chưa bao giờ tiến đến giai đoạn sản xuất hàng loạt."

msgid "F37_AMX50_Foch_short"
msgstr "Foch"

msgid "F38_Bat_Chatillon155_58"
msgstr "Bat.-Châtillon 155 58"

msgid "F38_Bat_Chatillon155_58_descr"
msgstr "Một dự án thử nghiệm pháo tự hành sử dụng nhiều yếu tố thuộc khung gầm của tăng hạng trung M47 từ Mỹ. So với Bat.-Châtillon 155 55, chiếc xe này có tháp pháo khác và sở hữu hệ thống nạp đạn theo băng. Chỉ tồn tại trên bản vẽ."

msgid "F38_Bat_Chatillon155_58_short"
msgstr "B-C 155 58"

msgid "F39_AMR_P103"
msgstr "AMR P.103"

msgid "F39_AMR_P103_descr"
msgstr "Một tăng hạng nhẹ được các kỹ sư Citroën phát triển năm 1935. Nó đã trải qua thử nghiệm vào tháng 04 cùng năm, cho thấy những bộ phận chính và kíp lái có sự bảo vệ đáng tin cậy. Tuy nhiên, do khung gầm và hệ thống truyền động thủy lực đầy chất chưởng, tốc độ lại chậm, dự án đã bị hủy bỏ để nhường chỗ cho AMR 35. Nguyên mẫu duy nhất sau đó đã bị phá hủy."

msgid "F39_AMR_P103_long_special"
msgstr "AMR P.103 là một tăng hạng nhẹ đa năng ở Cấp II, đủ cơ động để chiếm các vị trí then chốt trên trận địa. Nó có khẩu súng bắn nhanh, trong khi tầm nhìn tốt đem lại khả năng trinh sát hiệu quả—đặc biệt là ở giai đoạn cuối trận."

msgid "F39_AMR_P103_short"
msgstr "AMR P.103"

msgid "F39_AMR_P103_short_special"
msgstr "Tầm nhìn tốt, tốc độ bắn nhanh"

msgid "F42_AMR_35"
msgstr "AMR 35"

msgid "F42_AMR_35_descr"
msgstr "Một tăng hạng nhẹ trinh sát do Renault phát triển. Có tổng cộng 200 xe với nhiều chỉnh thể khác nhau đã được sản xuất từ năm 1936 đến 1940. Chúng tham chiến trong giai đoạn đầu Thế Chiến II. Sau khi Pháp đầu hàng, phần lớn các tăng này bị Đức thu giữ và chuyển đổi thành xe tự hành cho pháo cối 8 cm."

msgid "F42_AMR_35_long_special"
msgstr "Một xe tăng với kích thước nhỏ và súng đáng tin cậy ở cấp của nó. Không sở hữu tốc độ cao hay giáp dày, chiến thuật phù hợp nhất là dựa vào khả năng ẩn giấu. Hình dáng thấp khiến chiếc xe này khó bị phát hiện hay bắn trúng. Chưa kể, góc hạ/nâng nòng tốt cho phép tận dụng địa hình mấp mô một cách hiệu quả."

msgid "F42_AMR_35_short"
msgstr "AMR 35"

msgid "F42_AMR_35_short_special"
msgstr "Súng tốt và ẩn giấu xuất sắc"

msgid "F44_Somua_S35"
msgstr "Somua S35"

msgid "F44_Somua_S35_descr"
msgstr "Hỏa lực, giáp bảo vệ và độ cơ động tốt khiến S35 trở thành một trong những xe tăng tốt nhất thời bấy giờ. Tuy nhiên, tháp pháo nhỏ khiến Chỉ huy phải gánh vác nhiều nhiệm vụ cùng lúc: tìm kiếm mục tiêu, ngắm bắn, nạp đạn và phối hợp với kíp lái. Khối lượng công việc nhiều như vậy đã làm giảm mức độ cảnh giác của Chỉ huy và hiệu quả chiến đấu của xe trên trận địa. Tính đến thời điểm Pháp đầu hàng vào ngày 22/06/1940, có tổng cộng 427 chiếc S35 đã được sản xuất."

msgid "F44_Somua_S35_short"
msgstr "Somua S35"

msgid "F50_FCM36_20t"
msgstr "FCM 36"

msgid "F50_FCM36_20t_descr"
msgstr "Được phát triển vào giữa những năm 1930 để dùng làm tăng hỗ trợ bộ binh. Nó là mẫu xe Pháp duy nhất sử dụng động cơ diesel. Tính đến năm 1939, có tổng cộng 100 chiếc đã được sản xuất."

msgid "F50_FCM36_20t_short"
msgstr "FCM 36"

msgid "F62_ELC_AMX"
msgstr "AMX ELC bis"

msgid "F62_ELC_AMX_descr"
msgstr "Được phát triển từ năm 1957 đến 1961 để cung cấp cho không quân Pháp một loại xe có thể vận chuyển bằng máy bay mà vẫn đủ khả năng giao chiến với các tăng hạng nặng. Nó được lắp súng 90mm và có vóc dáng rất thấp bé. Hai thành viên kíp lái đều ngồi trong tháp pháo, có thể xoay 360 độ, nhưng chỉ khi xe không di chuyển. Các phiên bản với nhiều loại súng khác nhau đã được phác thảo. Người ta mới chỉ chế tạo xong một nguyên mẫu. Chiếc xe này chưa bao giờ phục vụ trong biên chế quân đội."

msgid "F62_ELC_AMX_short"
msgstr "AMX ELC bis"

msgid "F64_AMX_50Fosh_B"
msgstr "AMX 50 Foch B"

msgid "F64_AMX_50Fosh_B_7x7"
msgstr "AMX 50 Foch B 7x7"

msgid "F64_AMX_50Fosh_B_7x7_short"
msgstr "Foch B 7x7"

msgid "F64_AMX_50Fosh_B_descr"
msgstr "Chương trình phát triển pháo chống tăng AMX 50 Foch bao gồm nòng súng 120 mm kết hợp với hệ thống nạp đạn tự động. Tuy nhiên, dự án bị đánh giá nhiều khả năng sẽ không hiệu quả trên chiến trường sau khi việc phát triển xe tăng AMX 50 120 sử dụng cùng loại vũ khí được bắt đầu. Chiếc xe chỉ tồn tại trên bản vẽ."

msgid "F64_AMX_50Fosh_B_short"
msgstr "Foch B"

msgid "F67_Bat_Chatillon155_55"
msgstr "Bat.-Châtillon 155 55"

msgid "F67_Bat_Chatillon155_55_descr"
msgstr "Vào giữa những năm 1950, Batignolles-Châtillon đã phát triển một thiết kế pháo tự hành hạng nặng rất độc đáo, đồng thời sở hữu nhiều yếu tố thuộc khung gầm của tăng hạng trung M47 từ Mỹ. Nó được trang bị pháo nòng ngắn 155 mm lắp trên tháp pháo quay hoàn toàn. Ít nhất một nguyên mẫu đã được chế tạo. Chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F67_Bat_Chatillon155_55_short"
msgstr "B-C 155 55"

msgid "F68_AMX_Chasseur_de_char_46"
msgstr "AMX Chasseur de chars"

msgid "F68_AMX_Chasseur_de_char_46_descr"
msgstr "Năm 1946, công ty AMX đã giới thiệu bản thiết kế về chiếc xe mới này. Động cơ mạnh mẽ cùng trọng lượng nhẹ khiến nó cực kỳ cơ động, còn nòng súng 90 mm được trang bị hệ thống nạp đạn cơ khí có tốc độ bắn rất cao. Tuy nhiên, do kích thước lớn, giáp bảo vệ quá mỏng, giá thành cao và thiết kế phức tạp khiến nó không hấp dẫn. Như một hệ quả tất yếu, dự án này chưa bao giờ đến được giai đoạn chế tạo nguyên mẫu."

msgid "F68_AMX_Chasseur_de_char_46_long_special"
msgstr "Đây là một trong những xe tăng nhanh nhất cấp của nó. Chưa kể, AMX CDC còn được trang bị nòng súng hoàn hảo. Có thể nói, nó chạy nhanh vì giáp quá mỏng, do vậy khó chống chịu được bất kỳ phát đạn nào. Tuy nhiên, rất khó bắn trúng CDC!"

msgid "F68_AMX_Chasseur_de_char_46_short"
msgstr "AMX CDC"

msgid "F68_AMX_Chasseur_de_char_46_short_special"
msgstr "Súng ổn định, cơ động hoàn hảo, tầm nhìn xa"

msgid "F69_AMX13_57_100"
msgstr "AMX 13 57"

msgid "F69_AMX13_57_100_GrandFinal"
msgstr "AMX 13 57 GF"

msgid "F69_AMX13_57_100_GrandFinal_descr"
msgstr "Công ty AMX đã lên kế hoạch thiết kế chiếc tăng hạng nhẹ này với mục đích lắp đặt nòng súng 57-mm L/100. Có nhiều vấn đề xảy ra trong quá trình phát triển làm chậm tiến độ của dự án; thậm chí, đến tận những năm 1950, chiếc tăng vẫn chưa sẵn sàng ra mắt. Vào thời điểm đó, đề án sản xuất một biến thể khác, gồm thân xe có chỉnh sửa cùng tháp pháo lắp đặt nòng 75 mm, đã được ưu tiên hơn, khiến phiên bản 57-mm bị dừng phát triển."

msgid "F69_AMX13_57_100_GrandFinal_long_special"
msgstr "Chiếc tăng hạng nhẹ này được trang bị nòng súng có hệ thống nạp đạn theo băng với sát thương lý thuyết khủng khiếp. Nó phát huy tối đa khả năng khi cận chiến—tám viên đạn sẽ gây ra thiệt hại cực lớn trong một khoảng thời gian ngắn."

msgid "F69_AMX13_57_100_GrandFinal_short"
msgstr "AMX 13 57F"

msgid "F69_AMX13_57_100_GrandFinal_short_special"
msgstr "Súng độc đáo và cơ động khá tốt"

msgid "F69_AMX13_57_100_descr"
msgstr "Công ty AMX đã lên kế hoạch thiết kế chiếc tăng hạng nhẹ này với mục đích lắp đặt nòng súng 57-mm L/100. Có nhiều vấn đề xảy ra trong quá trình phát triển làm chậm tiến độ của dự án; thậm chí, đến tận những năm 1950, chiếc tăng vẫn chưa sẵn sàng ra mắt. Vào thời điểm đó, đề án sản xuất một biến thể khác, gồm thân xe có chỉnh sửa cùng tháp pháo lắp đặt nòng 75 mm, đã được ưu tiên hơn, khiến phiên bản 57-mm bị dừng phát triển."

msgid "F69_AMX13_57_100_long_special"
msgstr "Chiếc tăng hạng nhẹ của Pháp này được trang bị nòng súng có hệ thống nạp đạn theo băng với sát thương lý thuyết khủng khiếp. Nó phát huy tối đa khả năng khi cận chiến—tám viên đạn sẽ gây ra thiệt hại cực lớn trong một khoảng thời gian ngắn."

msgid "F69_AMX13_57_100_short"
msgstr "AMX 13 57"

msgid "F69_AMX13_57_100_short_special"
msgstr "Chính xác cao và bắn nhanh"

msgid "F72_AMX_30"
msgstr "AMX 30 B"

msgid "F72_AMX_30_descr"
msgstr "Được phát triển vào năm 1966. AMX 30 B có khả năng di chuyển, công suất động cơ và cự ly giao chiến chống tăng hiệu quả vượt trội hơn mọi xe tăng khác (trừ Leopard 1). Tầm nhìn rất xa cho phép Chỉ huy phối hợp với kíp lái mà vẫn duy trì mức độ cảnh giác, từ đó tăng cường đáng kể hiệu quả chiến đấu chung. Vỏ bọc thép của xe khá mỏng, nhưng người ta cho rằng các tiến bộ kỹ thuật về đạn chống tăng khiến giáp bảo vệ luôn luôn tụt hậu: Khả năng sống sót lúc này sẽ dựa vào độ cơ động và hỏa lực. Có tổng cộng 2800 chiếc AMX 30 B đã được sản xuất."

msgid "F72_AMX_30_short"
msgstr "AMX 30 B"

msgid "F73_M4A1_Revalorise"
msgstr "M4A1 Revalorisé"

msgid "F73_M4A1_Revalorise_FL"
msgstr "M4A1 Revalorisé FL"

msgid "F73_M4A1_Revalorise_FL_short"
msgstr "M4A1 Rev. FL"

msgid "F73_M4A1_Revalorise_descr"
msgstr "Vào những năm 1950, hàng loạt bản chỉnh sửa của M4 Sherman được cung cấp cho Pháp như một phần thuộc chương trình MDAP. Các đơn vị thiết kế trong nước bắt đầu hiện đại hóa chiếc xe này nhằm mục đích tăng cường hỏa lực. Ý tưởng trên dẫn tới chương trình hiện đại hóa dành cho các Lực lượng Phòng thủ Israel (Sherman M51). Chiếc tăng này chưa bao giờ phục vụ trong biên chế quân đội Pháp. Hiện vẫn không rõ có bao nhiêu nguyên mẫu đã được chế tạo."

msgid "F73_M4A1_Revalorise_long_special"
msgstr "Chiếc tăng hạng trung này được trang bị nòng pháo uy lực với sát thương lớn mỗi phát, hạ nòng tốt và tốc độ đạn bay nhanh, giúp nó xoay chuyển cục diện ở những tình huống ngặt nghèo nhất. Tầm nhìn tốt cũng cho phép M4A1 Rev. phát hiện địch và khai hỏa trước. Tuy nhiên, nhớ rằng giáp bảo vệ và độ cơ động của nó chỉ ở mức trung bình."

msgid "F73_M4A1_Revalorise_short"
msgstr "M4A1 Rev."

msgid "F73_M4A1_Revalorise_short_special"
msgstr "Súng tốt với sát thương lớn mỗi phát bắn"

msgid "F74_AMX_M4_1949"
msgstr "AMX M4 mle. 49"

msgid "F74_AMX_M4_1949_FL"
msgstr "AMX M4 mle. 49 FL"

msgid "F74_AMX_M4_1949_FL_short"
msgstr "AMX M4 49 FL"

msgid "F74_AMX_M4_1949_Liberte"
msgstr "AMX M4 mle. 49 Liberté"

msgid "F74_AMX_M4_1949_Liberte_descr"
msgstr "Một tăng hạng nặng ban đầu được biết đến với cái tên \"Dự án 141\". Do Pháp cần nhiều tăng hạng nặng hiện đại hơn, quá trình phát triển chiếc xe này bắt đầu ngay lập tức sau Thế Chiến II. Chỉ tồn tại trên bản vẽ."

msgid "F74_AMX_M4_1949_Liberte_long_special"
msgstr "Chiếc tăng này có giáp trước khá tốt, nổi bật hơn hẳn các xe Pháp khác. Hãy tận dụng điều đó khi xuyên phá đội hình địch và tác chiến tầm gần ở vị trí thích hợp. Bên cạnh đó, tháp pháo dày và súng tốt–xuyên cao, hạ nòng thoải mái–sẽ hỗ trợ tối đa cho chiến thuật trên."

msgid "F74_AMX_M4_1949_Liberte_short"
msgstr "AMX M4 49 L"

msgid "F74_AMX_M4_1949_Liberte_short_special"
msgstr "Giáp trước tốt, tỷ lệ xuyên cao"

msgid "F74_AMX_M4_1949_descr"
msgstr "Một tăng hạng nặng ban đầu được biết đến với cái tên \"Dự án 141\". Do Pháp cần nhiều tăng hạng nặng hiện đại hơn, quá trình phát triển chiếc xe này bắt đầu ngay lập tức sau Thế Chiến II. Chỉ tồn tại trên bản vẽ."

msgid "F74_AMX_M4_1949_long_special"
msgstr "Chiếc tăng này có giáp trước khá tốt, nổi bật hơn hẳn các xe Pháp khác. Hãy tận dụng điều đó khi xuyên phá đội hình địch và tác chiến tầm gần ở vị trí thích hợp. Bên cạnh đó, tháp pháo dày và súng tốt–xuyên cao, hạ nòng thoải mái–sẽ hỗ trợ tối đa cho chiến thuật trên."

msgid "F74_AMX_M4_1949_short"
msgstr "AMX M4 49"

msgid "F74_AMX_M4_1949_short_special"
msgstr "Giáp trước tốt, tỷ lệ xuyên cao"

msgid "F75_Char_de_25t"
msgstr "Bat.-Châtillon 25 t AP"

msgid "F75_Char_de_25t_descr"
msgstr "Vào năm 1950–1951, các kỹ sư thuộc công ty FAMH (Compagnie des forges et aciéries de la marine et d'Homécourt) đã tiến hành phát triển một tăng hạng trung với nòng 90 mm và tháp pháo xoay được hoàn toàn. Tuy nhiên, công tác này bị ngừng lại ngay ở giai đoạn thiết kế sơ bộ. Về sau, mọi chi tiết của nó được tích hợp vào xe tăng Batignolles-Châtillon 25 t."

msgid "F75_Char_de_25t_short"
msgstr "B-C 25 t AP"

msgid "F77_FCM_2C"
msgstr "FCM 2C"

msgid "F77_FCM_2C_descr"
msgstr "Quá trình phát triển của tăng hạng nặng xuyên phá FCM 2C bắt đầu vào cuối năm 1916, mục tiêu nhằm thay thế tăng xung kích Saint-Chamond và Schneider CA1 thiết kế tệ hại. Đơn hàng gồm tổng cộng 700 chiếc dự tính xuất xưởng kịp thời cho kế hoạch tiến công mới mùa xuân năm 1919. Tuy nhiên, đơn hàng bị hủy bỏ do cuộc chiến kết thúc. Kết quả, quân đội Pháp chỉ nhận được 10 chiếc FCM 2C từ năm 1918 đến 1922. Mỗi chiếc có định danh riêng."

msgid "F77_FCM_2C_long_special"
msgstr "Một dự án tăng hạng nặng xuyên phá của Pháp từ năm 1918. Ngoài hình dáng ấn tượng, FCM 2C vác khẩu 75 mm khá tốt, chưa kể độ cơ động tương đối ổn so với kích thước khổng lồ và trọng lượng 70 tấn. Sức kháng cự 600 HP dồi dào sẽ đem lại khả năng sống dai để \"đè\" hầu hết các đối thủ trong tầm đối đầu."

msgid "F77_FCM_2C_short"
msgstr "FCM 2C"

msgid "F77_FCM_2C_short_special"
msgstr "Hình dáng độc đáo, HP khủng"

msgid "F81_Char_de_65t"
msgstr "AMX 65 t"

msgid "F81_Char_de_65t_descr"
msgstr "Một thiết kế tăng hạng nặng do hãng AMX đề xuất vào năm 1950 và được phát triển cùng với mẫu AMX 50 100. Theo dự kiến, AMX 65 t sẽ có giáp rất tốt với hình \"mũi lao\" và nghiêng khá hiệu quả. Những bộ phận khác và cấu hình thân xe khá giống với chiếc tăng Royal Tiger. Chỉ tồn tại trên bản vẽ."

msgid "F81_Char_de_65t_short"
msgstr "AMX 65 t"

msgid "F82_AMX_M4_Mle1949_Ter"
msgstr "AMX M4 mle. 54"

msgid "F82_AMX_M4_Mle1949_Ter_7x7"
msgstr "AMX M4 mle. 54 7x7"

msgid "F82_AMX_M4_Mle1949_Ter_7x7_descr"
msgstr "Một phiên bản của tăng hạng nặng AMX M4 dựa trên Project 141 với giáp tốt hơn. Theo kế hoạch, thân xe phía trước còn có thể được bổ sung thêm một lớp giáp dày 280 mm. Chỉ tồn tại trên bản vẽ."

msgid "F82_AMX_M4_Mle1949_Ter_7x7_short"
msgstr "AMX 54 7x7"

msgid "F82_AMX_M4_Mle1949_Ter_descr"
msgstr "Một phiên bản của tăng hạng nặng AMX M4 dựa trên Project 141 với giáp tốt hơn. Theo kế hoạch, thân xe phía trước còn có thể được bổ sung thêm một lớp giáp dày 280 mm. Chỉ tồn tại trên bản vẽ."

msgid "F82_AMX_M4_Mle1949_Ter_short"
msgstr "AMX M4 54"

msgid "F83_AMX_M4_Mle1949_Bis"
msgstr "AMX M4 mle. 51"

msgid "F83_AMX_M4_Mle1949_Bis_FL"
msgstr "AMX M4 mle. 51 FL"

msgid "F83_AMX_M4_Mle1949_Bis_FL_short"
msgstr "AMX M4 51 FL"

msgid "F83_AMX_M4_Mle1949_Bis_descr"
msgstr "Project 141 là một phiên bản của tăng hạng nặng AMX M4 với giáp tốt hơn. Quá trình phát triển bắt đầu vào tháng 11/1949 nhưng chưa bao giờ được chế tạo. Dự án này cũng bao gồm rất nhiều giá trị tính toán cho các thân xe khác nhau trên cùng một khung gầm."

msgid "F83_AMX_M4_Mle1949_Bis_short"
msgstr "AMX M4 51"

msgid "F84_Somua_SM"
msgstr "Somua SM"

msgid "F84_Somua_SM_descr"
msgstr "Một tăng hạng nặng của Pháp, đại diện thay thế cho AMX 50 tại một cuộc thi thiết kế. Quá trình phát triển nó bắt đầu vào năm 1946; tuy nhiên, đến tận tháng 10/1951 mới hoàn thành xong nguyên mẫu. Nhiều công nghệ chế tạo tăng của Đức đã được áp dụng trong quá trình phát triển chiếc xe này: Nó sở hữu súng 100-mm với hệ thống tự động nạp đạn theo băng lắp trên tháp pháo \"gật\". Somua SM đã trải qua các cuộc thử nghiệm từ tháng 01 đến 07/1953 nhưng không cho thấy bất kỳ triển vọng nào. Lẽ tất yếu, dự án này bị ngừng lại để nhường chỗ cho AMX 50."

msgid "F84_Somua_SM_long_special"
msgstr "Một tăng hạng nặng với băng đạn 5 viên có khả năng gây ra 1500 HP thiệt hại trong khoảng thời gian ngắn; thêm vào đó, nó sở hữu góc nâng/hạ nòng ấn tượng và độ cơ động tốt. Giáp trước khá ổn, có thể chống chịu một số phát đạn, nhưng tháp pháo thì hoàn toàn ngược lại."

msgid "F84_Somua_SM_short"
msgstr "Somua SM"

msgid "F84_Somua_SM_short_special"
msgstr "Góc nâng/hạ nòng xuất sắc và hệ thống nạp đạn theo băng"

msgid "F85_M4A1_FL10"
msgstr "M4A1 FL 10"

msgid "F85_M4A1_FL10_descr"
msgstr "Được Batignolles-Châtillon phát triển theo yêu cầu của các Lực lượng Vũ trang Ai Cập, chiếc tăng này là một phiên bản hiện đại hóa quy mô lớn của M4 Sherman. Những xe xuất xưởng đầu tiên có thân và khung gầm của M4A1 nhưng lại gắn tháp pháo FL 10 từ AMX 13. Tuy nhiên, hầu hết các xe này dùng thân và khung gầm M4A4. Tổng cộng 50 chiếc đã được sản xuất và phục vụ trong biên chế các Lực lượng Vũ trang Ai Cập cho đến giữa những năm 1960. Về sau, các tăng còn đủ khả năng chiến đấu được bổ sung vào Sư đoàn Số 20 thuộc Tổ chức Giải phóng Palestine tại Dải Gaza."

msgid "F85_M4A1_FL10_long_special"
msgstr "Một xe tăng cơ động với súng bắn nhanh. Sát thương thấp mỗi phát được bù lại bằng lượng thiệt hại cao trên một phút. Một trong những điểm nổi bật của nó là tốc độ nạp đạn nhanh. Tuy nhiên, độ chính xác còn nhiều điều để nói. Ngoài ra, giáp không nổi bật khiến bạn phải cẩn trọng khi chơi."

msgid "F85_M4A1_FL10_short"
msgstr "M4A1 FL 10"

msgid "F85_M4A1_FL10_short_special"
msgstr "Nóng súng với hệ thống nạp đạn theo băng và sát thương cao mỗi phút, cơ động tốt"

msgid "F87_Batignolles-Chatillon_12t"
msgstr "Bat.-Châtillon 12 t"

msgid "F87_Batignolles-Chatillon_12t_descr"
msgstr "Một tăng hạng nhẹ được phát triển bởi Batignolles-Châtillon vào cuối những năm 1940. Bat.-Châtillon 12 t đặc trưng với tháp pháo \"gật\" và súng 75-mm. Chưa bao giờ được sản xuất hàng loạt."

msgid "F87_Batignolles-Chatillon_12t_short"
msgstr "B-C 12 t"

msgid "F88_AMX_13_105"
msgstr "AMX 13 105"

msgid "F88_AMX_13_105_7x7"
msgstr "AMX 13 105 7x7"

msgid "F88_AMX_13_105_7x7_short"
msgstr "AMX 13 105 7"

msgid "F88_AMX_13_105_descr"
msgstr "Một phiên bản của AMX 13 được phát triển vào cuối những năm 1950. Người ta đã chỉnh sửa tháp pháo FL 12  để lắp pháo 105-mm lên xe. Tuy nhiên, phiên bản này không phục vụ trong biên chế lục quân Pháo mà đem xuất khẩu sang các quốc gia khác; AMX 13 105 được cấp phép sản xuất tại Argentina. Mặc dù hỏa lực mạnh hơn trước, thiết kế mới có nhiều nhược điểm. Chẳng hạn, súng giật quá mạnh đôi khi làm nứt tháp pháo."

msgid "F88_AMX_13_105_short"
msgstr "AMX 13 105"

msgid "F89_Canon_dassaut_de_105"
msgstr "AMX Canon d'assaut 105"

msgid "F89_Canon_dassaut_de_105_descr"
msgstr "Pháo chống tăng Canon d'assaut de 105 là một xe chiến đấu được phát triển bởi Công ty AMX vào năm 1958. Theo các tư liệu lịch sử, ý định ban đầu của pháo chống tăng này là kết hợp khả năng cơ động và linh hoạt, giáp chắc chắn (dày đến 100 mm tại mặt trước) cùng một khẩu súng uy lực nòng 105-mm. Sau đó, quá trình phát triển bị đình chỉ, không nguyên mẫu nào được chế tạo."

msgid "F89_Canon_dassaut_de_105_long_special"
msgstr "Chiếc pháo chống tăng này là lựa chọn hoàn hảo cho chiến thuật phục kích. Nó có độ cơ động cao, giúp nhanh chóng chiếm lĩnh các vị trí chiến lược ở bất kỳ bản đồ nào để tận dụng tối đa khả năng của nòng súng chính xác. Tuy nhiên, giáp bảo vệ không tốt nên ưu tiên hàng đầu là tránh bị lộ diện."

msgid "F89_Canon_dassaut_de_105_short"
msgstr "AMX Cda 105"

msgid "F89_Canon_dassaut_de_105_short_special"
msgstr "Súng và độ cơ động tuyệt vời"

msgid "F97_ELC_EVEN_90"
msgstr "ELC EVEN 90"

msgid "F97_ELC_EVEN_90_FL"
msgstr "ELC EVEN 90 FL"

msgid "F97_ELC_EVEN_90_FL_short"
msgstr "ELC EVEN 90 FL"

msgid "F97_ELC_EVEN_90_descr"
msgstr "Một dòng xe được phát triển bởi BRUNON-VALETTE theo chương trình ELC vào cuối những năm 1950. Mục đích chung là chế tạo một tăng hạng nhẹ vận chuyển được bằng đường không nhằm hỗ trợ hỏa lực. Chiếc xe này có kích thước nhỏ và độ cơ động cao. Tổng cộng 10 xe thí điểm được sản xuất với các loại vũ trang khác nhau. Chúng đã trải qua giai đoạn thử nghiệm nhưng chưa bao giờ đi vào sản xuất hàng loạt."

msgid "F97_ELC_EVEN_90_long_special"
msgstr "Một xe trinh sát xuất sắc, kích thước nhỏ gọn, cơ động vượt trội và ẩn giấu tốt, cho phép nó luôn luôn có mặt đúng lúc đúng chỗ. Chiếc tăng này còn sở hữu súng nạp đạn tự động 3-viên, có khả năng gây ra 660 HP trong thời gian ngắn. Tuy nhiên, đừng bao giờ quên giáp chỉ ở mức \"tượng trưng\", không thể chịu nổi đòn đâm/húc mạnh."

msgid "F97_ELC_EVEN_90_short"
msgstr "ELC EVEN 90"

msgid "F97_ELC_EVEN_90_short_special"
msgstr "Hệ thống nạp đạn theo băng và cơ động tuyệt vời"

msgid "FCM_36Pak40"
msgstr "FCM 36 Pak 40"

msgid "FCM_36Pak40_descr"
msgstr "Vào năm 1943, mười chiếc FCM 36 mà Đức thu giữ được chuyển đổi thành pháo chống tăng. Chúng đã tham chiến tại Pháp cùng Verstärkte Schnelle Brigade West."

msgid "FCM_36Pak40_short"
msgstr "FCM36Pak40"

msgid "FCM_50t"
msgstr "FCM 50 t"

msgid "FCM_50t_descr"
msgstr "Quá trình phát triển bắt đầu từ tháng 12/1945. Theo kế hoạch, nó là một bản thay thế cho AMX 50t, kết hợp nhiều đặc điểm xưa cũ điển hình của ngành công nghiệp xe tăng nước Pháp trước chiến tranh với các cải tiến từ Đức. Chiếc xe này còn được dự định lắp đặt thêm một thùng xe moóc phụ, thiết bị hỗ trợ di chuyển dưới nước, và một bộ phận phá mìn tháo gỡ được."

msgid "FCM_50t_long_special"
msgstr "Chiếc tăng hạng nặng này nhìn chung có lối chơi theo kiểu tăng hạng trung: Nó khá nhanh dù kích thước lớn, nòng súng và tầm nhìn hoàn hảo. Tuy nhiên, FCM 50 t không có giáp dày, do vậy chỉ thích hợp trong vai trò hỗ trợ."

msgid "FCM_50t_short"
msgstr "FCM 50 t"

msgid "FCM_50t_short_special"
msgstr "Súng tốt, tầm nhìn hoàn hảo, ưu tiên xếp trận dễ"

