msgstr "D1"

msgid "D1_descr"
msgstr "Được bắt đầu phát triển từ năm 1929. Quá trình sản xuất hàng loạt bắt đầu vào năm 1930, với 160 chiếc được chế tạo tính đến năm 1935. Tổng số 152 chiếc đã chiến đấu ở Pháp. 18 chiếc bị quân đội Đức bắt giữ và sử dụng vào mục đích huấn luyện."

msgid "D1_short"
