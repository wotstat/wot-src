msgid "D2_descr"
msgstr "Bản tùy chỉnh cao hơn của xe tăng D1. Được phát triển vào năm 1934 bởi công ty Renault. Tổng số 100 chiếc đã được chế tạo từ năm 1936 đến năm 1940. Những xe thuộc dòng xe thứ 2 đã được đặt tên là D2bis."

msgid "D2_short"
