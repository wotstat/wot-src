msgid "abilitiesIncomplete/title"
msgstr "Thiếu Khả năng Chiến đấu"

msgid "abilitiesIncomplete/toAbilities"
msgstr "Đến Khả năng"

msgid "abilitiesIncomplete/toBattle"
msgstr "Đến Trận"

msgid "abilitiesIncomplete/warning"
msgstr "Xe đã chọn đang thiếu một hoặc nhiều Kỹ năng Chiến đấu. Điều này có thể ảnh hưởng đáng kể đến hiệu suất đánh. Vẫn vào trận?"

msgid "ammoSetup/changeHotKey/body"
msgstr "Bạn có thể tùy chỉnh tiền lập mặc định về phím tắt cho đạn và Khả năng Chiến đấu.\nThay đổi này chỉ áp dụng ở các trận trong sự kiện và không ảnh hưởng bất kỳ chế độ nào khác.\nBạn cũng có thể sửa từng phím tắt riêng tại Menu — Thiết lập — Điều khiển (mục Vật phẩm)."

msgid "ammoSetup/changeHotKey/header"
msgstr "Đổi Tiền lập Phím Tắt Vật phẩm"

msgid "anomaliesView/description_1"
msgstr "Đây là các khoản bonus kíp lái trong trận. Ở độ khó {{@ style (color #EEEDE9B2) (bold)}}Cao{{/}} và {{@ style (color #EEEDE9B2) (bold)}}Ác mộng{{/}}, hãy chọn Dị điểm lúc đánh rồi kết hợp chúng để mở khóa {{@ style (color #C293FFCC) (bold)}}Dị điểm Echo{{/}} tối thượng."

msgid "anomaliesView/description_2"
msgstr "Hướng dẫn này hiển thị các Dị điểm mà bạn đã nhận được trong những trận trước đó, cũng như Dị điểm chưa khám phá. Để mở Menu Dị điểm lúc đánh nhau, {{@ style (color #EEEDE9B2) (bold)}}hãy nhấn N{{/}} (phím mặc định)."

msgid "anomaliesView/header"
msgstr "DỊ ĐIỂM"

msgid "anomaliesView/quote_1/author"
msgstr "—Object 66, The Quiet One\nNgười ta nói hắn chưa từng được cử đi bất kỳ chuyến nào. Thế nhưng, những người khác lại chạm mặt hắn bên trong Dị điểm. Hắn lặng lẽ bàn giao các ghi chép mới rồi quay bước đi."

msgid "anomaliesView/quote_1/message"
msgstr "Cầu Mirium tùm lum trong ta."

msgid "anomaliesView/quote_2/author"
msgstr "—Object 6, Pied Piper\nMột kỹ sư trở về từ một chuyến thám hiểm và chế tạo Wavebreaker. Có người nói Mirium đã thay đổi ông ta. Kẻ khác cho rằng vốn đã vậy từ trước."

msgid "anomaliesView/quote_2/message"
msgstr "Nghe thấy không?\nMirium đang gọi."

msgid "anomaliesView/quote_3/author"
msgstr "—Object 12, Magpie\nTrợ lý phòng thí nghiệm từ chuyến thám hiểm đầu tiên, được liệt vào hàng mất tích. Nhưng quay lại. Không đúng nơi, không đúng thời điểm, và không phải cái người đi trước."

msgid "anomaliesView/quote_3/message"
msgstr "Dù rời khỏi Dị điểm bao nhiêu lần, nó vẫn sẽ kéo quay trở lại."

msgid "anomaliesView/title"
msgstr "Combo Dị điểm"

msgid "badgeWidget/tooltipBody"
msgstr "Hoàn thành nhiệm vụ hiện tại để nhận phù hiệu Babylon: Forbidden Zone độc đáo:"

msgid "badgeWidget/tooltipHeader"
msgstr "Nhiệm vụ Thành tựu Vĩ đại"

msgid "bestiaryView/carousel/card/new"
msgstr "MỚI"

msgid "bestiaryView/carousel/card/state/locked"
msgstr "Bị khóa"

msgid "bestiaryView/carousel/card/tooltip/locked/body"
msgstr "Hoàn thành Nhiệm vụ {number} để mở khóa hồ sơ của địch."

msgid "bestiaryView/carousel/card/tooltip/style/body"
msgstr "Đội lốt địch trong chế độ Trận đấu Ngẫu nhiên với kiểu mẫu 3D xoắn não kiểu Babylon từ cửa hàng sự kiện."

msgid "bestiaryView/info/about/czech_Cz34_Vz_71_Tesak_HW_BOT"
msgstr "?empty?"

msgid "bestiaryView/info/about/france_F110_Lynx_6x6_HW_BOT"
msgstr "Một kẻ địch nhẹ cân, nhanh, có khả năng điều khiển các đòn tấn công năng lượng vào mục tiêu."

msgid "bestiaryView/info/about/france_F17_AMX_13_90_HW_BOT"
msgstr "Một chiếc tăng Hornet thất lạc, giờ quay lại săn đồng đội cũ. Lòng căm hận tột độ của nó đã biến thành hỏa lực tập trung, thiêu cháy địch trong từng phát bắn."

msgid "bestiaryView/info/about/germany_G00_Bomber_Hell"
msgstr "Những quả cầu đen tự hành, phủ đầy gai như thủy lôi hải quân. Hedgehog luôn xuất hiện theo bầy. Nhanh, cực cơ động, chúng chỉ gây sát thương bằng cách phát nổ khi va chạm. Trúng phát đã dễ toi lắm. Nhiều con cùng lúc? Xong luôn."

msgid "bestiaryView/info/about/germany_G00_K_bomber__HW_21_AI"
msgstr "Tương tự Hedgehog thông thường về đặc điểm và hành vi, Alpha Hedgehog còn rắc rối hơn nữa. Khi phát hiện thứ này, toàn bộ đội được khuyến cáo mạnh mẽ nên tập trung diệt nó."

msgid "bestiaryView/info/about/germany_G113_SP_I_C_HW_BOT"
msgstr "Một nhóm xe tăng liên kết thành cấu trúc duy nhất. Sát thương gây lên một chiếc sẽ truyền sang số còn lại. Chúng cùng đứng vững hoặc cùng chết."

msgid "bestiaryView/info/about/germany_G142_M48RPz_HW_BOT"
msgstr "Một kẻ địch thường thấy trong Dị điểm, canh giữ những vị trí có Vật Chất. Khi bạn đến gần trại, tất cả Vệ Binh Guard ẩn náu ở đó sẽ lộ diện và tấn công. Chúng là tạo vật của Mirium, biến mất không để lại dấu vết lúc chết."

msgid "bestiaryView/info/about/germany_G171_E77_HW_BOT"
msgstr "Monarch đóng vai trò điểm neo cho Hive, duy trì mọi đơn vị gần đó."

msgid "bestiaryView/info/about/germany_G181_E100_Autocannon_Boss_HW25_bot"
msgstr "?empty?"

msgid "bestiaryView/info/about/germany_G25_PzII_Luchs_HELL_HALL"
msgstr "Một kẻ địch hèn nhát và thận trọng, thích rút ngay khi có dấu hiệu bị phát hiện. Không nguy hiểm, nhưng đáng chú ý vì dễ ăn và đem lại nguồn Mirium."

msgid "bestiaryView/info/about/germany_G64_Panther_II_Hall_minion"
msgstr "Một tăng hạng trung có khả năng truy đuổi kíp lái chúng ta khắp toàn bộ Dị điểm. Những quả đạn nổ mạnh uy lực của nó gây sát thương đáng kể lên đồng minh giáp mỏng."

msgid "bestiaryView/info/about/germany_G73_E50_Ausf_M_Hall_minion"
msgstr "Một tăng hạng nặng mạnh mẽ, có xu hướng dẫn đầu tốp canh Guard ở các trại. Độ bền khủng, sát thương đầu ra cao khiến nó thành mối đe dọa chết người."

msgid "bestiaryView/info/about/italy_It19_Progetto_C50_mod_66_HW_BOT"
msgstr "Một phiên bản méo mó của Legio Ferrata bị Mirium sao chép, nay quay lưng chống lại đồng minh cũ với sức mạnh còn lớn hơn trước."

msgid "bestiaryView/info/about/uk_GB100_Manticore_HW_BOT"
msgstr "Một đối thủ nhanh nhẹn, thấp gọn, nổi bật với tốc độ cao, sức kháng cự vượt trội. Tích hợp xích không bao giờ đứt, nó mang theo lượng Mirium khổng lồ và sẽ lập tức tìm cách chạy ngay khi bị phát hiện."

msgid "bestiaryView/info/about/uk_GB125_Saladin_HW_BOT"
msgstr "Kẻ địch này không mang theo vũ khí thông thường. Thay vào đó, nó sẽ cố gắng áp sát rồi tự hủy, giải phóng sóng xung kích làm choáng tất cả xe trong bán kính vụ nổ."

msgid "bestiaryView/info/about/uk_GB24_Centurion_Mk3_HW_BOT"
msgstr "Một Cerberus lạc lối trong Dị điểm, mục đích duy nhất giờ là săn những kẻ đang tìm cách chiếm đoạt Mirium của nó."

msgid "bestiaryView/info/about/usa_A100_T49_HW_BOT"
msgstr "Một Lost Grenadier vẫn có thể được tìm thấy bên trong Dị Thường. Khả năng gây sát thương cao và hệ thống dẫn đường laser khiến nó là đối thủ đáng gờm."

msgid "bestiaryView/info/about/ussr_R171_IS_3_II_HW_BOT"
msgstr "Một tăng hạng nặng thực hiện những cú húc tàn khốc. Nó thường di chuyển phía trước các đợt tấn công của địch, gây hỗn loạn đội hình. Với một đòn thành công, nó có thể diệt mục tiêu ngay."

msgid "bestiaryView/info/about/ussr_R40_T-54_HW_BOT"
msgstr "Một Malachite lạc lối trong Dị điểm, giờ đây cực kỳ nguy hiểm. Nó vẫn giữ nguyên các khả năng ban đầu và cố gắng tiếp cận bạn càng gần càng tốt."

msgid "bestiaryView/info/about/ussr_R77_KV2_turret_2"
msgstr "Thoạt nhìn, đây có vẻ dễ đối phó, nhưng đừng bị lừa. Giáp trước dày cùng súng chính xác rất cao khiến nó là mối đe dọa đáng gờm khi đối đầu trực diện."

msgid "bestiaryView/info/description/ability_1"
msgstr "Không thể rời khỏi khu vực được canh gác và truy đuổi các xe rút lui."

msgid "bestiaryView/info/description/ability_10"
msgstr "Định kỳ gây sát thương lên mọi xe ở gần bằng một sóng năng lượng tạo ra từ các cuộn dây của nó."

msgid "bestiaryView/info/description/ability_11"
msgstr "Dị điểm đã biến đổi khẩu súng của xe này, tạo ra hỏa lực tập trung khiến mỗi phát bắn đều có thể thiêu cháy mục tiêu."

msgid "bestiaryView/info/description/ability_12"
msgstr "Bắn đạn nổ mạnh từ cơ cấu nạp tự động theo băng 2-viên."

msgid "bestiaryView/info/description/ability_13"
msgstr "Nó đốt cháy sức mạnh của các cỗ máy trong phạm vi hào quang, đồng thời rút cạn Vật chất mà người chơi đã thu nhặt."

msgid "bestiaryView/info/description/ability_14"
msgstr "Đạn được tăng cường năng lượng echo cô đặc, sát thương lớn hơn đáng kể cho mọi phát trúng."

msgid "bestiaryView/info/description/ability_15"
msgstr "Tạo một vùng quanh chính nó. Sau khoảng trễ ngắn, vùng này sẽ phát nổ: Bất kỳ xe đồng minh kẹt bên trong sẽ bị choáng. Phá hủy Detonator trước khi vụ nổ xảy ra, hiệu ứng choáng sẽ giáng xuống tăng echo xung quanh thay vào đó."

msgid "bestiaryView/info/description/ability_16"
msgstr "Nó không di chuyển, hoạt động như ụ súng cố định và bắn tăng địch với độ chính xác cao."

msgid "bestiaryView/info/description/ability_17"
msgstr "Hoạt động như liên kết sự sống chủ chốt của cả nhóm, khiến mọi đơn vị đều phụ thuộc vào thủ lĩnh này."

msgid "bestiaryView/info/description/ability_18"
msgstr "Một liên kết trực tiếp gắn lõi đơn vị này với Monarch của nó. Khi chủ thể gục ngã, liên kết sẽ đứt và cấu trúc đơn vị sẽ sụp đổ ngay sau đó."

msgid "bestiaryView/info/description/ability_19"
msgstr "Khi bị phá hủy, kẻ địch này để lại một Dị điểm cô đặc mà lúc nhặt lên, nó sẽ trao cho cả đội một Dị điểm Pick-Up Anomaly đặc biệt."

msgid "bestiaryView/info/description/ability_2"
msgstr "Sử dụng Bộ Sạc để nhanh chóng áp sát mục tiêu và húc nó, gây sát thương đáng kể."

msgid "bestiaryView/info/description/ability_3"
msgstr "Hunter phát hiện địch từ rất xa, bắn đạn nổ mạnh bay chậm, có thể cực kỳ nguy hiểm không chỉ cho tăng hạng nhẹ mà còn với hông và phía sau tăng hạng trung, thậm chí cả tăng hạng nặng."

msgid "bestiaryView/info/description/ability_4"
msgstr "Sử dụng Mirium để đặt bẫy trên mặt đất bên dưới con mồi. Những vùng này sẽ phát nổ sau vài giây. Di chuyển, nếu không muốn bị xé toạc."

msgid "bestiaryView/info/description/ability_5"
msgstr "Khi bị phát hiện, nó sẽ bỏ chạy với tốc độ nhanh nhất, mang Mirium theo."

msgid "bestiaryView/info/description/ability_6"
msgstr "Khóa mục tiêu gần nhất và lao tới với tốc độ tối đa, phát nổ lúc va chạm. Vụ nổ cũng có thể gây hư hại cho các xe ở gần."

msgid "bestiaryView/info/description/ability_7"
msgstr "Khi bị phá hủy, Alpha Hedgehog sẽ vỡ ra thành nhiều Hedgehog thường (nhìn chung khoảng 3 con, nhưng số lượng có thể thay đổi), chúng sẽ đuổi theo đồng minh gần nhất, húc và phát nổ."

msgid "bestiaryView/info/description/ability_8"
msgstr "Phát ra hào quang Mirium làm ăn mòn giáp các xe gần đó, hấp thụ vật liệu bị mất để tự phục hồi."

msgid "bestiaryView/info/description/ability_9"
msgstr "Vũ khí có tốc độ bắn cao cho phép kẻ địch này gây thêm sát thương."

msgid "bestiaryView/info/tacticalAdvise/czech_Cz34_Vz_71_Tesak_HW_BOT"
msgstr "{UL}tacticalAdvise_czech_Cz34_Vz_71_Tesak_HW_BOT {UL}{LI}{f7f6f299Bold_open}Tactic_1{f7f6f299Bold_close}: do_1.{UL}{LI}{f7f6f299Bold_open}Tactic_2{f7f6f299Bold_close}: do_2.{UL}{LI}{f7f6f299Bold_open}Tactic_3{f7f6f299Bold_close}: do_3 ."

msgid "bestiaryView/info/tacticalAdvise/france_F110_Lynx_6x6_HW_BOT"
msgstr "{UL}Nó sẽ không để yên! Hãy tập trung diệt Trapper trước.{UL}{LI}{{@ style (bold)}}Tản ra{{/}}: Nếu đồng minh ở quá gần, bạn có thể lao vào vùng sát thương của họ khi đang cố thoát khỏi vùng của mình.{UL}{LI}{{@ style (bold)}}Tránh lối đi hẹp{{/}}: Hãy duy trì khả năng cơ động tối đa.{UL}{LI}{{@ style (bold)}}Sử dụng khả năng của xe{{/}}: Khiên Shield sẽ bảo vệ khỏi sát thương từ vùng chết, còn Tàng hình Stealth ngăn Trapper khóa mục tiêu vào mình ngay từ đầu. Tuy nhiên, hãy nhớ Tàng hình Stealth sẽ không ích gì nếu đã ở trong vùng thiệt hại."

msgid "bestiaryView/info/tacticalAdvise/france_F17_AMX_13_90_HW_BOT"
msgstr "{UL}Đếm cơ số đạn, nó có đủ cho mọi thành viên trong đội của bạn!{UL}{LI}{{@ style (bold)}}Mục tiêu ưu tiên cao{{/}}: Với nhiều khả năng dị thường, chiếc tăng này là mối đe dọa lớn cho toàn đội.{UL}{LI}{{@ style (bold)}}Chiến thuật thắng{{/}}: Tàng hình Stealth và sửa nhóm Group Repair có thể dập lửa, giúp bạn hoặc đồng minh không bị cháy rụi hoàn toàn.{UL}{LI}{{@ style (bold)}}Dồn hạ gục{{/}}: Dùng Turbo để húc nó, ra đòn chớp nhoáng!"

msgid "bestiaryView/info/tacticalAdvise/germany_G00_Bomber_Hell"
msgstr "{UL}Sau khi bị phát hiện, Hedgehog phải trở thành ưu tiên hàng đầu của cả đội!{UL}{LI}{{@ style (bold)}}Điểm yếu{{/}}: Chúng không có giáp, cực kỳ dễ diệt bằng bất kỳ loại vũ khí nào.{UL}{LI}{{@ style (bold)}}Chiến thuật theo bầy{{/}}: Chúng thường sống bầy đàn, vì vậy luôn cảnh giác, đừng để bất ngờ.{UL}{LI}{{@ style (bold)}}Lợi thế diện rộng{{/}}: Hãy sử dụng các khả năng gây sát thương diện rộng như Energy Shot hoặc Vampiric Shot để diệt cả cụm chỉ trong một đòn."

msgid "bestiaryView/info/tacticalAdvise/germany_G00_K_bomber__HW_21_AI"
msgstr "{UL}Sau khi xử lý Alpha, hãy sẵn sàng đối phó Hedgehog thường!{UL}{LI}{{@ style (bold)}}Sát thương diện rộng{{/}}: Hãy dùng Khả năng Chiến đấu—chỉ một đòn diện rộng cũng đủ để diệt cả nhóm trong một phát.{UL}{LI}{{@ style (bold)}}Canh thời điểm dùng Khiên{{/}}: Hãy dùng Energy Shield để hấp thụ sát thương khi Hedgehog lao vào, nhưng phải canh thật chuẩn để kích hoạt ngay trước lúc va chạm.{UL}{LI}{{@ style (bold)}}Luôn cơ động{{/}}: Nếu xe mình khá mỏng manh, hãy tận dụng tốc độ và Turbo để né tránh bầy đàn, hạ từng con từ khoảng cách an toàn."

msgid "bestiaryView/info/tacticalAdvise/germany_G113_SP_I_C_HW_BOT"
msgstr "{UL}4 đầu, 1 lõi.{UL}{LI}{{@ style (bold)}}Kết cấu chung{{/}}: Mọi phát bắn đều quan trọng, bất kể trúng chiếc nào. Gây sát thương lên bất kỳ đơn vị nào trong cụm cũng sẽ bào mòn kết cấu chung của chúng.{UL}{LI}{{@ style (bold)}}Hỏa lực không đổi{{/}}: Vì chung kết cấu duy nhất, bạn không thể giảm hỏa lực của chúng bằng cách phá hủy từng đơn vị từ sớm—tất cả đều phải diệt tận gốc.{UL}{LI}{{@ style (bold)}}Tối đa hóa lợi nhuận{{/}}: Bảo đảm diệt toàn bộ Hive để làm đầy bộ thu, lấy nhiều Mirium hơn."

msgid "bestiaryView/info/tacticalAdvise/germany_G142_M48RPz_HW_BOT"
msgstr "{UL}Trong Dị điểm, tinh thần đồng đội là chìa khóa thành công.{UL}{LI}{{@ style (bold)}}Phối hợp{{/}}: Chỉ tấn công trại địch khi phối hợp, tuyệt đối không hành động một mình!{UL}{LI}{{@ style (bold)}}Ưu thế hỏa lực{{/}}: Địch chết mới không thể gây hại. Giết nhầm còn hơn bỏ sót.{UL}{LI}{{@ style (bold)}}Rút lui chiến thuật{{/}}: Nếu có nguy cơ chết, bạn có thể rút ra ngoài trại để bảo toàn phương tiện."

msgid "bestiaryView/info/tacticalAdvise/germany_G171_E77_HW_BOT"
msgstr "{UL}Chặt đầu, thân gục!{UL}{LI}{{@ style (bold)}}Đánh thẳng vào tim{{/}}: Dùng Turbo để phá vòng vây và tiêu diệt Monarch.{UL}{LI}{{@ style (bold)}}Mục tiêu dễ xơi{{/}}: Bản thân Monarch không phải là đối thủ khó diệt.{UL}{LI}{{@ style (bold)}}Lựa chọn chiến lược{{/}}: Phải ưu tiên—hạ Monarch để kết thúc trận ngay, hoặc dọn sạch xe tăng Hive trước để làm đầy bộ thu và kiếm thêm Mirium."

msgid "bestiaryView/info/tacticalAdvise/germany_G181_E100_Autocannon_Boss_HW25_bot"
msgstr "{UL}tacticalAdvise_germany_G181_E100_Autocannon_Boss_HW25_bot {UL}{LI}{f7f6f299Bold_open}Tactic_1{f7f6f299Bold_close}: do_1.{UL}{LI}{f7f6f299Bold_open}Tactic_2{f7f6f299Bold_close}: do_2.{UL}{LI}{f7f6f299Bold_open}Tactic_3{f7f6f299Bold_close}: do_3 ."

msgid "bestiaryView/info/tacticalAdvise/germany_G25_PzII_Luchs_HELL_HALL"
msgstr "{UL}Đừng để chúng thoát!{UL}{LI}{{@ style (bold)}}Khả năng sống sót thấp{{/}}: Có thể bị phá hủy chỉ với một hoặc hai phát bắn, ngay cả bởi súng yếu.{UL}{LI}{{@ style (bold)}}Ưu tiên Rabbit ở xa{{/}}: Đừng để chúng chạy thoát. Hãy bắn vào xích của chúng nếu cần.{UL}{LI}{{@ style (bold)}}Dùng Turbo{{/}}: Khả năng này sẽ giúp bạn truy đuổi Rabbit đang bỏ chạy hoặc diệt nó nếu húc nhẹ."

msgid "bestiaryView/info/tacticalAdvise/germany_G64_Panther_II_Hall_minion"
msgstr "{UL}Hunter sẽ truy đuổi bạn trên toàn bản đồ, vì vậy rút lui cũng khó.{UL}{LI}{{@ style (bold)}}Luôn cảnh giác{{/}}: Hãy giao chiến với Hunter sau lúc xử xong lực lượng chính của địch hoặc trước khi bắt đầu cuộc chạm trán mới.{UL}{LI}{{@ style (bold)}}Luôn di chuyển{{/}}: Bạn có thể né các quả đạn HE bay chậm bằng cách cơ động.{UL}{LI}{{@ style (bold)}}Pháo hoa{{/}}: Hai bên sườn của Hunter là nơi trực tiếp chứa đạn, dễ hỏng và dễ phát nổ—hãy ngắm vào đó."

msgid "bestiaryView/info/tacticalAdvise/germany_G73_E50_Ausf_M_Hall_minion"
msgstr "{UL}To xác và vụng về, hãy tận dụng điều đó làm lợi thế cho mình!{UL}{LI}{{@ style (bold)}}Dễ bị phát hiện{{/}}: Hãy cố áp sát và di chuyển sang bên hông kẻ địch, giữ bản thân luôn ở dưới nòng pháo nó.{UL}{LI}{{@ style (bold)}}Tận dụng địa hình{{/}}: Hãy tận dụng môi trường xung quanh. Đứng giữa đồng không mông quạnh trước khẩu pháo khổng lồ của nó là sai lầm chết người.{UL}{LI}{{@ style (bold)}}Tấn công phối hợp{{/}}: Vì nó có sức kháng cự cực lớn, hãy suy nghĩ thật kỹ nếu muốn một mình hạ gục nó."

msgid "bestiaryView/info/tacticalAdvise/header"
msgstr "Chú ý chiến thuật"

msgid "bestiaryView/info/tacticalAdvise/italy_It19_Progetto_C50_mod_66_HW_BOT"
msgstr "{UL}Bản sao echo này sẽ tự khôi phục qua những sai lầm của bạn!{UL}{LI}{{@ style (bold)}}Mục tiêu ưu tiên cao{{/}}: Do có khả năng dị thường, chiếc tăng này đe dọa cực lớn cho toàn bộ đội.{UL}{LI}{{@ style (bold)}}Giữ khoảng cách{{/}}: Kẻ địch này sẽ khó diệt hơn nhiều nếu nó tự sửa chữa bằng cái giá của bạn.{UL}{LI}{{@ style (bold)}}Tránh đấu tay đôi{{/}}: Bản sao bị tha hóa này có thể dễ dàng hạ gục xe tăng của bạn khi đối đầu một chọi một."

msgid "bestiaryView/info/tacticalAdvise/uk_GB100_Manticore_HW_BOT"
msgstr "{UL}Chớp cơ hội khi còn—sẽ không có lần hai để giành lợi thế!{UL}{LI}{{@ style (bold)}}Cơ hội chỉ có một lần{{/}}: Scavenger mang lượng lớn Mirium và một Dị điểm độc đáo. Nếu để mất nó, cả Scavenger lẫn số hàng quý giá sẽ biến mất luôn khỏi trận.{UL}{LI}{{@ style (bold)}}Đừng quan tâm xích{{/}}: Kẻ địch này có xích bất tử. Thay vào đó, hãy dùng các khả năng tăng sát thương để xuyên giáp nó.{UL}{LI}{{@ style (bold)}}Coi chừng phía sau{{/}}: Đừng để đối thủ khác đánh úp trong lúc mải mê truy đuổi."

msgid "bestiaryView/info/tacticalAdvise/uk_GB125_Saladin_HW_BOT"
msgstr "{UL}Giữ khoảng cách và phá hủy nó—nhanh!{UL}{LI}{{@ style (bold)}}Giữ khoảng cách{{/}}: Đừng để Detonator đến gần.{UL}{LI}{{@ style (bold)}}Lật ngược tình thế{{/}}: Nếu phá hủy Detonator trước khi nó tự phát nổ, sóng xung kích của nó sẽ làm choáng tất cả tăng địch trong khu vực.{UL}{LI}{{@ style (bold)}}Sẵn sàng sửa chữa{{/}}: Nếu bạn hoặc đồng minh bị cuốn vào vụ nổ, hãy dùng Sửa Nhóm Group Repair để lập tức xóa hiệu ứng choáng."

msgid "bestiaryView/info/tacticalAdvise/uk_GB24_Centurion_Mk3_HW_BOT"
msgstr "{UL}Đừng để nó bắt được bạn ở chỗ trống!{UL}{LI}{{@ style (bold)}}Mục tiêu ưu tiên cao{{/}}: Do những khả năng dị thường của nó, chiếc tăng này là mối đe dọa cực lớn cho toàn bộ đội.{UL}{LI}{{@ style (bold)}}Chiến thuật quyết định{{/}}: Khi giao đấu với đối thủ này, luôn sẵn sàng dùng khiên hoặc tàng hình để vô hiệu hóa lượng sát thương cao của nó.{UL}{LI}{{@ style (bold)}}Lấy độc trị độc{{/}}: Dùng khả năng Nạp Đạn Nhanh Fast Reload để bào giáp nó, hạ gục bản sao nhợt nhạt của một Cerberus thực thụ này, nhanh nhất có thể."

msgid "bestiaryView/info/tacticalAdvise/usa_A100_T49_HW_BOT"
msgstr "{UL}Sai một li đi một dặm!{UL}{LI}{{@ style (bold)}}Mục tiêu ưu tiên cao{{/}}: Do sở hữu những khả năng bất thường, chiếc tăng này là mối đe dọa đáng kể cho toàn bộ đội.{UL}{LI}{{@ style (bold)}}Giáp mỏng{{/}}: Nạp đạn HE để diệt nó nhanh hơn.{UL}{LI}{{@ style (bold)}}Địch bọc sườn{{/}}: Đừng để đối thủ này đánh bọc sườn đội mình. Hãy đối đầu trực diện với nó."

msgid "bestiaryView/info/tacticalAdvise/ussr_R171_IS_3_II_HW_BOT"
msgstr "{UL}Diệt \"búa phá cổng\" trước khi nó lao trúng! Đây là mục tiêu ưu tiên trong mọi đợt tấn công.{UL}{LI}{{@ style (bold)}}Bắn vào xích{{/}}: Sẽ khiến Charger bất động, trở thành mục tiêu dễ dàng cho đồng đội.{UL}{LI}{{@ style (bold)}}Dồn hỏa lực{{/}}: Diệt địch trước khi nó hồi phục. Nếu cần, hãy bắn hỏng xích lần nữa.{UL}{LI}{{@ style (bold)}}Tránh đâm trực diện{{/}}: Nếu Charger đột phá đến chỗ bạn, hãy kích hoạt tàng hình hoặc cơ động gắt để thoát khỏi hướng tấn công."

msgid "bestiaryView/info/tacticalAdvise/ussr_R40_T-54_HW_BOT"
msgstr "{UL}Luôn mở to mắt, vì chớp phát nó đã áp sát cực gần.{UL}{LI}{{@ style (bold)}}Mục tiêu ưu tiên cao{{/}}: Do sở hữu những khả năng bất thường, chiếc tăng này là mối đe dọa đáng kể đối với toàn đội.{UL}{LI}{{@ style (bold)}}Giữ khoảng cách{{/}}: Kẻ địch này phát ra trường năng lượng gây sát thương. Bất kỳ đơn vị nào nằm trong phạm vi đều sẽ chịu thiệt hại rất lớn.{UL}{LI}{{@ style (bold)}}Dồn sát thương hạ gục nhanh{{/}}: Hãy dùng Fast Reload Nạp Nhanh hoặc các chiến thuật khác để diệt trước khi nó áp sát quá gần."

msgid "bestiaryView/info/tacticalAdvise/ussr_R77_KV2_turret_2"
msgstr "{UL}Luôn cơ động và tránh làn đạn!{UL}{LI}{f7f6f299Bold_open}Mối đe dọa cố định{f7f6f299Bold_close}: Vì đối thủ này không thể di chuyển, hãy tận dụng môi trường xung quanh. Dùng đồi dốc và chướng ngại vật để cắt tầm nhìn của nó, tránh hỏa lực bắn tới.{UL}{LI}{f7f6f299Bold_open}Đừng đấu trực diện{f7f6f299Bold_close}: Giáp trước của nó cực dày. Thay vì đấu súng, hãy tìm cách vòng sườn hoặc chờ thời cơ tấn công hai bên hông \"mềm\" hơn.{UL}{LI}{f7f6f299Bold_open}Chuẩn bị Khiên{f7f6f299Bold_close}: Kẻ địch này có hỏa lực rất mạnh. Đạn sát thương cao của nó dễ khiến xe của bạn bị tê liệt, vì vậy luôn sẵn sàng Energy Shield để giảm thiểu thiệt hại."

