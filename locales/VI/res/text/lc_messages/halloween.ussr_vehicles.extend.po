msgid "IS_3_II_Halloween_event"
msgstr "Double"

msgid "IS_3_II_Halloween_event_descr"
msgstr "Là một phần của chương trình cải tiến Mirium, IS-3-II trang bị bộ thu vật chất di động. Mạnh mẽ, vũ trang tốt dù hơi chậm, chiếc tăng này tỏ ra rất hiệu quả trong dị điểm lúc được điều khiển bởi người có kỹ năng. Khi nghiên cứu Mirium tiến triển, Double trở thành lực lượng tấn công chính cho các đơn vị hoạt động trong khu vực."

msgid "IS_3_II_Halloween_event_long_special"
msgstr "Một tăng hạng nặng với súng nòng đôi, sát thương khá tốt mỗi phát và giáp đáng tin cậy."

msgid "IS_3_II_Halloween_event_short"
msgstr "Double"

