msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Nguồn dị điểm đang đến. Tất nhiên đó là một chiếc tăng béo phì."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Tiêu diệt nó để kết thúc mọi thứ. Anh em, xung phong!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Bắn vào điểm yếu trên giáp."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Anh em, một con quái vật vừa to vừa xấu đang đến,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "chúng ta chưa gặp bao giờ."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Điểm yếu có vẻ dễ thấy. Chúng ta phải"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "tiêu diệt con trùm này để lấy cái tiếp sóng, hoàn thành nhiệm vụ."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Anh em, nay trúng số! Hai con trùm thay vì một—"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "cái này mới. Nhưng ta sẽ thắng. Bắn vào điểm yếu"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "trên giáp chúng và đừng quên xử lý bọn lâu la."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Đây là một đối thủ nguy hiểm, nhưng nó có điểm yếu."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Tiêu diệt nó, mọi chuyện sẽ kết thúc. Tiến lên anh em!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Bắn vào điểm yếu địch. Đừng quên xử lý"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "bọn tay sai, không là mệt đấy."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Chúng ta cần tiêu diệt con trùm để đóng dị điểm."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Ngắm vào điểm yếu trên giáp nó."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Chúng ta cần diệt kẻ thù cuối cùng để kết thúc nhiệm vụ."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Bắn vào điểm yếu của nó."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Đây là vật cản cuối cùng."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Tập trung vào anh em! Diệt quái vật nào!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Địch rất nguy hiểm, nhưng nó có điểm yếu."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Đây là cơ hội để chúng ta vĩnh viễn kết liễu nó."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Giờ xem dị điểm này có gì."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Một đối thủ mạnh, nhưng có điểm yếu."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Anh em, hạ con thú này!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Đây là một đối thủ rất mạnh. Nhưng chúng ta làm được."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Hôm nay ta làm con trùm một lần."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Tính ra có lời phết! Ngắm vào điểm yếu"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "trên giáp chúng. Diệt quái thôi!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Mấy con trùm chơi đá hay sao mà ngáo thế,"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "không đợi đến lượt. Cả hai đều có điểm yếu, ngắm vào đó."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Lại một cặp trùm múp máp nữa. Anh kế, hiểu ý chưa."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Bắn vào điểm yếu và \"dọn dẹp\" bọn tay sai."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Nhanh nhanh lên nhá!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Chúng ta dập nó hơi kinh, anh em ạ!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Nhưng anh em có vẻ chưa đã."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Ngon! Nhưng mới nửa đường thôi."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Nó chuẩn bị quay lại, kéo thêm đồng bọn."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Chơi phải thế! Sửa chữa xe tăng và tiếp tục nào."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Nó không dễ thua vậy đâu. Chuẩn bị cho lượt về."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Chúng ta đập nó rất kinh! Nhưng chưa kết thúc đâu anh em."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Ngon! Nhưng mới nửa đường thôi."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Chúng chuẩn bị quay lại, kéo thêm đồng bọn."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Chơi phải thế! Sửa chữa xe tăng và tiếp tục nào."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Chúng không dễ thua vậy đâu. Chuẩn bị cho lượt về."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Đại úy Smith đây. Trong lúc quân ta bên ngoài vết nứt"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "chặn đà tấn công từ tăng echo vào khu phức hợp Babylon,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "nhiệm vụ của chúng ta là vượt qua mọi pha rồi đóng dị điểm."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Để thành công, phải chất đầy thiết bị thu ở tất cả các pha. Tiến lên!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Phát hiện một căn cứ địch sâu bên trong không gian Mirium."

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Chúng đang tập kết quân đoàn xâm lăng khổng lồ. Cơ hội duy nhất"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "để ngăn chặn là bịt đường đi. Nhiệm vụ của chúng ta là"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "vào sâu trong pha dị điểm, rút bỏ cái tiếp sóng đang giữ"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "đường không gian ở trạng thái mở. Sạc Magnus đầy Mirium,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "chúng ta sẽ đi đến cuối con đường!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Chào tất cả! Cần bịt lối đi đến thực tại của chúng ta"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "mà tăng echo đang dùng. Đơn vị phản gián sẽ xử lý"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "gián điệp tại Babylon—nhiệm vụ của chúng ta là Mirium."

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "Chất đầy thiết bị thu ở mọi pha, bắn tùm lum mọi vật cản,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "đóng cái lỗ này lại. Nổ máy thôi anh em!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Smith đây. Nhiệm vụ của chúng ta là đóng vết nứt tại khu"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "phức hợp Babylon. Chất Mirium đầy thiết bị thu, tiêu diệt"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "mọi thứ không phải người. Tiến lên anh em, địch đang chờ tới số!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Quân mình đang cản đường tăng echo xâm lấn"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "thế giới loài người. Nhiệm vụ của chúng ta là đóng vết nứt."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Càng sớm càng tốt. Thu thập Mirium để vá lỗ hổng đó."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Tăng địch đang tấn công tổ hợp Babylon. Lũ mọi rợ đó"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "bò ra từ vết nứt, chúng ta phải bịt đường đi."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Thọc sâu vào dị điểm, diệt cỏ tận gốc. Xung phong!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Smith đây. Nhiệm vụ của chúng ta là chôn vùi quân đoàn"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "tăng echo của Đức bên trong dị điểm. Mục tiêu hiện tại"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "là pha sâu. Chất đầy Magnus để tiếp cận."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Phát hiện căn cứ địch sâu trong không gian Mirium."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Chúng đang triển khai kế hoạch tấn công từ đó."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Bỏ qua cô bé kia. Nhiệm vụ của chúng ta là kích hoạt"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus và mở đường tới pha sâu nhất"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "để chôn vùi kẻ thù vĩnh viễn."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "Phát hiện căn cứ địch ở pha sâu nhất."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Thực lực hiện khó thắng, nhưng ta có thể nhốt chúng trong đó."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Thu thập Mirium để tiếp cận đáy sâu vết nứt này."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Trời phật phù hộ anh em! Chúng ta sẽ làm được!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Đóng vết nứt nào xong lại có vết nứt mới."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Nhiệm vụ như cũ: Thu thập vật chất và"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "đóng dị điểm để chặn cuộc xâm lược vào thực tại chúng ta. Tiến lên!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Vết nứt lại mở ra rồi. Nhặt vật chất, làm đầy thiết bị thu."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Phải đóng cái dị điểm chết tiệt kia. Anh em bên ngoài"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "tin tưởng chúng ta, nhưng họ không trụ được lâu!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Tổ hợp Babylon vẫn đang bị tăng địch tấn công."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Thu thập vật chất và sạc Magnus. Chúng ta phải"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "đóng dị điểm, không cho tăng echo xâm lấn thế giới thật."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Mục tiêu cận kề. Tập trung, để ý"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "cảnh báo về Immortal."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Hay lắm anh em! Giữ phong độ! Ở đây không có"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "giờ giải lao. Ta cần thêm Mirium."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Phối hợp tuyệt vời! Tiếp nào, ta cần thêm Mirium."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Hay lắm! Ta phải kích hoạt Magnus để vào sâu hơn."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium giúp ta mạnh hơn sau mỗi pha mới."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Nhưng đừng tự mãn sớm."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Ta phải kích hoạt Magnus. Làm phát cuối nào!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Nhiệm vụ như cũ: Ta phải chất đầy thiết bị thu."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Ta đang đến gần nguồn gốc xâm lăng."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Nhiệm vụ không thay đổi: Chất đầy thiết bị thu."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Hát hay lắm. Tập trung nào anh em."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Ta phải thu thập Mirium và vào sâu hơn."

msgid "narrator"
msgstr "Smith"
