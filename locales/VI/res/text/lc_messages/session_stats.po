msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Tỷ lệ của tổng sát thương gây ra trên số trận đã đánh trong phiên tương ứng. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Tỷ lệ của số xe địch bị bắn hạ trên số trận tham chiến."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Cấp xe Trung bình mà bạn đã sử dụng cho phiên game."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Tỷ lệ của tổng XP kiếm được trên số trận đã đánh trong phiên tương ứng. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Tỷ lệ của tổng thiệt hại chặn được trên số trận đã đánh trong phiên tương ứng. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Tỷ lệ của tổng sát thương gây ra nhờ bạn phát hiện, phá xích, làm bất động xe địch, hoặc bắn choáng, trên số trận đã đánh trong một phiên. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Tỷ lệ của tham số \"Thiệt hại gây ra\" trên \"Thiệt hại hứng chịu\". Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Tỷ lệ của số xe địch tiêu diệt được trên số lần xe của người chơi bị bắn hạ. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Tỷ lệ của số xe địch bị phát hiện trên số trận tham chiến."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Phần trăm của tổng số trận tham chiến mà xe người chơi không bị tiêu diệt."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Số thắng lợi ở các Trận đánh Ngẫu nhiên trong phiên. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/wins"
msgstr "Số thắng lợi ở các Trận đánh Ngẫu nhiên trong phiên. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

msgid "propertyInfo/prop/descr/wtr"
msgstr "Chỉ số WTR theo các giá trị trung bình cho toàn bộ phiên. Delta hiển thị hiệu quả của phiên game hiện tại trên thông số tổng."

