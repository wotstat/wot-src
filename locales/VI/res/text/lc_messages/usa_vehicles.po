msgid "T14_MapsTraining_Player_HT_1"
msgstr "T14 (tr.)"

msgid "T14_descr"
msgstr "Được phát triển giữa tháng 05/1942 và tháng 05/1943. Người ta đã xây dựng hai nguyên mẫu và đưa đi kiểm chứng. Tuy nhiên, quá trình sản xuất hàng loạt bị hủy bỏ, khiến T14 vẫn mãi chỉ là một xe tăng thử nghiệm."

msgid "T14_descr_MapsTraining_Player_HT_1"
msgstr "Được phát triển giữa tháng 05/1942 và tháng 05/1943. Người ta đã xây dựng hai nguyên mẫu và đưa đi kiểm chứng. Tuy nhiên, quá trình sản xuất hàng loạt bị hủy bỏ, khiến T14 vẫn mãi chỉ là một xe tăng thử nghiệm."

msgid "T16E2"
msgstr "T16E2"

msgid "T18"
msgstr "T18"

msgid "T18T47"
msgstr "T18T47"

msgid "T18_descr"
msgstr "Quá trình phát triển pháo tự hành dựa trên nền tảng tăng hạng nhẹ M3 này bắt đầu vào tháng 10/1941. Nguyên mẫu đầu tiên vượt qua giai đoạn thử nghiệm vào mùa xuân năm 1942, nhưng nó chưa bao giờ được sản xuất hàng loạt."

msgid "T1_E6"
msgstr "T1E6"

msgid "T1_E6_descr"
msgstr "Các xe tăng thử nghiệm từ T1E4 cho tới T1E6 chịu ảnh hưởng lớn bởi mẫu xe Vickers E của Anh. Mẫu đầu tiên được sản xuất bởi tập đoàn Cunningham năm 1931. Sau khi chạy thử vào năm 1932, một mẫu nâng cấp khác được chế tạo. Tuy nhiên, một xe tăng thử nghiệm khác, mẫu T2, đã được ưu ái hơn."

msgid "T1_E6_short"
msgstr "T1E6"

msgid "T21"
msgstr "T21"

msgid "T21_descr"
msgstr "Một phiên bản nhẹ hơn của tăng hạng trung T20 với khung gầm M7 kéo dài. Chiếc xe này được phát triển trong nửa đầu năm 1943. Không giống như T20, T21 có giáp mỏng và trang bị vũ khí kém hơn. Nó chưa bao giờ được sản xuất hàng loạt cũng như phục vụ trong biên chế."

msgid "T23"
msgstr "T23"

msgid "T23D51080"
msgstr "T23D51080"

msgid "T23E3"
msgstr "T23E3"

msgid "T23E3_descr"
msgstr "Quá trình phát triển bắt đầu từ tháng 04/1943. Nguyên mẫu được chế tạo vào tháng 08/1944. Không giống như mẫu xe tiền nhiệm T23, phiên bản này đặc trưng với hệ thống giảm xóc thanh xoắn. Dù vậy, nó chưa bao giờ được sản xuất hàng loạt cũng như phục vụ trong biên chế quân đội."

msgid "T23E3_long_special"
msgstr "T23E3 là một xe tăng hỗ trợ đáng tin cậy, hiệu quả trong mọi tình huống. Góc nâng/hạ nòng tốt và tốc độ bắn nhanh cho phép nó tận dụng địa hình lồi lõm, trong khi tầm nhìn tương đối xa đảm bảo phát hiện địch trước tiên."

msgid "T23E3_short_special"
msgstr "Tốc độ bắn, chính xác và tầm nhìn tốt"

msgid "T23T80"
msgstr "T23T80"

msgid "T23_descr"
msgstr "Tăng hạng trung bản thử nghiệm. Quá trình phát triển bắt đầu từ cuối năm 1942 đến hè năm 1944. Chiếc xe này chưa bao giờ được sản xuất hàng loạt cũng như tham gia chiến đấu."

msgid "T25_2_SH"
msgstr "Raven"

msgid "T25_2_SH_descr"
msgstr "Chiếc xe này là sự cân bằng hoàn hảo giữa hiện đại và kinh điển. Những công nghệ đứng vững theo thời gian kết hợp các bước tiến mới nhất là nền tảng của nó, đem lại trải nghiệm tuyệt vời cho lái xe. Đương nhiên, bạn phải không bị dị ứng với kim loại gỉ sét."

msgid "T25_2_SH_short"
msgstr "Raven"

msgid "T26_E4_SuperPershing"
msgstr "T26E4 SuperPershing"

msgid "T26_E4_SuperPershing_FL"
msgstr "T26E4 SuperPershing FL"

msgid "T26_E4_SuperPershing_FL_short"
msgstr "T26E4 FL"

msgid "T26_E4_SuperPershing_descr"
msgstr "Để tăng cường hỏa lực, người ta đã trang bị súng nòng dài 90 mm mới lên T26E1 vào tháng 01/1945. Nguyên mẫu này được gọi là T26E4. Kế hoạch phát triển bị dừng lại vào tháng 01/1947 do có sự cố với khẩu súng và cơ chế nạp đạn. Tổng cộng 25 chiếc đã được sản xuất trong thời gian đó, nhưng chưa bao giờ phục vụ trong biên chế."

msgid "T26_E4_SuperPershing_long_special"
msgstr "Chiếc xe này có giáp trước rất tốt (có cả giáp ảo!), đủ khả năng chống chịu nhiều loạt đạn và bắn trả bằng nòng súng tuyệt vời so với cấp của nó. Dù vậy, độ cơ động chỉ ở mức trung bình nên hãy chọn hướng đánh cẩn thận."

msgid "T26_E4_SuperPershing_short"
msgstr "T26E4"

msgid "T26_E4_SuperPershing_short_special"
msgstr "Súng chính xác, giáp trước tuyệt vời"

