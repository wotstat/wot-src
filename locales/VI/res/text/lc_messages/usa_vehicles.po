msgid "M22_Locust_descr"
msgstr "Nhu cầu về tăng hạng nhẹ có thể vận chuyển bằng máy bay xuất hiện vào mùa đông năm 1941. M22 Locust được phát triển bởi công ty Marmon-Herrington. Có tổng cộng 830 chiếc đã xuất xưởng từ tháng 04/1943 đến 02/1944, 260 xe trong số đó được cung cấp cho Anh Quốc theo Thỏa thuận Thuê mượn (\"Lend-Lease\")."

msgid "M22_Locust_long_special"
msgstr "Một xe tăng trinh sát cực kỳ linh hoạt và thoắt ẩn, thoắt hiện cùng nòng súng khá tốt. Nó thực tế không có khuyết điểm nào, trừ cơ số đạn hơi ít."

msgid "M22_Locust_short"
msgstr "Locust"

msgid "M22_Locust_short_special"
msgstr "Tốc độ tối đa lớn, cơ động và ẩn giấu tốt"

