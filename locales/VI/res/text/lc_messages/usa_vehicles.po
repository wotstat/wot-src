msgid "T34T7"
msgstr "T34T7"

msgid "T34T7_BF"
msgstr "T34T7"

msgid "T34_hvy"
msgstr "T34"

msgid "T34_hvy_BF"
msgstr "T34 B"

msgid "T34_hvy_BF_descr"
msgstr "Được phát triển vào năm 1945 nhằm hiện đại hóa tăng hạng nặng T30. Chiếc xe này sở hữu súng 120 mm T53 và động cơ Continental AV-1790 mới. Do xu thế phát triển tăng hạng nặng đi xuống sau Thế Chiến II, T34 chưa bao giờ đi vào phục vụ trong biên chế. Các nguyên mẫu của nó đã được sử dụng để thử nghiệm thực địa."

msgid "T34_hvy_BF_long_special"
msgstr "Một tăng hạng nặng với tháp pháo rất dày và súng uy lực, đủ khả năng triệt hạ hầu như bất cứ đối thủ nào ngáng đường. Nó thể hiện hiệu quả nhất khi cận chiến ở vị trí phù hợp, đặc biệt khi tìm được nơi che thân xe, vốn có giáp không mấy ấn tượng."

msgid "T34_hvy_BF_short_special"
msgstr "Sát thương lớn mỗi phát, giáp tháp pháo tuyệt vời"

msgid "T34_hvy_FL"
msgstr "T34 FL"

msgid "T34_hvy_FL_short"
msgstr "T34 FL"

msgid "T34_hvy_descr"
msgstr "Được phát triển vào năm 1945 nhằm hiện đại hóa tăng hạng nặng T30. Chiếc xe này sở hữu súng 120 mm T53 và động cơ Continental AV-1790 mới. Do xu thế phát triển tăng hạng nặng đi xuống sau Thế Chiến II, T34 chưa bao giờ đi vào phục vụ trong biên chế. Các nguyên mẫu của nó đã được sử dụng để thử nghiệm thực địa."

msgid "T34_hvy_long_special"
msgstr "Một tăng hạng nặng với tháp pháo rất dày và súng uy lực, đủ khả năng triệt hạ hầu như bất cứ đối thủ nào ngáng đường. Nó thể hiện hiệu quả nhất khi cận chiến ở vị trí phù hợp, đặc biệt khi tìm được nơi che thân xe có giáp không mấy ấn tượng."

msgid "T34_hvy_short_special"
msgstr "Sát thương lớn mỗi phát bắn và tháp pháo giáp dày"

msgid "T40"
msgstr "T40"

msgid "T40_descr"
msgstr "Pháo chống tăng bản thử nghiệm được phát triển trên nền tảng của xe tăng M3 vào mùa xuân năm 1942. Dù vậy, nó chưa bao giờ đi vào sản xuất hàng loạt, cũng như phục vụ trong biên chế."

msgid "T48"
msgstr "T48"

msgid "T49"
msgstr "T49"

msgid "T51D1"
msgstr "T51D1"

msgid "T57"
msgstr "T57"

msgid "T57_descr"
msgstr "Pháo tự hành thử nghiệm thiết kế dựa trên nền tảng của M3A3. T57 đã được phát triển và thử nghiệm vào mùa thu năm 1942, nhưng chưa bao giờ đi vào sản xuất hàng loạt."

msgid "T67"
msgstr "T67"

msgid "T67_descr"
msgstr "Quá trình phát triển bắt đầu từ mùa xuân năm 1942. Sau nhiều cuộc thử nghiệm vào mùa thu 1942, người ta đã quyết định thay thế nòng 57 mm bằng súng 75 mm. Có hai nguyên mẫu từng được chế tạo, nhưng T67 chưa bao giờ đi vào giai đoạn sản xuất hàng loạt cũng như phục vụ trong biên chế quân đội."

msgid "T71"
msgstr "T71 DA"

msgid "T71_descr"
msgstr "Là tăng hạng nhẹ thử nghiệm chuyên chở được bằng máy bay, có tháp pháo \"gật\" và hệ thống nạp đạn tự động. Quá trình phát triển, do Detroit Arsenal tiến hành, bắt đầu từ năm 1952 đến 1953 nhằm thay thế M41. Tuy nhiên, vũ khí lắp đặt bị đánh giá là không hiệu quả, khiến dự án phải dừng lại sau khi một nguyên mẫu bằng gỗ đã được chế tạo."

msgid "T7_Combat_Car"
msgstr "T7 Combat Car"

msgid "T7_Combat_Car_descr"
msgstr "Là xe bánh-xích hạng nhẹ có trang bị súng máy được phát triển cho lực lượng kỵ binh Mỹ. Nguyên mẫu đầu tiên đã trải qua nhiều cuộc thử nghiệm vào tháng 04/1937 và tiếp tục cho đến năm 1939. Tuy nhiên, T7 bị ngừng phát triển do xu hưởng ưu tiên các xe tăng chỉ sử dụng hệ thống xích."

msgid "T7_Combat_Car_short"
msgstr "T7 Car"

