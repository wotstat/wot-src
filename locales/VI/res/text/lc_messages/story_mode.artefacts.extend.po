msgid "battleship/name"
msgstr "Khói Hiệu"

msgid "battleship/shortDescr"
msgstr "Một tín hiệu bằng khói đánh dấu khu vực cho loạt pháo khai hỏa từ chiến hạm ngoài khơi, gây thiệt hại cho thiết bị và vật thể địch ở vị trí đó."

msgid "distraction_ability/name"
msgstr "False Order"

msgid "distraction_ability/shortDescr"
msgstr "Bảo Gefr. Keller dùng radio tóm được từ Đức để truyền lệnh giả, bắt kẻ thù điều tra một địa điểm được chỉ định."

msgid "recon_ability/name"
msgstr "Scout Around"

msgid "recon_ability/shortDescr"
msgstr "Gửi Capt. Dubois trinh sát một địa điểm được chỉ định. Khi do thám, chiếc tăng dừng lại và giữ nguyên vị trí. Khả năng này tiếp tục hoạt động cho đến khi bị hủy."

msgid "scc_airstrike_ability/name"
msgstr "Air Support"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Gọi một cuộc không kích vào vị trí chỉ định."
