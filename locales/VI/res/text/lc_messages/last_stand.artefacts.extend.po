msgid "LS_aoeDamageInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeDamageInstantShot/descr"
msgstr "Bắn một phát súng gây sát thương cho mục tiêu và các xe địch gần đó."

msgid "LS_aoeDamageInstantShot/long_special"
msgstr "Thiết bị Chiến lược. Bắn một phát sát thương mục tiêu và mọi xe địch nội trong bán kính 35 m. Nếu sử dụng ít nhất một lần trong trận, thiết bị sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand: Terra Nord</font>.<br/><br/>Mọi thiết bị chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_aoeDamageInstantShot/name"
msgstr "Energy Shot"

msgid "LS_aoeDamageInstantShot/onUse"
msgstr "Bắn một phát gây thiệt hại cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "LS_aoeDamageInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeDamageInstantShot/short_special"
msgstr "Bắn một phát súng gây sát thương cho mục tiêu và các xe địch gần đó."

msgid "LS_aoeDrainEnemyHpInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeDrainEnemyHpInstantShot/descr"
msgstr "Bắn một phát súng khôi phục các điểm trúng bằng cách đánh cắp từ mục tiêu và các xe kẻ thù gần đó."

msgid "LS_aoeDrainEnemyHpInstantShot/long_special"
msgstr "Thiết bị Chiến lược. Bắn một phát khôi phục sức kháng cự bằng cách cướp HP từ mục tiêu và các xe địch nội trong bán kính 35 m, đồng thời sửa mô-đun hư hại cũng như loại bỏ hiệu ứng choáng. Nếu sử dụng ít nhất một lần trong trận, thiết bị sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand: Terra Nord</font>.<br/><br/>Mọi thiết bị chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_aoeDrainEnemyHpInstantShot/name"
msgstr "Vampiric Shot"

msgid "LS_aoeDrainEnemyHpInstantShot/onUse"
msgstr "Bắn một phát súng khôi phục các điểm trúng bằng cách đánh cắp từ mục tiêu và các xe địch gần đó trong bán kính 35 m, sửa chữa các mô-đun bị hư và loại bỏ hiệu ứng gây choáng."

msgid "LS_aoeDrainEnemyHpInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeDrainEnemyHpInstantShot/short_special"
msgstr "Bắn một phát súng khôi phục các điểm trúng bằng cách đánh cắp từ mục tiêu và các xe kẻ thù gần đó."

msgid "LS_aoeStunInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeStunInstantShot/descr"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và các xe địch gần đó."

msgid "LS_aoeStunInstantShot/long_special"
msgstr "Thiết bị Chiến lược. Bắn một phát làm choáng mục tiêu và mọi xe địch nội trong bán kính 35 m. Nếu sử dụng ít nhất một lần trong trận, thiết bị sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand: Terra Nord</font>.<br/><br/>Mọi thiết bị chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_aoeStunInstantShot/name"
msgstr "Stun Shot"

msgid "LS_aoeStunInstantShot/onUse"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "LS_aoeStunInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeStunInstantShot/short_special"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và các xe địch gần đó."

msgid "LS_damageShield/always"
msgstr "?empty?"

msgid "LS_damageShield/descr"
msgstr "Đem lại khả năng bất tử."

msgid "LS_damageShield/long_special"
msgstr "Thiết bị Chiến lược. Tạo một khiên năng lượng giúp bảo vệ xe của bạn khỏi bất cứ thiệt hại nào (trừ đâm/húc, ngập nước và va chạm) trong 10 giây. Nếu sử dụng ít nhất một lần trong trận, thiết bị sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand: Terra Nord</font>.<br/><br/>Mọi thiết bị chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_damageShield/name"
msgstr "Energy Shield"

msgid "LS_damageShield/onUse"
msgstr "Tạo một khiên năng lượng giúp bảo vệ xe của bạn khỏi bất cứ thiệt hại nào (trừ đâm/húc, ngập nước và va chạm) trong 10 giây."

msgid "LS_damageShield/restriction"
msgstr "?empty?"

msgid "LS_damageShield/short_special"
msgstr "Đem lại khả năng bất tử."

