msgstr "Tạm thời tăng độ cơ động cho xe của bạn sau khi bị địch sát thương.\nXác suất kích hoạt: 50%."

msgid "LS_nitroSituational/long_special"
msgstr "Khả năng Chiến đấu. Tạm thời tăng độ cơ động cho xe của bạn sau khi bị địch sát thương. Tự động kích hoạt với xác suất 50%. Nếu sử dụng ít nhất một lần trong trận, khả năng sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand: Terra Nord</font>.<br/><br/>Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_nitroSituational/name"
msgstr "Situational Mobility"

msgid "LS_nitroSituational/onUse"
msgstr "Tạm thời <font color='#feab34'>tăng</font> <font color='#feab34'>độ cơ động</font> cho xe của bạn sau khi bị địch sát thương.\nXác suất kích hoạt: <font color='#e9e2bf'>50%</font>."

msgid "LS_nitroSituational/restriction"
msgstr "?empty?"

msgid "LS_nitroSituational/short_special"
msgstr "Tạm thời tăng độ cơ động cho xe của bạn sau khi bị địch sát thương."

msgid "LS_selfRepair/always"
msgstr "?empty?"

msgid "LS_selfRepair/descr"
msgstr "Hồi phục sức kháng cự, dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hại."

msgid "LS_selfRepair/long_special"
msgstr "Khả năng Chiến đấu. Hồi phục sức kháng cự, dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hại. Có thể dùng nhiều lần một trận. Sẽ mất đi sau trận nếu đã được sử dụng ít nhất một lần.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Last Stand '25</font>.<br/><br/>Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "LS_selfRepair/name"
msgstr "Emergency Repairs"

msgid "LS_selfRepair/onUse"
msgstr "• Ngay lập tức khôi phục 400 HP cho xe của bạn.\n• Khôi phục thêm 300 HP trong 30 giây.\n• Quá trình khôi phục bị vô hiệu khi hứng chịu thiệt hại.\n• Dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hỏng.\n• Chỉ kích hoạt được khi đã chịu thiệt hại."

msgid "LS_selfRepair/restriction"
msgstr "?empty?"

msgid "LS_selfRepair/short_special"
msgstr "Hồi phục sức kháng cự, dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hại."

msgid "LS_selfRepair/usageCost"
msgstr "• Chi phí Mirium sử dụng trong trận chiến:"

msgid "LS_teamRepair/always"
msgstr "?empty?"

msgid "LS_teamRepair/descr"
