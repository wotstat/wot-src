msgid "roleExp/roleDescr/role_ATSPG_assault"
msgstr "Các xe với độ cơ động thấp nhưng giáp trước dày. Chúng phát huy hiệu quả tối đa khi đánh tuyến đầu."

msgid "roleExp/roleDescr/role_ATSPG_sniper"
msgstr "Các xe với giáp yếu nhưng súng tương đối tốt, buộc phải sử dụng chiến thuật phục kích trong hầu hết các tình huống giao tranh."

msgid "roleExp/roleDescr/role_ATSPG_support"
msgstr "Các xe với nòng súng hoàn hảo, nhưng cần một số điều kiện nhất định để phát huy hiệu quả tối đa. Chúng có thể gây ra một lượng thiệt hại rất lớn trong khoảng thời gian ngắn."

msgid "roleExp/roleDescr/role_ATSPG_universal"
msgstr "Các pháo chống tăng với hầu hết đặc tính ở mức trung bình, nhìn chung hiệu quả ở bất cứ khoảng cách nào."

msgid "roleExp/roleDescr/role_HT_assault"
msgstr "Các xe bọc giáp dày, hiệu quả khi đấu súng và chặn đà tiến của địch ở tuyến đầu."

msgid "roleExp/roleDescr/role_HT_break"
msgstr "Các xe với độ cơ động tốt và giáp đáng tin cậy, khiến chúng hiệu quả cả khi tạo góc tăng giáp đánh tuyến đầu, lẫn lúc đánh chọc sườn."

msgid "roleExp/roleDescr/role_HT_support"
msgstr "Các xe với nòng súng hoàn hảo, nhưng cần một số điều kiện nhất định để phát huy hiệu quả tối đa. Chúng có thể gây ra một lượng thiệt hại rất lớn trong khoảng thời gian ngắn."

msgid "roleExp/roleDescr/role_HT_universal"
msgstr "Các tăng đa nhiệm, dễ dàng thích nghi với bất cứ tình huống chiến đấu nào."

msgid "roleExp/roleDescr/role_LT_scout"
msgstr "Tăng hạng nhẹ trinh sát là những phương tiện nhỏ gọn, cơ động, được chế tạo để phát hiện kẻ địch. Dáng xe thấp, ngụy trang tốt, cùng độ linh hoạt tuyệt vời, tốc độ tối đa cao giúp chúng rất hiệu quả trong cả trinh sát thụ động lẫn chủ động, nhưng sức kháng cự kém và hỏa lực yếu không thể hỗ trợ hỏa lực đáng kể cho đồng minh."

msgid "roleExp/roleDescr/role_LT_support"
msgstr "Tăng hạng nhẹ hỗ trợ tận dụng khả năng cơ động cao, độ linh hoạt tuyệt vời và hỏa lực mạnh để nhanh chóng chuyển cánh, gây thiệt hại lớn trước khi rút về vị trí an toàn. Dù có thể thực hiện nhiệm vụ trinh sát trong một số tình huống nhất định, kích thước lớn, ngụy trang kém khiến chúng tệ hơn các tăng hạng nhẹ đặc thù vai trinh sát."

msgid "roleExp/roleDescr/role_LT_universal"
msgstr "Tăng hạng nhẹ đa năng là những phương tiện toàn diện, vừa trinh sát được vừa yểm trợ hỏa lực được. Dù kém hiệu quả hơn xe trinh sát đặc thù, hỏa lực yếu hơn tăng hạng nhẹ hỗ trợ, đặc tính cân bằng đa năng cho phép đảm nhiệm tốt cả hai vai trò, dễ dàng thích nghi nhiều tình huống chiến đấu."

msgid "roleExp/roleDescr/role_MT_assault"
msgstr "Các xe với giáp tương đối, phù hợp nhất khi cận chiến và cầm chân tăng hạng nặng đối phương."

msgid "roleExp/roleDescr/role_MT_sniper"
msgstr "Các xe với súng tuyệt vời nhưng giáp yếu, hiệu quả nhất khi đánh tầm xa."

msgid "roleExp/roleDescr/role_MT_support"
msgstr "Các xe với nòng súng hoàn hảo, nhưng cần một số điều kiện nhất định để phát huy hiệu quả tối đa. Chúng có thể gây ra một lượng thiệt hại rất lớn trong khoảng thời gian ngắn."

msgid "roleExp/roleDescr/role_MT_universal"
msgstr "Các xe toàn diện với khả năng thực hiện nhiều loại nhiệm vụ chiến đấu. Chúng dễ dàng thích ứng với những bản đồ có đặc thù riêng, hay tình thuống giao tranh cụ thể."

msgid "roleExp/roleDescr/role_SPG"
msgstr "Một loại xe hỗ trợ tầm xa cho quân ta tấn công. Độ hiệu quả của chúng thường phụ thuộc vào tình huống chiến đấu và diễn biến hai phe."

msgid "roleExp/roleGroupName/role_ATSPG_assault"
