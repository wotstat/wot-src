msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Thông số này biểu thị sự thay đổi của sát thương và độ xuyên giáp lý thuyết nhỏ nhất so với giá trị cơ sở (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Thông số này biểu thị sự thay đổi của sát thương và độ xuyên giáp lý thuyết lớn nhất so với giá trị cơ sở (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Thông số này biểu thị lượng thiệt hại gây ra lúc đâm/húc. Khi va chạm, hệ thống sẽ cân nhắc độ dày giáp tại điểm tiếp xúc, chênh lệch trọng lượng và tốc độ giữa các xe."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Thông số này biểu thị độ trễ trước khi Chỉ huy xác định được thiệt hại nghiêm trọng cho xe địch trong tâm ngắm của bạn."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Thông số này biểu thị khả năng lộ diện của xe địch được che giấu hoàn toàn bởi cành lá (sau một hay nhiều lớp). Áp dụng cho xe đứng yên và đang di chuyển."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Thông số này biểu thị khả năng lộ diện của xe địch đang di chuyển. Giá trị càng cao, xác suất phát hiện càng lớn."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Thông số này biểu thị sự thay đổi về xác suất gây thiệt hại nghiêm trọng cho mô-đun và kíp lái xe địch. Hiệu quả cho mọi loại đạn, trừ xe với súng Autocannon."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Thông số này biểu thị thời gian chờ hồi phục vật phẩm."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Thông số này biểu thị độ giảm thời gian hỏa hoạn và lượng thiệt hại hứng chịu từ đám cháy."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Thông số này biểu thị hiệu quả ẩn giấu khi nấp sau thực vật."

msgid "extraParams/name/hpRecover"
msgstr "Tham số này cho biết khoản tăng đối với lượng HP được khôi phục khi dùng Bộ Sửa chữa. Giá trị càng cao, HP hồi lại càng nhiều."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Thông số này biểu thị khả năng vượt địa hình của hệ thống giảm xóc trên địa hình tương đối yếu. Giá trị càng cao, thời gian cần để đạt tốc độ đi thẳng tối đa càng ngắn."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Thông số này biểu thị độ giảm tác động tiêu cực lên tầm nhìn tối đa khi thiết bị quan sát bị hỏng. Giá trị càng thấp, tầm nhìn càng xa."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Tham số này cho biết khoản tăng của giá trị xuyên lý thuyết tối đa đối với đạn ở cự ly dưới 50 m. Giá trị càng cao, khả năng xuyên càng tốt."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Thông số này biểu thị thời gian truyền tin thêm về vị trí địch sau khi xe của bạn bị phá hủy."

msgid "extraParams/name/radiomanHitChance"
msgstr "Thông số này biểu thị xác suất tránh bị thương của Liên lạc viên."

msgid "extraParams/name/shellVelocity"
msgstr "Thông số này biểu thị độ tăng vận tốc bay cho mọi loại đạn. Giá trị càng lớn, tốc độ đạn bay càng nhanh."

msgid "extraParams/name/softGroundFactor"
msgstr "Thông số này biểu thị khả năng vượt địa hình của hệ thống giảm xóc trên địa hình yếu. Giá trị càng cao, thời gian cần để đạt tốc độ đi thẳng tối đa càng ngắn."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Thông số này biểu thị mức độ của hiệu ứng tiêu cực từ việc kíp lái bị choáng."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Tham số này cho biết khoản giảm sát thương tác động lên hệ giảm xóc. Giá trị càng cao, thiệt hại hứng chịu càng ít."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Thông số này biểu thị độ giảm tác động tiêu cực lên thời gian nạp súng khi gác đạn bị hư hại. Giá trị càng lớn, thời gian nạp đạn càng đỡ lâu."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Thông số này biểu thị độ giảm liên quan đến vấn đề mất công suất khi động cơ bị hư hại. Giá trị càng lớn, động cơ càng mất ít công suất."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Thông số này biểu thị sức kháng cự của gác đạn, thùng nhiên liệu và động cơ. Giá trị càng cao, mô-đun càng bền."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Thông số này biểu thị sức kháng cự của gác đạn. Giá trị càng cao, gác đạn càng bền."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Thông số này biểu thị hư tổn khi hệ thống giảm xóc chịu thiệt hại lúc va chạm. Không ảnh hưởng đến thiệt hại gây ra cho má hoặc đỉnh tháo pháp lúc va chạm."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Thông số này biểu thị tốc độ sửa chữa hệ thống giảm xóc. Giá trị càng cao, tốc độ sửa càng nhanh."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Thông số này biểu thị sức kháng cự của hệ thống giảm xóc. Giá trị càng cao, hệ thống giảm xóc hứng chịu đạn và đâm/húc càng tốt."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Thông số này biểu thị thời gian địch lộ hình sau khi ra khỏi tầm nhìn của bạn. Giá trị mặc định: 10 giây."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Thông số này biểu thị độ giảm thiệt hại hứng chịu từ va chạm. Giá trị càng lớn, thiệt hại càng ít."

msgid "extraParams/name/vehicleFireChance"
msgstr "Thông số này biểu thị xác suất cháy động cơ khi nó hứng chịu thiệt hại."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Thông số này biểu thị độ bền của thùng nhiên liệu trước thiệt hại nghiêm trọng. Khi bị phá hủy, thùng nhiên liệu luôn gây ra hỏa hoạn."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Thông số này biểu thị khoản trừ vào độ chính xác khi di chuyển, xoay thân và tháp pháo. Giá trị càng thấp, tâm ngắm bị phân tán càng ít."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Tham số này hiển thị kích thước vòng ngắm sau khi bắn."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Thông số này biểu thị độ phân tán khi di chuyển. Giá trị càng thấp, súng càng chính xác."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Tham số này cho biết độ phân tán (lệch) khi xoay thân. Giá trị càng thấp, súng càng chính xác."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Tham số này cho biết độ phân tán (lệch) khi xoay súng. Giá trị càng thấp, súng càng chính xác."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Thông số này biểu thị độ phân tán với súng bị hỏng. Giá trị càng cao, độ phân tán càng thấp."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Thông số này biểu thị độ hấp thụ thiệt hại hứng chịu từ đạn HE. Giáp tại điểm tiếp xúc càng dày, hiệu quả càng cao."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Tham số này hiển thị độ ẩn giấu sau khi bắn."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Thông số này biểu thị thời gian xe bạn lộ hình sau khi ra khỏi tầm nhìn của địch. Giá trị mặc định là 10 giây."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Thông số này biểu thị lượng thiệt hại mà hệ thống giảm xóc phải hứng chịu lúc đâm/húc. Khi va chạm, hệ thống sẽ cân nhắc độ dày giáp tại điểm tiếp xúc, chênh lệch trọng lượng và tốc độ giữa các xe."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Thông số này biểu thị lượng thiệt hại phải hứng chịu lúc đâm/húc. Khi va chạm, hệ thống sẽ cân nhắc độ dày giáp tại điểm tiếp xúc, chênh lệch trọng lượng và tốc độ giữa các xe."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Thông số này biểu thị tốc độ chuyển đổi giữa các loại đạn khi súng đã lên nòng."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Thông số này biểu thị tốc độ sửa mô-đun trong và ngoài từ trạng thái \"đỏ\" sang \"vàng\". Giá trị càng cao, sửa càng nhanh."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Thông số này biểu thị khả năng vượt địa hình của hệ thống giảm xóc. Giá trị càng cao, thời gian cần để đạt tốc độ tối đa càng ít."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Thông số này biểu thị tốc độ đổi hướng của xe bánh lốp."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Thông số này biểu thị độ giảm tác động tiêu cực đến chuyên môn chính cho bất cứ thành viên kíp lái nào khi họ bị thương (trừ Chỉ huy)."

