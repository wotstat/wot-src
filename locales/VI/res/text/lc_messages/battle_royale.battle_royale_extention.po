msgid "rewardCurrencyTooltip/body/brProgressionToken"
msgstr "Được trao tặng khi hoàn tất các nhiệm vụ Săn Thiết giáp và kết quả đánh tốt. Chúng giúp bạn băng qua Tiến trình."

