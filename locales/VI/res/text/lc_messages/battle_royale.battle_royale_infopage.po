msgid "articleBP/subtitle"
msgstr "Giấy phép Quân sự là một sự kiện game yêu cầu người chơi hoàn tất nhiều Giai đoạn Tiến trình, kiếm Điểm để nhận nhiều phần thưởng giá trị. Khi xong một số Giai đoạn nhất định, game thủ sẽ sở hữu Giơ-tông Giấy phép Quân sự, loại tiền tệ đặc biệt dùng mua nhiều xe độc đáo cũng như các lợi phẩm hữu ích ở mục tương ứng trong Cửa hàng."

msgid "articleBP/title"
msgstr "Chi tiết Giấy phép Quân sự"

msgid "battleTasksDetails/stPatrick/subtitle"
msgstr "Mỗi ngày, người chơi có thể làm vài nhiệm vụ, xem tiến trình tương ứng. Khi hoàn thành chúng, bạn sẽ được thưởng Điểm Tiến trình và bạc."

msgid "battleTasksDetails/subtitle"
msgstr "Mỗi ngày, bạn có thể làm vài nhiệm vụ và xem tiến trình tương ứng. Khi hoàn thành chúng, bạn sẽ được thưởng Điểm Tiến trình, Ấn Thép và bạc."

msgid "battleTasksDetails/title"
msgstr "Nhiệm vụ"

msgid "battleTypes/battleTypesHeader/29"
msgstr "Trận Sô-lô"

msgid "battleTypes/battleTypesHeader/30"
msgstr "Trận Trung đội"

msgid "battleTypes/text/place"
msgstr "Vị thứ %(place)s"

msgid "battleTypes/text/places"
msgstr "Vị thứ %(place)s"

msgid "eventTime"
msgstr "Chế độ này sẽ khả dụng từ %(startDate)s đến %(endDate)s"

msgid "footer"
msgstr "Lấy thưởng xứng đáng!\nMùa săn giờ mới bắt đầu!"

msgid "generalDescription/accent"
msgstr "Mỗi xe có hai Khả năng Chiến đấu phổ biến, hai Khả năng độc đáo bên cạnh cơ chế Tái xuất."

msgid "generalDescription/subtitle"
msgstr "Trong Ga-ra, bạn sẽ tìm thấy tám xe đặc biệt, chia thành ba loại. Mỗi xe sở hữu đặc tính độc đáo và giá trị chiến thuật khác nhau. Không thể chỉnh sửa cấu hình của chúng trong Ga-ra, nhưng tất cả đều đi theo bộ mô-đun riêng và có thể nâng cấp trong trận."

msgid "generalDescription/title"
msgstr "Thợ săn"

msgid "infoBlock/moreGreen/subtitle"
msgstr "Cỏ ba lá khiến mọi Chiến lợi phẩm màu vàng thành xanh lục, nhưng chúng vẫn chứa mọi thứ bạn cần: XP, hồi phục sức kháng cự, đạn dược, nạp Khả năng, và quan trọng nhất là Ấn May mắn."

msgid "infoBlock/moreGreen/title"
msgstr "Nhuộm Xanh Trời Âu!"

msgid "infoBlock/sealsLuck/subtitle"
msgstr "Để kiếm Ấn May mắn, hãy nhặt Chiến lợi phẩm trong trận, hoàn tất Giai đoạn Tiến trình và đứng các vị trí Top đầu ở chế độ \"Battle Royale\" này. Khi đánh theo Trung đội, mọi Ấn May mắn được chia đề cho thành viên. Bạn có thể kiếm gấp đôi Ấn May mắn một lần mỗi ngày cho trận đầu tiên đánh bằng từng xe sự kiện. Để kích hoạt lợi ích vừa nói, bạn phải chiến đấu tốt trong trận."

msgid "infoBlock/sealsLuck/title"
msgstr "Ấn May mắn"

msgid "infoBlock/specialAwards/subtitle"
msgstr "Đánh trong Săn Thiết giáp để kiếm Ấn May mắn và đổi lấy quà đặc biệt trong Shop Cỏ ba lá."

msgid "infoBlock/specialAwards/title"
msgstr "Quà Đặc biệt"

msgid "maps/map1/title"
msgstr "Arzagir 4.04"

msgid "maps/map2/title"
msgstr "Khu vực 404"

msgid "maps/map3/title"
msgstr "Firnulfir"

msgid "maps/subtitle"
msgstr "Cuộc săn sẽ diễn ra trên ba bản đồ: {{@ colorLegacy 'ede6d9e5'}}Arzagir 4.04, Dreamland và Firnulfir{{/}}. Chúng lớn hơn so với chiến trường ở Trận đấu Ngẫu nhiên. Bản đồ đầu tiên đem đến một sa mạc rộng mở với nhiều hố cát và lạch khô. Bản đồ thứ hai là một khu đô thị dày đặc, nơi bạn có thể dễ dàng ẩn náu khỏi kẻ thù. Còn bản đồ thứ ba vẽ nên đài nguyên Scandinavi đầy tuyết, địa hình nhiều thung đặc trưng, làng mạc nhỏ và hồ ao đóng băng."

msgid "maps/title"
msgstr "Ba Bản đồ"

msgid "marauders/footer"
msgstr "Diệt Marauder để lấy hàng ngon."

msgid "marauders/marauder1"
msgstr "{{@ colorLegacy 'eeede9'}}Hare{{/}}—nhát nhưng nhanh"

msgid "marauders/marauder2"
msgstr "{{@ colorLegacy 'eeede9'}}Wolf{{/}}—hung hăng, thích tấn công và săn đuổi con mồi"

msgid "marauders/marauder3"
msgstr "{{@ colorLegacy 'eeede9'}}Bear{{/}}—đáng sợ, rất \"chì\" khi bảo vệ lãnh thổ của nó"

msgid "marauders/text"
msgstr "Một nhóm các xe do AI điều khiển đang tiêu thụ nốt xác thép rải rác khắp bản đồ sau Tour đấu Săn Thiết Giáp. Chúng không phải mối đe dọa trong trận. Những loại sau đã được nhận diện:"

msgid "marauders/title"
msgstr "Marauder"

msgid "mosaic/info1/stPatrick/subtitle"
msgstr "\"Battle Royale\" bằng các xe có thể nâng cấp được trong trận."

msgid "mosaic/info1/stPatrick/title"
msgstr "Săn Thiết giáp"

msgid "mosaic/info1/subtitle"
msgstr "\"Battle Royale\" bằng các xe có thể nâng cấp được trong trận."

msgid "mosaic/info1/title"
msgstr "Săn Thiết giáp"

msgid "mosaic/info2/stPatrick/subtitle"
msgstr "Kiếm gấp đôi Ấn May mắn một lần mỗi ngày cho trận đầu tiên đánh bằng từng xe đặc biệt. Để kích hoạt lợi ích vừa nói, hãy đứng Top 10 người chơi nếu sô-lô hoặc Top 7 khi đánh theo Trung đội."

msgid "mosaic/info2/stPatrick/title"
msgstr "Ấn May mắn Nhân Hai"

msgid "mosaic/info2/subtitle"
msgstr "Tất cả xe sự kiện đều khả dụng miễn phí. Ấn Thép có thể quy đổi lấy nhiều tùy biến."

msgid "mosaic/info2/title"
msgstr "Kinh tế"

msgid "mosaic/info3/stPatrick/subtitle"
msgstr "Một loại tiền tệ đặc biệt, có thể quy đổi lấy đồ giá trị trong Cửa hàng Cỏ ba lá. Để kiếm nhiều Ấn May mắn nhất có thể, hãy nhặt Chiến lợi phẩm trong trận, hoàn tất Giai đoạn Tiến trình và thắng chế độ \"Battle Royale\" này. Khi đánh theo Trung đội, mọi Ấn May mắn được chia đề cho thành viên."

msgid "mosaic/info3/stPatrick/title"
msgstr "Ấn May mắn"

msgid "mosaic/info3/subtitle"
msgstr "Đặt mục tiêu chiến đấu hiệu quả hơn trong các trận đánh và hoàn tất nhiệm vụ để băng qua Tiến trình."

msgid "mosaic/info3/title"
msgstr "Tiến trình"

msgid "mosaic/info4/stPatrick/subtitle"
msgstr "Hoàn tất nhiệm vụ hàng ngày và đứng các vị trí Top đầu trong trận để vượt qua Giai đoạn Tiến trình, nhận hàng loạt phần thưởng gồm cả Ấn May mắn."

msgid "mosaic/info4/stPatrick/title"
msgstr "Tiến trình"

msgid "mosaic/info4/subtitle"
msgstr "Cơ chế Tái xuất cho phép bạn trở lại trận đánh sau khi xe mình bị phá hủy. Cấp độ nâng cấp của xe không bị mất đi trong trường hợp này."

msgid "mosaic/info4/title"
msgstr "Tái xuất"

msgid "mosaic/title"
msgstr "Thông tin Tổng quan"

msgid "pointsBPDetailsSettings/subtitle"
msgstr "Một loại nguồn lực đặc biệt của Giấy phép Quân sự, có thể kiếm được trong nhiều chế độ, gồm cả Săn Thiết giáp. Số Điểm thu về sẽ tùy vào vị thứ của bạn trên bảng kết quả chiến đấu sau trận. Các xe Săn Thiết giáp không bị Giới hạn Điểm Tối đa."

msgid "pointsBPDetailsSettings/title"
msgstr "Điểm Giấy phép Quân sự"

msgid "pointsSHDetailsSettings/stPatrick/subtitle"
msgstr "Thợ săn đứng đầu trận được thưởng thêm Ấn May mắn. Bạn cũng sẽ thu về thêm Điểm Tiến trình tùy theo vị thứ trên bảng kết quả hậu chiến."

msgid "pointsSHDetailsSettings/stPatrick/title"
msgstr "Thưởng cho Vị thứ Sau trận"

msgid "pointsSHDetailsSettings/subtitle"
msgstr "Sau mỗi trận, bạn sẽ nhận được một lượng Điểm Tiến trình tương ứng với vị thứ của mình trên bảng kết quả chiến đấu."

msgid "pointsSHDetailsSettings/title"
msgstr "Phân bổ Điểm"

msgid "progressionDetails/stPatrick/subtitle"
msgstr "Tham dự sự kiện Cuốn Cỏ Ba Lá và đoạt thưởng giá trị! Để băng qua Tiến trình, bạn cần kiếm Điểm đặc biệt khi hoàn tất những nhiệm vụ hàng ngày của sự kiện và từ các trận Săn Thiết giáp."

msgid "progressionDetails/stPatrick/subtitle2"
msgstr "Sau khi làm xong Tiến trình Chính, bạn vẫn có thể tiếp tục tham chiến và thu thập Ấn May mắn. Quy đổi chúng lấy nhiều quà đặc biệt ở Shop Cỏ ba lá."

msgid "progressionDetails/stPatrick/title2"
msgstr "Ấn May mắn"

msgid "progressionDetails/subtitle"
msgstr "Hoàn tất Đường Thợ săn và đoạt thưởng giá trị! Để băng qua Tiến trình, bạn cần kiếm Điểm đặc biệt khi hoàn tất những nhiệm vụ hàng ngày của sự kiện, cũng như từ các trận Săn Thiết giáp."

msgid "progressionDetails/subtitle2"
msgstr "Sau khi hoàn tất Tiến trình Chính, bạn có thể tiếp tục làm nhiệm vụ và kiếm Ấn Thép để quy đổi lấy chi tiết tùy biến ở Cửa hàng trong game."

msgid "progressionDetails/title"
msgstr "Tiến trình"

msgid "progressionDetails/title2"
msgstr "Ấn Thép"

msgid "radarDetails/text1"
msgstr "Dò sóng Radio cho phép bạn định vị xe địch và hàng thả dù trên bản đồ con. Hệ thống này được kích hoạt một cách thủ công khi bấm phím X. Bạn phải đợi một chút trước khi có thể kích hoạt tiếp. Ngoài ra, người chơi có thể mở rộng bán kính phát hiện Dò sóng Radio hoặc giảm thời gian chờ hồi phục của nó bằng cách nâng cấp công nghệ tương ứng trong trận."

msgid "radarDetails/text2"
msgstr "Kỹ sư Ba Lan biết rằng tăng cường một trong các điểm mạnh của xe sẽ làm giảm đặc tính khác. Đó là lý do họ đề ra giải pháp vũ khí và khả năng chiến đấu để ngăn không cho địch tìm điểm yếu. Thời gian sẽ đem đến kết luận chính xác nhất về phát kiến này."

msgid "radarDetails/title"
msgstr "Dò sóng Radio"

msgid "respawn/block1/subtitle"
msgstr "Sau khi bị phá hủy, xe của bạn tự động được tái xuất. Cơ chế này áp dụng nội trong {{@ colorLegacy 'eeede9'}}{{soloRespawnPeriod}} ph{{/}} đầu trận."

msgid "respawn/block1/title"
msgstr "Khi Chơi Sô-lô"

msgid "respawn/block2/subtitle"
msgstr "Để tái xuất một đồng đội, hãy tránh giao tranh trong {{@ colorLegacy 'eeede9'}}{{platoonTimeToResurrect}} s{{/}}. Cơ chế này áp dụng nội trong {{@ colorLegacy 'eeede9'}}{{platoonRespawnPeriod}} phút{{/}} đầu trận. Sạc tái xuất được chia sẻ chung giữa các thành viên Trung đội."

msgid "respawn/block2/title"
msgstr "Khi Chơi theo Trung đội"

msgid "respawn/text"
msgstr "Cơ chế này cho phép bạn trở lại trận đánh sau khi xe mình bị phá hủy. Cấp độ nâng cấp của xe không bị mất đi trong trường hợp ở đây."

msgid "respawn/title"
msgstr "Tái xuất"

msgid "sectorDetails/text1"
msgstr "Hệ thống tầm nhìn đặc trưng, dựa theo nguyên tắc Thị kiến Hình nón. Bạn không thể thấy xe địch, Chiến lợi phẩm hay Hàng thả dù nằm ngoài tầm Thị kiến Hình nón của xe mình."

msgid "sectorDetails/text2"
msgstr "Nếu xe địch tiến rất sát đến xe của bạn, nó sẽ tự động bị phát hiện. Chú ý rằng bạn có thể bị trúng đạn từ địch dù không thấy chúng. Thị kiến Hình nón phụ thuộc vào tháp pháo xe. Vì thế, hãy quay tháp pháo thường xuyên để có tầm nhìn tốt hơn, không bỏ sót địch."

msgid "sectorDetails/title"
msgstr "Thị kiến Hình nón"

msgid "shopDetails/stPatrick/text1"
msgstr "Ấn May mắn kiếm được có thể quy đổi lấy quà Săn Thiết giáp độc đáo ở mục đặc biệt của Cửa hàng."

msgid "shopDetails/text1"
msgstr "Bạn có thể quy đổi Ấn Thép lấy các kiểu mẫu và đề-can Săn Thiết giáp ở mục tương ứng tại Cửa hàng trong game."

msgid "shopDetails/text2"
msgstr "{{@ colorLegacy 'ecca9d'}}Với Tài khoản WoT Premium, bạn kiếm được nhiều Ấn Thép hơn khi tham chiến.{{/}}"

msgid "shopDetails/title"
msgstr "Cửa hàng"

msgid "stPatrickFooter"
msgstr "Nhận thưởng xứng đáng trong trận.\nBắt đầu mùa săn!"

msgid "stPatrickSubTitle"
msgstr "CUỐN CỎ BA LÁ"

msgid "tableBPDetailsSettings/subtitle"
msgstr "Sau mỗi trận, bạn sẽ nhận được một số Điểm Giấy phép Quân sự tương ứng với vị thứ của mình trên bảng kết quả chiến đấu."

msgid "tableBPDetailsSettings/title"
msgstr "Phân bổ Điểm"

msgid "title"
msgstr "SĂN THIẾT GIÁP"

msgid "towerBlock/ammunition/stPatrick/subtitle"
msgstr "Khôi phục sức kháng cự, sửa mô-đun và chứa mọi thứ bạn cần để nghênh chiến: Một lần nạp Cứu hộ, đạn dược, XP giúp nâng cấp xe, cũng như (xác suất nhất định) một lần nạp Bộ Sửa chữa hoặc một trong các Khả năng Chiến đấu độc đáo."

msgid "towerBlock/ammunition/stPatrick/title"
msgstr "Vật phẩm"

msgid "towerBlock/ammunition/subtitle"
msgstr "Sửa mô-đun, khôi phục sức kháng cự và có chứa một lần nạp Cứu hộ, đạn dược cũng như XP để cải tiến xe. Hàng này giúp bạn nâng cấp xe nhanh hơn, cũng như ngay lập tức sẵn sàng nghênh chiến."

msgid "towerBlock/ammunition/title"
msgstr "Vật phẩm"

msgid "towerBlock/cargo/subtitle"
msgstr "Nếu lấy được Hàng thả dù, bạn sẽ nhận một sạc Tái xuất—lợi thế cực lớn so với địch. Đây là loại hàng thả giá trị nhất. Nó khôi phục sức kháng cự và sửa mô-đun xe, đem lại đạn dược, XP, cũng như sạc cả bốn Khả năng. Tuy nhiên, bạn cần nhiều thời gian hơn để nhặt Hàng thả dù. Chưa kể, mọi Thợ săn đều biết vị trí Hàng thả dù trên bản đồ, hãy sẵn sàng trước xung đột lợi ích."

msgid "towerBlock/cargo/title"
msgstr "Hàng thả dù"

msgid "towerBlock/euipment/subtitle"
msgstr "Chứa đạn và XP, dù lượng ít hơn loại hàng Vật phẩm. Nó cũng có thể chứa một lần nạp Bộ Sửa chữa hoặc một trong các Khả năng Chiến đấu. Tìm được loại hàng này đem lại cho bạn cơ hội lật ngược thế cờ."

msgid "towerBlock/euipment/title"
msgstr "Hộp tiếp tế"

msgid "towerBlock/subtitle"
msgstr "Để nâng cấp xe, bạn phải tìm đến các điểm đặc biệt có hàng chứa XP nâng cấp xe, cũng như đạn dược và nạp Khả năng Chiến đấu. Số lượng đồ phụ thuộc vào loại hàng."

msgid "towerBlock/title"
msgstr "Hàng"

msgid "towerBlock/trophies/subtitle"
msgstr "Sau khi diệt một kẻ địch, bạn có thể nhặt một nửa số nạp Khả năng của nó, khôi phục sức kháng cự, sửa mô-đun hư hại ở xe mình, cũng như nhận XP và đạn dược. Bạn cũng có cơ hội lấy thêm một lần nạp nữa cho một trong bốn Khả năng. Xe bị diệt chứa Chiến lợi phẩm được đánh dấu bằng khói đỏ trên bản đồ. Nhặt loại hàng này tốn ít thời gian hơn."

msgid "towerBlock/trophies/title"
msgstr "Chiến lợi phẩm"

msgid "zones/subtitle"
msgstr "Đừng tơ tưởng đến việc nấp trong góc bản đồ như chó chui gầm chạn. Chế độ này chỉ dành cho những ai thích đánh nhau sòng phẳng. Bản đồ thu hẹp dần theo thời gian, buộc các Thợ săn phải đối đầu."

msgid "zones/subtitle2"
msgstr "Điều này xảy ra ngẫu nhiên, tần suất phụ thuộc số xe tham chiến. Hãy cảnh và rút sớm khỏi các khu vực không an toàn."

msgid "zones/title"
msgstr "Chiến trường Hẹp dần"

msgid "zones/zoneRed/subtitle"
msgstr "Trong một khu vực chết, xe sẽ dần mất sức kháng cự cho đến khi bị phá hủy hoàn toàn. Bạn sẽ có rất ít thời gian để thoát khỏi khu vực tai hại này."

msgid "zones/zoneRed/title"
msgstr "Đỏ: Khu Vực Chết"

msgid "zones/zoneYellow/subtitle"
msgstr "Xe của bạn không hứng chịu thiệt hại ở khu vực nguy cơ, nhưng ô màu này có thể \"chết\" bất cứ lúc nào. Hãy lường trước đường rút."

msgid "zones/zoneYellow/title"
msgstr "Vàng: Khu vực Nguy cơ"
