msgid "chapter-1/lesson-1/description"
msgstr "Gia nhập quân đoàn thiết giáp lớn nhất với đủ mọi quân nhân đến từ khắp nơi trên thế giới. Chiến đấu trên những trận địa kinh điển, độc đáo, đẹp như tranh vẽ bằng nhiều chiến thuật và lối chơi đa dạng trong những cỗ chiến xa huyền thoại, cũng như các nguyên mẫu táo bạo chưa từng xuất xưởng."

msgid "chapter-1/lesson-1/hint-1/text"
msgstr "Một quân đoàn cực mạnh với 160 triệu người chơi từ khắp nơi trên thế giới."

msgid "chapter-1/lesson-1/hint-2/text"
msgstr "Nắm giữ 2 Kỷ lục Guinness Thế giới và hàng loạt giải thưởng uy tín khác."

msgid "chapter-1/lesson-1/hint-3/text"
msgstr "Hơn 700 xe chiến đấu từ giai đoạn giữa thế kỷ 20."

msgid "chapter-1/lesson-1/title"
msgstr "Chào mừng đến với\nWorld of Tanks!"

msgid "chapter-1/lesson-10/description"
msgstr "Bạn có thể thu thập các phân đoạn bản vẽ của từng xe cụ thể để nghiên cứu nó nhanh hơn. Bản vẽ khả dụng cho xe Cấp II–X nghiên cứu được. Khi ráp hoàn chỉnh một bản vẽ, không cần kinh nghiệm để nghiên cứu xe tương ứng."

msgid "chapter-1/lesson-10/title"
msgstr "Bản vẽ"

msgid "chapter-1/lesson-11/description"
msgstr "Nếu chưa tìm hiểu đầy đủ các chi tiết của tất cả bản đồ, Trắc địa là chế độ sẽ giúp bạn lấp đầy khoảng trống kiến thức này và nghiên cứu những đặc thù của một địa điểm cụ thể."

msgid "chapter-1/lesson-11/title"
msgstr "Trắc địa"

msgid "chapter-1/lesson-2/description"
msgstr "Trò chơi có một lượng bản đồ rất phong phú: Từ mấp mô cao thấp khó lường, hỗn hợp địa hình trống trải với ma trận đô thị, đến hàng loạt chỗ tránh đạn và điểm phục kích. Bởi thế, bạn luôn có khả năng triển khai các chiến thuật phù hợp nhất trong trận đánh. Hơn 30 bản đồ với chất lượng HD đang chờ đón bạn tham chiến."

msgid "chapter-1/lesson-2/title"
msgstr "Bản đồ Game"

msgid "chapter-1/lesson-3/hint-1/text"
msgstr "Sử dụng chuột để xoay tháp pháo và ngắm súng."

msgid "chapter-1/lesson-3/hint-2/text"
msgstr "Sử dụng các phím W, A, S, và D để điều khiển và di chuyển xe."

msgid "chapter-1/lesson-3/hint-3/text"
msgstr "Đợi đến lúc nòng pháo được nạp lại đạn trước khi khai hỏa."

msgid "chapter-1/lesson-3/hint-4/text"
msgstr "Sử dụng Ngắm Tự động để bắn địch khi đang di chuyển."

msgid "chapter-1/lesson-3/title"
msgstr "Điều khiển xe"

msgid "chapter-1/lesson-4/description"
msgstr "Ngắm vào xe địch sẽ bật sáng đỏ toàn bộ hình dáng của nó. Hãy đợi đến lúc ngắm xong hoàn toàn trước khi khai hỏa."

msgid "chapter-1/lesson-4/title"
msgstr "Sát thương"

msgid "chapter-1/lesson-5/description"
msgstr "Bạn có thể thắng trận bằng cách tiêu diệt tất cả xe địch hoặc khi chiếm đóng thành công căn cứ của đối phương. Ở chế độ Cơ bản, cả hai phe đều có căn cứ riêng; trong chế độ Xung kích, chỉ bên phòng thủ có căn cứ; ở chế độ Đôi công, chỉ có một căn cứ trung lập và phe nào cũng có thể chiếm đóng."

msgid "chapter-1/lesson-5/hint-1/text"
msgstr "Chiếm đóng căn cứ địch (hoặc trung lập)."

msgid "chapter-1/lesson-5/hint-2/text"
msgstr "Tiêu diệt tất cả mọi xe địch hoặc sống sót trận đánh (trong chế độ Xung kích)."

msgid "chapter-1/lesson-5/title"
msgstr "Điều kiện Chiến thắng"

msgid "chapter-1/lesson-6/description"
msgstr "Mỗi xe có mô-đun cơ bản cho từng đặc tính cụ thể. Một số chiếc có mô-đun “xịn” thay thế, muốn xài thì cày điểm XP để mở, rồi dùng bạc để lắp."

msgid "chapter-1/lesson-6/title"
msgstr "Nghiên cứu Xe"

msgid "chapter-1/lesson-7/hint-1/text"
msgstr "Game giờ có 11 cấp xe. Mỗi cấp có thử thách đa dạng và phương tiện độc lạ để anh em cày nghiên cứu."

msgid "chapter-1/lesson-7/hint-2/text"
msgstr "Bạn cần có kinh nghiệm và bạc để nghiên cứu cũng như mua xe mới."

msgid "chapter-1/lesson-7/title"
msgstr "Cấp Xe"

msgid "chapter-1/lesson-8/hint-1/text"
msgstr "Vàng là đơn vị tiền tệ giá trị trong game và có thể dùng tiền thật mua được, cũng như thưởng ở các sự kiện như Chiến trận Clan, Tour đấu đặc biệt, v.v..."

msgid "chapter-1/lesson-8/hint-2/text"
msgstr "Tài khoản Premium WoT cung cấp thêm 50% kinh nghiệm và bạc sau mỗi trận."

msgid "chapter-1/lesson-8/hint-3/text"
msgstr "Xe Premium không cần nghiên cứu gì, cũng như mang lại thêm bạc và kinh nghiệm sau mỗi trận."

msgid "chapter-1/lesson-8/title"
msgstr "Lợi ích Premium"

msgid "chapter-1/video-lesson-1/title"
msgstr "Video: Sơ đồ Công nghệ"

msgid "chapter-1/video-lesson-2/title"
msgstr "Video: Chiến thuật Căn bản"

msgid "chapter-2/lesson-1/description"
msgstr "Tùy theo hiệu suất chiến đấu, bạn sẽ nhận được kinh nghiệm và bạc cho từng trận đánh. Trận đấu Ngẫu nhiên bao gồm các chế độ sau: Cơ bản, Xung kích, Đôi công và Đại chiến."

msgid "chapter-2/lesson-1/title"
msgstr "Trận đấu Ngẫu nhiên"

msgid "chapter-2/lesson-2/hint-1/text"
msgstr "Hai phe phòng thủ căn cứ của mình và tấn công nhau."

msgid "chapter-2/lesson-2/hint-2/text"
msgstr "Chế độ này khả dụng cho mọi cấp xe."

msgid "chapter-2/lesson-2/hint-3/text"
msgstr "Hai phe được xếp khớp nhau một cách tự động, với 15 người chơi mỗi bên."

msgid "chapter-2/lesson-2/title"
msgstr "Trận đấu Ngẫu nhiên: Chế độ Cơ bản"

msgid "chapter-2/lesson-3/hint-1/text"
msgstr "Một phe tấn công căn cứ địch, bên còn lại phòng thủ căn cứ của mình."

msgid "chapter-2/lesson-3/hint-2/text"
msgstr "Chế độ này chỉ khả dụng sau khi nghiên cứu các xe Cấp VI."

msgid "chapter-2/lesson-3/hint-3/text"
msgstr "Hai phe được xếp khớp nhau một cách tự động, với 15 người chơi mỗi bên."

msgid "chapter-2/lesson-3/title"
msgstr "Trận đấu Ngẫu nhiên: Xung kích"

msgid "chapter-2/lesson-4/hint-1/text"
msgstr "Trận đánh chỉ có một căn cứ trung lập, và hai phe đều có thể chiếm đóng nó."

msgid "chapter-2/lesson-4/hint-2/text"
msgstr "Chế độ này chỉ khả dụng sau khi nghiên cứu các xe Cấp IV."

msgid "chapter-2/lesson-4/hint-3/text"
msgstr "Hai phe được xếp khớp nhau một cách tự động, với 15 người chơi mỗi bên."

msgid "chapter-2/lesson-4/title"
msgstr "Trận đấu Ngẫu nhiên: Đôi công"

msgid "chapter-2/lesson-5/hint-1/text"
msgstr "Chế độ này đặc trưng với bản đồ rộng lớn và đánh theo kiểu Cơ bản."

msgid "chapter-2/lesson-5/hint-2/text"
msgstr "Chế độ này chỉ khả dụng cho các xe Cấp X."

msgid "chapter-2/lesson-5/hint-3/text"
msgstr "Hai phe được xếp khớp nhau một cách tự động, với 30 người chơi mỗi bên."

msgid "chapter-2/lesson-5/title"
msgstr "Trận đấu Ngẫu nhiên: Đại chiến"

msgid "chapter-2/lesson-6/description"
msgstr "Hoàn thành tất cả các nhiệm vụ để làm quen với mọi điểm mạnh/yếu của từng loại xe. Chiến trận diễn ra theo dạng 15-vs-15, trong đó tất cả xe đều do máy tính điều khiển (trừ xe của bạn). Độ khó của nhiệm vụ quyết định tổng lượng phần thưởng cho bạn. Chế độ này khả dụng cho xe Cấp IV–X."

msgid "chapter-2/lesson-6/title"
msgstr "Nhiệm vụ theo Loại Xe"

msgid "chapter-2/lesson-7/description"
msgstr "Mài giũa kỹ năng của bạn cùng những người chơi khác trên bất cứ bản đồ nào. Bạn không nhận được phần thưởng sau trận, bù lại xe được sửa chữa miễn phí. Người chơi chỉ cần mua đạn và vật phẩm."

msgid "chapter-2/lesson-7/title"
msgstr "Tập Trận"

msgid "chapter-2/lesson-8/description"
msgstr "Mài giũa các kỹ năng của bạn với xe Cấp I–II bằng cách chiến đấu với máy tính và nhận được phần thưởng cho 10 trận đầu tiên, trong trường hợp bạn chưa tham chiến đủ 10 Trận đấu Ngẫu nhiên."

msgid "chapter-2/lesson-8/title"
msgstr "Thử nghiệm Thực chiến"

msgid "chapter-2/lesson-9/description"
msgstr "Những trận đánh dành cho game thủ Clan và lính lê dương bằng xe Cấp VI–X. Bạn và Clan của mình có cơ hội giành được nhiều lợi ích lớn về bạc, Kinh nghiệm Chiến đấu, Tự do và Kíp lái. Ghé thăm cổng thông tin chính thức để biết thêm chi tiết."

msgid "chapter-2/lesson-9/title"
msgstr "Pháo đài: Giao chiến"

msgid "chapter-2/video-lesson-1/title"
msgstr "Video: Cách Giành Chiến thắng"

msgid "chapter-3/lesson-1/description"
msgstr "Các mô-đun phản ánh nhiều đặc tính kỹ thuật của một xe. Có một số mô-đun chung nhất định và có thể lắp trên nhiều xe khác nhau."

msgid "chapter-3/lesson-1/hint-1/text"
msgstr "Tháp pháo đặc trưng cho tầm nhìn của một xe. Nó cũng có chỉ số giáp và tốc độ xoay nhất định."

msgid "chapter-3/lesson-1/hint-2/text"
msgstr "Nòng pháo đặc trưng cho: Sát thương, độ xuyên giáp, sát thương mỗi phút, độ phân tán và thời gian ngắm."

msgid "chapter-3/lesson-1/hint-3/text"
msgstr "Động cơ đặc trưng cho khả năng cơ động của xe. Nó có xác suất bắt lửa nhất định khi hứng chịu thiệt hại."

msgid "chapter-3/lesson-1/hint-4/text"
msgstr "Hệ giảm xóc chịu trách nhiệm cho tốc độ xoay của xe."

msgid "chapter-3/lesson-1/hint-5/text"
msgstr "Radio đặc trưng cho khoảng cách hiển thị xe trên bản đồ con."

msgid "chapter-3/lesson-1/title"
msgstr "Mô-đun của xe"

msgid "chapter-3/lesson-10/hint-1/text"
msgstr "5% của tất cả kinh nghiệm thu về được tích lũy dưới dạng Kinh nghiệm Tự do."

msgid "chapter-3/lesson-10/hint-2/text"
msgstr "XP Tự do xài để nghiên cứu mô-đun, xe, Biến thể Dã chiến, nâng cấp phương tiện Cấp XI, cũng như tăng tốc đào tạo kíp lái."

msgid "chapter-3/lesson-10/hint-3/text"
msgstr "Bạn có thể quy đổi Kinh nghiệm Chiến đấu dư thừa ở các xe \"Elite\" thành Kinh nghiệm Tự do."

msgid "chapter-3/lesson-10/title"
msgstr "Kinh nghiệm Tự do"

msgid "chapter-3/lesson-11/hint-1/text"
msgstr "Trạng thái \"Elite\" được gán cho xe đã nghiên cứu tất cả mô-đun, Nâng cấp và nhánh kỹ thuật khả dụng, gồm cả các phương tiện cấp trước."

msgid "chapter-3/lesson-11/hint-2/text"
msgstr "Kinh nghiệm Chiến đấu kiếm được trên xe \"Elite\" có thể được quy đổi sang Kinh nghiệm Tự do bằng cách dùng vàng."

msgid "chapter-3/lesson-11/hint-3/text"
msgstr "Khi tăng tốc đào tạo kíp lái trong Ga-ra, mọi kinh nghiệm thu được sau đó đều sẽ dồn cho kíp lái."

msgid "chapter-3/lesson-11/title"
msgstr "Xe \"Elite\""

msgid "chapter-3/lesson-12/description"
msgstr "Trò chơi có rất nhiều xe từ hàng tá quốc gia. Hãy đến màn hình SƠ ĐỒ CÔNG NGHỆ rồi click vào lá cờ ở khu vực bên trái để xem và nghiên cứu mọi xe khả dụng."

msgid "chapter-3/lesson-12/title"
msgstr "Sơ đồ Công nghệ"

msgid "chapter-3/lesson-13/description"
msgstr "Dùng bàn phím để điều khiển chuyển động của xe, chuột để xoay tháp pháo và ngắm bắn. Hãy tìm hiểu cẩn thận tất cả phím điều khiển trong mục Thiết lập."

msgid "chapter-3/lesson-13/title"
msgstr "Điều khiển xe"

msgid "chapter-3/lesson-14/description"
msgstr "Trước khi bắt đầu ra trận, việc tinh chỉnh thiết bị và điều phối kíp lái với các ứng dụng kỹ thuật sẽ giúp bạn tăng hiệu suất của xe cho một trận đánh."

msgid "chapter-3/lesson-14/title"
msgstr "Ứ.dụng K.thuật"

msgid "chapter-3/lesson-15/hint-1/text"
msgstr "Biến thể Dã chiến khả dụng cho các xe Cấp VI–X đã đạt trạng thái \"Elite\"."

msgid "chapter-3/lesson-15/hint-2/text"
msgstr "Bạn có thể điều chỉnh đặc tính xe bằng cách dùng hàng loạt sửa đổi biến thể. Cần XP Chiến đấu hoặc XP Tự do cùng với bạc để nghiên cứu và mua biến thể."

msgid "chapter-3/lesson-15/hint-3/text"
msgstr "Biến thể Đặc biệt mở khóa Cấu hình Khác cho xe và giúp chỉ định danh mục của ô thiết bị thứ hai."

msgid "chapter-3/lesson-15/title"
msgstr "Biến thể Dã chiến"

msgid "chapter-3/lesson-16/description"
msgstr "Sau khi mở khóa Cấu hình Khác trong Biến thể Dã chiến (cho xe Cấp VI–X) hoặc sau khi mở khóa nâng cấp Cấu hình Khác (cho xe Cấp XI), bạn sẽ có thêm bộ phương án dự phòng về thiết bị, đạn, vật phẩm và ứng dụng kỹ thuật tại Ga-ra. Nó không thay thế cấu hình chính, nhưng đem lại cơ hội mới. Bạn có thể đánh giá bản đồ và thành phần phe mình lúc chờ đếm ngược trước trận để chọn một trong hai cấu hình xe. Điều này cho phép thích nghi trước những tình huống khả dĩ sắp đương đầu."

msgid "chapter-3/lesson-16/title"
msgstr "Cấu hình Xe trong Trận"

msgid "chapter-3/lesson-17/description"
msgstr "Không như loại xe, vai trò xe phản ánh chính xác hơn về chiến thuật đánh tối ưu, cũng như quyết định Sơ đồ Biến thể nào sẽ khả dụng cho phương tiện cụ thể."

msgid "chapter-3/lesson-17/title"
msgstr "Vai trò Xe trong Trận"

msgid "chapter-3/lesson-2/description"
msgstr "Sử dụng vật phẩm để cải thiện đặc tính xe hoặc hiệu suất kíp lái, sửa chữa mô-đun bị hư hại hay cứu sống kíp lái bị thương trong trận. Bạn có thể trang bị tối đa ba loại vật phẩm khác nhau một lúc."

msgid "chapter-3/lesson-2/title"
msgstr "Vật phẩm"

msgid "chapter-3/lesson-3/description"
msgstr "Trước khi vào trận, hãy đảm bảo rằng bạn đã nạp đủ đạn. Bằng không, nhiều khả năng xe sẽ hết đạn ngay giữa trận địa khốc liệt. Sử dụng phím 1, 2 và 3 để chuyển đổi giữa các loại đạn khác nhau."

msgid "chapter-3/lesson-3/title"
msgstr "Đạn"

msgid "chapter-3/lesson-4/description"
msgstr "Sử dụng thiết bị thích hợp để tăng cường nhiều đặc tính kỹ thuật của xe. Bạn có thể chuyển thiết bị từ xe này sang xe khác: Tốn 10 vàng hoặc một Bộ Gỡ đối với loại tiêu chuẩn và Bao cấp; tốn 200 trái phiếu cho loại tiên tiến; cũng như cần thành phần hoặc một Bộ Gỡ đối với Thiết bị Thử nghiệm."

msgid "chapter-3/lesson-4/title"
msgstr "Thiết bị"

msgid "chapter-3/lesson-5/description"
msgstr "Khi mua xe, bạn có thể tuyển kíp lái. Bạn cũng có khả năng chuyển kíp lái từ xe khác sang và tái đào tạo."

msgid "chapter-3/lesson-5/hint-1/text"
msgstr "Chỉ huy ảnh hưởng đến tầm nhìn của xe và tăng cường hiệu suất chiến đấu cho những thành viên còn lại."

msgid "chapter-3/lesson-5/hint-2/text"
msgstr "Pháo thủ ảnh hưởng đến tốc độ xoay tháp pháo, ngắm bắn và độ chính xác khi khai hỏa."

msgid "chapter-3/lesson-5/hint-3/text"
msgstr "Nạp đạn viên ảnh hưởng đến thời gian nạp đạn vào súng."

msgid "chapter-3/lesson-5/hint-4/text"
msgstr "Lái xe ảnh hưởng đến độ cơ động của xe."

msgid "chapter-3/lesson-5/hint-5/text"
msgstr "Liên lạc viên ảnh hưởng đến tầm tín hiệu tối đa."

msgid "chapter-3/lesson-5/title"
msgstr "Kíp lái"

msgid "chapter-3/lesson-6/description"
msgstr "Kỹ năng được đào tạo lần lượt. Sau khi xong kỹ năng đầu tiên 100%, bạn có thể bắt đầu học cái tiếp theo.\n\nHiệu quả của kỹ năng phụ thuộc cấu hình xe. Tìm hiểu thêm bằng cách click \"Chi tiết về Kíp lái\" trong hồ sơ thành viên lính tăng."

msgid "chapter-3/lesson-6/title"
msgstr "Kỹ năng Kíp lái"

msgid "chapter-3/lesson-7/hint-1/text"
msgstr "Kíp lái trên xe của bạn cũng sẽ nhận được kinh nghiệm sau trận đánh."

msgid "chapter-3/lesson-7/hint-2/text"
msgstr "Sử dụng XP Kíp lái để đào tạo kỹ năng."

msgid "chapter-3/lesson-7/hint-3/text"
msgstr "Huấn luyện kỹ năng kíp lái lẹ hơn bằng cách dùng Đào tạo Nhanh."

msgid "chapter-3/lesson-7/title"
msgstr "Đào tạo Kíp lái"

msgid "chapter-3/lesson-8/description"
msgstr "Chuyển giao chỉ khả dụng cho kíp lái cùng quốc tịch. Nếu thành viên được huấn luyện cho một xe nhất định, họ tự động có khả năng vận hành mọi xe Premium và phần thưởng cùng loại."

msgid "chapter-3/lesson-8/hint-1/text"
msgstr "Khi bán xe, bạn có thể giải ngũ kíp lái hoặc đưa họ về Doanh trại."

msgid "chapter-3/lesson-8/hint-2/text"
msgstr "Khi chuyển kíp lái sang xe khác, đừng quên rằng nếu không tái đào tạo, họ sẽ không thể sử dụng mọi kỹ năng lúc tham chiến."

msgid "chapter-3/lesson-8/hint-3/text"
msgstr "Nếu kíp lái được huấn luyện kém chuyên sâu, kỹ năng của họ sẽ ít hiệu quả hơn."

msgid "chapter-3/lesson-8/title"
msgstr "Chuyển và Tái đào tạo Kíp lái"

msgid "chapter-3/lesson-9/hint-1/text"
msgstr "Kinh nghiệm Chiến đấu là tài nguyên kiếm được khi có đóng góp nhất định trong trận đánh."

msgid "chapter-3/lesson-9/hint-2/text"
msgstr "XP Chiến đấu kiếm được trên xe nào thì dùng nghiên cứu mô-đun, xe kế tiếp, biến thể dã chiến và nâng cấp cho chiếc Cấp XI tương ứng."

msgid "chapter-3/lesson-9/title"
msgstr "Kinh nghiệm Chiến đấu"

msgid "chapter-3/video-lesson-1/title"
msgstr "Video: Mô-đun của xe"

msgid "chapter-3/video-lesson-2/title"
msgstr "Video: Thiết bị"

msgid "chapter-3/video-lesson-3/title"
msgstr "Video: Kinh nghiệm Kíp lái"

msgid "chapter-3/video-lesson-4/title"
msgstr "Video: Kỹ năng Kíp lái"

msgid "chapter-4/lesson-1/description"
msgstr "Là loại xe cơ động, nhanh, nhỏ gọn nhất game nhưng giáp bảo vệ vào loại yếu nhất. Tăng hạng nhẹ sinh ra là để đi trinh sát: Chúng dễ dàng phát hiện xe địch và luôn cố gắng sống sót càng lâu càng tốt."

msgid "chapter-4/lesson-1/hint-1/text"
msgstr "Loại xe nhanh nhất trong game."

msgid "chapter-4/lesson-1/hint-2/text"
msgstr "Có tốc độ và khả năng cơ động tuyệt vời."

msgid "chapter-4/lesson-1/hint-3/text"
msgstr "Kích thước nhỏ gọn với khả năng ẩn giấu cao."

msgid "chapter-4/lesson-1/title"
msgstr "Tăng hạng Nhẹ"

msgid "chapter-4/lesson-2/description"
msgstr "Tăng hạng trung là loại xe toàn diện nhất trong World of Tanks. Chúng khá cơ động và hiệu quả ở tầm trung, trong khi có đủ sức kháng cự để sống sót sau vài phát đạn từ những nòng pháo cỡ lớn."

msgid "chapter-4/lesson-2/hint-1/text"
msgstr "Loại xe khá ổn về mọi mặt và đa năng."

msgid "chapter-4/lesson-2/hint-2/text"
msgstr "Chúng có đủ độ cơ động để xuất hiện đúng lúc, đúng chỗ."

msgid "chapter-4/lesson-2/hint-3/text"
msgstr "Hiệu quả khi hỗ trợ hỏa lực từ tuyến hai."

msgid "chapter-4/lesson-2/title"
msgstr "Tăng hạng Trung"

msgid "chapter-4/lesson-3/description"
msgstr "Tăng hạng nặng là loại xe xung kích nhằm bẻ gãy tuyến phòng thủ của địch. Độ cơ động thấp khiến chúng là mồi ngon của pháo tự hành đối phương. Dù vậy, giáp bảo vệ tốt giúp chúng có khả năng sống sót sau nhiều phát đạn."

msgid "chapter-4/lesson-3/hint-1/text"
msgstr "Loại xe giáp dày với độ cơ động thấp."

msgid "chapter-4/lesson-3/hint-2/text"
msgstr "Nòng pháo cỡ lớn."

msgid "chapter-4/lesson-3/hint-3/text"
msgstr "Sức kháng cự lớn và khả năng sống sót cao."

msgid "chapter-4/lesson-3/title"
msgstr "Tăng hạng Nặng"

msgid "chapter-4/lesson-4/description"
msgstr "Trong những vị trí ẩn nấp và phục kích, pháo chống tăng có thể gây ra lượng sát thương khủng khiếp từ khoảng cách lớn. Tuy nhiên, độ cơ động quá tệ khiến chúng thường thất bại thảm hại khi đánh cận chiến."

msgid "chapter-4/lesson-4/hint-1/text"
msgstr "Nòng pháo chính xác, xuyên cao và ngắm nhanh."

msgid "chapter-4/lesson-4/hint-2/text"
msgstr "Sát thương lớn mỗi phát bắn."

msgid "chapter-4/lesson-4/hint-3/text"
msgstr "Khả năng ẩn giấu cao khi đứng yên."

msgid "chapter-4/lesson-4/title"
msgstr "Pháo Chống tăng"

msgid "chapter-4/lesson-5/description"
msgstr "Pháo tự hành luôn đứng ở tuyến sau cùng so với xe đồng đội. Chúng có khả năng bắn trúng mục tiêu ở bất kỳ vị trí nào trên bản đồ. Pháo tự hành phải ẩn nấp và sống sót thật lâu vì chúng gần như không có cơ hội nào khi cận chiến do giáp rất mỏng và độ cơ động thấp."

msgid "chapter-4/lesson-5/hint-1/text"
msgstr "Hỗ trợ hỏa lực từ xa cho đồng đội."

msgid "chapter-4/lesson-5/hint-2/text"
msgstr "Lối chơi hoàn toàn khác biệt."

msgid "chapter-4/lesson-5/hint-3/text"
msgstr "Có thể gây choáng, làm giảm đặc tính kỹ thuật của xe địch."

msgid "chapter-4/lesson-5/title"
msgstr "Pháo Tự hành"

msgid "chapter-4/lesson-6/description"
msgstr "1. T.h.Nhẹ—Tuyến đầu, trinh sát chủ động hoặc thụ động. 2. T.h.Trung—Đánh thọc sườn, diệt xe trinh sát địch, hỗ trợ đồng đội tấn công. 3. T.h.Nặng—Xuyên phá hoặc giữ vững chiến tuyến chính. 4. P.C.tăng—Hỏa lực từ xa ở tuyến hai, diệt tăng hạng nặng địch. 5. P.T.hành—Khai hỏa vào xe địch từ khoảng cách xa, ép đối phương phải rời khỏi vị trí phục kích."

msgid "chapter-4/lesson-6/title"
msgstr "Loại Xe"

msgid "chapter-4/video-lesson-1/title"
msgstr "Video: Súng nạp đạn tự động"

msgid "chapter-4/video-lesson-2/title"
msgstr "Video: Súng tái nạp tự động"

msgid "chapter-5/lesson-1/hint-1/text"
msgstr "Súng có độ chính xác càng cao, khả năng bắn trượt mục tiêu càng thấp."

msgid "chapter-5/lesson-1/hint-2/text"
msgstr "Trước khi khai hỏa, hãy đợi tới khi vòng tròn tâm ngắm co lại vào mục tiêu."

msgid "chapter-5/lesson-1/hint-3/text"
msgstr "Khai hỏa không ngắm kỹ mang lại hiệu quả rất thấp."

msgid "chapter-5/lesson-1/title"
msgstr "Độ Phân tán của Súng"

msgid "chapter-5/lesson-10/hint-1/text"
msgstr "Có thể gây ra thiệt hại ngay cả khi không xuyên giáp. Chúng có xác suất sát thương cao hơn so với các loại đạn khác, dù lượng thiệt hại có thể không lớn."

msgid "chapter-5/lesson-10/hint-2/text"
msgstr "Có thể gây ra thiệt hại cho mô-đun trong và kíp lái ngay cả khi không xuyên giáp."

msgid "chapter-5/lesson-10/hint-3/text"
msgstr "Có thể đâm qua các lớp vật liệu mỏng và một số vật thể phá hủy được, nhưng sẽ mất đi một khoản xuyên giáp. Chúng phát nổ nếu không xuyên giáp."

msgid "chapter-5/lesson-10/title"
msgstr "Đạn Nổ Mạnh (HE)"

msgid "chapter-5/lesson-11/description"
msgstr "Tầm nhìn của mỗi xe được tính toán theo đơn vị mét và hiển thị trong đặc tính kỹ thuật. 445 m là giá trị cao nhất. Tăng tầm nhìn cơ bản giúp xe bạn phát hiện địch hiệu quả hơn, đặc biệt là khi chúng đang ẩn nấp, nội trong vòng tròn tầm nhìn. Đay là thông số quan trọng nhất cho tăng hạng nhẹ. 1—Xe địch bị phát hiện trong tầm nhìn của bạn. 2—Xe địch bị phát hiện sau khi nổ súng. 3—Xe địch đang ẩn nấp sau bụi rậm. 4—Xe địch đang ẩn nấp sau một công trình."

msgid "chapter-5/lesson-11/title"
msgstr "Tầm Nhìn"

msgid "chapter-5/lesson-12/description"
msgstr "Giá trị tham số này luôn luôn là 565 m. Nó đại diện cho khoảng cách tối đa mà xe địch và xe đồng đội có thể nhìn thấy được."

msgid "chapter-5/lesson-12/title"
msgstr "Vòng Tầm Hiển thị Tối đa"

msgid "chapter-5/lesson-13/description"
msgstr "Bạn luôn luôn phát hiện được xe địch nội trong bán kính 50 m, bất kể chúng đang ẩn nấp ở đâu."

msgid "chapter-5/lesson-13/title"
msgstr "Xe Nội trong 50 Mét Luôn bị Phát hiện"

msgid "chapter-5/lesson-14/description"
msgstr "Đâm/húc xe gây ra thiệt hại tỉ lệ với độ chênh lệch khối lượng, tốc độ và độ dày giáp tại vị trí va chạm. Khi điều khiển xe có trọng lượng lớn và chạy nhanh, hãy tận dụng cơ hội và đâm/húc đối phương để gây ra lượng thiệt hại đáng kể."

msgid "chapter-5/lesson-14/title"
msgstr "Đâm/húc"

msgid "chapter-5/lesson-15/description"
msgstr "Khi bật Armor Flashlight cho chế độ Sniper, nội trong vòng ngắm sẽ hiển thị xác suất xuyên giáp địch. Màu đỏ gần như không xuyên nổi, màu vàng hên xui, còn màu xanh lục là khả năng xuyên cao."

msgid "chapter-5/lesson-15/title"
msgstr "Armor Flashlight"

msgid "chapter-5/lesson-2/description"
msgstr "Xe đứng yên có khả năng bắn chính xác hơn khi đang di chuyển. Tránh vừa chạy vừa bắn xe địch ở xa: Cơ hội trúng mục tiêu rất thấp, trong khi xe mình có thể bị phát hiện khi nổ súng."

msgid "chapter-5/lesson-2/title"
msgstr "Độ Phân tán Cao hơn khi Di chuyển"

msgid "chapter-5/lesson-3/description"
msgstr "Mỗi loại đạn có tốc độ bay khác nhau và cần một lượng thời gian cụ thể để chạm đến mục tiêu. Hãy ngắm vào phía trước hoặc đón đầu xe địch để bắn trúng mục tiêu đang di chuyển. Tìm hiểu kỹ nòng pháo của mình và cố gắng làm quen với tốc độ đạn bay—bạn sẽ có khả năng bắn đón mục tiêu ở khoảng cách xa với tỷ lệ chính xác cao hơn."

msgid "chapter-5/lesson-3/title"
msgstr "Bắn Mục tiêu đang Di chuyển (Bắn đón)"

msgid "chapter-5/lesson-4/description"
msgstr "Ngắm Tự động sẽ tự động bám theo xe địch, nhưng đó chưa hẳn là điều hay. Chế độ ngắm tự động sẽ bám vào tâm hình học của xe mà rất có thể được bọc giáp rất dày ở vị trí đó."

msgid "chapter-5/lesson-4/hint-1/text"
msgstr "Sử dụng nút chuột phải để ngắm tự động vào một xe địch; click lại lần nữa sẽ hủy kích hoạt chế độ này."

msgid "chapter-5/lesson-4/hint-2/text"
msgstr "Tùy chọn này khá hữu ích khi buộc phải khai hỏa khi đang di chuyển."

msgid "chapter-5/lesson-4/hint-3/text"
msgstr "Ngắm Tự động không tự động đón đầu mục tiêu."

msgid "chapter-5/lesson-4/title"
msgstr "Ngắm Tự động"

msgid "chapter-5/lesson-5/description"
msgstr "Chỉ báo màu xanh cho thấy xác suất xuyên giáp cao nhất. Ngay cả khi không xuyên hay gây ra sát thương, nhiều khả năng bạn vẫn có thể làm hư hại mô-đun ngoài của xe địch. Chỉ báo màu đỏ cho thấy xác suất xuyên giáp địch rất thấp (hoặc đơn giản bằng 0). Chỉ báo vàng cho thấy xác suất khoảng 50%."

msgid "chapter-5/lesson-5/title"
msgstr "Xuyên giáp"

msgid "chapter-5/lesson-6/description"
msgstr "Nòng pháo nào cũng cần nạp lại đạn mới có thể khai hỏa tiếp."

msgid "chapter-5/lesson-6/title"
msgstr "Quá trình Nạp đạn"

msgid "chapter-5/lesson-7/hint-1/text"
msgstr "Độ xuyên của loại đạn này giảm theo khoảng cách bay, nhưng vẫn có góc thường hóa tốt."

msgid "chapter-5/lesson-7/hint-2/text"
msgstr "Chúng bị giảm độ xuyên lý thuyết khi phải xuyên qua các vật thể phá hủy được."

msgid "chapter-5/lesson-7/hint-3/text"
msgstr "Loại đạn này thường bị nảy bật ra khi trúng giáp ở một góc lớn hơn hoặc bằng 70 độ."

msgid "chapter-5/lesson-7/title"
msgstr "Đạn Xuyên Giáp (AP)"

msgid "chapter-5/lesson-8/description"
msgstr "Đạn Xuyên Giáp Hỗn hợp Cứng (APCR)"

msgid "chapter-5/lesson-8/hint-1/text"
msgstr "Tốc độ bay nhanh và xuyên giáp tốt, nhưng góc thường hóa kém."

msgid "chapter-5/lesson-8/hint-2/text"
msgstr "Chúng bị giảm độ xuyên theo khoảng cách bay và khi phải xuyên qua các vật thể phá hủy được."

msgid "chapter-5/lesson-8/hint-3/text"
msgstr "Loại đạn này thường bị nảy bật ra khi trúng giáp ở một góc lớn hơn hoặc bằng 70 độ."

msgid "chapter-5/lesson-8/title"
msgstr "Đạn Xuyên Giáp Hỗn hợp Cứng (APCR)"

msgid "chapter-5/lesson-9/hint-1/text"
msgstr "Loại đạn này có độ xuyên lý thuyết cao và không bị giảm theo khoảng cách bay."

msgid "chapter-5/lesson-9/hint-2/text"
msgstr "Chúng không thể xuyên qua chướng ngại hoặc vật thể phá hủy được, và nhiều khả năng không xuyên các tấm chắn hay lưới kim loại bảo vệ quanh xe tăng."

msgid "chapter-5/lesson-9/hint-3/text"
msgstr "Thường nảy bật ra khi trúng giáp ở một góc lớn hơn hoặc bằng 85 độ."

msgid "chapter-5/lesson-9/title"
msgstr "Đạn Nổ Mạnh Chống Tăng (HEAT)"

msgid "chapter-5/video-lesson-1/title"
msgstr "Video: Xuyên giáp"

msgid "chapter-5/video-lesson-2/title"
msgstr "Video: Ẩn giấu và Trinh sát"

msgid "chapter-6/lesson-1/description"
msgstr "Xe nào cũng có giáp bảo vệ. TẤT CẢ mọi xe thường bọc giáp tốt nhất ở mặt trước, tháp pháo (hoặc cabin) khá dày, nhưng hông và phía sau khá yếu. Mỗi xe có kiểu bố trí giáp độc đáo, đặc trưng với nhiều khu vực mạnh và yếu riêng."

msgid "chapter-6/lesson-1/title"
msgstr "Đặc điểm của Giáp"

msgid "chapter-6/lesson-10/description"
msgstr "Thùng Nhiên liệu đã hư hại chắc chắn sẽ bắt lửa khi bị bắn hỏng trong trận. Tuy nhiên Thùng Nhiên liệu hư hại không ảnh hưởng đến hiệu suất chiến đấu của xe: Chỉ báo màu vàng chỉ đơn giản thông báo xác suất bốc cháy cao hơn ở lần trúng đạn tiếp theo vào mô-đun này."

msgid "chapter-6/lesson-10/title"
msgstr "Hư hại Thùng Nhiên liệu"

msgid "chapter-6/lesson-11/description"
msgstr "Gác đạn bị hư hại sẽ làm tăng gấp đôi thời gian nạp đạn. Nếu bị bắn hỏng, nó sẽ phát nổ và phá hủy xe của bạn chỉ trong nháy mắt."

msgid "chapter-6/lesson-11/title"
msgstr "Hư hại Gác Đạn"

msgid "chapter-6/lesson-12/description"
msgstr "Radio bị hư hại không ảnh hưởng đến hiệu suất chiến đấu của xe và nó vẫn tiếp tục hoạt động được. Tuy nhiên, khi bị bắn hỏng hoàn toàn, tầm tín hiệu của bạn sẽ bị giảm đi một nửa và gây khó khăn trong việc nắm bắt tình huống chiến đấu."

msgid "chapter-6/lesson-12/title"
msgstr "Hư hại Radio"

msgid "chapter-6/lesson-13/description"
msgstr "Chỉ huy bị thương sẽ làm giảm tầm nhìn, mất khoản tăng hiệu suất cho các thành viên kíp lái còn lại, vô hiệu hóa tính năng Giác quan Thứ 6 và mọi kỹ năng tương ứng của Chỉ huy."

msgid "chapter-6/lesson-13/title"
msgstr "Chỉ huy bị thương"

msgid "chapter-6/lesson-14/description"
msgstr "Pháo thủ bị thương sẽ làm giảm tốc độ ngắm và quay tháp pháo của xe, cũng như vô hiệu hóa mọi kỹ năng tương ứng của Pháo thủ."

msgid "chapter-6/lesson-14/title"
msgstr "Pháo thủ bị thương"

msgid "chapter-6/lesson-15/description"
msgstr "Lái xe bị thương sẽ làm giảm khả năng di chuyển và tốc độ quay thân của xe, cũng như vô hiệu hóa mọi kỹ năng tương ứng của Lái xe."

msgid "chapter-6/lesson-15/title"
msgstr "Lái xe bị thương"

msgid "chapter-6/lesson-16/description"
msgstr "Liên lạc viên bị thương sẽ làm giảm tầm tín hiệu của xe và vô hiệu hóa mọi kỹ năng tương ứng của Liên lạc viên."

msgid "chapter-6/lesson-16/title"
msgstr "Liên lạc viên bị thương"

msgid "chapter-6/lesson-17/description"
msgstr "Nạp đạn viên bị thương sẽ làm tăng thời gian nạp đạn của xe và vô hiệu hóa mọi kỹ năng tương ứng của Nạp đạn viên."

msgid "chapter-6/lesson-17/title"
msgstr "Nạp đạn viên bị thương"

msgid "chapter-6/lesson-18/description"
msgstr "Khi rơi từ trên xuống, bạn có thể gây thiệt hại cho cả xe mình lẫn xe địch bên dưới. Nếu gặp phải nước sâu, đừng quên chỉ có 10 giây trước lúc bị chìm không cứu nổi. Trong trường hợp bị lật, xe của bạn sẽ tự động được dựng trở lại sau một khoảng thời gian ngắn."

msgid "chapter-6/lesson-18/title"
msgstr "Chìm, Lật và Rơi"

msgid "chapter-6/lesson-19/description"
msgstr "Bất kỳ loại thực vật nào (trừ cỏ) cũng đều che giấu xe của bạn khỏi địch. Đảm bảo rằng bụi rậm và tán cây che hết toàn bộ xe. Khi nổ súng, mọi loại che giấu trong bán kính 15 mét đều mất tác dụng. Bởi thế, bạn nên lùi xe cách bụi rậm trước mặt 15 m trước khi khai hỏa."

msgid "chapter-6/lesson-19/title"
msgstr "Thực vật và Ẩn giấu"

msgid "chapter-6/lesson-2/description"
msgstr "Khi đối diện làn đạn địch, cố gắng đừng bị bắn trúng ở một góc 90 độ. Xoay xe tạo góc tiếp xúc lớn giúp tăng khả năng nảy đạn."

msgid "chapter-6/lesson-2/title"
msgstr "Chặn Thiệt hại bằng Giáp hông"

msgid "chapter-6/lesson-20/description"
msgstr "Xe được ẩn giấu sẽ không lộ hình đối với địch. Hãy sử dụng Lưới Ngụy trang, Hệ thống Thoát khí Giảm thanh, sơn ngụy trang, ứng dụng kỹ thuật phù hợp hoặc kỹ năng Ẩn giấu để tăng khả năng ẩn mình cho xe của bạn. Bên cạnh đó, Quạt Thông gió Cải tiến, Đoàn kết và vật phẩm đặc biệt cũng đẩy cao độ ngụy trang nhưng chỉ khi lính đã học kỹ năng Ẩn giấu. Đừng quên: Nổ súng và có lửa cháy trong xe sẽ làm lộ vị trí của mình."

msgid "chapter-6/lesson-20/title"
msgstr "Ẩn giấu Xe và Yếu tố Làm lộ"

msgid "chapter-6/lesson-21/description"
msgstr "Trong cửa sổ NGOẠI THẤT, bạn có thể tùy biến xe mình. Ngụy trang làm thay đổi bề ngoài của xe, cũng như gia tăng khả năng ẩn giấu. Bạn có thể chọn từ hàng loạt hoa văn ngụy trang cho bản đồ mùa hè/mùa đông/sa mạc."

msgid "chapter-6/lesson-21/title"
msgstr "Ngụy trang"

msgid "chapter-6/lesson-3/description"
msgstr "Khi giao tranh với địch, cố gắng tận dụng tối đa các chỗ tránh đạn có sẵn như đá tảng, xác xe tăng hoặc nhà cửa. Điều này sẽ giúp giữ lại rất nhiều sức kháng cự cho bạn."

msgid "chapter-6/lesson-3/title"
msgstr "Tận dụng Nơi Tránh đạn để Giấu Điểm yếu của xe"

msgid "chapter-6/lesson-4/description"
msgstr "Hãy tận dụng tối đa đặc điểm địa hình của bản đồ. Giấu thân ở các vị trí lõm xuống và giảm tối thiểu phần xe lộ ra. Bạn có thể nổ súng từ sau quả đồi mà không bị địch bắn trả dễ dàng."

msgid "chapter-6/lesson-4/title"
msgstr "Tận dụng Đặc điểm Địa hình"

msgid "chapter-6/lesson-5/description"
msgstr "Hệ thống xích bị hư hại làm tăng xác suất hỏng hoàn toàn, hay đứt xích. Xích bị đứt sẽ làm bất động hầu hết các xe trong một khoảng thời gian."

msgid "chapter-6/lesson-5/title"
msgstr "Hư hại Hệ thống Xích"

msgid "chapter-6/lesson-6/description"
msgstr "Súng bị hư hại có xác suất trúng đích rất thấp. Tệ hơn, khi bị hỏng hoàn toàn, nó không thể khai hỏa cho đến khi được sửa chữa ít nhất đến tình trạng màu vàng."

msgid "chapter-6/lesson-6/title"
msgstr "Hư hại Súng"

msgid "chapter-6/lesson-7/description"
msgstr "Thiết bị Quan sát bị hư hại không ảnh hưởng đến tầm nhìn, nhưng nếu hỏng hoàn toàn sẽ làm giảm một nửa tầm nhìn."

msgid "chapter-6/lesson-7/title"
msgstr "Hư hại Thiết bị Quan sát"

msgid "chapter-6/lesson-8/description"
msgstr "Đai tháp pháo bị hư hại làm giảm tốc độ xoay tháp pháo. Khi bộ phận này hỏng hoàn toàn, tháp pháo sẽ kẹt cứng cho đến khi được sửa chữa. Bạn sẽ khổ sở vật lộn chiến đấu với một tháp pháo không quay được."

msgid "chapter-6/lesson-8/title"
msgstr "Hư hại Đai Tháp pháo"

msgid "chapter-6/lesson-9/description"
msgstr "Động cơ bị hư hại làm giảm đáng kể độ cơ động của xe. Khi hỏng hoàn toàn, xe sẽ không thể di chuyển cho đến khi động cơ được sửa chữa. Động cơ trúng đạn có thể làm cháy xe."

msgid "chapter-6/lesson-9/title"
msgstr "Hư hại Động cơ"

msgid "chapter-6/video-lesson-1/title"
msgstr "Video: Cách Sử dụng Giáp"

msgid "chapter-6/video-lesson-2/title"
msgstr "Video: Ẩn giấu Như Thế nào (Phần 1)"

msgid "chapter-6/video-lesson-3/title"
msgstr "Video: Ẩn giấu Như Thế nào (Phần 2)"

msgid "chapter-7/lesson-1/description"
msgstr "Bản đồ con cung cấp cái nhìn tổng quan về thế trận. Ngoài vị trí đồng đội, nó cũng hiển thị vị trí địch do phe ta phát hiện, cũng như tầm nhìn của xe bạn so với tầm nhìn cao nhất, hướng camera và vòng tầm hiển thị tối đa. Vòng tròn nhỏ nhất là khoảng cách mà xe địch tự động bị phát hiện bất chấp cơ chế ẩn giấu. Bạn có thể tùy chỉnh bản đồ con trong mục Thiết lập."

msgid "chapter-7/lesson-1/title"
msgstr "Bản đồ con"

msgid "chapter-7/lesson-10/hint-1/text"
msgstr "Tạo Trung đội gồm 2–3 người chơi và phối hợp tác chiến."

msgid "chapter-7/lesson-10/hint-2/text"
msgstr "Nhận thêm XP khi tham chiến theo Trung đội."

msgid "chapter-7/lesson-10/hint-3/text"
msgstr "Chỉ các xe cùng cấp mới được tham chiến theo Trung đội. Chỉ 1 tăng hạng nhẹ bánh lốp/xích (VII–XI) và 1 pháo tự hành được phép trong 1 Trung đội."

msgid "chapter-7/lesson-10/title"
msgstr "Chơi trong một Trung đội"

msgid "chapter-7/lesson-11/description"
msgstr "Trợ cấp Cá nhân là các lợi ích riêng, cho phép bạn thu về thêm phần thưởng sau mỗi trận trong một khoảng thời gian nhất định. Trợ cấp có thể nhận được khi hoàn tất nhiệm vụ hoặc tham gia những sự kiện đặc biệt, cũng như mua từ Cửa hàng."

msgid "chapter-7/lesson-11/title"
msgstr "Trợ cấp Cá nhân"

msgid "chapter-7/lesson-2/description"
msgstr "Mọi lệnh từ menu này được áp dụng cho phím tắt F3–F8."

msgid "chapter-7/lesson-2/hint-1/text"
msgstr "Nhấn-giữ phím Z và đưa trỏ chuột vào một lệnh để chọn nó."

msgid "chapter-7/lesson-2/title"
msgstr "Hiển thị Bảng Lệnh Điều khiển"

msgid "chapter-7/lesson-3/description"
msgstr "Một trạng thái tài khoản đặc biệt giúp mang lại thêm 50% bạc và kinh nghiệm sau mỗi trận. Nó có thể mua bằng vàng cho một khoảng thời gian nhất định, nhận được khi hoàn tất nhiều nhiệm vụ cụ thể, hoặc từ các sự kiện đặc biệt. Chưa kể, nó còn mang lại thêm những đặc cách khác như lợi ích linh động đối với XP, thêm ô bản đồ không thích, v.v..."

msgid "chapter-7/lesson-3/title"
msgstr "Tài khoản Premium WoT"

msgid "chapter-7/lesson-4/description"
msgstr "Vàng là một loại tiền tệ quý giá trong game. Nó không mua được bất kỳ lợi thế thật sự nào, nhưng giúp đơn giản hóa tiến trình game. Bạn có thể dùng vàng để mở rộng Doanh trại, mua Tài khoản Premium WoT và xe Premium, gỡ thiết bị, quy đổi Kinh nghiệm Tự do, cùng rất nhiều lợi ích khác."

msgid "chapter-7/lesson-4/title"
msgstr "Vàng"

msgid "chapter-7/lesson-5/description"
msgstr "Bạc là một loại tiền tệ quan trọng, chỉ nhận được khi có đóng góp cụ thể trong trận đánh. Bạn có thể dùng bạc để sửa xe, mua mô-đun và xe mới, tái tiếp tế đạn dược, thiết bị, cùng nhiều thứ khác."

msgid "chapter-7/lesson-5/title"
msgstr "Bạc"

msgid "chapter-7/lesson-6/description"
msgstr "Trái phiếu là loại tiền tệ đặc biệt trong game, thu về từ Trận đấu Ngẫu nhiên và các sự kiện nhất định. Một vài hàng hóa độc đáo có thể được mua bằng trái phiếu, bao gồm: Xe cộ hiếm, thiết bị tiên tiến, kiểu mẫu và ứng dụng kỹ thuật cho thiết bị."

msgid "chapter-7/lesson-6/title"
msgstr "Trái phiếu"

msgid "chapter-7/lesson-7/description"
msgstr "Xe Premium là một loại phương tiện đặc biệt, không cần nghiên cứu gì thêm và có sẵn cấu hình tốt nhất khi mua. Khi tham chiến, chúng mang lại thêm bạc và kinh nghiệm. Chưa kể, xe Premium có thể sử dụng kíp lái từ một xe khác cùng loại, cùng quốc gia mà không cần tái đào tạo. Hơn nữa, chi phí sửa xe Premium thường rẻ hơn. Đây là cơ hội tuyệt vời cho những người chơi muốn tiết kiệm thời gian."

msgid "chapter-7/lesson-7/title"
msgstr "Xe Premium"

msgid "chapter-7/lesson-8/hint-1/text"
msgstr "Liên lạc với đồng đội trong trận (phím Enter) hoạc tạo kênh riêng sau khi trận đánh kết thúc."

msgid "chapter-7/lesson-8/hint-2/text"
msgstr "Thêm người chơi vào danh sách Bạn bè để tìm thành viên Trung đội cho các trận đánh trong tương lai."

msgid "chapter-7/lesson-8/hint-3/text"
msgstr "Khi sử dụng từ ngữ xúc phạm hoặc làm phiền người chơi khác trong trận, bạn đã vi phạm Quy định Game và sẽ bị trừng phạt."

msgid "chapter-7/lesson-8/title"
msgstr "Giao tiếp"

msgid "chapter-7/lesson-9/hint-1/text"
msgstr "Bạn sẽ nhận được hàng loạt huân chương và danh hiệu cho những thành tích đặc biệt trong trận đánh."

msgid "chapter-7/lesson-9/hint-2/text"
msgstr "Chỉ số Cá nhân đại diện cho tổng kỹ năng và kinh nghiệm trong game. Nó được hiển thị cho tất cả mọi người chơi."

msgid "chapter-7/lesson-9/hint-3/text"
msgstr "Mỗi xe có danh sách thành tích riêng trong hàng loạt chế độ đánh."

msgid "chapter-7/lesson-9/title"
msgstr "Bảng Thành tích"

msgid "chapter-7/video-lesson-1/title"
msgstr "Video: Hệ thống Liên lạc Nhanh"

msgid "chapter-7/video-lesson-2/title"
msgstr "Video: Tài khoản Premium"

msgid "chapter-7/video-lesson-3/title"
msgstr "Video: Tiền tệ Trong Game"

msgid "chapter-7/video-lesson-4/title"
msgstr "Video: Trung đội"

