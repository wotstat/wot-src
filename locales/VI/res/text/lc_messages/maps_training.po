msgid "06_ensk/team1/heavyTank/descr"
msgstr "Mấu chốt của chiến thuật này là <a_ht_centralStreet>đường trung tâm</a_ht_centralStreet>.%(p)Các vị trí tại <a_ht_smallYard>sân nhỏ</a_ht_smallYard> cho phép bạn đấu súng với địch trên <a_ht_centralStreet>đường trung tâm</a_ht_centralStreet> và trong <a_ht_largeYard>sân lớn</a_ht_largeYard>. Nhớ rằng có rất nhiều hướng bắn trên bản đồ, vậy nên khi đứng ở <a_ht_smallYard>sân nhỏ</a_ht_smallYard> hay <a_ht_largeYard>sân lớn</a_ht_largeYard>, cũng như lúc đi ra <a_ht_centralStreet>đường trung tâm</a_ht_centralStreet>, bạn phải cẩn thận và chú ý đến <a_ht_square>quảng trường</a_ht_square>. Sau khi phá vỡ hàng thủ địch ở sân lớn, bạn có thể tiếp cận căn cứ đối phương qua <a_ht_stadium>sân vận động</a_ht_stadium>. Từ đây, bạn có thể ngắm bắn những vị trí phòng thủ ở cánh đối diện trong <a_ht_southernVillage>làng phía nam</a_ht_southernVillage>."

msgid "06_ensk/team1/heavyTank/title"
msgstr "Tấn công Thị trấn"

msgid "06_ensk/team1/mediumTank/descr"
msgstr "Mấu chốt của chiến thuật này là các <a_mt_storages>nhà kho</a_mt_storages>.%(p)Di chuyển theo cánh trái, bạn có thể chiếm vị trí gần <a_mt_industrialArea>khu công nghiệp</a_mt_industrialArea>. Từ đó, bạn có thể bắn cả khu vực <a_mt_forest>thảm thực vật</a_mt_forest> cũng như cạnh <a_mt_storages>nhà kho</a_mt_storages>. Dưới sự che chắn của các đường đắp và tòa nhà, bạn có thể an toàn đến gần địch trong <a_mt_southernVillage>làng phía nam</a_mt_southernVillage>. Nếu tiêu diệt hết đối phương tại đó, bạn có cơ hội tiếp cận căn cứ rồi chọc sườn kẻ thù trong <a_mt_stadium>sân vận động</a_mt_stadium> hoặc gần <a_mt_platform>sân ga</a_mt_platform>."

msgid "06_ensk/team1/mediumTank/title"
msgstr "Tấn công Nhà kho"

msgid "06_ensk/team2/heavyTank/descr"
msgstr "Mấu chốt của chiến thuật này là <b_ht_centralStreet>đường trung tâm</b_ht_centralStreet>.%(p)Các vị trí tại <b_ht_largeYard>sân lớn</b_ht_largeYard> cho phép bạn đấu súng với địch ở đối diện <b_ht_centralStreet>đường trung tâm</b_ht_centralStreet> và sâu trong <b_ht_smallYard>sân nhỏ</b_ht_smallYard>. Nhớ rằng có rất nhiều hướng bắn trên bản đồ, vậy nên lúc đi ra <b_ht_centralStreet>đường trung tâm</b_ht_centralStreet> hay khi hành quân từ <b_ht_smallYard>sân nhỏ</b_ht_smallYard> đến căn cứ địch, bạn phải cẩn thận và chú ý đến <b_ht_square>quảng trường</b_ht_square>. Sau khi phá vỡ hàng thủ địch trong thành phố và tiếp cận căn cứ đối phương, bạn có thể tấn công những vị trí phòng thủ ở cánh đối diện trong <b_ht_northernVillage>làng phía bắc</b_ht_northernVillage>."

msgid "06_ensk/team2/heavyTank/title"
msgstr "Tấn công Thị trấn"

msgid "06_ensk/team2/mediumTank/descr"
msgstr "Mấu chốt của chiến thuật này là <b_mt_industrialArea>khu công nghiệp</b_mt_industrialArea>.%(p)Di chuyển theo cánh phải, bạn có thể chiếm vị trí gần các <b_mt_storages>nhà kho</b_mt_storages> để bắn địch ở phía đối diện khu công nghiệp. Tiếp theo, dưới sự che chắn của các nhà kho, bạn nên đi thẳng vào <b_mt_industrialArea>khu công nghiệp</b_mt_industrialArea>. Từ đó, tận dụng hàng loạt chỗ nấp, bạn có thể đấu súng thành công trước đối phương trong <b_mt_industrialArea>khu công nghiệp</b_mt_industrialArea>, <b_mt_forest>thảm thực vật</b_mt_forest> và <b_mt_northernVillage>làng phía bắc</b_mt_northernVillage>. Sau khi phá vỡ tuyến địch và tiếp cận căn cứ, khả năng dọn sạch những mục tiêu còn lại trong vùng <b_mt_northernSuburb>ngoại ô phía bắc</b_mt_northernSuburb> là rất cao."

