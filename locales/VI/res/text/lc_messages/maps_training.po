msgid "queue/tip/1"
msgstr "Khám phá bản đồ để có lợi thế khi giao tranh."

msgid "queue/tip/10"
msgstr "Để tránh đạn địch, hãy thay đổi vị trí mà không bị phát hiện."

msgid "queue/tip/11"
msgstr "Sử dụng các vật thể (đá, công trình) trên bản đồ để bảo vệ xe mình."

msgid "queue/tip/12"
msgstr "Xe giáp dày: Trong một số trường hợp, bạn có thể trông cậy vào giáp bảo vệ của mình."

msgid "queue/tip/13"
msgstr "Xe cơ động: Khả năng linh hoạt là vũ khí chính của bạn."

msgid "queue/tip/14"
msgstr "Đừng phơi xe cho địch bắn, hãy đổi vị trí và tránh những khu vực dễ ăn đạn."

msgid "queue/tip/15"
msgstr "Khi tái nạp, hãy ẩn nấp và tránh đạn địch."

msgid "queue/tip/16"
msgstr "Nhử địch nổ súng rồi bắn khi chúng đang tái nạp đạn."

msgid "queue/tip/17"
msgstr "Để thắng, bạn cần di chuyển theo một trong những làn khả dụng trên bản đồ, xuyên thủng tuyến phòng thủ của địch và tiêu diệt các mục tiêu."

msgid "queue/tip/18"
msgstr "Trắc địa hiển thị các làn đáng chú ý, một số kịch bản giao tranh khả dĩ, cũng như những khu vực phổ biến cho tăng hạng trung và hạng nặng."

msgid "queue/tip/19"
msgstr "Thời gian có hạn. Hoàn tất đường bắn để nhận thêm thời gian."

msgid "queue/tip/2"
msgstr "Trắc địa là một chế độ cho phép bạn độc lập khám phá nhiều bản đồ trong game mà không ảnh hưởng đến thống kê/chỉ số của mình."

msgid "queue/tip/20"
msgstr "Trận đánh diễn ra tùy theo nhiều yếu tố. Luôn để ý đến đồng đội và cân nhắc sự khác biệt của xe mình."

msgid "queue/tip/21"
msgstr "Trên khu vực huấn luyện này, mức độ phản kháng không quá dữ dội. Ngoài trận thật, hãy tỉnh táo, đừng chủ quan với những khác biệt dù là nhỏ nhất trên bản đồ, cũng như đặc tính xe địch."

msgid "queue/tip/3"
msgstr "Học các làn phổ biến và sử dụng những điểm then chốt."

msgid "queue/tip/4"
msgstr "Học các vị trí điển hình mà địch thường chiếm giữ trong trận để biến thông tin này thành lợi thế cho mình."

msgid "queue/tip/5"
msgstr "Đừng quên tận dụng địa hình lồi lõm để khai hỏa trúng địch mà không chịu thiệt hại từ đạn bắn trả."

msgid "queue/tip/6"
msgstr "Mục tiêu nằm tại những khu vực thường thấy nhất trong chế độ Trận đấu Ngẫu nhiên."

msgid "queue/tip/7"
msgstr "Học các điểm yếu trên nhiều xe khác nhau và ngắm bắn vào đó."

msgid "queue/tip/8"
msgstr "Đường bắn là các vị trí có nơi ẩn náu. Bạn có thể sử dụng chúng để theo dõi động tĩnh của địch hoặc nổ súng bắn đối phương."

msgid "queue/tip/9"
msgstr "Đến đường bắn để hoàn thành nhiệm vụ và nhận thêm thời gian."

