msgid "alert"
msgstr "Bạn không thể chọn Quân Dự bị Chiến đấu trong khi đang đánh nhau."

msgid "description/one/reserve"
msgstr "Chọn Quân Dự bị %(reserve_name)s nhiều lần\nsẽ làm tăng đặc tính của nó."

msgid "description/second/reserve"
msgstr "Chọn Quân Dự bị %(first_reserve_name)s hoặc %(second_reserve_name)s nhiều lần\nsẽ làm tăng đặc tính của cái được chọn."

msgid "number_1"
msgstr "Thứ 1"

msgid "number_2"
msgstr "Thứ 2"

msgid "number_3"
msgstr "Thứ 3"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Rải một bãi mìn (có công hiệu trong khoảng thời gian nhất định) vào khu vực được chọn."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Gây thiệt hại đáng kể cho xe địch nội trong một bán kính nhỏ."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Làm choáng xe địch và gây thiệt hại vừa phải nội trong một bán kính rộng."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Tăng chuyên môn chính cho kíp lái của người chơi và đồng đội."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Cung cấp một khoản tăng cho tốc độ chiếm, chặn chiếm và tái tiếp tế."

msgid "shortDescription/reserve/reconAbility"
msgstr "Phát hiện xe địch và bãi mìn."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Khôi phục một lượng sức kháng cự nhất định cho xe."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Che giấu mọi xe nằm trong và phía sau màn khói."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Tăng thêm khả năng ẩn giấu và tầm nhìn. Làm giảm độ ẩn giấu của xe địch."

msgid "title"
msgstr "Ô Quân Dự bị %(number_name)s Khả dụng"
