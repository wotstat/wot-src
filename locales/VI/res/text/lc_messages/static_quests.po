msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Bắt đầu một Trận đấu Ngẫu nhiên bằng xe thuộc bất cứ cấp độ nào."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Chào mừng đến trò chơi! Tham chiến cùng bạn bè khắp thế giới và ăn mừng những thắng lợi ngoạn mục!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Trận Đầu"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Nghiên cứu và mua bất cứ xe Cấp IV nào."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Mua xe mới là một dịp quan trọng. Với mỗi cấp tiếp theo, xe ngày càng thú vị hơn. Kíp lái thành thạo cũng sẽ cải thiện đáng kể lối chơi."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Xe Cấp IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Đánh ba Trận đấu Ngẫu nhiên bằng xe Cấp IV–X có trang bị bất cứ chi tiết tùy biến nào."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Xe có thể được tùy biến bằng cách đổi ngoại quan với nhiều kiểu mẫu tiền lập, hoặc tạo diện mạo của riêng bạn từ ngụy trang, khẩu hiệu, biểu tượng và đề-can."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Ngoại thất Xe"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Bắt đầu học bất cứ kỹ năng nào cho thành viên kíp lái tùy ý."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Thành viên kíp lái có thể học thêm kỹ năng để nâng cao hiệu suất chiến đấu hoặc sở hữu khả năng mới."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Kỹ năng Kíp lái"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Kiếm được 150 000 bạc từ các Trận đấu Ngẫu nhiên bằng xe Cấp IV–X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Cấp độ chiến trận càng cao, bạn sẽ cần càng nhiều bạc để bảo trì xe, tái tiếp tế đạn dược, mua mô-đun và thiết bị."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Tích trữ Bạc"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Nghiên cứu và mua bất cứ xe Cấp V nào."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Cấp V là nơi nhiều xe đáng gờm hơn bắt đầu xuất hiện, thực sự thử thách kỹ năng của bạn. Kíp lái thành thục hoàn toàn sẽ rất cần thiết."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Xe Cấp V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Cấp V–X với đủ ba thiết bị được lắp đặt."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Kính Quang học hay Quạt Thông gió? Thiết bị phù hợp có thể tăng ưu, giảm nhược cho xe của bạn."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Lắp đặt Thiết bị"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Hoàn tất một kịch bản cơ sở trong chế độ Trắc địa."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Để tự tin trên trận địa, cách tốt nhất là học thuộc đường đi nước bước, chiến thuật, bản đồ, từ những vị trí then chốt đến các vật thể quan trọng."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Trắc địa"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Hoàn tất bốn kịch bản nâng cao ở một bản đồ trong Trắc địa."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Vào chế độ Trắc địa thường xuyên để học kỹ các bản đồ Trận đấu Ngẫu nhiên. Bốn kịch bản giúp bạn khám phá địa điểm từ những góc độ khác nhau."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Trắc địa Nâng cao"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Cấp V–X với một Trợ cấp Cá nhân được kích hoạt."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Khi được kích hoạt, bạn có thể nhận thêm lợi ích cho XP Chiến đấu, XP Tự do và Kíp lái, hoặc bạc sau mỗi trận."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Trợ cấp Cá nhân"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Sáu lần đứng Top 10 người chơi phe mình theo số XP khi thắng trong các Trận đấu Ngẫu nhiên bằng xe Cấp V–X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Những nhiệm vụ này giúp kiếm thêm gấp năm lần XP mỗi trận đánh thành công. Cụ thể, bạn cần phải thắng và đứng Top 10 người chơi phe mình theo số XP."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 Nhiệm vụ ×5 XP"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Nghiên cứu một mô-đun rồi lắp nó lên xe thuộc bất cứ cấp nào."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "XP Chiến đấu được trao sau mỗi trận. Kiếm XP Chiến đấu để nghiên cứu mô-đun mới, giúp cải thiện hiệu quả chiến đấu của xe."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "XP Chiến đấu"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Nghiên cứu và mua bất cứ xe Cấp VI nào."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Ở mỗi cấp sau, nghiên cứu xe sẽ cần nhiều thời gian và công sức hơn. XP Tự do sẽ giúp bạn thăng tiến nhanh hơn, trong khi kíp lái thành thạo rất hữu ích."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Xe Cấp VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Hoàn thành một Nhiệm vụ Cá nhân ở bất cứ chiến dịch nào."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Chiến dịch là một chuỗi nhiều nhiệm vụ cho các loại xe khác nhau. Khi hoàn thành, bạn sẽ nhận được hàng loạt phần thưởng hữu ích và chiến xa độc nhất vô nhị."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Nhiệm vụ Cá nhân"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Đào tạo một kíp lái bằng Giáo trình Phổ dụng."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Tài liệu Kíp lái giúp bạn tăng tốc độ đào tạo lính tăng một cách đáng kể bằng cách bổ sung lượng XP nhất định."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Tài liệu Kíp lái"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Cấp VI–X có trang bị một ứng dụng kỹ thuật cho kíp lái."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Ứng dụng Kỹ thuật cải thiện kỹ năng kíp lái trong một trận. Như vật phẩm, Ứng dụng Kỹ thuật có thể được mua hoặc thưởng."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Ứng dụng Kỹ thuật cho Kíp lái"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Mua một Gói Tân binh ở Cửa hàng trong game."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Bạn có thể mua mọi thứ cần thiết ở Cửa hàng trong game như vàng, xe Premium, vân vân. Bên cạnh đó là ưu đãi thường xuyên, giá hấp dẫn."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Cửa hàng"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Premium Cấp VI–X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Các xe này không cần nghiên cứu. Chúng kiếm được nhiều XP Chiến đấu, XP Kíp lái và bạc hơn, cũng như cho phép dùng kíp lái từ xe khác mà không phải tái đào tạo."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Xe Premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Cấp VI–X có lắp một ứng dụng kỹ thuật cho thiết bị."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Ứng dụng Kỹ thuật giúp tăng hiệu quả của thiết bị đã lắp. Như vật phẩm, Ứng dụng Kỹ thuật có thể được mua hoặc thưởng."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Ứng dụng Kỹ thuật cho Thiết bị"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "15 lần đứng Top 10 người chơi phe mình theo số XP trong các Trận đấu Ngẫu nhiên bằng xe Cấp VI–X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Những nhiệm vụ này giúp kiếm thêm gấp năm lần XP mỗi trận đánh thành công. Cụ thể, bạn cần phải thắng và đứng Top 10 người chơi phe mình theo số XP."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 Nhiệm vụ ×5 XP"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Nghiên cứu và mua bất cứ xe Cấp VII nào."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Ở cấp độ này, yêu cầu về trình độ người chơi tăng lên. Xe trở nên đáng sợ và hiệu quả hơn—cùng với đó là đối thủ của bạn."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Xe Cấp VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Đánh 10 Trận đấu Ngẫu nhiên bằng xe Cấp VII–X có trang bị Bộ Cứu thương Lớn, Bộ Sửa chữa Lớn và Bình Chữa cháy Tự động."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Khi được trang bị, vật phẩm lớn sửa mô-đun hư hại nhanh hơn loại nhỏ. Chúng cũng giảm thời gian bị choáng, giảm xác suất bắt lửa và rút ngắn thời gian chờ hồi phục."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Vật phẩm Lớn"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Nhận gấp đôi XP cho thắng lợi đầu tiên mỗi ngày trong các Trận đấu Ngẫu nhiên bằng một xe thuộc bất cứ cấp nào."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Bạn có thể nhận được gấp đôi XP ở thắng lợi đầu tiên trong ngày với mỗi xe. Tận dụng lợi ích này để nâng cấp xe mình nhanh hơn nữa."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Hệ số Nhân XP"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Tạo một phân đoạn bản vẽ cho bất cứ xe nào có thể nghiên cứu."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Bản vẽ làm giảm lượng XP cần đạt, từ đó tăng tốc nghiên cứu xe. Chúng có thể được thưởng hoặc quy đổi từ bản vẽ phổ dụng và quốc gia."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Bản vẽ Xe"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "20 lần đứng Top 10 người chơi phe mình theo số XP trong các Trận đấu Ngẫu nhiên bằng xe Cấp VII–X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Những nhiệm vụ này giúp kiếm thêm gấp năm lần XP mỗi trận đánh thành công. Cụ thể, bạn cần phải thắng và đứng Top 10 người chơi phe mình theo số XP."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 Nhiệm vụ ×5 XP"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Nghiên cứu và mua bất cứ xe Cấp VIII nào."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Xe Cấp VIII đòi hỏi bạn phải vận dụng mọi kiến thức đã học. Địch sẽ không ngơi nghỉ, dạy cho nhiều bài học đáng nhớ và giá trị."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Xe Cấp VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Dùng XP Tự do để nghiên cứu bất kỳ mô-đun nào."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Nếu không đủ XP Chiến đấu để nghiên cứu mô-đun hoặc xe, bạn có thể vận dụng XP Tự do, vốn có thể dùng cho bất cứ xe nào."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "XP Tự do"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Nạp vài viên đạn khác nhau và bắt đầu một Trận đấu Ngẫu nhiên bằng xe Cấp III–X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Đạn Xuyên Giáp (AP), Nổ Mạnh (HE) và Xuyên Giáp Hỗn hợp Cứng (APCR) được sử dụng cho những tình huống giao tranh khác nhau. Chọn lựa khôn ngoan để có lợi thế!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Đạn dược"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Bán một mô-đun không dùng từ Kho."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Mô-đun, đạn, thiết bị, vật phẩm và các thứ khác không dùng đến được lưu trữ trong Kho. Bạn có thể bán đồ thừa để lấy bạc."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Kho"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Kiếm được 25 000 bạc từ các Trận đấu Ngẫu nhiên bằng xe Cấp III–X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Bạc được dùng để mua đạn, xe mới, sửa xe, v.v... Điều quan trọng là phải biết cách tiết kiệm cũng như tiêu xài khôn khéo."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Bạc"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Đánh ba Trận đấu Ngẫu nhiên bằng xe Cấp III–X với vật phẩm lắp đủ trong mọi ô khả dụng."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Vật phẩm giúp khắc phục thiệt hại nghiêm trọng và cứu chữa kíp lái khi bị thương trong trận. Dùng vật phẩm đúng lúc là kỹ năng cực quan trọng để sống sót."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Vật phẩm"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Đánh ba Trận đấu Ngẫu nhiên bằng xe Cấp III–X có lắp bất cứ thiết bị nào."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Xe có thể được lắp thiết bị nhằm cải thiện một số đặc tính. Cấu hình thiết bị sẽ tùy thuộc vào loại xe và chiến thuật chơi."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Thiết bị"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Trắc địa"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Hoàn tất một kịch bản ở bất cứ bản đồ nào trong Trắc địa"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Đất Lạ"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Hoàn tất bốn kịch bản cơ sở ở một bản đồ trong Trắc địa"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Trinh Sát"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Hoàn tất bốn kịch bản nâng cao ở một bản đồ trong Trắc địa"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "10 Điểm Địa Lý"
