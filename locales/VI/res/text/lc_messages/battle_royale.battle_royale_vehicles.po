msgid "abilities/adaptationHealthRestore"
msgstr "Giáp Thích ứng"

msgid "abilities/adaptationHealthRestoreDescription"
msgstr "Lập tức khôi phục một lượng HP của xe. Trong suốt thời gian tác dụng, mọi sát thương từ đạn và Khả năng Chiến đấu sẽ được tích lại rồi chuyển thành sức kháng cự; sau khi Khả năng kết thúc, nó sẽ hồi phục thêm lượng HP bằng một phần của tổng số thiệt hại đã hứng chịu. HP khôi phục từ kiểu chuyển hóa này cũng áp dụng cho xe đồng đội nội trong bán kính nhỏ."

msgid "abilities/airstrike"
msgstr "Không Kích"

msgid "abilities/airstrikeDescription"
msgstr "Làm choáng xe địch và gây thiệt hại từ bom nổ trong khu vực được chọn."

msgid "abilities/berserk"
msgstr "Berserker"

msgid "abilities/berserkDescription"
msgstr "Tăng đáng kể các đặc tính và độ xuyên cho xe của bạn, nhưng giảm sức kháng cự trong một khoảng thời gian nhất định."

msgid "abilities/brander"
msgstr "Fireball"

msgid "abilities/branderDescription"
msgstr "Triển khai một loại mìn tự hành—đuổi theo kẻ thù gần nhất và gây thiệt hại nội trong bán kính nhỏ khi nổ. Địch có thể phá hủy \"Fireball\" bằng cách bắn hoặc đâm/húc nó. Fireball cũng tạo sát thương đâm/húc lúc đụng mục tiêu."

msgid "abilities/clingBrander"
msgstr "Rô-bốt Chiến trường"

msgid "abilities/clingBranderDescription"
msgstr "Gọi một chiếc tăng vận hành tự động với hệ thống \"Nhận diện Bạn hay Thù\" để đuổi theo và tấn công kẻ địch gần nhất. Chiếc tăng này có thể bị tiêu diệt."

msgid "abilities/corrodingShot"
msgstr "Đạn Axít"

msgid "abilities/corrodingShotDescription"
msgstr "Thêm tính năng ăn mòn cho một viên đạn. Khi sát thương xe địch, đạn gây thêm hiệu ứng ngắn hạn cho nó, làm thiệt hại nhiều hơn sau một khoảng thời gian. Bộ Sửa chữa loại bỏ hiệu ứng tiêu cực này."

msgid "abilities/extremeConcentration"
msgstr "Khóa Mục tiêu"

msgid "abilities/extremeConcentrationDescription"
msgstr "Tạm thời giảm độ phân tán, thời gian ngắm, đồng thời tăng ổn định nòng và tốc độ bắn của súng. Không ảnh hưởng thời gian lúc bắn một viên và nạp viên tiếp theo trong cùng băng, nòng hoặc ổ đạn."

msgid "abilities/fireCircle"
msgstr "Hỏa Xa"

msgid "abilities/fireCircleDescription"
msgstr "Phủ quanh xe địch một hỏa quang gây thiệt hại và giảm độ cơ động của nó nội trong vùng ảnh hưởng của Khả năng."

msgid "abilities/minefield"
msgstr "Bãi mìn"

msgid "abilities/minefieldDescription"
msgstr "Rải một bãi mìn (có công hiệu trong khoảng thời gian nhất định) vào khu vực được chọn. Đối phương đạp phải mìn sẽ bị choáng và hứng chịu thiệt hại từ vụ nổ. Mìn có thể bị phá hủy khi bắn trúng. Nếu đặt ngay dưới xe địch, mìn sẽ KHÔNG nổ."

msgid "abilities/nitro"
msgstr "Tuabin Tăng áp"

msgid "abilities/nitroDescription"
msgstr "Tăng sức mạnh động cơ, tốc độ tối đa và tốc độ xoay của xe trong một thời gian ngắn."

msgid "abilities/recoveryDot"
msgstr "Vùng Phục hồi"

msgid "abilities/recoveryDotDescription"
msgstr "Tạo một khu vực tĩnh, giúp sửa chữa mọi mô-đun bị hư hại, loại bỏ TẤT CẢ hiệu ứng xấu và khôi phục HP. Xe đồng đội thuộc phạm vi ảnh hưởng cũng sẽ hồi lại HP."

msgid "abilities/recoveryKit"
msgstr "Cứu hộ"

msgid "abilities/recoveryKitDescription"
msgstr "Khôi phục sức kháng cự cho xe bị hư hại."

msgid "abilities/recoveryZone"
msgstr "Khu vực Cứu hộ"

msgid "abilities/recoveryZoneDescription"
msgstr "Tạo ra một phạm vi quanh xe của bạn. Trong khu vực này, cả xe người chơi lẫn thành viên Trung đội sẽ phục hồi một lượng sức kháng cự nhất định mỗi giây."

msgid "abilities/repairKit"
msgstr "Bộ Sửa chữa"

msgid "abilities/repairKitDescription"
msgstr "Sửa mô-đun và loại bỏ hiệu ứng xấu."

msgid "abilities/rustCloud"
msgstr "Sương Axít"

msgid "abilities/rustCloudDescription"
msgstr "Tăng thêm độ ẩn giấu cho mọi xe thuộc vùng tác động, đồng thời sát thương TẤT CẢ các xe nằm trong tầm ảnh hưởng. Không làm gián đoạn quá trình nhặt hàng hay hoàn toàn phá hủy xe, để lại ít nhất 1 HP."

msgid "abilities/shotPassion"
msgstr "Sốt Nhiệt"

msgid "abilities/shotPassionDescription"
msgstr "Do giá trị ngắm và độ ổn định nòng giảm đi trong một khoảng thời gian nhất định, mỗi phát bắn xuyên giáp hay Phóng Điện trúng sẽ làm tăng sát thương dùng đạn gây ra cho xe địch. Sát thương có thể được tăng tối đa năm lần. Những phát không gây thiệt hại và trượt sẽ trả giá trị sát thương về lại con số ban đầu."

msgid "abilities/thunderStrike"
msgstr "Phóng Điện"

msgid "abilities/thunderStrikeDescription"
msgstr "Tạo một khu vực có nhiều phát điện giật với tần suất cao. Mỗi lần xẹt gây thiệt hại và tạm thời giảm độ cơ động của xe nội trong vùng ảnh hưởng. Có độ trễ giữa lúc kích hoạt khả năng và phát xẹt điện đầu tiên. Bộ Sửa chữa loại bỏ hiệu ứng tiêu cực."

msgid "abilities/trap"
msgstr "Bẫy"

msgid "abilities/trapDescription"
msgstr "Tạo ra một khu vực làm giảm độ linh hoạt của xe địch."

msgid "tanks/britain/description"
msgstr "Các kỹ sư Anh tiếp tục phô diễn khả năng chế tạo những chiếc xe hoàn hảo, hấp dẫn chỉ huy giàu kinh nghiệm và khiến kẻ thù khiếp sợ. \"Thợ săn\" này cũng không ngoại lệ. Chất thép Vương quốc Anh huyền thoại của nó luôn sẵn sàng chứng tỏ uy lực trên chiến trường."

msgid "tanks/britain/title"
msgstr "Harbinger Mk. IV"

msgid "tanks/china/description"
msgstr "Trung Quốc có một lực lượng đặc vụ tinh nhuệ giúp bắt kịp những giải pháp tối tân nhất trong ngành chế tạo tăng thiết giáp. Và đây là cơ hội không thể đẹp hơn để họ thử lửa \"hàng nóng\" mới dưới điều kiện khắc nghiệt của Săn Thiết giáp."

msgid "tanks/china/title"
msgstr "Bái Láng"

msgid "tanks/france/description"
msgstr "Nhẹ, hài hòa và uyển chuyển là ba điểm cốt lõi trong ngành công nghiệp chế tạo tăng Pháp. Chiếc xe này không hề vay mượn nền tảng thiết kế ngoại bang hay công nghệ thu được từ hoạt động tình báo. Tất cả đến từ sự sáng tạo, ý tưởng độc đáo và những giải pháp hiệu quả."

msgid "tanks/france/title"
msgstr "Arlequin"

msgid "tanks/germany/description"
msgstr "Người Đức là những chuyên gia luyện kim và lắp ráp chất lượng cao. Chiếc xe này là con sói đơn độc hoàn hảo—độc lập, toàn diện và dễ dàng thích nghi với mọi tình huống chiến đấu để sinh tồn."

msgid "tanks/germany/title"
msgstr "Walküre"

msgid "tanks/poland/description"
msgstr "Kỹ sư Ba Lan biết rằng tăng cường một trong các điểm mạnh của xe sẽ làm giảm đặc tính khác. Đó là lý do họ đề ra giải pháp vũ khí và khả năng chiến đấu để ngăn không cho địch tìm điểm yếu. Thời gian sẽ đem đến kết luận chính xác nhất về phát kiến này."

msgid "tanks/poland/title"
msgstr "Huragan"

msgid "tanks/sweden/description"
msgstr "Người Thụy chưa bao giờ xem nhẹ xu hướng chế tạo tăng mới, và Săn Thiết giáp là nơi thử nghiệm tuyệt vời cho các kỹ sư của họ. Chiếc xe này kết hợp những ý tưởng tài tình cũng như mạo hiểm nhất. Nó có thể gây ra và chống chịu thiệt hại nặng nề, mọi thứ trông khả quan đấy chứ."

msgid "tanks/sweden/title"
msgstr "Beowulf"

msgid "tanks/usa/description"
msgstr "Chiếc xe này là sự cân bằng hoàn hảo giữa hiện đại và kinh điển. Những công nghệ đứng vững theo thời gian kết hợp các bước tiến mới nhất là nền tảng của nó, đem lại trải nghiệm tuyệt vời cho lái xe. Đương nhiên, bạn phải không bị dị ứng với kim loại gỉ sét."

msgid "tanks/usa/title"
msgstr "Raven"

msgid "tanks/ussr/description"
msgstr "Chiếc tăng này—được lắp ráp bằng các bộ phận và linh kiện phế phẩm từ nhiều nhà máy chế tạo chiến xa khác nhau—là đối trọng đáng gờm đối với bất kỳ xe địch nào. Một quái vật thực sự, sinh ra ngay trên chiến trường bất cần bản vẽ hay tài liệu kỹ thuật gì cho phức tạp."

msgid "tanks/ussr/title"
msgstr "Varyag"
