msgid "entryPoint/tooltip/description"
msgstr "Đây là hộp đặc biệt chứa đồ mới và độc, gồm cả xe Premium, kiểu mẫu 2D, vân vân. Bạn có thể mua chúng ở Cửa hàng trong-game."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Hiện không thể mở hay mua Kho báu Blazing vì lý do kỹ thuật. Chúng tôi mong được thông cảm về vấn đề nhất thời này."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kho báu Blazing Tạm thời Không khả dụng"

