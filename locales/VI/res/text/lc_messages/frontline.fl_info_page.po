msgid "reserveCategories/config/footerText"
msgstr "Trong kịch bản {{@ colorLegacy 'FFE4C0'}}Định Mệnh{{/}}, thứ tự mở khóa Quân Dự bị Chiến đấu không phụ thuộc vào loại xe."

msgid "reserveCategories/config/header"
msgstr "Cấu hình Quân Dự bị theo Loại Xe"

msgid "reserveCategories/config/text"
msgstr "Trong kịch bản {{@ colorLegacy 'FFE4C0'}}Chế độ Cơ bản{{/}} và {{@ colorLegacy 'FFE4C0'}}Hậu cần Chiến dịch{{/}}, cả ba ô Quân Dự bị Chiến đấu khả dụng cho tất cả các phương tiện. Tuy nhiên, thứ tự mở khóa chúng sẽ phụ thuộc vào loại xe."

