msgid "reserveCategories/levelUpNote"
msgstr "* Cải thiện đến mức này chỉ khả dụng cho Quân Dự bị Chiến đấu {{@ colorLegacy 'FFE4C0'}}được mua{{/}} trong kịch bản {{@ colorLegacy 'FFE4C0'}}Định Mệnh{{/}}."

msgid "reserveCategories/levels/header"
msgstr "Cách Mở khóa Ô và Cải thiện Quân Dự bị Chiến đấu"

msgid "reserveCategories/levels/text"
msgstr "Theo mặc định, một Quân Dự bị Chiến đấu khả dụng cho bạn. Số còn lại được mở khóa khi đạt bậc Trung sỹ và Trung úy. Cả ba Quân Dự bị sẽ được cải thiện lúc đạt bậc Đại úy và Thiếu tá."

msgid "reserveCategories/progression/tableCell"
msgstr "Cấp {{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} hoặc {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}}"

