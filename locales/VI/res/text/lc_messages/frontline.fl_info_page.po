msgid "about/header"
msgstr "Chi tiết Giấy phép Quân sự"

msgid "about/position/header"
msgstr "Phân phối Điểm Giấy phép Quân sự"

msgid "about/position/text"
msgstr "Sau mỗi trận, bạn sẽ nhận được một lượng Điểm Giấy phép Quân sự tương ứng với vị thứ của mình. Ngoài ra, sẽ có Điểm GPQS thưởng thêm nếu tăng Cấp Chiến tuyến."

msgid "about/scores/header"
msgstr "Điểm Giấy phép Quân sự"

msgid "about/scores/text"
msgstr "Một đơn vị tiền tệ Giấy phép Quân sự đặc biệt, có thể kiếm được từ chế độ Trận đấu Ngẫu nhiên và Chiến tuyến. Điểm GPQS là phần thưởng khi đạt đến các Cấp Chiến tuyến cũng như vị thứ của bạn trong bảng kết quả trận đánh. Xe Chiến tuyến không có giới hạn số Điểm có thể kiếm được."

msgid "about/scoresTable/loseHeader"
msgstr "Thất bại"

msgid "about/scoresTable/topCell"
msgstr "Top {{top}} theo XP"

msgid "about/scoresTable/winHeader"
msgstr "Thắng"

msgid "about/text"
msgstr "Giấy phép Quân sự (GPQS) là sự kiện dài kỳ nơi người chơi thăng tiến qua các Giai đoạn bằng cách kiếm Điểm GPQS. Hoàn tất mỗi Giai đoạn đem về nhiều phần thưởng giá trị. Khi hoàn thành một số Giai đoạn nhất định, bạn có thể thu về Giơ-tông Giấy phép Quân sự—một tiền tệ đặc biệt được dùng để mua các xe độc đáo cùng những hàng hóa đáng giá khác trong mục tương ứng ở Cửa hàng."

msgid "addons/cellRent/header"
msgstr "Xe Thuê"

msgid "addons/cellRent/text_10"
msgstr "Vài xe Cấp {{vehiclesLevel}} khác nhau sẽ thuê được bằng cách dùng bạc. Thành viên kíp lái từ xe cùng loại và quốc gia có thể chuyển biên chế lẫn nhau mà không bị phạt hay phải tái đào tạo."

msgid "addons/cellRent/text_9"
msgstr "Vài xe Cấp {{@ colorLegacy 'FFE4C0'}}{{vehiclesLevel}}{{/}} khác nhau sẽ thuê được bằng cách dùng bạc. Thành viên kíp lái từ xe cùng loại và quốc gia có thể chuyển biên chế lẫn nhau mà không bị phạt hay phải tái đào tạo."

msgid "addons/cellSpectator/header"
msgstr "Chế độ Quan sát"

msgid "addons/cellSpectator/text"
msgstr "Trong lúc chờ tái xuất, bạn có thể tận dụng chế độ Quan sát để nắm bắt tình hình chiến trận và lên kế hoạch cho chiến thuật của mình."

msgid "addons/cellTime/header"
msgstr "Bù Giờ"

msgid "addons/cellTime/text"
msgstr "Nếu thời gian kết thúc khi căn cứ đang bị chiếm, phe của bạn sẽ được bù giờ. Nếu bên phòng thủ phá hỏng quá trình chiếm căn cứ, thời gian bổ sung sẽ bằng không."

msgid "addons/header"
msgstr "Thông tin thêm"

msgid "levelUp/sectionHeader"
msgstr "Xe Cấp {{level}}"

msgid "levelUp/text"
msgstr "Như trước, bạn chỉ có thể dùng xe Cấp {{vehiclesLevelFrom}} để tham chiến lúc đầu, nhưng xe Cấp {{vehiclesLevelTo}} được chuẩn bị sẵn trong Ga-ra. Sau khi bất kỳ căn cứ nào ở tuyến hai bị chiếm (D, E, F), cả hai phe sẽ có khả năng triển khai xe Cấp {{vehiclesLevelTo}}."

msgid "main/cellDuration/header"
msgstr "Thời gian"

msgid "main/cellDuration/text"
msgstr "Chiến tuyến sẽ kéo dài {{@ colorLegacy 'FFE4C0'}}{{days}}{{/}}. Hôm bắt đầu tiếp theo sẽ được thông báo sau."

msgid "main/cellFrontline/header"
msgstr "Chiến tuyến"

msgid "main/cellFrontline/text_8"
msgstr "Chiến trận 30v30 quy mô lớn bằng xe Cấp {{vehiclesLevel}} trên bản đồ {{@ colorLegacy 'FFE4C0'}}Normandy, Kraftwerk{{/}} và {{@ colorLegacy 'FFE4C0'}}Fata Morgana{{/}}. Phe tấn công phải phá hủy 3 trên 5 lô cốt đại pháo, phe phòng thủ phải bảo vệ chúng."

msgid "main/cellFrontline/text_9"
msgstr "Chiến trận 30v30 quy mô lớn bằng xe Cấp {{vehiclesLevelFrom}}–{{vehiclesLevelTo}} trên bản đồ {{@ colorLegacy 'FFE4C0'}}Normandy, Kraftwerk{{/}} và {{@ colorLegacy 'FFE4C0'}}Fata Morgana{{/}}. Phe tấn công phải phá hủy 3 trên 5 lô cốt đại pháo, phe phòng thủ phải bảo vệ chúng."

msgid "main/cellLevel9/header"
msgstr "Xe Cấp {{vehiclesLevel}}"

msgid "main/cellLevel9/text"
msgstr "Sau khi một căn cứ thuộc tuyến hai (D, E hay F) bị chiếm, bạn sẽ có thể lôi xe Cấp {{vehiclesLevel}} vào."

msgid "main/cellLevels/header"
msgstr "Xe Cấp {{vehiclesLevel}}"

msgid "main/cellLevels/text_8"
msgstr "Chỉ xe Cấp {{@ colorLegacy 'FFE4C0'}}{{vehiclesLevel}}{{/}} có thể sử dụng trong chế độ."

msgid "main/cellLevels/text_9"
msgstr "Chỉ xe Cấp {{vehiclesLevel}} mới có thể tham chiến."

msgid "main/cellPass/header"
msgstr "Giấy phép Quân sự"

msgid "main/cellPass/text"
msgstr "Chiến tuyến là một cơ hội tuyệt vời để kiếm Điểm Giấy phép Quân sự từ các trận đánh và đạt Cấp Chiến tuyến mới."

msgid "main/cellReserves/header"
msgstr "Loại Quân Dự bị chiến đấu"

msgid "main/cellReserves/text"
msgstr "Quân Dự bị Chiến đấu chia thành ba loại, mỗi loại gắn liền với một ô cụ thể. Thứ tự mở khóa và cải thiện chúng sẽ tùy thuộc từng loại xe."

msgid "main/cellScenarios/header"
msgstr "Kịch bản"

msgid "main/cellScenarios/text"
msgstr "Các trận Chiến tuyến diễn ra theo một trong những kịch bản sau: {{@ colorLegacy 'FFE4C0'}}Chế độ Cơ bản{{/}}, {{@ colorLegacy 'FFE4C0'}}Hậu cần Chiến dịch{{/}} hoặc {{@ colorLegacy 'FFE4C0'}}Định Mệnh{{/}}. Thông tin về kịch bản hiện hành được hiển thị ở màn hình tải, trong quá trình đếm ngược trước khi vào trận, hoặc lúc bấm phím Tab."

msgid "main/sectionHeader"
msgstr "Thông tin Chung"

msgid "page/backBtn"
msgstr "QUAY LẠI"

msgid "page/headerUpper"
msgstr "CHIẾN TUYẾN"

msgid "percentValue"
msgstr "{{value}}%"

msgid "plusPercentValue"
msgstr "+{{value}}%"

msgid "plusValue"
msgstr "+{{value}}"

msgid "progression/levelsSection/experienceText"
msgstr "Tùy theo cấp bậc đạt được, bạn sẽ nhận XP Chiến tuyến và XP Chiến đấu. XP Chiến tuyến dùng để tăng Cấp Chiến tuyến, gồm tổng cộng {{@ colorLegacy 'FFE4C0'}}20 Mức{{/}}."

msgid "progression/levelsSection/header"
msgstr "Cấp Chiến tuyến"

msgid "progression/levelsSection/rewardsText"
msgstr "{{@ colorLegacy 'FFE4C0'}}Cấp Chiến tuyến{{/}} đem lại phần thưởng gồm Điểm Giấy phép Quân sự, Điểm Quân Dự bị Chiến đấu, trái phiếu, ứng dụng kĩ thuật, Bằng Đào tạo, Bằng cố vấn và Tài liệu Kíp lái."

msgid "progression/levelsSection/rewardsTextNoBP"
msgstr "{{@ colorLegacy 'FFE4C0'}}Cấp Chiến tuyến{{/}} đem lại phần thưởng gồm Điểm Quân Dự bị Chiến đấu, trái phiếu, ứng dụng kĩ thuật, Bằng Đào tạo và Tài liệu Kíp lái."

msgid "progression/ranksSection/experience"
msgstr "{{@ colorLegacy 'FFE4C0'}}Cấp bậc{{/}} không những phản ánh hiệu quả giao tranh của bạn ở một trận cụ thể mà còn đem lại lợi ích XP Chiến đấu. Khoản thưởng này áp dụng trên tổng XP gốc kiếm được từ mọi xe đã dùng tham chiến. Khi bạn hoặc đồng đội đạt bậc Đại tướng, toàn bộ phe nhận được khoản tăng hiệu suất kíp lái (mức chuyên môn chính) từ {{@ colorLegacy 'FFE4C0'}}1.5%{{/}} đến {{@ colorLegacy 'FFE4C0'}}15%{{/}}."

msgid "progression/ranksSection/header"
msgstr "Cấp bậc"

msgid "progression/ranksSection/text"
msgstr "Chế độ này đặc trưng với hệ thống sáu-cấp-bậc mà người chơi có thể thăng tiến từ Binh Nhì đến Đại Tướng. Bạn sẽ được thăng chức khi chiến đấu hiệu quả trong trận (chiếm hoặc thủ căn cứ; phá hủy mục tiêu chính) và kinh nghiệm thu về. Tính tổng XP từ khắp mọi xe đã dùng tham chiến."

