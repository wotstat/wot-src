msgid "#PluralForms"
msgstr "nplurals=1; plural=0;"

msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s Cấp&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Kiểm soát các ăng-ten. Duy trì mạng lưới. Bảo đảm đường truyền."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Hiệu suất máy tính của bạn không đủ mạnh cho chế độ này. Bạn có thể gặp vấn đề với đồ họa và chuyển động xe. Client trò chơi cũng có khả năng gặp sự cố."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Hiệu suất Thấp"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Hiệu suất thấp"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Chế độ này yêu cầu hiệu suất máy tính cao. Bạn sẽ gặp vấn đề với quá trình tải bản đồ, đồ họa và chuyển động xe. Nếu hiệu suất không đủ mạnh, hãy thử giảm chất lượng đồ họa trong mục Thiết lập."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Hiệu suất bị Giảm"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Hiệu suất Kém hơn"
