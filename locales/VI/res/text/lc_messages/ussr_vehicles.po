msgid "Churchill_LL_descr"
msgstr "Là xe tăng của Anh Quốc cung cấp cho Liên Xô theo Thỏa thuận Thuê mượn (\"Lend-Lease\"). Liên Xô đã nhận tổng cộng 301 xe, nhưng một số bị mất trên biển trong quá trình vận chuyển đến Murmansk."

msgid "Churchill_LL_long_special"
