msgid "T44_122"
msgstr "T-44-122"

msgid "T44_122_CN"
msgstr "T-44-122A"

msgid "T44_122_CN_descr"
msgstr "Quá trình phát triển bắt đầu từ tháng 02/1944 dựa trên T-44. So với xe tiền thân, nó có thân, tháp pháo, giáp và vũ khí khác biệt. Nòng 122 mm D-25-44T dù đầy uy lực nhưng làm giảm cơ số đạn và phức tạp hóa quá trình nạp đạn bắn nhanh. Hệ thống nạp đạn riêng bị cho là không cần thiết do tốc độ bắn thấp, khiến T-44-122 sau này bị tái vũ trang với khẩu 85 mm."

msgid "T44_122_descr"
msgstr "Quá trình phát triển bắt đầu từ tháng 02/1944 dựa trên T-44. So với xe tiền thân, T-44-122 có thân, tháp pháo, giáp và vũ khí khác biệt. Nòng 122 mm D-25-44T dù đầy uy lực nhưng làm giảm cơ số đạn và phức tạp hóa quá trình nạp đạn bắn nhanh. Hệ thống nạp đạn riêng bị cho là không cần thiết do tốc độ bắn thấp, khiến T-44-122 sau này bị tái vũ trang với khẩu 85 mm."

msgid "T44_85"
msgstr "T-44-85"

msgid "T44_85M"
msgstr "T-44 lightweight"

msgid "T44_85M_descr"
msgstr "Bắt đầu phát triển từ năm 1943, bản thiết kế này đã được cải thiện sau khi chạy thử nghiệm nguyên mẫu. Phiên bản T-44A chuẩn được chế tạo vào tháng 08/1944 và tiếp tục trải qua nhiều cuộc kiểm chứng. Dù vậy, T-44A chưa bao giờ đến được giai đoạn sản xuất hàng loạt, không giống như mẫu thử nghiệm tiếp theo của nó."

msgid "T44_85M_short"
msgstr "T-44 ltwt."

msgid "T44_85_descr"
msgstr "Công tác phát triển chiếc xe này bắt đầu vào năm 1943. Là nguyên mẫu thứ hai của T-44, T-44-85 được chế tạo tại Cục Quân nhu Nhân dân thuộc Nhà máy Công nghiệp Xe tăng số 183 vào tháng 01/1944 và trải qua nhiều cuộc thực nghiệm kéo dài từ ngày 15/06 đến hết 17/07/1944. Dù vậy, nó chưa bao giờ đi vào sản xuất hàng loạt."

msgid "T62A"
msgstr "T-62A"

msgid "T62A_descr"
msgstr "Quá trình phát triển chiếc tăng hạng trung đầu tiên sau Thế Chiến của Liên Xô bắt đầu vào năm 1951. Năm 1961, xe tăng T-62 với súng nòng trơn đã được triển khai. Cùng lúc đó, một biến thể khác, T-62A, sử dụng nòng rãnh xoắn, cũng được chấp thuận. Tháng 03/1962, quy trình sản xuất hàng loạt T-62A bị ngừng lại. T-62 được chế tạo quy mô lớn từ năm 1961 đến hết 1975, với tổng cộng 20 000 xe đã xuất xưởng. Những biến thể sau này của nó vẫn còn phục vụ trong biên chế quân đội."

msgid "T62A_fallout"
msgstr "(R) T-62A"

msgid "T62A_fallout_descr"
msgstr "Quá trình phát triển chiếc tăng hạng trung đầu tiên sau Thế Chiến của Liên Xô bắt đầu vào năm 1951. Năm 1961, xe tăng T-62 với súng nòng trơn đã được triển khai. Cùng lúc đó, một biến thể khác, T-62A, sử dụng nòng rãnh xoắn, cũng được chấp thuận. Tháng 03/1962, quy trình sản xuất hàng loạt T-62A bị ngừng lại. T-62 được chế tạo quy mô lớn từ năm 1961 đến hết 1975, với tổng cộng 20 000 xe đã xuất xưởng. Những biến thể sau này của nó vẫn còn phục vụ trong biên chế quân đội."

msgid "T62A_fallout_short"
msgstr "(R) T-62A"

msgid "T62A_short"
msgstr "T-62A"

msgid "T80"
