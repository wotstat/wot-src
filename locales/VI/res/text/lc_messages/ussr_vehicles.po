msgid "T-26_descr"
msgstr "Một tăng hạng nhẹ được phát triển dựa trên nền tảng tăng Vickers Mk. E. của Anh vào đầu những năm 1930. Thiết kế T-26 nhằm mục đích hỗ trợ bộ binh và có khá nhiều biến thể. Nó đồng thời cũng là nền tảng của hàng loạt phương tiện và pháo tự hành đặc biệt, vốn không được sử dụng rộng rãi. Từ năm 1931 đến 1941, có 9686 chiếc T-26 thuộc nhiều biến thể và cấu hình khác nhau đã được sản xuất."

msgid "T-34_MapsTraining_Player_MT_1"
msgstr "T-34 (tr.)"

msgid "T-34_descr_MapsTraining_Player_MT_1"
msgstr "Huyền thoại của các lực lượng thiết giáp Xô-viết và là loại tăng được sản xuất nhiều nhất Thế Chiến II, với tổng số 33,805 chiếc đã xuất xưởng. Ba phiên bản của mẫu tăng này đã được chế tạo lắp ráp tại nhiều nhà máy Xô-viết từ năm 1940 đến 1944."

msgid "T-34_mod_1942_MapsTraining_Player_MT_1"
