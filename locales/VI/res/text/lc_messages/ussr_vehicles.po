msgid "T80_descr"
msgstr "Được phát triển vào mùa hè và mùa thu năm 1942 tại Cục Xây dựng thuộc Nhà máy Ô tô Gorky dưới sự giám sát của N. A. Astrov. T-80 bắt đầu phục vụ trong biên chế quân đội từ tháng 12/1942. Có tổng cộng 85 chiếc đã được sản xuất hàng loạt."

