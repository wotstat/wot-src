msgstr "R-113C"

msgid "R_123B"
msgstr "R-123B"

msgid "R_123C"
msgstr "R-123C"

msgid "R_123KR"
msgstr "R-123KR"

msgid "R_123V"
msgstr "R-123V"

msgid "R_123_1476"
msgstr "R-123 (1476)"

msgid "SCR_209"
msgstr "SCR 209"

msgid "SCR_508I"
msgstr "SCR 508I"

msgid "SU-18"
msgstr "SU-18"

msgid "SU-18Bis"
msgstr "SU-18 Bis"

msgid "SU-18_descr"
msgstr "Pháo tự hành dựa trên nền tảng khung gầm của MS-1. Mẫu xe này chỉ tồn tại trên bản vẽ và không có nguyên mẫu nào được phát triển. Chưa bao giờ đi vào sản xuất hàng loạt."

msgid "SU-26"
msgstr "SU-26"

msgid "SU-26_descr"
msgstr "Pháo tự hành dựa trên nền tảng xe T-26 được phát triển tại Leningrad trong vây hãm mùa hè năm 1941. Quá trình sản xuất được triển khai tại Nhà máy Nâng và Truyền tải Thiết Bị Kirov. Khoảng 12 khung sườn được trang bị súng nòng 76,2 mm (giả thuyết dựa trên phiên bản năm 1927 dùng súng hỗ trợ bộ binh nòng 76,2 mm). Xe phục vụ trong hàng ngũ các lữ đoàn thiết giáp Hồng Quân chiến đấu trên Mặt trận Leningrad cho đến năm 1944."

msgid "SU-5"
msgstr "SU-5"

msgid "SU-5_descr"
msgstr "Chiếc xe này được phát triển bởi Cục Thiết kế tại Nhà máy Chế tạo Cơ khí Thử nghiệm Kirov số 185 (ở Leningrad) vào đầu những năm 1930. Dự án dựa trên tăng hạng nhẹ T-26, vốn được thiết kế nhằm hỗ trợ các đơn vị cơ giới. Có ba nguyên mẫu với ba loại nòng súng là 76 mm, 122 mm, và 152 mm được chế tạo nhưng chỉ phiên bản sứ dụng súng 122 mm đi vào sản xuất hàng loạt. Tổng cộng có 30 chiếc được cung cấp cho quân đội. Dự án bị dừng lại vào năm 1937."

msgid "SU-5bis"
msgstr "SU-5 Bis"

msgid "SU-85A"
msgstr "SU-85B"

msgid "SU-85A1"
msgstr "SU-85A"

msgid "SU100Y"
msgstr "SU-100Y"

msgid "SU100Y_descr"
msgstr "Được phát triển dựa trên nền tảng tăng hạng nặng T-100. Mục đích của SU-100Y là vô hiệu hóa các ụ phòng thủ kiên cố và tiêu diệt xe địch. Do vậy, nó được trang bị pháo hải quân B-13-S2 cải tiến. Nguyên mẫu duy nhất được chế tạo vào tháng 03/1940. SU-100Y chưa từng đi vào giai đoạn sản xuất hàng loạt."

msgid "SU100Y_long_special"
msgstr "Thực tế, chiếc pháo chống tăng không khác gì một bệ đỡ dành riêng cho khẩu pháo khủng khiếp so với cấp của nó. Dù vậy, ưu thế này được cân bằng bởi giáp kém, cơ động không cao và ẩn giấu tồi. Dù vậy, thông số nòng pháo đủ khiến bạn bỏ qua hết phần còn lại."

msgid "SU100Y_short_special"
msgstr "Sát thương mỗi phát bắn và độ xuyên khủng khiếp, sức kháng cự lớn"

msgid "SU122_44"
msgstr "SU-122-44"

msgid "SU122_44_descr"
msgstr "Được phát triển từ tháng 7 năm 1944 bởi Cục Thiết kế Uralmash. Những chiếc xe dựa theo chiếc T-44 và có thông số kỹ thuật cơ bản với các vị trí trước của khoang chiến đấu. Vào tháng 10, Cục Quân Nhu ngành công nghiệp tăng gọi dự án là SU-122-44. Trong tháng 12, dự án đã được thiết kế hoàn thiện. Tuy nhiên, SI-100-M-2 với các vị trí sau của khoang chiến đấu được ưa thích hơn."

msgid "SU122_44_long_special"
msgstr "Một pháo chống tăng cơ động, được bảo vệ tốt ở mặt trước, súng bắn nhanh và sát thương khá cao mỗi phát bắn. Độ chính xác, thời gian ngắm chỉ ở mức trung bình, tầm nhìn kém nhưng giáp trước nghiêng hiệu quả khiến SU-122-44 phù hợp đánh xung kích hơn là phục kích."

msgid "SU122_44_short"
msgstr "SU-122-44"

msgid "SU122_44_short_special"
msgstr "Sát thương lớn mỗi phát, tốc độ bắn nhanh, có thể đảm đương nhiều vai trò trên trận địa"

msgid "SU122_54"
msgstr "SU-122-54"

msgid "SU122_54_descr"
msgstr "Quá trình phát triển bắt đầu từ mùa hè năm 1948. T-54 được sử dụng làm nền tảng cho pháo chống tăng này. SU-122-54 đi vào phục vụ trong biên chế quân đội từ tháng 03/1954. Quá trình sản xuất hàng loạt khởi động năm 1955, với tổng cộng 100 chiếc đã được chế tạo. Cấu hình chính của chiếc xe này rất giống với các pháo xung kích thời Thế Chiến II."

msgid "SU122_54_short"
msgstr "SU-122-54"

msgid "SU14_1"
msgstr "SU-14-1"

msgid "SU14_1_descr"
msgstr "Được phát triển dựa trên mẫu SU-14 và thử nghiệm năm 1936, song dự án bị huỷ bỏ vào năm 1937. Mẫu thử nghiệm được lưu giữ ở Kubinka, và được sử dụng trong trận chiến bảo vệ thành phố Mát-cơ-va năm 1941."

msgid "SU76I"
msgstr "SU-76I"

msgid "SU76I_descr"
msgstr "Nguyên mẫu đầu tiên của SU-76I (\"I\" viết tắt cho từ \"ngoại quốc\" trong tiếng Nga) được chế tạo vào tháng 3/1943 trên nền tảng 2 xe Đức bị bắt giữ StuG III và Pz.Kpfw III , và sở hữu súng Xô Viết F-34 nòng 76 mm. Tổng cộng 200 chiếc đã được chế tạo. Mẫu xe SU-76I tham gia nhiều trận đánh đến mùa hè năm 1944 và sau đó được dùng vào mục đích huấn luyện cho đến hết cuộc chiến. SU-85I dự kiến là giai đoạn tiếp theo trong quá trình phát triển xe."

msgid "SU_85I"
msgstr "SU-85I"

msgid "SU_85I_descr"
msgstr "Cùng với sự ra đời của SU-76I, có khá nhiều thử nghiệm lắp súng 85-mm lên các xe tăng Pz.Kpfw. III bắt giữ được từ quân Đức. Tuy nhiên, loại xe này chưa bao giờ đi vào sản xuất hàng loạt hay phục vụ trong biên chế."

msgid "Su-26A"
msgstr "SU-26"

msgid "Su-26B"
msgstr "SU-26 Bis"

msgid "T-127"
msgstr "T-127"

msgid "T-127_descr"
msgstr "Được phát triển cùng T-126 tại Nhà máy Số 174 trong mùa hè năm 1940. Công tác nghiên cứu chế tạo T-127 đã bị tạm dừng ngay trong giai đoạn thiết kế sơ bộ và sau đó bị ngừng lại do các vấn đề với động cơ diesel V-3."

msgid "T-127_long_special"
msgstr "Một xe tăng nhỏ gọn, cứng cáp, bảo vệ toàn diện so với cấp của nó, có súng bắn nhanh, cho phép sửa chữa nhiều sai lầm trên chiến trường, đủ khả năng đảm nhận hầu như mọi vai trò trên trận địa."

msgid "T-127_short_special"
msgstr "Giáp toàn diện, có thể đảm đương nhiều vai trò trên trận địa"

msgid "T-18"
