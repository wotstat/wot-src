msgid "detailsHelp/default/title"
msgstr "Trợ giúp"

msgid "detailsHelp/devMaps/headerTitle"
msgstr "Đặc điểm Bản đồ"

msgid "detailsHelp/devMaps/markers/description"
msgstr "Vị trí sự kiện ngẫu nhiên sẽ được đánh dấu bằng\nkhói trên chính địa hình và chỉ báo ở bản đồ con.\nBạn có thể tắt bỏ những bản đồ này trong thiết lập trò chơi ở tab Game."

msgid "detailsHelp/devMaps/title"
msgstr "Bản đồ Có Sự kiện Ngẫu nhiên"

msgid "detailsHelp/devMaps/zone/description"
msgstr "Xe của bạn có thể bị phá hủy khi nằm trong khu vực sự kiện ngẫu nhiên (ví dụ, máy bay rơi).\nNhững bản đồ như thế tắt bỏ được trong thiết lập trò chơi ở tab Game."

msgid "detailsHelp/dualGun/quick_fire"
msgstr "Các xe với hệ thống khai hỏa này sẽ đổi nòng khi bắn. Súng vừa khai hỏa sẽ tự động tái nạp đạn, trong khi nòng thứ hai (đã nạp và sẵn sàng) phải chờ một chút (trước khi có thể bắn)."

msgid "detailsHelp/dualGun/quick_fire/title"
msgstr "Bắn Nối tiếp"

msgid "detailsHelp/dualGun/volley_fire"
msgstr "Các xe với hệ thống súng đôi sở hữu cơ chế bắn loạt đặc biệt, được kích hoạt bằng cách nhấn giữ phím gán tương ứng. Khi khai hỏa, hai viên đạn sẽ bay ra song song với nhau. Nút điều khiển cơ chế này có thể thay đổi trong mục Thiết lập."

msgid "detailsHelp/dualGun/volley_fire/title"
msgstr "Bắn Song song"

msgid "detailsHelp/engineMode/engineModePage1"
msgstr "Bạn có thể đổi chế độ động cơ cho phù hợp với tình huống chiến thuật cụ thể. Để thực hiện, xe cần phải dừng hẳn và sẽ tốn một khoảng thời gian nhất định, bất chấp tình trạng của mô-đun."

msgid "detailsHelp/engineMode/engineModePage1/title"
msgstr "Cơ chế Chuyển động Mới"

msgid "detailsHelp/engineMode/engineModePage2"
msgstr "Nitro tăng áp đẩy mạnh công suất động cơ, tốc độ tiến và lùi. Tuy nhiên, chế độ này khiến xe của bạn dễ bị phát hiện hơn, giảm độ ổn định của súng và tăng thời gian ngắm."

msgid "detailsHelp/engineMode/engineModePage2/title"
msgstr "Ưu điểm và Nhược điểm"

msgid "detailsHelp/mapbox/headerTitle"
msgstr "Đặc điểm Bản đồ"

msgid "detailsHelp/mapbox/localWeather/description"
msgstr "Các xe nằm trong khu vực thời tiết cục bộ không thể phát hiện các xe bên ngoài và ngược lại; đồng thời, việc trao đổi thông tin về vị trí đối phương ra ngoài khu vực cũng bị gián đoạn. Lửa gây thiệt hại cho mọi xe."

msgid "detailsHelp/mapbox/localWeather/title"
msgstr "Thời tiết cục bộ"

msgid "detailsHelp/mechanics/accuracyStacks/page1/description"
msgstr "Đứng yên hoặc chạy chậm dưới một tốc độ nhất định giúp xe của bạn hiệu chỉnh Device tính đạn đạo Analog, tích lũy mức chính xác.\nMỗi mức làm tăng độ chuẩn cho phát bắn tiếp theo và sẽ mất đi lúc khai hỏa."

msgid "detailsHelp/mechanics/accuracyStacks/page1/title"
msgstr "Device tính đạn đạo Analog"

msgid "detailsHelp/mechanics/accuracyStacks/page2/description"
msgstr "Ở mức hiệu chỉnh full chuẩn, súng xe đạt mức chính xác cao nhất, được ổn định tốt, phân tán ít hơn khi di chuyển hoặc xoay tháp pháo/thân.\nHiệu ứng mất đi lúc khai hỏa."

msgid "detailsHelp/mechanics/accuracyStacks/page2/title"
msgstr "Full chuẩn"

msgid "detailsHelp/mechanics/autoShootGun/page1/description"
msgstr "Một loại vũ khí tự động với tốc độ bắn cực cao. Hiệu quả khai hỏa được thể hiện bằng chỉ báo trên tâm ngắm."

msgid "detailsHelp/mechanics/autoShootGun/page1/title"
msgstr "Autogun"

msgid "detailsHelp/mechanics/autoShootGun_overheatGun/page1/description"
msgstr "Súng này có thể bắn liên thanh mà không phải dừng chờ nạp viên tiếp theo. Tuy nhiên, mỗi phát sẽ sinh nhiệt nên khai hỏa lâu khiến nòng quá nóng, không thể bắn cho đến khi nguội."

msgid "detailsHelp/mechanics/autoShootGun_overheatGun/page1/title"
msgstr "Autocannon Kiểm Thermal Overheat"

msgid "detailsHelp/mechanics/battleFury/page1/description"
msgstr "Mỗi lần trúng địch bằng một viên đạn, bạn sẽ nhận một mức hiệu quả tái nạp, giúp tạm thời tăng tốc reload cho súng. Các mức độ sẽ cộng dồn theo từng phát trúng.\nDiệt xe địch bằng đạn sẽ cho thêm mức hiệu quả tái nạp."

msgid "detailsHelp/mechanics/battleFury/page1/title"
msgstr "Ammo Rack bán-tự động"

msgid "detailsHelp/mechanics/chargeShot/page1/description"
msgstr "Nếu súng đã được nạp, bạn có thể bắt đầu làm nóng phát tiếp theo để tăng sát thương—mức nhiệt càng cao, Bonus cho sát thương trung bình càng lớn.\nĐể bắt đầu quá trình làm nóng, bấm:"

msgid "detailsHelp/mechanics/chargeShot/page1/title"
msgstr "Overcharge đạn đạo Thermo"

msgid "detailsHelp/mechanics/chargeShot/page2/description"
msgstr "Ở mức nhiệt cao nhất, đồng hồ sẽ đếm thời gian để bóp cò—nếu không bắn trước khi nó đếm hết, bạn sẽ tạm thời không thể khai hỏa trong vài giây."

msgid "detailsHelp/mechanics/chargeShot/page2/title"
msgstr "Sạc Quá nhiệt"

msgid "detailsHelp/mechanics/chargeableBurst/page1/description"
msgstr "Đạt hai phát trúng-xuyên giáp xe địch kích hoạt cơ chế Burst, nạp một Cassette cho phép giải phóng hai viên nhanh liên tiếp với phát tiếp theo."

msgid "detailsHelp/mechanics/chargeableBurst/page1/title"
msgstr "Cơ chế Burst"

msgid "detailsHelp/mechanics/concentrationMode/page1/description"
msgstr "Gyro cân bằng khí nén giúp ổn định tối đa khi di chuyển thân và tháp pháo trong thời gian ngắn, cho phép vừa chạy vừa bắn chính xác hơn, phản ứng nhanh trước mối đe dọa bất ngờ.\nĐể kích hoạt nó, hãy bấm phím tắt:"

msgid "detailsHelp/mechanics/concentrationMode/page1/title"
msgstr "Gyro cân bằng khí nén"

msgid "detailsHelp/mechanics/dualAccuracy/page1/description"
msgstr "Nếu súng đã được tản nhiệt đủ sau khi bắn, độ phân tán sẽ giảm đi nữa. Vòng tròn ngắm thứ hai với bánh kính bé hơn sẽ xuất hiện, vốn quyết định diện tích đạn rơi vào. Hiệu ứng này tồn tại cho đến khi phát đạn tiếp theo rời nòng."

msgid "detailsHelp/mechanics/dualAccuracy/page1/title"
msgstr "Ngắm kép"

msgid "detailsHelp/mechanics/extraShotClip/page1/description"
msgstr "Hệ thống tự động bắt đầu nạp Cassette mới khi còn một viên trong cái hiện tại.\nNếu bắn viên cuối trong lúc đang nạp Cassette mới, thời gian reload còn lại sẽ bị kéo thêm vài giây."

msgid "detailsHelp/mechanics/extraShotClip/page1/title"
msgstr "Hệ thống Nạp Cassette"

msgid "detailsHelp/mechanics/heatingZonesGun/page1/description"
msgstr "Hệ thống giúp súng luôn mát, cho phép bắn chính xác cao. Khi khai hỏa, súng sẽ nóng lên, nhưng bắt đầu được làm nguội và trở lại thông số tối ưu trong lúc nạp đạn. Nhiệt độ càng cao, súng càng thay đổi vài thông số."

msgid "detailsHelp/mechanics/heatingZonesGun/page1/title"
msgstr "Nguội súng Active"

msgid "detailsHelp/mechanics/improvedRamming/page1/description"
msgstr "Xe này được cấu hình đặc biệt để đâm/húc, với nhiều cải tiến gây sát thương đâm/húc nhiều hơn."

msgid "detailsHelp/mechanics/improvedRamming/page1/title"
msgstr "Cấu hình Đâm/húc"

msgid "detailsHelp/mechanics/lowChargeShot/page1/description"
msgstr "Súng của xe này có thể bắn sớm: Các phát sạc đơn, khai hỏa trong khi nạp lại, có hiệu quả kém hơn; ngược lại, các phát sạc đầy tiêu chuẩn, được bắn sau lúc nạp xong, có tham số đạn đạo tối ưu."

msgid "detailsHelp/mechanics/lowChargeShot/page1/title"
msgstr "System Sạc Multi-Pack"

msgid "detailsHelp/mechanics/overheatStacks/page1/description"
msgstr "Đứng yên hoặc di chuyển chậm dưới một tốc độ nhất định để tích nhiệt làm nóng, tăng sát thương trung bình và độ chính xác cho phát tiếp theo.\nVượt quá giới hạn tốc độ sẽ dần làm giảm Bonus, trong khi việc bắn hoặc đổi đạn sẽ lập tức reset nó."

msgid "detailsHelp/mechanics/overheatStacks/page1/title"
msgstr "System nhiệt đẩy"

msgid "detailsHelp/mechanics/overheatStacks/page2/description"
msgstr "Ở mức làm nóng cao nhất, xuyên giáp xe địch có ít HP hơn sát thương trung bình của bạn—tính cả Bonus làm nóng đã tích lũy—sẽ gây nổ gác đạn, lập tức phá hủy phương tiện đó."

msgid "detailsHelp/mechanics/overheatStacks/page2/title"
msgstr "Sát thương Định đoạt"

msgid "detailsHelp/mechanics/powerMode/page1/description"
msgstr "Cơ chế Direct Drive đẩy mạnh công suất động cơ và tốc độ tiến tối đa. Càng lái về trước lâu, tốc độ càng tích lũy, giúp đi mây về gió trên trận địa."

msgid "detailsHelp/mechanics/powerMode/page1/title"
msgstr "Direct Drive"

msgid "detailsHelp/mechanics/propellantAfterburnerGun/page1/description"
msgstr "Theo thời gian, hệ thống tự động tích lũy sạc, một phần đó được tiêu hao để tăng sát thương phát bắn. Sạc càng nhiều, thiệt hại gây thêm càng lớn."

msgid "detailsHelp/mechanics/propellantAfterburnerGun/page1/title"
msgstr "Afterburner Cảm ứng Propellant"

msgid "detailsHelp/mechanics/propellantAfterburnerGun/page2/description"
msgstr "Theo mặc định, hệ thống chỉ lưu trữ điện tích đến giới hạn cụ thể. Tắt bộ giới hạn Limiter cho phép sạc vượt thêm, mang lại mức tăng sát thương lớn hơn nhiều, nhưng giảm độ vận hành súng. Để bật/tắt Limiter, nhấn:"

msgid "detailsHelp/mechanics/propellantAfterburnerGun/page2/title"
msgstr "Limiter"

msgid "detailsHelp/mechanics/rechargeableNitro/page1/description"
msgstr "Booster nhiên liệu lỏng làm nhảy vọt công suất động cơ để di chuyển đột biến trên trận địa—nhưng giới hạn tốc độ lùi và xoay xe. Chúng có thể bật/tắt bất cứ lúc nào, trừ trường hợp bị quá nhiệt.\nĐể bứt tốc, bấm hoặc giữ:"

msgid "detailsHelp/mechanics/rechargeableNitro/page1/title"
msgstr "Booster nhiên liệu lỏng"

msgid "detailsHelp/mechanics/rechargeableNitro/page2/description"
msgstr "Booster hoạt động sẽ nóng dần lên, khi chạm đến mức nhiệt tới hạn sẽ tạm thời bị vô hiệu và không thể kích hoạt tiếp nếu chưa nguội. Hãy tính nước đi cẩn thận để không bị úp sọt."

msgid "detailsHelp/mechanics/rechargeableNitro/page2/title"
msgstr "Mức nhiệt Tới hạn"

msgid "detailsHelp/mechanics/rocketAcceleration/page1/description"
msgstr "Áp phản lực dùng để tăng độ cơ động của xe, cho phép chiếm vị trí ưu thế hoặc băng qua các khu vực nguy hiểm nhanh hơn. Bộ áp phản lực có tác dụng trong khoảng thời gian nhất định và giới hạn số lần kích hoạt mỗi trận. Chúng không thể bị tắt hay phá hủy."

msgid "detailsHelp/mechanics/rocketAcceleration/page1/title"
msgstr "Bộ áp Phản lực"

msgid "detailsHelp/mechanics/rocketAcceleration/page2/description"
msgstr "Khi kích hoạt, bộ áp phản lực tăng công suất động cơ và tốc độ tiến tối đa. Tuy nhiên, xe trở nên khó bẻ lái, cũng như giảm mất tốc độ lùi."

msgid "detailsHelp/mechanics/rocketAcceleration/page2/title"
msgstr "Ưu và Nhược"

msgid "detailsHelp/mechanics/stagedJetBoosters/page1/description"
msgstr "Các khối cấp lực đẩy (Thruster) nhiên liệu rắn, tăng (Boost) khả năng bứt tốc, linh hoạt và điều động của xe trong vài giây. Hai Thruster trái–phải có thể hoạt động độc lập, cho phép xoay thân nhanh hơn và không hạn chế khả năng lùi."

msgid "detailsHelp/mechanics/stagedJetBoosters/page1/title"
msgstr "Thruster Rốckét Sequential"

msgid "detailsHelp/mechanics/stanceDance/page1/description"
msgstr "Xe này có hai cơ chế — Turbo và Tiếp chiến — chuyển đổi thoải mái bất cứ lúc nào. Bộ nguồn Tactical tích lũy năng lượng cho chế độ đang dùng.\nĐể chuyển cơ chế, bấm:"

msgid "detailsHelp/mechanics/stanceDance/page1/title"
msgstr "Hai Cơ chế"

msgid "detailsHelp/mechanics/stanceDance/page2/description"
msgstr "Khi Bộ nguồn Tactical đầy năng lượng, bạn mở khóa khả năng riêng của cơ chế. Kích hoạt sẽ tốn hết năng lượng nhưng đem lại Bonus mạnh trong thời gian ngắn.\nĐể kích hoạt khả năng độc đáo của cơ chế, nhấn:"

msgid "detailsHelp/mechanics/stanceDance/page2/title"
msgstr "Khả năng Cơ chế"

msgid "detailsHelp/mechanics/stationaryReload/page1/description"
msgstr "Module tiếp đạn External cho phép gián đoạn quá trình tái nạp và bắt đầu bắn bất cứ lúc nào, miễn là còn một viên lên nòng. Để ngắt hoặc tiếp tục reload, bấm phím tắt:"

msgid "detailsHelp/mechanics/stationaryReload/page1/title"
msgstr "Module tiếp đạn External"

msgid "detailsHelp/mechanics/stationaryReload/page2/description"
msgstr "Trong lúc reload, Module sẽ khóa tháp pháo cùng các thùng đạn ngoài của xe, tạm thời khiến bạn không thể ngắm hoặc khai hỏa trừ khi gián đoạn quá trình này."

msgid "detailsHelp/mechanics/stationaryReload/page2/title"
msgstr "Module tiếp đạn External"

msgid "detailsHelp/mechanics/supportWeapon/page1/description"
msgstr "Xe này được trang bị bộ vũ khí phụ có chu trình nạp riêng, độc lập với súng chính, cho phép gây thêm thiệt hại vào thời điểm then chốt. Để kích hoạt vũ khí phụ, bấm phím tắt:"

msgid "detailsHelp/mechanics/supportWeapon/page1/title"
msgstr "Vũ khí Phụ"

msgid "detailsHelp/mechanics/targetDesignator/page1/description"
msgstr "Laser Chốt Mục tiêu thêm hiệu ứng đặc biệt cho phát bắn tiếp theo, áp dụng vào bất kỳ kẻ địch nào ăn đạn. Hiệu ứng tùy thuộc mục tiêu có đang bị phát hiện tại thời điểm trúng hay không.\nĐể kích hoạt Laser Chốt Mục tiêu, nhấn:"

msgid "detailsHelp/mechanics/targetDesignator/page1/title"
msgstr "Laser Chốt Mục tiêu"

msgid "detailsHelp/mechanics/targetDesignator/page2/description"
msgstr "Bắn trúng đối phương đã bị phát hiện sẽ đánh dấu nó—lộ hình lâu hơn, ăn đòn thấm hơn.\nBắn trúng kẻ thù chưa bị phát hiện: Làm nổi vị trí của nó bằng chỉ báo đặc biệt."

msgid "detailsHelp/mechanics/targetDesignator/page2/title"
msgstr "Chốt Mục tiêu"

msgid "detailsHelp/mechanics/twinGun/page1/description"
msgstr "Bạn có thể chuyển cơ chế khai hỏa từ bắn từng viên sang bắn cả loạt tùy tình huống chiến thuật trên trận địa."

msgid "detailsHelp/mechanics/twinGun/page1/title"
msgstr "Cơ chế Chuyển Chế độ Bắn"

msgid "detailsHelp/mechanics/twinGun/page2/description"
msgstr "Cơ chế bắn cả loạt tăng gấp đôi sát thương và thời gian nạp đạn, trong khi độ phân tán ở 100 m* tệ đi."

msgid "detailsHelp/mechanics/twinGun/page2/title"
msgstr "Ưu và Nhược"

msgid "detailsHelp/mechanics/wheeledDash/page1/description"
msgstr "Cải biên cơ khí này tăng đáng kể gia tốc tiến/lùi, công suất động cơ, tốc độ tối đa tiến/lùi trong khoảng thời gian ngắn. Duy trì tốc độ di chuyển cao sẽ giúp nó hồi phục nhanh."

msgid "detailsHelp/mechanics/wheeledDash/page1/title"
msgstr "Assist Áp High-Pressure"

msgid "detailsHelp/noKeysWarning"
msgstr "Các phím cần thiết vẫn chưa được chỉ định. Hãy gán chúng trong mục thiết lập game."

msgid "detailsHelp/pillboxSiege/mechanics/page1"
msgstr "Trong cơ chế này, độ chính xác, tốc độ nạp đạn, góc nâng/hạ của súng được tăng đáng kể, nhưng khả năng di chuyển (tốc độ tiến/lùi và dịch thân ngang/dọc) bị giới hạn nghiêm trọng. Để kích hoạt cơ chế, %(pressAndHold)s phím tắt:"

msgid "detailsHelp/pillboxSiege/mechanics/page1/pressAndHold"
msgstr "nhấn và giữ"

msgid "detailsHelp/pillboxSiege/mechanics/page1/title"
msgstr "Cơ chế Lô-cốt"

msgid "detailsHelp/pillboxSiege/mechanics/page2"
msgstr "Trong cơ chế này, độ chính xác, tốc độ ngắm, góc nâng/hạ của súng được tăng thêm, nhưng khả năng di chuyển (tốc độ tiến/lùi) bị giới hạn. Để kích hoạt cơ chế, bấm phím tắt:"

msgid "detailsHelp/pillboxSiege/mechanics/page2/title"
msgstr "Cơ chế Tác xạ"

