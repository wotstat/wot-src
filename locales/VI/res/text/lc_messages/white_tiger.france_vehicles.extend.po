msgid "Chassis_F18_Bat_Chatillon25t_hound_TLXXL"
msgstr "Foudre"

msgid "F18_Bat_Chatillon25t_hound_TLXXL"
msgstr "Foudre"

msgid "F18_Bat_Chatillon25t_hound_TLXXL_descr"
msgstr "Von Krieger dạy máy móc của hắn cách suy nghĩ, vì đó là trò duy nhất y biết. Hắn thật sự tin rằng trí thông minh là thứ khiến con người trở thành con người, mặc tiến hóa cho thấy điều ngược lại. Chúng ta không đến được đây bằng cách suy nghĩ trước tiên; chúng ta đến đây trong sợ hãi, đói khát và liều lĩnh. Còn hắn lại nghĩ có thể xây tầng trên cùng mà không cần nền móng trước. Tùy thôi, dù sao tôi cũng sẽ đập sập tất cả. Cỗ Foudre này đã xuống địa ngục rồi trở về, nó có mọi thứ để biến lũ đồ chơi của hắn thành cát bụi. Đến lúc cho gã khoa học điên thấy cuộc sống thực sự trông như thế nào."

msgid "F18_Bat_Chatillon25t_hound_TLXXL_short"
msgstr "Foudre"

msgid "F18_Bat_Chatillon25t_hound_TLXXL_short_special"
msgstr "Bản hiện đại hóa quy mô lớn của chiếc tăng chiến đấu chủ lực"

