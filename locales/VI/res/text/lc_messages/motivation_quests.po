msgid "common/congratulation"
msgstr "Xin chúc mừng! Bạn đã hoàn thành nhiệm vụ và nhận được các phần thưởng sau"

msgid "common/requirements"
msgstr "Có thể hoàn thành bằng xe Cấp IV hoặc cao hơn."

msgid "g1/advice"
msgstr "Bạn có thể thắng trận bằng cách tiêu diệt hết toàn bộ xe địch hoặc cướp căn cứ đối phương. Hãy cẩn thận và đừng vội vàng lao lên phía trước. Phối hợp với đồng đội là yếu tố then chốt quyết định sự sống còn trong chiến trận."

msgid "g1/description"
msgstr "Không bắt buộc phải đáp ứng được yêu cầu trong 3 trận liên tiếp."

msgid "g1/name"
msgstr "Những ngày Chiến tranh"

msgid "g10/advice"
msgstr "Bạn có thể gây ra rất nhiều thiệt hại bằng bất cứ loại xe nào. Hãy chọn những mục tiêu dễ bắn trúng, cố sống càng lâu càng tốt để đến khi hết trận, dòng \"Thiệt hại đã Gây ra\" trên màn hình \"Kết quả Trận đấu\" sẽ hiển thị con số lớn bất ngờ và vô cùng thú vị."

msgid "g10/description"
msgstr "Không bắt buộc phải đáp ứng được yêu cầu trong 2 trận liên tiếp."

msgid "g10/name"
msgstr "Hình mẫu: Sát thương"

msgid "g2/advice"
msgstr "Tăng hạng nặng sở hữu những khẩu súng đầy uy lực và giáp trước khó xuyên thủng. Bù lại, khả năng di chuyển không cao khiến chúng dễ dàng bị đánh thọc sườn, bọc hậu và để lộ điểm yếu ở phần hông hoặc phía sau xe."

msgid "g2/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g2/name"
msgstr "Hồng tâm: Tăng hạng Nặng"

msgid "g3/advice"
msgstr "Tăng hạng trung là các đơn vị toàn diện, có khả năng thực hiện hàng loạt mục tiêu trên bất cứ chiến trường nào—từ yểm trợ đội hình tấn công chính cho đến đánh thọc sườn. Đừng để bị bắn vào phía hông xe và hãy tiêu diệt tăng hạng trung địch ngay khi chúng đang tìm cách tiếp cận."

msgid "g3/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g3/name"
msgstr "Hồng tâm: Tăng hạng Trung"

msgid "g4/advice"
msgstr "Tăng hạng nhẹ có giáp và súng đều yếu, nhưng vô địch về tốc độ cùng khả năng ẩn nấp. Nhiệm vụ chính của chúng là phát hiện và đánh lạc hướng quân địch."

msgid "g4/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g4/name"
msgstr "Hồng tâm: Tăng hạng Nhẹ"

msgid "g5/advice"
msgstr "Pháo chống tăng là đối thủ đáng sợ với hỏa lực cực mạnh và khả năng ẩn nấp rất tốt, nhưng—trong hầu hết các trường hợp—có khả năng di chuyển kém. Hãy cố gắng phát hiện và tiêu diệt chúng càng sớm càng tốt."

msgid "g5/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g5/name"
msgstr "Hồng tâm: Pháo Chống tăng"

msgid "g6/advice"
msgstr "Xe địch còn càng ít, cơ hội chiến thắng càng cao. Hãy hành động khôn khéo, cố gắng sống sót và gây ra nhiều thiệt hại nhất có thể. Luôn tận dụng địa hình để khai hỏa mà không để lộ mình."

msgid "g6/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g6/name"
msgstr "Kỹ năng Tổng hợp"

msgid "g7/advice"
msgstr "Mỗi xe đều có kíp lái, mô-đun bên trong và bên ngoài. Những phát đạn gây thiệt hại nghiêm trọng cho 3 thứ trên sẽ làm giảm đáng kể hiệu quả chiến đấu của xe. Hãy nghiên cứu các điểm yếu trên mỗi phương tiện để sát thương địch hiệu quả hơn và không để lộ \"gót chân A-sin\" của xe mình."

msgid "g7/description"
msgstr "Kết quả đạt được ở mọi trận đánh bằng bất cứ xe nào sẽ được cộng chung lại."

msgid "g7/name"
msgstr "Phát bắn Chí mạng"

msgid "g8/advice"
msgstr "Chiếm căn cứ địch là một cách để giành chiến thắng. Khi xe tăng đối phương đang mải tập trung đấu súng, bạn có thể chuồn đi cướp căn cứ mà không hề bị phát hiện. Nhớ rằng, càng nhiều xe nằm trong vòng tròn căn cứ, quá trình chiếm đóng sẽ càng nhanh. Tốc độ chiếm đóng nhanh nhất là khi có 3 xe trong vòng tròn căn cứ."

msgid "g8/name"
msgstr "Kế hoạch B"

msgid "g9/advice"
msgstr "Bạn có thể kiếm được kinh nghiệm từ việc phát hiện, gây thiệt hại và tiêu diệt xe địch; chiếm căn cứ đối phương, bảo vệ căn cứ phe ta và chiến thắng trận đánh."

msgid "g9/description"
msgstr "Không bắt buộc phải đáp ứng được yêu cầu trong 2 trận liên tiếp."

msgid "g9/name"
msgstr "Hình mẫu: Kinh nghiệm"

msgid "group"
msgstr "Huấn luyện Tân binh"
