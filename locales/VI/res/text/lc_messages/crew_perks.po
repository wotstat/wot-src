msgid "armorPatching/alt/description"
msgstr "Hứng chịu sát thương sẽ làm gián đoạn quá trình hồi HP.\n\nTốc độ hồi HP và giới hạn hồi phục tối đa được dựa trên tổng HP của xe, gồm mọi hệ số điều chỉnh đã áp dụng."

msgid "armorPatching/alt/info"
msgstr "Đối với kỹ năng tập thể, nó sẽ tính theo mức đào tạo trung bình của toàn bộ thành viên kíp lái. Tác dụng được phát huy ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "armorPatching/currentLvlDescription"
msgstr "Sử dụng Bộ Sửa chữa sẽ khôi phục %(hpRecover)s {yellow_Start}HP{yellow_End} của xe trong 5 giây, tối đa 20% mỗi trận. Cho phép dùng Bộ Sửa chữa khi không hư hại nghiêm trọng."

msgid "armorPatching/hudDescription"
msgstr "HP đã được phục hồi."

msgid "armorPatching/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn cho tất cả lính, hồi phục %(hpRecover)s {yellow_Start}HP{yellow_End} của xe trong 5 giây sau lúc sử dụng Bộ Sửa chữa, tối đa 20% mỗi trận. Cho phép dùng Bộ Sửa chữa khi không hư hại nghiêm trọng."

msgid "armorPatching/name"
msgstr "Armor Patching"

msgid "armorPatching/shortDescription"
msgstr "@ Tăng độ ẩn giấu cơ bản của xe."

msgid "brotherhood/alt/description"
msgstr "Khoản tăng hiệu suất kíp lái cải thiện hiệu quả của tổ lính trong trận, cũng như nâng cao mọi kỹ năng đã học, trừ cái này. Thông số này có thể được tăng thêm nhờ lắp thiết bị hoặc vật phẩm với hiệu ứng tương thích, hay dùng ứng dụng kỹ thuật Màng lọc Ống thông khí. Kỹ năng \"Khẩn cấp\" của Chỉ huy, kỹ năng \"Kề vai Sát cánh\" và \"Chuyên gia Truyền tin\" của Liên lạc viên cũng cải thiện thông số này."

msgid "brotherhood/alt/info"
msgstr "Đối với kỹ năng tập thể, nó sẽ tính theo mức đào tạo trung bình của toàn bộ thành viên kíp lái. Tác dụng được phát huy ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "brotherhood/currentLvlDescription"
msgstr "{greenBright_Start}Khoản tăng hiệu suất kíp lái{greenBright_End} của toàn bộ tổ lính được nâng thêm %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn cho tất cả lính, cải thiện {greenBright_Start}khoản tăng hiệu suất kíp lái{greenBright_End} của toàn bộ tổ lính thêm %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/name"
msgstr "Đoàn kết"

msgid "brotherhood/shortDescription"
msgstr "Tăng hiệu quả chiến đấu chung của kíp lái."

msgid "camouflage/alt/description"
msgstr "Kỹ năng này tác động lên độ ẩn giấu của xe. Nó có thể được cải thiện thêm nhờ ứng dụng kỹ thuật Vỏ bọc Tự nhiên.\n\nNgoài ra, độ ẩn giấu của xe còn tăng nữa nếu áp dụng ngụy trang hoặc kiểu mẫu, cũng như khi lắp thiết bị hay vật phẩm với hiệu ứng tương thích."

msgid "camouflage/alt/info"
msgstr "Đối với kỹ năng tập thể, nó sẽ tính theo mức đào tạo trung bình của toàn bộ thành viên kíp lái. Tác dụng được phát huy ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "camouflage/currentLvlDescription"
msgstr "{greenBright_Start}Độ ẩn giấu{greenBright_End} của xe được tăng thêm %(maskingFactor)s&zwnbsp;."

msgid "camouflage/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn cho tất cả thành viên kíp lái, tăng {greenBright_Start}độ ẩn giấu{greenBright_End} của xe thêm %(maskingFactor)s&zwnbsp;."

msgid "camouflage/name"
msgstr "Độ ẩn giấu"

msgid "camouflage/shortDescription"
msgstr "Tăng độ ẩn giấu cơ bản của xe."

msgid "commander_coordination/alt/description"
msgstr "Hiệu ứng kích hoạt mỗi lần phát hiện xe địch nhưng không cộng dồn nếu soi ra nhiều xe.\n\nTốc độ ngắm có thể được cải thiện thêm khi học kỹ năng Ngắm Nhanh của Pháo thủ hoặc lắp thiết bị có hiệu ứng tương tự."

msgid "commander_coordination/alt/info"
msgstr "Kỹ năng có hiệu quả theo tình huống, phát huy tác dụng ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên. Nó kích hoạt lúc xuất hiện những điều kiện nhất định trong trận."

msgid "commander_coordination/currentLvlDescription"
msgstr "{yellow_Start}Tốc độ ngắm{yellow_End} sẽ được tăng thêm %(vehicleGunAimSpeed)s trong 15 s sau khi bạn phát hiện xe địch."

msgid "commander_coordination/hudDescription"
msgstr "Tốc độ ngắm được tăng lên."

msgid "commander_coordination/maxLvlDescription"
msgstr "Lúc được đào tạo thành thục hoàn toàn, tăng {yellow_Start}tốc độ ngắm{yellow_End} thêm %(vehicleGunAimSpeed)s trong 15 s sau khi bạn phát hiện xe địch.\t"

msgid "commander_coordination/name"
msgstr "Phối hợp"

msgid "commander_coordination/shortDescription"
msgstr "Tốc độ ngắm được tăng lên."

msgid "commander_eagleEye/alt/description"
msgstr "Tầm nhìn có thể được cải thiện thêm nhờ học kỹ năng Cảnh Giác của Liên lạc viên, hoặc khi lắp thiết bị với hiệu ứng tương thích. Dùng ứng dụng kỹ thuật Khối Hiệu chỉnh Quang học sẽ tăng hiệu quả."

msgid "commander_eagleEye/alt/info"
msgstr "Kỹ năng có tác dụng ngay khi thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "commander_eagleEye/currentLvlDescription"
msgstr "{greenBright_Start}Tầm nhìn{greenBright_End} được tăng thêm %(circularVisionRadius)s&zwnbsp;. {greenBright_Start}Tác động tiêu cực lên thiết bị quan sát{greenBright_End} được giảm đi %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/hudDescription"
msgstr "Tác động tiêu cực lên thiết bị quan sát được giảm đi."

msgid "commander_eagleEye/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn, tăng {greenBright_Start}tầm nhìn{greenBright_End} thêm %(circularVisionRadius)s&zwnbsp; và giảm {greenBright_Start}tác động tiêu cực lên thiết bị quan sát{greenBright_End} đi %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/name"
msgstr "Trinh sát"

msgid "commander_eagleEye/shortDescription"
msgstr "Tăng tầm nhìn, đặc biệt khi thiết bị quan sát bị hỏng."

msgid "commander_emergency/alt/description"
msgstr "Khi liên tiếp hứng chịu thiệt hại từ một kẻ địch, hiệu ứng không cộng dồn. Khoản tăng hiệu suất kíp lái cải thiện hiệu quả của tổ lính trong trận. Thông số này có thể được tăng thêm nhờ lắp thiết bị hoặc vật phẩm với hiệu ứng tương thích, hay dùng ứng dụng kỹ thuật Màng lọc Ống thông khí. Kỹ năng Tập thể \"Đoàn Kết\", kỹ năng \"Kề vai Sát cánh\" và \"Chuyên gia Truyền tin\" của Liên lạc viên cũng cải thiện thông số này."

msgid "commander_emergency/alt/info"
msgstr "Kỹ năng có hiệu quả theo tình huống, phát huy tác dụng ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên. Nó kích hoạt lúc xuất hiện những điều kiện nhất định trong trận."

msgid "commander_emergency/currentLvlDescription"
msgstr "{yellow_Start}Khoản tăng hiệu suất kíp lái{yellow_End} sẽ được tăng thêm %(crewLevelIncrease)s trong 15 s sau khi hứng chịu thiệt hại từ một kẻ địch."

msgid "commander_emergency/hudDescription"
msgstr "Khoản tăng hiệu suất kíp lái được cải thiện."

msgid "commander_emergency/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn, cải thiện {yellow_Start}khoản tăng hiệu suất kíp lái{yellow_End} thêm %(crewLevelIncrease)s trong 15 s sau khi hứng chịu thiệt hại từ một kẻ địch."

msgid "commander_emergency/name"
msgstr "Khẩn cấp"

msgid "commander_emergency/shortDescription"
msgstr "Khoản tăng hiệu suất kíp lái được cải thiện."

msgid "commander_enemyShotPredictor/alt/description"
msgstr "Một cảnh báo về đạn Pháo Tự hành địch, được kích hoạt ngay thời điểm đối phương khai hỏa nhưng có chút độ trễ.\n\nKỹ năng này có thể cải thiện thêm nhờ ứng dụng kỹ thuật \"Cảm ứng Cảnh báo Sớm\"."

msgid "commander_enemyShotPredictor/alt/info"
msgstr "Kỹ năng có hiệu quả theo tình huống, phát huy tác dụng ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên. Nó kích hoạt lúc xuất hiện những điều kiện nhất định trong trận."

msgid "commander_enemyShotPredictor/currentLvlDescription"
msgstr "Một {yellow_Start}cảnh báo về đạn Pháo Tự hành địch{yellow_End} và hướng bắn tới sẽ được đưa ra nhưng có độ trễ %(artNotificationDelayFactor)s. {greenBright_Start}Tác động tiêu cực của hiệu ứng choáng{greenBright_End} được giảm đi %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn, ra {yellow_Start}cảnh báo về đạn Pháo Tự hành địch{yellow_End}, hiển thị hướng bắn nhưng trễ %(artNotificationDelayFactor)s. Làm giảm {greenBright_Start}tác động tiêu cực của hiệu ứng choáng{greenBright_End} đi %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/name"
msgstr "Nhạy âm"

msgid "commander_enemyShotPredictor/shortDescription"
msgstr "Nhận biết pháo địch bắn."

msgid "commander_holdLine/alt/description"
msgstr "Khoản tăng hiệu suất kíp lái giúp cải thiện hiệu quả tác chiến của lính.\n\nTham số này có thể được tăng thêm bằng cách lắp thiết bị hoặc vật phẩm với hiệu ứng tương thích, hay dùng ứng dụng kỹ thuật Màng lọc Ống thông khí. Nhiều kỹ năng kíp lái khác cũng cải thiện tham số."

msgid "commander_holdLine/alt/info"
msgstr "Kỹ năng có hiệu quả theo tình huống, phát huy tác dụng ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên. Nó kích hoạt lúc xuất hiện những điều kiện nhất định trong trận."

msgid "commander_holdLine/currentLvlDescription"
msgstr "{yellow_Start}Khoản tăng hiệu suất kíp lái{yellow_End} sẽ được cải thiện thêm %(crewLevelIncrease)s khi địch có nhiều hơn phe của bạn ít nhất 3 xe tham chiến&zwnbsp;."

msgid "commander_holdLine/hudDescription"
msgstr "Khoản tăng hiệu suất kíp lái được cải thiện (địch đông hơn)."

msgid "commander_holdLine/maxLvlDescription"
msgstr "Khi đào tạo thành thục hoàn toàn, cải thiện {yellow_Start}khoản tăng hiệu suất kíp lái{yellow_End} thêm %(crewLevelIncrease)s lúc địch có nhiều hơn phe của bạn ít nhất 3 xe tham chiến&zwnbsp;."

msgid "commander_holdLine/name"
msgstr "Hold the Line"

msgid "commander_holdLine/shortDescription"
msgstr "@ Cải thiện khoản tăng hiệu suất kíp lái"

msgid "commander_practical/alt/description"
msgstr "Kỹ năng tương thích với mọi loại vật phẩm lắp trên xe của bạn.\n\nHiệu quả có thể tăng thêm bằng cách dùng ứng dụng kỹ thuật Lý thuyết Kỹ lưỡng."

msgid "commander_practical/alt/info"
msgstr "Kỹ năng có tác dụng ngay khi thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "commander_practical/currentLvlDescription"
msgstr "{greenBright_Start}Thời gian hồi phục vật phẩm {greenBright_End} được giảm đi %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn, giảm {greenBright_Start}thời gian hồi phục vật phẩm{greenBright_End} đi %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/name"
msgstr "Thực tiễn"

msgid "commander_practical/shortDescription"
msgstr "Giảm thời gian hồi phục vật phẩm."

msgid "commander_sixthSense/alt/description"
msgstr "Chỉ huy bị thương sẽ khiến \"Giác quan Thứ 6\" vô hiệu. Tốc độ kích hoạt \"Giác quan Thứ 6\" có thể nhanh hơn nhờ kỹ năng \"Bắt Tín hiệu\" của Liên lạc viên."

msgid "commander_sixthSense/alt/info"
msgstr "Đây là một tính năng đặc biệt của Chỉ huy mà không cần đào tạo, khả dụng theo mặc định."

msgid "commander_sixthSense/currentLvlDescription"
msgstr "Giúp Chỉ huy ý thức được liệu xe mình đã bị địch phát hiện hay chưa. Kích hoạt %(delay)s sau khi xe lộ hình."

msgid "commander_sixthSense/name"
msgstr "Giác quan Thứ 6"

msgid "commander_sixthSense/shortDescription"
msgstr "Cho phép Chỉ huy ý thức được liệu xe của mình đã bị địch phát hiện hay chưa."

msgid "commander_staySharp/alt/description"
msgstr "Khoản tăng hiệu suất kíp lái giúp cải thiện hiệu quả tác chiến của lính.\n\nTham số này có thể được tăng thêm bằng cách lắp thiết bị hoặc vật phẩm với hiệu ứng tương thích, hay dùng ứng dụng kỹ thuật Màng lọc Ống thông khí. Nhiều kỹ năng kíp lái khác cũng cải thiện tham số."

msgid "commander_staySharp/alt/info"
msgstr "Kỹ năng có hiệu quả theo tình huống, phát huy tác dụng ngay lúc thành thục ít nhất 1% và tăng dần hiệu quả khi học lên. Nó kích hoạt lúc xuất hiện những điều kiện nhất định trong trận."

msgid "commander_staySharp/currentLvlDescription"
msgstr "{yellow_Start}Khoản tăng hiệu suất kíp lái{yellow_End} sẽ được cải thiện thêm %(crewLevelIncrease)s trong 15&nbsp;s sau khi dùng Bộ Cứu thương. Cho phép sử dụng Bộ Cứu thương ngay cả lúc không thành viên nào bị hại&zwnbsp;."

msgid "commander_staySharp/hudDescription"
msgstr "Khoản tăng hiệu suất kíp lái được cải thiện (dùng Bộ Cứu thương)."

msgid "commander_staySharp/maxLvlDescription"
msgstr "Khi thành thục hoàn toàn, cải thiện {yellow_Start}khoản tăng hiệu suất kíp lái{yellow_End} thêm %(crewLevelIncrease)s trong 15 s sau lúc dùng Bộ Cứu thương. Cho phép sử dụng Bộ Cứu thương ngay cả ở trường hợp không thành viên nào bị hại&zwnbsp;."

msgid "commander_staySharp/name"
msgstr "Stay Sharp"

msgid "commander_staySharp/shortDescription"
msgstr "@ Cải thiện khoản tăng hiệu suất kíp lái"

msgid "commander_tutor/alt/description"
msgstr "Chỉ huy bị thương không thể thay thế thành viên khác. Lợi ích chỉ áp dụng cho lượng XP Kíp lái gốc kiếm được trong trận.\n\nXP Kíp lái còn có thể tăng lên nhờ sử dụng Tài liệu Kíp lái hoặc quy đổi từ XP Tự do."

msgid "commander_tutor/alt/info"
msgstr "Kỹ năng có tác dụng ngay khi thành thục ít nhất 1% và tăng dần hiệu quả khi học lên."

msgid "commander_tutor/currentLvlDescription"
msgstr "Tăng %(xpBonusFactorPerLevel)s {greenBright_Start}XP{greenBright_End} kiếm được cho mọi thành viên kíp lái. Chỉ huy có thể {greenBright_Start}thay thế thành viên bị thương{greenBright_End} với hiệu suất %(woundedCrewEfficiency)s."

msgid "commander_tutor/hudDescription"
msgstr "Thành viên kíp lái bị thương được Chỉ huy thay thế."

msgid "commander_tutor/maxLvlDescription"
msgstr "Khi đào tạo thành thục hoàn toàn, tăng %(xpBonusFactorPerLevel)s {greenBright_Start}XP{greenBright_End} kiếm được cho mọi thành viên kíp lái. Giúp Chỉ huy có thể {greenBright_Start}thay thế thành viên bị thương{greenBright_End} với hiệu suất %(woundedCrewEfficiency)s."

msgid "commander_tutor/name"
msgstr "Thông thái"

msgid "commander_tutor/shortDescription"
msgstr "Thành viên kíp lái bị thương được Chỉ huy thay thế."

msgid "commander_universalist/alt/description"
msgstr "Chỉ huy chỉ có thể thay thế chuyên môn chính của thành viên kíp lái bị thương. Khả năng thay thế giảm dần theo mỗi lính tăng mất đi."

msgid "commander_universalist/alt/info"
msgstr "Kỹ năng có tác dụng ngay khi thành thục ít nhất 1%. Hiệu quả tăng dần theo sau đó."

msgid "commander_universalist/currentLvlDescription"
msgstr "Chỉ huy có thể {greenBright_Start}thay thế thành viên kíp lái bị thương{greenBright_End} với hiệu quả %(woundedCrewEfficiency)s."

msgid "commander_universalist/hudDescription"
msgstr "Chỉ huy làm thay vai trò của thành viên kíp lái bị thương."

msgid "commander_universalist/maxLvlDescription"
msgstr "Khi được đào tạo thành thục hoàn toàn, cho phép Chỉ huy {greenBright_Start}thay thế thành viên kíp lái bị thương{greenBright_End} với hiệu quả %(woundedCrewEfficiency)s."

msgid "commander_universalist/name"
msgstr "Ba đầu Sáu tay"

msgid "commander_universalist/shortDescription"
