msgid "Chassis_R97_Object_140_hound_TLXXL"
msgstr "Object 140 Resistor"

msgid "R113M_WT"
msgstr "R-113 Resistor"

msgid "R97_Object_140_hound_TLXXL"
msgstr "Resistor"

msgid "R97_Object_140_hound_TLXXL_descr"
msgstr "Resistor nhồi plasma thô vào từng viên đạn. Súng thế này, con quỷ mới nhất của von Krieger sẽ không trụ nổi một buổi chiều. Nó như ép xung và tàn bạo; đúng thứ tôi cần. Còn về chiếc Blitzträger bên kia? To chưa chắc đã tốt. Mỗi phát ta bắn trúng đích là lời phản bác mọi thứ hắn từng lắp ghép. Mà nói nhỏ nghe, tôi không chắc kẻ cầm lái nó vẫn là con người đó. Cách hắn nói chuyện dạo này, như thứ gì khác chọn lời cho. Nhưng không quan trọng. Kẻ nào cũng sẽ lĩnh đủ thứ plasma này thôi."

msgid "R97_Object_140_hound_TLXXL_short"
msgstr "Resistor"

msgid "R97_Object_140_hound_TLXXL_short_special"
msgstr "Bản hiện đại hóa quy mô lớn của chiếc tăng chiến đấu chủ lực"

msgid "TD-12_WT"
msgstr "TD-12 Resistor"

msgid "Turret_1_R97_Object_140_hound_TLXXL"
