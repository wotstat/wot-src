msgid "epilogue/text"
msgstr "MacLeod: \"Còn sống! Brooks còn sống! Bị cháy nặng. Nhưng còn sống. Tất nhiên rồi. Đã hứa có huy chương mà. Qua bao năm. Xứng đáng, phải công nhận. Nướng đen con King Tiger đó. Bây giờ chúng ta hòa nhá. Phát bắn vào chiếc Tiger khi cứu quá may. Bắn không nhắm. Kết quả đấy? Đúng tự cứu mình sau đấy. Và cả Brooks nữa.\n\nBây giờ có thể nghỉ ngơi một chút. Chúng ta có vài ngày. Sửa lại xe tăng thôi. Berlin đang đợi.\n\nÀ quên, tỷ số đang thắng 7-4. Nhưng bọn Đức vẫn còn Tiger, chưa biết ai đầu bảng đâu!\""

msgid "epilogue/title"
msgstr "ĐOẠN KẾT"

