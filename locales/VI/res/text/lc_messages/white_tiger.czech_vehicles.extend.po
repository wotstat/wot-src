msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "Chiếc Pojistka này đúng là cả một xưởng cơ động trên bánh xích. Góc cạnh sắc gọn, dây dẫn đi sạch sẽ, mọi hệ thống đáp ứng ngay lệnh đầu tiên. Chúng tôi xuất quân để chặn một gã khoa học điên loạn, rồi cuối cùng phải đối đầu với thứ hắn gọi là Trí tuệ Điện tử. Đám Sentinel của y vẫn đang học hỏi, theo dõi từng động thái chúng tôi. Hắn tạo ra chúng để thay thế chúng tôi. Được thôi. Vậy bài học hôm nay là của tôi. Tôi tìm gờ cao, khóa mục tiêu, rồi để đạn toe toét lo phần còn lại. Nếu hắn thật sự tin cỗ máy biết suy nghĩ có thể sống dai hơn chúng tôi, hãy xem dưới áp lực nó nghĩ ra được gì."

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "Bản hiện đại hóa quy mô lớn của chiếc tăng chiến đấu chủ lực"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silver Bullet"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "\"Viên đạn Bạc\", niềm kiêu hãnh từ công nghệ làm súng của quân Đồng minh"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Mỗi Máy Phát bị quá tải sẽ sạc Silver Bullet—Viên đạn Bạc—với Plasma. Sạc càng nhiều, Plasma gây sát thương càng lớn. Hãy bắn khi Blitzträger không có khiên bảo vệ để tạo ra thiệt hại lớn nhất."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Sát thương lớn hơn với Plasma"
