msgid "GB123_GSOR_1006_v7_Halloween_event"
msgstr "Havoc"

msgid "GB123_GSOR_1006_v7_Halloween_event_descr"
msgstr "Cỗ máy mật danh Havoc lần đầu được thử nghiệm trong chuyến thám hiểm tới Tòa Tháp Dark Tower. Sự kết hợp giữa khung gầm bánh lốp, súng bắn nhanh với hệ thống nạp theo băng tiếp đạn và cải tiến Mirium đã chứng tỏ hiệu quả vượt trội tại những giai đoạn sâu hơn của Dị điểm, trước các tác động khó lường bộc lộ rõ. Nhiều kíp lái ghi nhận tính linh hoạt và công năng đa dạng ở mẫu xe này."

msgid "GB123_GSOR_1006_v7_Halloween_event_long_special"
msgstr "Một xe đa năng kết hợp khung gầm bánh lốp với súng tự động bắn nhanh."

msgid "GB123_GSOR_1006_v7_Halloween_event_short"
msgstr "Havoc"

msgid "GB125_Saladin_HW_BOT"
msgstr "Detonator"

msgid "GB125_Saladin_HW_BOT_descr"
msgstr "Xe bánh lốp bọc thép FV601 Saladin do \"Alvis Car and Engineering Company\" thiết kế nhằm thay thế AEC Armoured Car. Công tác phát triển bắt đầu năm 1946, nhưng giai đoạn thực tiễn mãi đến nửa đầu những năm 1950 mới khởi động. Đặc trưng của nó bao gồm cấu hình bánh 6x6 và hệ giảm xóc tay đòn mở rộng \"outrigger\". Hai nguyên mẫu đầu tiên của FV 601 (B) được chế tạo năm 1955. Hai năm sau, tổng cộng sáu xe bọc thép thí điểm xuất xưởng, và đến năm 1958 đi vào sản xuất hàng loạt. Nó được sản xuất cho đến năm 1972, hầu hết là biến thể Saladin Mk. 2. Tổng cộng 1177 chiếc đã ra đời. Nó tích cực tham chiến ở Trung Đông và Châu Phi."

msgid "GB125_Saladin_HW_BOT_short"
msgstr "Detonator"

msgid "GB24_Centurion_Mk3_HW_BOT"
msgstr "Corrupted Cerberus"

msgid "GB24_Centurion_Mk3_HW_BOT_descr"
msgstr "Một tăng hạng trung với độ cơ động bình thường, giáp trước tin cậy được và súng xuất sắc."

msgid "GB24_Centurion_Mk3_HW_BOT_short"
msgstr "Corrupted"

msgid "GB24_Centurion_Mk3_Halloween_event"
msgstr "Cerberus"

msgid "GB24_Centurion_Mk3_Halloween_event_descr"
msgstr "Lấy tăng hạng trung Centurion Mk.3 của Anh làm cơ sở, quá trình phát triển Cerberus được thúc đẩy bởi nhu cầu xe đa năng có thể hoạt động trong điều kiện môi trường thù địch. Sự kết hợp giữa giáp bảo vệ tuyệt vời, vũ khí mạnh mẽ và nhiều cải tiến dựa trên Mirium đã chứng tỏ hiệu quả đến mức các tăng Cerberus gần như không thể thiếu khi hoạt động trong dị điểm."

msgid "GB24_Centurion_Mk3_Halloween_event_long_special"
msgstr "Một tăng hạng trung với độ cơ động bình thường, giáp trước tin cậy được và súng xuất sắc."

