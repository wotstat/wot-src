msgid "battlePassSeasonDescription"
msgstr "Kiểu mẫu chủ đề 3D mới"

msgid "beCareful"
msgstr "Hãy Cẩn thận"

msgid "comp7Core10"
msgstr "Bạn có thể đổi sang xe phù hợp hơn trong quá trình Chuẩn bị Trước trận."

msgid "comp7Core10Status"
msgstr "Chuẩn bị Trước trận"

msgid "comp7Core11"
msgstr "Màn hình Chuẩn bị Trước trận hiển thị các xe của bạn đã vũ trang với kíp lái và đạn. Đừng quên sửa soạn biên chế chúng trước khi tham chiến."

msgid "comp7Core11Status"
msgstr "Chuẩn bị Trước trận"

msgid "comp7Core12"
msgstr "Sau khi quyết định xong xe ưng ý, hãy để đồng đội biết bằng cách click nút Xác nhận Lựa chọn."

msgid "comp7Core12Status"
msgstr "Chuẩn bị Trước trận"

msgid "comp7Core13"
msgstr "Sau khi click nút Xác nhận Lựa chọn, bạn sẽ không thể đổi xe."

msgid "comp7Core13Status"
msgstr "Xác nhận Lựa chọn Của Bạn"

msgid "comp7Core14"
msgstr "Chiếm các điểm đặc biệt trên bản đồ để sở hữu Kỹ Chiến lược và lợi thế lớn!"

msgid "comp7Core14Status"
msgstr "Điểm Then chốt"

msgid "comp7Core15"
msgstr "Một Điểm Then chốt trên bản đồ. Chiếm được vị trí này sẽ cho phép bạn sử dụng Kỹ Chiến lược \"Ra-đa Chia nhánh\". Khi kích hoạt, mọi xe địch sẽ lộ diện trong vài giây."

msgid "comp7Core15Status"
msgstr "Trung tâm Liên lạc"

msgid "comp7Core16"
msgstr "Một Điểm Then chốt trên bản đồ. Chiếm được vị trí này sẽ cho phép bạn sử dụng Kỹ Chiến lược \"Pháo Kích\". Khi kích hoạt, người chơi có thể chọn một khu vực để gọi pháo bắn phá."

msgid "comp7Core16Status"
msgstr "Sở Chỉ huy Pháo"

msgid "comp7Core17"
msgstr "Nếu Kỹ Chiến lược \"Pháo Kích\" bắn trúng đồng đội, họ sẽ không bị thiệt hại nhưng vẫn bị choáng."

msgid "comp7Core17Status"
msgstr "Pháo Kích"

msgid "comp7Core18"
msgstr "Xin vui lòng chú ý: Các bản đồ trong chế độ này có thể khác biệt so với thường thấy ở Trận đấu Ngẫu nhiên."

msgid "comp7Core18Status"
msgstr "Bản đồ trong Sự kiện"

msgid "comp7Core19"
msgstr "Tạo Trung đội gồm 7 người chơi có thể tăng khả năng thắng của bạn."

msgid "comp7Core19Status"
msgstr "Phối hợp Tập thể là Chìa khóa"

msgid "comp7Core21"
msgstr "Bạn có thể kiểm tra cấp sạc của Kỹ Vai trò thuộc về đồng đội trong trận bằng cách bấm phím Tab hoặc Alt."

msgid "comp7Core21Status"
msgstr "Kỹ Vai trò Đồng đội"

msgid "comp7Core22"
msgstr "Bạn có thể kiểm tra danh sách phe để xem đồng đội mình đã sở hữu Kỹ Chiến lược nào. Kỹ Chiến lược của địch không hiển thị."

msgid "comp7Core22Status"
msgstr "Kỹ Chiến lược"

msgid "comp7Core23"
msgstr "Nếu Kỹ Vai trò ảnh hưởng lên một xe, biểu tượng tương ứng sẽ hiển thị phía trên dấu hiệu xe của người chơi."

msgid "comp7Core23Status"
msgstr "Hiệu ứng Kỹ Vai trò"

msgid "comp7Core24"
msgstr "Phím H (theo mặc định) sẽ bật Chat Voice. Dùng tính năng này để giao tiếp hiệu quả hơn với đồng đội."

msgid "comp7Core24Status"
msgstr "Chat Voice"

msgid "comp7Core25"
msgstr "Nếu gặp bất cứ vấn đề nào về Chat Voice, hãy kiểm tra thiết lập của bạn trong client trò chơi."

msgid "comp7Core25Status"
msgstr "Chat Voice"

msgid "comp7Core29"
msgstr "Khi bấm Alt, vai trò của bất cứ phương tiện nào nội trong tầm nhìn của bạn sẽ được hiển thị phía trên dấu hiệu xe người chơi. Đối với đồng đội, bạn cũng sẽ thấy cấp sạc Kỹ Vai trò của họ."

msgid "comp7Core29Status"
msgstr "Vai trò Xe"

msgid "comp7Core31"
msgstr "Bạn có thể tái định phím nóng cho Kỹ Vai trò và Kỹ Chiến lược trong thiết lập game."

msgid "comp7Core31Status"
msgstr "Thiết lập Điều khiến"

msgid "comp7Core32"
msgstr "Sau khoảng thời gian nhất định, bạn sẽ có thể tái chiếm Điểm Then chốt."

msgid "comp7Core32Status"
msgstr "Chi tiết về Điểm Then chốt"

msgid "comp7Core33"
msgstr "Bạn không thể chiếm Điểm Then chốt cho tới khi sử dụng xong Kỹ Chiến lược tương ứng."

msgid "comp7Core33Status"
msgstr "Chi tiết về Điểm Then chốt"

msgid "comp7Core34"
msgstr "Chiếm Điểm Then chốt sẽ đem lại cho bạn một lượng Điểm Thanh thế."

msgid "comp7Core34Status"
msgstr "Chi tiết về Điểm Then chốt"

msgid "comp7Core35"
msgstr "Xem quy tắc của sự kiện để tìm hiểu thêm về cách kiếm Điểm Thanh thế."

msgid "comp7Core35Status"
msgstr "Chi tiết về Điểm Thanh thế"

msgid "comp7Core37"
msgstr "Chế độ có các hệ số điều chỉnh làm thay đổi đặc tính kỹ thuật của xe, chẳng hạn như sức kháng cự, thời gian chờ hồi vật phẩm, thời gian bị lộ hình, v.v..."

msgid "comp7Core37Status"
msgstr "Hệ số Chỉnh Cường kích"

msgid "comp7Core5"
msgstr "Tùy theo vai trò, mỗi xe có một kỹ thuật đặc biệt với ba cấp sạc. Cấp sạc càng cao khi kích hoạt, hiệu ứng sẽ càng mạnh."

msgid "comp7Core5Status"
msgstr "Chi tiết về Kỹ Vai trò"

msgid "comp7Core6"
msgstr "Điểm Thanh thế có thể kiếm được nhờ hiệu suất ấn tượng trong trận, chiếm Điểm Then chốt, sử dụng kỹ thuật, v.v..."

msgid "comp7Core6Status"
msgstr "Chi tiết về Điểm Thanh thế"

msgid "comp7Core8"
msgstr "Người chơi sẽ không có thông tin gì về xe địch cho tới khi chúng bị phát hiện."

msgid "comp7Core8Status"
msgstr "Sương Chiến tranh"

msgid "comp7Light7"
msgstr "Bạn có thể tìm hiểu thêm về Cường kích Giản thể bằng cách click nút CHI TIẾT SỰ KIỆN ở màn hình tương ứng."

msgid "comp7Light7Status"
msgstr "Chi tiết Chế độ"

msgid "comp7Light9"
msgstr "Với một bộ sưu tập xe Cấp VIII ở nhiều vai trò khác nhau, bạn luôn có thể chọn ra chiếc tối ưu nhất ở bất cứ trận nào, cũng như ứng biến cho hợp đồng đội."

msgid "comp7Light9Status"
msgstr "Mở rộng Ga-ra"

msgid "comp7NightMaps38"
msgstr "Bản đồ Đêm làm các chiến trường quen thuộc thú vị hơn với ánh sáng mù mờ, Đồn Quan sát mới, cập nhật Điểm Then chốt, điều chỉnh cơ chế phát hiện."

msgid "comp7NightMaps38Status"
msgstr "Bản đồ Đêm"

msgid "comp7Ranked0"
msgstr "Đánh giành Điểm Xếp hạng để leo lên bậc cao nhất và chứng tỏ tài nghệ thượng thừa của mình."

msgid "comp7Ranked0Status"
msgstr "Hệ thống Xếp hạng"

msgid "comp7Ranked1"
msgstr "Càng ghi được nhiều Điểm Thanh thế trong trận, số Điểm Xếp hạng thu về sẽ càng nhiều khi thắng, và càng ít bị mất nếu thua."

msgid "comp7Ranked1Status"
msgstr "Điểm Thanh thế và Điểm Xếp hạng"

msgid "comp7Ranked2"
msgstr "Trong Cường kích, các trận đánh được lập thành giữa những người chơi có bậc tương đương."

msgid "comp7Ranked20"
msgstr "Rời khỏi trận chiến trước khi nó kết thúc khiến đồng đội chịu bất lợi lớn. Làm thế còn bị cấm chơi trong một khoảng thời gian và trừ Điểm Xếp hạng."

msgid "comp7Ranked20Status"
msgstr "Đào ngũ"

msgid "comp7Ranked26"
msgstr "Chỉ những người chơi bậc Champion và Legend mới được hiển thị trên Bảng Xếp Hạng. Mọi game thủ đứng trong Bảng Xếp Hạng sẽ có phần thưởng mỗi ngày."

msgid "comp7Ranked26Status"
msgstr "Bảng Xếp Hạng"

msgid "comp7Ranked27"
msgstr "Những kẻ đào ngũ sẽ tạm thời bị cấm tham gia chế độ game này. Thời lượng phạt sẽ tăng lên với mỗi lần tái phạm tiếp theo."

msgid "comp7Ranked27Status"
msgstr "Tạm thời Cấm chơi"

msgid "comp7Ranked28"
msgstr "Đánh trong chế độ game này để mở khóa các chi tiết mới cho kiểu mẫu cấp tiến của Cường kích."

msgid "comp7Ranked28Status"
msgstr "Kiểu mẫu Cấp tiến"

msgid "comp7Ranked2Status"
msgstr "Người chơi Đáng trọng"

msgid "comp7Ranked3"
msgstr "Bậc Legend chỉ trao cho những người giỏi nhất trong số những người giỏi. Để đạt bậc này, bạn cần đứng Top 10% game thủ trên Bảng Xếp hạng theo Điểm Xếp hạng ghi được."

msgid "comp7Ranked36"
msgstr "Xin vui lòng chú ý: Nếu rời khỏi trận trước khi nó kết thúc, bạn sẽ mất nhiều Điểm Xếp hạng hơn cả những thất bại nặng nề nhất."

msgid "comp7Ranked36Status"
msgstr "Đào ngũ"

msgid "comp7Ranked3Status"
msgstr "Legend"

msgid "comp7Ranked4"
msgstr "Nếu ngừng chơi chế độ Cường kích, bạn sẽ mất Điểm Xếp hạng. Quy định này áp dụng cho bậc Silver, Gold, Champion và Legend."

msgid "comp7Ranked4Status"
msgstr "Không đánh Xếp hạng"

msgid "comp7Ranked7"
msgstr "Bạn có thể tìm hiểu thêm về Cường kích bằng cách click nút CHI TIẾT SỰ KIỆN ở màn hình tương ứng."

msgid "comp7Ranked7Status"
msgstr "Chi tiết Chế độ"

msgid "comp7Ranked9"
msgstr "Với một bộ sưu tập xe Cấp X ở nhiều vai trò khác nhau, bạn luôn có thể chọn ra chiếc tối ưu nhất ở bất cứ trận nào, cũng như ứng biến cho hợp đồng đội."

msgid "comp7Ranked9Status"
msgstr "Mở rộng Ga-ra"

msgid "devMaps0"
msgstr "Vị trí sự kiện ngẫu nhiên sẽ được đánh dấu bằng\nkhói trên chính địa hình và chỉ báo ở bản đồ con.\nBạn có thể tắt bỏ những bản đồ này trong thiết lập trò chơi ở tab Game."

msgid "devMaps0Status"
msgstr "Bản đồ Có Sự kiện Ngẫu nhiên"

msgid "devMaps1"
msgstr "Xe của bạn có thể bị phá hủy khi nằm trong khu vực sự kiện ngẫu nhiên (ví dụ, máy bay rơi).\nNhững bản đồ như thế tắt bỏ được trong thiết lập trò chơi ở tab Game."

msgid "devMaps1Status"
msgstr "Bản đồ Có Sự kiện Ngẫu nhiên"

msgid "dualGunVehicles"
msgstr "Xe với hệ thống súng đôi"

msgid "epicModeHiddenFeatures"
msgstr "Bậc thầy Chiến tuyến"

msgid "epicModeIntroduction"
msgstr "Đặc trưng Chế độ"

msgid "epicModeUseful"
msgstr "Tìm hiểu Chiến tuyến"

msgid "epicRandom0"
msgstr "Bạn sẽ có thể gặp một số vấn đề nhỏ về hiệu suất game ở chế độ đánh này."

msgid "epicTip1"
msgstr "Khi một căn cứ bị chiếm, tất cả xe của phe phòng thủ còn ở trong khu vực sẽ hứng chịu bom oanh tạc."

msgid "epicTip10"
msgstr "Ngoài danh vọng và thắng lợi, cấp bậc cũng mang lại cho bạn nhiều lợi ích tuyệt vời sau mỗi trận."

msgid "epicTip11"
msgstr "Chiến tuyến bao gồm rất nhiều cách mới để kiếm XP và bạc."

msgid "epicTip12"
msgstr "Chiến tuyến sẽ thay đổi khi đẩy ngược phe đối phương trở lại. Điều này cũng giúp bạn tái xuất gần với mục tiêu của mình hơn."

msgid "epicTip13"
msgstr "Khi một xe trong vòng tròn chiếm đóng bị sát thương, tiến trình chiếm của xe đó sẽ bị chặn lại trong một khoảng thời gian."

msgid "epicTip14"
msgstr "Kích hoạt và tăng cường Quân Dự bị Chiến đấu ở màn hình đặc biệt. Sử dụng chúng để phá thế trận của địch."

msgid "epicTip15"
msgstr "Bạn luôn có khả năng thay đổi mặt trận ở Màn hình Tái xuất nếu chiến thuật cần điều đó."

msgid "epicTip16"
msgstr "Đừng bao giờ đi vào các khu vực được bảo vệ. Hệ thống pháo địch sẽ ngay lập tức khai hỏa vào bạn."

msgid "epicTip17"
msgstr "Mắc kẹt đâu đó trên bản đồ? Hãy dùng ngay chức năng bỏ xe (phím J theo mặc định) để rời khỏi tình huống đó và bắt đầu lại."

msgid "epicTip18"
msgstr "Mở kiểu bản đồ con lớn hơn (phím M theo mặc định) để xem tổng quan trận địa tốt hơn."

msgid "epicTip19"
msgstr "Bạn sẽ chỉ nhận được thông tin liên lạc từ các đồng đội thuộc cùng bản đồ con hiện tại."

msgid "epicTip2"
msgstr "Chiến tuyến mang lại rất nhiều phần thưởng lớn nếu đó là điều bạn mong muốn."

msgid "epicTip20"
msgstr "Bạn có thể điều chỉnh khu vực hiển thị của bản đồ con với con lăn chuột khi đang chỉ vào nó bằng trỏ chuột."

msgid "epicTip21"
msgstr "Bạn có thể làm nổi bật các căn cứ và mục tiêu cho đồng đội bằng cách click vào chúng trên bản đồ con."

msgid "epicTip22"
msgstr "Khi hết tăng, hãy thử dùng chế độ Camera Tự do. Bằng cách này, bạn có thể lên kế hoạch và lập chiến lược cho mình trong khi chờ quay lại trận địa."

msgid "epicTip23"
msgstr "Khi một căn cứ đang bị chiếm nhưng hết thời gian đánh, trận đấu bước vào giai đoạn bù giờ. Cuộc chiến sẽ tiếp tục cho đến khi không còn giao tranh ở tất cả các căn cứ."

msgid "epicTip3"
msgstr "Trong chế độ Chiến tuyến, trận địa bao trùm 9 km², rộng hơn 9 lần kích thước của bất kỳ bản đồ nào thường thấy."

msgid "epicTip4"
msgstr "Thời gian đánh sẽ được tăng thêm mỗi lần chiếm đóng một khu vực. Khu vực cuối cùng cũng mang lại thêm thời gian."

msgid "epicTip5"
msgstr "Nếu xe của bạn bị tiêu diệt khi giao tranh, nó sẽ cần một khoảng thời gian để được sửa chữa. Hãy chọn xe khác và tiếp tục cuộc chiến."

msgid "epicTip6"
msgstr "Thêm một xe sẽ được đưa vào biên chế dự bị của bạn sau mỗi 5 phút."

msgid "epicTip7"
msgstr "Phe tấn công chỉ có thể vào được khu vực tuyến hai nếu đã chiếm khu vực tuyến đầu ở cùng mặt trận."

msgid "epicTip8"
msgstr "Khi mọi khu vực tuyến đầu bị chiếm, tất cả các khu vực tuyến hai sẽ bị yếu đi."

msgid "epicTip9"
msgstr "Thắng trận bằng cách tiêu diệt sạch phe đối thủ hoàn toàn có khả năng xảy ra. Chỉ có điều, xác suất là RẤT NHỎ."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Tuân theo các Quy định"

msgid "howToPlay"
msgstr "Cách Chơi"

msgid "mapbox0"
msgstr "Các xe nằm trong khu vực thời tiết cục bộ không thể phát hiện các xe bên ngoài và ngược lại; đồng thời, việc trao đổi thông tin về vị trí đối phương ra ngoài khu vực cũng bị gián đoạn. Lửa gây thiệt hại cho mọi xe."

msgid "mapbox0Status"
msgstr "Thời tiết cục bộ"

msgid "payAttention"
msgstr "Lưu ý"

msgid "ranked1"
msgstr "Bạn nhận được nhiều XP hơn do đã tác chiến đúng theo vai trò của xe mình! Cụ thể mục đích chiến đấu và động thái tương ứng khi giao tranh của các loại xe tăng được thông báo trong Ga-ra tại trang thông tin Chi tiết Chế độ."

msgid "ranked10"
msgstr "Khi thăng tiến qua Trận đánh Xếp hạng, bạn sẽ có thể mua các xe độc đáo và chi tiết tùy biến bằng trái phiếu (gồm cả giảm giá). Để xem danh sách cụ thể, hãy click vào hình tương ứng.\nBạn không thể sờ đến hàng hóa hay giảm giá khi mùa kết thúc."

msgid "ranked11"
msgstr "Trận Chiến lợi Hàng ngày chỉ khả dụng trong các Hạng đấu. Chúng được thu về dựa trên kết quả của Vòng loại và nhờ hoàn thành các nhiệm vụ đặc biệt. Trận Chiến lợi Hàng ngày không được cộng dồn sang hôm sau."

msgid "ranked12"
msgstr "Vào cuối năm, những người chơi hiệu quả nhất sẽ góp mặt trong Bảng Xếp hạng. Họ sẽ thu về một phù hiệu bổ sung và tận hưởng sự vinh hạnh cùng tôn trọng của cộng đồng."

msgid "ranked13"
msgstr "Một số Bậc là cố định. Sau khi đạt được Bậc này, bạn không thể mất nó. Bậc cố định giữa-giai đoạn được cung cấp kèm một chỉ báo bổ sung. Các Bậc khởi đầu của mỗi Phân cấp cũng cố định và không thể bị mất."

msgid "ranked2"
msgstr "Bạn nhận được Trận Chiến lợi Tiêu chuẩn và Hàng ngày nhờ đạt đến Phân cấp tiếp theo hay Hạng đấu. Một Trận Chiến lợi tự động gấp đôi số quân hàm thu về sau trận đánh, và không áp dụng nếu chưa đạt yêu cầu. Bạn chỉ có thể dùng một Trận Chiến lợi mỗi ngày cho từng xe Cấp X."

msgid "ranked3"
msgstr "Luôn để ý Giờ Cao điểm: Nếu đã bỏ lỡ nó, bạn phải đợi tới ngày hôm sau để tiếp tục tham chiến các Trận đánh Xếp hạng và sẽ nhận được thông báo tương ứng."

msgid "ranked4"
msgstr "Một số Bậc có \"khiên\" bảo vệ. Khi thua ở những Bậc đó, khiên bảo vệ sẽ bị suy yếu nhưng không khiến bạn xuống Bậc. Nếu khiên Bậc chưa vỡ hoàn toàn, khi nhận quân hàm ở Bậc có khiên sẽ hoàn toàn khôi phục khiên này."

msgid "ranked5"
msgstr "Đừng bao giờ bỏ cuộc! Một quân hàm sẽ được trao tặng cho không chỉ Top 7 người chơi bên phe thắng mà còn cho game thủ tốt nhất phe thua. Nhớ rằng, số quân hàm thu về sẽ nhân đôi với Trận Chiến lợi."

msgid "ranked6"
msgstr "Sau khi hoàn tất mọi Phân cấp, người chơi sẽ đạt đến một trong ba Hạng: Gold, Silver hoặc Bronze. Tiếp tục tham chiến để cải thiện kết quả chiến đấu, tăng hiệu suất và đoạt lấy vị thứ trên Bảng Xếp Hạng."

msgid "ranked7"
msgstr "Người chơi nhận được một Giơ-tông Bậc cho mỗi Phân cấp hoàn tất. Game thủ với hiệu suất tốt nhất ba Mùa giải sẽ thu về phần thưởng cuối cùng xứng đáng."

msgid "ranked8"
msgstr "Vào cuối Mùa giải, những người chơi xuất sắc nhất sẽ nhận được một phù hiệu và kiểu mẫu độc đáo. Hai phần thưởng này là niềm kiêu hãnh, là biểu tượng cho phong độ và đẳng cấp vượt trội của họ."

msgid "ranked9"
msgstr "Bạn nhận được trái phiếu cho những thành tích trong Trận đánh Xếp hạng. Trái phiếu có thể quy đổi lấy ứng dụng kỹ thuật và thiết bị tiên tiến. Ngoài ra, còn có nhiều phần thưởng giá trị khác: Bạc, vật phẩm, v.v..."

msgid "rankedStatus1"
msgstr "XP cho việc sử dụng xe đúng vai trò"

msgid "rankedStatus10"
msgstr "Mặt hàng Trận đánh Xếp hạng"

msgid "rankedStatus11"
msgstr "Trận Chiến lợi Hàng ngày"

msgid "rankedStatus12"
msgstr "Top Người chơi của Năm"

msgid "rankedStatus13"
msgstr "Quy định Chế độ"

msgid "rankedStatus2"
msgstr "Trận Chiến lợi"

msgid "rankedStatus3"
msgstr "Giờ Cao điểm"

msgid "rankedStatus4"
msgstr "Quy định Chế độ"

msgid "rankedStatus5"
msgstr "Quy định Chế độ"

msgid "rankedStatus6"
msgstr "Chiến trận trong Hạng đấu"

msgid "rankedStatus7"
msgstr "Phần thưởng Hàng năm"

msgid "rankedStatus8"
msgstr "Phần thưởng Cuối Mùa"

msgid "rankedStatus9"
msgstr "Phần thưởng Bậc"

msgid "security"
msgstr "An toàn là Trên hết"

msgid "technicalAdvice"
msgstr "Khuyến cáo Kỹ thuật"

msgid "tip0"
msgstr "Đất lầy lội làm giảm tốc độ xoay và khả năng cơ động của xe khá nhiều."

msgid "tip100"
msgstr "Hiệu suất của một thành viên kíp lái ảnh hưởng đến các đặc tính xe tương ứng."

msgid "tip101"
msgstr "Tính năng Giác quan Thứ 6 cho phép Chỉ huy ý thức được liệu xe mình đã bị địch phát hiện hay chưa."

msgid "tip102"
msgstr "Hiệu quả kỹ năng là thông số quyết định mức hữu dụng của mọi kỹ năng mà một thành viên kíp lái đã học."

msgid "tip103"
msgstr "Bạn có thể đổi chuyên môn của thành viên kíp lái khi tái đào tạo."

msgid "tip106"
msgstr "Thiết bị giúp cải thiện hiệu quả chiến đấu của kíp lái và các đặc tính xe."

msgid "tip107"
msgstr "Xe đã nghiên cứu hết toàn bộ mô-đun và các phương tiện tiếp sau sẽ đạt được trạng thái \"Elite\"."

msgid "tip108"
msgstr "Kinh nghiệm Chiến đấu kiếm được ở các xe \"Elite\", kể cả những phương tiện Premium, có thể quy đổi thành Kinh nghiệm Tự do."

msgid "tip11"
msgstr "Sử dụng các bụi rậm và tán cây để ngụy trang Pháo Chống tăng của bạn. Chú ý rằng xe đứng yên sẽ khó bị phát hiện hơn."

msgid "tip111"
msgstr "Đôi lúc chiếm căn cứ là cách chiến thắng đơn giản và an toàn hơn so với việc tiêu diệt tất cả tăng địch."

msgid "tip114"
msgstr "Chia sẻ tài khoản là vi phạm Quy định của Game và có thể dẫn đến việc mất quyền truy cập vào tài khoản đó."

msgid "tip115"
msgstr "Quy định của Game cấm việc chia sẻ tài khoản. Những người vi phạm có thể mất vĩnh viễn các tài khoản đó."

msgid "tip116"
msgstr "Mật khẩu của bạn càng phức tạp càng tốt."

msgid "tip117"
msgstr "Hãy thường xuyên thay đổi mật khẩu của bạn."

msgid "tip118"
msgstr "Quy định của Game cấm việc mua bán tài khoản. Nếu vi phạm, bạn có thể mất tài khoản của mình."

msgid "tip119"
msgstr "Đừng vào những liên kết dẫn tới các website lạ. Bạn rất dễ bị lừa đảo hoặc bị \"hack\"."

msgid "tip120"
msgstr "Bạn chỉ nên mua vàng ở trang chính thức của World of Tanks. Nếu cố mua ở các website khác, bạn rất dễ gặp rủi ro và mất tiền vô ích."

msgid "tip121"
msgstr "Tính năng \"Lưu mật khẩu\" có thể tiện lợi, song kém an toàn."

msgid "tip122"
msgstr "Trên trang chủ trò chơi, bạn sẽ tìm được những hướng dẫn bảo mật tài khoản của mình. Hãy đọc chúng thật kỹ."

msgid "tip123"
msgstr "Khi đang trong trận, hãy giữ phím Ctrl để hiển thị con trỏ chuột."

msgid "tip124"
msgstr "Để sửa một mô-đun, hãy sử dụng Bộ Sửa chữa. Để cứu thương một thành viên kíp lái, hãy dùng Bộ Sơ Cứu."

msgid "tip125"
msgstr "Để sử dụng vật phẩm và chuyển đổi giữa nhiều loại đạn, hãy dùng các phím tắt (mặc định là 1-6)."

msgid "tip126"
msgstr "Trong chế độ nhìn của Pháo, để di chuyển camera ngay lập tức, hãy click chuột phải vào chỗ cần đến ở bản đồ con."

msgid "tip127"
msgstr "Để đổi cách hiển thị danh sách đội chơi, hãy ấn Ctrl+Tab."

msgid "tip128"
msgstr "Click chuột phải vào tên người chơi trong bảng đội ở rìa màn hình để xem các tác vụ khả dụng."

msgid "tip129"
msgstr "Để tố cáo người chơi, hãy click chuột phải vào tên game thủ đó trong bảng đội ở rìa màn hình và chọn nút tương ứng từ menu ngữ cảnh."

msgid "tip130"
msgstr "Bộ tín hiệu khả dụng ở Bảng Lệnh Điều khiển sẽ thay đổi tùy vị trí trỏ chuột của bạn: Đang chỉ vào một địa hình đặc biệt, đồng đội, xe địch hay vật thể."

msgid "tip131"
msgstr "Để chọn một tín hiệu trong Bảng Lệnh Điều khiển, hãy giữ phím T hoặc Z và di chuyển chuột để bật sáng tín hiệu cần phát ra."

msgid "tip132"
msgstr "Sử dụng các phím tắt F2–F8 để chọn nhanh tín hiệu trong Bảng Lệnh Điều khiển."

msgid "tip134"
msgstr "Cư xử thô lỗ không phải là cách để thuyết phục đồng đội rằng bạn đúng. Thêm vào đó, các quy định của game không cho phép những hành động này."

msgid "tip135"
msgstr "Đồng đội chỉ sẵn lòng hỗ trợ những người chơi cư xử đúng đắn."

msgid "tip136"
msgstr "Cuộc chiến thực sự phải diễn ra trên bản đồ, không phải trong khung chat."

msgid "tip137"
msgstr "Đừng gửi các thông điệp lung tung vào ô chat, vì chúng sẽ làm những người chơi còn lại mất tập trung khỏi trận đánh."

msgid "tip138"
msgstr "Sử dụng chức năng Tố cáo khi có bất kỳ hành vi vi phạm quy định nào của game."

msgid "tip139"
msgstr "Khi đưa người chơi vào Sổ Đen, bạn sẽ không còn nhận được những thông điệp cũng như lời mời từ họ ngay lập tức."

msgid "tip14"
msgstr "Chế độ Ngắm Tự động không đảm bảo chính xác 100%. Những người chơi kinh nghiệm sẽ tự ngắm bằng tay."

msgid "tip140"
msgstr "Chức năng che các từ khó chịu có thể được bật lên trong mục Thiết lập."

msgid "tip141"
msgstr "Có thể tắt chức năng chat trong trận đánh ở mục Thiết lập. Dù vậy, chat Trung đội sẽ vẫn được hiển thị."

msgid "tip142"
msgstr "Trong khi bạn cãi nhau với đồng đội, phe địch thoải mái tiến quân và dễ dàng thắng trận."

msgid "tip143"
msgstr "Luôn bám sát diễn biến trận đánh. Chỉ cần một sơ suất thôi là có thể thua cuộc."

msgid "tip144"
msgstr "Khi sử dụng các bản chỉnh sửa (\"mod\") bị cấm hay tham gia dàn xếp trận đấu, bạn có nguy cơ mất vĩnh viễn tài khoản của mình."

msgid "tip146"
msgstr "Bạn sẽ chịu nhiều hình phạt nếu vi phạm các Quy định của Game và có thể bị khóa tài khoản."

msgid "tip147"
msgstr "Nếu bị phạt vì vi phạm các Quy định của Game, chúng tôi kiên quyết mời bạn đọc lại chúng một lần nữa để không tái phạm trong tương lai."

msgid "tip148"
msgstr "Quy định của Game áp dụng cho tất cả mọi người chơi, cũng như trách nhiệm phải nhận khi vi phạm chúng."

msgid "tip149"
msgstr "Không thể vào trận? Hãy thử bỏ hết các bản chỉnh sửa (\"mod\") và khởi động lại game."

msgid "tip150"
msgstr "Số khung hình trên giây (FPS) quá thấp? Hãy thử giảm chất lượng đồ họa trong mục Thiết lập."

msgid "tip151"
msgstr "Số khung hình trên giây (FPS) quá thấp và méo dạng hình ảnh? Hãy thử cập nhật driver card màn hình của bạn."

msgid "tip152"
msgstr "Độ trễ (ping) quá cao khi sử dụng 3G hoặc Wi-Fi? Hãy thử kết nối Internet bằng dây cáp."

msgid "tip153"
msgstr "Xe bạn biến mất rồi đột ngột xuất hiện ở chỗ khác, hoặc khai hỏa nhưng chờ một lúc đạn mới bay ra? Hãy kiểm tra lại kết nối mạng."

msgid "tip154"
msgstr "Một phần mềm chống virus đáng tin cậy sẽ bảo đảm phần cứng và game chạy ổn định."

msgid "tip155"
msgstr "Đồng đội không nghe thấy bạn trong trận đánh? Hãy kiểm tra thiết lập giao tiếp âm thanh."

msgid "tip156"
msgstr "Cung cấp càng nhiều chi tiết cho bộ phận Hỗ trợ Người chơi, vấn đề của bạn sẽ được giải quyết càng nhanh."

msgid "tip157"
msgstr "Trước khi liên hệ bộ phận Hỗ trợ Người chơi, hãy chắc chắn rằng bạn vẫn gặp vấn đề đó sau khi loại bỏ mọi bản chỉnh sửa (\"mod\") trong trò chơi."

msgid "tip158"
msgstr "Thêm số điện thoại giúp bảo vệ tài khoản của bạn tránh bị xâm nhập trái phép (\"hack\")."

msgid "tip159"
msgstr "Hãy chắc chắn rằng số điện thoại thêm vào tài khoản của bạn còn hoạt động, vì điều đó sẽ giúp khôi phục khả năng truy cập tài khoản nhanh chóng."

msgid "tip160"
msgstr "Bằng cách liên kết số điện thoại di động vào tài khoản, bạn có thể thay đổi địa chỉ email đã đăng ký."

msgid "tip161"
msgstr "Nếu nghi ngờ có truy cập trái phép vào tài khoản của bạn, hãy liên hệ ngay với Trung tâm Chăm sóc Khách hàng."

msgid "tip162"
msgstr "Đừng nhận quà từ người lạ."

msgid "tip163"
msgstr "Chọn mục phù hợp trong bộ phận Hỗ trợ Người chơi để có được câu trả lời nhanh nhất cho vấn đề của bạn."

msgid "tip164"
msgstr "Một người chơi pháo kinh nghiệm có thể định vị được Pháo Tự hành đối phương qua \"vết\" đạn và tiêu diệt gọn, nếu kẻ địch đó không thay đổi vị trí bắn."

msgid "tip165"
msgstr "Bình Chữa Cháy Tự động giúp giảm xác suất cháy động cơ và dập tắt lửa ngay lập tức."

msgid "tip166"
msgstr "Khi bắn pháo, hãy cân nhắc cẩn thận đường đạn, tốc độ đạn bay cũng như địa hình địa vật."

msgid "tip167"
msgstr "Luôn để ý đến đồng đội và quân địch trên Bản đồ con."

msgid "tip168"
msgstr "Khai hỏa khi đang do thám \"thụ động\" sẽ làm lộ vị trí nấp của bạn. Bạn kiếm được thêm kinh nghiệm và bạc cho việc phát hiện quân địch."

msgid "tip169"
msgstr "Hãy sử dụng Bộ Sửa chữa để sửa nhanh hệ thống xích bị hư hại. Một khi xe bạn có thể di chuyển được, hãy cố gắng rút khỏi làn đạn của địch."

msgid "tip17"
msgstr "Một mục tiêu giáp rất tốt mà không thể bị đánh bại bởi Đạn Xuyên Giáp (AP) vẫn có khả năng chịu thiệt hại từ Đạn Nổ Mạnh (HE)."

msgid "tip170"
msgstr "Giống như bụi rậm, cây đổ cũng có khả năng che giấu xe tăng của bạn."

msgid "tip171"
msgstr "Đá tảng và hào sâu có thể làm xe bạn không di chuyển được."

msgid "tip173"
msgstr "Bạn có thể chuyển kíp lái sang một xe Premium cùng loại và chung quốc gia mà không cần phải đào tạo lại."

msgid "tip174"
msgstr "Kíp lái bị thương sẽ chiến đấu kém hiệu quả hơn."

msgid "tip176"
msgstr "Để lấy quà, người nhận phải đăng nhập vào mục Quản lý Tài khoản của mình."

msgid "tip177"
msgstr "Không thể kháng án phạt cho việc phá hủy/làm hư hại xe đồng đội trong bất cứ trường hợp nào."

msgid "tip178"
msgstr "Liên hệ bộ phận Hỗ trợ Người chơi để biết rõ lý do treo tài khoản của bạn."

msgid "tip179"
msgstr "Trước khi tạo đơn hỏi bộ phận Hỗ trợ Người chơi về vấn đề mất xe, hãy kiểm tra và chắc chắn rằng bạn đã tắt bộ lọc phương tiện trong game."

msgid "tip180"
msgstr "Bạn có thể điều chỉnh âm lượng bằng cách dùng thanh trượt Âm lượng Chung hoặc thay đổi thiết lập tương ứng trong hệ thống của mình."

msgid "tip181"
msgstr "Chọn thiết bị âm thanh của bạn—\"HT Âm thanh 2.0/2.1\" hoặc \"Tai nghe\"—trong mục thiết lập tương ứng để có trải nghiệm tốt nhất."

msgid "tip182"
msgstr "Để các hệ thống âm thanh cấu hình thấp đạt hiệu suất tốt nhất, hãy chọn bộ tiền lập có tên \"Laptop\"."

msgid "tip183"
msgstr "Sử dụng chế độ ban đêm để giảm những âm thanh chói tai."

msgid "tip184"
msgstr "Bạn có thể sử dụng tùy chọn \"Tăng cường tần số thấp\", nhưng kết quả sẽ không giống nhau và tùy từng hệ thống âm thanh."

msgid "tip185"
msgstr "Xe bánh lốp hạng nhẹ sở hữu độ cơ động vào hàng bậc nhất, cho phép chúng chiếm lĩnh các vị trí chiến lược hoặc tìm địa điểm nấp an toàn trước bất kỳ loại xe nào."

msgid "tip186"
msgstr "Các xe này được vũ trang với hai nòng súng có khả năng khai hỏa cùng lúc hoặc lần lượt. Nút điều khiển bắn có thể thay đổi được trong mục Thiết lập."

msgid "tip191"
msgstr "Một thiết bị có nhiều loại khác nhau và phụ thuộc vào cấp xe mà bạn muốn lắp."

msgid "tip192"
msgstr "Đối với xe Cấp VI trở lên, lắp đặt thiết bị tiêu chuẩn vào ô chủng loại tương ứng đem lại một khoản tăng cao hơn. Khi gắn vào ô khác, chỉ khoản tăng cơ bản được áp dụng."

msgid "tip193"
msgstr "Tốc độ tối đa không bị ảnh hưởng bởi cấu hình của xe. Chỉ có thể được cải thiện bằng cách lắp đặt thiết bị, biến thể dã chiến tương ứng, hoặc kíp lái có học kỹ năng phù hợp."

msgid "tip194"
msgstr "Biến thể Dã chiến cho phép bạn tinh chỉnh xe theo lối chơi của riêng mình."

msgid "tip195"
msgstr "Biến thể Dã chiến mở khóa Cấu hình Khác cho xe tương ứng. Chọn cấu hình phù hợp sẽ là \"lưỡi dao trong tay áo\" khi giao tranh."

msgid "tip196"
msgstr "Sử dụng tổ hợp phím tắt Ctrl+1 và Ctrl+2 để chuyển qua lại giữa Thiết đặt Cốt yếu hay Phụ trợ."

msgid "tip197"
msgstr "Sau khi đạt đến Cấp Biến thể Dã chiến nhất định, bạn có thể chỉ định danh mục cho ô thiết bị thứ hai."

msgid "tip198"
msgstr "Biến thể Dã chiến khả dụng cho xe Cấp VI–X đã đạt trạng thái \"Elite\". Chúng xuất hiện ngay sau khi mua đối với các xe loại đặc biệt, phần thưởng và Premium."

msgid "tip199"
msgstr "Sơ đồ Biến thể phụ thuộc trực tiếp vào loại xe và vai trò tương ứng."

msgid "tip200"
msgstr "Giúp đảm bảo một phần khả năng di chuyển khi xích chính bị đứt."

msgid "tip200Status"
msgstr "Xích Phụ"

msgid "tip201"
msgstr "Giúp đảm bảo một phần khả năng di chuyển khi xích chính bị đứt."

msgid "tip202"
msgstr "Bộ áp phản lực được dùng để tăng độ cơ động của xe, cho phép chiếm vị trí ưu thế hoặc băng qua các khu vực nguy hiểm nhanh hơn."

msgid "tip202Status"
msgstr "Xe có Bộ áp Phản lực"

msgid "tip203"
msgstr "Bấm phím TAB hoặc B để kích hoạt Trợ cấp Cá nhân"

msgid "tip204"
msgstr "Nếu súng đã được tản nhiệt đủ sau khi bắn, độ phân tán sẽ giảm đi nữa. Vòng tròn ngắm thứ hai với bánh kính bé hơn sẽ xuất hiện, vốn quyết định diện tích đạn rơi vào. Hiệu ứng này tồn tại cho đến khi phát đạn tiếp theo rời nòng."

msgid "tip204Status"
msgstr "Ngắm kép"

msgid "tip205"
msgstr "Một loại vũ khí tự động với tốc độ bắn cực cao. Hiệu quả khai hỏa được thể hiện bằng chỉ báo trên tâm ngắm."

msgid "tip205Status"
msgstr "Autogun"

msgid "tip206"
msgstr "Thành viên kíp lái có thể học tối đa sáu kỹ năng ứng với chuyên môn chính."

msgid "tip207"
msgstr "Thành viên kíp lái đa-chức-vụ có thể học kỹ năng Bonus từ chuyên môn kiêm nhiệm. Các kỹ năng Bonus này không chứa XP và không tính vào giới hạn số kỹ năng."

msgid "tip208"
msgstr "Nếu vài thành viên kíp lái trùng chuyên môn, ảnh hưởng từ tất cả các kỹ năng của họ bị tính trung bình. Để một kỹ năng hoạt động ở mức 100%, nó phải được đào tạo đầy đủ bởi mọi thành viên kíp lái chung chuyên môn."

msgid "tip209"
msgstr "Sau khi đạt giới hạn sáu-kỹ-năng, thành viên kíp lái sẽ tiếp tục tích lũy XP, vốn được quy đổi thành Sách chuyên Phổ dụng để dùng cho kíp lái khác."

msgid "tip210"
msgstr "Xe được trang bị hệ thống súng cho phép bạn chọn các chế độ bắn khác nhau tùy theo tình hình chiến đấu."

msgid "tip210Status"
msgstr "Xe có tùy chọn chế độ bắn"

msgid "tip211"
msgstr "Bộ áp phản lực được dùng để tăng độ cơ động của xe, cho phép chiếm vị trí ưu thế hoặc băng qua các khu vực nguy hiểm nhanh hơn."

msgid "tip211Status"
msgstr "Xe có Bộ áp Phản lực"

msgid "tip212"
msgstr "Súng có các thiết bị đặc biệt cho phép điều chỉnh thông số đạn trước khi bắn."

msgid "tip212Status"
msgstr "Shell Calibration System"

msgid "tip213"
msgstr "Khi dùng đạn bắn trúng một xe địch đang lộ hình, bộ hiệu chuẩn ngòi nổ trên viên tiếp theo sẽ được điều chỉnh. Nếu phát đầu xuyên giáp địch, sát thương của phát bắn tiếp theo sẽ tăng lên. Nếu không, khả năng xuyên giáp của phát tiếp theo sẽ tăng lên."

msgid "tip213Status"
msgstr "Adjustable Fuze Setter"

msgid "tip23"
msgstr "Các tăng hạng nhẹ với lớp giáp mỏng có thể bị tiêu diệt bằng cách đâm/húc."

msgid "tip25"
msgstr "Hãy dùng Đạn Nổ Mạnh (HE) để phá mô-đun cũng như sát thương kíp lái của địch."

msgid "tip28"
msgstr "Đạn Nổ Mạnh (HE) hiệu quả nhất khi bắn vào các xe có giáp bảo vệ mỏng và cabin để hở."

msgid "tip29"
msgstr "Để chặn bước tiến của xe địch và biến nó thành một mục tiêu dễ dàng bị tiêu diệt, hãy bắn vào xích."

msgid "tip30"
msgstr "Xe càng thấp càng khó bị phát hiện, đặc biệt là khi nấp trong bụi cây."

msgid "tip31"
msgstr "Hãy thử dùng các loại đạn khác nếu bạn không thể gây thiệt hại cho địch bằng đạn đang chọn."

msgid "tip32"
msgstr "Khoản tăng hiệu suất kíp lái giúp nâng cao các kỹ năng cho tổ lính, cải thiện đặc tính cơ bản của xe được vận hành tham chiến."

msgid "tip33"
msgstr "Xe đứng yên khó bị phát hiện hơn xe đang di chuyển."

msgid "tip36"
msgstr "Nếu phải đánh cận chiến, Pháo Tự hành có thể tiêu diệt xe địch bằng cách bắn trực tiếp."

msgid "tip37"
msgstr "Pháo đối phương có thể đoán được vị trí của bạn khi bạn cán đổ hàng rào và nhà cửa."

msgid "tip39"
msgstr "Bắn tập trung hỏa lực vào một mục tiêu luôn đem lại hiệu quả lớn."

msgid "tip41"
msgstr "Để xác định vị trí xe địch, hãy quan sát vệt khói mà đường đạn vạch ra khi chúng bắn."

msgid "tip42"
msgstr "Càng nhiều phương tiện nằm trong vòng tròn căn cứ địch, thời gian chiếm đóng sẽ càng ngắn. Để cướp căn cứ nhanh nhất, hãy sử dụng ba xe."

msgid "tip43"
msgstr "Nếu không phe nào áp đảo tuyệt đối trong chế độ Xung kích, bên phòng thủ sẽ giành chiến thắng khi hết giờ."

msgid "tip44"
msgstr "Hãy tránh đạn của địch khi đang chiếm đóng cứ điểm. Việc cướp căn cứ sẽ bị gián đoạn nếu như xe bạn bị hư hại."

msgid "tip45"
msgstr "Độ cơ động bị ảnh hưởng bởi loại hệ thống giảm xóc, công suất động cơ và tổng trọng lượng của các mô-đun trên xe. Có thể được cải thiện bằng cách lắp đặt thiết bị tương ứng."

msgid "tip47"
msgstr "Nhà cửa và xác xe có thể cản được đạn của địch. Cây và bụi rậm sẽ giúp bạn ẩn mình, nhưng không chặn được những viên đạn bắn tới."

msgid "tip48"
msgstr "Click vào Bộ Sửa chữa để phục hồi một mô-đun bị hư hại."

msgid "tip49"
msgstr "Khi bị hỏng hoàn toàn, súng sẽ không hoạt động được. Click vào Bộ Sửa chữa để phục hồi lại súng như cũ."

msgid "tip50"
msgstr "Hư hại khu vực gác chứa đạn sẽ làm giảm tốc độ nạp đạn, hoặc, trong một số trường hợp, gây phát nổ ngay lập tức."

msgid "tip56"
msgstr "Tài khoản Premium giúp tăng thêm 50% kinh nghiệm và bạc sau mỗi trận."

msgid "tip57"
msgstr "Bạn có thể dùng XP Tự do để nghiên cứu bất cứ xe, mô-đun hay biến thể nào."

msgid "tip58"
msgstr "Khi nghiên cứu mô-đun, xe và biến thể, XP Chiến đấu được sử dụng trước, sau cùng mới đến XP Tự do."

msgid "tip6"
msgstr "Mỗi loại xe có kiểu chiến đấu và chiến thuật hết sức khác nhau."

msgid "tip60"
msgstr "Bạc và kinh nghiệm được thưởng cho việc phát hiện, gây thiệt hại, tiêu diệt hoàn toàn xe địch; chiếm đóng/phòng thủ căn cứ, v.v."

msgid "tip62"
msgstr "Những phát bắn của bạn có thể làm giảm sức kháng cự (số HP) của xe địch, gây hư hại hay phá hỏng mô-đun, hoặc sát thương kíp lái."

msgid "tip65"
msgstr "Hãy tận dụng tốt địa hình, vì nó có thể giúp xe tránh đạn và ẩn nấp, không bị địch phát hiện."

msgid "tip66"
msgstr "Phe nào phối hợp tốt hơn sẽ giành chiến thắng chung cuộc."

msgid "tip67"
msgstr "Nếu hết không gian trong Ga-ra, bạn nên cân nhắc mua thêm chỗ mới hoặc bán bớt một trong các xe của mình."

msgid "tip68"
msgstr "Sử dụng Kho để bán xe, mô-đun, vật phẩm, thiết bị hoặc đạn bạn không cần nữa."

msgid "tip69"
msgstr "Nếu có ai hỏi mật khẩu của bạn, đó là lừa đảo. Đội ngũ quản trị không bao giờ cần mật khẩu vì bất kỳ lý do nào. Luôn giữ mật khẩu an toàn."

msgid "tip70"
msgstr "Chi phí sửa xe Premium rất rẻ."

msgid "tip71"
msgstr "Không được bắn vào đồng đội!"

msgid "tip75"
msgstr "Xoay tháp pháo và thân xe sẽ làm giảm độ chính xác khi bắn. Vì thế sau khi di chuyển, hãy đợi vòng ngắm thu nhỏ vào mục tiêu rồi mới khai hỏa."

msgid "tip77"
msgstr "Khả năng tăng tốc chịu ảnh hưởng bởi công suất động cơ, trọng lượng xe và loại địa hình. Có thể được cải thiện bằng cách lắp đặt thiết bị tương ứng hoặc sử dụng vật phẩm, biến thể hay kỹ năng kíp lái phù hợp."

msgid "tip78"
msgstr "Các mô-đun giảm xóc có tốc độ xoay và khả năng vượt địa hình khác nhau."

msgid "tip79"
msgstr "Một cú đâm/húc hiệu quả sẽ được quyết định bởi tỷ lệ trọng lượng, vận tốc và độ dày giáp xe."

msgid "tip81"
msgstr "Tốc độ co vòng ngắm vào mục tiêu được quyết định bởi kỹ năng của Pháo thủ, một số thiết bị và vật phẩm nhất định."

msgid "tip83"
msgstr "Chế độ Ngắm Tự động sẽ hết tác dụng khi mục tiêu đã khóa bị tiêu diệt hoặc biến mất."

msgid "tip84"
msgstr "Một xe bị bắn hạ sẽ bị khóa và giữ nguyên tình trạng không khả dụng đó trong Ga-ra cho đến khi trận đánh kết thúc."

msgid "tip85"
msgstr "Bạn chỉ có thể tham chiến bằng một xe đã được sửa chữa hoàn toàn và đầy đủ kíp lái."

msgid "tip86"
msgstr "Bạn có thể đánh dấu chọn \"Tiếp tế tự động\" và \"Sửa chữa tự động\" cho xe của mình."

msgid "tip87"
msgstr "Giáp nghiêng làm tăng xác suất đạn tới bị nảy văng đi và không xuyên."

msgid "tip88"
msgstr "Thành viên kíp lái chưa học cách vận hành một xe nhất định sẽ không thể sử dụng kỹ năng khi lái nó."

msgid "tip89"
msgstr "Bạn có thể chuyển kíp lái từ xe này sang xe khác, hoặc đưa về Doanh trại."

msgid "tip9"
msgstr "Bất cứ khi nào linh cảm thấy sự nguy hiểm, hãy di chuyển Pháo sang chỗ khác—bạn sẽ sống sót lâu hơn."

msgid "tip91"
msgstr "Bạn không thể tham chiến khi kíp lái không đầy đủ."

msgid "tip92"
msgstr "Tốc độ tiến bộ của kíp lái phụ thuộc vào hiệu quả chiến đấu của họ trên chiến trường."

msgid "tip93"
msgstr "Chỉ huy cung cấp một khoản tăng cho hiệu suất của tất cả các thành viên còn lại. Hiệu suất kíp lái cũng có thể cao thêm nữa bằng cách sử dụng một số kỹ năng đặc biệt, vài thiết bị và vật phẩm."

msgid "tip95"
msgstr "Toàn bộ Kinh nghiệm Chiến đấu thu về khi bật chế độ \"Tăng tốc Đào tạo Kíp lái\" sẽ tập trung truyền cho thành viên \"tụt hậu\" nhất."

msgid "tip98"
msgstr "Danh sách thiết bị khả dụng phụ thuộc vào cấp, loại và đặc trưng thiết kế của mỗi xe cụ thể."

msgid "tip99"
msgstr "Mọi thiết bị đều có thể được gỡ và chuyển sang xe khác."

msgid "usefulFeatures"
msgstr "Tùy chọn Hữu ích"

msgid "wheeledVehicles"
msgstr "Xe bánh lốp thuộc hàng cơ động nhất trong game"

msgid "winback1"
msgstr "Bạn có thể thoát \"Khởi động\" trong menu chọn chế độ của thiết lập Trận đấu Ngẫu nhiên."

msgid "winback1Status"
msgstr "Lưu ý"
