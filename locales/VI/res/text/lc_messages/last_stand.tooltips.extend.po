msgid "Contact/status/inBattle/last_stand"
msgstr "Trong trận Last Stand"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Bắn một phát gây thiệt hại cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Bắn một phát súng khôi phục sức kháng cự bằng cách cướp HP từ mục tiêu và các xe địch nội trong bán kính 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "advanced/ls_damageShield"
msgstr "Bảo vệ khỏi bất cứ thiệt hại nào (trừ đâm/húc, ngập nước và va chạm) trong 10 giây."

msgid "advanced/ls_doubleDamage"
msgstr "Phát bắn thành công tiếp theo của bạn sẽ sát thương gấp đôi."

msgid "advanced/ls_equipment"
msgstr "Thiết bị Chiến lược giúp bạn đánh hiệu quả hơn trong các trận Last Stand, hoàn tất Giai đoạn và đoạt thưởng giá trị. Để trang bị chúng, hãy click vào một khe Thiết bị Chiến lược."

msgid "advanced/ls_extraDamageSituational"
msgstr "Cho cơ hội gây thêm thiệt hại cho xe địch."

msgid "advanced/ls_fastReload"
msgstr "Tăng tốc độ bắn / nạp lại băng đạn."

msgid "advanced/ls_healSituational"
msgstr "Hồi một ít HP sau khi diệt xe địch."

msgid "advanced/ls_invisibility"
msgstr "Tạm thời ngăn địch khóa mục tiêu vào xe của bạn, khôi phục HP, sửa mô-đun, dập lửa, loại bỏ choáng và cứu mọi thành viên kíp lái bị thương."

msgid "advanced/ls_nitro"
msgstr "Tạm thời tăng độ cơ động cho xe."

msgid "advanced/ls_nitroSituational"
msgstr "Tạm thời tăng độ cơ động cho xe của bạn sau khi bị địch sát thương."

msgid "advanced/ls_selfRepairKit"
msgstr "Hồi phục sức kháng cự, dập lửa, loại bỏ hiệu ứng choáng và sửa mô-đun bị hư hại."

msgid "advanced/ls_teamRepairKit"
msgstr "Sửa mô-đun hư hại, dập lửa, loại bỏ hiệu ứng choáng và hồi phục một lượng HP cho xe đồng đội nội trong bán kính tác dụng."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Thiết bị Chiến lược có thể được trang bị vào những khe đặc biệt, giúp bạn đánh hiệu quả hơn trong các trận Last Stand, hoàn tất Giai đoạn và đoạt thưởng giá trị."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Ô Thiết bị Chiến lược"
