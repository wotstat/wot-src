msgid "vo_sm_char10_m05_stg21_02"
msgstr "Sĩ quan Sở Chỉ huy: Bãi đổ bộ Echo-5 đã là của ta. Xe tăng đang tiến công. Cung cấp toàn bộ hỏa lực yểm trợ."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Sĩ quan Bộ Chỉ huy: Tái điều hướng không quân để hỗ trợ xe tăng tiến lên."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Sĩ quan Bộ Chỉ huy: Các đội công binh, dọn chướng ngại cho quân ta tiến sâu hơn."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Sĩ quan Bộ Chỉ huy: Bãi biển đã an toàn. Đang gửi quân chủ lực. Làm rất tốt."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Sĩ quan Bộ Chỉ huy: Giữ vững vị trí. Tiếp viện đang đến."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Sĩ quan Bộ Chỉ huy: Bảo vệ bãi đổ bộ bằng mọi giá."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Sĩ quan Bộ Chỉ huy: Thêm xe tăng, thêm cơ hội. Lần này cẩn thận hơn nhá."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Sĩ quan Bộ Chỉ huy: Chúng ta sắp cạn lực dự bị. Chỉ huy, chắt chiu cái này vào."

