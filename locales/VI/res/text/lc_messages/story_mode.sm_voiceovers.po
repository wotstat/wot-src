msgid "vo_sm_char11_m03_stg18_03"
msgstr "Phi công: Chào lực lượng mặt đất, đây là Eagle-One."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Phi công: Chúng tôi đang bổ xuống thành phố, thấy nhiều tăng địch như kiến vỡ tổ."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Phi công: Và đã sẵn sàng thả các gói hàng. Ở dưới tránh xa ra."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Phi công: Eagle-One xin hết."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Phi công: Eagle One đây, nghe rõ."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Phi công: Các đồng chí có một nhóm mục tiêu nhỏ co cụm trong quảng trường."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Phi công: Chúng tôi đang vào hàng rải thảm."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Phi công: Cái gì còn sót lại, không nổ, các đồng chí dọn nhá. Chúc may mắn! Hết."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Phi công: Ở đâu ra thế? Tôi được đảm bảo là lực lượng không-đối-không đã làm chủ bầu trời."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Phi công: Eagle One đây, hết."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Phi công: Các đồng chí có một nhóm thiết giáp hạng nặng đang đến từ ngôi làng."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Phi công: Chúng tôi sẽ rải một đường và... Đ**!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Phi công: Tiêm kích địch hướng 8 giờ... Không cắt đuôi được."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Phi công: Đội hộ tống đâu, cái đ** m*! A-a-aaaa!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Phi công: Storm Petrel đây."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Phi công: Nghe rõ. King Tiger sắp làm thường dân rồi."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Phi công: Trời đánh thánh vật!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Phi công: Địch đã bị hạ."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Phi công: Storm Petrel. Không phải Seagull."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Phi công: Thấy rồi."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Phi công: Mục tiêu sẽ bị hạ sau 3... 2... 1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Phi công: Đang chờ mục tiêu mới, Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Phi công: Khốn nạn!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Phi công: Không chỉ có Jagdtiger dưới đó. Chúng nấp trong các tòa nhà."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Phi công: Cần thứ nặng đô hơn. Đến lúc gọi cấp trên rồi!"

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Phi công: Đã xong! Sẵn sàng cho cái tiếp theo!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Phi công: Sẵn sàng tấn công theo tín hiệu từ các đồng chí."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Phi công: Trúng trực tiếp!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr "Phi công: Nghe rõ! Đang tấn công!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Phi công: Mãi mới được! Trở lại sân bay đây. Hẹn gặp lại các đồng chí!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Phi công: Sẵn sàng và chờ có mục tiêu."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Phi công: Đang chờ xác nhận mục tiêu."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Phi công: Cần tọa độ để oanh tạc."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Phi công: Không thể bắn trúng cho đến khi nó đứng im."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Phi công: Cần mục tiêu đó bất động để oanh tạc chính xác."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Phi công: Mục tiêu tĩnh mới trúng được!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Phi công: Đang vòng lại, sớm thôi."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Phi công: Đang tái định vị, sẽ sớm trở lại."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Phi công: Sẵn sàng tấn công."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Phi công: Ra tín hiệu khi nào oanh tạc."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Phi công: Vẫn đang chờ đây."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Phi công: Tiếp tục chờ chỉ thị."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Phi công: Nghe rõ. Đang vào hàng rải thảm."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Phi công: Đã nhận. Đang vào vị trí oanh tạc."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Phi công: Rõ rồi. Đang tấn công mục tiêu."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Phi công: Đã nhận được. Đang tiếp cận để oanh tạc."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smith: Không phải bản thân tờ giấy."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smith: Ý chí của hàng triệu đồng bào. Những người đàn ông và phụ nữ đã chiến đấu để làm tờ giấy đó có ý nghĩa."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smith: Không bao giờ nữa."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Chỉ huy, Capt. Smith: Tiến lên. Nhớ đây là nhiệm vụ bí mật."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smith: Tránh giao tranh thừa và chỉ nổ súng khi thực sự cần."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smith: Nếu ta đánh động cả đồn lính, cơ hội sống gần như bằng không."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smith: Khi có thể, tìm đường vòng và nấp."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smith: Không thời gian để phí. Tiến lên. Mỗi giây đều quan trọng."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smith: Bỏ đi. Mọi người ở đây để ngăn một cuộc thảm sát. Cả hai phe."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smith: DỪNG LẠI! Lùi!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smith: Lùi lại!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smith: Lùi lại! Nhanh lên!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smith: Quay lại, ngay!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smith: Trốn!"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smith: Có vẻ không bị phát hiện."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smith: Ở trong bóng tối có lợi —địch mất nhiều thời gian hơn để nhận diện xe tăng Mỹ."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smith: Nếu đi nhanh, chúng không kịp nhận ra đâu."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smith: Murphy, dẫn đường ra sau góc đó."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smith: Hay lắm, Murphy. Nhích từng tí một. Đừng nổ súng!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smith: Lẻn lại gần hơn nữa. Chỗ đó!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smith: Đi nhanh là chúng không thấy đâu."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smith: Đi càng nhanh lên, chúng càng ít thời gian để nhận diện."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smith: Đi nhanh lên, chúng nó không kịp nhìn rõ!"

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smith: Cần do thám phía trước. Dubois, xem tình hình."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smith: Thôi ngay, Kowalski."

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smith: Chúng đang di chuyển. Dubois, quay lại."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smith: Lấy mấy cái bản đồ nào. Di chuyển."

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smith: Chết tiệt! Địch hướng 12 giờ. Kowalski, bắn!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smith: Murphy, lắc xe tránh đạn. Kowalski, kết liễu hắn nhanh."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smith: Không có thời gian để đùa. Phải giữ im lặng."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smith: Đủ rồi, Kowalski. Không thể đến chỗ quân ta nếu không có Keller."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smith: Đi nhanh trước khi có thêm ai xuất hiện."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smith: Tiger! Vào chỗ trốn! Chết tiệt."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smith: Phản đối. Không thể mạo hiểm. Keller, thử đánh lạc hướng nó đi."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smith: Keller, làm đi. Nhanh."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smith: Dùng bộ đàm radio lừa chúng."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smith: Di chuyển trước khi hắn quay lại."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smith: Dubois, tìm bản đồ đó."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smith: Chuyện gì vậy?"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smith: Vậy là thu thập các mảnh bản đồ. Di chuyển thôi."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smith: Ngon. Murphy, đánh dấu lại."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smith: Đến điểm tiếp theo. Thời gian không nhiều."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smith: Sang đồn tiếp theo."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smith: Đi tiếp. Mỗi phút rất quan trọng."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smith: Dubois, lục tìm bản đồ."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smith: Murphy, tình hình sao rồi?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smith: Ít nhất giờ ta biết các đồn chỉ huy khác. Di chuyển."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smith: Dubois? Có gì chưa?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smith: Sang điểm tiếp theo. Thời gian không nhiều."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smith: Tới lượt Dubois."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smith: Sang vị trí tiếp theo."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smith: Murphy, tình hình sao rồi?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smith: Xem thử tìm được gì."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smith: Keller, đây có phải đồn chỉ huy?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smith: Lui lại!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smith: Đừng tấn công!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smith: Không bắn!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smith: Đừng bắn! Chúng ta không đến đây vì cái đó!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smith: Bình tĩnh! Mục tiêu là chuyển thông điệp, không phải gây ra cuộc tắm máu!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smith: Lùi lại ngay! Họ sẽ phát hiện chúng ta!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smith: Rút lui! Đừng để chúng thấy!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smith: Lùi lại, Murphy! Trốn!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smith: Chưa bị phát hiện. Cứ vậy."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smith: Địch mù."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smith: Lùi lại ngay! Suýt bị phát hiện rồi!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smith: Lui lại! Địch sắp nhận ra chúng ta!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smith: Murphy, tìm chỗ trốn! Địch chưa nhận ra chúng ta là ai!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smith: Nhanh lên! Chúng vẫn chưa chắc!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smith: Vào bóng tối! Chúng không nhận ra!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smith: Murphy, quay lại! Nếu không chúng sẽ nhận ra!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smith: Tôi nghĩ nên rút lui."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smith: Không thể mạo hiểm với nhiệm vụ. Rút lui."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smith: Nhớ nhiệm vụ! Nếu rút lui an toàn hơn, thì phải làm."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smith: Thay đổi vị trí. Chúng sẽ càn quét khu này."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smith: Nhanh. Chỗ này sắp nhung nhúc Panzer rồi."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smith: Chúng đi qua rồi. Giữ thấp và im lặng."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smith: Bắn mục tiêu!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smith: Chiến đấu! Giữ tập trung!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smith: Chạm địch!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smith: Sạch! Di chuyển!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smith: Mục tiêu bị hạ!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smith: Tiêu diệt!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smith: Cứng đấy. Lần sau tìm cách khác đi."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smith: Tốt hơn là thám sát trước khi tiến vào."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smith: Lên xe tăng. Di chuyển!"

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smith: Thám sát đủ rồi. Đi."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smith: Lên xe. Đến lúc lăn bánh."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smith: Đừng phí thời gian. Di chuyển!"

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smith: Keller có thể dụ chúng đi bằng lệnh giả."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smith: Tập trung vào mục tiêu. Cần những mảnh bản đồ để cứu lính mình."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smith: Di chuyển! Không phải giờ ngủ."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smith: Mỗi giây rất quan trọng. Đi đi."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smith: Hết lựa chọn. Ta sẽ phải đánh."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smith: Tìm lối đi khác."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smith: Dùng radio. Dụ chúng ra khỏi đường."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smith: Đợi tuần tra đi đã."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smith: Xe tăng đã sửa, nhưng mất nhiều thời gian quá. Cảnh giác."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smith: Họ đang bị báo động. Thấy là bắn luôn."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smith: Từ đâu ra thế?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smith: Nó quá gần rồi. Đẩy lên!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smith: Murphy, chỉ cần đưa chúng ta đến nơi an toàn."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smith: Tiger! Phiền quá!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smith: Nó đang săn chúng ta."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smith: Không xuyên được giáp trước, nhưng nó sẽ đục ta như giấy."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smith: Chạy đi—tốc độ là lợi thế duy nhất!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smith: Pháo địch tỉnh ngủ rồi. Phải cơ động thôi!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smith: Cứ làm những gì có thể."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smith: Tiger gần rồi. Giữ khoảng cách, Murphy!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smith: Tiger quá gần rồi! Phải tách ra!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smith: Lùi lại! Nó đang ngắm chúng ta!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smith: Chúng ta trong tầm ngắm rồi! Té!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smith: Tiger bắn trượt! Đừng cho nó cơ hội nữa!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smith: Tiết kiệm đạn, bắn giáp trước Tiger vô dụng."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smith: Quên Tiger đi—lo mục tiêu nhỏ hơn."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smith: Xích đứt rồi! Nó bất động!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smith: Pháo! Quẹo phải gấp!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smith: Pháo kích! Quẹo trái!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smith: Đến kìa! Dừng hẳn!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smith: Pháo! Lắc xe né tránh!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smith: Pháo kích! Quẹo ngay!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smith: Mấy cái này ta xử được. Kowalski, thoải mái xả đạn."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smith: Cái này quất luôn. Kowalski, xả hết đạn."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smith: Đừng phí đạn vào Ferdinand!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smith: Bỏ Ferdinand—nó như thùng sắt."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smith: Mìn sau lưng rồi! Murphy, đạp hết ga, quân ta đang đợi kìa."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smith: Keller, chuyển sang tần số Đồng minh, nối máy cho tôi."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smith: Chú ý tất cả đơn vị, đây là Captain Jack Smith, Sư đoàn Thiết giáp Số 02."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smith: Chúng tôi đang tiếp cận bằng M24 Chaffee từ phía Tây."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smith: Đừng bắn. Tôi lặp lại, đừng bắn."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smith: Chúng tôi có lệnh khẩn từ Bộ Chỉ huy Quân đoàn III. Mật khẩu: \"Torch\". Hết."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smith: Về nhà rồi, anh em ơi. Cuộc chiến kết thúc."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smith: Chết tiệt. Thất bại hết rồi."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smith: Quá ồn. Mọi radar từ đây đến Berlin đều biết chúng ta ở đâu."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smith: Không phải trò bắn vịt loạn xạ đâu. Kín đáo hơn!"

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smith: Cần đi yên lặng hơn. Mỗi phát đều mang đến điều không mong muốn."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smith: Cứ bắn ầm ầm thế này, tiếp viện tới nhanh lắm. Chúng ta không kịp cứu quân mình đâu."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smith: Bắt được gì không?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smith: Có xịn không?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smith: Không."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smith: Con phố á? Làm sao? Liệt kê hết tên chúng ta à?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smith: Tập trung vào đường đi."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keller: Nie wieder."

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Liên lạc viên, Gefr. Keller: Có một... đồn chỉ huy ngay ngoài thị trấn. Họ cất bản đồ bãi mìn ở đó."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keller: Nhìn như quân tuần tra. Họ sẽ sớm đi thôi."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keller: Đồn chỉ huy với bản đồ, nó ở trên kia, trên đồi."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keller: Đó là một tăng chỉ huy."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keller: Nếu bộ đàm còn nguyên vẹn và bắt đúng tần số, tôi có thể..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keller: Nein, gửi lệnh giả cho quân tuần tra. Làm họ phân tâm. Để chúng ta lẻn qua."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keller: Vâng, thưa Captain Smith."

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keller: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Chú ý, Panzer Bốn! Hoạt động thù địch tại Điểm Sektor Berta.)"

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keller: Sofort aufklären!\n(Điều tra ngay!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keller: Đây là đồn chỉ huy."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keller: Dấu này cũng chỉ các đồn chỉ huy. Họ có những mảnh bản đồ hiện lối đi."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keller: Dành cho... trinh sát Đức. Nên tìm ở đó."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keller: Đây."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keller: Không phải sĩ quan nào cũng chịu trách nhiệm về bãi mìn."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keller: Có vẻ tìm thấy một đồn chỉ huy nữa. Kiểm tra thử."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keller: Ừ, có thể còn một mảnh bản đồ nữa."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keller: Không."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keller: Họ... họ không để ý thấy."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keller: Họ đã bỏ cuộc tìm kiếm... tạm vậy."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keller: Tôi có thể dụ họ rời khỏi đường đi của ta."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keller: Đang lên sóng."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keller: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Chú ý! Đến vị trí mới tại Sektor Berta. Thực hiện ngay!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keller: Đang nối máy."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keller: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Lệnh khẩn! Cần tập kết tại Điểm Dora!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keller: Đang chuyển tần số."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keller: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Hoạt động thù địch ở Sektor Emil! Khẩn trương điều tra!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keller: Đang phát sóng."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keller: Zurückziehen auf Stellung Gustav! Schnell! Schnell! (Rút về Vị trí Gustav!\nƯu tiên cao nhất!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keller: Đang truyền tín hiệu."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keller: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Nhóm Chiến đấu phía Bắc báo cáo gặp địch! Cần tiếp viện!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keller: Không có ai trên tần số này trong phạm vi."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keller: Không đơn vị nào phản hồi trong khu này."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keller: Không có quân Đức nào gần để nhận lệnh."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keller: Không có phản hồi. Không tăng Đức nào gần đây. Tôi nghĩ vậy."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keller: Phản đối."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keller: Tôi không thể."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keller: Vô ích."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keller: Đó là xe tăng chỉ huy trung đội, sẽ không nhận lệnh từ chúng ta."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keller: Chỉ huy trung đội... Sẽ không nhận lệnh từ chúng ta."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keller: Xe tăng của chỉ huy trung đội. Họ chỉ nhận lệnh từ Bộ Tư lệnh Tiểu đoàn."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keller: Họ cố thủ ở đây. Ra lệnh vô ích."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keller: Chiếc tăng này bị hỏng. Họ dùng nó làm lô cốt."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keller: Đây là xe tăng bị hỏng. Không thể di chuyển."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keller: Xích bị đứt. Đi đâu được?"

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keller: Achtung! Họ đang quay lại vị trí."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keller: Chúng đang quay lại. Cẩn thận."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keller: Cẩn thận! Chúng đang quay đầu."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keller: Có lẽ nên... ờ... tới đồn chỉ huy?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keller: Trước khi tuần tra đổi ca?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keller: Để thử phân tán sự chú ý của họ."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keller: Đây là đội tuần tra. Sẽ cút sớm thôi."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keller: May đấy. Có vẻ số phận muốn ta hoàn thành nhiệm vụ này."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keller: Captain, họ đang báo cáo về một chiếc tăng Mỹ chống phá."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keller: Giờ họ sẽ tìm chúng ta đấy."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keller: Tôi nghe lệnh... cử thêm tiếp viện."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keller: Đơn vị đặc biệt sẽ săn tìm chúng ta..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keller: Đây là một đội tuần tra. Nếu canh đúng, ta có thể lẻn qua."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keller: Tuần tra có lộ trình nghiêm ngặt. Có thể lẻn qua khi họ rời đi."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keller: Một đội tuần tra. Chúng sẽ cút khỏi đây sớm."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keller: Những chiếc tăng này không thể di chuyển nữa, nhưng họ dùng chúng làm hỏa lực cố định..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keller: Đơn vị đồn trú sắp hết phụ tùng, nhưng vẫn dùng những chiếc tăng này làm công sự."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keller: Thiếu nhiên liệu nên chúng chỉ làm... lô cốt."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keller: Nhưng súng vẫn nguy hiểm..."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keller: Captain...Panzer! Ngay đó!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keller: Có lẽ... có lẽ nên chậm lại?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keller: Dạ, sếp."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keller: Tháp Nghiêng Pisa mới đúng, Murphy..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keller: Radio này dùng liên lạc. Để phân tâm đám tuần tra."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keller: Tôi không muốn..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keller: Có thể thử, nhưng là nhạc Đức nha."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keller: Thực ra hơn 1000 loại."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keller: Có rồi. Ngoài cứng, trong mềm."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keller: À... thực ra... hai đội đang bàn về một con ma ám thị trấn ban đêm."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keller: Không... chẳng bao giờ nghĩ mình sẽ vào bất cứ xe tăng nào..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keller: Thật ra, tôi rất sợ. Chỉ là quá sợ để thể hiện thôi."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kowalski: Nigdy więcej."

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Pháo thủ, Sgt. Kowalski: Sao mang theo tên Đức Kraut này? Hắn sẽ đưa ta thẳng vào bẫy."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kowalski: Ồ chắc chắn rồi, tin lời thằng Đức vào cái thị trấn bẫy này."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kowalski: Gọi tất cả lính Đức đến đây?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kowalski: Chaffee không phải loại xe đánh nhau. Dù vậy... nếu Murphy…"

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kowalski: Thế làm đi, nói gì đó với chúng."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kowalski: Keller, quên tiếng Đức rồi à?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kowalski: Bảo thằng Tiger biến đê!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kowalski: Cái gì? Tưởng đồn nào cũng có mảnh bản đồ chứ. Keller?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kowalski: Ừ thì, ít ra vừa tiễn thêm vài con Panzer lên bảng đếm số."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kowalski: Ừ thì, ít ra vừa tiễn thêm vài con Panzer lên bảng đếm số."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kowalski: Còn kiếm được mấy đồn chỉ huy xịn nữa."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kowalski: Lỡ nó là…"

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kowalski: Đui mù ngu học."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kowalski: Đù! Sao không thấy ta?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kowalski: Đi trước khi mấy thằng Kraut nữa xuất hiện."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kowalski: Đui mù ngu học. Chúng không có lần sau."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kowalski: Chờ mãi! Được nện rồi!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kowalski: Sạch. Đứa nào tiếp?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kowalski: Mày xong!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kowalski: Giờ còn mạnh nữa không? Nhưng ta mất quá nhiều thời gian."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kowalski: Đừng lao vào không kế hoạch. Các sếp thấy sao?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kowalski: Dubois nên do thám xung quanh?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kowalski: Không."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kowalski: Đừng phí thời gian! Bản đồ này là vé thông bãi mìn của chúng ta."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kowalski: Đi, không tôi dùng tay đẩy tăng đấy!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kowalski: Chúng tự chuốc lấy. Cho chúng thấy gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kowalski: Ok, lần này đừng thẳng vào họng súng địch nhá."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kowalski: Okay, khởi động xong. Giờ làm thật."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kowalski: Nhìn có gì kìa!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kowalski: Bắn bất cứ lúc nào. Nhanh!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kowalski: Tới kìa! Bị phát hiện rồi!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kowalski: Tiger đang nhắm! Không thoát ngay là tiêu!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kowalski: Tiger sắp bắn... tôi biết kiểu ngắm!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kowalski: Kurde! Nếu là tôi, chắc chắn không trượt."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kowalski: Có thế thôi ư Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kowalski: Świetnie! Đúng chỗ ngứa!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kowalski: Nhìn thích quá! Mục tiêu dễ!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kowalski: Vô ích. Chọi đá có khi còn hơn!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kowalski: Murphy, quên rồi à? Mìn đầy đây này!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kowalski: Dostał!"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kowalski: Cuộc tàn sát đã bắt đầu. Chúng ta quá chậm..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kowalski: Khi có đám cưới thôi."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kowalski: Cầu hôn à, Murphy?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kowalski: Murphy, lái kiểu gì vậy."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kowalski: Cố tình nhảy ổ gà, leo dốc, làm tăng nghiêng đúng không?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kowalski: Cả đồng đội vạ lây."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kowalski: Nói thật, tôi lo cho anh đấy, Murphy."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kowalski: Tôi thật sự lo cho anh."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kowalski: Chẳng bao giờ nữa."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kowalski: Không dễ đâu."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kowalski: Trước giáo viên, giờ trong xe tăng, cậu bình thản lạ đấy, Keller."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kowalski: Ê. Nghe có vẻ... thành thật bất ngờ."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kowalski: Dubois, ngân nga gì vậy?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Vâng sếp, đã hiểu! Đang đến Điểm Berta!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Đã hiểu, đang đến Berta.)"

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Rõ sếp, bắt đầu tập kết.)"

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Rõ sếp, bắt đầu trinh sát.)"

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Đã hiểu, đang rút.)"

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Xác nhận, đang trên đường.)"

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Scharf: Chỉ huy, ta có không quân yểm trợ, nhưng ít, nên dùng đúng lúc."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Gọi không kích khi cần."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Biết công nghệ radio chứ nhỉ? Cả hòn đảo đã biết rồi."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Ưu tiên thu giữ xe đó nguyên trạng. Cấp trên muốn kiểm tra."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Giống cái gì của Đức không?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Nhìn số xe địch là biết phải có cơ sở bảo trì đâu đó"

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: Đâu đó trên hòn đảo này."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Nhanh lên. Tên lửa không chờ ai."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Bảo rồi, lẽ ra tôi phải xuống cùng. Tiến chậm như rùa."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Thử tìm cách vô hiệu hóa nó mà không hỏng nhiều. Mẫu vật phải còn nguyên."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni: Cứ thử đi. Okay?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Cực kỳ cẩn thận. Bẫy đấy."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Đã bắt được tần số radio của chúng."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Đã theo dõi sóng radio của chúng bảy phút qua."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Bớt bớt cái miệng lại, để báo cho nghe."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Thỉnh thoảng nín bớt đi, Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni: Mục tiêu mới nhận: Phải bắt sống cái xe đó, nguyên vẹn."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Có gì đặc biệt không? Mô-đun lạ? Thiết bị mới?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Chỉ huy, không muốn test con tăng mới thật à?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Với khả năng bị phục kích phía trước, có thêm hỏa lực sẽ tốt hơn."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, biết đầu bên kia không nghe được?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Đây chỉ thu sóng thôi, không phát tín hiệu ra."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Báo cáo tình hình. Chỉ gặp giáp Đức đúng không?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Biết ngay mà. Rắc rối hơn."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: Theo tin nghe lén được..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Nhắc lại: Phải bắt sống cái xe đó để phân tích. Và ok, được..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: Tôi muốn tự mình kiểm tra nó."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Đính chính: Chưa đủ bằng chứng để khẳng định là người Đức."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Tình báo hiện tại: Một tổ chức đánh thuê quốc tế."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Giọng đó... Quen lắm. Tôi đã nghe giọng chỉ huy địch ở đâu rồi..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: Vậy tốt bụng quá."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Vâng, cảm ơn."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Chuyện gì vậy?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Đây chính xác vì sao tôi đã nhấn mạnh phải thu giữ xe nguyên vẹn."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Mang xe thử nghiệm đến đây, tôi sẽ chế mấy thứ...đỉnh của chóp."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Chỉ huy, tôi đề nghị thử con tăng mới này. Biết đâu có chiêu lạ."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Thôi thì để đó cũng khôn."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Chắc sẽ còn nguyên, kỹ sư phe ta có thể thu hồi sau."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Trong số đó có con nào thử nghiệm không? Bất thường?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Nhóm Adler này... Phải điều tra mới được."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: Chúng có thể giúp sáng tỏ lai lịch chỉ huy bí ẩn kia."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Ta đang bám sát tên lửa trên radar. Thời gian hành động rất gấp."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Nhiệm vụ mới: Chiếm giữ trung tâm điều khiển bay. Có thể chỉnh quỹ đạo từ xa."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Làm ngay."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Con tăng này có gì bất ngờ?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Chiếc tăng hạng nặng mới này có giáp siêu hơn. Tối ưu đối đầu nhiều mục tiêu cùng lúc."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Chỉ huy, tôi đề nghị lấy luôn về."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Tổ kỹ thuật đang tiếp cận phòng điều khiển bay. Giữ vị trí. Cần thời gian."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Cố chặn chúng thêm tí nữa."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Được rồi, được rồi... không phải giờ!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Không thể vượt quyền điều khiển. Thử mọi cách rồi, không đổi được đường bay. Nhưng..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: Có cái hơi lạ."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Cơ hội hành động sắp hết, nhanh lắm. Đừng phí thời giờ."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Thời gian nhiệm vụ kìa! Di chuyển ngay."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Càng chậm, chúng càng có thời gian tổ chức phòng thủ."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Tiến thẳng tới mục tiêu."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Ta vừa mất con tăng đầu đàn! Giữ đội hình!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Tăng của Chỉ huy đã bị phá hủy. Đang chuẩn bị con khác."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Tiếp viện không vô hạn đâu. Cẩn thận hơn đi."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Phản ứng nhanh hơn đi, không có lần sau đâu."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Căn cứ sửa chữa của chúng chỉ có vài tăng này thôi."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Lần sau cẩn thận hơn nha."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Nhiệm vụ thất bại. Hết giờ. "

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Tất cả tăng đã mất. Xác nhận nhiệm vụ thất bại."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Không quân đã xuất kích. Chuẩn bị oanh tạc."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Máy bay đã tấn công mục tiêu. Còn vài giây trước va chạm. "

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Vị trí mục tiêu không hợp lệ để không kích."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Phát hiện pháo kích. Sang chỗ khác ngay!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Pháo địch bắn. Đạn tới sau vài giây. Chạy đi! Nhanh!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Trinh sát địch đang gọi pháo bắn chỗ ta. Rút khỏi vùng oanh tạc ngay!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Không."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Thời tiết. Nhiều mây. Nhiệt độ 8 độ. Gió 6 mét/giây, hướng Bắc–Đông Bắc."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni: Có vài giả thuyết, nhưng cần thêm bằng chứng."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Người gần nhất gọi \"cưng\" bay hai ngón tay đấy."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Nhưng tối nào đấy yên yên, đúng chỗ... Có thể cân nhắc."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, đang liều mạng vô lý đấy."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: Sống liều quá chết sớm. Như tiền nhiệm đó."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Thông minh."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Tôi sẽ coi đó là khen."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: Không phải phép thuật."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: Một xung điện từ tập trung, tạm thời gián đoạn hệ thống điện tử."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Cố sống sót trở về. Thay người giỏi tốn giấy mực lắm."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Nếu so với tôi trong câu đó,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: Nhiệm vụ tiếp theo lên Bắc Cực nhá."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Bỏ qua. Có hết giấy tờ đây."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Tất cả... cảm giác như có tính toán."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Mỗi rào cản, mỗi lớp thủ—chúng đang câu giờ, không phải chống cự."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Ta chắc đang thuộc phương trình của kẻ khác. Đây không thích làm biến số đâu."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Tôi đang tính xác suất sống sót dựa trên các biến số hiện tại của nhiệm vụ."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Không công bố kết quả. Sĩ khí cũng là một ẩn số."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Tôi đã bám theo chúng."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Chất lượng giảm 23% từ khi bắt đầu nhiệm vụ, nhưng tần suất lại tăng 47%."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Phải biết rõ đồng minh."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Không bao giờ."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Đơn vị thử nghiệm này cực nguy hiểm. Đổi chiến thuật ngay."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Tăng của Chỉ huy đã bị phá hủy. Con máy đó mạnh hơn dự tính nhiều."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Nhìn đống này! Như cáo xộc chuồng gà!"

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Quê tôi có câu, \"Sóng sau xô sóng trước, sập cả đê.\""

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Đức... Lại nữa?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: Có thằng chạy! Chặn lại trước khi nó kéo thêm băng!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Ừ, nhưng giờ đơn độc. Dễ xơi hơn nhiều khi nó có đồng bọn."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: Chuẩn bài mình rồi! Bắn trước, hỏi sau, cây súng dài kia là gì!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Thấy phát đó không?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: Cho nó chừa cái tội khoe súng xịn!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Bắt sống? Trân trọng, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: Tôi thích bắn trước, điền giấy tờ thu hồi sau."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Con đó suýt biến bọn tôi thành sắt vụn! Nhưng thôi, sẽ cố không bắn mấy thứ quan trọng..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: Chỉ nhắm gác đạn được không?"

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Nhìn kìa—lại thêm một con tăng lạ hoắc!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: Giờ tôi chẳng biết đang đánh với ai nữa."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Nó giống thứ hoàn toàn trái ngược."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Hy vọng sớm tìm được kho đạn của chúng. Không chắc mình đủ cho cả bọn."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Gục thêm một con! Tôi thích đám này rồi!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Xếp hàng, xếp hàng! Từng người một. Ai cũng có quà."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Làm tao phát điên! Đợi đã, đang tự sửa ngoài kia á?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Đợi đấy—bố mày tới tháo từng con ốc!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Cùng phe không đấy, Leni? Nó muốn giết ta mà!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Đợi đã. Hiểu rồi... Mày! Không phải CẤP TRÊN. Chính mày là người muốn sở hữu con tăng này."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Nghiện mấy... khẩu súng dài bắn xa!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Ô thế à? Tiên tri kiểu gì vậy, fräulein chiêm tinh?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Tụi nó mời đi party phục kích à?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Đang nghe lén sóng? Mà GIỜ mới nói?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: Anh cũng yêu em, Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Nhìn em ấy kìa! Đẹp hết phần người khác!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Á, nein-nein-nein! Đồ mỏng tang này không dành cho tôi. Em nó cần nâng niu nhẹ nhàng!"

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Chỉ huy, đến mà lái."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Nếu tôi lái con này, kỹ sư phe ta chắc lấy rổ đựng mất!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: Đúng bài! Chuẩn bị thẳng vào bẫy!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"Khoai to không lo chết đói!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: Đúng thứ cần! Chỉ huy, đến lúc ban phát dân chủ!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Nhìn con quái này! Chỉ huy, đi ngang không lái thử thì sống làm gì!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Có khi nên nhúng tay vào đi?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Ôi không! Đen rồi... Đen cho chúng nó, phá nát cái bẫy này!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Mục tiêu! Ha! Bắt bài Ulysses à. Lúc nào cũng mấy lệnh diễn tập y chang."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Địch? MÀY mới là địch!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Ê, Herr Phản Diện, xuống đây nói chuyện đàng hoàng coi!"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Tất nhiên biết rồi! Tôi chỉ... giữ sĩ khí cho team thôi."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: À ha, phần ghê nhất trong cái bẫy của chúng."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: Bắn đạn không xuyên được giáp ta, tụi nó chuyển sang ném đá kìa."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Mấy thằng khôn thật!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Không, đó mới lạ. Giờ chẳng phân biệt nổi đang đánh ai."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Đợi mãi! PHỤC KÍCH! Leni, còn gì nữa trong thực đơn không?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Ngài Phản Diện còn trò gì nữa không?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Không, không, đừng nói! Gợi ý cheat quá, tôi muốn tận mắt thấy! Đây sẵn sàng đón mọi thứ!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Thoát? \"Thoát\" là gì? Mình có bỏ chạy đâu!"

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: Bọn tôi đang tìm ông đấy, Mr. Scary Voice. Dạ chị Leni, em biết hắn không nghe được."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: Ôi, thằng chuột camping đó, túm được là tôi tháo từng con ốc!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: Đấy mới đúng bài. Tôi sẽ cố hết sức, Leni. "

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! Nó đã gục. Dễ đoán như đồng hồ Thụy Sĩ—mỗi tội hàng pha-ke Đức."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Ố kìa, thêm “bạn chơi”! Tôi đang lo không đủ bia bắn tập!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: Bạn cũ à? Muốn tôi rủ đi cùng không?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: Để tôi đoán—cô cũng muốn \"bắt sống\" ảnh hả?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Tôi sẽ cố hết sức."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Ối trời! Quái gì thế?! Ok, ok... cái này tôi thua. ĐÉO thể ngờ."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Cái lề gì thốn?! Đồ điện trong con tăng... đột ngột tắt hết!"

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Ê, sao ta không bắt đầu làm tăng có tuyệt chiêu nhỉ?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Có tí \"đồ chơi\" trong tăng, tôi tự tin lắm!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Hứa đấy à, fräulein? Cấm hứa lèo!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: À, hiểu rồi. Địch chơi chiêu “bỏ của chạy lấy người”."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Táo bạo đấy!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: Rõ, Ulysses. Tôi sẽ ém hàng để dùng sau."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Lạy Chúa Mein Gott, fräulein ơi! Cô mê mấy cái tăng mới này"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: hơn cả chú Pavel nhà tôi, suốt ngày nhặt gỗ thủy sinh ở tận Nam Mỹ!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Nhưng phải thừa nhận, ổng có vài cái chất như nước cất."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Ôi zời ơi, ai đó sầu não! Nhìn mặt biết ta làm tổn hương người ta rồi."

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Đừng lo, fräulein, đã hứa sẽ giao hắn cho cô mà!"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Mỗi tội không đảm bảo \"hàng\" còn nguyên, có thể...“xước xát” tí."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy: Cô tự hỏi luôn đi, tôi lo chi!"

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Ối dồi ôi... Quả tên lửa lại gần nhìn khủng bố quá!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Như chú tôi hay kể về con cá câu được — mà này TO thật!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Sao lại vậy... Gần xong mà! Bao công sức, đổ sông đổ biển hết hả?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Tôi sẽ càn hết chúng nó rồi đục thẳng đường đến trung tâm điều khiển."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Cho cái tên lửa chết tiệt đó xuống biển!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Chỉ huy, nên cầm con quái đó đi."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: Lũ chó phóng được tên lửa rồi, nhưng đừng hòng rời đảo toàn thây."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Hiểu. Tôi cũng thích mấy cái lẹ hơn kiểu nặng mông cà tàng này."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: 36 kế, tẩu vi thượng sách."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Đừng mơ chạy thoát, thò chắng! Nơi duy nhất mày \"bảy chọ\" về"

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: là phòng hỏi cung. Tao sẽ đích thân đưa mày tới."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Đưa hết bọn còn lại ra đây! Lẹ nào—"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: Đỡ tốn công tao phải đuổi khi mày cúp đuôi chạy như chó."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: Kết thúc đi!"

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Đúng lúc! Tao cần xả cơn tức."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: À, cuối cùng, thằng bạn cũ thích tự sướng cũng chịu xuất hiện, tưởng ai!"

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: Đến lúc dứt điểm chuyện này. Giờ chỉ còn một câu hỏi—"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: Ai sẽ vinh dự cho hắn đi bán phế liệu?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Ý là xưởng của Leni”."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Thế là xong. Ôi Leni à, tôi biết cô muốn nó còn nguyên, nhưng..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: Chắc trầy sơn tí tẹo."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter hả? Để ráng nhớ!"

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Biết xe tăng què ở Séc gọi là gì không? Bia tập bắn!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: Và hôm nay tao không muốn làm bia cho ai cả."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Xích mọc cả rễ rồi! Lên đường!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Chạy nhanh không hết, Chỉ huy! Phiêu lưu phía trước kìa!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Thằng cu... nòng dài đã về lại chỗ cũ. Dí nó xuống!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Chui về hang đi, thằng Long.. nòng dài si đần!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Cái định mệnh gì vậy?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Nòng dài hơn sớ người yêu cũ của dì Katarina nhà tôi!"

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: Tin đi, nói vậy là còn nhẹ!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Gì vậy? Mang luôn tiệm sửa xe trong túi hả?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Ghê bây! Thằng nòng dài sửa xong rồi! Chắc chắn đã bắn lỗ chỗ con quái đó!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Nó vá víu xong rồi! Quỷ tha ma bắt, sao hay vậy?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Cái định mệnh! Toi xe của Chỉ huy—Câu giờ tụi nó chờ sếp!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Chỉ huy bị hạ! Giữ vững, sẽ quay lại ngay!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Lại đổi xe? Đừng biến trò này thành “mốt” nha mấy thím."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: May còn xe dự phòng, đừng lầy quá rồi lại toi đấy!"

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Ê ê! Nhẹ tay thôi cha! Tui nghi tụi nó không để nhiều đồ cho mình đâu!"

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Ráng giữ con này nguyên vẹn giùm cái."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Thôi xong! Tụi nó úp sọt tao – đừng quẩy quá khi thiếu tao nhaaa!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Rồi xong, xe tao đi bụi rồi – kiếm cái khác chạy tiếp!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Bùm! Nhưng lần này là tao nổ! Ngồi yên đó, quay lại liền!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: Chết tiệt! Con quái vật to xác đó thật sự hạ tôi!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Rồi đó, ông bự, vòng này ông ăn… nhưng tao sẽ trả thù!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Alo thế giới! Lại là tui đây! Nhớ tui hônggg?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Tao quay lại đây. Tăng mới toanh. Cái cũ máy kêu cọc cạch như đánh trống… mà lỗ chỗ hơn tổ ong."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: Chết tiệt! Tao xong đời rồi. Hạ vài con trả thù đi!"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Gì? Sao vậy? Không, không, không... Không thể nào. Thua rồi sao? Tao không tin!"

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Rồi xong, bay sạch xe tăng luôn… Tức! Tức muốn xé áo luôn á trời!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Ồ, xem ai lò dò tới party kìa."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Nhìn xịn phết. Thử xem nó cháy thế nào nhé!"

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BÙM! Leni ơi, tiếc cô không thấy Chỉ huy vừa hạ con nguyên mẫu đó thế nào!"

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Làm tốt lắm, Chỉ huy! Hy vọng tụi nó còn giữ hóa đơn, vì con này không xịn như chúng tưởng."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Nói nhiều quá... Nguyên mẫu nọ, công nghệ cao siêu kia..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Tao phá hủy nó rồi! Toang toàn tập!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Tới công chuyện! Đến lúc dập vài tấm tôn!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Súng nóng hổi! Tiếp đối lễ độ luôn!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: Xong rồi, mình về! Lên đường!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Xong con cuối – đừng đứng chơi nữa, nhanh lên, đi đi!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Rồi, xong phim – ai tiếp nào?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Bùm! Này thì phiền phức!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Lại về với cát bụi! Làm tốt lắm chiến hữu!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Chơi là phải vậy – kiếm thêm đứa nữa cho xả!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: Gạt thêm thằng nữa – đứa nào lên thớt tiếp?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Con này của tôi!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Hạ gục!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Tiếp theo!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Pháo bông anh em! Ngồi chill coi tụi nó banh xác nè!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Thả bommmm! Cho tụi nó biết mùi \"bão đạn\"."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Phi công chứ có phải ông nội siêu nhân đâu!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Ủa alo, gì vậy? Bất ngờ vãi chưởng!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Xẹt! Giờ tụi nó nằm im như ăn lựu choáng – quất lẹ anh em!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Xem ra tụi nó bị cúp điện đột ngột rồi!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: Đen thôi, bọn nó cháy khét! Giờ ta xơi tái cho nhanh!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Giáp modular nghệ quá! Như chú Pavel tôi hay bảo,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"Máy hư còn sửa, tình tan thì chịu!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Kỳ quan kỹ thuật hiện đại!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Swap mảng giáp nhanh hơn thay áo!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Xe tăng mới tinh! Bóng loáng, không lỗ thủng."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Thay mảng giáp rồi hả? Giờ nhìn khác phô mai Thụy Sĩ nha!"

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Đỡ ngon mắt hẳn!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Có hóng hớt soi ta bằng ống nhòm và bộ đàm! Lăn bánh khỏi chỗ đó!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Thằng trinh sát pháo binh lượn lẹo bắt được tăm hơi tụi mình! Chạy! Cút lẹ!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Thằng đi soi nhà nó đang tô tâm ngắm vô hình lên chúng ta! Cho nó vỡ mộng! Lượn thôi ông anh!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Bom sắp tới rồi! Chạy ngay, không banh xác hết!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: Bọn nó gọi cả đại bác khủng bố! Mau lẹ cút!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Nhanh! Quất ngay mấy quả đạn xịn lúc tụi nó đang khoe mẽ!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Đang chiêu trò á! Đánh sập tiệm trước khi nó xong!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Nhìn kìa! Tụi nó vá víu như ma pháp luôn! Để ta bóc mẽ!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, chị sẽ nhỏ dãi công nghệ này! Tụi nó tự sửa ngay giữa trận!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Em có nên mang mẫu vật về không?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Ôi dồi ôi! Con này tưởng mình xe đua à! Đừng để nó hôn lên giáp nha!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Chu cha nội ơi? Xe tăng nó đeo rocket hẳn hoi á hả?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: Chỉ huy, đồ xịn tan tành rồi! Giờ phải tăng kiểu cổ lỗ sĩ!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Chỉ huy, xe tăng hết phép! Bọn nó chuyển sang bắn đạn không vui anti-fun!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni ơi, hỏi nhanh phát – tình báo có thực sự biết số lượng địch trên đảo này?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Chỉ giỏi ăn hại thôi hả?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: Ít ra cũng không phải zero hẳn!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy: Đánh thuê đồ xịn hơn mình luôn! Chắc có đại gia rót tiền mạnh lắm!"

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Uuu, bí ẩn phết! Tôi thích kiểu ninja giấu bài."

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni cưng, hết chuyện dẫn đi Prague quẩy nha!"

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Có cái quán nhỏ – bánh mì xoắn ngon số dzách, goulash khỏi chê,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: và chỗ ngồi chill, nhẹ nhàng buổi tối. Chị căng quá, nên thả lỏng!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Sống không rủi ro như goulash thiếu paprika—nhạt toẹt, chẳng ra gì!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Khoan... Gì cơ? Có tiền nhiệm hả? Bị gì rồi? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Ông nội tôi hay bảo: \"Tin vào trực giác, phải kiểm tra hai lần.\""

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Ông chắc mê chị luôn! Bà nào nguy hiểm tí là ổng đeo."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Đồng ý ba chân!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Đạn thử nghiệm này bá đạo! Bắn vào tắt hệ thống chúng nó như chưởng ma pháp!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Pro tổ chức sinh nhật cho trẻ con rồi."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: “Đây không phải thỏ nha mấy đứa, nó là Oryctolagus cuniculus thuần hóa!”"

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Này Leni, xong vụ này muốn quà lưu niệm kiểu gì?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Tôi đang tính mang về cái nòng pháo tăng bắn tỉa đó."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Đằng ấy có vẻ thích vũ khí dài dài bắn xa xa."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Tiếng Đức kiểu “Tao để ý mày đó” hả? Đáng iu vãi!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni ơi, nếu có đây, chắc phát cuồng vì cái xe tăng thử nghiệm đẹp muốn xỉu này."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Đường nét mượt, động cơ khủng, cứ như..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: …như chuẩn kỹ thuật Đức! Tưởng gì khác hả, mơ đi cưng!"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Tiết kiệm đạn? Gì tiếp, dùng lại túi trà? Lau thìa nhựa? Giặt khăn giấy?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Tôi cá 5$ thằng chỉ huy đánh thuê bí-ẩn-giọng-ngầu-đáng-sợ kia có ria mép xàm!"

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Vai phản diện đúng chuẩn đều để râu."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Cá 10$ hắn hay vặn ria khi nghĩ không ai để ý!"

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Để ý đội hình tụi nó chưa? Chăm học giáo trình quân sự chắc luôn."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Chương một: “Cách để bị bao vây và tan xác trong 3 bước siêu dễ”. "

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Tự phụ, bất tài — cái nào nổ banh thôi, bạn ơi."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Biết gì lạ không? Tôi thấy vui với nhiệm vụ này thật."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Cảnh đẹp như tranh, xe tăng lạ hoắc, địch thủ bí ẩn..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Tôi sẽ coi đây là “xả hơi hành động”!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Đánh giá tâm lý? Chúng ta có hẹn với bác sĩ tâm lý?!"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: À...thì ra chat với cái cô xinh xinh đó là… bài đánh giá? "

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: Nói gì vậy?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Giỡn à?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Há hà! Đơn vị tinh nhuệ của tụi nó hóa ra cũng thường!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Chỉ còn vài thằng chắn giữa ta và quả rocket!"

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Bà nội tao cầm cái dép lê cũng đủ vả sưng mặt bọn này!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Địt! Con quái to đùng hốt Chỉ huy rồi—đụng chạm cá nhân đây!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Con đó mà xơi Chỉ huy thật á? Được, bố mày điên đây!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Corvin: Ulysses báo cáo. Vừa đổ bộ. Chết tiệt...bãi biển nghĩa địa xe tăng."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Đợt đầu bay sạch! Đừng nấn ná ở đây!"

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Chúng ta cần đến trung tâm chỉ huy và ngăn vụ phóng bằng mọi giá."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Địch phía trước! Tăng Đức, hướng 11 giờ. Bắn tự do."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Mục tiêu mới! Bắn đè, ghìm nó!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Nó đang rút lui."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Phải tiếp tục tiến lên. Ở cự ly này, mình không có cửa trước hỏa lực đó."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Phải thu hẹp khoảng cách, tìm cách vòng hông nó. Tiến lên!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Tập trung! Phải xử đám địch ở đây trước."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Thằng nòng dài lát xử sau."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Phát hiện địch mới phía trước."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Chết tiệt, lần này đông hơn."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Tôi từng ở cửa dưới hơn nhiều tại Bắc Phi. Cứ tiến lên, ta sẽ phá được."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Phối hợp cùng nhau. Nhắm vào sườn chúng!"

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Nòng dài quay lại rồi! Bắn đè, NGAY!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Tiếp tục di chuyển. Đường ngắn nhất tới quả rocket là xuyên qua nhà máy này."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Giữ vị trí. Hình như vừa tìm được cái... thú vị."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Xe tăng bị bỏ lại. Mẫu lạ hoắc."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: Đạn này trông như hàng thử. Có thể tạm thời vô hiệu hoá xe địch."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Chỉ huy, chiếc xe tăng thử nghiệm đó có thể cho ta lợi thế chiến thuật cực quan trọng."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Tôi đề nghị nên cầm lái nó."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Cẩn thận!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Chú ý phía trước! Nhiều lắm!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Lệnh rõ kiểu này mới giữ mạng được, bạn vui tính à!"

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Cẩn thận!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: Chúng đang bao vây mình. Vào vị trí!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Không có thời gian cò cưa. Nhanh gọn lẹ, dứt điểm!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Để ý cái lỗ trên tường đó. Ở giữa có thể bắn qua. Nấp kỹ vào!"

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Thời giờ đâu mà cãi. Đồng hồ đang đếm ngược – đi mau!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Mối đe dọa mới. Bọn nó đang dùng loại đạn thử nghiệm gì đó"

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: có thể tạm thời tê liệt hệ thống điện tử xe ta."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Đám đánh thuê này không phải vừa — công nghệ xịn chưa từng thấy!"

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Nhìn kia, một trạm bảo trì dã chiến nữa...và lại mấy con tăng tôi không nhận diện được."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: Được thứ hay đấy."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Xe tăng này có giáp modular, dễ thay thế nhanh ngoài chiến trường."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Có thể hữu dụng."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Giờ phải chỉnh chiến thuật."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy và tôi sẽ đi đầu, còn lại bắn yểm trợ phía sau."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: Cách này giữ tăng mới an toàn hơn, đồng thời phát huy tối đa khẩu pháo bá đạo đó."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Có vẻ Adler-Gruppe này là đơn vị tinh nhuệ,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: nguy hiểm hơn nãy giờ rất nhiều."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, đừng cà chớn nữa, cho chúng biết ta là ai."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Mục tiêu chính là chặn vụ phóng tên lửa. Mọi cái khác đều thứ yếu."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Đừng ngáo!"

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Gần tới mục tiêu. Đợt công cuối cùng!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Không! KHÔNG! MẸ KIẾP, KHÔNG!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Chúng ta đã không ngăn được vụ phóng. Tên lửa đang tăng độ cao."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Đồng ý."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: Phát hiện trạm sửa dã chiến nữa phía trước. Có tăng hạng nặng không rõ."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Giáp dày hơn hẳn những gì từng gặp."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Bất ngờ là...không có gì đặc biệt."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: À, trừ cái giáp siêu mạnh và chậm hơn rùa."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: Và đó chính xác là thứ ta cần lúc này."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Đã chiếm bãi phóng. Chúng tôi đang giữ vị trí lối vào boongke."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Địch mới đến. Đang tới chỗ thủ tốt hơn."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Mồm thối Teddy, cầu với chả mong. Hình như chúng đang kéo hết về đây chứ không di tản."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Có vẻ là đợt sóng lớn nhất của chúng."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Phát hiện di chuyển ở trung tâm! Nguyên mẫu nòng dài đó quay lại!"

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, tình hình quả rocket thế nào?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Là sao?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Đứng yên là chết như đợt đầu. Đi nào!"

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Thời gian không chờ ai. Tiến lên!"

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Đứng yên dễ ăn đạn. Di chuyển ngay!"

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Có địch ở giữa! Bắn đè, không cho nó ngóc đầu!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Sniper quay lại rồi – duy trì hỏa lực, đừng để nó ngắm thoải mái!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Pháo chống tăng ở giữa – đã sửa xong và trở lại vòng chiến!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Sao nó sửa nhanh vậy?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Tỉnh táo! Chỉ huy tạm thời bị hạ, sẽ quay lại ngay!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Chỉ huy trúng đạn! Tiếp tục tiến lên, sếp sẽ sớm trở lại!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Quay lại rồi, ngon! Nhưng lần này cẩn thận hơn đi."

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: Suýt toi. Lần sau giữ cái xe nguyên vẹn hộ cái?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: Mấy trạm sửa này không có xe mới vô hạn đâu."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Lần sau cẩn thận hơn đi."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Chết tiệt! Tôi bị hạ rồi! Sẽ quay lại."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: Bọn nó hạ tôi rồi! Cứ chiến tiếp, tôi sẽ quay lại!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Tôi trúng đạn! Tiếp tục tiến lên, tôi sẽ sớm đoàn tụ!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Tôi gục rồi. Chết tiệt – con đó cứng hơn mấy con khác thật!"

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Ăn đạn trực diện... Mấy con tăng mới này không đùa được."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Tôi trở lại vòng chiến. Hy vọng lần này không bất ngờ gì nữa."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Quay lại trận chiến. Chết tiệt... Có lúc tụi nó đông quá!"

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Ulysses: Tăng tôi hỏng rồi. Loại khỏi vòng chiến, anh em cố gắng, nhiệm vụ bằng mọi giá!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Chết tiệt... Quá chậm rồi. Lỗi tại chúng ta!"

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: Hết. Làm gì còn xe tăng. Xong cuộc."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Tiếp viện địch đang tới. Nghênh chiến."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Phát hiện địch mới. Không phải tăng thường — cảnh giác cao độ!"

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Bắn hay đấy! Đơn vị thử nghiệm bị hạ. Bớt một đống phiền phức!"

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Làm tốt lắm! Chúng hết đồ chơi xịn. Tiếp tục gây áp lực nào."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Mục tiêu lớn bị hạ. Xem tụi nó còn gì nữa!"

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Đám tinh nhuệ nhất cũng không ăn thua. Kết thúc trận luôn!"

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Gặp địch! Xả đi anh em!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Đang giao chiến. Tỉnh vào!"

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Kết liễu mục tiêu cuối — di chuyển!"

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: Đó là mục tiêu cuối cùng — khu vực clear, đi thôi!"

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Đã diệt toán địch – Tiếp tiếp."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Mục tiêu gục rồi."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Địch bị hạ."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Bắn đẹp đấy!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Tôi đã xử xong mối đe dọa."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Tôi giết nó rồi."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Tôi cover phía sau, đẩy đi!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Không kích hỗ trợ đang tới. Chuẩn bị nổ."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Xác nhận oanh tạc. Tránh vùng nổ ra!"

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Không kích không trúng chỗ đó được. Chỉnh lại tọa độ mục tiêu đi."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Mục tiêu choáng rồi — giờ ta đập thật lực!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Hệ thống địch bị tê liệt. Kết liễu luôn!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Kỹ năng đặc biệt của địch vô hiệu. Tấn công! Ngay!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Vết thủng thân xe đã được bịt. Hiệu quả chiến đấu trở lại mức tối ưu."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Giáp modular đã thay xong. Xe lại sẵn sàng chiến đấu."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Tấm giáp đã được thay mới. Mức độ bảo vệ của xe trở lại chuẩn."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Giáp đã được sửa! Tiếp tục nhiệm vụ."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Phát hiện thám phá pháo binh! Rút ngay khỏi khu vực oanh tạc!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Pháo đang bắn! Di chuyển–NGAY!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Pháo địch sắp nã! Chỉ còn vài giây–chạy đi!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: Chúng đang triển khai hệ thống thử nghiệm. Cản ngay! Dùng đạn đặc biệt!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Mục tiêu đang chuẩn bị chiêu đặc biệt. Làm choáng nó trước khi xong!"

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Địch tự sửa. Đen rồi."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: Chúng có sửa chữa tại trận. Phải sát thương nhanh hơn tốc độ vá xe!"

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Địch tăng tốc nhằm đâm/húc! Né đòn!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Địch lao tới tốc độ tối đa. Đừng để bọn nó chạm được!"

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Chỉ huy, địch đánh trúng hệ thống giao diện! Thiết bị điện tử tạm thời offline."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Trúng thẳng mô-đun điều khiển. Đồ điện tử xịn “off” tạm thời!"

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, phải tiết kiệm đạn. Bắn ít lại, nhắm điểm yếu!"

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Tôi không thấy giá trị cá cược vô nghĩa."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Chúng dàn quân kiểu tự phụ, không phải ngu dốt. Đừng coi thường."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, khái niệm \"xả hơi\" của anh cần xét lại nghiêm túc."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Anh có chắc đã vượt qua bài đánh giá tâm lý trước nhiệm vụ này?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Chúng ta đang bị dắt mũi?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, mồm em im bất thường. Đang nghĩ gì vậy?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: Sao nữa?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, thật lòng hỏi, mấy trò của Teddy nhạt hay mặn hơn rồi?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Em phân tích câu đùa của nó thật à?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: Tiến lên nào–Ta đang gần bãi phóng. Cần chiếm nó trước."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Chỉ huy bị hạ! Con xe mới đúng là ác mộng thật sự."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Ulysses: Chúng ta đánh giá thấp con đó rồi. Tỉnh táo, Chỉ huy sẽ quay lại ngay."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Súng chính của tăng này có khả năng buff sát thương."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Trong vài điều kiện, nó có thể gây thiệt hại cực khủng nếu triển khai đúng."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Đúng thứ ta cần để đối phó đơn vị hạng nặng đó."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: Nhìn vũ khí kìa. Súng chính của tăng này có khả năng buff sát thương."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Trong vài điều kiện, nó có thể gây thiệt hại cực khủng nếu triển khai đúng."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Đúng thứ ta cần để đối phó đơn vị hạng nặng đó."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Con tăng này trang bị hệ thống bắt mục tiêu chính xác."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Có vẻ càng đứng yên lâu, bắn càng chuẩn."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Hoàn hảo cho giao tranh tầm xa."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Nhưng thú vị hơn là con tăng này có hệ thống bắt mục tiêu chính xác."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Có vẻ càng đứng yên lâu, bắn càng chuẩn."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Hoàn hảo cho giao tranh tầm xa."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Hay nhỉ: Con này còn gắn vũ khí phụ."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Có thể duy trì hỏa lực đàn áp khi súng chính đang nạp đạn."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Lợi thế chiến thuật khi đối đầu giáp mỏng."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: À đúng. Thêm nữa. Con này còn có vũ khí phụ."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Có thể duy trì hỏa lực đàn áp khi súng chính đang nạp đạn."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Lợi thế chiến thuật khi đối đầu giáp mỏng."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Con xe này trang bị khác chuẩn. Không phải đồ nâng cấp thường—"

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: Chúng chế ra thứ đặc biệt. Chỉ huy, lái thử đi."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Xem công nghệ này cỡ nào."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: Công nghệ cao được tích hợp vào hệ thống con tăng này."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Ta nên tận dụng hết khả năng của nó."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Chỉ huy, thử điều khiển xem–khám phá hệ thống này có thể làm gì trên chiến trường."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Nguyên mẫu này kỹ thuật quá đỉnh, không phải nâng cấp dã chiến thường thấy—"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: Thay đổi cả cục diện. Chỉ huy thử coi!"

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Ép hệ thống chạy max công suất, cho địch thấy công nghệ của chúng cỡ nào."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "Một xe thử nghiệm của ta bị địch thu giữ. Nhận diện mục tiêu cẩn thận."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta và Dora, hành động cẩn thận. Kéo dài thời gian lâu nhất có thể."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Địch đang tiến vào nhà máy. Kampfgruppe Berta và Dora, nghênh chiến."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Giữ chân chúng lâu nhất có thể."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Chú ý, Team Zeppelin! Di chuyển tới nhà máy, chiếm vị trí thủ và giữ vững!"

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, duy trì hỏa lực tại các lối ra. Tuyệt đối không để chúng thoát khỏi cơ sở."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Kích hoạt Giao thức Valkyrie. Tất cả đơn vị, xác nhận!"

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Tất cả đơn vị, vào vị trí thủ. Adler-Gruppe, nghênh chiến!"

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Tất cả đơn vị, tấn công đối phương. Ai diệt được sẽ nhận gấp đôi tiền thưởng."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Cái quái gì vậy?! Architect, chúng ta chưa sẵn sàng! Vẫn còn tăng trong vùng nổ!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Tất cả các đơn vị, rút khỏi bãi phóng–NGAY LẬP TỨC!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Bố đời! Báo hại!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Tất cả các đơn vị còn lại, rút khỏi bán kính nổ! Bảo vệ vụ phóng! Giữ vị trí!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Tất cả đơn vị còn lại—tập kết tại trung tâm chỉ huy. Giao chiến với địch. Cò cưa giữ chân."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Duy trì vị trí phòng thủ đến khi có lệnh tiếp theo. Khi có lệnh, rút về các điểm sơ tán."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Tao biết mày nghe được. Không ngờ gặp đối như vầy."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Nhưng giờ tao đã soi kỹ chiến thuật và khả năng của mày. Lần sau gặp, xác định ăn hành!"

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter hết."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "Năm ngày trước, chúng ta mất liên lạc với một tổ hợp quân sự-vũ trụ bí mật ở Biển Na Uy."

msgid "vo_sm_norway_intro_02"
msgstr "Phi công máy bay trinh sát báo cáo có dấu vết giao tranh"

msgid "vo_sm_norway_intro_03"
msgstr "và các tòa công nghiệp bị phá hủy một phần tại đó."

msgid "vo_sm_norway_intro_04"
msgstr "Nhưng quan trọng nhất, anh ta mô tả một tên lửa sẵn sàng phóng từ bệ launch pad"

msgid "vo_sm_norway_intro_05"
msgstr "ngay trước khi mất liên lạc."

msgid "vo_sm_norway_intro_06"
msgstr "Một biệt đội phản ứng nhanh được cử đến hiện trường điều tra."

msgid "vo_sm_norway_outro_01"
msgstr "Thứ tưởng là vũ khí hóa ra nguy hiểm hơn nhiều."

msgid "vo_sm_norway_outro_02"
msgstr "Tên lửa đã phóng một vệ tinh nhân tạo ra quỹ đạo,"

msgid "vo_sm_norway_outro_03"
msgstr "bắt đầu truyền tải tài liệu bí mật của Reich:"

msgid "vo_sm_norway_outro_04"
msgstr "Bản thiết kế công nghệ tiên tiến"

msgid "vo_sm_norway_outro_05"
msgstr "và tọa độ các căn cứ quân sự bí mật chứa mẫu vũ khí sẵn dùng."

msgid "vo_sm_norway_outro_06"
msgstr "Kẻ đứng sau vụ này tự xưng là Architect."

msgid "vo_sm_norway_outro_07"
msgstr "Động cơ không hoàn toàn rõ ràng, nhưng hành động của hắn bắt đầu thay đổi trật tự quốc tế."

msgid "vo_sm_norway_outro_08"
msgstr "Để đối phó mối đe dọa này, chúng ta cần một lực lượng có khả năng bảo vệ thế giới khỏi sự hỗn loạn sắp tới."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Chú ý! Chú ý!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Chúng tôi kêu gọi tất cả binh lính, sĩ quan của Wehrmacht, Luftwaffe và Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Bộ Tư lệnh Tối cao Đức đã ký kết đầu hàng vô điều kiện.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Chiến tranh đã kết thúc...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Chúng tôi kêu gọi tất cả những ai vẫn đang chống cự vô ích;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Hạ vũ khí và đầu hàng quân đội Đồng minh.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Mạng sống của các bạn rất quan trọng để xây dựng một nước Đức mới, được tái thiết...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(Lại cú lừa nữa.)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Trừ khi có lệnh thật từ chỉ huy, chúng ta chiến tiếp.)"
