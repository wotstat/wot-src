msgid "vo_ob_char01_intro_01"
msgstr "Brooks: Lại Tiger nữa à..."

msgid "vo_ob_char01_intro_03"
msgstr "Brooks: Thượng sĩ Brooks, Binh chủng Thiết giáp Số 02. Chúng tôi cũng từng đụng một chiếc Tiger."

msgid "vo_ob_char01_intro_03_01"
msgstr "Brooks: Ô-kê, làm bạn được rồi."

msgid "vo_ob_char01_intro_05"
msgstr "Brooks: Theo tôi. Cuộc tấn công vào thị trấn đã bắt đầu rồi..."

msgid "vo_ob_char01_intro_05_01"
msgstr "Brooks: Nhanh lên."

msgid "vo_ob_char01_intro_07"
msgstr "Brooks: Cứ giống thế."

msgid "vo_ob_char01_intro_09"
msgstr "Brooks: 'Betsy' để dọa địch à?"

msgid "vo_ob_char01_intro_11"
msgstr "Brooks: Địch hướng 3 giờ!"

msgid "vo_ob_char01_intro_12"
msgstr "Brooks: Diệt Stug trước!"

msgid "vo_ob_char01_intro_17"
msgstr "Brooks: Chiếm thị trấn cái đã. Sau đó tính tiếp..."

msgid "vo_ob_char01_m01_stg00_01"
msgstr "Brooks: Đừng phí thời gian. Di chuyển nào."

msgid "vo_ob_char01_m01_stg00_02"
msgstr "Brooks: Tỉnh táo vào! Chúng ta tiến lên phía trước."

msgid "vo_ob_char01_m01_stg00_03"
msgstr "Brooks: Sherman, nhanh lên."

msgid "vo_ob_char01_m01_stg00_04"
msgstr "Brooks: Quân ta cần yểm trợ trong thị trấn - đi nào."

msgid "vo_ob_char01_m01_stg00_05"
msgstr "Brooks: Tiến lên, khẩn trương!"

msgid "vo_ob_char01_m01_stg010_01"
msgstr "Brooks: Pháo tự hành hướng 12 giờ. Diệt ngay!"

msgid "vo_ob_char01_m01_stg010_04"
msgstr "Brooks: Được rồi! Sherman, làm tốt lắm."

msgid "vo_ob_char01_m01_stg011_01"
msgstr "Brooks: Trung đội - có địch mới!"

msgid "vo_ob_char01_m01_stg012_02"
msgstr "Brooks: Vào trung tâm. Tập trung."

msgid "vo_ob_char01_m01_stg014_01"
msgstr "Brooks: Tuyệt vời. Giờ dọn sạch ô cuối cùng. Tiến lên!"

msgid "vo_ob_char01_m01_stg015_01"
msgstr "Brooks: Chú ý! Địch đông hơn dự kiến!"

msgid "vo_ob_char01_m01_stg015_05"
msgstr "Brooks: Nhóm địch mới! Lucky, đừng để chúng chọc sườn!"

msgid "vo_ob_char01_m01_stg016_02"
msgstr "Brooks: Cảm ơn các đồng chí. Thắng trận này rồi, nhưng cuộc chiến vẫn còn dài."

msgid "vo_ob_char01_m01_stg016_04"
msgstr "Brooks: Nào, nào, Betsy."

msgid "vo_ob_char01_m01_stg01_01"
msgstr "Brooks: Cuộc tấn công đã bắt đầu rồi—chúng ta phải khẩn trương."

msgid "vo_ob_char01_m01_stg01_03"
msgstr "Brooks: Nhân danh ông nội?"

msgid "vo_ob_char01_m01_stg01_07"
msgstr "Brooks: Sherman, theo tôi. Đừng phí thời giờ nữa."

msgid "vo_ob_char01_m01_stg02_04"
msgstr "Brooks: Nghe giống tiếng Đức quá."

msgid "vo_ob_char01_m01_stg03_01"
msgstr "Brooks: Địch hướng 2 giờ! Bắn!"

msgid "vo_ob_char01_m01_stg03_02"
msgstr "Brooks: Địch hướng 12 giờ! Bắn!"

msgid "vo_ob_char01_m01_stg04_01"
msgstr "Brooks: Xong. Vào thị trấn nào."

msgid "vo_ob_char01_m01_stg04_03"
msgstr "Brooks: Nghe nó sợ... Nhưng không độc lạ cho lắm."

msgid "vo_ob_char01_m01_stg05_01"
msgstr "Brooks: Nhanh, đi thôi! Quân ta đang chờ."

msgid "vo_ob_char01_m01_stg06_01"
msgstr "Brooks: Hai kẻ địch hướng 12 giờ. Bắn!"

msgid "vo_ob_char01_m01_stg07_02"
msgstr "Brooks: Chỉ huy, mở to mắt ra! Hãy lái vòng sang bên phải."

msgid "vo_ob_char01_m01_stg08_01"
msgstr "Brooks: Có Panzer của Đức. Bắn đạn AP!"

msgid "vo_ob_char01_m02_stg01_01"
msgstr "Brooks: Di chuyển. Tất cả hết sức cảnh giác. Không quân đang oanh tạc thị trấn."

msgid "vo_ob_char01_m02_stg01_01_01"
msgstr "Brooks: Nhưng vẫn còn nhiều xe địch."

msgid "vo_ob_char01_m02_stg01_03"
msgstr "Brooks: MacLeod, bình tĩnh. Đây là..."

msgid "vo_ob_char01_m02_stg01_03_01"
msgstr "Brooks: Đ** **! Đã tìm thấy nhóm tấn công đầu tiên. Tiger à?"

msgid "vo_ob_char01_m02_stg02_01"
msgstr "Brooks: Chúng đến rồi đây!"

msgid "vo_ob_char01_m02_stg02_03"
msgstr "Brooks: MacLeod, tập trung!"

msgid "vo_ob_char01_m02_stg03_01"
msgstr "Brooks: Một chiếc VK ở bờ bên kia! Bắn!"

msgid "vo_ob_char01_m02_stg04_02"
msgstr "Brooks: Lần đầu tôi nghe chú van xin mục tiêu đấy."

msgid "vo_ob_char01_m02_stg05_01"
msgstr "Brooks: Cầu bị chặn rồi. Đi vòng đi."

msgid "vo_ob_char01_m02_stg05_03"
msgstr "Brooks: Lạc quan là tốt. Có chỗ cạn gần đây."

msgid "vo_ob_char01_m02_stg05_04"
msgstr "Brooks: Ông tiên đoán như thần. Sao hay thế?"

msgid "vo_ob_char01_m02_stg05_06"
msgstr "Brooks: Thế sao không cảnh báo chúng tôi? Đó là kẻ thù."

msgid "vo_ob_char01_m02_stg06_01"
msgstr "Brooks: Địch hướng 12 giờ!"

msgid "vo_ob_char01_m02_stg06_01_01"
msgstr "Brooks: Lucky, giữ đạn! Đừng bắn lung tung; dùng kính ngắm."

msgid "vo_ob_char01_m02_stg06_03"
msgstr "Brooks: Kết liễu chúng rồi di chuyển nào."

msgid "vo_ob_char01_m02_stg06_03_01"
msgstr "Brooks: Chúng ta cần bắt kịp tổ tấn công thứ hai."

msgid "vo_ob_char01_m02_stg07_02"
msgstr "Brooks: Đừng hăng máu quá. Tiger không phải đùa."

msgid "vo_ob_char01_m02_stg07_02_01"
msgstr "Brooks: Chúng cực kỳ nguy hiểm."

msgid "vo_ob_char01_m02_stg07_04"
msgstr "Brooks: Lại lải nhải về huân chương đấy à! Ông ở đây chỉ vì thành tích?"

msgid "vo_ob_char01_m02_stg08_01"
msgstr "Brooks: Tin tốt: Chúng ta đã bắt kịp tổ đội thứ hai."

msgid "vo_ob_char01_m02_stg08_02"
msgstr "Brooks: Đ** **! Chọc sườn! Chọc sườn!"

msgid "vo_ob_char01_m02_stg08_04"
msgstr "Brooks: Đ** **! Bắn cẩn thận xem nào!"

msgid "vo_ob_char01_m02_stg08_05"
msgstr "Brooks: Trung đội, chú ý: Mọi nhóm quân đồng minh đã bị tiêu diệt."

msgid "vo_ob_char01_m02_stg08_05_01"
msgstr "Brooks: Còn mỗi chúng ta thôi. Phải hoàn thành nhiệm vụ. Đi nào."

msgid "vo_ob_char01_m02_stg09_01"
msgstr "Brooks: Có địch! Hướng 12 giờ!"

msgid "vo_ob_char01_m02_stg09_03"
msgstr "Brooks: Chưa hết đâu."

msgid "vo_ob_char01_m02_stg09_03_01"
msgstr "Brooks: Trinh sát báo rằng không chỉ có Tiger."

msgid "vo_ob_char01_m02_stg10_01"
msgstr "Brooks: V** ***... Không phải Panther. King Tiger đấy."

msgid "vo_ob_char01_m02_stg10_03"
msgstr "Brooks: Anh xin phép nhường chú quả huân chương này."

msgid "vo_ob_char01_m02_stg10_05"
msgstr "Brooks: Không xuyên được mặt trước. Tạt sườn đi."

msgid "vo_ob_char01_m02_stg11_01"
msgstr "Brooks: Chạy đi! Đừng để nó ngắm!"

msgid "vo_ob_char01_m02_stg11_03"
msgstr "Brooks: Đ** **! Trúng xích rồi. Tôi không đi được!"

msgid "vo_ob_char02_intro_02"
msgstr "MacLeod: Nhưng chúng cháy đẹp thật."

msgid "vo_ob_char02_intro_04"
msgstr "MacLeod: Chiếc kia cũng cháy mãn nhãn."

msgid "vo_ob_char02_intro_06"
msgstr "MacLeod: Ê, Thượng sĩ Brooks—tại sao lại là \"Thunderbolt\"?"

msgid "vo_ob_char02_intro_06_01"
msgstr "MacLeod: Mỗi cái tên cũng đòi làm địch sợ?"

msgid "vo_ob_char02_intro_08"
msgstr "MacLeod: Hừm… Firefly của tôi cũng cần tên vậy. Em nó sẽ là \"Betsy.\""

msgid "vo_ob_char02_intro_10"
msgstr "MacLeod: Theo tên bà ngoại. Tôi sợ bả lắm..."

msgid "vo_ob_char02_intro_13"
msgstr "MacLeod: Ê, Sherman, tỉnh chưa? Đúng lúc đấy!"

msgid "vo_ob_char02_intro_14"
msgstr "MacLeod: Lũ sâu bọ!"

msgid "vo_ob_char02_intro_15"
msgstr "MacLeod: Sherman, bắn tốt lắm! Đừng tụt phong độ nữa nhá!"

msgid "vo_ob_char02_intro_16"
msgstr "MacLeod: Tôi ghi hai điểm nữa! Thượng sĩ Brooks, huân chương đâu?"

msgid "vo_ob_char02_intro_18"
msgstr "MacLeod: Điển hình..."

msgid "vo_ob_char02_m01_stg00_01"
msgstr "MacLeod: Đi thôi, Sherman."

msgid "vo_ob_char02_m01_stg00_02"
msgstr "MacLeod: Sherman, dậy đi."

msgid "vo_ob_char02_m01_stg00_03"
msgstr "MacLeod: Đừng đứng đực đấy. Lái!"

msgid "vo_ob_char02_m01_stg00_04"
msgstr "MacLeod: Xe chú lại chết máy à?"

msgid "vo_ob_char02_m01_stg00_05"
msgstr "MacLeod: Di chuyển nào, không là lỡ hẹn!"

msgid "vo_ob_char02_m01_stg010_02"
msgstr "MacLeod: Ặc, cái đống... Nhớ mặt đấy!"

msgid "vo_ob_char02_m01_stg010_03"
msgstr "MacLeod: Lucky, dùng kính ngắm!"

msgid "vo_ob_char02_m01_stg010_03_01"
msgstr "MacLeod: Tự nhiên vuột mồm ra. Gọi là Lucky từ giờ luôn!"

msgid "vo_ob_char02_m01_stg012_01"
msgstr "MacLeod: Mọi thứ ô-kê ở đây, Lucky. Chắc chắn là nhớ kiểu đấy rồi."

msgid "vo_ob_char02_m01_stg013_01"
msgstr "MacLeod: Ố ồ! Ai cũng có phần."

msgid "vo_ob_char02_m01_stg015_02"
msgstr "MacLeod: Lucky, ta thi đua tí nhỉ?"

msgid "vo_ob_char02_m01_stg015_03"
msgstr "MacLeod: Tiếp nào, bắn rụi chúng nó đi!"

msgid "vo_ob_char02_m01_stg015_04"
msgstr "MacLeod: Cháy phừng phừng!"

msgid "vo_ob_char02_m01_stg016_01"
msgstr "MacLeod: \"Nóng\" thật! Tại hạ nể phục."

msgid "vo_ob_char02_m01_stg016_01_01"
msgstr "MacLeod: Lâu lắm mới lại được thấy cảnh này!"

msgid "vo_ob_char02_m01_stg016_03"
msgstr "MacLeod: Ê, Thượng sĩ Brooks, huân chương kia đâu?"

msgid "vo_ob_char02_m01_stg016_05"
msgstr "MacLeod: Há!"

msgid "vo_ob_char02_m01_stg01_02"
msgstr "MacLeod: Ra ý tưởng đặt tên cho Sherman nữa."

msgid "vo_ob_char02_m01_stg01_04"
msgstr "MacLeod: Hả! Tên là Ruaraidh."

msgid "vo_ob_char02_m01_stg01_05"
msgstr "MacLeod: Địch chắc chắn sợ."

msgid "vo_ob_char02_m01_stg01_05_01"
msgstr "MacLeod: Nhưng tôi thấy hơn khó phát âm!"

msgid "vo_ob_char02_m01_stg01_06"
msgstr "MacLeod: Được rồi, Sherman, đi nào! Vở kịch đã bắt đầu rồi!"

msgid "vo_ob_char02_m01_stg02_01"
msgstr "MacLeod: Lái vòng đi, Sherman."

msgid "vo_ob_char02_m01_stg02_02"
msgstr "MacLeod: Đi dính là mất tốc, dễ ăn đạn lắm."

msgid "vo_ob_char02_m01_stg02_03"
msgstr "MacLeod: Hay là \"Battlewagon\"? Nghe kinh đấy chứ?"

msgid "vo_ob_char02_m01_stg03_03"
msgstr "MacLeod: Tiếp nào! Đục thêm vài lỗ nữa cho cái thùng rác đấy!"

msgid "vo_ob_char02_m01_stg04_02"
msgstr "MacLeod: \"Death Machine\" thì sao?"

msgid "vo_ob_char02_m01_stg04_04"
msgstr "MacLeod: Gọi \"Thunderbolt\"!"

msgid "vo_ob_char02_m01_stg05_02"
msgstr "MacLeod: Các quý ông của chúng ta biết phải làm gì! Sô diễn khói lửa!"

msgid "vo_ob_char02_m01_stg06_02"
msgstr "MacLeod: Bắn, Death Machine, bắn đi!"

msgid "vo_ob_char02_m01_stg06_03"
msgstr "MacLeod: Chúng ta cần tên gọn hơn."

msgid "vo_ob_char02_m01_stg06_04"
msgstr "MacLeod: Coi nào! Quay tháp pháo đi! Nướng thịt đi!"

msgid "vo_ob_char02_m01_stg07_01"
msgstr "MacLeod: Vãi cả khói! Hú vía."

msgid "vo_ob_char02_m01_stg09_01"
msgstr "MacLeod: Chạy đâu cho thoát! Dí chúng nó..."

msgid "vo_ob_char02_m01_stg09_01_01"
msgstr "MacLeod: Reaper? Tên Reaper thì sao?"

msgid "vo_ob_char02_m02_stg01_02"
msgstr "MacLeod: Bắt đầu cuộc săn nào!"

msgid "vo_ob_char02_m02_stg01_02_01"
msgstr "MacLeod: Lucky, chắc nay đúng là ngày MacLeod cướp danh hiệu \"Thợ Săn Hổ\" từ chú!"

msgid "vo_ob_char02_m02_stg01_04"
msgstr "MacLeod: Không. Kích thước lỗ khác. Đó là tăng hạng trung."

msgid "vo_ob_char02_m02_stg02_02"
msgstr "MacLeod: *Khạc chủ... Game nhạt như nước ốc. Không có gì hay."

msgid "vo_ob_char02_m02_stg02_04"
msgstr "MacLeod: Vâng, thưa sếp! Tiếp đi, Lucky!"

msgid "vo_ob_char02_m02_stg03_02"
msgstr "MacLeod: Chúng quyết định hơi sai. Kính ngắm của ta quá mạnh."

msgid "vo_ob_char02_m02_stg04_01"
msgstr "MacLeod: Chiếc thứ hai đến kìa. Ê, Lucky—Để phần tôi ít nhất một con xem nào?"

msgid "vo_ob_char02_m02_stg04_03"
msgstr "MacLeod: Đ** **! Tôi vừa nói to lắm à?"

msgid "vo_ob_char02_m02_stg05_02"
msgstr "MacLeod: Thượng sĩ, lạc quan hơn tí đi! Sẽ có đường đi giờ."

msgid "vo_ob_char02_m02_stg05_05"
msgstr "MacLeod: Mắt tôi tinh. Thấy máy bay."

msgid "vo_ob_char02_m02_stg05_07"
msgstr "MacLeod: Vậy á? Tưởng là của ta."

msgid "vo_ob_char02_m02_stg06_02"
msgstr "MacLeod: Cứ như ở trường bắn tập. Chúng nghĩ gì thế?"

msgid "vo_ob_char02_m02_stg07_01"
msgstr "MacLeod: Tôi nghĩ chúng mới là kẻ chơi đuổi bắt."

msgid "vo_ob_char02_m02_stg07_01_01"
msgstr "MacLeod: Địch đi vòng hơi xa đấy. Qua chỗ cạn của ông."

msgid "vo_ob_char02_m02_stg07_01_02"
msgstr "MacLeod: Tiger khắc tên chúng ta đấy."

msgid "vo_ob_char02_m02_stg07_03"
msgstr "MacLeod: Tốt."

msgid "vo_ob_char02_m02_stg07_03_01"
msgstr "MacLeod: Cần diệt bao nhiêu nữa mới được huân chương?"

msgid "vo_ob_char02_m02_stg07_05"
msgstr "MacLeod: Không quan tâm."

msgid "vo_ob_char02_m02_stg07_05_01"
msgstr "MacLeod: Tôi chỉ muốn có để gửi về cho má—cho mừng tí, hiểu không?"

msgid "vo_ob_char02_m02_stg07_05_02"
msgstr "MacLeod: Đi khoe khắp hàng xóm. Tự hào lắm."

msgid "vo_ob_char02_m02_stg07_05_03"
msgstr "MacLeod: Kiểu như mãi mới được."

msgid "vo_ob_char02_m02_stg08_03"
msgstr "MacLeod: Con này cứng phết."

msgid "vo_ob_char02_m02_stg08_03_01"
msgstr "MacLeod: Lucky, ngắm điểm yếu ấy! Bên hông và phía sau!"

msgid "vo_ob_char02_m02_stg08_04"
msgstr "MacLeod: Cháy đẹp quá!"

msgid "vo_ob_char02_m02_stg08_05"
msgstr "MacLeod: Con đấy cứng! Lucky, ngắm điểm yếu ấy."

msgid "vo_ob_char02_m02_stg08_05_01"
msgstr "MacLeod: Ngắm xuống bụng—bên dưới giáp trước luôn mỏng hơn."

msgid "vo_ob_char02_m02_stg08_06"
msgstr "MacLeod: Con đấy cứng! Lucky, ngắm điểm yếu ấy!"

msgid "vo_ob_char02_m02_stg08_07"
msgstr "MacLeod: Ngắm xuống bụng—bên dưới giáp trước luôn mỏng hơn!"

msgid "vo_ob_char02_m02_stg08_08"
msgstr "MacLeod: Ngắm vào tháp nhỏ—khó trúng nhưng dễ xuyên."

msgid "vo_ob_char02_m02_stg09_02"
msgstr "MacLeod: Lucky, đừng quên di chuyển. Không là ăn đạn vào điểm yếu đấy."

msgid "vo_ob_char02_m02_stg09_02_01"
msgstr "MacLeod: Hoặc giấu thân xe sau xác tăng."

msgid "vo_ob_char02_m02_stg09_02_02"
msgstr "MacLeod: Địch khó ăn được—tháp pháo mình cứng."

msgid "vo_ob_char02_m02_stg09_04"
msgstr "MacLeod: Mấy thằng trinh sát... Làm ăn như không."

msgid "vo_ob_char02_m02_stg09_04_01"
msgstr "MacLeod: Còn gì ở đấy nữa? Panther?"

msgid "vo_ob_char02_m02_stg10_02"
msgstr "MacLeod: Chưa thấy bao giờ."

msgid "vo_ob_char02_m02_stg10_04"
msgstr "MacLeod: Á à, cuối cùng!"

msgid "vo_ob_char02_m02_stg10_06"
msgstr "MacLeod: Lucky! Hông! Đít! Bắn điểm yếu!"

msgid "vo_ob_char02_m02_stg11_02"
msgstr "MacLeod: Con mập này không thể theo kịp Sherman chúng ta đâu."

msgid "vo_ob_char02_m02_stg11_04"
msgstr "MacLeod: Lucky, hạ chúng đi—nhanh!"

msgid "vo_ob_char02_m02_stg12_01"
msgstr "MacLeod: Brooks! Đ** **, Brooks, nghe rõ trả lời!"

msgid "vo_ob_char02_m02_stg13_01"
msgstr "MacLeod: Chọc sườn! Bắn điểm yếu của chúng!"

msgid "vo_ob_char02_m02_stg13_02"
msgstr "MacLeod: Lucky, tạt sườn và chọc hậu!"

msgid "vo_ob_char02_m02_stg13_03"
msgstr "MacLeod: Tháp pháo chỉ cứng mặt trước. Di chuyển đi!"

msgid "vo_ob_char02_m02_stg14_01"
msgstr "MacLeod: Xong rồi."

msgid "vo_ob_char02_m02_stg14_02"
msgstr "MacLeod: Chúng đang bốc cháy. Thơm phức."

msgid "vo_ob_char02_m02_stg14_03"
msgstr "MacLeod: Danh hiệu Thợ Săn Hổ: Chính thức, chúc mừng."

msgid "vo_sm_char01_m03_stg01_02"
msgstr "Brooks: Sở Chỉ huy đây. Thượng sĩ Brooks gọi các Thợ săn Hổ."

msgid "vo_sm_char01_m03_stg01_02_01"
msgstr "Brooks: Thành phố và ngoại ô đầy mìn. Đi đứng cẩn thận."

msgid "vo_sm_char01_m03_stg01_04"
msgstr "Brooks: Rất vui vì điều đó, MacLeod."

msgid "vo_sm_char01_m03_stg01_04_01"
msgstr "Brooks: Nhưng nhớ cảnh giác. Chuẩn bị tinh thần gặp nhiều bãi mìn lớn trên đường đi."

msgid "vo_sm_char01_m03_stg01_06"
msgstr "Brooks: Sóc cái gì liên tục?"

msgid "vo_sm_char01_m03_stg03_02"
msgstr "Brooks: Sao biết Lucky cũng có nghi lễ riêng?"

msgid "vo_sm_char01_m03_stg04_02"
msgstr "Brooks: Đừng quá tự phụ. Nhắm cùng mục tiêu đi. Không để lạc nhau."

msgid "vo_sm_char01_m03_stg07_03"
msgstr "Brooks: Già? Thật à?"

msgid "vo_sm_char01_m03_stg07_05"
msgstr "Brooks: Hơn có sáu tuổi thôi, MacLeod."

msgid "vo_sm_char01_m03_stg08_02"
msgstr "Brooks: Có thể chúng đang giữ ý, cho nói hết, MacLeod!"

msgid "vo_sm_char01_m03_stg10_02"
msgstr "Brooks: MacLeod, báo cáo tình hình."

msgid "vo_sm_char01_m03_stg10_04"
msgstr "Brooks: MacLeod, vẫn chứng nào tật nấy."

msgid "vo_sm_char01_m03_stg11_02"
msgstr "Brooks: May có Lucky. Còn hên hơn mọi loại bùa hộ mệnh."

msgid "vo_sm_char01_m03_stg11_02_01"
msgstr "Brooks: Anh em, tìm đường khác đi!"

msgid "vo_sm_char01_m03_stg14_02"
msgstr "Brooks: Các Thợ săn, cảnh giác."

msgid "vo_sm_char01_m03_stg14_02_01"
msgstr "Brooks: Máy bay ném bom của đồng minh đang đến vị trí. Hãy cẩn thận."

msgid "vo_sm_char01_m03_stg14_02_02"
msgstr "Brooks: Giữ khoảng cách với các tăng địch này."

msgid "vo_sm_char01_m03_stg15_02"
msgstr "Brooks: Anh em ổn không?"

msgid "vo_sm_char01_m03_stg18_02"
msgstr "Brooks: Không có gì, MacLeod. Nhưng chúng ta được không quân hỗ trợ. Đang kết nối tới phi công."

msgid "vo_sm_char01_m03_stg21_02"
msgstr "Brooks: Giữ mục tiêu, MacLeod. Ta còn quảng trường cuối cùng phải quét sạch."

msgid "vo_sm_char01_m03_stg21_02_01"
msgstr "Brooks: Bàn luận về mê tín của mình sau đi, lúc uống trà."

msgid "vo_sm_char01_m03_stg21_04"
msgstr "Brooks: Sao cũng được."

msgid "vo_sm_char01_m03_stg25_03"
msgstr "Brooks: Đừng ngu, đây không cần bùa may mắn."

msgid "vo_sm_char01_m03_stg25_05"
msgstr "Brooks: Kế hoạch và Chiến lược, McLeod, Kế hoạch và Chiến lược."

msgid "vo_sm_char01_m03_stg26_02"
msgstr "Brooks: Cái bàn gì?"

msgid "vo_sm_char01_m03_stg28_03"
msgstr "Brooks: ĐM, tình báo không nói vụ này..."

msgid "vo_sm_char01_m03_stg28_07"
msgstr "Brooks: Làm hết sức vậy."

msgid "vo_sm_char01_m03_stg30_02"
msgstr "Brooks: Được báo là Eagle One vẫn còn sống. Làm tốt lắm anh em."

msgid "vo_sm_char01_m03_stg30_03"
msgstr "Brooks: Đúng thật, MacLeod, đôi khi ta cần chút bùa may."

msgid "vo_sm_char01_m03_stg30_03_01"
msgstr "Brooks: À ừ, đây cũng có thật. Một cái chuông tintinnabulum với con c** thần thánh."

msgid "vo_sm_char01_m03_stg30_05"
msgstr "Brooks: (cười lớn)"

msgid "vo_sm_char01_m03_stg32_04"
msgstr "Brooks: Lucky, đến lúc đi rồi. Ở đây không phải ngắm cảnh."

msgid "vo_sm_char01_m03_stg32_05"
msgstr "Brooks: Tiến lên, Lucky! Mỗi giây đều quan trọng trong cuộc chiến này."

msgid "vo_sm_char01_m03_stg32_06"
msgstr "Brooks: Lucky, ta có nhiệm vụ phải hoàn thành. Đi nào."

msgid "vo_sm_char01_m03_stg33_02"
msgstr "Brooks: Betsy nói vậy thật à?"

msgid "vo_sm_char01_m03_stg34_01"
msgstr "Brooks: Thời gian không ở bên ta. Giờ đừng nổi máu anh hùng."

msgid "vo_sm_char01_m03_stg34_01_01"
msgstr "Brooks: Luôn dùng thế gọng kìm kẹp kẻ thù nếu có thể. Làm chúng rối loạn rồi chọc hai bên hông."

msgid "vo_sm_char01_m03_stg40_01"
msgstr "Brooks: Đang gửi quân tiếp viện đến. Cố trụ."

msgid "vo_sm_char01_m03_stg40_02"
msgstr "Brooks: Đang có hỗ trợ đến. Sớm thôi."

msgid "vo_sm_char01_m03_stg40_03"
msgstr "Brooks: Tăng đồng minh mới đang trên đường tới."

msgid "vo_sm_char01_m03_stg42_05"
msgstr "Brooks: Trở lại rồi, Chỉ huy. Thấp cái đầu xuống và đẩy lên."

msgid "vo_sm_char01_m03_stg42_06"
msgstr "Brooks: Cẩn thận với con tăng này dùm anh cái. Sắp hết xe dự phòng rồi."

msgid "vo_sm_char01_m03_stg42_07"
msgstr "Brooks: Thêm cơ hội nữa. Tận dụng đi."

msgid "vo_sm_char01_m04_stg01_02"
msgstr "Brooks: Sở Chỉ huy đây. Thượng sĩ Brooks ở đầu dây này."

msgid "vo_sm_char01_m04_stg01_04"
msgstr "Brooks: Không, chắc là không."

msgid "vo_sm_char01_m04_stg01_04_01"
msgstr "Brooks: Hy vọng thế."

msgid "vo_sm_char01_m04_stg02_02"
msgstr "Brooks: Không. Cái gì đó to và nặng. Đồng minh thử nhiều lần rồi."

msgid "vo_sm_char01_m04_stg02_02_01"
msgstr "Brooks: Đã gửi đi vài trung đội tăng. Không ai trở lại."

msgid "vo_sm_char01_m04_stg03_02"
msgstr "Brooks: Không, tình báo nói rằng mục tiêu của chúng ta vẫn còn trong thành phố."

msgid "vo_sm_char01_m04_stg05_01"
msgstr "Brooks: Đừng hấp tấp! Giờ không phải lúc mạo hiểm! Có nhiệm vụ khác cần ưu tiên."

msgid "vo_sm_char01_m04_stg06_02"
msgstr "Brooks: Đề nghị sử dụng con át chủ bài."

msgid "vo_sm_char01_m04_stg07_01"
msgstr "Brooks: Sở Chỉ huy gọi Storm Petrel, nghe rõ trả lời."

msgid "vo_sm_char01_m04_stg07_03"
msgstr "Brooks: Mục tiêu là một chiếc King Tiger trên cây cầu tại ô tọa độ C3."

msgid "vo_sm_char01_m04_stg08_03"
msgstr "Brooks: Đợi đã, MacLeod. Rủi ro quá."

msgid "vo_sm_char01_m04_stg08_03_01"
msgstr "Brooks: Tác chiến cùng nhau. Làm bất động chiếc Tiger. Storm Petrel sẽ lượn một vòng nữa."

msgid "vo_sm_char01_m04_stg08_03_02"
msgstr "Brooks: Làm bất động chiếc Tiger. Storm Petrel sẽ lượn một vòng nữa."

msgid "vo_sm_char01_m04_stg13_03"
msgstr "Brooks: Không có thông tin rõ ràng, MacLeod."

msgid "vo_sm_char01_m04_stg13_03_01"
msgstr "Brooks: Thử nghiệm gì gì đó. Một nguyên mẫu. Và không phải dạng vừa đâu."

msgid "vo_sm_char01_m04_stg14_02"
msgstr "Brooks: MacLeod, không có thời gian cho chuyện này. Đừng chõ mũi vào."

msgid "vo_sm_char01_m04_stg15_01"
msgstr "Brooks: Bỏ qua đi, luồn sang các con phố nhỏ. Gửi tọa độ cho Bennett."

msgid "vo_sm_char01_m04_stg15_03"
msgstr "Brooks: Storm Petrel."

msgid "vo_sm_char01_m04_stg17_02"
msgstr "Brooks: Typ 205."

msgid "vo_sm_char01_m04_stg17_04"
msgstr "Brooks: Sao lại \"Chuột Tí\"?"

msgid "vo_sm_char01_m04_stg19_02"
msgstr "Brooks: Đó là tình báo. Họ đáng ra phải về đến căn cứ rồi."

msgid "vo_sm_char01_m04_stg23_02"
msgstr "Brooks: Xin lỗi, MacLeod. Hơi buột miệng."

msgid "vo_sm_char01_m04_stg24_06"
msgstr "Brooks: Có thể, nhưng cần thời gian."

msgid "vo_sm_char01_m04_stg26_02"
msgstr "Brooks: Đó là một chiến dịch bí mật."

msgid "vo_sm_char01_m04_stg26_02_01"
msgstr "Brooks: Nhưng tự tiện quyết định đấu với con Jagdtiger đó."

msgid "vo_sm_char01_m04_stg26_04"
msgstr "Brooks: Họ bị kẹt trong những cuộc đụng độ ở tuyến đầu."

msgid "vo_sm_char01_m04_stg27_01"
msgstr "Brooks: Máy bay ném bom đang vào hàng oanh tạc rồi. Chuẩn bị xem pháo hoa."

msgid "vo_sm_char01_m04_stg28_02"
msgstr "Brooks: Biết cằn nhằn từ khi nào thế, MacLeod?"

msgid "vo_sm_char01_m04_stg30_03"
msgstr "Brooks: Ai nói đó là những con Tiger đầu tiên? Nghĩ xem tại sao được vào nhiệm vụ này?"

msgid "vo_sm_char01_m04_stg31_02"
msgstr "Brooks: Làm việc nhóm tốt đấy, MacLeod."

msgid "vo_sm_char01_m04_stg33_02"
msgstr "Brooks: Chết tiệt! Lucky, hãy cẩn thận và... chúc may mắn!"

msgid "vo_sm_char01_m04_stg35_01"
msgstr "Brooks: Tiếp viện đang trên đường tới vị trí."

msgid "vo_sm_char01_m04_stg35_01_01"
msgstr "Brooks: Những chiếc tăng đồng minh đã cứu lúc trước. MacLeod, nỗ lực không vô ích."

msgid "vo_sm_char01_m04_stg42_02"
msgstr "Brooks: Nhóm đồng minh mới đã đến."

msgid "vo_sm_char01_m04_stg42_02_01"
msgstr "Brooks: Hy vọng sự giúp đỡ này sẽ đánh bại Chuột Tí dễ hơn."

msgid "vo_sm_char01_m04_stg42_03"
msgstr "Brooks: Nhưng đừng quên, phát súng cuối cùng phải là của chúng ta."

msgid "vo_sm_char01_m04_stg42_03_01"
msgstr "Brooks: Đây hẳn là chiến lợi phẩm của chúng ta. Lucky, Bennett, đừng bỏ lỡ."

msgid "vo_sm_char01_m04_stg47_01"
msgstr "Brooks: Làm tốt lắm các đồng chí. Đang gửi đội hộ tống đến di tản anh em."

msgid "vo_sm_char01_m04_stg47_01_01"
msgstr "Brooks: MacLeod, cần đưa cả Chuột Tí ra nữa. Điều tối quan trọng là nó rơi vào tay quân ta."

msgid "vo_sm_char01_m04_stg47_01_02"
msgstr "Brooks: Cứ nghĩ huân chương đã nằm trong túi đi."

msgid "vo_sm_char01_m04_stg47_03"
msgstr "Brooks: Thế muốn gì, MacLeod? Thăng chức?"

msgid "vo_sm_char02_m03_stg01_01"
msgstr "MacLeod: Được rồi, quý vị, đã đến lúc tiến lên và dọn dẹp thị trấn này!"

msgid "vo_sm_char02_m03_stg01_03"
msgstr "MacLeod: Brooks?! Trung sĩ Brooks?! Tin tốt vãi! Chúng ta được bảo kê rồi!"

msgid "vo_sm_char02_m03_stg01_05"
msgstr "MacLeod: Vâng thưa sếp!"

msgid "vo_sm_char02_m03_stg01_05_01"
msgstr "MacLeod: Anh em! Sóc đồng xu may mắn của mình trước phát súng đầu tiên!"

msgid "vo_sm_char02_m03_stg01_07"
msgstr "MacLeod: Gì cơ? Đây không mê tín, nhưng phong tục là thế!"

msgid "vo_sm_char02_m03_stg02_01"
msgstr "MacLeod: Á à, cặp chim tình nhân của chúng ta đây."

msgid "vo_sm_char02_m03_stg02_01_01"
msgstr "MacLeod: Tôi bao ly \"trà\" Scotch đầu tiên cho ai diệt nhiều nhất!"

msgid "vo_sm_char02_m03_stg02_01_02"
msgstr "MacLeod: Lucky, làm mẫu cho thiên hạ thấy nào!"

msgid "vo_sm_char02_m03_stg03_01"
msgstr "MacLeod: Quá yên tĩnh, không phải gu của tôi. Thử thách ở đâu?"

msgid "vo_sm_char02_m03_stg03_01_01"
msgstr "MacLeod: Thôi thì... Lucky, mở mồm – kể nghi thức cầu may của mình?"

msgid "vo_sm_char02_m03_stg03_03"
msgstr "MacLeod: Ai cũng có cách lấy may riêng, phải không Lucky?"

msgid "vo_sm_char02_m03_stg03_03_01"
msgstr "MacLeod: Một điệu nhảy? Jig phát nhanh trước khi vào cuộc?"

msgid "vo_sm_char02_m03_stg04_01"
msgstr "MacLeod: A ha, giờ nói rồi đó! Trông có vẻ rất quyết tâm chiến đấu."

msgid "vo_sm_char02_m03_stg05_01"
msgstr "MacLeod: Lời khôn đấy, ông già Brooks. Lucky, giúp với, được không?"

msgid "vo_sm_char02_m03_stg05_01_01"
msgstr "MacLeod: Tôi sẽ thu hút sự chú ý của con quái vật, hãy lẻn sang bên phải nó."

msgid "vo_sm_char02_m03_stg05_01_02"
msgstr "MacLeod: Cho chúng bất con mẹ nó ngờ, ô-kế?"

msgid "vo_sm_char02_m03_stg06_01"
msgstr "MacLeod: Cái này khó nhai lắm, Lucky! Xé toạc nó ra!"

msgid "vo_sm_char02_m03_stg07_01"
msgstr "MacLeod: Đừng để thoát! Nó sẽ làm hỏng hết bất ngờ của chúng ta!"

msgid "vo_sm_char02_m03_stg07_02"
msgstr "MacLeod: Xong, gọn gàng!"

msgid "vo_sm_char02_m03_stg07_04"
msgstr "MacLeod: Đùa tí thôi mà, thân mới thế, thưa \"sếppppppppp\"!"

msgid "vo_sm_char02_m03_stg07_06"
msgstr "MacLeod: Rồi, rồi, biết rồi."

msgid "vo_sm_char02_m03_stg08_01"
msgstr "MacLeod: Các sếp bé, sao nay ít nói thế?"

msgid "vo_sm_char02_m03_stg08_03"
msgstr "MacLeod: Há!"

msgid "vo_sm_char02_m03_stg09_00"
msgstr "MacLeod: Chết bà, chọc phải tổ kiến lửa rồi."

msgid "vo_sm_char02_m03_stg09_00_01"
msgstr "MacLeod: Lucky, nhớ giấu thân xe đằng sau gò đất hoặc xác địch."

msgid "vo_sm_char02_m03_stg09_00_02"
msgstr "MacLeod: Chỉ để lộ tháp pháo—phần cứng nhất của tăng mình."

msgid "vo_sm_char02_m03_stg09_01"
msgstr "MacLeod: Đúng, đây là đối thủ nặng ký, không đùa được."

msgid "vo_sm_char02_m03_stg09_01_01"
msgstr "MacLeod: Chúng ta không thể đánh trực diện, hãy làm theo kế hoạch."

msgid "vo_sm_char02_m03_stg09_01_02"
msgstr "MacLeod: Tôi thu hút sự chú ý, ông lẻn ra phía sau. Nhưng hãy cẩn thận, Lucky."

msgid "vo_sm_char02_m03_stg09_02"
msgstr "MacLeod: Nếu nó quay sang ngắm ông, đừng bày đặt anh hùng—trốn ngay."

msgid "vo_sm_char02_m03_stg09_02_01"
msgstr "MacLeod: Súng nó xuyên thủng Sherman của chúng ta từ đầu đến đít."

msgid "vo_sm_char02_m03_stg09_03"
msgstr "MacLeod: Giữ đấy, để tôi lẻn ra sau hốt nó."

msgid "vo_sm_char02_m03_stg10_01"
msgstr "MacLeod: Phù, mãi cũng xong!"

msgid "vo_sm_char02_m03_stg10_03"
msgstr "MacLeod: Chưa gặp con Tiger nào cả. Ta cần chúng để xem ai giỏi nhất!"

msgid "vo_sm_char02_m03_stg10_05"
msgstr "MacLeod: Già! Ha ha!"

msgid "vo_sm_char02_m03_stg11_01"
msgstr "MacLeod: Đờ phắc, từ từ đã các sếp!"

msgid "vo_sm_char02_m03_stg11_01_01"
msgstr "MacLeod: Mìn. Này thì chế nhạo bùa may này, Brooks."

msgid "vo_sm_char02_m03_stg11_01_02"
msgstr "MacLeod: Đ** may là ăn l** hết cả lũ!"

msgid "vo_sm_char02_m03_stg12_01"
msgstr "MacLeod: Ê, Lucky! Tìm đường khác. Đi thôi."

msgid "vo_sm_char02_m03_stg12_01_01"
msgstr "MacLeod: Sẽ ra sao nếu không có bạn già MacLeod này!"

msgid "vo_sm_char02_m03_stg12_02"
msgstr "MacLeod: Ngồi đây đến đêm nhá! Ha ha!"

msgid "vo_sm_char02_m03_stg12_03"
msgstr "MacLeod: Ồ! Tìm được con đường vòng! Tuyệt vời!"

msgid "vo_sm_char02_m03_stg12_03_01"
msgstr "MacLeod: Tưởng sắp kẹt ở đây đến tối chờ công binh chứ."

msgid "vo_sm_char02_m03_stg13_01"
msgstr "MacLeod: Nhìn kìa, Lucky! Hai con Tiger! Cuộc so tài của chúng ta trở lại rồi."

msgid "vo_sm_char02_m03_stg14_01"
msgstr "MacLeod: Nhưng đường phố này quá hẹp. Xuyên thủng giáp trước Tiger không dễ."

msgid "vo_sm_char02_m03_stg14_03"
msgstr "MacLeod: Tốt lắm! Chờ đấy, sắp được xem nghệ thuật rồi."

msgid "vo_sm_char02_m03_stg14_03_01"
msgstr "MacLeod: Các sếp trên trời của chúng ta sẽ diệt lũ quái vật thép này chính xác như dao phẫu thuật."

msgid "vo_sm_char02_m03_stg15_01"
msgstr "MacLeod: Ôi, gì thế?! Tiếng to quá!"

msgid "vo_sm_char02_m03_stg15_01_01"
msgstr "MacLeod: Ôi, gì vừa xảy ra vậy?!"

msgid "vo_sm_char02_m03_stg15_03"
msgstr "MacLeod: Ừ, vẫn ổn, nhưng rớt mẹ đồng xu may mắn!"

msgid "vo_sm_char02_m03_stg15_03_01"
msgstr "MacLeod: Mấy tòa nhà hồi trước ở đây đâu rồi?"

msgid "vo_sm_char02_m03_stg16_01"
msgstr "MacLeod: Lucky! Nhìn kìa, con Tiger thứ hai còn ngọ nguậy."

msgid "vo_sm_char02_m03_stg16_01_01"
msgstr "MacLeod: Tận dụng khoảng trống mới này. Ép chặt từ hai phía."

msgid "vo_sm_char02_m03_stg17_01"
msgstr "MacLeod: Bắn tốt! Một con Tiger nữa vào chuồng chúng ta!"

msgid "vo_sm_char02_m03_stg18_01"
msgstr "MacLeod: Ái dà, bất ngờ chưa ông già! Thêm Tiger! Kiếp trước làm gì mà được nhiều quà thế này?"

msgid "vo_sm_char02_m03_stg18_01_01"
msgstr "MacLeod: Chết tiệt, chỗ đây đông quá. Brooks, có lời khuyên nào không?"

msgid "vo_sm_char02_m03_stg19_01"
msgstr "MacLeod: Anh thích chú rồi đấy! Lucky, làm như sách giáo khoa. Sử dụng lối đi mới này."

msgid "vo_sm_char02_m03_stg19_01_01"
msgstr "MacLeod: Tôi sẽ dí từ phía trước, đồng chí lẻn sang bên."

msgid "vo_sm_char02_m03_stg20_01"
msgstr "MacLeod: Khiến con quỷ này nhảy lung tung như bắp rang bơ."

msgid "vo_sm_char02_m03_stg20_01_01"
msgstr "MacLeod: Hãy đợi tới khi cả hai ta đều nạp xong, để nó không biết đạn sẽ đến từ phía nào."

msgid "vo_sm_char02_m03_stg20_02"
msgstr "MacLeod: Từ trước trông rất cứng. Nhưng hai bên hông và phía sau lại mềm mại múp máp lắm!"

msgid "vo_sm_char02_m03_stg21_01"
msgstr "MacLeod: Chắc chắn phải có gì đó mang lại may mắn, Lucky. Có lẽ nào..."

msgid "vo_sm_char02_m03_stg21_03"
msgstr "MacLeod: Đó là truyền thống, Brooks. Không phải mê tín."

msgid "vo_sm_char02_m03_stg21_05"
msgstr "MacLeod: Đủ rồi, chuyến tham quan hoành tráng này phải kết thúc thôi. Eagle One, nghe rõ trả lời?"

msgid "vo_sm_char02_m03_stg21_05_01"
msgstr "MacLeod: Cho chúng tôi cái nhìn tổng quan—bao nhiêu fan hâm mộ cuồng nhiệt còn lảng vảng ở quảng trường?"

msgid "vo_sm_char02_m03_stg22_02"
msgstr "MacLeod: Công nhận, phải nói, anh thích chú này!"

msgid "vo_sm_char02_m03_stg22_02_01"
msgstr "MacLeod: Tiếc là không làm trong ngành xe tăng. Chúng ta cần người như thế vào đội."

msgid "vo_sm_char02_m03_stg23_01"
msgstr "MacLeod: Vậy thì, chào lần cất cánh cuối cùng."

msgid "vo_sm_char02_m03_stg23_01_01"
msgstr "MacLeod: Eagle One, cẩn thận trên đó, tiêm kích địch đang xuất hiện từ đường chân trời."

msgid "vo_sm_char02_m03_stg24_01"
msgstr "MacLeod: Mìn! Đ** m* mìn. Tìm đường vòng đi, Lucky. Tôi sẽ hút sự chú ý của chúng."

msgid "vo_sm_char02_m03_stg25_01"
msgstr "MacLeod: Coi như Lucky đẻ ra dưới ngôi sao may mắn đi."

msgid "vo_sm_char02_m03_stg25_01_01"
msgstr "MacLeod: Còn Brooks? Có bùa may mắn riêng à?"

msgid "vo_sm_char02_m03_stg25_02"
msgstr "MacLeod: Móng ngựa trong túi? Hay một cái chuông tintinnabulum với con c** thần thánh?"

msgid "vo_sm_char02_m03_stg25_04"
msgstr "MacLeod: Từ từ đã. Đoán đúng à?"

msgid "vo_sm_char02_m03_stg26_01"
msgstr "MacLeod: Mấy thằng ranh, nhìn các huyền thoại làm đây mà học!"

msgid "vo_sm_char02_m03_stg26_01_01"
msgstr "MacLeod: Nếu không bị thương, Brooks chắc chắn sẽ ở đây!"

msgid "vo_sm_char02_m03_stg26_01_02"
msgstr "MacLeod: Cả ba chúng ta phối hợp... À thôi, không ăn mày quá khứ được. Giờ Brooks chỉ còn là cái b..."

msgid "vo_sm_char02_m03_stg26_03"
msgstr "MacLeod: Cái bàn huyền thoại, thưa sếp!"

msgid "vo_sm_char02_m03_stg27_01"
msgstr "MacLeod: Chết tiệt! Đen tình đỏ bạc, bọn pháo nhập cuộc rồi!"

msgid "vo_sm_char02_m03_stg27_01_01"
msgstr "MacLeod: Đừng ngồi im, Lucky—di chuyển! Cho bọn nó sợ bắn trúng người mình."

msgid "vo_sm_char02_m03_stg28_02"
msgstr "MacLeod: Brooks, bọn ăn chực này ở đâu đến thế?"

msgid "vo_sm_char02_m03_stg28_02_01"
msgstr "MacLeod: Họp trước trận đéo ai nói gì."

msgid "vo_sm_char02_m03_stg28_04"
msgstr "MacLeod: Ôi, tình báo yêu dấu... có như không, cắt mẹ ngân sách đi."

msgid "vo_sm_char02_m03_stg28_04_01"
msgstr "MacLeod: Eagle One, hộ chúng tôi được bao nhiêu?"

msgid "vo_sm_char02_m03_stg28_06"
msgstr "MacLeod: Eagle-One, nghe rõ trả lời! Eagle-One! Chết tiệt!"

msgid "vo_sm_char02_m03_stg28_06_01"
msgstr "MacLeod: Brooks, quân ta có chiến đấu cơ giúp họ đúng không?!"

msgid "vo_sm_char02_m03_stg28_08"
msgstr "MacLeod: Lucky, thấy gì không? Cố lên, Eagle One, cắt đuôi chúng đi. Vãi nồi!"

msgid "vo_sm_char02_m03_stg28_08_01"
msgstr "MacLeod: Hạ màn thôi, Lucky. Bánh mì kẹp thịt chúng từ hai phía. Đéo lịch sự nữa."

msgid "vo_sm_char02_m03_stg29_01"
msgstr "MacLeod: Hình như ta có nhiều khách hàng hơn dự tính."

msgid "vo_sm_char02_m03_stg29_01_01"
msgstr "MacLeod: Dồn hỏa lực vào cùng mục tiêu. Chúng ta sẽ vặt từng thằng một, Lucky."

msgid "vo_sm_char02_m03_stg29_01_02"
msgstr "MacLeod: Và món tráng miệng sẽ là miếng pháo tự hành xắt mỏng ngọt lịm!"

msgid "vo_sm_char02_m03_stg30_01"
msgstr "MacLeod: Phù... Khổ vãi l**. Ố ồ, nhìn này! Tìm thấy đồng xu may mắn của tôi!"

msgid "vo_sm_char02_m03_stg30_04"
msgstr "MacLeod: Chờ đã. Cái gì??? Đùa nhau à? Phải xem tận mắt!"

msgid "vo_sm_char02_m03_stg31_01"
msgstr "MacLeod: Tránh ra, Lucky, không thôi trà nhà mình sẽ lạnh cóng như mùa đông Phần Lan."

msgid "vo_sm_char02_m03_stg31_02"
msgstr "MacLeod: Đi thôi, Lucky! Mấy con Tiger không tự rót bia rồi ngã vào lòng ta đâu!"

msgid "vo_sm_char02_m03_stg31_03"
msgstr "MacLeod: Không có mìn ở đây, Lucky. Đến lúc đi rồi."

msgid "vo_sm_char02_m03_stg31_04"
msgstr "MacLeod: Lucky, có phải đang dã ngoại đâu. Đi nhanh!"

msgid "vo_sm_char02_m03_stg31_05"
msgstr "MacLeod: Đừng đứng đực ra đấy, Lucky. Pháo không bao giờ ngủ."

msgid "vo_sm_char02_m03_stg32_01"
msgstr "MacLeod: Lucky, hãy tìm đường vòng qua đống mìn này."

msgid "vo_sm_char02_m03_stg32_02"
msgstr "MacLeod: Đừng đứng đực ra đấy, Lucky. Soi đường khác đi."

msgid "vo_sm_char02_m03_stg32_03"
msgstr "MacLeod: Ngắm đống mìn không làm gì được chúng đâu, Lucky."

msgid "vo_sm_char02_m03_stg32_03_01"
msgstr "MacLeod: Tìm đường khác thôi."

msgid "vo_sm_char02_m03_stg33_01"
msgstr "MacLeod: Như bà tôi hay nói, \"Luôn chọc hông kẻ thù rồi nhồi đạn xuyên giáp vào chúng.\""

msgid "vo_sm_char02_m03_stg33_03"
msgstr "MacLeod: Đại loại thế."

msgid "vo_sm_char02_m03_stg35_01"
msgstr "MacLeod: Đừng quên, kẹp địch từ hai phía, chúng sẽ luôn lộ điểm yếu cho một trong hai chúng ta."

msgid "vo_sm_char02_m03_stg35_02"
msgstr "MacLeod: Đóng thùng chúng nào, chọc từ hai cánh sườn."

msgid "vo_sm_char02_m03_stg35_02_01"
msgstr "MacLeod: Bằng cách đó, chúng sẽ để lộ điểm yếu."

msgid "vo_sm_char02_m03_stg35_03"
msgstr "MacLeod: Làm như sách giáo khoa: Tấn công từ hai phía, một trong hai ta chắc chắn liếm được miếng giáp hông mỏng manh ngon lành!"

msgid "vo_sm_char02_m03_stg36_01"
msgstr "MacLeod: Đi cẩn thận, Lucky!"

msgid "vo_sm_char02_m03_stg36_02"
msgstr "MacLeod: Coi chừng mìn!"

msgid "vo_sm_char02_m03_stg36_03"
msgstr "MacLeod: Chờ đã! Đống mìn này không thích xe tăng chúng ta! "

msgid "vo_sm_char02_m03_stg36_04"
msgstr "MacLeod: Mìn! Đ** m* mìn."

msgid "vo_sm_char02_m03_stg36_05"
msgstr "MacLeod: Cẩn trọng! Mìn quanh đây cáu kỉnh lắm."

msgid "vo_sm_char02_m03_stg36_06"
msgstr "MacLeod: Có mìn phía trước! Tốt nhất tìm đường khác."

msgid "vo_sm_char02_m03_stg37_01"
msgstr "MacLeod: Lucky! Nổ to thế! Đằng ấy ổn không?"

msgid "vo_sm_char02_m03_stg37_02"
msgstr "MacLeod: Từ từ! Đi đâu vội thế?"

msgid "vo_sm_char02_m03_stg37_02_01"
msgstr "MacLeod: Sửa xích rồi lùi ra khỏi đó!"

msgid "vo_sm_char02_m03_stg37_03"
msgstr "MacLeod: Lucky, nếu muốn đào mồ chôn, có cách nhẹ nhàng hơn mà!"

msgid "vo_sm_char02_m03_stg37_04"
msgstr "MacLeod: Lằn ranh đỏ, Lucky. Đống mìn này trốn kỹ lắm."

msgid "vo_sm_char02_m03_stg37_05"
msgstr "MacLeod: Ái chà, cũng là một cách dò mìn. Không phải tối ưu, nhưng cũng được."

msgid "vo_sm_char02_m03_stg37_06"
msgstr "MacLeod: Cắt đi, Lucky. Ai cũng phải nhảy với một hoặc hai quả mìn."

msgid "vo_sm_char02_m03_stg38_01"
msgstr "MacLeod: Cẩn thận, Lucky! Quả mìn tiếp theo có thể là quả cuối đời đấy."

msgid "vo_sm_char02_m03_stg38_02"
msgstr "MacLeod: Có vẻ thích sửa xích hơi nhiều nhỉ, Lucky."

msgid "vo_sm_char02_m03_stg38_03"
msgstr "MacLeod: Gì?! Nữa hả? Yêu mìn cuồng dại à, Lucky?"

msgid "vo_sm_char02_m03_stg39_01"
msgstr "MacLeod: Mẹ, chúng ta vừa mất một xe tăng."

msgid "vo_sm_char02_m03_stg39_02"
msgstr "MacLeod: Còn cái nịt! Mất thêm một đồng chí nữa!"

msgid "vo_sm_char02_m03_stg39_03"
msgstr "MacLeod: Mất một tăng đồng minh. Chúng ta giờ phải gánh gấp đôi."

msgid "vo_sm_char02_m03_stg41_01"
msgstr "MacLeod: Tăng của tôi bị hạ. Sẽ trở lại trong giây lát! Tất nhiên có xe mới ngay."

msgid "vo_sm_char02_m03_stg41_02"
msgstr "MacLeod: À, đ** m*! Chiếc tăng ưa thích của tôi. Thôi kệ, hiệp hai sớm thôi!"

msgid "vo_sm_char02_m03_stg41_03"
msgstr "MacLeod: Tôi trúng đạn. Đừng lo, sẽ trở lại với chiếc mới—hy vọng nó có màu ưa thích."

msgid "vo_sm_char02_m03_stg41_04"
msgstr "MacLeod: Vờ cờ lờ. Hỏng một tăng nữa. Chờ một phút, tôi sẽ quay lại ngay."

msgid "vo_sm_char02_m03_stg41_05"
msgstr "MacLeod: Có vẻ tôi phải trở lại thị trường mua bán tăng mới nữa."

msgid "vo_sm_char02_m03_stg41_05_01"
msgstr "MacLeod: Đứng yên, tôi sẽ trở lại trước khi có người kịp hỏi \"MacLeod đâu?\""

msgid "vo_sm_char02_m03_stg42_01"
msgstr "MacLeod: Trở lại rồi, ế? Cho chúng sợ nào!"

msgid "vo_sm_char02_m03_stg42_02"
msgstr "MacLeod: Dậy mà đi, hỡi đồng bào ơi. Hiệp hai! Cố lên."

msgid "vo_sm_char02_m03_stg42_03"
msgstr "MacLeod: Đây không phải đại lý bán xe. Giữ chiếc này cẩn thận."

msgid "vo_sm_char02_m03_stg42_04"
msgstr "MacLeod: Ha ha! Không ai cản được, phải không? Quay lại thêm, ế?"

msgid "vo_sm_char02_m04_stg01_01"
msgstr "MacLeod: Các Thợ săn Tiger tại điểm tập kết."

msgid "vo_sm_char02_m04_stg01_01_01"
msgstr "MacLeod: Brooks, gọi tên cúng cơm được không? A lô?"

msgid "vo_sm_char02_m04_stg01_03"
msgstr "MacLeod: Sao câu nệ thế, Brooks? Ai chả biết ông."

msgid "vo_sm_char02_m04_stg01_03_01"
msgstr "MacLeod: Giờ hỏi thật, quân ta có biết chúng tôi đang ở trong thành phố không?"

msgid "vo_sm_char02_m04_stg01_03_02"
msgstr "MacLeod: Họ sẽ chừa chúng tôi ra, đúng không?"

msgid "vo_sm_char02_m04_stg01_05"
msgstr "MacLeod: Câu trả lời này nghe thấy dễ ăn l** lắm?"

msgid "vo_sm_char02_m04_stg02_01"
msgstr "MacLeod: Đang tìm cái gì hả Brooks? Chắc chắn không phải con muỗi này?"

msgid "vo_sm_char02_m04_stg03_01"
msgstr "MacLeod: Có người trở lại. Tôi thấy một tăng quân ta. Lỡ cuộc vui rồi?"

msgid "vo_sm_char02_m04_stg03_03"
msgstr "MacLeod: Giời ạ, ông tình báo..."

msgid "vo_sm_char02_m04_stg04_01"
msgstr "MacLeod: Đ**! Nữa này."

msgid "vo_sm_char02_m04_stg04_01_01"
msgstr "MacLeod: Đó là... úi giời, Brooks, lại con quái vật đó. King Tiger."

msgid "vo_sm_char02_m04_stg04_01_02"
msgstr "MacLeod: Lucky, biết làm gì rồi đấy. Sẵn sàng?"

msgid "vo_sm_char02_m04_stg06_01"
msgstr "MacLeod: Ý ông là sao? Bỏ chạy? Để nó lại đây?"

msgid "vo_sm_char02_m04_stg08_02"
msgstr "MacLeod: Có cố gắng, nhưng hình như..."

msgid "vo_sm_char02_m04_stg09_01"
msgstr "MacLeod: Cho ông già Brooks cười tự hào vì chúng ta nào, Lucky."

msgid "vo_sm_char02_m04_stg09_01_01"
msgstr "MacLeod: Nhằm vào bánh truyền động phía trước hoặc sau. Cách dễ nhất để chặt xích đối phương."

msgid "vo_sm_char02_m04_stg09_01_02"
msgstr "MacLeod: Nhằm vào bánh truyền động phía trước hoặc sau. Cách dễ nhất để chặt xích đối phương."

msgid "vo_sm_char02_m04_stg10_01"
msgstr "MacLeod: Bắn tiếp đi, sớm muộn gì cũng đứt xích."

msgid "vo_sm_char02_m04_stg10_01_01"
msgstr "MacLeod: Và cỗ xe này sẽ thành quả bí ngô."

msgid "vo_sm_char02_m04_stg10_01_02"
msgstr "MacLeod: Bắn tiếp đi, sớm muộn gì cũng đứt xích."

msgid "vo_sm_char02_m04_stg11_01"
msgstr "MacLeod: Chuẩn rồi đấy! Bắn tốt. Seagull, đến lượt sếp."

msgid "vo_sm_char02_m04_stg13_01"
msgstr "MacLeod: Nghe như cô giáo sinh học hồi xưa. Chị Nguyễn Thị Vật."

msgid "vo_sm_char02_m04_stg13_02"
msgstr "MacLeod: Lucky, đi thôi trước khi con Mèo Chúa nào nữa xuất hiện."

msgid "vo_sm_char02_m04_stg13_02_01"
msgstr "MacLeod: Brooks, gợi ý đi, chúng tôi phải tìm cái gì?"

msgid "vo_sm_char02_m04_stg13_02_02"
msgstr "MacLeod: To hơn Vua Hổ King Tiger? Thiên Hoàng?"

msgid "vo_sm_char02_m04_stg14_01"
msgstr "MacLeod: Thấy tăng Đồng minh phía trước. Như thường lệ, họ chả làm gì ra hồn, chỉ biết hùng hục đẩy."

msgid "vo_sm_char02_m04_stg14_01_01"
msgstr "MacLeod: Chầy cối cũng không qua được Jagdtiger đâu. Lucky, chúng ta tính luôn Jagdtiger chứ?"

msgid "vo_sm_char02_m04_stg14_03"
msgstr "MacLeod: Brooks, ông ngồi trên Sở Chỉ huy hơi lâu rồi đấy."

msgid "vo_sm_char02_m04_stg14_03_01"
msgstr "MacLeod: Hiểu, ông phải viết tường trình. Nhưng đồng đội cần chúng tôi ngoài này."

msgid "vo_sm_char02_m04_stg15_02"
msgstr "MacLeod: Bennett?"

msgid "vo_sm_char02_m04_stg15_04"
msgstr "MacLeod: Phải thế chứ. Lucky, giúp đồng đội trên trời ghi vài điểm nào!"

msgid "vo_sm_char02_m04_stg16_01"
msgstr "MacLeod: Tái chế nhanh mấy cái lon thiếc này. Cần tiếp cận Jagdtiger sớm."

msgid "vo_sm_char02_m04_stg16_01_01"
msgstr "MacLeod: Nếu gặp phải hàng cứng hơn, hãy ngắm vào bánh dẫn động."

msgid "vo_sm_char02_m04_stg16_01_02"
msgstr "MacLeod: Cho \"chim biển\" của chúng ta vài bia tập bắn."

msgid "vo_sm_char02_m04_stg16_01_03"
msgstr "MacLeod: Ngắm vào bánh dẫn động. Cho \"chim biển\" của chúng ta vài bia tập bắn."

msgid "vo_sm_char02_m04_stg17_01"
msgstr "MacLeod: Cái nguyên mẫu này tên gì?"

msgid "vo_sm_char02_m04_stg17_01_01"
msgstr "MacLeod: Có mật danh không? Hay đây tự đặt được?"

msgid "vo_sm_char02_m04_stg17_03"
msgstr "MacLeod: Tên gì chán phèo. Tôi sẽ gọi nó là...Chuột Tí."

msgid "vo_sm_char02_m04_stg17_05"
msgstr "MacLeod: Nếu là kỹ sư Đức, tôi sẽ đặt thế cho vui."

msgid "vo_sm_char02_m04_stg18_01"
msgstr "MacLeod: Bao nhiêu ngoài đó? Muộn cuộc hẹn hò với Jagdtiger mất."

msgid "vo_sm_char02_m04_stg18_01_01"
msgstr "MacLeod: Lucky, khẩn trương. Để phái yếu chờ là không ga-lăng."

msgid "vo_sm_char02_m04_stg19_01"
msgstr "MacLeod: Oa! Thế là ai?"

msgid "vo_sm_char02_m04_stg19_01_01"
msgstr "MacLeod: Brooks! Sao không cảnh báo là có đơn vị phe ta ở đây?"

msgid "vo_sm_char02_m04_stg19_01_02"
msgstr "MacLeod: Đừng bảo tôi bọn tình báo lại ăn hại nhá!"

msgid "vo_sm_char02_m04_stg19_03"
msgstr "MacLeod: Trẻ không học, lớn làm tình báo."

msgid "vo_sm_char02_m04_stg19_03_01"
msgstr "MacLeod: Nhập hội với chúng tôi, đi một mình dễ hự lắm."

msgid "vo_sm_char02_m04_stg19_05"
msgstr "MacLeod: Lạy chúa. Mồm ông tía lia như thằng ở chiến dịch lần trước."

msgid "vo_sm_char02_m04_stg19_05_01"
msgstr "MacLeod: Ổn rồi, đi thôi, đến buổi hẹn hò hơi muộn."

msgid "vo_sm_char02_m04_stg20_01"
msgstr "MacLeod: Seagull!"

msgid "vo_sm_char02_m04_stg20_01_01"
msgstr "MacLeod: À quên, Storm Petrel! Chúng tôi tìm thấy mục tiêu mỡ màng cho sếp. Khó trượt lắm."

msgid "vo_sm_char02_m04_stg20_01_02"
msgstr "MacLeod: Lucky, ngắm vào bánh dẫn động!"

msgid "vo_sm_char02_m04_stg20_01_03"
msgstr "MacLeod: Lucky, ngắm vào bánh dẫn động!"

msgid "vo_sm_char02_m04_stg23_01"
msgstr "MacLeod: Rõ. Chúng ta sẽ sớm có m...Từ từ. Cái gì?!"

msgid "vo_sm_char02_m04_stg23_01_01"
msgstr "MacLeod: Ôi...Brooks, con ch*... Đó là bí mật giữa chúng ta!"

msgid "vo_sm_char02_m04_stg23_03"
msgstr "MacLeod: Vâng, tất nhiên. Có tuổi rồi, tôi hiểu."

msgid "vo_sm_char02_m04_stg24_01"
msgstr "MacLeod: Rất gần rồi anh em. Thiên thần hộ mệnh của chúng ta sẽ hóa giải mọi bất trắc."

msgid "vo_sm_char02_m04_stg24_03"
msgstr "MacLeod: Vấn đề gì nữa?"

msgid "vo_sm_char02_m04_stg24_05"
msgstr "MacLeod: Brooks, có lưỡi dao trong tay áo nào nữa không, to cỡ máy bay ném bom?"

msgid "vo_sm_char02_m04_stg24_07"
msgstr "MacLeod: Chúng ta sẽ chờ nó trôi qua. Đúng không, Lucky?"

msgid "vo_sm_char02_m04_stg25_01"
msgstr "MacLeod: Brooks? Nhanh nhanh hộ cái?"

msgid "vo_sm_char02_m04_stg25_01_01"
msgstr "MacLeod: Có thế lực thù địch tại đây. Nhiều quá. Tình báo, nói gì đi, sao im lìm thế!"

msgid "vo_sm_char02_m04_stg26_01"
msgstr "MacLeod: Brooks, ngoài chúng tôi và mấy ông kia, còn ai tấn công thành phố không?"

msgid "vo_sm_char02_m04_stg26_01_01"
msgstr "MacLeod: Tưởng làm nhiệm vụ bí mật, có phải tấn công tổng lực đâu."

msgid "vo_sm_char02_m04_stg26_03"
msgstr "MacLeod: Vẫn làm thôi. Tưởng có thêm chút hỗ trợ để chiếm thành phố."

msgid "vo_sm_char02_m04_stg26_05"
msgstr "MacLeod: Được thôi. May mắn đang ở bên ta! Chuẩn chưa, Lucky?"

msgid "vo_sm_char02_m04_stg27_02"
msgstr "MacLeod: Đợi mãi"

msgid "vo_sm_char02_m04_stg28_01"
msgstr "MacLeod: Sao cứ phải là chúng tôi mới xong việc?"

msgid "vo_sm_char02_m04_stg28_03"
msgstr "MacLeod: Ha ha! Có lẽ chúng ta đều già rồi, Brooks!"

msgid "vo_sm_char02_m04_stg28_03_01"
msgstr "MacLeod: Ra quán mấy lão thành nghỉ hưu làm ván cờ tướng đê?"

msgid "vo_sm_char02_m04_stg29_01"
msgstr "MacLeod: Lucky, vở cũ soạn lại. Chặt xích đê."

msgid "vo_sm_char02_m04_stg29_01_01"
msgstr "MacLeod: Chúng ta nên mai mối chiếc Jagdtiger này Bennett. Cả hai chắc chắn bén duyên."

msgid "vo_sm_char02_m04_stg29_01_02"
msgstr "MacLeod: Lucky, vở cũ soạn lại. Chặt xích đê."

msgid "vo_sm_char02_m04_stg30_02"
msgstr "MacLeod: Tinh thần phải thế! Ba điểm cho Bennett."

msgid "vo_sm_char02_m04_stg30_02_01"
msgstr "MacLeod: Ở đây nửa ngày nữa là bắt kịp chúng tôi thôi."

msgid "vo_sm_char02_m04_stg31_01"
msgstr "MacLeod: Đừng bảo đang hòa nhá! Brooks, nhiều Tiger như chúng tôi?"

msgid "vo_sm_char02_m04_stg31_03"
msgstr "MacLeod: Huỵch toẹt mẹ ra đi, vòng vo tam quốc."

msgid "vo_sm_char02_m04_stg32_01"
msgstr "MacLeod: Kinh dị quá. Chuột Tí răng sắc phát khiếp."

msgid "vo_sm_char02_m04_stg32_01_01"
msgstr "MacLeod: Hãy cảnh giác, Lucky. Bennett, cùng chúng tôi?"

msgid "vo_sm_char02_m04_stg33_01"
msgstr "MacLeod: Con ch*, cái động cơ lỏ này phản bội rồi!"

msgid "vo_sm_char02_m04_stg33_01_01"
msgstr "MacLeod: Lucky, đừng chờ, đẩy lên đi."

msgid "vo_sm_char02_m04_stg33_01_02"
msgstr "MacLeod: Tôi sẽ yểm trợ bằng mọi cách từ đây và điều khiển hỏa lực của Bennett."

msgid "vo_sm_char02_m04_stg33_01_03"
msgstr "MacLeod: Động cơ kiểu l** gì đấy!"

msgid "vo_sm_char02_m04_stg34_01"
msgstr "MacLeod: Thấy rồi. Cái l** má, con chuột này béo phì. Nặng bao nhiêu tấn thế anh em?"

msgid "vo_sm_char02_m04_stg34_01_01"
msgstr "MacLeod: À mà không quan trọng. Càng nặng, xích càng bị đè nén."

msgid "vo_sm_char02_m04_stg34_01_02"
msgstr "MacLeod: Hiểu vấn đề, Lucky? Biết ngắm vào đâu rồi đấy."

msgid "vo_sm_char02_m04_stg36_01"
msgstr "MacLeod: Đ** má nó bọc giáp dày tứ phía. Không thể xuyên được."

msgid "vo_sm_char02_m04_stg36_01_01"
msgstr "MacLeod: Trong cái khó ló cái khôn. Nóc xe chắc chắn mỏng."

msgid "vo_sm_char02_m04_stg36_01_02"
msgstr "MacLeod: Lucky, tập trung vào xích."

msgid "vo_sm_char02_m04_stg36_01_03"
msgstr "MacLeod: Lucky, tập trung vào xích."

msgid "vo_sm_char02_m04_stg37_01"
msgstr "MacLeod: Bắt được mày rồi, con Chuột! Storm Petrel, kết liễu nó đi để về nhà."

msgid "vo_sm_char02_m04_stg38_01"
msgstr "MacLeod: Cái đ**..địch không chết."

msgid "vo_sm_char02_m04_stg38_01_01"
msgstr "MacLeod: Lucky, trong khi chờ Bennett vòng lại, hãy xử lý bọn ruồi bu này."

msgid "vo_sm_char02_m04_stg39_01"
msgstr "MacLeod: Đám tay chân đến rồi. Xử lý chúng trước để rảnh tay."

msgid "vo_sm_char02_m04_stg40_01"
msgstr "MacLeod: Nó đi đâu thế? Trốn à? Lucky, ông làm nó sợ kìa."

msgid "vo_sm_char02_m04_stg40_01_01"
msgstr "MacLeod: Một lời chào nồng nhiệt nữa từ Bennett là xong."

msgid "vo_sm_char02_m04_stg41_01"
msgstr "MacLeod: Rồi. Bắt được nó. Bennett, cho chúng tôi về đi, mệt lắm rồi."

msgid "vo_sm_char02_m04_stg42_01"
msgstr "MacLeod: Hừm...nỗi đau kéo dài thật."

msgid "vo_sm_char02_m04_stg42_01_01"
msgstr "MacLeod: Mày là cái quái gì thế? Phải cháy phừng phừng rồi chứ."

msgid "vo_sm_char02_m04_stg42_01_02"
msgstr "MacLeod: Mẹ! Lucky, chúng ta làm nó giận rồi."

msgid "vo_sm_char02_m04_stg43_01"
msgstr "MacLeod: Lucky, cẩn thận, có nhóm địch mới đến đây."

msgid "vo_sm_char02_m04_stg44_01"
msgstr "MacLeod: Lucky, chỉ ngắm vào xích. Đừng phí đạn, đ** xuyên nổi giáp nó đâu."

msgid "vo_sm_char02_m04_stg45_01"
msgstr "MacLeod: Bennett, nó như cá nằm trên thớt! Làm thịt đi!"

msgid "vo_sm_char02_m04_stg46_01"
msgstr "MacLeod: Tuyệt vời! Xong rồi!"

msgid "vo_sm_char02_m04_stg46_03"
msgstr "MacLeod: Cảm ơn Bennett. Coi như nợ lần này!"

msgid "vo_sm_char02_m04_stg47_02"
msgstr "MacLeod: Úi giời, huân với chả chương. Nhà có đầy."

msgid "vo_sm_char02_m04_stg47_04"
msgstr "MacLeod: Chíu chíu! Ai thích cờ tướng nào? Lucky, chơi không?"

msgid "vo_sm_char02_m04_stg53_01"
msgstr "MacLeod: Chúng tôi đã làm nó bất động, Bennett. Duyệt hỏa lực."

msgid "vo_sm_char02_m04_stg54_01"
msgstr "MacLeod: Storm Petrel, xích của mục tiêu đã đứt. Dâng đến miệng rồi đấy!"

msgid "vo_sm_char02_m04_stg55_01"
msgstr "MacLeod: Xích đã đứt. Không quân, đến lượt các sếp."

msgid "vo_sm_char02_m04_stg56_01"
msgstr "MacLeod: Mục tiêu đã bất động, Bennett."

msgid "vo_sm_char02_m05_stg59_02"
msgstr "MacLeod: Đùa tí mới giải tỏa được căng thẳng! Anh em trong đội mới gắn kết."

msgid "vo_sm_char02_m05_stg60_02"
msgstr "MacLeod: Thế lời tôi nói không có giá trị gì? Ông bạn làm buồn quá!"

msgid "vo_sm_char03_m05_stg01_02"
msgstr "Connolly: Hỏng rồi! Chỉ huy đã chết! Các đồng chí, chúng ta phải tự lo thôi."

msgid "vo_sm_char03_m05_stg01_02_01"
msgstr "Connolly: Mọi người cẩn thận—quanh đây toàn mìn."

msgid "vo_sm_char03_m05_stg03_01"
msgstr "Connolly: Đ*****! Boongke bắn chết xe tăng phá mìn rồi!"

msgid "vo_sm_char03_m05_stg03_03"
msgstr "Connolly: Đ*****! Mìn! Đ***** mìn!"

msgid "vo_sm_char03_m05_stg04_01"
msgstr "Connolly: Chúng ta phải phá hủy mấy cái boongke khốn nạn đấy."

msgid "vo_sm_char03_m05_stg04_01_01"
msgstr "Connolly: Xe tăng của chúng ta không dễ gì diệt được chúng, nhưng hết cách rồi, phải thử."

msgid "vo_sm_char03_m05_stg04_01_02"
msgstr "Connolly: Biết đâu gặp may, chỉ cần một quả lọt qua kẽ hở nào cũng được!"

msgid "vo_sm_char03_m05_stg04_04"
msgstr "Connolly: Tiếp tục nổ súng vào các boongke đó, ta buộc phải tiêu diệt chúng. Hy vọng duy nhất."

msgid "vo_sm_char03_m05_stg08_01"
msgstr "Connolly: Boongke vô hiệu hóa. Tăng phá mìn đã có thể dọn lối."

msgid "vo_sm_char03_m05_stg09_01"
msgstr "Connolly: Cuối cùng... có đường rồi! Tiến công ngay!"

msgid "vo_sm_char03_m05_stg11_01"
msgstr "Connolly: Phát hiện tăng địch phía trước. Sẵn sàng nghênh chiến."

msgid "vo_sm_char03_m05_stg12_01"
msgstr "Connolly: Đ*****, chúng ta phải nhanh chóng tiêu diệt boongke này. Cần tiếp cận các khẩu phòng không ngay."

msgid "vo_sm_char03_m05_stg13_01"
msgstr "Connolly: Ha-ha! Bọn nó loạn rồi!"

msgid "vo_sm_char03_m05_stg13_01_01"
msgstr "Connolly: Địch tháo chạy và bỏ lại pháo phòng không khi nghe tiếng xe tăng chúng ta."

msgid "vo_sm_char03_m05_stg18_01"
msgstr "Connolly: Boongke tiếp theo hơi bị cứng."

msgid "vo_sm_char03_m05_stg18_01_01"
msgstr "Connolly: Dùng khói đánh dấu nó để chiến hạm bên ta oanh tạc trước."

msgid "vo_sm_char03_m05_stg19_01"
msgstr "Connolly: Boongke tiếp theo này được bảo vệ rất kỹ. Chúng ta cần đánh từ cả hai phía sườn, dốc toàn lực."

msgid "vo_sm_char03_m05_stg19_01_01"
msgstr "Connolly: Giúp quân Pháp tác chiến trong khi tôi và Captain Murphy khiến địch bận rộn tại đây."

msgid "vo_sm_char03_m05_stg20_01"
msgstr "Connolly: Sau khi yểm trợ Captain Dubois, chúng ta đã đủ hỏa lực để tấn công boongke trên đỉnh đồi kia."

msgid "vo_sm_char03_m05_stg22_01"
msgstr "Connolly: Mục tiêu tiếp theo là khẩu đại pháo phòng thủ bờ biển."

msgid "vo_sm_char03_m05_stg22_01_01"
msgstr "Connolly: Nếu hạ được, chiến hạm chúng ta có thể vào gần để hỗ trợ toàn bộ hỏa lực pháo binh."

msgid "vo_sm_char03_m05_stg25_01"
msgstr "Connolly: Hoan hô, nhìn kìa anh em! Không quân Hoàng gia đến rồi."

msgid "vo_sm_char03_m05_stg25_01_01"
msgstr "Connolly: Đẹp quá! Bay lượn như chim!"

msgid "vo_sm_char03_m05_stg32_01"
msgstr "Connolly: Các đồng chí, tập trung. Địch không khoan nhượng, chúng ta cũng thế."

msgid "vo_sm_char03_m05_stg33_01"
msgstr "Connolly: Xong rồi! Chúng ta đã lật ngược tình thế."

msgid "vo_sm_char03_m05_stg35_01"
msgstr "Connolly: Dùng khói đánh dấu các mục tiêu cho chiến hạm."

msgid "vo_sm_char03_m05_stg35_02"
msgstr "Connolly: Đừng quên thả khói."

msgid "vo_sm_char03_m05_stg35_03"
msgstr "Connolly: Sử dụng khói hiệu của mình. Phi công có thể truyền đi các tọa độ đó."

msgid "vo_sm_char03_m05_stg35_04"
msgstr "Connolly: Đấy là một mục tiêu khó. Dùng khói hiệu đánh dấu nó."

msgid "vo_sm_char03_m05_stg36_01"
msgstr "Connolly: Sherman, đi thôi! Trận chiến không chờ chúng ta đâu."

msgid "vo_sm_char03_m05_stg36_02"
msgstr "Connolly: Sherman, tỉnh dậy!"

msgid "vo_sm_char03_m05_stg36_03"
msgstr "Connolly: Sherman, sao dừng? Máy móc gặp vấn đề à?"

msgid "vo_sm_char03_m05_stg36_04"
msgstr "Connolly: Sherman, nhanh nào, không còn thì giờ. Tiền tuyến ngay phía trước rồi!"

msgid "vo_sm_char03_m05_stg36_05"
msgstr "Connolly: Sherman, thời gian không ở bên ta! Đi thôi!"

msgid "vo_sm_char03_m05_stg37_02"
msgstr "Connolly: Trà ngon hơn, nhưng cà phê cũng được."

msgid "vo_sm_char03_m05_stg38_02"
msgstr "Connolly: Captain Murphy, cứ ở dưới đất đi. An toàn hơn. Hiểu ý không."

msgid "vo_sm_char03_m05_stg40_01"
msgstr "Connolly: Các đại ca, chuẩn bị. Nhóm địch mới đang đến."

msgid "vo_sm_char03_m05_stg45_01"
msgstr "Connolly: Tốt lắm anh em, trở lại rồi! Nhớ cảnh giác."

msgid "vo_sm_char03_m05_stg45_02"
msgstr "Connolly: Sống dậy từ cõi chết, mạnh mẽ hơn. Tiến lên!"

msgid "vo_sm_char03_m05_stg46_01"
msgstr "Connolly: Chết tiệt! Xe tăng của tôi hỏng rồi. Đừng chờ, đi tiếp đi."

msgid "vo_sm_char03_m05_stg46_02"
msgstr "Connolly: Con xe này hết hạn thật rồi. Dù sao chúng ta cũng rất cảm ơn nó."

msgid "vo_sm_char03_m05_stg46_03"
msgstr "Connolly: Xe tăng hỏng rồi, nhưng chưa hết hẳn. Chúng tôi sẽ sớm trở lại vòng chiến."

msgid "vo_sm_char04_m05_stg03_02"
msgstr "Địch đang diệt chúng ta từng thằng một! Chạy vào vách đá!"

msgid "vo_sm_char04_m05_stg03_02_01"
msgstr "Đứng ngoài chỗ trống không khác gì tự sát."

msgid "vo_sm_char04_m05_stg03_02_02"
msgstr "Vách đá kia có thể che chắn được."

msgid "vo_sm_char04_m05_stg16_02"
msgstr "Murphy: Captain Murphy đây. Vừa đến bờ biển, nhưng chúng tôi bị kìm chân bởi các boongke trên sườn dốc."

msgid "vo_sm_char04_m05_stg16_02_01"
msgstr "Murphy: Cần hỗ trợ tại đây để tiếp tục di chuyển!"

msgid "vo_sm_char04_m05_stg17_01"
msgstr "Murphy: Boongke trụi rồi! Đường đã rộng mở. Tiến lên!"

msgid "vo_sm_char04_m05_stg17_01_01"
msgstr "Murphy: Nhìn kìa! Quân ta đang làm thịt chúng nó trên kia! Vào phụ nào!"

msgid "vo_sm_char04_m05_stg19_02"
msgstr "Murphy: Kế hoạch được đấy. Đập chết m* chúng nó!"

msgid "vo_sm_char04_m05_stg20_02"
msgstr "Murphy: Ô kê, tiến lên, đánh chết m* chúng nó!"

msgid "vo_sm_char04_m05_stg22_02"
msgstr "Murphy: Hô-hô! Với hỏa lực cỡ đấy yểm trợ, chúng ta có thể đẩy một mạch vào sâu đất liền."

msgid "vo_sm_char04_m05_stg23_01"
msgstr "Murphy: Có vẻ như các khẩu phòng không đã lặng tiếng."

msgid "vo_sm_char04_m05_stg23_01_01"
msgstr "Murphy: Đoán là bọn lính pháo vác quần bỏ chạy nhanh hơn cả thỏ rừng khi thấy bóng chúng ta."

msgid "vo_sm_char04_m05_stg23_01_02"
msgstr "Murphy: Quân mình lực vl nó lại nhàn quá?"

msgid "vo_sm_char04_m05_stg28_02"
msgstr "Murphy: Tuyệt vời! Chúng ta đã thành công!"

msgid "vo_sm_char04_m05_stg28_02_01"
msgstr "Murphy: Thở tí đi, rồi lên đường cho địch thấy chúng còn nhiều hành để ăn lắm."

msgid "vo_sm_char04_m05_stg30_02"
msgstr "Murphy: Vào vị trí. Đừng quên ta có pháo tàu chiến yểm trợ."

msgid "vo_sm_char04_m05_stg33_02"
msgstr "Murphy: Quả vừa rồi khó. Nhưng ta vẫn làm được! Tiếp đà lên nào!"

msgid "vo_sm_char04_m05_stg35_05"
msgstr "Murphy: Khói hiệu đâu? Em họ tôi làm trên tàu. Nó thích bắn súng to!"

msgid "vo_sm_char04_m05_stg35_06"
msgstr "Murphy: Đờ mờ, ước gì mình có khói hiệu. Cảm giác gọi đại pháo nó sướng."

msgid "vo_sm_char04_m05_stg35_07"
msgstr "Murphy: Dùng khói đánh dấu chúng để tàu chiến phe ta xử lý."

msgid "vo_sm_char04_m05_stg36_06"
msgstr "Murphy: Sherman, sao lâu thế? Đạp ga đê!"

msgid "vo_sm_char04_m05_stg36_07"
msgstr "Murphy: Sherman, không có cả ngày đâu! Di chuyển đi!"

msgid "vo_sm_char04_m05_stg36_08"
msgstr "Murphy: Sherman, ta cần tiến lên!"

msgid "vo_sm_char04_m05_stg36_09"
msgstr "Murphy: Sherman, ngồi ** hay sao lâu thế. Đi nào!"

msgid "vo_sm_char04_m05_stg37_01"
msgstr "Murphy: Giờ có li cà phê Việt thì hay biết mấy."

msgid "vo_sm_char04_m05_stg38_01"
msgstr "Murphy: Lần sau, tôi sẽ lái một chiếc máy bay ném bom kia. Thích trời mây bốn bể."

msgid "vo_sm_char04_m05_stg39_01"
msgstr "Murphy: Ê, Dubois, đua xe tăng không?"

msgid "vo_sm_char04_m05_stg40_02"
msgstr "Murphy: Tấn công! Vì vườn nho ngon nhất hành tinh!"

msgid "vo_sm_char04_m05_stg40_04"
msgstr "Murphy: À quên, tôi vừa nói gì thế?"

msgid "vo_sm_char04_m05_stg41_01"
msgstr "Murphy: Ê Dubois, có tí nhạc Pháp nào vui vui không?"

msgid "vo_sm_char04_m05_stg41_03"
msgstr "Murphy: Thật á? Trước giờ không biết nó nghĩa gì."

msgid "vo_sm_char04_m05_stg42_01"
msgstr "Murphy: Ở Paris món hamburger \"Quarter Pounder with Cheese\" gọi sao?"

msgid "vo_sm_char04_m05_stg43_01"
msgstr "Murphy: Dubois, có đúng là tăng Pháp dùng bánh mì baguette thay cho phuộc nhún?"

msgid "vo_sm_char04_m05_stg43_03"
msgstr "Murphy: Rất nghiêm túc giống ông, mỗi tội hay cười thôi."

msgid "vo_sm_char04_m05_stg44_02"
msgstr "Murphy: Dubois, nghĩa là gì thế?"

msgid "vo_sm_char04_m05_stg45_03"
msgstr "Murphy: Trở lại vòng chiến hả? Đẩy tiếp nào, chúng tôi tin tưởng."

msgid "vo_sm_char04_m05_stg45_04"
msgstr "Murphy: Trở lại rồi? Tinh thần phải thế chứ! Đập chết m* chúng nó."

msgid "vo_sm_char04_m05_stg46_04"
msgstr "Murphy: Xe tăng hỏng! Từ giờ cuốc bộ vậy anh em."

msgid "vo_sm_char04_m05_stg46_05"
msgstr "Murphy: Xong con m* nó rồi. Xe tăng không tham chiến được nữa, nhưng tôi sẽ trở lại!"

msgid "vo_sm_char04_m05_stg46_06"
msgstr "Murphy: Xe hỏng rồi. Tôi không sao, đừng lo. Tôi sẽ trở lại với xe mới!"

msgid "vo_sm_char04_m06_outro_02"
msgstr "Murphy: Cái gì? Năm thằng liều lên cơn rồ?"

msgid "vo_sm_char04_m06_outro_11"
msgstr "Murphy: Không bao giờ nữa."

msgid "vo_sm_char04_m06_stg02_01"
msgstr "Lái xe, Capt. Murphy: Khoan, chậm lại! Trước có bãi mìn!"

msgid "vo_sm_char04_m06_stg02_02"
msgstr "Murphy: Ê Keller, từng phục vụ ở đây—có sáng kiến nào không?"

msgid "vo_sm_char04_m06_stg02_04"
msgstr "Murphy: Vậy đến thị trấn thôi! Tới lúc cần bản đồ, ít pretzel và schnitzel!"

msgid "vo_sm_char04_m06_stg06_06"
msgstr "Murphy: Nào nào, Giáo sư, thể hiện phép thuật radio của ông đi."

msgid "vo_sm_char04_m06_stg06_12"
msgstr "Murphy: Ước gì có người như Keller sáu tháng trước..."

msgid "vo_sm_char04_m06_stg06_14"
msgstr "Murphy: Chết tiệt. Nhiệm vụ bí mật thật."

msgid "vo_sm_char04_m06_stg06_14_01"
msgstr "Murphy: Tôi nghĩ chúng ta đang ẩn dụ."

msgid "vo_sm_char04_m06_stg07_02"
msgstr "Murphy: Và không gác canh trong tầm mắt! Nữ thần may mắn đang về phía ta hôm nay."

msgid "vo_sm_char04_m06_stg08_08"
msgstr "Murphy: Ối trời, các đồng chí, chúng ta đang chơi bịt mắt bắt dê thật!"

msgid "vo_sm_char04_m06_stg09_03"
msgstr "Murphy: Rõ rõ, thưa Sếp, đợi chút. Đ**. Dubois, cho mượn cái bút chì. Của tôi mất rồi."

msgid "vo_sm_char04_m06_stg09_05"
msgstr "Murphy: Ồ, đúng rồi. Keller, có cái...Bleistift không?"

msgid "vo_sm_char04_m06_stg09_08"
msgstr "Murphy: Ha! Cảm ơn, Keller."

msgid "vo_sm_char04_m06_stg10_02"
msgstr "Murphy: Ồ! Một mảnh ghép mới! Dubois, quà của ông toàn đố!"

msgid "vo_sm_char04_m06_stg11_02"
msgstr "Murphy: Đó là Jack Murphy, monsieur Delacroix! Khi nào mới gọi đúng tên tôi?"

msgid "vo_sm_char04_m06_stg12_03"
msgstr "Murphy: Chờ chút. Bút chì đâu rồi..."

msgid "vo_sm_char04_m06_stg12_05"
msgstr "Murphy: Rồi rồi, tôi sẽ mua cả hộp bút chì, Dubois!"

msgid "vo_sm_char04_m06_stg12_05_01"
msgstr "Murphy: Sếp! Sắp đến rồi! Mảnh này em thích!"

msgid "vo_sm_char04_m06_stg15_03"
msgstr "Murphy: Chắc chắn đã tìm khắp nơi?"

msgid "vo_sm_char04_m06_stg15_05"
msgstr "Murphy: Ê, có lẽ nó như đôi tất của tôi—toàn ở chỗ không ngờ!"

msgid "vo_sm_char04_m06_stg16_02"
msgstr "Murphy: Một giây... Tất cả đều khớp. Trời phật, mê cung!"

msgid "vo_sm_char04_m06_stg16_02_01"
msgstr "Murphy: Tôi sẽ gọi nó là mê cung MINE-otaur! Ha ha. Hiểu không? Không à?"

msgid "vo_sm_char04_m06_stg16_02_02"
msgstr "Murphy: Nào, hay thế cơ mà!"

msgid "vo_sm_char04_m06_stg16_04"
msgstr "Murphy: Nạp đạn mệt rồi à, Dubois?"

msgid "vo_sm_char04_m06_stg18_03"
msgstr "Murphy: Kiểm tra thôi. Mọi người, sẵn sàng."

msgid "vo_sm_char04_m06_stg19_02"
msgstr "Murphy: Ồ, tưởng có kho vàng bí mật của Đức ở đây."

msgid "vo_sm_char04_m06_stg19_02_01"
msgstr "Murphy: Này, Keller, các ông có giấu vàng quanh đây không?"

msgid "vo_sm_char04_m06_stg19_04"
msgstr "Murphy: Đó chính xác là những gì tôi sẽ nói nếu đang giấu vàng ở đây."

msgid "vo_sm_char04_m06_stg19_04_01"
msgstr "Murphy: Captain Smith, tìm...bản đồ không?"

msgid "vo_sm_char04_m06_stg21_03"
msgstr "Murphy: Lẻn qua dễ thật!"

msgid "vo_sm_char04_m06_stg21_04"
msgstr "Murphy: Thấy không? Chúng ta tàng hình!"

msgid "vo_sm_char04_m06_stg23_04"
msgstr "Murphy: Ơ... Sếp? Nên lui không? Trước khi mọi thứ căng quá?"

msgid "vo_sm_char04_m06_stg23_05"
msgstr "Murphy: Một phiếu cho rút lui chiến thuật. Ai đồng ý?"

msgid "vo_sm_char04_m06_stg24_03"
msgstr "Murphy: Đến lúc tìm chỗ nấp mới trước khi đám khùng tới!"

msgid "vo_sm_char04_m06_stg25_02"
msgstr "Murphy: Phù! Chiến dịch thiết giáp của chúng ta bí mật thật! Ngạc nhiên chưa?"

msgid "vo_sm_char04_m06_stg26_04"
msgstr "Murphy: Đến lúc nhảy múa với những chiếc Panzer này!"

msgid "vo_sm_char04_m06_stg26_05"
msgstr "Murphy: Cho thấy Chaffee này có thể làm gì!"

msgid "vo_sm_char04_m06_stg26_06"
msgstr "Murphy: Bắt đầu đây, thưa quý ông quý bà!"

msgid "vo_sm_char04_m06_stg27_02"
msgstr "Murphy: Ú hú! Đẹp chửa!"

msgid "vo_sm_char04_m06_stg28_03"
msgstr "Murphy: Trúng phóc!"

msgid "vo_sm_char04_m06_stg29_02"
msgstr "Murphy: Mèn đét ơi, mục tiêu đó to thế!"

msgid "vo_sm_char04_m06_stg30_02"
msgstr "Murphy: Sếp, có lẽ Dubois nên kiểm tra trước?"

msgid "vo_sm_char04_m06_stg31_07"
msgstr "Murphy: Ngoài đó lạnh quá, lại quên mang áo khoác."

msgid "vo_sm_char04_m06_stg35_02"
msgstr "Murphy: Có lẽ đến lúc xem giáo sư của chúng ta làm phép radio?"

msgid "vo_sm_char04_m06_stg42_02"
msgstr "Murphy: Ê Sếp, ngắm cảnh tuyệt đấy, nhưng không phải đang đi tìm mảnh bản đồ à?"

msgid "vo_sm_char04_m06_stg43_03"
msgstr "Murphy: Dậy dậy, hai trứng một gậy!"

msgid "vo_sm_char04_m06_stg44_02"
msgstr "Murphy: Có lẽ phải làm theo kiểu ồn rồi!"

msgid "vo_sm_char04_m06_stg45_02"
msgstr "Murphy: Tôi cá có cách tốt hơn mớ này!"

msgid "vo_sm_char04_m06_stg46_02"
msgstr "Murphy: Ê, Keller, cho xem trò ảo ma radio đi!"

msgid "vo_sm_char04_m06_stg47_02"
msgstr "Murphy: Hay để tự chán rồi bỏ đi?"

msgid "vo_sm_char04_m06_stg48_02"
msgstr "Murphy: Ê mọi người, lần sau cố không nổ nhé?"

msgid "vo_sm_char04_m06_stg53_02"
msgstr "Murphy: Ai đó lén lén lút lút! Hư quá!"

msgid "vo_sm_char04_m06_stg54_02"
msgstr "Murphy: Thời gian đang trôi rất nhanh, chúng ta phải nhanh hơn thế."

msgid "vo_sm_char04_m06_stg55_01"
msgstr "Murphy: Ha! Nắm chắc rồi! Thế mà bảo khó lắm."

msgid "vo_sm_char04_m06_stg55_04"
msgstr "Murphy: Đừng lo anh em, cụ Murphy đang chuyển chế độ lái hung thần xa lộ."

msgid "vo_sm_char04_m06_stg56_02"
msgstr "Murphy: Giời ạ...Dubois, lo nhiều quá! Cùng lắm là chết?"

msgid "vo_sm_char04_m06_stg56_04"
msgstr "Murphy: Không được, giáo sư! Một là hết ga, hai là hết đời!"

msgid "vo_sm_char04_m06_stg56_06"
msgstr "Murphy: Bớt bớt đi, mon ami! Tôi có bản đồ trong đầu."

msgid "vo_sm_char04_m06_stg57_02"
msgstr "Murphy: Một chiếc Tiger? Chỉ vậy á? Mấy cái lời đồn vũ khí vi diệu hay nghe đâu hết rồi?"

msgid "vo_sm_char04_m06_stg58_02"
msgstr "Murphy: Di chuyển? DI CHUYỂN?"

msgid "vo_sm_char04_m06_stg58_02_01"
msgstr "Murphy: Trong cái ngõ hẹp rộng một Chaffee rưỡi này?"

msgid "vo_sm_char04_m06_stg58_02_02"
msgstr "Murphy: Di chuyển vào cái đầu thằng nào?"

msgid "vo_sm_char04_m06_stg59_03"
msgstr "Murphy: Thôi nào! Tiger, không có tăng nào khác để đuổi à?"

msgid "vo_sm_char04_m06_stg60_03"
msgstr "Murphy: Tôi không thích súng Tiger chĩa vào chúng ta!"

msgid "vo_sm_char04_m06_stg61_02"
msgstr "Murphy: Thấy gió gió không? Tôi chắc chắn có!"

msgid "vo_sm_char04_m06_stg62_01"
msgstr "Murphy: Xước tí thôi! Không hề hấn gì!"

msgid "vo_sm_char04_m06_stg62_02"
msgstr "Murphy: Ê! Vừa đánh bóng chiếc tăng này!"

msgid "vo_sm_char04_m06_stg63_03"
msgstr "Murphy: Kowalski, ngắm vào xích!"

msgid "vo_sm_char04_m06_stg64_02"
msgstr "Murphy: Đứt xích là khỏi nhích, hết hổ báo chưa?"

msgid "vo_sm_char04_m06_stg68_01"
msgstr "Murphy: Ối! Quả mìn đó không có trên bản đồ!"

msgid "vo_sm_char04_m06_stg68_02"
msgstr "Murphy: Mìn! Ồ đúng. Biết rồi."

msgid "vo_sm_char04_m06_stg69_01"
msgstr "Murphy: Làng nước ơi! Thằng này đâu ra vậy?!"

msgid "vo_sm_char04_m06_stg70_02"
msgstr "Murphy: Nghiêm túc thế? Vui mà! Hiểu không? Vì mìn đó?"

msgid "vo_sm_char04_m06_stg70_02_01"
msgstr "Murphy: À, thôi nào anh em!..."

msgid "vo_sm_char04_m06_stg71_02"
msgstr "Murphy: Chết tiệt... tất cả những người đó... gần lắm rồi!"

msgid "vo_sm_char04_m06_stg73_01"
msgstr "Murphy: Dubois, có đúng là tăng Pháp có máy cà phê espresso?"

msgid "vo_sm_char04_m06_stg73_03"
msgstr "Murphy: Trả lời nghiêm túc ghê, suýt tin đấy. Đùa à?"

msgid "vo_sm_char04_m06_stg74_02"
msgstr "Murphy: Chưa, anh em tôi lên phía bắc."

msgid "vo_sm_char04_m06_stg74_02_01"
msgstr "Murphy: Nhưng sẽ ghé sau chiến tranh."

msgid "vo_sm_char04_m06_stg74_02_02"
msgstr "Murphy: Còn leo tháp Pizza nữa."

msgid "vo_sm_char04_m06_stg75_01"
msgstr "Murphy: Dubois, có biết ngủ ông nói mớ không?"

msgid "vo_sm_char04_m06_stg75_03"
msgstr "Murphy: \"Wee, wee, ma share-ee\" nghĩa gì vậy?"

msgid "vo_sm_char04_m06_stg76_01"
msgstr "Murphy: Dubois, dạy tôi tí tiếng Pháp đi!"

msgid "vo_sm_char04_m06_stg76_03"
msgstr "Murphy: Gì? Không hiểu."

msgid "vo_sm_char04_m06_stg76_05"
msgstr "Murphy: Cái gì? Giỡn mặt hả?"

msgid "vo_sm_char04_m06_stg76_05_01"
msgstr "Murphy: Hay lắm, nhưng đang đùa với lửa đấy Dubois!"

msgid "vo_sm_char04_m06_stg77_01"
msgstr "Murphy: Biết nhảy polka không, Kowalski?"

msgid "vo_sm_char04_m06_stg77_03"
msgstr "Murphy: Làm luôn đi, tổ chức tiệc polka cho vui!"

msgid "vo_sm_char04_m06_stg77_05"
msgstr "Murphy: Tất nhiên rồi! Ý tôi là... không phải kiểu đó đâu, hiểu không?"

msgid "vo_sm_char04_m06_stg78_02"
msgstr "Murphy: Vấn đề gì à?"

msgid "vo_sm_char04_m06_stg78_04"
msgstr "Murphy: Tôi gọi đó là chiến thuật \"Tăng nghiêng\". Luôn bắt kẻ thù phải đoán!"

msgid "vo_sm_char04_m06_stg79_01"
msgstr "Murphy: Kowalski, nếu lập ban nhạc, anh chơi nhạc cụ gì?"

msgid "vo_sm_char04_m06_stg79_03"
msgstr "Murphy: Ê... Tôi làm Guitar chính nhé..."

msgid "vo_sm_char04_m06_stg80_01"
msgstr "Murphy: Keller, chỉnh radio phát nhạc!"

msgid "vo_sm_char04_m06_stg80_03"
msgstr "Murphy: Chút thôi mà? Nhạc giúp phấn chấn lên!"

msgid "vo_sm_char04_m06_stg80_05"
msgstr "Murphy: Vậy thôi đừng chỉnh nữa."

msgid "vo_sm_char04_m06_stg81_01"
msgstr "Murphy: Tối qua tôi mơ thấy bọn mình đang câu cá."

msgid "vo_sm_char04_m06_stg81_03"
msgstr "Murphy: Một cái ủng cũ."

msgid "vo_sm_char04_m06_stg81_05"
msgstr "Murphy: Heh, tôi biết anh là người lạc quan mà."

msgid "vo_sm_char04_m06_stg81_05_01"
msgstr "Murphy: Luôn tìm cái gì đó tích cực."

msgid "vo_sm_char04_m06_stg82_01"
msgstr "Murphy: Sếp, kể một câu chuyện vui đi."

msgid "vo_sm_char04_m06_stg82_03"
msgstr "Murphy: Ai kể không? Kowalski? Keller? Dubois, không hỏi ông."

msgid "vo_sm_char04_m06_stg82_05"
msgstr "Murphy: Ờ... muốn thì cứ kể."

msgid "vo_sm_char04_m06_stg82_07"
msgstr "Murphy: ... Đó là lý do."

msgid "vo_sm_char04_m06_stg83_02"
msgstr "Murphy: \"Quân hèn chết nhiều lần trước khi đắp chiếu;\""

msgid "vo_sm_char04_m06_stg83_02_01"
msgstr "Murphy: \"Kẻ dũng mới chỉ chết một lần\", đúng chưa?"

msgid "vo_sm_char04_m06_stg83_04"
msgstr "Murphy: Ừ? Nghe quá Pháp luôn."

msgid "vo_sm_char04_m06_stg84_01"
msgstr "Murphy: Nghĩ một con phố sẽ được đặt theo tên chúng ta không?"

msgid "vo_sm_char04_m06_stg84_03"
msgstr "Murphy: Đúng rồi. Cần có tên đội!"

msgid "vo_sm_char04_m06_stg84_05"
msgstr "Murphy: Mmm… tên quá dài. Tôi thích TROUBLESHOOTERS."

msgid "vo_sm_char04_m06_stg85_01"
msgstr "Murphy: Kowalski, có bao giờ cười không?"

msgid "vo_sm_char04_m06_stg85_03"
msgstr "Murphy: Chấp nhận thách thức! Tôi sẽ đập vỡ cái vỏ của anh!"

msgid "vo_sm_char04_m06_stg85_05"
msgstr "Murphy: Được rồi, nghe này: Cốc cốc."

msgid "vo_sm_char04_m06_stg85_06"
msgstr "Murphy: Phải hỏi “Ai đó?”"

msgid "vo_sm_char04_m06_stg85_07"
msgstr "Murphy: Okay, khó hơn tôi tưởng."

msgid "vo_sm_char04_m06_stg87_01"
msgstr "Murphy: Cái gì thế?!"

msgid "vo_sm_char04_m06_stg87_03"
msgstr "Murphy: Nó trong ủng tôi. Ồ! Một cái bút chì."

msgid "vo_sm_char04_m06_stg88_01"
msgstr "Murphy: Keller, nghe gì thú vị trên kênh Đức không?"

msgid "vo_sm_char04_m06_stg88_03"
msgstr "Murphy: Á đù! Chính là chúng ta! Tăng Ma! Cơn ác mộng của người Đức!"

msgid "vo_sm_char04_m06_stg88_04"
msgstr "Murphy: Keller, cá là *éo thể tin được anh đang đi trộm trứng gà trong một chiếc tăng Mỹ!"

msgid "vo_sm_char04_m06_stg88_06"
msgstr "Murphy: Đời nó hãm nhỉ? Giống hộp sô-cô-la!"

msgid "vo_sm_char04_m06_stg90_03"
msgstr "Murphy: Ồ!!! Kowalski! Phải đọc lời bài La Marseillaise đi!"

msgid "vo_sm_char04_m06_stg90_03_01"
msgstr "Murphy: Có mấy cái... rất đẫm máu!"

msgid "vo_sm_char04_m06_stg91_02"
msgstr "Murphy: Vâng!"

msgid "vo_sm_char04_m06_stg92_01"
msgstr "Murphy: Nếu có ai hỏi, chúng ta là gánh xiếc di động."

msgid "vo_sm_char04_m06_stg92_03"
msgstr "Murphy: Cần truyện lấp liếm; giờ chúng ta là gián điệp rồi!"

msgid "vo_sm_char04_m06_stg93_01"
msgstr "Murphy: Nghĩ sau nhiệm vụ này tôi có thể lấy cái bút gián điệp không?"

msgid "vo_sm_char04_m06_stg93_03"
msgstr "Murphy: Dubois, nhỏ mọn quá!"

msgid "vo_sm_char05_m05_stg18_02"
msgstr "Dubois: Bonjour, monsieurs! Capitaine Dubois đây."

msgid "vo_sm_char05_m05_stg18_02_01"
msgstr "Dubois: Chúng tôi đã đổ bộ lên H1, nhưng không thể di chuyển vì địch bắn rát quá."

msgid "vo_sm_char05_m05_stg18_02_02"
msgstr "Dubois: Cần hỗ trợ ngay!"

msgid "vo_sm_char05_m05_stg19_04"
msgstr "Dubois: Aaa, đường trống rồi. Cuối cùng cũng xong! En avant, tham chiến nào anh em. Vive la France!"

msgid "vo_sm_char05_m05_stg21_01"
msgstr "Dubois: Merci mon ami! Một bước gần hơn tới giải phóng quê tôi."

msgid "vo_sm_char05_m05_stg27_01"
msgstr "Dubois: Magnifique! Pháo phòng thủ bờ biển đã im bặt."

msgid "vo_sm_char05_m05_stg27_01_01"
msgstr "Dubois: Giờ, chiến hạm có thể vào gần hơn và hỗ trợ bằng pháo hạng nặng."

msgid "vo_sm_char05_m05_stg27_01_02"
msgstr "Dubois: Thưởng thức pháo hoa thôi!"

msgid "vo_sm_char05_m05_stg29_01"
msgstr "Dubois: Sẵn sàng tham chiến. Tôi sẽ không bao giờ xa đất Pháp nữa. Plus jamais de retraite!"

msgid "vo_sm_char05_m05_stg33_03"
msgstr "Dubois: Đây mới chỉ là khởi đầu. Kết cục cuộc chiến trong tầm mắt."

msgid "vo_sm_char05_m05_stg35_08"
msgstr "Dubois: Dùng khói đánh dấu mục tiêu, mes amis. Để tàu chiến liberate La France!"

msgid "vo_sm_char05_m05_stg35_09"
msgstr "Dubois: Khói hiệu ném chuẩn đem lại may mắn và mưa đạn xuống đầu địch!"

msgid "vo_sm_char05_m05_stg36_10"
msgstr "Dubois: Sherman, đi thôi, vite-vite!"

msgid "vo_sm_char05_m05_stg36_11"
msgstr "Dubois: Sherman, chúng ta phải di chuyển, allons!"

msgid "vo_sm_char05_m05_stg36_12"
msgstr "Dubois: Sherman, nhanh lên! La France đang chờ!"

msgid "vo_sm_char05_m05_stg39_02"
msgstr "Dubois: Captain Murphy, đây không phải cuộc thi; chúng ta đang giải phóng quê tôi."

msgid "vo_sm_char05_m05_stg39_02_01"
msgstr "Dubois: Câu hỏi này... Xàm! Tôi đang lái tăng hạng nặng, làm sao nhanh hơn được?"

msgid "vo_sm_char05_m05_stg40_03"
msgstr "Dubois: Vì nước Pháp!"

msgid "vo_sm_char05_m05_stg41_02"
msgstr "Dubois: Tôi ca bài 'La Marseillaise.' Nó phù hợp cho trận chiến. Lời rất hưng phấn, thậm chí sục sôi."

msgid "vo_sm_char05_m05_stg42_02"
msgstr "Dubois: Burger? Murphy, chúng tôi không ăn trash food ở Pháp."

msgid "vo_sm_char05_m05_stg42_02_01"
msgstr "Dubois: Chúng tôi chuộng baguette xăng-uých, kèm ít pho mát mịn và charcuterie."

msgid "vo_sm_char05_m05_stg43_02"
msgstr "Dubois: Captain Murphy, đôi lúc tôi tự hỏi ông có nghiêm túc với cuộc chiến này không."

msgid "vo_sm_char05_m05_stg44_01"
msgstr "Dubois: Sur le risque disparu, sur l’espoir sans souvenir, j’écris ton nom..."

msgid "vo_sm_char05_m05_stg44_03"
msgstr "Dubois: Murphy, đấy nghĩa là chúng nó chết con m* rồi."

msgid "vo_sm_char05_m05_stg45_05"
msgstr "Dubois: Chào mừng trở lại vòng chiến. Ông sống dai phết."

msgid "vo_sm_char05_m05_stg46_07"
msgstr "Dubois: Mon dieu, tăng của chúng tôi đã hết đời! Tạm thời rút đây."

msgid "vo_sm_char05_m05_stg46_08"
msgstr "Dubois: Chiếc tăng này bỏ thôi. Chúng ta đã làm hết sức, mes amis."

msgid "vo_sm_char05_m05_stg46_08_01"
msgstr "Dubois: Nhưng tôi sẽ tiếp tục giải phóng nước Pháp!"

msgid "vo_sm_char05_m05_stg46_09"
msgstr "Dubois: Chiếc tăng đã bị phá hủy, nhưng tinh thần chúng tôi còn nguyên. Hãy đợi đấy!"

msgid "vo_sm_char05_m06_outro_01"
msgstr "Dubois: Vậy rốt cuộc nó có thể ngăn chặn cuộc đổ máu."

msgid "vo_sm_char05_m06_outro_03"
msgstr "Dubois: Một tờ giấy. Một tờ giấy đơn giản có thể ngăn tất cả."

msgid "vo_sm_char05_m06_outro_05"
msgstr "Dubois: Vậy cái gì?"

msgid "vo_sm_char05_m06_outro_09"
msgstr "Dubois: Plus jamais."

msgid "vo_sm_char05_m06_stg04_02"
msgstr "Nạp đạn viên, Capt. Dubois: Rõ, sếp!"

msgid "vo_sm_char05_m06_stg04_03"
msgstr "Dubois: Phát hiện xe tăng."

msgid "vo_sm_char05_m06_stg06_11"
msgstr "Dubois: Magnifique! Hiệu quả thật!"

msgid "vo_sm_char05_m06_stg08_02"
msgstr "Dubois: Rõ sếp!"

msgid "vo_sm_char05_m06_stg08_03"
msgstr "Dubois: Thấy rồi! Giờ có thể vượt qua thị trấn... merde!"

msgid "vo_sm_char05_m06_stg08_05"
msgstr "Dubois: Toàn tuyến đầu bị cài mìn. Không thể qua gặp quân mình."

msgid "vo_sm_char05_m06_stg09_01"
msgstr "Dubois: Thấy rồi!"

msgid "vo_sm_char05_m06_stg09_04"
msgstr "Dubois: Tôi đã đưa. Anh làm mất luôn rồi đấy."

msgid "vo_sm_char05_m06_stg09_07"
msgstr "Dubois: Đừng đưa. Anh ta làm mất luôn bây giờ."

msgid "vo_sm_char05_m06_stg10_01"
msgstr "Dubois: Murphy, cho cái này nè. Cầm đi."

msgid "vo_sm_char05_m06_stg11_01"
msgstr "Dubois: Trúng lớn rồi!"

msgid "vo_sm_char05_m06_stg11_03"
msgstr "Dubois: Ý tôi là... a... mon Dieu, chắc giờ nhớ mấy trò đùa ngáo của anh khi nhiệm vụ xong."

msgid "vo_sm_char05_m06_stg12_01"
msgstr "Dubois: Tôi tìm thấy rồi! Một mảnh nữa."

msgid "vo_sm_char05_m06_stg12_04"
msgstr "Dubois: Bảo rồi mà."

msgid "vo_sm_char05_m06_stg13_01"
msgstr "Dubois: Không có gì hết, mấy ba ơi mes amis."

msgid "vo_sm_char05_m06_stg14_02"
msgstr "Dubois: Không. Không phải chỗ cần tìm."

msgid "vo_sm_char05_m06_stg15_02"
msgstr "Dubois: Không có gì."

msgid "vo_sm_char05_m06_stg15_04"
msgstr "Dubois: Kỹ lắm rồi."

msgid "vo_sm_char05_m06_stg15_06"
msgstr "Dubois: Mon Dieu...Đang so sánh tài liệu quân sự mật với... à... thôi bỏ đi."

msgid "vo_sm_char05_m06_stg15_07"
msgstr "Dubois: Mon Dieu...Đang so sánh tài liệu quân sự mật với... à... thôi bỏ đi."

msgid "vo_sm_char05_m06_stg15_07_01"
msgstr "Dubois: Sếp, còn mấy đồn chỉ huy khác được đánh dấu ở đây."

msgid "vo_sm_char05_m06_stg16_03"
msgstr "Dubois: Nhón qua bãi mìn đi, để tôi còn được thở chút."

msgid "vo_sm_char05_m06_stg16_05"
msgstr "Dubois: Lại chả không."

msgid "vo_sm_char05_m06_stg17_03"
msgstr "Dubois: Bình tĩnh đi, Kowalski. Nếu Keller muốn phản bội, hắn đã làm từ lâu rồi."

msgid "vo_sm_char05_m06_stg19_01"
msgstr "Dubois: Nhìn kìa, có vẻ là đồn chỉ huy."

msgid "vo_sm_char05_m06_stg21_05"
msgstr "Dubois: Suýt nữa rồi, các huynh đệ mes amis."

msgid "vo_sm_char05_m06_stg24_04"
msgstr "Dubois: Ta phải di chuyển ngay, mes amis. Chúng sẽ điều tra."

msgid "vo_sm_char05_m06_stg25_03"
msgstr "Dubois: Magnifique. Chúng đã lạc hướng. Tiếp tục nhiệm vụ."

msgid "vo_sm_char05_m06_stg26_07"
msgstr "Dubois: En avant!"

msgid "vo_sm_char05_m06_stg27_03"
msgstr "Dubois: Mục tiêu đã bị hạ. Đạn trước giờ nặng thế cơ à?"

msgid "vo_sm_char05_m06_stg27_04"
msgstr "Dubois: Mọi người ok chứ? Tôi ổn."

msgid "vo_sm_char05_m06_stg28_04"
msgstr "Dubois: Địch bị hạ!"

msgid "vo_sm_char05_m06_stg31_01"
msgstr "Dubois: Rõ!"

msgid "vo_sm_char05_m06_stg31_02"
msgstr "Dubois: Đang đi thám sát."

msgid "vo_sm_char05_m06_stg31_03"
msgstr "Dubois: Tôi sẽ kiểm tra và báo lại."

msgid "vo_sm_char05_m06_stg31_04"
msgstr "Dubois: Đang đến điểm quan sát."

msgid "vo_sm_char05_m06_stg31_05"
msgstr "Dubois: Đến lúc duỗi chân. Để xem có gì phía trước."

msgid "vo_sm_char05_m06_stg31_06"
msgstr "Dubois: Murphy, muốn thay tôi không?"

msgid "vo_sm_char05_m06_stg31_08"
msgstr "Dubois: Biết thừa..."

msgid "vo_sm_char05_m06_stg31_09"
msgstr "Dubois: Kowalski, ông có thể..."

msgid "vo_sm_char05_m06_stg31_11"
msgstr "Dubois: Kê thôi, tôi đi một mình."

msgid "vo_sm_char05_m06_stg31_12"
msgstr "Dubois: Ai muốn vận động nhẹ không?"

msgid "vo_sm_char05_m06_stg31_13"
msgstr "Dubois: Tôi biết mà. Đi đây."

msgid "vo_sm_char05_m06_stg32_01"
msgstr "Dubois: Phát hiện địch!"

msgid "vo_sm_char05_m06_stg32_02"
msgstr "Dubois: Panzers trong tầm."

msgid "vo_sm_char05_m06_stg32_03"
msgstr "Dubois: Chú ý. Xe tăng địch."

msgid "vo_sm_char05_m06_stg32_04"
msgstr "Dubois: Thấy chúng rồi."

msgid "vo_sm_char05_m06_stg32_05"
msgstr "Dubois: Địch trong tầm."

msgid "vo_sm_char05_m06_stg33_01"
msgstr "Dubois: Chưa thấy gì, nhưng chắc chắn gần."

msgid "vo_sm_char05_m06_stg33_02"
msgstr "Dubois: Trước mắt trống trải, nhưng phải cảnh giác."

msgid "vo_sm_char05_m06_stg33_03"
msgstr "Dubois: Không thấy động tĩnh gì. Chúng đang ẩn đâu đó."

msgid "vo_sm_char05_m06_stg33_04"
msgstr "Dubois: Hiện trống trải... nhưng chắc nên đợi thêm."

msgid "vo_sm_char05_m06_stg33_05"
msgstr "Dubois: Chưa có gì. Nhưng đợi xem có tuần tra không."

msgid "vo_sm_char05_m06_stg42_03"
msgstr "Dubois: Messieurs các quý ông, tôi phải nhắc rằng nhiệm vụ thành công hay không phụ thuộc những mảnh bản đồ này."

msgid "vo_sm_char05_m06_stg43_04"
msgstr "Dubois: Mon Dieu, thời gian không chờ đợi khi ngắm cảnh."

msgid "vo_sm_char05_m06_stg48_03"
msgstr "Dubois: Mỗi giây rất quan trọng. Giờ phải cực cảnh giác."

msgid "vo_sm_char05_m06_stg53_03"
msgstr "Dubois: Chú ý! Tăng địch phía trước!"

msgid "vo_sm_char05_m06_stg55_03"
msgstr "Dubois: Mon Dieu! Murphy, mồm ông ăn mắm à!"

msgid "vo_sm_char05_m06_stg55_05"
msgstr "Dubois: Vậy trước giờ anh ở chế độ gì?"

msgid "vo_sm_char05_m06_stg56_01"
msgstr "Dubois: Murphy, cẩn thận, lạy Chúa! Ta đang giữa bãi mìn!"

msgid "vo_sm_char05_m06_stg56_05"
msgstr "Dubois: Murphy, biết đi đâu không? Chưa vẽ mảnh bản đồ cuối cùng mà!"

msgid "vo_sm_char05_m06_stg56_07"
msgstr "Dubois: Vậy mới lo!"

msgid "vo_sm_char05_m06_stg59_04"
msgstr "Dubois: Mon Dieu, Tiger ngay sau lưng!"

msgid "vo_sm_char05_m06_stg59_05"
msgstr "Dubois: Cette bête con quái vật này sẽ bắt kịp bất cứ lúc nào! Murphy, nhanh!"

msgid "vo_sm_char05_m06_stg68_03"
msgstr "Dubois: Murphy, tôi biết cậu làm vậy có chủ đích! Nghỉ đùa đi!"

msgid "vo_sm_char05_m06_stg72_05"
msgstr "Dubois: Chắc chắn có cách xong nhiệm vụ này mà không bắn lung tung."

msgid "vo_sm_char05_m06_stg73_02"
msgstr "Dubois: Ừ, nhưng không nhét vừa chiếc Chaffee."

msgid "vo_sm_char05_m06_stg74_01"
msgstr "Dubois: Murphy, đi Paris chưa?"

msgid "vo_sm_char05_m06_stg74_04"
msgstr "Dubois: Đừng quan tâm. Đó là kiểu vui của anh ta thôi."

msgid "vo_sm_char05_m06_stg75_02"
msgstr "Dubois: Làm gì có."

msgid "vo_sm_char05_m06_stg75_04"
msgstr "Dubois: À, mơ về Pháp thôi."

msgid "vo_sm_char05_m06_stg76_02"
msgstr "Dubois: Très bien. Lặp lại \"Comment? Je ne comprends pas.\""

msgid "vo_sm_char05_m06_stg76_04"
msgstr "Dubois: Dịch rồi, bảo lặp lại mà!"

msgid "vo_sm_char05_m06_stg82_04"
msgstr "Dubois: Sao vậy?"

msgid "vo_sm_char05_m06_stg82_06"
msgstr "Dubois: Biết tại sao người Pháp ăn ốc không? Vì chúng tôi ghét đồ ăn nhanh."

msgid "vo_sm_char05_m06_stg83_01"
msgstr "Dubois: Anh giống một nhân vật trong \"Ba Người Lính Ngự Lâm\" đấy, Murphy."

msgid "vo_sm_char05_m06_stg83_03"
msgstr "Dubois: Đó là Shakespeare, Murphy."

msgid "vo_sm_char05_m06_stg86_01"
msgstr "Dubois: Keller, có đúng người Đức có hơn 300 loại bánh mì?"

msgid "vo_sm_char05_m06_stg86_03"
msgstr "Dubois: Ghê dữ. Nhưng anh thử bánh mì baguette Pháp chưa?"

msgid "vo_sm_char05_m06_stg86_05"
msgstr "Dubois: Phép ẩn dụ hoàn hảo cho Pháp!"

msgid "vo_sm_char05_m06_stg87_02"
msgstr "Dubois: Ở đâu? Tôi chẳng thấy gì."

msgid "vo_sm_char05_m06_stg87_04"
msgstr "Dubois: Mon Dieu..."

msgid "vo_sm_char05_m06_stg90_02"
msgstr "Dubois: La Marseillaise."

msgid "vo_sm_char05_m06_stg91_01"
msgstr "Dubois: Rẽ trái hay phải, Murphy?"

msgid "vo_sm_char05_m06_stg91_03"
msgstr "Dubois: Oi, Murphy..."

msgid "vo_sm_char05_m06_stg92_02"
msgstr "Dubois: Cái gì?"

msgid "vo_sm_char05_m06_stg93_02"
msgstr "Dubois: Rồi lại làm mất nó á?"

msgid "vo_sm_char06_m05_stg01_01"
msgstr "McCormick: Anh em, nghe đây! Thấp cái đầu xuống, di chuyển thật nhanh!"

msgid "vo_sm_char06_m05_stg01_01_01"
msgstr "McCormick: Tập trung vào các boongke; chúng ta cần dọn đường cho quân mình."

msgid "vo_sm_char06_m05_stg01_01_02"
msgstr "McCormick: Có việc phải làm, thành bại tại thân!"

msgid "vo_sm_char07_m04_stg19_04"
msgstr "Rõ!"

