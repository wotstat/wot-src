msgid "vo_sm_char08_m05_stg01_13"
msgstr "Phi công Spitfire: Tầm nhìn kém, không hỗ trợ được!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Phi công Spitfire: Quá nhiều đạn phòng không, hỗ trợ phát chết ngay!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Phi công Spitfire: Đạn phòng không rát quá, không điều chỉnh hỏa lực được."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Phi công Spitfire: Lưới đạn flak phòng không như bão tuyết trên này hỉ?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Phi công Spitfire: Chúng tôi không điều chỉnh hỏa lực tàu chiến dưới làn đạn này."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Phi công Spitfire: Chúng tôi cần các khẩu phòng không cạnh boongke ngừng bắn."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Phi công Spitfire: Tôi đã xoay xở bổ nhào xuống thấp hơn được rồi."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Phi công Spitfire: Giờ tôi có thể bắt đầu gọi đại pháo oanh tạc vào khói hiệu trên mặt đất."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Phi công Spitfire: Xe tăng, đến lượt di chuyển!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Phi công Spitfire: Tôi đã thấy khói."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Phi công Spitfire: Đang truyền tọa độ cho chiến hạm để bắn trúng trực tiếp."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Phi công Spitfire: Đ*****, một phi cơ phe ta vừa rụng! Vẫn không thể bay thấp hơn."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Phi công Spitfire: Cần loại bỏ các khẩu phòng không còn lại ngay!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Phi công Spitfire: Súng phòng không đã vô hiệu, tôi bay xuống thấp đây. Sẵn sàng điều hướng pháo kích dày hơn từ chiến hạm quân ta."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Phi công Spitfire: Chú ý! Phát hiện nhóm địch lớn đang đi về phía các đồng chí."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Phi công Spitfire: Địch dốc toàn lực còn lại đấy."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Phi công Spitfire: Coi chừng, một nhóm địch mới đang tiếp cận. Ở dưới đấy bảo trọng."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Phi công Spitfire: Cảnh báo, đợt cuối cùng và lớn nhất của địch đang đến."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Phi công Spitfire: Chúng đang vào từ mọi phía. Cố lên anh em."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Phi công Spitfire: Đã có góc nhìn rõ khói hiệu. Tọa độ đang được truyền sang tàu chiến."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Phi công Spitfire: Ê, khói hiệu của chúng ta kìa. Tôi chuyển tiếp vị trí cho tàu chiến đây."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Phi công Spitfire: Khói hiệu trên mục tiêu. Đang gửi tọa độ chính xác cho tàu chiến."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Phi công Spitfire: Tôi thấy khói, các đồng chí cần giúp chứ gì."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Chỉ huy USS Frankford: Đang chờ tọa độ để bắn yểm trợ."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Chỉ huy USS Frankford: Bắn mù rất mạo hiểm, có thể trúng quân ta."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Chỉ huy USS Frankford: Cần mục tiêu chính xác, đang tạm dừng bắn."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Chỉ huy USS Frankford: Đây là Chỉ huy USS Frankford. Phản đối."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Chỉ huy USS Frankford: Không thể hỗ trợ tiến công. Tầm nhìn quá kém."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Chỉ huy USS Frankford: Không thấy vách đá và boongke, chỉ nhìn rõ xe tăng quân ta trên bãi biển."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Chỉ huy USS Frankford: Đã thấy xe tăng tấn công về phía vách đá."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Chỉ huy USS Frankford: Chúng tôi sẽ hỗ trợ hỏa lực ở hướng đó."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Chỉ huy USS Frankford: Hy vọng chiếc Sherman này giỏi toán lý địa."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Chỉ huy USS Frankford: Sherman đã đổi mục tiêu. Chúng tôi cũng điều chỉnh cho khớp."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Chỉ huy USS Frankford: Sherman đã ngừng bắn. Công việc tạm xong tại đây."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Chỉ huy USS Frankford: Các boongke sâu trong đất liền quá tầm bắn của chúng tôi."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Chỉ huy USS Frankford: Rút ra xa để đảm bảo khoảng cách an toàn đây. Chúc may mắn trên bờ biển."

