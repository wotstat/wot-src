msgid "aim/spg/autoChangeAimMode"
msgstr "Tự Đổi Chế độ Ngắm"

msgid "aim/spg/autoChangeAimMode/tooltip/body"
msgstr "Khi cuộn con lăn chuột đến một giá trị phóng to nhất định, tâm ngắm sẽ chuyển từ góc nhìn \"Mắt chim\" sang \"Quan sát đường đạn\"."

msgid "aim/spg/autoChangeAimMode/tooltip/header"
msgstr "Tự Đổi Chế độ Ngắm"

