msgid "CUSTOM_AA_MODE"
msgstr "Khử răng cưa"

msgid "CUSTOM_AA_MODE/description"
msgstr "Quyết định mức độ tăng cường xử lý các đường mỏng và viền của vật thể. Giảm tối thiểu hiệu ứng răng cưa.\n\n• Cao—FXAA\n• Tối đa—Temporal Supersampling Antialiasing (TSSAA)"

msgid "DRR_AUTOSCALER_ENABLED"
msgstr "Điều chỉnh Linh động"

msgid "DRR_AUTOSCALER_ENABLED/description"
msgstr "Bật hoặc tắt tính năng tự động điều chỉnh độ phân giải kết xuất dữ liệu (Render) 3D tùy thuộc vào cường độ card màn hình.\n\nBật tham số này có thể cải thiện hiệu suất game. Độ phân giải kết xuất dữ liệu trong Ga-ra luôn không đổi."

msgid "EFFECTS_QUALITY"
msgstr "Chất lượng Hiệu ứng Phụ"

msgid "EFFECTS_QUALITY/description"
msgstr "Quyết định chất lượng tia lửa của đạn bị nảy ra, các vụ nổ, khói và nhiều hiệu ứng trực quan khác.\n\nGiảm giá trị của tham số này có thể cải thiện hiệu suất trò chơi."

msgid "FAR_PLANE"
msgstr "Khoảng cách Đồ họa"

msgid "FAR_PLANE/description"
msgstr "Quyết định chất lượng của các hình nổi, nhà cửa, xe địch và các vật thể khác trong trò chơi."

msgid "FLORA_QUALITY"
msgstr "Mật độ Cây cỏ"

msgid "FLORA_QUALITY/description"
msgstr "Quyết định mật độ cây cỏ hiển thị ở chế độ \"Arcade\" và \"Sniper\"."

msgid "HAVOK_ENABLED"
msgstr "Tăng cường hiệu ứng phá hủy vật lý"

msgid "HAVOK_ENABLED/OFF"
msgstr "TẮT"

msgid "HAVOK_ENABLED/ON"
msgstr "BẬT"

msgid "HAVOK_ENABLED/description"
msgstr "Cho phép xử lý cũng như hiển thị sự phá hủy vật thể chi tiết và chân thực hơn trên bản đồ.\n\nTắt tham số này có thể cải thiện hiệu suất trò chơi."

msgid "HAVOK_ENABLED/warning"
msgstr "Thiết lập này sẽ được áp dụng ở trận tiếp theo, nếu bị tắt ở trận hiện tại."

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED"
msgstr "Hiệu ứng hình ảnh nâng cao"

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED/description"
msgstr "Bật các hiệu ứng hình ảnh nâng cao. Tắt tùy chọn này sẽ trở lại các hiệu ứng tiêu chuẩn, điều này có thể cải thiện hiệu năng trò chơi."

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED/warning"
msgstr "Thiết lập này sẽ được áp dụng ở trận tiếp theo, nếu bị tắt ở trận hiện tại."

msgid "LANGUAGE_CODE"
msgstr "vi"

msgid "LIGHTING_QUALITY"
msgstr "Chất lượng Ánh sáng"

msgid "LIGHTING_QUALITY/description"
msgstr "Độ chuẩn xác khi hiển thị các tia nắng, tia chớp và hiệu ứng ánh sáng.\n\nTăng giá trị của tham số này sẽ khiến card màn hình phải làm việc với cường độ cao hơn đáng kể."

msgid "MOTION_BLUR_QUALITY"
msgstr "Hiệu ứng Nhòe do Chuyển động"

msgid "MOTION_BLUR_QUALITY/description"
msgstr "Quyết định chất lượng hiệu ứng nhòe do chuyển động của hình ảnh khi xe di chuyển và xoay camera."

msgid "MSAA_QUALITY"
msgstr "Khử răng cưa"

msgid "MSAA_QUALITY/description"
msgstr "Quyết định mức độ tăng cường xử lý các đường mỏng và viền của vật thể. Giảm tối thiểu hiệu ứng răng cưa.\n\n• Thấp—MSAA 2x\n• Trung bình—MSAA 4x\n• Cao—MSAA 8x"

msgid "OBJECT_LOD"
msgstr "Độ chi tiết của vật thể"

msgid "OBJECT_LOD/description"
msgstr "Quyết định số lượng vật thể hiển thị và chất lượng của chúng."

msgid "POST_PROCESSING_QUALITY"
msgstr "Chế độ Hậu Xử lý"

msgid "POST_PROCESSING_QUALITY/description"
msgstr "Quyết định chất lượng các hiệu ứng trực quan hậu xử lý: Ảo ảnh nhiệt, sóng xung kích, quang sai, mờ viền, nhiễu phim, v.v...\n\nGiảm giá trị của tham số này có thể cải thiện hiệu suất trò chơi."

msgid "RENDER_PIPELINE_QUALITY"
msgstr "Đồ họa"

msgid "RENDER_PIPELINE_QUALITY/description"
msgstr "Nâng cao: Cho chất lượng hình ảnh tối đa.\n\nTiêu chuẩn: Cho hiệu suất game tốt nhất bằng cách đơn giản hóa hoặc tắt bỏ một số hiệu ứng đẹp mắt."

msgid "RENDER_PIPELINE_QUALITY/label"
msgstr "Đồ họa:"

msgid "RENDER_PIPELINE_QUALITY/warning"
msgstr "Thay đổi tham số này sẽ có hiệu lực sau khi khởi động lại game."

msgid "SEMITRANSPARENT_LEAVES_ENABLED"
msgstr "Độ trong của tán lá"

msgid "SEMITRANSPARENT_LEAVES_ENABLED/description"
msgstr "Quyết định cách hiển thị tán lá của bụi rậm và cây cối xung quanh.\n\nTắt tham số này sẽ làm ẩn hoàn toàn tán lá của các bụi rậm và cây cối xung quanh, từ đó có thể cải thiện hiệu suất game."

msgid "SHADER_VERSION_CAP"
msgstr "Kiểu đổ Bóng"

msgid "SHADOWS_QUALITY"
msgstr "Chất lượng Bóng"

msgid "SHADOWS_QUALITY/description"
msgstr "Quyết định chất lượng xử lý bóng đổ linh động trên toàn bộ khoảng cách đồ họa.\n\nGiảm giá trị của tham số này có thể cải thiện đáng kể hiệu suất game."

msgid "SMOKE_ENABLED"
msgstr "Khói"

msgid "SNIPER_MODE_EFFECTS_QUALITY"
msgstr "Hiệu ứng Phụ trong Chế độ Sniper"

msgid "SNIPER_MODE_EFFECTS_QUALITY/description"
msgstr "Quyết định chất lượng tia lửa của đạn bị nảy ra, các vụ nổ, khói và nhiều hiệu ứng thực tế khác trong chế độ Sniper.\n\nGiảm giá trị của tham số này có thể cải thiện hiệu suất trò chơi."

msgid "SNIPER_MODE_GRASS_ENABLED"
msgstr "Hiển thị Cỏ trong chế độ Sniper"

msgid "SNIPER_MODE_GRASS_ENABLED/description"
msgstr "Hiển thị cỏ trong chế độ Sniper.\n\nTắt bỏ tham số này có thể cải thiện hiệu suất trò chơi."

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED"
msgstr "Tăng cường chi tiết bề mặt địa hình trong chế độ \"Sniper'"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED/description"
msgstr "Tăng chất lượng hình ảnh địa hình ở chế độ \"Sniper\" trong bán kính 50 mét tính từ xe của bạn. Chỉ khả dụng khi tùy chọn tăng cường chi tiết bề mặt Địa hình được bật.\n\nTắt tham số này có thể cải thiện hiệu suất trò chơi."

msgid "SPEEDTREE_QUALITY"
msgstr "Chất lượng Thực vật"

msgid "SPEEDTREE_QUALITY/description"
msgstr "Quyết định chất lượng hình ảnh của cây cối, bụi rậm và cỏ."

msgid "TERRAIN_QUALITY"
msgstr "Chất lượng Địa hình"

msgid "TERRAIN_QUALITY/description"
msgstr "Quyết định chất lượng đồ họa của các vật thể nổi có trên bản đồ.\n\nChỉ nên chọn chất lượng địa hình thấp nhất khi máy tính cấu hình yếu.\n\nGiảm giá trị của tham số này có thể gây mất đồng bộ khi hiển thị địa hình giữa máy chủ và trong game."

msgid "TERRAIN_QUALITY/warning"
msgstr "Sẽ tốn một khoảng thời gian để áp dụng các tham số đã định."

msgid "TERRAIN_TESSELLATION_ENABLED"
msgstr "Tăng cường chi tiết bề mặt địa hình"

msgid "TERRAIN_TESSELLATION_ENABLED/description"
msgstr "Một tiến trình tăng tốc nhờ phần cứng khi thêm các tam giác mới vào lưới đa giác để tăng độ chi tiết của lưới.\n\nChức năng này chỉ hoạt động với:\n• Thiết lập Đồ họa Nâng cao\n• Chất lượng Địa hình Cao, Tối đa hoặc Siêu cao\n• DirectX 11 được cài đặt.\n\nCác thay đổi thiết lập không khả dụng với những phiên bản cũ hơn DirectX 11.\n\nTắt bỏ thông số này có thể cải thiện hiệu suất game."

msgid "TEXTURE_QUALITY"
msgstr "Chất lượng Hình ảnh Bề mặt"

msgid "TEXTURE_QUALITY/description"
msgstr "Chất lượng bề mặt của các vật thể trong game, đặc biệt là khi nhìn gần.\n\nGiảm giá trị của tham số này có thể cải thiện hiệu suất trò chơi."

msgid "TEXTURE_QUALITY/warning"
msgstr "Sẽ tốn một khoảng thời gian để áp dụng các tham số đã định."

msgid "TRACK_PHYSICS_QUALITY"
msgstr "Vật lý Xích"

msgid "TRACK_PHYSICS_QUALITY/description"
msgstr "Quyết định độ chi tiết của xích, chất lượng mô phỏng vật lý cho xích bị đứt cũng như đang hoạt động.\n\nTắt hoặc giảm tham số này có thể cải thiện hiệu suất game."

msgid "VEHICLE_DUST_ENABLED"
msgstr "Bật hiệu ứng xích và bánh xe"

msgid "VEHICLE_DUST_ENABLED/description"
msgstr "Hiển thị đất, tuyết hoặc nước văng lên phía sau xích và bánh xe.\n\nTắt bỏ tham số này có thể cải thiện hiệu suất trò chơi."

msgid "VEHICLE_TRACES_ENABLED"
msgstr "Bật hiển thị vết xích và bánh xe"

msgid "VEHICLE_TRACES_ENABLED/description"
msgstr "Hiển thị vết xích và bánh xe trên mặt đất.\n\nKhông khả dụng đối với thiết lập Đồ họa Tiêu chuẩn và Chất lượng Đề-can Thấp."

msgid "VISIBILITY_TUNNEL"
msgstr "Hiệu ứng và độ hiển thị phụ tùng 3D"

msgid "VISIBILITY_TUNNEL/description"
msgstr "Điều chỉnh độ hiển thị của hiệu ứng và các phụ tùng 3D gần trung tâm màn hình để giảm cản trở tầm nhìn khi ngắm. Độ hiển thị của phụ tùng 3D chỉ được điều chỉnh trong chế độ Sniper.\n\nGiá trị thấp sẽ làm hiệu ứng và phụ tùng 3D trong suốt hơn để tăng độ rõ khi ngắm."

msgid "WATER_QUALITY"
msgstr "Chất lượng Mặt nước"

msgid "WATER_QUALITY/description"
msgstr "Quyết định chất lượng hình ảnh của mặt nước."

msgid "aim/armorFlashlight/colorSchema/greenShades/label"
msgstr "Chỉ giáp kém"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/body"
msgstr "Nếu bật, Flashlight chỉ làm nổi giáp yếu của mục tiêu.\n\nGiáp có khả năng xuyên thủng cao được làm nổi bằng màu xanh lá cây đậm, trong khi xác suất trung bình được làm nổi bằng màu lục hơi trong suốt. Màu sắc có thể khác khi bật chế độ mù màu."

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/header"
msgstr "Chỉ làm nổi giáp kém"

msgid "aim/armorFlashlight/colorSchema/redShades/label"
msgstr "Chỉ giáp mạnh"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/body"
msgstr "Nếu bật, Flashlight chỉ làm nổi giáp mạnh của mục tiêu.\n\nGiáp có khả năng xuyên thủng gần như bằng không được làm nổi bằng màu đỏ đậm, trong khi xác suất trung bình được làm nổi bằng màu đỏ hơi trong suốt. Màu sắc có thể khác khi bật chế độ mù màu."

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/header"
msgstr "Chỉ làm nổi giáp mạnh"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/label"
msgstr "Mọi loại giáp"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/body"
msgstr "Nếu bật, Flashlight làm nổi mọi giáp của mục tiêu.\n\nGiáp có khả năng xuyên thủng gần như bằng không được làm nổi bằng màu đỏ, trong khi xác suất cao—màu lục, xác suất trung bình—màu vàng. Màu sắc có thể khác khi bật chế độ mù màu."

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/header"
msgstr "Làm nổi mọi giáp"

msgid "aim/armorFlashlight/colorSchemas"
msgstr "Làm nổi giáp"

msgid "aim/armorFlashlight/enabled/label"
msgstr "Bật vào đầu trận"

msgid "aim/armorFlashlight/enabled/tooltip/body"
msgstr "Trạng thái mặc định của Flashlight khi bắt đầu trận. Bạn có thể bật hoặc tắt Flashlight bất kỳ lúc nào bằng phím nóng đã gán.\n\nKhi bật, Flashlight chỉ hoạt động trong chế độ Sniper.\n\nChế độ game được hỗ trợ:\n• Trận đấu Ngẫu nhiên và Tập Trận;\n• Chiến tuyến;\n• Chiến trận Arcade;\n• Cường kích;\n• Một số chế độ và sự kiện khác.\n\nCó thể hỗ trợ thêm chế độ và sự kiện trong tương lai."

msgid "aim/armorFlashlight/enabled/tooltip/header"
msgstr "Bật vào đầu trận"

