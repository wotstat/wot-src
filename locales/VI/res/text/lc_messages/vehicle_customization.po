msgid "projection_decals/special/projection_decal_132"
msgstr "Anh hùng Thời Hiện đại, Hạng II"

msgid "projection_decals/special/projection_decal_132/description"
msgstr "Một đề-can được trao tặng cho người chơi đã tham chiến 250 000 trận."

msgid "projection_decals/special/projection_decal_133"
msgstr "Anh hùng Thời Hiện đại, Hạng I"

msgid "projection_decals/special/projection_decal_133/description"
msgstr "Một đề-can được trao tặng cho người chơi đã tham chiến 300 000 trận."

msgid "projection_decals/special/projection_decal_134"
msgstr "Chân dung của Elsa"

msgid "projection_decals/special/projection_decal_134/description"
msgstr "\"... và nhiều tượng băng nhất có thể. Chúng sẽ cải thiện hình ảnh sân vườn rất tốt. Ta đặt chúng ở đây, ở kia. Ánh sáng và đèn đặc biệt bắt mắt. Tất cả thật kỳ diệu. Hàng xóm chắc chắn sẽ ghen tị. Anh kia, giúp di chuyển cái hộp này ngay. Đúng rồi, đi chậm nhất có thể, lạnh hết cả lưng. Đừng quên phải cẩn thận với đống pháo hoa, nước xa không cứu được lửa gần nghe chưa.\""

msgid "projection_decals/special/projection_decal_135"
msgstr "Chân dung của Alexandra"

msgid "projection_decals/special/projection_decal_135/description"
msgstr "\"Nơi này thật ấm cúng! Ông nội bảo ở đây đúng rồi! Tiếng này khó chịu không? Pháo hoa có thể là lựa chọn không hay. Cả khu rừng bị quấy nhiễu khiến động vật chạy nhốn nháo. Tốt nhất là nên lắng nghe tiếng nói của thiên nhiên... Thôi, đi đây, mẹ dặn phải cẩn thận với người phàm.\""

msgid "projection_decals/special/projection_decal_136"
msgstr "Chân dung của Holly"

msgid "projection_decals/special/projection_decal_136/description"
msgstr "\"Éo éo! Vù vù! Tuyệt vời! Xin chào, tên: Holly. Phù, để thở cái nào. Đợi đã, đó là khẩu M2 à? Cho bắn thử được không? Chưa bao giờ thử nhưng chắc chắn có thể làm được.\""

msgid "projection_decals/special/projection_decal_137"
msgstr "Chân dung của Ada"

msgid "projection_decals/special/projection_decal_137/description"
msgstr "\"Xin chào! Đây là bánh quy may mắn, cứ tự nhiên đi! Quen không: Món quà giúp hé lộ tương lai. \"Đường dài còn ở phía trước\". Lúc nào cũng thế? Phải nói rằng nơi này được trang trí rất đẹp. Đừng nghe người ta gièm pha, bông hoa nở giữa nghịch cảnh là điều tuyệt đẹp và hiếm có nhất.\""

msgid "projection_decals/special/projection_decal_138"
msgstr "Bản thiết kế"

msgid "projection_decals/special/projection_decal_138/description"
msgstr "Về mặt kỹ thuật, bản thiết kế không phải hình vẽ đơn thuần mà là mẫu in màu xanh lục lam trên giấy cảm quang, được sản xuất bởi quy trình in ảnh Cyanotype. Các kỹ sư đã tận dụng nó đến mức tối đa trong thế kỷ 20 như một phương pháp đơn giản, chi phí thấp để tạo ra bản sao của các họa đồ, hay bản thiết kế nói chung."

msgid "projection_decals/special/projection_decal_139"
msgstr "Mối họa Vô hình"

msgid "projection_decals/special/projection_decal_139/description"
msgstr "Một sự thật không thể chối cãi. Dù có mọi kỹ năng trong tay cùng nhiều phương án đề phòng, kết quả đều giống nhau: Bóng—sút—vỡ kính."

msgid "projection_decals/special/projection_decal_14"
msgstr "Bản đồ Chiến sự Mùa 18"

msgid "projection_decals/special/projection_decal_140"
msgstr "Pizza Progetto"

msgid "projection_decals/special/projection_decal_140/description"
msgstr "Sau khi thử món ăn nhẹ bổ dưỡng này, bạn sẽ trải nghiệm một hiệu ứng khá thú vị. Mỗi miếng cải thiện khả năng nói tiếng Ý và giúp bạn phát âm như người bản địa chính gốc. Nhưng hãy nhớ... tác dụng sẽ biến mất sau khi ăn xong chiếc pizza. Arrivederci!"

msgid "projection_decals/special/projection_decal_141"
msgstr "Rất Thích Khi..."

msgid "projection_decals/special/projection_decal_141/description"
msgstr "... bạn tham chiến trong chiếc xe với giáp \"mỏng manh\" tới mức có thể bị xuyên mà không cần ngắm vào điểm yếu. Đăng ký và click biểu tượng chiếc chuông để liên tục cập nhật tin tức."

msgid "projection_decals/special/projection_decal_142"
msgstr "Đầu bếp"

msgid "projection_decals/special/projection_decal_142/description"
msgstr "Trụ cột của mọi đơn vị quân đội, \"keo dính\" giúp tất cả gắn kết với nhau... Mọi đầu bếp \"ăn mặn\" đều tuân theo hai quy tắc đơn giản: Hạn chế Natri và \"thà sống còn hơn chín quá\"."

msgid "projection_decals/special/projection_decal_143"
msgstr "Tự Tin Thể Hiện Bản Thân"

msgid "projection_decals/special/projection_decal_143/description"
msgstr "Mỗi trận mỗi khác, vì vậy, đừng lo lắng, đâu còn có đó. Cứ chậm rãi... Nhanh lên! Quyết định thuộc về bạn. Luôn có nhiều vị trí tùy chọn và một nòng súng để thổi bay sức kháng cự của quân thù."

msgid "projection_decals/special/projection_decal_144"
msgstr "Đặc vụ Hellcat"

msgid "projection_decals/special/projection_decal_144/description"
msgstr "Nếu theo đúng thể loại, đề-can này sẽ thành kiểu đơn sắc với mưa lớn ở hậu cảnh. Hãy tưởng tượng một đoạn độc thoại dài đầy tính ngữ, thều thào chất giọng chứa đầy sự vô vọng và mệt mỏi."

msgid "projection_decals/special/projection_decal_145"
msgstr "Thùng Chiến tích"

msgid "projection_decals/special/projection_decal_145/description"
msgstr "Không lãng phí, cũng chả thèm muốn gì. Ga-ra đủ rộng để lưu trữ tất cả phần thưởng xứng đáng, nhọc công kiếm được trong nhiều sự kiện game đặc biệt."

msgid "projection_decals/special/projection_decal_147"
msgstr "Nòng kép"

msgid "projection_decals/special/projection_decal_147/description"
msgstr "Vũ trang? Là sao? Vũ trang gì? Xích, giáp, ngụy trang, kính ba lớp...? Đoán xem mấy chiếc tăng hạng nặng Liên Xô này sẽ được trang bị gì? Tất nhiên là hai nòng súng rồi, ngố tàu!"

msgid "projection_decals/special/projection_decal_148"
msgstr "Minsk (Tái phục dựng)"

msgid "projection_decals/special/projection_decal_148/description"
msgstr "Thành phố nơi mọi thứ bắt đầu. Đây có thể hiểu là phép đệ quy: Đầu tiên, xe tăng ảo được phát triển ở thành phố Minsk thực, sau đó, Minsk ảo được phát triển cho xe tăng ảo."

msgid "projection_decals/special/projection_decal_149"
msgstr "Hổ Rình Mồi"

msgid "projection_decals/special/projection_decal_149/description"
msgstr "Đây là chiến thuật trinh sát hoàn hảo trên Prokhorovka. Chậm rãi, từng inch một, trườn qua bụi rậm tới khi chạm đến khu vực K-1. Ta-đa! Một Trung đội Mouse lộ hình, run như cầy sấy!"

msgid "projection_decals/special/projection_decal_15"
msgstr "Bản đồ Chiến sự Mùa 19"

msgid "projection_decals/special/projection_decal_150"
msgstr "Rồng Ẩn Mình"

msgid "projection_decals/special/projection_decal_150/description"
msgstr "Sau trận đánh dài và khốc liệt, trên đường đến căn cứ kẻ thù, với sức kháng cự thấp tới mức không thể sống nổi nếu chẳng may quẹt phải bụi gai, chẳng có liều thuốc tiên nào tuyệt hơn khi thấy một chiếc tăng địch còn nguyên vẹn, bằng cách nào đó, đứng im ru, đầy HP."

