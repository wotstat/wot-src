msgid "camouflage/czech/Cz_dust/description"
msgstr "Vào mùa hè 1942, các đốm vàng được phối với màu xám chủ đạo của những xe Tiệp Khắc trong Sư đoàn Thiết giáp (Panzer Division) Số 22."

msgid "camouflage/czech/Cz_dust/label"
msgstr "Đức từ 1942"

msgid "camouflage/czech/Cz_summer/description"
msgstr "Được sử dụng cho tới 1939. Các đốm vàng, nâu được phối lên bột nhuộm xanh lá cây xỉn. Mỗi xe có hoa văn riêng."

msgid "camouflage/czech/Cz_summer/label"
msgstr "Tiệp Khắc từ 1930"

msgid "camouflage/czech/Cz_winter/description"
msgstr "Được sử dụng từ 1941 đến 1942. Các xe Tiệp Khắc trong Sư đoàn Thiết giáp Số 8 của Wehrmacht được chấm bột nhuộm trắng lên nền màu xám cơ bản."

msgid "camouflage/czech/Cz_winter/label"
msgstr "Đức từ 1941"

msgid "camouflage/czech/bicolor/Cz_desert01/description"
msgstr "Hoa văn đốm màu cát được phối lên lớp cơ bản. Một tăng Tiệp Khắc với kiểu sơn ngụy trang này, được sử dụng bởi Sư đoàn Tăng Wehrmacht Số 20, đã bị phát hiện gần Demyansk vào tháng 03/1942."

msgid "camouflage/czech/bicolor/Cz_desert01/label"
msgstr "Cát 2-tông"

msgid "camouflage/czech/bicolor/Cz_winter01/description"
msgstr "Hoa văn này được tạo ra bằng cách phối sơn nước trắng và vôi lên lớp nền cơ bản gồm các đốm không đều. Nó đã được sử dụng trong mùa đông 1941–1942 bởi Sư đoàn Tăng Wehrmacht Số 12."

msgid "camouflage/czech/bicolor/Cz_winter01/label"
msgstr "Mùa đông 2-tông"

