msgid "special_style/bb2020_dezgamez_shop/long"
msgstr "Một kiểu mẫu mọi mùa với tông màu đại diện cho đội DezGamez. Chưa ai từng thấy mặt hay biết nhiều về anh, nhưng có một điều chắc chắn, đằng sau lớp mặt nạ, anh là một người luôn cho ra lò nội dung hữu ích, sâu sắc về tất cả những thông tin hấp dẫn mới trên Twitch và Youtube."

msgid "special_style/bb2020_dezgamez_shop_desc"
msgstr "Kiểu mẫu mọi mùa có thể được mua trong sự kiện game đặc biệt."

msgid "special_style/bb2020_dragon_award"
msgstr "Đội Dragon, phần thưởng"

msgid "special_style/bb2020_dragon_award/long"
msgstr "Một kiểu mẫu mọi mùa với tông màu đại diện cho đội Dragon—những chiến binh huyền thoại, mình đồng da sắt, không bao giờ quay lưng và luôn nhắm đến mục tiêu. Hùng mạnh, uyên thâm, cẩn trọng khi ra quyết định, luôn góp phần vào thành công của mọi nhiệm vụ, không có gì là bất khả thi đối với họ."

msgid "special_style/bb2020_dragon_award_desc"
msgstr "Một kiểu mẫu mọi mùa được trao tặng cho thành tích của bạn trong sự kiện game đặc biệt."

msgid "special_style/bb2020_dragon_shop"
msgstr "Đội Dragon, tấn công"

msgid "special_style/bb2020_dragon_shop/long"
