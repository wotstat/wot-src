msgid "special_style/rebranding_event_desc/long"
msgstr "?empty?"

msgid "special_style/red_desert"
msgstr "Sa mạc Đỏ"

msgid "special_style/red_desert_desc"
msgstr "Một kiểu mẫu mọi-mùa lấy cảm hứng từ phong cảnh sa mạc cát ở trung tâm Australia."

msgid "special_style/red_desert_desc/long"
msgstr "Nhà thám hiểm người Anh Charles Sturt khám phá ra sa mạc khổng lồ này ở trung tâm Australia năm 1845, khi dẫn đầu một đoàn đặc biệt của chính phủ đi tìm nguồn nước ngọt. Năm 1929, chuyên gia địa chất Cecil Madigan khảo sát lãnh thổ từ trên cao và đặt tên sa mạc theo Alfred Allen Simpson, chủ tịch chi nhánh Nam Úc của Hiệp hội Địa lý Hoàng gia Australasia.\nSa mạc này nổi tiếng với những cồn cát song song dài nhất thế giới, đặc biệt là cồn cát tên \"Big Red\" cao đến 40-mét. Ngoài khách du lịch, bạn cũng sẽ bắt gặp nhiều loài động vật quý hiếm và thực vật độc đáo giữa phong cảnh đỏ sậm. Sa mạc Simpson là nhà của hơn 180 loại chim, hàng loạt thú có túi cũng như thằn lằn."

msgid "special_style/referal_programm"
msgstr "Hợp lực"

msgid "special_style/referal_programm_desc"
msgstr "Một kiểu mẫu mọi mùa, được trao tặng khi hoàn thành Chương trình Giới thiệu."

msgid "special_style/retrowave"
msgstr "Retro Rhythm"

msgid "special_style/retrowave_desc"
msgstr "Một kiểu mẫu mọi-mùa tôn vinh âm thanh của những ngày xưa tươi đẹp."

msgid "special_style/retrowave_desc/long"
msgstr "Càng lớn, ta càng hay nhìn lại những ngày xưa cũ. Hồi đó mọi thứ dường như tốt hơn, phải không? Cỏ xanh hơn, mùa hè dài hơn, âm nhạc nghe cũng... mới mẻ hơn. Nhưng thời gian thay đổi. Cuộc sống đổi thay. Ta cũng vậy. Dù thế, có những cảm xúc chẳng bao giờ phai. Như cảm giác hồi hộp khi nhấn nút \"Play\" cuộn băng cassette mới toanh. Hay khoảnh khắc kỳ diệu khi kim rơi xuống bản nhạc yêu thích trên đĩa than. Những ký ức khác có thể mờ dần, nhưng âm nhạc luôn ở lại."

msgid "special_style/roaring_waves"
msgstr "Sóng Gầm"

msgid "special_style/roaring_waves_desc"
msgstr "Một kiểu mẫu mọi-mùa lấy cảm hứng từ nghệ thuật phương Đông."

msgid "special_style/roaring_waves_desc/long"
msgstr "Một quái vật thép gầm thét trên trận địa, phủ trên mình màu sắc biển khơi. Với sức mạnh của sóng gió, các chiến binh khoác lớp sơn này sẽ gieo rắc kinh hoàng cho kẻ địch. Chỉ những nhà vô địch uy lực nhất mới có vinh dự sở hữu \"Sóng Gầm\"."

msgid "special_style/roll_into_christmas"
msgstr "Roll Into Christmas"

msgid "special_style/roll_into_christmas_desc"
msgstr "Một kiểu mẫu lễ hội giúp bạn gặt hái không khí Giáng Sinh, quanh năm."

msgid "special_style/roll_into_christmas_desc/long"
msgstr "Ồ, Giáng Sinh. Thời gian tuyệt nhất trong năm, phải không? Cây cối, đèn điếc, tầm gửi—ấm cúng ra phết. Và tất nhiên còn những món quà. Cái gì dưới gốc cây vậy? Một đôi vớ nữa từ bà ngoại? Một cục than? Không, không phải năm nay. Năm nay, một chiếc tăng mới coóng bọc ngoài với kiểu mẫu tết? Vâng, bất chấp...ai ...nghèo, ngành ...doanh ảo ...tục ...túng... tâm ... ...tiêu dùng... ...sữa từ những... bò!"

msgid "special_style/royal_corps"
msgstr "Fear Naught"

msgid "special_style/royal_corps_desc/long"
msgstr "Kiểu mẫu này dựa trên vài biểu tượng của Vương quốc Anh: Con Sư tử và Kỳ lân từ phù hiệu chính thức, biểu tượng và khẩu hiệu của Quân đoàn Thiết giáp Hoàng Gia, và quốc kỳ của Vương quốc Anh, vốn bao gồm cờ Anh, Scotland và Bắc Ireland."

msgid "special_style/royalpurple"
msgstr "Royal Purple"

msgid "special_style/royalpurple_desc"
msgstr "Mang chút tinh tế vào chiến trường bằng kiểu mẫu vua chúa mọi-mùa này."

msgid "special_style/sandbox"
msgstr "Sự thật trong Sandbox"

msgid "special_style/sandbox_desc"
msgstr "Một kiểu mẫu mọi-mùa được trao tặng khi tham dự thử nghiệm Sandbox."

msgid "special_style/sandbox_desc/long"
msgstr "Sandbox là một máy chủ thử nghiệm riêng biệt, nơi ê-kíp phát triển và người chơi cùng nhau kiểm tra, thảo luận cũng như quyết định số phận của nhiều cơ chế hay ý tưởng mới. Ai cũng có thể tham gia, và phản hồi từ game thủ sẽ được cân nhắc, trực tiếp ảnh hưởng đến các bản cập nhật World of Tanks trong tương lai."

msgid "special_style/sandstorm"
msgstr "Sandstorm"

msgid "special_style/sandstorm_desc/long"
msgstr "Một kiểu mẫu mọi-mùa vinh danh sự kiện Tương Lai Xa.\nĐể sống sót trên sa mạc, người Fremen chế tạo bộ đồ chưng cất đặc biệt, gọi là \"stillsuit\". Vải đa-lớp độc đáo giúp phân tán nhiệt và lọc hơi ẩm của cơ thể. Nhìn chung, một bộ \"stillsuit\" hoạt động bình thưởng, vừa vặn cho phép người mặc sống sót vài tuần trên sa mạc mênh mông. Tuy nhiên, môi trường đó cực kỳ khắc nghiệt, đôi khi những sản phẩm tinh vi nhất như vậy vẫn bị chôn vùi dưới lớp cát."

msgid "special_style/sekira"
msgstr "The Axe"

msgid "special_style/sekira_desc"
msgstr "Một kiểu mẫu mọi-mùa +10 động lực."

msgid "special_style/sekira_desc/long"
msgstr "\"Khi đụng độ một đối thủ, bạn cần cơn điên thể thao đó trong mình. Không phải cơn giận mù quáng—cơn thịnh nộ thể thao. Đó là thứ mang lại sức mạnh. Đó là lý do tại sao người mạnh nhất không phải là kẻ thắng, mà là người sẵn sàng nỗ lực hết mình. Hãy nhớ khi mọi thứ trở nên rối rắm. Nhưng chỉ khi đó thôi. Bởi vì quãng thời gian còn lại, việc mất kiểm soát không bao giờ kết thúc tốt đẹp.\""

msgid "special_style/seniority_awards_2020"
msgstr "Tăng thủ Kỳ cựu"

msgid "special_style/seniority_awards_2020_desc/long"
msgstr "Một kiểu mẫu mọi-mùa được trao tặng như lời tri ân đến tất cả tăng thủ của chúng tôi, những người đã có nhiều đóng góp quý giá vào quá trình phát triển dự án này, giúp mở ra các chân trời mới, thúc đẩy Ê-kíp cải thiện trò chơi. Được trao tặng theo chương trình Phần thưởng Xứng đáng bắt đầu từ 2020."

msgid "special_style/seniority_awards_2021_desc/long"
