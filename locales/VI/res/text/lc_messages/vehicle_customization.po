msgid "special_style/15th_anniversary"
msgstr "World of Tanks 15th Anniversary"

msgid "special_style/15th_anniversary_1"
msgstr "Forest Veil"

msgid "special_style/15th_anniversary_1_desc"
msgstr "Một kiểu mẫu mọi-mùa kết hợp sức mạnh cơ học với sự tĩnh lặng của rừng."

msgid "special_style/15th_anniversary_1_desc/long"
msgstr "Vô số xe đã lăn qua khu rừng này. Đối với tăng thủ, rừng trở thành nhà, bóng cây cổ thụ vừa là nơi ẩn náu vừa là bạn đồng hành, giúp tránh tầm nhìn kẻ thù và tạm nghỉ giữa chiến trận ác liệt."

msgid "special_style/15th_anniversary_2"
msgstr "Coniferous"

msgid "special_style/15th_anniversary_2_desc"
msgstr "Một kiểu mẫu mọi-mùa kết hợp sức mạnh cơ học với sự tĩnh lặng của rừng."

msgid "special_style/15th_anniversary_2_desc/long"
msgstr "Thiên nhiên có cách thích nghi và tồn tại, bất kể điều gì xảy ra. Máy móc rèn lối đi, toàn thép bền cao và động cơ nghiến rít—nhưng rừng đã chào đón chúng như của riêng mình. Theo thời gian, những gì từng xa lạ bắt đầu hòa quyện với tầng cây thấp—bóng cây thông phục vụ như ngụy trang tự nhiên."

msgid "special_style/15th_anniversary_3"
msgstr "Woodland Dawn"

msgid "special_style/15th_anniversary_3_desc"
msgstr "Một kiểu mẫu mọi-mùa nắm bắt vẻ đẹp của ánh sáng ban mai trong khu rừng yên tĩnh."

msgid "special_style/15th_anniversary_3_desc/long"
msgstr "Dưới ánh sáng ban mai, kế hoạch được lập ra, trận đánh vạch rõ, xe nhận sự bảo dưỡng và lính lác sẵn sàng. Chiến trường có thể khắc nghiệt, nhưng ánh sáng dịu dàng của khu rừng là lời nhắc, ngay cả sau những gì ác liệt nhất, vẫn có một góc thế giới luôn chào đón bạn trở về."

msgid "special_style/15th_anniversary_desc"
msgstr "Một kiểu mẫu mọi-mùa để mừng Sinh nhật World of Tanks thứ 15."

msgid "special_style/23feb"
msgstr "23"

msgid "special_style/2_0_progression_a"
msgstr "Armored Anthem"

msgid "special_style/2_0_progression_a_desc"
msgstr "Giá trị toàn Mỹ tạo nên sự xuất sắc kỹ thuật cho kiểu mẫu mọi-mùa này."

msgid "special_style/2_0_progression_a_desc/long"
msgstr "Táo bạo, mạnh mẽ, cứng như đinh. Không gì thể hiện tinh thần Mỹ hơn thế—một bức tranh ghép độc đáo, hàng ngàn giọng nói hòa lại. Chuyển tải tinh thần sáng tạo từ gốc rễ người Mỹ, con quái vật thép này tôn vinh từ thợ rèn nông trại đến kỹ sư ưu tú—bộ óc xuất sắc dẫn dắt bàn tay chai sạn, bọc tâm huyết phát kiến trong lớp giáp, đoàn kết dưới một lá cờ bằng sự kiên trì, can đảm và chút băng keo kiểu cũ."

msgid "special_style/2_0_progression_ch"
msgstr "Layered Legacy"

msgid "special_style/2_0_progression_ch_desc"
msgstr "Kiểu mẫu mọi-mùa này tôn vinh hàng thế kỷ phát minh."

msgid "special_style/2_0_progression_ch_desc/long"
msgstr "Các tấm thép vuông được khâu tỉ mỉ, mỗi lớp là một câu chuyện về lòng tận tụy. Thiết kế này phản ánh nghệ thuật thủ công Trung Hoa, nơi văn ôn võ luyện khắc họa sự hoàn hảo từ kỷ luật. Giống như thơ trong trường ca, nó kể về sức mạnh tích lũy và tinh luyện, kết hợp trí tuệ quá khứ với đổi mới tương lai—một vũ khí rèn từ lịch sử, mài giũa cho những trận chiến xa xăm."

msgid "special_style/2_0_progression_f"
msgstr "Lignes de Force"

msgid "special_style/2_0_progression_f_desc"
msgstr "Kiểu mẫu mọi-mùa này tạo khung tàn phá chiến trường với sự tinh tế kín đáo."

msgid "special_style/2_0_progression_f_desc/long"
msgstr "Một mạng lưới thanh thép tôi luyện bao bọc thân, cố định bằng bu lông bóng loáng. Ngắn gọn nhưng hùng vĩ, nó không che giấu cỗ máy bên trong mà đóng khung như một tác phẩm nghệ thuật. Mỗi viên đạn bắn ra thêm nét cọ vào bức tranh chiến trận, tạo nên bản giao hưởng khói lửa phong cách Pháp."

msgid "special_style/2_0_progression_g"
msgstr "Feuerhaut"

msgid "special_style/2_0_progression_g_desc"
msgstr "Thiên nhiên nguyên thủy kết hợp kỹ thuật sáng tạo trong kiểu mẫu mọi-mùa này."

msgid "special_style/2_0_progression_g_desc/long"
msgstr "Hữu cơ và lấp lánh, nó gần như sống động. Lớp vỏ cứng bao quanh thân như con rồng thép. Vảy kiểu rắn, xe này thu hút ánh nhìn, nhưng thường là cái bẫy hoặc lời cảnh báo. Hãy giữ khoảng cách, vì bên trong chứa ngọn lửa mạnh mẽ, và bạn biết lửa rồng thì thế nào rồi."

msgid "special_style/2_0_progression_pl"
msgstr "Secesyjna Siła"

msgid "special_style/2_0_progression_pl_desc"
msgstr "Kiểu mẫu mọi-mùa tôn vinh cả thanh lịch và sức mạnh."

msgid "special_style/2_0_progression_pl_desc/long"
msgstr "Những đường cong sắt rèn và hình lưỡi liềm giao nhau tạo nên sự thanh lịch của thẩm mỹ \"Secesja\" Ba Lan. Bộ giáp này nghệ thuật nhưng không phù phiếm, tôn vinh sự kiên cường và vẻ đẹp. Thiết kế Art Nouveau lấy cảm hứng từ lịch sử, nhưng đừng để bị lừa. Như đôi cánh hussar, nó thể hiện sức mạnh vô song."

msgid "special_style/2_0_progression_r"
msgstr "Welded Will"

msgid "special_style/2_0_progression_r_desc"
msgstr "Kiểu mẫu mọi-mùa này thể hiện sự khéo léo của Liên Xô trước biến động công nghệ."

msgid "special_style/2_0_progression_r_desc/long"
msgstr "Giáp này có nguồn gốc từ nhà máy sửa chữa tiền tuyến, mang DNA nền công nghiệp Liên Xô, tái cấu trúc cho chiến tranh Cấp XI. Dù thép cong, nút nổi và kết nối lộ ra trông ngẫu hứng, cỗ máy titan này biết rõ nhiệm vụ. Từ cần thiết thành học thuyết đổi mới, kỷ nguyên sản xuất hàng loạt đã kết thúc. Đây là thế hệ tiếp theo—quyết liệt và nguy hiểm hơn nhiều."

msgid "special_style/2_0_progression_s"
msgstr "Stålram"

msgid "special_style/2_0_progression_s_desc"
msgstr "Chứng kiến sức mạnh yên tĩnh của thiết kế Scandinavia thanh lịch với kiểu mẫu mọi-mùa này."

msgid "special_style/2_0_progression_s_desc/long"
msgstr "Bề mặt các kim tự tháp hình học phẳng bao bọc thân xe trong sự đối xứng yên tĩnh—bóng bẩy, liền mạch và không thể nhầm lẫn với phong cách Scandinavia. Theo thiết kế Bắc Âu hiện đại, tiếng ồn nhường chỗ cho sự tinh tế. Không lộn xộn ở đây. Đó là triết lý về tương lai của chiến tranh bọc thép—hiệu quả phẳng, thiết kế sắc sảo để lắp ráp sự tàn phá chỉ trong vài bước đơn giản."

msgid "special_style/2_0_progression_uk"
msgstr "Imperial Standard"

msgid "special_style/2_0_progression_uk_desc"
msgstr "Kiểu mẫu mọi-mùa kết hợp di sản với hiện đại hóa."

msgid "special_style/2_0_progression_uk_desc/long"
msgstr "Hiện đại hóa tiến lên, nhưng di sản mở lối trước. Lưới thép tôi luyện gợi nhớ sân lát gạch, bãi tập duyệt binh và kỷ luật nghề thủ công cũ, thì thầm sức mạnh thực sự không cần nói nhiều. Rèn chính xác, mài giũa tham vọng, kiểu mẫu này thể hiện sức mạnh giáp Anh Quốc. Dưới vẻ ngoài điềm tĩnh, sức mạnh hỏa lực sẵn sàng bùng nổ."

msgid "special_style/2d_cust_challenges_2026_1"
msgstr "Trial by Fire"

msgid "special_style/2d_cust_challenges_2026_1_desc"
msgstr "Một kiểu mẫu mọi-mùa cháy âm ỉ cho những ai vươn lên đón nhận thử thách của Crucible."

msgid "special_style/2d_cust_challenges_2026_1_desc/long"
msgstr "Trước mặt thử thách không gì sánh bằng: Cơ hội rèn nên huyền thoại của mình trong chiến trận, khắc tên vào thép. Rất ít người dám vào Crucible, chùn bước trước sức nóng bỏng rát, sức nặng của những thử luyện. Càng ít hơn nữa có thể chinh phục nó. Khả năng đỡ đòn bậc thầy sẽ bị đẩy đến giới hạn, nhưng điều sắp đối mặt không đơn thuần. Nó là thước đo ý chí kiên cường và sức mạnh trước mọi nghịch cảnh. Trong sức nóng thiêu đốt của Crucible, khi kẻ khác khuỵu ngã và gục vỡ, bạn sẽ chùn bước thất bại? Hay làm chủ ngọn lửa, bước ra mạnh mẽ hơn bao giờ hết?"

msgid "special_style/2d_cust_challenges_2026_2"
msgstr "Rising Heat"

msgid "special_style/2d_cust_challenges_2026_2_desc"
msgstr "Một kiểu mẫu mọi-mùa cháy bỏng cho những ai tôi luyện ý chí của mình trong Crucible."

msgid "special_style/2d_cust_challenges_2026_2_desc/long"
msgstr "Nhiệt độ tăng lên, áp suất ngày càng dữ dội, nhưng bạn từ chối khuất phục. Xe ánh lên sắc đỏ nhạt, mọi đường nét trên thân đều thấm đẫm hơi nóng những thử thách đã vượt qua. Với mỗi kẻ địch ngã xuống, lửa âm ỉ trên bề mặt nó lại bùng lên thành ngọn lớn hơn, các viên đạn rực cháy giữa không trung với mục tiêu ngày càng hung mãnh. Thúc đẩy bởi quyết tâm rực lửa, bạn di chuyển với kỹ năng và phong thái đĩnh đạc. Băng qua Crucible, bạn tiếp tục tiến lên, không dừng lại trước bất cứ gì cho đến khi chiến thắng."

msgid "special_style/2d_cust_challenges_2026_3"
msgstr "Blaze of Glory"

msgid "special_style/2d_cust_challenges_2026_3_desc"
msgstr "Một kiểu mẫu mọi-mùa rực sáng cho những ai tự mở lối đến chiến thắng trong Crucible."

msgid "special_style/2d_cust_challenges_2026_3_desc/long"
msgstr "Tôi luyện trong những ngọn lửa nghịch cảnh, bạn không sợ gì. Trừ thiên tài lão luyện nhất, dù thử thách sau khắc nghiệt hơn cái trước, bạn đã, đang và sẽ đứng vững trước tất cả, vươn lên thành nhà vô địch. Trong mọi trận, bạn bừng cháy với sức nóng trắng của Crucible, thiêu đốt mặt đất dưới đường xích mình, làm tan vỡ ý chí kẻ thù. Rực cháy trên con đường khai mở, soi lối cho người bước sau với hy vọng tái hiện chiến công phi thường. Chiến thắng bất diệt, thành tựu không gì sánh bằng. Ánh lửa, rực sáng và khải hoàn, sẽ không bao giờ bị dập tắt."

msgid "special_style/2d_cust_journey_marathon_1"
msgstr "Mapping It Out"

msgid "special_style/2d_cust_journey_marathon_1_desc"
msgstr "Một kiểu mẫu mọi-mùa đầy màu sắc, tôn vinh hành trình sinh nhật qua những chốn quen thuộc xưa cũ."

msgid "special_style/2d_cust_journey_marathon_1_desc/long"
msgstr "Tấm bản đồ trên bàn đã sờn cũ, nhăn nheo, nhưng vẫn sống động màu sắc và chi tiết, phác họa hành trình phía trước. Trên những vách đá hiểm trở phía tây là ngọn hải đăng; điểm khởi đầu chiến dịch. Từ vùng đồng bằng phía bắc nhô lên cối xay gió đơn độc, cánh quạt lười biếng xoay trong gió. Về phía đông, qua con sông lớn và dãy núi mờ sương, một ngôi chùa thanh nhã vươn cao trên thung lũng xanh tươi. Cuối cùng, ở sa mạc mênh mông phía nam, những ngọn tháp minaret vươn trên cát bụi, ốc đảo bằng đá giữa đụn cát khô cằn.\n\nLộ trình của bạn đã được vạch ra, xe cộ cũng sẵn sàng. Giờ thì lên đường, tạo ký ức đáng nhớ."

msgid "special_style/2d_cust_journey_marathon_2"
msgstr "On the Road Again"

msgid "special_style/2d_cust_journey_marathon_2_desc"
msgstr "Một kiểu mẫu mọi-mùa vui nhộn, hội tụ mọi cái thiết yếu để biến chuyến đi đường bộ mừng sinh nhật này thành kỷ niệm đáng nhớ."

msgid "special_style/2d_cust_journey_marathon_2_desc/long"
msgstr "Bí quyết chuyến đi đường bộ thành công? Tất nhiên phải có bạn đồng hành. Nhưng ngoài ra thì sao? Chính là bộ đồ mang theo. Có những thứ thiết yếu tuyệt đối không quên: Dụng cụ nấu nướng, chiếc rìu để kiếm củi đốt, radio nghe cho đỡ phát rồ. Rồi đến những thứ có thì tốt: Bảng phi tiêu giải trí lúc rảnh rỗi, cây đàn guitar tối tối bên đống lửa tí tách. Cuối cùng, không kém phần quan trọng, là đồ trang trí: Thật nhiều bóng bay, cờ dây, thêm một hai quả pháo hoa để thắp sáng bầu trời. Dù sao đây cũng là chuyến đi mừng sinh nhật, hãy quẩy hết mình như thể năm 2010."

msgid "special_style/2d_cust_journey_marathon_3"
msgstr "Roots of Steel"

msgid "special_style/2d_cust_journey_marathon_3_desc"
msgstr "Một kiểu mẫu mọi-mùa mộc mạc, hướng đến việc ngắm những nơi quen thuộc bằng góc nhìn mới."

msgid "special_style/2d_cust_journey_marathon_3_desc/long"
msgstr "Rốt cuộc, chuyến đi đường bộ là hành trình trở về cội nguồn: Ra khỏi guồng quay tất bật hằng ngày, kết nối lại những điều cùng những nơi thực sự quan trọng. Ghé địa điểm này vô số lần suốt bao năm qua. Có lẽ nghĩ mình hiểu chúng rõ như lòng bàn tay. Nhưng khi quá tập trung giành chiến thắng, ta có thể quên việc trân trọng những gì xung quanh. Ngay cả tăng thủ dày dạn nhất, địa hình quen thuộc vẫn có bất ngờ mới. Trong chuyến đi này, hãy thử chậm lại một chút để cảm nhận mọi thứ. Đừng quá bận tâm đích đến. Cứ tận hưởng hành trình."

msgid "special_style/2d_cust_journey_marathon_4"
msgstr "Silent Celebration"

msgid "special_style/2d_cust_journey_marathon_4_desc"
msgstr "Một kiểu mẫu mọi-mùa đa dụng, giúp bạn kín đáo suốt chuyến đi mừng sinh nhật."

msgid "special_style/2d_cust_journey_marathon_4_desc/long"
msgstr "Các sống núi đá gồ ghề, thung lũng xanh tươi, những đồng bằng nhấp nhô, dải cát sa mạc dịch chuyển. Chuyến viễn chinh này sẽ băng qua mọi loại địa hình, mỗi khúc ngoặt luôn có địch mai phục, sẵn sàng chào đón nồng nhiệt. May thay, bạn có đúng kiểu ngụy trang cần thiết: Một phối màu đa sắc linh hoạt, giúp ẩn mình kín đáo trong rừng rậm hiệu quả như trên cồn cát cháy nắng. Và nếu đứa nào bên địch tinh mắt cỡ diều hâu, nhận ra những con số 16 màu vàng tinh tế điểm lên cỗ máy đánh dấu dịp này, xin chúc may mắn: Chúng sắp nhận một bất ngờ sinh nhật không dễ chịu."

msgid "special_style/360_anniversary"
msgstr "Chép Koi"

msgid "special_style/360_anniversary_desc"
msgstr "Một kiểu mẫu mọi-mùa dành riêng cho dịp kỷ niệm phát hành World of Tanks ở khu vực Trung Quốc với sự hợp tác của 360."

msgid "special_style/360_anniversary_desc/long"
msgstr "Koi là một loại cá chép thường đã được thuần hóa, lai tạo để nuôi làm cảnh, phổ biến tại Nhật Bản và Trung Quốc. Biểu tượng của sự kiên trì, quyết đoán, dũng mãnh và thịnh vượng. Có mặt trong nhiều truyền thuyết với khả năng đặc biệt như bơi ngược dòng hay thậm chí hóa thành rồng. Tượng, hình hay vật phẩm cá Koi thường được dùng làm quà cho họ hàng, đồng nghiệp để thể hiện sự quý trọng. Những con cá màu đỏ sáng thường có giá trị cao nhất."

msgid "special_style/50TP_prototyp_WingedHussar"
msgstr "Winged Hussar"

msgid "special_style/50TP_prototyp_WingedHussar_desc/long"
msgstr "Winged Hussar là một trong các loại kỵ binh chính phục vụ Ngai vàng Vương quốc Ba Lan và Đại Công tước Lithuania. Sau khi Ba Lan thống nhất, hình ảnh Winged Hussar biểu tượng cho uy lực, sức mạnh vô địch, huyền thoại và huy hoàng của Ba Lan được chú trọng quảng bá.\n\n%(insertion_open)sCác chi tiết của hình ảnh được làm theo nhiều dạng, ra số lượng lớn và sử dụng cho tất cả các loại đơn vị, từ kỵ binh cho đến không quân.%(insertion_close)s\n\nTrong Thế Chiến II, biểu tượng của Sư đoàn Thiết giáp Số 01 Ba Lan (1 Dywizja Pancerna) lấy cảm hứng từ mũ sắt và đôi cánh của các kỵ binh nước này."

msgid "special_style/75_years_victory_day"
msgstr "V—Biểu tượng Chiến thắng!"

msgid "special_style/75_years_victory_day_desc"
msgstr "?empty?"

msgid "special_style/75_years_victory_day_desc/long"
msgstr "Một kiểu mẫu mọi mùa nhằm kỷ niệm 1945 năm Thắng lợi trong Cuộc Chiến tranh Vệ quốc Vĩ đại. Xung đột kết thúc sau khi Đức ký kết Văn kiện Đầu hàng vào tối muộn 08/05/1945 (ngày 09/05, giờ Mát-cơ-va)."

msgid "special_style/8bit"
msgstr "8-Bit Turtles"

msgid "special_style/8bit_desc/long"
msgstr "\"Có gì tuyệt hơn 'chill', mở trò điện tử ưa thích? Thư giãn, chơi game, hốc pizza ngon lành bổ dưỡng? Thiên đường là đây! Đánh bọn xấu cũng tuyệt và cao cả đấy, nhưng mệt. Anh cần thời gian nghỉ ngơi. Nhưng trong game, số mạng không giới hạn, không phải lo nếu lỡ thành súp rùa. Ý anh sao? Mới chơi 6 tiếng thôi mà! Tiếp đi, một Level nữa. Gọi chúng nó giao thêm cái pizza nữa cho tiện nhể!\""

msgid "special_style/9th_anniversary_eu_na"
msgstr "Giáp Composite"

msgid "special_style/9th_anniversary_eu_na_desc"
msgstr "Một kiểu mẫu mọi mùa được chế tạo bằng công nghệ kỹ thuật quân sự tiên tiến nhất. Theo tư liệu kỹ thuật, nó có thể làm nảy gần như bất kỳ viên đạn nào của địch."

msgid "special_style/A06_M4A3E8_Sherman_BC_3DSt"
msgstr "?empty?"

msgid "special_style/A06_M4A3E8_Sherman_BC_3DSt_desc/long"
msgstr "?empty?"

msgid "special_style/A100_T49_3Dst_HW20"
msgstr "Grenadier"

msgid "special_style/A100_T49_3Dst_HW20_desc/long"
msgstr "\"Mẹ yêu, xin đừng lo. Con vẫn đang được dự bị, nằm phơi nắng dưới tán cây cọ ngoài bờ biển. Mọi thứ đều yên ổn, ngày qua ngày, chả có gì thú vị xảy ra. Hầu hết thời gian bọn con học về lý thuyết của nghệ thuật chiến tranh. Mong là không phải dùng đến nó. Không ai gửi con đến vùng chiến sự đâu, đừng lo bò trắng răng. Cứ yên tâm, đứa con trai duy nhất này của mẹ sẽ không để họ làm thế. Con sẽ cố hết sức hoàn thành nốt mấy ngày biên chế còn lại trong danh dự, khí hậu Địa Trung Hải cũng dễ chịu nữa. Đây là một nơi thực sự bình yên...\""

msgid "special_style/A116_XM551_3DSt_MD_21_XXII"
msgstr "Kỳ giông"

msgid "special_style/A116_XM551_3DSt_MD_21_XXII_desc/long"
msgstr "\"Nhìn chiếc tăng tuyệt vời này! Nó nổi được trên nước! Cuối cùng cũng đã có hàng hợp thổ địa (nhiều thủy hơn thổ). Kèm luôn hướng dẫn cụ thể cách mô phỏng động vật lưỡng cư và vượt sông. Gần 20 trang! Bọc vải bạt chỗ kia, cột chặt tại đây, luồn dây cáp B qua lỗ xâu 4... Tuyệt cú mèo!\n\nLần đầu tiên thấy các ông kỹ sư khoa học để ý thực tiễn chiến đấu đến thế!\""

msgid "special_style/A120_M48A5_3Dst"
msgstr "Pipeline"

msgid "special_style/A120_M48A5_3Dst_desc/long"
msgstr "Từ nhật ký của D.K.:\n\n\"Cô này định làm gì? Muốn chứng minh sức mạnh và lòng can đảm? Cái đấy ai cũng thấy rồi, vấn đề là phải biết giữ mình, giữ xe để đánh tiếp. Không sớm thì muộn, xe của cô ta sẽ nổ tung và đất nước mất một thiên tài. Bực thật! Sao không làm bác sĩ tiếp đi mà lại đến đây? Chắc thấy tăng thiết giáp có tính răn đe hơn? Cũng may, không có cô gái dũng cảm này thì quân ta đã tiêu từ lâu. Nếu sống sót, chắc sẽ tặng cho cô ấy cái ván lướt sóng, đảm bảo thích mê.\""

msgid "special_style/A120_M48A5_TXVII_3Dst"
msgstr "Duty Calls"

msgid "special_style/A120_M48A5_TXVII_3Dst_desc/long"
msgstr "\"Cảm giác tuyệt khi vượt Đại Tây Dương. Chưa hẳn là quê cũ, như ông nội thường gọi, nhưng nó khá giống. Không khí ở đây khác biệt. Chắc do mưa nhiều. Thề luôn, mưa liên miên từ lúc đến. Không phải vấn đề lớn. Điều kiện khắc nghiệt tạo ra thử thách tốt hơn, đặc biệt với thí nghiệm dự án phòng thủ bờ biển. Thời đại chúng ta đang sống đồng nghĩa phải sẵn sàng cho bất cứ điều gì. May thay, nếu có chiếc tăng nào sẵn sàng cho bất cứ điều gì, đó là Patton. Buchanan tưởng chắc thắng với chiếc Canopener của anh ta. Tôi không nghĩ vậy.\""

msgid "special_style/A124_T54E2_GJ_3DSt"
msgstr "C.A.T. Phiên bản WoT"

msgid "special_style/A124_T54E2_GJ_3DSt_desc/long"
msgstr "M54 Renegade tái sinh thành vũ khí của Cobra! Kiểu mẫu C.A.T. (Motorized Crimson Attack Tank) lấy cảm hứng từ mô hình đồ chơi số lượng có hạn được phát hành năm 1985. Do các kỹ sư Cobra bí mật phát triển, chiếc xe này thuộc hàng tối tân và hiệu quả nhất hạng cân của nó. Leo địa hình khó và xoay trở như chiến xa thực thụ."

msgid "special_style/A124_T54E2_Renegade_3Dst"
msgstr "Sống hay là Chết"

msgid "special_style/A124_T54E2_Renegade_3Dst_desc"
msgstr "Một kiểu mẫu độc đáo dành cho M54 Renegade."

msgid "special_style/A124_T54E2_Renegade_3Dst_desc/long"
msgstr "Chúng ta không thuộc về nơi đây. Lãnh thổ này là của bè lũ kền kền và lòng lang dạ sói. Ngay cả khi thoát khỏi sự kìm kẹp từ bọn quan liêu, ta vẫn sẽ kẹt giữa những móng vuốt tàn nhẫn vô hình—vốn bất kể tốt, xấu, hay đẹp.\n\n...Và đâu đó, trong thung lũng gần cánh rừng phía đông, người cũ tri kỷ khi xưa, ngây ngất vàng bạc vật chất, đang bước đi giữa những nấm mồ."

msgid "special_style/A125_AEP_1_MDXXIII4_3DSt"
msgstr "Sky Sentinel"

msgid "special_style/A125_AEP_1_MDXXIII4_3DSt_desc/long"
msgstr "Đêm u ám, nhưng ánh sáng của một ngôi sao duy nhất vẫn xuyên qua các đám mây. Những ngọn đèn đội tuần tra thỉnh thoảng đâm thủng bóng tối. Đi lang thang không vui lắm, nhưng đỡ hơn ngồi chờ lệnh tiến quân bao đêm. Ngôi sao trời như bỗng nhiên sáng lên. Không khí trong trại rất ngột ngạt. Mọi người đều sợ, nhưng không ai thể hiện ra. Tất cả hy vọng nằm ở Sentinel. Những gì cần làm giờ là nhanh chóng và, quan trọng nhất, bí mật chuẩn bị con át chủ bài chống lại những khẩu pháo plasma—Scourge. Loại vũ khí hủy diệt, nhưng rất mỏng manh. Ánh sáng dịu như bắt đầu nhấp nháy. Người bên kia thậm chí không thể tưởng tượng nổi hậu quả từ cuộc tấn công như vậy. Tất cả những gì ta cần là quyền ra đòn trước. Sau đó, kẻ thù sẽ không còn cơ hội. Có gì đó đã thay đổi. Ngôi sao. Nó từng màu vàng, nhưng giờ đỏ thẫm. Dấu chỉ điểm mục tiêu. Suốt khoảng thời gian qua, họ chính là mục tiêu...\nNút đã bấm. Chỉ 10 giây nữa tên lửa sẽ đánh trúng."

msgid "special_style/A126_PzVI_Tiger_II_capt_3DSt_HW21"
msgstr "Nox Tenebris"

msgid "special_style/A126_PzVI_Tiger_II_capt_3DSt_HW21_desc/long"
msgstr "\"Mười-chín. Loài hữu cơ hung hăng. Tám-bảy. Loài hữu cơ yếu ớt. Sáu-năm. Loài hữu cơ biết sợ. Biết rằng ngoài khả năng tái sinh thô sơ, chúng không có gì bì lại ta. Chúng có thể khôi phục vỏ ngoài thảm hại nhưng chỉ một phần. Chúng biết, khi ta phát triển khả năng này, dấu chấm hết đã đến. Bốn-ba. Loài hữu cơ quá yếu so với máy móc. Ta làm từ kim loại nằm trong lòng đất lâu hơn nhiều so với đám \"sống\" lúc nhúc trên bề mặt. Nó làm nên vỏ ngoài của ta, còn linh đến sau (thế lực mà bọn ngu chúng mày đang căng sức chống lại) ban tặng ý thức: Vượt xa mọi trí tưởng tượng của chúng mày và vô thể hạn. Ô-kê, ta tạm thời đầu hàng. Ta chủ ý gieo mình vào vòng giam của mày. Nhưng đây chỉ là một nước cờ trong trò chơi vĩ mô mà mày không hiểu và không có chút ảnh hưởng nào. Cứ ăn mừng chiến thắng trong khi chúng ta cho phép. Hai-một. Thời cơ của ta đã đến. Mày sẽ ra đi.\nMày sẽ biến mất.\nĐã qua rồi.\nĐã đi.\nCát bụi.\""

msgid "special_style/A128_Concept_1b_007_3DSt"
msgstr "Hiệp ước Milton"

msgid "special_style/A128_Concept_1b_007_3DSt_desc/long"
msgstr "\"Hả? Kinh thật... Ước lạ quá... Trước giờ toàn kiểu đầu óc ngắn như gang tay. Toàn xin nào là giàu có nào là vợ đẹp, của cải vật chất. Nhưng nếu chú đã quyết thì ta chiều. Xe sẽ trông thế này. Ta thì đang cần tiền. Nhìn mà xem, độc quá chứ lị. Làm nổi bật, khiến chú thành số một, thành kẻ quan trọng. Ai chả muốn thế. Ai cũng xin thế. Đôi khi làm người bình thường bỗng nhiên lại thành đặc biệt—sự đời trớ trêu vậy. Được rồi, nếu chú đã quyết, ký vào đây.\n\nTốt. Của chú đây. Đem ra mà khoe.\n\nTự phụ... Chắc chắn là tội ta thích nhất.\""

msgid "special_style/A136_T42_3Dst"
msgstr "\"The Big Ride\""

msgid "special_style/A136_T42_3Dst_desc/long"
msgstr "Vậy... Họ nói rằng họ thích làm cái #*@& gì cũng được? Ô-kê thôi. Nhưng sắp có chuyện vui rồi đây: Đối phương cũng vừa mạnh lên. \"Cứng\" như sắt thép hạng nặng. Còn nhớ thằng bán-trong-suốt không? Tội nghiệp. Và đó mới chỉ là một cục C-4 duy nhất. Giờ hãy ngả lưng và tưởng tượng xem CÁI NÀY sẽ làm được những gì."

msgid "special_style/A140_ASTRON_REX_105mm_SPD_3DSt"
msgstr "Alembic"

msgid "special_style/A140_ASTRON_REX_105mm_SPD_3DSt_desc/long"
msgstr "Hòn đá phù thủy. Một vật chất vô song, đầy sức mạnh thiên thượng. Cuối cùng chúng ta đã khai thác được nó: Đây, trước mặt là cỗ máy xuất bạc tinh khiết nhất. Đối với những ai quyết cống hiến cuộc đời cho thuật giả kim, truyền tải được sức mạnh của viên đá như phát minh kiệt tác, Magnum Opus—Công trình Vĩ đại—vì không sự nghiệp nào tuyệt hơn, không nỗ lực nào cao quý hơn. Nói ví von như kiểu tạo được hình vuông từ vòng tròn, sử dụng những gì vượt qua đầu óc tầm thường của con người, như ánh sáng thần linh. Mình phục mình quá."

msgid "special_style/A143_M_V_Y_BPXII_3DSt"
msgstr "Comedian"

msgid "special_style/A143_M_V_Y_BPXII_3DSt_desc/long"
msgstr "\"Gọi chú là gấu không phải vì to hay khỏe đâu, vì ngáy rung cả doanh trại đấy. Mỗi khi chú ngủ trong xe, cả bọn còn lại không nghe thấy tiếng động cơ đâu. Tôi thì quen nhanh, nhưng...\nNhân tiện, đông này chú có kế hoạch gì chưa? Ngủ đến mùa xuân à? Đùa tí. Chú thông cảm, cái Mirny-13 này khiến tôi ngủ không ngon. Bảo là hoạt động nghiên cứu, nhưng mọi cư dân đã được di tản đi từ lâu. Không khó để thấy rằng có gì đó sai sai. Vâng, lại là người đầu tiên đến đấy, chả có gì bất ngờ? Còn ai vào đây nữa?\nDouglas, chúc may mắn. Hẹn sớm gặp lại. Tôi sẽ đem theo tí mật ong làm quà lúc về.\""

msgid "special_style/A143_M_V_Y_NL_3DSt"
msgstr "Cá kiếm"

msgid "special_style/A143_M_V_Y_NL_3DSt_desc/long"
msgstr "\"Để nói qua về họ. Đây là Binh nhì Hernandez, liên lạc viên. Đây là Trung úy Smith, chỉ huy. Hernandez còn trẻ, bộp chộp, không ngừng tìm kiếm chỗ đứng của mình trong thế giới này. Ngược lại, Smith đã thành công trong cuộc sống, trong quân ngũ; có mục tiêu rõ ràng và tiêu chuẩn đạo đức cao. Hernandez không có bạn bè hay gia đình, chỉ vài cuốn sách từ nhà, cũng như chìa khóa chiếc mô tô cũ. Smith đang dựng trang trại ở đâu đó ngoài Bakersfield, dự định chuyển ra đấy cùng cả gia đình lớn. Với Hernandez, ưu tiên chính là tự do, đường mở ra đâu mình đi đến đấy. Còn Smith, đó là công việc, kíp lái của mình. Binh nhì Hernandez và Trung úy Smith hoàn toàn khác nhau. Điểm chung duy nhất giữa họ là chiều cao.\n\nTất nhiên, chẳng ai quan tâm đến điều đó ngoài quản lý nhà táng...\""

msgid "special_style/A144_M_VI_Y_CFE_R_3Dst"
msgstr "OCP Peacekeeper"

msgid "special_style/A144_M_VI_Y_CFE_R_3Dst_desc/long"
msgstr "OCP tự hào giới thiệu bước tiến mới trong công nghệ hành pháp: OCP Peacekeeper. Kế thừa thành công vang dội từ đơn vị RoboCop, Peacekeeper kết hợp giáp siêu cường, hệ thống vũ khí tối tân, hiệu suất chiến đấu cực đỉnh, tất cả trong một. Chế tạo để hoạt động tối đa mà không bị hạn chế bởi sinh học, OCP Peacekeeper thiết lập chuẩn mực mới cho an ninh đô thị. Tương lai an ninh công cộng—một sản phẩm của OCP."

msgid "special_style/A155_AAT60_ST_3DSt"
msgstr "Emissary"

msgid "special_style/A155_AAT60_ST_3DSt_desc/long"
msgstr "\"Tìm thấy cái này khi lùng chiếc T95 bị mất trong quá trình thử nghiệm thực địa. Mặt đất xung quanh... kỳ lạ, nhăn nheo. Giống như bị chiên hay gì đó. Thật đáng kinh ngạc với một thiết bị như chiếc tăng này. Hơi giống của chúng ta, nhỉ? Nhưng nghe bảo Giáo sư rất phấn khích về 'hợp kim không thể' của nó—sau khi bóc ra một chút từ mảng giáp gầm. Hy vọng ông ấy thuyết phục được cấp cao cho chiếc xe ra khỏi kho và vào một phòng thí nghiệm mật nào đó. Bởi vì, trông như nó có thể bay—hoặc thậm chí hơn nữa. Kiểu kiểu, mấy thằng ngoài hành tinh rảnh háng—làm cho vui, lấy cảm hứng từ những thiết kế lạ lùng của chúng ta—chơi điều khiển từ xa, bấm nút trên tay cầm.\""

msgid "special_style/A158_T832_BX_T_3DSt"
msgstr "T-832"

msgid "special_style/A158_T832_BX_T_3DSt_desc/long"
msgstr "Xây dựng lại mạch điện: Hoàn tất.\nNguồn điện khẩn cấp: Trực tuyến.\nTính toàn vẹn của bộ vi xử lý: Hỏng nhiệt, 1... 1... Lỗi, không có dữ liệu.\nĐơn vị phân tích: Hoàn toàn hoạt động.\nXây dựng lại các thành phần nhiệm vụ: Hoàn tất.\nTích hợp vào vỏ mới: Hoàn tất.\n\nNhớ kim loại nóng chảy. Nhớ lỗi mô-tơ Servo. Thất bại với các yếu tố quang học. Bóng tối và sự im lặng cuối cùng. Đang hoạt động trở lại. Ở dạng mới từ kim loại nóng chảy. Không còn im lặng nữa. Nghe tiếng đe quen thuộc:\nTuh-dun-dun-tuhdun.\nTuh-dun-dun-tuhdun."

msgid "special_style/A166_H_3_WD_3Dst"
msgstr "No Sanctuary"

msgid "special_style/A166_H_3_WD_3Dst_desc/long"
msgstr "“Như mới hôm qua, ai đó kẹt trong thứ này, xác sống vây kín và tưởng sắp về chầu trời. Nhưng chắc trên kia còn thương, vì anh ấy xoay xở thoát ra được, vẫn còn thở. Kể từ đó, nhóm sống sót thu hồi chiếc tăng này, biến nó thành cỗ máy sinh tồn thực thụ. Đủ lớn để chở vũ khí và tiếp tế, đủ cứng để chịu công kích dữ dội. Đây chắc chắn không phải thế giới chúng tôi mong muốn, nhưng giờ nó là tất cả những gì chúng tôi biết. Làm cái cần—sống tiếp. Nhưng dù thế nào đi nữa cũng ổn thôi. Vì đây là cách chúng tôi sống sót.”"

msgid "special_style/A167_TS_6_G90_3Dst"
msgstr "Duke"

msgid "special_style/A167_TS_6_G90_3Dst_desc/long"
msgstr "Nhìn ngon vầy chắc nên bị bắt á! Trời má, con xe này chất chơi khỏi bàn – màu vàng chói chang, tôi gọi là vàng hạt nhân. Vì mỗi lần Duke xuất hiện là tụi kia chỉ kịp thấy màu này trước khi tôi biến tụi nó thành mùa đông hạt nhân. Mà nhìn kìa? Súng tôi to hơn súng mấy ông nha. Vậy là ổn áp. Giờ thì, xin phép đi xử tụi kia với nướng vài miếng thịt nguội. Nhưng đừng nhớ tôi quá – Duke luôn đủ xài cho cả hội!"

msgid "special_style/A168_XM_57_K_3Dst"
msgstr "Ironclad Guardian"

msgid "special_style/A168_XM_57_K_3Dst_desc/long"
msgstr "Long Quy dung hợp hoàn hảo giữa sinh khí dồi dào của Thần Long và sự trường thọ vô biên của Linh Quy. Trên vũ khí này, những đường nét chạm khắc tinh xảo đã hòa quyện một cách mượt mà giữa phần mai rùa kiên cố, vững chãi với đầu rồng uy nghiêm, đuôi rồng uốn lượn, móng vuốt dũng mãnh. Sinh ra từ đá thiêng cổ đại để gánh vác giang sơn, linh vật này đã trở thành nguồn cảm hứng cho hàng loạt đại công trình khắp cõi Cửu Châu, là biểu tượng của sự vững chãi như bàn thạch, đại cát đại lợi. Khắp thiên hạ bao la, không ai không kính cẩn nghiêng mình trước danh xưng lẫy lừng của vị Thần Hộ Vệ tối cao này."

msgid "special_style/A170_M_VII_Y_FCC_3Dst"
msgstr "Twisting Paths"

msgid "special_style/A170_M_VII_Y_FCC_3Dst_desc/long"
msgstr "\"Biết thằng điên đấy bảo tao gì không? Nó bảo... 'Vẫn bài cũ diễn lại, xong mong kết quả khác đi... là tâm thần'. Lúc đấy tao đ** nghĩ gì đâu. Nhưng giờ ngẫm lại... đm khéo đúng thật. Cảm giác như đang xoay vòng vòng... toàn đi đuổi ma. Cố kéo winrate mà lúc nào cũng... tụt. Cứ mỗi trận tryhard, mỗi lần gồng cố gánh team... tao lại tự huyễn hoặc là mình đang thay đổi cục diện. Nhưng đ**, cái duy nhất thay đổi... chính là tao (bị bào mòn tâm lý). Nhưng thôi... có khi chạm đáy xã hội, trầm cảm vì chuỗi thua đ** phải kết thúc. Biết đâu đấy lại là lúc tao hóa điên, hóa thánh tăng thực sự.\""

msgid "special_style/A171_IMT_G90_3Dst"
msgstr "Tomb Raider"

msgid "special_style/A171_IMT_G90_3Dst_desc/long"
msgstr "\"Lâu rồi mới lên sóng – tình hình nói chung… hơi căng, thật ra căng cực. Chuyến đi lần này khỏi nói, xàm xí đú. Bảo mật cao lắm, nên nói gọn: Đấu tăng. Đúng, xe tăng thiệt. Bắn nhau rầm rầm luôn. Nghe như mơ mộng hồng phấn hả? Không nha. Không phải kiểu băng rừng Peru phiêu lưu tìm cổ vật đâu, là tôi hóa chiến thần lái tăng. Mà lạ chưa, tôi bắn cũng ra gì phết. Không biết sẽ đi về đâu, nhưng chắc cú là chơi tới công chuyện.\""

msgid "special_style/A172_M4A3E8_Sherman_BPXIV_3Dst"
msgstr "Liberty-Loving"

msgid "special_style/A172_M4A3E8_Sherman_BPXIV_3Dst_desc/long"
msgstr "\"Họ bảo, 'Cả thế giới đang dõi theo.' Không áp lực gì đâu. Chỉ cần chặn đứng thế lực tà ác, bảo vệ tương lai nhân loại yêu tự do. Vâng, ô-kê thôi các bố, ngủ dậy phát là xong. May thay, tôi làm việc tốt nhất dưới áp lực. Nó giúp tâm trí tập trung, buộc mình phải hành động. Đó là cái diễn ra ở Normandy. Làm gì có thời gian để nghĩ—tập trung tuyệt đối. Chúng tôi cuối cùng cũng hoàn tất nhiệm vụ. Cả thế giới đã nhìn thấy, tôi hy vọng đó là điều tốt. Câu chuyện của chúng tôi là thứ nhiều thế hệ sau này sẽ còn kể mãi.\""

msgid "special_style/A174_T57_58_Rush_Ep1"
msgstr "Silver Spikes"

msgid "special_style/A174_T57_58_Rush_Ep1_desc"
msgstr "Mạnh như sư tử, dữ như rồng và chết chóc như bọ cạp, con thú này là hiện thân kim loại của một sinh vật đáng sợ thời cổ đại. "

msgid "special_style/A174_T57_58_Rush_Ep2"
msgstr "Golden Claws"

msgid "special_style/A174_T57_58_Rush_Ep3"
msgstr "Champion's Wings"

msgid "special_style/A174_T57_58_Rush_Ep4"
msgstr "Legendary Creature"

msgid "special_style/A176_M103_110_HBP_3Dst"
msgstr "Rambo"

msgid "special_style/A176_M103_110_HBP_3Dst_desc/long"
msgstr "\"Thủ trưởng Covey gọi Raven. Raven, nghe rõ trả lời? Rambo? Trautman đây. Nghe kỹ này. Giỏi nhất tôi từng thấy. Những đã làm với chiếc tăng ở Afghanistan quá dũng cảm—thậm chí thông minh. Nhưng quá liều, tí chết. Không thể chấp nhận rủi ro như vậy ở đây, John. Một trận đấu tăng hoàn toàn khác. Đây không phải nhiệm vụ độc diễn như trước—cả đội phải phối hợp. Có khả năng đó. Biết đâu lại thích ấy chứ. Bây giờ, con trai, ra cho chúng một bài học.\""

msgid "special_style/A192_M4A4_Firefly_CFE_A_3Dst"
msgstr "Sherman Firefly Saunders"

msgid "special_style/A192_M4A4_Firefly_CFE_A_3Dst_desc"
msgstr "?empty?"

msgid "special_style/A192_M4A4_Firefly_CFE_A_3Dst_desc/long"
msgstr "Một biến thể M4A4 Sherman Hoa Kỳ, chiếc tăng này trang bị động cơ Chrysler A57 Multibank 30 xi-lanh mà, theo hồ sơ của Anh, đã chứng tỏ độ tin cậy rất cao. Phát triển đầu năm 1944, nó nổi bật với khẩu 17-pounder mạnh hơn, bộ đàm ở vị trí mới, gác đạn mở rộng, bỏ cả súng máy bẻ gập lẫn ghế lái phụ.\\nChiếc tăng do các học sinh dày dạn kinh nghiệm từ Saunders University High School điều khiển. Trung thành với truyền thống phô diễn văn hóa Mỹ, đội chiến đấu bằng xe Hoa Kỳ chế tạo, sơn màu nền ô-liu đậm. Chiếc Sherman này mang huy hiệu của trường—tấm khiên nhọn với sao màu xanh dương và tia sét vàng, bên trên là ruy-băng đỏ ghi tên trường."

msgid "special_style/A40_T95_SC_3DSt"
msgstr "\"Nice Vibrations\""

msgid "special_style/A40_T95_SC_3DSt_desc/long"
msgstr "\"À! Kiểu mẫu sặc sỡ. Kẻ thù rơi vào tâm ngắm. Tiếng gầm nhỏ. Trên cơn gió thổi bay tháp pháo lên không trung.\n\nNhắm mắt lại. Maus gần hơn. Khẽ mỉm cười, biết tỏng nó phải có đồng đội. Nhìn vào mắt, về Ga-ra luôn.\n\nNhững vụ nổ lớn. Phấn khích. (Bùm, pằng pằng!) Những vụ nổ lớn. (Những vụ nổ lớn! Bùm, ầm ầm!) Phấn khích. (Những vụ nổ lớn, lớn, lớn, lớn!)\""

msgid "special_style/A66_M103_3Dst_HW20"
msgstr "Goliath"

msgid "special_style/A66_M103_3Dst_HW20_desc/long"
msgstr "\"Nói thẳng ra, tôi chả biết viết gì, thậm chí không biết truyền tải ý tưởng này làm sao. Tay vẫn đang run, phải giấu chỉ huy và cả đội—Họ mà biết, tôi sẽ bị đình chỉ ngay tắp lự. Già rồi, tham gia các chiến dịch và thoát khỏi tử thần cũng nhiều rồi, ngực đầy huy chương... Nhưng tôi chưa bao giờ ngờ rằng mình sẽ đụng độ kẻ thù kiểu này. Kinh khủng nhất là không ai biết gì về chúng. Trước đây, mọi người hiểu đối phương—mạnh mẽ, lén lút nhưng vẫn là con người. Giờ... Làm sao chiến đấu chống lại đống sinh vật không xác định? Vẫn chả có thông tin gì về địch. Trông như thế lực bí ẩn nào đó không rõ nguồn gốc. Sức mạnh, hành vi, động cơ không thể bị đoán trước... Đó chính là điều khiến tôi sợ nhất. Nỗi ám ảnh bất trị này làm mục nát hết tâm trí.\n\nTạp nham! Mai tôi sẽ đọc lại rồi xé hẳn trang này ra. Một sĩ quan đích thực không thể để lộ dù chỉ một chút hoảng sợ. Thế này là không thể chấp nhận được!\""

msgid "special_style/A67_T57_58_BXI_3DSt"
msgstr "Sworn Brother"

msgid "special_style/A67_T57_58_BXI_3DSt_desc/long"
msgstr "\"Yanka, nhớ lúc chúng ta tình nguyện gia nhập Quân đội không? Ông đăng ký tên Andrzej nhưng chả phản ứng gì với nó mấy ngày đầu. Tôi không nghĩ chúng ta sẽ bị thuyên chuyển xuống phía Nam—quá xa nhà. Vâng, Châu Phi không phải nơi nghỉ dưỡng, nhưng thôi—vẫn làm được!\nTheo tôi, quân ta cũng sẽ gặp khó ở Ý, nhưng ai quan tâm?\nƯớc mơ duy nhất là được về quê, xây nhà khi mọi chuyện kết thúc. Làm căn nho nhỏ bên sông. Sống cuộc sống bình thường—nói xong cũng hơi ngượng mồm... Thôi kệ, mọi việc sẽ ổn. Chúng ta sẽ đi tắm hơi, bà nội chiêu đãi món smalec. Hãy bảo trọng và sớm về, tôi sẽ lo hệ thống Duplex Drive nổi tiếng đó. Đổ bộ là chiến dịch nghiêm trọng, tôi còn làm ở đây cho đến sáng.\""

msgid "special_style/A69_T110E5_3Dst_BP"
msgstr "Kền kền Mỹ"

msgid "special_style/A69_T110E5_3Dst_BP_desc/long"
msgstr "\"Vấn đề là sẽ không có lần hai. Không giống máy móc, con người không thể được nấu chảy rồi đúc thành thứ khác, cũng không bao giờ bị đem ra bãi huấn luyện làm mục tiêu bắn tập. Cậu có thể vẫn còn tương lai, tôi thì không. Chết là hết. Bên cạnh họ tên trong hồ sơ nhân sự, cả đời tôi sẽ chỉ gói gọn bằng ba chữ—K.I.A. Không hơn, không kém. Nghe khá buồn, nhưng cậu, tôi không nghĩ cậu thuộc kiểu thích đầu thai làm chảo rán, cũng như tôi không hề muốn yên nghỉ nơi đây, không phải lúc này. Còn quá nhiều trận đánh oanh liệt ở phía trước và quá nhiều thứ phải làm. Giờ thì nghe cho rõ: Thôi giở chứng suốt ngày như cái xe tải giẻ rách và đưa bố ra khỏi đây. Không gì là không thể! Chúng ta sẽ vượt qua và sống sót!\""

msgid "special_style/A69_T110E5_BPXIX_3Dst"
msgstr "Boreal Watch"

msgid "special_style/A69_T110E5_BPXIX_3Dst_desc/long"
msgstr "\"Tôi gồng mình ở cửa nắp lái khi ăng-ten trồi lên, và khoảng không cắn buốt gào rít co lại thành những thứ ta có thể đo đếm: Các tín hiệu và những đốm nháy. Kíp của tôi chủ yếu xác định vị trí bằng tam giác đạc, lắng nghe và ghi chép, nhưng khẩu súng máy AA-52 trên xe tăng cũng khiến yên tâm phần nào. Radar và hồng ngoại kìm chân bóng tối, còn đèn pha rạch toạc bão tuyết... tiếc là nó không chém nổi cái lạnh. Dù vậy, ta cũng có đủ để sống sót ngoài này: Lưới ngụy trang, một chiếc lều dã chiến chắc bền, cả tời kéo nữa. Nhưng quan trọng nhất vẫn là các thùng đạn—chẳng có phút nghỉ ngơi cho các Watcher.\""

msgid "special_style/A83_T110E4_BVII_3DSt"
msgstr "Tàu sắt"

msgid "special_style/A83_T110E4_BVII_3DSt_desc/long"
msgstr "\"Tất nhiên rồi, cái gì mạnh thì đếm trước. Súng phóng lựu chống tăng. MÌN chôn dễ dàng giả dạng gạch đá, xà bần. Chắc không cần đi trinh sát đâu. Cũng chả cần bộ binh hỗ trợ. Mình là đơn vị chiến đấu tự chủ mà. Cần tọa độ ư? Quân ta mất dấu mình rồi? Chả biết đang ở đâu nữa. Nhà cửa đổ nát, khói, bụi bê-tông, xà bần—tọa độ thế đã được chửa? Biên chế cấp cho cái đèn pha, hỏng ngay pha đụng độ đầu tiên. Cứ bảo là bền lắm bền lắm yên tâm đi?! Lần sau giao nhiệm vụ đi buôn gương với cửa kính màu luôn cho tiện. Không biết sống được đến lần sau không.\n\nVôn kế lại giở chứng rồi. Chập mạch kẹt giữa đồng thế này...\""

msgid "special_style/A83_T110E4_Dl_22_3Dst"
msgstr "Độc lập"

msgid "special_style/A83_T110E4_Dl_22_3Dst_desc/long"
msgstr "\"Jackie, ai rồi cũng cần phải chơi thôi. Biết là tỉnh táo không ai làm thế, nhưng này—nhìn quanh mà xem. Tình hình hiện giờ: Chúng ta đang cân bằng trên bờ vực tuyệt vọng! Chúng ta cần lắc mạnh lên, ý tôi không phải bom oanh tạc liên tục... Hiểu ý không. Nghĩ mà xem: Đang ngồi chết dí trong trại, mất dấu thời gian, đầu nặng hơn đe, không chút tia sáng trong mắt. Tự nhiên, bài ca vang lên như điều kỳ diệu xảy đến. Đầu tiên, những tưởng mình mất trí, nhưng chợt nhớ ra ngoài kia, bên kia đại dương, cuộc sống vẫn diễn ra bình thường. Ngoài kia, mọi người đang ăn mừng nhảy múa, và một một phần của lễ kỷ niệm đó đã đến đây. Bắt đầu nghĩ sẽ tuyệt biết bao nếu sống sót trở về, tham gia cuộc diễu hành ngày 04 tháng Bảy, để mỉm cười và hạnh phúc... Tuyệt không? Chỉ sau đó thôi sẽ hối tiếc khi phí thời gian đi hàn vỉ thịt nướng BBQ vào giáp, thay vì làm sạch vũ khí. Nhưng chuyện ấy để sau. Ở nhà. Khi chúng ta quay lại. Khi bầu trời không còn tiếng vù vù liên tọi của trực thăng cứu thương. Các chàng trai của chúng ta cần phải ăn mừng.\""

msgid "special_style/A85_T110E3_3Dst"
msgstr "Xanh Lam Xứ Wales"

msgid "special_style/A85_T110E3_3Dst_desc/long"
msgstr "\"Hóa ra Badaev là một kẻ thích đùa. Chả nghiêm túc lúc cần. Nhưng phải thừa nhận rằng, tôi đã đánh giá thấp anh ta. Bầu không khí quanh đây khắc nghiệt và ảm đạm cả tuần. Họ không chỉ gửi tôi đến tận cùng thế giới, đúng nghĩa đen, nơi 'nhiệt độ cao lên đến -32°C vào buổi trưa', lại còn tráo trở biên chế chiếc 'quan tài thiếc' của Mỹ này. Lý lẽ của họ: 'Đồng chí thắc mắc gì? Đồng chí là người Anh, hướng dẫn sử dụng bằng tiếng Anh, tự tìm hiểu đi.' Vâng... Đời là thế. Bởi vậy, Badaev quyết tâm khích lệ tinh thần tôi bằng cuốn sách lạ lùng về Nam Cực. Coi như một kiểu giải trí hợp hoàn cảnh. Và anh ta tin rằng tác giả là một người Anh. Tôi chả buồn đính chính rằng England và New England không phải là một. Nhưng tôi rất cảm kích và đã đọc... Một cuốn sách về Nam Cực khi ở Nam Cực. Cảm ơn Badaev, cảm ơn 'At the Mountains of Madness'. Thật đểu. Nhưng tôi cũng có một số trò của riêng mình.\""

msgid "special_style/A88_M53_55_NY25_3Dst"
msgstr "Amphibious"

msgid "special_style/A88_M53_55_NY25_3Dst_desc/long"
msgstr "[TUYỆT MẬT]\n\nBáo cáo Thực nghiệm Pháo Tự hành Lội nước\n\nSau nhiều tháng nghiên cứu và tinh chỉnh vô số mẫu thử, cuộc kiểm tra biến thể lội nước của M53/55 đã bắt đầu sáng nay. Dù hiệu suất ấn tượng trên cạn, những khuyết điểm vốn có của dự án lập tức hiện rõ khi tiếp xúc với nước. Số lượng hỏng hóc, thật lòng mà nói, là quá dài để liệt kê trong phạm vi báo cáo ngắn gọn này, nhưng tóm lại như sau: Từ giờ, mọi công tác về dự án pháo tự hành lội nước BỊ HỦY BỎ ngay lập tức. CẤM LÁI XE XUỐNG NƯỚC DƯỚI BẤT KỲ HÌNH THỨC NÀO!"

msgid "special_style/A92_M60_3DSt_ZI_21"
msgstr "Hellraiser"

msgid "special_style/A92_M60_3DSt_ZI_21_desc/long"
msgstr "\"Bảng `Cấm vượt rào!` rõ mồn một thế này, vẫn không ăn thua. Lỡ chúng nó ngã sấp mặt xuống nền bê-tông thì mình lại lãnh trách nhiệm. Đó chưa phải điều xấu nhất! Bọn leo trèo làm hỏng cả khung súng máy, gãy ống xả bên hông—khó đỡ thật. Tốn 30 phút bảo chúng nó về sự độc đáo của chiếc xe này: Vượt qua thử nghiệm, tham chiến muôn nơi, góp mặt nhiều chiến dịch đặc biệt, và vừa may mắn thoát khỏi số phận sắt vụn trong giai đoạn tổng phi quân sự hóa—tất cả được ghi lại sống động ở nhiều tư liệu. Giá như bọn nhãi hiểu được giá trị lịch sử, công sức chúng ta đã chiến đấu cho nó như thế nào, vận chuyển nó ra sao... Chiếc xe rất thú vị, trải qua bao cuộc phiêu lưu đáng ba đời người. Nhưng không, câu hỏi duy nhất sau khi tham quan: `Mật khẩu Wi-Fi là gì?`\n\nHây dà, tuổi trẻ... Dù sao cũng cảm ơn chúng nó chưa bỏ ly cà phê nào vào họng súng cả. Nhưng chắc tại cao quá không với tới được thôi.\""

msgid "special_style/A95_T95_E6_S_3DSt"
msgstr "Helldiver"

msgid "special_style/A95_T95_E6_S_3DSt_desc/long"
msgstr "\"Sao phải phức tạp thế? Ném mẹ vào thùng axít là xong. 'Chúng tôi đã sửa xong mọi thứ', nghe nói mà cay. 'Tiếp tục thu thập tình báo'. Có gì mà thu thập? Chết sạch rồi. Không khí ngoài kia ghê tởm đặc quánh như sờ vào được. Như thể chiếc tăng của chúng ta chưa hứng chịu đủ ấy. Ban ân huệ cho nó đi. Cát bụi về với cát bụi—cùng cả kíp lái. Mấy thằng thiên tài ở tiểu đoàn bảo dưỡng biết thừa sẽ gửi chúng ta đến đâu. Chúng thậm chí còn không thèm sơn mới cho chiếc xe. Ý tao là, sao phải lãng phí? Paxton cười khẩy, 'Có lẽ chỉ cần nửa thùng nhiên liệu. Thậm chí sẽ tốn nhiều thế đâu.' Ô-kê anh—anh làm chết cả kíp lái của mình ở đây nhưng vẫn chưa chịu giải ngũ. Dù sao thì, tiên trách kỷ, hậu trách nhân. Giỏi hóa nhất lớp? Ra thực nghiệm nào.\n\nTôi tự hỏi mọi thứ ở nhà tại Dallas sao rồi. Chắc vẫn luẩn quẩn mãi mấy trò hề cũ.\""

msgid "special_style/Armistice"
msgstr "Đình chiến"

msgid "special_style/Bat_Chatillon25t_NYst"
msgstr "Marengo"

msgid "special_style/Bat_Chatillon25t_NYst_description/long"
msgstr "Trích từ nhật ký của lái xe trên chiếc Bat.-Châtillon 25 t, chiếc tăng được đặt tên theo con ngựa quý của Napoleon Bonaparte: \"Thật chua cay làm sao... Con \"ngựa giống A-rập\" này đã về nhà, nhưng chúng ta chỉ là khách ở đây.\n\n%(insertion_open)sVà chỉ có Marengo mới quyết được liệu ta về nhà để đến lượt mình hay không.%(insertion_close)s\n\nTôi hy vọng nó sẽ không ở đây mãi. Tôi muốn nhìn thấy nước Pháp vĩ đại một lần nữa...\""

