msgid "special_style/bb2021_amway_korben_award"
msgstr "Amway921/KorbenDaIlas, Phần thưởng"

msgid "special_style/bb2021_amway_korben_award_desc"
msgstr "Một kiểu mẫu mọi-mùa dựa theo màu đội của Amway921 và KorbenDaIlas. Được trao tặng cho thành tích của bạn trong sự kiện Blogger Tử chiến 2021."

msgid "special_style/bb2021_amway_korben_award_desc/long"
msgstr "Amway921 thực sự là hiện thân của sự ấm áp. Từ đánh giá đến Stream lôi cuốn và trò chuyện thân thiện với người xem, bạn có thể xem hết ở kênh tương ứng. Chưa kể, \"nùi bông\" đồng hành với Amway921 luôn khiến mọi buổi Stream rất dễ chịu.\n\nKorbenDaIlas là tác giả của nhiều hướng dẫn, đánh giá, chia sẻ thông tin giá trị về mọi xe Cấp VIII–X khả dụng trong game. À, hầu hết mới đúng. KorbenDaIlas cũng sáng lập và tiếp tục thúc đẩy nguyên tắc nghiêm khắc \"lái ở giáp gầm và bắn vòng căn cứ\". Kỹ năng tấn công âm thanh của KorbenDaIlas vẫn giữ ngôi vô địch."

msgid "special_style/bb2021_amway_korben_paid"
msgstr "Amway921/KorbenDaIlas, Tấn công"

msgid "special_style/bb2021_amway_korben_paid_desc"
msgstr "Một kiểu mẫu mọi-mùa dựa theo màu đội của Amway921 và KorbenDaIlas. Có thể mua được trong sự kiện Blogger Tử chiến 2021."

msgid "special_style/bb2021_amway_korben_paid_desc/long"
msgstr "Amway921 thực sự là hiện thân của sự ấm áp. Từ đánh giá đến Stream lôi cuốn và trò chuyện thân thiện với người xem, bạn có thể xem hết ở kênh tương ứng. Chưa kể, \"nùi bông\" đồng hành với Amway921 luôn khiến mọi buổi Stream rất dễ chịu.\n\nKorbenDaIlas là tác giả của nhiều hướng dẫn, đánh giá, chia sẻ thông tin giá trị về mọi xe Cấp VIII–X khả dụng trong game. À, hầu hết mới đúng. KorbenDaIlas cũng sáng lập và tiếp tục thúc đẩy nguyên tắc nghiêm khắc \"lái ở giáp gầm và bắn vòng căn cứ\". Kỹ năng tấn công âm thanh của KorbenDaIlas vẫn giữ ngôi vô địch."

