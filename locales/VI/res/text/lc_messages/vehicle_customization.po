msgid "special_style/battlepass_paid"
msgstr "Dấu ấn Lịch sử"

msgid "special_style/battlepass_paid_desc"
msgstr "Một kiểu mẫu mọi mùa trao thưởng cho thành tích đạt được trong Giấy phép Quân sự Mùa 1."

msgid "special_style/bb2020_aeg_award"
msgstr "AwesomeEpicGuys, phần thưởng"

msgid "special_style/bb2020_aeg_award/long"
msgstr "Một kiểu mẫu mọi mùa với tông màu đại diện cho đội AwesomeEpicGuys. Đầy vui nhộn, tinh quái và \"chua loét\". Bộ đôi Thụy Điển đáng sợ này luôn cười đùa và \"meme\" trong các buổi stream trực tiếp cũng như video của họ. Bạn sẽ bắt gặp cặp bài trùng tham gia đủ trò ở World of Tanks cùng đội quân \"dưa giấm\" trên Twitch và YouTube."

msgid "special_style/bb2020_aeg_award_desc"
msgstr "Một kiểu mẫu mọi mùa được trao tặng cho thành tích của bạn trong sự kiện game đặc biệt."

msgid "special_style/bb2020_aeg_shop"
msgstr "AwesomeEpicGuys, tấn công"

msgid "special_style/bb2020_aeg_shop/long"
msgstr "Một kiểu mẫu mọi mùa với tông màu đại diện cho đội AwesomeEpicGuys. Đầy vui nhộn, tinh quái và \"chua loét\". Bộ đôi Thụy Điển đáng sợ này luôn cười đùa và \"meme\" trong các buổi stream trực tiếp cũng như video của họ. Bạn sẽ bắt gặp cặp bài trùng tham gia đủ trò ở World of Tanks cùng đội quân \"dưa giấm\" trên Twitch và YouTube."

msgid "special_style/bb2020_aeg_shop_desc"
