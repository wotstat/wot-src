msgid "boxTooltip/description/text/bronze"
msgstr "Khi được mở, các hộp này có thể đem lại xe Premium Cấp VIII, tiền tệ trong game và nhiều phần thưởng giá trị khác cho bạn."

msgid "boxTooltip/description/text/gold"
msgstr "Khi được mở, các hộp này có thể đem lại xe Cấp X hiếm, tiền tệ trong game và nhiều phần thưởng giá trị khác cho bạn."

msgid "boxTooltip/description/text/silver"
msgstr "Khi được mở, các hộp này có thể đem lại xe Premium Cấp IX, tiền tệ trong game và nhiều phần thưởng giá trị khác cho bạn."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Có thể nhận được từ quà khi mua hàng trong Shop Premium, cũng như lúc mở các hộp thuộc bất cứ loại nào khác."

msgid "boxTooltip/howGet/text/gold"
msgstr "Có thể nhận được lúc mở các hộp thuộc bất cứ loại nào khác."

msgid "boxTooltip/howGet/text/silver"
msgstr "Có thể nhận được lúc mở các hộp thuộc bất cứ loại nào khác."

