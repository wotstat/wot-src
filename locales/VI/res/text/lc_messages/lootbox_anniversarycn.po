msgid "entryPoint/tooltip/description"
msgstr "Đây là những hộp đặc biệt chứa xe VIII—X mới và độc đáo cùng nhiều phần thưởng khác.\nBạn có thể nhận được hộp từ quà khi mua hàng trong Shop Premium, cũng như lúc mở các hộp thuộc bất cứ loại nào khác."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Hiện không thể mở hay mua Hộp vì lý do kỹ thuật. Chúng tôi rất tiếc và xin lỗi về vấn đề nhất thời này."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Hộp God's Blessing Tạm thời Bất Khả dụng"

msgid "eventName/lowerCase"
msgstr "God's Blessing"

msgid "eventName/upperCase"
msgstr "GOD'S BLESSING"

msgid "infoPage/footer/description/autoOpen"
msgstr "Nếu bạn không mở hết các hộp trước khi sự kiện kết thúc, chúng sẽ tự động được khui sau."

msgid "infoPage/footer/description/compensation"
msgstr "Nếu đã sở hữu mọi xe từ hộp rồi, bạn sẽ nhận được Chosen Lootbox làm Phần thưởng Chắc chắn hoặc thay cho xe xuất hiện."

msgid "infoPage/footer/description/guaranteed"
msgstr "Mỗi %(guaranteed0)s Celestial, %(guaranteed1)s Heaven Help và %(guaranteed2)s Chosen Lootbox chắc chắn đem lại một xe Cấp VIII—X. Nếu mở chúng mà không xuất hiện chiếc nào như thế, bạn sẽ ẵm về một chiếc Cấp VIII—X chưa sở hữu khi khui hộp thứ %(guaranteed0)s/%(guaranteed1)s/%(guaranteed2)s (tương ứng theo loại hộp). Lúc điều đó xảy ra, bộ đếm sẽ tính lại từ đầu."

msgid "infoPage/footer/title/compensation"
msgstr "Nếu Đã Nhận Tất Cả Xe"

msgid "infoPage/header/description"
msgstr "Mở các hộp để có cơ hội nhận đồ giá trị trong game!\nXem danh sách phần thưởng khả dĩ dưới đây."

msgid "noBoxesView/description/"
msgstr "Không có hộp nào.\nBạn có thể sở hữu chúng từ Shop Premium."

