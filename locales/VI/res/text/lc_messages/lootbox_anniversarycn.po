msgid "#PluralForms"
msgstr "nplurals=1; plural=0;"

msgid "boxTooltip/description/text/bronze"
msgstr "Khi được mở, các hộp này có thể đem lại xe tăng, tiền tệ game và nhiều quà khác đầy giá trị cho bạn."

msgid "boxTooltip/description/text/gold"
msgstr "Khi được mở, các hộp này có thể đem lại xe tăng, tiền tệ game, tùy biến và nhiều quà khác đầy giá trị cho bạn."

msgid "boxTooltip/description/text/silver"
msgstr "Khi được mở, các hộp này có thể đem lại xe tăng, tiền tệ game, tùy biến và nhiều quà khác đầy giá trị cho bạn."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Có thể nhận từ Cửa hàng trong game và khi mở các hộp thuộc bất kỳ loại nào khác."

msgid "boxTooltip/howGet/text/gold"
msgstr "Có thể nhận được lúc mở các hộp thuộc bất cứ loại nào khác."

msgid "boxTooltip/howGet/text/silver"
msgstr "Có thể nhận được lúc mở các hộp thuộc bất cứ loại nào khác."

