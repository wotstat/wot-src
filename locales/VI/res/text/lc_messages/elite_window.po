msgid "elite_window/buttons/ok"
msgstr "Đã rõ!"

msgid "elite_window/buttons/post_progression"
msgstr "Đến Biến thể"

msgid "elite_window/buttons/vanity_progression"
msgstr "Đến Phần thưởng Elite"

msgid "elite_window/elite/description"
msgstr "Trạng thái \"Elite\" được gán cho xe đã nghiên cứu tất cả mô-đun, Nâng cấp và nhánh kỹ thuật khả dụng, gồm cả các phương tiện cấp trước. XP Chiến đấu thu về trên xe Elite có thể quy đổi sang XP Tự do bằng cách sử dụng vàng, hoặc dùng Tăng tốc Huấn luyện Kíp lái."

msgid "elite_window/elite/title"
msgstr "Trạng thái \"Elite\""

msgid "elite_window/post_progression/description"
msgstr "Biến thể Dã chiến bắt đầu khả dụng"

msgid "elite_window/prestige/description"
msgstr "Lúc đạt trạng thái \"Elite\", xe bắt đầu tích lũy Điểm Uy tín và nhận Cấp Uy tín nhằm thể hiện \"độ chuyên\" của bạn đối với một phương tiện cụ thể. Quân hàm tương ứng sẽ bắt đầu xuất hiện trong trận sau khi nhận Cấp Uy tín đầu tiên."

msgid "elite_window/prestige/title"
msgstr "Hệ thống Uy tín"

msgid "elite_window/title"
msgstr "ĐÃ ĐẠT TRẠNG THÁI \"ELITE\""

msgid "elite_window/vanity_progression/description"
msgstr "Nhận thưởng đặc biệt cho xe Cấp XI gồm kiểu mẫu có chiều sâu độc đáo, Stat Tracker và ống bọc nòng Gun Sleeve!"

msgid "elite_window/vanity_progression/title"
msgstr "Hệ thống Phần thưởng Elite giờ đã khả dụng"
