msgid "mode/halloween/battlePassTooltip/body"
msgstr "Vài nhiệm vụ nhất định trong sự kiện {whiteSpanish_open}Babylon: Dark Tower{whiteSpanish_close} sẽ cho phép bạn kiếm Điểm Giấy phép Quân sự."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Điểm Giấy phép Quân sự"

msgid "mode/halloween/calendar"
msgstr "Sự kiện sẽ kéo dài %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Sự kiện sẽ kết thúc vào %(date)s."

msgid "mode/halloween/description"
msgstr "Đánh và thu thập Vật chất.\nChiến trận bằng xe đặc biệt."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Hiệu suất máy tính của bạn không đủ mạnh cho chế độ này. Bạn có thể gặp vấn đề với đồ họa và chuyển động xe. Client trò chơi cũng có khả năng gặp sự cố."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Hiệu suất Thấp"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Hiệu suất Thấp"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Chế độ này yêu cầu hiệu suất máy tính cao.\nBạn sẽ gặp vấn đề với quá trình tải bản đồ, đồ họa và chuyển động xe. Nếu hiệu suất không đủ mạnh, hãy thử giảm chất lượng đồ họa trong mục Thiết lập."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Hiệu suất bị Giảm"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Hiệu suất bị Giảm"
