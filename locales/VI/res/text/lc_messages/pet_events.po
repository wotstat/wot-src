msgid "joke/event_1"
msgstr "Nếu con chó bỗng phát sáng, hãy báo y tế. Hoặc không. Đây không phải lời tư vấn."

msgid "joke/event_10"
msgstr "Con chó đã vượt qua lớp học bơi với thành tích xuất sắc. Còn người lính? Không được vậy."

msgid "joke/event_11"
msgstr "Đó là cuộc thu hồi chiến thuật... đồ ăn vặt."

msgid "joke/event_12"
msgstr "Ai cần thuốc đuổi rắn khi đã có cái đuôi vẫy và tiếng sủa khiến chúng bỏ chạy?"

msgid "joke/event_13"
msgstr "Gom đồ linh tinh? Không hề, phải gọi là tuyển chọn vật phẩm nâng cao tinh thần thì đúng hơn!"

msgid "joke/event_14"
msgstr "Chúng tôi không biết nó chạy bằng gì, nhưng đoán là bóng tennis và hỗn loạn."

msgid "joke/event_15"
msgstr "Quên máy dò mìn đi, đôi khi tất cả những gì bạn cần chỉ là đôi mắt tinh anh và cái đuôi vẫy đầy cảnh giác."

msgid "joke/event_16"
msgstr "Chú chó của bạn đã chính thức trở thành trinh sát lương thực đáng tin cậy nhất cả đội."

msgid "joke/event_17"
msgstr "Chẳng ai biết nó từ đâu ra, nhưng tinh thần thì lên cao còn nguồn cung phô mai sụt giảm."

msgid "joke/event_18"
msgstr "Thông điệp cuối cùng? \"Sủa một tiếng báo nguy, hai tiếng để nạp đạn.\""

msgid "joke/event_19"
msgstr "Không phải xâm nhập trái phép. Chỉ lạc đường trầm trọng. Và có vũ khí."

msgid "joke/event_2"
msgstr "Có vẻ như cuối cùng cũng có người tìm ra bí quyết để đẩy nhanh thủ tục hành chính—bốn cái chân, không hỏi nhiều."

msgid "joke/event_20"
msgstr "Quên cảm biến đi—thay vào đó đặt một con chó cạnh mỗi đường ống."

msgid "joke/event_21"
msgstr "Biết là nghiêm trọng rồi khi một con chó còn có chuỗi cung ứng tốt hơn đội hậu cần."

msgid "joke/event_22"
msgstr "Ngay cả những thợ máy hàng đầu cũng không đưa cái cờ lê nhanh đến thế."

msgid "joke/event_23"
msgstr "Khi thiên tai ập đến, điều động đội chó cứu hộ."

msgid "joke/event_24"
msgstr "Thành viên kíp lái duy nhất chính thức đủ tiêu chuẩn vừa \"sẵn sàng chiến đấu\" vừa là \"một chú cún rất ngoan.\""

msgid "joke/event_25"
msgstr "Này, nếu đồ chơi bắt đầu tự di chuyển… thì đến ca trực rồi."

msgid "joke/event_26"
msgstr "Đạn thật trong huấn luyện? May mà con chó của bạn kiểm tra lại."

msgid "joke/event_27"
msgstr "Tân binh của tháng: Bốn chân, không xẻng, nhiều đất."

msgid "joke/event_28"
msgstr "Gọi một con chó là “đầu bếp” thì hơi khiên cưỡng, nhưng cái đuôi làm dụng cụ khuấy tuyệt vời."

msgid "joke/event_29"
msgstr "Bác sĩ dặn: Hai liều thuốc và một em cún ngoan mỗi phòng."

msgid "joke/event_3"
msgstr "Không bằng lái xe nâng, nhưng vẫn đầy động lực."

msgid "joke/event_30"
msgstr "Lau sàn? Xong. Lau bụi? Xong. Rụng lông? Xong gấp đôi. Duyệt dọn nhà!"

msgid "joke/event_4"
msgstr "Chó nhà bạn hoặc là đã phát hiện một kho đồ bí mật… hoặc là quyết định mở hẳn Ga-ra mới."

msgid "joke/event_5"
msgstr "Hóa ra, công thức hiệu quả nhất để giải tán đám đông là cá lên men cộng với bốn chân."

msgid "joke/event_6"
msgstr "Một con chó và một con mèo hợp tác với nhau? Chắc tận thế đến sớm hơn dự kiến."

msgid "joke/event_7"
msgstr "Nếu chú chó của bạn bắt đầu trông chừng phụ tùng, đừng lo — nó chỉ đang muốn thăng chức lên thợ máy tập sự thôi."

msgid "joke/event_8"
msgstr "Chó tru dưới trăng? Chó sói."

msgid "joke/event_9"
msgstr "Diễn tập hỏa hoạn cứu người. Chó cứu cả team."

msgid "rewards/synergy_value"
msgstr "+"

msgid "rewards/title"
msgstr "Thất lạc, nhưng chưa mất:"

msgid "submit"
msgstr "Rõ!"

msgid "text/event_1"
msgstr "Một {{@ style (color $color)}}người lạ{{/}} mặc {{@ style (color $color)}}bộ vest trang trọng{{/}}{{@ style (color $color)}}{{/}} tiến lại gần. \"Con {{@ style (color $color)}}chó{{/}} đã hỗ trợ {{@ style (color $color)}}tìm kiếm{{/}} và {{@ style (color $color)}}kiểm soát{{/}} một {{@ style (color $color)}}vật thể {{/}}{{@ style (color $color)}}nguy hiểm{{@ style (color $defaultColor)}}. {{/}}{{/}}Dữ liệu về sự cố này sẽ bị {{@ style (color $color)}}xóa{{/}} khỏi tất cả {{@ style (color $color)}}nhật ký{{@ style (color $defaultColor)}}. {{/}}{{/}}Cảm ơn.\" Người đàn ông đưa cho bạn một {{@ style (color $color)}}gói hàng{{/}} và rời khỏi {{@ style (color $color)}}Ga-ra{{/}}."

msgid "text/event_10"
msgstr "Trong đợt {{@ style (color $color)}}diễn tập {{/}}{{@ style (color $color)}}chiến đấu{{/}} trên {{@ style (color $color)}}mặt nước{{/}}, một {{@ style (color $color)}}người lính{{/}} bị {{@ style (color $color)}}vướng{{/}} vào {{@ style (color $color)}}dây {{/}}{{@ style (color $color)}}neo{{/}} và {{@ style (color $color)}}rơi {{/}}{{@ style (color $color)}}xuống{{@ style (color $defaultColor)}}. {{/}}{{/}}May thay, con {{@ style (color $color)}}chó{{/}} ở gần và kịp {{@ style (color $color)}}kéo{{/}} {{@ style (color $color)}}người {{/}}{{@ style (color $color)}}đuối nước{{/}} vào nơi {{@ style (color $color)}}an toàn{{@ style (color $defaultColor)}}. {{/}}{{/}}Câu chuyện nhanh chóng trở thành biểu tượng của {{@ style (color $color)}}lòng dũng cảm{{/}} khắp {{@ style (color $color)}}đơn vị{{/}}."

msgid "text/event_11"
msgstr "Bạn thấy {{@ style (color $color)}}con chó{{/}} của mình chạy khỏi {{@ style (color $color)}}nhà kho{{/}} với {{@ style (color $color)}}một cái {{/}}{{@ style (color $color)}}túi {{/}}{{@ style (color $color)}}nhỏ {{/}}trong {{@ style (color $color)}}miệng{{@ style (color $defaultColor)}}. {{/}}{{/}}Khi chuẩn bị {{@ style (color $color)}}mắng{{/}} nó vì {{@ style (color $color)}}lấy trộm {{/}}{{@ style (color $color)}}vật tư{{/}}, {{@ style (color $color)}}người {{/}}{{@ style (color $color)}}trông {{/}}{{@ style (color $color)}}coi{{/}} khúc khích cười. \"Tôi không thể bắt tội một chú {{@ style (color $color)}}cún{{/}} ngoan như thế.\" Có lẽ {{@ style (color $color)}}huấn luyện{{/}} thêm về {{@ style (color $color)}}cách {{/}}{{@ style (color $color)}}cư xử{{/}} cũng chẳng hại gì."

msgid "text/event_12"
msgstr "Trong một {{@ style (color $color)}}cuộc kiểm tra {{/}}{{@ style (color $color)}}định kỳ{{/}}, các {{@ style (color $color)}}binh sĩ{{/}} phát hiện {{@ style (color $color)}}ổ {{/}}{{@ style (color $color)}}rắn{{/}} gần {{@ style (color $color)}}doanh trại{{@ style (color $defaultColor)}}. {{/}}{{/}}Lúc họ bàn bạc cách {{@ style (color $color)}}xử lý{{/}}, chú {{@ style (color $color)}}chó{{/}} trung thành của bạn đã xua đuổi lũ {{@ style (color $color)}}bò sát{{/}} bằng {{@ style (color $color)}}tiếng sủa{{/}} và {{@ style (color $color)}}những cú vồ dũng mãnh{{@ style (color $defaultColor)}}. {{/}}{{/}}Đến {{@ style (color $color)}}tối{{/}}, {{@ style (color $color)}}khu vực{{/}} đã {{@ style (color $color)}}an toàn{{/}} trở lại. {{@ style (color $color)}}Lòng dũng cảm từ con chó{{/}} của bạn chắc chắn sẽ được {{@ style (color $color)}}thưởng{{/}}."

msgid "text/event_13"
msgstr "Bạn nhận thấy {{@ style (color $color)}}con chó{{/}} của mình thỉnh thoảng lại {{@ style (color $color)}}chạy {{/}}{{@ style (color $color)}}đi{{/}} đâu đó vào {{@ style (color $color)}}buổi sáng{{@ style (color $defaultColor)}}. {{/}}{{/}}Hóa ra một số {{@ style (color $color)}}phi công{{/}} có truyền thống {{@ style (color $color)}}vuốt ve{{/}} {{@ style (color $color)}}chú cún{{/}} để {{@ style (color $color)}}lấy {{/}}{{@ style (color $color)}}may{{/}} trước khi {{@ style (color $color)}}cất cánh{{@ style (color $defaultColor)}}. {{/}}{{/}}Vì tò mò, bạn {{@ style (color $color)}}đi theo{{/}} {{@ style (color $color)}}cái đuôi {{/}}{{@ style (color $color)}}hay {{/}}{{@ style (color $color)}}vẫy{{/}}, phát hiện {{@ style (color $color)}}kho {{/}}{{@ style (color $color)}}bí mật{{/}}—một {{@ style (color $color)}}chiếc {{/}}{{@ style (color $color)}}rương {{/}}{{@ style (color $color)}}nhỏ{{/}} chứa đầy {{@ style (color $color)}}nắp {{/}}{{@ style (color $color)}}chai{{/}}, {{@ style (color $color)}}cúc áo{{/}} và {{@ style (color $color)}}tất {{/}}{{@ style (color $color)}}bị gặm {{/}}{{@ style (color $color)}}nát{{/}}."

msgid "text/event_14"
msgstr "Con {{@ style (color $color)}}chó{{/}} của bạn tìm thấy một {{@ style (color $color)}}thiết bị {{/}}{{@ style (color $color)}}lạ{{/}} trong {{@ style (color $color)}}nhà để xe {{/}}{{@ style (color $color)}}cũ{{@ style (color $defaultColor)}}. {{/}}{{/}}Sau khi {{@ style (color $color)}}bật {{/}}{{@ style (color $color)}}lên{{@ style (color $defaultColor)}}, {{/}}{{/}}{{@ style (color $color)}}thiết bị{{/}} bắt đầu {{@ style (color $color)}}xử lý{{/}} các món {{@ style (color $color)}}đồ chơi{{/}} bên trong, tạo {{@ style (color $color)}}vật phẩm {{/}}{{@ style (color $color)}}mới{{@ style (color $defaultColor)}} hoàn toàn. {{/}}{{/}}Trong suốt {{@ style (color $color)}}quá trình {{/}}{{@ style (color $color)}}biến đổi{{/}}, bạn lấy được vài {{@ style (color $color)}}vật phẩm {{/}}{{@ style (color $color)}}hữu ích{{/}}."

msgid "text/event_15"
msgstr "Trong {{@ style (color $color)}}diễn tập{{/}} tại {{@ style (color $color)}}bãi {{/}}{{@ style (color $color)}}huấn luyện{{/}}, một số {{@ style (color $color)}}xe tăng{{/}} tiến vào cánh đồng đầy {{@ style (color $color)}}mìn {{/}}{{@ style (color $color)}}giả{{@ style (color $defaultColor)}}. {{/}}{{/}}Con {{@ style (color $color)}}chó{{/}} của bạn lao lên phía trước, {{@ style (color $color)}}thu hút {{/}}{{@ style (color $color)}}sự chú ý{{/}} và giúp các {{@ style (color $color)}}kíp xe{{/}}{{@ style (color $color)}} {{/}}{{@ style (color $color)}}kịp thời {{/}}{{@ style (color $color)}}nhận ra mối {{/}}{{@ style (color $color)}}nguy hiểm{{/}}. Nhờ {{@ style (color $color)}}phản ứng {{/}}{{@ style (color $color)}}nhanh{{/}} từ thú cưng của bạn, các {{@ style (color $color)}}xe tăng{{/}} đã {{@ style (color $color)}}tập hợp lại {{/}} và xử lý {{@ style (color $color)}}chướng ngại vật{{/}} một cách an toàn. Dù kết quả ra sao, {{@ style (color $color)}}phần thưởng{{/}} cho sự {{@ style (color $color)}}dũng cảm{{/}} như vậy là điều chắc chắn."

msgid "text/event_16"
msgstr "Trong lúc {{@ style (color $color)}}khám phá{{/}} {{@ style (color $color)}}Ga-ra{{/}}, {{@ style (color $color)}}con chó{{/}} của bạn đánh hơi thấy một {{@ style (color $color)}}kho{{/}} {{@ style (color $color)}}khẩu phần cũ{{/}} được giấu sau vài {{@ style (color $color)}}thùng gỗ{{@ style (color $defaultColor)}}. {{/}}{{/}}Những {{@ style (color $color)}}người lính{{/}} cười phá lên trước {{@ style (color $color)}}{{@ style (color $defaultColor)}}\"{{/}}kho báu{{@ style (color $defaultColor)}}\"{{/}}{{/}} và bàn giao cho {{@ style (color $color)}}sĩ quan quân nhu{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Con chó{{/}} của bạn được hứa hẹn {{@ style (color $color)}}phần thưởng{{/}} cho {{@ style (color $color)}}phát hiện {{/}}{{@ style (color $color)}}bất ngờ{{/}} đó."

msgid "text/event_17"
msgstr "Bạn nghe {{@ style (color $color)}}tiếng ồn{{/}} phát ra từ {{@ style (color $color)}}doanh trại{{@ style (color $defaultColor)}}. {{/}}{{/}}Khi lại gần, thấy {{@ style (color $color)}}binh lính{{/}} tụ tập xung quanh, đang xem {{@ style (color $color)}}con chó{{/}} của bạn {{@ style (color $color)}}đánh nhau{{/}} với một {{@ style (color $color)}}con chuột{{/}}{{@ style (color $color)}} lực lưỡng{{/}}{{@ style (color $color)}} khổng lồ{{@ style (color $defaultColor)}}. {{/}}{{/}}Có lúc, mọi người {{@ style (color $color)}}bị phân tâm{{/}} bởi {{@ style (color $color)}}thông báo{{/}}—khi quay lại, {{@ style (color $color)}}con gặm nhấm {{/}}{{@ style (color $color)}}kỳ quái{{/}} đã {{@ style (color $color)}}biến mất{{@ style (color $defaultColor)}}. {{/}}{{/}}Để tỏ lòng biết ơn {{@ style (color $color)}}màn trình diễn {{/}}{{@ style (color $color)}}giải trí{{/}} như vậy, {{@ style (color $color)}}binh lính{{/}} đã tặng {{@ style (color $color)}}con chó{{/}} của bạn vài {{@ style (color $color)}}vật dụng {{/}}{{@ style (color $color)}}hữu ích{{/}}."

msgid "text/event_18"
msgstr "Trong lúc {{@ style (color $color)}}khám phá{{/}} {{@ style (color $color)}}hội trường {{/}}{{@ style (color $color)}}chỉ huy {{/}}{{@ style (color $color)}}cũ{{/}}, con {{@ style (color $color)}}chó{{/}} của bạn bắt đầu {{@ style (color $color)}}sủa{{/}} vào một {{@ style (color $color)}}bức chân dung phủ bụi{{@ style (color $defaultColor)}}. {{/}}{{/}}Sau chút {{@ style (color $color)}}phủi {{/}}{{@ style (color $color)}}bụi{{/}}, {{@ style (color $color)}}tờ ghi chú{{/}} rơi xuống từ phía sau {{@ style (color $color)}}khung tranh{{/}}.{{br}}Trong đó nói về {{@ style (color $color)}}đơn vị xe tăng {{/}}{{@ style (color $color)}}bị lãng quên{{/}} đã {{@ style (color $color)}}biến mất{{/}} trong lúc {{@ style (color $color)}}diễn tập {{/}}{{@ style (color $color)}}ban đêm{{/}}—{{@ style (color $color)}}hiệu {{/}}{{@ style (color $color)}}gọi{{/}} {{@ style (color $color)}}của họ{{/}} là {{@ style (color $color)}}Iron {{/}}{{@ style (color $color)}}Paw{{/}}."

msgid "text/event_19"
msgstr "Trong lần {{@ style (color $color)}}tuần tra{{/}} khác quanh {{@ style (color $color)}}lãnh thổ{{/}}, {{@ style (color $color)}}con chó{{/}} của bạn đột nhiên {{@ style (color $color)}}lao{{/}} vào {{@ style (color $color)}}bụi rậm{{/}} và {{@ style (color $color)}}xua {{/}}{{@ style (color $color)}}ra{{/}} một {{@ style (color $color)}}kẻ lạ mặt{{@ style (color $defaultColor)}} đang ẩn nấp. {{/}}{{/}}Đội {{@ style (color $color)}}tuần tra{{/}} đã {{@ style (color $color)}}tạm giữ{{/}} {{@ style (color $color)}}kẻ xâm nhập{{/}}, {{@ style (color $color)}}vụ việc{{/}} được {{@ style (color $color)}}ghi lại{{/}} để tiếp tục {{@ style (color $color)}}điều tra{{/}}."

msgid "text/event_2"
msgstr "Con {{@ style (color $color)}}chó{{/}} chạy về phía bạn, vẫy {{@ style (color $color)}}đuôi{{@ style (color $defaultColor)}}. {{/}}{{/}}Một xấp {{@ style (color $color)}}giấy tờ{{/}} ngậm chặt trong {{@ style (color $color)}}hàm răng{{@ style (color $defaultColor)}} của nó. {{/}}{{/}}Thoạt nhìn, chúng trông giống mọi {{@ style (color $color)}}báo cáo{{/}}, {{@ style (color $color)}}bảng biểu{{/}} và {{@ style (color $color)}}tài liệu{{@ style (color $defaultColor)}} khác. {{/}}{{/}}Mọi người ở {{@ style (color $color)}}văn {{/}}{{@ style (color $color)}}phòng{{/}} có lẽ sẽ vui mừng nhận lại."

msgid "text/event_20"
msgstr "Trong khi {{@ style (color $color)}}đi bộ{{/}} quanh {{@ style (color $color)}}khu vực{{/}}, con {{@ style (color $color)}}chó{{/}} của bạn đột nhiên bắt đầu {{@ style (color $color)}}sủa{{/}} về phía một trong những {{@ style (color $color)}}đường ống nước{{@ style (color $defaultColor)}}. {{/}}{{/}}Sau khi {{@ style (color $color)}}kỹ thuật viên{{/}} {{@ style (color $color)}}kiểm tra{{/}} {{@ style (color $color)}}cơ sở{{/}}, họ phát hiện {{@ style (color $color)}}lỗi{{/}} có thể dẫn đến {{@ style (color $color)}}sự cố {{/}}{{@ style (color $color)}}hệ thống{{/}} nghiêm trọng."

msgid "text/event_21"
msgstr "Con {{@ style (color $color)}}chó{{/}} mang cho bạn một chiếc {{@ style (color $color)}}túi{{/}} đầy đủ mọi loại {{@ style (color $color)}}đồ vật {{/}}{{@ style (color $color)}}kỳ lạ {{/}}{{@ style (color $color)}}mà hữu ích{{@ style (color $defaultColor)}}. {{/}}{{/}}Dù đã cố hết sức, bạn vẫn không thể {{@ style (color $color)}}tìm ra{{/}} nguồn gốc {{@ style (color $color)}}đến từ{{/}} đâu{{@ style (color $color)}}{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Người bạn {{/}}{{@ style (color $color)}}bốn {{/}}{{@ style (color $color)}}chân{{/}} chỉ ngồi gần đó, trông {{@ style (color $color)}}đắc ý{{/}} và hoàn toàn {{@ style (color $color)}}mãn nguyện{{/}} suốt phần còn lại của {{@ style (color $color)}}hôm đó{{/}}."

msgid "text/event_22"
msgstr "Những {{@ style (color $color)}}thợ máy{{/}} đã {{@ style (color $color)}}dạy{{/}} được {{@ style (color $color)}}con chó{{/}} của bạn cách {{@ style (color $color)}}lấy{{/}} và {{@ style (color $color)}}nhận diện {{/}}{{@ style (color $color)}}dụng cụ{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Chú chó {{/}}{{@ style (color $color)}}phi thường{{/}} đã dành cả {{@ style (color $color)}}ngày{{/}} {{@ style (color $color)}}làm việc {{/}}{{@ style (color $color)}}cùng{{/}} họ, tự tin {{@ style (color $color)}}mang{{/}} đúng {{@ style (color $color)}}đồ nghề{{/}} như {{@ style (color $color)}}thành {{/}}{{@ style (color $color)}}viên{{/}} kỳ cựu."

msgid "text/event_23"
msgstr "Một {{@ style (color $color)}}cây {{/}}{{@ style (color $color)}}khô{{/}} đổ đè lên {{@ style (color $color)}}lính gác{{/}} trong một {{@ style (color $color)}}cuộc tuần tra{{@ style (color $defaultColor)}}. {{/}}{{/}}Con {{@ style (color $color)}}chó{{/}} của bạn không chỉ {{@ style (color $color)}}chạy {{/}}{{@ style (color $color)}}đi {{/}}{{@ style (color $color)}}cầu cứu{{/}} mà còn {{@ style (color $color)}}giúp {{/}}{{@ style (color $color)}}kéo{{/}} {{@ style (color $color)}}người {{/}}{{@ style (color $color)}}bị thương{{/}} ra khỏi {{@ style (color $color)}}thân cây{{@ style (color $defaultColor)}}. {{/}}{{/}}Câu {{@ style (color $color)}}chuyện{{/}} này {{@ style (color $color)}}nhanh {{/}}{{@ style (color $color)}}chóng {{/}}{{@ style (color $color)}}lan truyền{{/}} trong các {{@ style (color $color)}}đội {{/}}{{@ style (color $color)}}tuần tra{{/}}."

msgid "text/event_24"
msgstr "Con {{@ style (color $color)}}chó{{/}} của bạn đã tham dự {{@ style (color $color)}}lễ {{/}}{{@ style (color $color)}}trao giải{{/}} dành cho những {{@ style (color $color)}}lính tăng dày dạn kinh nghiệm nhất{{@ style (color $defaultColor)}}. {{/}}{{/}}Chú {{@ style (color $color)}}chó{{/}} tận tụy đã làm {{@ style (color $color)}}trợ lý{{/}}, trao {{@ style (color $color)}}huy chương{{/}} và {{@ style (color $color)}}quà{{/}} cho {{@ style (color $color)}}người dẫn chương trình{{@ style (color $defaultColor)}}. {{/}}{{/}}Sự {{@ style (color $color)}}đóng góp{{/}} này không bị {{@ style (color $color)}}bỏ qua{{/}}—mang lại cho {{@ style (color $color)}}chú cún{{/}} một {{@ style (color $color)}}phần thưởng{{/}} xứng đáng."

msgid "text/event_25"
msgstr "{{@ style (color $color)}}Con chó{{/}} của bạn trở về {{@ style (color $color)}}căn cứ{{/}}, mang theo một {{@ style (color $color)}}con cáo {{/}}{{@ style (color $color)}}nhồi bông {{/}}{{@ style (color $color)}}bị {{/}}{{@ style (color $color)}}rách. {{/}}Vài {{@ style (color $color)}}binh sĩ{{/}} cho biết họ đã nghe thấy {{@ style (color $color)}}tiếng thì thầm{{/}} trong {{@ style (color $color)}}khu rừng{{/}} ngay trước đấy.{{br}}Sau đó vào {{@ style (color $color)}}buổi tối{{/}} hôm ấy, một người trong số họ đã {{@ style (color $color)}}nhận ra{{/}} món {{@ style (color $color)}}đồ chơi{{/}}—nó trùng khớp với {{@ style (color $color)}}phù hiệu {{/}}{{@ style (color $color)}}cáo{{/}} của một {{@ style (color $color)}}đơn vị {{/}}{{@ style (color $color)}}trinh sát {{/}}{{@ style (color $color)}}đã giải thể{{/}} từ lâu, {{@ style (color $color)}}biến mất {{/}}nhiều năm trước trong các cuộc {{@ style (color $color)}}diễn tập {{/}}{{@ style (color $color)}}mùa đông{{@ style (color $defaultColor)}}. {{/}}{{/}}Không còn {{@ style (color $color)}}hồ sơ{{/}} nào về họ."

msgid "text/event_26"
msgstr "Trong lúc {{@ style (color $color)}}phân phát {{/}}{{@ style (color $color)}}vật tư{{/}} {{@ style (color $color)}}cho {{/}}{{@ style (color $color)}}huấn luyện {{/}}{{@ style (color $color)}}dã chiến{{/}}, {{@ style (color $color)}}con chó{{/}} của bạn bắt đầu {{@ style (color $color)}}sủa {{/}}{{@ style (color $color)}}dữ dội{{@ style (color $defaultColor)}}. {{/}}{{/}}Hốt hoảng, {{@ style (color $color)}}sĩ quan{{/}} đã {{@ style (color $color)}}kiểm tra{{/}} {{@ style (color $color)}}các thùng{{/}} và phát hiện {{@ style (color $color)}}vài trang bị{{/}} là {{@ style (color $color)}}thật{{/}}, {{@ style (color $color)}}bị {{/}}{{@ style (color $color)}}lẫn {{/}}{{@ style (color $color)}}nhầm vào {{/}}{{@ style (color $color)}}lô thử nghiệm{{/}}."

msgid "text/event_27"
msgstr "Trong đợt {{@ style (color $color)}}huấn luyện {{/}}{{@ style (color $color)}}quân sự{{/}}, {{@ style (color $color)}}thú cưng{{/}} của bạn trở nên say mê {{@ style (color $color)}}đào {{/}}{{@ style (color $color)}}hào{{@ style (color $defaultColor)}}. {{/}}{{/}}Niềm {{@ style (color $color)}}say mê{{/}} này nhanh chóng {{@ style (color $color)}}lan sang{{/}} các {{@ style (color $color)}}tân binh{{/}}, những người bắt đầu {{@ style (color $color)}}thi đua{{/}} với con {{@ style (color $color)}}chó{{/}} về {{@ style (color $color)}}tốc độ{{/}} và {{@ style (color $color)}}độ sâu{{/}}—khiến {{@ style (color $color)}}sĩ quan huấn luyện{{/}} {{@ style (color $color)}}thích thú{{/}}."

msgid "text/event_28"
msgstr "Hôm nay là {{@ style (color $color)}}ngày {{/}}{{@ style (color $color)}}tự {{/}}{{@ style (color $color)}}nấu ăn{{/}} tại {{@ style (color $color)}}doanh trại{{/}}, các {{@ style (color $color)}}binh sĩ{{/}} được phép {{@ style (color $color)}}chế biến {{/}}{{@ style (color $color)}}món {{/}}{{@ style (color $color)}}địa phương{{/}} từ {{@ style (color $color)}}nguyên liệu sẵn có{{@ style (color $defaultColor)}}. {{/}}{{/}}Chú {{@ style (color $color)}}chó{{/}} của bạn đã dành suốt {{@ style (color $color)}}ngày{{/}} {{@ style (color $color)}}chạy{{/}} {{@ style (color $color)}}qua lại {{/}}giữa {{@ style (color $color)}}các trạm{{/}}{{@ style (color $color)}} nấu{{/}} và {{@ style (color $color)}}giúp {{/}}{{@ style (color $color)}}mang {{/}}{{@ style (color $color)}}đồ tiếp tế{{/}} — nhận được không ít {{@ style (color $color)}}miếng ăn{{/}} từ những {{@ style (color $color)}}bàn tay {{/}}{{@ style (color $color)}}thân thiện{{/}}."

msgid "text/event_29"
msgstr "Hôm nay là {{@ style (color $color)}}ngày {{/}}{{@ style (color $color)}}quan trọng{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Thú cưng{{/}} của bạn đã ở {{@ style (color $color)}}bệnh {{/}}{{@ style (color $color)}}viện{{/}}, {{@ style (color $color)}}động {{/}}{{@ style (color $color)}}viên{{/}} những người {{@ style (color $color)}}bị thương{{/}} bằng cách trình diễn vài {{@ style (color $color)}}trò{{/}} mà bạn đã dạy nó, lại còn nhớ {{@ style (color $color)}}thăm{{/}} từng {{@ style (color $color)}}binh sĩ{{@ style (color $defaultColor)}}. {{/}}{{/}}Trong một khoảng thời gian, {{@ style (color $color)}}phòng bệnh{{/}} tràn ngập {{@ style (color $color)}}tiếng cười{{/}} và {{@ style (color $color)}}những cái vẫy đuôi{{/}}."

msgid "text/event_3"
msgstr "Bạn nhìn thấy con {{@ style (color $color)}}chó{{/}} vui vẻ giúp các {{@ style (color $color)}}chàng trai{{/}} ở {{@ style (color $color)}}nhà kho{{/}} khiêng {{@ style (color $color)}}túi{{/}} và {{@ style (color $color)}}kiện hàng{{@ style (color $defaultColor)}}. {{/}}{{/}}Cuối ngày, người {{@ style (color $color)}}đốc công{{/}} biết ơn, trao cho bạn một {{@ style (color $color)}}gói{{/}} nhỏ như lời cảm ơn vì công sức giúp đỡ từ chú chó."

msgid "text/event_30"
msgstr "Hôm nay, {{@ style (color $color)}}chú chó{{/}} của bạn đã giúp những {{@ style (color $color)}}nhân viên {{/}}{{@ style (color $color)}}phục vụ {{/}}{{@ style (color $color)}}vốn thường bị bỏ qua{{@ style (color $defaultColor)}}. {{/}}{{/}}Chú {{@ style (color $color)}}chó săn{{/}} siêng năng đã mang {{@ style (color $color)}}đồ {{/}}{{@ style (color $color)}}vệ sinh{{/}} và thậm chí còn thử {{@ style (color $color)}}kéo {{/}}{{@ style (color $color)}}một{{/}} {{@ style (color $color)}}cây lau nhà{{/}} trên {{@ style (color $color)}}sàn{{/}} mà không cần ai giúp. Những {{@ style (color $color)}}nỗ lực đầy {{/}}{{@ style (color $color)}}quyết tâm{{/}} nhưng {{@ style (color $color)}}vụng về{{/}} như vậy đã nâng cao {{@ style (color $color)}}tinh thần{{/}} mọi người trong phần còn lại của {{@ style (color $color)}}ngày{{/}}."

msgid "text/event_4"
msgstr "Con {{@ style (color $color)}}chó{{/}} lôi vào trong một cái {{@ style (color $color)}}thùng {{/}}{{@ style (color $color)}}gỗ{{/}} chứa đầy {{@ style (color $color)}}dụng cụ {{/}}{{@ style (color $color)}}kỳ lạ, lẫn lộn, khác bộ{{@ style (color $defaultColor)}}. {{/}}{{/}}Không ai biết từ đâu đến, nhưng trông như thể ai đó đã cố ý {{@ style (color $color)}}đóng gói{{/}}."

msgid "text/event_5"
msgstr "Con {{@ style (color $color)}}chó{{/}} tìm thấy một {{@ style (color $color)}}cái lon{{/}} có {{@ style (color $color)}}nhãn {{/}}{{@ style (color $color)}}Thụy Điển{{@ style (color $defaultColor)}}. {{/}}{{/}}Sau khi {{@ style (color $color)}}cắn {{/}}{{@ style (color $color)}}nắp{{/}}, nó bắt đầu {{@ style (color $color)}}chạy {{/}}{{@ style (color $color)}}đuổi theo {{/}}{{@ style (color $color)}}binh sĩ{{/}} một cách {{@ style (color $color)}}{{/}}nghịch ngợm, những người {{@ style (color $color)}}đang bỏ chạy{{/}} vì {{@ style (color $color)}}mùi {{/}}{{@ style (color $color)}}khủng khiếp của {{/}}{{@ style (color $color)}}cái lon{{@ style (color $defaultColor)}}. {{/}}{{/}}Một {{@ style (color $color)}}ông thần{{/}} chạy ngang qua đã {{@ style (color $color)}}đề nghị{{/}} cho bạn {{@ style (color $color)}}phần thưởng{{/}} để chấm dứt {{@ style (color $color)}}sự hành hạ{{/}} này."

msgid "text/event_6"
msgstr "Một trong các {{@ style (color $color)}}đầu bếp{{/}} đã dành cả ngày dán {{@ style (color $color)}}áp phích{{/}} về chú {{@ style (color $color)}}mèo con {{/}}{{@ style (color $color)}}mất tích{{/}} xung quanh {{@ style (color $color)}}Ga-ra{{@ style (color $defaultColor)}}. {{/}}{{/}}Con {{@ style (color $color)}}chó{{/}} của bạn quyết định giúp {{@ style (color $color)}}tìm kiếm{{/}} và, sau vài giờ, đã thấy {{@ style (color $color)}}kẻ chạy trốn {{/}}{{@ style (color $color)}}lông xù{{/}} đang ẩn nấp gần {{@ style (color $color)}}doanh trại{{/}}."

msgid "text/event_7"
msgstr "Con {{@ style (color $color)}}chó{{/}} của bạn đã tìm thấy {{@ style (color $color)}}thiết bị {{/}}{{@ style (color $color)}}lạ{{/}} và mang đi khắp {{@ style (color $color)}}Ga-ra{{/}} suốt cả ngày. Cuối cùng, một trong các {{@ style (color $color)}}thợ máy{{/}} nhận ra đó là {{@ style (color $color)}}bộ phận {{/}}{{@ style (color $color)}}dự phòng {{/}}{{@ style (color $color)}}của xe tăng{{/}} và cẩn thận mang đến {{@ style (color $color)}}xưởng{{@ style (color $defaultColor)}}. {{/}}{{/}}Con {{@ style (color $color)}}chó{{/}} có vẻ rất tự hào về {{@ style (color $color)}}phát hiện của mình{{@ style (color $defaultColor)}}. {{/}}{{/}}Dù rốt cuộc là gì, có vẻ như bạn sẽ được {{@ style (color $color)}}thưởng{{/}} cho {{@ style (color $color)}}phát hiện{{/}} này."

msgid "text/event_8"
msgstr "Đêm nay {{@ style (color $color)}}trăng {{/}}{{@ style (color $color)}}tròn{{@ style (color $defaultColor)}}. {{/}}{{/}}Bị {{@ style (color $color)}}ánh trăng{{/}} mê hoặc, {{@ style (color $color)}}con chó{{/}} tru gần như không ngừng cho đến {{@ style (color $color)}}sáng{{@ style (color $defaultColor)}}. {{/}}{{/}}Những {{@ style (color $color)}}người lính{{/}} bị đánh thức đã thử mọi cách để làm dịu {{@ style (color $color)}}chó con{{/}}, nhưng dường như chẳng gì hiệu quả."

msgid "text/event_9"
msgstr "Trong lúc {{@ style (color $color)}}thử nghiệm{{/}}, {{@ style (color $color)}}lửa{{/}} bùng phát ở một {{@ style (color $color)}}xe tăng{{@ style (color $defaultColor)}}. {{/}}{{/}}Trước khi người kịp phản ứng, con {{@ style (color $color)}}chó{{/}} của bạn đã lao vào chiếc {{@ style (color $color)}}xe {{/}}{{@ style (color $color)}}bốc cháy{{/}} và giúp {{@ style (color $color)}}kíp lái{{/}} {{@ style (color $color)}}thoát ra{{@ style (color $defaultColor)}}. {{/}}{{/}}Câu chuyện về {{@ style (color $color)}}lòng dũng {{/}}{{@ style (color $color)}}cảm{{/}} như vậy nhanh chóng lan truyền khắp {{@ style (color $color)}}căn cứ{{/}}."

