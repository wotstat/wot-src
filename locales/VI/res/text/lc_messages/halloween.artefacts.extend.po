msgid "hwAoeDamageInstantShot/always"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/descr"
msgstr "Bắn một phát súng gây thiệt hại và làm choáng cho mục tiêu cùng các xe địch gần đó."

msgid "hwAoeDamageInstantShot/long_special"
msgstr "Khả năng Chiến đấu. Bắn một phát súng gây thiệt hại và làm choáng mục tiêu cùng mọi xe địch nội trong bán kính 35 m. Nếu sử dụng ít nhất một lần trong trận, khả năng sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Babylon: Dark Tower</font>.<br/><br/>Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "hwAoeDamageInstantShot/name"
msgstr "Đạn Tăng lực"

msgid "hwAoeDamageInstantShot/onUse"
msgstr "Bắn một phát súng gây thiệt hại và làm choáng cho mục tiêu cùng mọi xe địch nội trong bán kính 35 m."

msgid "hwAoeDamageInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/short_special"
msgstr "Bắn một phát súng gây thiệt hại và làm choáng cho mục tiêu cùng các xe địch gần đó."

msgid "hwAoeDrainEnemyHpInstantShot/always"
msgstr "?empty?"

msgid "hwAoeDrainEnemyHpInstantShot/descr"
msgstr "Bắn một phát súng khôi phục các điểm trúng bằng cách đánh cắp từ mục tiêu và các xe kẻ thù gần đó."

msgid "hwAoeDrainEnemyHpInstantShot/long_special"
msgstr "Khả năng Chiến đấu. Bắn một phát súng khôi phục sức kháng cự bằng cách cướp HP từ mục tiêu và các xe địch nội trong bán kính 35 m, đồng thời sửa mô-đun hư hại cũng như loại bỏ hiệu ứng choáng. Nếu sử dụng ít nhất một lần trong trận, khả năng sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Babylon: Dark Tower</font>.<br/><br/>Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "hwAoeDrainEnemyHpInstantShot/name"
msgstr "Đạn Cà rồng"

msgid "hwAoeDrainEnemyHpInstantShot/onUse"
msgstr "Bắn một phát súng khôi phục sức kháng cự bằng cách cướp HP từ mục tiêu và các xe địch nội trong bán kính 35 m, cũng như sửa mô-đun hư hại và loại bỏ hiệu ứng gây choáng."

msgid "hwAoeDrainEnemyHpInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDrainEnemyHpInstantShot/short_special"
msgstr "Bắn một phát súng khôi phục các điểm trúng bằng cách đánh cắp từ mục tiêu và các xe kẻ thù gần đó."

