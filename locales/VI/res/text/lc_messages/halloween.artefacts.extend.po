msgid "hwAoeStunInstantShot/descr"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và các xe địch gần đó."

msgid "hwAoeStunInstantShot/long_special"
msgstr "Khả năng Chiến đấu. Bắn một phát súng gây choáng cho mục tiêu và mọi xe địch nội trong bán kính 35 m. Có thể dùng nhiều lần một trận. Sẽ mất đi sau trận nếu đã được sử dụng ít nhất một lần.<br /><br />Chỉ khả dụng trong sự kiện <font color='#cbac77'>Babylon Project</font>.<br /><br />Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "hwAoeStunInstantShot/name"
msgstr "Đạn Choáng"

msgid "hwAoeStunInstantShot/onUse"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và mọi xe địch nội trong bán kính 35 m."

msgid "hwAoeStunInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeStunInstantShot/short_special"
msgstr "Bắn một phát súng gây choáng cho mục tiêu và các xe địch gần đó."

msgid "hwInvisibility/always"
msgstr "?empty?"

msgid "hwInvisibility/descr"
msgstr "Khiến xe của bạn tàng hình trước mắt địch, khôi phục HP, sửa mô-đun và dập lửa."

msgid "hwInvisibility/long_special"
msgstr "Khả năng Chiến đấu. Biến xe của bạn tàng hình trước mắt địch trong 10 s. Khôi phục 35 HP mỗi giây, sửa mô-đun, dập lửa, loại bỏ mọi hiệu ứng tiêu cực và giúp miễn nhiễm thiệt hại ăn mòn. Sẽ lộ vị trí ngay nếu bạn sát thương địch hoặc hứng chịu thiệt hại (theo cách bắn, đâm/húc hoặc dùng Khả năng Chiến đấu). Không thể bị đạn địch làm gián đoạn trong 3 giây sau lúc kích hoạt. Nếu sử dụng ít nhất một lần trong trận, khả năng sẽ tiêu hao nhưng tái tiếp tế được bằng bạc. Không cần tái tiếp tế nếu không dùng tới.<br/><br/>Chỉ khả dụng trong sự kiện <font color='#cbac77'>Babylon: Dark Tower</font>.<br/><br/>Mọi khả năng chưa dùng sẽ bị bỏ và được đền bù bằng bạc theo tỷ giá 50% chi phí của chúng khi bản cập nhật tiếp theo phát hành."

msgid "hwInvisibility/name"
msgstr "Stealth Heal"

msgid "hwInvisibility/onUse"
msgstr "Biến xe của bạn tàng hình trước mắt địch trong 10 s. Khôi phục 35 HP mỗi giây, sửa mô-đun, dập lửa, loại bỏ mọi hiệu ứng tiêu cực và giúp miễn nhiễm thiệt hại ăn mòn. Sẽ lộ vị trí ngay nếu bạn sát thương địch hoặc hứng chịu thiệt hại (theo cách bắn, đâm/húc hoặc dùng Khả năng Chiến đấu). Không thể bị đạn địch làm gián đoạn trong 3 giây sau lúc kích hoạt."

msgid "hwInvisibility/restriction"
msgstr "?empty?"

msgid "hwInvisibility/short_special"
msgstr "Ẩn mình khỏi địch, hồi HP, sửa mô-đun, dập lửa, loại bỏ choáng và chữa trị tổ lái."

