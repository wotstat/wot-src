msgid "elite_window/buttons/ok"
msgstr "Recepționat!"

msgid "elite_window/buttons/post_progression"
msgstr "Spre Modificare"

msgid "elite_window/buttons/vanity_progression"
msgstr "Spre recompensele elită"

msgid "elite_window/elite/description"
msgstr "Statutul Elită se acordă vehiculelor care au cercetate toate modulele disponibile, îmbunătățirile și ramurile tehnice, inclusiv vehiculele din generația următoare. EXP de luptă obținută cu vehiculele Elită poate fi transformată în EXP liberă contra aur sau utilizată pentru a accelera antrenamentul echipajului."

msgid "elite_window/elite/title"
msgstr "Starea Elită"

msgid "elite_window/post_progression/description"
msgstr "Modificarea de teren este acum disponibilă"

msgid "elite_window/prestige/description"
msgstr "După obținerea stării Elită, vehiculul începe să obțină puncte Elită și să primească niveluri Elită care reprezintă dedicarea ta asupra unui anumit vehicul. Un grad corespunzător este afișat în luptă după ce obții primul nivel Elită."

msgid "elite_window/prestige/title"
msgstr "Sistemul Elită"

msgid "elite_window/title"
msgstr "S-A OBŢINUT NIVELUL «ELITĂ»"

msgid "elite_window/vanity_progression/description"
msgstr "Obține recompense exclusive pentru vehiculele de generația XI, inclusiv un stil volumetric unic, un monitor de statistici și un manșon termic!"

msgid "elite_window/vanity_progression/title"
msgstr "Sistemul recompenselor elită este acum disponibil"
