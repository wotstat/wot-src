msgid "tank_params/desc/chargeableBurstSize"
msgstr "Numărul de proiectile stocate în caseta de salvă."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Perioada de reparare a unei șenile avariate."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Perioada de reparare a unei șenile principale/de rezervă avariate."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "Viteza de rotație a carenei în jurul axei și viteza de schimbare a direcției în mișcare (manevrabilitate)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "Raza vizuală curentă a vehiculului tău. Nu pot fi descoperite vehicule la distanţă mai mare de 445 m. O creştere ulterioară a acestui parametru uşurează descoperirea vehiculelor inamice la o distanţă de 445 m sau mai puţin (modul standard/special)."

msgid "tank_params/desc/clipFireRate"
msgstr "Timpul dintre focul ultimului proiectil din casetă (sau ambelor tunuri) și încărcarea următoarei casete. / Timpul dintre focul cu un proiectil și încărcarea următorului proiectil în casetă, tun sau container. / Numărul de tunuri sau proiectile din casetă."

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Durata efectului Telemetrului electromagnetic de coincidență, după activare."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Timpul necesar pentru ca activarea stabilizatorului să devină din nou disponibilă."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Durata de activare a stabilizatorului."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Numărul de proiectile per minut, fără timpul de reîncărcare."

msgid "tank_params/desc/coolingDelay"
msgstr "Perioada de după foc, până la începerea răcirii tunului."

msgid "tank_params/desc/coolingTime"
msgstr "Perioada necesară pentru ca un tun complet încălzit să se răcească. Tunul poate fi utilizat în acest timp."

msgid "tank_params/desc/damage"
msgstr "Daune provocate de un proiectil standard la pentrarea blindajului inamic."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Timpul necesar pentru ca marcatorul să poată fi utilizat din nou. Timpul de pregătire începe după efectuarea unei trageri."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Timpul scurs de la începerea luptei, necesar pentru ca marcatorul să poată fi utilizat pentru prima dată."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Perioada de timp în care vehiculele marcate rămân descoperite și suferă daune crescute de la proiectile."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "Cantitatea de daune suplimentare suferită via proiectile de inamicii marcați."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "Bonusul la dispersia la 100m conferit de vizor."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Afișează timpul necesar după foc pentru răcirea suficientă a tunului pentru îmbunătățirea preciziei."

msgid "tank_params/desc/enginePower"
msgstr "Acest parametru afectează accelerația vehiculului, viteza maximă și viteza de rotație a carenei."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Acest parametru afectează accelerația vehiculului și performanța pe diverse tipuri de teren (mod standard / special)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "Bonusul la accelerația vehiculului, conferit de acceleratoare."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Acest parametru afectează accelerația vehiculului, viteza maximă și viteza de rotație a carenei vehiculului în modul Turbo."

msgid "tank_params/desc/explosionRadius"
msgstr "Raza daunelor după explozia proiectilelor HE, afișând abilitatea de a provoca daune la o distanță față de punctul de impact."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Timpul adăugat la reîncărcarea casetei rămase după tragerea ultimului proiectil."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Viteza vehiculului, definită de caracteristicile sale tehnice."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "Bonusul la media daunelor per minut, la nivelul maxim al eficienței reîncărcării."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Numărul maxim de niveluri de eficiență a reîncărcării care pot fi acumulate."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "Durata nivelului eficienței încărcării, înainte de expirare."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "Numărul de niveluri de eficiență a reîncărcării după distrugerea unui vehicul inamic cu un proiectil."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "Numărul de niveluri ale eficienței reîncărcării obținute după lovirea unui inamic descoperit cu un proiectil."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "Dimensiunea reducerii timpului de încărcare, per nivelul de eficiență a reîncărcării."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "Penalizarea la dispersie la rotația tunului în modul Turbo."

msgid "tank_params/desc/gunYawLimits"
msgstr "Unghiurile maxime ale rotației orizontale a tunului (la stânga și la dreapta poziției inițiale), când carena este staționară."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "Bonusul la media daunelor pentru fiecare nivel de încălzire acumulat."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Perioada în care vehiculul nu poate trage sau schimba proiectilele."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Perioada în care vehiculul poate rămâne la nivelul maxim de încălzire, înainte de supraîncălzirea încărcăturii."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Timpul necesar pentru atingerea fiecărui nivel de încălzire."

msgid "tank_params/desc/heatingPerShot"
msgstr "Cantitatea de căldură generată de tun per lovitură."

msgid "tank_params/desc/hullArmor"
msgstr "Grosimea blindajului carenei: frontal / lateral / spate, după caz."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "Penalizarea la dispersie la rotația carenei în modul Turbo."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Parametrul afișează cantitatea de daune provocate prin coliziune. Atunci când vehiculele intră în coliziune, sistemul ia în considerare grosimea blindajului în punctul de impact, diferența dintre greutățile vehiculelor și vitezele acestora."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Parametrul afișează cantitatea de daune provocate suspensiei prin coliziune. Atunci când vehiculele intră în coliziune, sistemul ia în considerare grosimea blindajului în punctul de impact, diferența dintre greutățile vehiculelor și vitezele acestora."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Arată camuflarea unui vehicul în mișcare. Cu cât este mai mare parametrul, cu atât crește camuflarea. Sunt indicați următorii parametri: pentru vehicul în mișcare / pentru vehicul în mișcare care a tras."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Arată camuflarea unui vehicul staționar. Cu cât este mai mare parametrul, cu atât crește camuflarea. Sunt indicați următorii parametri: pentru vehicul staționar / pentru vehicul staționar care a tras."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "Cantitatea de încărcătură a Acceleratorului ionic, generată per secundă la viteza de peste 40 km/h în modul Turbo."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Acest parametru afectează durata Acceleratorului ionic, după activare."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Acest parametru afectează accelerația, viteza maximă și viteza de rotație a carenei dupăm activarea Acceleratorului ionic."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "Viteza suplimentară obținută după activarea Acceleratorului ionic."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "Cantitatea de încărcătură a Acceleratorului ionic, generată per secundă în modul Turbo."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Valoarea medie a daunelor provocate de o lovitură cu o încărcare parțială după o lovitură penetrantă. Dispersia potențială de daune este +/-25% față de valoarea medie."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Timpul până la încărcarea completă, pe perioada căruia nu pot fi trase focuri cu încărcare parțială."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Creșterea dispersiei tunului la focul cu încărcare parțială. Caracterizat prin deviația maximă a proiectilului față de punctul de țintire, la o distanță de 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Valoarea medie a grosimii blindajului care poate fi penetrat de un foc cu încărcare parțială, cu ajustarea normalizării proiectilului. Dispersia este +/-25% față de valoarea medie."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Creșterea valorii focurilor per minut trase cu încărcare parțială (față de focurile standard)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Viteza unui proiectil tras cu încărcare parțială."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Numărul maxim de niveluri de precizie care pot fi acumulate."

msgid "tank_params/desc/maxHealth"
msgstr "Numărul de puncte de integritate ale unui vehicul."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "Unghiul maxim de rotație a roților. Afectează manevrabilitatea vehiculului."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "Penalizarea la dispersie în deplasare în modul Turbo."

msgid "tank_params/desc/overheatDuration"
msgstr "Perioada necesară pentru răcirea completă a unui tun supraîncălzit. Tunul nu poate fi utilizat pe perioada răcirii."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "Cantitatea de încărcătură a Telemetrului electromagnetic de coincidență, generată per secundă în modul de angajament."

msgid "tank_params/desc/piercingPower"
msgstr "Grosimea de blindaj care poate fi penetrată de un proiectil standard, după calculul normalizării proiectilului."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Viteza de rotație a carenei în jurul axei și viteza de schimbare a direcției în mișcare (manevrabilitate)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "Timpul necesar pentru a schimba modurile depinde de starea motorului. Un motor avariat crește timpul necesar schimbării. Schimbarea este indisponibilă când motorul este distrus."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "Timpul necesar pentru a schimba modurile depinde de starea motorului. Un motor avariat crește timpul necesar schimbării. Schimbarea este indisponibilă când motorul este distrus."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Viteza de ridicare și coborâre a carenei, atunci când vehiculul se află în modul Buncăr."

msgid "tank_params/desc/pitchLimits"
msgstr "Unghiurile verticale maxime ale tunului, relative la carena vehiculului, luând în considerare suspensia."

msgid "tank_params/desc/powerModeDuration"
msgstr "Timpul necesar pentru a atinge viteza maximă de înaintare și puterea maximă a motorului în modul Transmisie directă."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Timpul necesar pentru activarea modului Transmisie directă."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "Bonusul la dispersie la 100m, la preîncălzire maximă."

msgid "tank_params/desc/preheatDmgCap"
msgstr "Bonusul la media daunelor provocate la preîncălzire maximă."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Depășirea acestei viteze previne generarea de preîncălzire și îi poate provoca descreșterea."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Timpul necesar vehiculului pentru preîncălzire maximă, de la zero."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Timpul necesar vehiculului pentru revenirea la zero, de la preîncălzire maximă."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Pe perioada acestei întârzieri, preîncălzirea vehiculului rămâne constantă."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "Nivelul maxim de încărcare care poate fi atins fără dezactivarea limitatorului."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "Cantitatea de încărcătură pierdută după foc."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "Cantitatea de încărcătură pe secundă generată automat."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "Cantitatea de încărcătură pierdută per secundă după activarea limitatorului, până la atingerea limitei."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "Perioada după care limitatorul poate fi comutat din nou."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "Penalizarea la timpul de țintire, atunci când limita este depășită."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "Bonusul daunelor medii conferit la încărcare completă, atunci când limita este depășită."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "Creșterea bruscă a daunelor provocate de foc, atunci când limita este depășită."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "Penalizarea la dispersia la 100 m atunci când limita este depășită."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "Bonusul daunelor medii conferit la încărcare maximă, atunci când limitatorul este activ."

msgid "tank_params/desc/radioDistance"
msgstr "Transmisiune - împărtășirea informațiilor privind pozițiile vehiculelor între aliați. Distanța de transmisiune pentru fiecare vehicul este reprezentată de un cerc cu raza determinată de acest parametru. Când mai multe cercuri se întrepătrund, informația poate fi transmisă la orice distanță."

msgid "tank_params/desc/reactivationDelay"
msgstr "Timpul de pregătire pentru ca activarea acceleratoarelor să devină din nou disponibilă."

msgid "tank_params/desc/reactivationLimit"
msgstr "Nivelul maxim de încălzire care poate fi atins înainte ce acceleratoarele să devină indisponibile pentru reactivare."

msgid "tank_params/desc/relativeArmor"
msgstr "Un set de parametri care indică rezistența vehiculului la daunele provocate."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Un set de parametri care indică eficiența camuflajului când vehiculul tău este staționar, în mișcare și după ce a tras. Vopseaua de camuflaj sporește parametrul de camuflare."

msgid "tank_params/desc/relativeMobility"
msgstr "Un set de parametri care indică cât de rapid un vehicul își poate schimba poziția pe câmpul de luptă."

msgid "tank_params/desc/relativePower"
msgstr "Un set de parametri care indică eficiența în distrugerea vehiculelor inamice."

msgid "tank_params/desc/relativeVisibility"
msgstr "Un set de parametri care indică eficiența în observarea vehiculelor inamice."

msgid "tank_params/desc/reloadTime"
msgstr "Proiectile trase pe minut."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Bonusul la timpul de reîncărcare a tunului, conferit atunci când vizorul este activ."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Timpul de reîncărcare a tunului (sau a ambelor tunuri la vehicule cu sisteme de tun cu două țevi) după tragere."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
msgstr "Timpul de reîncărcare a tunului după foc (mod Foc-cu-Foc/mod Salvă)."

msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
msgstr "Reducerea vitezei de marșarier a vehiculului atunci când acceleratoarele sunt active."

msgid "tank_params/desc/rocketAccelerationEnginePower"
msgstr "Acest parametru afectează accelerația vehiculului, viteza maximă și viteza de rotație a carenei."

msgid "tank_params/desc/rocketAccelerationReuseAndDuration"
msgstr "Racheto-accelerare care crește puterea motorului și viteza maximă. La activare, racheto-accelerarea descrește manevrabilitatea și nu poate fi dezactivată manual."

msgid "tank_params/desc/rocketAccelerationSpeedLimits"
msgstr "Viteza nominală a vehiculului cu racheto-accelerare activată."

msgid "tank_params/desc/secondaryAvgDamage"
msgstr "Valoarea medie a daunelor provocate de un proiectil al armamentului auxiliar după o lovitură penetrantă. Dispersia potențială de daune este +/-25% față de valoarea medie."

msgid "tank_params/desc/secondaryAvgPiercingPower"
msgstr "Valoarea medie a grosimii blindajului penetrate de un proiectil al armamentului auxiliar, cu ajustarea normalizării proiectilului. Dispersia este +/-25% față de valoarea medie."

msgid "tank_params/desc/secondaryReloadTimeSecs"
msgstr "Durata reîncărcării armamentului auxiliar după tragere."

msgid "tank_params/desc/secondaryTotalBurstSize"
msgstr "Cantitatea de proiectile disponibilă armamentului auxiliar pe perioada fiecărei activări."

msgid "tank_params/desc/shellCalibrationAvgDamage"
msgstr "Bonusul la daune acordat după o lovitură penetrantă asupra unui vehicul inamic."

msgid "tank_params/desc/shellCalibrationAvgPenetration"
msgstr "Bonusul la penetrare acordat după o lovitură non-penetrantă asupra unui vehicul inamic."

msgid "tank_params/desc/shellLoadingTime"
msgstr "Perioada necesară pentru încărcarea proiectilelor la începutul luptei și la schimbarea între tipurile de proiectile."

msgid "tank_params/desc/shellParamsSwitchingTime"
msgstr "Timpul necesar pentru a comuta între modurile de tragere Calibrat și Standard."

msgid "tank_params/desc/shotDispersionAngle"
msgstr "Dispersie a tunului, definită de deviația maximă a proiectilului de la punctul ochit, la o distanță de 100 m."

msgid "tank_params/desc/shotDispersionAngle/twinGun"
msgstr "Dispersie a tunului, definită de deviația maximă a proiectilului de la punctul ochit, la o distanță de 100 m (mod standard/special)."

msgid "tank_params/desc/shotDispersionAngle/withDualAccuracy"
msgstr "Afișează cât de mult poate devia un proiectil față de punctul de țintire în metri per 100m față de țintă. Valoarea standard (prima) este pentru un tun încins, valoarea îmbunătățită (a doua) este pentru un tun răcit."

msgid "tank_params/desc/sightPointerConsealmentFoliage"
msgstr "Reducere progresivă a camuflajului vehiculelor inamice în spatele vegetației din sectorul de scanare al IRST."

msgid "tank_params/desc/sightPointerConsealmentMoving"
msgstr "Reducere progresivă a camuflajului vehiculelor inamice în mișcare din sectorul de scanare al IRST."

msgid "tank_params/desc/sightPointerDeployTime"
msgstr "Timpul scurs de la începerea luptei, necesar pentru IRST să poată fi utilizat pentru prima dată."

msgid "tank_params/desc/sightPointerDuration"
msgstr "Durata scanării IRST."

msgid "tank_params/desc/sightPointerReloadTime"
msgstr "Timpul necesar pentru ca IRST să poată fi utilizat din nou după activare."

msgid "tank_params/desc/sightPointerRotationSpeed"
msgstr "Reducerea vitezei de rotație a turelei în timp ce IRST este activ."

msgid "tank_params/desc/sightPointerSectorAngleEnd"
msgstr "Lățimea sectorului de scanare al IRST la sfârșitul duratei sale."

msgid "tank_params/desc/sightPointerSectorAngleStart"
msgstr "Lățimea sectorului de scanare al IRST la începutul duratei sale."

msgid "tank_params/desc/sightPointerSelfSpottingTime"
msgstr "Perioada în care vehiculul tău este descoperit, după ce detectezi cu IRST un inamic nedescoperit."

msgid "tank_params/desc/sightPointerViewRange"
msgstr "Creșterea progresivă a razei vizuale în sectorul de scanare al IRST."

msgid "tank_params/desc/speedLimits"
msgstr "Viteza vehiculului, definită de caracteristicile sale tehnice."

msgid "tank_params/desc/stagedJetBoostersChargeDuration"
msgstr "Durata maximă a accelerării după activarea acceleratoarelor."

msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "De câte ori poate fi utilizat acceleratorul într-o luptă."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Timpul de pregătire de după utilizare până la reactivarea acceleratoarelor."

msgid "tank_params/desc/stagedJetBoostersEnginePower"
msgstr "Bonusul la accelerația vehiculului cu acceleratoarele activate."

msgid "tank_params/desc/stagedJetBoostersRotationSpeed"
msgstr "Bonusul la viteza de rotație a vehiculului cu acceleratoarele activate."

msgid "tank_params/desc/stagedJetBoostersSpeedLimits"
msgstr "Viteza vehiculului, definită de caracteristicile sale tehnice."

msgid "tank_params/desc/stagedJetBoostersTopSpeed"
msgstr "Bonusul la viteza maximă a vehiculului cu acceleratoarele activate."

msgid "tank_params/desc/stationaryReloadSwitchOffTime"
msgstr "Durata necesară pentru deblocarea turelei și posibilitatea ca vehiculul să tragă din nou, după întreruperea procesului de reîncărcare."

msgid "tank_params/desc/stationaryReloadSwitchOnTime"
msgstr "Durata necesară pentru legarea turelei de rezervoarele de muniție externe și începerea procesului de reîncărcare."

msgid "tank_params/desc/stunMaxDuration"
msgstr "Indică durata maximă a șocului aplicat echipajului inamic, dacă obuzul HE a penetrat blindajul unui vehicul fără echipament sau consumabile care reduc durata șocului și dacă a provocat daune maxime."

msgid "tank_params/desc/stunMinDuration"
msgstr "Indică durata minimă a șocului aplicat echipajului inamic, dacă vehiculul inamic este în raza daunelor și nu este echipat cu consumabile sau echipamente care reduc durata șocului."

msgid "tank_params/desc/switchEngineModeBothModes"
msgstr "Timpul necesar pentru schimbarea între modurile de angajament și Turbo."

msgid "tank_params/desc/switchOffTime"
msgstr "Timpul necesar pentru a schimba modurile depinde de starea motorului. Un motor avariat crește timpul necesar schimbării. Schimbarea este indisponibilă când motorul este distrus."

msgid "tank_params/desc/switchOnTime"
msgstr "Timpul necesar pentru a schimba modurile depinde de starea motorului. Un motor avariat crește timpul necesar schimbării. Schimbarea este indisponibilă când motorul este distrus."

msgid "tank_params/desc/switchTime"
msgstr "Timpul necesar pentru a schimba modurile depinde de starea motorului. Un motor avariat crește timpul necesar schimbării. Schimbarea este indisponibilă când motorul este distrus."

msgid "tank_params/desc/temperatureAimingTime"
msgstr "Timpul de țintire pentru un tun complet încălzit sau răcit."

msgid "tank_params/desc/temperatureAvgDamagePerMinute"
msgstr "Cantitatea de daune ce pot fi provocate unui vehicul inamic, în teorie, într-un minut, dacă toate proiectilele penetrează blindajul."

msgid "tank_params/desc/temperatureReloadTime"
