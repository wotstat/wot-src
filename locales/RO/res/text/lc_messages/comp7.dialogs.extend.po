msgid "comp7/deserter/cancel"
msgstr "Anulează"

msgid "comp7/deserter/message"
msgstr "Lupta încă nu s-a încheiat. Dacă părăsești lupta înainte de încheierea acesteia, îți vei părăsi echipa. \n{brown_open}Gradul tău va fi redus și vei fi blocat din lupte în acest mod.{brown_close}\nEști sigur că vrei să părăsești lupta?"

msgid "comp7/deserter/msgTitle"
msgstr "Vei pierde Punctele de clasament!"

msgid "comp7/deserter/submit"
msgstr "Dezertare"

msgid "comp7/deserter/title"
msgstr "Dezertare din luptă"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Ai încălcat regulile jocului pe harta {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} la {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nȚi s-au eliminat {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Puncte de clasament și ai fost blocat temporar din lupte în modul {whiteSpanish_Open}Violență{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Ai încălcat regulile jocului pe harta {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} la {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nAi fost blocat temporar din lupte în modul {whiteSpanish_Open}Violență{whiteSpanish_Close} și scorul tău personal a fost redus."
