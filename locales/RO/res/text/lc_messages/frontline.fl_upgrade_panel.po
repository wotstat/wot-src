msgid "alert"
msgstr "Nu poți alege o rezervă de luptă în lupta activă."

msgid "description/one/reserve"
msgstr "Alegerea repetată a rezervei %(reserve_name)s\nîi va îmbunătăți caracteristicile."

msgid "description/second/reserve"
msgstr "Alegerea repetată a rezervelor %(first_reserve_name)s sau %(second_reserve_name)s\nva îmbunătăți caracteristicile celei selectate."

msgid "number_1"
msgstr "Primul"

msgid "number_2"
msgstr "Al doilea"

msgid "number_3"
msgstr "Al treilea"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Desfășoară un câmp activ de mine în zona selectată pentru o anumită perioadă de timp."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Provoacă daune considerabile vehiculelor inamice într-o zonă restrânsă."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Provoacă șoc vehiculelor inamice și provoacă daune medii într-o rază mare."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Adaugă un bonus la calificarea majoră a echipajelor jucătorului și aliaților."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Conferă bonus vitezei de capturare, blocării capturării și reaprovizionării."

msgid "shortDescription/reserve/reconAbility"
msgstr "Descoperă vehicule și mine inamice."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restaurează un anumit procentaj din punctele de integritate ale vehiculului tău."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Ascunde toate vehiculele din fum și din spatele acestuia."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Conferă un bonus la camuflaj și raza vizuală. Reduce camuflajul vehiculelor inamice."

msgid "title"
msgstr "%(number_name)s locaș al rezervelor este disponibil"
