msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Începe o luptă standard cu un vehicul de orice generație."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Bun venit în joc! Luptă alături de alți fani de pretutindeni și sărbătorește victorii spectaculoase!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Prima luptă"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Cercetează şi cumpără orice vehicul de generaţia a IV-a."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Cumpărarea unui nou vehicul este o ocazie importantă. Cu fiecare generație, vehiculele devin mai interesante. Un echipaj antrenat va îmbunătăți mai mult jocul."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Vehiculul de generația IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Participă la trei lupte standard cu vehicule de generațiile IV-X cu orice element de personalizare aplicat."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Poți personaliza vehiculele, schimbându-le exteriorul cu stiluri presetate sau creând propriul stil utilizând camuflaje, inscripții, embleme și autocolante."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Exteriorul vehiculelor"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Începe antrenarea oricărui talent pentru orice membru de echipaj."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Membrii de echipaj pot antrena talente suplimentare care să le crească eficiența sau să obțină capabilități noi."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Talentele de echipaj"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Câștigă 150.000 de credite în lupte standard cu vehicule de generațiile IV-X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Cu cât mai mare nivelul, cu atât mai multe credite sunt necesare pentru mentenanța vehiculului, reîncărcarea cu muniție și cumpărarea de module și echipament."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Strângerea de credite"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Cercetează şi cumpără orice vehicul de generaţia V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Vehiculele mai puternice apar odată cu generația V, în care abilitățile tale din joc sunt testate cu adevărat. Un echipaj complet antrenat îți va fi de ajutor."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Vehiculul de generația V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile V-X cu trei articole de echipament instalate."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Aparatură optică antireflex sau Ventilație îmbunătățită? Echipamentul potrivit poate crește punctele forte ale vehiculului și îi poate micșora dezavantajele."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Instalarea echipamentului"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Finalizează un scenariu de bază în modul Topografie."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Pentru a avea încredere pe câmpul de luptă, cel mai bun lucru este înțelegerea tacticilor și hărților, a pozițiilor cheie și ale obiectelor din acestea."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografia"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Finalizează patru scenarii avansate pe o hartă în Topografie."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Intră din când în când în modul Topografie pentru a studia hărțile din luptele standard. Scenariile îți permit să explorezi locațiile din diverse unghiuri."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Topografia avansată"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile V-X cu o rezervă personală activată."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "La activarea acestora, poți obține bonusuri suplimentare la EXP de luptă sau liberă și de echipaj, ori la credite după fiecare luptă."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Rezervele personale"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Clasează-te în primii 10 jucători din echipa ta ca EXP obținută de șase ori în lupte standard victorioase cu vehicule din generațiile V-X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Aceste misiuni îți permit să câștigi de cinci ori mai multă EXP per luptă de succes. Trebuie să învingi și să fii în top 10 jucători din echipa ta ca EXP obținută."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 misiuni pentru 5× EXP"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Cercetează un modul și instalează-l pe un vehicul de orice generație."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "EXP de luptă este acordată după fiecare luptă. Obține EXP de luptă pentru a cerceta module noi care îți cresc eficiența vehiculului."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "EXP de luptă"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Cercetează şi cumpără orice vehicul de generaţia VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "În fiecare generație următoare, cercetarea de vehicule cere mai mult timp și efort. EXP liberă te va ajuta să avansezi, iar un echipaj antrenat prinde bine."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Vehiculul de generația VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Finalizează o misiune personală în orice campanie."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Campaniile sunt lanțuri de misiuni pentru diferite tipuri de vehicule. La finalizarea acestora poți obține recompense utile și vehicule unice."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Misiuni personale"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Antrenează un echipaj cu un manual universal."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Cărțile de echipaj îți permit să accelerezi semnificativ antrenamentul echipajului, adăugând o anumită cantitate de EXP unuia sau tuturor membrilor de echipaj."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Cărți de echipaj"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile VI-X echipate cu o directivă de echipaj."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Directivele pot îmbunătăți un talent al echipajului în luptă. Directivele pot fi cumpărate sau obținute drept recompensă."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Directivele pentru echipaj"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Cumpără din Magazinul din joc un Pachet de Începător special."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Poți cumpăra tot ce ai nevoie din Magazinul din joc, inclusiv aur, vehicule premium și multe altele. Acolo vei găsi regulat promoții avantajoase."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Magazin"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile VI-X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Aceste vehicule nu necesită cercetare. Ele câștigă mai multă EXP de luptă, EXP liberă și credite și îți permit să transferi pe ele un echipaj fără reantrenare."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Vehicule Premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile VI-X cu o directivă de echipament."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Directivele îți permit să crești eficiența echipamentului instalat. Precum consumabilele, directivele pot fi cumpărate sau obținute drept recompensă."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Directivele pentru echipament"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Clasează-te în primii 10 jucători din echipa ta ca EXP obținută de 15 ori în lupte standard cu vehicule din generațiile VI-X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Aceste misiuni îți permit să câștigi de cinci ori mai multă EXP per luptă de succes. Trebuie să învingi și să fii în top 10 jucători din echipa ta ca EXP obținută."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 misiuni pentru 5× EXP"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Cercetează și cumpără orice vehicul de generația VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "În această generație, cerințele de abilități sunt și mai mari. Vehiculele devin mai formidabile și mai eficiente, la fel și inamicii."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Vehiculul de generația VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Participă la 10 lupte standard cu vehicule din generațiile VII-X echipate cu un Set complex de piese de schimb, o trusă de prim ajutor complexă și un Extinctor automat."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Atunci când sunt echipate, consumabilele complexe repară modulele avariate mai rapid decât cele standard. Acestea mai reduc durata șocului și riscul de incendiu și au un timp de refacere redus."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Consumabilele mari"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Primești dublul EXP pentru prima victorie a zilei în lupte standard, cu vehicule din orice generație."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Poți primi dublul EXP pentru prima victorie a zilei cu orice vehicul. Folosește acest lucru pentru a-ți îmbunătăți vehiculele și mai repede."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Multiplicatorul EXP"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Creează un fragment de plan pentru orice vehicul necercetat."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Planurile conferă o reducere la EXP și accelerarea cercetării. Se pot obține ca recompense sau din fragmente universale și naționale."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Planurile vehiculelor"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Clasează-te în primii 10 jucători din echipa ta ca EXP obținută de 20 de ori în lupte standard cu vehicule din generațiile VII-X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Aceste misiuni îți permit să câștigi de cinci ori mai multă EXP per luptă de succes. Trebuie să învingi și să fii în top 10 jucători din echipa ta ca EXP obținută."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 de misiuni pentru 5× EXP"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Cercetează și cumpără orice vehicul de generația VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Vehiculele din generația VIII necesită întreaga ta serie de cunoștințe. Inamicii nu te vor plictisi, oferindu-ți adrenalină și experiență valoroasă."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Vehiculul de generația VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Utilizează EXP liberă pentru a cerceta orice modul."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Dacă nu ai destulă EXP de luptă pentru a cerceta un modul sau un vehicul, poți utiliza EXP liberă, care poate fi câștigată cu orice vehicul."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "EXP liberă"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Încarcă proiectile alternative și începe o luptă standard cu un vehicul din generațiile III-X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Proiectilele penetrante, explozive și penetrante compozite sunt utile în diverse situații în luptă. Alege cu înțelepciune pentru a fi avantajat!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Muniţia"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Vinde un modul nefolosit din depozit."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Modulele, proiectilele, echipamentul, consumabilele și alte articole neutilizate sunt stocate în Depozit. Poți vinde articolele suplimentare contra credite."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depozit"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Câștigă 25.000 de credite în lupte standard cu vehicule de generațiile III-X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Creditele sunt utilizate pentru a cumpăra proiectile și vehicule noi, pentru a repara vehicule și altele. E important să le economisești; utilizează-le just."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Creditele"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Participă la trei lupte standard cu vehicule din generațiile III-X cu consumabile instalate în toate locașurile disponibile."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Consumabilele repară daunele critice ale vehiculului și vindecă rănile echipajului. Consumabilele sunt cruciale pentru supraviețuirea pe câmpul de luptă."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Consumabile"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Participă la trei lupte Standard cu un vehicul de generațiile III-X cu orice echipament instalat."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Vehiculelor li se poate adăuga echipament pentru a le îmbunătăți anumite caracteristici. Configurația echipamentului depinde de vehicul și de stilul de joc."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Echipament"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Finalizează orice scenariu pe orice hartă în Topografie"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Finalizează patru scenarii de bază pe o hartă în Topografie"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Recunoaștere"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Finalizează patru scenarii avansate pe o hartă în Topografie"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Nota 10 la Geografie"
