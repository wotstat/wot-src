msgstr "Stingerea automată a incendiului"

msgid "berserker/battleDescr"
msgstr "Crește de %(gunPiercing)s ori penetrarea și cadența de tragere, crescând de asemenea eficiența țintirii și stabilizarea cu %(gunAimingTime)s, însă reduce totalul de HP al vehiculului cu %(healthDebuff)s pe parcursul duratei sale de %(duration)s s.\n\n* Daunele provocate de abilitatea Luptător furios nu îți pot distruge vehiculul."

msgid "berserker/descr"
msgstr "Crește de %(gunPiercing)s ori penetrarea și cadența de tragere, crescând de asemenea eficiența țintirii și stabilizarea cu %(gunAimingTime)s, însă reduce totalul de HP al vehiculului cu %(healthDebuff)s pe parcursul duratei sale de %(duration)s s.\n\n* Daunele provocate de abilitatea Luptător furios nu îți pot distruge vehiculul."

msgid "berserker/longDescr"
msgstr "Crește {green_Open}de %(gunPiercing)s ori{green_Close} penetrarea și cadența de tragere, crescând de asemenea eficiența țintirii și stabilizarea {green_Open}cu %(gunAimingTime)s{green_Close}, însă reduce totalul de HP al vehiculului cu {red_Open}%(healthDebuff)s{red_Close} pe parcursul duratei sale {whiteSpanish_Open}de %(duration)s s{whiteSpanish_Close}.\n\n* Daunele provocate de abilitatea Luptător furios nu îți pot distruge vehiculul."

msgid "berserker/name"
msgstr "Luptător furios"

msgid "berserker/shortDescr"
msgstr "Crește {green_Open}de %(gunPiercing)s ori{green_Close} penetrarea și cadența de tragere, crescând de asemenea eficiența țintirii și stabilizarea {green_Open}cu %(gunAimingTime)s{green_Close}, însă reduce totalul de HP al vehiculului cu {red_Open}%(healthDebuff)s{red_Close} pe parcursul duratei sale {whiteSpanish_Open}de %(duration)s s{whiteSpanish_Close}.\n\n* Daunele provocate de abilitatea Luptător furios nu îți pot distruge vehiculul."

