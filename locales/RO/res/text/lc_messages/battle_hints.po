msgid "hint/LSH_FIRE"
msgstr "Fumul complică descoperirea vehiculelor inamice și comunicarea pozițiilor acestora. Focul provoacă daune vehiculelor."

msgid "hint/LSH_FOG"
msgstr "Ceața complică descoperirea vehiculelor inamice și comunicarea pozițiilor acestora."

msgid "hint/LSH_RAIN"
msgstr "Ploaia grea complică descoperirea vehiculelor inamice și comunicarea pozițiilor acestora."

msgid "hint/LSH_SANDSTORM"
msgstr "Furtuna de nisip complică descoperirea vehiculelor inamice și comunicarea pozițiilor acestora."

msgid "hint/LSH_SMOKE"
msgstr "Fumul complică descoperirea vehiculelor inamice și comunicarea pozițiilor acestora."

msgid "hint/PPH_AIMING_01"
msgstr "Deplasarea vehiculului și rotirea turelei descresc <font color='#EE7000'>precizia tunului</font>."

msgid "hint/PPH_AIMING_02"
msgstr "Cercul din jurul reticulului indică <font color='#EE7000'>precizia tunului</font>. Așteaptă puțin pentru un foc mai precis."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Țintirea automată</font> activată. Apasă butonul din dreapta al mouse-ului pentru a o dezactiva."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Țintirea automată efectuează întotdeauna țintirea <font color='#EE7000'>în mijlocul</font> vehiculului inamic"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Baza ta este <font color='#EE7000'>capturată!</font> Dacă nu acționezi, echipa inamică va câștiga lupta."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Fiecare vehicul inamic are <font color='#EE7000'>propriul său</font> progres de captură"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Capturarea</font> bazei inamice este una dintre modurile în care se poate câștiga lupta"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Atunci când suferi daune, progresul capturii <font color='#EE7000'>se resetează</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Când părăsești cercul bazei, progresul capturii <font color='#EE7000'>se pierde</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Mai multe vehicule capturează <font color='#EE7000'>mai rapid</font> baza"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "După <font color='#EE7000'>al treilea</font> vehicul, viteza de capturare nu mai crește"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Baza inamică este aproape capturată!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Echipa ta câștigă cursa de capturare a bazei!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modulul vehiculului este avariat critic! Repară-l utilizând <font color='#EE7000'>setul de piese de schimb</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modulul vehiculului este avariat critic! Repară-l utilizând <font color='#EE7000'>setul de piese de schimb</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Membru de echipaj rănit! Vindecă-l cu <font color='#EE7000'>trusa de prim ajutor</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Membru de echipaj rănit! Vindecă-l cu <font color='#EE7000'>trusa de prim ajutor</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Echipaj în șoc! Vindecă-l cu <font color='#EE7000'>trusa de prim ajutor</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vehicul incendiat! Utilizează <font color='#EE7000'>extinctorul</font> din panoul de jos."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vehicul incendiat! <font color='#EE7000'>Extinctorul automat</font> s-a activat."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Modulul vehiculului este avariat critic! Echiparea unui <font color='#EE7000'>set de piese de schimb</font> înaintea luptei ajută la rezolvarea avariilor critice."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Membru de echipaj rănit! Echiparea <font color='#EE7000'>unei truse de prim ajutor</font> înaintea luptei ajută la tratarea echipajului."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Vehicul incendiat! Echiparea <font color='#EE7000'>unui extinctor</font> înaintea luptei ajută la stingerea incendiului."

msgid "hint/PPH_OTHER_01"
msgstr "Ai fost <font color='#EE7000'>descoperit</font>: focul îți poate evidenția poziția!"

msgid "hint/PPH_OTHER_02"
msgstr "Vehiculul tău a fost distrus. Poți apăsa <font color='#EE7000'>Esc</font> pentru a părăsi lupta fără penalizări."

msgid "hint/PPH_OTHER_03"
msgstr "Vehiculul tău a fost distrus. Poți apăsa butonul mouse-ului pentru a <font color='#EE7000'>deveni spectator</font> al aliaților."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Iconița de tip bec</font> indică faptul că ai fost descoperit de inamici!"

msgid "hint/PPH_OTHER_05"
msgstr "Tunul tău încă <font color='#EE7000'>se reîncarcă</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Tunul tău poate fi utilizat doar dacă cercul din jurul reticulului este <font color='#EE7000'>complet verde</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Poți roti în sus rotița mouse-ului pentru a intra în <font color='#EE7000'>modul lunetist</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Poți roti în jos rotița mouse-ului pentru a <font color='#EE7000'>ieși din</font> modul lunetist"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Un <font color='#EE7000'>reticul verde interior</font> indică șanse mari de a penetra blindajul inamicului"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Chiar dacă reticulul interior e verde, penetrarea blindajului <font color='#EE7000'>nu e garantată</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Tunurile nu au precizie de 100%, astfel, loviturile <font color='#EE7000'>nu vor nimeri mereu în centrul</font> reticulului"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Reticulul interior poate indica șansa de penetrare a blindajului inamic. <font color='#EE7000'>Activează acest lucru în Setări</font>."

msgid "penetration/chance/high"
msgstr "Șansă crescută"

msgid "penetration/chance/low"
msgstr "Șansă redusă"

msgid "penetration/chance/medium"
msgstr "Șansă medie"
