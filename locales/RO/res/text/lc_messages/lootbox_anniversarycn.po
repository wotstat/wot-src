msgid "boxTooltip/description/text/bronze"
msgstr "La deschidere, aceste cutii îți pot aduce vehicule premium de generația VIII, monede în joc sau alte recompense valoroase."

msgid "boxTooltip/description/text/gold"
msgstr "La deschidere, aceste cutii îți pot aduce vehicule rare de generația X, monede în joc sau alte recompense valoroase."

msgid "boxTooltip/description/text/silver"
msgstr "La deschidere, aceste cutii îți pot aduce vehicule premium de generația IX, monede în joc sau alte recompense valoroase."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Se pot obține drept cadou la cumpărarea de articole din Magazinul Premium, precum și la deschiderea de cutii de orice alt tip."

msgid "boxTooltip/howGet/text/gold"
msgstr "Se pot obține la deschiderea de cutii de orice alt tip."

msgid "boxTooltip/howGet/text/silver"
msgstr "Se pot obține la deschiderea de cutii de orice alt tip."

