msgid "extraParams/desc"
msgstr "Un parametru care nu afectează direct eficiența în distrugerea vehiculelor inamice."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Bonusul total este calculat folosind atât modificatori aditivi, cât și multiplicativi, astfel încât poate deveni fie mai mare, fie mai mic decât valorile indicate aici."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Parametrul afișează perioada dintre focul artileriei și primirea avertismentului."

msgid "extraParams/name/commanderLampDelay"
msgstr "Parametrul afișează timpul scurs până când comandantul identifică dacă vehiculul tău a fost descoperit de inamic. Cu cât mai mare este valoarea, cu atât mai scurtă este întârzierea."

msgid "extraParams/name/crewHitChance"
msgstr "Acest parametru arată șansele de a evita rănirea membrilor echipajului."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Acest parametru arată durata șocului adițional pentru un vehicule deja aflat în șoc."

msgid "extraParams/name/crewStunDuration"
msgstr "Acest parametru arată durata șocului primit."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Parametrul afișează schimbarea daunelor minime potențiale și a valorii de penetrare potențiale față de valoarea de bază (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Parametrul afișează schimbarea daunelor maxime potențiale și a valorii de penetrare potențiale față de valoarea de bază (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Parametrul afișează cantitatea de daune provocate prin coliziune. Atunci când vehiculele intră în coliziune, sistemul ia în considerare grosimea blindajului în punctul de impact, diferența dintre greutățile vehiculelor și vitezele acestora."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Parametrul afișează întârzierea cu care comandantul detectează în reticul daunele critice suferite de vehiculul inamic."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Acest parametru arată gradul de expunere al inamicilor complet ascunși de frunziș (atât izolat cât și frunziș grupat). Se aplică vehiculelor staționare și în mișcare."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Acest parametru arată arată gradul de expunere al vehiculelor inamice în mișcare. Cu cât valoarea este mai mare, cu atât șansele de a-i descoperi cresc."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Parametrul afișează schimbările în șansa de a provoca daune critice echipajului și modulelor inamicilor. Efectul funcționează cu toate tipurile de proiectile, cu excepția vehiculelor cu autotunuri."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Parametrul afișează timpul de refacere al consumabilelor."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Parametrul determină descreșterea duratei incendiului și cantitatea de daune provocată de acesta."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Parametrul afișează efectul camuflajului din spatele frunzișului."

msgid "extraParams/name/hpRecover"
msgstr "Parametrul afișează creșterea de HP refăcut la utilizarea unui set de piese de schimb. Valorile mai mari reprezintă mai mult HP refăcut."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Parametrul afișează performanțele suspensiei pe teren moderat-moale. Cu cât valoarea este mai mare, cu atât se atinge mai repede viteza în linie dreaptă."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Parametrul reduce penalizarea la raza vizuală maximă atunci când aparatura de observare este distrusă. Valoarea mai mică reprezintă vizibilitate mai bună."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Parametrul afișează creșterea potențialului maxim de penetrare al proiectilelor la distanțe de sub 50 m. Valorile mai mari reprezintă o penetrare mai bună."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Parametrul afișează timpul suplimentar de transmitere a pozițiilor inamice de după distrugerea vehiculului."

msgid "extraParams/name/radiomanHitChance"
msgstr "Parametrul afișează șansele de a evita rănirea transmisionistului."

msgid "extraParams/name/shellVelocity"
msgstr "Parametrul afișează creșterea în viteză a proiectilelor de toate tipurile. Valorile mai mari reprezintă viteze mai ridicate ale proiectilelor."

msgid "extraParams/name/softGroundFactor"
msgstr "Parametrul afișează performanțele suspensiei pe teren moale. Cu cât valoarea este mai mare, cu atât se atinge mai repede viteza în linie dreaptă."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Parametrul afișează gradul efectelor negative ale șocului asupra echipajului."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Parametrul afișează reducerea daunelor suferite de suspensie. Valorile mai mari reprezintă mai puține daune suferite."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Parametrul afișează reducerea penalizării la timpul de reîncărcare a tunului provocat de compartimentul muniției avariat. Valorile mai mari reprezintă un timp de reîncărcare mai scurt."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Parametrul afișează reducerea pierderii de putere a unui motor avariat. Valorile mai mari reprezintă o reducere de putere mai mică."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Acest parametru arată rezistența compartimentului de muniție, rezervoarelor și motorului. Cu cât valoarea este mai mare, cu atât componentele sunt mai durabile."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Parametrul afișează rezistența compartimentului de muniție. Cu cât valoarea este mai mare, cu atât modulul este mai durabil."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Acest parametru arată daunele provocate de avariile la suspensie în cazul unui impact. Nu afectează daunele provocate lateralelor și acoperișului turelei într-un impact."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Acest parametru arată viteza de reparație a suspensiei. Cu cât valoarea este mai mare, cu atât viteza de reparație crește."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Acest parametru arată rezistența suspensiei. Cu cât valoarea este mai mare, cu atât suspensia este mai rezistentă la proiectile și impact/ciocniri."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Acest parametru arată durata în care inamicii rămân vizibili după ce au părăsit câmpul tău vizual. Valoarea standard este de 10 secunde."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Parametrul afișează reducerea daunelor suferite de un vehicul în cazul coliziunii. Valorile mai mari reprezintă daune mai mici."

msgid "extraParams/name/vehicleFireChance"
msgstr "Parametrul afișează șansa de incendiu a motorului la avariere."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Parametrul afișează rezistența rezervorului la daune critice. La distrugere, rezervorul este întotdeauna incendiat."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Acest parametru arată reducere preciziei tunului la mișcare și la rotirea carenei și turelei. Cu cât valoarea este mai mică, cu atât dispersia colimatorului este mai mică."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Acest parametru afișează dimensiunea cercului de țintire după foc."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Parametrul afișează dispersia în mișcare. Valorile mai mici reprezintă un tun mai precis."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Parametrul afișează dispersia la rotirea carenei. Valorile mai mici reprezintă un tun mai precis."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Parametrul afișează dispersia la rotirea tunului. Valorile mai mici reprezintă un tun mai precis."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Parametrul afișează dispersia unui tun avariat. Valorile mai mari reprezintă o dispersie mai mică."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Acest parametru arată daunele suferite via proiectile HE. Cu cât zona de blindaj este mai extinsă, cu atât efectul sporește."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Acest parametru afișează camuflajul după foc."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Parametrul afișează durata în care vehiculul tău rămâne vizibil inamicilor după ce ai părăsit raza lor vizuală. Valoarea standard este de 10s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Parametrul afișează cantitatea de daune provocate suspensiei prin coliziune. Atunci când vehiculele intră în coliziune, sistemul ia în considerare grosimea blindajului în punctul de impact, diferența dintre greutățile vehiculelor și vitezele acestora."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Parametrul afișează cantitatea de daune suferite prin coliziune. Atunci când vehiculele intră în coliziune, sistemul ia în considerare grosimea blindajului în punctul de impact, diferența dintre greutățile vehiculelor și vitezele acestora."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Parametrul afișează viteza de schimbare între tipurile de proiectile dintr-un tun încărcat."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Parametrul afișează viteza de reparare a modulelor interne și externe de la starea „roșu” la starea „galben”. Valorile mai mari reprezintă reparații mai rapide."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Acest parametru arată performanțele pe teren accidentat ale suspensiei. Cu cât valoarea este mai mare, cu atât se atinge mai repede viteza în linie dreaptă."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Parametrul afișează viteza de schimbare a direcției unui vehicul cu roți."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Parametrul afișează descreșterea penalizărilor la calificarea majoră pentru orice membru de echipaj la rănire (cu excepția comandantului)."

