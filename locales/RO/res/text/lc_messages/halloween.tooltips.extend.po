msgid "Contact/status/inBattle/halloween"
msgstr "Într-o luptă în Babylon: Turnul Întunecat"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Trage un proiectil care provoacă daune și șoc țintei și tuturor vehiculelor inamice dintr-o zonă cu raza de 35m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Trage un proiectil care reface puncte de integritate, furându-le de la țintă și de la vehiculele inamice apropiate dintr-o zonă cu raza de 35m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Trage un proiectil care provoacă șoc țintei și tuturor vehiculelor inamice dintr-o zonă cu raza de 35m."

msgid "advanced/hw_damageShield"
msgstr "Protejează la daune (exceptând coliziunea, înecul și impactul) timp de 7 secunde."

msgid "advanced/hw_fastReload"
msgstr "Crește cadența de tragere / reîncarcă magazia."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Restaurează puncte de integritate, stinge incendiul, elimină efectul de șoc și repară modulele avariate."

msgid "advanced/hw_invisibility"
msgstr "Face ca vehiculul să fie temporar invizibil față de inamici, restaurează puncte de integritate, repară instantaneu modulele, stinge incendiul, elimină efectul de șoc și vindecă toți membrii de echipaj."

msgid "advanced/hw_teamRepairKit"
msgstr "Repară module avariate, stinge incendiul, elimină efectul de șoc și reface o parte din punctele de integritate ale vehiculelor aliate din raza de acțiune."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Abilitățile de luptă te ajută să lupți mai eficient în luptele Babylon: Turnul Întunecat, să finalizezi obiective și să obții recompense valoroase. Pentru a le echipa, clic pe unul din locașurile de Abilități de luptă."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Locașurile Abilităților de luptă"

msgid "hwShell/alt/description"
msgstr "%(bold)s se poate găsi în luptă, cu o anumită probabilitate, după distrugerea unui inamic."

msgid "hwShell/alt/description/bold"
msgstr "Un proiectil alternativ"
