msgid "GB24_Centurion_Mk3_HW_BOT_descr"
msgstr "Tanc mediu cu mobilitate mediocră, blindaj frontal de încredere și tun excelent."

msgid "GB24_Centurion_Mk3_HW_BOT_short"
