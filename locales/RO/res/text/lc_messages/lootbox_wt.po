msgid "awardViews/footer/backButton/"
msgstr "Înapoi la module"

msgid "boxTooltip/description/text/wt"
msgstr "La deschidere, aceste module îți pot aduce vehicule premium, monede în joc sau alte recompense valoroase."

msgid "boxTooltip/howGet/text/wt"
msgstr "Poți cumpăra Module Paradox din Magazinul din joc sau Magazinul Premium."

msgid "common/boxCategory/lowerCase/wt"
msgstr "Modul paradox"

msgid "common/boxCategory/upperCase/wt"
msgstr "MODUL PARADOX"

