msgid "armorPatching/alt/description"
msgstr "Suferirea de daune întrerupe refacerea de HP.\n\nViteza de refacere a HP-ului și limita maximă de refacere se bazează pe totalul de HP al vehiculului, luând în considerare toți modificatorii aplicați."

msgid "armorPatching/alt/info"
msgstr "Pentru talentele de grup, nivelul mediu de antrenament al tuturor membrilor de echipaj este calculat. Acesta devine activ când e antrenat la minim 1%și îi crește eficiența cu antrenament suplimentar."

msgid "armorPatching/currentLvlDescription"
msgstr "Utilizarea unui set de piese de schimb reface %(hpRecover)s din {yellow_Start}HP-ul{yellow_End} vehiculului în 5 secunde, până la maxim 20% din HP-ul vehiculului per luptă. Permite utilizarea setului de piese de schimb fără daune critice."

msgid "armorPatching/hudDescription"
msgstr "Punctele de HP sunt refăcute."

msgid "armorPatching/maxLvlDescription"
msgstr "Când este antrenat complet pentru toți membrii echipajului, reface %(hpRecover)s din {yellow_Start}HP-ul{yellow_End} vehiculului în 5 secunde după utilizarea unui set de piese de schimb, până la maxim 20% per luptă. Permite utilizarea setului de piese de schimb fără daune critice."

msgid "armorPatching/name"
msgstr "Repararea blindajului"

msgid "armorPatching/shortDescription"
msgstr "@ Crește camuflajul de bază al vehiculului."

msgid "brotherhood/alt/description"
msgstr "Bonusul eficienței echipajului îmbunătățește eficiența membrului de echipaj în lupte, precum și eficiența tuturor talentelor, cu excepția bonusului. Acest parametru poate fi crescut prin instalarea de echipament sau consumabile cu efect similar, sau prin utilizarea directivei Evacuare forțată. Talentul Urgență al comandantului, precum și talentul Umăr la Umăr al transmisionistului sau talentul Expert în Comunicații pot crește valoarea acestui parametru."

msgid "brotherhood/alt/info"
msgstr "Pentru talentele de grup, nivelul mediu de antrenament al tuturor membrilor de echipaj este calculat. Acesta devine activ când e antrenat la minim 1% și îi crește eficiența cu antrenament suplimentar."

msgid "brotherhood/currentLvlDescription"
msgstr "{greenBright_Start}Bonusul de eficiență a echipajului{greenBright_End} pentru întreg echipajul a fost crescut cu %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/maxLvlDescription"
msgstr "Atunci când este complet antrenat de toți membrii de echipaj, crește {greenBright_Start}nivelul calificării majore{greenBright_End} al întregului echipaj cu %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/name"
msgstr "Frați de Arme"

msgid "brotherhood/shortDescription"
msgstr "Crește performanța generală a echipajului."

msgid "camouflage/alt/description"
msgstr "Acest talent afectează camuflajul vehiculului. Poate fi îmbunătățit mai departe cu directiva Adăpost natural.\n\nÎn plus, camuflajul vehiculului poate fi crescut prin aplicarea unui model de camuflaj sau a unui stil, precum și prin instalarea de echipament cu efect similar."

msgid "camouflage/alt/info"
msgstr "Pentru talentele de grup, nivelul mediu de antrenament al tuturor membrilor de echipaj este calculat. Acesta devine activ când e antrenat la minim 1% și îi crește eficiența cu antrenament suplimentar."

msgid "camouflage/currentLvlDescription"
msgstr "Crește {greenBright_Start}camuflajul{greenBright_End} cu %(maskingFactor)s&zwnbsp;."

msgid "camouflage/maxLvlDescription"
msgstr "Când este antrenat complet pentru toți membrii de echipaj, crește {greenBright_Start}camuflajul{greenBright_End} vehiculului cu %(maskingFactor)s&zwnbsp;."

msgid "camouflage/name"
msgstr "Camuflaj"

msgid "camouflage/shortDescription"
msgstr "Crește camuflajul de bază al vehiculului."

msgid "commander_coordination/alt/description"
msgstr "Efectul se activează de fiecare dată când un vehicul inamic este descoperit și nu se adună la descoperirea mai multor vehicule.\n\nViteza de țintire poate fi crescută mai departe prin antrenarea talentului Țintire Rapidă al tunarului sau prin instalarea de echipament cu efect similar."

msgid "commander_coordination/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "commander_coordination/currentLvlDescription"
msgstr "{yellow_Start}Viteza de țintire{yellow_End} va fi crescută cu %(vehicleGunAimSpeed)s timp de 15 secunde de la descoperirea de către tine a unui vehicul inamic."

msgid "commander_coordination/hudDescription"
msgstr "Viteza de țintire este crescută."

msgid "commander_coordination/maxLvlDescription"
msgstr "Când este antrenat complet, crește {yellow_Start}viteza de țintire{yellow_End} cu %(vehicleGunAimSpeed)s timp de 15 secunde de la descoperirea de către tine a unui vehicul inamic.\t"

msgid "commander_coordination/name"
msgstr "Coordonare"

msgid "commander_coordination/shortDescription"
msgstr "Viteza de țintire este crescută."

msgid "commander_eagleEye/alt/description"
msgstr "Raza vizuală poate fi crescută mai departe antrenând talentul Informaţii suplimentare al transmisionistului sau prin instalarea de echipament cu efect similar. Utilizarea directivei Calibrare optică îmbunătățește efectul."

msgid "commander_eagleEye/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "commander_eagleEye/currentLvlDescription"
msgstr "{greenBright_Start}Raza vizuală{greenBright_End} crește cu %(circularVisionRadius)s&zwnbsp;. {greenBright_Start}Penalizarea aparaturii de observare avariate{greenBright_End} este redusă cu %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/hudDescription"
msgstr "Penalizarea aparaturii de observare avariate este redusă."

msgid "commander_eagleEye/maxLvlDescription"
msgstr "Când este antrenat complet, crește {greenBright_Start}raza vizuală{greenBright_End} cu %(circularVisionRadius)s&zwnbsp; și reduce {greenBright_Start}penalizarea aparaturii de observare avariate{greenBright_End} cu %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/name"
msgstr "Recunoaștere"

msgid "commander_eagleEye/shortDescription"
msgstr "Crește raza vizuală, mai ales când aparatura de observare e avariată."

msgid "commander_emergency/alt/description"
msgstr "La daunele suferite repetat din partea unui inamic, efectul nu se compune. Bonusul eficienței echipajului îmbunătățește eficiența membrului de echipaj în lupte. Acest parametru poate fi crescut mai departe prin instalarea de echipament sau consumabile cu efect similar, sau prin utilizarea directivei Evacuare forțată. Talentul de grup Frați de arme, precum și talentul Umăr la Umăr și Expert în Comunicații ale transmisionistului pot crește de asemenea acest parametru."

msgid "commander_emergency/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "commander_emergency/currentLvlDescription"
msgstr "{yellow_Start}Bonusul de eficiență a echipajului{yellow_End} va fi crescut cu %(crewLevelIncrease)s timp de 15 secunde de la suferirea de daune din partea unui inamic."

msgid "commander_emergency/hudDescription"
msgstr "Bonusul de eficiență a echipajului este crescut."

msgid "commander_emergency/maxLvlDescription"
msgstr "Când este antrenat complet, {yellow_Start}bonusul de eficiență a echipajului{yellow_End} va fi crescut cu %(crewLevelIncrease)s timp de 15 secunde de la suferirea de daune din partea unui inamic."

msgid "commander_emergency/name"
msgstr "Urgență"

msgid "commander_emergency/shortDescription"
msgstr "Bonusul de eficiență a echipajului este crescut."

msgid "commander_enemyShotPredictor/alt/description"
msgstr "O alertă a focului de artilerie inamic este activată cu o mică întârziere față de momentul focului.\n\nTalentul poate fi îmbunătățit cu directiva Vigilență Crescută."

msgid "commander_enemyShotPredictor/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "commander_enemyShotPredictor/currentLvlDescription"
msgstr "O {yellow_Start}alertă a focului de artilerie inamic{yellow_End} și direcția din care a fost tras proiectilul va fi creată cu o întârziere de\n%(artNotificationDelayFactor)s.{greenBright_Start} Efectul negativ al șocului{greenBright_End} scade cu %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/maxLvlDescription"
msgstr "Când este antrenat complet, generează o {yellow_Start}alertă legată de focul de artilerie inamic{yellow_End} cu o întârziere de %(artNotificationDelayFactor)s și determină direcția loviturii. Descrește {greenBright_Start}efectul negativ al șocului{greenBright_End} cu %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/name"
msgstr "Detecția sonoră"

msgid "commander_enemyShotPredictor/shortDescription"
msgstr "Indică un foc al unei artilerii inamice."

msgid "commander_holdLine/alt/description"
msgstr "Bonusul de eficiență a echipajului îmbunătățește eficiența în luptă a membrului de echipaj.\n\nAcest parametru poate fi crescut suplimentar prin instalarea de echipament sau consumabile cu efect similar sau prin utilizarea directivei Evacuare forțată. Diverse alte talente de echipaj pot crește acest parametru."

msgid "commander_holdLine/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "commander_holdLine/currentLvlDescription"
msgstr "{yellow_Start}Bonusul de eficiență a echipajului{yellow_End} va crește cu %(crewLevelIncrease)satâta timp cât echipa inamică are în luptă cu minim trei vehicule în plus față de echipa proprie&zwnbsp;."

msgid "commander_holdLine/hudDescription"
msgstr "Bonusul de eficiență a echipajului este crescut (inamicul e majoritar)."

msgid "commander_holdLine/maxLvlDescription"
msgstr "Când este antrenat complet, crește {yellow_Start}bonusul de eficiență a echipajului{yellow_End} cu %(crewLevelIncrease)satâta timp cât echipa inamică are în luptă cu minim trei vehicule în plus față de echipa proprie&zwnbsp;."

msgid "commander_holdLine/name"
msgstr "Menținerea Liniei"

msgid "commander_holdLine/shortDescription"
msgstr "@ Crește bonusul de eficiență a echipajului"

msgid "commander_practical/alt/description"
msgstr "Talentul funcționează cu toate tipurile de consumabile instalate pe vehicul.\n\nEfectul său poate fi crescut mai departe cu ajutorul directivei Pregătire completă."

msgid "commander_practical/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "commander_practical/currentLvlDescription"
msgstr "{greenBright_Start}Timpul de refacere al consumabilelor{greenBright_End} este redus cu %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/maxLvlDescription"
msgstr "Când este antrenat complet, descrește {greenBright_Start}numărătoarea inversă a consumabilelor{greenBright_End} cu %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/name"
msgstr "Practică"

msgid "commander_practical/shortDescription"
msgstr "Descrește numărătoarea inversă a consumabilelor."

msgid "commander_sixthSense/alt/description"
msgstr "Al Șaselea Simț este dezactivat dacă comandantul este rănit. Perioada până la activare poate fi redusă prin talentul Interceptarea Semnalului al transmisionistului."

msgid "commander_sixthSense/alt/info"
msgstr "Este o caracteristică specială a comandantului care nu are nevoie de antrenament și este disponibilă implicit."

msgid "commander_sixthSense/currentLvlDescription"
msgstr "Îi permite comandantului să identifice dacă vehiculul a fost descoperit de inamic. Se activează la %(delay)s după descoperirea vehiculului."

msgid "commander_sixthSense/name"
msgstr "Al şaselea simţ"

msgid "commander_sixthSense/shortDescription"
msgstr "Îi permite comandantului să afle dacă vehiculul a fost descoperit de inamic."

msgid "commander_staySharp/alt/description"
msgstr "Bonusul de eficiență a echipajului îmbunătățește eficiența în luptă a membrului de echipaj.\n\nAcest parametru poate fi crescut suplimentar prin instalarea de echipament sau consumabile cu efect similar sau prin utilizarea directivei Evacuare forțată. Diverse alte talente de echipaj pot crește acest parametru."

msgid "commander_staySharp/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "commander_staySharp/currentLvlDescription"
msgstr "{yellow_Start}Bonusul de eficiență a echipajului{yellow_End} va crește cu %(crewLevelIncrease)s timp de 15&nbsp;s după utilizarea unei truse de prim ajutor. Permite utilizarea unei truse de prim ajutor chiar dacă niciun membru de echipaj nu este rănit&zwnbsp;."

msgid "commander_staySharp/hudDescription"
msgstr "Bonusul de eficiență a echipajului este crescut (s-a utilizat trusa de prim ajutor)."

msgid "commander_staySharp/maxLvlDescription"
msgstr "Când este antrenat complet, {yellow_Start}bonusul de eficiență a echipajului{yellow_End} crește cu %(crewLevelIncrease)s timp de 15 s după utilizarea unei truse de prim ajutor. Permite utilizarea unei truse de prim ajutor chiar dacă niciun membru de echipaj nu este rănit&zwnbsp;."

msgid "commander_staySharp/name"
msgstr "Atenție sporită"

msgid "commander_staySharp/shortDescription"
msgstr "@ Crește bonusul de eficiență a echipajului"

msgid "commander_tutor/alt/description"
msgstr "Un comandant rănit nu poate înlocui alt membru de echipaj. Bonusul se aplică doar cantității de bază de EXP de echipaj obținută în luptă.\n\nEXP suplimentară de echipaj poate fi primită utilizând cărți de echipaj sau prin conversia de EXP liberă în EXP de echipaj."

msgid "commander_tutor/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "commander_tutor/currentLvlDescription"
msgstr "Cantitatea de {greenBright_Start}EXP{greenBright_End} obținută este crescută cu %(xpBonusFactorPerLevel)s pentru toți membrii de echipaj. Comandantul poate {greenBright_Start}înlocui membrii de echipaj scoși din uz{greenBright_End} cu eficiență de %(woundedCrewEfficiency)s."

msgid "commander_tutor/hudDescription"
msgstr "Membrul de echipaj scos din uz este înlocuit de comandant."

msgid "commander_tutor/maxLvlDescription"
msgstr "Când este antrenat complet, crește cantitatea de {greenBright_Start}EXP{greenBright_End} obținută cu %(xpBonusFactorPerLevel)s pentru toți membrii de echipaj. Comandantul va {greenBright_Start}înlocui membrii de echipaj scoși din uz{greenBright_End} cu eficiență de %(woundedCrewEfficiency)s."

msgid "commander_tutor/name"
msgstr "Mentor"

msgid "commander_tutor/shortDescription"
msgstr "Membrul de echipaj scos din uz este înlocuit de comandant."

msgid "commander_universalist/alt/description"
msgstr "Comandantul poate înlocui doar calificarea majoră a membrului de echipaj rănit. Efectul înlocuirii se diminuează pentru fiecare membru de echipaj rănit."

msgid "commander_universalist/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%. Eficiența sa crește cu antrenament ulterior."

msgid "commander_universalist/currentLvlDescription"
msgstr "Comandantul poate {greenBright_Start}înlocui membrii de echipaj răniți{greenBright_End} cu eficiență de %(woundedCrewEfficiency)s."

msgid "commander_universalist/hudDescription"
msgstr "Comandantul îndeplinește rolul membrului de echipaj rănit."

msgid "commander_universalist/maxLvlDescription"
msgstr "Când este antrenat complet, îi permite comandantului să {greenBright_Start}înlocuiască membrii de echipaj răniți{greenBright_End} cu eficiență de %(woundedCrewEfficiency)s."

msgid "commander_universalist/name"
msgstr "Bun la toate"

msgid "commander_universalist/shortDescription"
msgstr "Îi permite comandantului să înlocuiască membrii de echipaj răniți."

msgid "driver_badRoadsKing/alt/description"
msgstr "Reduce penalizarea manevrabilității vehiculului la condusul pe teren moderat-moale. Descrește semnificativ aceste penalizări la condusul pe teren moale, aducându-le în linie cu cele pentru condusul pe teren moderat-moale.\nManevrabilitatea pe teren moderat-moale și moale nu poate fi mai bună decât cea pe teren tare."

msgid "driver_badRoadsKing/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "driver_badRoadsKing/currentLvlDescription"
msgstr "{greenBright_Start}Pierderea de viteză pe teren moderat moale{greenBright_End} este redusă cu %(mediumGroundFactor)s&zwnbsp;, {greenBright_Start}pierderea de viteză pe teren moale{greenBright_End} este redusă la %(softGroundFactor)s din valoarea rezultată pentru teren moderat moale."

msgid "driver_badRoadsKing/maxLvlDescription"
msgstr "Când este antrenat complet, {greenBright_Start}pierderea de viteză pe teren moderat moale{greenBright_End} este redusă cu %(mediumGroundFactor)s&zwnbsp;, {greenBright_Start}pierderea de viteză pe teren moale{greenBright_End} este redusă la %(softGroundFactor)s din valoarea rezultată pentru teren moderat moale."

msgid "driver_badRoadsKing/name"
msgstr "Şofer tot-teren"

msgid "driver_bulletproof/alt/description"
msgstr "Bonusul de eficiență a echipajului îmbunătățește eficiența în luptă a membrului de echipaj.\n\nAcest parametru poate fi crescut suplimentar prin instalarea de echipament sau consumabile cu efect similar sau prin utilizarea directivei Evacuare forțată. Diverse alte talente de echipaj pot crește acest parametru."

msgid "driver_bulletproof/alt/info"
msgstr "Un talent cu efect situațional devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior. Efectul situațional se activează la îndeplinirea anumitor condiții în luptă."

msgid "driver_bulletproof/currentLvlDescription"
msgstr "{yellow_Start}Bonusul de eficiență a echipajului{yellow_End} va crește cu %(crewLevelIncrease)s dacă totalul daunelor blocate depășește cantitatea inițială de puncte de integritate ale vehiculului propriu."

msgid "driver_bulletproof/hudDescription"
msgstr "Bonusul de eficiență a echipajului este crescut (suficiente daune au fost blocate)."

msgid "driver_bulletproof/maxLvlDescription"
msgstr "Când este antrenat complet, {yellow_Start}bonusul de eficiență a echipajului{yellow_End} crește cu %(crewLevelIncrease)s dacă totalul daunelor blocate depășește cantitatea inițială de puncte de integritate ale vehiculului propriu."

msgid "driver_bulletproof/name"
msgstr "Impenetrabil"

msgid "driver_motorExpert/alt/description"
msgstr "Viteza maximă a vehiculului poate fi crescută mai mult, iar penalizarea motorului avariat poate fi redusă mai mult prin instalarea de echipament cu efect similar."

msgid "driver_motorExpert/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "driver_motorExpert/currentLvlDescription"
msgstr "Vitezele de {greenBright_Start}înaintare{greenBright_End} și {greenBright_Start}marșarier{greenBright_End} ale vehiculului cresc cu %(vehicleForwardMaxSpeed)s. {greenBright_Start}penalizarea motorului avariat{greenBright_End} este redusă cu %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/hudDescription"
msgstr "Penalizarea motorului avariat este redusă."

msgid "driver_motorExpert/maxLvlDescription"
msgstr "Când este antrenat complet, vitezele de {greenBright_Start}înaintare{greenBright_End} și {greenBright_Start}marșarier{greenBright_End} ale vehiculului cresc cu %(vehicleForwardMaxSpeed)s. {greenBright_Start}Penalizarea motorului avariat{greenBright_End} este redusă cu %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/name"
msgstr "Inginer"

msgid "driver_motorExpert/shortDescription"
msgstr "Penalizarea motorului avariat este redusă."

msgid "driver_rammingMaster/alt/description"
msgstr "Talentul e ineficient atunci când două vehicule aliate intră în coliziune.\n\nDaunele prin coliziune suferite de vehiculul tău pot fi reduse mai mult prin instalarea de echipament cu efect similar."

msgid "driver_rammingMaster/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "driver_rammingMaster/currentLvlDescription"
msgstr "{greenBright_Start}Daunele prin coliziune asupra vehiculelor inamice{greenBright_End} cresc cu %(damageEnemiesByRamming)s&zwnbsp;. {greenBright_Start}Daunele prin coliziune suferite de vehiculul propriu{greenBright_End} sunt reduse cu %(vehicleRamDamageResistance)s&zwnbsp; și cele suferite de {greenBright_Start}suspensie{greenBright_End} cu %(vehicleRamChassisDamageResistance)s&zwnbsp;."

msgid "driver_rammingMaster/maxLvlDescription"
msgstr "Când este antrenat complet, {greenBright_Start}daunele prin coliziune asupra vehiculelor inamice{greenBright_End} cresc cu %(damageEnemiesByRamming)s&zwnbsp;. {greenBright_Start}Daunele prin coliziune suferite de vehiculul propriu{greenBright_End} sunt reduse cu %(vehicleRamDamageResistance)s&zwnbsp; și cele suferite de {greenBright_Start}suspensie{greenBright_End} cu %(vehicleRamChassisDamageResistance)s&zwnbsp;."

msgid "driver_rammingMaster/name"
msgstr "Impact controlat"

msgid "driver_rammingMaster/shortDescription"
msgstr "Reduce daunele suferite la coliziune și crește daunele provocate la coliziunea cu un vehicul inamic."

msgid "driver_reliablePlacement/alt/description"
msgstr "Daunele suferite de la proiectilele HE pot fi reduse suplimentar prin instalarea de echipament cu efect similar."

msgid "driver_reliablePlacement/alt/info"
msgstr "Un talent devine activ atunci când este antrenat la minim 1%, iar eficiența sa crește cu antrenament ulterior."

msgid "driver_reliablePlacement/currentLvlDescription"
msgstr "{greenBright_Start}Absorbția daunelor proiectilelor HE{greenBright_End} este crescută cu %(vehicleHEShellDamageResistance)s&zwnbsp;. &nbsp;{greenBright_Start}Riscul de incendiu la motor{greenBright_End} este redus cu %(vehicleFireChance)s și cel al {greenBright_Start}daunelor la suspensie{greenBright_End} cu %(suspensionDamageReduction)s&zwnbsp;."

msgid "driver_reliablePlacement/maxLvlDescription"
