msgid "vo_sm_char08_m05_stg01_13"
msgstr "Pilot de Spitfire: Vizibilitate scăzută, nu pot ajuta!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Pilot de Spitfire: Foc AA intens, nu pot ajuta!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Pilot de Spitfire: Foc puternic AA, nu pot ajusta tragerea."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Pilot de Spitfire: E furtună de șrapnele pe-aici, nu?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Pilot de Spitfire: Nu putem ajusta focul navei cu barajul ăsta."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Pilot de Spitfire: Bateriile AA de lângă buncăre trebuie distruse."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Pilot de Spitfire: Am reușit să cobor."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Pilot de Spitfire: Acum pot începe să ghidez loviturile tunurilor mari cu ajutorul semnalelor de fum."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Pilot de Spitfire: Mulțumesc, e rândul tău!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Pilot de Spitfire: Am reperat fumul."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Pilot de Spitfire: Trimit coordonatele cuirasatului pentru lovitura directă."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Pilot de Spitfire: La naiba, unul dintre ai noștri s-a prăbușit! Încă nu pot coborî."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Pilot de Spitfire: Încă un tun AA trebuie distrus chiar acum!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Pilot de Spitfire: Tunurile AA distruse, cobor. Sunt pregătit să redirecționez focul mai dens de pe cuirasat."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Pilot de Spitfire: Atenție! Un grup mare de inamici se deplasează către voi."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Pilot de Spitfire: Aruncă în luptă tot ce pot."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Pilot de Spitfire: Atenție, un grup nou de inamici se apropie. Rămâi în alertă."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Pilot de Spitfire: Atenție, ultimul și cel mai mare grup de inamici se apropie."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Pilot de Spitfire: Se apropie din toate direcțiile. Pregătiți-vă."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Pilot de Spitfire: Văd clar semnalul de fum. Coordonatele sunt trimise cuirasatului."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Pilot de Spitfire: Ah, iată marcajul de fum. Trimit localizarea către cuirasat."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Pilot de Spitfire: Fumul se ridică în zona țintei. Trimit locul exact către cuirasat."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Pilot de Spitfire: Văd fumul, prietenii noștri au nevoie de ajutor."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Comandant USS Frankford: Aștept coordonatele pentru foc de asistență."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Comandant USS Frankford: Focul în orb e periculos, putem lovi aliații."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Comandant USS Frankford: Avem nevoie ținte precise, suntem în așteptare."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Comandant USS Frankford: Aici comandantul USS Frankford. Negativ."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Comandant USS Frankford: Nu pot asista ofensiva. Vizibilitate redusă."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Comandant USS Frankford: Nu vedem crestele și buncărele, sunt vizibile doar tancurile de pe plajă."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Comandant USS Frankford: Observăm tancuri care avansează spre creste."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Comandant USS Frankford: Vom asista cu foc în acea direcție."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Comandant USS Frankford: Să sperăm că acest Sherman știe încotro trage."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Comandant USS Frankford: Sherman a schimbat ținta. Ajustăm asistența."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Comandant USS Frankford: Sherman a încetat focul. Munca noastră s-a încheiat."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Comandant USS Frankford: Nu putem ajunge la buncărele dinspre interior."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Comandant USS Frankford: Ne retragem la distanță sigură. Baftă pe țărm."

