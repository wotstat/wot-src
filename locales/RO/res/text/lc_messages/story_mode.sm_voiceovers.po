msgid "vo_sm_char10_m05_stg21_02"
msgstr "Ofițer CG: Capul de plajă Echo-5 asigurat. Tancurile avansează. Oferiți asistență prin foc."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Ofițer CG: redirecționați asistența aeriană către ofensiva tancurilor."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Ofițer CG: Echipele de geniști, curățați obstacolele pentru ofensiva ulterioară."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Ofițer CG: Plaja e curățată. Trimitem forțele principale. Excelentă acțiune."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Ofițer CG: Mențineți poziția. Întăririle sunt pe drum."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Ofițer CG: Protejați capul de plajă cu orice preț."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Ofițer CG: Încă un tanc, încă o șansă. Aveți grijă de data aceasta."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Ofițer CG: Rezervele sunt pe terminate. Trebuie să reușești acum, comandante."

