msgid "entryPoint/boxes"
msgstr "SPRE COMORI"

msgid "entryPoint/tooltip/description"
msgstr "Acestea sunt cutii speciale care conțin articole noi și unice, inclusiv vehicule premium, stiluri 2D și multe altele. Le poți obține din Magazinul din joc."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Comorile arzătoare nu pot fi deschise sau cumpărate momentan, din motive tehnice. Oferim scuze pentru neplăcerea temporară."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Comorile arzătoare sunt momentan indisponibilă"

