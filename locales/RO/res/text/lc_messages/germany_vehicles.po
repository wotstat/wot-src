msgid "Pz38t_Standardketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. A"

msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Dezvoltat de compania ČKD pentru armata cehoslovacă, în 1938. În timpul ocupației germane, vehiculul a intrat în dotarea Wehrmacht și a fost folosit în campaniile din Polonia și Franța, precum și pe Frontul de est. Tancul a participat la lupte în prima linie până la mijlocul lui 1942. Aproximativ 1400 de vehicule, în opt versiuni (Ausf. A/B/C/D/E/F/S/G), au fost fabricate."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

