msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Tanc experimental dezvoltat din AMX 13. A participat la teste dar nu a fost produs în masă şi nici nu a participat la lupte. Două vehicule produse."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

