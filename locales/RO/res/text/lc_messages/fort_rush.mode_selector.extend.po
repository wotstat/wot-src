msgid "mode/fort_rush_battle/description"
msgstr "Preia controlul antenelor. Menține controlul rețelei. Asigură transmisiunea."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Performanțele computerului tău sunt insuficiente pentru acest mod. Poți avea probleme de grafică și cu mișcarea vehiculului. Sunt posibile și erori ale clientului de joc."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Performanță scăzută"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Performanță scăzută"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Acest mod necesită un computer foarte performant. Vei avea probleme cu încărcarea hărții, grafica și mișcarea vehiculului. Dacă performanța e insuficientă, poți încerca să reduci calitatea grafică în Setări."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Performanță redusă"

