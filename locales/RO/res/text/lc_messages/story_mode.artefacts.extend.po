msgid "battleship/name"
msgstr "Semnal de fum"

msgid "battleship/shortDescr"
msgstr "Un semnal de fum care marchează o zonă pentru o salvă de artilerie navală care provoacă daune obiectelor și echipamentului inamic aflate acolo."

msgid "distraction_ability/name"
msgstr "Ordin fals"

msgid "distraction_ability/shortDescr"
msgstr "Pune-l pe Gefr. Keller să utilizeze stația radio germană capturată pentru a transmite un ordin fals, trimițându-i pe inamici să investigheze o anumită locație."

msgid "recon_ability/name"
msgstr "Cercetare"

msgid "recon_ability/shortDescr"
msgstr "Trimite-l pe Capt. Dubois în recunoaștere către o anumită locație. Pe perioada recunoașterii, tancul se oprește și rămâne staționar. Abilitatea continuă până la anulare."

msgid "scc_airstrike_ability/name"
msgstr "Suport Aerian"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Cheamă un bombardament aerian asupra unei poziții desemnate."
