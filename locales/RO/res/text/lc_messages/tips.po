msgid "battlePassSeasonDescription"
msgstr "Stiluri 3D tematice noi"

msgid "beCareful"
msgstr "Ai grijă"

msgid "comp7Core10"
msgstr "Poți schimba cu un vehicul mai potrivit în pregătirea pre-luptă."

msgid "comp7Core10Status"
msgstr "Pregătirea pre-luptă"

msgid "comp7Core11"
msgstr "Ecranul „Pregătirea pre-luptă” afișează vehiculele tale împreună cu echipaje și proiectile. Nu uita să le pregătești înainte de a intra în luptă."

msgid "comp7Core11Status"
msgstr "Pregătirea pre-luptă"

msgid "comp7Core12"
msgstr "După ce ai selectat vehiculul, anunță-ți aliații apăsând butonul „Confirmă selecția”."

msgid "comp7Core12Status"
msgstr "Pregătirea pre-luptă"

msgid "comp7Core13"
msgstr "După apăsarea butonului „Confirmă selecția”, nu vei putea schimba vehiculele."

msgid "comp7Core13Status"
msgstr "Confirmă selecția"

msgid "comp7Core14"
msgstr "Capturează puncte speciale de pe hartă pentru a accesa Abilități tactice și a avea un avantaj!"

msgid "comp7Core14Status"
msgstr "Punctele de interes"

msgid "comp7Core15"
msgstr "Un Punct de interes de pe hartă. Capturarea acestei zone îți va permite să utilizezi Abilitatea tactică „Radar de divizie”. La activare, toate vehiculele inamice vor fi descoperite timp de câteva secunde."

msgid "comp7Core15Status"
msgstr "Centrul de Comunicații"

msgid "comp7Core16"
msgstr "Un Punct de interes de pe hartă. Capturarea acestei zone îți va permite să utilizezi Abilitatea tactică „Lovitură de artilerie”. La activare, jucătorul poate selecta o zonă care să fie lovită de un baraj de artilerie."

msgid "comp7Core16Status"
msgstr "Centrul de Comandă al Artileriei"

msgid "comp7Core17"
msgstr "Dacă Abilitatea tactică „Lovitură de artilerie” lovește un aliat, acesta nu va suferi daune, însă va suferi șoc."

msgid "comp7Core17Status"
msgstr "Lovitură de artilerie"

msgid "comp7Core18"
msgstr "Reține: Hărțile din acest mod sunt diferite față de cele cu același nume din luptele standard."

msgid "comp7Core18Status"
msgstr "Hărțile evenimentului"

msgid "comp7Core19"
msgstr "Crearea unui pluton cu 7 jucători îți poate îmbunătăți șansele de câștig."

msgid "comp7Core19Status"
msgstr "Jocul în echipă este cheia"

msgid "comp7Core21"
msgstr "Poți verifica în luptă nivelul de încărcare al Abilităților de rol ale aliaților apăsând tastele Tab sau Alt."

msgid "comp7Core21Status"
msgstr "Abilitățile de rol ale aliaților"

msgid "comp7Core22"
msgstr "Poți verifica lista echipelor pentru a vedea dacă aliații tăi au primit abilități tactice. Abilitățile tactice ale inamicilor nu sunt afișate."

msgid "comp7Core22Status"
msgstr "Abilitățile tactice"

msgid "comp7Core23"
msgstr "Dacă o Abilitate de rol afectează un vehicul, se va afișa o iconiță corespunzătoare deasupra marcajului jucătorului."

msgid "comp7Core23Status"
msgstr "Efectele Abilităților de rol"

msgid "comp7Core24"
msgstr "Tasta (implicită) H activează chat-ul vocal. Folosește această caracteristică pentru a comunica mai eficient cu echipa."

msgid "comp7Core24Status"
msgstr "Chat-ul vocal"

msgid "comp7Core25"
msgstr "Dacă ai probleme cu chat-ul vocal, verifică setările din clientul jocului."

msgid "comp7Core25Status"
msgstr "Chat-ul vocal"

msgid "comp7Core29"
msgstr "La apăsarea tastei Alt, rolurile tuturor vehiculelor din raza ta vizuală vor fi afișate deasupra marcajului jucătorilor. În cazul jucătorilor aliați, vei vedea de asemenea și nivelul de încărcare al Abilităților de rol."

msgid "comp7Core29Status"
msgstr "Rolurile vehiculelor"

msgid "comp7Core31"
msgstr "Poți reasigna în setările jocului taste pentru Abilitățile tactice și de rol."

msgid "comp7Core31Status"
msgstr "Setările de taste"

msgid "comp7Core32"
msgstr "Vei putea recaptura un Punct de interes după un anumit timp."

msgid "comp7Core32Status"
msgstr "Despre Punctele de interes"

msgid "comp7Core33"
msgstr "Nu poți captura un Punct de interes până nu folosești Abilitatea tactică corespunzătoare."

msgid "comp7Core33Status"
msgstr "Despre Punctele de interes"

msgid "comp7Core34"
msgstr "Capturarea unui Punct de interes îți aduce un anumit număr de Puncte de prestigiu."

msgid "comp7Core34Status"
msgstr "Despre Punctele de interes"

msgid "comp7Core35"
msgstr "Verifică regulile evenimentului pentru a afla mai multe despre obținerea de Puncte de prestigiu."

msgid "comp7Core35Status"
msgstr "Despre Punctele de prestigiu"

msgid "comp7Core37"
msgstr "Modul are modificatori care schimbă anumiți parametri ai vehiculelor, precum punctele de integritate, perioada de refacere a consumabilelor, perioada de vizibilitate și multe altele."

msgid "comp7Core37Status"
msgstr "Modificatorii Violență"

msgid "comp7Core5"
msgstr "În funcție de rol, fiecare vehicul are o abilitate specială cu trei nivele de încărcare. Cu cât mai mare este nivelul de încărcare la activarea abilității, au atât mai puternic este efectul."

msgid "comp7Core5Status"
msgstr "Despre Abilitățile de rol"

msgid "comp7Core6"
msgstr "Punctele de prestigiu pot fi obținute pentru performanță impresionantă în lupte, capturarea de Puncte de interes, utilizarea de abilități, etc."

msgid "comp7Core6Status"
msgstr "Despre Punctele de prestigiu"

msgid "comp7Core8"
msgstr "Jucătorii nu vor avea informații despre vehiculele inamice până la descoperirea acestora."

msgid "comp7Core8Status"
msgstr "Ceața de război"

msgid "comp7Light7"
msgstr "Poți afla mai multe despre modul „Violență Simplificată” dând clic pe butonul „DESPRE EVENIMENT” din ecranul evenimentului."

msgid "comp7Light7Status"
msgstr "Detaliile modului"

msgid "comp7Light9"
msgstr "Cu o colecție de vehicule de generația VIII cu diferite roluri, poți mereu alege cele mai potrivite vehicule pentru o luptă și să te adaptezi față de vehiculele aliate."

msgid "comp7Light9Status"
msgstr "Extindere Garaj"

msgid "comp7Ranked0"
msgstr "Luptă pentru Puncte de clasament pentru a atinge cele mai înalte grade și a-ți demonstra superioritatea."

msgid "comp7Ranked0Status"
msgstr "Sistemul de grade"

msgid "comp7Ranked1"
msgstr "Cu cât mai multe Puncte de prestigiu obții în lupte, cu atât mai multe Puncte de clasament vei primi la victorie și cu atât mai puține vei pierde la înfrângere."

msgid "comp7Ranked1Status"
msgstr "Punctele de prestigiu și Punctele de clasament"

msgid "comp7Ranked2"
msgstr "În modul Violență, luptele se poartă între jucători cu grade asemănătoare."

msgid "comp7Ranked20"
msgstr "Părăsirea luptei înainte ca aceasta să se încheie îți dezavantajează aliații. Această acțiune se pedepsește cu o suspendare temporară și eliminarea de Puncte de clasament."

msgid "comp7Ranked20Status"
msgstr "Dezertarea"

msgid "comp7Ranked26"
msgstr "În Clasament sunt afișați doar jucătorii cu gradele Campion și Legendă. Toți jucătorii care ajung în Clasament vor primi recompense zilnice."

msgid "comp7Ranked26Status"
msgstr "Clasamentul"

msgid "comp7Ranked27"
msgstr "Dezertorii vor fi suspendați temporar de la participarea la modul jocului. Durata suspendării va crește pentru fiecare încălcare ulterioară."

msgid "comp7Ranked27Status"
msgstr "Suspendarea temporară"

msgid "comp7Ranked28"
msgstr "Luptă în modul jocului pentru a debloca elemente noi ale stilului progresiv „Violență”."

msgid "comp7Ranked28Status"
msgstr "Stilul progresiv"

msgid "comp7Ranked2Status"
msgstr "Jucătorii valoroși"

msgid "comp7Ranked3"
msgstr "Gradul Legendă se acordă doar celor mai buni dintre jucători. Pentru atingerea acestui grad trebuie să te clasezi în top 10% jucători din Clasament după Punctele de clasament obținute."

msgid "comp7Ranked36"
msgstr "Reține: Dacă părăsești o luptă înainte de încheierea acesteia, vei pierde mai multe Puncte de clasament decât în cea mai grozavă înfrângere."

msgid "comp7Ranked36Status"
msgstr "Dezertarea"

msgid "comp7Ranked3Status"
msgstr "Legendă"

msgid "comp7Ranked4"
msgstr "Dacă întrerupi participarea la acest mod, vei pierde Puncte de clasament. Această regulă se aplică gradelor Argint, Aur, Campion și Legendă."

msgid "comp7Ranked4Status"
msgstr "Inactivitatea de grad"

msgid "comp7Ranked7"
msgstr "Poți afla mai multe despre modul „Violență” dând clic pe butonul „DESPRE EVENIMENT” din ecranul evenimentului."

msgid "comp7Ranked7Status"
msgstr "Detaliile modului"

msgid "comp7Ranked9"
msgstr "Cu o colecție de vehicule de generația X cu diferite roluri, poți mereu alege cele mai potrivite vehicule pentru o luptă și să te adaptezi față de vehiculele aliate."

msgid "comp7Ranked9Status"
msgstr "Extindere Garaj"

msgid "devMaps0"
msgstr "Zona evenimentului aleatoriu va fi marcată cu\nfum pe hartă și un marcaj pe mini-hartă.\nHărțile cu evenimente aleatorii pot fi dezactivate în setările din tab-ul „Joc”."

msgid "devMaps0Status"
msgstr "Hărțile cu evenimente aleatorii"

msgid "devMaps1"
msgstr "Vehiculul tău poate fi distrus într-o zonă cu eveniment aleatoriu (de exemplu, în timpul prăbușirii unui avion).\nHărțile cu evenimente aleatorii pot fi dezactivate în setările din tab-ul „Joc”."

msgid "devMaps1Status"
msgstr "Hărțile cu evenimente aleatorii"

msgid "dualGunVehicles"
msgstr "Vehicule cu sistem de tun cu două țevi"

msgid "epicModeHiddenFeatures"
msgstr "Stăpânește Frontul"

msgid "epicModeIntroduction"
msgstr "Facilități mod"

msgid "epicModeUseful"
msgstr "Învață Frontul"

msgid "epicRandom0"
msgstr "E posibil să observi probleme minore de performanţă în acest mod de luptă."

msgid "epicTip1"
msgstr "Când o bază este capturată, toate vehicule din echipa din apărare care rămân în zonă sunt ținta unui bombardament."

msgid "epicTip10"
msgstr "În plus față de faimă și glorie, gradele îți aduc și bonusuri utile după fiecare luptă."

msgid "epicTip11"
msgstr "Modul Front include o mulțime de noi moduri de a câștiga EXP și credite."

msgid "epicTip12"
msgstr "Frontul poate fi mutat împingând înapoi cealaltă echipă. Aceasta vă va permite să reapăreți în luptă mai aproape de obiectiv."

msgid "epicTip13"
msgstr "Când i se provoacă daune unui vehicul din interiorul cercului de captură, pprogresul capturii pentru acel vehicul este suspendat pentru un timp."

msgid "epicTip14"
msgstr "Activează și crește-ți Rezervele de luptă pe ecranul special. Folosește-le să faci distrugeri pe câmpul de luptă."

msgid "epicTip15"
msgstr "Poți oricând să schimbi fronturile pe ecranul de Reapariție dacă situația strategică o cere."

msgid "epicTip16"
msgstr "Nu intra în zonele protejate. Instalațiile de artilerie inamică vor începe să tragă în tine."

msgid "epicTip17"
msgstr "Ești blocat undeva pe hartă? Utilizează funcționalitatea de Abandon (implicit J) pentru a părăsi vehiculul și a începe din nou."

msgid "epicTip18"
msgstr "Deschide o versiune mărită a hărții (implicit M) pentru a vedea mai bine câmpul de luptă."

msgid "epicTip19"
msgstr "Vei putea comunica doar cu aliații vizibili pe hartă."

msgid "epicTip2"
msgstr "Frontul oferă o mulțime de recompense dacă vrei să câștigi în plus."

msgid "epicTip20"
msgstr "Poți ajusta zona vizibilă pe mini hartă cu rotița mouse-ului în timp ce ești cu cursorul deasupra acesteia."

msgid "epicTip21"
msgstr "Poți selecta baze sau obiective pentru coechipieri dând clic pe ele pe mini hartă."

msgid "epicTip22"
msgstr "Când rămâi fără tancuri poți încerca modul Cameră liberă. În acest fel îți poți planifica strategia până când te poți întoarce în luptă."

msgid "epicTip23"
msgstr "Când o bază este capturată și timpul de luptă expiră, meciul intră în prelungiri. Lupta va continua până când toate bazele sunt în situație clară."

msgid "epicTip3"
msgstr "În modul Front, câmpul de luptă este de 9 km², adisă de nouă ori mărimea unei hărți din modul standard."

msgid "epicTip4"
msgstr "Perioada luptei crește de fiecare dată când o zonă este capturată. Ultima zonă acordă timp suplimentar."

msgid "epicTip5"
msgstr "Dacă vehiculul tău a fost distrus în luptă, va avea nevoie de timp pentru reparații. Alege alt vehicul și reintră în luptă."

msgid "epicTip6"
msgstr "Un vehicul în plus este adăugat la rezerve la fiecare 5 minute."

msgid "epicTip7"
msgstr "Atacanții pot intra doar într-o zonă din a doua linie atunci când o zonă din prima linie din același front este capturată."

msgid "epicTip8"
msgstr "Când toate zonele din prima linie sunt capturate, toate zonele din a doua linie sunt slăbite."

msgid "epicTip9"
msgstr "Poți câștiga o luptă eliminând întreaga echipă inamică. totuși, acest lucru e FOARTE improbabil."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Respectă regulile"

msgid "howToPlay"
msgstr "Cum se joacă"

msgid "mapbox0"
msgstr "Vehiculele aflate într-o zonă locală de vreme rea nu pot descoperi vehicule aflate în afara zonei și viceversa; de asemenea, nu pot schimba informații legate de pozițiile vehiculelor inamice din afara zonei. Focul provoacă daune vehiculelor."

msgid "mapbox0Status"
msgstr "Vremea rea"

msgid "payAttention"
msgstr "Fii atent"

msgid "ranked1"
msgstr "Primești mai multă experiență dacă menții rolul vehiculului tău! Descrierea rolurilor vehiculelor și acțiunilor corespunzătoare acestora sunt disponibile în garaj și în pagina informațională."

msgid "ranked10"
msgstr "Progresând în Luptele de clasament, vei putea cumpăra vehicule unice și elemente de personalizare contra bonduri (inclusiv cele reduse). Pentru a vedea lista de articole, dă clic pe banner.\nNu poți accesa articolele sau reducerile în afara sezonului."

msgid "ranked11"
msgstr "Luptele bonus zilnice sunt disponibile doar în Ligi. Ele sunt primite în funcție de rezultatele din Calificări și prin finalizarea de misiuni speciale. Luptele bonus zilnice nu se reportează în ziua următoare."

msgid "ranked12"
msgstr "La finalul anului, jucătorii cei mai eficienți vor intra în Clasament. Ei vor primi o insignă suplimentară și se vor bucura de onoarea și respectul comunității."

msgid "ranked13"
msgstr "Unele grade sunt permanente. Odată obținut, gradul nu mai poate fi pierdut. Gradele permanente de la mijlocul etapei sunt oferite cu indicații adiționale. Toate gradele de început ale fiecărei Divizii sunt permanente și nu pot fi pierdute."

msgid "ranked2"
msgstr "Primești lupte bonus standard și zilnice pentru atingerea următoarei Divizii și Ligi. O luptă bonus dublează automat galoanele obținute în luptă și nu e consumată în cazul unui eșec. Dispui de o singură luptă bonus pe zi pentru fiecare vehicul de generația X."

msgid "ranked3"
msgstr "Urmărește ora de vârf: odată încheiată, luptele pentru clasament devin indisponibile până în ziua următoare, iar tu vei primi notificarea respectivă."

msgid "ranked4"
msgstr "Unele grade au așa-numitele scuturi. La înfrângere la asemenea grade, vei slăbi scutul fără a pierde gradul. Dacă scutul gradului nu este consumat în întregime, obținerea unui galon la un grad cu scut va restaura scutul în întregime."

msgid "ranked5"
msgstr "Nu te da bătut! Un galon va fi acordat nu doar primilor 7 jucători din echipa învingătoare, dar și celui mai bun jucător din echipa învinsă. Nu uita că fiecare galon obținut într-o luptă bonus va fi dublat."

msgid "ranked6"
msgstr "După finalizarea tuturor diviziilor, jucătorii ating una dintre cele trei Ligi: de Aur, de Argint și de Bronz. Ei continuă lupta și rezultatele lor le vor determina eficiența și determina poziția în clasament."

msgid "ranked7"
msgstr "Jucătorii obțin un token de grad la fiecare divizie finalizată. Jucătorii care au arătat cea mai bună eficiență timp de trei sezoane vor obține recompensa finală binemeritată."

msgid "ranked8"
msgstr "La încheierea sezonului, cei mai buni jucători vor obține un ecuson unic și un stil pentru vehicule. Aceste recompense sunt motiv de mândrie pentru jucători, simboluri ale măiestriei de neegalat."

msgid "ranked9"
msgstr "Obții bonduri în urma succesului tău în lupte pentru clasament. Bondurile pot fi schimbate contra directive și echipament îmbunătățit. În plus, primești alte recompense precum creite, consumabile, etc."

msgid "rankedStatus1"
msgstr "Experiență pentru menținerea rolului vehiculului"

msgid "rankedStatus10"
msgstr "Articolele Luptelor de clasament"

msgid "rankedStatus11"
msgstr "Luptele bonus zilnice"

msgid "rankedStatus12"
msgstr "Jucătorii de top ai anului"

msgid "rankedStatus13"
msgstr "Regulile modului"

msgid "rankedStatus2"
msgstr "Lupte bonus"

msgid "rankedStatus3"
msgstr "Ora de Vârf"

msgid "rankedStatus4"
msgstr "Reguli mod"

msgid "rankedStatus5"
msgstr "Reguli mod"

msgid "rankedStatus6"
msgstr "Lupte în Ligi"

msgid "rankedStatus7"
msgstr "Recompense anuale"

msgid "rankedStatus8"
msgstr "Recompensele finalului de sezon"

msgid "rankedStatus9"
msgstr "Recompense pentru grade"

msgid "security"
msgstr "Siguranţa înainte de toate"

msgid "technicalAdvice"
msgstr "Sfat tehnic"

msgid "tip0"
msgstr "Terenul mlăștinos reduce semnificativ viteza și rotația unui vehicul."

msgid "tip100"
msgstr "Eficiența unui membru de echipaj afectează caracteristicile corespunzătoare ale vehiculului."

msgid "tip101"
msgstr "Caracteristica Al Șaselea Simț îi permite Comandantului să sesizeze dacă vehiculul a fost detectat de către inamic."

msgid "tip102"
msgstr "Eficiența talentului este un parametru care determină eficiența tuturor talentelor antrenate de un membru de echipaj."

msgid "tip103"
msgstr "La reantrenare, poți schimba calificarea unui membru de echipaj."

msgid "tip106"
msgstr "Echipamentul creşte eficienţa echipajului şi caracteristicile vehiculului."

msgid "tip107"
msgstr "Vehiculele cu toate modulele și ramurile tehnice cercetate ating statutul de Elită."

msgid "tip108"
msgstr "Experienţa de luptă câştigată pe vehiculele de Elită, incluzând vehiculele premium, poate fi transformată în Experienţă liberă."

msgid "tip11"
msgstr "Foloseşte-te de tufişuri şi frunziş pentru a face antitancul tău mai greu de detectat. Ia aminte că vehiculele staţionare sunt mai puţin vizibile."

msgid "tip111"
msgstr "Uneori capturarea bazei este o soluţie mai uşoară şi sigură decât distrugerea tuturor vehiculelor inamice."

msgid "tip114"
msgstr "Folosirea în comun a unui cont încalcă regulile jocului şi poate duce la pierderea accesului la cont."

msgid "tip115"
msgstr "Regulile jocului interzic folosirea la comun a conturilor. Toate părțile implicate își pot pierde conturile pentru totdeauna."

msgid "tip116"
msgstr "Cu cât mai sofisticată e parola ta, cu atât mai bine."

msgid "tip117"
msgstr "Schimbă-ţi parola în mod regulat."

msgid "tip118"
msgstr "Regulile jocului interzic cumpărarea şi vânzarea de conturi. Dacă încalci aceste reguli, îţi poţi pierde contul."

msgid "tip119"
msgstr "Nu urma link-uri către site-uri necunoscute. Poți fi escrocat sau ți se poate fura contul."

msgid "tip120"
msgstr "Poţi cumpăra aur doar de pe site-ul oficial al World of Tanks. Dacă încerci să cumperi aur de pe alte site-uri, rişti să îţi pierzi banii."

msgid "tip121"
msgstr "Opţiunea de salvare a parolei este convenabilă dar posibil nesigură."

msgid "tip122"
msgstr "Poţi găsi instrucţiuni legate de securitatea contului pe portalul jocului. Citeşte-le cu atenţie."

msgid "tip123"
msgstr "În timpul luptei, ţine apăsat Ctrl pentru a afişa cursorul mouse-ului."

msgid "tip124"
msgstr "Pentru a repara un modul, foloseşte trusa de reparaţii. Pentru a vindeca un membru al echipajului, foloseşte trusa de prim ajutor."

msgid "tip125"
msgstr "Pentru a folosi consumabile şi a schimba tipurile de proiectile, foloseşte tastele rapide (implicit 1-6)."

msgid "tip126"
msgstr "Pentru mișca instant camera în modul Artilerie, fă clic dreapta pe mini-hartă."

msgid "tip127"
msgstr "Pentru a schimba modul de afişare a listei jucătorilor, apasă Ctrl+Tab."

msgid "tip128"
msgstr "Apasă clic dreapta pe numele jucătorului în panourile laterale pentru a vedea acţiunile disponibile."

msgid "tip129"
msgstr "Pentru a înregistra o plângere despre un jucător, apasă clic dreapta pe numele jucătorului în panourile laterale şi selectează opţiunea corespunzătoare din meniul contextual."

msgid "tip130"
msgstr "Comenzile disponibile din meniul de comenzi depind de poziţia cursorului: pe un aliat, un inamic, un obiect sau o particularitate a terenului."

msgid "tip131"
msgstr "Pentru a selecta o comandă din meniul de comenzi, ţine apăsat T sau Z şi mută mouse-ul pentru a evidenţia comanda dorită."

msgid "tip132"
msgstr "Folosește tastele F2-F8 pentru a accesa rapid comenzile din Meniul de Comandă."

msgid "tip134"
msgstr "Jignirile nu sunt cea mai bună cale de a-ţi convinge aliatul că ai dreptate. De altfel, nu este permisă de regulile jocului."

msgid "tip135"
msgstr "Aliaţii preferă să ajute jucătorii politicoşi."

msgid "tip136"
msgstr "Lupta trebuie să fie purtată pe hartă, nu în chat."

msgid "tip137"
msgstr "Nu trimite mesaje fără utilitate în chat deoarece vei distrage jucătorii de la luptă."

msgid "tip138"
msgstr "Foloseşte opţiunea de plângeri când regulile jocului sunt încălcate."

msgid "tip139"
msgstr "Prin adăugarea jucătorilor la lista neagră vei înceta imediat să mai primeşti mesaje şi invitaţii de la aceştia."

msgid "tip14"
msgstr "Ţintirea automată nu garantează acurateţea 100%. jucătorii experimentaţi ţintesc manual."

msgid "tip140"
msgstr "Cenzurarea mesajelor poate fi activată în setări."

msgid "tip141"
msgstr "Chat-ul de luptă poate fi dezactivat în setări. Chat-ul de pluton va fi în continuare disponibil."

msgid "tip142"
msgstr "În timp ce te cerţi cu aliaţii, inamicul pune stăpânire pe câmpul de luptă."

msgid "tip143"
msgstr "Fii atent la cursul luptei. O singură greşeală poate duce la înfrângere."

msgid "tip144"
msgstr "Când foloseşti programe interzise sau participi la lupte aranjate, riști să-ţi pierzi contul definitiv."

msgid "tip146"
msgstr "Încălcările regulilor jocului se pedepsesc şi pot rezulta în blocarea contului."

msgid "tip147"
msgstr "Dacă ai fost pedepsit pentru încălcarea regulilor jocului, îţi recomandăm călduros să reciteşti regulile pentru a preveni astfel de incidente în viitor."

msgid "tip148"
msgstr "Regulile jocului se aplică tuturor, ca și penalizările pentru încălcarea lor."

msgid "tip149"
msgstr "Nu poţi intra în luptă? Încearcă să dezactivezi modurile şi să restartezi clientul jocului."

msgid "tip150"
msgstr "Rată FPS mică? Încearcă să reduci calitatea graficii din Setări."

msgid "tip151"
msgstr "Rată FPS mică şi distorsiuni grafice? Actualizează driverele plăcii video."

msgid "tip152"
msgstr "Latenţă mare prin 3G sau wireless? Încearcă o conexiune prin cablu."

msgid "tip153"
msgstr "Vehiculul tău se teleportează sau trage cu întârziere? Verifică-ţi conexiunea la reţea."

msgid "tip154"
msgstr "Un software antivirus bun garantează funcționarea stabilă a computerului tău și a clientului de joc."

msgid "tip155"
msgstr "Echipa ta nu te poate auzi în luptă? Verifică setările comunicării prin voce."

msgid "tip156"
msgstr "Cu cât descrii mai detaliat problema către Asistența Jucători, cu atât va fi luată în considerare mai rapid."

msgid "tip157"
msgstr "Înainte de a contacta Asistența Jucători, asigură-te că problema reclamată poate fi reprodusă dacă dezactivezi toate modificările."

msgid "tip158"
msgstr "Asocierea unui număr de telefon la cont permite securizarea acestuia în fața unei tentative de hacking."

msgid "tip159"
msgstr "Asigură-te că numărul de telefon asociat contului tău este activ, pentru a putea recăpăta rapid acces la cont."

msgid "tip160"
msgstr "Asociind numărul de telefon mobil cu contul tău, vei putea să schimbi adresa de e-mail cu care a fost înregistrat contul."

msgid "tip161"
msgstr "Dacă bănuiești că ai avut o accesare neautorizată pe contul tău, contactează serviciul de Suport clienți imediat."

msgid "tip162"
msgstr "Nu accepta cadouri de la utilizatori necunoscuți."

msgid "tip163"
msgstr "Selectează secțiunea corectă în Asistența Jucători pentru a garanta o analiză promptă a problemei tale."

msgid "tip164"
msgstr "Un artilerist experimentat poate detecta și distruge o artilerie inamică după urma proiectilelor, dacă aceasta nu își schimbă poziția."

msgid "tip165"
msgstr "Extinctoarele de incendiu automate sting focul rapid și reduc riscul de incediu la motor."

msgid "tip166"
msgstr "Când comanzi o artilerie trebuie să iei în considerare atât traiectoria și viteza proiectilelor, cât și configurația terenului."

msgid "tip167"
msgstr "Ține mereu seama de pozițiile aliaților și inamicilor pe Mini-hartă."

msgid "tip168"
msgstr "Dacă deschizi focul când faci observare pasivă vei divulga poziția ta. Ținerea inamiculu sub observație îți poate aduce experiență și credite suplimentare."

msgid "tip169"
msgstr "Folosește Setul de piese de rezervă pentru reparații rapida la o suspensie avariată. O dată ce vehiculul tău este repus în mișcare, încearcă să eviți focul inamic."

msgid "tip17"
msgstr "O țintă puternic blindată care nu poate fi penetrată cu proiectile perforante AP poate fi vulnerabilă la proiectile explozive HE."

msgid "tip170"
msgstr "Aidoma tufișurilor, copacii căzuți pot ascunde vehiculul tău."

msgid "tip171"
msgstr "Bolovanii și șanțurile adânci îți pot imobiliza vehiculul."

msgid "tip173"
msgstr "Poți transfera membri de echipaj pe un vehicul premium de aceeași naționalitate și tip fără recalificare."

msgid "tip174"
msgstr "Rănirea membrilor de echipaj le reduce eficiența în luptă."

msgid "tip176"
msgstr "Pentru a primi cadoul, destinatarul acestuia trebuie să se conecteze la Account Management."

msgid "tip177"
msgstr "Sancțiunile pentru distrugerea/avarierea vehiculelor aliate nu pot face subiectul unui apel, sub nici o circumstanță."

msgid "tip178"
msgstr "Ia legătura cu Asistența Jucători pentru a clarifica motivele suspendării contului tău."

msgid "tip179"
msgstr "Înainte de a reclama dispariția vehiculelor prin tichet adresat Asistenței Jucători, asigură-te că nu ai selectat un filtru de vehicule în clientul jocului."

msgid "tip180"
msgstr "Poţi schimba sonorul folosind setarea de Volum Principal sau schimbând setăriule de volum ale sistemului tău."

msgid "tip181"
msgstr "Selectează sistemul de sunet-\"Sunet 2.0/2.1\" sau \"Căşti\"-în setările de sunet pentru poziţionare mai bună a sunetului."

msgid "tip182"
msgstr "Pentru performanţă maximă pe sisteme de sunet slabe, foloseşte presetul \"Laptop\"."

msgid "tip183"
msgstr "Folsoeşte modul de noapte pentru a reduce sunetele ascuţite."

msgid "tip184"
msgstr "Poţi selecta opţiunea se îmbunătăţire a frecvenţelor joase, dar rezultatele vor diferi pentru sisteme de sunet diferite."

msgid "tip185"
msgstr "Vehiculele ușoare cu roți au caracteristicile dinamice cele mai bune care le permit să fie primele la ocuparea unei poziții avantajoase sau să se ascundă de focul inamic."

msgid "tip186"
msgstr "Aceste vehicule sunt echipate cu două țevi complet funcționale care pot trage simultan sau separat. Butonul de control al focului poate fi schimbat în Setări."

msgid "tip191"
msgstr "Sunt disponibile mai multe clase pentru o piesă de echipament, în funcție de generația vehiculului pe care vrei să o montezi."

msgid "tip192"
msgstr "Pentru vehiculele de generație VI sau mai mare, montarea echipamentului standard în locașul de categorie corespunzătoare conferă un bonus sporit. Montarea într-un alt locaș conferă bonusul standard."

msgid "tip193"
msgstr "Viteza maximă nu este afectată de configurația vehiculului. Aceasta poate fi îmbunătățită prin instalarea de echipament corespunzător, cumpărarea de modificări sau antrenamentul echipajului în talentele potrivite."

msgid "tip194"
msgstr "Modificările de teren îți permit să îți configurezi vehiculul pentru a se potrivi stilului tău de joc."

msgid "tip195"
msgstr "Modificările de teren deblochează configurația alternativă a vehiculului. Alegerea unei configurații potrivite îți aduce un avantaj în lupta care urmează."

msgid "tip196"
msgstr "Utilizează scurtăturile Ctrl+1 și Ctrl+2 pentru a schimba între configurarea esențială și cea auxiliară."

msgid "tip197"
msgstr "După atingerea unui anumit nivel al Modificărilor de teren, poți aloca o categorie celui de-al doilea locaș al echipamentului."

msgid "tip198"
msgstr "Modificările de teren sunt disponibile vehiculelor din generațiile VI-X care au atins starea „Elită”. Modificările devin disponibile imediat după achiziție pentru vehiculele speciale, premiu, recompensă sau Premium."

msgid "tip199"
msgstr "Înfățișarea arborelui de modificări depinde în mod direct de tipul și rolul vehiculului."

msgid "tip200"
msgstr "Permite păstrarea mobilității parțiale atunci când șenila principală este distrusă."

msgid "tip200Status"
msgstr "Șenilă de rezervă"

msgid "tip201"
msgstr "Permite păstrarea mobilității parțiale atunci când șenila principală este distrusă."

msgid "tip202"
msgstr "Utilizarea de racheto-accelerare crește mobilitatea vehiculului. Îți permite să ocupi poziții avantajoase sau să traversezi mai rapid zonele periculoase."

msgid "tip202Status"
msgstr "Vehiculele cu racheto-accelerare"

msgid "tip203"
msgstr "Apasă tastele TAB sau B pentru a activa rezerve personale"

msgid "tip204"
msgstr "Dacă un tun s-a răcit suficient după foc, dispersia sa va fi redusă. Va apărea un al doilea cerc cu diametru mai mic, care va determina zona de impact a proiectilului. Efectul durează până la următorul foc."

msgid "tip204Status"
msgstr "Țintire dublă"

msgid "tip205"
msgstr "Un tip de armament automat cu cadență de tragere extrem de ridicată. Eficiența focului este afișată printr-un indicator din cercul de țintire."

msgid "tip205Status"
msgstr "Tun automat"

msgid "tip206"
msgstr "Membrii de echipaj pot antrena maxim șase talente ale calificării majore."

msgid "tip207"
msgstr "Membrii de echipaj cu calificări multiple pot antrena talente bonus ale calificărilor suplimentare. Aceste talente bonus nu conțin EXP și nu respectă limita de talente."

msgid "tip208"
msgstr "Dacă mai mulți membri de echipaj au aceeași calificare, efectele tuturor talentelor acestora vor fi calculate drept medie. Pentru ca un talent să aibă eficiență de 100%, acesta trebuie să fie antrenat de toți membrii de echipaj cu aceeași calificare."

msgid "tip209"
msgstr "După atingerea limitei de șase talente, membrii de echipaj vor continua să obțină EXP, care va fi convertită în Ghiduri Universale pentru alte echipaje."

msgid "tip210"
msgstr "Acest vehicul este echipat cu un sistem al tunului care îți permite să alegi moduri de tragere diferite, în funcție de condițiile luptei"

msgid "tip210Status"
msgstr "Vehicule cu mod de tragere selectiv"

msgid "tip211"
msgstr "Utilizarea de racheto-accelerare crește mobilitatea vehiculului. Îți permite să ocupi poziții avantajoase sau să traversezi mai rapid zonele periculoase."

msgid "tip211Status"
msgstr "Vehiculele cu racheto-accelerare"

msgid "tip23"
msgstr "Vehiculele ușoare cu blindaj subțire pot fi distruse prin coliziune."

msgid "tip25"
msgstr "Folosește proiectile explozive HE pentru a distruge module și a scoate din luptă echipajul inamic."

msgid "tip28"
msgstr "Obuzele explozive HE au eficiență maximă împotriva vehiculelor cu protecție redusă din partea blindajului și cu cabină deschisă."

msgid "tip29"
msgstr "Pentru a stopa un vehicul inamic și a-l transforma într-o țintă facilă, trage în șenile."

msgid "tip30"
msgstr "Un profil redus face un vehicul mai greu de detectat, în special în tufișuri."

msgid "tip31"
msgstr "Încearcă alte tipuri de proiectile dacă nu poți provoca daune inamicului cu proiectilul selectat."

msgid "tip32"
msgstr "Bonusul de eficiență a echipajului permite ca talentele echipajului să fie îmbunătățite mai departe, crescând caracteristicile de bază ale vehiculului cu care aceștia intră în luptă."

msgid "tip33"
msgstr "Un vehicul staționar este mai dificil de detectat decât unul în mișcare."

msgid "tip36"
msgstr "În lupta de aproape, o artilerie poate distruge un vehicul inamic prin foc direct."

msgid "tip37"
msgstr "Artileria inamică îți poate ghici locația când distrugi garduri și structuri."

msgid "tip39"
msgstr "Concentrarea focului este întotdeauna utilă."

msgid "tip41"
msgstr "Pentru a detecta vehiculele inamice, urmărește traiectoria proiectilelor lor."

msgid "tip42"
msgstr "Cu cât sunt mai multe vehicule în interiorul bazei inamice, cu atât baza este capturată mai repede. Cea mai rapidă captură poate fi realizată cu trei vehicule."

msgid "tip43"
msgstr "Dacă nici o echipă nu câștigă superioritatea în modul Asalt, echipa în defensivă este câștigătoare la expirarea timpului de joc."

msgid "tip44"
msgstr "Evită proiectilele inamice când capturezi baza. Capturarea bazei este întreruptă dacă vehiculul tău este avariat."

msgid "tip45"
msgstr "Manevrabilitatea este afectată de tipul suspensiei, puterea motorului și greutatea totală a componentelor montate. Poate fi îmbunătățită prin montarea de echipament corespunzător."

msgid "tip47"
msgstr "Clădirile și vehiculele distruse pot bloca focul inamic. Copacii și tufișurile te pot ascunde, dar nu vor bloca loviturile de obuz."

msgid "tip48"
msgstr "Da clic pe Setul de piese de schimb pentru a repara un modul avariat."

msgid "tip49"
msgstr "Când este distrus, un tun nu mai poate trage. Dă clic pe Setul de piese de schimb pentru a repune tunul în funcțiune."

msgid "tip50"
msgstr "Avarierea compartimentului de muniție poate rezulta în reducerea vitezei de reîncărcare sau, în unele cazuri, la explozie imediată."

msgid "tip56"
msgstr "Contul Premium îți aduce 50% experiență și credite după fiecare luptă."

msgid "tip57"
msgstr "Poți folosi EXP liberă pentru a cerceta orice vehicul, modul sau modificare."

msgid "tip58"
msgstr "Când cercetezi module, vehicule și modificări, mai întâi cheltui din EXP de luptă și mai apoi din EXP liberă."

msgid "tip6"
msgstr "Vehiculele de tip diferit necesită adesea tactici diferite."

msgid "tip60"
msgstr "Creditele și experiența sunt acordate pentru descoperirea vehiculelor inamice, avarierea și distrugerea lor, pentru capturarea/apărarea bazei, etc."

msgid "tip62"
msgstr "Focurile tale pot reduce punctele de viață ale vehiculului inamic, pot avaria sau distruge module sau pot răni membri de echipaj."

msgid "tip65"
msgstr "Folosește denivelările de teren, ele te pot adăposti de foc direct sau te pot ascunde."

msgid "tip66"
msgstr "O echipă bine coordonată este o echipă câștigătoare."

msgid "tip67"
msgstr "Dacă nu mai ai spațiu în Garaj, gândește-te să cumperi încă un loc sau să vinzi unul din vehiculele tale."

msgid "tip68"
msgstr "Folosește Depozitul pentru a vinde vehiculele, modulele, consumabilele, echipamentele sau muniția de care nu mai ai nevoie."

msgid "tip69"
msgstr "Dacă cineva îți cere parola, este o înșelătorie. Administratorii nu au de ce să îți ceară parola, pentru niciun motiv. Nu divulga niciodată parola ta."

msgid "tip70"
msgstr "Vehiculele premium sunt ieftin de reparat."

msgid "tip71"
msgstr "Nu trage în aliați!"

msgid "tip75"
msgstr "Rotirea turelei și a carenei reduce acuratețea focului, așa că după ce termini manevra, trebuie să aștepți ca cercul colimatorului să se strângă pe țintă."

msgid "tip77"
msgstr "Accelerația este afectată de puterea motorului, greutatea vehiculului și tipul terenului. Poate fi îmbunătățită prin montarea de echipament corespunzător sau folosind consumabile sau modificări corespunzătoare și talente ale membrilor de echipaj."

msgid "tip78"
msgstr "Modulele de suspensie au viteze de rotație și abilități de traversare diferite."

msgid "tip79"
msgstr "Rezultatul unei coliziuni depinde de diferențele de greutate, viteză și grosime blindaj dintre vehicule."

msgid "tip81"
msgstr "Viteza cu care colimatorul se strânge pe țintă este determinată de talentele tunarului, anumite echipamente instalate și consumabile."

msgid "tip83"
msgstr "Auto-ochirea se dezactivează dacă vehicul țintit este distrus sau pierdut din vedere."

msgid "tip84"
msgstr "Un vehicul distrus este blocat şi rămâne indisponibil în garaj până la finalul luptei."

msgid "tip85"
msgstr "Poți intra în luptă doar cu un vehicul reparat în întregime și cu un echipaj complet."

msgid "tip86"
msgstr "Poți seta opțional Realimentare automată și Reparație automată pentru vehiculul tău."

msgid "tip87"
msgstr "Blindajul înclinat crește șansa de ricoşeuri sau lovituri non-penetrante."

msgid "tip88"
msgstr "Membrii de echipaj care nu sunt antrenați pentru un anumit vehicul nu își pot utiliza talentele atunci când luptă în acesta."

msgid "tip89"
msgstr "Poți transfera membri de echipaj în alt vehicul sau îi poți trimite în Cazarmă."

msgid "tip9"
msgstr "De fiecare dată când simți că ești în pericol, relochează-ți artileria - vei supraviețui mai mult."

msgid "tip91"
msgstr "Nu poți începe o luptă cu echipaj incomplet."

msgid "tip92"
msgstr "Viteza pregătirii echipajului tău depinde de succesul lor în luptă."

msgid "tip93"
msgstr "Comandantul conferă un bonus la eficiența tuturor celorlalți membri de echipaj. Eficiența echipajului poate fi de asemenea crescută cu ajutorul anumitor talente de echipaj sau anumitor echipamente și consumabile."

msgid "tip95"
msgstr "Toată experienţa de luptă câştigată atunci când antrenamentul accelerat este selectat va fi primită de membrul de echipă cel mai puţin antrenat."

msgid "tip98"
msgstr "Lista de echipamente disponibile depinde de generația, tipul și particularitățile de design ale fiecărui vehicul."

msgid "tip99"
msgstr "Toate echipamentele pot fi demontate și trasferate pe alt vehicul."

msgid "usefulFeatures"
msgstr "Opțiuni utile"

msgid "wheeledVehicles"
msgstr "Vehiculele cu roți sunt printre cele mai dinamice din joc"

msgid "winback1"
msgstr "Poți ieși din Încălzire din meniul de selectare a modului din setările luptei standard."

msgid "winback1Status"
msgstr "Fii atent"
