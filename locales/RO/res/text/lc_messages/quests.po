msgid "action/full/tankmen/mixed"
msgstr "Antrenează sau reantrenează echipajul la un cost redus cu %(discount)s. Un echipaj bine antrenat sporește caracteristicile vehiculului și asigură folosirea sa la potențial maxim."

msgid "action/full/tradeInSellPriceFactor"
msgstr "Dă la schimb un vehicul Premium vechi pentru unul nou și vei fi rambursat %(discount)s din prețul vechiului vehicul Premium."

msgid "action/full/vehicleBuyPrice"
msgstr "Reducere la achiziția de vehicule"

