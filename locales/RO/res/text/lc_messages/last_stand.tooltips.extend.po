msgid "Contact/status/inBattle/last_stand"
msgstr "Într-o luptă Ultima Redută"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Trage un proiectul care avariază ținta și toate vehiculele inamice dintr-o zonă cu raza de 35m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Trage un proiectil care reface puncte de integritate, furându-le de la țintă și de la vehiculele inamice apropiate dintr-o zonă cu raza de 35m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Trage un proiectil care provoacă șoc țintei și tuturor vehiculelor inamice dintr-o zonă cu raza de 35m."

msgid "advanced/ls_damageShield"
msgstr "Protejează împotriva daunelor (exceptând coliziunea, înecul și impactul) timp de 10 secunde."

msgid "advanced/ls_doubleDamage"
msgstr "Următoarea ta lovitură reușită provoacă daune duble."

msgid "advanced/ls_equipment"
msgstr "Componentele tactice te ajută să lupți mai eficient în luptele Ultima Redută, să finalizezi etape și să obții recompense valoroase. Pentru a le echipa, clic pe unul din locașurile de componente tactice."

msgid "advanced/ls_extraDamageSituational"
msgstr "Conferă șansa de a provoca daune crescute unui vehicul inamic."

msgid "advanced/ls_fastReload"
msgstr "Crește cadența de tragere / reîncarcă magazia."

msgid "advanced/ls_healSituational"
msgstr "Restaurează Puncte de integritate după distrugerea unui vehicul inamic."

msgid "advanced/ls_invisibility"
msgstr "Îi împiedică temporar pe inamici să-ți țintească vehiculul, restaurează puncte de integritate, repară instantaneu modulele, stinge incendiul, elimină efectul de șoc și vindecă toți membrii de echipaj."

msgid "advanced/ls_nitro"
msgstr "Crește temporar mobilitatea vehiculului."

msgid "advanced/ls_nitroSituational"
msgstr "Crește temporar mobilitatea vehiculului propriu după suferirea de daune de la un vehicul inamic."

msgid "advanced/ls_selfRepairKit"
msgstr "Restaurează puncte de integritate, stinge incendiul, elimină efectul de șoc și repară modulele avariate."

msgid "advanced/ls_teamRepairKit"
msgstr "Repară module avariate, stinge incendiul, elimină efectul de șoc și reface o parte din punctele de integritate ale vehiculelor aliate din raza de acțiune."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Componentele tactice pot fi echipate în locașuri speciale care te ajută să lupți mai eficient în Ultima Redută, să finalizezi etape și să obții recompense valoroase."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Locașurile componentelor tactice"
