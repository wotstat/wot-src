msgstr "Pz.Kpfw. 38H 735 (f)"

msgid "H39_captured"
msgstr "Pz.Kpfw. 38H 735 (f)"

msgid "H39_captured_descr"
msgstr "ドイツ軍はフランス戦線を通じて約 600 輌のオチキス 39 (Hotchkiss 39) を鹵獲し、これらを改装して運用しました。"

msgid "H39_captured_short"
msgstr "Pz. 38H"

msgid "H39turm"
msgstr "Pz.Kpfw. 38H 735 (f)"

