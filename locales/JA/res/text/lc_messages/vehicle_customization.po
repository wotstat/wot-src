msgstr "「バトルパス・シーズンV」の特定のステージで入手できるオールシーズンスタイル。"

msgid "special_style/bp2021_6_1"
msgstr "天空に最も近い場所"

msgid "special_style/bp2021_6_1_desc"
msgstr "「バトルパス・シーズンVI」の特定のステージで入手できるオールシーズンスタイル。"

