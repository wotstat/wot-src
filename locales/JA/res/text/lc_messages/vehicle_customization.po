msgid "special_style/white_tiger_2021"
msgstr "トランスダクター (オン)"

msgid "special_style/white_tiger_2021_desc"
msgstr "2021年のイベント「RETURN OF WAFFENTRÄGER」で入手可能なオールシーズンスタイル。"

