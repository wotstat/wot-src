msgid "extraParams/name/demaskMovingFactor"
msgstr "해당 매개 변수는 기동 중인 적 전차의 노출값을 나타냅니다. 수치가 높을수록 관측 확률이 증가합니다."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "해당 매개 변수는 적 전차 승무원 부상 및 부품 손상 유발 확률이 바뀐 정도를 나타냅니다. 자동포 포탄을 제외한 모든 유형의 포탄에 효과가 적용됩니다."

msgid "extraParams/name/equipmentPreparationTime"
