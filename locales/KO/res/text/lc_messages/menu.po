msgid "extraParams/name/radiomanHitChance"
msgstr "해당 매개 변수는 무전수 부상 방지 확률을 나타냅니다."

msgid "extraParams/name/shellVelocity"
msgstr "해당 매개 변수는 모든 포탄 유형의 포탄 속도가 증가하는 정도를 나타냅니다. 수치가 높을수록 포탄 속도가 빨라집니다."

msgid "extraParams/name/softGroundFactor"
msgstr "해당 매개 변수는 무른 지형에서 현가장치의 최고 속력 도달 능력을 나타냅니다. 수치가 높을수록 최고 속력까지 도달하는 시간이 짧아집니다."

msgid "extraParams/name/stunResistanceEffectFactor"
