msgid "PzIV_schmalturm_descr"
msgstr "1944년 11월 크룹사는 당시 운용 중인 전차 및 구축전차 개량 기획안을 제시하였다. 그중 Panther의 Schmalturm 포탑을 Pz Iv Ausf. J에 장착하는 설계도 포함되어 있었지만, 현가장치에 지나치게 많은 중량이 실릴 것으로 판단되었으며 Pz IV 생산이 단계적으로 중단되며 기획이 취소되었다."

msgid "PzIV_schmalturm_long_special"
