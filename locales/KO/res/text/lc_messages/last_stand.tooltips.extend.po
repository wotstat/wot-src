msgid "Contact/status/inBattle/last_stand"
msgstr "최후의 저항 전투 중"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "목표물 및 목표물로부터 35m 범위 내에 있는 모든 적 전차에 피해를 입히는 포탄을 발사합니다."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "목표물 및 목표물로부터 35m 범위 내에 있는 적 전차의 내구도를 강탈하여 자신의 전차 내구도를 회복하는 포탄을 발사합니다."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "목표물 및 목표물로부터 35m 범위 내에 있는 모든 적 전차에 폭발 충격을 가하는 포탄을 발사합니다."

msgid "advanced/ls_damageShield"
msgstr "10초 동안 충돌, 침수, 충격 피해를 제외한 모든 피해를 막아 줍니다."

msgid "advanced/ls_doubleDamage"
msgstr "다음 포탄이 피해를 두 배로 입힙니다."

msgid "advanced/ls_equipment"
msgstr "전술 장비를 사용하면 최후의 저항 전투에서 더 효율적으로 활약하여 스테이지를 완료하고 값진 보상을 획득할 수 있습니다. 전술 장비 슬롯을 클릭하면 장비를 장착할 수 있습니다."

msgid "advanced/ls_extraDamageSituational"
msgstr "일정 확률로 적 전차에 입히는 피해가 증가합니다."

msgid "advanced/ls_fastReload"
msgstr "연사력이 향상되고 클립식 주포가 즉시 재장전됩니다."

msgid "advanced/ls_healSituational"
msgstr "적 전차 격파 후 내구도가 일정량 복구됩니다."

msgid "advanced/ls_invisibility"
msgstr "전차가 적이 조준할 수 없는 상태가 되고, 내구도가 회복되고, 부품이 수리되고, 화재가 진압되고, 폭발 충격 효과가 제거되고, 부상당한 모든 승무원이 치료됩니다."

msgid "advanced/ls_nitro"
msgstr "전차 기동력이 일시적으로 증가합니다."

msgid "advanced/ls_nitroSituational"
msgstr "적 전차로부터 피해를 받으면 본인 전차 기동력이 일시적으로 향상됩니다."

msgid "advanced/ls_selfRepairKit"
msgstr "내구도가 회복되고, 화재가 진압되고, 폭발 충격 효과가 제거되고, 손상된 부품이 수리됩니다."

msgid "advanced/ls_teamRepairKit"
msgstr "범위 내 아군 전차의 부품이 수리되고, 화재가 진압되고, 폭발 충격 효과가 제거되고, 내구도가 일정량 회복됩니다."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "전술 장비를 특별 슬롯에 장착하면 최후의 저항 전투에서 더욱 효율적으로 활약하여 스테이지를 완료하고 값진 보상을 획득할 수 있습니다."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "전술 장비 슬롯"
