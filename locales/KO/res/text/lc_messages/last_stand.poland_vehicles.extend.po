msgid "Pl05_50TP_Tyszkiewicza_LS_BOT"
msgstr "보초 50TP"

msgid "Pl05_50TP_Tyszkiewicza_LS_BOT_descr"
msgstr "사관생도 Tadeusz Tyszkiewicz가 1950년대 초 바르샤바 군사 기술 학교에서 개발한 중전차 설계이다. 전차 중량을 50톤 이상으로 계획하였다. 설계도면으로만 존재한다."

msgid "Pl05_50TP_Tyszkiewicza_LS_BOT_short"
msgstr "보초"

msgid "Pl11_45TP_Habicha_LS_BOT"
msgstr "보초 45TP"

msgid "Pl11_45TP_Habicha_LS_BOT_descr"
msgstr "중형전차 Habich를 기반으로 개발이 제안된 중전차이다. 차체 장갑은 두꺼운 경사 장갑으로 설계하고 더욱 강력한 주포를 장착하려 했지만, 시제 전차조차 제작되지 않았다."

msgid "Pl11_45TP_Habicha_LS_BOT_short"
msgstr "보초"

msgid "Pl13_53TP_Markowskiego_LS_BOT"
msgstr "보초 53TP"

msgid "Pl13_53TP_Markowskiego_LS_BOT_descr"
msgstr "1940년 개발하려 했던 중전차이다. 제2차 세계대전이 발발하여 설계 단계에서 개발이 중단되었다."

msgid "Pl13_53TP_Markowskiego_LS_BOT_short"
msgstr "보초"

msgid "Pl18_BUGI_LS_BOT"
msgstr "보초 B.U.G.I."

msgid "Pl18_BUGI_LS_BOT_descr"
msgstr "B.U.G.I.는 4명의 전차 개발자(Bujnowicz, Ulrych, Grabski, Iwanicki) 이름의 첫 글자를 따온 것으로 중형전차 KSUS II를 기반으로 개량한 전차이다. 1938~1939년 Grudziądz 회담에서 개발이 논의되었다. 1939년 5월, 모들린의 육군 훈련소에서 개발이 확정되었으며 1939년 8월 중순, 개발국에서 전차 설계를 공개하였다. 하지만, 제2차 세계대전으로 인해 개발이 중단되었다."

msgid "Pl18_BUGI_LS_BOT_short"
msgstr "보초"

msgid "Pl20_CS_44_LS_BOT"
msgstr "보초 CS-44"

msgid "Pl20_CS_44_LS_BOT_descr"
msgstr "1940년대 후반기에 바르샤바 기술대학교 학생이 개발한 중형전차이다. 소련과 프랑스의 전차 설계 방식을 기반으로 개발된 전차이다. 설계도면으로만 존재한다."

msgid "Pl20_CS_44_LS_BOT_short"
msgstr "보초"

msgid "Pl23_CS_53_Alpha_LS_BOT"
msgstr "CS-53"

msgid "Pl23_CS_53_Alpha_LS_BOT_descr"
msgstr "1950년대 전반기에 바르샤바 육군 기술학교에서 여러 중형전차를 개발 중이었다. 해당 중형전차는 소련 전차 설계 방식을 기반으로 개발되었으며 개발 과정 중 폴란드 기술자는 양산형 소련 전차 T-54의 구성 및 설계를 참고하였다. 설계도면으로만 존재한다."

msgid "Pl23_CS_53_Alpha_LS_BOT_short"
msgstr "CS-53"

msgid "Pl23_CS_53_LS_BOT"
msgstr "보초 CS-53"

msgid "Pl23_CS_53_LS_BOT_descr"
msgstr "1950년대 전반기에 바르샤바 육군 기술학교에서 여러 중형전차를 개발 중이었다. 해당 중형전차는 소련 전차 설계 방식을 기반으로 개발되었으며 개발 과정 중 폴란드 기술자는 양산형 소련 전차 T-54의 구성 및 설계를 참고하였다. 설계도면으로만 존재한다."

msgid "Pl23_CS_53_LS_BOT_short"
msgstr "보초"

