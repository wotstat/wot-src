msgid "notrecruitedtankman/tankmen_mtlb4_3/desc"
msgstr "육성의 세 번째 장수인 Li는 철퇴를 사용하는 거대한 체구의 강인한 인물입니다. 평정심을 유지하며 전투의 열기 속에서도 결코 흔들리지 않습니다. 이랑진군을 도와 길을 개척했으며, 화과산 수렴동의 관문을 가장 먼저 돌파했습니다."

msgid "notrecruitedtankman/tankmen_mtlb4_3/howToGetInfo"
