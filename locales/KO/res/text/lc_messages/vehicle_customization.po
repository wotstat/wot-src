msgid "projection_decals/special/projection_decal_122/description"
msgstr "당신이 서부에서 가장 빠른 총잡이일 수도 있고 가장 예리한 저격수일 수도 있지만, 운명의 수레바퀴도 그 사실에 동의할 것이라고 생각하십니까?"

msgid "projection_decals/special/projection_decal_123"
