msgid "T14_descr"
msgstr "1942년 5월부터 1943년 5월까지 개발이 진행되었다. 시험 주행 후 양산이 승인되었으나 결국 취소되어 실험 전차로만 남게 되었다. 시제 전차 2대만이 제작되었다."

msgid "T14_descr_MapsTraining_Player_HT_1"
