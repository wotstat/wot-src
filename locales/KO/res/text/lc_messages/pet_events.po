msgid "joke/event_1"
msgstr "개의 몸이 빛나면 의무대와 상의하십시오. 아니, 상의하지 마십시오. 그냥 못 들은 것으로 하십시오."

msgid "joke/event_10"
msgstr "개한테 수영 과정 통과하기는 마치 땅 짚고 헤엄치기처럼 쉬웠다고 합니다. 그 병사요? 힘들어 보이더군요."

msgid "joke/event_11"
msgstr "전술적 채집 작전이었다고 하죠. 간식을 대상으로 한..."

msgid "joke/event_12"
msgstr "꼬리를 흔들며 사납게 짖는 맹수가 있는데 뱀 퇴치제가 필요할까요?"

msgid "joke/event_13"
msgstr "고물 수집? 그보단 사기 진작 유물 선별이라고 하죠!"

msgid "joke/event_14"
msgstr "어떻게 작동하는지는 짐작도 안 갑니다. 대충 테니스공이랑 수수께끼의 원리로 돌아가려니 할 뿐이죠."

msgid "joke/event_15"
msgstr "지뢰 탐지기는 잊어버리세요. 날카로운 눈과 흔들리는 꼬리면 충분합니다."

msgid "joke/event_16"
msgstr "부대에서 가장 믿음직스러운 식품 정찰병으로 공식 인정받았습니다."

msgid "joke/event_17"
msgstr "놈이 어디서 와서 어디로 갔는지는 아무도 모릅니다. 다만 병사들의 사기는 올랐고, 치즈 보급은 줄었습니다."

msgid "joke/event_18"
msgstr "마지막 통신 기록은 \"위험 시 멍, 재장전 시 멍멍\"이었던 것으로 보입니다."

msgid "joke/event_19"
msgstr "침입자는 아니고 길을 잃었을 뿐이라는군요. 무장한 상태로."

msgid "joke/event_2"
msgstr "드디어 행정 절차를 빠르게 처리할 비결이 드러났습니다. 묻지도 따지지도 않는 네발 달린 대원만 있으면 되겠네요."

msgid "joke/event_20"
msgstr "센서의 시대는 갔습니다. 이젠 배관마다 개 한 마리씩만 배치해 두면 되겠네요."

msgid "joke/event_21"
msgstr "행여 강아지가 수송대보다 뛰어난 보급망을 펼쳤다면 그건 정말 보통 일이 아닙니다."

msgid "joke/event_22"
msgstr "렌치 건네는 속도가 최고참 정비병보다도 빠르다네요."

msgid "joke/event_23"
msgstr "자연재해도 막아내는 동물 대원의 힘을 볼 수 있었습니다."

msgid "joke/event_24"
msgstr "\"전투 준비상\"과 \"착한 강아지상\"을 동시에 받을 수 있는 유일한 승무원이었다고 합니다."

msgid "joke/event_25"
msgstr "혹시라도 장난감이 저절로 움직이기라도 하면 네가 처리하는 거다..."

msgid "joke/event_26"
msgstr "훈련에서 실전용 포탄이라니. 다행히도 개가 한 번 더 확인해 주었습니다."

msgid "joke/event_27"
msgstr "이달의 훈련병: 삽도 없이 네발로 산더미 같은 흙을 파냄."

msgid "joke/event_28"
msgstr "개가 요리를 지휘하긴 어렵지만, 꼬리로 소스를 휘저으면 볼만하겠네요."

msgid "joke/event_29"
msgstr "처방전: 알약 하루에 두 정, 방마다 말 잘 듣는 강아지 한 마리"

msgid "joke/event_3"
msgstr "지게차 면허는 없지만, 추진력은 넘칩니다."

msgid "joke/event_30"
msgstr "걸레질 끝, 먼지 털기 끝, 털갈이 두 번 끝. 대청소 끝!"

msgid "joke/event_4"
msgstr "숨겨져 있던 보물을 찾아낸 걸까요, 아니면 새 차고 하나를 통째로 세울 생각일까요?"

msgid "joke/event_5"
msgstr "군중을 해산시키는 데에는 삭힌 생선과 네발 달린 동물만큼 효과적인 게 없죠."

msgid "joke/event_6"
msgstr "개와 고양이가 함께라니, 해가 서쪽에서 뜰 일입니다."

msgid "joke/event_7"
msgstr "개가 예비 부품을 지키기 시작하더라도 걱정하지 마세요. 그저 수습 정비사로 진급하고 싶어 할 뿐이니까요."

msgid "joke/event_8"
msgstr "보름달이 뜬 밤에 개가 뭐라고 울부짖었는지 아십니까? \"월월(月月)!\""

msgid "joke/event_9"
msgstr "승무원들의 생명을 지키는 길에는 화재 예방 훈련과 군견 사육이 있습니다."

msgid "rewards/synergy_value"
msgstr "+"

msgid "rewards/title"
msgstr "그밖에 다음 유실물도 찾았습니다."

msgid "submit"
msgstr "확인"

msgid "text/event_1"
msgstr "{{@ style (color $color)}}정장 차림{{/}}의 {{@ style (color $color)}}낯선 남자{{/}}가 다가옵니다. \"기르시는 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}위험 물체{{/}} {{@ style (color $color)}}수색{{/}} 및 {{@ style (color $color)}}제거{{/}} 작업에 큰 도움이 되었습니다. 해당 작업에 관한 모든 자료는 {{@ style (color $color)}}기록{{/}}에서 {{@ style (color $color)}}삭제{{/}}될 예정입니다. 협력해 주셔서 감사합니다.\" 남자는 {{@ style (color $color)}}꾸러미{{/}} 하나를 건네고는 유유히 {{@ style (color $color)}}차고{{/}}를 떠납니다."

msgid "text/event_10"
msgstr "{{@ style (color $color)}}수중{{/}} {{@ style (color $color)}}전투 훈련{{/}} 도중 {{@ style (color $color)}}병사{{/}} 한 명이 {{@ style (color $color)}}계류줄{{/}}에 {{@ style (color $color)}}엉켜{{/}} 물에 {{@ style (color $color)}}빠졌습니다{{/}}. 다행히 근처에 있던 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}물에 빠진 병사{{/}}를 {{@ style (color $color)}}건져내어{{/}} 바로 {{@ style (color $color)}}안전한 곳{{/}}으로 옮겼습니다. 이 이야기는 곧 {{@ style (color $color)}}부대{{/}} 전체에 퍼져 {{@ style (color $color)}}용기{{/}}의 상징으로 자리 잡았습니다."

msgid "text/event_11"
msgstr "{{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}창고{{/}}에 있던 {{@ style (color $color)}}작은 가방{{/}}을 {{@ style (color $color)}}입{{/}}에 물고 달려 나옵니다. {{@ style (color $color)}}보급품을 빼내면{{/}} 안 된다고 {{@ style (color $color)}}꾸짖으려던{{/}} 참에, {{@ style (color $color)}}관리인{{/}}이 웃으며 말합니다. \"이렇게 착한 {{@ style (color $color)}}강아지{{/}}는 그냥 봐주게 됩니다.\" 그래도 {{@ style (color $color)}}예절{{/}} {{@ style (color $color)}}교육{{/}}은 조금 더 신경 쓰는 게 좋겠네요."

msgid "text/event_12"
msgstr "{{@ style (color $color)}}정기 시찰{{/}} 도중 {{@ style (color $color)}}병사들{{/}}이 한 {{@ style (color $color)}}막사{{/}} 근처에서 {{@ style (color $color)}}뱀 굴{{/}}을 찾았습니다. 이를 어떻게 {{@ style (color $color)}}해결{{/}}해야 좋을지 의논하는 사이, 충직한 {{@ style (color $color)}}개{{/}}가 큰 소리로 {{@ style (color $color)}}짖으면서{{/}} {{@ style (color $color)}}뱀들{{/}}을 {{@ style (color $color)}}맹공격{{/}}하여 쫓아냈습니다. {{@ style (color $color)}}저녁{{/}} 무렵 해당 {{@ style (color $color)}}지역{{/}}은 다시 {{@ style (color $color)}}안전한{{/}} 상태가 되었습니다. 개는 그 {{@ style (color $color)}}용기{{/}}에 합당한 {{@ style (color $color)}}보상{{/}}을 받아야 하죠."

msgid "text/event_13"
msgstr "가끔 {{@ style (color $color)}}아침{{/}}이면 {{@ style (color $color)}}개{{/}}가 어딘가로 {{@ style (color $color)}}달려간다{{/}}는 사실을 알게 되었습니다. 알고 보니 {{@ style (color $color)}}조종사{{/}}들 사이에는 {{@ style (color $color)}}이륙{{/}} 전에 {{@ style (color $color)}}강아지{{/}}를 {{@ style (color $color)}}쓰다듬으면서{{/}} {{@ style (color $color)}}행운{{/}}을 비는 관습이 있는 모양입니다. 궁금증을 못 참고 {{@ style (color $color)}}개가 꼬리를 흔들며{{/}} 가는 뒤를 계속해서 {{@ style (color $color)}}따라가{{/}} 보았더니 {{@ style (color $color)}}비밀 창고{{/}}에 도착했습니다. 그 안에는 {{@ style (color $color)}}병뚜껑{{/}}, {{@ style (color $color)}}단추{{/}}, {{@ style (color $color)}}씹은 흔적이 있는 양말{{/}}로 가득한 {{@ style (color $color)}}작은 상자{{/}}가 숨겨져 있었습니다."

msgid "text/event_14"
msgstr "우리 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}오래된 차고{{/}}에서 {{@ style (color $color)}}이상한 장치{{/}}를 찾아왔습니다. {{@ style (color $color)}}장치{{/}}에 {{@ style (color $color)}}전원을 넣자{{/}} 곧 안에 든 {{@ style (color $color)}}장난감{{/}}에 어떤 {{@ style (color $color)}}처리{{/}}를 가하더니 완전히 {{@ style (color $color)}}새로운 물건{{/}}을 내놓았습니다. {{@ style (color $color)}}변환{{/}} 작업을 몇 차례 더 거친 끝에 {{@ style (color $color)}}유용한 물건{{/}}을 건질 수 있었습니다."

msgid "text/event_15"
msgstr "{{@ style (color $color)}}훈련{{/}}이 진행되던 {{@ style (color $color)}}훈련장{{/}}에서 {{@ style (color $color)}}전차{{/}} 여러 대가 {{@ style (color $color)}}모형 지뢰{{/}}가 설치된 들판으로 진입하였습니다. 우리의 {{@ style (color $color)}}개{{/}}가 앞장서 달려 나가 {{@ style (color $color)}}승무원들{{/}}의 {{@ style (color $color)}}주의{{/}}를 끌고 {{@ style (color $color)}}위험{{/}}을 알려주었습니다. 동물 대원의 {{@ style (color $color)}}재빠른 대응{{/}} 덕분에 {{@ style (color $color)}}전차{{/}}가 {{@ style (color $color)}}다시 모여{{/}} {{@ style (color $color)}}장애물{{/}}을 무사히 넘길 수 있었습니다. 그리고 {{@ style (color $color)}}용맹한{{/}} 대원에게는 그에 합당한 {{@ style (color $color)}}보상{{/}}이 지급되었습니다."

msgid "text/event_16"
msgstr "{{@ style (color $color)}}차고{{/}}를 {{@ style (color $color)}}탐험{{/}}하던 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}상자{{/}} 뒤에 숨겨진 {{@ style (color $color)}}오래된 전투식량{{/}} {{@ style (color $color)}}더미{{/}}의 냄새를 맡았습니다. 그 \"{{@ style (color $color)}}보물{{/}}\"을 본 {{@ style (color $color)}}병사들{{/}}은 큰 소리로 웃고는 {{@ style (color $color)}}병참장교{{/}}에게 건넸습니다. {{@ style (color $color)}}뜻밖의 발견{{/}}을 한 {{@ style (color $color)}}개{{/}}에게는 {{@ style (color $color)}}보상{{/}}이 내려졌습니다."

msgid "text/event_17"
msgstr "수상한 {{@ style (color $color)}}소리{{/}}가 {{@ style (color $color)}}막사{{/}}에서 들렸습니다. 막사로 가 보니 {{@ style (color $color)}}병사들{{/}}이 모여 서서 {{@ style (color $color)}}개{{/}}와 거대한 {{@ style (color $color)}}근육질 쥐{{/}}의 {{@ style (color $color)}}싸움{{/}}을 지켜보고 있었습니다. 그러던 순간 {{@ style (color $color)}}알림{{/}}이 울려 모두가 {{@ style (color $color)}}주의를 빼앗겼고{{/}}, 다시 보니 {{@ style (color $color)}}괴물 쥐{{/}}가 어딘가로 {{@ style (color $color)}}사라지고{{/}} 없었습니다. {{@ style (color $color)}}재미있는 구경거리{{/}}를 보여준 것에 대한 감사의 의미로 {{@ style (color $color)}}병사들{{/}}이 {{@ style (color $color)}}개{{/}}에게 {{@ style (color $color)}}유용한 물품{{/}} 몇 개를 선물했습니다."

msgid "text/event_18"
msgstr "{{@ style (color $color)}}오래된 지휘실{{/}}을 {{@ style (color $color)}}탐사{{/}}하던 중, {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}먼지투성이 초상화{{/}}를 향해 {{@ style (color $color)}}짖기 시작{{/}}했습니다. 살짝 {{@ style (color $color)}}솔질{{/}}을 해 보니 {{@ style (color $color)}}쪽지{{/}} 하나가 {{@ style (color $color)}}액자{{/}} 뒤쪽에서 떨어졌습니다.{{br}}쪽지에는 {{@ style (color $color)}}야간 기동 작전{{/}} 도중 {{@ style (color $color)}}실종{{/}}되어 {{@ style (color $color)}}잊힌 한 전차 부대{{/}}에 관한 이야기가 적혀 있었습니다. 마지막으로 알려진 해당 부대의 {{@ style (color $color)}}호출부호{{/}}는 {{@ style (color $color)}}Iron Paw{{/}}(강철 발바닥)이었습니다."

msgid "text/event_19"
msgstr "평소와 다를 바 없는 {{@ style (color $color)}}주변 구역{{/}} {{@ style (color $color)}}순찰{{/}} 도중 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}덤불{{/}} 속으로 {{@ style (color $color)}}달려들어{{/}} 그 속에 숨어 있던 {{@ style (color $color)}}거수자{{/}}를 {{@ style (color $color)}}몰아내었습니다{{/}}. 달아나는 {{@ style (color $color)}}침입자{{/}}를 {{@ style (color $color)}}순찰대{{/}}가 {{@ style (color $color)}}붙잡았습니다{{/}}. {{@ style (color $color)}}사건{{/}}은 현재 {{@ style (color $color)}}추가 조사{{/}} 단계에 {{@ style (color $color)}}부쳐졌습니다{{/}}."

msgid "text/event_2"
msgstr "{{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}꼬리{{/}}를 흔들며 이쪽으로 달려옵니다. {{@ style (color $color)}}이빨{{/}} 사이에 {{@ style (color $color)}}종이{{/}} 뭉치가 물려 있습니다. 언뜻 보기에는 {{@ style (color $color)}}보고서{{/}}, {{@ style (color $color)}}도표{{/}} 등이 포함된 {{@ style (color $color)}}문서{{/}}로 보입니다. {{@ style (color $color)}}사무실{{/}} 사람들에게 돌려주면 참 좋아하겠네요."

msgid "text/event_20"
msgstr "{{@ style (color $color)}}근무지{{/}} 주변을 {{@ style (color $color)}}산책{{/}}하던 도중 {{@ style (color $color)}}개{{/}}가 갑자기 {{@ style (color $color)}}수도관{{/}} 하나를 향해 {{@ style (color $color)}}짖기{{/}} 시작했습니다. {{@ style (color $color)}}기술자들{{/}}이 해당 {{@ style (color $color)}}현장{{/}}을 {{@ style (color $color)}}점검{{/}}해 본 결과 중대한 {{@ style (color $color)}}시스템 고장{{/}}으로 이어질 수도 있는 {{@ style (color $color)}}결함{{/}}이 발견되었습니다. "

msgid "text/event_21"
msgstr "우리 {{@ style (color $color)}}개{{/}}가 온갖 {{@ style (color $color)}}잡동사니{{/}}로 가득한 {{@ style (color $color)}}가방{{/}} 하나를 물고 왔습니다. 다방면으로 조사해 보았음에도 그 가방의 {{@ style (color $color)}}출처{{/}}는 {{@ style (color $color)}}알아내지{{/}} 못하였습니다. 그동안 우리 {{@ style (color $color)}}동물 친구{{/}}는 곁에 가만히 앉아 {{@ style (color $color)}}뿌듯{{/}}하고 {{@ style (color $color)}}기분 좋은{{/}} 미소를 띤 채 남은 {{@ style (color $color)}}하루{{/}}를 즐겼습니다."

msgid "text/event_22"
msgstr "{{@ style (color $color)}}정비병들{{/}}이 {{@ style (color $color)}}개{{/}}에게 {{@ style (color $color)}}도구{{/}}를 {{@ style (color $color)}}식별 및 회수{{/}}하는 방법을 {{@ style (color $color)}}가르쳤습니다{{/}}. {{@ style (color $color)}}똑똑한 개{{/}}는 {{@ style (color $color)}}하루{{/}} 온종일 정비대와 {{@ style (color $color)}}함께하며{{/}} 노련한 {{@ style (color $color)}}승무원{{/}}처럼 시시각각 알맞은 {{@ style (color $color)}}장비{{/}}를 {{@ style (color $color)}}가져다주었습니다{{/}}."

msgid "text/event_23"
msgstr "{{@ style (color $color)}}순찰{{/}} 중이던 {{@ style (color $color)}}경비병{{/}} 한 명 위로 {{@ style (color $color)}}죽은 나무{{/}} 한 그루가 쓰러졌습니다. {{@ style (color $color)}}개{{/}}가 즉시 {{@ style (color $color)}}달려가 도움을 요청{{/}}하고 {{@ style (color $color)}}환자{{/}}를 {{@ style (color $color)}}나무줄기{{/}} 밑에서 끌어당겨 {{@ style (color $color)}}빼내는 데에도 도움{{/}}을 주었습니다. 이 {{@ style (color $color)}}이야기{{/}}는 {{@ style (color $color)}}순찰대원들{{/}} 사이에서 빠르게 {{@ style (color $color)}}회자{{/}}되었습니다. "

msgid "text/event_24"
msgstr "우리 {{@ style (color $color)}}개{{/}}가 가장 경험 많은 {{@ style (color $color)}}전차병{{/}}을 대상으로 한 {{@ style (color $color)}}시상식{{/}}에 참석했습니다. 성실한 {{@ style (color $color)}}개{{/}}는 {{@ style (color $color)}}도우미{{/}}로서 {{@ style (color $color)}}사회자{{/}}에게 {{@ style (color $color)}}훈장{{/}}과 {{@ style (color $color)}}선물{{/}}을 전달하는 역할을 맡았습니다. 그리고 이 {{@ style (color $color)}}공로{{/}}는 {{@ style (color $color)}}등한시{{/}}되지 않았고, {{@ style (color $color)}}개{{/}}에게는 마땅한 {{@ style (color $color)}}상{{/}}이 내려졌습니다."

msgid "text/event_25"
msgstr "{{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}너덜너덜한 여우 인형{{/}}을 물고 {{@ style (color $color)}}기지{{/}}로 돌아왔습니다. {{@ style (color $color)}}병사 몇 명{{/}}이 얼마 전 {{@ style (color $color)}}숲속{{/}}에서 {{@ style (color $color)}}속삭이는 소리{{/}}를 들었다고 합니다.{{br}}그날 {{@ style (color $color)}}저녁{{/}}, 병사 중 한 명이 {{@ style (color $color)}}인형{{/}}을 보고 수년 전 {{@ style (color $color)}}동계 기동 작전{{/}} 중에 {{@ style (color $color)}}실종{{/}}되어 {{@ style (color $color)}}해체된 정찰 부대{{/}}에서 사용하던 {{@ style (color $color)}}여우 문양{{/}}과 일치한다는 사실을 {{@ style (color $color)}}알아차렸습니다{{/}}. 해당 부대와 관련하여 남아있는 {{@ style (color $color)}}기록{{/}}은 없는 것 같습니다."

msgid "text/event_26"
msgstr "{{@ style (color $color)}}야전 훈련{{/}}용 {{@ style (color $color)}}보급품 배분{{/}} 도중 우리 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}사납게 짖기{{/}} 시작했습니다. 깜짝 놀란 {{@ style (color $color)}}장교들{{/}}이 상황을 {{@ style (color $color)}}상자{{/}}를 {{@ style (color $color)}}검사{{/}}해 본 결과, 일부 {{@ style (color $color)}}장비{{/}}가 {{@ style (color $color)}}훈련용 모조품{{/}}이 아닌 {{@ style (color $color)}}실전용 장비{{/}}로 잘못 준비되어 있었습니다."

msgid "text/event_27"
msgstr "{{@ style (color $color)}}군사 훈련{{/}} 도중 우리 {{@ style (color $color)}}동물 대원{{/}}이 {{@ style (color $color)}}참호 파기{{/}}에 무아지경이 되었습니다. 그 {{@ style (color $color)}}열기{{/}}는 {{@ style (color $color)}}훈련병들{{/}} 사이에 빠르게 {{@ style (color $color)}}퍼져나갔습니다{{/}}. 병사들은 돌연 {{@ style (color $color)}}개{{/}}를 상대로 참호를 파는 {{@ style (color $color)}}속도{{/}}와 {{@ style (color $color)}}깊이{{/}}를 {{@ style (color $color)}}겨루기{{/}} 시작했습니다. 그리고 {{@ style (color $color)}}교관들{{/}}은 그 광경을 {{@ style (color $color)}}흐뭇하게{{/}} 바라보았습니다."

msgid "text/event_28"
msgstr "{{@ style (color $color)}}병사들{{/}}이 사용 가능한 {{@ style (color $color)}}재료{{/}}로 {{@ style (color $color)}}현지 음식을 직접 조리{{/}}해 먹을 수 있는 {{@ style (color $color)}}부대{{/}} {{@ style (color $color)}}요리의 날{{/}}이었습니다. {{@ style (color $color)}}개{{/}}는 {{@ style (color $color)}}하루{{/}} 온종일 {{@ style (color $color)}}취사장 사이를 뛰어다니면서{{/}} {{@ style (color $color)}}보급품 나르기{{/}}를 거들었습니다. 그 과정에서 {{@ style (color $color)}}친절한 병사들{{/}}한테 얻어먹은 {{@ style (color $color)}}간식{{/}}이 꽤 많았던 모양입니다."

msgid "text/event_29"
msgstr "{{@ style (color $color)}}중요한 하루{{/}}가 시작되었습니다. 우리의 {{@ style (color $color)}}동물 대원{{/}}은 {{@ style (color $color)}}병원{{/}} 신세를 지고 있는 {{@ style (color $color)}}부상자들{{/}} 앞에서 사전에 가르쳐 둔 여러 {{@ style (color $color)}}묘기{{/}}를 선보이고 각 {{@ style (color $color)}}병사{{/}} 개개인과 {{@ style (color $color)}}시간을 보내는 등{{/}} {{@ style (color $color)}}위문{{/}}의 시간을 가졌습니다. 한동안 {{@ style (color $color)}}병동{{/}}은 {{@ style (color $color)}}웃음{{/}}으로 가득했고 {{@ style (color $color)}}흔들리는 꼬리{{/}}도 작은 행복을 더했습니다."

msgid "text/event_3"
msgstr "{{@ style (color $color)}}창고{{/}}에서 {{@ style (color $color)}}소년들{{/}}이 {{@ style (color $color)}}자루{{/}}와 {{@ style (color $color)}}짐{{/}}을 나르는 것을 {{@ style (color $color)}}개{{/}}가 도와주며 즐거워하는 모습이 보입니다. 하루가 끝날 무렵, {{@ style (color $color)}}작업반장{{/}}이 강아지의 도움에 고마워하며 작은 {{@ style (color $color)}}꾸러미{{/}} 하나를 건넵니다."

msgid "text/event_30"
msgstr "오늘은 우리의 {{@ style (color $color)}}개{{/}}가 사람들의 주목을 받지 않는 {{@ style (color $color)}}군무원{{/}}을 도왔습니다. {{@ style (color $color)}}개{{/}}는 분주히 움직이며 {{@ style (color $color)}}청소용품{{/}}을 나르기도 하고, 혼자서 {{@ style (color $color)}}바닥{{/}}에 {{@ style (color $color)}}걸레질{{/}}까지 해보려 했습니다. 그 {{@ style (color $color)}}서투른{{/}}, 그러나 {{@ style (color $color)}}결연한 노력{{/}}을 본 사람들은 남은 {{@ style (color $color)}}하루{{/}} 동안 {{@ style (color $color)}}투지{{/}}를 불태웠습니다."

msgid "text/event_4"
msgstr "{{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}나무 상자{{/}}를 끌고 들어왔습니다. 상자 안에는 서로 짝이 맞지 않는 조잡한 {{@ style (color $color)}}공구{{/}}가 가득 들어 있었습니다. 어디서 온 도구인지는 아무도 모르지만, 누군가 일부러 {{@ style (color $color)}}넣어 놓은{{/}} 것 같습니다."

msgid "text/event_5"
msgstr "{{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}스웨덴어 라벨{{/}}이 붙어 있는 {{@ style (color $color)}}깡통{{/}} 하나를 찾았습니다. {{@ style (color $color)}}뚜껑을 문{{/}} 상태로 장난스럽게 {{@ style (color $color)}}병사들을 뒤쫓자{{/}} 병사들은 깡통에서 나는 {{@ style (color $color)}}고약한 냄새{{/}}에 너도나도 {{@ style (color $color)}}달아나기{{/}} 시작했습니다. 그리고 그 옆을 지나가던 {{@ style (color $color)}}장병들{{/}} 중 한 명이 개의 {{@ style (color $color)}}장난{{/}}을 멈추면 {{@ style (color $color)}}보상{{/}}을 주겠다고 제안했습니다."

msgid "text/event_6"
msgstr "{{@ style (color $color)}}취사병{{/}} 중 한 명이 하루 종일 {{@ style (color $color)}}차고{{/}} 주변에 {{@ style (color $color)}}잃어버린 새끼 고양이{{/}}가 그려진 {{@ style (color $color)}}포스터{{/}}를 붙이고 다녔습니다. 우리의 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}수색{{/}}을 돕기로 했고, 몇 시간 뒤 한 {{@ style (color $color)}}막사{{/}} 근처에 숨어 있는 {{@ style (color $color)}}복슬복슬한 탈영병{{/}}이 발견되었습니다."

msgid "text/event_7"
msgstr "우리 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}이상한 장치{{/}}를 찾아내더니 하루 종일 물고 {{@ style (color $color)}}차고{{/}} 안을 돌아다녔습니다. 결국 {{@ style (color $color)}}기술자{{/}} 중 한 명이 살펴보고 해당 장치가 {{@ style (color $color)}}예비 전차 부품{{/}}임을 알아내어 조심스럽게 {{@ style (color $color)}}작업소{{/}}로 가져갔습니다. {{@ style (color $color)}}개{{/}}는 자신의 {{@ style (color $color)}}발견{{/}}에 무척 뿌듯해 보였습니다. 어떤 부품이었든 {{@ style (color $color)}}발견{{/}}에 대한 {{@ style (color $color)}}보상{{/}}이 지급될 수도 있겠네요."

msgid "text/event_8"
msgstr "{{@ style (color $color)}}보름달{{/}}이 뜬 밤이었습니다. {{@ style (color $color)}}달빛{{/}}에 이끌린 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}아침{{/}}까지 쉬지 않고 울부짖었습니다. 잠이 깨 버린 {{@ style (color $color)}}병사들{{/}}은 {{@ style (color $color)}}개{{/}}를 진정시키려 갖은 수를 써 보았지만 아무 소용도 없었습니다."

msgid "text/event_9"
msgstr "{{@ style (color $color)}}전차{{/}} 성능을 {{@ style (color $color)}}시험{{/}}하던 도중 한 대에서 {{@ style (color $color)}}불길{{/}}이 치솟았습니다. 사람들이 반응하기도 전에 {{@ style (color $color)}}개{{/}}가 {{@ style (color $color)}}불타는 전차{{/}} 쪽으로 달려가 {{@ style (color $color)}}승무원들{{/}}을 {{@ style (color $color)}}구조{{/}}하였습니다. 개가 떨친 {{@ style (color $color)}}용맹{{/}}이 담긴 무용담은 {{@ style (color $color)}}기지{{/}} 내에서 순식간에 퍼졌습니다."

