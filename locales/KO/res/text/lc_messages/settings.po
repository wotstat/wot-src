msgid "CUSTOM_AA_MODE"
msgstr "계단 현상 완화"

msgid "CUSTOM_AA_MODE/description"
msgstr "게임 화면 내 사물 윤곽선 처리 품질을 설정합니다. 계단 현상을 최소화합니다.\n\n• 높음—FXAA\n• 최고—계단 현상 완화 (TSSAA)"

msgid "DRR_AUTOSCALER_ENABLED"
msgstr "동적 렌더링 설정"

msgid "DRR_AUTOSCALER_ENABLED/description"
msgstr "비디오 카드 사용량에 따른 3D 렌더링 해상도 자동 조정 사용 여부를 설정합니다.\n\n해당 설정을 활성화하면 게임 성능이 향상됩니다. 차고 내 랜더링 해상도는 항상 동일하게 유지됩니다."

msgid "EFFECTS_QUALITY"
msgstr "추가 효과 품질"

msgid "EFFECTS_QUALITY/description"
msgstr "도탄, 폭발, 연기 등 추가 효과 발생 시 불꽃 시각 효과 품질을 설정합니다.\n\n품질을 낮추면 게임 성능이 향상됩니다."

msgid "FAR_PLANE"
msgstr "시야"

msgid "FAR_PLANE/description"
msgstr "기복 지형, 건물, 적 전차 등 기타 게임 사물의 거리 표시 품질을 설정합니다."

msgid "FLORA_QUALITY"
msgstr "식물 밀도"

msgid "FLORA_QUALITY/description"
msgstr "3인칭 시점 및 저격 시점에서 표시되는 식물 밀도를 설정합니다."

msgid "HAVOK_ENABLED"
msgstr "파괴 물리 효과 향상"

msgid "HAVOK_ENABLED/OFF"
msgstr "끄기"

msgid "HAVOK_ENABLED/ON"
msgstr "켜기"

msgid "HAVOK_ENABLED/description"
msgstr "게임 사물 파괴 처리가 더욱 세밀하고 현실적으로 향상됩니다.\n\n해당 설정을 끄면 게임 성능이 향상됩니다."

msgid "HAVOK_ENABLED/warning"
msgstr "현재 전투에서 비활성화한 설정은 다음 전투부터 적용됩니다."

msgid "LANGUAGE_CODE"
msgstr "ko"

msgid "LIGHTING_QUALITY"
msgstr "광원 품질"

msgid "LIGHTING_QUALITY/description"
msgstr "태양광, 광원, 광학 효과 품질을 조절합니다.\n\n품질을 높이면 비디오 카드에 무리가 갈 수 있습니다."

msgid "MOTION_BLUR_QUALITY"
msgstr "모션 블러 효과"

msgid "MOTION_BLUR_QUALITY/description"
msgstr "전차가 이동하고 카메라가 회전할 때 모션 블러 효과의 품질을 설정합니다."

msgid "MSAA_QUALITY"
msgstr "계단 현상 완화"

msgid "MSAA_QUALITY/description"
msgstr "게임 화면 내 사물 윤곽선 처리 품질을 설정합니다. 계단 현상을 최소화합니다.\n\n• 낮음—MSAA 2x\n• 중간—MSAA 4x\n• 높음—MSAA 8x"

msgid "OBJECT_LOD"
msgstr "사물 표현"

msgid "OBJECT_LOD/description"
msgstr "표시되는 사물 수와 품질을 설정합니다."

msgid "POST_PROCESSING_QUALITY"
msgstr "후처리"

msgid "POST_PROCESSING_QUALITY/description"
msgstr "아지랑이 효과, 충격파 효과, 색수차, 비네트 효과, 필름 그레인 효과 등 기타 후처리 시각 효과 품질을 설정합니다.\n\n품질을 낮추면 게임 성능이 향상됩니다."

msgid "RENDER_PIPELINE_QUALITY"
msgstr "그래픽"

msgid "RENDER_PIPELINE_QUALITY/description"
msgstr "간소: 일부 시각 효과의 품질 설정을 제한하여 게임 성능을 최적화합니다.\n\n향상: 이미지 품질을 최고로 설정할 수 있습니다."

msgid "RENDER_PIPELINE_QUALITY/label"
msgstr "그래픽:"

msgid "RENDER_PIPELINE_QUALITY/warning"
msgstr "해당 설정을 변경하면 게임을 다시 시작해야 합니다."

msgid "SEMITRANSPARENT_LEAVES_ENABLED"
msgstr "저격 모드 중 수풀 밀도"

msgid "SEMITRANSPARENT_LEAVES_ENABLED/description"
msgstr "저격 모드에서 주변 나무와 덤불 표시를 설정합니다.\n\n사용하지 않으면 저격 모드에서 주변 나무와 덤불이 모두 표시되지 않으며 게임 성능이 향상됩니다."

msgid "SHADER_VERSION_CAP"
msgstr "쉐이더 버전"

msgid "SHADOWS_QUALITY"
msgstr "그림자 품질"

msgid "SHADOWS_QUALITY/description"
msgstr "시야에 들어오는 동적 그림자 품질을 설정합니다.\n\n품질을 낮추면 게임 성능이 크게 향상됩니다."

msgid "SMOKE_ENABLED"
msgstr "연기"

msgid "SNIPER_MODE_EFFECTS_QUALITY"
msgstr "저격 모드 중 추가 효과"

msgid "SNIPER_MODE_EFFECTS_QUALITY/description"
msgstr "도탄, 불꽃, 폭발, 연기 등 저격 모드의 기타 실사 효과 품질을 설정합니다.\n\n품질을 낮추면 게임 성능이 향상됩니다."

msgid "SNIPER_MODE_GRASS_ENABLED"
msgstr "저격 모드 중 수풀 표현"

msgid "SNIPER_MODE_GRASS_ENABLED/description"
msgstr "저격 모드에서 수풀을 표시합니다.\n\n해당 설정을 끄면 게임 성능이 향상됩니다."

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED"
msgstr "저격 모드 지형 테셀레이션"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED/description"
msgstr "저격 모드 사용 시 전차로부터 50m 이내 지형 품질을 향상합니다. 지형 테셀레이션 설정을 활성화해야 사용할 수 있습니다.\n\n해당 설정을 끄면 게임 성능이 향상됩니다."

msgid "SPEEDTREE_QUALITY"
msgstr "식물 품질"

msgid "SPEEDTREE_QUALITY/description"
msgstr "나무, 수풀, 덤불 묘사 품질을 설정합니다."

msgid "TERRAIN_QUALITY"
msgstr "지형 품질"

msgid "TERRAIN_QUALITY/description"
msgstr "지도의 기복 지형 거리 품질을 설정합니다.\n\n풍경 품질 최소 설정은 컴퓨터 성능이 떨어질 때만 사용하십시오.\n\n품질을 낮추면 클라이언트와 서버 간 환경 표시 동기화가 해제될 수도 있습니다."

msgid "TERRAIN_QUALITY/warning"
msgstr "설정을 적용하려면 다소 시간이 걸릴 수 있습니다."

msgid "TERRAIN_TESSELLATION_ENABLED"
msgstr "지형 테셀레이션"

msgid "TERRAIN_TESSELLATION_ENABLED/description"
msgstr "메시 세부 묘사를 향상할 수 있도록 삼각형을 폴리곤 메시에 추가하는 하드웨어 가속 처리 작업입니다.\n\n사용 조건\n• 향상 그래픽 설정\n• 높음, 최고, 울트라 지형 품질\n• DirectX 11 설치\n\n해당 설정은 DirectX 11 이전 버전에서는 사용할 수 없습니다.\n\n해당 설정을 끄면 게임 성능이 향상됩니다."

msgid "TEXTURE_QUALITY"
msgstr "사물 질감 품질"

msgid "TEXTURE_QUALITY/description"
msgstr "게임 내 사물의 세부 묘사 품질입니다.\n\n품질을 낮추면 게임 성능이 향상됩니다."

msgid "TEXTURE_QUALITY/warning"
msgstr "설정을 적용하려면 다소 시간이 걸릴 수 있습니다."

msgid "TRACK_PHYSICS_QUALITY"
msgstr "궤도 물리 효과"

msgid "TRACK_PHYSICS_QUALITY/description"
msgstr "파괴된 궤도와 작동 중인 궤도 등 궤도 관련 물리 효과 품질을 결정합니다.\n\n해당 설정을 낮추거나 끄면 게임 성능이 향상됩니다."

msgid "VEHICLE_DUST_ENABLED"
msgstr "궤도 및 차륜 효과 활성화"

msgid "VEHICLE_DUST_ENABLED/description"
msgstr "전차가 지날 때 흙먼지, 눈 날림, 물보라를 표시합니다.\n\n설정을 끄면 게임 성능이 향상됩니다."

msgid "VEHICLE_TRACES_ENABLED"
msgstr "궤도 및 차륜 자국 활성화"

msgid "VEHICLE_TRACES_ENABLED/description"
msgstr "지면에 궤도 및 차륜 자국을 표시합니다.\n\n간소 그래픽 설정, 낮음 데칼 품질에서는 이용할 수 없습니다."

msgid "VISIBILITY_TUNNEL_ENABLED"
msgstr "저격 모드에서 3D 부착물 숨기기"

msgid "VISIBILITY_TUNNEL_ENABLED/description"
msgstr "저격 모드에서 조준원 주변에 표시되는 전차의 3D 부착물을 임시로 숨깁니다.\n\n시각적 혼잡이 줄어들고 조준 정확도가 향상됩니다."

msgid "WATER_QUALITY"
msgstr "수면 품질"

msgid "WATER_QUALITY/description"
msgstr "수면 품질을 설정합니다."

msgid "aim/armorFlashlight/colorSchema/greenShades/label"
msgstr "약점만"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/body"
msgstr "장갑 구분색 활성화 시 표적 장갑의 약점만 강조됩니다.\n\n장갑 관통 확률이 높은 부분은 진한 녹색으로, 중간 수준인 부분은 반투명한 녹색으로 표시됩니다. 색약 모드 사용 시 색상이 다르게 표시될 수 있습니다."

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/header"
msgstr "약점만 강조"

msgid "aim/armorFlashlight/colorSchema/redShades/label"
msgstr "강점만"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/body"
msgstr "장갑 구분색 활성화 시 표적 장갑의 강점만 강조됩니다.\n\n장갑 관통 확률이 낮거나 없는 부분은 진한 빨간색으로, 중간 수준인 부분은 반투명한 빨간색으로 표시됩니다. 색약 모드 사용 시 색상이 다르게 표시될 수 있습니다."

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/header"
msgstr "강점만 강조"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/label"
msgstr "모든 장갑"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/body"
msgstr "장갑 구분색 활성화 시 표적 장갑의 강약점이 모두 강조됩니다.\n\n장갑 관통 확률이 낮거나 없는 부분은 빨간색으로, 높은 부분은 녹색으로, 중간 수준인 부분은 노란색으로 표시됩니다. 색약 모드 사용 시 색상이 다르게 표시될 수 있습니다."

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/header"
msgstr "모든 장갑 강조"

msgid "aim/armorFlashlight/colorSchemas"
msgstr "강조할 장갑"

msgid "aim/armorFlashlight/enabled/label"
msgstr "전투 시작 시 활성화"

msgid "aim/armorFlashlight/enabled/tooltip/body"
msgstr "전투 시작 시 장갑 구분색 활성화 여부를 설정합니다. 장갑 구분색은 지정된 단축키를 눌러 언제든 활성화/비활성화할 수 있습니다.\n\n장갑 구분색은 저격 모드에서만 적용됩니다.\n\n기능 지원 모드\n• 무작위 전투 및 팀 연습 전투\n• 전선 대격돌\n• 아케이드\n• 격전\n• 기타 모드 및 이벤트\n\n추후 지원 모드 및 이벤트가 추가될 수 있습니다."

msgid "aim/armorFlashlight/enabled/tooltip/header"
msgstr "전투 시작 시 활성화"

