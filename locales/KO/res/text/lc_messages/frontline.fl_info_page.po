msgstr "주력"

msgid "reserveCategories/categories/support"
msgstr "예비"

msgid "reserveCategories/config/footerText"
msgstr "{{@ colorLegacy 'FFE4C0'}}운명의 장난{{/}} 시나리오에서는 전차 유형이 물자 해제 순서에 영향을 미치지 않습니다."

msgid "reserveCategories/config/header"
msgstr "전차 유형별 물자 구성"

msgid "reserveCategories/config/text"
msgstr "{{@ colorLegacy 'FFE4C0'}}일반 전투{{/}} 및 {{@ colorLegacy 'FFE4C0'}}전술 지원{{/}} 시나리오에서는 모든 전차가 전차 유형과 관계없이 전시 물자 슬롯 3개를 모두 이용할 수 있습니다. 하지만 슬롯이 해제되는 순서는 전차 유형마다 다릅니다."

msgid "reserveCategories/config/vehicles/destroyer"
msgstr "구축전차"

msgid "reserveCategories/config/vehicles/heavy"
msgstr "중전차"

msgid "reserveCategories/config/vehicles/light"
msgstr "경전차"

msgid "reserveCategories/config/vehicles/middle"
msgstr "중형전차"

msgid "reserveCategories/config/vehicles/selfPropelled"
msgstr "자주포"

msgid "reserveCategories/levelUpNote"
msgstr "* {{@ colorLegacy 'FFE4C0'}}운명의 장난{{/}} 시나리오에서 {{@ colorLegacy 'FFE4C0'}}구매해 둔 전시 물자{{/}}를 선택한 경우에만 해당 레벨까지 강화할 수 있습니다."

msgid "reserveCategories/levels/header"
msgstr "슬롯 해제 및 전시 물자 강화 방법"

msgid "reserveCategories/levels/text"
msgstr "전시 물자 하나는 기본으로 주어지며 나머지 물자는 병장 및 중위 계급 달성 시 해제됩니다. 대위 및 소령 계급 달성 시에는 각각 세 물자 모두 강화됩니다."

msgid "reserveCategories/progression/tableCell"
msgstr "레벨 {{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} 또는 {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}}"

