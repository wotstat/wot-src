msgid "G25_PzII_Luchs_Alpha_LS_BOT"
msgstr "토끼"

msgid "G25_PzII_Luchs_Alpha_LS_BOT_descr"
msgstr "Pz.Kpfw. II Ausf. C와 비교하여 신형 차체와 포탑을 장착하였으며 엇갈리게 배열된 전륜을 사용하였다. 정찰 전차로써 뛰어난 성능을 자랑하였지만, 생산 비용 문제로 L형 개량형 131대만이 생산되었다."

msgid "G25_PzII_Luchs_Alpha_LS_BOT_short"
msgstr "토끼"

msgid "G25_PzII_Luchs_LS_BOT"
msgstr "토끼"

msgid "G25_PzII_Luchs_LS_BOT_descr"
msgstr "Pz.Kpfw. II Ausf. C와 비교하여 신형 차체와 포탑을 장착하였으며 엇갈리게 배열된 전륜을 사용하였다. 정찰 전차로써 뛰어난 성능을 자랑하였지만, 생산 비용 문제로 L형 개량형 131대만이 생산되었다."

msgid "G25_PzII_Luchs_LS_BOT_short"
msgstr "토끼"

msgid "G54_E-50_LS_BOT"
msgstr "알파 E 50"

msgid "G54_E-50_LS_BOT_descr"
msgstr "E 50은 1945년 Panther와 Panther II를 대체할 표준 중형전차로 개발되었다. 설계 도면으로만 존재한다."

msgid "G54_E-50_LS_BOT_short"
msgstr "알파"

msgid "G57_PzVI_Tiger_P_LS_BOT"
msgstr "보초 Tiger (P)"

msgid "G57_PzVI_Tiger_P_LS_BOT_descr"
msgstr "1941년 5월 26일 아돌프 히틀러는 페르디난트 포르셰와 헨셸사에 새로운 중전차를 개발할 것을 명령하였다. 1942년 4월 20일 히틀러에게 시제 전차를 선보였고 제작을 시작했지만, 조종 시스템이 복잡하고 생산에 필요한 구리가 부족하여 곧 생산이 중단되었다. 이때 생산된 차체 90대는 이후 Ferdinand 구축전차에 장착되었다."

msgid "G57_PzVI_Tiger_P_LS_BOT_short"
msgstr "보초"

msgid "G58_VK4502P_LS_BOT"
msgstr "보초 VK 45.02 (P)"

msgid "G58_VK4502P_LS_BOT_descr"
msgstr "페르디난트 포르셰에 의해 시제 전차 2대(전방 포탑형, 후방 포탑형 각 1대)가 제작되었으나 양산되지는 않았다."

msgid "G58_VK4502P_LS_BOT_short"
msgstr "보초"

msgid "G64_Panther_II_LS_BOT"
msgstr "사냥꾼 Panther II"

msgid "G64_Panther_II_LS_BOT_descr"
msgstr "1943년 개발이 시작되어 1944년 Panther I의 포탑을 탑재한 시제 전차 2대의 제작이 시작되었지만 1945년까지 MAN 사에 의해 단 한 대만이 제작되었다."

msgid "G64_Panther_II_LS_BOT_short"
msgstr "사냥꾼"

msgid "G67_VK4502A_LS_BOT"
msgstr "보초 VK 45.02 A"

msgid "G67_VK4502A_LS_BOT_descr"
msgstr "VK 45.01 (P)를 개량한 전차 기획안이다. 10기통 Porsche 엔진이 시험을 통과하지 못해 시제 전차조차 제작하지 않았으며 이미 제작한 포탑은 초기 Tiger II에 장착되었다."

msgid "G67_VK4502A_LS_BOT_short"
msgstr "보초"

msgid "G73_E50_Ausf_M_LS_BOT"
msgstr "알파 E 50 M"

msgid "G73_E50_Ausf_M_LS_BOT_descr"
msgstr "독일군은 E 계열 전차의 변속기를 차체 후면에 배치하려 했다. 하지만, E 50와 E 75 전차는 기술자가 더 빨리 작업할 수 있도록 Tiger II 전차의 엔진과 변속기를 사용하여 차체 후면에 변속기를 배치할 수는 없었다. E-50 Ausf. M은 E 50 차체 후면에 변속기를 장착할 수 있도록 재설계한 전차이다."

msgid "G73_E50_Ausf_M_LS_BOT_short"
msgstr "알파"

msgid "G88_Indien_Panzer_LS_BOT"
msgstr "보초 Indien-Pz."

msgid "G88_Indien_Panzer_LS_BOT_descr"
msgstr "인도 육군의 중형전차 개발 기획으로 설계된 전차다. 1954년부터 1955년까지 개발되었으며 포르셰사, 다임러 벤츠사, 프리드릭스하펜의 찬라트파브리크 AG사가 참여하였다. 그러나 인도에서 생산하기에는 지나치게 복잡해 기획안이 취소되었다."

msgid "G88_Indien_Panzer_LS_BOT_short"
msgstr "보초"

msgid "G97_Waffentrager_IV_LS_BOT"
msgstr "알파 WT auf Pz.IV"

msgid "G97_Waffentrager_IV_LS_BOT_descr"
msgstr "1944년 2월 PzIV 전차의 차체를 이용하여 개발된 구축전차로, 체코제 12.8cm PaK 44포를 탑재한 크룹사의 Waffentrager가 채택되면서 중단되었다. 도면만이 존재한다."

msgid "G97_Waffentrager_IV_LS_BOT_short"
msgstr "알파"

msgid "G99_RhB_Waffentrager_LS_BOT"
msgstr "알파 Rhm.-B. WT"

msgid "G99_RhB_Waffentrager_LS_BOT_descr"
msgstr "Rheinmetall-Borsig사가 개발한 특수 야포 운반차량으로 야포 운반과 동시에 직접 사격할 수 있도록 설계되었으며 Hetzer 구축전차의 현가장치를 사용하였다. 개발은 1942년부터 1944년 중반까지 이어졌으나, 복잡한 설계와 높은 생산 단가 그리고 지나친 하중 문제로 계획이 폐기되었다."

msgid "G99_RhB_Waffentrager_LS_BOT_short"
msgstr "알파"

