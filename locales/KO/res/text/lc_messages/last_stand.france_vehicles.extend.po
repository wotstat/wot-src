msgid "F110_Lynx_6x6_LS_BOT"
msgstr "덫꾼"

msgid "F110_Lynx_6x6_LS_BOT_descr"
msgstr "Panhard AML 전차의 개량형으로 6륜 구동 현가장치, 새로운 포탑, 더욱 강력한 무장을 장착하였다."

msgid "F110_Lynx_6x6_LS_BOT_short"
msgstr "덫꾼"

msgid "F17_AMX_13_90_LS_BOT"
msgstr "오염체 Hornet"

msgid "F17_AMX_13_90_LS_BOT_descr"
msgstr "기동성이 뛰어나며 5연발 클립식 주포를 탑재한 전차입니다."

msgid "F17_AMX_13_90_LS_BOT_short"
msgstr "오염체"

msgid "F71_AMX_30_prototype_LS_BOT"
msgstr "보초 A.P. AMX 30"

msgid "F71_AMX_30_prototype_LS_BOT_descr"
msgstr "유럽 표준 전차 협정에 따라 개발되었다. 강력한 엔진 출력을 바탕으로 기동성이 좋고 Leopard 1 다음으로 뛰어난 대전차 사거리를 자랑한다. 대전차 포탄 기술의 발달로 장갑 자체가 무의미해지자 두꺼운 장갑을 버리고 기동성과 화력에 집중하여 장갑을 얇게 제작하였다."

msgid "F71_AMX_30_prototype_LS_BOT_short"
msgstr "보초"

msgid "F73_M4A1_Revalorise_LS_BOT"
msgstr "보초 M4A1 Rev."

msgid "F73_M4A1_Revalorise_LS_BOT_descr"
msgstr "1950년 다양한 개조 작업을 거친 M4 Sherman을 상호 방위 지원 계획을 통하여 프랑스에 공급하였다. 프랑스 설계국은 M4 Sherman를 현대화하여 화력을 강화하려 했으며 이러한 전차 현대화 작업은 이스라엘 방어군 Sherman M51 현대화 작업으로 이어졌다. 프랑스에서 제식 채용되지 않았으며 생산된 시제 전차 수는 알려지지 않았다."

msgid "F73_M4A1_Revalorise_LS_BOT_short"
msgstr "보초"

msgid "F74_AMX_M4_1949_LS_BOT"
msgstr "보초 AMX M4 49"

msgid "F74_AMX_M4_1949_LS_BOT_descr"
msgstr "Project 141로 명명되어 개발된 중전차이다. 현대적인 중전차의 필요성이 대두되어 제2차 세계대전 종전 직후 개발이 시작되었다. 설계도로만 존재한다."

msgid "F74_AMX_M4_1949_LS_BOT_short"
msgstr "보초"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT"
msgstr "보초 AMX M4 54"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_descr"
msgstr "프로젝트 141을 기반으로 정면 장갑을 강화한 중전차 AMX M4 개량형이다. 280mm 장갑판을 장착하여 정면 장갑을 강화하기로 하였다. 설계 도면으로만 존재한다."

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_short"
msgstr "보초"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT"
msgstr "보초 AMX M4 51"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_descr"
msgstr "Project 141은 중전차 AMX M4의 정면 장갑을 강화한 개량형이다. 1949년 11월부터 개발이 시작되었지만, 실제로 제작되지는 않았다. 프로젝트 141에는 같은 차대에 다양한 차체를 장착한 설계도도 여럿 포함되어 있었다."

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_short"
msgstr "보초"

