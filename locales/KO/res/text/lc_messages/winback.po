msgid "modeInfoTooltip/title"
msgstr "준비 운동"

msgid "selectableRewardTooltip/basic/description"
msgstr "원하는 {{level}}단계 일반 전차를 선택할 수 있습니다. 해당 전차는 연구가 완료된 부품, 승무원, 차고 슬롯이 함께 지급됩니다."

msgid "selectableRewardTooltip/basic/title"
msgstr "{{level}}단계 전차"

msgid "selectableRewardTooltip/discount/description"
msgstr "{{level}}단계 전차 연구 시 {{researchDiscount}} 할인, 구매 시 {{purchaseDiscount}} 할인이 적용됩니다. 일반 전차는 어떤 전차든 선택 가능합니다."

msgid "selectableRewardTooltip/discount/footer"
msgstr "{{@ style (color $color)}}연구{{/}} 비용 할인은 전차 설계도면 조각 할인에 추가됩니다. {{@ style (color $color)}}구매{{/}} 비용 할인은 가장 큰 할인이 적용됩니다."

