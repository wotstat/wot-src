msgid "tankman/lore/men_race19_commanderB"
msgstr "위대한 레이스 참가자 중 한 명으로 뛰어난 조종수이자 재능있는 교관입니다. 지칠 줄 모르는 실험가로서 신병들에게 언제나 참신한 아이디어와 혁신적인 해결책을 제공합니다."

msgid "tankman/lore/men_race19_commanderB_en"
