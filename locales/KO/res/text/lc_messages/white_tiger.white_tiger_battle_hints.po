msgid "battleHints/wtBattleStart_boss"
msgstr "침입자를 사냥하십시오!\n제한 시간 동안 생존해야 합니다."

msgid "battleHints/wtBattleStart_hunters"
msgstr "Blitzträger를 격파하십시오!\n보호막을 없애려면 발전기를 과부하해야 합니다."

msgid "battleHints/wtBossHyperionDeploy"
msgstr "! 경고 !\n히페리온이 발사됩니다!"

msgid "battleHints/wtBossHyperionReady"
msgstr "히페리온이 충전되었습니다!"

msgid "battleHints/wtBossInvincible"
msgstr "Blitzträger의 보호막이 다시 활성화됩니다!"

msgid "battleHints/wtBossTeleport"
msgstr "Blitzträger가 순간 이동 중입니다!"

msgid "battleHints/wtCampKilled_boss"
msgstr "발전기가 취약한 상태입니다."

msgid "battleHints/wtCampKilled_hunters"
msgstr "발전기를 과부하할 수 있습니다."

msgid "battleHints/wtEndgameStart_boss"
msgstr "보호막이 사라지며 다시 복구되지 않습니다!"

msgid "battleHints/wtEndgameStart_hunters"
msgstr "Blitzträger의 보호막이 완전히 사라졌습니다."

msgid "battleHints/wtGeneratorCaptured_boss"
msgstr "보호막이 사라졌습니다!"

msgid "battleHints/wtGeneratorCaptured_hunters"
msgstr "Blitzträger의 보호막이 사라졌습니다!\n지금 공격하십시오!"

msgid "battleHints/wtMiniBossDestroyed"
msgstr "Ermelinda를 격퇴했습니다!"

msgid "battleHints/wtMiniBossSpawned"
msgstr "Ermelinda가 전투에 합류했습니다!"

msgid "battleHints/wtOvertime_boss"
msgstr "발전기를 사수하십시오!"

msgid "battleHints/wtOvertime_header"
msgstr "추가 시간"

msgid "battleHints/wtOvertime_hunters"
msgstr "발전기를 과부하하십시오!"

msgid "battleHints/wtTimeRemaining_boss"
msgstr "얼마 남지 않았습니다!\n조금만 더 버티십시오."

msgid "battleHints/wtTimeRemaining_hunter"
msgstr "서둘러 마무리하십시오!\n시간이 얼마 남지 않았습니다!"

msgid "loading/winText/boss"
msgstr "Von Krieger\n진정한 힘이 무엇인지 보여주십시오."

msgid "loading/winText/hunters"
msgstr "모든 수단을 동원하여\nVon Krieger를 저지하십시오."
