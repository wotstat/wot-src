msgid "battlePassSeasonDescription"
msgstr "신규 테마 3D 스타일"

msgid "beCareful"
msgstr "자가 진단"

msgid "comp7Core10"
msgstr "전투 대기 중에는 선택한 전차를 상황에 적합한 전차로 변경할 수 있습니다."

msgid "comp7Core10Status"
msgstr "전투 대기 중"

msgid "comp7Core11"
msgstr "전투 대기 화면에는 승무원 탑승 및 포탄 보급이 완료된 전차가 표시됩니다. 전투가 시작되기 전에 전차 준비를 마무리하는 것을 잊지 마십시오."

msgid "comp7Core11Status"
msgstr "전투 대기 중"

msgid "comp7Core12"
msgstr "전차를 선택하고 나면 아군이 선택한 전차를 확인할 수 있도록 선택 확인 버튼을 눌러 주십시오."

msgid "comp7Core12Status"
msgstr "전투 대기 중"

msgid "comp7Core13"
msgstr "선택 확인 버튼을 클릭한 후에는 전차를 변경할 수 없습니다."

msgid "comp7Core13Status"
msgstr "선택 확인"

msgid "comp7Core14"
msgstr "특별 거점을 점령하면 전술 기술을 사용하여 우위를 점할 수 있습니다."

msgid "comp7Core14Status"
msgstr "거점"

msgid "comp7Core15"
msgstr "지도에 나타나는 거점입니다. 해당 거점을 점령하면 전파 탐지 전술 기술을 사용할 수 있습니다. 전술 기술 활성화 시 모든 적군이 수 초 동안 발견 상태가 됩니다."

msgid "comp7Core15Status"
msgstr "무전 센터"

msgid "comp7Core16"
msgstr "지도에 나타나는 거점입니다. 해당 거점을 점령하면 포격 지원 전술 기술을 사용할 수 있습니다. 전술 기술 활성화 시 포격을 퍼부을 지점을 선택할 수 있습니다."

msgid "comp7Core16Status"
msgstr "포병 본부"

msgid "comp7Core17"
msgstr "포격 지원 전술 기술이 아군에 명중 시 아군은 피해를 받지 않습니다. 하지만 폭발 충격은 받습니다."

msgid "comp7Core17Status"
msgstr "포격 지원"

msgid "comp7Core18"
msgstr "참고: 해당 모드 지도는 무작위 전투와 다를 수 있습니다."

msgid "comp7Core18Status"
msgstr "이벤트 지도"

msgid "comp7Core19"
msgstr "플레이어 7명으로 소대를 조직하면 전투에서 승리할 확률을 높일 수 있습니다."

msgid "comp7Core19Status"
msgstr "협동이 핵심"

msgid "comp7Core21"
msgstr "전투 중 Tab 키 또는 Alt 키를 눌러 아군 역할 기술 충전 레벨을 확인할 수 있습니다."

msgid "comp7Core21Status"
msgstr "아군 역할 기술"

msgid "comp7Core22"
msgstr "팀 목록에서 아군의 전술 기술 보유 여부를 확인할 수 있습니다. 적군 전술 기술은 표시되지 않습니다."

msgid "comp7Core22Status"
msgstr "전술 기술"

msgid "comp7Core23"
msgstr "전차가 역할 기술의 영향을 받게 되면 플레이어 표식 위에 이를 알리는 아이콘이 표시됩니다."

msgid "comp7Core23Status"
msgstr "역할 기술 효과"

msgid "comp7Core24"
msgstr "H 키(기본값)로 음성 대화를 할 수 있습니다. 음성 대화로 팀과 효율적으로 소통해 보십시오."

msgid "comp7Core24Status"
msgstr "음성 대화"

msgid "comp7Core25"
msgstr "음성 대화에 문제가 있으면 게임 클라이언트 설정을 확인해 주십시오."

msgid "comp7Core25Status"
msgstr "음성 대화"

msgid "comp7Core29"
msgstr "Alt 키를 누르면 관측 범위 내 모든 전차 역할이 플레이어 표식 위에 표시됩니다. 아군 플레이어는 역할 기술 충전 레벨도 함께 표시됩니다."

msgid "comp7Core29Status"
msgstr "전차 역할"

msgid "comp7Core31"
msgstr "게임 설정에서 역할 기술 및 전술 기술 단축키를 변경할 수 있습니다."

msgid "comp7Core31Status"
msgstr "조작 설정"

msgid "comp7Core32"
msgstr "일정 시간이 지나면 거점을 다시 점령할 수 있습니다."

msgid "comp7Core32Status"
msgstr "거점"

msgid "comp7Core33"
msgstr "거점은 관련 전술 기술을 사용할 때까지 점령할 수 없습니다."

msgid "comp7Core33Status"
msgstr "거점"

msgid "comp7Core34"
msgstr "거점을 점령하면 영예 점수가 지급됩니다."

msgid "comp7Core34Status"
msgstr "거점"

msgid "comp7Core35"
msgstr "영예 점수 획득에 관한 자세한 내용은 이벤트 규정에서 확인할 수 있습니다."

msgid "comp7Core35Status"
msgstr "영예 점수"

msgid "comp7Core37"
msgstr "해당 모드에서는 전차 내구도, 소모품 재사용 시간, 전차 발각 유지 시간 등 전차의 특정 성능이 변동됩니다."

msgid "comp7Core37Status"
msgstr "격전 성능 변동"

msgid "comp7Core5"
msgstr "각 전차에는 전차 역할에 따른 특별 기술이 존재합니다. 각 기술에는 3단계로 구분되는 충전 레벨이 있습니다. 기술 활성화 시 충전 레벨이 높을수록 효과가 강력해집니다."

msgid "comp7Core5Status"
msgstr "역할 기술"

msgid "comp7Core6"
msgstr "영예 점수는 전투에서 뛰어난 활약을 펼치거나, 거점을 점령하거나, 기술을 사용하면 획득합니다."

msgid "comp7Core6Status"
msgstr "영예 점수"

msgid "comp7Core8"
msgstr "적군이 탐지되기 전까지는 적 전차에 관한 정보가 제공되지 않습니다."

msgid "comp7Core8Status"
msgstr "전장의 안개"

msgid "comp7Light7"
msgstr "격전 라이트 모드 세부 정보는 이벤트 화면에서 \"이벤트 정보\" 버튼을 클릭하여 확인할 수 있습니다."

msgid "comp7Light7Status"
msgstr "모드 세부 정보"

msgid "comp7Light9"
msgstr "다양한 역할의 8단계 전차를 보유하고 있다면 매 전투에 가장 적합한 전차를 선택하여 아군 전차와의 조화를 도모할 수 있습니다."

msgid "comp7Light9Status"
msgstr "차고 확장"

msgid "comp7NightMaps38"
msgstr "야간 지도에서는 야간 환경, 새로운 관측 지점, 업데이트된 거점, 변경된 탐지 시스템을 통해 익숙한 전장에서 새로운 전투를 펼칠 수 있습니다."

msgid "comp7NightMaps38Status"
msgstr "야간 지도"

msgid "comp7Ranked0"
msgstr "레이팅 점수를 건 전투에서 최고 랭크를 달성하고 실력을 증명해 보십시오."

msgid "comp7Ranked0Status"
msgstr "랭크 시스템"

msgid "comp7Ranked1"
msgstr "전투에서 영예 점수를 많이 획득할수록 승리 시 지급되는 레이팅 점수가 증가하며 패배 시 잃는 레이팅 점수는 감소합니다."

msgid "comp7Ranked1Status"
msgstr "영예 점수 및 레이팅 점수"

msgid "comp7Ranked2"
msgstr "격전 모드에서는 랭크가 비슷한 플레이어끼리 전투에 참여하게 됩니다."

msgid "comp7Ranked20"
msgstr "전투가 끝나기 전에 전장에서 이탈하면 아군이 불리한 상황에 놓입니다. 전장을 이탈한 플레이어는 일시적으로 모드 이용이 차단되거나 레이팅 점수가 차감됩니다."

msgid "comp7Ranked20Status"
msgstr "전장 이탈"

msgid "comp7Ranked26"
msgstr "순위표에는 챔피언 및 레전드 랭크 플레이어만이 표시됩니다. 순위표에 진출한 모든 플레이어에게는 일일 보상이 지급됩니다."

msgid "comp7Ranked26Status"
msgstr "순위표"

msgid "comp7Ranked27"
msgstr "전장에서 이탈한 플레이어는 일시적으로 모드 이용이 차단됩니다. 이후에도 계속 규정을 위반하면 차단 기간이 늘어납니다."

msgid "comp7Ranked27Status"
msgstr "임시 차단"

msgid "comp7Ranked28"
msgstr "해당 모드 전투에 참여하여 격전 진행 스타일 신규 요소를 해제해 보십시오."

msgid "comp7Ranked28Status"
msgstr "진행 스타일"

msgid "comp7Ranked2Status"
msgstr "우수 플레이어"

msgid "comp7Ranked3"
msgstr "레전드 랭크는 최고의 실력을 갖춘 플레이어를 위한 랭크입니다. 레전드 랭크를 달성하려면 레이팅 점수 순위표에서 상위 10%에 들어야 합니다."

msgid "comp7Ranked36"
msgstr "전투가 끝나기 전에 전장에서 이탈하면 전투에서 참패하였을 때보다 많은 레이팅 점수를 잃게 됩니다."

msgid "comp7Ranked36Status"
msgstr "전장 이탈"

msgid "comp7Ranked3Status"
msgstr "레전드"

msgid "comp7Ranked4"
msgstr "해당 모드를 계속 플레이하지 않으면 레이팅 점수가 소실됩니다. 해당 규칙은 실버, 골드, 챔피언, 레전드 랭크에 적용됩니다."

msgid "comp7Ranked4Status"
msgstr "랭크 휴면"

msgid "comp7Ranked7"
msgstr "격전 모드 세부 정보는 이벤트 화면에서 \"이벤트 정보\" 버튼을 클릭하여 확인할 수 있습니다."

msgid "comp7Ranked7Status"
msgstr "모드 세부 정보"

msgid "comp7Ranked9"
msgstr "다양한 역할의 10단계 전차를 보유하고 있다면 매 전투에 가장 적합한 전차를 선택하여 아군 전차와의 조화를 도모할 수 있습니다."

msgid "comp7Ranked9Status"
msgstr "차고 확장"

msgid "devMaps0"
msgstr "돌발 상황 발생 지역은 지도에 연기로 표시되며\n미니맵에서 표식도 확인할 수 있습니다.\n돌발 상황 발생 지도는 게임 설정 화면 일반 메뉴에서 비활성화할 수 있습니다."

msgid "devMaps0Status"
msgstr "돌발 상황 발생 지도"

msgid "devMaps1"
msgstr "항공기 추락 등 돌발 상황 발생 지역 내에 있으면 전차가 파괴될 수도 있습니다.\n돌발 상황 발생 지도는 게임 설정 화면 일반 메뉴에서 비활성화할 수 있습니다."

msgid "devMaps1Status"
msgstr "돌발 상황 발생 지도"

msgid "dualGunVehicles"
msgstr "이중포신 주포 탑재 전차"

msgid "epicModeHiddenFeatures"
msgstr "전선 대격돌 숙련"

msgid "epicModeIntroduction"
msgstr "모드 특징"

msgid "epicModeUseful"
msgstr "전선 대격돌 정보"

msgid "epicRandom0"
msgstr "해당 전투 유형에서는 게임 성능이 저하될 수도 있습니다."

msgid "epicTip1"
msgstr "기지가 점령되면 해당 지역 내에 있는 모든 방어팀 전차가 폭격 대상으로 지정됩니다."

msgid "epicTip10"
msgstr "계급을 올리면 명예와 영광 외에도 전투 후 유용한 보너스를 획득할 수 있습니다."

msgid "epicTip11"
msgstr "전선 대격돌 모드에서는 다양하고 새로운 방법으로 경험치와 크레딧을 획득할 수 있습니다."

msgid "epicTip12"
msgstr "전선 대격돌 모드에서 상대 팀을 뒤로 밀어내면 전차 재생성 지점이 목표 지점과 더욱 가까워집니다."

msgid "epicTip13"
msgstr "기지 안에 있는 전차가 피해를 입으면 해당 전차의 점령 진행 상황이 일정 시간 중지됩니다."

msgid "epicTip14"
msgstr "특별 화면에서 전시 물자를 활성화하고 레벨을 올리십시오. 전시 물자를 사용하면 전투를 더욱 유리하게 진행할 수 있습니다."

msgid "epicTip15"
msgstr "전략적인 상황에 따라 언제든지 전차 재생성 화면에서 참여할 전선을 변경할 수 있습니다."

msgid "epicTip16"
msgstr "방어 지역으로 들어가면 적군 포대가 공격을 시작합니다. 주의하십시오."

msgid "epicTip17"
msgstr "전차가 지형에 끼었다면 전차 포기 기능 (기본값 J)를 눌러 다른 전차로 전투를 계속 진행할 수 있습니다."

msgid "epicTip18"
msgstr "전체 지도 (기본값 M)를 통해 전체적인 전투 진행 상황을 파악할 수 있습니다."

msgid "epicTip19"
msgstr "미니맵에 표시되는 아군과만 통신할 수 있습니다."

msgid "epicTip2"
msgstr "전선 대격돌 모드를 플레이하면 다양한 보상을 획득할 수 있습니다."

msgid "epicTip20"
msgstr "미니맵에 마우스를 올린 채 마우스 휠을 사용하면 미니맵 표시 지역을 변경할 수 있습니다."

msgid "epicTip21"
msgstr "미니맵에서 기지 또는 군사 시설을 클릭하여 아군이 주목하도록 할 수 있습니다."

msgid "epicTip22"
msgstr "운용할 전차가 없을 때는 자유 카메라 시점을 이용해 보십시오. 자유 카메라 시점을 통해 전장에 복귀하기 전 더욱 치밀하게 전략을 구상할 수 있습니다."

msgid "epicTip23"
msgstr "전투 시간이 끝나갈 때도 기지를 점령 중이라면 전투 시간이 연장됩니다. 기지 안에 있는 전차가 없을 때까지 전투가 계속 진행됩니다."

msgid "epicTip3"
msgstr "전선 대격돌 지도 크기는 일반 지도의 9배인 9km²입니다."

msgid "epicTip4"
msgstr "기지를 점령할 때마다 전투 시간이 증가합니다. 마지막 기지 점령 시에는 전투 시간이 추가로 증가합니다."

msgid "epicTip5"
msgstr "전투 중 파괴된 전차를 수리하려면 시간이 필요합니다. 다른 전차를 선택하여 전투를 계속 진행하십시오."

msgid "epicTip6"
msgstr "5분마다 예비 전차가 한 대씩 추가됩니다."

msgid "epicTip7"
msgstr "공격팀은 첫 번째 전선 기지 점령 후에만 두 번째 전선 기지에 접근할 수 있습니다."

msgid "epicTip8"
msgstr "첫 번째 전선의 모든 기지를 점령하면 두 번째 전선의 모든 기지가 약화됩니다."

msgid "epicTip9"
msgstr "상대 팀 전차를 모두 격파하여 승리할 수도 있지만, 확률은 매우 낮습니다."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "운영 정책"

msgid "howToPlay"
msgstr "플레이 방법"

msgid "mapbox0"
msgstr "기상 상황이 발생한 구역 내 전차와 바깥쪽 전차는 서로를 관측할 수 없습니다. 또한, 구역 밖에 있는 적 전차 위치에 대한 정보도 전달이 불가능합니다. 화재가 발생한 지역에 있는 전차는 피해를 입습니다."

msgid "mapbox0Status"
msgstr "기상 상황"

msgid "payAttention"
msgstr "기본 정보"

msgid "ranked1"
msgstr "운용 전차 역할을 소화하면 더 많은 경험치를 획득할 수 있습니다! 전차 역할 관련 설명은 랭크 모드 정보 페이지에서 확인할 수 있습니다."

msgid "ranked10"
msgstr "랭크 전투 진행 상황에 따라 전쟁 채권으로 특별 전차 및 전차 꾸미기 요소(할인 상품 포함)를 구매할 수 있습니다. 구매 가능한 아이템 목록을 확인하려면 배너를 클릭하십시오.\n비시즌 기간에는 아이템 또는 할인 이용이 불가능합니다."

msgid "ranked11"
msgstr "일일 보너스 전투는 리그에서만 이용할 수 있습니다. 예선 결과 및 특별 임무 완료에 따라 획득할 수 있으며 획득한 당일에만 사용 가능합니다."

msgid "ranked12"
msgstr "연말이 되면 가장 뛰어난 플레이어는 순위표에 진출할 수 있습니다. 해당 플레이어에게는 특별 증표가 지급되며 명예와 영광이 따라옵니다."

msgid "ranked13"
msgstr "특정 랭크는 한번 달성하면 강등되지 않습니다. 강등 불가 랭크에는 강등 불가를 알리는 아이콘이 표시됩니다. 각 편성의 시작 랭크도 강등 불가 랭크로 지정됩니다."

msgid "ranked2"
msgstr "각 편성 및 리그 진출 시 일반 보너스 전투와 일일 보너스 전투가 지급됩니다. 보너스 전투에서는 자동으로 계급장을 2배로 획득하며 계급장을 획득하지 못한 전투에서는 보너스 전투가 적용되지 않습니다. 보너스 전투는 10단계 전차별로 하루에 한 번만 사용할 수 있습니다."

msgid "ranked3"
msgstr "작전 개시 시간을 자주 확인하십시오. 작전 개시 시간이 종료되면 다음 날까지 랭크 전투를 이용할 수 없으며 이에 해당하는 알림을 받게 됩니다."

msgid "ranked4"
msgstr "일부 랭크에는 랭크 방어 점수가 있습니다. 랭크 방어 점수가 있는 랭크에서 전투 패배 시 랭크 방어 점수가 감소합니다. 랭크 방어 점수가 남아 있는 상태에서 계급장을 획득하면 랭크 방어 점수가 모두 회복됩니다."

msgid "ranked5"
msgstr "포기하지 마십시오! 승리 팀 상위 7명뿐만 아니라 패배 팀에서 뛰어난 성적을 기록한 플레이어도 계급장을 획득할 수 있습니다. 보너스 전투에서는 계급장을 두 배로 획득할 수 있다는 것도 잊지 마십시오."

msgid "ranked6"
msgstr "모든 편성을 통과하면 골드, 실버, 브론즈 3개 리그 중 하나로 진출합니다. 리그에서 진행한 전투 결과도 성적과 순위에 반영됩니다."

msgid "ranked7"
msgstr "편성을 통과할 때마다 랭크 토큰이 지급됩니다. 3개 시즌에서 가장 뛰어난 성적을 거둔 플레이어는 최종 보상을 획득할 수 있습니다."

msgid "ranked8"
msgstr "시즌 종료 시 가장 뛰어난 성적을 기록한 플레이어는 특별 증표와 스타일을 획득할 수 있습니다. 특별 증표와 스타일은 해당 플레이어의 긍지와 뛰어난 실력을 상징합니다."

msgid "ranked9"
msgstr "랭크 전투 성적에 따라 전쟁 채권을 획득할 수 있습니다. 전쟁 채권은 지휘명령과 강화 장비를 구매할 수 있는 통화입니다. 또한, 크레딧, 소모품 등 다양한 보상도 획득할 수 있습니다."

msgid "rankedStatus1"
msgstr "전차 역할 소화 획득 경험치"

msgid "rankedStatus10"
msgstr "랭크 전투 아이템"

msgid "rankedStatus11"
msgstr "일일 보너스 전투"

msgid "rankedStatus12"
msgstr "올해 최고의 플레이어"

msgid "rankedStatus13"
msgstr "모드 규정"

msgid "rankedStatus2"
msgstr "보너스 전투"

msgid "rankedStatus3"
msgstr "작전 개시 시간"

msgid "rankedStatus4"
msgstr "모드 규정"

msgid "rankedStatus5"
msgstr "모드 규정"

msgid "rankedStatus6"
msgstr "리그 전투"

msgid "rankedStatus7"
msgstr "연간 보상"

msgid "rankedStatus8"
msgstr "시즌 보상 종료"

msgid "rankedStatus9"
msgstr "랭크 보상"

msgid "security"
msgstr "보안 강화"

msgid "technicalAdvice"
msgstr "기술 조언"

msgid "tip0"
msgstr "무른 지형을 지날 때는 전차의 선회 속도와 기동성이 현저히 떨어집니다."

msgid "tip100"
msgstr "승무원 숙련도는 전차의 관련 성능에 영향을 미칩니다."

msgid "tip101"
msgstr "전차장은 육감 특성을 통해 전차가 적에게 발견되었는지 파악할 수 있습니다."

msgid "tip102"
msgstr "능력 숙련도는 승무원이 훈련한 모든 능력의 효율성을 결정하는 매개변수입니다."

msgid "tip103"
msgstr "승무원은 재훈련 시 직책을 변경할 수 있습니다."

msgid "tip106"
msgstr "장비를 장착하면 승무원 숙련도와 전차 성능이 향상됩니다."

msgid "tip107"
msgstr "해당 전차 부품과 다음 단계 전차를 모두 연구하면 정예 전차가 됩니다."

msgid "tip108"
msgstr "프리미엄 전차와 정예 전차로 획득한 일반 경험치는 즉시 자유 경험치로 전환할 수 있습니다."

msgid "tip11"
msgstr "구축전차를 운용할 때 수풀 뒤에 숨으면 쉽게 발견되지 않습니다. 정지한 상태에서는 더욱 발견하기 어렵다는 점도 명심하십시오."

msgid "tip111"
msgstr "가끔은 적 전차를 모두 격파하려고 하기보다는 적군 기지를 점령하는 것이 더 유리할 때도 있습니다."

msgid "tip114"
msgstr "계정 공유는 운영 정책에 어긋나며 계정 접속에 제한을 받을 수 있습니다."

msgid "tip115"
msgstr "계정 공유는 운영 정책에 어긋나며 위반 시 두 계정 모두 영구 정지될 수 있습니다."

msgid "tip116"
msgstr "개인 정보 보호를 위해 복잡한 비밀번호를 사용하십시오."

msgid "tip117"
msgstr "주기적으로 비밀번호를 변경하십시오."

msgid "tip118"
msgstr "계정 판매나 구매는 운영 정책 위반입니다. 운영 정책 위반 시 계정을 잃을 수도 있습니다."

msgid "tip119"
msgstr "확인되지 않은 링크는 누르지 마십시오. 사기 및 해킹을 당할 수 있습니다."

msgid "tip120"
msgstr "게임 골드는 월드 오브 탱크 공식 웹사이트에서만 구매할 수 있습니다. 외부 사이트에서 골드 구매 시 여러 가지 문제가 발생할 수 있습니다."

msgid "tip121"
msgstr "비밀번호 저장 기능은 편리하지만, 보안에 취약할 수 있습니다."

msgid "tip122"
msgstr "월드 오브 탱크 포털에서 계정 보안 유지 방법에 관해서 알아볼 수 있습니다."

msgid "tip123"
msgstr "전투 중에 CTRL 단추를 누르고 있으면 마우스 커서가 나타나며 다른 인터페이스를 클릭할 수 있습니다."

msgid "tip124"
msgstr "부품을 수리하려면 수리 도구를 사용하십시오. 승무원을 치료하려면 구급 상자를 사용하십시오."

msgid "tip125"
msgstr "단축키 1~6번을 사용하여 소모품을 사용하거나 포탄 유형을 변경할 수 있습니다."

msgid "tip126"
msgstr "자주포 모드에서 시야를 즉시 이동하려면 CTRL 단추를 누른 상태에서 미니맵의 해당 지점을 우클릭하십시오."

msgid "tip127"
msgstr "CTRL+TAB 키를 누르면 팀 목록 표시 방법이 변경됩니다."

msgid "tip128"
msgstr "팀 목록에서 플레이어 이름을 우클릭하면 관련 메뉴가 표시됩니다."

msgid "tip129"
msgstr "플레이어를 신고하려면 팀 목록에서 해당 플레이어 이름을 우클릭한 후 신고를 선택하십시오."

msgid "tip130"
msgstr "명령 메뉴에서 사용할 수 있는 명령 종류는 지형 특징, 아군, 적군, 사물 등 조준하고 있는 대상에 따라 달라집니다."

msgid "tip131"
msgstr "명령 메뉴에 있는 명령을 선택하려면 T 또는 Z 키를 누른 상태로 마우스 커서를 이동하여 사용할 명령을 선택하십시오."

msgid "tip132"
msgstr "단축키 F2~F8을 사용하여 명령 메뉴에 있는 명령을 더 빠르게 사용할 수 있습니다."

msgid "tip134"
msgstr "운영 정책에 어긋나지 않더라도 무례한 행동은 정당화될 수 없습니다."

msgid "tip135"
msgstr "아군은 언제나 긍정적인 플레이어를 선호합니다."

msgid "tip136"
msgstr "전투는 대화창이 아니라 전장에서만!"

msgid "tip137"
msgstr "대화창에 전투에 방해되는 불필요한 메시지를 입력하지 마십시오."

msgid "tip138"
msgstr "운영 정책을 위반한 플레이어가 있다면 \"신고\" 기능을 이용하십시오."

msgid "tip139"
msgstr "플레이어를 차단 목록에 추가하면 해당 플레이어의 메시지와 초대가 즉시 차단됩니다."

msgid "tip14"
msgstr "자동 조준은 100% 명중률을 보장하지는 않습니다. 숙련된 플레이어는 수동 조준을 선호합니다."

msgid "tip140"
msgstr "설정 메뉴에서 비속어 감추기 기능을 설정할 수 있습니다."

msgid "tip141"
msgstr "설정 메뉴에서 전투 중 대화 기능을 비활성화한 후에도 소대 대화는 계속 이용할 수 있습니다."

msgid "tip142"
msgstr "아군과 다툼을 벌이는 중에도 적군은 계속 움직입니다."

msgid "tip143"
msgstr "미니맵을 주시하십시오. 한순간의 실수가 패배로 직결될 수도 있습니다."

msgid "tip144"
msgstr "금지 모드나 불법 프로그램을 사용하면 계정이 영구 차단됩니다."

msgid "tip146"
msgstr "운영 정책 위반 시 계정이 정지될 수도 있습니다."

msgid "tip147"
msgstr "운영 정책 위반으로 징계를 받았다면 운영 정책을 다시 한 번 숙지한 후 다시는 제재를 받지 않도록 하십시오."

msgid "tip148"
msgstr "운영 정책은 모든 플레이어에게 적용되며 반드시 준수해야 합니다."

msgid "tip149"
msgstr "전투를 시작할 수 없다면 모드 사용을 중지하고 게임 클라이언트를 재시작해 보십시오."

msgid "tip150"
msgstr "FPS가 낮다면 게임 내 설정 메뉴에서 그래픽 설정을 낮추십시오."

msgid "tip151"
msgstr "FPS가 낮고 게임 화면에 문제가 있다면 비디오 카드 드라이버를 업데이트해 보십시오."

msgid "tip152"
msgstr "무선 인터넷 사용 시 게임 지연 현상이 있다면 인터넷을 유선으로 연결한 후 다시 게임을 실행해 보십시오."

msgid "tip153"
msgstr "전차가 순간적으로 이동하거나 사격 시 지연 현상이 있다면 네트워크 연결 상태를 확인하십시오."

msgid "tip154"
msgstr "믿을 수 있는 백신 프로그램을 사용하십시오. 컴퓨터와 게임 클라이언트를 보호할 수 있습니다."

msgid "tip155"
msgstr "소속팀의 음성이 들을 수 없다면 음성 대화 설정을 확인해 보십시오."

msgid "tip156"
msgstr "고객 지원에 문의 시 도움이 필요한 내용을 자세히 작성하면 해당 문제를 더 빠르게 해결할 수 있습니다."

msgid "tip157"
msgstr "게임 모드를 사용 중이라면 고객 지원에 문의하기 전에 모드 사용을 중지한 후 해당 문제를 다시 한 번 확인해 보십시오."

msgid "tip158"
msgstr "계정에 휴대전화 번호를 추가하면 보안 설정을 강화할 수 있습니다."

msgid "tip159"
msgstr "휴대전화 번호가 계정에 정상적으로 추가되었는지 확인하십시오."

msgid "tip160"
msgstr "관리자는 계정에 추가된 이메일을 변경할 수 없습니다. 이메일을 안전하게 관리하십시오."

msgid "tip161"
msgstr "계정이 노출된 것으로 의심된다면 고객 지원에 문의하십시오."

msgid "tip162"
msgstr "선물을 보낸 플레이어가 불확실하다면 선물을 수락하지 마십시오."

msgid "tip163"
msgstr "고객 지원 문의 시 도움이 필요한 상담 유형을 선택하면 더 빠르게 문제를 해결할 수 있습니다."

msgid "tip164"
msgstr "숙련된 자주포 플레이어는 적 자주포의 포탄 궤적을 확인한 후 적 자주포의 위치를 예상할 수 있습니다."

msgid "tip165"
msgstr "자동 소화기는 화재를 즉시 진압하며 장착된 전차의 엔진 화재 발생 확률이 감소합니다."

msgid "tip166"
msgstr "자주포를 운용할 때는 사격 경로, 포탄 속도, 지형을 고려해야 합니다."

msgid "tip167"
msgstr "항상 미니맵을 주시하고 아군과 적군의 위치를 파악하십시오."

msgid "tip168"
msgstr "은폐한 상태라도 사격 후에는 위치가 노출됩니다. 적 전차를 발견하면 추가 경험치와 크레딧을 획득할 수 있습니다."

msgid "tip169"
msgstr "현가장치가 파괴되면 수리 도구를 사용하여 전차를 수리하고 적 전차의 공격을 피하십시오."

msgid "tip17"
msgstr "철갑탄으로 관통할 수 없는 전차는 고폭탄으로 피해를 줄 수 있습니다."

msgid "tip170"
msgstr "덤불이나 쓰러진 나무는 전차를 은폐하기에 최적의 장소입니다."

msgid "tip171"
msgstr "지형 돌파 능력이 높다고 해서 모든 지형을 이동할 수 있는 것은 아닙니다."

msgid "tip173"
msgstr "전차의 국가와 유형이 같다면 프리미엄 전차에 재훈련 없이 승무원을 이동할 수 있습니다."

msgid "tip174"
msgstr "승무원이 부상당하면 전투 효율이 저하됩니다."

msgid "tip176"
msgstr "선물을 받으려면 포털에 로그인한 후 계정 관리 페이지를 확인하십시오."

msgid "tip177"
msgstr "어떤 상황에서도 아군 사격은 허용되지 않습니다."

msgid "tip178"
msgstr "불명확한 이유로 계정이 정지되었다면 고객 지원에 문의하십시오."

msgid "tip179"
msgstr "보유 중인 전차가 사라졌다면 고객 지원에 문의하기 전에 게임 내 차고 필터 설정을 다시 한 번 확인해 보십시오."

msgid "tip180"
msgstr "전체 음량 또는 게임을 플레이하는 기기에 따라 음량 설정을 변경하여 게임 사운드를 최적화할 수 있습니다."

msgid "tip181"
msgstr "본인의 환경에 맞게 \"2.0/2.1\"와 \"헤드폰\" 중 적합한 효과음 설정을 선택하십시오."

msgid "tip182"
msgstr "저사양 사운드 시스템에서 게임을 최적화하려면 \"노트북\" 설정을 사용하십시오."

msgid "tip183"
msgstr "고음역 출력을 낮추려면 야간 모드를 사용하십시오."

msgid "tip184"
msgstr "저음역 강화 옵션은 선택한 사운드 시스템에 따라 개별 적용됩니다."

msgid "tip185"
msgstr "차륜 전차는 기동성이 매우 뛰어나 전략적 주요 지점을 누구보다 빠르게 선점하고 적의 공격으로부터 안전한 곳을 확보할 수 있습니다."

msgid "tip186"
msgstr "이중포신 주포를 탑재한 전차는 각 주포를 동시에 또는 개별적으로 발사할 수 있습니다. 사격 버튼은 설정에서 변경할 수 있습니다."

msgid "tip191"
msgstr "장비는 전차 단계에 따라 여러 급수로 나누어집니다."

msgid "tip192"
msgstr "특정 범주의 일반 장비를 6단계 이상 전차의 해당 범주 슬롯에 장착하면 더욱 효과적입니다. 슬롯과 장비의 범주가 다르다면 기본 성능으로 적용됩니다."

msgid "tip193"
msgstr "최고 속력은 전차 구성에 영향을 받지 않습니다. 특정 장비를 장착하거나, 개량을 적용하거나, 관련 승무원 능력을 훈련하여 해당 성능을 높일 수 있습니다."

msgid "tip194"
msgstr "야전 개량을 통해 전차를 자신의 플레이 스타일에 맞게 조정할 수 있습니다."

msgid "tip195"
msgstr "야전 개량을 통해 전차의 대체 구성을 해제할 수 있습니다. 적절한 구성을 선택하면 전투를 유리하게 진행할 수 있을 것입니다."

msgid "tip196"
msgstr "Ctrl+1 및 Ctrl+2 키를 사용하여 핵심 보급품과 보조 보급품 간 전환이 가능합니다."

msgid "tip197"
msgstr "야전 개량이 특정 레벨에 도달하면 두 번째 장비 슬롯 범주를 지정할 수 있습니다."

msgid "tip198"
msgstr "야전 개량은 정예 상태를 달성한 6~10단계 전차로 이용할 수 있습니다. 특별, 보상, 프리미엄 전차는 구매 후 즉시 이용 가능합니다."

msgid "tip199"
msgstr "개량 계통도는 전차 유형 및 역할에 따라 달라집니다."

msgid "tip200"
msgstr "기본 궤도가 파괴되더라도 부분적으로 기동력을 유지할 수 있습니다."

msgid "tip200Status"
msgstr "비상 궤도"

msgid "tip201"
msgstr "기본 궤도가 파괴되더라도 부분적으로 기동력을 유지할 수 있습니다."

msgid "tip202"
msgstr "제트 추진기를 사용하면 전차 기동력이 향상되어 빠르게 유리한 위치를 차지하거나 위험 지역을 벗어날 수 있습니다."

msgid "tip202Status"
msgstr "제트 추진기 탑재 전차"

msgid "tip203"
msgstr "Tab 키 또는 B 키를 입력하여 개인 물자 활성화"

msgid "tip204"
msgstr "사격 후 주포가 충분히 냉각되면 분산도가 감소합니다. 주포 냉각 시 반경이 더 작은 두 번째 조준원이 표시되며 해당 범위를 기준으로 포탄이 발사됩니다. 다음 포탄 사격 시까지 해당 효과가 유지됩니다."

msgid "tip204Status"
msgstr "2단 조준"

msgid "tip205"
msgstr "엄청난 연사력을 자랑하는 자동 화기의 일종입니다. 사격 효율은 조준원 내 표시기를 통해 확인할 수 있습니다."

msgid "tip205Status"
msgstr "자동포"

msgid "tip206"
msgstr "승무원이 훈련할 수 있는 주요 직책 능력은 최대 6개입니다."

msgid "tip207"
msgstr "여러 직책을 담당하는 승무원은 추가 직책의 능력을 보너스로 훈련할 수 있습니다. 보너스 능력은 훈련 시 경험치를 필요로 하지 않으며 능력 수 제한에도 집계되지 않습니다."

msgid "tip208"
msgstr "직책이 같은 승무원이 여러 명이라면 능력의 효과는 평균치로 적용됩니다. 100% 훈련 완료 시 작동하는 능력은 직책이 같은 승무원이 모두 해당 능력을 훈련 완료해야 적용됩니다."

msgid "tip209"
msgstr "승무원이 능력 6개를 모두 훈련했더라도 경험치는 계속 획득할 수 있습니다. 해당 경험치는 범용 지침으로 전환되어 다른 승무원에게 사용할 수 있습니다."

msgid "tip210"
msgstr "해당 전차는 전황에 따라 사격 모드를 전환할 수 있는 주포 시스템을 탑재하고 있습니다."

msgid "tip210Status"
msgstr "선택식 사격 모드 전차"

msgid "tip211"
msgstr "제트 추진기를 사용하면 전차 기동력이 향상되어 빠르게 유리한 위치를 차지하거나 위험 지역을 벗어날 수 있습니다."

msgid "tip211Status"
msgstr "제트 추진기 탑재 전차"

msgid "tip212"
msgstr "사격 전 일부 포탄 성능을 변경할 수 있는 특별 장치입니다."

msgid "tip212Status"
msgstr "포탄 보정 시스템"

msgid "tip213"
msgstr "발견한 적 전차에 포탄이 명중하면 다음 포탄의 신관이 조정됩니다. 첫 포탄이 적 장갑을 관통하면 다음 포탄의 공격력이 증가하고, 관통하지 못하면 다음 포탄의 관통력이 증가합니다."

msgid "tip213Status"
msgstr "신관 조정 장치"

msgid "tip23"
msgstr "장갑이 약한 전차는 충돌로 파괴할 수도 있습니다."

msgid "tip25"
msgstr "적 전차의 부품을 파괴하고 승무원에 부상을 입힐 때에는 고폭탄이 더욱 효과적입니다."

msgid "tip28"
msgstr "고폭탄은 장갑이 약한 전차와 개방형 포탑이 장착된 전차에 효과적입니다."

msgid "tip29"
msgstr "적 전차의 움직임을 봉쇄하려면 전차의 궤도를 파괴하십시오."

msgid "tip30"
msgstr "덤불에 숨으면 위장률이 증가하며 차체가 작을수록 위장률이 높습니다."

msgid "tip31"
msgstr "선택한 포탄으로 적 전차에 피해를 기록할 수 없다면 다른 유형의 포탄을 사용해 보십시오."

msgid "tip32"
msgstr "승무원 숙련도 보너스를 통해 승무원 능력을 향상할 수 있으며 이는 전차의 기본 성능에도 영향을 미칩니다."

msgid "tip33"
msgstr "이동 중인 전차보다 정지한 전차를 발견하는 것이 더 어렵습니다."

msgid "tip36"
msgstr "근접전에서 자주포의 직사 공격은 생존율을 높일 수 있습니다."

msgid "tip37"
msgstr "지도 내 사물이나 장애물을 파괴하면 적 자주포가 위치를 예상할 수 있습니다."

msgid "tip39"
msgstr "집중 사격은 언제나 효과적입니다."

msgid "tip41"
msgstr "적 전차를 발견하려면 적 전차의 포탄 궤적을 주시하십시오."

msgid "tip42"
msgstr "기지 점령 중인 전차가 많을수록 더 빨리 점령할 수 있지만, 3대 이상은 차이가 없습니다."

msgid "tip43"
msgstr "강습전은 전투 시간이 종료되면 방어 팀이 승리합니다."

msgid "tip44"
msgstr "기지 점령 중인 전차가 피해를 받으면 해당 전차가 기록한 기지 점령 점수가 초기화됩니다."

msgid "tip45"
msgstr "조작성은 현가장치 유형, 엔진 출력, 장착된 부품 중량에 영향을 받습니다. 특정 장비를 장착하여 해당 성능을 높일 수 있습니다."

msgid "tip47"
msgstr "건물과 파괴된 전차 잔해는 훌륭한 엄폐물입니다. 나무나 수풀에 전차를 은폐할 수는 있지만, 날아오는 포탄을 막아주지는 않습니다."

msgid "tip48"
msgstr "손상된 부품을 수리하려면 수리 도구를 클릭하거나 단축키를 누르십시오."

msgid "tip49"
msgstr "주포가 파괴되면 사격할 수 없습니다. 수리 도구를 사용하여 주포를 수리하십시오."

msgid "tip50"
msgstr "탄약고에 손상을 입으면 장전이 느려지거나 유폭이 발생할 수도 있습니다."

msgid "tip56"
msgstr "프리미엄 계정을 사용하면 전투당 경험치와 크레딧을 50% 추가로 획득할 수 있습니다."

msgid "tip57"
msgstr "자유 경험치는 모든 전차, 부품, 개량 연구 시 사용할 수 있습니다."

msgid "tip58"
msgstr "부품, 전차, 개량 연구 시 자유 경험치보다 일반 경험치가 먼저 사용됩니다."

msgid "tip6"
msgstr "전차 종류가 다르다면 각기 다른 전략을 사용해야 합니다."

msgid "tip60"
msgstr "전투에서 획득하는 크레딧과 경험치는 적 전차 발견, 피해, 격파, 기지 점령, 기지 방어 등 다양한 요소에 의해 결정됩니다."

msgid "tip62"
msgstr "적 전차를 관통했을 때 내구도가 내려가지 않는다고 실망하지 마십시오. 승무원이나 부품에 치명적인 손상을 입힌 것입니다."

msgid "tip65"
msgstr "지형의 굴곡을 이용하면 적의 사격을 피할 수 있으며 쉽게 발견되지 않습니다."

msgid "tip66"
msgstr "승리하기 위해선 팀워크가 중요합니다."

msgid "tip67"
msgstr "차고에 전차를 보관할 슬롯이 부족하다면 추가 슬롯을 구매하거나 사용하지 않는 전차를 판매하십시오."

msgid "tip68"
msgstr "보관소에서 사용하지 않은 전차, 부품, 소모품, 장비, 포탄을 판매할 수 있습니다."

msgid "tip69"
msgstr "월드 오브 탱크 운영진은 게임 안에서 사용자의 비밀번호를 요구하지 않습니다. 절대로 타인에게 알려 주지 마십시오."

msgid "tip70"
msgstr "프리미엄 전차는 수리 비용이 매우 저렴합니다. 또한, 크레딧 및 경험치를 추가로 획득할 수 있습니다."

msgid "tip71"
msgstr "아군을 공격하거나 격파하면 계정이 정지될 수 있습니다."

msgid "tip75"
msgstr "포탑과 차체 회전은 사격 정확도에 영향을 줍니다. 기동이 끝난 뒤 조준원이 목표에 고정될 때까지 기다리십시오."

msgid "tip77"
msgstr "가속력은 엔진 출력, 전차 중량, 지형 유형에 영향을 받습니다. 특정 장비를 장착하거나 특정 소모품, 개량, 승무원 능력을 사용하여 해당 성능을 높일 수 있습니다."

msgid "tip78"
msgstr "현가장치 부품마다 회전 속도와 험지 주파력이 다릅니다."

msgid "tip79"
msgstr "충돌 피해량은 적 전차에 대한 중량 우위, 속력, 장갑 두께에 의해 결정됩니다."

msgid "tip81"
msgstr "포수의 능력과 장착된 장비 및 소모품에 따라 적 전차를 더 빠르게 조준할 수 있습니다."

msgid "tip83"
msgstr "자동 조준은 목표물이 파괴되거나 시야에서 사라지면 자동으로 해제됩니다."

msgid "tip84"
msgstr "파괴된 전차는 해당 전투가 종료될 까지 사용할 수 없습니다."

msgid "tip85"
msgstr "승무원이 모두 탑승한 상태에서 수리를 마친 전차만 전투에 참여할 수 있습니다."

msgid "tip86"
msgstr "자동 수리와 자동 재보급을 사용하면 전투 종료 후 손상된 전차가 자동으로 수리되며 포탄이 재보급됩니다."

msgid "tip87"
msgstr "경사 장갑은 도탄 및 비관통 확률이 높습니다."

msgid "tip88"
msgstr "특화 전차가 아닌 다른 전차에 탑승한 승무원은 해당 전차로 전투 참여 시 능력을 사용할 수 없습니다."

msgid "tip89"
msgstr "막사나 다른 전차로 승무원을 보낼 수 있습니다."

msgid "tip9"
msgstr "자주포 운용 시 위치가 노출되거나 위험이 감지된다면 위치를 변경하십시오."

msgid "tip91"
msgstr "승무원이 모두 탑승하지 않은 상태에서는 해당 전차로 전투를 시작할 수 없습니다."

msgid "tip92"
msgstr "승무원의 훈련 속도는 전투 결과에 따라 다릅니다."

msgid "tip93"
msgstr "전차장은 다른 모든 승무원의 숙련도에 보너스를 제공합니다. 승무원 숙련도는 특정 능력, 장비, 소모품을 통해 향상할 수도 있습니다."

msgid "tip95"
msgstr "승무원 급속 훈련을 사용하면 전투에서 획득한 모든 경험치를 승무원 훈련에 사용합니다. 가장 적은 경험치를 보유한 승무원이 두 배로 훈련됩니다."

msgid "tip98"
msgstr "장착할 수 있는 장비는 전차 단계, 유형, 설계 특성에 따라 달라집니다."

msgid "tip99"
msgstr "모든 장비는 해체하여 다른 전차에 장착할 수 있습니다. 일부 장비는 해제 시 비용을 지급해야 합니다."

msgid "usefulFeatures"
msgstr "유용한 기능"

msgid "wheeledVehicles"
msgstr "게임 내에서 가장 뛰어난 기동성을 갖춘 차륜 전차"

msgid "winback1"
msgstr "모드 선택 메뉴 무작위 전투 설정에서 준비 운동을 종료할 수 있습니다."

msgid "winback1Status"
msgstr "기본 정보"
