msgid "VK3002DB_SH_descr"
msgstr "德國人無論在冶金工程與高品質組裝方面都是一等一的老手。此車輛堪稱完美無瑕的孤狼：可獨立作戰、功能多元且可輕易適應任何戰況進而在戰場存活。"

msgid "VK3002DB_SH_short"
msgstr "Walküre"

msgid "VK3002DB_Standardtketten_SH"
