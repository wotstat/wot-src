msgid "extraParams/desc"
msgstr "不會直接影響擊毀敵方車輛效率的一項參數。"

msgid "extraParams/header"
msgstr "%(paramName)s加成"

msgid "extraParams/multiDesc"
msgstr "總加成同時計入加法性與乘法性變項，因此最終數值可能比此處顯示的數值高或低。"

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "此參數顯示從自走炮射擊到收到警告之間的時間。"

msgid "extraParams/name/commanderLampDelay"
msgstr "此參數顯示車長確定車輛是否已被敵人發現前的延遲時間。數值越低，延遲就越短。"

msgid "extraParams/name/crewHitChance"
msgstr "此參數顯示可避免乘員受傷的機率。"

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "此參數顯示已遭震盪車輛的額外震盪持續時間。"

msgid "extraParams/name/crewStunDuration"
msgstr "此參數顯示受到震盪的持續時間。"

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "此參數顯示與基本數值（-25%）相比的最低潛在傷害與潛在穿透力數值。"

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "此參數顯示與基本數值（+25%）相比的最高潛在傷害與潛在穿透力數值。"

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "此參數顯示藉由衝撞造成的傷害量。當車輛彼此碰撞時，系統將碰撞點的裝甲厚度、車重差異與速度納入考量。"

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "此參數顯示準星內敵方車輛遭受之嚴重傷害被車長偵測到前的延遲時間。"

msgid "extraParams/name/demaskFoliageFactor"
msgstr "此參數顯示敵方車輛完全在（單一或一群）樹葉後隱藏時的隱蔽性。適用於靜止與移動中車輛。"

msgid "extraParams/name/demaskMovingFactor"
msgstr "此參數顯示移動中敵方車輛的可偵察程度。數值越高，偵察到的機率越高。"

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "此參數顯示對敵方乘員與配件造成嚴重傷害的機率。適用於所有類型的砲彈，裝備自動火炮之車輛的砲彈除外。"

msgid "extraParams/name/equipmentPreparationTime"
msgstr "此參數顯示消耗品的冷卻時間。"

msgid "extraParams/name/fireExtinguishingRate"
msgstr "此參數決定火災持續時間與造成之傷害量的下降程度。"

msgid "extraParams/name/foliageMaskingFactor"
msgstr "此參數顯示在樹葉後的隱蔽性效果。"

msgid "extraParams/name/hpRecover"
msgstr "此參數顯示使用工具包時恢復血量的增加量。數值越高，恢復的血量就越多。"

msgid "extraParams/name/mediumGroundFactor"
msgstr "此參數顯示在一般軟地上行駛時懸吊的越野能力。數值越高，達到直線速度的時間就越短。"

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "此參數顯示觀測裝置遭毀時，最遠可見距離縮短的削減幅度。數值越低，可視範圍就越大。"

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "此參數顯示在距離小於 50 公尺時，砲彈最高潛在穿透力數值的增加量。數值越高，穿透力就越高。"

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "此參數顯示您在車輛遭摧毀後持續傳輸敵人位置的額外時間。"

msgid "extraParams/name/radiomanHitChance"
msgstr "此參數顯示可避免通訊員受傷的機率。"

msgid "extraParams/name/shellVelocity"
msgstr "此參數顯示所有類型砲彈的速度增加幅度。數值越高，砲彈速度就越快。"

msgid "extraParams/name/softGroundFactor"
msgstr "此參數顯示在軟地上行駛時懸吊的越野能力。數值越高，達到直線速度的時間就越短。"

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "此參數顯示乘員受震盪之負面影響的程度。"

msgid "extraParams/name/suspensionDamageReduction"
msgstr "此參數顯示懸吊受到傷害的降低量。數值越高，受到的傷害就越低。"

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "此參數顯示彈藥架受損時，炮管裝填時間延長的削減幅度。數值越高，裝填時間就越短。"

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "此參數顯示受損引擎之功率損失的降低幅度。數值越高，引擎功率的損失就越低。"

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "此參數顯示彈藥架、油箱與引擎的耐久性。數值越高，配件的耐久性就越高。"

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "此參數顯示彈藥架的耐久性。數值越高，彈藥架的耐久性就越高。"

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "此參數顯示碰撞時懸吊受損所造成的傷害。不會影響碰撞時對炮塔側面或頂部所造成的傷害。"

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "此參數顯示懸吊修理速度。數值越高，修理速度就越快。"

msgid "extraParams/name/vehicleChassisStrength"
msgstr "此參數顯示懸吊的耐久性。數值越高，懸吊對砲彈與碰撞/衝撞的耐久性就越高。"

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "此參數顯示敵人離開您的可視範圍後的持續可見時間。預設數值為 10 秒。"

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "此參數顯示車輛遭碰撞傷害的降低幅度。數值越高，受到的傷害就越低。"

msgid "extraParams/name/vehicleFireChance"
msgstr "此參數顯示引擎受損時起火的機率。"

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "此參數顯示油箱抵抗嚴重傷害的耐久性。一旦油箱遭摧毀，一定會引發火災。"

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "此參數顯示移動、車身與炮塔迴轉時，炮管準確度的降低。數值越低，瞄準圈的擴散度就越小。"

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "此參數顯示開火後的瞄準圈大小。"

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "此參數顯示移動時的炮管擴散度。數值越低，炮管越準。"

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "此參數顯示車身迴轉時的炮管擴散度。數值越低，炮管越準。"

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "此參數顯示炮管迴轉時的擴散度。數值越低，炮管越準。"

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "此參數顯示受損炮管的擴散度。數值越高，擴散度越低。"

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "此參數顯示裝甲吸收 HE 彈的傷害量。命中處裝甲越多，效果就越好。"

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "此參數顯示開火後的隱蔽性。"

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "此參數顯示在您離開敵方可視範圍後，您的車輛可持續被見到的時間。預設數值為 10 秒。"

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "此參數顯示懸吊因遭衝撞受到的傷害量。當車輛彼此碰撞時，系統將碰撞點的裝甲厚度、車重差異與速度納入考量。"

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "此參數顯示因遭衝撞受到的傷害量。當車輛彼此碰撞時，系統將碰撞點的裝甲厚度、車重差異與速度納入考量。"

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "此參數顯示已裝填炮管切換砲彈類型的速度。"

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "此參數顯示內部與外部配件從「紅色」狀態修理為「黃色」狀態的速度。數值越高，修理速度越快。"

msgid "extraParams/name/vehicleSpeedGain"
msgstr "此參數顯示懸吊的越野能力。數值越高，達到直線速度的時間就越短。"

