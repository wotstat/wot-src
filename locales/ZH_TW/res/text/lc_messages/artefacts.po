msgid "br_respawn/name"
msgstr "重生"

msgid "br_respawn/platoon/descr"
msgstr "讓您在車輛遭摧毀後重回戰鬥。此機制在戰鬥的首 %(duration)s 分鐘內可用。\n\n若要讓隊友重生，必須持續 %(timeToResurrect)s 秒不與敵人交戰。裝甲排隊友共用重生次數。"

msgid "br_respawn/solo/descr"
msgstr "讓您在車輛遭摧毀後重回戰鬥。此機制在戰鬥的首 %(duration)s 分鐘內可用。\n\n一旦遭摧毀，您的車輛會自動重生。"

msgid "br_smoke/battleDescr"
msgstr "為消耗品範圍內的所有車輛提供 %(duration)s 秒隱蔽性加成。"

msgid "br_smoke/descr"
msgstr "為消耗品範圍內的所有車輛提供隱蔽性加成。"

msgid "br_smoke/longDescr"
msgstr "為消耗品範圍內的所有車輛提供 %(duration)s 秒隱蔽性加成。"

