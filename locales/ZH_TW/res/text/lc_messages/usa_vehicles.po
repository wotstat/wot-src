msgid "T14_descr"
msgstr "於 1942 年 5 月到 1943 年 5 月間研發。經過測試後，原先批准進行大量生產，但最終還是被取消，T14 依舊還是一輛試驗車。製造過兩輛原型車。"

msgid "T14_descr_MapsTraining_Player_HT_1"
msgstr "於 1942 年 5 月到 1943 年 5 月間研發。經過測試後，原先批准進行大量生產，但最終還是被取消，T14 依舊還是一輛試驗車。製造過兩輛原型車。"

msgid "T16E2"
msgstr "T16E2"

msgid "T18"
