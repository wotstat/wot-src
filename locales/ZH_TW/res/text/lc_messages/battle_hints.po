msgid "hint/LSH_FIRE"
msgstr "煙霧會干擾對敵方車輛的偵察及這些車輛位置的通報。火災事件會對車輛造成傷害。"

msgid "hint/LSH_FOG"
msgstr "濃霧會干擾對敵方車輛的偵察及這些車輛位置的通報。"

msgid "hint/LSH_RAIN"
msgstr "豪雨會干擾對敵方車輛的偵察及這些車輛位置的通報。"

msgid "hint/LSH_SANDSTORM"
msgstr "沙塵暴會干擾對敵方車輛的偵察及這些車輛位置的通報。"

msgid "hint/LSH_SMOKE"
msgstr "煙霧會干擾對敵方車輛的偵察及這些車輛位置的通報。"

msgid "hint/PPH_AIMING_01"
msgstr "車輛與炮塔移動會降低<font color='#EE7000'>炮管準度</font>"

msgid "hint/PPH_AIMING_02"
msgstr "準星周圍的圓圈顯示<font color='#EE7000'>炮管準度</font>。多等一下來提高準度。"

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>自動瞄準</font>已開啟。點擊滑鼠右鍵取消。"

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "自動瞄準總會將您的炮管對準目標車輛<font color='#EE7000'>中央</font>"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "您的基地正被<font color='#EE7000'>佔領！</font>如果不驅趕敵人，敵方隊伍將贏得戰鬥。"

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "每輛敵方車輛均有<font color='#EE7000'>各自的</font>佔領進度"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>佔領</font>敵方基地為贏得戰鬥的方法之一"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "當您受到傷害，您的佔領進度<font color='#EE7000'>將重置</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "當您離開基地圈，您的佔領進度<font color='#EE7000'>將重置</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "圈內有多輛車輛，可<font color='#EE7000'>更快</font>佔領基地"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "<font color='#EE7000'>第三輛</font>車輛進入圈內後，再有車輛進入，不會加快基地佔領"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "即將佔領敵方基地！"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "您的隊伍更快佔領基地！"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "車輛配件嚴重受損！使用底部面板上的<font color='#EE7000'>大型工具箱</font>修理。"

msgid "hint/PPH_CONSUMABLES_02"
msgstr "車輛配件嚴重受損！使用底部面板上的<font color='#EE7000'>大型工具箱</font>修理。"

msgid "hint/PPH_CONSUMABLES_03"
msgstr "乘員重傷！使用底部面板上的<font color='#EE7000'>大型急救箱</font>治療。"

msgid "hint/PPH_CONSUMABLES_04"
msgstr "乘員重傷！使用底部面板上的<font color='#EE7000'>大型急救箱</font>治療。"

msgid "hint/PPH_CONSUMABLES_05"
msgstr "乘員受到震盪！使用底部面板上的<font color='#EE7000'>急救包</font>治療。"

msgid "hint/PPH_CONSUMABLES_06"
msgstr "車輛起火！使用底部面板上的<font color='#EE7000'>手動滅火器</font>滅火。"

msgid "hint/PPH_CONSUMABLES_07"
msgstr "車輛起火！<font color='#EE7000'>自動滅火系統</font>已啟用。"

msgid "hint/PPH_CONSUMABLES_08"
msgstr "車輛配件嚴重受損！在戰鬥前裝備<font color='#EE7000'>工具包</font>，可助您修理配件。"

msgid "hint/PPH_CONSUMABLES_09"
msgstr "乘員重傷！在戰鬥前裝備<font color='#EE7000'>急救包</font>，可助您治療乘員。"

msgid "hint/PPH_CONSUMABLES_10"
msgstr "車輛起火！在戰鬥前裝備<font color='#EE7000'>滅火器</font>，可助您撲滅火災。"

msgid "hint/PPH_OTHER_01"
msgstr "您已<font color='#EE7000'>被偵察到</font> — 開火可能暴露您的位置！"

msgid "hint/PPH_OTHER_02"
msgstr "您的車輛已遭摧毀。您可按下 <font color='#EE7000'>Esc 鍵</font>離開戰鬥且不會受到懲罰。"

msgid "hint/PPH_OTHER_03"
msgstr "您的車輛已遭摧毀。您可點擊滑鼠按鈕來<font color='#EE7000'>觀戰</font>隊友。"

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>燈泡圖示</font>出現，代表您已被敵人偵察到！"

msgid "hint/PPH_OTHER_05"
msgstr "您的炮管仍在<font color='#EE7000'>裝填</font>"

msgid "hint/PPH_OTHER_06"
msgstr "等到準星周圍的圓圈<font color='#EE7000'>完全變綠色</font>後，您的炮管才能射擊"

msgid "hint/PPH_SNIPER_01"
msgstr "您可滾動滑鼠滾輪進入<font color='#EE7000'>狙擊模式</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "您可滾動滑鼠滾輪離開<font color='#EE7000'>狙擊模式</font>"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>綠色的內準心</font>代表擊穿敵方裝甲的機率高"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "就算內準星為綠色，也<font color='#EE7000'>不保證</font>會擊穿裝甲"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "炮管並非 100% 準確，也就是說砲彈<font color='#EE7000'>並不會總是</font>命中準星中央"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "內準星代表擊穿敵方裝甲的機率。在<font color='#EE7000'>設定中開啟</font>。"

msgid "penetration/chance/high"
msgstr "高機率"

msgid "penetration/chance/low"
msgstr "低機率"

msgid "penetration/chance/medium"
msgstr "中等機率"
