msgid "CUSTOM_AA_MODE"
msgstr "反鋸齒"

msgid "CUSTOM_AA_MODE/description"
msgstr "決定遊戲物件細線及輪廓的額外處理程度。使混疊效應降到最低。\n\n• 高──FXAA\n• 最大──隨機超級採樣反鋸齒 (TSSAA)"

msgid "DRR_AUTOSCALER_ENABLED"
msgstr "動態調整"

msgid "DRR_AUTOSCALER_ENABLED/description"
msgstr "根據顯示卡負載開啟或關閉 3D 渲染解析度的自動調整。\n\n開啟這個參數值可以提高遊戲的效能。車庫中的渲染解析度總是保持不變。"

msgid "EFFECTS_QUALITY"
msgstr "最大特效品質"

msgid "EFFECTS_QUALITY/description"
msgstr "決定跳彈火花、爆炸、煙霧以及其它視覺效果的顯示品質。\n\n降低這個參數值可以提高遊戲的效能。"

msgid "FAR_PLANE"
msgstr "繪製距離"

msgid "FAR_PLANE/description"
msgstr "決定立體樣貌、建築物、敵方車輛以及其它遊戲物件的顯示距離。"

msgid "FLORA_QUALITY"
msgstr "雜草密度"

msgid "FLORA_QUALITY/description"
msgstr "決定一般和狙擊模式下顯示的雜草密度。"

msgid "HAVOK_ENABLED"
msgstr "增強破壞的物理性"

msgid "HAVOK_ENABLED/OFF"
msgstr "關"

msgid "HAVOK_ENABLED/ON"
msgstr "開"

msgid "HAVOK_ENABLED/description"
msgstr "開啟更細緻且逼真的方式來處理地圖上的物件破壞效果。\n\n關閉這個參數可以提高遊戲的效能。"

msgid "HAVOK_ENABLED/warning"
msgstr "如果當前戰鬥已關閉了該設定，要到下一場戰鬥才會套用。"

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED"
msgstr "增強視覺效果"

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED/description"
msgstr "開啟增強視覺效果。關閉此選項會還原為一般效果，可能會因此提升遊戲效能。"

msgid "INCREASE_EFFECTS_CONTRAST_ENABLED/warning"
msgstr "如果當前戰鬥已關閉了該設定，要到下一場戰鬥才會套用。"

msgid "LANGUAGE_CODE"
msgstr "zh_tw"

msgid "LIGHTING_QUALITY"
msgstr "光線品質"

msgid "LIGHTING_QUALITY/description"
msgstr "決定太陽光線與光暈效果的品質與顯示方式。\n\n提高這個參數值會大幅地增加顯示卡的負載。"

msgid "MOTION_BLUR_QUALITY"
msgstr "動態模糊效果"

msgid "MOTION_BLUR_QUALITY/description"
msgstr "決定車輛移動與鏡頭轉動時，其影像的動態模糊品質。"

msgid "MSAA_QUALITY"
msgstr "反鋸齒"

msgid "MSAA_QUALITY/description"
msgstr "決定遊戲物件細線及輪廓的額外處理程度。使混疊效應降到最低。\n\n• 低──MSAA 2x\n• 中──MSAA 4x\n• 高──MSAA 8x"

msgid "OBJECT_LOD"
msgstr "物件動態光"

msgid "OBJECT_LOD/description"
msgstr "決定物件的顯示數量與其品質。"

msgid "POST_PROCESSING_QUALITY"
msgstr "後處理"

msgid "POST_PROCESSING_QUALITY/description"
msgstr "決定後處理視覺效果的品質：熱扭曲和熱浪效果、色差、暈影、電影膠捲顆粒、... 等。\n\n降低這個參數值可以提高遊戲的效能。"

msgid "RENDER_PIPELINE_QUALITY"
msgstr "畫質"

msgid "RENDER_PIPELINE_QUALITY/description"
msgstr "增強：允許使用最高的影像品質。\n\n簡化：允許透過簡化或關閉某些視覺效果以獲得最高的效能。"

msgid "RENDER_PIPELINE_QUALITY/label"
msgstr "畫質："

msgid "RENDER_PIPELINE_QUALITY/warning"
msgstr "對此參數的變更將在重新啟動遊戲後生效。"

msgid "SEMITRANSPARENT_LEAVES_ENABLED"
msgstr "樹葉透明度"

msgid "SEMITRANSPARENT_LEAVES_ENABLED/description"
msgstr "決定如何顯示靠近的樹木與樹叢。\n\n關閉此參數，會完全看不到靠近的樹木與樹叢之樹葉，同時也可以提高遊戲的效能。"

msgid "SHADER_VERSION_CAP"
msgstr "陰影版本"

msgid "SHADOWS_QUALITY"
msgstr "陰影品質"

msgid "SHADOWS_QUALITY/description"
msgstr "決定動態陰影在整體繪製距離上的處理品質。\n\n降低這個參數值可以大幅地提高遊戲的效能。"

msgid "SMOKE_ENABLED"
msgstr "煙霧"

msgid "SNIPER_MODE_EFFECTS_QUALITY"
msgstr "狙擊模式下的最大特效"

msgid "SNIPER_MODE_EFFECTS_QUALITY/description"
msgstr "決定在狙擊模式下跳彈火光、爆炸、煙霧以及其他真實特效的顯示品質。\n\n降低這個參數值可以提高遊戲的效能。"

msgid "SNIPER_MODE_GRASS_ENABLED"
msgstr "狙擊模式下顯示雜草"

msgid "SNIPER_MODE_GRASS_ENABLED/description"
msgstr "在狙擊模式下顯示雜草。\n\n關閉這個參數可以提高遊戲的效能。"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED"
msgstr "狙擊模式下的地形曲面細分"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED/description"
msgstr "在狙擊模式下，提高距離自身車輛半徑 50 公尺內的地形品質。只有當地形曲面細分選項開啟時才能使用。\n\n關閉這個參數值可以提高遊戲的效能。"

msgid "SPEEDTREE_QUALITY"
msgstr "植被品質"

msgid "SPEEDTREE_QUALITY/description"
msgstr "決定樹木、灌木叢和雜草的繪製品質。"

msgid "TERRAIN_QUALITY"
msgstr "地面品質"

msgid "TERRAIN_QUALITY/description"
msgstr "決定地圖表面立體感的繪製品質。\n\n請只在低階電腦的情況下才使用最小的景色品質。\n\n降低這個數值會造成客戶端與伺服端之間的景色顯示不同步。"

msgid "TERRAIN_QUALITY/warning"
msgstr "套用指定的參數可能要花上一些時間。"

msgid "TERRAIN_TESSELLATION_ENABLED"
msgstr "地形曲面細分"

msgid "TERRAIN_TESSELLATION_ENABLED/description"
msgstr "新增三角形到多邊形網格以提高網格細緻度的硬體加速程序。\n\n此功能只適用於：\n• 已啟用「增強」畫質\n• 地面品質設定為高、最大或極高\n• 已安裝 DirectX 11\n\n此設定不適用於比 DirectX 11 舊的版本。\n\n關閉此參數可提高遊戲效能。"

msgid "TEXTURE_QUALITY"
msgstr "貼圖品質"

msgid "TEXTURE_QUALITY/description"
msgstr "遊戲物件的表面品質，特別是在近距離查看之下。\n\n降低這個參數值可以提高遊戲的效能。"

msgid "TEXTURE_QUALITY/warning"
msgstr "套用指定的參數可能要花上一些時間。"

msgid "TRACK_PHYSICS_QUALITY"
msgstr "履帶物理機制"

msgid "TRACK_PHYSICS_QUALITY/description"
msgstr "決定運作正常與遭摧毀之履帶及履帶細節的物理模擬品質。\n\n降低或關閉此參數可以提高遊戲的效能。"

msgid "VEHICLE_DUST_ENABLED"
msgstr "開啟履帶與車輪效果"

msgid "VEHICLE_DUST_ENABLED/description"
msgstr "顯示履帶與車輪後方濺起的土塊、雪片以及水花。\n\n關閉這個參數可以提高遊戲的效能。"

msgid "VEHICLE_TRACES_ENABLED"
msgstr "開啟履帶與車輪痕跡"

msgid "VEHICLE_TRACES_ENABLED/description"
msgstr "顯示地面上的履帶與車輪痕跡。\n\n不適用於「簡化」畫質設定與較低的花樣品質。"

msgid "VISIBILITY_TUNNEL"
msgstr "效果與 3D 配飾可見度"

msgid "VISIBILITY_TUNNEL/description"
msgstr "調整螢幕中央附近的效果與 3D 配飾可見度，以降低瞄準時的視覺遮蔽。3D 配飾的可見度僅在狙擊模式下調整。\n\n較低的數值會讓效果與 3D 配飾較透明，以提升瞄準時的清晰度。"

msgid "WATER_QUALITY"
msgstr "水面品質"

msgid "WATER_QUALITY/description"
msgstr "決定水面的繪製品質。"

msgid "aim/armorFlashlight/colorSchema/greenShades/label"
msgstr "僅裝甲薄弱處"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/body"
msgstr "若啟用，解析儀僅強調目標的裝甲薄弱處。\n\n穿透機率高的裝甲部位會以填滿的綠色強調，裝甲穿透機率一般的部位，則會以半透明的綠色標示。在色盲模式下的色彩可能不同。"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/header"
msgstr "僅強調裝甲薄弱處"

msgid "aim/armorFlashlight/colorSchema/redShades/label"
msgstr "僅裝甲厚實處"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/body"
msgstr "若啟用，解析儀僅強調目標的裝甲厚實處。\n\n穿透機率趨近於零的裝甲部位會以填滿的紅色強調，裝甲穿透機率一般的部位，則會以半透明的紅色標示。在色盲模式下的色彩可能不同。"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/header"
msgstr "僅強調裝甲厚實處"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/label"
msgstr "所有裝甲"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/body"
msgstr "若啟用，解析儀會強調目標的所有裝甲。\n\n穿透機率趨近於零的裝甲部位會以紅色強調，穿透機率高的裝甲部位會以綠色強調，裝甲穿透機率一般的部位會以黃色強調。在色盲模式下的色彩可能不同。"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/header"
msgstr "強調所有裝甲"

msgid "aim/armorFlashlight/colorSchemas"
msgstr "裝甲強調"

msgid "aim/armorFlashlight/enabled/label"
msgstr "在戰鬥開始時開啟"

msgid "aim/armorFlashlight/enabled/tooltip/body"
msgstr "戰鬥一開始解析儀的預設狀態。您可隨時使用指派的快捷鍵來開啟或關閉。解析燈\n\n開啟時，解析儀僅在狙擊模式下作用。\n\n支援的遊戲模式：\n• 隨機戰鬥與隊伍訓練；\n• 前線；\n• 遊戲廳戰鬥；\n• 天梯戰；\n• 其他特定活動與模式。\n\n未來可能會支援額外的模式與活動。"

msgid "aim/armorFlashlight/enabled/tooltip/header"
msgstr "在戰鬥開始時開啟"

