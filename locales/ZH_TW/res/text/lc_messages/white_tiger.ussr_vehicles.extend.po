msgstr "Object 140 Resistor"

msgid "_100mm_D54_TS_WT"
msgstr "100 mm U-8TS Resistor"

msgid "_100mm_UBR-412PB_WT"
msgstr "Silver Bullet"

msgid "_100mm_UBR-412PB_WT_descr"
msgstr "聯盟軍械士的驕傲"

msgid "_100mm_UBR-412PB_WT_long_special"
msgstr "每超載一台發電機，就能用等離子體為 Silver Bullet 充能。充能次數越多，等離子體造成的傷害就越高。在 Blitzträger 的保護罩關閉時射擊，藉此造成最高傷害。"

msgid "_100mm_UBR-412PB_WT_short_special"
msgstr "藉由等離子體造成額外傷害"
