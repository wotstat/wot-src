msgid "battlePassSeasonDescription"
msgstr "全新主題 3D 風格"

msgid "beCareful"
msgstr "當心"

msgid "comp7Core10"
msgstr "您可在戰前準備期間切換到更為合適的車輛。"

msgid "comp7Core10Status"
msgstr "戰前準備"

msgid "comp7Core11"
msgstr "戰前準備畫面會顯示乘員完整且已裝載砲彈的車輛。千萬別忘了在進入戰鬥前完成車輛準備。"

msgid "comp7Core11Status"
msgstr "戰前準備"

msgid "comp7Core12"
msgstr "一旦您完成車輛選擇，點擊「確認選擇」按鈕讓隊友知道。"

msgid "comp7Core12Status"
msgstr "戰前準備"

msgid "comp7Core13"
msgstr "點擊「確認選擇」按鈕後，您將無法變更車輛。"

msgid "comp7Core13Status"
msgstr "確認選擇"

msgid "comp7Core14"
msgstr "佔領地圖上的特殊點位以獲得戰術技能並獲取優勢！"

msgid "comp7Core14Status"
msgstr "關鍵點位"

msgid "comp7Core15"
msgstr "地圖上的關鍵點位。佔領此位置後，您將可使用「裝甲師雷達」戰術技能。啟用後，所有敵方車輛將在數秒內持續被偵察到。"

msgid "comp7Core15Status"
msgstr "通訊中心"

msgid "comp7Core16"
msgstr "地圖上的關鍵點位。佔領此位置後，您將可使用「火炮襲擊」戰術技能。啟用後，玩家可選擇區域並對該區域發動火炮攻擊。"

msgid "comp7Core16Status"
msgstr "炮兵總部"

msgid "comp7Core17"
msgstr "若隊友遭您的「火炮襲擊」戰術技能命中，他們的車輛不會受到傷害，但仍會被震盪。"

msgid "comp7Core17Status"
msgstr "火炮襲擊"

msgid "comp7Core18"
msgstr "請注意：此模式中的地圖可能與隨機戰鬥中的同名地圖略有不同。"

msgid "comp7Core18Status"
msgstr "活動中的地圖"

msgid "comp7Core19"
msgstr "建立 7 名玩家組成的裝甲排來提高您獲勝的機會。"

msgid "comp7Core19Status"
msgstr "團隊作戰為關鍵"

msgid "comp7Core21"
msgstr "您可在戰鬥中按下 Tab 或 Alt 鍵來查看隊友角色技能的充能等級。"

msgid "comp7Core21Status"
msgstr "隊友的角色技能"

msgid "comp7Core22"
msgstr "您可查看隊伍名單來確認您的隊友是否已獲得任何戰術技能，敵人的戰術技能則不會顯示。"

msgid "comp7Core22Status"
msgstr "戰術技能"

msgid "comp7Core23"
msgstr "若車輛的角色技能作用中，玩家標示上將顯示相應圖示。"

msgid "comp7Core23Status"
msgstr "角色技能效果"

msgid "comp7Core24"
msgstr "H 鍵（預設）可用來開啟語音聊天。您可使用此功能來有效地與您的隊伍溝通。"

msgid "comp7Core24Status"
msgstr "語音聊天"

msgid "comp7Core25"
msgstr "若您在使用語音聊天時遇到任何問題，請先檢查遊戲客戶端中的設定內容。"

msgid "comp7Core25Status"
msgstr "語音聊天"

msgid "comp7Core29"
msgstr "按下 Alt 時，您可視範圍內任何車輛的玩家標示上方，將會顯示車輛角色。若為隊友，您也能見到對方的角色技能充能等級。"

msgid "comp7Core29Status"
msgstr "車輛角色"

msgid "comp7Core31"
msgstr "您可在遊戲設定中為「角色技能」與「戰術技能」指派快捷鍵。"

msgid "comp7Core31Status"
msgstr "操控設定"

msgid "comp7Core32"
msgstr "在一段時間後，您將可再次佔領關鍵點位。"

msgid "comp7Core32Status"
msgstr "關於關鍵點位"

msgid "comp7Core33"
msgstr "您必須先用掉戰術技能，才能佔領相應的關鍵點位。"

msgid "comp7Core33Status"
msgstr "關於關鍵點位"

msgid "comp7Core34"
msgstr "佔領關鍵點位後，您可獲得一定數量的威望點數。"

msgid "comp7Core34Status"
msgstr "關於關鍵點位"

msgid "comp7Core35"
msgstr "查看活動規則來了解更多有關如何獲取威望點數。"

msgid "comp7Core35Status"
msgstr "關於威望點數"

msgid "comp7Core37"
msgstr "模式變項會改變車輛的特定參數，如車輛生命值、消耗品冷卻時間、可持續被見到的時間等。"

msgid "comp7Core37Status"
msgstr "天梯戰變項"

msgid "comp7Core5"
msgstr "每輛車輛均有與角色相應的特殊技能，該技能有三個充能等級。啟用技能時，充能等級越高，效果越強大。"

msgid "comp7Core5Status"
msgstr "關於角色技能"

msgid "comp7Core6"
msgstr "威望點數可藉由在戰鬥中達成出色表現、佔領關鍵點位、使用技能等方式獲取。"

msgid "comp7Core6Status"
msgstr "關於威望點數"

msgid "comp7Core8"
msgstr "偵察到敵人前，玩家無法獲得有關敵方車輛的資訊。"

msgid "comp7Core8Status"
msgstr "戰爭迷霧"

msgid "comp7Light7"
msgstr "您可點擊活動畫面中的「關於活動」按鈕來了解更多有關天梯戰輕裝版的資訊。"

msgid "comp7Light7Status"
msgstr "模式詳情"

msgid "comp7Light9"
msgstr "擁有多輛不同角色的 VIII 階車輛，您就能為任何戰鬥挑選最合適的車輛，也能根據隊友的車輛選擇進行調整。"

msgid "comp7Light9Status"
msgstr "擴充車輛陣容"

msgid "comp7Ranked0"
msgstr "進行戰鬥來獲得評價點數，藉此登上最高位階來證明自己的主宰能力。"

msgid "comp7Ranked0Status"
msgstr "排名系統"

msgid "comp7Ranked1"
msgstr "您在戰鬥中獲得越多威望點數，勝利後獲得的評價點數就越多，戰敗後失去的點數也會越少。"

msgid "comp7Ranked1Status"
msgstr "威望點數與評價點數"

msgid "comp7Ranked2"
msgstr "在天梯戰中，位階相近的玩家會被配對到同一場戰鬥。"

msgid "comp7Ranked20"
msgstr "在戰鬥結束前離開，會讓您的隊友陷入劣勢。此行為可能會導致暫時性封鎖並失去評價點數。"

msgid "comp7Ranked20Status"
msgstr "擅離職守"

msgid "comp7Ranked26"
msgstr "排行榜僅會顯示達到「勇士」與「傳奇」位階的玩家。登上排行榜的所有玩家都將獲得每日獎勵。"

msgid "comp7Ranked26Status"
msgstr "排行榜"

msgid "comp7Ranked27"
msgstr "擅離職守者將暫時無法參與遊戲模式。若連續擅離職守，封鎖的持續期間將會延長。"

msgid "comp7Ranked27Status"
msgstr "暫時性封鎖"

msgid "comp7Ranked28"
msgstr "進行遊戲模式戰鬥來解鎖「天梯戰」漸變風格的全新要素。"

msgid "comp7Ranked28Status"
msgstr "漸變風格"

msgid "comp7Ranked2Status"
msgstr "傑出玩家"

msgid "comp7Ranked3"
msgstr "「傳奇」位階僅會頒發給強者中的強者。為達此位階，您必須成為置身評價點數排行榜前 10% 的玩家。"

msgid "comp7Ranked36"
msgstr "請注意：若您在戰鬥結束前離開，您失去的評價點數將比您慘敗失去的要多。"

msgid "comp7Ranked36Status"
msgstr "擅離職守"

msgid "comp7Ranked3Status"
msgstr "傳奇"

msgid "comp7Ranked4"
msgstr "若您停止在此模式中進行戰鬥，您將失去評價點數。此規則適用於達到「白銀」、「黃金」、「勇士」、「傳奇」位階的玩家。"

msgid "comp7Ranked4Status"
msgstr "評價不活躍"

msgid "comp7Ranked7"
msgstr "您可點擊活動畫面中的「關於活動」按鈕來了解更多有關天梯戰的資訊。"

msgid "comp7Ranked7Status"
msgstr "模式詳情"

msgid "comp7Ranked9"
msgstr "擁有多輛不同角色的 X 階車輛，您就能為任何戰鬥挑選最合適的車輛，也能根據隊友的車輛選擇進行調整。"

msgid "comp7Ranked9Status"
msgstr "擴充車輛陣容"

msgid "devMaps0"
msgstr "隨機事件的發生位置將在地圖上以煙霧標記\n並在小地圖上以標示標記。\n具隨機事件的地圖可在遊戲設定中關閉。"

msgid "devMaps0Status"
msgstr "具隨機事件的地圖"

msgid "devMaps1"
msgstr "您的車輛可能在發生隨機事件的區域遭摧毀（如飛機墜毀的區域）。\n具隨機事件的地圖可在遊戲設定中關閉。"

msgid "devMaps1Status"
msgstr "具隨機事件的地圖"

msgid "dualGunVehicles"
msgstr "擁有雙管火炮系統的車輛"

msgid "epicModeHiddenFeatures"
msgstr "前線老手"

msgid "epicModeIntroduction"
msgstr "模式特色"

msgid "epicModeUseful"
msgstr "了解前線"

msgid "epicRandom0"
msgstr "您可能會在此戰鬥類型中遇到一些效能上的問題。"

msgid "epicTip1"
msgstr "當基地被佔領時，留在該區域中的所有防守隊伍車輛將標記為轟炸目標。"

msgid "epicTip10"
msgstr "除了聲望和榮耀外，每一場戰鬥後軍階還會為您帶來實用的獎勵。"

msgid "epicTip11"
msgstr "前線有著許多能獲得經驗和銀幣的新方法。"

msgid "epicTip12"
msgstr "前線會因為另一隊被擊退而移動。這使您重生於更接近目標的位置。"

msgid "epicTip13"
msgstr "當佔領環內的車輛受到傷害時，該車輛的佔領進度就會被阻擾一段時間。"

msgid "epicTip14"
msgstr "在特殊介面中啟動並增加戰鬥儲備，充分運用它們在戰場上來大肆破壞。"

msgid "epicTip15"
msgstr "如果有戰略上的需要，您隨時都能在重生畫面中變更前線。"

msgid "epicTip16"
msgstr "不要進入受到保護的區域。敵人的火炮就會對您發動攻擊。"

msgid "epicTip17"
msgstr "您卡在地圖上的某處了嗎？使用放棄功能 (預設為 J 鍵) 來離開您的車輛並重新開始。"

msgid "epicTip18"
msgstr "打開更大張的小地圖 (預設為 M 鍵) 以便更加了解戰場的情況。"

msgid "epicTip19"
msgstr "您只會收到自己小地圖上可見隊友的通訊訊息。"

msgid "epicTip2"
msgstr "如果您想賺取一點額外收入，前線會提供很多很棒的獎勵。"

msgid "epicTip20"
msgstr "您可以將滑鼠游標移到小地圖上，用滑鼠滾輪來調整其可見區域。"

msgid "epicTip21"
msgstr "您可以點擊小地圖上的基地或目標來將它們突顯出來給隊友看。"

msgid "epicTip22"
msgstr "當您的戰車用完時，務必試一試自由鏡頭模式。在能夠返回戰場前，藉由此模式鉅細靡遺地制定您的戰略。"

msgid "epicTip23"
msgstr "當基地正在被佔領且戰鬥時間也用完時，該回合就會進入加時。戰鬥會持續到所有基地都被清除乾淨為止。"

msgid "epicTip3"
msgstr "前線模式中，戰場大小為 9 平方公里，為標準型戰鬥地圖的九倍大。"

msgid "epicTip4"
msgstr "每次佔領一個區域都會提高戰鬥時間。最後一個區域會給予更多的時間。"

msgid "epicTip5"
msgstr "如果您的車輛在戰鬥中遭到擊毀，將需要一段時間才能修復。請選擇另一輛車來重新加入戰鬥。"

msgid "epicTip6"
msgstr "每五分鐘就會多一輛車抵達您的預備隊。"

msgid "epicTip7"
msgstr "在同一條前線上，攻擊者必須先佔領第一條防線的區域，才能進入第二條防線的區域。"

msgid "epicTip8"
msgstr "當位於第一條防線的所有區域都被佔領時，第二條防線的所有區域都會被弱化。"

msgid "epicTip9"
msgstr "消滅整個敵方隊伍就能贏得戰鬥。只是要達成相當不可能。"

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "遵守規則"

msgid "howToPlay"
msgstr "如何進行遊戲"

msgid "mapbox0"
msgstr "在局部天氣區域內的車輛無法偵察到區域外的車輛，反之亦然；也無法與區域外友軍交換敵方車輛的位置資訊。火災事件會對車輛造成傷害。"

msgid "mapbox0Status"
msgstr "局部天氣"

msgid "payAttention"
msgstr "注意"

msgid "ranked1"
msgstr "只要您符合車輛的角色就能獲得更多的經驗！車輛角色說明及其在戰鬥中的相應行為，都在車庫的「關於模式」資訊頁裡有提供。"

msgid "ranked10"
msgstr "透過挺進排名戰進度，您將能花費點券購買獨特車輛與自訂要素（包括折扣物品）。若要查看這些物品的清單，請點擊橫幅。\n您無法在非賽季期間購買物品或使用折扣。"

msgid "ranked11"
msgstr "每日獎勵戰鬥僅適用於聯賽。獲得這些戰鬥的數量，與外圍賽結果及是否完成特殊任務有關。每日獎勵戰鬥不可留到隔天使用。"

msgid "ranked12"
msgstr "年底時，最有效率的玩家將會加入排行榜。他們將獲得額外徽章且能享受來自社群的榮耀與尊敬。"

msgid "ranked13"
msgstr "部分軍階為永久軍階。一旦獲得此軍階就不會失去。第一軍階以外的永久軍階會另外標示。每個分組的起始軍階亦為永久軍階且不會失去。"

msgid "ranked2"
msgstr "您會因為達到下一個分組與聯賽而得到一般與每日獎勵戰鬥。獎勵戰鬥會自動加倍戰鬥中所獲得的折槓數，而且在失敗的情況下不會用掉。每輛 X 階車輛一天只能使用一次獎勵戰鬥。"

msgid "ranked3"
msgstr "密切留意黃金時段：一旦結束，直到隔天都無法使用排名戰，而您將會收到相應的通知。"

msgid "ranked4"
msgstr "一些軍階有所謂的盾牌。而在這類軍階戰敗時，您的盾牌會減弱但不會失去軍階。如果軍階盾牌沒有完全耗盡，只要在有盾牌的軍階下獲得一個折槓，就會讓盾牌完全恢復。"

msgid "ranked5"
msgstr "永不言棄！折槓不僅會頒給獲勝隊伍的前 7 名玩家，也會頒給戰敗隊伍中的最佳玩家。要記得，獎勵戰鬥中獲得的每個折槓都會加倍。"

msgid "ranked6"
msgstr "在完成所有分組後，玩家會到達三種聯賽之一：黃金、白銀，或青銅。他們將繼續奮鬥下去，而其結果將影響他們的表現並決定排行榜上的名次。"

msgid "ranked7"
msgstr "玩家每次完成分組都會獲得軍階代幣。在三個賽季裡展現出最佳表現的玩家，將獲得當之無愧的最終獎勵。"

msgid "ranked8"
msgstr "在賽季結束時，最佳玩家將獲得一個獨特徽章及一個車輛風格。這些獎勵將成為玩家自豪的標誌，象徵他們無與倫比的熟練。"

msgid "ranked9"
msgstr "您因為在排名戰的成功而獲得點券。點券可兌換技術指南和改良型裝備。此外，還有其它有價值的獎勵：銀幣、消耗品... 等。"

msgid "rankedStatus1"
msgstr "符合車輛角色的經驗"

msgid "rankedStatus10"
msgstr "排名戰物品"

msgid "rankedStatus11"
msgstr "每日獎勵戰鬥"

msgid "rankedStatus12"
msgstr "年度頂尖玩家"

msgid "rankedStatus13"
msgstr "模式規則"

msgid "rankedStatus2"
msgstr "獎勵戰鬥"

msgid "rankedStatus3"
msgstr "黃金時段"

msgid "rankedStatus4"
msgstr "模式規則"

msgid "rankedStatus5"
msgstr "模式規則"

msgid "rankedStatus6"
msgstr "聯賽的戰鬥"

msgid "rankedStatus7"
msgstr "年度獎勵"

msgid "rankedStatus8"
msgstr "賽季結束獎勵"

msgid "rankedStatus9"
msgstr "軍階的獎勵"

msgid "security"
msgstr "安全第一"

msgid "technicalAdvice"
msgstr "技術諮詢"

msgid "tip0"
msgstr "沼澤地會大幅降低車輛速度和迴轉速度。"

msgid "tip100"
msgstr "乘員熟練度會影響相應的車輛技術特性。"

msgid "tip101"
msgstr "「第六感」功能使車長能夠確定車輛是否已被敵人發現。"

msgid "tip102"
msgstr "歷練整體熟練度這項參數可決定任何乘員已訓練之歷練的效率。"

msgid "tip103"
msgstr "您可在重新訓練乘員時變更他們的專長。"

msgid "tip106"
msgstr "能改善乘員效率和車輛特性的裝備。"

msgid "tip107"
msgstr "研發了所有配件與後續車輛的車輛就能獲得精英狀態。"

msgid "tip108"
msgstr "精英車輛所獲得的戰鬥經驗、包括加值車輛，都能轉換為自由經驗。"

msgid "tip11"
msgstr "使用灌木叢與樹葉來使您的驅逐戰車更難被發現。要記得，靜止的車輛更不容易被看到。"

msgid "tip111"
msgstr "有的時候，佔領一座基地的選擇會比擊毀所有敵方車輛來得簡單且安全。"

msgid "tip114"
msgstr "共用一個帳號會違反遊戲規則、且會導致帳號被停權。"

msgid "tip115"
msgstr "遊戲規則禁止共用帳號。違規者可能會永久失去雙方的帳號。"

msgid "tip116"
msgstr "您的密碼越複雜越好。"

msgid "tip117"
msgstr "請定期變更您的密碼。"

msgid "tip118"
msgstr "遊戲規則禁止購買與販售帳號。如果您違反這些規則，就會因此而失去您的帳號。"

msgid "tip119"
msgstr "不要進入來路不明網站的連結。您會有被詐騙或盜用的風險。"

msgid "tip120"
msgstr "請您只到官方 World of Tanks 網站上購買金幣。如果您試著在其它網站上購買金幣，就會有失去金錢的風險。"

msgid "tip121"
msgstr "儲存密碼選項是很方便，不過也有潛在的不安全。"

msgid "tip122"
msgstr "您可以在入口網站上找到如何維護您的帳號安全性的說明。請仔細地閱讀它們。"

msgid "tip123"
msgstr "戰鬥時，可按住 Ctrl 來顯示滑鼠指標。"

msgid "tip124"
msgstr "想要修理配件，請使用工具包。想要治療乘員，請使用急救包。"

msgid "tip125"
msgstr "想要使用消耗品以及在彈種之間做切換，請使用快捷鍵 (預設為 1–6)。"

msgid "tip126"
msgstr "想要在火炮模式下迅速地移動鏡頭，請右鍵點擊小地圖。"

msgid "tip127"
msgstr "想要變更隊伍名單的顯示方式，請按下 CTRL+TAB。"

msgid "tip128"
msgstr "右鍵點擊兩旁隊伍面板中的玩家名稱以檢視可用的操作。"

msgid "tip129"
msgstr "想要檢舉玩家，請右鍵點擊兩旁隊伍面板中的玩家名稱、再從上下文選單中選擇相應的選項。"

msgid "tip130"
msgstr "命令選單中的可用命令組合變化，是取決於您的準星是朝向特定地形、隊友、敵人、或是物件。"

msgid "tip131"
msgstr "想要在命令選單中選擇一項命令，請按住 T 或 Z 鍵然後移動您的滑鼠來反白想用的指令。"

msgid "tip132"
msgstr "使用 F2–F8 快捷鍵來在命令選單中快速選擇命令。"

msgid "tip134"
msgstr "粗魯不是用來說服隊友您是對的最好方式。此外，它也不被遊戲規則所允許。"

msgid "tip135"
msgstr "隊友都會十分願意支援有禮貌的玩家。"

msgid "tip136"
msgstr "主要的戰鬥是發生在地圖上，而不是聊天之中。"

msgid "tip137"
msgstr "不要發送沒有意義的訊息到聊天之中，因為它們會使玩家從戰鬥中分心。"

msgid "tip138"
msgstr "當有人違反任何遊戲規則時，請使用檢舉功能。"

msgid "tip139"
msgstr "透過加入玩家到黑名單，您就能立即停止接收到來自他們的訊息與邀請。"

msgid "tip14"
msgstr "自動瞄準並不保證 100% 準確。經驗老到的玩家都是使用手動瞄準。"

msgid "tip140"
msgstr "訊息過濾可於設定中開啟。"

msgid "tip141"
msgstr "戰鬥聊天可於設定中關閉。但裝甲排聊天仍舊可以使用。"

msgid "tip142"
msgstr "當您在跟隊友爭執時，敵人正試圖掌握戰場。"

msgid "tip143"
msgstr "要密切注意戰鬥的局勢。即使是一個小錯誤也可能會導致戰敗。"

msgid "tip144"
msgstr "使用禁止的模組或互相串通，會讓您處於永遠失去帳號的危險之中。"

msgid "tip146"
msgstr "違反遊戲規則會被處罰、且可能會導致您的帳號被鎖定。"

msgid "tip147"
msgstr "如果您是因為違反遊戲規則而被處罰，我們強烈地建議您重新閱讀這些規則以防止未來再度發生這類事件。"

msgid "tip148"
msgstr "遊戲規則適用於所有的玩家，也要為違反規則擔負起責任。"

msgid "tip149"
msgstr "無法進入戰鬥？請試著先拔掉模組然後再重新啟動遊戲客戶端。"

msgid "tip150"
msgstr "畫面更新率太低？請試著到設定中使用較低的畫面品質。"

msgid "tip151"
msgstr "畫面更新率太低且畫質扭曲？請試著更新您的顯示卡驅動程式。"

msgid "tip152"
msgstr "經由 3G 或 Wi-Fi 連線的延遲過高？請試著使用有線的網際網路連線。"

msgid "tip153"
msgstr "您的車輛出現瞬移或開火延遲？請檢查您的網路連線。"

msgid "tip154"
msgstr "可靠的防毒軟體能確保您的硬體與遊戲客戶端得以穩定地運作。"

msgid "tip155"
msgstr "您的隊伍在戰鬥中聽不到您說話？請檢查語音通訊的設定。"

msgid "tip156"
msgstr "您提供給玩家服務的問題敘述越詳細，就能越迅速地解決您的問題。"

msgid "tip157"
msgstr "聯絡玩家服務之前，請先確認問題在關閉遊戲模組後還是會出現。"

msgid "tip158"
msgstr "將您的電話號碼加入到帳號，就能讓您的帳號避免可能會被盜用。"

msgid "tip159"
msgstr "請確保您所加入到帳號的行動電話號碼是有用的。這將能快速恢復您的帳號存取權限。"

msgid "tip160"
msgstr "透過將您的行動電話號碼連接到帳號，您就可以變更用來註冊帳號的電子郵件地址。"

msgid "tip161"
msgstr "如果您懷疑有人未經授權登入您的帳號，請馬上聯絡客戶支援服務。"

msgid "tip162"
msgstr "千萬不要接受來自不明使用者的禮品。"

msgid "tip163"
msgstr "選擇正確的玩家服務類別以確保能快速地解決您的問題。"

msgid "tip164"
msgstr "一名熟練的自走炮玩家，可用彈道來找出並摧毀一輛沒有在改變其開火位置的敵方自走炮。"

msgid "tip165"
msgstr "自動滅火系統能迅速地撲滅火災、並降低引擎起火的機率。"

msgid "tip166"
msgstr "駕駛自走炮時，記得要考慮砲彈的飛行路徑與速度、以及地形的不規則性。"

msgid "tip167"
msgstr "要密切注意小地圖上的隊友與敵人。"

msgid "tip168"
msgstr "在被動偵察下開火，會顯露出您的位置。您會因為偵察到敵人而獲得額外的經驗與銀幣收入。"

msgid "tip169"
msgstr "使用工具包來快速修理受損的履帶。一旦您的車輛恢復移動力，就要試著去避開敵人的砲彈。"

msgid "tip17"
msgstr "一個有著良好裝甲的目標是不會被穿甲彈所擊敗的、不過還是會受到高爆彈的傷害。"

msgid "tip170"
msgstr "像是灌木叢、倒下的樹都能隱藏您的車輛。"

msgid "tip171"
msgstr "巨礫與深溝能使您的車輛動彈不得。"

msgid "tip173"
msgstr "您可以調動乘員到相同國家與類型的加值車輛上，無需重新訓練。"

msgid "tip174"
msgstr "乘員受傷會降低其作戰效率。"

msgid "tip176"
msgstr "想要獲得您的禮品，收件玩家必須要登入並前往其帳號管理。"

msgid "tip177"
msgstr "在任何情況下，破壞/傷害隊友車輛的處罰都不得上訴。"

msgid "tip178"
msgstr "請詢問玩家服務以釐清您帳號被暫停的原因。"

msgid "tip179"
msgstr "在為遺失的車輛向玩家服務送出回報單之前，請確認您已關閉遊戲客戶端中的車輛過濾。"

msgid "tip180"
msgstr "您可以透過主要音量的滑動條或變更您的系統音量設定來調整音量。"

msgid "tip181"
msgstr "可到聲音設定中選擇您的聲音裝置──「2.0/2.1 音響系統」或「耳機」──以獲得更好的聲音定位。"

msgid "tip182"
msgstr "為了能在低階音響系統上獲得最佳效能，請使用「膝上型電腦」預設。"

msgid "tip183"
msgstr "使用夜間模式來降低尖銳的聲音。"

msgid "tip184"
msgstr "您可以選擇低音增強選項，但在不同音響系統上的結果也會不同。"

msgid "tip185"
msgstr "輕型輪式車輛具有最高的動力特性，允許它們搶先拿下有利位置，或是進入安全的掩體以躲避敵人攻擊。"

msgid "tip186"
msgstr "這種戰車裝載了兩管可同時或單獨進行開火的戰車炮。控制開火的按鍵可在設定中進行更改。"

msgid "tip191"
msgstr "依您打算安裝的車輛階級不同，可能有多個不同型號的裝備。"

msgid "tip192"
msgstr "就 VI 階與以上車輛而言，在對應類別欄位安裝標準裝備可獲得額外加成。在不同類別欄位安裝則提供標準加成。"

msgid "tip193"
msgstr "最高速度不受車輛配置的影響。可藉由安裝相應的裝備，購買戰地升級，或為車輛乘員訓練合適歷練來提高。"

msgid "tip194"
msgstr "戰地升級讓您依自身玩法設定車輛。"

msgid "tip195"
msgstr "戰地升級解鎖車輛的替代配置。選擇合適的配置將讓您在即將到來的戰鬥中獲得優勢。"

msgid "tip196"
msgstr "使用 Ctrl+1 與 Ctrl+2 快捷鍵來在核心與輔助武裝之間切換。"

msgid "tip197"
msgstr "在達到特定戰地升級等級後，您可為第二個裝備欄位指派類別。"

msgid "tip198"
msgstr "獲得精英狀態的 VI–X 階車輛可使用戰地升級。購買特殊、獎品、獎勵與加值車輛後，可立即使用改裝。"

msgid "tip199"
msgstr "改裝樹的配置與車輛類型和角色直接相關。"

msgid "tip200"
msgstr "當主要履帶遭摧毀時，得以維持部分的機動性。"

msgid "tip200Status"
msgstr "備用履帶"

msgid "tip201"
msgstr "當主要履帶遭摧毀時，得以維持部分的機動性。"

msgid "tip202"
msgstr "噴射助推器可用來提高車輛的機動性，讓您更快佔據優勢位置或穿越危險區域。"

msgid "tip202Status"
msgstr "具有噴射助推器的車輛"

msgid "tip203"
msgstr "按下 TAB 或 B 鍵來啟用個人儲備"

msgid "tip204"
msgstr "炮管在開火後若充分降溫，擴散度將會降低。半徑較小的第二個瞄準圈將會出現，其將決定砲彈的彈著區域。此效果將持續至下一發砲彈射擊為止。"

msgid "tip204Status"
msgstr "雙重瞄準"

msgid "tip205"
msgstr "自動武器的一種類型，具備極高的射速。射擊效率會藉由瞄準圈內的指示來顯示。"

msgid "tip205Status"
msgstr "自動火炮"

msgid "tip206"
msgstr "乘員最多可訓練 6 個主要專長歷練。"

msgid "tip207"
msgstr "擁有多個專長的乘員，可為額外的專長訓練額外歷練。這些額外歷練不需要使用經驗來訓練且不會計入歷練數量上限。"

msgid "tip208"
msgstr "若數名乘員有同樣的專長，歷練的效率會以所有乘員該歷練的平均值計算。若要讓該歷練效率達 100%，\n則擁有相同專長的所有乘員都必須完成該歷練的訓練。"

msgid "tip209"
msgstr "達到 6 個歷練的上限後，乘員仍能繼續獲取經驗，這些經驗將轉換為「通用訓練指南」，可用來訓練其他乘員。"

msgid "tip210"
msgstr "此車輛裝備的炮管系統能讓您依戰況選擇不同的射擊模式"

msgid "tip210Status"
msgstr "可選擇射擊模式的車輛"

msgid "tip211"
msgstr "噴射助推器可用來提高車輛的機動性，讓您更快佔據優勢位置或穿越危險區域。"

msgid "tip211Status"
msgstr "具有噴射助推器的車輛"

msgid "tip23"
msgstr "裝甲防護力較弱的輕型車輛可透過衝撞來摧毀。"

msgid "tip25"
msgstr "使用高爆彈以摧毀配件並擊昏敵方乘員。"

msgid "tip28"
msgstr "高爆彈用來對付裝甲防護力較弱以及開頂式戰鬥艙車輛十分有效。"

msgid "tip29"
msgstr "想要停下敵方車輛並使之成為容易下手的目標，請射擊它的履帶。"

msgid "tip30"
msgstr "低姿態會使得車輛難以被發現，特別是在灌木叢中。"

msgid "tip31"
msgstr "若您無法以選擇的砲彈對敵人造成傷害，試著使用其他砲彈類型。"

msgid "tip32"
msgstr "乘員熟練度加成可進一步提升乘員歷練的熟練度，藉此提高所在車輛進入戰鬥時的基本特性。"

msgid "tip33"
msgstr "一輛靜止的車輛會比移動中的車輛更難以被發現。"

msgid "tip36"
msgstr "近距離戰鬥中，自走炮可用直接火力來摧毀敵方車輛。"

msgid "tip37"
msgstr "當您撞毀籬笆與建築物時，敵方自走炮就能猜出您的所在。"

msgid "tip39"
msgstr "集中火力是有其道理的。"

msgid "tip41"
msgstr "想要發現敵方車輛，請觀察其彈道軌跡。"

msgid "tip42"
msgstr "越多的車輛在敵人基地圈內，就能越快佔領基地。透過三輛車就能達成最快佔領速度。"

msgid "tip43"
msgstr "如果突襲模式中沒有隊伍取得優勢，在戰鬥時間到期時，獲勝會屬於防守的隊伍。"

msgid "tip44"
msgstr "佔領基地時要閃避敵人砲彈。如果您的車輛受到傷害，就會打斷基地的佔領。"

msgid "tip45"
msgstr "操控性受懸吊類型、引擎功率與安裝配件的總重量影響。可透過安裝對應的裝備改善。"

msgid "tip47"
msgstr "建築與摧毀的車輛可阻擋敵人的火力。樹木與灌木叢也許可以將您隱藏起來，但它們卻無法阻擋來襲的砲彈。"

msgid "tip48"
msgstr "點擊工具包以修理受損配件。"

msgid "tip49"
msgstr "當炮管因半毀而無法射擊時。請使用工具包來恢復炮管的功能。"

msgid "tip50"
msgstr "傷害到彈藥架可能會導致裝填速度降低，或者，在一些情況下，立即殉爆。"

msgid "tip56"
msgstr "加值帳號在每場戰鬥後都會多提供 50% 的經驗與銀幣。"

msgid "tip57"
msgstr "您可使用自由經驗來研發任何車輛、配件或改裝。"

msgid "tip58"
msgstr "在研發配件、車輛與改裝時，會先花費戰鬥經驗，最後才會花費自由經驗。"

msgid "tip6"
msgstr "不同類型的車輛，往往都會需要不同的戰術。"

msgid "tip60"
msgstr "偵察、傷害與擊毀敵方車輛，以及佔領/防禦基地等都會獲得銀幣和經驗。"

msgid "tip62"
msgstr "您的射擊能降低敵方車輛的血量、損壞或摧毀配件、或是傷其乘員。"

msgid "tip65"
msgstr "多利用地形的不規則性，因為它們可以躲避直接火力與觀測。"

msgid "tip66"
msgstr "一支能充分配合的隊伍就是一支勝利的隊伍。"

msgid "tip67"
msgstr "如果您用完了您的車庫空間，請考慮購買另一個車位或出售您其中一輛車。"

msgid "tip68"
msgstr "請使用倉庫來出售您所不需要的車輛、配件、消耗品、裝備或彈藥。"

msgid "tip69"
msgstr "如果有任何人詢問您的密碼，這是種詐騙手段。管理人員永遠不會以任何理由而需要您的密碼。請不要公開您的密碼。"

msgid "tip70"
msgstr "加值車輛的修理費用很便宜的。"

msgid "tip71"
msgstr "不要朝您的隊友開火！"

msgid "tip75"
msgstr "迴轉炮塔或車身會降低您的射擊準度，所以在動作完成之後，請等候瞄準圈縮圈鎖定目標。"

msgid "tip77"
msgstr "加速受引擎功率、車輛重量與地面類型影響。可透過安裝對應裝備，或使用對應消耗品、改裝與乘員歷練來改善。"

msgid "tip78"
msgstr "懸吊配件都有著不同的迴轉速度與越野能力。"

msgid "tip79"
msgstr "重量比、速度、以及車輛裝甲厚度決定了衝撞的效果。"

msgid "tip81"
msgstr "炮手的歷練、某些已安裝的裝備和消耗品決定了瞄準目標的縮圈速度。"

msgid "tip83"
msgstr "如果追蹤的目標已摧毀或是不見，就會關閉自動瞄準。"

msgid "tip84"
msgstr "摧毀的車輛會被鎖定且到戰鬥結束為止，都會保持在車庫中無法使用。"

msgid "tip85"
msgstr "您只能用完全修好的車輛以及完整的乘員來進入戰鬥。"

msgid "tip86"
msgstr "您可以為您的車輛勾選自動補充以及自動修理選項。"

msgid "tip87"
msgstr "傾斜裝甲提高了跳彈以及未穿透命中的機率。"

msgid "tip88"
msgstr "要是乘員未接受特定車輛的訓練，他們以該車輛進入戰鬥時無法使用歷練。"

msgid "tip89"
msgstr "您可以將乘員調動到另一輛車上或是將他們送回兵營中。"

msgid "tip9"
msgstr "當您感到危險時，請移動您的自走炮 — 您會活得更久。"

msgid "tip91"
msgstr "您無法以不完整的乘員來開始戰鬥。"

msgid "tip92"
msgstr "您的乘員訓練速度取決於他們在戰鬥中的成功。"

msgid "tip93"
msgstr "車長可為所有其他乘員提供熟練度加成。乘員熟練度也可使用特定乘員歷練、部分裝備或消耗品提升。"

msgid "tip95"
msgstr "開啟加速乘員訓練會將獲得的所有戰鬥經驗給予熟練度最低的乘員。"

msgid "tip98"
msgstr "可用裝備清單與各自車輛的階級、類型與設計特色有關。"

msgid "tip99"
msgstr "所有的裝備都能拆卸下來並轉移到其它車輛上。"

