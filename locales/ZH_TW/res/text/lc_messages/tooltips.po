msgid "notrecruitedtankman/wt_2024_skill4ltu/label"
msgstr "Waffenträger：審判時刻"

msgid "notrecruitedtankman/wt_2024_vonkrieger/desc"
msgstr "這失去方向的世界比以往都更需要我。"

msgid "notrecruitedtankman/wt_2024_vonkrieger/label"
msgstr "Waffenträger：審判時刻"

