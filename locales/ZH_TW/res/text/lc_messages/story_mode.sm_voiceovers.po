msgid "vo_sm_char07_m05_stg57_03"
msgstr "正確判斷"

msgid "vo_sm_char07_m05_stg58_01"
msgstr "我不確定這是個好主意"

msgid "vo_sm_char07_m05_stg58_02"
msgstr "聽起來風險重重"

msgid "vo_sm_char07_m05_stg59_01"
