msgid "vo_sm_char07_m05_stg56_01"
msgstr "哈，有意思！"

msgid "vo_sm_char07_m05_stg56_02"
msgstr "我笑了！"

msgid "vo_sm_char07_m05_stg56_03"
msgstr "這笑話真有哏"

msgid "vo_sm_char07_m05_stg56_04"
msgstr "沒時間開玩笑了"

msgid "vo_sm_char07_m05_stg56_05"
