msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "這輛 Pojistka 簡直是掛上履帶的移動工坊。稜角分明、線路整齊，每個系統一經指令便立刻回應。我們上戰場是為了阻止一名瘋狂科學家，結果卻對上了他稱為「電子智慧」的東西。他的哨兵仍在學習，觀察我們的一舉一動。他打造這些哨兵是為了取代我們。好，今天就讓我幫它們上一課。我找到一處山脊，鎖定一個目標，然後用這些齜牙咧嘴的砲彈收尾。若他真相信他那能思考的機器能比我們撐得久，那就讓我們見識它在壓力下能如何接招。"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "大規模現代化的主力戰車"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silver Bullet"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "聯盟軍械士的驕傲"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "每超載一台發電機，就能用等離子體為 Silver Bullet 充能。充能次數越多，等離子體造成的傷害就越高。在 Blitzträger 的保護罩關閉時射擊，藉此造成最高傷害。"

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "藉由等離子體造成額外傷害"
