msgid "special_style/NY2020_new_year_desc"
msgstr "Een stijl die is gebaseerd op het patroon van het legendarische tapijt van de Perzische prins Dyud. Het kon niet vliegen, maar het paste wel perfect in elke kamer."

msgid "special_style/NY2020_new_year_desc/long"
