msgid "mode/halloween/battlePassTooltip/body"
msgstr "Bepaalde missies in het {whiteSpanish_open}Babylon: Duistere Toren{whiteSpanish_close} evenement geven je de mogelijkheid om Vechtpaspunten te verdienen."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Vechtpaspunten"

msgid "mode/halloween/calendar"
msgstr "Het evenement duurt %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Het evenement eindigt over %(date)s."

msgid "mode/halloween/description"
msgstr "Vecht en verzamel materie.\nGevechten in speciale voertuigen."

msgid "mode/halloween/performance/highRisk/description"
msgstr "De prestatie van jouw computer is voor deze modus onvoldoende. Je kunt problemen ervaren met graphics en voertuigbeweging. Het is ook waarschijnlijk dat de spelclient crasht."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Lage prestatie"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Lage prestatie"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Deze modus vereist een hoge computerprestatie.\nJe zult problemen ervaren met de graphics, voertuigbeweging en het laden van de kaart. Probeer in het geval van een onvoldoende prestatie om in je instellingen de graphics te verlagen."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Verminderde prestatie"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Verminderde prestatie"
