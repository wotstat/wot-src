msgid "adaptationHealthRestore/battleDescr"
msgstr "Herstelt onmiddellijk %(immediatelyRestore)s van de levenspunten van het voertuig. Gedurende de %(duration)s s dat de bekwaamheid actief is, wordt alle ontvangen schade van granaten en gevechtsbekwaamheden verzameld en in levenspunten omgezet, plus een extra %(restoringCoefficient)s van de totale hoeveelheid ontvangen schade wanneer de bekwaamheid eindigt.\n\n*HP-herstel heeft ook invloed op geallieerde voertuigen binnen een klein bereik."

msgid "adaptationHealthRestore/descr"
msgstr "Herstelt onmiddellijk %(immediatelyRestore)s van de levenspunten van het voertuig. Gedurende de %(duration)s s dat de bekwaamheid actief is, wordt alle ontvangen schade van granaten en gevechtsbekwaamheden verzameld en in levenspunten omgezet, plus een extra %(restoringCoefficient)s van de totale hoeveelheid ontvangen schade wanneer de bekwaamheid eindigt.\n\n*HP-herstel heeft ook invloed op geallieerde voertuigen binnen een klein bereik."

msgid "adaptationHealthRestore/longDescr"
msgstr "{green_Open}Herstelt meteen %(immediatelyRestore)s{green_Close} van de levenspunten van het voertuig. Gedurende de {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} dat de bekwaamheid actief is, wordt alle ontvangen schade van granaten en gevechtsbekwaamheden verzameld en in levenspunten omgezet, plus een {green_Open}extra %(restoringCoefficient)s van de totale hoeveelheid ontvangen schade{green_Close} wanneer de bekwaamheid eindigt.\n\n*HP-herstel heeft ook invloed op geallieerde voertuigen binnen een klein bereik."

msgid "adaptationHealthRestore/name"
msgstr "Adaptief pantser"

