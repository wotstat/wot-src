msgid "br_respawn/name"
msgstr "Respawn"

msgid "br_respawn/platoon/descr"
msgstr "Stelt je in staat om nadat je voertuig is vernietigd weer het gevecht in te gaan. Dit kan alleen in de eerste %(duration)s min van een gevecht.\n\nOm een bondgenoot te respawnen, moet je gedurende %(timeToResurrect)s s niet in de strijd zijn verwikkeld. Respawnladingen worden gedeeld met je pelotongenoten."

msgid "br_respawn/solo/descr"
msgstr "Stelt je in staat om nadat je voertuig is vernietigd weer het gevecht in te gaan. Dit kan alleen in de eerste %(duration)s min van een gevecht.\n\nNa vernietiging zal je voertuig automatisch respawnen."

msgid "br_smoke/battleDescr"
msgstr "Voegt een %(duration)s seconde durende verborgenheidsbonus toe aan alle voertuigen binnen het verbruiksartikelbereik."

msgid "br_smoke/descr"
msgstr "Voegt een verborgenheidsbonus toe aan alle voertuigen binnen het verbruiksartikelbereik."

msgid "br_smoke/longDescr"
msgstr "Voegt een %(duration)s seconde durende verborgenheidsbonus toe aan alle voertuigen binnen het verbruiksartikelbereik."

msgid "br_smoke/name"
msgstr "Rookgordijn"

msgid "br_smoke/shortDescr"
msgstr "Voegt een verborgenheidsbonus toe aan alle voertuigen binnen het verbruiksartikelbereik."

msgid "br_smoke_with_damage/battleDescr"
msgstr "Voegt een verborgenheidsbonus toe aan alle voertuigen binnen het bereik van het verbruiksartikel, en beschadigt ALLE voertuigen binnen zijn bereik voor %(damagePerTick)s van hun totale HP per seconde. Duurt %(duration)s s.\n\n*Schade door corroderende mist verstoort het oprapen van buit niet en vernietigt ook geen voertuigen; in plaats daarvan zullen ze minstens 1 HP overhouden."

msgid "br_smoke_with_damage/descr"
msgstr "Voegt een verborgenheidsbonus toe aan alle voertuigen binnen het bereik van het verbruiksartikel, en beschadigt ALLE voertuigen binnen zijn bereik voor %(damagePerTick)s van hun totale HP per seconde. Duurt %(duration)s s.\n\n*Schade door corroderende mist verstoort het oprapen van buit niet en vernietigt ook geen voertuigen; in plaats daarvan zullen ze minstens 1 HP overhouden."

msgid "br_smoke_with_damage/longDescr"
msgstr "Voegt een verborgenheidsbonus toe aan alle voertuigen binnen het bereik van het verbruiksartikel, en beschadigt ALLE voertuigen binnen zijn bereik {whiteSpanish_Open}voor %(damagePerTick)s{whiteSpanish_Close} van hun totale HP per seconde. Duurt {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close}.\n\n*Schade door corroderende mist verstoort het oprapen van buit niet en vernietigt ook geen voertuigen; in plaats daarvan zullen ze minstens 1 HP overhouden."

msgid "br_smoke_with_damage/name"
