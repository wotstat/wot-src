msgstr "Koplampendimmer (type 1)"

msgid "bomber/longDescr"
msgstr "Beveelt een aanvalsvliegtuig om bommen te werpen in het geselecteerde gebied, waarbij vijandelijke voertuigen worden verdoofd en beschadigd. Voertuigen in het centrum van het gebied ontvangen de meeste schade. Vooral effectief tegen licht en gemiddeld gepantserde voertuigen."

msgid "bomber/name"
msgstr "Luchtaanval"

msgid "bomber/shortDescr"
msgstr "Verdooft vijandelijke voertuigen en veroorzaakt een middelmatige hoeveelheid schade binnen een grote straal."

msgid "brRegenerationKit/battleDescr"
msgstr "Herstelt geleidelijk aan %(healPerTickDuration)s van de HP van het voertuig binnen %(duration)s s. Kan worden onderbroken wanneer het voertuig wordt beschadigd."

msgid "brRegenerationKit/descr"
msgstr "Herstelt geleidelijk aan %(healPerTickDuration)s van de HP van het voertuig binnen %(duration)s s. Kan worden onderbroken wanneer het voertuig wordt beschadigd."

msgid "brRegenerationKit/long_special"
msgstr "Herstelt geleidelijk aan {green_Open}%(healPerTickDuration)s{green_Close} van de HP van het voertuig {whiteSpanish_Open}binnen %(duration)s s{whiteSpanish_Close}. Kan worden onderbroken wanneer het voertuig wordt beschadigd."

msgid "brRegenerationKit/name"
msgstr "Herstel"

msgid "brRegenerationKit/short_special"
msgstr "Herstelt geleidelijk aan {green_Open}%(healPerTickDuration)s{green_Close} van de HP van het voertuig {whiteSpanish_Open}binnen %(duration)s s{whiteSpanish_Close}. Kan worden onderbroken wanneer het voertuig wordt beschadigd."

