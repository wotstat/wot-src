msgid "berserker/battleDescr"
msgstr "Verhoogt de penetratie en vuursnelheid met een factor %(gunPiercing)s en verbetert ook de richtefficiëntie en stabilisatie met %(gunAimingTime)s, maar vermindert de totale HP van je voertuig met %(healthDebuff)s tijdens de %(duration)s s die de bekwaamheid duurt.\n\n*Je voertuig kan niet door schade van de Berserker bekwaamheid worden vernietigd."

msgid "berserker/descr"
msgstr "Verhoogt de penetratie en vuursnelheid met een factor %(gunPiercing)s en verbetert ook de richtefficiëntie en stabilisatie met %(gunAimingTime)s, maar vermindert de totale HP van je voertuig met %(healthDebuff)s tijdens de %(duration)s s die de bekwaamheid duurt.\n\n*Je voertuig kan niet door schade van de Berserker bekwaamheid worden vernietigd."

msgid "berserker/longDescr"
msgstr "Verhoogt de penetratie en vuursnelheid {green_Open}met een factor %(gunPiercing)s{green_Close} en verbetert ook de richtefficiëntie en stabilisatie {green_Open}met %(gunAimingTime)s{green_Close}, maar vermindert de totale HP van je voertuig met {red_Open}%(healthDebuff)s{red_Close} tijdens de {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} die de bekwaamheid duurt.\n\n*Je voertuig kan niet door schade van de Berserker bekwaamheid worden vernietigd."

msgid "berserker/name"
msgstr "Berserker"

msgid "berserker/shortDescr"
msgstr "Verhoogt de penetratie en vuursnelheid {green_Open}met een factor %(gunPiercing)s{green_Close} en verbetert ook de richtefficiëntie en stabilisatie {green_Open}met %(gunAimingTime)s{green_Close}, maar vermindert de totale HP van je voertuig met {red_Open}%(healthDebuff)s{red_Close} tijdens de {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} die de bekwaamheid duurt.\n\n*Je voertuig kan niet door schade van de Berserker bekwaamheid worden vernietigd."

