msgid "hint/LSH_FIRE"
msgstr "Rook maakt het verkennen van vijandelijke voertuigen en doorgeven van hun posities moeilijker. Brand veroorzaakt schade aan voertuigen."

msgid "hint/LSH_FOG"
msgstr "Mist maakt het verkennen van vijandelijke voertuigen en doorgeven van hun posities moeilijker."

msgid "hint/LSH_RAIN"
msgstr "Zware regenval maakt het verkennen van vijandelijke voertuigen en doorgeven van hun posities moeilijker."

msgid "hint/LSH_SANDSTORM"
msgstr "Zandstormen maken het verkennen van vijandelijke voertuigen en doorgeven van hun posities moeilijker."

msgid "hint/LSH_SMOKE"
msgstr "Rook maakt het verkennen van vijandelijke voertuigen en doorgeven van hun posities moeilijker."

msgid "hint/PPH_AIMING_01"
msgstr "Voertuig- en koepelbeweging verminderen de <font color='#EE7000'>nauwkeurigheid van het kanon</font>."

msgid "hint/PPH_AIMING_02"
msgstr "De cirkel rond het dradenkruis geeft de <font color='#EE7000'>nauwkeurigheid van het kanon</font> aan. Wacht even om het schot nauwkeuriger te maken."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatisch richten</font> aangezet. Rechtermuisklik om het uit te zetten."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatisch richten richt altijd je kanon <font color='#EE7000'>op het midden</font> van je doelwit."

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Je basis wordt <font color='#EE7000'>veroverd!</font> Als dit niet wordt gestopt, zal het vijandelijk team het gevecht winnen."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Elk vijandelijk voertuig heeft <font color='#EE7000'>zijn eigen</font> veroveringsvoortgang."

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Verovering</font> van de vijandelijke basis is een van de manieren om een gevecht te winnen."

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Als je schade ontvangt, wordt je veroveringsvoortgang <font color='#EE7000'>gereset</font>."

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Als je de cirkel verlaat, gaat je veroveringsvoortgang <font color='#EE7000'>verloren</font>."

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Met meer voertuigen verover je een basis <font color='#EE7000'>sneller</font>."

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Na het <font color='#EE7000'>derde</font> voertuig wordt de basisverovering niet meer versneld."

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "De vijandelijke basis is bijna veroverd!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Jouw team is de veroveringsrace aan het winnen!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Voertuigmodule kritisch beschadigd! Repareer de module door de <font color='#EE7000'>reparatieset</font> in het onderste paneel te gebruiken."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Voertuigmodule kritisch beschadigd! Repareer de module door de <font color='#EE7000'>reparatieset</font> in het onderste paneel te gebruiken."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Bemanningslid gewond! Genees het bemanningslid met de <font color='#EE7000'>verbanddoos</font> in het onderste paneel."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Bemanningslid gewond! Genees het bemanningslid met de <font color='#EE7000'>verbanddoos</font> in het onderste paneel."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Voertuigbemanning verdoofd! Behandel ze met de <font color='#EE7000'>verbanddoos</font> in het onderste paneel."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Het voertuig staat in brand! Gebruik de <font color='#EE7000'>brandblusser</font> in het onderste paneel."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Het voertuig staat in brand! Automatische <font color='#EE7000'>brandblusser</font> geactiveerd."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Voertuigmodule kritisch beschadigd! Monteer voor het gevecht een <font color='#EE7000'>reparatieset</font> om het effect van kritische treffers te kunnen verhelpen."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Bemanningslid gewond! Monteer voor het gevecht een <font color='#EE7000'>verbanddoos</font> om verwondingen te kunnen genezen."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Het voertuig staat in brand! Monteer voor het gevecht een <font color='#EE7000'>brandblusser</font> om branden te kunnen blussen."

msgid "hint/PPH_OTHER_01"
msgstr "Je bent <font color='#EE7000'>gespot</font> – het kanon afvuren kan je positie weggeven!"

msgid "hint/PPH_OTHER_02"
msgstr "Je voertuig is vernietigd. Je kunt op <font color='#EE7000'>Esc</font> drukken om zonder straf het gevecht te verlaten."

msgid "hint/PPH_OTHER_03"
msgstr "Je voertuig is vernietigd. Je kunt met de linkermuisknop je teamgenoten <font color='#EE7000'>bekijken</font>."

msgid "hint/PPH_OTHER_04"
msgstr "Het <font color='#EE7000'>gloeilamp-icoon</font> geeft aan dat vijanden je hebben gespot!"

msgid "hint/PPH_OTHER_05"
msgstr "Je kanon is nog aan het <font color='#EE7000'>herladen</font>."

msgid "hint/PPH_OTHER_06"
msgstr "Je kanon kan pas worden afgevuurd wanneer de cirkel rond het dradenkruis <font color='#EE7000'>helemaal groen</font> is."

msgid "hint/PPH_SNIPER_01"
msgstr "Je kunt het muiswiel scrollen om de <font color='#EE7000'>sluipschuttermodus</font> te betreden."

msgid "hint/PPH_SNIPER_02"
msgstr "Je kunt het muiswiel scrollen om de sluipschuttermodus te <font color='#EE7000'>verlaten</font>."

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Een <font color='#EE7000'>groen binnenste dradenkruis</font> geeft aan dat de kans om het vijandelijk pantser te doorboren groot is."

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Zelfs wanneer het binnenste dradenkruis groen is, is pantserpenetratie <font color='#EE7000'>niet zeker</font>."

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Omdat kanonnen niet 100% nauwkeurig zijn, zullen je schoten <font color='#EE7000'>niet altijd in het midden van het dradenkruis</font> belanden."

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Het binnenste dradenkruis geeft de kans aan dat het vijandelijk pantser wordt doorboord. <font color='#EE7000'>Dit kun je in de instellingen aanzetten</font>."

msgid "penetration/chance/high"
msgstr "Grote kans"

msgid "penetration/chance/low"
msgstr "Kleine kans"

msgid "penetration/chance/medium"
msgstr "Middelgrote kans"
