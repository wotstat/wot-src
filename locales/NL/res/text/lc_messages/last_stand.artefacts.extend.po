msgid "LS_damageShield/onUse"
msgstr "Creëert een energieschild dat je voertuig 10 seconden lang tegen schade beschermt, m.u.v. rammen, botsen en verdrinken."

msgid "LS_damageShield/restriction"
msgstr "?empty?"

msgid "LS_damageShield/short_special"
msgstr "Maakt het voertuig onkwetsbaar."

