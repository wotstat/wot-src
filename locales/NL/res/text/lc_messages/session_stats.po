msgid "propertyInfo/prop/descr/averageDamage"
msgstr "De verhouding van de totaal veroorzaakte schade tot het aantal deelgenomen gevechten in de sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Verhouding van vernietigde vijanden tot deelgenomen gevechten."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Gemiddeld niveau van tijdens de sessie gespeelde voertuigen."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "De verhouding van de totaal verdiende ervaring tot het aantal deelgenomen gevechten in de sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "De verhouding van de totaal geblokkeerde schade tot het aantal deelgenomen gevechten in de sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "De verhouding van de schade veroorzaakt door geallieerden door jouw verkenning, vernietiging van een rupsband met immobilisatie als gevolg, of verdoving tot het aantal gevechten dat in een sessie is gespeeld. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "De verhouding van de parameter \"Schade veroorzaakt\" tot de parameter \"Schade ontvangen\". Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "De verhouding van vernietigde vijandelijke voertuigen tot het aantal keer dat het eigen voertuig werd vernietigd. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Verhouding van verkende vijanden tot deelgenomen gevechten."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Percentage van deelgenomen gevechten waarin het voertuig van de speler niet werd vernietigd."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Percentage overwinningen in Willekeurige gevechten voor de sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/wins"
msgstr "Het aantal overwinningen in Willekeurige gevechten in de sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

msgid "propertyInfo/prop/descr/wtr"
msgstr "De gemiddelde WTR-waarden voor de gehele sessie. Delta toont het effect van de huidige spelsessie op de totale parameter."

