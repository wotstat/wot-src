msgid "battleship/name"
msgstr "Rooksein"

msgid "battleship/shortDescr"
msgstr "Een rooksein dat een gebied markeert voor een artilleriesalvo van een slagschip, dat vijandelijke uitrusting en objecten in het gebied beschadigt."

msgid "distraction_ability/name"
msgstr "Foutief bevel"

msgid "distraction_ability/shortDescr"
msgstr "Laat Gefr. Keller met de veroverde Duitse radio een foutief bevel geven, zodat vijanden naar een bepaalde locatie gaan."

msgid "recon_ability/name"
msgstr "Verkennen"

msgid "recon_ability/shortDescr"
msgstr "Stuur kapitein Dubois op verkenning naar een bepaalde locatie. Tijdens het verkennen blijft de tank stilstaan. De bekwaamheid eindigt pas wanneer die wordt geannuleerd."

msgid "scc_airstrike_ability/name"
msgstr "Luchtsteun"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Roep een luchtaanval in op een aangewezen positie."
