msgid "boxTooltip/description/text/fractal_cn_common"
msgstr "In deze kisten kun je voertuigen, in-game valuta en andere waardevolle beloningen vinden."

msgid "boxTooltip/description/text/fractal_cn_epic"
msgstr "In deze kisten kun je voertuigen, in-game valuta, aanpassingselementen en andere waardevolle beloningen vinden."

msgid "boxTooltip/description/text/fractal_cn_rare"
msgstr "In deze kisten kun je voertuigen, in-game valuta, aanpassingselementen en andere waardevolle beloningen vinden."

msgid "boxTooltip/howGet/text/fractal_cn_common"
msgstr "Je kunt ze halen in de in-game winkel en ontvangen als je andere soorten kisten opent."

msgid "boxTooltip/howGet/text/fractal_cn_epic"
msgstr "Kan worden ontvangen wanneer een ander soort kist wordt geopend."

msgid "boxTooltip/howGet/text/fractal_cn_rare"
msgstr "Kan worden ontvangen wanneer een ander soort kist wordt geopend."

