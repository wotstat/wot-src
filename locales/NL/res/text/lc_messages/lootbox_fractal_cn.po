msgstr "HEMELHULP LOOTBOX"

msgid "entryPoint/tooltip/description"
msgstr "Dit zijn speciale kisten met nieuwe en unieke items. Ze kunnen worden verkregen in de in-game winkel."

msgid "entryPoint/tooltip/timerText"
msgstr "Het evenement eindigt over"

msgid "eventName/lowerCase"
msgstr "Gods zegen"

msgid "eventName/upperCase"
msgstr "GODS ZEGEN"

msgid "guaranteed/tooltip/description1/"
msgstr "Als je alle voertuigen al hebt, krijg je een gekozen lootbox."

msgid "infoPage/footer/description/compensation"
msgstr "Als je alle voertuigen uit de kisten al hebt, krijg je een gekozen lootbox als beloning in plaats van een voertuig."

msgid "infoPage/footer/description/guaranteed"
msgstr "Elke %(guaranteed0)s hemelse, %(guaranteed1)s hemelhulp en %(guaranteed2)s gekozen lootboxes bevatten gegarandeerd een voertuig. Als je ze opent en geen voertuig vindt, dan vind je een voertuig dat je nog niet bezit als je de %(guaranteed0)se/%(guaranteed1)se/%(guaranteed2)se kist opent (afhankelijk van het soort kist). Als je een voertuig vindt, wordt de teller gereset."

msgid "infoPage/footer/title/compensation"
msgstr "Compensatie"

msgid "infoPage/footer/title/guaranteed"
msgstr "Gegarandeerde beloning"

msgid "infoPage/header/rewards/description"
msgstr "Je kunt maximaal één beloning per groep ontvangen"
