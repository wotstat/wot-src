msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Drakenbootkisten"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRAKENBOOTKISTEN"

msgid "entryPoint/tooltip/description"
msgstr "Dit zijn speciale kisten met unieke en waardevolle in-game items.\nJe kunt de kisten verkrijgen in de in-game winkel of Premiumwinkel."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Drakenbootkisten zijn tijdelijk onbeschikbaar"

msgid "eventName/lowerCase"
msgstr "Tem de draak, berijd de wind"

msgid "eventName/upperCase"
msgstr "TEM DE DRAAK, BERIJD DE WIND"

msgid "infoPage/footer/description/compensation"
msgstr "Als je alle voertuigen uit de lijst met mogelijke inhoud van de kist al hebt, dan zul je in plaats van alle voertuigen die daarna in Drakenbootkisten zitten, hun volledige waarde in goud ontvangen."

msgid "infoPage/footer/description/guaranteed"
msgstr "Elke %(guaranteed0)s Drakenbootkisten bevatten gegarandeerd een niveau VIII–IX voertuig. Als je ze hebt geopend zonder een dergelijk voertuig te ontvangen, dan bevat de %(guaranteed0)s&zwnbsp;e Drakenbootkist een niveau VIII–IX voertuig. Wanneer dat gebeurt, wordt de teller gereset."

msgid "noBoxesView/description/"
msgstr "Je hebt geen kisten.\nJe kunt ze in de in-game winkel kopen."
