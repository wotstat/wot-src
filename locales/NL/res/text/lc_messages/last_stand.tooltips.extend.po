msgid "Contact/status/inBattle/last_stand"
msgstr "In een Laatste verweer-gevecht"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Vuurt een schot af dat het doelwit en alle vijandelijke voertuigen binnen een straal van 35 m beschadigt."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Vuurt een schot af dat levenspunten herstelt door ze te stelen van het doelwit en vijandelijke voertuigen binnen een straal van 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Vuurt een schot af dat het doelwit en alle vijandelijke voertuigen binnen een straal van 35 m verdooft."

msgid "advanced/ls_damageShield"
msgstr "Biedt 10 seconden lang bescherming tegen alle soorten schade (m.u.v. rammen, botsen en verdrinken)."

msgid "advanced/ls_doubleDamage"
msgstr "Je eerstvolgende succesvolle schot veroorzaakt twee keer zoveel schade."

msgid "advanced/ls_equipment"
msgstr "Tactische apparaten helpen je om in Laatste verweer-gevechten effectiever te zijn, stadia te voltooien en waardevolle beloningen te verdienen. Rust ze uit door op een van de plekken voor tactische apparaten te klikken."

msgid "advanced/ls_extraDamageSituational"
msgstr "Geeft een kans om meer schade te veroorzaken aan een vijandelijk voertuig."

msgid "advanced/ls_fastReload"
msgstr "Verhoogt de vuursnelheid / herlaadt het magazijn."

msgid "advanced/ls_healSituational"
msgstr "Herstelt levenspunten nadat een vijandelijk voertuig is vernietigd."

msgid "advanced/ls_invisibility"
msgstr "Voorkomt tijdelijk dat vijanden op je voertuig kunnen richten, herstelt levenspunten, repareert modules, blust branden, verwijdert verdovingen en geneest alle gewonde bemanningsleden."

msgid "advanced/ls_nitro"
msgstr "Verbetert tijdelijk de mobiliteit van je voertuig."

msgid "advanced/ls_nitroSituational"
msgstr "Verbetert tijdelijk de mobiliteit van je voertuig nadat je door een vijandelijk voertuig bent beschadigd."

msgid "advanced/ls_selfRepairKit"
msgstr "Herstelt levenspunten, blust branden, verwijdert verdovingen en repareert beschadigde modules."

msgid "advanced/ls_teamRepairKit"
msgstr "Repareert beschadigde modules, blust branden, verwijdert verdovingen en herstelt een deel van de levenspunten van geallieerde voertuigen binnen zijn straal."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Tactische apparaten kunnen in speciale plekken worden geplaatst. Ze helpen je om in Laatste verweer-gevechten effectiever te zijn, stadia te voltooien en waardevolle beloningen te verdienen."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Plekken voor tactische apparaten"
