msgid "05_prohorovka/team1/heavyTank/descr"
msgstr "Het belangrijkste punt van deze tactiek is de %(a_ht_alleyPhrase1).%(p)Rijd langs de %(a_ht_railwayPhrase) en je kunt nabij het %(a_ht_villagePhrase) een vuurpositie innemen om de vijand op de %(a_ht_mountainPhrase) te beschieten. Schakel ze uit en ga naar de %(a_ht_alleyPhrase2). Nadat je dit punt hebt ingenomen, kun je de heuvels en begroeiing gebruiken om de resterende vijandelijke voertuigen op het %(a_ht_southernFieldsPhrase) te vernietigen."

msgid "05_prohorovka/team1/heavyTank/title"
msgstr "Aanval via de laan"

msgid "05_prohorovka/team1/mediumTank/descr"
msgstr "Het belangrijkste punt van deze tactiek is de %(a_mt_mountainPhrase2).%(p)Ga naar de oostflank en rijd na het oversteken van de %(a_mt_railwayPhrase) de %(a_mt_mountainPhrase1) op om een goede vuurpositie in te nemen. Als je hier de vijand hebt verdreven, kun je je richten op de vijanden in het %(a_mt_villagePhrase) en achter de spoorweg. Als je verder oprukt en de vijanden langs de spoorweg vernietigt, kun je een veilige positie innemen in kleine heuvels van het %(a_mt_southernFieldsPhrase) om op vijanden in de %(a_mt_alleyPhrase) te vuren."

msgid "05_prohorovka/team1/mediumTank/title"
msgstr "Bergaanval"

msgid "05_prohorovka/team2/heavyTank/descr"
msgstr "Het belangrijkste punt van deze tactiek is de %(b_ht_alleyPhrase1).%(p)Rijd langs de %(b_ht_railwayPhrase) en je kunt nabij het %(b_ht_villagePhrase) een vuurpositie innemen om de vijand op de %(b_ht_mountainPhrase) te beschieten. Schakel ze uit en ga naar de %(b_ht_alleyPhrase2). Nadat je dit punt hebt ingenomen, kun je de heuvels en begroeiing gebruiken om de resterende vijandelijke voertuigen op het %(b_ht_northernFieldsPhrase) te vernietigen."

msgid "05_prohorovka/team2/heavyTank/title"
msgstr "Aanval via de laan"

