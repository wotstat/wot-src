msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Speel een Willekeurig gevecht met een voertuig van welk niveau dan ook."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Welkom in het spel! Voer strijd met fans van over de hele wereld, en vier spectaculaire overwinningen!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Eerste gevecht"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Onderzoek en koop een niveau IV voertuig."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Het kopen van een nieuwe tank is een belangrijke gebeurtenis. Voertuigen worden met elk nieuw niveau interessanter. Een getrainde bemanning verbetert ook de gameplay."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Niveau IV voertuig"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Speel drie Willekeurige gevechten met niveau IV–X voertuigen waarop een willekeurig aanpassingselement is aangebracht."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Je kunt voorgeprogrammeerde stijlen op voertuigen aanbrengen, maar je kunt ook met camouflage, leuzen, emblemen en stickers je eigen stijl creëren."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Voertuigexterieur"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Begin met het trainen van een specialisatie voor een bemanningslid."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Bemanningsleden kunnen extra specialisaties trainen om hun effectiviteit te verhogen of nieuwe bekwaamheden te verwerven."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Bemanningsspecialisaties"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Verdien met niveau IV–X voertuigen 150.000 credits in Willekeurige gevechten."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Hoe hoger het niveau van het gevecht, hoe meer credits je nodig hebt om je voertuig te onderhouden, munitie aan te vullen, en modules en uitrusting te kopen."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Credits verzamelen"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Onderzoek en koop een niveau V voertuig."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Vanaf niveau V verschijnen de serieuzere tanks op het slagveld en worden je vaardigheden echt getest. Een volledig getrainde bemanning komt dan goed van pas."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Niveau V voertuig"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau V–X voertuigen waarop drie stuks uitrusting zijn gemonteerd."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Optiek met anti-reflectiecoating of verbeterde ventilatie? De juiste uitrusting kan de sterke punten van je voertuig boosten en zijn zwaktes minimaliseren."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Uitrusting monteren"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Voltooi één standaard scenario in de Topografie-modus."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Om op het slagveld vertrouwen op te bouwen, moet je bekend zijn met de routes, tactieken en kaarten, inclusief de sleutelposities en objecten die daar staan."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografie"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Voltooi vier geavanceerde scenario's op één kaart in Topografie."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Betreed van tijd tot tijd de Topografie-modus om kaarten te bestuderen. De vier scenario's stellen je in staat om de locatie vanuit alle hoeken te verkennen."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Geavanceerde Topografie"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau V–X voertuigen met een geactiveerde persoonlijke reserve."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Na activatie hiervan zul je na elk gevecht extra Gevechts-XP, Vrije en Bemannings-XP, of credits ontvangen."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Persoonlijke reserves"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Eindig met verdiende XP zes keer bij de beste 10 spelers van je team in gewonnen Willekeurige gevechten met niveau V–X voertuigen."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Met deze missies verdien je per succesvol gevecht 5 keer zoveel XP. Voorwaarde is dat je wint en met verdiende XP bij de beste 10 spelers van je team eindigt."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 missies voor ×5 XP"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Onderzoek een module en monteer die op een voertuig van welk niveau dan ook."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Gevechts-XP wordt na elk gevecht uitgereikt. Verdien Gevechts-XP om nieuwe modules te onderzoeken die de eigenschappen van je voertuig verbeteren."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Gevechts-XP"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Onderzoek en koop een niveau VI voertuig."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Hoe hoger het niveau, hoe meer tijd en inspanning het onderzoeken van voertuigen zal vergen. Vrije XP helpt je hierbij, evenals een goed getrainde bemanning."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Niveau VI voertuig"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Voltooi één persoonlijke missie van een willekeurige campagne."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Campagnes zijn missiereeksen voor verschillende voertuigtypes. Na de voltooiing zul je nuttige beloningen en unieke voertuigen ontvangen."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Persoonlijke missies"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Train een bemanning met een universeel handboek."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Met bemanningsboeken kun je de training van je bemanning aanzienlijk versnellen door een bepaalde hoeveelheid XP aan één of alle bemanningsleden toe te voegen."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Bemanningsboeken"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau VI–X voertuigen waarop een gevechtsbevel voor de bemanning is aangebracht."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Gevechtsbevelen kunnen voor één gevecht bemanningsspecialisaties verbeteren. Net als verbruiksartikelen kun je ze kopen of als beloning ontvangen."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Gevechtsbevelen voor bemanningen"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Koop in de in-game winkel een speciale Beginnersbundel."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Alles wat je nodig hebt kun je in de in-game winkel kopen, waaronder goud en Premium voertuigen. In de winkel vind je regelmatig geweldige deals en aanbiedingen."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Winkel"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau VI–X Premium voertuigen."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Deze voertuigen hoeven niet te worden onderzocht. Ze verdienen meer Gevechts-XP, Bemannings-XP en credits, en je kunt zonder hertraining bemanningen overzetten."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium voertuigen"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau VI–X voertuigen waarop een gevechtsbevel voor uitrusting is aangebracht."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Gevechtsbevelen verhogen de effectiviteit van gemonteerde uitrusting. Net als verbruiksartikelen kun je ze kopen of als beloning ontvangen."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Gevechtsbevelen voor uitrusting"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Eindig met verdiende XP 15 keer bij de beste 10 spelers van je team in Willekeurige gevechten met niveau VI–X voertuigen."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Met deze missies verdien je per succesvol gevecht 5 keer zoveel XP. Voorwaarde is dat je wint en met verdiende XP bij de beste 10 spelers van je team eindigt."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 missies voor ×5 XP"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Onderzoek en koop een niveau VII voertuig."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Op dit voertuigniveau zijn nog meer vaardigheden vereist. De voertuigen worden formidabeler en efficiënter, net als je opponenten."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Niveau VII voertuig"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Speel 10 Willekeurige gevechten met niveau VII–X voertuigen uitgerust met een grote reparatieset, grote verbanddoos en automatische brandblusser."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Grote verbruiksartikelen repareren beschadigde modules sneller dan kleine. Ze verminderen ook de verdovingsduur en kans op brand, en hebben een kortere herlaadtijd."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Grote verbruiksartikelen"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Ontvang dubbel zoveel XP voor je eerste overwinning van de dag in Willekeurige gevechten met een voertuig van welk niveau dan ook."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Je ontvangt twee keer zoveel XP voor je eerste overwinning van de dag met elk voertuig. Gebruik deze bonus om je voertuigen nog sneller te upgraden."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "XP-vermenigvuldiger"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Creëer een blauwdrukfragment voor een nog niet onderzocht voertuig."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Blauwdrukken geven je een XP-korting, waardoor je onderzoek wordt versneld. Ontvang ze als beloning, of door universele en nationale fragmenten om te zetten."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Voertuigblauwdrukken"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Eindig met verdiende XP 20 keer bij de beste 10 spelers van je team in Willekeurige gevechten met niveau VII–X voertuigen."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Met deze missies verdien je per succesvol gevecht 5 keer zoveel XP. Voorwaarde is dat je wint en met verdiende XP bij de beste 10 spelers van je team eindigt."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 missies voor ×5 XP"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Onderzoek en koop een niveau VIII voertuig."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Op niveau VIII moet je al je vergaarde kennis toepassen. Je vijanden zorgen ervoor dat je je niet verveelt, wat in actierijke en leuke gevechten resulteert."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Niveau VIII voertuig"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Gebruik Vrije XP om een willekeurige module te onderzoeken."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Als je niet genoeg Gevechts-XP hebt om een voertuig of module te onderzoeken, dan kun je Vrije XP gebruiken. Alle voertuigen verdienen deze ervaring."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Vrije XP"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Laad wat alternatieve granaten en speel een Willekeurig gevecht met een niveau III–X voertuig."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Pantserdoorborende, brisante en pantserdoorborende keramische granaten worden voor verschillende situaties gebruikt. Kies verstandig om een voordeel te krijgen!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munitie"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Verkoop een ongebruikte module in je depot."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Ongebruikte modules, granaten, uitrusting, verbruiksartikelen en andere items worden in het depot opgeslagen. Overtollige items kun je voor credits verkopen."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depot"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Verdien met niveau III–X voertuigen 25.000 credits in Willekeurige gevechten."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Met credits kun je granaten en nieuwe voertuigen kopen, voertuigen repareren, en meer. Het is belangrijk om te weten hoe je credits kunt opsparen en uitgeven."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Credits"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Speel drie Willekeurige gevechten met niveau III–X voertuigen met verbruiksartikelen in alle beschikbare plekken."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Verbruiksartikelen kunnen in het gevecht kritische schade repareren en verwondingen genezen. Gebruik ze op het juiste moment om het gevecht te overleven."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Verbruiksartikelen"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Speel drie Willekeurige gevechten met niveau III–X voertuigen waarop uitrusting is gemonteerd."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Voertuigen kunnen met uitrusting worden uitgerust om bepaalde eigenschappen te verbeteren. Welke uitrusting je het beste kunt monteren, hangt af van het voertuig en je speelstijl."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Uitrusting"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografie"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Voltooi één scenario op een willekeurige kaart in Topografie."

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Voltooi vier standaard scenario's op één kaart in Topografie."

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Verkenning"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Voltooi vier geavanceerde scenario's op één kaart in Topografie."

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Een 10 voor aardrijkskunde"
