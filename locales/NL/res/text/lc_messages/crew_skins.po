msgid "kadettKnabe/Name"
msgstr "Max"

msgid "krieger/Descr"
msgstr "\"De natuur gaf ons elektriciteit, maar ik ben de enige die de oneindige kracht ervan kon controleren en benutten. Niemand geloofde mij, sommigen lachten mij zelfs uit, maar wie het laatst lacht, lacht het best.&zwnbsp;\""

msgid "krieger/LastName"
