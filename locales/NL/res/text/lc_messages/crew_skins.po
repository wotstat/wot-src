msgid "Space01/Descr"
msgstr "Deze astronaut draagt een van de eerste drukpakken. Dit pak biedt veiligheid tijdens acceleratie, beschermt tegen het wegvallen van de druk, en zorgt voor de zuurstoflevering. Het werd medio jaren 30 in de V.S. ontworpen."

msgid "Space01/LastName"
msgstr "Harland"

msgid "Space01/Name"
msgstr "Malcolm"

msgid "Space02/Descr"
msgstr "Deze kosmonaut draagt het SK&zwnbsp;-&zwnbsp;1-pak, speciaal ontworpen voor bemanningen van de Vostok-ruimtevaartuigen. Het werd gebruikt tijdens de eerste bemande ruimtevlucht, op 12 april 1961."

msgid "Space02/LastName"
msgstr "Bykhovsky"

msgid "Space02/Name"
msgstr "Pavel"

msgid "Space03/Descr"
msgstr "Deze kosmonaut draagt het Berkut-pak dat komt met een geïntegreerd levensondersteuningssysteem, gebruikt tijdens de eerste ruimtewandeling ooit, op 18 maart 1965."

msgid "Space03/LastName"
msgstr "Simonchuk"

msgid "Space03/Name"
msgstr "Fyodor"

msgid "Space04/Descr"
msgstr "Deze astronaut draagt het A7L-pak, gebruikt door NASA voor bemande ruimtemissies en tijdens Apollo 11's maanlanding in juli 1969."

msgid "Space04/LastName"
msgstr "Lagvik"

msgid "Space04/Name"
msgstr "James"

msgid "Space05/Descr"
msgstr "Deze astronaut draagt het ACES-pak (Advanced Crew Escape Suit), gebruikt door Amerikaanse Space Shuttle-bemanningen tijdens de lancering, docking, undocking en landing. Het pak is ongeschikt voor activiteiten buiten ruimtevaartuigen."

msgid "Space05/LastName"
msgstr "Ramires"

msgid "Space05/Name"
msgstr "Joaquin"

msgid "Space06/Descr"
msgstr "Deze kosmonaut draagt de Orlan, een ruimtepak voor gebruik buiten ruimtevaartuigen. Voor het eerst gebruikt op 20 december 1977, en de aangepaste versie wordt nog steeds gedragen door kosmonauten in het ISS."

msgid "Space06/LastName"
msgstr "Belkovets"

msgid "Space06/Name"
msgstr "Aleksey"

