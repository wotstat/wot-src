msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s niveau&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Neem de controle over de antennes. Behoud het netwerk. Stel de transmissie veilig."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "De prestatie van je computer is voor deze modus onvoldoende. Je kunt problemen ervaren met de graphics en voertuigbeweging. Het is ook waarschijnlijk dat de spelclient crasht."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Lage prestatie"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Lage prestatie"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Deze modus vereist een hoge computerprestatie. Je zult problemen ervaren met de graphics, voertuigbeweging en het laden van de kaart. Probeer in het geval van een verminderde prestatie om in je instellingen de graphics te verlagen."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Verminderde prestatie"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Verminderde prestatie"
