msgid "vo_sm_char10_m05_stg04_02"
msgstr "Hoofdkwartierofficier: De tanks zitten vast op het strand. Vloot, lever vuursteun."

msgid "vo_sm_char10_m05_stg13_06"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg13_07"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg14_01"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg14_01_01"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg21_02"
msgstr "Hoofdkwartierofficier: Echo-5 bruggenhoofd veiliggesteld. Tanks rukken op. Lever vuursteun."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Hoofdkwartierofficier: Zet luchtsteun in om de tanks op te laten rukken."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Hoofdkwartierofficier: Genie, verwijder de obstakels voor de opmars."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Hoofdkwartierofficier: Het strand is vrij. Hoofdstrijdkrachten worden gestuurd. Uitstekend gedaan."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Hoofdkwartierofficier: Behoud je positie, versterkingen zijn onderweg."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Hoofdkwartierofficier: Bescherm het bruggenhoofd koste wat kost."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Hoofdkwartierofficier: Nieuwe tank, nieuwe kans. Wees ditmaal voorzichtig."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Hoofdkwartierofficier: Onze reserves raken op. Zorg dat je hier goed gebruik van maakt, commandant."

