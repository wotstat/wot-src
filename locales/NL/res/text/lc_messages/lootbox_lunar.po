msgstr "VLAMMENDE SCHATTEN"

msgid "common/getButton/lowerCase"
msgstr "Pak Schatten"

msgid "common/getButton/upperCase"
msgstr "PAK SCHATTEN"

msgid "common/loader"
msgstr "Vlammende Schatten openen..."

msgid "common/statistics/emptyHeader"
msgstr "Open Schatten om statistieken te bekijken."

msgid "common/statistics/header"
msgstr "Vlammende Schatten geopend: %(count)"

msgid "confirmResetLootBoxStatistics/description"
msgstr "Alle informatie over geopende Vlammende Schatten zal worden verwijderd."

msgid "entryPoint/boxes"
msgstr "NAAR SCHATTEN"

msgid "entryPoint/tooltip/description"
msgstr "Dit zijn speciale kisten met nieuwe en unieke items, waaronder Premium voertuigen en 2D-stijlen. Je kunt ze in de in-game winkel verkrijgen."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Wegens technische redenen kunnen er momenteel geen Vlammende Schatten worden geopend of gekocht. Onze excuses voor het tijdelijke ongemak."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Vlammende Schatten tijdelijk onbeschikbaar"

msgid "eventName/lowerCase"
msgstr "MAANPREMIE"

msgid "eventName/upperCase"
msgstr "MAANPREMIE"

msgid "guaranteedTitle/nextBox"
msgstr "Gegarandeerde beloning in de volgende Schat!"

msgid "guaranteedTitle/text"
msgstr "Maximum aantal Vlammende Schatten tot een gegarandeerde beloning: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Als je de Vlammende Schatten niet voor het einde van het evenement opent, zullen ze automatisch worden geopend."

msgid "infoPage/footer/description/compensation"
msgstr "Als je alle voertuigen uit de lijst met mogelijke inhoud van de Vlammende Schatten al hebt, dan zul je in plaats van alle voertuigen die daarna in Vlammende Schatten zitten, hun volledige waarde in goud ontvangen."

msgid "infoPage/footer/description/guaranteed"
msgstr "Elke %(guaranteed0)s Vlammende Schatten bevatten gegarandeerd een niveau VIII–IX voertuig. Als je ze hebt geopend zonder een dergelijk voertuig te ontvangen, dan bevat de %(guaranteed0)s&zwnbsp;e Vlammende Schat een niveau VIII–IX voertuig dat je nog niet hebt. Wanneer dat gebeurt, wordt de teller gereset."

msgid "infoPage/header/description"
msgstr "Open Vlammende Schatten om kans te maken op waardevolle in-game items! Kijk hieronder voor meer informatie."

msgid "multipleRewardView/header/subTitle/"
msgstr "Uit de %(name) (%(boxesCount) Vlammende Schatten geopend)"

msgid "noBoxesView/description/"
msgstr "Je hebt geen Vlammende Schatten.\nJe kunt ze in de in-game winkel kopen."

msgid "preview/backLabel"
msgstr "NAAR SCHATTEN"

msgid "quantityTitle/boxesAvailable"
msgstr "Schatten beschikbaar: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "Geen Schatten beschikbaar"

msgid "singleRewardView/tooltip/description/"
msgstr "Als je alle voertuigen uit de lijst met mogelijke inhoud van de Vlammende Schatten al hebt, dan zul je in plaats van alle voertuigen die daarna in Vlammende Schatten zitten goud ontvangen."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) Vlammende Schat"
msgstr[1] "%(remainingCount) Vlammende Schatten"
msgstr[2] "%(remainingCount) Vlammende Schatten"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "De gegarandeerde beloning is een voertuig uit de lijst met mogelijke inhoud van de Vlammende Schat.\nAls je er %(remainingCount) opent zonder een dergelijk voertuig te ontvangen, dan zal de %(count)e Vlammende Schat het voertuig bevatten. Als dat gebeurt, wordt de teller gereset."
