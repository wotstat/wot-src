msgid "Contact/status/inBattle/halloween"
msgstr "In een 'Babylon: Duistere Toren' gevecht"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Vuurt een schot af dat het doelwit en alle vijandelijke voertuigen binnen een straal van 35 m beschadigt en verdooft."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Vuurt een schot af dat levenspunten herstelt door ze te stelen van het doelwit en vijandelijke voertuigen binnen een straal van 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Vuurt een schot af dat het doelwit en alle vijandelijke voertuigen binnen een straal van 35 m verdooft."

msgid "advanced/hw_damageShield"
msgstr "Biedt 7 seconden lang bescherming tegen alle soorten schade (m.u.v. rammen, botsen en verdrinken)."

msgid "advanced/hw_fastReload"
msgstr "Verhoogt de vuursnelheid / herlaadt het magazijn."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Herstelt levenspunten, blust branden, verwijdert verdovingen en repareert beschadigde modules."

msgid "advanced/hw_invisibility"
msgstr "Maakt je voertuig tijdelijk onzichtbaar voor vijanden, herstelt levenspunten, repareert modules, blust branden, verwijdert verdovingen en geneest alle gewonde bemanningsleden."

msgid "advanced/hw_teamRepairKit"
msgstr "Repareert beschadigde modules, blust branden, verwijdert verdovingen en herstelt een deel van de levenspunten van geallieerde voertuigen binnen zijn straal."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Gevechtsbekwaamheden helpen je om in 'Babylon: Duistere Toren' gevechten effectiever te zijn, doelstellingen te bereiken en waardevolle beloningen te verdienen. Rust ze uit door op een van de plekken voor gevechtsbekwaamheden te klikken."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Gevechtsbekwaamheidsplekken"

msgid "hwShell/alt/description"
msgstr "Tijdens een gevecht heb je na het vernietigen van een vijand een bepaalde kans om een %(bold)s te vinden."

msgid "hwShell/alt/description/bold"
msgstr "alternatieve granaat"
