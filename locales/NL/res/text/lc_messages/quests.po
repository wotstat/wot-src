msgid "action/full/shell/creditsPriceMultiplier"
msgstr "Koop granaten tegen een korting van %(discount)s door gebruik te maken van credits. Koop alvast munitie tegen een korting om grondstoffen te besparen."

msgid "action/full/shell/goldPriceMultiplier"
