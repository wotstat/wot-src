msgid "boxTooltip/description/text/bronze"
msgstr "Bij het openen kunnen deze kisten je niveau VIII Premium voertuigen, in-game valuta en andere waardevolle dingen opleveren."

msgid "boxTooltip/description/text/gold"
msgstr "Bij het openen kunnen deze kisten je zeldzame niveau X voertuigen, in-game valuta en andere waardevolle dingen opleveren."

msgid "boxTooltip/description/text/silver"
msgstr "Bij het openen kunnen deze kisten je niveau IX Premium voertuigen, in-game valuta en andere waardevolle dingen opleveren."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Kan worden ontvangen als geschenk voor het kopen van items in de Premiumwinkel of wanneer een ander soort kist wordt geopend."

msgid "boxTooltip/howGet/text/gold"
msgstr "Kan worden ontvangen wanneer een ander soort kist wordt geopend."

msgid "boxTooltip/howGet/text/silver"
msgstr "Kan worden ontvangen wanneer een ander soort kist wordt geopend."

msgid "common/boxCategory/lowerCase/bronze"
msgstr "Hemelse lootbox"

msgid "common/boxCategory/lowerCase/gold"
msgstr "Gekozen lootbox"

msgid "common/boxCategory/lowerCase/silver"
msgstr "Hemelhulp lootbox"

msgid "common/boxCategory/upperCase/bronze"
msgstr "HEMELSE LOOTBOX"

msgid "common/boxCategory/upperCase/gold"
msgstr "GEKOZEN LOOTBOX"

