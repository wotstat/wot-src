msgid "november22_descr"
msgstr "Een unieke medaille die bij Prime Gaming zit."

msgid "occupyingForce"
msgstr "Meester aanvaller"

msgid "occupyingForce_condition"
msgstr "• Kan alleen in Frontlinie worden verkregen."

msgid "occupyingForce_descr"
msgstr "Verdien als aanvaller in totaal 100 basisveroveringspunten of vernietig een vijandelijk hoofddoel."

msgid "october19"
msgstr "Altijd bewust"

msgid "october19_descr"
msgstr "Een unieke medaille, uitgereikt tijdens het speciale evenement."

msgid "october20"
msgstr "Queen Maeve"

msgid "october20_descr"
msgstr "Een unieke medaille die bij Prime Gaming zit."

