msgid "comp7/deserter/cancel"
msgstr "Annuleren"

msgid "comp7/deserter/message"
msgstr "Dit gevecht is nog niet afgelopen. Als je het gevecht verlaat voordat het is afgelopen, laat je je team in de steek.\n{brown_open}Je beoordeling wordt verlaagd en je kunt in deze modus geen gevechten meer spelen. {brown_close}\nWeet je zeker dat je het gevecht wilt verlaten?"

msgid "comp7/deserter/msgTitle"
msgstr "Je zult je rangpunten verliezen!"

msgid "comp7/deserter/submit"
msgstr "Deserteren"

msgid "comp7/deserter/title"
msgstr "Desertie van het slagveld"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Je hebt de spelregels overtreden op de {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}-kaart om {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nEr zijn {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} rangpunten in mindering gebracht en je mag tijdelijk geen gevechten spelen in de {whiteSpanish_Open}Bestorming{whiteSpanish_Close}-modus."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Je hebt de spelregels overtreden op de {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}-kaart om {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nJe mag tijdelijk geen gevechten spelen in de {whiteSpanish_Open}Bestorming{whiteSpanish_Close}-modus en je rating is verminderd."
