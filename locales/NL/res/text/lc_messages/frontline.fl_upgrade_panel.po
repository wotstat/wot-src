msgid "alert"
msgstr "Tijdens actieve strijd kun je geen gevechtsreserve kiezen."

msgid "description/one/reserve"
msgstr "Het herhaaldelijk kiezen van de %(reserve_name)s reserve\nzal zijn eigenschappen verbeteren."

msgid "description/second/reserve"
msgstr "Het herhaaldelijk kiezen van de %(first_reserve_name)s of %(second_reserve_name)s reserve\nzal de eigenschappen van de geselecteerde reserve verbeteren."

msgid "number_1"
msgstr "1ste"

msgid "number_2"
msgstr "2de"

msgid "number_3"
msgstr "3de"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Legt voor een bepaalde tijdsduur een actief mijnenveld in het geselecteerde gebied."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Veroorzaakt binnen een kleine straal veel schade aan vijandelijke voertuigen."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Verdooft vijandelijke voertuigen en veroorzaakt een middelmatige hoeveelheid schade binnen een grote straal."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Voegt een bonus toe aan de hoofdkwalificatie van de bemanning van de speler en de bemanningen van geallieerden."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Levert een bonus aan de veroveringssnelheid, veroveringsblokkering en herbevoorrading."

msgid "shortDescription/reserve/reconAbility"
msgstr "Verkent vijandelijke vliegtuigen en mijnenvelden."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Herstelt een bepaald percentage van de levenspunten van je voertuig."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Verbergt alle voertuigen in en achter de rook."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Levert een bonus aan verborgenheid en zichtbereik. Vermindert de verborgenheid van vijandelijke voertuigen."

msgid "title"
msgstr "De %(number_name)s reserveplek is beschikbaar"
