msgid "Maus_IGR"
msgstr "Maus"

msgid "Maus_IGR_descr"
msgstr "Ontwikkeld van juni 1942 tot in juli 1944, met twee prototypes geproduceerd, waarvan maar één een koepel en bewapening kreeg."

msgid "Maus_IGR_short"
