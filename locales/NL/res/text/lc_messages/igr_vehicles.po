msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Deze experimentele tank was een verdere ontwikkeling van de AMX 13. De tank werd getest, maar werd nooit in massaproductie of in dienst genomen. Twee voertuigen werden geproduceerd."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

