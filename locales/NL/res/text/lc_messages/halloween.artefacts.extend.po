msgstr "Repareert meteen modules, blust branden, verwijdert verdovingen en herstelt een deel van de levenspunten van geallieerde voertuigen binnen zijn straal."

msgid "teamRepairKit/restriction"
msgstr "?empty?"

msgid "teamRepairKit/short_special"
msgstr "Repareert en herstelt levenspunten van geallieerde voertuigen binnen zijn straal."
