msgstr "Todas as informações dos módulos abertos serão excluídas."

msgid "entryPoint/boxes"
msgstr "ACESSAR MÓDULOS"

msgid "entryPoint/tooltip/description"
msgstr "Estes são módulos especiais que incluem itens novos e únicos como veículos Premium, elementos de customização, economias do jogo e outras recompensas valiosas.\nOs módulos podem ser obtidos através da Loja do jogo ou da Loja Premium."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Os Módulos não podem ser abertos ou comprados no momento por motivos técnicos. Pedimos desculpas pelo inconveniente temporário."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Módulos Temporariamente Indisponíveis"

