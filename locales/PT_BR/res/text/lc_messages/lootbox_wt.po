msgstr "Módulos máximos antes de uma Recompensa Garantida: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Os Módulos fechados serão abertos automaticamente no fim do evento."

msgid "infoPage/footer/description/compensation"
msgstr "Se você já possui todos os veículos da lista de possíveis conteúdos do módulo, todos os veículos subsequentes que você receber dos módulos serão compensados em ouro."

msgid "infoPage/footer/description/guaranteed"
msgstr "A cada %(guaranteed0)s módulos, você vai receber um veículo Premium. Se abrir todos eles sem que um veículo seja dropado, um veículo Premium que você ainda não possui será garantido no %(guaranteed0)s° módulo. Sempre que um veículo for dropado, o contador é reiniciado."

msgid "infoPage/header/description"
