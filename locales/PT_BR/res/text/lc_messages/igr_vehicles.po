msgid "Maus_IGR"
msgstr "Maus"

msgid "Maus_IGR_descr"
msgstr "Desenvolvido de junho de 1942 até julho de 1944, tendo dois protótipos produzidos, dos quais somente um recebeu torre e armamentos."

msgid "Maus_IGR_short"
msgstr "Maus"

