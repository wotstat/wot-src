msgid "battleship/name"
msgstr "Sinal de Fumaça"

msgid "battleship/shortDescr"
msgstr "Um sinal de fumaça que marca a área para um salvo de artilharia de encouraçado, causando danos a equipamentos e objetos inimigos localizados ali."

msgid "distraction_ability/name"
msgstr "Ordem Falsa"

msgid "distraction_ability/shortDescr"
msgstr "Faça Gefr. Keller usar o rádio alemão capturado para transmitir uma ordem falsa, direcionando os inimigos a investigar um local específico."

msgid "recon_ability/name"
msgstr "Faça o Reconhecimento"

msgid "recon_ability/shortDescr"
msgstr "Envie Capt. Dubois para fazer o reconhecimento de um local específico. Durante o reconhecimento, o tanque vai parar e permanecer estacionário. A habilidade continua operacional até que seja cancelada."

msgid "scc_airstrike_ability/name"
msgstr "Suporte Aéreo"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Chama um ataque aéreo a uma posição específica."
