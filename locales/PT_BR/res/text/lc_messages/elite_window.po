msgid "elite_window/buttons/ok"
msgstr "Afirmativo!"

msgid "elite_window/buttons/post_progression"
msgstr "Para a Modificação"

msgid "elite_window/buttons/vanity_progression"
msgstr "Acessar Recompensas Elite"

msgid "elite_window/elite/description"
msgstr "O status Elite é concedido a veículos que possuem todos os módulos, melhorias e ramificações técnicas pesquisados, incluindo o(s) veículo(s) do nível seguinte. A XP de Combate obtida em veículos Elite pode ser convertida em XP Livre usando ouro ou utilizada para acelerar o treinamento da tripulação."

msgid "elite_window/elite/title"
msgstr "Status Elite"

msgid "elite_window/post_progression/description"
msgstr "A Modificação de Campo está disponível"

msgid "elite_window/prestige/description"
msgstr "Após receber o Status Elite, o veículo passa a ganhar Pontos Elite e a receber Níveis Elite que representam sua dedicação a um veículo específico. Uma divisa correspondente é exibida na batalha após você receber o primeiro Nível Elite."

msgid "elite_window/prestige/title"
msgstr "Sistema Elite"

msgid "elite_window/title"
msgstr "STATUS ELITE ADQUIRIDO"

msgid "elite_window/vanity_progression/description"
msgstr "Receba recompensas exclusivas para veículos de Nível XI incluindo um estilo único volumétrico, um Rastreador de Estatísticas e uma luva do canhão."

msgid "elite_window/vanity_progression/title"
msgstr "O sistema de Recompensas Elite está disponível."
