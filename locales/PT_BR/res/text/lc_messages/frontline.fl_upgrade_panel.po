msgid "alert"
msgstr "Você não pode escolher uma Reserva de Combate durante o meio de um conflito."

msgid "description/one/reserve"
msgstr "Escolher repetidamente a Reserva \"%(reserve_name)s\"\n irá melhorar as características dela."

msgid "description/second/reserve"
msgstr "Escolher repetidamente \"%(first_reserve_name)s\" ou a Reserva \"%(second_reserve_name)s\"\nirá melhorar as características da selecionada."

msgid "number_1"
msgstr "1°"

msgid "number_2"
msgstr "2°"

msgid "number_3"
msgstr "3°"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Lança um campo minado ativo na área selecionada por um determinado período de tempo."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Provoca um dano considerável à veículos inimigos dentro de um pequeno raio."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Atordoa veículos inimigos e provoca um dano médio em uma grande área."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Adiciona um bônus à qualificação principal da tripulação do jogador e das tripulações aliadas."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Oferece um bônus para a velocidade de captura, bloqueio de captura e reabastecimento."

msgid "shortDescription/reserve/reconAbility"
msgstr "Detecta veículos inimigos e campos minados."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restaura uma certa porcentagem dos pontos de vida do seu veículo."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Camufla todos os veículos dentro e atrás da fumaça."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Fornece um bônus para a ocultação e para o alcance de visão. Reduz a ocultação de veículos inimigos."

msgid "title"
msgstr "A %(number_name)s Vaga da Reserva Está Disponível"
