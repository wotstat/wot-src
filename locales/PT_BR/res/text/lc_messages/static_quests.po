msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Comece uma Batalha Aleatória em um veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Que bom que veio jogar com a gente! Batalhe com outros jogadores do mundo e comemore vitórias espetaculares!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Primeira Batalha"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Pesquise e compre qualquer veículo de Nível IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Comprar um veículo novo é motivo de felicidade. A cada novo nível, novos desafios. Uma tripulação bem treinada também faz a diferença."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Veículo de Nível IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Jogue três Batalhas Aleatórias em veículos de Nível IV–X com qualquer elemento de customização aplicado."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Personalize seus veículos decorando seu exterior com estilos predefinidos ou criando seu próprio estilo usando camuflagem, inscrições, emblemas e decalques."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Exterior dos Veículos"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Inicie o treinamento em qualquer habilidade de qualquer tripulante."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Os tripulantes podem treinar habilidades adicionais para aumentar sua eficácia ou obter novos recursos."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Habilidades da Tripulação"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Ganhe 150.000 créditos em Batalhas Aleatórias com veículos de Nível IV–X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Quanto maior for o nível da batalha, mais créditos você vai precisar para manter o seu veículo, reabastecer munição, além de comprar módulos e equipamento."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Juntando Créditos"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Pesquise e compre qualquer veículo de Nível V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "O Nível V é onde os veículos mais sérios começam a aparecer e você vai ter que dar o seu melhor. Uma tripulação completamente treinada será fundamental."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Veículo de Nível V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos de Nível V–X com 3 equipamentos montados."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Lentes Revestidas ou Ventilação Aperfeiçoada? O equipamento correto pode impulsionar os pontos fortes e reduzir os pontos fracos do seu veículo."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montando Equipamento"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Complete um cenário básico no modo Topografia."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "É sempre importante conhecer os caminhos, táticas, e posições chaves nos mapas para ganhar confiança no campo de batalha."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografia"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Complete quatro cenários avançados em um mapa no Topografia."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Entre no modo Topografia de vez em quando para estudar mapas para Batalhas Aleatórias. Os quatro cenários permitem explorar o local de diferentes ângulos."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Topografia Avançada"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos de Nível V–X com uma Reserva Pessoal ativada."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Quando ativadas você pode ganhar bônus adicionais na XP de Combate, XP Livre e XP de Tripulação, ou créditos após cada batalha."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Reservas Pessoais"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Fique entre os 10 melhores jogadores da sua equipe por XP recebida seis vezes em Batalhas Aleatórias com veículos de Nível V-X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Essas missões permitem que você ganhe cinco vezes mais XP por batalha vencida ficando entre os 10 melhores jogadores da sua equipe por XP recebida."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 Missões de x5 XP"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Pesquise e monte um módulo em um veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "A XP de Combate é recebida após cada batalha. Use XP para pesquisar novos módulos que melhoram a eficiência do seu veículo."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "XP de Combate"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Pesquise e compre qualquer veículo de Nível VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Cada nível subsequente exige mais tempo e esforço. A XP Livre vai ajudar você a progredir mais rápido e treinar sua tripulação com mais facilidade."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Veículo de Nível VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Complete uma Missão Pessoal em qualquer campanha."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "As Campanhas são missões em cadeia para diferentes veículos. Você ganha recompensas e veículos exclusivos quando completa as Campanhas."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Missões Pessoais"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Treine uma tripulação com um Manual Universal."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Os Livros da Tripulação aceleram muito o treinamento da tripulação, pois adicionam uma certa quantidade de XP para um ou todos os tripulantes."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Livros da Tripulação"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos de Nível VI-X equipados com uma diretiva de tripulação."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "As Diretivas podem melhorar as habilidades da tripulação em uma batalha. Assim como os consumíveis, elas podem ser compradas ou recebidas como uma recompensa."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Diretivas da Tripulação"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Compre um \"Pacote Novato\" na Loja do jogo."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Você pode comprar tudo o que precisa na Loja do jogo, incluindo ouro, veículos Premium, entre outros itens. Você vai encontrar promoções regulares que oferecem ótimas ofertas."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Loja"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos Premium de Nível VI–X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Estes veículos não precisam ser pesquisados. Eles ganham mais XP de Combate, XP de Tripulação e créditos, além de transferir tripulantes sem precisar de retreinamento."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Veículos Premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos de Nível VI–X com uma diretiva ou equipamento."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "As diretivas aumentam a eficácia do equipamento montado. Elas podem ser compradas ou recebidas como recompensa, assim como os consumíveis."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Diretivas para equipamento"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Fique entre os 10 melhores jogadores da sua equipe por XP recebida 15 vezes jogando Batalhas Aleatórias em veículos de Nível VI-X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Essas missões permitem que você ganhe cinco vezes mais XP por batalha vencida ficando entre os 10 melhores jogadores da sua equipe por XP recebida."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 Missões de x5 XP"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Pesquise e compre qualquer veículo de Nível VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Os requisitos de habilidade aumentam ainda mais para este nível de veículo. Os veículos se tornam mais formidáveis e mais eficientes, assim como seus oponentes."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Veículo de Nível VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Jogue 10 Batalhas Aleatórias em veículos de Nível VII–X com um Kit Grande de Primeiros-Socorros, Kit Grande de Consertos e um Extintor de Incêndio Automático."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Quando equipados, os consumíveis grandes consertam módulos danificados mais rápido do que os pequenos. Eles também reduzem a duração do atordoamento e chance de incêndio, além de ter um período mais curto de recarga."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Consumíveis Grandes"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Receba o dobro de XP na sua primeira vitória do dia nas Batalhas Aleatórias usando um veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Você recebe o dobro de XP na sua primeira vitória do dia em cada veículo. Use esse recurso para melhorar seus veículos ainda mais rápido."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Multiplicador de XP"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Crie um fragmento de projeto para qualquer veículo não pesquisado."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Os projetos fornecem um desconto de XP e aceleram a pesquisa de um veículo, sendo recebidos como recompensa ou convertidos de fragmentos universais e nacionais."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Projetos de Veículos"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Fique entre os 10 melhores jogadores da sua equipe por XP recebida 20 vezes jogando Batalhas Aleatórias em veículos de Nível VII-X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Essas missões permitem que você ganhe cinco vezes mais XP por batalha vencida ficando entre os 10 melhores jogadores da sua equipe por XP recebida."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 Missões de x5 XP"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Pesquise e compre qualquer veículo de Nível VIII"

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Os veículos de Nível VIII exigem que você use todo o seu conhecimento adquirido. As batalhas vão ser mais disputadas e cheias de adrenalina."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Veículo de Nível VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Use XP Livre para pesquisar qualquer módulo."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Se você não tem XP de Combate suficiente para pesquisar um módulo ou veículo, a XP Livre pode ser usada e recebida em qualquer veículo."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "XP Livre"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Equipe projéteis alternativos e comece uma Batalha Aleatória em veículos de Nível III–X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "AP, HE e APCR são projéteis com usos diferentes em combate. Saber escolher bem é a chave da vitória."

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munição"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Venda um módulo não utilizado do Depósito."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Módulos, projéteis, equipamentos, consumíveis e outros itens não utilizados são guardados no Depósito. Você pode vender itens sobressalentes por créditos."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depósito"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Ganhe 25,000 créditos em Batalhas Aleatórias em veículos de Nível III–X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Os créditos são usados para comprar projéteis e novos veículos, para reparar veículos, entre outras funções. É importante saber como economizá-lo e usá-lo."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Créditos"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Jogue três Batalhas Aleatórias em veículos de Nível III–X com consumíveis montados em todas as vagas disponíveis."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Os consumíveis podem reparar danos críticos do veículo e curar ferimentos da tripulação em batalha. Usar os consumíveis na hora certa é crucial."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Consumíveis"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Jogue três Batalhas Aleatórias em veículos de Nível III–X com qualquer equipamento montado."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Os veículos podem ser configurados com equipamento para aprimorar suas características. A seleção dos equipamentos depende do veículo e da jogabilidade dele."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Equipamento"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Complete um cenário em qualquer mapa no Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terreno Desconhecido"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Complete quatro cenários básicos em um mapa no Topografia"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Reconhecimento"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Complete quatro cenários avançados em um mapa no Topografia."

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Nota 10 em Geografia"
