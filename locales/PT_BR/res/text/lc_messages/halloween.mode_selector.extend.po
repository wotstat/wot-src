msgid "mode/halloween/battlePassTooltip/body"
msgstr "Algumas missões do evento {whiteSpanish_open}Babilônia: Torre Negra{whiteSpanish_close} fornece Pontos do Passe de Batalha."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Pontos do Passe de Batalha"

msgid "mode/halloween/calendar"
msgstr "O evento vai durar por %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "O evento vai terminar em %(date)s."

msgid "mode/halloween/description"
msgstr "Jogue e colete Matéria.\nBatalhas em veículos especiais."

msgid "mode/halloween/performance/highRisk/description"
msgstr "O desempenho do seu computador é insuficiente para este modo. Você pode ter problemas com gráficos e movimentação do veículo. Travamentos do jogo também são prováveis."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Desempenho Baixo"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Desempenho Baixo"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Este modo requer alto desempenho do computador.\nVocê vai ter problemas com o carregamento de mapas, gráficos e movimentação do veículo. Em caso de desempenho insuficiente, tente uma qualidade gráfica mais baixa nas Configurações."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Desempenho Reduzido"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Desempenho Reduzido"
