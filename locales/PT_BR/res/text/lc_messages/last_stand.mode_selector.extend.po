msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Você pode ganhar Pontos do Passe de Batalha no modo {whiteSpanish_open}Última Defesa{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Pontos do Passe de Batalha"

msgid "mode/last_stand/calendar"
msgstr "O evento vai durar por %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "O evento vai terminar em %(date)s."

msgid "mode/last_stand/description"
msgstr "Lute contrar as ondas de inimigos.\nBatalhas em veículos de Nível VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "O desempenho do seu computador é insuficiente para este modo. Você pode ter problemas com gráficos e movimentação do veículo. Travamentos do jogo também são prováveis."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Desempenho Baixo"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Desempenho Baixo"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Este modo requer alto desempenho do computador.\nVocê vai ter problemas com o carregamento de mapas, gráficos e movimentação do veículo. Em caso de desempenho insuficiente, tente uma qualidade gráfica mais baixa nas Configurações."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Desempenho Reduzido"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Desempenho Reduzido"
