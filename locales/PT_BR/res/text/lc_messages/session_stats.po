msgid "propertyInfo/prop/descr/averageDamage"
msgstr "A razão entre o dano total provocado e o número de batalhas combatidas na sessão. Delta mostra o efeito da sessão de jogo atual no parâmetro total."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Proporção de veículos inimigos destruídos por batalhas disputadas."

