msgid "R20_T-44_LS_PLAYER"
msgstr "T-44"

msgid "R20_T-44_LS_PLAYER_descr"
msgstr "Uma amostra de referência do veículo designado T-44A. Desenvolvido pelo Gabinete de Construção da Fábrica Nº 183. O veículo entrou em serviço em 23 de Novembro de 1944, mas nunca entrou em combate. Desde o final de Novembro de 1944 até Setembro de 1945, um total de 570 veículos foram produzidos."

msgid "R40_T-54_LS_BOT"
msgstr "Malaquita Corrompida"

msgid "R40_T-54_LS_BOT_descr"
