msgid "R40_T-54_LS_BOT_short"
msgstr "Corrompida"

msgid "R77_KV2_Mosquito_LS_BOT"
msgstr "Mosquito"

msgid "R77_KV2_Mosquito_LS_BOT_descr"
msgstr "Um tanque de assalto pesado. Desenvolvido no chassi do KV-1 em Janeiro de 1940, totalizando 334 veículos produzidos de 1940 a 1941. O KV-2 foi utilizado em ações em 1941, sendo a maioria dos veículos perdidos neste mesmo ano."

