msgid "Contact/status/inBattle/last_stand"
msgstr "Em uma batalha do Última Defesa"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Um disparo que causa dano ao alvo e a todos os veículos inimigos em um raio de 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Um disparo que restaura pontos de vida roubados do alvo e de todos os veículos inimigos em um raio de 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Um disparo que atordoa o alvo e todos os veículos inimigos em um raio de 35 m."

msgid "advanced/ls_damageShield"
msgstr "Protege contra qualquer dano (exceto impacto, afogamento e queda) por 10 segundos."

msgid "advanced/ls_doubleDamage"
msgstr "Seu próximo disparo bem sucedido provoca o dobro de dano."

msgid "advanced/ls_equipment"
msgstr "Os Dispositivos Táticos ajudam você durante as batalhas do Última Defesa, seja para completar os Estágios ou ganhar recompensas valiosas. Para equipa-los, clique em uma das vagas dos Dispositivos Táticos."

msgid "advanced/ls_extraDamageSituational"
msgstr "Fornece a chance de provocar mais dano a um veículo inimigo."

msgid "advanced/ls_fastReload"
msgstr "Aumenta a taxa de disparo / recarga do carregador."

msgid "advanced/ls_healSituational"
msgstr "Restaura alguns pontos de vida após destruir um veículo inimigo."

msgid "advanced/ls_invisibility"
msgstr "Impede temporariamente que os inimigos mirem no seu veículo, restaura pontos de vida, repara módulos, apaga incêndios, remove o efeito de atordoamento e cura todos os tripulantes feridos."

msgid "advanced/ls_nitro"
msgstr "Aumenta a mobilidade do seu veículo temporariamente."

msgid "advanced/ls_nitroSituational"
msgstr "Aumenta temporariamente a mobilidade do seu veículo após receber dano de um veículo inimigo."

msgid "advanced/ls_selfRepairKit"
msgstr "Restaura os pontos de vida, apaga incêndios, remove atordoamento e repara módulos danificados."

msgid "advanced/ls_teamRepairKit"
msgstr "Repara módulos danificados, apaga incêndios, remove atordoamento e restaura parte dos pontos de vida de veículos aliados dentro do raio de efeito."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Os Dispositivos Táticos podem ser equipados em vagas especiais para progredir de forma mais eficaz nas batalhas do Última Defesa, completar Estágios e ganhar recompensas valiosas."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Vagas dos Dispositivos Táticos"
