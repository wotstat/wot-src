msgid "Churchill_LL_descr"
msgstr "Tanque Britânico fornecido à USSR pelo programa Lend-Lease. A USSR recebeu um total de 301 veículos, com alguns deles sendo perdidos durante o transporte até Murmansk."

msgid "Churchill_LL_long_special"
