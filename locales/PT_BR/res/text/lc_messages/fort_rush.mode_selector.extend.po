msgid "mode/fort_rush_battle/condition"
msgstr "7x7 %(parSecondary_open)sI%(parSecondary_close)s Nível&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Assuma o controle das antenas. Mantenha a rede. Garanta a transmissão."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "O desempenho do seu computador é insuficiente para este modo. Você pode ter problemas com gráficos e movimentação do veículo. Travamentos do jogo também são prováveis."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Desempenho Baixo"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Desempenho Baixo"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Esse modo exige um computador com alta performance. Você vai presenciar problemas com carregamento de mapas, gráficos e movimentação dos veículos. Se não tiver potência o suficiente, tente baixar a qualidade gráfica nas Configurações."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Desempenho Reduzido"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Desempenho Reduzido"
