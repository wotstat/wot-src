msgid "br_respawn/name"
msgstr "Respawn"

msgid "br_respawn/platoon/descr"
msgstr "Permite que você volte para a batalha após seu veículo ser destruído. Esta mecânica funciona dentro do primeiro %(duration)sminuto da batalha.\n\nPara dar respawn em um aliado, é preciso ficar fora de qualquer conflito durante %(timeToResurrect)s s. As cargas de respawn são compartilhadas entre os membros do Pelotão."

msgid "br_respawn/solo/descr"
msgstr "Permite que você volte para a batalha após seu veículo ser destruído. Esta mecânica funciona dentro do primeiro %(duration)sminuto da batalha.\n\nAssim que for destruído, seu veículo dá respawn automaticamente."

msgid "br_smoke/battleDescr"
msgstr "Adiciona um bônus de ocultação de %(duration)s segundos a todos os veículos dentro do alcance do consumível."

msgid "br_smoke/descr"
msgstr "Adiciona um bônus de ocultação a todos os veículos dentro do alcance do consumível."

