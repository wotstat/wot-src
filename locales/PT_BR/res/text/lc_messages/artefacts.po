msgid "br_bomber/battleDescr"
msgstr "Atordoa e provoca %(minDamage)s até %(maxDamage)s de dano em veículos inimigos. Os veículos no centro da área de impacto levam danos mais severos.\n\n*Existe um delay de %(delay)s s antes do impacto."

msgid "br_bomber/descr"
msgstr "Atordoa e provoca %(minDamage)s até %(maxDamage)s de dano em veículos inimigos. Os veículos no centro da área de impacto levam danos mais severos.\n\n*Existe um delay de %(delay)s s antes do impacto."

