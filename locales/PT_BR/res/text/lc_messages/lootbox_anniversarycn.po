msgid "boxTooltip/description/text/bronze"
msgstr "Quando abertas, as caixas podem conter veículos Premium de Nível VIII, economia do jogo e outras recompensas valiosas."

msgid "boxTooltip/description/text/gold"
msgstr "Quando abertas, as caixas podem conter veículos Premium de Nível X, economia do jogo e outras recompensas valiosas."

msgid "boxTooltip/description/text/silver"
msgstr "Quando abertas, as caixas podem conter veículos Premium de Nível IX, economia do jogo e outras recompensas valiosas."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Pode ser recebido como um presente ao comprar itens na Loja Premium ou na abertura de qualquer tipo de caixa."

msgid "boxTooltip/howGet/text/gold"
msgstr "Pode ser recebido ao abrir qualquer tipo de caixa."

msgid "boxTooltip/howGet/text/silver"
msgstr "Pode ser recebido ao abrir qualquer tipo de caixa."

