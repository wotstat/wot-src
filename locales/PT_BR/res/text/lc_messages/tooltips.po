msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
msgstr "A redução da velocidade de ré do veículo enquanto os propulsores estão ativos."

msgid "tank_params/desc/rocketAccelerationEnginePower"
msgstr "Este parâmetro afeta a aceleração do veículo, velocidade máxima, e casco velocidade de avanço."

msgid "tank_params/desc/rocketAccelerationReuseAndDuration"
