msgid "tank_params/desc/secondaryAvgPiercingPower"
msgstr "Espessura média da blindagem penetrada por um projétil padrão auxiliar, ajustada para normalização do projétil. A dispersão é de +/- 25% do valor médio."

msgid "tank_params/desc/secondaryReloadTimeSecs"
msgstr "Hora de recarregar os canhões auxiliares após o disparo."

msgid "tank_params/desc/secondaryTotalBurstSize"
msgstr "Quantidade de projéteis disponíveis para os canhões auxiliares durante cada ativação."

msgid "tank_params/desc/shellLoadingTime"
msgstr "Tempo requerido para carregar os projéteis no começo da batalha e para trocar entre os diferentes tipos de projéteis."

msgid "tank_params/desc/shotDispersionAngle"
msgstr "A dispersão do canhão é caracterizada pelo desvio máximo do projétil a partir do ponto de mira a uma distância de 100 m."

msgid "tank_params/desc/shotDispersionAngle/twinGun"
msgstr "A dispersão do canhão é caracterizada pelo desvio máximo do projétil a partir do ponto de mira a uma distância de 100 m (modo padrão/especial)."

msgid "tank_params/desc/shotDispersionAngle/withDualAccuracy"
msgstr "Mostra quanto o projétil pode desviar do ponto de mira (em metros) por 100 metros para atingir o alvo. O valor padrão (o primeiro) é para o canhão aquecido, o valor melhorado (o segundo) é para o canhão esfriado."

msgid "tank_params/desc/speedLimits"
msgstr "Velocidade do veículo conforme definida nas suas características técnicas."

msgid "tank_params/desc/stagedJetBoostersChargeDuration"
msgstr "Duração máxima do impulso após a ativação do propulsor."

msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "Quantidade de vezes que os propulsores podem ser usados por batalha."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Tempo de recarga após o uso antes que os propulsores possam ser ativados novamente."

msgid "tank_params/desc/stagedJetBoostersEnginePower"
msgstr "O bônus na aceleração do veículo com os propulsores ativos."

msgid "tank_params/desc/stagedJetBoostersRotationSpeed"
msgstr "O bônus na rotação do casco do veículo com os propulsores ativos."

msgid "tank_params/desc/stagedJetBoostersSpeedLimits"
msgstr "Velocidade do veículo conforme definida nas suas características técnicas."

msgid "tank_params/desc/stagedJetBoostersTopSpeed"
msgstr "O bônus na velocidade máxima do veículo com os propulsores ativos."

msgid "tank_params/desc/stationaryReloadSwitchOffTime"
