msgid "advanced/relativePower"
msgstr "Um conjunto de parâmetros que exibe a eficiência na destruição de veículos inimigos."

msgid "advanced/relativeVisibility"
msgstr "Um conjunto de parâmetros que exibe a distância em que veículos inimigos são detectados e exibidos no minimapa."

msgid "advanced/removedRpmLimiter"
msgstr "Melhora as dinâmicas do veículo, mas danifica o motor gradualmente. Pode ser ativado e desativado manualmente. Comprado uma vez e não desaparece após a batalha."

msgid "advanced/service"
