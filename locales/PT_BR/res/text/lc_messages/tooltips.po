msgid "tank_params/desc/stationaryReloadSwitchOnTime"
msgstr "Tempo para conectar a torre aos compartimentos externos de munição e iniciar o processo de recarga."

msgid "tank_params/desc/stunMaxDuration"
msgstr "Exibe a duração máxima do atordoamento aplicado a tripulação inimiga, caso o Projétil Explosivo tenha penetrado a blindagem do veículo sem equipamentos e consumíveis que reduzam a duração do atordoamento e cause dano máximo."

msgid "tank_params/desc/stunMinDuration"
msgstr "Mostra a duração mínima do atordoamento infligido à tripulação inimiga se o veículo inimigo estiver no raio de dano e não estiver equipado com consumíveis ou equipamentos que diminuam a duração do atordoamento."

msgid "tank_params/desc/switchEngineModeBothModes"
msgstr "Tempo necessário para trocar entre o modo de Combate e modo Turbo."

msgid "tank_params/desc/switchOffTime"
msgstr "O tempo necessário para alternar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para a alteração. A alteração não está disponível quando o motor está destruído."

msgid "tank_params/desc/switchOnTime"
msgstr "O tempo necessário para alternar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para a alteração. A alteração não está disponível quando o motor está destruído."

msgid "tank_params/desc/switchTime"
msgstr "O tempo necessário para alternar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para a alteração. A alteração não está disponível quando o motor está destruído."

msgid "tank_params/desc/temperatureAimingTime"
