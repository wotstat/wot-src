msgstr "Tripulante Único"

msgid "notrecruitedtankman/yha_loader/desc"
msgstr "Ele tem uma personalidade simples e honesta e gosta de todos os tipos de comida. Ele pode ajustar a atmosfera e o humor da equipe facilmente."

msgid "notrecruitedtankman/yha_loader/label"
msgstr "Tripulante Único"

msgid "notrecruitedtankman/yha_radioman/desc"
