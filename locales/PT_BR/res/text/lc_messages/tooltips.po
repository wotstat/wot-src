msgid "battle_royale/hangar/perf/high_risk/header"
msgstr "Desempenho Baixo"

msgid "battle_royale/hangar/perf/medium_risk/description"
msgstr "Esse modo exige um computador com alta performance. Você vai sofrer menos com carregamento de mapas, gráficos e movimentação dos veículos. Se não tiver potência o suficiente, tente baixar a qualidade gráfica nas Configurações."

