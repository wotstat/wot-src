msgid "tank_params/desc/reactivationDelay"
msgstr "Tempo de espera necessário antes que os propulsores possam ser ativados novamente após o uso."

msgid "tank_params/desc/reactivationLimit"
msgstr "O nível máximo de calor que pode ser atingido antes que os propulsores fiquem indisponíveis para reativação."

msgid "tank_params/desc/relativeArmor"
