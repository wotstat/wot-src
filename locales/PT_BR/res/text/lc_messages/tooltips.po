msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "A quantidade de carga da Mira Eletromecânica de Coincidência gerada por segundo no modo de Combate."

msgid "tank_params/desc/piercingPower"
msgstr "Espessura da blindagem que pode ser penetrada por um projétil padrão ajustado pela normalização do projétil."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Velocidade de rotação do casco sobre o seu eixo e velocidade de mudança de direção em movimento (manobrabilidade)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "O tempo necessário para alternar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para a alteração. A alteração não está disponível quando o motor está destruído."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "O tempo necessário para alternar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para a alteração. A alteração não está disponível quando o motor está destruído."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Velocidade de inclinação do casco para cima e para baixo enquanto o veículo está no modo Casamata."

msgid "tank_params/desc/pitchLimits"
