msgid "tank_params/desc/relativeCamouflage"
msgstr "Um conjunto de parâmetros que mostra a eficácia de ocultação quando seu veículo estiver parado, em movimento e atirando. Camuflagem aplicada aumenta o parâmetro de ocultação."

msgid "tank_params/desc/relativeMobility"
msgstr "Um conjunto de parâmetros que mostram a rapidez com que o veículo pode alterar a sua posição no campo de batalha."

msgid "tank_params/desc/relativePower"
msgstr "Um conjunto de parâmetros que mostram a eficácia de destruir veículos inimigos."

msgid "tank_params/desc/relativeVisibility"
msgstr "Um conjunto de parâmetros que mostram a eficácia de detectar veículos inimigos."

msgid "tank_params/desc/reloadTime"
msgstr "Número de projéteis por minuto."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "O bônus concedido para o tempo de recarga do canhão enquanto a mira estiver ativa."

msgid "tank_params/desc/reloadTimeSecs"
