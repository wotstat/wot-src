msgstr "Conjunto Único de Camuflagem"

msgid "personalMissions/awards/camouflageAll/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto). Pode ser aplicado ao veículo recompensado gratuitamente ou comprado para qualquer outro veículo da mesma nação."

msgid "personalMissions/awards/camouflageAll/header"
msgstr "Conjunto Único de Camuflagem"

msgid "personalMissions/awards/camouflageNation/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto). Pode ser comprado para qualquer veículo da mesma nação do veículo recompensado."

