msgid "comp7/deserter/cancel"
msgstr "Cancelar"

msgid "comp7/deserter/message"
msgstr "Essa batalha ainda não acabou. Se você sair da batalha antes que ela termine, estará decepcionando sua equipe.\n{brown_open}Sua classificação será reduzida e você será bloqueado de jogar batalhas nesse modo.{brown_close}\nTem certeza de que quer sair da batalha?"

msgid "comp7/deserter/msgTitle"
msgstr "Você vai perder seus Pontos de Classificação!"

msgid "comp7/deserter/submit"
msgstr "Abandonar"

msgid "comp7/deserter/title"
msgstr "Deserção do Campo de Batalha"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Você violou as Regras do Jogo no {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} mapa em {whiteSpanish_Open}%(time)s{whiteSpanish_Close}\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close}Os Pontos de Classificação foram deduzidos e você sofreu um banimento temporário de batalhas no modo {whiteSpanish_Open}Investida{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Você violou as Regras do Jogo no mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} às {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nVocê foi bloqueado temporariamente das batalhas no modo {whiteSpanish_Open}Investida{whiteSpanish_Close} e os Pontos de Classificação foram reduzidos."
