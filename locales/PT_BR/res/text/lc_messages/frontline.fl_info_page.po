msgstr "Tenente"

msgid "progression/ranksTable/major"
msgstr "Major"

msgid "progression/ranksTable/private"
msgstr "Soldado"

msgid "progression/ranksTable/sergeant"
msgstr "Sargento"

msgid "progression/sectionHeader"
msgstr "Progressão no Linha de Frente"

msgid "progression/text"
msgstr "Ao jogar este modo, você vai aumentar seu rank, avançar na Progressão do Linha de Frente e ganhar recompensas."

