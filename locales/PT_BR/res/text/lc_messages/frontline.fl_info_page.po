msgstr "Auxiliar"

msgid "reserveCategories/config/footerText"
msgstr "No cenário {{@ colorLegacy 'FFE4C0'}}Reviravolta do Destino{{/}}, a ordem em que as Reservas de Combate são desbloqueadas não depende do tipo do veículo."

msgid "reserveCategories/config/header"
msgstr "Configurações das Reservas por Tipo de Veículo"

msgid "reserveCategories/config/text"
msgstr "Nos cenários {{@ colorLegacy 'FFE4C0'}}Batalha Padrão{{/}} e {{@ colorLegacy 'FFE4C0'}}Suporte Operacional{{/}}, todas as três vagas das Reservas de Combate estão disponíveis para todos os tipos de veículos. Entretanto, a ordem em que elas são desbloqueadas depende do tipo do veículo."

msgid "reserveCategories/config/vehicles/destroyer"
msgstr "Caça-Tanques"

msgid "reserveCategories/config/vehicles/heavy"
msgstr "Tanques Pesados"

msgid "reserveCategories/config/vehicles/light"
msgstr "Tanques Leves"

msgid "reserveCategories/config/vehicles/middle"
msgstr "Tanques Médios"

msgid "reserveCategories/config/vehicles/selfPropelled"
msgstr "Artilharias"

msgid "reserveCategories/levelUpNote"
msgstr "* O aprimoramento deste nível está disponível apenas para as Reservas de Combate {{@ colorLegacy 'FFE4C0'}}compradas{{/}} no cenário {{@ colorLegacy 'FFE4C0'}}Reviravolta do Destino{{/}}."

msgid "reserveCategories/levels/header"
msgstr "Como Desbloquear Vagas e Melhorar as Reservas de Combate"

msgid "reserveCategories/levels/text"
msgstr "Uma Reserva de Combate fica disponível para você por padrão. Outras desbloqueiam após alcançar os ranks Sargento e Tenente. Todas as três Reservas vão ser aprimoradas após alcançar os ranks Capitão e Major."

msgid "reserveCategories/progression/tableCell"
msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} ou {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}} Nível"

