msgid "vo_sm_char10_m05_stg28_01"
msgstr "Oficial do QG: Praia limpa. Enviando forças principais. Excelente trabalho."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Oficial do QG: Segure sua posição. Os reforços estão chegando."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Oficial do QG: Proteja a cabeça de praia a todo custo."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Oficial do QG: Outro tanque, outra chance. Tome cuidado dessa vez."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Oficial do QG: Estamos ficando sem reservas. Faça essa valer a pena, comandante."

