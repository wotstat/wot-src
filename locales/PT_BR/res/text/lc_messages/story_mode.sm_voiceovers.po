msgid "vo_sm_char07_m05_stg56_03"
msgstr "Que piadoca engraçada."

msgid "vo_sm_char07_m05_stg56_04"
msgstr "Não temos tempo para piadas."

msgid "vo_sm_char07_m05_stg56_05"
msgstr "Tem graça nenhuma."

msgid "vo_sm_char07_m05_stg56_06"
msgstr "Deixa as piadas para quando ganharmos."

msgid "vo_sm_char07_m05_stg57_01"
msgstr "É assim que se faz!"

msgid "vo_sm_char07_m05_stg57_02"
msgstr "Estou com você."

msgid "vo_sm_char07_m05_stg57_03"
msgstr "Gostei da decisão."

msgid "vo_sm_char07_m05_stg58_01"
msgstr "Não sei se é uma boa ideia."

msgid "vo_sm_char07_m05_stg58_02"
msgstr "Parece arriscado."

msgid "vo_sm_char07_m05_stg59_01"
msgstr "Foca na missão e para de falar."

msgid "vo_sm_char07_m05_stg60_01"
msgstr "Para de usar o rádio pra ficar falando besteira."

