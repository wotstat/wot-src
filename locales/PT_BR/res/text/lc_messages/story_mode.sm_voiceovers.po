msgstr "Área segura!"

msgid "vo_sm_char07_m05_stg54_02"
msgstr "Inimigos neutralizados!"

msgid "vo_sm_char07_m05_stg55_01"
msgstr "Afirmativo!"

msgid "vo_sm_char07_m05_stg55_02"
