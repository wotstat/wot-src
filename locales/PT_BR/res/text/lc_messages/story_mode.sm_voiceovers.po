msgid "vo_sm_char10_m05_stg21_02"
msgstr "Oficial do QG: Cabeça de praia em Eco-5 segura. Tanques avançando. Forneça suporte total de fogo."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Oficial do QG: Redirecione o suporte aéreo para ajudar o avanço dos tanques."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Oficial do QG: Equipes de engenharia, limpe os obstáculos para o avanço."

msgid "vo_sm_char10_m05_stg21_05"
