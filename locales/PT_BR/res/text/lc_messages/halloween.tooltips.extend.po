msgid "Contact/status/inBattle/halloween"
msgstr "Em uma batalha do Babilônia: Torre Negra"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Um disparo que danifica e atordoa o alvo, além de todos os veículos inimigos em um raio de 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Um disparo que restaura pontos de vida roubados do alvo e de todos os veículos inimigos em um raio de 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Um disparo que atordoa o alvo e todos os veículos inimigos em um raio de 35 m."

msgid "advanced/hw_damageShield"
msgstr "Protege contra qualquer dano (exceto impacto, afogamento e queda) por 7 segundos."

msgid "advanced/hw_fastReload"
msgstr "Aumenta a taxa de disparo / recarga do carregador."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Restaura os pontos de vida, apaga incêndios, remove atordoamento e repara módulos danificados."

msgid "advanced/hw_invisibility"
msgstr "Deixa seu veículo temporariamente invisível para os inimigos, restaura pontos de vida, repara módulos, apaga incêndios, remove o efeito de atordoamento e cura todos os tripulantes feridos."

msgid "advanced/hw_teamRepairKit"
msgstr "Repara módulos danificados, apaga incêndios, remove atordoamento e restaura parte dos pontos de vida de veículos aliados dentro do raio de efeito."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "As Habilidades de Combate ajudam você durante as batalhas do Babilônia: Torre Negra para completar Objetivos e ganhar recompensas valiosas. Para equipa-las, clique em uma das vagas das Habilidades de Combate."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Vagas das Habilidades de Combate"

msgid "hwShell/alt/description"
msgstr "%(bold)s pode ser encontrado em batalha com uma certa probabilidade após destruir um inimigo."

msgid "hwShell/alt/description/bold"
msgstr "Um projétil alternativo"
