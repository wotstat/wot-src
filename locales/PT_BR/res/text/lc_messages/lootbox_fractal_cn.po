msgstr "BÊNÇÃO DIVINA"

msgid "guaranteed/tooltip/description1/"
msgstr "Caso já possua todos os veículos, você receberá uma Caixa do Escolhido no lugar deles."

msgid "infoPage/footer/description/compensation"
msgstr "Caso já possua todos os veículos das caixas, você receberá uma Caixa do Escolhido como recompensa ao invés de um veículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "A cada %(guaranteed0)s Caixas Celestiais, %(guaranteed1)s Caixas de Ajuda Celestial ou %(guaranteed2)s Caixas do Escolhido, é garantido dropar um veículo. Um veículo que você não tenha vai dropar na %(guaranteed0)sª / %(guaranteed1)sª / %(guaranteed2)sª (dependendo do tipo da caixa) caso não tenha dropado nenhum veículo. Quando um veículo dropar, o contador é zerado."

msgid "infoPage/footer/title/compensation"
msgstr "Compensação"

msgid "infoPage/footer/title/guaranteed"
msgstr "Recompensa Garantida"

msgid "infoPage/header/rewards/description"
msgstr "Apenas uma recompensa pode dropar por grupo"
