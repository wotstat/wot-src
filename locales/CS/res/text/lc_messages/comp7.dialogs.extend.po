msgid "comp7/deserter/cancel"
msgstr "Zrušit"

msgid "comp7/deserter/message"
msgstr "Tato bitva ještě neskončila. Pokud bitvu opustíte před jejím koncem, zklamete svůj tým.\n{brown_open}Vaše hodnocení bude sníženo a budete zablokováni pro bitvy v tomto režimu.{brown_close}\nJste si jistí, že chcete bitvu opustit?"

msgid "comp7/deserter/msgTitle"
msgstr "Ztratíte své body hodnocení!"

msgid "comp7/deserter/submit"
msgstr "Dezertovat"

msgid "comp7/deserter/title"
msgstr "Dezerce z bojiště"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Na mapě {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} v čase {whiteSpanish_Open}%(time)s{whiteSpanish_Close} jste porušili pravidla hry.\nBylo odečteno {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} bodů hodnocení a dočasně jste byli zablokováni v bitvách režimu {whiteSpanish_Open}„Nápor“{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Na mapě {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} v době {whiteSpanish_Open}%(time)s{whiteSpanish_Close} jste porušili pravidla hry.\nDočasně jste byli zablokováni v bitvách režimu „{whiteSpanish_Open}Nápor{whiteSpanish_Close}“ a bylo sníženo vaše hodnocení."
