msgid "singleRewardView/tooltip/description/"
msgstr "Pokud již vlastníte všechna vozidla ze seznamu možného obsahu truhly, pak všechna následující vozidla, která z truhel získáte, budou kompenzována ve zlaťácích."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) truhla"
msgstr[1] "%(remainingCount) truhly"
msgstr[2] "%(remainingCount) truhel"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Zaručená odměna je vozidlo ze seznamu možného obsahu truhly.\nPokud otevřete %(remainingCount) truhel, aniž by vám takové vozidlo padlo, při otevření %(count). truhly takové vozidlo padne. Když k tomu dojde, počítadlo se vynuluje."
