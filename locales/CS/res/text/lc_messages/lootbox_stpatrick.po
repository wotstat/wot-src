msgstr "Zaručená odměna v další truhle!"

msgid "guaranteedTitle/text"
msgstr "Maximální počet otevřených truhel před získáním zaručené odměny: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Pokud truhly neotevřete před koncem akce, budou otevřeny automaticky."

msgid "infoPage/footer/description/compensation"
msgstr "Pokud již vlastníte všechna vozidla ze seznamu možného obsahu truhly, budou všechna následující vozidla, která z truhel získáte, kompenzována ve zlaťácích v hodnotě jejich plné ceny."

msgid "infoPage/footer/description/guaranteed"
msgstr "Každá %(guaranteed0)s. truhla zaručeně obsahuje vozidlo VIII.–IX. úrovně. Pokud daný počet truhel otevřete, aniž by vám takové vozidlo padlo, pak při otevření %(guaranteed0)s.&zwnbsp;truhly padne vozidlo VIII.–IX. úrovně, které ještě nevlastníte. Až k tomu dojde, počítadlo se vynuluje."

msgid "infoPage/header/description"
msgstr "Otevřete truhlu pro šanci získat cenné herní předměty! Více podrobností níže."

msgid "multipleRewardView/header/subTitle/"
msgstr "Z %(name) (otevřeno %(boxesCount) truhel)"

msgid "noBoxesView/description/"
msgstr "Nemáte žádné truhly.\nMůžete si je pořídit v herním obchodě."

msgid "preview/backLabel"
msgstr "NA TRUHLY"

msgid "quantityTitle/boxesAvailable"
