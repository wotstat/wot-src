msgid "vo_sm_char10_m05_stg04_02"
msgstr "Důstojník velitelství: Tanky uvízly na pláži. Flotilo, poskytněte podporu."

msgid "vo_sm_char10_m05_stg13_06"
msgstr "?empty?"

