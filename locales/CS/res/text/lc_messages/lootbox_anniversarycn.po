msgstr "SVATÁ BEDNA"

msgid "entryPoint/tooltip/description"
msgstr "Jedná se o speciální bedny obsahující nové a jedinečné předměty. Lze je získat v herním obchodě."

msgid "entryPoint/tooltip/timerText"
msgstr "Akce skončí za"

msgid "eventName/lowerCase"
msgstr "Tichá pokladnice"

msgid "eventName/upperCase"
msgstr "TICHÁ POKLADNICE"

msgid "guaranteed/tooltip/description1/"
msgstr "Pokud již vlastníte všechna vozidla, obdržíte místo toho kvalitní bednu."

msgid "infoPage/footer/description/compensation"
msgstr "Pokud již všechna vozidla z bedny vlastníte, obdržíte jako zaručenou odměnu namísto vozidla kvalitní bednu."

msgid "infoPage/footer/description/guaranteed"
msgstr "Každá %(guaranteed0)s. plná bedna, %(guaranteed1)s. kvalitní bedna a %(guaranteed2)s. svatá bedna zásob zaručeně obsahuje vozidlo. Pokud daný počet beden otevřete aniž by vám takové vozidlo padlo, pak při otevření %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. bedny padne v závislosti na typu bedny vozidlo, které ještě nevlastníte. Až k tomu dojde, počítadlo se vynuluje."

msgid "infoPage/footer/title/compensation"
msgstr "Kompenzace"

msgid "infoPage/footer/title/guaranteed"
msgstr "Zaručená odměna"

msgid "infoPage/header/rewards/description"
msgstr "Z každé skupiny může padnout nanejvýš jedna odměna"
