msgid "#PluralForms"
msgstr "nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;"

msgid "boxTooltip/description/text/bronze"
msgstr "Po otevření vám z těchto beden mohou padnout prémiová vozidla, herní měny a další hodnotné odměny."

msgid "boxTooltip/description/text/gold"
msgstr "Po otevření vám z těchto beden mohou padnout vozidla, herní měny, prvky na úpravu vzhledu a další hodnotné odměny."

msgid "boxTooltip/description/text/silver"
msgstr "Po otevření vám z těchto beden mohou padnout vozidla, herní měny, prvky na úpravu vzhledu a další hodnotné odměny."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Lze získat z herního obchodu a po otevření beden jakéhokoliv typu."

msgid "boxTooltip/howGet/text/gold"
msgstr "Lze získat při otevírání beden jakéhokoliv jiného typu."

msgid "boxTooltip/howGet/text/silver"
msgstr "Lze získat při otevírání beden jakéhokoliv jiného typu."

