msgid "Pz38t_Standardketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. A"

msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Byl vyvinut v roce 1938 společností ČKD pro československou armádu. Během německé okupace sloužilo vozidlo ve Wehrmachtu a používalo se během tažení v Polsku a ve Francii, a také na východní frontě. Na frontě tank bojoval až do poloviny roku 1942. Bylo vyrobeno přibližně 1 400 vozidel v osmi modifikacích (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

