msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Dračí bedny"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRAČÍ BEDNY"

msgid "entryPoint/tooltip/description"
msgstr "Jde o speciální bedny obsahující jedinečné a hodnotné herní předměty.\nBedny můžete získat v herním nebo v prémiovém obchodě."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Dračí bedny jsou dočasně nedostupné"

msgid "eventName/lowerCase"
msgstr "Zkroťte draka, surfujte po větru"

msgid "eventName/upperCase"
msgstr "ZKROŤTE DRAKA, SURFUJTE PO VĚTRU"

msgid "infoPage/footer/description/compensation"
msgstr "Pokud již vlastníte všechna vozidla ze seznamu možného obsahu bedny, pak všechna následující vozidla, která z Dračích beden získáte, budou kompenzována ve zlaťácích v hodnotě jejich plné ceny."

msgid "infoPage/footer/description/guaranteed"
msgstr "Každá %(guaranteed0)s. Dračí bedna zaručeně obsahuje vozidlo VIII.–IX. úrovně. Pokud daný počet beden otevřete, aniž by vám takové vozidlo padlo, pak při otevření %(guaranteed0)s. &zwnbsp;Dračí bedny padne vozidlo VIII.–IX. úrovně, které ještě nevlastníte. Až k tomu dojde, počítadlo se vynuluje."

msgid "noBoxesView/description/"
msgstr "Nemáte žádné bedny.\nMůžete si je pořídit v herním obchodě."
