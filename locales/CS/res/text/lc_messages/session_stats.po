msgid "tooltip/battleType/hasBattles/daily/body"
msgstr "Odehráno bitev: %(value)s. Statistiky se aktualizují po každé bitvě. Hodnoty se automaticky vynulují každých 24 hodin."

msgid "tooltip/battleType/header"
