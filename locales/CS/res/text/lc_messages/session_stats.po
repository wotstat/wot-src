msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Poměr celkem způsobeného poškození a počtu bitev odehraných v relaci. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Poměr zničených nepřátelských vozidel a odehraných bitev."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Průměrná úroveň vozidel, která jste řídili za herní relaci."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Poměr celkem získaných zkušeností a počtu bitev odehraných v relaci. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Poměr celkového poškození zastaveného pancířem a počtu bitev odehraných v relaci. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Poměr poškození způsobeného spojenci díky vašemu odhalování, zničení pásu, znehybnění nepřátelského vozidla nebo ochromení a počtu bitev odehraných v relaci. Delta zobrazuje efekt stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Poměr parametrů „Způsobené poškození“ a „Obdržené poškození“. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Poměr zničených nepřátelských vozidel a počtu zničení hráčova vozidla. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Poměr odhalených nepřátelských vozidel a bitev odehraných za relaci."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Procentní podíl celkem odehraných bitev, v nichž nebylo hráčovo vozidlo zničeno."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Procentní podíl vítězství v náhodných bitvách za relaci. Delta zobrazuje efekt stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/wins"
msgstr "Počet vítězství v náhodných bitvách v rámci relace. Delta zobrazuje vliv stávající herní relace na celkový parametr."

msgid "propertyInfo/prop/descr/wtr"
msgstr "WTR podle průměrných hodnot za celou relaci. Delta zobrazuje vliv stávající herní relace na celkový parametr."

