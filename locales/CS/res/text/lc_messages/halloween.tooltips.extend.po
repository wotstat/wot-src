msgid "Contact/status/inBattle/halloween"
msgstr "V bitvě Babylonu: Temné věže"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Vypálí výstřel, který poškodí a ochromí cíl a všechna nepřátelská vozidla v okruhu 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Vypálí výstřel, který ukradne body výdrže cíli a nepřátelským vozidlům v okruhu 35 m a obnoví je hráči."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Vypálí výstřel, který ochromí cíl a všechna nepřátelská vozidla v okruhu 35 m."

msgid "advanced/hw_damageShield"
msgstr "Po dobu 7 sekund chrání před jakýmkoliv poškozením (vyjma nárazem, utopením a pádem)."

msgid "advanced/hw_fastReload"
msgstr "Zvýší rychlost palby / nabije zásobník."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Obnovuje body výdrže, hasí požár, odstraňuje efekt ochromení a opravuje poškozené moduly."

msgid "advanced/hw_invisibility"
msgstr "Dočasně činí vaše vozidlo pro nepřátele neviditelným, obnovuje body výdrže, opravuje moduly, hasí požár, odstraňuje efekt ochromení a léčí všechny zraněné členy posádky."

msgid "advanced/hw_teamRepairKit"
msgstr "Opravuje poškozené moduly, hasí požáry, odstraňuje efekt ochromení a obnovují nějaké body výdrže spojeneckým vozidlům v dosahu."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Bojové schopnosti vám pomáhají efektivněji bojovat v bitvách akce „Babylon: Temná věž“, dokončovat cíle a získávat hodnotné odměny. Pro vybavení se bojovými schopnostmi klikněte na jeden ze slotů na bojové schopnosti."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Sloty na bojové schopnosti"

msgid "hwShell/alt/description"
msgstr "%(bold)s lze s určitou pravděpodobností najít v bitvě po zničení nepřítele."

msgid "hwShell/alt/description/bold"
msgstr "Alternativní granát"
