msgid "mode/fort_rush_battle/condition"
msgstr "7 proti 7 %(parSecondary_open)sI%(parSecondary_close)s X.&nbsp;úroveň"

msgid "mode/fort_rush_battle/description"
msgstr "Převezměte kontrolu nad anténami. Udržte síť. Zajistěte přenos."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Výkon vašeho počítače není pro tento herní režim dostačující. Můžete mít potíže s grafikou a pohybem vozidla. Pravděpodobné jsou také pády herního klienta."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Nízký výkon"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Nízký výkon"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Tento herní režim vyžaduje vysoký výpočetní výkon. Budete mít potíže s načítáním mapy, grafikou a pohybem vozidla. V případě nedostatečného výkonu zkuste v nastavení snížit kvalitu vaší grafiky."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Snížený výkon"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Snížený výkon"
