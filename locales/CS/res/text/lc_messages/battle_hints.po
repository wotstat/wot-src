msgid "hint/LSH_FIRE"
msgstr "Kouř komplikuje odhalování nepřátelských vozidel a sdělování jejich polohy. Požár způsobuje poškození vozidel."

msgid "hint/LSH_FOG"
msgstr "Mlha komplikuje odhalování nepřátelských vozidel a sdělování jejich polohy."

msgid "hint/LSH_RAIN"
msgstr "Silný déšť komplikuje odhalování nepřátelských vozidel a sdělování jejich polohy."

msgid "hint/LSH_SANDSTORM"
msgstr "Písečná bouře komplikuje odhalování nepřátelských vozidel a sdělování jejich polohy."

msgid "hint/LSH_SMOKE"
msgstr "Kouř komplikuje odhalování nepřátelských vozidel a sdělování jejich polohy."

msgid "hint/PPH_AIMING_01"
msgstr "Pohyb vozidla a věže snižuje <font color='#EE7000'>přesnost děla</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Kruh zaměřovače ukazuje <font color='#EE7000'>přesnost děla</font>. Pro přesnější zásah před výstřelem chvíli počkejte."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatické zaměřování</font> aktivováno. Pro zrušení klikněte pravým tlačítkem myši."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatické zaměřování vždy míří <font color='#EE7000'>na střed</font> vámi zaměřeného vozidla"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Vaše základna je <font color='#EE7000'>obsazována!</font> Pokud nepřátelský tým neodrazíte, protivník zvítězí."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Každé nepřátelské vozidlo má <font color='#EE7000'>svůj vlastní</font> postup obsazování"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Obsazení</font> nepřátelské základny je jedním ze způsobů, jak lze vyhrát bitvu"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Pokud obdržíte poškození, váš postup obsazování <font color='#EE7000'>bude ztracen</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Pokud opustíte kruh základny, váš postup obsazování <font color='#EE7000'>bude ztracen</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Několik vozidel najednou obsadí základnu <font color='#EE7000'>rychleji</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Po <font color='#EE7000'>třetím</font> vozidle se rychlost obsazování již nezvýší"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Nepřátelská základna je téměř obsazena!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Váš tým vyhrává v závodě v obsazování základen!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modul vozidla kriticky poškozen! Opravte ho pomocí <font color='#EE7000'>sady nářadí</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modul vozidla kriticky poškozen! Opravte ho pomocí <font color='#EE7000'>sady nářadí</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Člen posádky kriticky zraněn! Ošetřete ho pomocí <font color='#EE7000'>lékárničky</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Člen posádky kriticky zraněn! Ošetřete ho pomocí <font color='#EE7000'>lékárničky</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Posádka vozidla ochromena! Ošetřete ji pomocí <font color='#EE7000'>lékárničky</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vozidlo hoří! Použijte <font color='#EE7000'>hasicí přístroj</font> na spodním panelu."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vozidlo hoří! Automatický <font color='#EE7000'>hasicí přístroj</font> aktivován."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Modul vozidla kriticky poškozen! Vybavení se <font color='#EE7000'>sadou nářadí</font> před bitvou pomáhá vypořádat se s kritickými zásahy."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Člen posádky kriticky zraněn! Vybavení se <font color='#EE7000'>lékárničkou</font> před bitvou pomáhá vypořádat se se zraněnými členy posádky."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Vozidlo hoří! Vybavení se <font color='#EE7000'>hasicím přístrojem</font> před bitvou pomáhá vypořádat se s požárem."

msgid "hint/PPH_OTHER_01"
msgstr "Byli jste <font color='#EE7000'>odhaleni</font> – palba může odhalit vaši pozici!"

msgid "hint/PPH_OTHER_02"
msgstr "Vaše vozidlo bylo zničeno. Pro opuštění bitvy bez postihu stiskněte klávesu <font color='#EE7000'>„Esc“</font>."

msgid "hint/PPH_OTHER_03"
msgstr "Vaše vozidlo bylo zničeno. Pro <font color='#EE7000'>sledování hry</font> spojenců klikněte myší."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Ikona žárovky</font> značí, že jste byli odhaleni nepřítelem!"

msgid "hint/PPH_OTHER_05"
msgstr "Vaše dělo stále <font color='#EE7000'>nabíjí</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Vaše dělo může vypálit pouze tehdy, pokud je kruh zaměřovače <font color='#EE7000'>kompletně zelený</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Můžete rolovat kolečkem myši, abyste přešli do <font color='#EE7000'>odstřelovacího režimu</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Můžete rolovat kolečkem myši, abyste <font color='#EE7000'>opustili</font> odstřelovací režim"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Zelený vnitřní zaměřovač</font> značí vysokou šanci na probití pancíře nepřátel"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Dokonce ani zelený vnitřní zaměřovač <font color='#EE7000'>nezaručuje</font> probití"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Děla nejsou vždy 100% přesná, střely proto nemusí vždy <font color='#EE7000'>dopadnout do středu</font> zaměřovače"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Vnitřní zaměřovač zobrazuje šanci na probití pancíře nepřátel. <font color='#EE7000'>Aktivujte ho v nastavení</font>."

msgid "penetration/chance/high"
msgstr "Vysoká šance"

msgid "penetration/chance/low"
msgstr "Nízká šance"

msgid "penetration/chance/medium"
msgstr "Průměrná šance"
