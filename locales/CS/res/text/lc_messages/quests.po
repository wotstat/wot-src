msgstr "Kupte si jakékoliv granáty se slevou %(discount)s. Kupte si s předstihem zlevněnou munici, abyste ušetřili své zdroje."

msgid "action/full/shell/creditsPriceMultiplier"
msgstr "Kupte si granáty za kredity se slevou %(discount)s. Kupte si s předstihem zlevněnou munici, abyste ušetřili své zdroje."

