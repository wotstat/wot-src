msgid "gunner_armorer/maxLvlDescription"
msgstr "Při úplném vycvičení snižuje rozsah {greenBright_Start}potenciálního poškození{greenBright_End} a {greenBright_Start}potenciální průbojnosti{greenBright_End} o {greenBright_Start}±{greenBright_End}%(damageAndPiercingDistributionLowerBound)s. Snižuje {greenBright_Start}rozptyl děla{greenBright_End} o %(shotDispersionAngle)s&zwnbsp;."

