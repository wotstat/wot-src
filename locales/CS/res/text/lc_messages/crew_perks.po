msgid "radioman_finder/shortDescription"
msgstr "Zvyšuje dohled."

msgid "radioman_interference/alt/description"
msgstr "Pokud mají schopnost vycvičenou dva radisté, je aplikována průměrná hodnota úrovně jejího vycvičení.\n\nDobu, po kterou zůstane vaše vozidlo odhaleno, lze dále snížit namontováním vybavení s podobným efektem."

msgid "radioman_interference/alt/info"
