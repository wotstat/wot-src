msgstr "Bok po boku"

msgid "radioman_sideBySide/shortDescription"
msgstr "Zlepšený výkon posádky."

msgid "radioman_signalInterception/alt/description"
msgstr "Efekt zlepšuje prvek velitele „Šestý smysl“ urychlením jeho aktivace.\n\nPokud mají tuto schopnost dva radisté, je aplikována průměrná hodnota úrovně jejího vycvičení."

msgid "radioman_signalInterception/alt/info"
msgstr "Schopnost se stává aktivní po vycvičení na alespoň 1 % a její efektivita se s dalším výcvikem zlepšuje."

msgid "radioman_signalInterception/currentLvlDescription"
msgstr "{greenBright_Start}Doba pro určení{greenBright_End}, zda {greenBright_Start}bylo vaše vozidlo odhaleno{greenBright_End} nepřítelem, je snížena o %(commanderLampDelay)s."

msgid "radioman_signalInterception/maxLvlDescription"
msgstr "Při úplném vycvičení snižuje {greenBright_Start}dobu pro určení{greenBright_End}, zda {greenBright_Start}{greenBright_End}bylo vaše vozidlo odhaleno nepřítelem, o %(commanderLampDelay)s."

