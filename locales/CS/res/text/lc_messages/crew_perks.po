msgid "radioman_sideBySide/maxLvlDescription"
msgstr "Při úplném vycvičení zvyšuje {yellow_Start}bonus efektivity posádky{yellow_End} o %(crewLevelIncrease)s na vzdálenost menší než 50 m od spojeneckého vozidla stejného typu&zwnbsp;."

