msgstr "%(icon) Nízký výkon"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Tento herní režim vyžaduje vysoký výpočetní výkon.\nBudete mít potíže s načítáním mapy, grafikou a pohybem vozidla. V případě nedostatečného výkonu zkuste v nastavení snížit kvalitu vaší grafiky."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Snížený výkon"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
