msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Zdroj anomálie se blíží. Samozřejmě to je obří tank."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Zničte ho a všechno to skončí. Do toho chlapi!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Střílejte na slabá místa pancíře."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Chlapi, směrem k nám míří velká hnusná monstrozita,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "jakou jsme ještě neviděli."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Její slabá místa se zdají viditelná. Musíme"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "zničit bosse, získat vysílač a dokončit misi."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Je to náš šťastný den, chlapi! Dva bossové místo jednoho –"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "to je něco nového. Ale stejně vyhrajeme. Palte na zranitelná"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "místa v jejich pancíři a nezapomeňte ničit jejich ochránce."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Je to pořádný protivník, ale má svá slabá místa."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Zničte tu bestii a všechno skončí. Pojďme na to chlapi!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Palte na slabá místa nepřítele. A nezapomeňte ničit"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "jeho nohsledy, nebo to bude opravdu těžké."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Pro zavření anomálie musíme zničit bosse."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Miřte na slabá místa v jeho pancíři."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Pro dokončení mise musíme zničit posledního protivníka."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Palte na jeho zranitelná místa."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Je to poslední překážka na naší cestě."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "No tak chlapi, vzpamatujte se! Pojďme zničit tohle monstrum!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Nepřítel je velmi nebezpečný, ale má slabá místa."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Tohle je naše šance ukončit to jednou provždy."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Teď poznáme, co si pro nás anomálie přichystala."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Silný protivník, ale má slabá místa."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Pojďme tuhle bestii zničit, chlapi!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Tohle je opravdu silný protivník. Ale to zvládneme, jsem si tím jistý."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Dneska dva bossové za cenu jednoho."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Tak do toho, je to skvělá nabídka! Miřte na zranitelná místa"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "v jejich pancíři. Zničme tato monstra!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Zdá se, že se bossům nepodařilo dohodnout na pořadí"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "a přišli oba. Oba mají slabá místa, miřte na ně."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Pěkný páreček bossů. Víte, co máte dělat."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Palte na jejich slabá místa a zničte všechny ochránce."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "A rychle!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Pořádně jsme jim to nandali, chlapi!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Ale ještě jsme neskončili."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Pěkný! Ale jsme jen na půli cesty."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Vrátí se i s přáteli."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Takhle se na to musí! Opravme své tanky a pojeďme znovu."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Takhle snadno ho neporazíme. Připravte se na druhé kolo."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Dobře jsme jim to ukázali, chlapi! Ale ještě to nekončí."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Pěkný! Ale jsme jen na půli cesty."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Vrátí se i s přáteli."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Takhle se na to musí! Opravme své tanky a pojeďme znovu."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Takhle snadno je neporazíme. Připravte se na druhé kolo."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Tady kapitán Smith. Zatímco naši chlapi před trhlinou"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "zadržují útok echo tanků na komplex Babylon,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "naší misí je projít všemi fázemi a zavřít anomálii."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Z toho důvodu tomu musíme ve všech fázích naplnit kolektory. Vpřed!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Hluboko v podprostoru Miria byla spatřena nepřátelská základna. "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Na invazi připravují obrovskou armádu. Naší jedinou nadějí"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "je zablokovat jim cestu a tak je zastavit. Naší misí je dostat se"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "do hluboké fáze anomálie a extrahovat vysílač, který"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "drží jejich cestu otevřenou. Nabijte Magnus Miriem"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "a ukončete jejich existenci!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Zdravím všechny! Musíme echo tankům uzavřít cestu"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "do naší reality. Kontrarozvědka se postará o špióny"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "v Babylonu – naším cílem je Mirium. Naplňte kolektory ve všech fázích,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "nakopejte zadky těm věcem, které na nás tam dole čekají,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "a zavřeme tuhle díru. Zažehněte motory!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Tady Smith. Naším cílem je zavřít trhlinu v oblasti komplexu"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "Babylon. Naplňte kolektory Miriem a zničte"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "cokoliv, co nejsme my. Tak pojďme chlapi, nepřítel čeká!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Naši chlapci drží zpátky echo tanky, kterým se zatím nedaří"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "probít do reálného světa. Vaší misí je uzavřít trhlinu."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Čím dřív, tím líp. Nasbírejte Mirium a zavřete tu díru."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Nepřátelské tanky útočí na komplex Babylon. Ta špína"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "vyjíždí z trhliny, musíme jim zablokovat cestu."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Vjeďme hluboko do anomálie a neutralizujme tohle zlo přímo u zdroje. Pojďme na to!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Tady Smith. Naší misí je zastavit armádu německých"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "echo tanků uvnitř anomálie. Naš cíl se momentálně nachází"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "v hluboké fázi. Naplňte Magnus a dosáhněte jí."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "V hlubinách podprostoru Miria jsme odhalili nepřátelskou základnu."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Odsud plánují svůj útok."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Malé holčičky si nevšímejte. Naším cílem je aktivovat"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus a otevřít cestu do nejhlubší fáze,"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "kde nepřítele zastavíme jednou provždy."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "V nejhlubší fázi jsme spatřili nepřátelskou základnu."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Teď je porazit nezvládneme, ale můžeme je tam uvěznit."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Nasbírejte Mirium a posuňte se na dno této trhliny."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Věřím vám, chlapi! To zvládneme!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Nová trhlina se otevřela krátce po uzavření té minulé."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Naše mise zůstává stejná: Nasbírat hmotu a"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "uzavřít anomálii, čímž zastavíme invazi do naší reality. Vpřed!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Trhlina se znovu otevřela. Nasbírejte hmotu a naplňte kolektor."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Musíme uzavřít tu zatracenou anomálii. Chlapi venku"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "na nás spoléhají, ale nezvládnou se bránit věčně!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Komplex Babylon je stále pod útokem nepřátelských tanků."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Nasbírejte hmotu a naplňte Magnus. Musíme uzavřít"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "anomálii a zastavit invazi echo tanků do naší reality."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Náš cíl je blízko. Zůstaňte v pozoru a sledujte po očku"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "detektor Nesmrtelného."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Skvělá práce, chlapi! Držte tempo! Čas na čaj"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "ještě nenastal. Musíme nasbírat víc Miria."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Skvělá týmová práce! Pojeďme dál, potřebujeme víc Miria."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Dobrá práce! Musíme aktivovat Magnus a posunout se ještě hlouběji."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium nás s každou další fází posiluje."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Jen se nenechte unést."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Musíme aktivovat Magnus. Ještě jednou na zteč!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Naše mise zůstává stejná: Musíme naplnit kolektor."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Blížíme se ke zdroji invaze."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Náš úkol zůstává stejný: Naplnit kolektor."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Pěkná písnička. Soustřeďte se, chlapi."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Musíme nasbírat Mirium a jet hlouběji."

msgid "narrator"
msgstr "Smith"
