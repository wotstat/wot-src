msgid "br_minefield/battleDescr"
msgstr "Na %(duration)s s pokládá ve vybrané oblasti aktivní minové pole. Nepřátelská vozidla, která se dostanou do kontaktu s minami, mohou být ochromena a obdržet výbušné poškození.\n\n*Miny lze zničit palbou. Miny položené pod nepřátelskými vozidly NEVYBUCHNOU."

msgid "br_minefield/descr"
msgstr "Na %(duration)s s pokládá ve vybrané oblasti aktivní minové pole. Nepřátelská vozidla, která se dostanou do kontaktu s minami, mohou být ochromena a obdržet výbušné poškození.\n\n*Miny lze zničit palbou. Miny položené pod nepřátelskými vozidly NEVYBUCHNOU."

msgid "br_minefield/longDescr"
msgstr "{whiteSpanish_Open}Na %(duration)s s{whiteSpanish_Close} pokládá ve vybrané oblasti aktivní minové pole. Nepřátelská vozidla, která se dostanou do kontaktu s minami, mohou být ochromena a obdržet výbušné poškození.\n\n*Miny lze zničit palbou. Miny položené pod nepřátelskými vozidly NEVYBUCHNOU."

