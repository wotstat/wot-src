msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Po dobu trvání bitvy zlepšuje účinek Vertikálního stabilizátoru (jakékoliv třídy), Systému stabilizačního vybavení nebo Trofejního stabilizátoru. Tyto položky vybavení by měly být na vašem vozidle namontovány, abyste se mohli směrnicí vybavit a aktivovat ji."

msgid "aimingStabilizerBattleBooster/name"
