msgid "berserker/battleDescr"
msgstr "%(gunPiercing)snásobně zvyšuje průbojnost a rychlost palby a zároveň zvyšuje efektivitu pohonu děla a stabilizaci o %(gunAimingTime)s, ale po dobu trvání %(duration)s s odebírá %(healthDebuff)s z celkových bodů výdrže vašeho vozidla.\n\n*Poškození způsobené schopností „Berserk“ nemůže vaše vozidlo zničit."

msgid "berserker/descr"
msgstr "%(gunPiercing)s násobně zvyšuje průbojnost a rychlost palby a zároveň zvyšuje efektivitu pohonu děla a stabilizace o %(gunAimingTime)s, ale během %(duration)s s doby trvání odebírá %(healthDebuff)s z celkových bodů výdrže vašeho vozidla.\n\n*Poškození způsobené schopností „Berserk“ nemůže vaše vozidlo zničit."

msgid "berserker/longDescr"
msgstr "{green_Open}%(gunPiercing)snásobně{green_Close} zvyšuje průbojnost a rychlost palby a zároveň zvyšuje efektivitu pohonu děla a stabilizace {green_Open}o %(gunAimingTime)s{green_Close}, ale během{whiteSpanish_Open} %(duration)ss{whiteSpanish_Close} doby trvání odebírá {red_Open}%(healthDebuff)s{red_Close} z celkových bodů výdrže vašeho vozidla.\n\n*Poškození způsobené schopností „Berserk“ nemůže zničit vaše vozidlo."

msgid "berserker/name"
msgstr "Berserk"

msgid "berserker/shortDescr"
