msgid "adaptationHealthRestore/name"
msgstr "Adaptivní pancíř"

msgid "adaptationHealthRestore/shortDescr"
msgstr "Okamžitě {green_Open}obnoví %(immediatelyRestore)s{green_Close} z bodů výdrže vozidla. Během {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} doby trvání schopnosti bude až do skončení schopnosti všechno poškození obdržené od granátů a bojových schopností shromažďováno a konvertováno na body výdrže plus {green_Open}dalších %(restoringCoefficient)s z celkového obdrženého poškození{green_Close}.\n\n*Zkonvertované obnovené body výdrže ovlivní také spojenecká vozidla v blízkosti."

msgid "additInvisibilityDeviceBattleBooster/descr"
msgstr "%s k maskování nehybného či jedoucího vozidla s namontovaným Nízkohlučným výfukovým systémem (jakékoliv třídy) nebo Trofejním výfukovým systémem."

