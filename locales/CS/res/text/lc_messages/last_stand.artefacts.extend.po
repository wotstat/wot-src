msgstr "Situační pohyblivost"

msgid "LS_nitroSituational/onUse"
msgstr "Po obdržení poškození od nepřátelského vozidla dočasně <font color='#feab34'>zvyšuje</font> <font color='#feab34'>pohyblivost</font> vašeho vozidla.\nPravděpodobnost aktivace: <font color='#e9e2bf'>50 %</font>."

