msgid "extraParams/desc"
msgstr "Parametr, který přímo neovlivňuje efektivitu ničení nepřátelských vozidel."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Celkový bonus se počítá pomocí aditivních i multiplikativních modifikátorů, takže může být vyšší nebo nižší než hodnoty uvedené zde."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Tento parametr ukazuje dobu mezi výstřelem dělostřelectva a obdržením varování."

msgid "extraParams/name/commanderLampDelay"
msgstr "Tento parametr ukazuje prodlevu v čase, než velitel určí, zda bylo vaše vozidlo odhaleno nepřítelem. Čím vyšší hodnota, tím kratší prodleva."

msgid "extraParams/name/crewHitChance"
msgstr "Tento parametr ukazuje pravděpodobnost na zabránění zranění členů vaší posádky."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Tento parametr ukazuje trvání dodatečného ochromení pro již ochromené vozidlo."

msgid "extraParams/name/crewStunDuration"
msgstr "Tento parametr ukazuje trvání obdrženého ochromení."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Tento parametr ukazuje změnu minimálního potencionálního poškození a potencionální hodnoty průbojnosti v porovnání s výchozí hodnotou (–25 %)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Tento parametr ukazuje změnu maximálního potencionálního poškození a potencionální hodnoty průbojnosti v porovnání s výchozí hodnotou (+25 %)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Tento parametr ukazuje množství poškození způsobené nárazem. Při srážce vozidel systém zohledňuje tloušťku pancíře v bodu nárazu, rozdíl v hmotnosti vozidel a jejich rychlosti."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Tento parametr ukazuje prodlevu před tím, než velitel odhalí kritické poškození nepřátelského vozidla ve vašem zaměřovači."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Tento parametr ukazuje vystavení nepřátel, kteří jsou plně zamaskováni listovím (izolované i seskupené listoví). Platí pro nehybná i jedoucí vozidla."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Tento parametr ukazuje vystavení jedoucích nepřátelských vozidel. Čím vyšší hodnota, tím vyšší šance na odhalení."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Tento parametr ukazuje změny v pravděpodobnosti způsobení kritického poškození nepřátelské posádce a modulům. Efekt funguje pro všechny typy granátů mimo vozidel s automatickými kanóny."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Tento parametr ukazuje dobu obnovení spotřebních doplňků."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Tento parametr určuje snížení doby trvání požáru a množství poškození, které způsobí."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Tento parametr ukazuje efekt maskování za vegetací."

msgid "extraParams/name/hpRecover"
msgstr "Tento parametr udává nárůst obnovených bodů výdrže při použití sady nářadí. Čím vyšší je hodnota, tím více bodů výdrže bude obnoveno."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Tento parametr ukazuje průchodnost podvozku na středně měkkém terénu. Čím vyšší hodnota, tím méně času je zapotřebí k dosažení lineární rychlosti."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Tento parametr snižuje postih k maximálnímu dohledu vozidla při zničení pozorovacích zařízení. Čím nižší hodnota, tím lepší dohled."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Tento parametr udává nárůst maximální potenciální průbojnosti granátů na vzdálenosti menší než 50 m. Čím vyšší je hodnota, tím vyšší je průbojnost."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Tento parametr ukazuje dodatečný čas vysílání pozic nepřítele po zničení vašeho vozidla."

msgid "extraParams/name/radiomanHitChance"
msgstr "Tento parametr ukazuje pravděpodobnost zabránění zranění vašeho radisty."

msgid "extraParams/name/shellVelocity"
msgstr "Tento parametr ukazuje zvýšenou rychlost letu granátu pro všechny typy granátů. Čím vyšší hodnota, tím vyšší rychlost granátu."

msgid "extraParams/name/softGroundFactor"
msgstr "Tento parametr ukazuje průchodnost podvozku na měkkém terénu. Čím vyšší hodnota, tím méně času je zapotřebí k dosažení lineární rychlosti."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Tento parametr ukazuje míru negativních efektů z ochromení posádky."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Tento parametr udává snížení obdrženého poškození podvozku. Čím vyšší je hodnota, tím nižší bude obdržené poškození."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Tento parametr ukazuje snížení postihu nabíjení děla kvůli poškozené bedně s municí. Čím vyšší hodnota, tím kratší doba nabíjení."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Tento parametr ukazuje snížení výkonu poškozeného motoru. Čím vyšší hodnota, tím menší ztráta výkonu motoru."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Tento parametr ukazuje výdrž bedny s municí, palivových nádrží a motoru. Čím vyšší hodnota, tím jsou vaše moduly odolnější."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Tento parametr ukazuje výdrž bedny s municí. Čím vyšší hodnota, tím je vaše bedna s municí odolnější."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Tento parametr ukazuje poškození způsobené poškozením podvozku při dopadu. Neovlivňuje poškození způsobené při dopadu bokům či vršku věže."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Tento parametr ukazuje rychlost oprav podvozku. Čím vyšší hodnota, tím rychlejší opravy."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Tento parametr ukazuje výdrž podvozku. Čím vyšší hodnota, tím je váš podvozek odolnější proti granátům i dopadům/nárazům."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Tento parametr ukazuje dobu, po kterou jsou nepřátelé viditelní poté, co opustí váš dohled. Výchozí hodnota je 10 sekund."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Tento parametr ukazuje snížení poškození obdrženého pádem vozidla. Čím vyšší hodnota, tím menší poškození obdržíte."

msgid "extraParams/name/vehicleFireChance"
msgstr "Tento parametr ukazuje pravděpodobnost vznícení motoru při jeho poškození."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Tento parametr ukazuje odolnost palivových nádrží proti kritickému poškození. Po zničení se palivové nádrže vždy vznítí."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Tento parametr ukazuje snížení přesnosti děla za pohybu a při otáčení korby a věže. Čím nižší hodnota, tím menší rozptyl kruhu zaměřovače."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Tento parametr ukazuje velikost kruhu zaměřovače po výstřelu."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Tento parametr ukazuje rozptyl při pohybu. Čím nižší hodnota, tím přesnější dělo."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Tento parametr ukazuje rozptyl při otáčení korby. Čím nižší hodnota, tím přesnější dělo."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Tento parametr ukazuje rozptyl při otáčení věže. Čím nižší hodnota, tím přesnější dělo."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Tento parametr ukazuje rozptyl poškozeného děla. Čím vyšší hodnota, tím větší rozptyl."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Tento parametr ukazuje poškození obdržené od HE granátů. Čím více je v oblasti dopadu pancíře, tím vyšší je účinek."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Tento parametr ukazuje maskování po výstřelu."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Tento parametr ukazuje dobu, po kterou je vaše vozidlo pro nepřátele viditelné poté, co opustíte jejich dohled. Výchozí hodnota je 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Tento parametr ukazuje množství poškození podvozku obdrženého nárazem. Při srážce vozidel systém zohledňuje tloušťku pancíře v bodu nárazu, rozdíl v hmotnosti vozidel a jejich rychlosti."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Tento parametr ukazuje množství poškození obdrženého nárazem. Při srážce vozidel systém zohledňuje tloušťku pancíře v bodu nárazu, rozdíl v hmotnosti vozidel a jejich rychlosti."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Tento parametr ukazuje rychlost přepnutí mezi typy granátu v nabitém děle."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Tento parametr ukazuje rychlost oprav vnitřních a vnějších modulů z „červeného“ stavu na „žlutý“ stav. Čím vyšší hodnota, tím rychlejší opravy."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Tento parametr ukazuje průchodnost podvozku. Čím vyšší hodnota, tím méně času je zapotřebí k dosažení lineární rychlosti."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Tento parametr ukazuje rychlost změny směru pro kolové vozidlo."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Tento parametr ukazuje snížení postihu k hlavním kvalifikacím jakéhokoliv zraněného člena posádky (kromě velitele)."

