msgid "quest/advice/successLimiter/info/3/title"
msgstr "Násobitel:"

msgid "quest/advice/successLimiter/limiter/1/description"
msgstr "Podle hodnoty: mise má určitou minimální hodnotu, které musíte dosáhnout. Není-li této hodnoty dosaženo, tak se výsledek bitvy nepočítá. Podle času: podmínka se považuje za splněnou, pokud je vyplněna v uvedeném časovém rozpětí."

msgid "quest/advice/successLimiter/limiter/1/title"
msgstr "Omezení."

msgid "quest/advice/successLimiter/warning"
msgstr "DŮLEŽITÉ: pokud misi zrušíte, bude všechen postup ztracen."

msgid "quest/advice/sum/description"
msgstr "Každá mise tohoto typu má omezený počet pokusů o splnění uvedené podmínky."

msgid "quest/advice/sum/info/1/description"
msgstr "výsledky každé bitvy se přičítají. Není-li dosaženo požadované hodnoty a již nezbývají žádné pokusy, považuje se mise za nezdařenou a její postup se vynuluje. Mise se restartuje."

msgid "quest/advice/sum/info/1/title"
msgstr "Primární podmínka:"

msgid "quest/advice/sum/info/2/description"
msgstr "podobá se primární a má svůj vlastní postup splnění. Tato podmínka je složitější a na její splnění budete mít stejný počet pokusů."

