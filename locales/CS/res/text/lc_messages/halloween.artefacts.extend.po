msgid "fastReload/name"
msgstr "Rychlé nabíjení"

msgid "fastReload/onUse"
msgstr "Po určitou dobu výrazně urychluje nabíjení cyklického děla nebo okamžitě nabije děla se systémem nabíjení zásobníku."

msgid "fastReload/restriction"
