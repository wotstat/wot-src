msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Začněte náhodnou bitvu s vozidlem jakékoliv úrovně."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Vítejte ve hře! Bojujte s ostatními fanoušky z celého světa a oslavujte velkolepá vítězství!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "První bitva"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Vyzkoumejte a kupte si jakékoliv vozidlo IV. úrovně."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Zakoupení nového vozidla je velkou událostí. S každou novou úrovní jsou vozidla zajímavější. Celkovou hratelnost také zlepší vycvičená posádka."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Vozidlo IV. úrovně"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Odehrajte 3 náhodné bitvy s vozidly IV.–X. úrovně, která na sobě mají prvky na úpravu vzhledu."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Můžete upravit vzhled svých vozidel pomocí přednastavených stylů nebo vytvořením vlastního stylu pomocí kamufláže, nápisů, emblémů a obtisků."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Vnější vzhled vozidel"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Začněte s výcvikem schopnosti jakéhokoliv člena posádky."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Členové posádky mohou cvičit další schopnosti, aby zvýšili svou efektivitu nebo získali nové schopnosti."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Schopnosti posádky"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Získejte v náhodných bitvách s vozidly IV.–X. úrovně 150 000 kreditů."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Čím vyšší úroveň bitvy, tím více kreditů budete potřebovat k údržbě svého vozidla, doplnění munice a zakoupení modulů a vybavení."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Střádání kreditů"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Vyzkoumejte a kupte si jakékoliv vozidlo V. úrovně."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Na V. úrovni se začínají objevovat nebezpečnější vozidla a vaše herní schopnosti jsou podrobeny zkoušce. Bude se hodit kompletně vycvičená posádka."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Vozidlo V. úrovně"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s vozidly V.–X. úrovně, která mají nainstalovaná 3 kusy vybavení."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Skládaná optika nebo Vylepšená ventilace? Správné vybavení může posílit přednosti vašeho vozidla a omezit jeho slabiny."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montáž vybavení"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "V režimu „Mapování“ dokončete jeden základní scénář."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Abyste se na bojišti cítili sebejistě, je nejlepší mít dobré znalosti o cestách, taktikách a mapách, včetně klíčových pozic a objektů na nich."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Mapování"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Dokončete 4 pokročilé scénáře na jedné mapě v Mapování."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Čas od času vstupte do režimu „Mapování“, abyste prostudovali mapy pro náhodné bitvy. Čtyři scénáře vám umožní prozkoumat lokaci z různých úhlů."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Pokročilé mapování"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s vozidly V.–X. úrovně, která mají aktivované osobní zálohy."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Když jsou aktivovány, můžete po každé bitvě získat další bonusy k bojovým ZK, volným ZK a ZK posádky nebo kreditům."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Osobní zálohy"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Umístěte se s vozidly V.–X. úrovně ve vítězných náhodných bitvách 6krát mezi 10 nejlepšími hráči svého týmu podle získaných ZK."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Tyto mise vám umožní získat za úspěšnou bitvu 5x víc ZK. Abyste toho dosáhli, musíte zvítězit a umístit se mezi 10 nejlepšími hráči svého týmu dle získaných ZK."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 misí na 5× ZK"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Vyzkoumejte modul a nainstalujte jej na vozidlo jakékoliv úrovně."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Po každé bitvě jsou přidělovány bojové ZK. Získávejte je pro výzkum nových modulů, které zlepší efektivitu vašeho vozidla."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Bojové ZK"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Vyzkoumejte a kupte si jakékoliv vozidlo VI. úrovně."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Pro každou následující úroveň bude výzkum vozidel vyžadovat víc času a úsilí. Volné ZK vám pomohou postupovat rychleji a bude se hodit vycvičená posádka."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Vozidlo VI. úrovně"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Dokončete jednu osobní misi v jakékoliv kampani."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampaně jsou řetězce misí pro různé typy vozidel. Za jejich splnění můžete získat užitečné odměny a jedinečná vozidla."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Osobní mise"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Vycvičte posádku pomocí univerzálního manuálu."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Knihy posádky vám umožňují výrazně urychlit výcvik posádky tím, že jednomu nebo všem členům posádky přidají určitý počet ZK."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Knihy posádky"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s vozidly VI.–X. úrovně vybavenými směrnicí posádky."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Směrnice v jedné bitvě vylepší schopnosti posádky. Stejně jako spotřební doplňky lze směrnice zakoupit nebo získat jako odměnu."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Směrnice pro posádku"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Kupte si v herním obchodě speciální balíček nováčka."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "V obchodě si můžete koupit vše, co potřebujete, včetně zlaťáků, prémiových vozidel a dalších věcí. Najdete zde pravidelné propagační akce se skvělými nabídky."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Obchod"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s prémiovými vozidly VI.–X. úrovně."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Tato vozidla není třeba vyzkoumat. Získávají více bojových ZK, ZK posádky a kreditů a umožňují vám přesouvat posádku bez nutnosti přeškolení."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Prémiová vozidla"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s vozidly VI.–X. úrovně, která jsou vybavena směrnicí pro vybavení."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Směrnice vám umožňují zvýšit efektivitu namontovaného vybavení. Stejně jako spotřební doplňky lze směrnice zakoupit nebo získat jako odměnu."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Směrnice pro vybavení"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Umístěte se s vozidly VI.–X. úrovně v náhodných bitvách 15krát mezi 10 nejlepšími hráči svého týmu podle získaných ZK."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Tyto mise vám umožní získat za úspěšnou bitvu 5x víc ZK. Abyste toho dosáhli, musíte zvítězit a umístit se mezi 10 nejlepšími hráči svého týmu dle získaných ZK."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 misí na 5× ZK"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Vyzkoumejte a kupte si jakékoliv vozidlo VII. úrovně."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "U této úrovně vozidla se požadavky na dovednosti ještě zvyšují. Vozidla se stávají hrozivějšími a efektivnějšími – stejně jako vaši protivníci."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Vozidlo VII. úrovně"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Odehrajte 10 náhodných bitev s vozidly VII.–X. úrovně vybavenými velkou lékárničkou, velkou sadou nářadí a automatickým hasicím přístrojem."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Velké spotřební doplňky po použití opravují poškozené moduly rychleji než malé spotřební doplňky. Také snižují dobu trvání ochromení a šanci na požár a mají kratší dobu obnovení."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Velké spotřební doplňky"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Získejte s vozidlem jakékoliv úrovně dvojnásobné ZK za své první vítězství dne v náhodných bitvách."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Za své první vítězství dne můžete s každým vozidlem získat dvojnásobek ZK. Tento prvek využijte k ještě rychlejšímu vylepšení svých vozidel."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Násobitel ZK"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Vytvořte fragment plánu pro jakékoliv nevyzkoumané vozidlo."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Plány poskytují slevu na ZK a zrychlují výzkum vozidla. Plány lze získat jako odměnu nebo konverzí z univerzálních a národních fragmentů."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Plány vozidla"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Umístěte se s vozidly VII.–X. úrovně v náhodných bitvách 20krát mezi 10 nejlepšími hráči svého týmu podle získaných ZK."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Tyto mise vám umožní získat za úspěšnou bitvu 5x víc ZK. Abyste toho dosáhli, musíte zvítězit a umístit se mezi 10 nejlepšími hráči svého týmu dle získaných ZK."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 misí na 5× ZK"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Vyzkoumejte a kupte si jakékoliv vozidlo VIII. úrovně."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Vozidla VIII. úrovně vyžadují, abyste využili všechny své získané znalosti. Nepřátelé vás nenechají se nudit a zajistí vám vzrušení a neocenitelné zkušenosti."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Vozidlo VIII. úrovně"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Použijte volné ZK pro vyzkoumání jakéhokoliv modulu."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Pokud nemáte dostatek bojových ZK pro výzkum modulu nebo vozidla, můžete použít volné ZK, které lze získat pro jakékoliv vozidlo."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Volné ZK"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Naložte alternativní granáty a začněte náhodnou bitvu s vozidlem III.–X. úrovně."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Průbojné, výbušné a podkaliberní granáty se používají v různých situacích v bitvě. Abyste získali výhodu, vybírejte s rozvahou!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munice"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Prodejte nevyužívané moduly ze skladu."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Nepoužité moduly, granáty, vybavení, spotřební doplňky a ostatní předměty jsou uloženy ve skladu. Předměty navíc můžete prodat za kredity."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Sklad"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Získejte v náhodných bitvách s vozidly III.–X. úrovně 25 000 kreditů."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Kredity jsou používány k nákupu granátů a nových vozidel, k opravám vozidel a mnohému dalšímu. Je důležité vědět, jak je našetřit, a používat je s rozvahou."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Kredity"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Odehrajte 3 náhodné bitvy s vozidly III.–X. úrovně, která mají ve všech dostupných slotech namontované spotřební doplňky."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Spotřební doplňky v bitvě opraví kritické poškození vozidla a vyléčí členy posádky. Používání doplňků ve správnou chvíli je zásadní pro přežití na bojišti."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Spotřební doplňky"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Odehrajte 3 náhodné bitvy s vozidly III.–X. úrovně, která mají namontované jakékoliv vybavení."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Na vozidla je možné umístit vybavení, které vylepší některé jejich parametry. Výbava závisí na vozidle a stylu hry."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Vybavení"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Mapování"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Dokončete jeden scénář na jakékoliv mapě v Mapování"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Dokončete jeden scénář na jakékoliv mapě v Mapování"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Průzkum"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Dokončete 4 pokročilé scénáře na jedné mapě v Mapování"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Jednička ze zeměpisu"
