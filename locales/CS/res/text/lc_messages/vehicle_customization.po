msgstr "Styl pro všechna roční období udělovaný za vaše úspěchy během akce „Bitva blogerů 2020“."

msgid "special_style/bb2020_amway921_shop"
msgstr "Amway921, útok"

msgid "special_style/bb2020_amway921_shop/long"
