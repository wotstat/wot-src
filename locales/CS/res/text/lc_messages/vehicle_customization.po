msgstr "Bílá poušť"

msgid "special_style/bp2021_2_desc"
msgstr "Styl pro všechna roční období, který se uděluje v určité fázi 4. sezóny Battle Passu."

msgid "special_style/bp2021_3"
msgstr "Náledí"

msgid "special_style/bp2021_3_desc"
msgstr "Styl pro všechna roční období, který se uděluje v určité fázi 4. sezóny Battle Passu."

msgid "special_style/bp2021_5_2"
msgstr "Koroze"

msgid "special_style/bp2021_5_2_desc"
msgstr "Styl pro všechna roční období, který se uděluje v určité fázi V. sezóny Battle Passu."

msgid "special_style/bp2021_5_3"
msgstr "Jižní vítr"

msgid "special_style/bp2021_5_3_desc"
msgstr "Styl pro všechna roční období, který se uděluje v určité fázi V. sezóny Battle Passu."

