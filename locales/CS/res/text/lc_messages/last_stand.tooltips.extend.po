msgid "Contact/status/inBattle/last_stand"
msgstr "V bitvě Posledního vzdoru"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Vypálí výstřel, který poškodí cíl a všechna nepřátelská vozidla v okruhu 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Vypálí výstřel, který ukradne body výdrže cíli a nepřátelským vozidlům v okruhu 35 m a obnoví je hráči."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Vypálí výstřel, který ochromí cíl a všechna nepřátelská vozidla v okruhu 35 m."

msgid "advanced/ls_damageShield"
msgstr "Po dobu 10 sekund chrání před jakýmkoliv poškozením (vyjma nárazem, utopením a pádem)."

msgid "advanced/ls_doubleDamage"
msgstr "Váš další výstřel způsobí dvojnásobné poškození."

msgid "advanced/ls_equipment"
msgstr "Taktická zařízení vám pomáhají efektivněji bojovat v bitvách akce „Poslední vzdor: Invaze“, dokončovat cíle a získávat hodnotné odměny. Abyste se vybavili taktickými zařízeními, klikněte na jeden ze slotů pro taktická zařízení."

msgid "advanced/ls_extraDamageSituational"
msgstr "Poskytuje šanci na způsobení zvýšeného poškození nepřátelskému vozidlu."

msgid "advanced/ls_fastReload"
msgstr "Zvýší rychlost palby / nabije zásobník."

msgid "advanced/ls_healSituational"
msgstr "Po zničení nepřátelského vozidla obnovují body výdrže."

msgid "advanced/ls_invisibility"
msgstr "Dočasně zabraňuje nepřátelům zaměřit vaše vozidlo, obnovuje body výdrže, opravuje moduly, hasí požár, odstraňuje efekt ochromení a léčí všechny zraněné členy posádky."

msgid "advanced/ls_nitro"
msgstr "Dočasně zvyšuje pohyblivost vašeho vozidla."

msgid "advanced/ls_nitroSituational"
msgstr "Po obdržení poškození od nepřátelského vozidla dočasně zvyšuje pohyblivost vašeho vozidla."

msgid "advanced/ls_selfRepairKit"
msgstr "Obnovuje body výdrže, hasí požár, odstraňuje efekt ochromení a opravuje poškozené moduly."

msgid "advanced/ls_teamRepairKit"
msgstr "Opravuje poškozené moduly, hasí požáry, odstraňuje efekt ochromení a obnovují nějaké body výdrže spojeneckým vozidlům v dosahu."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktická zařízení, která lze namontovat do speciálních slotů, vám pomohou v bitvách Posledního vzdoru efektivněji bojovat, dokončovat fáze a získávat hodnotné odměny."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Sloty pro taktická zařízení"
