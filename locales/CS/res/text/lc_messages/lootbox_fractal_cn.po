msgid "#PluralForms"
msgstr "nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;"

msgid "boxTooltip/description/text/fractal_cn_common"
msgstr "Po otevření vám z těchto beden mohou padnout prémiová vozidla, herní měny a další hodnotné odměny."

msgid "boxTooltip/description/text/fractal_cn_epic"
msgstr "Po otevření vám z těchto beden mohou padnout vozidla, herní měny, prvky na úpravu vzhledu a další hodnotné odměny."

msgid "boxTooltip/description/text/fractal_cn_rare"
msgstr "Po otevření vám z těchto beden mohou padnout vozidla, herní měny, prvky na úpravu vzhledu a další hodnotné odměny."

msgid "boxTooltip/howGet/text/fractal_cn_common"
msgstr "Lze získat z herního obchodu a po otevření beden jakéhokoliv typu."

msgid "boxTooltip/howGet/text/fractal_cn_epic"
msgstr "Lze ji získat při otevírání beden jakéhokoliv jiného typu."

msgid "boxTooltip/howGet/text/fractal_cn_rare"
msgstr "Lze ji získat při otevírání beden jakéhokoliv jiného typu."

msgid "common/boxCategory/lowerCase/fractal_cn_common"
msgstr "Nebeská bedna zásob"

msgid "common/boxCategory/lowerCase/fractal_cn_epic"
msgstr "Vyvolená bedna zásob"

msgid "common/boxCategory/lowerCase/fractal_cn_rare"
msgstr "Bedna zásob s nebeskou pomocí"

msgid "common/boxCategory/upperCase/fractal_cn_common"
msgstr "NEBESKÁ BEDNA ZÁSOB"

msgid "common/boxCategory/upperCase/fractal_cn_epic"
msgstr "VYVOLENÁ BEDNA ZÁSOB"

msgid "common/boxCategory/upperCase/fractal_cn_rare"
msgstr "BEDNA ZÁSOB S NEBESKOU POMOCÍ"

msgid "entryPoint/tooltip/description"
msgstr "Jedná se o speciální bedny obsahující nové a jedinečné předměty. Lze je získat v herním obchodě."

msgid "entryPoint/tooltip/timerText"
msgstr "Akce skončí za"

msgid "eventName/lowerCase"
msgstr "Boží požehnání"

msgid "eventName/upperCase"
msgstr "BOŽÍ POŽEHNÁNÍ"

msgid "guaranteed/tooltip/description1/"
msgstr "Pokud již vlastníte všechna vozidla, obdržíte místo toho požehnanou bednu zásob."

msgid "infoPage/footer/description/compensation"
msgstr "Pokud již všechna vozidla z bedny vlastníte, obdržíte jako zaručenou odměnu namísto vozidla požehnanou bednu zásob."

msgid "infoPage/footer/description/guaranteed"
msgstr "Každá %(guaranteed0)s. nebeská bedna zásob, %(guaranteed1)s. bedna zásob s nebeskou pomocí a %(guaranteed2)s. vyvolená bedna zásob zaručeně obsahuje vozidlo. Pokud daný počet beden otevřete aniž by vám takové vozidlo padlo, pak při otevření %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. bedny padne v závislosti na typu bedny vozidlo, které ještě nevlastníte. Až k tomu dojde, počítadlo se vynuluje."

msgid "infoPage/footer/title/compensation"
msgstr "Kompenzace"

msgid "infoPage/footer/title/guaranteed"
msgstr "Zaručená odměna"

msgid "infoPage/header/rewards/description"
msgstr "Z každé skupiny může padnout nanejvýš jedna odměna"
