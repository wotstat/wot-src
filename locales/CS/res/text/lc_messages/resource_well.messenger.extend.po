msgid "serviceChannelMessages/resourceWell/enabled/text"
msgstr "Montovna se opět otevírá!"

msgid "serviceChannelMessages/resourceWell/end/text"
msgstr "Začínáme pracovat na dalším projektu. Dáme vám vědět, až vývoj skončí. Brzo na viděnou!"

msgid "serviceChannelMessages/resourceWell/end/title"
msgstr "Montovna se zavírá"

msgid "serviceChannelMessages/resourceWell/noSerialVehicles/text"
msgstr "Doručování vozidel s čísly dokončeno. Začínáme montáž stroje %(vehicle)s ve standardní konfiguraci. Pospěšte si – počet vozidel je omezen!"

msgid "serviceChannelMessages/resourceWell/noVehicles/text"
msgstr "Montáž vozidel dokončena. Všechna vozidla doručena novým majitelům."

msgid "serviceChannelMessages/resourceWell/noVehicles/title"
msgstr "Hlášení z Montovny"

msgid "serviceChannelMessages/resourceWell/noVehicles/twoParallelProducts/text"
msgstr "Dodání strojů %(soldOutVehicle)s je dokončeno. Stále máte příležitost si zakoupit stroj %(availableVehicle)s. Pokud jste utratili zdroje, ale včas nedokončili nákup, budou zdroje brzy vráceny na váš účet. Pospěšte si – počet vozidel je omezen!"

msgid "serviceChannelMessages/resourceWell/noVehiclesWithReturn/text"
msgstr "Montáž vozidel dokončena. Všechna vozidla doručena majitelům. Všechny utracené zdroje budou brzy vráceny na váš účet."

msgid "serviceChannelMessages/resourceWell/oneVehicleStart/text"
msgstr "Veliteli, máte šanci stát se majitelem stroje %(vehicle)s s očíslovaným 3D stylem. Počet vozidel je omezen!"

msgid "serviceChannelMessages/resourceWell/pause/text"
msgstr "Montovna je z důvodu údržby dočasně nedostupná."

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/additionalText"
msgstr "Číslo stylu: %(serialNumber)s"

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/text"
msgstr "Jedinečné vozidlo %(vehicle)s získané z Montovny."

msgid "serviceChannelMessages/resourceWell/reward/title"
msgstr "Stroj %(vehicle)s získán!"

msgid "serviceChannelMessages/resourceWell/reward/vehicle/text"
msgstr "Stroj %(vehicle)s získán z Montovny."

msgid "serviceChannelMessages/resourceWell/start/title"
msgstr "Montovna se otevírá"

msgid "serviceChannelMessages/resourceWell/twoVehiclesStart/text"
msgstr "Veliteli, tohle je vaše šance získat stroje %(firstVehicle)s a %(secondVehicle)s! Pospěšte si, zásoby jsou omezené!"
