msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "ระบบกันภัยนี้คือโรงประกอบเคลื่อนที่บนตีนตะขาบ มุมแหลม, การวางสายไฟอย่างสะอาดตา, ทุกระบบตอบสนองในการสั่งครั้งแรก เราเริ่มเคลื่อนที่ออกเพื่อหยุดยั้งนักวิทยาศาสตร์สติเฟื่องและต้องเผชิญกับสิ่งที่เขาเรียกว่าปัญญากระแสไฟฟ้า เหล่าองครักษ์ของเขากำลังเรียนรู้และจับตาดูทุกก้าวของเรา เขาสร้างมันขึ้นมาเพื่อมาแทนที่เรา ก็ได้ ถ้างั้นบทเรียนวันนี้จะมาจากผมเอง ผมจะหาชะง่อนผาแล้วเลือกเป้าหมายและให้กระสุนเหล่านี้ทำงานที่เหลือเอง ถ้าเขาเชื่อว่าเครื่องจักรคิดเองได้ของเขาสามารถเอาชนะพวกเรา เรามาดูกันว่ามันจะคิดอะไรเมื่อเจอกับแรงกดดัน"

