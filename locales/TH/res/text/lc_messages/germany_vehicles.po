msgstr "Großtraktor - Krupp"

msgid "G100_Gtraktor_Krupp_descr"
msgstr "ยานเกราะรบรุ่นทดลองถูกพัฒนาโดยบริษัท Krupp เพื่อให้เป็นรถถังกลาง ในปี 1929 มีการผลิตรถต้นแบบขึ้นสองคันด้วยเหล็กที่ไม่ได้ใช้ในการผลิตเกราะ และเข้ารับการทดสอบในสหภาพโซเวียตช่วงปี 1930 ถึง 1933 การทดสอบแสดงให้เห็นถึงข้อผิดพลาดบนตัวรถจำนวนมาก และยานเกราะรุ่นนี้ก็ไม่ได้เข้าประจำการ อย่างไรก็ดี ผลของการพัฒนายานเกราะรุ่นนี้ถูกนำไปใช้โดยวิศวกรเยอรมัน"

msgid "G100_Gtraktor_Krupp_long_special"
msgstr "รถถังกลางเยอรมันระดับ III ที่มีความคล่องตัวดี มุมกด/มุมยกที่ใช้ได้และปืนใช้กระสุนระเบิดแรงสูงอันทรงพลับที่ทำลายข้าศึกได้ด้วยการยิงเพียง 1 หรือ 2 นัด อย่างไรก็ตาม เกราะที่บางและขนาดที่ใหญ่ของมันทำให้ต้องทำการรบอย่างระวังและต้องพยายามหลีกเลี่ยงการรบระยะประชิด"

msgid "G100_Gtraktor_Krupp_short"
msgstr "Gr.Tr."

msgid "G100_Gtraktor_Krupp_short_special"
msgstr "ความเสียหายต่อนัดและมุมกด/มุมยกที่ดี กับความทนทานที่มากพอตัว"

msgid "G101_StuG_III"
msgstr "StuG III Ausf. B"

msgid "G101_StuG_III_descr"
msgstr "ในปี 1935 Erich von Manstein ซึ่งเป็นเจ้าหน้าที่เสนาธิการกองทัพบกเยอรมันได้ระบุในจดหมายถึงพลเอก Ludwig Beck ในแนวคิดการสร้างปืนทำลายป้อมปราการเพื่อสนับสนุนหน่วยทหารราบ มีการสร้างต้นแบบรุ่น \"0\" ขึ้นมาห้าคันในปี 1937 การดัดแปลงเบื้องต้นจาก Ausf.A ไปเป็น Ausf.F/8 ถูกผลิตขึ้นจนกระทั่งเดือนธันวาคม 1942"

msgid "G101_StuG_III_short"
msgstr "StuG III B"

msgid "G102_Pz_III"
msgstr "Pz.Kpfw. III Ausf. E"

msgid "G102_Pz_III_descr"
msgstr "คำสั่งการออกแบบยานเกราะตีนตะขาบขนาด 15 ตันพร้อมด้วยอาวุธปืนใหญ่ถูกประกาศในปี 1935 และถึงแม้ว่าน้ำหนักของ Pz. Kpfw. III Ausf. E ที่เป็นยานเกราะขนาดใหญ่จะหนักถึง 19.5 ตัน การปรับแต่งของมันถือว่าประสบความสำเร็จและจำนวนของยานเกราะก็เพิ่มถึง 96 คัน การดัดแปลงเพิ่มเติมทำให้ยานเกราะเป็นที่นิยมมากกว่าเดิม และ Pz. Kpfw. III ก็กลายเป็นยานเกราะที่ผลิตจำนวนมากที่สุดของกองทัพเยอรมัน"

msgid "G102_Pz_III_short"
msgstr "Pz. III E"

msgid "G103_RU_251"
msgstr "Spähpanzer Ru 251"

msgid "G103_RU_251_descr"
msgstr "พาหนะรุ่นนี้ถูกพัฒนาขึ้นโดยใช้รากฐานของยานพิฆาตรถถัง Kanonenjagdpanzer 4-5 ออกแบบโดยบริษัท Henschel ในปี 1964 รถถังรุ่นนี้ถูกวางแผนไว้ให้มาทดแทนรถถัง M41 Walker Bulldog ที่ล้าสมัยที่ถูกใช้โดยกองพันลาดตระเวณของกองพลยานเกราะในกองทัพบกเยอรมัน รถถังรุ่นนี้ไม่ได้เข้าสายการผลิตจำนวนมาก แต่ก็มีนวัตกรรมบางส่วนถูกนำมาใช้ภายหลังในการพัฒนาพาหนะรุ่นอื่น ไม่มีบันทึกยอดการผลิตของรถต้นแบบรุ่นนี้"

msgid "G103_RU_251_short"
msgstr "Ru 251"

msgid "G104_Stug_IV"
msgstr "StuG IV"

msgid "G104_Stug_IV_descr"
msgstr "ในเดือนกุมภาพันธ์ 1943 ตามการชี้นำของกระทรวงสรรพาวุธ บริษัท Krupp ก็ได้เริ่มการทดสอบพาหนะใหม่ที่ใช้โครงส่วนบนของ StuG III ที่ปรับปรุงแล้ว และช่วงล่างของ Pz.Kpfw. IV H และ J รวมด้วยกัน พาหนะคันแรกๆถูกผลิตขึ้นในเดือนธันวาคม 1943 และหลังจากที่ได้ยกเลิกการผลิต Pz. IV บริษัท Krupp ก็ได้เน้นความสนใจไปในการผลิตพาหนะรุ่นใหม่นี้โดยเริ่มในเดือนมกราคม 1944 มียอดการผลิต 1,108 คัน โดยมี 31 คันที่ผลิตจากการดัดแปลงรถถังที่มีอยู่แล้ว"

msgid "G104_Stug_IV_long_special"
msgstr "ยานพิฆาตรถถังเยอรมันระดับ V ที่มีค่าการเจาะเกราะ ความแม่นยำและการอำพรางดี ยานเกราะคันนี้เป็นหน่วยซุ่มยิงที่สมบูรณ์แบบซึ่งจะสร้างปัญหากับกองทัพข้าศึกได้เป็นอย่างดีในขณะที่ไม่ถูกพบ ข้อเสียหลักของยานเกราะคันนี้คือเกราะที่บาง"

msgid "G104_Stug_IV_short"
msgstr "StuG IV"

msgid "G104_Stug_IV_short_special"
msgstr "ปืนที่แม่นยำมีอัตราการยิงสูงและการอำพรางตัวที่สมบูรณ์แบบ"

msgid "G105_T-55_NVA_DDR"
msgstr "T-55A"

msgid "G105_T-55_NVA_DDR_descr"
msgstr "รุ่นยกระดับของรถถัง T-55 โดย T-55A มีระดับการป้องกันนิวเคลียร์ที่สูงกว่าและไม่มีปืนกลติดตัวถังรถ จากช่วงปี 1962 ถึง 1970 มียอดการผลิตรถถัง T-55 และ T-55A รวมกัน 1,800 คันที่สหภาพโซเวียตส่งมอบให้เยอรมันตะวันออก"

msgid "G105_T-55_NVA_DDR_long_special"
msgstr "รถถังกลางเยอรมันระดับ IX มีปืนที่ใช้ได้ดี รูปทรงที่ต่ำและความคล่องตัวปานกลาง บทบาทหลักของรถถังคันนี้ในการรบคือการเข้ายึดจุดยิงสำคัญ ตรวจจับพาหนะข้าศึกและช่วยสนับสนุนในการบุก แม้ว่าป้อมปืนจะสามารถสะท้อนกระสุนได้ มุมกด/มุมยกที่ต่ำของรถถังทำให้ไม่สามารถใช้ภูมิประเทศเป็นที่กำบังได้ดีนัก"

msgid "G105_T-55_NVA_DDR_short"
msgstr "T 55A"

msgid "G105_T-55_NVA_DDR_short_special"
msgstr "ปืนที่ดีพอตัว ระยะการมองเห็นที่ดี รูปทรงที่ต่ำและขนาดที่เล็ก"

msgid "G106_PzKpfwPanther_AusfF"
msgstr "Panther mit 8,8 cm L/71"

msgid "G106_PzKpfwPanther_AusfF_descr"
msgstr "การพัฒนารุ่นดัดแปลงรถถัง Panther เริ่มขึ้นในฤดูใบไม้ผลิปี 1944 รุ่นดัดแปลงใหม่นี้ถูกวางแผนที่จะประกอบป้อมปืน Schmalturm ที่ออกแบบใหม่เข้าไป และจะได้นามเรียกขานของรถถังรุ่นนี้ว่า Panther Ausf. F. ในวันที่ 23 มกราคม 1945 มีรายงานว่าปืน 88 มม.ของรถถัง King Tiger ถูกติดตั้งบนป้อมปืนใหม่ มีการผลิตตัวถังรถถังรุ่นนี้มาเป็นจำนวนมากแต่ไม่มีการผลิตป้อมปืนและคงอยู่ในรูปแบบจำลองไม้เท่านั้น"

msgid "G106_PzKpfwPanther_AusfF_long_special"
msgstr "ระยะการมองเห็นที่ดีและปืนที่พึ่งพาได้ทำให้รถถังคันนี้เป็นยานสนับสนุนที่สมบูรณ์แบบ ในขณะเดียวกัน ถ้าข้าศึกเข้าใกล้เกินไป รถถังคันนี้ก็สามารถยืนหยัดในการรบประชิดได้จากน้ำหนักที่มากและความสามารถในการพุ่งชนที่มีประสิทธิภาพ"

msgid "G106_PzKpfwPanther_AusfF_short"
msgstr "Panther 8,8"

msgid "G106_PzKpfwPanther_AusfF_short_special"
msgstr "ปืนและระยะการมองเห็นที่ดี ความสามารถในการพุ่งชนที่มีประสิทธิภาพ"

msgid "G107_PzKpfwIII_AusfK"
msgstr "Pz.Kpfw. III Ausf. K"

msgid "G107_PzKpfwIII_AusfK_descr"
msgstr "รถถังรุ่นนี้ถูกพัฒนาบนฐานของตัวถัง Pz. Kpfw. III Ausf. J รุ่นหลัง โดยรวมเข้ากับป้อมปืน Pz.Kpfw. IV Ausf. F2 และปืนขนาด 75 มม. แปลนการออกแบบแรกนั้นเสร็จสิ้นในเดือนธันวาคม 1941 มีการเริ่มผลิตแต่รถถังรุ่นนี้มีความซับซ้อนมากเกินไปและการผลิตก็ถูกหยุดลง มียอดการผลิตทั้งหมด 50 คันและถูกใช้เป็นรถถังบัญชาการอีกทั้งยังติดตั้งปืน 50 มม. และไม่มีคันใดได้ติดตั้งปืน 75 มม."

msgid "G107_PzKpfwIII_AusfK_long_special"
msgstr "รถถังกลางเยอรมันระดับ V มีปืนที่อัตราการยิงสูงและมีมุมกด/มุมยกที่ดี บทบาทหลักของรถถังในการรบคือการสนับสนุนพันธมิตรในการบุกและการยิงควบคุมแนวรบ เกราะที่บางและความแม่นยำที่ต่ำทำให้รถถังคันนี้เหมาะกับการต่อสู้จากแนวยิงที่สองมากกว่า"

msgid "G107_PzKpfwIII_AusfK_short"
msgstr "Pz. III K"

msgid "G107_PzKpfwIII_AusfK_short_special"
msgstr "ปืนอัตราการยิงสูงและมุมกด/มุมยกที่ดี"

msgid "G108_PzKpfwII_AusfD"
msgstr "Pz.Kpfw. II Ausf. D"

msgid "G108_PzKpfwII_AusfD_descr"
msgstr "การปรับแก้อย่างเร่งด่วนของ Pz. II ซึ่งมีไว้ให้กองพลยานเกราะเบาที่แปลงมาจากกองพลทหารม้า Pz.Kpfw.II Ausf D นั้นมีตัวถังและช่วงล่างใหม่ ส่วนป้อมปืนและปืนใหญ่นั้นถอดแบบมาจาก Ausf. C ระบบช่วงล่างมีล้อคู่ใหญ่แปดล้อและมีเพลารับน้ำหนักอิสระสำหรับแต่ละล้อและไม่มีลูกกลิ้งเสริม รถถังบางคันมีการใช้ช่วงล่างใหม่โดยเพิ่มล้อขับเคลื่อนและถูกระบุเป็น Ausf. E ตามแหล่งข้อมูลหลายแปล่ง มียอดการผลิตรุ่น D และ E รวมกัน 200-250 คัน"

msgid "G108_PzKpfwII_AusfD_long_special"
msgstr "รถถังเบาเยอรมันระดับ II มีความคล่องตัวที่ดีและความทนทานที่สูงสำหรับระดับนี้ รถถังสามารถสนับสนุนการโจมตีหรือปฏิบัติหน้าที่เป็นหน่วยชี้เป้าไม่เผยตัวได้แต่เกราะของมันบางอย่างมากและจะไม่สามารถช่วยคุณได้แม้จะโดนยิงด้วยปืนกลก็ตาม"

msgid "G108_PzKpfwII_AusfD_short"
msgstr "Pz. II D"

msgid "G108_PzKpfwII_AusfD_short_special"
msgstr "ความคล่องตัวที่ดี ความทนทานที่มากกับปืนอัตราการยิงสูง"

msgid "G109_Steyr_WT"
msgstr "Krupp-Steyr Waffenträger"

msgid "G109_Steyr_WT_descr"
msgstr "โครงการพาหนะโดย Steyr เพื่อเป็นยานขนส่งปืนใหญ่พิเศษที่ไม่เพียงขนส่งปืนได้แต่ยังทำการยิงจากตัวรถได้ด้วย ในการลดค่าใช้จ่ายและความซับซ้อนลง การออกแบบใช้ส่วนประกอบจำนวนมากจาก Raupenschlepper Ost ซึ่งเป็นยานตีนตะขาบเคลื่อนย้ายปืนใหญ่ ส่วนป้อมปืนและปืนถูกผลิตโดย Krupp มีการผลิตโครงไม้และรถต้นแบบขึ้นอย่างละคันภายในวันที่ 2 กันยายน 1944"

msgid "G109_Steyr_WT_long_special"
msgstr "นีคือยานพิฆาตรถถังซุ่มโจมตีที่มีการซ่อนตัวที่ดี ปืนที่มีใช้ได้และมุมการยิงที่ดีจะมีประโยชน์ในการต่อกรกับพาหนะข้าศึกทุกแบบ อย่างไรก็ตาม พยายามอยู่ห่างการรบประชิดเอาไว้ เพราะยานพิฆาตรถถังคันนี้แทบจะไม่มีเกราะเลย"

msgid "G109_Steyr_WT_short"
msgstr "Steyr WT"

msgid "G109_Steyr_WT_short_special"
msgstr "ปืนที่ยอดเยี่ยม การซ่อนตัวที่ดี"

msgid "G10_PzIII_AusfJ"
msgstr "Pz.Kpfw. III Ausf. J"

msgid "G10_PzIII_AusfJ_descr"
msgstr "การผลิตของรุ่น J นั้นเริ่มต้นในเดือนมีนาคม 1941 นอกเหนือไปจากเกราะที่หนาคืน รถถังรุ่นนี้ยังได้รับการติดตั้งปืน KwK 38 ใหม่ขนาด 50 มม. ซึ่งถือว่าเป็นการตัดสินใจที่ประสบความสำเร็จอย่างมาก อีก 1,067 คันที่เหลือทำการติดตั้งปืน KwK 39 เอาไว้ ซึ่งเป็นรุ่นปรับปรุงที่มีอัตราการเจาะเกราะที่สูงกว่า การติดตั้งปืนขนาด 75 มม. (รุ่น N) ถือว่าไม่ประสบความสำเร็จและยานเกราะขนาดใหญ่คือรุ่น J L และ M ได้รับการติดตั้งปืน 50 มม. ที่มีประวัติยอดเยี่ยมเช่นกัน มียอดการผลิตทั้งหมด 5,691 คันซึ่งในจำนวน 1,969 คันได้รับการติดตั้งปืนลำกล้องยาวและ 2,391 คันได้รับการติดตั้งปืนลำกล้องสั้นขนาด 50 มม."

msgid "G10_PzIII_AusfJ_short"
msgstr "Pz. III J"

msgid "G110_Typ_205"
msgstr "Mäuschen"

msgid "G110_Typ_205_descr"
msgstr "ในฤดูร้อนปี 1942 บริษัท Porsche ได้รับคำสั่งพัฒนารถถังบุกทะลวงที่มีการป้องกันสูงสุดที่เป็นไปได้และปืนที่ทรงพลัง หนึ่งในผลการพัฒนาของรถถังหนักยิ่งยวด Maus คือ Typ 205 Mäuschen ซึ่งเป็นโครงการออกแบบที่มีโครงสร้างภายในเหมือนกัน มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G110_Typ_205_short"
msgstr "Mäuschen"

msgid "G112_KanonenJagdPanzer"
msgstr "Kanonenjagdpanzer"

msgid "G112_KanonenJagdPanzer_105"
msgstr "Kanonenjagdpanzer 105"

msgid "G112_KanonenJagdPanzer_105_descr"
msgstr "รถต้นแบบคันแรกของ Kanonenjagdpanzer ถูกประกอบขึ้นในปี 1960 โดยบริษัท Hanomag และ Henschel ให้กับสหพันธ์สาธารณรัฐเยอรมนี การผลิตจำนวนมากดำเนินจนถึงปี 1967 มียอดการผลิตทั้งหมด 770 คันสำหรับกองทัพเยอรมันและ 80 คันสำหรับกองทัพเบลเยี่ยม ในปี 1983 นั้นพาหนะคันนี้ถือว่าล้าสมัย โดยจากความเห็นของวิศวกรแล้วบางคันนั้นสามารถติดตั้งปืนขนาด 105 มม.ได้แต่ท้ายที่สุดพาหนะเหล่านี้ก็ถูกแปลงเป็นยานสังเกตการณ์สำหรับปืนใหญ่หรือยานปล่อยขีปนาวุธต่อต้านรถถัง Kanonenjagdpanzer (หรือในอีกชื่อหนึ่งคือ Jagdpanzer Kanone 90mm) ยังคงประจำการในกองกำลังทหารประชาชนจนถึงปี 1990"

msgid "G112_KanonenJagdPanzer_105_long_special"
msgstr "ยานพิฆาตรถถังเยอรมันที่ว่องไวและแทบล่องหนด้วยรูปทรงที่ต่ำและมีปืนที่มีประสิทธิภาพ คุณลักษณะความคล่องตัวของมันทำให้สามารถเข้าตำแหน่งที่ได้เปรียบบนแผนที่ใดก็ตามได้อย่างรวดเร็วเพื่อยิงสนับสนุนพันธมิตร การพึ่งพาเกราะให้รอดจากการรบไม่ใช่ตัวเลือกที่ดีอย่างแน่นอนฉะนั้นการป้องกันที่ดีที่สุดคือพยายามเคลื่อนที่ตลอดเวลา"

msgid "G112_KanonenJagdPanzer_105_short"
msgstr "KanJPz 105"

msgid "G112_KanonenJagdPanzer_105_short_special"
msgstr "ความคล่องตัวที่สูงและการซ่อนตัวที่ดี"

msgid "G112_KanonenJagdPanzer_descr"
msgstr "รถต้นแบบคันแรกของ Kanonenjagdpanzer ซึ่งรู้จักกันในอีกชื่อหนึ่งว่า Jagdpanzer Kanone 90mm ถูกผลิตในปี 1960 โดยบริษัท Hanomag Henschel ของเยอรมนี สำหรับ FRG การผลิตดำเนินการจนถึงปี 1967 มียอดการผลิตทั้งหมด 770 คันสำหรับกองทัพเยอรมันและ 80 คันสำหรับกองกำลังติดอาวุธเบลเยี่ยม แต่ในปี 1985 รถรุ่นนี้ถือว่าล้าสมัยแล้ ยานพิฆาตรถถังบางส่วนถูกแปลงเป็นพาหนะสังเกตการณ์ให้กับปืนใหญ่ ส่วนบางคันถูกแปลงเป็นฐานยิงขีปนาวุธนำวิถีต่อต้านรถถังเคลื่อนที่ อย่างไรก็ตาม Kanonenjagdpanzer ก็ยังคงประจำการจนถึงปี 1990"

msgid "G112_KanonenJagdPanzer_long_special"
msgstr "ยานพิฆาตรถถังเยอรมันที่ว่องไวและแทบล่องหนด้วยรูปทรงที่ต่ำและมีปืนที่ยิงเร็วติดตั้งในห้องทำการรบแบบอยู่กับที่ คุณลักษณะความคล่องตัวของมันทำให้สามารถเข้าตำแหน่งที่ได้เปรียบบนแผนที่ใดก็ตามได้อย่างรวดเร็วเพื่อยิงสนับสนุนพันธมิตร การพึ่งพาเกราะให้รอดจากการรบไม่ใช่ตัวเลือกที่ดีอย่างแน่นอนฉะนั้นการป้องกันที่ดีที่สุดคือพยายามเคลื่อนที่ตลอดเวลา"

msgid "G112_KanonenJagdPanzer_short"
msgstr "KanJPz"

msgid "G112_KanonenJagdPanzer_short_special"
msgstr "ความคล่องตัวที่สูงและการซ่อนตัวที่ดี"

msgid "G113_SP_I_C"
msgstr "Spähpanzer SP I C"

msgid "G113_SP_I_C_descr"
msgstr "ยานพิฆาตรถถังสอดแนมถูกพัฒนาขึ้นโดยบริษัท Hotchkiss และ Klöckner-Humboldt-Deutz ตั้งแต่ช่วง 1956 ถึง 1962 เพื่อเพิ่มความสามารถในการต่อต้านรถถังของกองพันรถถังสอดแนม มีการวางแผนติดตั้งปืนใหญ่ต่อต้านรถถัง 90 มม.บนตัวรถ แต่โครงการก็หยุดลงในเวลาต่อมา ไม่มีการระบุจำนวนการผลิตรถต้นแบบเอาไว้"

msgid "G113_SP_I_C_short"
msgstr "SP I C"

msgid "G114_Rheinmetall_Skorpian"
msgstr "Rheinmetall Skorpion G"

msgid "G114_Rheinmetall_Skorpian_descr"
msgstr "การพัฒนาปืนอัตตาจรชุดที่สองโดยใช้ฐานของรถถัง Panther เริ่มขึ้นโดยบริษัท Rheinmetall ในเดือนมกราคม 1943 การออกแบบ Skorpion ติดตั้งปืน 12.8 ซม.นั้นเสร็จสิ้นในวันที่ 2 เมษายน 1943 มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G114_Rheinmetall_Skorpian_long_special"
msgstr "ยานพิฆาตรถถังที่มีคุณลักษณะความคล่องตัวที่ดีและปืนที่ยอดเยี่ยมติดตั้งบนป้อมปืนหมุนรอบตัว พาหนะคันนี้สามารถเข้าตำแหน่งยิงที่ได้เปรียบได้ในพริบตาและเริ่มทำการยิงโดยไม่ต้องหมุนตัวถัง อย่างไรก็ตาม เกราะที่บางของยานพิฆาตรถถังคันนี้ทำให้มันเป็นเป้าหมายชั้นดีของกระสุนระเบิดแรงสูงของข้าศึก"

msgid "G114_Rheinmetall_Skorpian_short"
msgstr "Skorpion G"

msgid "G114_Rheinmetall_Skorpian_short_special"
msgstr "ปืนที่ทรงพลังและป้อมปืนหมุนรอบตัว"

msgid "G114_Skorpian"
msgstr "Rheinmetall Skorpion"

msgid "G114_Skorpian_descr"
msgstr "การพัฒนาปืนอัตตาจรชุดที่สองโดยใช้ฐานของรถถัง Panther เริ่มขึ้นโดยบริษัท Rheinmetall ในเดือนมกราคม 1943 การออกแบบ Skorpion ติดตั้งปืน 12.8 ซม.นั้นเสร็จสิ้นในวันที่ 2 เมษายน 1943 มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G114_Skorpian_long_special"
msgstr "ยานพิฆาตรถถังที่ทรงพลังนี้ติดตั้งป้อมปืนหมุนได้รอบตัวและปืนที่มีประสิทธิภาพ และด้วยคุณลักษณะนี้ พาหนะนี้จะสามารถเข้าประจำตำแหน่งที่เหมาะสมในเวลาที่เหมาะ พร้อมที่จะทำความเสียหายจำนวนมากที่ระยะใดก็ได้ แต่อย่าประมาทเกราะที่บางของมันและพยายามเลี่ยงการรบประชิดให้มากที่สุด"

msgid "G114_Skorpian_short"
msgstr "Skorpion"

msgid "G114_Skorpian_short_special"
msgstr "ความแม่นยำที่ดี ความเสียหายต่อนัดที่สูง"

msgid "G115_Typ_205B"
msgstr "VK 100.01 (P)"

msgid "G115_Typ_205B_descr"
msgstr "รุ่นของ Maus ในช่วงวันที่ 4 มิถุนายน 1942 เป็นรุ่นก่อนหน้าของรถถังหนักยิ่งยวด 120 ตันที่มีอยู่ในพิมพ์เขียวเท่านั้นและไม่ได้เข้าประจำการ พาหนะรุ่นนี้เป็นเพียงช่วงระหว่างการพัฒนาของ Maus"

msgid "G115_Typ_205B_short"
msgstr "VK 100.01 P"

msgid "G115_Typ_205_4_Jun"
msgstr "VK 100.01 (P) Ausf. B"

msgid "G115_Typ_205_4_Jun_descr"
msgstr "รุ่นของ Maus ในช่วงวันที่ 4 มิถุนายน 1942 เป็นรุ่นก่อนหน้าของรถถังหนักยิ่งยวด 120 ตันที่มีอยู่ในพิมพ์เขียวเท่านั้นและไม่ได้เข้าประจำการ พาหนะรุ่นนี้เป็นเพียงช่วงระหว่างการพัฒนาของ Maus"

msgid "G115_Typ_205_4_Jun_long_special"
msgstr "รถถังหนักเยอรมันระดับ VIII ที่มีการเจาะเกราะและความเสียหายต่อนัดสูงอีกทั้งมีมุมกด/มุมยกที่ดี เกราะที่แข็งแกร่งและความทนทานที่พอตัว รถถังสามารถต้านทานกระสุนและยิงสวนกลับได้อย่างดีแต่ด้วยขนาดที่ใหญ่และความคล่องตัวที่ต่ำทำให้มันเป็นเป้าหมายหลักของหน่วยซุ่มยิงข้าศึก"

msgid "G115_Typ_205_4_Jun_short"
msgstr "VK 100.01 B"

msgid "G115_Typ_205_4_Jun_short_special"
msgstr "อำนาจการยิงที่ดีและเกราะที่ทนทาน"

msgid "G116_Turan_III_prot"
msgstr "Turán III prototípus"

msgid "G116_Turan_III_prot_descr"
msgstr "รถต้นแบบของรถถังกลางฮังการีในสงครามโลกครั้งที่สอง รถถังคันนี้มีปืนใหญ่ลำกล้องยาว 75mm 43.M และเกราะรุ่นปรับปรุงเมือ่เทียบกับรุ่นก่อนหน้า ไม่ได้เข้าสายการผลิตจำนวนมากเนื่องจากการหยุดผลิตพาหนะในฮังการีในช่วงฤดูร้อนปี 1944"

msgid "G116_Turan_III_prot_long_special"
msgstr "รถถังกลางเยอรมันระดับ V มีมุมกด/มุมยกปืนที่ดีอีกทั้งมีความแม่นยำ อัตราการยิงและความเร็วการเล็งสูง รถถังคันนี้ใช้ได้ดีที่สุดเมื่อยิงต่อสู้จากที่กำบังเพราะมีเกราะที่บางและความคล่องตัวที่ปานกลางนั้นทำให้ต้องหลีกเลี่ยงการรบระยะประชิด"

msgid "G116_Turan_III_prot_short"
msgstr "Turán III PT"

msgid "G116_Turan_III_prot_short_special"
msgstr "ปืนที่ทรงพลังและมุมกด/มุมยกที่ดี"

msgid "G117_Toldi_III"
msgstr "43 M. Toldi III"

msgid "G117_Toldi_III_descr"
msgstr "รุ่นปรับแต่งของรถถังเบา 38M Toldi I รถถังรุ่นนี้ถูกตั้งชื่อตามอัศวินฮังการี Miklos Toldi รถถังรุ่นนี้มีเกราะรุ่นปรับปรุงและพิกัดกระสุนมากกว่าเดิมเมื่อเทียบกับรุ่นก่อนหน้า มียอดการผลิตประมาณ 12 คันในช่วงสงครามโลกครั้งที่สอง"

msgid "G117_Toldi_III_long_special"
msgstr "รถถังเบาเยอรมันระดับ III มีความคล่องตัวและการอำพรางที่ดี ระยะการมองเห็นที่ต่ำทำให้มันไม่สามารถตรวจจับข้าศึกได้ดีนักแต่จุดเด่นของรถถังนั้นอยู่ที่ความสามารถในการเข้าจุดยิงและช่วยทีมในการบุกหรือตั้งรับได้อย่างรวดเร็ว"

msgid "G117_Toldi_III_short"
msgstr "Toldi III"

msgid "G117_Toldi_III_short_special"
msgstr "ความคล่องตัวและการอำพรางที่ใช้ได้และมีการเจาะเกราะที่ดี"

msgid "G118_VK4503"
msgstr "VK 45.03"

msgid "G118_VK4503_descr"
msgstr "รถถังหนักที่ถูกพัฒนาขึ้นในช่วงสิ้นสุดสงครามโลกครั้งที่สอง โครงการได้รับนามเรียกขานว่า Tiger III (VK 45.03) ในวันที่ 12 ตุลาคม 1942 มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G118_VK4503_long_special"
msgstr "ปืนเยอรมันและระยะการมองเห็นที่ดีเป็นจุดเด่นหลักของพาหนะคันนี้ซึ่งสามารถยิงข้าศึกได้จากระยะใดก็ได้ แต่เกราะบนตัวรถนั้นค่อนข้างบาง ฉะนั้นผู้เล่นควรจะหลีกเลี่ยงการรบประชิดและระวังตัวให้ดี"

msgid "G118_VK4503_short_special"
msgstr "ปืนที่ใช้ได้และความสามารถอยู่รอดที่ดี"

msgid "G119_Panzer58"
msgstr "Panzer 58"

msgid "G119_Panzer58_BF"
msgstr "Schwarzpanzer 58"

msgid "G119_Panzer58_BF_descr"
msgstr "โครงการรถถังกลางสวิสที่มีคุณลักษณะการรบแบบปรังปรุงและความสามารถที่จะทำการรบในพื้นที่ภูเขา เริ่มพัฒนาในปี 1953 มีแผนที่จะใช้ปืนใหญ่จากรถถัง Centurion ของอังกฤษ มีรถต้นแบบสองคันและรถถังอีกสิบคันถูกผลิตขึ้น แต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "G119_Panzer58_BF_long_special"
msgstr "รถถังกลางที่รวดเร็วและว่องไวคันนี้เป็นยานเกราะสนับสนุนที่สมบูรณ์แบบ มันติดตั้งปืนที่เจาะเกราะได้ดีและมีมุมกด/มุมยกที่น่าประทับใจ เกราะหน้าของมันเป็นแผ่นลาดเอียงที่สามารถสะท้อนกระสุนได้ในบางครั้ง"

msgid "G119_Panzer58_BF_short"
msgstr "Schwarzpz.58"

msgid "G119_Panzer58_BF_short_special"
msgstr "ความคล่องตัวและระยะการมองเห็นที่ดี ปืนที่ใช้ได้"

msgid "G119_Panzer58_FL"
msgstr "Panzer 58 FL"

msgid "G119_Panzer58_FL_short"
msgstr "Pz. 58 FL"

msgid "G119_Panzer58_descr"
msgstr "โครงการรถถังกลางสวิสที่มีคุณลักษณะการรบแบบปรังปรุงและความสามารถที่จะทำการรบในพื้นที่ภูเขา เริ่มพัฒนาในปี 1953 มีแผนที่จะใช้ปืนใหญ่จากรถถัง Centurion ของอังกฤษ มีรถต้นแบบสองคันและรถถังอีกสิบคันถูกผลิตขึ้น แต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "G119_Panzer58_long_special"
msgstr "รถถังกลางคันที่รวดเร็วและคล่องตัวคันนี้เป็นหน่วยสนับสนุนที่สมบูรณ์แบบ เพราะมีปืนที่เจาะเกราะและมุมกด/มุมยกปืนที่ดี เกราะหน้าลาดเอียงของรถถังยังสามารถเบี่ยงกระสุนข้าศึกได้ในบางโอกาสด้วย"

msgid "G119_Panzer58_short"
msgstr "Pz. 58"

msgid "G119_Panzer58_short_special"
msgstr "ความคล่องตัวและระยะการมองเห็นที่ดี ปืนที่ใช้ได้"

msgid "G119_Pz58_Mutz"
msgstr "Panzer 58 Mutz"

msgid "G119_Pz58_Mutz_descr"
msgstr "พัฒนาขึ้นในปี 1953 ที่สวิสเซอร์แลนด์ รถต้นแบบคันแรกของรถถังรุ่นนี้ติดตั้งปืนขนาด 90 มม. เอาไว้ รถต้นแบบคันที่สองมีการติดตั้งปืน 20 ปอนด์ของอังกฤษในภายหลัง ที่สุดแล้ว มีการผลิตรถถังจำนวน 10 คัน โดยติดตั้งปืนขนาด 105 มม. และเข้าประจำการจนกระทั่งปี 1964 หลังจากนั้น รถถังก็ได้ถูกใช้เป็นรากฐานของการผลิต Panzer 61 รถถัง Panzer 58 คันเดียวที่ยังคงหลงเหลืออยู่มีการติดตั้งปืนขนาด 20 ปอนด์เอาไว้และถูกเก็บไว้ที่พิพิธภัณฑ์รถถังใน Thun กรุง Bern"

msgid "G119_Pz58_Mutz_long_special"
msgstr "รถถังกลางคันที่รวดเร็วและคล่องตัวคันนี้เป็นหน่วยสนับสนุนที่สมบูรณ์แบบ เพราะมีปืนที่เจาะเกราะและมุมกด/มุมยกปืนที่ดี เกราะหน้าลาดเอียงของรถถังยังสามารถเบี่ยงกระสุนข้าศึกได้ในบางโอกาสด้วย"

msgid "G119_Pz58_Mutz_short"
msgstr "Pz. 58 Mutz"

msgid "G119_Pz58_Mutz_short_special"
msgstr "ความคล่องตัวและระยะการมองเห็นที่ดี ปืนที่ใช้ได้"

msgid "G120_M41_90"
msgstr "leKpz M 41 90 mm"

msgid "G120_M41_90_GrandFinal"
msgstr "leKpz M 41 90 mm GF"

msgid "G120_M41_90_GrandFinal_descr"
msgstr "รุ่นเยอรมันของรถถังเบาสหรัฐฯ M41A1 Walker Bulldog การเปลี่ยนแปลงหลักๆ อยู่ที่การเปลี่ยนขนาดลำกล้องปืน M32 ขนาด 76 มม. โดยได้รับการเจาะลำกล้องใหม่เป็นขนาด 90 มม.และตัดให้สั้นลง 425 มม."

msgid "G120_M41_90_GrandFinal_long_special"
msgstr "ยานเกราะคันนี้เป็นรถถังเบาสนับสนุนมากกว่าหน่วยลาดตระเวนเนื่องด้วยปืนที่ทรงพลังและขนาดที่ใหญ่ รถถังมีกระสุนระเบิดแรงสูงที่เจาะเกราะได้มาก และสมบูรณ์แบบสำหรับการทำลายข้าศึกที่มีเกราะบาง"

msgid "G120_M41_90_GrandFinal_short"
msgstr "M 41 90 GF"

msgid "G120_M41_90_GrandFinal_short_special"
msgstr "ปืนที่ยอดเยี่ยมและความคล่องตัวที่ดี"

msgid "G120_M41_90_descr"
msgstr "รุ่นดัดแปลงของรถถังเบาสหรัฐฯ M41A1 Walker Bulldog โดยเยอรมัน การเปลี่ยนแปลงหลักคือการติดตั้งปืน M32 ขนาด 76 มม. ซึ่งขยายออกไป 90 มม.และสั้นลง 425 มม."

msgid "G120_M41_90_long_special"
msgstr "ยานเกราะคันนี้เป็นรถถังเบาสนับสนุนมากกว่าหน่วยลาดตระเวนเนื่องด้วยปืนที่ทรงพลังและขนาดที่ใหญ่ รถถังมีกระสุนระเบิดแรงสูงที่เจาะเกราะได้มาก และสมบูรณ์แบบสำหรับการทำลายข้าศึกที่มีเกราะบาง"

msgid "G120_M41_90_short"
msgstr "M 41 90 mm"

msgid "G120_M41_90_short_special"
msgstr "ปืนที่ยอดเยี่ยมและความคล่องตัวที่ดี"

msgid "G121_Grille_15_L63"
msgstr "Grille 15"

msgid "G121_Grille_15_L63_descr"
msgstr "ในช่วงฤดูร้อนปี 1942 Waffenamt (หน่วยสรรพาวุธกองทัพบกเยอรมัน) ได้สรุปข้อตกลงกับบริษัท Krupp และ Rheinmetall สำหรับการออกแบบยานพิฆาตรถถังบนตัวถังของรถถัง Panther โดยมีการวางแผนติดตั้งปืนใหญ่ K 43 ขนาด 128 มม. หรือปืนใหญ่สนาม sFH 43 ขนาด 150 มม. บนตัวรถ โครงการได้รับนามเรียกขาน Grille 12 และ Grille 15 โดยมีการวางห้องทำการรบไว้ทางด้านหลัง และต่างกันเพียงแค่ขนาดของระบบปืนใหญ่ ต่อมา Grille 15 ได้รับการติดตั้งปืน 150 มม. มีความยาวลำกล้องขนาด 63 ที่สามารถเจาะเกราะหนา 200 มม. ได้ที่ระยะ 4,000 เมตร อย่างไรก็ตาม การพัฒนาเป็นไปได้ช้าและ Grille 15 ก็มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G121_Grille_15_L63_short"
msgstr "Grille 15"

msgid "G122_VK6501H"
msgstr "VK 65.01 (H)"

msgid "G122_VK6501H_descr"
msgstr "วันที่ 19 มกราคม 1939 แผนกยานเกราะและยุทโธปกรณ์เคลื่อนที่ (WaPrüf 6) ของหน่วยสรรพาวุธกองทัพเยอรมันได้ประกาศการพัฒนารถถัง 65 ตันขึ้น โดยบริษัท Henschel และ Krupp ได้รับคำสั่งให้ทำการผลิตพาหนะนำร่องในวันที่ 1 กันยายน 1939 หุ่นจำลองไม้ถูกสร้างขึ้นในเดือนเมษายน 1940 และตามแหล่งข่าวหลายแห่ง มีการผลิตรถต้นแบบขึ้นอีกหนึ่งหรือสองคันโดยใช้เหล็กไม่หุ้นเกราะและไม่มีป้อมปืนในช่วงกลางปี 1941 ในปี 1942 การพัฒนาหยุดลงและรถต้นแบบถูกทำลาย"

msgid "G122_VK6501H_long_special"
msgstr "รถถังหนักเยอรมันพิเศษระดับ V ที่มีเกราะรอบตัวหนา 80 มม. แม้ว่าการวางเกราะจะทำให้พึ่งพาการป้องกันจากกระสุนของพาหนะระดับเดียวกันไม่ได้ตลอด แต่หากใช้ที่กำบังที่ดีแล้ว มันก็สามารถแสดงความโดดเด่นจากอัตราการยิงที่สูง ปืนที่แม่นยำและเล็งอย่างรวดเร็วได้"

msgid "G122_VK6501H_short"
msgstr "VK 65.01 (H)"

msgid "G122_VK6501H_short_special"
msgstr "ความเสียหายต่อนาที่ที่ใช้ได้และความแม่นยำที่ดี"

msgid "G124_Pz_Kpfw_38_K"
msgstr "Pz.Kpfw. 38 (K)"

msgid "G124_Pz_Kpfw_38_K_descr"
msgstr "ตัวเลือกสำหรับการปรับปรุงรถถัง Panzerkampfwagen 38(t) ให้ทันสมัยซึ่งเสนอในเดือนพฤศจิกายน 1944 โดยบริษัท Krupp เป้าหมายของโครงการคือการเพิ่มอำนาจการยิงด้วยการติดตั้งป้อมปืนแบบเรียบง่ายของรถถัง Pz.Kpfw. IV ด้วยปืน 7.5 cm Kw.K. 40 L/48 โครงการนี้ถูกหยุดลงในช่วงการออกแบบ"

msgid "G124_Pz_Kpfw_38_K_long_special"
msgstr "ส่วนผสมที่ดีของความคล่องตัวและอาวุธที่ไม่มีข้อด้อยชัดเจนใดๆทำให้ Pz.Kpfw. 38 (K) นั้นมีประโยชน์ในการรบเสมอ มันสามารถทำความเสียหายได้อย่างมีประสิทธิภาพและหากจำเป็นก็สามารถรับบทบาทของรถถังเบาได้"

msgid "G124_Pz_Kpfw_38_K_short"
msgstr "Pz. 38 (K)"

msgid "G124_Pz_Kpfw_38_K_short_special"
msgstr "ความคล่องตัวที่ดีและความว่องไวที่สูงกับปืนที่ใช้ได้สะดวก"

msgid "G125_Spz_57_Rh"
msgstr "Rheinmetall Panzerwagen"

msgid "G125_Spz_57_Rh_descr"
msgstr "ในวันที่ 8 มิถุนายน 1957 Rheinmetall ได้บันทึกสิทธิบัตรสำหรับรถถังเบาใหม่ที่มีป้อมปืนแบบส่ายพร้อมกับจุดหมุนแนวดิ่ง การออกแบบที่เสนอมาทำให้วิศวกรสามารถติดตั้งปืนขนาด 90 มม.และ 105 มม.บนรถถังเบาและยังรักษาความสูงของรถถังเดิมไว้ได้ Rheinmetall นั้นไม่มีตัวถังของตนสำหรับการประกอบรถถังและได้ทำการเสนอป้อมปืนดังกล่าวให้โรงงานอื่น รถถังนี้เป็นโครงการที่ใช้ตัวถังของ Hanomag and Henschel มีอยู่ในเพียงพิมพ์เขียวเท่านั้น"

msgid "G125_Spz_57_Rh_short"
msgstr "Rhm. Pzw."

msgid "G126_HWK_12"
msgstr "HWK 12"

msgid "G126_HWK_12_descr"
msgstr "ชุดของยานหุ้มเกราะตีนตะขาบเบา HWK 10 พัฒนาขึ้นโดย Henschel Werke ในช่วงปลายทศวรรษ 1950 ถึงต้นทศวรรษที่ 1960 พาหนะถูกพัฒนาสำหรับการส่งออก โดยรถต้นแบบคันแรกของ HWK 11 ถูกสร้างขึ้นในปี 1963 และ 40 คันถูกส่งไปยังเม็กซิโก รถต้นแบบ HWK 13 (ยานลาดตระเวน) ถูกสร้างขึ้นมาเช่นกัน ส่วน HWK 12 ที่ควรจะถูกผลิตด้วยฐานตัวถังเดียวกันนั้นไม่ได้มีการสร้างขึ้นแต่อย่างใด"

msgid "G126_HWK_12_short"
msgstr "HWK 12"

msgid "G12_Ltraktor"
msgstr "Leichttraktor"

msgid "G12_Ltraktor_descr"
msgstr "ผลิตตั้งแต่ปีคริสตศักราช 1930 ถึง 1934 มีต้นแบบสี่คันที่ติดอาวุธ พลรถถัง น้ำหนัก และระบบช่วงล่างแตกต่างกัน"

msgid "G12_Ltraktor_short"
msgstr "L.Tr."

msgid "G134_PzKpfw_VII"
msgstr "Pz.Kpfw. VII"

msgid "G134_PzKpfw_VII_descr"
msgstr "รถถังหนักยิ่งยวดโดยมีการวางป้อมปืนที่ด้านหลัง พัฒนาขึ้นโดยบริษัท Krupp ในปี 1942 โครงการถูกยกเลิกเพื่อหลีกทางให้กับรถถังที่หนักกว่า ไม่มีการผลิตรถถังคันนี้ขึ้นมา"

msgid "G134_PzKpfw_VII_short"
msgstr "Pz.Kpfw. VII"

msgid "G136_Tiger_131"
msgstr "Tiger 131"

msgid "G136_Tiger_131_descr"
msgstr "รถถัง Pz.Kpfw. VI คันเดียวที่ยังสามารถใช้การได้ รถถังคันนี้ถูกยึดโดยกรมรถถังกองทัพบกอังกฤษที่ 48 ในตูนิเชียวันที่ 21 เมษายน 1943 และนำมาซ่อมในเวลาต่อมา รถถังถูกส่งไปยังสหราชอาณาจักรในปีเดียวกัน โดยกองทัพอังกฤษก็ได้ทำการตรวจสภาพโดยสมบูรณ์ของรถถังและนำรถถังออกแสดงที่พิพิธภัณฑ์รถถัง Bovington ในปี 1951"

msgid "G136_Tiger_131_long_special"
msgstr "รถถังคันนี้มีปืนที่ยิงเร็ว ระยะการมองเห็นที่ดี และความทนทานที่เพียงพอ อย่างไรก็ตาม เกราะของรถถังนั้นไม่ได้มีมุมลาดเอียงทำให้อ่อนแอต่อกระสุนข้าศึก"

msgid "G136_Tiger_131_short"
msgstr "Tiger 131"

msgid "G136_Tiger_131_short_special"
msgstr "ความสามารถในการอยู่รอดที่ดี อัตราการยิงและระยะการมองเห็นที่สูง"

msgid "G137_PzVI_Tiger_217"
msgstr "Tiger 217"

msgid "G137_PzVI_Tiger_217_descr"
msgstr "ในเดือนเมษายน 1944 Otto Carius ได้รับรถถัง Tiger รุ่นดัดแปลง E หมายเลข 217 เสือรถถังทำการรบในรถถังคันนี้จนได้รับบาดเจ็บช่วงเดือนมิถุนายน 1944 รถถังคันนี้ไดรับความเสียหายอย่างหนักและระเบิดในพื้นที่ใกล้ Pillau ในปี 1945"

msgid "G137_PzVI_Tiger_217_long_special"
msgstr "รถถังหนักเยอรมันระดับ VI มีปืนที่ทรงพลัง มุมกด/มุมยกที่ดีและความทนทานที่พอตัว แม้ว่าเกราะจะใช้ได้แต่พาหนะของระดับเดียวกันจะสามารถยิงเจาะเกราะได้อันเนื่องด้วยมุมลาดเอียงเกราะที่ต่ำ ยุทธวิธีที่เหมาะของรถถังคันนี้คือการเข้าตีโอบข้าศึกและยิงเข้าจุดอ่อนข้าศึกอย่างแม่นยำ"

msgid "G137_PzVI_Tiger_217_short"
msgstr "Tiger 217"

msgid "G137_PzVI_Tiger_217_short_special"
msgstr "ปืนที่ใช้ได้และระยะการมองเห็นที่ยอดเยี่ยม"

msgid "G138_VK168_02"
msgstr "VK 168.01 (P)"

msgid "G138_VK168_02_Mauerbrecher"
msgstr "VK 168.01 Mauerbrecher"

msgid "G138_VK168_02_Mauerbrecher_descr"
msgstr "ในฤดูร้อนปี 1942 Porsche ได้รับคำสั่งสร้างยานเกราะบุกทะลวงที่มีอาวุธที่ทรงพลังที่สุดและเกราะหนาที่สุดเท่าที่จะเป็นไปได้สำหรับชั้นของมัน VK 168.01 เป็นการพัฒนาต่อของโครงการ Mäuschen โดยมีความแตกต่างหลักคือการวางป้อมปืนไว้ที่ส่วนหน้า มีอยู่ในพิมพ์เขียวเท่านั้น"

msgid "G138_VK168_02_Mauerbrecher_long_special"
msgstr "รถถังหนักเยอรมันคันนี้ไม่ได้มีเกราะชั้นยอดหรือความคล่องตัวชั้นดี อย่างไรก็ตาม ปืนของมันมีความเสียหายต่อนัดระดับทำลายล้างที่มีผลอย่างมากในการรบประชิด นอกจากนี้ระยะการมองเห็นที่ดียังทำให้สามารถชี้เป้าข้าศึกได้ด้วย"

msgid "G138_VK168_02_Mauerbrecher_short"
msgstr "Mauerbrecher"

msgid "G138_VK168_02_Mauerbrecher_short_special"
msgstr "ปืนที่ทรงพลังและระยะการมองเห็นที่ดี"

msgid "G138_VK168_02_descr"
msgstr "ในฤดูร้อนปี 1942 Porsche ได้รับคำสั่งสร้างยานเกราะบุกทะลวงที่มีอาวุธที่ทรงพลังที่สุดและเกราะหนาที่สุดเท่าที่จะเป็นไปได้สำหรับชั้นของมัน VK 168.01 เป็นการพัฒนาต่อของโครงการ Mäuschen โดยมีความแตกต่างหลักคือการวางป้อมปืนไว้ที่ส่วนหน้า มีอยู่ในพิมพ์เขียวเท่านั้น"

msgid "G138_VK168_02_long_special"
msgstr "รถถังหนักเยอรมันคันนี้ไม่ได้มีเกราะชั้นยอดหรือความคล่องตัวชั้นดี อย่างไรก็ตาม ปืนของมันมีความเสียหายต่อนัดระดับทำลายล้างที่มีผลอย่างมากในการรบประชิด นอกจากนี้ระยะการมองเห็นที่ดียังทำให้สามารถชี้เป้าข้าศึกได้ด้วย"

msgid "G138_VK168_02_short"
msgstr "VK 168.01 P"

msgid "G138_VK168_02_short_special"
msgstr "ปืนที่ทรงพลังและระยะการมองเห็นที่ดี"

msgid "G139_MKA"
msgstr "MKA"

msgid "G139_MKA_descr"
msgstr "รถถังสร้างขึ้นเพื่อการส่งออกพัฒนาขึ้นโดยบริษัท Krupp รถต้นแบบแรกผ่านการทดสอบภาคสนามในปี 1940 แต่การพัฒนาถูกหยุดลงและโครงการไม่ได้ดึงดูดลูกค้าที่น่าจะเป็นไปได้ มีรถต้นแบบเพียงหนึ่งคันซึ่งถูกตัดชิ้นส่วนไปในภายหลัง"

msgid "G139_MKA_long_special"
msgstr "รถถังเบาหลากภารกิจเยอรมันระดับ II ที่ไม่ได้มีจุดเด่นหรือจุดด้อยสำคัญใดๆ ความคล่องตัวของรถถังคันนี้ทำให้สามารถเข้ายิงสนับสนุนได้ในทุกแนวรบ เกราะของรถถังไม่ได้เป็นน่าประทับใจนัก แต่ก็ยังพอไว้ใจได้เมื่อเผชิญกับรถถังข้าศึกที่ใช้ปืนป้อนกระสุนอัตโนมัติ"

msgid "G139_MKA_short"
msgstr "MKA"

msgid "G139_MKA_short_special"
msgstr "รถถังหลากภารกิจที่มีความคล่องตัวยอดเยี่ยม"

msgid "G13_VK3001H"
msgstr "VK 30.01 (H)"

msgid "G13_VK3001H_descr"
msgstr "คำสั่งในการพัฒนาพาหนะรุ่นนี้เกิดขึ้นในวันที่ 9 กันยายน 1939 ในช่วงการพัฒนา วิศวกรของ Henschel ได้ใช้องค์ประกอบจากโครงการ D.W. II อย่างมาก รถต้นแบบสองคันแรกพร้อมทดสอบในเดือนมีนาคม 1942 และอีกสองคันสร้างเสร็จในเดือนตุลาคมปีเดียวกัน ตัวถัของรถต้นแบบเข้ารับทำการทดสอบที่สนามทดสอบของโรงงาน ภายหลังการทดสอบ รถต้นแบบสองคันถูกแปลงเป็นยานพิฆาตรถถังขนาดหนัก มีการผลิตป้อมปืนขึ้นมาหกป้อมโดยบริษัท Krupp ซึ่งนำไปติดตั้งที่กำแพงแอตแลนติค"

msgid "G13_VK3001H_short"
msgstr "VK 30.01 H"

msgid "G140_HWK_30"
msgstr "HWK 30"

msgid "G140_HWK_30_descr"
msgstr "พาหนะคันนี้ถูกเสนอเป้นการพัฒนาต่อของ Ru 251 และมีจุดมุ่งหมายเพื่อทำการส่งออกไปยังเม็กซิโกเป็นหลัก รุ่นดัดแปลงนี้มีเกราะและอาวุธดังเช่นรุ่นก่อนหน้าแต่มีตัวถังที่ยาวขึ้นและลูกล้อรองรับเพิ่มเติม มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G140_HWK_30_long_special"
msgstr "ระยะการมองเห็นและมุมกด/มุมยกชั้นยอดทำให้พาหนะคันนี้แตกต่างจากรถถังเบาพิเศษคันอื่นๆ อย่างไรก็ตาม ขนาดที่ใหญ่ของมันและเกราะที่บางทำให้รถถังคันนี้ต้องเคลื่อนที่และเปลี่ยนแนวรบตลอดเวลารวมไปถึงการชี้เป้าแบบไม่เผยตำแหน่งและใช้ประโยชน์จากพุ่มไม้และภูมิประเทศที่ไม่ราบเรียบ"

msgid "G140_HWK_30_short"
msgstr "HWK 30"

msgid "G140_HWK_30_short_special"
msgstr "ระยะการมองเห็นที่ดีและปืนที่แม่นยำอีกทั้งมีมุมกด/มุมยกที่น่าประทับใจ"

msgid "G141_VK7501K"
msgstr "VK 75.01 (K)"

msgid "G141_VK7501K_descr"
msgstr "แนวทางการพัฒนารถถังหนักติดตั้งป้อมปืนวางไว้ทางด้านหลัง ไม่มีการสร้างรถต้นแบบขึ้นมาและไม่ได้เข้าสู่สายการผลิตจำนวนมาก"

msgid "G141_VK7501K_long_special"
msgstr "เกราะหน้าที่ไว้ใจได้และการวางป้อมปืนไว้ด้านหลังนั้นเหมาะสำหรับการกันความเสียหายอย่างมีประสิทธิภาพด้วยเกราะด้านข้างและใช้ปืนที่ทรงพลังให้เป็นประโยชน์ อย่างไรก็ตาม แต่ระวังความคล่องตัวที่ปานกลางและเลือกทิศทางจู่โจม (หรือตำแหน่งป้องกัน) ให้ดีตั้งแต่เริ่มการรบ"

msgid "G141_VK7501K_short"
msgstr "VK 75.01 K"

msgid "G141_VK7501K_short_special"
msgstr "เกราะที่ใช้ได้ ปืนที่ทรงพลัง"

msgid "G142_M48RPz"
msgstr "M48A2 Räumpanzer"

msgid "G142_M48RPz_descr"
msgstr "รุ่นก่อนหน้าของยานทหารช่างที่พัฒนาขึ้นโดยมีต้นแบบจากรถถังกลาง M48 ของสหรัฐฯช่วงหลังสงคราม ซึ่งมีการติดตั้งใบไถ M8A1 รถถังเหล่านี้เข้าประจำการในหน่วยทหารช่างของกองทัพบกเยอรมันและถูกใช้งานจนถึงช่วงปลายทศวรรษ 1990 ในหน่วยรักษาดินแดนแต่ทำการถอดปืนออก มีรถถังรุ่นนี้ทั้งหมด 53 คันที่ประจำการในกองทัพบกเยอรมัน"

msgid "G142_M48RPz_long_special"
msgstr "รถถังกลางที่ช้าคันนี้ติดตั้งปืนใหญ่มาตรฐานขนาด 90 มม.และเกราะที่ดีพอตัว แม้ความคล่องตัวและความแม่นยำจะค่อนข้างปานกลาง รถถังคันนี้สามารถต่อกรกับข้าศึกในการรบประชิดได้อย่างดีด้วยการปฏิบัติการทั้งในฐานะรถถังกลางและรถถังหนัก ตัวรถถังยังติดตั้งใบไถซึ่งสามารถป้องกันแผ่นเกราะลาดด้านล่างและหลอกข้าศึกได้อีกด้วย"

msgid "G142_M48RPz_short"
msgstr "M48 RPz"

msgid "G142_M48RPz_short_special"
msgstr "เกราะที่เยี่ยมและการออกแบบที่เป็นเอกลักษณ์"

msgid "G143_E75_TS"
msgstr "E 75 TS"

msgid "G143_E75_TS_descr"
msgstr "หนึ่งในโครงการพัฒนาต่อและปรับรถถัง E75 ให้ทันสมัย มีแผนที่จะทำการติดตั้งเครื่องยนต์กังหันไอน้ำและป้อมปืนติดแผ่นเกราะเสริม แต่มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G143_E75_TS_long_special"
msgstr "รถถังหนักเยอรมันที่มีคุณลักษณะของรถถังกลาง รถถังคันนี้รวมความคล่องตัวที่ดีพอๆกับ Panther II เข้าด้วยกันกับเกราะที่ใช้ได้ ปืน 105 มม.ของรถถังทำความเสียหายได้มากกว่ารถถังกลางของระดับเดียวกันและความเร็วสูงสุด 45 กม./ชม.นั้นเหนือกว่ารถถังหนักคันอื่นๆ ทั้งหมดข้างต้นทำให้รถถังคันนี้มีความหลากหลายและปรับตัวเข้าสถานการณ์รบได้ทุกสถานการณ์"

msgid "G143_E75_TS_short"
msgstr "E 75 TS"

msgid "G143_E75_TS_short_special"
msgstr "ความคล่องตัวที่สมบูรณ์แบบและเกราะที่ใช้ได้"

msgid "G144_Kpz_50t"
msgstr "Kampfpanzer 50 t"

msgid "G144_Kpz_50t_descr"
msgstr "หนึ่งในโครงการรถถังกลางที่พัฒนาขึ้นในเยอรมนีช่วงทศวรรษ 1960 รถถังคันนี้ถูกมุ่งหมายให้มีปืนที่ทรงพลังและเกราะที่ใช้ได้ อย่างไรก็ตาม การพัฒนานั้นหยุดลงอยู่ที่ช่วงการทำเอกสารการออกแบบ"

msgid "G144_Kpz_50t_long_special"
msgstr "รถถังเยอรมันคันนี้มีส่วนผสมที่ไม่ปกติของเกราะหัวทวนของโซเวียตและป้อมปืนของ Leopard ตัวรถถังมีเกราะหน้าที่ใช้ได้ ปืนที่แม่นยำและมีประสิทธิภาพอีกทั้งมีมุมกด/มุมยกที่ดี อย่างไรก็ตาม เกราะข้างที่บอบบางทำให้ต้องทำการรบอย่างระวังและใช้ภูมิประเทศที่ไม่ราบเรียบให้เป็นประโยชน์และเปลี่ยนตำแหน่งยิงอยู่เรื่อยๆ"

msgid "G144_Kpz_50t_short"
msgstr "Kpz 50 t"

msgid "G144_Kpz_50t_short_special"
msgstr "ปืนที่เยี่ยมและขนาดที่เล็ก"

msgid "G147_Kunze_Panzer"
msgstr "Kunze Panzer"

msgid "G147_Kunze_Panzer_desc"
msgstr "โครงการรถถังกลางที่มีแกนป้อมปืนยื่นไปส่วนหน้าและจัดวางที่นั่งของพลรถถังทั้งหมดเอาไว้ในป้อมปืน พัฒนาขึ้นในปี 1964 มีอยู่ในแบบพิมพ์เขียวเท่านั้้น"

msgid "G147_Kunze_Panzer_long_special"
msgstr "รถถังกลางเยอรมันระดับ IX ที่มีความคล่องตัวยอดเยี่ยมและการอำพรางตัวและระยะการมองเห็นที่ดี ระบบยิงเร็วจะทำให้รถถังเพิ่มความแม่นยำปืนและมุมกดได้มากกว่าเดิม ในขณะที่รูปแบบเดินทางเร็วทำให้รถถังมีอัตราการยิงเร็วขึ้นและช่วยย้ายตำแหน่งได้รวดเร็ว อย่างไรก็ตาม พยายามจำไว้ว่ารถถังคันนี้มีความสามารถอยู่รอดต่ำทำให้ไม่สามารถออกปะทะตรงๆกับข้าศึกได้นาน"

msgid "G147_Kunze_Panzer_short"
msgstr "Kunze Panzer"

msgid "G147_Kunze_Panzer_short_special"
msgstr "ความคล่องตัวสูง มุมกด/มุมยกปืนที่ใช้ได้ดีและความเสียหายที่ดี"

msgid "G151_Pz_Sfl_IC"
msgstr "Pz.Sfl. IC"

msgid "G151_Pz_Sfl_IC4_long_special"
msgstr "ยานพิฆาตรถถังคล่องตัวที่มีปืนยิงเร็วซึ่งสามารถป้องกันตำแหน่งได้จากระยะไกล สำหรับเป้าหมายควรจะเป็นยานเกราะที่มีเกราะบางหรือมุ่งเน้นไปกับการทำความเสียหายข้าศึกที่รุกเข้าจากแนวข้างและใช้โอกาสที่หลากหลายในการเปล่ียนตำแหน่งยิง"

msgid "G151_Pz_Sfl_IC_descr"
msgstr "ยานพิฆาตรถถังเบาเยอรมันพัฒนาขึ้นในปี 1940 มีแผนที่จะทำการประกอบยานพิฆาตรถถังรุ่นนี้ในจำนวน 1,200 คันแต่ก็ไม่มีการผลิตจำนวนมากเกิดขึ้น มีการสร้างรถต้นแบบเพียงสองคันเพื่อทำการส่งไปทดสอบในแนวรบตะวันออกเมื่อวันที่ 29 เมษายน 1942 ไม่มีใครทราบชะตากรรมของรถต้นแบบสองคันนั้น"

msgid "G151_Pz_Sfl_IC_short"
msgstr "Pz.Sfl. IC"

msgid "G151_Pz_Sfl_IC_short_special"
msgstr "ความคล่องตัวที่ดีและอัตราการยิงที่สูง"

msgid "G154_Kpz_07_RH"
msgstr "Kampfpanzer 07 RH"

msgid "G154_Kpz_07_RH_LN"
msgstr "มังกรขาว"

msgid "G154_Kpz_07_RH_LN_descr"
msgstr "ผู้คุ้มครองน้ำและอากาศ พญามังกรขาวนั้นเป็นองครักษ์ของทุกอย่างที่ถือว่าเป็นสิ่งดี แม้ว่ารูปลักษณ์อาจจะดูดุร้าย แต่สัตว์อันสง่างามนี้ก็มีวิญญาณที่เมตตา มันมีปัญญาที่สั่งสมมานับหลายพันปี พลังของมันนั้นไร้ขีดจำกัดถ้าหากมันต้องการจะใช้พลังดังกล่าว แต่มันก็ไม่ใช่สิ่งมีชีวิตที่ชั่วร้ายหรือจองเวร มันคือผู้ให้ชีวิตและเกล็ดของมันก็ส่องประกายสีขาวยิ่งกว่าหิมะที่ปกคลุมยอดเขาว ปีมะโรงที่หวนมาทุกๆ 12 ปีนั้นก็เป็นเวลามงคลที่นำโชคลาภและความรุ่งเรืองมาให้เพราะนี่คือเวลาที่มังกรขาวมอบความกรุณาให้กับโลกมนุษย์"

msgid "G154_Kpz_07_RH_LN_long_special"
msgstr "ยานเกราะคันนี้เหมือนทั้งรถถังกลางและรถถังเบาซึ่งมีความเร็วและความคล่องตัวอันสมบูรณ์แบบทำให้สามารถแล่นเข้ายึดตำแหน่งยิงที่ได้เปรียบได้เป็นคันแรกๆ ปืน 90 มม.ที่ติดตั้งเอาไว้มีการปรับเสถียรและอัตราการยิงที่ดี อย่างไรก็ตามการเจาะเกราะและความเสียหายต่อนัดนั้นก็ไม่ได้น่าประทับใจนัก"

msgid "G154_Kpz_07_RH_LN_short"
msgstr "มังกรขาว"

msgid "G154_Kpz_07_RH_LN_short_special"
msgstr "ความคล่องตัวและความเสียหายต่อนาทีที่ยอดเยี่ยม"

msgid "G154_Kpz_07_RH_descr"
msgstr "พร้อมๆไปกับโครงการ Standardpanzer นั้นก็ได้มีการพัฒนายานเกราะที่มีขนาดเบากว่าในช่วงต้นทศวรรษที่ 1960 ในระยะการออกแบบได้มีการพิจารณาเลือกใช้เครื่องยนต์ขับเคลื่อน ระบบช่วงล่าง และการจัดวางพลรถถังที่แตกต่างกันไป คุณลักษณะร่วมของโครงการทั้งหมดนี้คือการใช้ป้อมปืนแบบส่ายที่มีใช้การประกอบที่แตกต่างออกไป โครงการได้หยุดลงที่ระยะทำการขึ้นแบบร่าง อย่างไรก็ตาม หนึ่งในรุ่นดัดแปลงที่มีป้อมปืนแบบส่ายและใช้ตัวถังของ Leopard 1 ปรับปรุงใหม่ก็ถูกผลิตขึ้นและผ่านการทดสอบ"

msgid "G154_Kpz_07_RH_long_special"
msgstr "ยานเกราะคันนี้เหมือนทั้งรถถังกลางและรถถังเบาซึ่งมีความเร็วและความคล่องตัวอันสมบูรณ์แบบทำให้สามารถแล่นเข้ายึดตำแหน่งยิงที่ได้เปรียบได้เป็นคันแรกๆ ปืน 90 มม.ที่ติดตั้งเอาไว้มีการปรับเสถียรและอัตราการยิงที่ดี อย่างไรก็ตามการเจาะเกราะและความเสียหายต่อนัดนั้นก็ไม่ได้น่าประทับใจนัก"

msgid "G154_Kpz_07_RH_short"
msgstr "Kpz 07 RH"

msgid "G154_Kpz_07_RH_short_special"
msgstr "ความคล่องตัวและความเสียหายต่อนาทีที่ยอดเยี่ยม"

msgid "G158_VK2801_105_SPXXI"
msgstr "VK 28.01 mit 10,5 cm L/28"

msgid "G158_VK2801_105_SPXXI_long_special"
msgstr "รถถังเบาเยอรมันระดับ VI ที่เป็นที่คุ้นเคยของผู้เล่นจำนวนมาก แตต่างจากรถถังระดับเดียวกันที่คันนี้ติดตั้งปืนลำกล้องใหญ่และมีเกราะที่ไว้ใจได้แต่ก็ทำให้ความคล่องตัว การอำพรางตัวและความว่องไวลดลง แต่น้ำหนักที่เพิ่มขึ้นนี้ก็ช่วยให้รถถังสามารถพุ่งชนเป้าหมายเกราะเบาได้ดีกว่าเดิม"

msgid "G158_VK2801_105_SPXXI_short"
msgstr "VK 28.01 105"

msgid "G158_VK2801_105_SPXXI_short_special"
msgstr "ปืนลำกล้องใหญ่และเกราะที่ไว้ใจได้"

msgid "G159_KPZ_3_Project_07_HK"
msgstr "KPz 3 Projekt 07 HK"

msgid "G159_KPZ_3_Project_07_HK_descr"
msgstr "ในช่วงกลางทศวรรษ 1960 ภายใต้อิทธิพลของ Strv S ของสวีเดน ทางเยอรมนีตะวันตกก็ได้เริ่มทำการพัฒนายานเกราะไม่มีป้อมปืน หนึ่งในโครงการนั้นถูกตั้งชื่อว่า Projekt 07 HK เหล่าวิศวกรของเยอรมันได้ทำการติดตั้งปืนเอาไว้ภายนอกและระบบช่วงล่างทำให้ยานเกราะเอียงตัวถังและเพิ่มมุมกดปืนได้ มีการติดตั้งอาวุธเสริมเป็นปืนอัตโนมัติ 20 มม.สองกระบอก คุณลักษณะเด่นของยานเกราะนี้คือห้องเฉพาะพลรถถังและกล้องสังเกตการณ์ที่มีระยะการมองเห็นที่ดีขึ้น ไม่มีการสร้างรถต้นแบบขึ้นมา"

msgid "G159_KPZ_3_Project_07_HK_long_special"
msgstr "ยานพิฆาตรถถังเยอรมันมีรูปแบบยิงเร็ว คุณลักษณะที่โดดเด่นของมันคือเกราะหน้าที่ลาดเอียงเป็นอย่างดี การป้องกันเพิ่มเติมไม่ได้เพียงเพิ่มโอกาสอยู่รอดของคุณเท่านั้นแต่ยังทำให้มันมีประโยชน์อย่างมากในการรบ"

msgid "G159_KPZ_3_Project_07_HK_short"
msgstr "KPz 3 Pr.07HK"

msgid "G159_KPZ_3_Project_07_HK_short_special"
msgstr "รูปแบบยิงเร็วและรูปทรงต่ำ"

msgid "G15_VK3601H"
msgstr "VK 36.01 (H)"

msgid "G15_VK3601H_descr"
msgstr "รถถังหนักเยอรมันรุ่นทดลองในสงครามโลกครั้งที่สอง รถถังคันนี้เป็นการพัฒนาต่อของโครงการ VK 30.01(H) และเป็นตอนหนึ่งของกระบวนการออกแบบของรถถัง Tiger มีการผลิตตัวถังจำนวนแปดชิ้นและรถต้นแบบขึ้นหนึ่งคันในปี 1942 ในช่วงการพัฒนา มีการทดสอบการแก้ไขทางเทคนิคหลายประการ ซึ่งบางส่วนถูกนำมาใช้เป็นรากฐานในการออกแบบรถถังหนักเยอรมันในช่วงสงครามโลกครั้งที่สอง ตัวถังรถยังถูกนำไปใช้ในการสร้างยานกู้ภัยหุ้มเกราะอีกด้วย"

msgid "G15_VK3601H_short"
msgstr "VK 36.01 H"

msgid "G160_Pz_Kpfw_35_R_mit_T_26_Turm"
msgstr "Pz.Kpfw. 35 R"

msgid "G160_Pz_Kpfw_35_R_mit_T_26_Turm_descr"
msgstr "ในปี 1940 กองทัพบกเยอรมันได้รับรถถังเบาฝรั่งเศส Renault R35 รุ่นใหม่ที่เป็นที่นิยมอย่างมากจำนวนมากกว่า 800 คันซึ่งต่อมาได้ถูกเปลี่ยนรหัสเรียกขานให้เป็น Panzerkampfwagen 35 R 731 (f) หรือ Pz.Kpfw. 35 R สองสามเดือนต่อมาทางกองทัพก็เห็นว่าป้อมปืนนั้นคับแคบเกินไปและอาวุธที่ติดตั้งไว้ก็ไม่ทรงพลังพอแม้แต่สำหรับการปฏิบัติการระดับรองทำให้รถถังหลายคันถูกแปลงมาเป็น Pz.Kpfw. 35 R ที่ติดตั้งป้อมปืนจากรถถัง T-26 ของโซเวียตซึ่งยึดมาได้ แต่ไม่มีข้อมูลระบุว่ารถถังเหล่านี้ได้รับการดัดแปลงที่โรงงานใดหรือโดยผู้ใด"

msgid "G160_Pz_Kpfw_35_R_mit_T_26_Turm_long_special"
msgstr "รถถังเบาเยอรมันระดับ II ซึ่งประกอบขึ้นจากชิ้นส่วนของ Renault R35 กับ T-26 และถือเป็นรุ่นสืบทอดของรถถังเหล่านี้ ปืน 45 มม.ที่ทรงพลังถูกติดตั้งบนตัวถังที่ทนทานทำให้รถถังลูกผสมคันนี้เป็นหน่วยต่อสู้เต็มรูปแบบในสนามรบ"

msgid "G160_Pz_Kpfw_35_R_mit_T_26_Turm_short"
msgstr "Pz. 35 R"

msgid "G160_Pz_Kpfw_35_R_mit_T_26_Turm_short_special"
msgstr "ปืนที่ทรงพลังและเกราะตัวถังที่ไว้ใจได้"

msgid "G161_Pz_Kpfw_M15_38_t"
msgstr "Pz.Kpfw. M 15"

msgid "G161_Pz_Kpfw_M15_38_t_descr"
msgstr "ในเดือนกันยายน 1943 กองทัพบกเยอรมันได้เข้ายึดบริษัท Ansaldo ของอิตาลีซึ่งในช่วงดังกล่าวบริษัทกำลังทำการผลิตรถถัง Carro Armato P26/40 และ Carro Armato M15/42 อยู่โดยรุ่น M15/42 ได้ถูกเปลี่ยนรหัสเรียกขานเป็น Pz.Kpfw. M15/42 และกลายเป็นยานเกราะอิตาลีที่ได้รับความนิยมที่สุดในกองทัพเยอรมัน ในระหว่างการซ่อมยานเกราะที่เสียหายของหน่วยรบเยอรมันก็มีการดัดแปลงที่ทำให้เกิดเป็นลูกผสมระหว่าง Pz.Kpfw. M15/42 และ Pz.Kpfw. 38 (t) จากการนำป้อมปืนของรถถังคันหนึ่งมาติดตั้งบนตัวถังของอีกคันและทำให้รถถังลูกผสมคันดังกล่าวถูกนำไปใช้ในการสู้รบที่ยูโกสลาเวียและถูกยึดโดยกองทัพของยูโกสลาเวียในช่วงฤดูใบไม้ผลิปี 1945"

msgid "G161_Pz_Kpfw_M15_38_t_long_special"
msgstr "รถถังเบาเยอรมันระดับ III รถถังคันนี้นั้นใช้ชิ้นส่วนจากทั้ง M15/42 และ Pz.Kpfw. 38(t) ช่วงล่างของอิตาลีทำให้มีความคล่องตัวที่ดีและใช้ได้ดีเมื่อรวมกับปืนยิงเร็วของเยอรมัน ซึ่งทั้งหมดนี้ทำให้รถถังสามารถเข้าจุดยิงหลักได้อย่างรวดเร็วและทำความเสียหายข้าศึกอย่างหนักได้ในเวลาอันสั้น"

msgid "G161_Pz_Kpfw_M15_38_t_short"
msgstr "Pz. M 15"

msgid "G161_Pz_Kpfw_M15_38_t_short_special"
msgstr "ความคล่องตัวที่ดีและอัตราการยิงที่สูง"

msgid "G162_Project_Kpz_07P_E"
msgstr "Kampfpanzer 07 P(E)"

msgid "G162_Project_Kpz_07P_E_descr"
msgstr "ในช่วงฤดูร้อนปี 1963 คณะกรรมาธิการกลาโหมของเยอรมันได้อนุมัติการผลิตรถถัง Leopards ชุดศูนย์ จำนวน 50 คันซึ่งถือเป็นรถถังเยอรมันตะวันตกหลังสงครามชุดแรก อย่างไรก็ตามเมื่อถึงตอนนั้นก็มีการพัฒนายานเกราะรุ่นใหม่เริ่มขึ้นแล้วและมันก็ควรจะเริ่มผลิตจำนวนมากในช่วงต้นทศวรรษ 1970 ข้อกำหนดหลักนั้นมีดังต่อไปนี้: ความสามารถในการยิงกระสุนขณะกำลังแล่นในภูมิประเทศกันดาร, ความคล่องตัวที่ดี, การป้องกันรังสีที่ดีที่สุดและน้ำหนักรบจำกัดที่ 32 ตัน ไม่ได้มีความพยายามเพิ่มการป้องกันกระสุนรถถัง ในขณะเดียวกัน ความคล่องตัวที่สูงและรูปทรงที่ต่ำถือเป็นคุณลักษณะหลักสำหรับการเอาตัวรอดหลักของรถถัง การออกแบบที่พัฒนาขึ้นโดย Dr. Ing. h.c. F. Porsche AG ในความร่วมมือกับ Wegmann & Co., ได้ถูกส่งเข้ารับการพิจารณาในเดือนธันวาคม 1963 แต่ก็ไม่ได้รับการยอมรับอันเนื่องด้วยน้ำหนักรถถังที่มากเกือบถึง 60 ตัน"

msgid "G162_Project_Kpz_07P_E_long_special"
msgstr "หนึ่งในโครงการรถถังหนักเยอรมันช่วงท้าย ปืน 120 มม.ที่มีส่วนผสมที่ดีของความเสียหายต่อนัดและความเสียหายต่อนาที การกระจายที่ต่ำและเวลาเล็งที่เร็ว ส่วนหน้ารถถังมีการเสริมแผ่นเกราะหนาและแผ่นลาดเอียงล่างนั้นติดตั้งใบไถที่ทำหน้าที่เป็นแผงเกราะกันกระสุนระเบิดแรงสูงต่อต้านรถถัง รถถังคันนี้มีความคล่องตัวที่ดี"

msgid "G162_Project_Kpz_07P_E_short"
msgstr "Kpz. 07 P(E)"

msgid "G162_Project_Kpz_07P_E_short_special"
msgstr "ปืนที่แม่นยำและเกราะที่ดี"

msgid "G163_Pz_Kpfw_KW_Ir_mit_75mm_kwk40"
msgstr "Pz.Kpfw. KW I (r)"

msgid "G163_Pz_Kpfw_KW_Ir_mit_75mm_kwk40_descr"
msgstr "ในช่วงต้นเดือนกรกฎาคม 1941 กองบัญชาการสูงสุดกองกำลังติดอาวุธได้ออกคำสั่งอพยพและเริ่มทำการนำรถถังโซเวียตที่ยึดได้มาใช้งานหนึ่งในยานเกราะดังกล่าวเป็นรถถังหนัก KV การปรับปรุงที่สำคัญที่สุดของ KV-1 นั้นเกิดขึ้นในปี 1943 โดยกรมยานเกราะ 204 ของกองพลยานเกราะที่ 22 ปืนดูน่าจะเสียหายเพราะมีการติดตั้งปืน 7.5 ซม.ของเยอรมันจาก Pz.Kpfw. IV G มีแผ่นเกราะปืนที่ใช้ปืนกลร่วมแกน MG 34 นอกจากนี้ ฝาครอบของ Pz.Kpfw. IVG ยังถูกนำมาติดตั้งไว้บนป้อมปืนและทำการเปลี่ยนวิทยุออกไปและติดตั้งพัดลม T-34 มีฝาปิดเข้ามาแทน"

msgid "G163_Pz_Kpfw_KW_Ir_mit_75mm_kwk40_long_special"
msgstr "รถถังหนักเยอรมันพิเศษที่มีเกราะไว้ใจได้และปืนยิงเร็ว 75 มม. คุณลักษณะปืนที่ยอดเยี่ยมทำให้คุณยิงเข้าเป้าหมายได้อย่างมีประสิทธิภาพ ด้วยการวางตำแหน่งที่เหมาะในการรบ รถถังคันนี้จะทำให้คุณสามารถใช้ได้ทุกยุทธวิธีไม่ว่าจะเป็นการบุกทะลวงแนวข้าศึกไปจนถึงการต้านทานทิศทางการบุก"

msgid "G163_Pz_Kpfw_KW_Ir_mit_75mm_kwk40_short"
msgstr "Pz. KW I"

msgid "G163_Pz_Kpfw_KW_Ir_mit_75mm_kwk40_short_special"
msgstr "เกราะที่ไว้ใจได้และอำนาจการยิงดี"

msgid "G164_Kpz_Pr_68_P"
msgstr "Mittlerer Kpz. Pr. 68 (P)"

msgid "G164_Kpz_Pr_68_P_descr"
msgstr "โครงการ Mittlerer Kpz. Pr. 68 (P) นั้นพัฒนาขึ้นโดยเหล่าวิศวกรของ Porscher ในฐานะส่วนหนึ่งของโครงการเยอรมันตะวันตกในการพัฒนารถถังยุคใหม่ ยานเกราะนี้มีจุดเด่นจากรูปทรงที่ต่ำและทรงด้านหน้าที่เล็ก ทั้งนี้มีแผนการที่จะใช้ระบบช่วงล่างลมผสมน้ำมันซึ่งจะทำให้ยานเกราะสามารถเอียงตัวถังและเพิ่มมุมยกหรือกดปืนได้ ยานเกราะนี้มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G164_Kpz_Pr_68_P_long_special"
msgstr "รถถังซุ่มยิงดั้งเดิมของเยอรมันมีความคล่องตัวที่ยอดเยี่ยมและความเสียหายต่อนัดและการเจาะเกราะที่ดีอีกทั้งยังมีการกระจายกระสุนที่ต่ำและเล็งได้เร็ว ข้อเสียนั้นคือเกราะที่ปานกลางและความเสียหายต่อนาทีที่ต่ำ"

msgid "G164_Kpz_Pr_68_P_short"
msgstr "MKpz 68 (P)"

msgid "G164_Kpz_Pr_68_P_short_special"
msgstr "ความคล่องตัวที่ดีและอาวุธที่ทรงพลัง"

msgid "G165_Erich_Konzept_I"
msgstr "Kpz. Erich Konzept I"

msgid "G165_Erich_Konzept_I_descr"
msgstr "Erich Konzept I เป็นแบบพิมพ์เขียวปี 1965 ที่พัฒนาขึ้นในฐานะโครงการ T/KPZ 70 ทางผู้พัฒนามีจุดมุ่งหมายในการสร้างป้อมปืนที่มีฐานทรงกลมที่ทำให้หมุนได้ในทั้งสามระนาบ อีกทั้งยังมีแผนที่จะติดตั้งปืน 120 มม.ที่จะปรับเสถียรสามระนาบและหาความเป็นไปได้ในการติดตั้งปืนที่ทรงพลังกว่าเอาไว้บนยานเกราะ โครงการนี้ไม่มีความคืบหน้าพ้นช่วงเขียนแบบพิมพ์เขียว"

msgid "G165_Erich_Konzept_I_long_special"
msgstr "ด้วยปืนที่รวมความแม่นยำ, อำนาจการเจาะเกราะ, การปรับเสถีรยและความเร็วกระสุนเข้าด้วยกัน ทำให้ Kpz. Erich Konzept I นั้นเหมาะกับการรบระยะไกล มันยังมีความคล่องตัวที่สูงทำให้ปรับตัวกับสถานการณ์การรบได้เป็นอย่างดี แต่ความทนทานที่ต่ำและเกราะที่บางทำให้มีโอกาสอยู่รอดต่ำเช่นกันทำให้มันสามารถรอดจากกระสุนระเบิดแรงสูงไม่กี่นัดเท่านั้น"

msgid "G165_Erich_Konzept_I_short"
msgstr "Kpz EK I"

msgid "G165_Erich_Konzept_I_short_special"
msgstr "การควบคุมปืนที่ดี, ความคล่องตัวที่ยอดเยี่ยม"

msgid "G166_LKpz_70_K"
msgstr "Leichter Kpz. 70 (K)"

msgid "G166_LKpz_70_K_descr"
msgstr "ในปี 1970 บริษัท Krupp GmbH ได้เริ่มทำการวิจัยความเป็นไปได้ในการสร้างยานเกราะที่มีพลประจำหนึ่งถึงสามนายหรือแม้กระทั่งควบคุมจากระยะไกลโดยไม่มีพลรถถัง รถต้นแบบพื้นฐานถูกมุ่งหมายให้มีระบบช่วงล่างลมผสมน้ำมันปรับได้พร้อมล้อขับที่ยาวและมีกำลังขับจำเพาะสูง อาวุธหลักจะเป็นปืนมีการปรับเสถียรสองระนาบโดยใช้หลังคายกเหนือช่องป้อนกระสุนทำให้สามารถมีมุมกด -10 องศาได้ พลรถถังจะประจำไว้ด้านหลังและควบคุมยานเกราะด้วยกล้องและระบบควบคุมทางไกลที่ทำงานอัตโนมัติ ความคล่องตัวชั้ันยอดถูกตั้งให้เป็นการป้องกันหลักของยานเกราะ การดำเนินการกับโครงการนี้ถูกหยุดลงในช่วงการสร้างแบบจำลองและทำแบบพิมพ์เขียว"

msgid "G166_LKpz_70_K_long_special"
msgstr "ยานเกราะที่เป็นเอกลักษณ์มีมุมกดปืน -10 องศาที่ยอดเยี่ยม ระบบช่วงล่างลมผสมน้ำมันและป้อมปืนขนาดย่อมไร้พลประจำติดตั้งปืน 90 มม.ที่แม่นยำทำให้สามารถยิงจากหลังที่กำบังได้โดยซ่อนตัวถังได้ทั้งหมดและทำให้การยิงยานเกราะคันนี้ลำบากอย่างมาก"

msgid "G166_LKpz_70_K_short"
msgstr "LKpz 70 (K)"

msgid "G166_LKpz_70_K_short_special"
msgstr "ปืนที่ยอดเยี่ยมและระบบช่วงล่างลมผสมน้ำมัน"

msgid "G167_Tiger_Maus_120t"
msgstr "Tiger-Maus"

msgid "G167_Tiger_Maus_120t_descr"
msgstr "โครงการรถถังหนักยิ่งยวด 120 ตันที่พัฒนาในช่วงกันยายนถึงธันวาคมปี 1942 รถถังคันนี้ถูกมุ่งหมายให้ใช้ป้อมปืนจาก Pz. Kpfw. Maus ในขณะที่ระบบขับเคลื่อน, ระบบหล่อเย็นและชิ้นส่วนอื่นๆนั้นถูกนำมาจาก VK 45.02 (H) รถถังคันนี้ได้รับรหัสเรียกขานเป็น Tiger-Maus โครงการนี้ถูกยกเลิกแต่ก็พัฒนาต่อภายหลังในช่วงการพัฒนารถถัง E100"

msgid "G167_Tiger_Maus_120t_long_special"
msgstr "รุ่นปรับปรุงของปืน 128 มม.นั้นมีพลังทำลายมหาศาลอีกทั้งยังเจาะเกราะได้ดีพอตัว ในขณะเดียวกันเกราะที่แข็งแกร่งจะสะท้อนกระสุนที่ยิงเข้ามาได้มากทำให้รถถังคันนี้เหมาะกับการเป็นผู้นำการบุก แต่กระนั้นเอง ความคล่องตัวนั้นก็ไม่ได้เป็นจุดเด่นของรถถัง"

msgid "G167_Tiger_Maus_120t_short"
msgstr "Tiger-Maus"

msgid "G167_Tiger_Maus_120t_short_special"
msgstr "อาวุธที่ทรงพลังและเกราะที่ยอดเยี่ยม"

msgid "G168_KJpz_T_III"
msgstr "KJPZ TIII Jäger"

msgid "G168_KJpz_T_III_descr"
msgstr "KJPZ TIII Jäger เป็นการออกแบบยานเกราะรุ่นก้าวหน้าที่นำเสนอโดย Rheinstahl AG ในปี 1972 จุดเด่นหลักนั้นคือความเร็วสูงสุดที่มาก, ปืน 120 มม.และป้อมปืนที่ปรับเสถียรสามระนาบที่ทำให้สามารถยิงระหว่างแล่นได้ โครงการนี้ถูกยกเลิกในช่วงการออกแบบ"

msgid "G168_KJpz_T_III_long_special"
msgstr "ยานพิฆาตรถถังเยอรมันมีป้อมปืนหมุนไม่ได้รอบตัว เนื่องจากเกราะที่บางทำให้เหมาะกว่าที่จะรักษาระยะห่างจากข้าศึกและใช้จุดเด่นของยานเกราะซึ่งเป็นการกระจายของกระสุนที่ต่ำ, เวลาการเล็งที่ใช้ได้และการอำพรางที่ดี ความคล่องตัวที่ใช้ได้ทำให้มันสามารถเปลี่ยนทิศทางได้อย่างรวดเร็วหรือเข้าประจำจุดยิงที่ดีขึ้น"

msgid "G168_KJpz_T_III_short"
msgstr "TIII Jäger"

msgid "G168_KJpz_T_III_short_special"
msgstr "การกระจายกระสุนที่ต่ำและความคล่องตัวที่ดี"

msgid "G169_T_54D"
msgstr "T 54D"

msgid "G169_T_54D_descr"
msgstr "โครงการรถถัง T 54D เป็นส่วนหนึ่งของโครงการ FRG เพื่อปรับปรุงรถถัง T-54 (T-55) ให้ทันสมัย เมื่อทำการเพิ่มพิกัดน้ำหนักขึ้นระดับหนึ่ง รถถังจะมีแท่งเกราะป้องกันที่เพิ่มการป้องกันกระสุนระเบิดแรงสูงต่อต้านรถถังและการป้องกันที่ดีขึ้นสำหรับกระสุนพลังจลน์ มีการเสนอให้เปลี่ยนปืน 100 mm D-10T ด้วยปืน 105 mm L7A3 ที่ทันสมัยกว่า ปืนของอังกฤษนี้เหนือกว่าปืนโซเวียตทั้งในการเจาะเกราะและความแม่นยำ อีกทั้งยังมีการขอให้ติดตั้งปืนกล MG 3 เอาไว้บนรถถังและเปลี่ยนระบบสื่อสาร, กล้องเล็งสังเกตการณ์ที่ล้าสมัยด้วยรุ่นที่ก้าวหน้ากว่า ไม่มีการผลิตรถต้นแบบขึ้นมา"

msgid "G169_T_54D_long_special"
msgstr "รุ่นปรับให้ทันสมัยของรถถัง T-54 ของเยอรมัน การปรับแต่งนั้นปรับปรุงเกราะและใช้ปืน 105 มม. L7A3 ของอังกฤษ แนวการปรับให้ทันสมัยของ T-54 นั้นทำให้รถถังหนักขึ้นเล็กน้อยแต่ส่วนผสมของอำนาจการยิงและการป้องกันที่เพิ่มขึ้นทำให้มีประสิทธิภาพการรบเพิ่มขึ้นอย่างมาก"

msgid "G169_T_54D_short"
msgstr "T 54D"

msgid "G169_T_54D_short_special"
msgstr "ปืนที่แม่นยำและเกราะปรับปรุง"

msgid "G16_PzVIB_Tiger_II"
msgstr "Tiger II"

msgid "G16_PzVIB_Tiger_II_F_long_special"
msgstr "รถถังหนักเยอรมันระดับ VII ที่ถือเป็นศัตรูที่น่ากลัวของรถถังระดับเดียวกันและมีความโดดเด่นจากเกราะที่ดีและปืนอันทรงพลังที่สามารถยิงเข้าเป้าหมายได้ทุกระยะ"

msgid "G16_PzVIB_Tiger_II_F_short_special"
msgstr "เกราะที่ไว้ใจได้และปืนที่แม่นยำ"

msgid "G16_PzVIB_Tiger_II_descr"
msgstr "เป็นรถถังที่เกราะหนาที่สุดและมีปืนต่อต้านรถถังที่ทรงพลังที่สุด ข้อด้อยของรถถังคือระบบช่วงล่างที่รับน้ำหนักเกิดพิกัดและปัญหาของกลุ่มส่งกำลังเครื่องยนต์ รวมไปถึงมวลรวมที่มากกว่าปกติ เมื่อทำการต่อสู้กับยานเกราะข้าศึกที่ระยะไกล Tiger II นั้นมีความได้เปรียบเหนือยานเกราะอื่นจากทั้งปืนและการป้องกันของเกราะอย่างไรก็ตาม ด้วยมวลของรถถัง ความทนทานของเครื่องยนต์และระบบส่งกำลังที่ต่ำรวมไปถึงจำนวนการผลิตที่น้อย ทำให้ Tiger II ไม่ได้สร้างผลงานที่โดดเด่นนักในสงคราม"

msgid "G16_PzVIB_Tiger_II_short"
msgstr "Tiger II"

msgid "G170_PzKpfwIV_Ausf_F2"
msgstr "Pz.Kpfw. IV Ausf. F2"

msgid "G170_PzKpfwIV_Ausf_F2_descr"
msgstr "ก่อนเริ่มปฏิบัติการบาบารอสซาได้มีการตัดสินใจที่ปรับปรุงสมรรถนะการต่อต้านรถถังของ Pz.Kpfw. IV ด้วยการติดตั้งปืนขนาด 50 mm Kw.K. L/60 อย่างไรก็ตาม การรบกับรถถัง T34 และ KV ของโซเวียตในช่วงสมรภูมิฤดูร้อน-ใบไม้ร่วงปี 1941 แสดงให้เห็นว่าจำเป็นต้องใช้ปืนที่ทรงพลังกว่านี้ ก็มีการนำปืน 75 mm Kw.K. 40 L/43 ที่มีปลอกลดแสงทรงลูกแพร์มาติดตั้งแทน กระสุนเจาะเกราะของปืนสามารถเจาะเกราะรถถังผลิตจำนวนมากทุกคันของยุคนั้นได้จากระยะ 1.5 กม."

msgid "G170_PzKpfwIV_Ausf_F2_long_special"
msgstr "รถถังกลางมีปืน 7.5 cm Kw.K. 40 L/43 ที่โด่งดัง รถถังคันนี้มีการเจาะเกราะที่ดีและเวลาบรรจุที่ใช้ได้รวมไปถึงมีระยะการมองเห็นที่ค่อนข้างดีถึง 360 เมตรและความคล่องตัวที่ปานกลาง จากการมีเกราะที่ปานกลางทำให้มันเหมาะกับการรวมกลุ่มกับรถถังพันธมิตรและใช้ปืนยิงเร็วขณะที่ข้าศึกกำลังบรรจุกระสุนอยู่"

msgid "G170_PzKpfwIV_Ausf_F2_short"
msgstr "Pz. IV F2"

msgid "G170_PzKpfwIV_Ausf_F2_short_special"
msgstr "ปืนยิงเร็วและความคล่องตัวที่ดี"

msgid "G171_E77"
msgstr "E 77"

msgid "G171_E77_descr"
msgstr "โครงการไร้ชื่อของรถถังหนักที่ถือเป็นตัวเลือกให้กับรถถังชุด E มีแผนที่จะทำการติดตั้งเครื่องยนต์กังหันแก๊สขนาดเล็กลง ระบบขับเคลื่อนน่าจะถูกติดตั้งเอาไว้ในส่วนท้ายรถถังและป้อมปืนจะเป็นแบบหล่อขึ้นรูป ปัจจัยทั้งหมดนี้น่าจะทำให้ลดน้ำหนักรถถังและติดตั้งปืนที่ทรงพลังมากขึ้นได้มากขึ้น ตามรายงานของคณะกรรมาธิการโซเวียตที่ทำงานในเยอรมนีหลังสงครามโลกครั้งที่สอง นักออกแบบเยอรมันได้ทำงานอย่างต่อเนื่องกับกลไกระบบป้อนกระสุน อย่างไรก็ตาม การที่สงครามจบลงทำให้การพัฒนาจำนวนมากหยุดลงซึ่งรวมไปถึงโครงการไร้นามนี้ด้วยที่น่าจะกลายเป็นคู่ต่อสู้ที่น่ากลัวกับรถถังโซเวียตรุ่นใหม่ล่าสุด"

msgid "G171_E77_long_special"
msgstr "E 77 เป็นรุ่นทดลองของรถถังหนักเยอรมันที่มีแนวคิดห้องเครื่องยนต์, ตัวถังและระบบส่งกำลังใหม่ การเปลี่ยนแปลงเหล่านี้น่าจะทำให้ลดขนาดรถถังโดยรวมได้และทำให้ E 77 โดดเด่นในบรรดารถถังของเยอรมัน อย่างไรก็ตาม รถถังก็ยังมีเกราะที่ไว้ใจได้และปืน 12.8 ซม.ของเยอรมันที่โด่งดัง"

msgid "G171_E77_short"
msgstr "E 77"

msgid "G171_E77_short_special"
msgstr "ปืนอันทรงพลัง, รูปทรงที่ต่ำ"

msgid "G172_PzVIB_Tiger_II_DIT"
msgstr "Tiger II Kuromorimine"

msgid "G172_PzVIB_Tiger_II_DIT_descr"
msgstr "หนึ่งในยานเกราะที่น่าเกรงขามที่สุดในช่วงท้ายของสงครามโลกครั้งที่สองนั้นก็คือ Tiger II ซึ่งมีอีกชื่อว่า Königstiger หรือ King Tiger รถถังคันนี้คือความภาคภูมิใจของทีมวิถีแห่งรถถังของโรงเรียนมัธยมสตรี Kuromorimine ไม่ว่าจะเป็นปืนอันน่ากลัวที่ทำความเสียหายระดับทำลายล้างหรือเกราะอันทนทานที่ทำให้สมบูรณ์แบบสำหรับหลักนิยมบัญชาการรถถังของ Nishizumi ที่ทางโรงเรียน Kuromorimine เชี่ยวชาญจากการเน้นการโจมตีอย่างแม่นยำและการป้องกันที่เจาะไม่เข้า Tiger II ยังเป็นส่วนสำคัญของโรงเรียน Kuromorimine ในการแข่งขันทัวร์นาเมนต์วิถีแห่งรถถังระดับมัธยมของประเทศ ภายใต้การบัญชาการของ Erika Itsumi ทำให้ Kuromorimine แพ้ต่อโรงเรียน Oarai ในการแข่งรอบสุดท้ายของทัวร์นาเมนต์ครั้งที่ 63"

msgid "G172_PzVIB_Tiger_II_DIT_long_special"
msgstr "ยานเกราะคันนี้มีเกราะที่ไว้ใจได้และปืนที่ทรงพลังซึ่งเป็นส่วนผสมที่น่ากลัวในสนามรบ อย่างไรก็ตาม มันก็มีความเร็วและความคล่องตัวที่ธรรมดาทำให้ต้องระวังในการเลือกเส้นทางเข้าต่อสู้และต้องไม่เปิดเผยตัวให้ถูกข้าศึกเข้าตีโอบได้"

msgid "G172_PzVIB_Tiger_II_DIT_short"
msgstr "Tiger II Kuro."

msgid "G172_PzVIB_Tiger_II_DIT_short_special"
msgstr "เกราะหน้าที่ไว้ใจได้, ปืนที่ดี"

msgid "G173_BT42_DIT"
msgstr "BT-42 Jatkosota HS"

msgid "G173_BT42_DIT_descr"
msgstr "ในแรกเริ่มนั้นเป็นเพียงรถถังเบาโซเวียต BT-7 รถถัง BT-42 ที่รู้จักในอีกชื่อว่า Christie Rynnäkkötykki ได้เปลี่ยนโฉมใหม่หลังจากถูกยึดและดัดแปลงโดยกองทัพบกฟินแลนด์ในปี 1941-2 ขนาดที่เล็กของรถถังทำให้รถถังมีพลรถถังหญิงสามคนเป็นผู้บัญชาการ Mika, พลปืน/บรรจุกระสุน Aki และพลขับ Mikko จากทีมวิถีแห่งรถถังของโรงเรียนมัธยม Jatkosota รถถังคันนี้มีประสิทธิภาพมากที่สุดเมื่อออกรบเมื่อมีการเล่นเพลง Säkkijärven Polkka รถถัง BT-42 นั้นมีประสิทธิภาพในการรบประชิดซึ่งสามารถทำให้ปืนใหญ่สนามลำกล้องใหญ่ของรถถังทำงานได้เต็มที่ ช่วงเวลาเด่นของ BT-42 นั้นอยู่ในช่วงการรบที่ Oarai ซึ่งระบบช่วงล่างคริสตี้ของรถถังทำให้ยังสามารถแล่นได้แม้จะไม่มีตีนตะขาบและสามารถทำลายหมวดรถถัง M26 Pershings จากทีมมหาวิทยาลัย Hand-Picked ได้"

msgid "G173_BT42_DIT_long_special"
msgstr "รถถังเบาติดตั้งปืนขนาด 114 มม.ที่น่าประทับใจซึ่งทำความเสียหายมหาศาลต่อนัด นอกจากนี้ รถถังยังมีความคล่องตัวที่ยอดเยี่ยมและกำลังขับจำเพาะที่สูง อย่างไรก็ตาม เวลาบรรจุกระสุนที่นานและการกระจายของกระสุนปืนที่มากทำให้ไม่สามารถยิงขณะทำการแล่นได้"

msgid "G173_BT42_DIT_short"
msgstr "BT-42 Jatk."

msgid "G173_BT42_DIT_short_special"
msgstr "ความเสียหายระดับทำลายล้างและความเร็วสูง"

msgid "G174_Kpz3_GST_Turm"
msgstr "Kpz. 3 GST Turm"

msgid "G174_Kpz3_GST_Turm_descr"
msgstr "โครงการ Kpz.3 GST นั้นมีสองรุ่นดัดแปลง โดยรุ่นแรกเป็นยานพิฆาตรถถังแบบดั้งเดิม ส่วนแบบที่สอง Kpz.3 GST Turm นั้นมีป้อมปืนที่หมุนได้ในมุมจำกัด พลรถถังทั้งหมดของ Kpz.3 GST Turm จะประจำการอยู่ในป้อมปืน Kpz.3 GST นั้นมีระบบช่วงล่างไฮโดรนิวมาติคเหมือนกับของ Kpz.70\n\nมีการสันนิษฐานว่า Kpz.3 นั้นน่าจะเป็นยานเกราะรบความเร็วสูงอย่างมากและมีเกราะหน้าอันทรงพลังกับอัตราการยิงที่เร็ว อย่างไรก็ตามไม่มีรุ่นดัดแปลงได้ได้ผ่านการพิจารณาของกองทัพเยอรมัน ยานเกราะนี้ถือว่าเป็นแบบที่ไม่ปกติเกินไปและทางกองทัพก็ได้เลือกพัฒนาสายรถถัง Leopard 2 ต่อแทน"

msgid "G174_Kpz3_GST_Turm_long_special"
msgstr "Kpz.3 GST Turm เป็นยานพิฆาตรถถังจู่โจมเยอรมันระดับ VIII จุดเด่นหลักของมันคือเกราะหน้าที่ทนทานทำให้มันเข้ายึดจุดสำคัญได้ในขณะที่ระบบช่วงล่างไฮโดรนิวมาติคทำให้คุณใช้ประโยชน์จากภูมิประเทศได้อย่างสะดวก ปืนของยานพิฆาตรถถังนั้นถือว่าเหมาะสมกับบทบาทของมันโดยมีอัตราการเจาะเกราะและความเสียหายต่อนาทีที่สูงและการควบคุมปืนที่ดีและป้อมปืนหมุนได้ก็ยังมีระยะการหมุนที่ดีอีกด้วย"

msgid "G174_Kpz3_GST_Turm_short"
msgstr "GST Turm"

msgid "G174_Kpz3_GST_Turm_short_special"
msgstr "เกราะหน้าที่ทนทาน, ระบบช่วงล่างไฮโดรนิวมาติคอัตโนมัติ"

msgid "G175_Rheinmetall_Begleitwagen"
msgstr "Rheinmetall Begleitwagen"

msgid "G175_Rheinmetall_Begleitwagen_desc"
msgstr "ในช่วงครึ่งหลังของปี 1934 ทางเยอรมันได้เริ่มพัฒนารถถังที่ใช้รหัสเรียกขาน Verbesserten Nb.Fz. ทางบริษัท Rheinmetall นั้นได้รับมอบหมายให้ทำการออกแบบรถถังโดยมีกำหนดให้น้ำหนักอยู่ที่ประมาณ 17-18 ตัน อาวุธของรถถังนั้นประกอบด้วยปืนลำกล้องสั้นขนาด 75 มม.และปืนกลร่วมแกนและมีปืนกลอีกกระบอกติดตั้งบนป้อมปืนเล็กที่ด้านหน้าของตัวถัง การจัดวางระบบส่งกำลังด้านหน้าที่หนาแน่นทำให้ลดความยาวตัวถังได้อย่างมาก อีกทั้งยังมีแผนที่จะใช้เครื่องยนต์ Maybach HL 100 TR แบบ 12 ลูกสูบเรียงตัววีขนาด 10 ลิตรที่มีกำลังขับ 300 แรงม้า ทาง Rheinmetall ได้ผลิตรถต้นแบบจากไม้ขนาดจริงและต่อมาได้ประกอบตัวถังจากเหล็กก่อสร้างขึ้นมา มีการปรับปรุงกับตัวถังในเวลาต่อมาแต่ก็ไม่ได้ถูกนำมาใช้สำหรับการผลิตรถถังจำนวนมาก"

msgid "G175_Rheinmetall_Begleitwagen_long_special"
msgstr "Rheinmetall Begleitwagen เป็นรถถังกลางเยอรมันระดับ III ที่ใช้ปืน 7.5 ซม.ซึ่งทำความเสียหายต่อนัดได้สูง เกราะของรถถังนั้นถือว่าปานกลางสำหรับระดับของรถถังแต่ก็มีความคล่องตัวที่ใช้ได้ Begleitwagen นั้นมีประสิทธิภาพสูงสุดเมื่อยิงแลกกับข้าศึกระยะประชิดและใช้ประโยชน์จากความเสียหายต่อนัดที่สูง"

msgid "G175_Rheinmetall_Begleitwagen_short"
msgstr "B.W.(Rh)"

msgid "G175_Rheinmetall_Begleitwagen_short_special"
msgstr "ปืนทีทรงพลัง, ความคล่องตัวที่ใช้ได้"

msgid "G176_Jagdpanzer_E90"
msgstr "Jagdpanzer E 90"

msgid "G176_Jagdpanzer_E90_descr"
msgstr "โครงการยานพิฆาตรถถังหนักที่มีต้นแบบจากตัวถังของรถถัง E 90 รุ่นก้าวหน้าที่พัฒนาขึ้นในปี 1945 ในฐานะแนวคิดรถถังรุ่น E ยานเกราะนี้มีอำนาจการยิงที่สูงและการป้องกันที่ดีรวมไปถึงเครื่องยิงระเบิดต่อต้านทหารราบ ยานพิฆาตรถถังคันนี้ออกแบบมาให้ติดตั้งปืน 15 ซม.อันน่าเกรงขามขนาด 44 คาลิเบอร์ เพื่อเป็นการเพิ่มอัตราการยิงก็มีการวางแผนใช้ระบบป้อนกระสุนอัตโนมัติ นอกจากนี้ ยังมีการพัฒนากระสุนไอพ่นพิเศษสำหรับยานเกราะนี้ด้วยทำให้สามารถยิงโดยเกิดแรงสะท้อนที่น้อยมากระหว่างที่มุมยกปืนสูงที่สุด โครงการนี้ไม่ได้พัฒนาพ้นช่วงร่างแบบพิมพ์เขียว ไม่มีการสร้างรถต้นแบบขึ้นมา"

msgid "G176_Jagdpanzer_E90_long_special"
msgstr "Jagdpanzer E 90 เป็นยานพิฆาตรถถังจู่โจมระดับ IX มีเกราะที่ยอดเยี่ยมและปืนที่ทรงพลัง นอกจากความเสียหายต่อนัดสูงแล้ว ปืนยังทำการยิงได้อย่างสบายทำให้สามารถทำความเสียหายได้อย่างสม่ำเสมอ โดยรวมแล้ว ยานเกราะนี้ถือว่าเป็นแบบดั้งเดิมของยานเกราะชั้นนี้ มันสามารถผลักดันแนวรบข้าศึก, กันกระสุนที่ยิงเข้ามาและทำความเสียหายจำนวนมหาศาล"

msgid "G176_Jagdpanzer_E90_short"
msgstr "Jg.Pz. E 90"

msgid "G176_Jagdpanzer_E90_short_special"
msgstr "เกราะที่ยอดเยี่ยม ปืนที่ทรงพลัง"

msgid "G177_E65_Zwilling"
msgstr "E 65 Zwilling"

msgid "G177_E65_Zwilling_descr"
msgstr "เมื่อเข้าใกล้ช่วงสิ้นสุดสงครามโลกครั้งที่สอง อุตสาหกรรมรถถังเยอรมันก็ได้เริ่มแนวคิดอันเป็นที่รู้จัดในชื่อชุด E หนึ่งในยานเกราะของโครงการนั้นคือ E 65 ที่เป็นรถถังใช้ระบบช่วงล่างแบบ Horstmann จากบริษัท Steyr และทำการวางล้อขับเคลื่อนเอาไว้ที่ด้านท้ายตัวถัง ความแตกต่างหลักจากยานเกราะคันอื่นๆของรุ่นคือแนวคิดในการติดตั้งปืนสองกระบอกเอาไว้บนป้อมปืนเดี่ยว รถถังนี้น่าจะสามารถทำการยิงแบบทั้งสองกระบอกหรือยิงกระบอกเดียวแต่มีความเร็วสูงขึ้น อย่างไรก็ตาม E 65 นั้นก็ไม่ได้มีการพัฒนาพ้นช่วงการออกแบบแนวคิดโดยรวมเบื้องต้น"

msgid "G177_E65_Zwilling_long_special"
msgstr "E 65 Zwilling เป็นรถถังหนักเยอรมันระดับ VIII ซึ่งมีการติดตั้งปืน 8.8 ซม. แบบคู่ที่มีเวลาเตรียมระดมยิงรวดเร็วและเวลาการเล็งเพื่อระดมยิงที่ดีขึ้น อย่างไรก็ตาม การหยุดไม่ให้บรรจุหลังระดมยิงนั้นถือว่านานมาก รถถังคันนี้มีความคล่องตัวที่ดีสำหรับรถถังหนักและยังมีการป้องกันตัวที่ดีอีกด้วย"

msgid "G177_E65_Zwilling_short"
msgstr "E 65 Zwilling"

msgid "G177_E65_Zwilling_short_special"
msgstr "ระบบปืนคู่, เกราะที่ไว้ใจได้"

msgid "G178_KanJpz_2"
msgstr "Kanonenjagdpanzer 2"

msgid "G178_KanJpz_2_descr"
msgstr "ในปี 1959 ก็ได้มีการออกแบบแรกๆของการติดตั้งปืน 105 มม.บน Kanonenjagdpanzer ในขณะเดียวกันก็เกิดปัญหากับการที่กระบอกปืนนั้นยาวออกมาด้านหน้าเกินไป ซึ่งทำให้โครงการ KanJpz-2 ได้เริ่มขึ้น ระบบปืนบนยานเกราะนั้นถูกย้ายถอยไปทางด้านขวาและด้านหน้าตัวถังก็จะเป็นแบบอสมมาตร โครงการนี้มีอยู่ในแบบพิมพ์เขียวแต่มีเพียงแผนการทำงานของ KanJpz-2 ที่ถูกนำไปใช้กับโครงการอื่นๆในภายหลังโดยไม่มีการพัฒนาโครงการนี้ต่อ"

msgid "G178_KanJpz_2_long_special"
msgstr "Kanonenjagdpanzer 2 เป็นยานพิฆาตรถถังเยอรมันระดับ VIII มีปืนขนาด 11 ซม. ระบบไฮโดรนิวมาติคทำให้ยานเกราะมีมุมกดปืนเพิ่มอีก 7 องศาและรูปแบบการเดินทาง/ยิงเร็วทำให้มีการเล่นเหมือนกับยานพิฆาตรถถังสวีเดน ยานพิฆาตรถถังคันนี้มีการป้องกันที่พื้นฐานแต่ความคล่องตัวในรูปแบบเดินทางทำให้มันเข้ายึดตำแหน่งได้อย่างรวดเร็ว ในรูปแบบยิงเร็ว ปืนนั้นควบคุมได้ดีและมีความเสียหายต่อนาทีสูง"

msgid "G178_KanJpz_2_short"
msgstr "KanJPz 2"

msgid "G178_KanJpz_2_short_special"
msgstr "ความคล่องตัวดี, ระบบช่วงล่างไฮโดรนิวมาติค"

msgid "G179_Straussler_V4"
msgstr "Straussler V–4/40"

msgid "G179_Straussler_V4_descr"
msgstr "ในฤดูใบไม้ร่วงปี 1936 เหล่านักออกแบบที่ Manfred Weiss ได้รับคำสั่งทำการพัฒนาและสร้างรุ่นปรับปรุงของรถถัง V-4 ในชื่อว่า V-4/40 ในด้านอาวุธ รถถังถูกกำหนดให้ติดตั้งปืน 40 มม.และมีปืนกลร่วมแกน 8 มม.ของ Gebauer ในฤดูใบไม้ผลิปี 1938 การพัฒนายานต้นแบบที่สองก็เสร็จสิ้นที่ Csepel ส่วนหน้าของตัวถังได้รับการปรับแต่งอย่างมากในขณะที่ป้อมปืนถูกขยายให้ใหญ่ที่สุดเท่าที่จะทำได้โดยมีฝาครอบที่มีกล้องสังเกตการณ์ หลายเดือนต่อมาการได้ทำการทดสอบครั้งสุดท้ายกับ V-4/40 แต่นั่นก็ทำให้รถถังถูกลดจำนวนการผลิตจนหยุดในที่สุดเนื่องจากปัญหาระบบกลไกและความคล่องตัวที่ต่ำ หลังจากนั้น อาวุธที่ติดตั้งบนรถถังก็ถูกปลดออกและนำรถถังมาใช้เป็นยานลากจูงจนถึงปี 1944 ในปี 1945 V-4/40 ก็ถูกยึดโดยกองทัพแดงโซเวียตและไม่มีบันทึกว่าเกิดอะไรขึ้นกับรถถังหลังจากนั้นมา"

msgid "G179_Straussler_V4_long_special"
msgstr "Straussler V-4/40 เป็นรุ่นปรับปรุงของรถถังฮังการี V-4 ที่มีปืนยิงเร็วขนาด 4 ซม.ที่สามารถทำความเสียหายข้าศึกได้มากหากไม่ระวัง รถถังอาจจะมีความคล่องตัวโดยรวมไปม่ดีนักแต่ก็ยังคล่องแคล่วพอและความทนทานของมันก็ทำให้สามารถออกรบพร้อมกับรถถังเบาคันอื่นๆได้"

msgid "G179_Straussler_V4_short"
msgstr "V–4/40"

msgid "G179_Straussler_V4_short_special"
msgstr "ปืน 4 ซม., ความคล่องตัวที่ดีพอตัว"

msgid "G17_JagdPzIV"
msgstr "Jagdpanzer IV"

msgid "G17_JagdPzIV_descr"
msgstr "รถถังกลาง Pz. IV เป็นฐานให้กับพาหนะจำนวนมากรวมถึงยานพิฆาตรถถัง ในช่วงสิ้นปี 1944 รุ่นปืน 75-mm PaK 42 L/70 ก็ถูกเตรียมไว้สำหรับฐานนี้ รุ่นดัดแปลงใหม่ของพาหนะก็ได้รับนามเรียกขานเป็น JagdPzIV/70 จากช่วงสิงหาคม 1944 ถึง มีนาคม 1945 บริษัท Nibelungenwerke ก็ได้ผลิตพาหนะรุ่นนี้ 278 คัน"

msgid "G17_JagdPzIV_short"
msgstr "Jg.Pz. IV"

msgid "G183_Fossa_VM_68"
msgstr "Fossa VM 68"

msgid "G183_Fossa_VM_68_descr"
msgstr "Radpanzer Versuchsmuster 68 Fossa นั้นเป็นโครงการรถถังล้อพัฒนาโดยเยอรมนีตะวันตกในปลายทศวรรษ 1960 การออกแบบนั้นกำหนดให้เป็นยานเกราะเร็วที่มีอาวุธดีสำหรับการลาดตระเวนและต่อสู้ยานเกราะข้าศึก ยานเกราะคันนี้น่าจะมีเครื่องยนต์วางลูกสูบสองแถวตัววีติดตั้งในตัวถังล้อแบบ 8 x 8 และมีระบบช่วงล่างเป็นอิสระทำให้หมุนตัวได้แบบรถถัง ปืน 105 มม.พร้อมปลอกลดเสียงได้รับการพิจารณาให้ติดตั้งบนยานเกราะแต่ก็พบข้อเสียร้ายแรงในช่วงเริ่มการออกแบบเพราะการจัดวางอุปกรณ์ที่แน่นภายในยานเกราะทำให้การซ่อมบำรุงและซ่อมแซมนั้นยากกว่าเดิมอีกทั้งมีขนาดถังเชื้อเพลิงไม่เพียงพอและมีรางกระสุนขนาดเล็กรวมไปถึงศูนย์ถ่วงที่สูงซึ่งลดความเสถียรระหว่างหมุนตัวและระหว่างการยิง โครงการนี้ถูกปิดตัวลงก่อนที่จะมีการสร้างรถต้นแบบขึ้น"

msgid "G183_Fossa_VM_68_long_special"
msgstr "Radpanzer Versuchsmuster 68 Fossa นั้นเป็นรถถังกลางล้อซุ่มยิงเยอรมันระดับ X ที่รวมความคล่องตัวชั้นยอดที่มาจากตัวถังล้อและเครื่องยนต์ที่ทรงพลังและปืนที่แม่นยำอย่างมาก ค่าคุณลักษณะเหล่านี้ทำให้ยานเกราะสามารถแทรกซึมเข้าแนวข้าศึกและทำการโจมตีจากมุมที่ไม่คาดคิดได้"

msgid "G183_Fossa_VM_68_short"
msgstr "Fossa VM 68"

msgid "G183_Fossa_VM_68_short_special"
msgstr "ความคล่องตัวที่ยอดเยี่ยม, ปืนที่แม่นยำ"

msgid "G183_Radkampfwagen"
msgstr "Radkampfwagen"

msgid "G183_Radkampfwagen_desc"
msgstr "โครงการรถถังล้อที่พัฒนาโดยเยอรมนีในปลายทศวรรษ 1960 มีการเสนอยานเกราะเร็วติดอาวุธดีสำหรับการลาดตระเวนและเข้าปะทะกับยานเกราะของข้าศึก ความคล่องตัวที่พอใช้นั้นมาจากเครื่องยนต์ขนาดย่อมของสหรัฐฯที่วางแบบตัววี, ตัวถังที่ใช้ล้อแบบ 8x8 และระบบช่วงล่างเป็นอิสระจากกันที่ทำให้สามารถหมุนกับที่เหมือนรถถังได้ ขนาดลำกล้องปืนนั้นถูกตั้งให้อยู่ที่ 90-105 มม. ข้อด้อยที่เห็นได้ชัดนั้นปรากฎในช่วงการออกแบบ: การจัดวางชิ้นส่วนที่แน่นหนามาก, ขนาดถังเชื้อเพลิงที่ไม่พอและขนาดรางกระสุนที่เล็กรวมไปถึงจุดศูนย์ถ่วงที่สูงซึ่งลดความเสถียรระหว่างหมุนตัวและยิงปืนใหญ่ โครงการนี้ปิดตัวลงก่อนที่จะมีการสร้างรถต้นแบบขึ้น"

msgid "G183_Radkampfwagen_long_special"
msgstr "Radkampfwagen นั้นเป็นรถถังกลางล้อซุ่มยิงเยอรมันระดับ X ที่รวมความคล่องตัวชั้นยอดที่มาจากตัวถังล้อและเครื่องยนต์ที่ทรงพลังและปืนที่แม่นยำอย่างมาก ค่าคุณลักษณะเหล่านี้ทำให้ยานเกราะสามารถแทรกซึมเข้าแนวข้าศึกและทำการโจมตีจากมุมที่ไม่คาดคิดได้"

msgid "G183_Radkampfwagen_short"
msgstr "RadKpfw."

msgid "G183_Radkampfwagen_short_special"
msgstr "ความคล่องตัวที่ยอดเยี่ยม, ปืนที่แม่นยำ"

msgid "G184_Windhund"
msgstr "Windhund"

msgid "G184_Windhund_descr"
msgstr "ในช่วงกลางทศวรรษ 1960 กองทัพบกเยอรมันที่ได้รับแรงบันดาลใจจาก Strv S ของสวีเดนก็ได้ตัดสินใจพยายามพัฒนายานเกราะลักษณะคล้ายกันให้กองทัพเยอรมัน ในปี 1966 บริษัท KraussMaffei และ Rheinmetall ได้เสนอตัวให้แข่งขันออกแบบรถถังไร้ป้อมปืนที่ติดตั้งปืนใหญ่เอาไว้ในตัวถัง สามปีต่อมา Rheinmetall ก็ได้เสนอรถต้นแบบในขณะที่ KraussMaffei ถอนตัวจากการแข่งขันเพื่อมุ่งเป้าหมายไปยังการผลิตและยกระดับรถถัง Leopard 1 อย่างไรก็ตาม รถต้นแบบนี้ถือว่ามีค่าการผลิตที่สูงมากโดยต่างจากรถถังรบหลัก Kpz. 70 ไม่มากทำให้โครงการหยุดลงจากการมีค่าใช้จ่ายสูงเกินไป มีการทดสอบต่อในปี 1972 แต่โครงการก็ปิดตัวลงในเวลาต่อมา"

msgid "G184_Windhund_long_special"
msgstr "Windhund เป็นยานพิฆาตรถถังระดับ VIII โดยมีจุดเด่นหลักจากรูปแบบยิงเร็วและช่วงล่างไฮโดรนิวมาติคที่เหมือนกับยานพิฆาตรถถังสวีเดน Windhund นั้นมีความคล่องตัวที่ดีมากในรูปแบบเดินทางและความคล่องตัวที่ใช้ได้ในรูปแบบยิงเร็วทำให้มันยังแล่นไปมาได้เล็กน้อยโดยไม่ต้องเปลี่ยนเป็นรูปแบบเดินทาง ยานเกราะยังใช้กระสุนที่สามารถเจาะเกราะได้สูงมากอีกด้วย"

msgid "G184_Windhund_short_special"
msgstr "ระบบช่วงล่างไฮโดรนิวมาติค, การเจาะเกราะสูง"

msgid "G185_Leopard_120_Verbessert"
msgstr "Leopard 120 Verbessert"

msgid "G185_Leopard_120_Verbessert_descr"
msgstr "ในปลายทศวรรษ 1970 ทางกองทัพเยอรมันมีความคิดติดตั้งปืนลำกล้องเรียบ 120 มม.จาก Leopard 2 บนรถถัง Leopard 1 ทุกคันซึ่งจะเพิ่มอำนาจการยิงของรถถังอย่างมาก มีการพิจารณาตัวเลือกการดัดแปลงหลายแบบด้วยกันแต่หลังจากที่เริ่มทำการผลิตจำนวนมากของรถถัง Leopard 2 แผนก็ถูกล้มเลิกเนื่องด้วยการป้องกันไม่ให้เกิดการขาดแคลนปืนและทำให้สามารถผลิตรถถังใหม่ได้ทันตามกำหนด"

msgid "G185_Leopard_120_Verbessert_long_special"
msgstr "Leopard 120 Verbessert นั้นเป็นรถถังกลางที่ทำการรบเหมือนรถถังกลางซุ่มยิงเพราะความสามารถอยู่รอดของรถถังนั้นจำกัดแต่ก็ชดเชยได้ด้วยความคล่องตัวและอำนาจการยิงอันยอดเยี่ยม รถถังรุ่นนี้มีประสิทธิภาพมากที่สุดที่ระยะไกลซึ่งอยู่ห่างจากการยิงของข้าศึกและศักยภาพการซุ่มยิงของมันก็ยังถูกเสริมด้วยระบบปรับปรุงการเล็งเฉพาะตัว"

msgid "G185_Leopard_120_Verbessert_short"
msgstr "Leopard 120"

msgid "G186_Schwertwal"
msgstr "Schwertwal"

msgid "G186_Schwertwal_descr"
msgstr "รถถังนี้ออกแบบมาสำหรับการขจัดข้อด้อยและเน้นจุดเด่นของ Panzerkampfwagen VI และ VI Ausf. B (Tiger II) การปรับปรุงหลักที่มีคือเกราะพร้อมกับชิ้นส่วนที่หล่อขึ้นรูปทำให้การผลิตมีความซับซ้อนน้อยลง นอกจากนี้ หนึ่งในการออกแบบที่เด่นคือการวางเครื่องยนต์และระบบส่งกำลังเอาไว้ในห้องเดียวกันทำให้การจัดวางรถถังดีขึ้น ตัวถังยังคงใช้ล้อขับซ้อนกันเช่นเดิมทำให้แล่นได้อย่างราบรื่นในขณะที่เครื่องยนต์ไอพ่นเชื้อเพลิงแข็งจาก R4M Orkan ก็ถูกติดตั้งเอาไว้ที่ด้านข้างเพื่อช่วยให้ปรับเสถียรและเพิ่มความว่องไวในภาวะฉุกเฉิน แม้จะมีการออกแบบที่ก้าวหน้ามาก รถถังคันนี้ก็มีจุดด้อยจากการปรับลาดเอียงของเกราะที่ด้านหน้าและกำลังขับจำเพาะที่ต่ำทำให้มีความคล่องตัวและสมรรถนะการรบที่จำกัด"

msgid "G186_Schwertwal_long_special"
msgstr "Schwertwal เป็นรถถังหนักจู่โจมของเยอรมันระดับ X ปืนขนาด 15 ซม.ที่ทำความเสียหายต่อนัดมหาศาลนั้นเหมาะกับการรบระยะประชิด ป้อมปืนของรถถังนั้นมีความทนทานอย่างมากโดยไม่มีจุดอ่อนใดๆ ความคล่องตัวพื้นฐานนั้นเพิ่มให้ดีขึ้นได้ด้วยการใช้ตัวเร่งเครื่องยนต์ไอพ่นที่ทำงานได้นาน"

msgid "G186_Schwertwal_short"
msgstr "Schwertwal"

msgid "G186_Schwertwal_short_special"
msgstr "ตัวเร่งไอพ่น, เกราะป้อมปืนที่ยอดเยี่ยม"

msgid "G187_Taschenratte"
msgstr "Taschenratte"

msgid "G187_Taschenratte_descr"
msgstr "โครงการปรับปรุงให้ทันสมัยของ Panzerkampfwagen VIII Maus ที่เน้นการปรับตัวถังให้ดีขึ้นอย่างมาก มุมลาดเอียงและความหนาเกราะนั้นถูกปรับให้เพิ่มการป้องกันโดยไม่เพิ่มน้ำหนักขึ้นอย่างมากเกินไป ในขณะเดียวกันก็มีการปรับแก้ป้อมปืนที่เพื่อขจัดโอกาสที่กระสุนจะสะท้อนไปยังตัวถังด้านบน เครื่องยนต์และระบบส่งกำลังถูกย้ายไปทางด้านหลังและป้อมปืนถูกย้ายมาใกล้จุดศูนย์ถ่วงมากขึ้นซึ่งน่าจะช่วยให้การกระจายน้ำหนักและพื้นที่่่ภายในดีขึ้น นักออกแบบวางแผนที่จะติดตั้งระบบปล่อยทุ่นระเบิดและการป้องกันอาวุธทำลายล้างสูง (รวมไปถึงการกันรังสี) โครงการนี้ถูกปิดตัวลงเนื่องจากไม่สามารถแก้ไขความคล่องตัวที่ต่ำได้"

msgid "G187_Taschenratte_long_special"
msgstr "Taschenratte เป็นรถถังหนักยิ่งยวดที่มีความคล่องตัวจำกัดแต่มีความสามารถอยู่รอดแบบไร้เทียมทาน เกราะลาดเอียงจำนวนมากทำให้มันแทบจะเป็นอมตะจากการยิงของข้าศึกและสมบูรณ์แบบสำหรับการเป็นหน่วยรักษาจุดสำคัญหรือหน่วยทะลวงแนวข้าศึก รถถังคันนี้มีอำนาจการยิงที่น่ากลัวอยู่แล้วและยังสามารถเสริมได้ด้วยระบบอาวุธรองที่เพิ่มศักยภาพการรบของมันยิ่งขึ้นกว่าเดิม"

msgid "G187_Taschenratte_short"
msgstr "Taschenratte"

msgid "G188_LeKpz_Borkenkafer"
msgstr "leKpz Borkenkäfer"

msgid "G188_LeKpz_Borkenkafer_descr"
msgstr "ในช่วงทศวรรษ 1970 ทางเยอรมันได้เริ่มทำการพัฒนาตัวถังสากลสำหรับรถถังเบาประจำกองทัพบกเยอรมัน หนึ่งในโครงการนั้นเป็นโครงรถถังใหม่ที่มีชื่อไม่เป็นทางการว่า Borkenkäfer (ด้วงเปลือกไม้) รถถังเบานี้มีปืนที่ถือว่าทรงพลัง (ได้ถึง 105 มม.) และค่าความคล่องตัวที่ดี ระบบควบคุมการยิงนั้นเป็นศูนย์เล็งสองช่องและระบบวัดระยะสองระบบเพื่อให้มีความแม่นยำการยิงสูงไม่ว่าจะสภาพอากาศใด เนื่องจากความซับซ้อนของระบบควบคุมการยิง โครงการนี้ก็ถูกลดลงเป็น PUMA (Panzer unter minimalen Aufwand หรือรถถังราคาต่ำ) แทนและถูกปิดตัวลงในที่สุด แม้ว่าจะมีการสร้างโครงรถขึ้นมา ตัวรถถังทั้งคันก็มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "G188_LeKpz_Borkenkafer_long_special"
msgstr "leKpz Borkenkäfer นั้นเป็นรถถังเบาที่รวมความคล่องตัวที่ยอดเยี่ยมและการควบคุมปืนที่ดี ทำให้มันสามารถออกปฏิบัติหน้าที่ที่หลากหลายในสนามรบได้ ในช่วงเริ่มการรบรถถังจะเน้นการตรวจจับและโต้ตอบหน่วยลาดตระเวนข้าศึก แล้วจึงเปลี่ยนเป็นการใช้อำนาจการยิงของมันในการกำจัดข้าศึกที่เหลือ ระบบระบุเป้าหมายรุ่นทดลองของ Borkenkäfer นั้นจะเสริมสมรรถนะการลาดตระเวนของมันให้ดีขึ้นอย่างมาก"

msgid "G188_LeKpz_Borkenkafer_short"
msgstr "Borkenkäfer"

msgid "G189_Hirschkafer"
msgstr "Hirschkäfer"

msgid "G189_Hirschkafer_descr"
msgstr "โครงการยานพิฆาตรถถังเยอรมันจากทศวรรษ 1970 โดยมีต้นแบบจาก Leopard 1 ที่มีระบบป้อนกระสุนอัตโนมัติ นักออกแบบนั้นเชื่อว่ายานเกราะนี้สามารถยิงรถถังข้าศึกจากระยะไกลมากจนไม่สามารถยิงโต้ตอบได้ อย่างไรก็ตามก็พบว่างานดังกล่าวนั้น Leopard 2 ที่เป็นรถถังคันล่าสุดของกองทัพบกเยอรมันก็สามารถปฏิบัติได้ดีเท่ากันเช่นกัน และนั่นทำให้ทางกองทัพตัดสินใจไม่ทำการสร้างรถต้นแบบของยานเกราะรุ่นนี้"

msgid "G189_Hirschkafer_long_special"
msgstr "ยานพิฆาตรถถังซุ่มยิงตัวจริง Hirschkäfer นั้นมีปืนที่มีความแม่นยำและการควบคุมที่ดีมาก ในขณะที่ความคล่องตัวอันยอดเยี่ยมของยานเกราะทำให้สามารถแล่นข้ามสนามรบได้อย่างอิสระ แม้ว่าจะไม่เหมาะกับการเดินแผนพลาดแต่ถ้าหาตำแหน่งยิงที่ระวัง Hirschkäfer ก็สามารถเลือกจังหวะเหมาะในการยิงทำลายล้างได้"

msgid "G189_Hirschkafer_short"
msgstr "Hirschkäfer"

msgid "G18_JagdPanther"
msgstr "Jagdpanther"

msgid "G18_JagdPanther_descr"
msgstr "ยานเกราะพิฆาตรถถังชนิดนี้สร้างจากตัวถังของรถถังใหม่ VK 30.02 (MAN) โดยเริ่มการผลิตนับตั้งแต่ปี 1942 ในเดือนตุลาคม 1943 ก็ได้มีการเริ่มทดสอบรถต้นแบบ มียอดการผลิตทั้งหมด 392 คัน"

msgid "G18_JagdPanther_short"
msgstr "JPanther"

msgid "G191_StuG_IIIF_CFE_A"
msgstr "StuG III Ausf. F Kabasan"

msgid "G191_StuG_IIIF_CFE_A_descr"
msgstr "เมื่อเผชิญหน้ากับยานเกราะข้าศึกจำนวนมาก ทางทหารเยอรมันก็ได้ทำการปรับปรุง StuG III โดยการติดตั้งปืน 7.5 cm StuK 40 L/43, รางกระสุนใหม่และพัดลมระบายอากาศ หลังจากการทดสอบที่สำเร็จในเดือนเมษายน 1942 ก็เริ่มทำการผลิตจำนวนมากขึ้น ยานเกราะ 120 คันแรกนั้นใช้ปืน StuK 40 L/43 และ 240 คันถัดมาก็ได้ใช้ปืน StuK 40 L/48 ความหนาเกราะส่วนหน้านั้นเพิ่มจาก 50 มม.เป็น 80 มม. โดยรวมแล้วมีรุ่นดัดแปลงเหล่านี้ผลิตรวมกันในจำนวน 360 คัน ทีมฮิปโปนั้นได้เผชิญหน้ากับวิทยาลัยสตรี St. Gloriana ในการแข่งกระชับมิตรและประดับลายที่เป็นตัวแทนความหลงไหลในประวัติศาสตร์การทหาร ด้วยยุทธวิธีที่ใช้ประโยชน์จากพื้นท่ี่เมือง ทางทีมก็ได้ประสบความสำเร็จอย่างเห็นได้ชัด นับแต่นั้นมากในทุกการแข่ง ทีมฮิปโปก็ได้ใช้ลายพรางแนวสีเทาและฝึกทักษะของพวกเธอในการอำพรางตัวและการซุ่มโจมตี"

msgid "G191_StuG_IIIF_CFE_A_long_special"
msgstr "StuG III Ausf. F Kabasan นั้นเป็นยานพิฆาตรถถังเยอรมันระดับ V ด้วยเครื่องยนต์ที่ทรงพลังและปืนที่ไว้ใจได้ ยานเกราะคันนี้ถือว่ามีความอเนกประสงค์สูงมาก มันสามารถทำการเปลี่ยนตำแหน่งได้อย่างรวดเร็วในแผนที่เมื่อจำเป็นและสามารถทำความเสียหายพาหนะข้าศึกได้อย่างหนักอีกทั้งยังมีการอำพรางตัวที่ดีทำให้สามารถใช้กลยุทธ์ล่องหนได้"

msgid "G191_StuG_IIIF_CFE_A_short"
msgstr "StuG III Kaba"

msgid "G191_StuG_IIIF_CFE_A_short_special"
msgstr "ความคล่องตัวดีกับอัตราการยิงที่สูง"

msgid "G193_Pz_Kpfw_55"
msgstr "Pz.Kpfw. 55"

msgid "G193_Pz_Kpfw_55_descr"
msgstr "ในช่วงท้ายสงครามโลกครั้งที่สอง ทางเยอรมนีมีความต้องการรถถังหนักยุคใหม่ที่มีปืนที่ทรงพลังกว่าเดิมเพื่อต่อสู้กับยาเนกราะใหม่ของสัมพันธมิตรที่ปืนของรถถังผลิตจำนวนมากไม่สามารถทำความเสียหายได้อย่างแน่นอน เพื่อเป็นการเสริมประสิทธิภาพปืนที่มีอยู่เดิมโดยไม่ต้องพัฒนาปืนรุ่นใหม่ขึ้น ทางวิศวกรก็ได้เสนอทำการใช้ห้องดินขับเสริม โครงการดังกล่าวเป็นของรถถัง Panzerkampfwagen 55 Adler อย่างไรก็ตามแม้ว่าจะมีการทดลองกับปืนห้องดินขับเสริมและมีการใช้รวมกับยานเกราะหนักก็ไม่สามารถทำให้โครงการได้พัฒนาต่อ วงการอุตสาหกรรมที่รับภาระงานมากเกินไปและการแพ้ของเยอรมนีทำให้โครงการนี้หยุดลงในช่วงการร่างแบบพิมพ์เขียวเท่านั้น"

msgid "G193_Pz_Kpfw_55_short"
msgstr "Pz. 55"

msgid "G195_HWK_40"
msgstr "HWK 40"

msgid "G195_HWK_40_descr"
msgstr "โครงการรถถังหนักจากปลายทศวรรษ 1960 ที่มุ่งหมายให้รุ่นหนักกว่าที่มีการป้องกันและอำนาจการยิงที่ดีกว่าของรถถังหลักนิยม Leopard 1 โดยยังมีการปรับแต่งแบบเดิม รถถังคันนี้รวมแนวการออกแบบตามธรรมเนียมและองค์ประกอบใหม่เข้าด้วยกันคือ ระบบการปรับเสถียรพัฒนาใหม่, ระบบส่งกำลังรุ่นล่าสุดและชุดเกราะรุ่นทดลอง การพัฒนาเริ่มขึ้นตั้งแต่ 1967 ถึง 1971 โดยมีการสร้างแบบจำลองขนาดเต็มขึ้นมา อย่างไรก็ตามด้วยหลายสาเหตุ (โดยหลักมาจากการที่น้ำหนักที่มากของรถถังไม่ตรงกับแนวหลักนิยมของกองทัพบกเยอรมันที่ต้องการกองรบที่คล่องตัว) ทำให้โครงการไม่ได้ทำการพัฒนาต่อ แต่กระนั้นเอง แนวการออกแบบทางเทคนิคหลายอย่างก็ถูกใช้ต่อมาในการวิจัยที่นำไปสู่รถถังของรุ่นถัดไปซึ่งรวมไปถึง Leopard 2"

msgid "G195_HWK_40_long_special"
msgstr "HWK 40 นั้นเป็นรถถังหนักเยอรมันระดับ IX ที่สามารถปฏิบัติงานได้หลากหลายจากคุณลักษณะที่ดีของรถถังเองเช่นความคล่องตัวที่ดี, ปืนที่ใช้งานได้สะดวกและเกราะที่ดีพอตัว ส่วนผสมนี้ยังถูกเสริมด้วยระบบที่ทำให้คุณสามารถปรับคุณลักษณะของกระสุนได้เมื่อจำเป็น"

msgid "G195_HWK_40_short"
msgstr "HWK 40"

msgid "G195_HWK_40_short_special"
msgstr "ความคล่องตัวดี, ปืนที่ควบคุมได้ง่าย"

msgid "G196_Versuchspanzer_57"
msgstr "Versuchspanzer 57"

msgid "G196_Versuchspanzer_57_descr"
msgstr "ในช่วงทศวรรษ 1950 มีการเริ่มพัฒนาโครงการ Versuchpanzer 57 ที่เยอรมนี เหล่าวิศวกรของกองทัพบกเยอรมันได้ยืมแนวการออกแบบของยานเกราะรุ่นก่อนหน้าโดยมีแผนที่จะทดสอบปืนที่มีห้องดินขับเสริมซึ่งพัฒนาขึ้นในช่วงสงครามโลกกับรถถังคันนี้ อย่างไรก็ตาม การพัฒนาเผชิญกับปัญหาใหญ่ซึ่งก็คือวงการอุตสาหกรรมเพิ่มจะคืนสภาพจากสงครามและการนำรถถัง M47 ของสหรัฐฯเข้าประจำการกองทัพทำให้ฝ่ายเสนาธิการของกองทัพเลือกที่ลดการใช้ทรัพยากรกับการพัฒนารถถังของตัวเองขึ้น ทั้งหมดนี้ก็เป็นผลให้โครงการถูกพักการพัฒนาชั่วคราว เมื่อมีการพัฒนารถถังยุโรปรวมขึ้นมา โครงการนี้ก็ถูกปิดตัวอย่างถาวร"

msgid "G196_Versuchspanzer_57_short"
msgstr "VPz 57"

msgid "G197_Pz_Kpfw_Neu"
msgstr "Pz.Kpfw. Neu"

msgid "G197_Pz_Kpfw_Neu_descr"
msgstr "โครงการ Panzerkampfwagen Neu-70/120 นั้นเป็นความพยายามพัฒนาเพื่อหารถถังมาแทนที่รถถัง Leopard 1 และมุ่งหมายไม่ได้ให้เป็นเพียงยานรบคั่นกลางแต่ยังเป็นตัวเลือกทางวิทยาการที่โดดเด่นสำหรับรถถังรบหลักยุคต่อไป รถถังนี้ก็ควรจะมีตัวถังและป้อมปืนเชื่อมเข้าด้วยกันและมีการมุ่งเป้าในการเพิ่มโอกาสการยิงเข้าเป้าหมายในนัดแรกด้วยการใช้ระบบควบคุมการยิงรุ่นก้าวหน้า รุ่นนี้เองก็ถือเป็นรถถังรุ่นแรกที่องค์กรออกแบบรถถังเยอรมันได้พิจารณาการใช้ปืนใหญ่ 120 มม.ที่มีกระสุนตั้งเวลาระเบิดระยะไกลที่ทำให้สามารถทำความเสียหายเป้าหมายที่อยู่หลังที่กำบังได้อย่างมีประสิทธิภาพ อย่างไรก็ตาม การวิเคราะห์ของโครงการก็ได้แสดงให้เห็นปัญหาหลายอย่างเช่น ตัวถังและป้อมปืนมีน้ำหนักสูงเกินไป, ราคาที่สูงและความเป็นไปได้ในการปรับให้ทันสมัยที่ต่ำ นอกจากนี้ ก็มีโครงการที่มีความสมดุลอยู่แล้วซึ่งก็คือ Leopard 2 ทำให้การพัฒนาถูกเห็นว่าไม่มีโอกาสพัฒนาต่อและทำให้ถูกปิดตัวลง"

msgid "G197_Pz_Kpfw_Neu_long_special"
msgstr "Pz.Kpfw. Neu นั้นออกแบบมาสำหรับความอเนกประสงค์ขั้นสูงสุดและการปรับตัวตามสถานการณ์มากกว่าความยอดเยี่ยมในคุณลักษณะใดคุณลักษณะหนึ่ง นอกเหนือไปจากเกราะที่ทนทาน, ความคล่องตัวที่ดีและปืนที่ควบคุมได้สบายแล้ว ปืนยังมีระบบตั้งโปรแกรมชนวนกระสุนและห้องดินขับเสริมทำให้สามารถปรับคุณลักษณะของกระสุนและปรับการเจาะเกราะได้ด้วย"

msgid "G197_Pz_Kpfw_Neu_short"
msgstr "Pz. Neu"

msgid "G198_Kampfpanzer_67"
msgstr "Kampfpanzer 67"

msgid "G198_Kampfpanzer_67_descr"
msgstr "ในทศวรรษ 1960 ที่ยังมีการพัฒนาชุดโครงการรถถังที่มีระบบเสริมอำนาจการยิงแบบทดลองกำลังดำเนินอยู่ ทางองค์กรกลางวิทยาการทหารและการจัดหาก็ได้ทำการพิจารณาโครงการยานเกราะหนัก Kampfpanzer 67 ซึ่งมีการกำหนดให้ใช้ระบบตั้งโปรแกรมชนวนกระสุนและมีห้องดินขับเสริมหรือแม้กระทั่วรวมทั้งสองระบบเข้าด้วยกัน ห้องดินขับเสริมนั้นเป็นวิทยาการที่มีการพัฒนามากว่าหนึ่งทศวรรษแล้วและระบบตั้งโปรแกรมชนวนก็ถูกพิจารณาว่าเป็นแนวการพัฒนาที่น่าสนใจ อย่างไรก็ตาม การเปิดตัวของอาวุธต่อสู้รถถังใหม่และค่าการพัฒนาที่สูงเมื่อเทียบกับ Leopard 1 นั้นก็ทำให้โครงการต้องปิดตัวลงในช่วงเริ่มต้นได้ไม่นาน"

msgid "G198_Kampfpanzer_67_short"
msgstr "KPz 67"

msgid "G200_Chi_Go"
msgstr "Chi-Go"

msgid "G200_Chi_Go_desc"
msgstr "ในช่วงต้นปี 1945 เหล่าวิศวกรญี่ปุ่นได้เริ่มพัฒนาโครงการ Chi-Go ของตัวเองโดยมีต้นแบบจากเอกสารทางเทคนิคของเยอรมันของ PzKpfw V Panther ที่มีการปรับแต่งให้ง่ายขึ้นและประกอบได้ง่ายขึ้นกว่าเดิม ต่อมา ทางเยอรมนีที่่วงการอุตสาหกรรมกำลังเผชิญกับปัญหาก็เริ่มสนใจในยานเกราะรุ่นนี้ รุ่นยานเกราะที่ถูกถอดชิ้นส่วนได้ถูกส่งต่อด้วยเรือดำน้ำสำหรับการวิจัยและใช้งานวิทยาการการผลิตรถถังที่ง่ายขึ้นกว่าเดิม"

msgid "G200_Chi_Go_long_special"
msgstr "Chi-Go นั้นเป็นรถถังกลางอเนกประสงค์เยอรมันระดับ VII ที่ต่างจาก Pz.Kpfw V Panther ที่คุ้นเคยด้วยการใช้วิทยาการของญี่ปุ่น รถถังคันนี้มีความเสียหายต่อนัดสูงเมื่อเทียบกับ Panther ระดับเดียวกัน ป้อมปืนหุ้มเกราะที่ใช้ได้และมีความคล่องตัวปานกลางที่ทำให้มีแนวการเล่นเชิงรุกได้ถ้าหากจำเป็น"

msgid "G200_Chi_Go_short"
msgstr "Chi-Go"

msgid "G200_Chi_Go_short_special"
msgstr "ป้อมปืนมีเกราะใช้ได้, ความเสียหายต่อนัดสูง"

msgid "G204_PzVI_Tiger_P_CFE_A"
msgstr "VK 45.01 (P)"

msgid "G204_PzVI_Tiger_P_CFE_A_descr"
msgstr "?empty?"

msgid "G204_PzVI_Tiger_P_CFE_A_long_special"
msgstr "VK 45.01 (P) เป็นรถถังหนักเยอรมันระดับ VI ที่มีเกราะหน้าทนทานสามารถต้านทานกระสุนปกติจากรถถังกลางและรถถังหนักระดับเดียวกันได้อย่างดี ปืนของมันมีความเสียหายต่อนาทีที่ดีอีกทั้งยังเจาะเกราะได้ดีและมีความเสียหายต่อนัดสูง แม้ว่าจะช้า รถถังคันนี้ก็มีระบบเฉพาะที่เพิ่มความคล่องตัวชั่วคราวทำให้มันเร่งความเร็วสูงสุดได้รวดเร็ว"

msgid "G204_PzVI_Tiger_P_CFE_A_short"
msgstr "VK 45.01 (P)"

msgid "G204_PzVI_Tiger_P_CFE_A_short_special"
msgstr "เกราะหน้าทนทาน, ระบบปรับปรุงความคล่องตัว"

msgid "G20_Marder_II"
msgstr "Marder II"

msgid "G20_Marder_II_descr"
msgstr "ยานพิฆาตรถถังเบาถูกพัฒนาช่วงต้นปี 1942 โดยใช้ตัวถังของรถถัง Pz. Kpfw. II ที่ล้าสมัยและผลิตออกมาจำนวนมากและติดตั้งปืนที่ทรงพลังไว้ พาหนะรุ่นนี้ถูกใช้อย่างแพร่หลายในแนวรบตะวันออก ตั้งแต่ปี 1944 พาหนะรุ่นนี้ก็ยังเข้าร่วมการรบในอิตาลีและแนวรบตะวันตก ยานพิฆาตรถถังรุ่นนี้เข้าประจำการจนสิ้นสุดสงคราม"

msgid "G20_Marder_II_short"
msgstr "Marder II"

msgid "G23_Grille"
msgstr "Grille"

msgid "G23_Grille_descr"
msgstr "ปืนอัตตาจรเยอรมันในสงครามโลกครั้งที่สอง สร้างขึ้นบนตัวถัง Pz.Kpfw. 38(t) ของเชคโกสโลวาเกียในช่วงปี 1943 ถึง 1944 มียอดการผลิตทั้งหมด 282 คัน"

msgid "G23_Grille_short"
msgstr "Grille"

msgid "G24_VK3002DB"
msgstr "VK 30.02 (D)"

msgid "G24_VK3002DB_descr"
msgstr "รถต้นแบบถูกผลิตขึ้นในช่วงฤดูใบไม้ผลิปี 1942 โดยคาดมาให้เป็นตัวแทนโครงการที่ปรับใหม่ของ Daimler-Benz ตัวรถใช้ตัวถังใหม่ที่มีช่วงล่างเพลาเหล็กบิดและลูกล้อแปดล้อรองรับในแบบตาหมากรุก มีการวางแผนทำการติดตั้งเครื่องยนต์ Maybach HL 210 P45 และปืน 75 มม. KwK 42 L/71 บนตัวรถ อย่างไรก็ตามโครงการของ MAN (ที่จะมาเป็น Pz. Kpfw. V Panther ในอนาคต) ถูกรับเลือกแทน จึงไม่มีการผลิตรถต้นแบบของ Daimler-Benz ต่อ"

msgid "G24_VK3002DB_short"
msgstr "VK 30.02 D"

