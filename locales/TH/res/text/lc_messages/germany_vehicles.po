msgstr "Jg. E 100 7x7"

msgid "G72_JagdPz_E100_descr"
msgstr "E 100 นั้นเกิดขึ้นโดยมุ่งให้เป็นฐานของปืนอัตตาจร ปืนต่อต้านอากาศยาน และยานพิฆาตรถถัง แต่การพัฒนาในด้านนี้ก็ไม่ได้มีความคืนหน้าแต่อย่างใด"

msgid "G72_JagdPz_E100_short"
msgstr "Jg.Pz. E 100"

msgid "G73_E50_Ausf_M"
msgstr "E 50 Ausf. M"

msgid "G73_E50_Ausf_M_descr"
msgstr "กองทัพบกเยอรมันต้องการให้รถถังรุ่น E มีระบบส่งกำลังอยู่ด้านหลังของตัวรถถัง อย่างไรก็ตาม รถถัง E 50 และ E 75 ใช้ระบบส่งกำลังของ Tiger II ซึ่งทำให้วิศวกรทำงานได้เร็วขึ้นแต่ก็ทำให้การวางเครื่องด้านหลังเป็นไปไม่ได้ รถถังรุ่น E 50 Ausf. M เป็นการออกแบบใหม่ของโครงการ E 50 พร้อมด้วยการวางระบบส่งกำลังไว้ด้านหลังตัวถังรถ"

msgid "G73_E50_Ausf_M_short"
msgstr "E 50 M"

msgid "G77_PzIV_Schmalturm_SHXXI_B"
msgstr "หมาป่า"

msgid "G77_PzIV_Schmalturm_SHXXI_B_short"
msgstr "หมาป่า"

msgid "G81_Pz_IV_AusfH"
msgstr "Pz.Kpfw. IV Ausf. H"

msgid "G81_Pz_IV_AusfH_GuP"
msgstr "Pz.Kpfw. IV Ausf. H Ankou"

msgid "G81_Pz_IV_AusfH_GuP_descr"
msgstr "Pz.Kpfw. IV Ausf. H Ankou นั้นเป็นรถถังประจำทีม Anglerfish ซึ่งประกอบด้วยนักเรียนห้าคนจากโรงเรียนมัธยมสตรี Oarai นำโดย Miho Nishizumi รถถังคันนี้เป็นปัจจัยสำคัญของชัยชนะครั้งสำคัญของโรงเรียน Oarai ในการแข่งขันกับทีม Saunders, Anzio, Pravda และ Kuromorimine รถถังคันนี้เป็นคันแรกที่ทีม Sensha-Dō ของโรงเรียน Oarai ที่ทำการตั้งทีมขึ้นมาใหม่อีกครั้งเพื่อเข้าร่วมการแข่งขันทัวร์นาเมนต์มัธยมปลายระดับชาติหลังจากที่ถูกปล่อยให้ทิ้งร้างในโรงรถของโรงเรียนเป็นเวลาหลายปีโดยในแรกเริ่มที่พบอยู่ในสภาพที่ย่ำแย่มาก แต่หลังจากการตรวจสภาพโดยละเอียดแล้วเกราะกับตีนตะขาบก็ยังสามารถใช้การได้ดี ซึ่งเป็นจุดเริ่มต้นของทีมในการยกระดับรถถังคันนี้ในหลายส่วนในเวลาต่อมารวมไปถึงการติดตั้งเกราะแบบกลวงและปืนที่มีขนาดลำกล้องใหญ่ขึ้น"

msgid "G81_Pz_IV_AusfH_GuP_long_special"
msgstr "ตัวอย่างชั้นดีของรถถังกลางเยอรมันของระดับนี้ที่มีเกราะดีพอตัว ปืนที่ไว้ใจได้และความเร็วที่ดี รถถังคันนี้มีจุดเด่นที่มุมกดปืนและแผงเกราะป้องกันที่ดีเยี่ยม"

msgid "G81_Pz_IV_AusfH_GuP_short"
msgstr "Pz. IV H Ankou"

msgid "G81_Pz_IV_AusfH_GuP_short_special"
msgstr "การเจาะเกราะที่เยี่ยม มุมกด/มุมยกปืนและแผงเกราะป้องกันที่ดี"

msgid "G81_Pz_IV_AusfH_descr"
msgstr "รุ่น G ของ Pz. IV ถูกผลิตขึ้นในช่วงพฤษภาคม 1942 ในเดือนเมษายน 1943 ได้เริ่มทำการผลิตรุ่น H ซึ่งกลายมาเป็นรุ่นที่ถูกผลิตมากที่สุดของ Pz. IV รุ่น Ausf. H มีปืนยกระดับแล้วแบบเดียวกันกับ Ausf. G. และใช้แผ่นลาดด้านหน้าขนาด 80 มม.แผ่นเดียวแทนที่จะใช้แผ่นเรียงเป็นชั้น ระบบส่งกำลังใหม่ลดความเร็วพาหนะลงเล็กน้อยแต่เชื่อถือได้มากกว่าเดิม รถถังของรุ่นนี้ก็มีการติดแผ่นตาข่ายหนาขนาด 5-8 มม.รอบด้านข้างของตัวรถและป้อมปืน มียอดการผลิตรุ่น Ausf. H. ทั้งหมด 3,774 คัน"

msgid "G81_Pz_IV_AusfH_short"
msgstr "Pz. IV H"

msgid "G82_Pz_II_AusfG"
msgstr "Pz.Kpfw. II Ausf. G"

msgid "G82_Pz_II_AusfG_descr"
msgstr "รถถังลาดตระเวณเบาเยอรมันในสงครามโลกครั้งที่สองเป็นการดัดแปลงของรถถัง Pz. II รถถังคันนี้มีตัวถังและช่วงล่างที่ได้รับการปรับปรุง เครื่องยนต์ที่ทรงพลังกว่าเดิม อีกทั้งมีอุปกรณ์สังเกตการณ์สำหรับพลวิทยุและพลขับที่ทำให้เพิ่มระยะการมองเห็นกว่าเดิม"

msgid "G82_Pz_II_AusfG_short"
msgstr "Pz. II G"

msgid "G85_Aufklarungspanzer_V"
msgstr "Aufklärungspanzer V"

msgid "G85_Aufklarungspanzer_V_descr"
msgstr "ในเบื้องต้นถูกวางให้เป็นยานลาดตระเวณขนาดหนัก โดยใช้ตัวถัง Panther การใช้ตัวถังและลำตัวของรถถังที่่มีอยู่แล้วจะทำให้ผลิตจำนวนมากได้เร็วขึ้น ป้อมปืนที่เล็กลงจะทำให้ลดน้ำหนักและเพิ่มความคล่องตัวของพาหนะ แต่อย่างไรก็ตาม โครงการก็ถูกหยุดลงในช่วงการพัฒนา"

msgid "G85_Aufklarungspanzer_V_long_special"
msgstr "รถถังเบาเยอรมันระดับ VII ที่มีตัวถังใหญ่ซึ่งชดเชยด้วยเกราะหน้าที่ใช้ได้และกระสุนเจาะเกราะหัวผสมแกนแข็งที่มีค่าการเจาะเกราะดี รถถังคันนี้สามารถเป็นได้ทั้งหน่วยชี้เป้าไม่เปิดเผยตัวหรือเป็นหน่วยไล่ล่ารถถังเบาและปืนอัตตาจรข้าศึก"

msgid "G85_Aufklarungspanzer_V_short"
msgstr "Aufkl.Pz. V"

msgid "G85_Aufklarungspanzer_V_short_special"
msgstr "ความคล่องตัวที่ดีและการเจาะเกราะที่สมูบรณ์แบบของกระสุน APCR"

msgid "G88_Indien_Panzer"
msgstr "Indien-Panzer"

msgid "G88_Indien_Panzer_descr"
msgstr "โครงการนี้เกิดขึ้นเพื่อทำการพัฒนารถถังกลางสำหรับกองทัพอินเดีย ซึ่งโครงการนี้อยู่ภายใต้การดำเนินการของบริษัท Porsche Daimler-Benz และ Zahnradfabrik ตั้งแต่ปี 1954 ถึง 1955 แต่ยานเกราะดังกล่าวถือว่าซับซ้อนเกินสำหรับการผลิตในอินเดียและถูกยกเลิกไป"

msgid "G88_Indien_Panzer_short"
msgstr "Indien-Pz."

msgid "G89_Leopard1"
msgstr "Leopard 1"

msgid "G89_Leopard1_descr"
msgstr "รถถังรบหลักของสาฐารณรัฐเยอรมนี การพัฒนาเริ่มขึ้นในปี 1956 รถต้นแบบถูกสร้างขึ้นในปี 1965 ที่โรงงาน Krauss-Maffei Leopard 1 นั้นเข้าประจำการในประเทศมากกว่า 10 ประเทศ"

msgid "G89_Leopard1_short"
msgstr "Leopard 1"

msgid "G91_Pro_Ag_A"
msgstr "Leopard Prototyp A"

msgid "G91_Pro_Ag_A_descr"
msgstr "รถถังต้นแบบพัฒนาขึ้นในปี 1960 ถึง 1961 เพื่อเป็นรถถังกลางสำหรับกองทัพเยอรมัน โดยมีจำนวนรถต้นแบบทั้งหมด 26 คัน รถต้นแบบดังกล่าวถูกทดสอบถึงปี 1963 ยานเกราะรุ่นนี้เป็นยานเกราะต้นแบบให้กับรถถังกลาง Leopard"

msgid "G91_Pro_Ag_A_short"
msgstr "Leopard PT A"

msgid "G92_VK7201_long_special"
msgstr "รถถังหนักเยอรมันระดับ X ที่ทำความเสียหายมหาศาลต่อนัดและมีความคล่องตัวดี ทั้งตัวถังและป้อมปืนนั้นมีเกราะหนาทำให้รถถังนั้นเหมาะกับการป้องกันความเสียหายและผลักดันแนวรบข้าศึก จุดเด่นเหล่านี้ก็ต้องแลกกับการเจาะเกราะที่แย่ เวลาเล็งที่นานและความแม่นยำที่ปานกลาง"

msgid "G92_VK7201_short_special"
msgstr "เกราะที่สมบูรณ์แบบและความเสียหายต่อนัดที่ดี"

msgid "G94_GW_Tiger_P"
msgstr "G.W. Tiger (P)"

msgid "G94_GW_Tiger_P_descr"
msgstr "การกำเนิดแนวคิดใหม่ของปืนอัตตาจรหนักที่ติดตั้งบนตัวถังรถถัง Porsche Tiger ในขณะที่เป็นที่รู้กันว่า Ferdinand Porsche ตั้งใจที่จะพัฒนาปืนอัตตาจรวิถีโค้งแต่โครงการนี้ก็ไม่ได้มีการเริ่มพัฒนาแต่อย่างใด"

msgid "G94_GW_Tiger_P_short"
msgstr "G.W. Tiger P"

msgid "G96_VK3002M"
msgstr "VK 30.02 (M)"

msgid "G96_VK3002M_descr"
msgstr "รถถังกลางพัฒนาโดยบริษัท MAN โดยให้เป็นรถถังระดับ 30 ตัน ในเวลาเดียวกัน บริษัท Daimler-Benz ก็ได้พัฒนาโครงการคู่แข่งขึ้นมา ในวันที่ 13 พฤษภาคม 1942 ทั้งสองโครงการถูกส่งเข้ากระทรวงสรรพาวุธและการผลิตเชิงสงคราม การออกแบบของ MAN ได้รับการคัดเลือกและต่อมาก็เข้าประจำการในนามเรียกขาน Pz.Kpfw. V Panther"

msgid "G96_VK3002M_short"
msgstr "VK 30.02 M"

msgid "G97_Waffentrager_IV"
msgstr "Waffenträger auf Pz. IV"

msgid "G97_Waffentrager_IV_descr"
msgstr "ยานเกราะพิฆาตรถถังพัฒนาขึ้นในเดือนกุมภาพันธ์ 1944 โดยใช้ฐานของ PzIV การพัฒนาถูกหยุดลงเนื่องจากมีการพัฒนายานเกราะที่คล้ายคลึงกันโดยใช้ฐานของ Krupp Waffentrager 12.8 cm PaK 44 ที่มีต้นกำเนิดจากสาธารณรัฐเชคฯ มีอยู่แค่แบบพิมพ์เขียว"

msgid "G97_Waffentrager_IV_short"
msgstr "WT auf Pz. IV"

msgid "G98_WT_auf_E_100_Phonix"
msgstr "WT auf E 100 Phönix"

msgid "G98_WT_auf_E_100_Phonix_descr"
msgstr "รุ่นดัดแปลงของปตอ.ลำกล้องใหญ่ที่ติดตั้งบนตัวถังของ E 100 มีการวางแผนที่จะใช้ระบบป้อนโม่กระสุนสำหรับปืนขนาด 128 มม. การพัฒนาโครงการชะงักลงเมื่อสงครามโลกครั้งที่สองสิ้นสุดในเวลาต่อมา"

msgid "G98_WT_auf_E_100_Phonix_long_special"
