msgid "Contact/status/inBattle/halloween"
msgstr "ในการรบบาบิลอน: หอคอยมืด"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "ยิงกระสุนที่ทำความเสียหายและทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรมึนงง"

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากข้าศึกและพาหนะข้าศึกโดยรอบในรัศมี 35 เมตร"

msgid "advanced/hw_aoeStunInstantShot"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรมึนงง"

msgid "advanced/hw_damageShield"
msgstr "ป้องกันพาหนะจากความเสียหายใดๆ(ยกเว้นการพุ่งชน, จมน้ำหรือตกจากที่สูง) เป็นเวลา 7 วินาที"

msgid "advanced/hw_fastReload"
msgstr "เพิ่มอัตราการยิง/บรรจุโม่กระสุน"

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "คืนความทนทาน, ดับเพลิง, ลบสภาวะมึนงงและซ่อมชิ้นส่วนที่เสียหาย"

msgid "advanced/hw_invisibility"
msgstr "ทำให้พาหนะของคุณล่องหนจากข้าศึกเป็นการชั่วคราว, คืนความทนทาน, ซ่อมชิ้นส่วน, ดับเพลิง, ลบสภาวะมึนงงและรักษาพลรถถังที่บาดเจ็บทุกคน"

msgid "advanced/hw_teamRepairKit"
msgstr "ซ่อมชิ้นส่วนที่เสียหาย, ดับไฟ, ลบสภาวะมึนงงและคืนความทนทานบางส่วนให้กับพาหนะพันธมิตรที่อยู่ในรัศมี"

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "ความสามารถรบสามารถช่วยให้คุณมีประสิทธิภาพมากขึ้นในบาบิลอน: หอคอยมืด บรรลุเป้าหมายให้สำเร็จแล้วรับรางวัลที่มีค่า ในการติดตั้งความสามารถรบให้คลิกที่หนึ่งในช่องความสามารถรบที่มี"

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "ช่องความสามารถรบ"

msgid "hwShell/alt/description"
msgstr "%(bold)s สามารถหาได้ในการรบโดยมีโอกาสระดับหนึ่งหลังทำลายข้าศึกได้"

msgid "hwShell/alt/description/bold"
msgstr "กระสุนตัวเลือก"
