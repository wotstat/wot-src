msgid "G25_PzII_Luchs_Alpha_LS_BOT"
msgstr "Rabbit"

msgid "G25_PzII_Luchs_Alpha_LS_BOT_descr"
msgstr "เมื่อเทียบกันกับ Pz. Kpfw. II Ausf. C รถถังรุ่นนี้ได้รับการติดตั้งลำตัวรถและป้อมปืนใหม่รวมไปถึงตัวถังที่มีการซ้อนล้อขับเคลื่อน รถถังลาดตระเวณมีคุณลักษณะที่ดีมากแต่มีการผลิตรุ่น L เพียง 131 คันเท่านั้นเนื่องจากค่าใช้จ่ายในการผลิตถือว่าสูงมาก"

msgid "G25_PzII_Luchs_Alpha_LS_BOT_short"
msgstr "Rabbit"

msgid "G25_PzII_Luchs_LS_BOT"
msgstr "Rabbit"

msgid "G25_PzII_Luchs_LS_BOT_descr"
msgstr "เมื่อเทียบกันกับ Pz. Kpfw. II Ausf. C รถถังรุ่นนี้ได้รับการติดตั้งลำตัวรถและป้อมปืนใหม่รวมไปถึงตัวถังที่มีการซ้อนล้อขับเคลื่อน รถถังลาดตระเวณมีคุณลักษณะที่ดีมากแต่มีการผลิตรุ่น L เพียง 131 คันเท่านั้นเนื่องจากค่าใช้จ่ายในการผลิตถือว่าสูงมาก"

msgid "G25_PzII_Luchs_LS_BOT_short"
msgstr "Rabbit"

msgid "G54_E-50_LS_BOT"
msgstr "Alpha E 50"

msgid "G54_E-50_LS_BOT_descr"
msgstr "ในปี 1945 E 50 กำลังจะกลายเป็นรถถังกลางขนาดมาตรฐานของกองรถถังเยอรมันที่จะมาแทนที่รถถัง Panther และ Panther II แต่ก็ไม่ได้มีการพัฒนาการมากไปกว่าพิมพ์เขียว"

msgid "G54_E-50_LS_BOT_short"
msgstr "Alpha"

msgid "G57_PzVI_Tiger_P_LS_BOT"
msgstr "Guard Tiger (P)"

msgid "G57_PzVI_Tiger_P_LS_BOT_descr"
msgstr "ในวันที่ 26 พฤษภาคม 1941 Adolf Hitler ได้ออกคำสั่งให้ Ferdinand Porsche และ บริษัท Henschel พัฒนาต้นแบบรถถังหนักรุ่นใหม่ รถต้นแบบถูกแสดงต่อผู้นำในวันที่ 20 เมษายน 1942 และมีการเริ่มผลิต แต่การผลิตนั้นชะงกลงเนื่องจากความซับซ้อนของระบบขับเคลื่อนและระบบควบคุม อีกทั้งการขาดแคลนแร่ทองแดงซึ่งจำเป็นต่อการผลิต ต่อมาตัวถังที่ถูกผลิตขึ้น 90 ตัวถังถูกแปลงมาเป็นยานพิฆาตรถถัง Ferdinand"

msgid "G57_PzVI_Tiger_P_LS_BOT_short"
msgstr "Guard"

msgid "G58_VK4502P_LS_BOT"
msgstr "Guard VK 45.02 (P)"

msgid "G58_VK4502P_LS_BOT_descr"
msgstr "รุ่นดัดแปลงสองรุ่นที่มีป้อมปืนติดด้านหน้าและด้านหลังซึ่งถูกออกแบบโดย Ferdinand Porsche รถถังรุ่นนี้ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "G58_VK4502P_LS_BOT_short"
msgstr "Guard"

msgid "G64_Panther_II_LS_BOT"
msgstr "Hunter Panther II"

msgid "G64_Panther_II_LS_BOT_descr"
msgstr "รถถังคันนี้ได้รับการออกแบบเมื่อปีคริสตศักราช 1943 มีการสั่งผลิตรถถังต้นแบบติดตั้งป้อมปืน Panther I ในปีคริสตศักราช 1944 ในปีคริสตศักราช 1945 มีเพียงคันเดียวที่ผลิตโดยบริษัท MAN"

msgid "G64_Panther_II_LS_BOT_short"
msgstr "Hunter"

msgid "G67_VK4502A_LS_BOT"
msgstr "Guard VK 45.02 A"

msgid "G67_VK4502A_LS_BOT_descr"
msgstr "โครงการของการพัฒนาต่อ VK 45.01 (P) ไม่มีการผลิตรถต้นแบบเนื่องจากเครื่องยนต์ 10 สูบของ Porsche ไม่ผ่านการทดสอบ ป้อมปืนที่สร้างขึ้นถูกนำมาติดตั้งรถถัง Tiger II คันแรกๆ"

msgid "G67_VK4502A_LS_BOT_short"
msgstr "Guard"

msgid "G73_E50_Ausf_M_LS_BOT"
msgstr "Alpha E 50 M"

msgid "G73_E50_Ausf_M_LS_BOT_descr"
msgstr "กองทัพบกเยอรมันต้องการให้รถถังรุ่น E มีระบบส่งกำลังอยู่ด้านหลังของตัวรถถัง อย่างไรก็ตาม รถถัง E 50 และ E 75 ใช้ระบบส่งกำลังของ Tiger II ซึ่งทำให้วิศวกรทำงานได้เร็วขึ้นแต่ก็ทำให้การวางเครื่องด้านหลังเป็นไปไม่ได้ รถถังรุ่น E 50 Ausf. M เป็นการออกแบบใหม่ของโครงการ E 50 พร้อมด้วยการวางระบบส่งกำลังไว้ด้านหลังตัวถังรถ"

msgid "G73_E50_Ausf_M_LS_BOT_short"
msgstr "Alpha"

msgid "G88_Indien_Panzer_LS_BOT"
msgstr "Guard Indien-Pz."

msgid "G88_Indien_Panzer_LS_BOT_descr"
msgstr "โครงการนี้เกิดขึ้นเพื่อทำการพัฒนารถถังกลางสำหรับกองทัพอินเดีย ซึ่งโครงการนี้อยู่ภายใต้การดำเนินการของบริษัท Porsche Daimler-Benz และ Zahnradfabrik ตั้งแต่ปี 1954 ถึง 1955 แต่ยานเกราะดังกล่าวถือว่าซับซ้อนเกินสำหรับการผลิตในอินเดียและถูกยกเลิกไป"

msgid "G88_Indien_Panzer_LS_BOT_short"
msgstr "Guard"

msgid "G97_Waffentrager_IV_LS_BOT"
msgstr "Alpha WT auf Pz.IV"

msgid "G97_Waffentrager_IV_LS_BOT_descr"
msgstr "ยานเกราะพิฆาตรถถังพัฒนาขึ้นในเดือนกุมภาพันธ์ 1944 โดยใช้ฐานของ PzIV การพัฒนาถูกหยุดลงเนื่องจากมีการพัฒนายานเกราะที่คล้ายคลึงกันโดยใช้ฐานของ Krupp Waffentrager 12.8 cm PaK 44 ที่มีต้นกำเนิดจากสาธารณรัฐเชคฯ มีอยู่แค่แบบพิมพ์เขียว"

msgid "G97_Waffentrager_IV_LS_BOT_short"
msgstr "Alpha"

msgid "G99_RhB_Waffentrager_LS_BOT"
msgstr "Alpha Rhm.-B. WT"

msgid "G99_RhB_Waffentrager_LS_BOT_descr"
msgstr "พัฒนาขึ้นโดยบริษัท Rheinmetall-Borsig และออกแบบเพื่อเป็นยานลากจูงปืนใหญ่ ยานเกราะรุ่นนี้ถูกออกแบบมาให้ลากจูงระบบปืนใหญ่และสามารถยิงจากตัวถังรถได้ โดยใช้ระบบช่วงล่างของยานเกราะพิฆาตรถถัง Hetzer การพัฒนาดำเนินอยู่ในช่วงสิ้นปี 1942 ถึงกลางปี 1944 อย่างไรก็ตาม โครงการนี้ถูกหยุดลงเพื่อหลีกทางให้โครงการ Ardelt เนื่องด้วยการออกแบบที่ซับซ้อน ค่าใช้จ่ายสูงและน้ำหนักที่สูง"

msgid "G99_RhB_Waffentrager_LS_BOT_short"
msgstr "Alpha"

