msgid "R116_ISU122C_Berlin"
msgstr "ISU-122S"

msgid "R116_ISU122C_Berlin_descr"
msgstr "ปืนจู่โจมหนัก ISU-122S ถูกสร้างขึ้นจากฐานของรถถัง IS ซึ่งมีประสิทธิภาพในการต่อสู้กับรถถังหนักเยอรมันรวมถึงปราการใหญ่ รถต้นแบบถูกสร้างขึ้นที่โรงงาน Chelyabinsk Kirov ในเดือนเมษายน 1944 พาหนะรุ่นนี้เข้าประจำการในเดือนสิงหาคมปีเดียวกัน มียอดการผลิตทั้งหมด 675 คันในช่วงปี 1944 ถึง 1945"

msgid "R116_ISU122C_Berlin_long_special"
msgstr "ยานพิฆาตรถถังคันนี้ติดตั้งปืนยิงเร็วที่ทำความเสียหายต่อนาทีได้เยี่ยม ทำให้มันกำจัดข้าศึกทุกคันได้รวดเร็ว ความคล่องตัวของยานเกราะไม่ได้โดดเด่นอะไรนัก แต่นี่ก็ทำให้มันเหมาะกับการซุ่มโจมตี"

msgid "R116_ISU122C_Berlin_short_special"
msgstr "ความเสียหายต่อนาทีที่ยอดเยี่ยมและการซ่อนตัวที่ใช้ได้"

msgid "R117_T34_85_Rudy"
msgstr "T-34-85 Rudy"

msgid "R117_T34_85_Rudy_descr"
msgstr "รถถัง T-34-85 จากในนิยายนี้ มีหมายเลข 102 ของกองพลน้อยรถถังที่ 1 ของกองทัพบกโปแลนด์ ปรากฏในละครโทรทัศน์โปแลนด์ชื่อว่า \"สี่พลรถถังและเจ้าตูบ\" แต่ในความเป็นจริง รถถัง T-34-85 ถูกผลิตขึ้นในโปแลนด์ในทศวรรษ 1950 ที่โรงงาน Bumar Labedy ในเมือง Gliwice รุ่นรถถังของโปแลนด์ถูกดัดแปลงเล็กน้อยจากรถถังโซเวียตในช่วงหลังสงคราม"

msgid "R117_T34_85_Rudy_long_special"
msgstr "รถถังกลางหลากภารกิจที่สามารถบรรลุเป้าหมายใดก็ได้ในสนามรบ มันมีความคล่องตัว อัตราการยิง ระยะการมองเห็น และความแม่นยำที่ดี คุณลักษณะที่สมดุลทำให้รถถังคันนี้สามารถรับบทบาทใดก็ได้ในการรบ ไม่ว่าจะเป็นการป้องกัน ไล่ล่า เก็บข้าศึกเสียหายหนัก หรือทำการตีโต้อย่างรวดเร็ว"

msgid "R117_T34_85_Rudy_short"
msgstr "Rudy U.S.S.R."

msgid "R117_T34_85_Rudy_short_special"
msgstr "สารพัดประโยชน์ การควบคุมปืนที่ดี"

msgid "R118_T28_F30"
msgstr "T-28E with F-30"

msgid "R118_T28_F30_descr"
msgstr "รถถัง T-28 พร้อมด้วยปืน 85 มม. F-30 ถูกพัฒนาขึ้นในปี 1941 มีรถต้นแบบหนึ่งคันถูกสร้างและนำเข้าทำการทดสอบ ซึ่งแตกต่างจากรถถัง T-28 รุ่นผลิตจำนวนมากที่ติดตั้งอาวุธที่ต่างออกไป ไม่มีแหล่งข้อมูลระบุว่ารถถังรุ่นนี้ได้เข้าสายการผลิตจำนวนมากหรือถูกใช้ในการรบ"

msgid "R118_T28_F30_long_special"
msgstr "แม้ว่าความคล่องตัวและการป้องกันเกราะจะปานกลาง พาหนะคันนี้ก็มีปืนชั้นยอดที่ทำให้มีความได้เปรียบเหนือพาหนะข้าศึกทุกคัน ระยะการมองเห็นที่ไกลนั้นสำคัญอย่างมากในรูปแบบการรบที่พาหนะคันนี้ไดเปรียบเพราะจะทำให้สามารถตรวจจับข้าศึกได้อย่างรวดเร็ว"

msgid "R118_T28_F30_short"
msgstr "T-28E F-30"

msgid "R118_T28_F30_short_special"
msgstr "ปืนที่ทรงพลังและระยะการมองเห็นที่ยอดเยี่ยม"

msgid "R119_Object_777"
msgstr "Object 777 Version II"

msgid "R119_Object_777C_cn"
msgstr "Object 777 Dynamic"

msgid "R119_Object_777C_cn_descr"
msgstr "รุ่นปรับปรุงของโครงการ Object 777 ที่ตัวถังและป้อมปืนนำมาใช้เป็นต้นแบบให้กับการพัฒนาต่อของรถถัง Object 770 เมื่อเทียบกับ Object 777 แล้วรุ่นปรับปรุงรุ่นนี้มีความคล่องตัว อำนาจการยิงและระยะการมองเห็นที่ดีกว่า"

msgid "R119_Object_777C_cn_short"
msgstr "Obj. 777 D"

msgid "R119_Object_777C_cn_short_special"
msgstr "ความคล่องตัวที่ดี รูปทรงที่ต่ำ"

msgid "R119_Object_777C_long_special"
msgstr "รถถังหนักโซเวียตระดับ X ติดตั้งปืนที่ทำความเสียหายพาหนะข้าศึกได้ทุกชนิด เกราะและความคล่องตัวที่มีทำให้สามารถทำการรบในส่วนใดก็ได้ของแผนที่ รูปทรงที่ต่ำจะช่วยให้รถถังสามารถใช้วัตถุที่เล็กที่สุดเป็นที่กำบังในช่วงการยิงต่อสู้ได้"

msgid "R119_Object_777C_short_special"
msgstr "ปืนที่ยอดเยี่ยม รูปทรงที่ต่ำและความคล่องตัวที่ดี"

msgid "R119_Object_777_descr"
msgstr "Object 777 เป็นโครงการรถถังหนักพิเศษ รถถังถูกพัฒนาขึ้นที่โรงงาน Chelyabinsk Kirov โดยมีการร่างแผนการออกแบบขึ้นในปี 1953 และสร้างแบบจำลองรถถังขึ้น มีการวางแผนให้รถต้นแบบนั้นประกอบด้วยตัวถังเหล็กหล่อและป้อมปืนทรงเพรียวและติดตั้งปืนใหญ่ 122 มม. M-62-T2 แต่อย่างไรก็ตาม การพัฒนาก็ไม่ได้ดำเนินการต่อ และ Object 777 ก็ไม่ได้เข้าสายการผลิตจำนวนมากหรือเข้าประจำการ"

msgid "R119_Object_777_long_special"
msgstr "รถถังที่รูปทรงต่ำและคล่องตัวคันนี้มีแผ่นเกราะลาดเอียงอย่างดีและปืนขนาด 122 มม. หนึ่งในจุดด้อยหลักของมันคือความเร็วการหมุนป้อมปืนและตัวถังที่ปานกลางรวมไปถึงความแม่นยำ ความเสียหายต่อนานทีที่ต่ำ และมุมกดที่น้อย (-5°) รถถังคันนี้มีประสิทธิภาพที่สุดในการรบประชิดบนพื้นราบเรียบ"

msgid "R119_Object_777_short"
msgstr "Obj. 777 II"

msgid "R119_Object_777_short_special"
msgstr "เกราะที่ไว้ใจได้และรูปทรงที่ต่ำ"

msgid "R11_MS-1"
msgstr "MS-1"

msgid "R11_MS-1_descr"
msgstr "รถถังของโซเวียตคันแรกที่เข้าสายการผลิตจำนวนมาก โดยผลิตออกมาจำนวน 959 คัน ผลิตตั้งแต่ปี 1928 ถึง 1931"

msgid "R120_T22SR_A22"
msgstr "T-22 medium"

msgid "R120_T22SR_A22_descr"
msgstr "รถต้นแบบของตัวถัง A-22 ถูกผลิตขึ้นในปี 1949 การออกแบบรวมแผ่นเกราะม้วนที่มุมลาดเอียงสูงสุดเข้าไปด้วย ผลการยิงทดสอบแสดงให้เห็นว่าตัวถังรถนั้นทนทานต่อกระสุนเจาะเกราะขนาดลำกล้องใหญ่ ตัวถังถูกใช้เป็นพื้นฐานของโครงการรถถังกลาง T-22 การพัฒนาถูกหยุดลงภายหลังการเตรียมระบบช่วงล่างและออกแบบทั่วไปเสร็จสิ้นลง ต่อมานวัตกรรมที่ดีที่สุดของรถรุ่นนี้ก็ถูกนำไปใช้ในการพัฒนา Object 907"

msgid "R120_T22SR_A22_long_special"
msgstr "รถถังกลางเฉพาะระดับ X ที่มีความสามารถอยู่รอดสูง แต่มีค่าความเสียหายต่อนาทีที่ปานกลางซึ่งจะชดเชยด้วยการออกแบบตัวถังพิเศษที่มีแผงเกราะกั้น ทำให้รถถังคันนี้เหมาะกับการยิงต่อสู้หลังที่กำบังและการบุกขณะถูกยิงจากทุกทิศทาง"

msgid "R120_T22SR_A22_short"
msgstr "T-22 med."

msgid "R120_T22SR_A22_short_special"
msgstr "เกราะลาดเอียงและความเป็นอเนกประสงค์"

msgid "R121_KV4_KTT"
msgstr "KV-4 KTTS"

msgid "R121_KV4_KTT_descr"
msgstr "ยานพิฆาตรถถังหนักพร้อมด้วยปืนทดลอง 107 มม. M-75 (ZiS-24) ติดตั้งบนตัวถังของรถถัง KV-4 ที่เสนอไว้ มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "R121_KV4_KTT_long_special"
msgstr "ยานพิฆาตรถถังโซเวียตพิเศษระดับ VIII มีห้องทำการรบติดตั้งปืน 107 มม.เอาไว้กับตัวถังด้านหลังของ KV-4 ยานเกราะคันนี้มีความคล่องตัวต่ำแต่ทำความเสียหายต่อนาทีได้สูง, มีการวางเกราะโดยรวมดีและมีมุมการหมุนป้อมปืน 90 องศา นอกจากนี้ยานพิฆาตรถถังคันนี้ยังสามารถสะท้อนกระสุนด้วยเกราะข้างจากทั้งในที่กำบังและในพื้นที่โล่ง"

msgid "R121_KV4_KTT_short"
msgstr "KV-4 KTTS"

msgid "R121_KV4_KTT_short_special"
msgstr "ปืนที่ยอดเยี่ยมและเกราะที่ไว้ใจได้ มุมการหมุนป้อมปืนที่ดี"

msgid "R122_T44_100"
msgstr "T-44-100"

msgid "R122_T44_100B"
msgstr "T-44-100 (B)"

msgid "R122_T44_100B_descr"
msgstr "รถถังกลางทดลองที่ัพัฒนาในปี 1945 โดยมีรากฐานจากรถถัง T-44 แต่ต่างที่ T-44-100 ใช้ปืน 100 มม. LB-1 โดยติดตั้งกับป้อมปืนออกแบบใหม่และมีเกราะข้างลาดเอียง มีการผลิตรถถังขึ้นเพียงสองคัน"

msgid "R122_T44_100B_short"
msgstr "T-44-100 (B)"

msgid "R122_T44_100_descr"
msgstr "รถถังกลางรุ่นทดลองที่ถูกพัฒนาขึ้นในปี 1945 โดยมีรากฐานจากรถถัง T-44 แต่ต่างที่ T-44-100 ทำการติดตั้งปืนใหญ่ 100 mm LB-1 บนป้อมปืนที่ได้รับการออกแบบมาใหม่ และมีเกราะกรงด้านข้าง มีการผลิตรถถังรุ่นนี้ขึ้นเพียงสองคัน"

msgid "R122_T44_100_long_special"
msgstr "รถถังกลางโซเวียต T-44-100 ระดับ VIII นั้นถือเป็นตัวแทนของรถถังกลางอเนกประสงค์ที่มีคุณลักษณะปานกลางแต่สมดุลดีทำให้รถถังกลางคันนี้เป็นส่วนผสมที่เหมาะของอำนาจการยิง การป้องกันและความคล่องตัว"

msgid "R122_T44_100_short"
msgstr "T-44-100"

msgid "R122_T44_100_short_special"
msgstr "ความเป็นอเนกประสงค์ ปืนที่ไว้ใจได้และความคล่องตัวที่ดี"

msgid "R123"
msgstr "R-123"

