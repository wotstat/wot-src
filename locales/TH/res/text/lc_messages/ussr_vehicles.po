msgid "R123_K"
msgstr "R-123K"

msgid "R123_Kirovets_1"
msgstr "Kirovets-1"

msgid "R123_Kirovets_1_descr"
msgstr "โครงการ Kirovets-1 (IS-3 รถต้นแบบหมายเลข 1) ถูกพัฒนาขึ้นในเดือนมิถุนายนถึงพฤศจิกายน 1944 รถต้นแบบถูกสร้างขึ้นที่โรงงาน Chelyabinsk Kirov ในช่วงเดือนกันยายน-ตุลาคม 1944 ถึง 18-24 ธันวาคม 1944 รถต้นแบบเข้าทำการทดสอบที่สนามทดสอบ NIBT ใน Kubinka ภายหลังได้มีการตัดสินใจที่จะผลิตรุ่นนำร่องของรถถัง IS-2 รุ่นดัดแปลงที่ใช้ตัวถังตามที่เสนอโดยวิศวกรโรงงานหมายเลข 100 และสถาบันวิจัยกลาง 48 การพัฒนา Kirovets-1 ก็ได้หยุดลง"

msgid "R123_Kirovets_1_long_special"
msgstr "รถถังหนักโซเวียตระดับ VIII ที่ติดตั้งปืนอันทรงพลังแต่ไม่ค่อยแม่นยำเอาไว้ รถถังนั้นค่อนข้างรวดเร็วและมีแผ่นเกราะลาดเอียงทำให้มันเหมาะกับการรบในระยะประชิด"

msgid "R123_Kirovets_1_short"
msgstr "Kirovets-1"

msgid "R123_Kirovets_1_short_special"
msgstr "ปืนที่ทรงพลังและเกราะลาดเอียง"

