msgid "Contact/status/inBattle/last_stand"
msgstr "ในการรบการยืนหยัดครั้งสุดท้าย"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรเสียหาย"

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากข้าศึกและพาหนะข้าศึกโดยรอบในรัศมี 35 เมตร"

msgid "advanced/ls_aoeStunInstantShot"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรมึนงง"

msgid "advanced/ls_damageShield"
msgstr "ป้องกันพาหนะจากความเสียหายใดๆ(ยกเว้นการพุ่งชน, จมน้ำหรือตกจากที่สูง) เป็นเวลา 10 วินาที"

msgid "advanced/ls_doubleDamage"
msgstr "กระสุนนัดต่อไปของคุณที่ยิงเข้าจะทำความเสียหายสองเท่า"

msgid "advanced/ls_equipment"
msgstr "อุปกรณ์ยุทธวิธีช่วยให้คุณมีประสิทธิภาพมากขึ้นในการยืนหยัดครั้งสุดท้าย ผ่านด่านที่มีแล้วรับรางวัลที่มีค่า ในการติดตั้งความสามารถรบให้คลิกที่หนึ่งในช่องความสามารถรบที่มี"

msgid "advanced/ls_extraDamageSituational"
msgstr "ให้โอกาสในการทำความเสียหายพาหนะข้าศึกเพิ่มขึ้น"

msgid "advanced/ls_fastReload"
msgstr "เพิ่มอัตราการยิง/บรรจุโม่กระสุน"

msgid "advanced/ls_healSituational"
msgstr "คืนความทนทานบางส่วนหลังทำลายพาหนะข้าศึก"

msgid "advanced/ls_invisibility"
msgstr "หยุดการจับเป้าพาหนะคุณโดยข้าศึกเป็นการชั่วคราว, คืนความทนทาน, ซ่อมชิ้นส่วน, ดับเพลิง, ลบสภาวะมึนงงและรักษาพลรถถังที่บาดเจ็บทุกคน"

msgid "advanced/ls_nitro"
msgstr "เพิ่มความคล่องตัวพาหนะของคุณเป็นการชั่วคราว"

msgid "advanced/ls_nitroSituational"
msgstr "เพิ่มความคล่องตัวพาหนะคุณเป็นการชั่วคราวหลังได้รับความเสียหายจากพาหนะข้าศึก"

msgid "advanced/ls_selfRepairKit"
msgstr "คืนความทนทาน, ดับเพลิง, ลบสภาวะมึนงงและซ่อมชิ้นส่วนที่เสียหาย"

msgid "advanced/ls_teamRepairKit"
msgstr "ซ่อมชิ้นส่วนที่เสียหาย, ดับไฟ, ลบสภาวะมึนงงและคืนความทนทานบางส่วนให้กับพาหนะพันธมิตรที่อยู่ในรัศมี"

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "อุปกรณ์ยุทธวิธีสามารถติดตั้งในช่องพิเศษเพื่อช่วยให้คุณต่อสู้ได้อย่างมีประสิทธิภาพมากขึ้นในการรบการยืนหยัดครั้งสุดท้าย, ผ่านด่านต่างๆและรับรางวัลที่มีค่า"

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "ช่องอุปกรณ์ยุทธวิธี"
