msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "เข้าร่วมการรบหนึ่งครั้งด้วยพาหนะระดับใดก็ได้"

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "ขอต้อนรับเข้าสู่เกม! มาออกรบกับแฟนเกมจากทั่วโลกแล้วมาฉลองการชนะอันยิ่งใหญ่กัน!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "การรบครั้งแรก"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "วิจัยและซื้อพาหนะระดับ IV ใดๆก็ได้"

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "การซื้อพาหนะคันใหม่นั้นถือเป็นโอกาสสำคัญ ด้วยระดับใหม่ พาหนะจะเริ่มน่าสนใจมากขึ้น พลรถถังที่ฝึกไว้ก็จะมีสมรรถนะโดยรวมในการรบมากขึ้น"

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "พาหนะระดับ IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "ออกรบการรบแบบสุ่มสามครั้งด้วยพาหนะระดับ IV–X โดยติดตั้งองค์ประกอบปรับแต่งใดๆก็ได้"

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "คุณสามารถทำการปรับแต่งพาหนะได้ด้วยการเปลี่ยนโครงภายนอกรูปแบบปรับแต่งล่วงหน้าหรือสร้างรูปแบบของตัวเองด้วยการใช้ลายพราง, คำจารึก, ตราสัญลักษณ์และลวดลาย"

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "โครงภายนอกพาหนะ"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "เริ่มทำการฝึกความสามารถใดๆของสมาชิกพลรถถังคนใดก็ได้"

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "สมาชิกพลรถถังสามารถฝึกความสามารถเพิ่มเติมเพื่อเสริมประสิทธิภาพของตนหรือได้รับความสามารถใหม่"

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "ความสามารถพลรถถัง"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "หาเงิน 150,000 เหรียญในการรบ แบบสุ่ม ด้วยพาหนะระดับ IV–X"

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "ยิ่งระดับการรบสูงเท่าใด คุณก็จะต้องใช้เงินมากขึ้นในการบำรุงรักษาพาหนะ, เติมกระสุนและซื้อชิ้นส่วนกับอุปกรณ์"

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "การสะสมเงิน"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "วิจัยและซื้อพาหนะระดับ V"

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "ระดับ V จะมีพาหนะที่จริงจังขึ้นปรากฎตัวและการรบก็จะเป็นการพิสูจน์ฝีมือของคุณ พลรถถังที่ฝึกสมบูรณ์แล้วจะมีประโยชน์อย่างมาก"

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "พาหนะระดับ V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "ออกรบในการรบแบบสุ่ม 10 ครั้งด้วยพาหนะระดับ V–X ที่ติดตั้งอุปกรณ์เอาไว้สามอย่าง"

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "กล้องเคลือบผิวเลนส์หรือระบบระบายอากาศรุ่นปรับปรุง? อุปกรณ์ที่เหมาะสมสามารถเพิ่มจุดเด่นและลดจุดอ่อนพาหนะของคุณได้"

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "การติดตั้งอุปกรณ์"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "ผ่านหนึ่งสถานการณ์พื้นฐานในรูปแบบภูมิประเทศ"

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "เพื่อให้คุณมั่นใจในการรบ มันจะดีที่สุดที่คุณเข้าใจเส้นทางการรบ, ยุทธวิธีและแผนที่เป็นอย่างดีรวมไปถึงจุดสำคัญและวัตถุในแผนที่ที่มีผลกับแผนการเล่นของคุณ"

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "ภูมิประเทศ"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "ผ่านสี่สถานการณ์ก้าวหน้าสำเร็จในหนึ่งแผนที่ของรูปแบบภูมิประเทศ"

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "เข้าสู่รูปแบบภูมิประเทศอยู่เรื่อยๆเพื่อศึกษาแผนที่สำหรับการรบแบบสุ่ม สี่สถานการณ์ที่มีให้จะทำให้คุณสามารถสำรวจแผนที่จากมุมที่แตกต่างจากเดิมได้"

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "ภูมิประเทศก้าวหน้า"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "ออกรบใน การรบแบบสุ่ม 10 ครั้งด้วยพาหนะระดับ V–X โดยเปิดใช้กำลังสำรองส่วนตัวเอาไว้"

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "เมื่อเปิดใช้งาน คุณสามารถได้รับโบนัสเพิ่มเติมให้กับประสบการณ์การรบ, ประสบการณ์และประสบการณ์อิสระหรือเงินหลังการรบแต่ละครั้ง"

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "กำลังสำรองส่วนตัว"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "เป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับหกครั้งใน การรบแบบสุ่มที่ชนะด้วยพาหนะระดับ V–X"

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "ภารกิจเหล่านี้ทำให้คุณได้รับประสบการณ์ห้าเท่าต่อการรบที่ชนะ ในการได้รับส่วนนี้ คุณจะต้องชนะการรบและเป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับ"

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 ภารกิจประสบการณ์ x5"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "วิจัยชิ้นส่วนแล้วติดตั้งมันบนพาหนะของระดับใดก็ได้"

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "ประสบการณ์การรบจะมอบให้ในการรบแต่ละครั้ง หาประสบการณ์การรบเพื่อวิจัยชิ้นส่วนใหม่ที่จะเพิ่มประสิทธิภาพให้พาหนะของคุณ"

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "ประสบการณ์การรบ"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "วิจัยและซื้อพาหนะระดับ VI คันใดก็ได้"

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "ในแต่ระดับถัดๆไป การวิจัยพาหนะจะต้องใช้เวลา และความพยายามมากขึ้น ประสบการณ์อิสระจะ ช่วยให้คุณก้าวหน้าได้เร็วขึ้นและพลรถถังที่ึฝึกแล้ว จะช่วยคุณได้มาก"

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "พาหนะระดับ VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "ผ่านหนึ่งภารกิจส่วนตัวในสมรภูมิใดก็ได้"

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "สมรภูมินั้นเป็นชุดภารกิจสำหรับชนิดพาหนะที่แตกต่างกัน เมื่อผ่านได้ คุณสามารถได้รับรางวัลที่มีประโยน์และพาหนะที่เป็นเอกลักษณ์"

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "ภารกิจส่วนตัว"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "ฝึกพลรถถังหนึ่งคนด้วยคู่มือสากล"

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "หนังสือพลรถถังจะทำให้คุณเร่งการฝึกพลรถถังได้อย่างมากด้วยการเพิ่มประสบการณ์จำนวนหนึ่งให้กับพลรถถังหนึ่งคนหรือทุกคน"

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "หนังสือพลรถถัง"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "เข้าร่วมการรบแบบสุ่ม 10 ครั้งด้วยพาหนะระดับ VI–X โดยติดตั้งคำสั่งพลรถถังเอาไว้"

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "คำสั่งสามารถเสริมความสามารถพลรถถังสำหรับการรบหนึ่งครั้ง ดังเช่นยุทธปัจจัย คำสั่งสามารถซื้อหรือรับเป็นรางวัลได้ด้วย"

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "คำสั่งสำหรับพลรถถัง"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "ซื้อชุดสินค้าผู้เล่นใหม่พิเศษจากร้านค้าในเกม"

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "คุณสามารถซื้อทุกอย่างที่จำเป็นได้ในร้านค้าในเกมรวมไปถึงทอง, พาหนะพิเศษและอื่นๆอีกมากมาย คุณจะได้เห็นการส่งเสริมปกติที่มีข้อเสนอชั้นดีให้"

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "ร้านค้า"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "ออกรบใน การรบแบบสุ่ม 10 ครั้งด้วยพาหนะพิเศษระดับ VI–X"

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "พาหนะเหล่านี้ไม่จำเป็นต้องทำการวิจัย อีกทั้งได้รับประสบการณ์การรบ, ประสบการณ์พลรถถังและเงินมากกว่าปกติและโอนพลรถถังโดยไม่ต้องฝึก"

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "พาหนะพิเศษ"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "ออกรบในการรบแบบสุ่ม 10 ครั้งด้วยพาหนะระดับ VI–X โดยติดตั้งคำสั่งสำหรับอุปกรณ์เอาไว้"

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "คำสั่งทำให้คุณเพิ่มประสิทธิภาพสำหรับอุปกรณ์ที่ติดตั้งเอาไว้เช่นยุทธปัจจัยหรือคำสั่งนั้นสามารถซื้อหรือได้รับเป็นรางวัล"

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "คำสั่งสำหรับอุปกรณ์"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "ได้เป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับ 15 ครั้งใน การรบแบบสุ่มด้วยพาหนะระดับ VI–X"

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "ภารกิจเหล่านี้ทำให้คุณได้รับประสบการณ์ห้าเท่าต่อการรบที่ชนะ ในการได้รับส่วนนี้ คุณจะต้องชนะการรบและเป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับ"

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 ภารกิจประสบการณ์ x5"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "วิจัยและซื้อพาหนะระดับ VII คันใดก็ได้"

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "สำหรับพาหนะระดับนี้จำเป็นต้องใช้ทักษะจากผู้เล่นมากยิ่งขึ้น พาหนะจะมีความน่ากลัวและมีประสิทธิภาพมากขึ้นและข้าศึกของคุณก็เช่นกัน"

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "พาหนะระดับ VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "เข้าร่วมการรบแบบสุ่ม 10 ครั้งด้วยพาหนะระดับ VII-X ที่ติดตั้งชุดปฐมพยาบาลใหญ่, ชุดซ่อมแซมใหญ่และเครื่องดับเพลิงอัตโนมัติเอาไว้"

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "เมื่อติดตั้งเอาไว้ ยุทธปัจจัยใหญ่ก็จะซ่อมชิ้นส่วนที่เสียหายได้เร็วกว่าแบบเล็ก อีกทั้งยังลดเวลามึนงงและโอกาสเกิดไฟไหม้อีกทั้งมีเวลาพักใช้ที่สั้นกว่าเดิม"

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "ยุทธปัจจัยใหญ่"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "รับประสบการณ์เป็นสองเท่าจากการชนะครั้งแรกของวันในการรบแบบสุ่มด้วยพาหนะระดับใดก็ได้"

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "คุณสามารถได้รับประสบการณ์เป็นสองเท่าสำหรับการรบครั้งแรกของวันด้วยพาหนะแต่ละคัน ใช้เนื้อหานี้ในการยกระดับพาหนะต่างๆของคุณให้เร็วยิ่งขึ้น"

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "ตัวคูณประสบการณ์"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "สร้างเศษพิมพ์เขียวสำหรับพาหนะคันใดก็ตามที่ยังไม่ได้วิจัย"

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "พิมพ์เขียวจะเป็นส่วนลดประสบการณ์ที่ทำให้คุณเร่งวิจัยพาหนะได้เร็วขึ้น สามารถได้รับพิมพ์เขียวเป็นรางวัลหรือแปลงจากพิมพ์เขียวสากลหรือประจำชาติ"

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "พิมพ์เขียวพาหนะ"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "ได้เป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับ 20 ครั้งใน การรบแบบสุ่มด้วยพาหนะระดับ VII–X"

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "ภารกิจเหล่านี้ทำให้คุณได้รับประสบการณ์ห้าเท่าต่อการรบที่ชนะ ในการได้รับส่วนนี้ คุณจะต้องชนะการรบและเป็นหนึ่งใน 10 ผู้เล่นอันดับแรกในทีมคุณตามประสบการณ์ที่ได้รับ"

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 ภารกิจประสบการณ์ x5"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "วิจัยและซื้อพาหนะระดับ VIII คันใดก็ได้"

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "พาหนะระดับ VIII นั้นคุณจำเป็นต้องใช้ความสามารถที่ได้รับมาทั้งหมด ข้าศึกจะไม่ทำให้คุณเบื่ออีกทั้งมอบความตื่นเต้นชั้นยอดกับประสบการณ์ที่มีค่าให้"

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "พาหนะระดับ VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "ใช้ประสบการณ์อิสระในการวิจัยชิ้นส่วนใดก็ได้"

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "ถ้าคุณไม่มีประสบการณ์การรบมากพอสำหรับการวิจัยชิ้นส่วนหรือพาหนะ คุณสามารถใช้ประสบการณ์อิสระที่พาหนะทุกคันสามารถหาได้"

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "ประสบการณ์อิสระ"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "บรรจุกระสุนตัวเลือกแล้วเริ่มการรบแบบสุ่มหนึ่งครั้งด้วยพาหนะระดับ III–X"

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "กระสุนเจาะเกราะ, กระสุนระเบิดแรงสูงและกระสุนเจาะเกราะหัวผสมแกนเข็ง นั้นเหมาะกับสถานการณ์ที่ต่างกัน เลือกกระสุนให้ดีเพื่อเพิ่มความได้เปรียบ!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "กระสุน"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "ขายชิ้นส่วนที่ไม่ได้ใช้จากโรงเก็บ"

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "ชิ้นส่วน, กระสุน, อุปกรณ์, ยุทธปัจจัยและสิ่งของอื่นๆนั้นจะถูกเอาไว้ในโรงเก็บ คุณสามารถขายเพื่อหาเงินเพิ่มได้"

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "โรงเก็บ"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "หาเงิน 25,000 เหรียญในการรบแบบสุ่มด้วยพาหนะระดับ III–X"

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "เงินนั้นใช้ในการซื้อกระสุนและพาหนะใหม่, ซ่อมพาหนะและงานอื่นๆ ถือเป็นเรื่องสำคัญที่คุณจะรู้วิธีการหาเงิน สะสมและใช้มันอย่างชาญฉลาด"

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "เงิน"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "ออกรบในการรบแบบสุ่มสามครั้งด้วยพาหนะระดับ III–X โดยติดตั้งยุทธปัจจัยในทุกช่องที่มีให้"

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "ยุทธปัจจัยสามารถซ่อมความเสียหายร้ายแรงของพาหนะและรักษาอาการบาดเจ็บของพลรถถังในการรบ ใช้ยุทธปัจจัยในจังหวะที่เหมาะเป็นปัจจัยสำคัญของการอยู่รอดในสนามรบ"

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "ยุทธปัจจัย"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "ออกรบในการรบแบบสุ่มสามครั้งด้วยพาหนะระดับ III–X โดยติดตั้งอุปกรณ์ใดก็ได้"

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "พาหนะสามารถติดตั้งอุปกรณ์เพื่อเพิ่มค่าคุณลักษณะบางอย่างได้ ชุดการติดตั้งอุปกรณ์จะขึ้นกับพาหนะและรูปแบบการเล่นของพาหนะคันนั้นๆ"

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "อุปกรณ์"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "ภูมิประเทศ"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "ปฏิบัติหนึ่งสถานการณ์สำเร็จในแผนที่ใดก็ได้ของรูปแบบภูมิประเทศ"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "แดนไร้นาม"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "ผ่านสี่สถานการณ์พื้นฐานสำเร็จในหนึ่งแผนที่ของรูปแบบภูมิประเทศ"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "การลาดตระเวน"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "ผ่านสี่สถานการณ์ก้าวหน้าสำเร็จในหนึ่งแผนที่ของรูปแบบภูมิประเทศ"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "เกรด A ในภูมิศาสตร์"
