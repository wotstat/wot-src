msgid "CUSTOM_AA_MODE"
msgstr "การลบรอยหยัก"

msgid "CUSTOM_AA_MODE/description"
msgstr "กำหนดระดับการประมวลเส้นบางและเส้นแนวของวัตถุในเกม ลดขอบหยักของวัตถุลง\n\n• สูง—FXAA\n• สูงสุด—Temporal Supersampling Antialiasing (TSSAA)"

msgid "DRR_AUTOSCALER_ENABLED"
msgstr "การปรับเปลี่ยนตามสถานการณ์"

msgid "DRR_AUTOSCALER_ENABLED/description"
msgstr "เปิดหรือปิดการปรับแต่งอัตโนมัติของการเรนเดอร์รายละเอียดสามมิติโดยขึ้นกับภาระงานของการ์ดจอ\n\nการเปิดค่านี้สามารถเพิ่มสมรรถนะของเกมได้ การเรนเดอร์รายละเอียดในโรงรถจะยังคงเดิมเสมอ"

msgid "EFFECTS_QUALITY"
msgstr "คุณภาพเอฟเฟกต์เพิ่มเติม"

msgid "EFFECTS_QUALITY/description"
msgstr "เลือกคุณภาพการแสดงสะเก็ดไฟจากกระสุนเด้ง การระเบิด ควันและเอฟเฟคภาพอื่นๆ\n\nการลดค่าตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกม"

msgid "FAR_PLANE"
msgstr "ระยะการวาดภาพ"

msgid "FAR_PLANE/description"
msgstr "เลือกระยะการแสดงตึก ยานเกราะข้าศึก และวัตถุอื่นๆในเกม"

msgid "FLORA_QUALITY"
msgstr "ความหนาแน่นของหญ้า"

msgid "FLORA_QUALITY/description"
msgstr "กำหนดความหนาแน่นและคุณภาพของหญ้าและพุ่มไม้ที่แสดงในแบบอาร์เคดและแบบเล็งประณีต"

msgid "HAVOK_ENABLED"
msgstr "ฟิสิกสการทำลายขั้นก้าวหน้า"

msgid "HAVOK_ENABLED/OFF"
msgstr "ปิด"

msgid "HAVOK_ENABLED/ON"
msgstr "เปิดใช้แล้ว"

msgid "HAVOK_ENABLED/description"
msgstr "เปิดใช้งานรูปปแบบการทำลายวัตถุที่สมจริงกว่าเดิมบนแผนที่เกม\n\nการปิดตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกมได้"

msgid "HAVOK_ENABLED/warning"
msgstr "การตั้งค่าจะถูกใช้ในการรบครั้งต่อไป ถ้าหากถูกปิดไว้อยู่ในการรบปัจจุบัน"

msgid "LANGUAGE_CODE"
msgstr "th"

msgid "LIGHTING_QUALITY"
msgstr "คุณภาพของแสง"

msgid "LIGHTING_QUALITY/description"
msgstr "ความแม่นยำในการแสดงแสงแดด การวางแสงและเอฟเฟคความสว่าง\n\nการเพิ่มค่าของตัวแปรนี้จะเพิ่มภาระให้กับการ์ดจออย่างมาก"

msgid "MOTION_BLUR_QUALITY"
msgstr "เอฟเฟคการสั่น"

msgid "MOTION_BLUR_QUALITY/description"
msgstr "เลือกคุณภาพของเอฟเฟคการเบลอจากการเคลื่อนไหวเมื่อยานเกราะเคลื่อนที่หรือกล้องหมุน"

msgid "MSAA_QUALITY"
msgstr "การลบรอยหยัก"

msgid "MSAA_QUALITY/description"
msgstr "กำหนดระดับการประมวลผลเพิ่มเติมสำหรับเส้นและลายเส้นของวัตถุในเกม ลดลักษณะการเกิดรอยหยักบนวัตถุ\n\n• ต่ำ—MSAA 2x\n• กลาง—MSAA 4x\n• สูง—MSAA 8x"

msgid "OBJECT_LOD"
msgstr "ระดับความละเอียดของวัตถุ"

msgid "OBJECT_LOD/description"
msgstr "เลือกจำนวนของวัตถุที่ถูกแสดงและคุณภาพของวัตถุ"

msgid "POST_PROCESSING_QUALITY"
msgstr "การประมวลผลภาพ"

msgid "POST_PROCESSING_QUALITY/description"
msgstr "กำหนดคุณภาพเอฟเฟคภาพหลังการประมวลอื่นๆ: เอฟเฟคประกายจากความร้อน และคลื่นอัดกระแทก อาการสีเหลื่อม เงาขอบ เม็ดฟิล์ม และอื่นๆ\n\nการลดค่าตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกม"

msgid "RENDER_PIPELINE_QUALITY"
msgstr "กราฟฟิค"

msgid "RENDER_PIPELINE_QUALITY/description"
msgstr "ปรับปรุง: ทำให้ใช้คุณภาพภาพขั้นสูงสุดได้\n\nแบบง่าย: ทำให้ได้สมรรถนะสูงสุดโดยการปิดเอฟเฟคภาพบางส่วนลงไป"

msgid "RENDER_PIPELINE_QUALITY/label"
msgstr "กราฟฟิค:"

msgid "RENDER_PIPELINE_QUALITY/warning"
msgstr "การเปลี่ยนค่านี้จะมีผลหลังจากทำการรีสตาร์ทเกม"

msgid "SEMITRANSPARENT_LEAVES_ENABLED"
msgstr "ความโปร่งใสของใบไม้"

msgid "SEMITRANSPARENT_LEAVES_ENABLED/description"
msgstr "เลือกการแสดงของใบไม้บนต้นไม้และพุ่มไม้ว่าจะแสดงเช่นไร\n\nการปิดตัวแปรนี้จะทำให้ใบไม้บนต้นไม้และพุ่มไม้ล่องหน ซึ่งจะทำให้สมรรถนะเกมดีขึ้นได้"

msgid "SHADER_VERSION_CAP"
msgstr "รุ่นของการปรับแสงเงา"

msgid "SHADOWS_QUALITY"
msgstr "ความละเอียดของเงา"

msgid "SHADOWS_QUALITY/description"
msgstr "กำหนดคุณภาพของการประมวลผลเงาแปรผันในระยะการวาดทั้งหมด \n\nการลดค่าตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกมได้อย่างมาก"

msgid "SMOKE_ENABLED"
msgstr "ควัน"

msgid "SNIPER_MODE_EFFECTS_QUALITY"
msgstr "เอฟเฟคต์เพิ่มในมุมมองแบบเล็งประณีต"

msgid "SNIPER_MODE_EFFECTS_QUALITY/description"
msgstr "เลือกคุณภาพการแสดงสะเก็ดไฟจากกระสุนเด้ง การระเบิด ควันและเอฟเฟคภาพอื่นๆในการเล็งประณีต\n\nการลดค่าตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกม"

msgid "SNIPER_MODE_GRASS_ENABLED"
msgstr "แสดงหญ้าในมุมมองแบบเล็งประณีต"

msgid "SNIPER_MODE_GRASS_ENABLED/description"
msgstr "แสดงหญ้าในการเล็งประณีต\n\nการปิดตัวแปรนี้จะช่วยเพิ่มสมรรถนะเกม"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED"
msgstr "การเรียงเทสเซลเลชันพื้นดินในการเล็งประณีต"

msgid "SNIPER_MODE_TERRAIN_TESSELLATION_ENABLED/description"
msgstr "เพิ่มคุณภาพของพื้นดินในรัศมี 50 เมตรจากพาหนะของคุณในรูปแบบการเล็งประณีต มีให้เฉพาะเมื่อเปิดใช้งานการเรียงเทสเซลเลชันพื้นดินเท่านั้น\n\nการปิดค่านีจะช่วยเพิ่มสมรรถนะของเกมได้"

msgid "SPEEDTREE_QUALITY"
msgstr "คุณภาพของพุ่มต้นไม้"

msgid "SPEEDTREE_QUALITY/description"
msgstr "กำหนดคุณภาพการแสดงต้นไม้ พุ่มไม้และต้นหญ้า"

msgid "TERRAIN_QUALITY"
msgstr "คุณภาพพื้นดิน"

msgid "TERRAIN_QUALITY/description"
msgstr "เลือกคุณภาพการวาดพื้นผิวแผนที่ \n\nใช้คุณภาพภูมิทัศน์ขั้นต่ำในกรณีที่คอมพิวเตอร์มีสมรรถนะต่ำ\n\nการลดค่าตัวแแปรนี้อาจจะทำให้เกิดการประสานพื้นผิวที่ไม่ตรงกันระหว่างโปรแกรมลูกข่ายและเซิร์ฟเวอร์"

msgid "TERRAIN_QUALITY/warning"
msgstr "การประยุกต์ใช้งานตัวแปรที่ระบุไว้อาจจะต้องใช้เวลาสักครู่"

msgid "TERRAIN_TESSELLATION_ENABLED"
msgstr "การเรียงเทสเซลเลชันพื้นดิน"

msgid "TERRAIN_TESSELLATION_ENABLED/description"
msgstr "กระบวนการที่เร่งด้วยคอมพิวเตอร์ซึ่งเพิ่มสามเหลี่ยมใหม่เข้าสู่ตาข่ายโพลีกอนเพื่อเพิ่มรายละเอียดของตาข่าย\n\nการใช้งานนี้จะใช้ร่วมได้กับส่วนดังต่อไปนี้เท่านั้น: \n• กราฟฟิคแบบปรับปรุง\n• คุณภาพภูมิประเทศแบบสูง สูงสุด หรือสูงมาก\n• มีการติดตั้ง DirectX 11 เอาไว้\n\nการเปลี่ยนแปลงการตั้งค่านั้นไม่มีให้กับ DirectX เก่ากว่า DirectX 11\n\nการปิดค่านี้สามารถเพิ่มสมรรถนะของเกมได้"

msgid "TEXTURE_QUALITY"
msgstr "ความละเอียดของพื้นผิว"

msgid "TEXTURE_QUALITY/description"
msgstr "คุณภาพของพื้นผิววัตถุในเกมโดยเฉพาะเมื่อมองจากระยะใกล้\n\nการลดค่าตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกม"

msgid "TEXTURE_QUALITY/warning"
msgstr "การประยุกต์ใช้งานตัวแปรที่ระบุไว้อาจจะต้องใช้เวลาสักครู่"

msgid "TRACK_PHYSICS_QUALITY"
msgstr "ฟิสิกส์ตีนตะขาบ"

msgid "TRACK_PHYSICS_QUALITY/description"
msgstr "กำหนดคุณภาพการจำลองฟิสิกส์สำหรับตีนตะขาบที่ใช้งานได้และที่เสียรวมถึงรายละเอียดตีนตะขาบ\n\nการลดหรือปิดค่านี้จะเพิ่มสมรรถนะของเกมได้"

msgid "VEHICLE_DUST_ENABLED"
msgstr "เปิดการแสดงเอฟเฟกต์ตีนตะขาบและล้อ"

msgid "VEHICLE_DUST_ENABLED/description"
msgstr "การแสดงพื้นดิน หิมะและการกระเด็นของน้ำหลังตีนตะขาบและล้อ\n\nการปิดตัวแปรนี้จะช่วยเพิ่มสมรรถนะของเกม"

msgid "VEHICLE_TRACES_ENABLED"
msgstr "เปิดการแสดงรอยตีนตะขาบและรอยล้อ"

msgid "VEHICLE_TRACES_ENABLED/description"
msgstr "แสดงรอยตีนตะขาบและรอยล้อบนพื้นดิน\n\nไม่มีให้ในการแสดงกราฟฟิคแบบง่ายและคุณภาพลวดลายต่ำ"

msgid "VISIBILITY_TUNNEL_ENABLED"
msgstr "ซ่อนชุดติดตั้งสามมิติในการเล็งประณีต"

msgid "VISIBILITY_TUNNEL_ENABLED/description"
msgstr "ซ่อนชุดติดตั้งสามมิติพาหนะจากศูนย์เล็งปืนในการเล็งประณีตเป็นการชั่วคราว\n\nลดภาพรบกวนและเพิ่มความแม่นยำในการเล็ง"

msgid "WATER_QUALITY"
msgstr "รายละเอียดของน้ำ"

msgid "WATER_QUALITY/description"
msgstr "จะเลือกคุณภาพการวาดพื้นผิวน้ำ"

msgid "aim/armorFlashlight/colorSchema/greenShades/label"
msgstr "เกราะบางเท่านั้น"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/body"
msgstr "ถ้าเปิดใช้งาน ไฟฉายจะส่องเฉพาะจุดเกราะบางของเป้าหมายเท่านั้น\n\nเกราะที่มีโอกาสเจาะได้สูงจะแสดงเอาไว้ด้วยสีเขียวเข้มในขณะที่เกราะที่มีโอกาสเจาะได้ปานกลางจะเป็นสีเขียวโปร่งแสง สีอาจจะต่างออกไปในรูปแบบตาบอดสี"

msgid "aim/armorFlashlight/colorSchema/greenShades/tooltip/header"
msgstr "แสดงเกราะบางเท่านั้น"

msgid "aim/armorFlashlight/colorSchema/redShades/label"
msgstr "เกราะหนาเท่านั้น"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/body"
msgstr "ถ้าเปิดใช้งาน ไฟฉายจะส่องเฉพาะจุดเกราะหนาของเป้าหมายเท่านั้น\n\nเกราะที่ไม่มีโอกาสเจาะเข้าจะแสดงเอาไว้ด้วยสีแดงเข้มในขณะที่เกราะที่มีโอกาสเจาะได้ปานกลางจะเป็นสีแดงโปร่งแสง สีอาจจะต่างออกไปในรูปแบบตาบอดสี"

msgid "aim/armorFlashlight/colorSchema/redShades/tooltip/header"
msgstr "แสดงเกราะหนาเท่านั้น"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/label"
msgstr "เกราะทั้งหมด"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/body"
msgstr "ถ้าเปิดไว้ ไฟฉายจะแสดงเกราะเป้าหมายทั้งหมดเ\n\nกราะที่มีแทบไม่มีโอกาสเจาะเข้าหรือเจาะไม่ได้เลยจะแสดงด้วยสีแดง, เกราะที่มีโอกาสเจาะได้สูงจะเป็นสีเขียวและเกราะที่มีโอกาสเจาะได้ปานกลางจะเป็นสีเหลือง สีอาจจะต่างออกไปในรูปแบบตาบอดสี"

msgid "aim/armorFlashlight/colorSchema/redYellowGreen/tooltip/header"
msgstr "แสดงเกราะทั้งหมด"

msgid "aim/armorFlashlight/colorSchemas"
msgstr "การแสดงความหนาเกราะ"

msgid "aim/armorFlashlight/enabled/label"
msgstr "เปิดใช้เมื่อเริ่มการรบ"

msgid "aim/armorFlashlight/enabled/tooltip/body"
msgstr "สถานะไฟแสดงเกราะพื้นฐานเมื่อเริ่มการรบ คุณสามารถเปิดหรือปิดไฟแสดงเกราะได้ด้วยการใช้ปุ่มลับที่กำหนดเมื่อใดก็ได้\n\nเมื่อเปิดใช้ไฟแสดงเกราะจะทำงานเมื่อเล็งประณีตเท่านั้น\n\nรูปแบบเกมที่สนับสนุน:\n• การรบแบบสุ่มและการฝึกรบ\n• แนวหน้า\n• การรบอาร์เคด\n• การบุกรุก\n• รูปแบบและกิจกรรมบางอย่าง \n\nอาจจะสนับสนุนรูปแบบและกิจกรรมเพิ่มเติมในอนาคต"

msgid "aim/armorFlashlight/enabled/tooltip/header"
msgstr "เปิดใช้เมื่อเริ่มการรบ"

