msgid "battlePassSeasonDescription"
msgstr "รูปแบบสามมิติแนวกิจกรรม"

msgid "beCareful"
msgstr "ระวังให้ดี"

msgid "comp7Core10"
msgstr "คุณสามารถเปลี่ยนไปเป็นพาหนะที่เหมาะกว่าในช่วงการเตรียมการก่อนการรบ"

msgid "comp7Core10Status"
msgstr "การเตรียมการก่อนการรบ"

msgid "comp7Core11"
msgstr "หน้าจอการเตรียมการก่อนการรบจะแสดงพาหนะของคุณที่มีพลรถถังและกระสุน อย่าลืมที่จะเตรียมพาหนะเหล่านี้ก่อนเข้าทำการรบล่ะ"

msgid "comp7Core11Status"
msgstr "การเตรียมการก่อนการรบ"

msgid "comp7Core12"
msgstr "ทันทีที่คุณเลือกพาหนะของคุณ บอกให้พันธมิตรของคุณรู้ด้วยการคลิกที่ปุ่มยืนยันการเลือก"

msgid "comp7Core12Status"
msgstr "การเตรียมการก่อนการรบ"

msgid "comp7Core13"
msgstr "หลังจากที่คลิกปุ่มยืนยันการเลือกแล้ว คุณจะไม่สามารถเปลี่ยนพาหนะได้"

msgid "comp7Core13Status"
msgstr "ยืนยันการเลือกของคุณ"

msgid "comp7Core14"
msgstr "ทำการยึดจุดสนใจบนแผนที่เพื่อให้สามารถใช้ทักษะยุทธวิธีและชิงความได้เปรียบจากข้าศึก!"

msgid "comp7Core14Status"
msgstr "จุดสนใจ"

msgid "comp7Core15"
msgstr "จุดสนใจในแผนที่ การยึดตำแหน่งนี้ได้จะทำให้คุณสามารถใช้ทักษะยุทธวิธีเรดาร์กองพล เมื่อเปิดใช้งาน พาหนะข้าศึกทั้งหมดจะถูกเปิดเผยเป็นเวลาหลายวินาที"

msgid "comp7Core15Status"
msgstr "ศูนย์สื่อสาร"

msgid "comp7Core16"
msgstr "จุดสนใจในแผนที่ การยึดตำแหน่งนี้ได้จะทำให้คุณสามารถใช้ทักษะยุทธวิธีการโจมตีปืนใหญ่ เมื่อเปิดใช้งาน ผู้เล่นสามารถเลือกพื้นที่ที่จะทำการโจมตีด้วยปืนใหญ่ได้"

msgid "comp7Core16Status"
msgstr "กองบัญชาการปืนใหญ่"

msgid "comp7Core17"
msgstr "ถ้าทักษะยุทธวิธีการโจมตีปืนใหญ่ยิงเข้าพันธมิตรของคุณ พวกเขาจะไม่เสียหายแต่สามารถมึนงงได้"

msgid "comp7Core17Status"
msgstr "การโจมตีปืนใหญ่"

msgid "comp7Core18"
msgstr "โปรดทราบ: แผนที่ในรูปแบบนี้อาจจะต่างจากแผนที่เดียวกันในการรบแบบสุ่ม"

msgid "comp7Core18Status"
msgstr "แผนที่ในกิจกรรม"

msgid "comp7Core19"
msgstr "การสร้างหมวดรถถังผู้เล่น 7 คนสามารถช่วยเพิ่มโอกาสที่คุณจะชนะได้"

msgid "comp7Core19Status"
msgstr "การเล่นเป็นทีมคือกุญแจสำคัญ"

msgid "comp7Core21"
msgstr "คุณสามารถดูระดับของทักษะบทบาทของพันธมิตรในการรบได้ด้วยการกดปุ่ม Tab หรือ Alt"

msgid "comp7Core21Status"
msgstr "ทักษะบทบาทพันธมิตร"

msgid "comp7Core22"
msgstr "คุณสามารถตรวจสอบรายชื่อทีมเพื่อดูว่าพันธมิตรของคุณได้รับทักษะยุทธวิธีใดๆบ้าง แต่จะไม่มีการแสดงทักษะยุทธวิธีของข้าศึก"

msgid "comp7Core22Status"
msgstr "ทักษะยุทธวิธี"

msgid "comp7Core23"
msgstr "ถ้าทักษะบทบาทมีผลกับพาหนะ ก็จะมีการแสดงไอคอนที่เกี่ยวข้องบนเครื่องหมายผู้เล่น"

msgid "comp7Core23Status"
msgstr "ผลของทักษะบทบาท"

msgid "comp7Core24"
msgstr "ปุ่ม H (โดยมาตรฐาน) จะเป็นการเปิดการสนทนาเสียง ใช้ปุ่มนี้ในการสื่อสารกับพันธมิตรของคุณให้ดียิ่งขึ้น"

msgid "comp7Core24Status"
msgstr "สนทนาเสียง"

msgid "comp7Core25"
msgstr "ถ้าคุณมีปัญหาใดๆกับการสนทนาเสียง ให้ตรวจสอบการตั้งค่าของคุณในโปรแกรมลูกข่ายเกม"

msgid "comp7Core25Status"
msgstr "สนทนาเสียง"

msgid "comp7Core29"
msgstr "เมื่อกดปุ่ม Alt จะมีการแสดงบทบาทของพาหนะใดๆก็ตามที่อยู่ในระยะการมองเห็นของคุณเหนือเครื่องหมายผู้เล่น สำหรับผู้เล่นพันธมิตร คุณจะยังได้เห็นระดับทักษะบทบาทที่พวกเขามีอีกด้วย"

msgid "comp7Core29Status"
msgstr "บทบาทพาหนะ"

msgid "comp7Core31"
msgstr "คุณสามารถตั้งปุ่มลัดสำหรับทักษะบทบาทและทักษะยุทธวิธีใหม่ได้ในการตั้งค่าเกม"

msgid "comp7Core31Status"
msgstr "การตั้งค่าการควบคุม"

msgid "comp7Core32"
msgstr "หลังจากผ่านไปช่วงเวลาหนึ่ง คุณจะสามารถยึดจุดสนใจได้อีกครั้ง"

msgid "comp7Core32Status"
msgstr "เกี่ยวกับจุดสนใจ"

msgid "comp7Core33"
msgstr "คุณจะไม่สามารถยึดจุดสนใจได้จนกว่าคุณใช้ทักษะยุทธวิธีที่เหมาะสม"

msgid "comp7Core33Status"
msgstr "เกี่ยวกับจุดสนใจ"

msgid "comp7Core34"
msgstr "การยึดจุดสนใจจะทำให้คุณได้รับคะแนนเกียรติภูมิจำนวนหนึ่ง"

msgid "comp7Core34Status"
msgstr "เกี่ยวกับจุดสนใจ"

msgid "comp7Core35"
msgstr "มาอ่านกฎกิจกรรมเพื่อเรียนรู้เพิ่มเติมเกี่ยวกับการหาคะแนนเกียรติภูมิ"

msgid "comp7Core35Status"
msgstr "เกี่ยวกับคะแนนเกียรติภูมิ"

msgid "comp7Core37"
msgstr "รูปแบบนี้มีตัวปรับที่เปลี่ยนค่าบางอย่างของพาหนะเช่นความทนทานพาหนะ, เวลาพักใช้ยุทธปัจจัย, เวลาที่ยังปรากฎและอื่นๆอีกมากมาย"

msgid "comp7Core37Status"
msgstr "ตัวปรับการบุกรุก"

msgid "comp7Core5"
msgstr "ตามบทบาทที่มี พาหนะจะมีทักษะพิเศษที่มีระดับการใช้งานสามระดับ ยิ่งระดับสูงเท่าใดเมื่อสั่งใช้ทักษะ ผลที่มีก็จะมากขึ้นตาม"

msgid "comp7Core5Status"
msgstr "เกี่ยวกับทักษะบทบาท"

msgid "comp7Core6"
msgstr "คะแนนเกียรติภูมิสามารถหาได้จากการมีผลงานการรบที่น่าประทับใจ, การยึดจุดสนใจ, การใช้ทักษะและอื่นๆ"

msgid "comp7Core6Status"
msgstr "เกี่ยวกับคะแนนเกียรติภูมิ"

msgid "comp7Core8"
msgstr "ผู้เล่นจะไม่มีข้อมูลเกี่ยวกับพาหนะข้าศึกจนกว่าจะตรวจจับข้าศึกได้"

msgid "comp7Core8Status"
msgstr "หมอกแห่งสงคราม"

msgid "comp7Light7"
msgstr "คุณสามารถอ่านเพิ่มเติมเกี่ยวกับการบุกรุกรุ่นเบาด้วยการคลิกที่ปุ่ม เกี่ยวกับกิจกรรม บนหน้าจอกิจกรรม"

msgid "comp7Light7Status"
msgstr "รายละเอียดเพิ่มเติม"

msgid "comp7Light9"
msgstr "เมื่อมีชุดพาหนะระดับ VIII ที่มีบทบาทต่างกัน คุณสามารถเลือกพาหนะคันที่เหมาะที่สุดสำหรับทุกการรบได้เสมอและปรับตัวให้เข้ากับพาหนะของพันธมิตรคุณได้เช่นกัน"

msgid "comp7Light9Status"
msgstr "ขยายโรงรถ"

msgid "comp7NightMaps38"
msgstr "แผนที่กลางคืนจะมาปรับโฉมให้กับสนามรบด้วยสภาวะกลางคืน, จุดสังเกตการณ์ใหม่, จุดสนใจปรับใหม่และกลไกการตรวจจับปรับแก้แล้ว"

msgid "comp7NightMaps38Status"
msgstr "แผนที่กลางคืน"

msgid "comp7Ranked0"
msgstr "ต่อสู้เพื่อหาคะแนนจัดอันดับเพื่อไต่ไปยังอันดับสูงสุดและแสดงฝีมือของคุณ"

msgid "comp7Ranked0Status"
msgstr "ระบบการจัดอันดับ"

msgid "comp7Ranked1"
msgstr "ยิ่งคุณได้คะแนนเกียรติภูมิจากการรบมากเท่าใด คุณก็จะได้รับคะแนนจัดอันดับจากการชนะมากขึ้นตามและคุณจะเสียคะแนนจัดอันดับน้อยลงหากแพ้"

msgid "comp7Ranked1Status"
msgstr "คะแนนเกียรติภูมและคะแนนจัดอันดับ"

msgid "comp7Ranked2"
msgstr "ในการบุกรุก การรบจะทำการจับคู่ผู้เล่นที่มีอันดับเหมือนกัน"

msgid "comp7Ranked20"
msgstr "การออกจากการรบก่อนที่การรบจบลงจะทำให้พันธมิตรของคุณเสียเปรียบและจะทำให้คุณถูกบล็อคเป็นการชั่วคราวและเสียคะแนนจัดอันดับไป"

msgid "comp7Ranked20Status"
msgstr "การหนีการรบ"

msgid "comp7Ranked26"
msgstr "มีเพียงผู้เล่นอันดับแชมป์และตำนานเท่านั้นที่จะได้ปรากฎบนกระดานผู้นำ ผู้เล่นที่ได้เข้าสู่กระดานผู้นำจะได้รับรางวัลประจำวัน"

msgid "comp7Ranked26Status"
msgstr "กระดานผู้นำ"

msgid "comp7Ranked27"
msgstr "ผู้ที่หนึการรบจะถูกบล็อคจากการเข้าร่วมรูปแบบเกมเป็นการชั่วคราว ระยะเวลาการบล็อคจะเพิ่มขึ้นถ้าหากมีการละเมิดซ้ำในครั้งต่อๆไป"

msgid "comp7Ranked27Status"
msgstr "การบล็อคชั่วคราว"

msgid "comp7Ranked28"
msgstr "ออกรบในรูปแบบเกมเพื่อปลดล็อคองค์ประกอบใหม่ของรูปแบบก้าวหน้าการบุกรุก"

msgid "comp7Ranked28Status"
msgstr "รูปแบบก้าวหน้า"

msgid "comp7Ranked2Status"
msgstr "ผู้เล่นอันคู่ควร"

msgid "comp7Ranked3"
msgstr "อันดับตำนานนั้นจะมอบให้เฉพาะยอดฝีมือเท่านั้น ในการได้รับอันดับนี้ คุณจะต้องเป็นหนึ่งใน 10% ผู้เล่นอันดับสูงสุดในกระดานผู้นำตามคะแนนจัดอันดับที่ได้รับ"

msgid "comp7Ranked36"
msgstr "โปรดทราบ: ถ้าคุณออกจากการรบก่อนที่การรบจบลง คุณจะเสียคะแนนจัดอันดับมากกว่ากรณีที่คุณแพ้โดยสิ้นเชิง"

msgid "comp7Ranked36Status"
msgstr "การหนีการรบ"

msgid "comp7Ranked3Status"
msgstr "ตำนาน"

msgid "comp7Ranked4"
msgstr "ถ้าคุณหยุดเล่นในรูปแบบนี้ คุณจะเสียคะแนนจัดอันดับไป กฎนี้จะมีผลกับอันดับเงิน, ทอง, แชมป์และตำนาน"

msgid "comp7Ranked4Status"
msgstr "อันดับไม่เคลื่อนไหว"

msgid "comp7Ranked7"
msgstr "คุณสามารถอ่านเพิ่มเติมเกี่ยวกับการบุกรุกด้วยการคลิกที่ปุ่ม เกี่ยวกับกิจกรรม บนหน้าจอกิจกรรม"

msgid "comp7Ranked7Status"
msgstr "รายละเอียดเพิ่มเติม"

msgid "comp7Ranked9"
msgstr "เมื่อมีชุดพาหนะระดับ X ที่มีบทบาทต่างกัน คุณสามารถเลือกพาหนะคันที่เหมาะที่สุดสำหรับทุกการรบได้เสมอและปรับตัวให้เข้ากับพาหนะของพันธมิตรคุณได้เช่นกัน"

msgid "comp7Ranked9Status"
msgstr "ขยายโรงรถ"

msgid "devMaps0"
msgstr "จุดเกิดเหตุการณ์สุ่มจะทำเครื่องหมายด้วย\nควันบนแผนที่และเครื่องหมายบนแผนที่ย่อ\nแผนที่มีเหตุการณ์สุ่มจะสามารถปิดได้ด้วยการตั้งค่าในแถบเกม"

msgid "devMaps0Status"
msgstr "แผนที่มีเหตุการณ์สุ่ม"

msgid "devMaps1"
msgstr "พาหนะของคุณสามารถถูกทำลายได้ในพื้นที่เหตุการณ์สุ่ม (ตัวอย่างเช่นเมื่อเครื่องบินตกใส่)\nแผนที่มีเหตุการณ์สุ่มจะสามารถปิดได้ด้วยการตั้งค่าในแถบเกม"

msgid "devMaps1Status"
msgstr "แผนที่มีเหตุการณ์สุ่ม"

msgid "dualGunVehicles"
msgstr "รถถังติดตั้งระบบปืนลำกล้องคู่"

msgid "epicModeHiddenFeatures"
msgstr "ฝึกการเล่นแนวรบให้เชี่ยวชาญ"

msgid "epicModeIntroduction"
msgstr "เนื้อหาของรูปแบบ"

msgid "epicModeUseful"
msgstr "เรียนรู้การเล่นแนวรบ"

msgid "epicRandom0"
msgstr "คุณอาจจะเผชิญกับปัญหาเกี่ยวกับสมรรถนะเกมเล็กน้อยในการรบชนิดนี้"

msgid "epicTip1"
msgstr "เมื่อฐานถูกยึดแล้ว พาหนะของทีมป้องกันทุกคันที่ยังคงอยู่ในเขตจะตกเป็นเป้าการทิ้งระเบิด"

msgid "epicTip10"
msgstr "นอกเหนือไปจากชื่อเสียงและเกียรติยศแล้ว ยศจะยังทำให้คุณได้รับโบนัสที่มีประโยชน์ภายหลังการรบแต่ละครั้ง"

msgid "epicTip11"
msgstr "แนวรบจะมีวิธีใหม่ๆในการหาประสบการณ์และเงิน"

msgid "epicTip12"
msgstr "แนวรบจะสามารถเคลื่อนได้จากการผลักดันอีกทีมหนึ่งไป นี่จะทำให้คุณสามารถเกิดใหม่ใกล้กับเป้าหมายของคุณมากขึ้น"

msgid "epicTip13"
msgstr "เมื่อพาหนะอยู่ในวงการยึดได้รับความเสียหาย ความคืบหน้าในการยึดสำหรับพาหนะนั้นจะถูกกั้นไว้เป็นช่วงเวลาหนึ่ง"

msgid "epicTip14"
msgstr "เปิดใช้และเพิ่มกำลังสำรองรบในหน้าจอพิเศษ ใช้กำลังสำรองรบเพื่อทำลายล้างข้าศึกในสนามรบ"

msgid "epicTip15"
msgstr "คุณสามารถเปลี่ยนแนวรบหนึ่งไปยังอีกแนวได้จากหน้าจอเกิดใหม่เสมอหากสถานการณ์ทางการรบบังคับให้คุณต้องทำ"

msgid "epicTip16"
msgstr "พยายามอย่าเข้าเขตที่ได้รับการป้องกัน เพราะฐานยิงปืนใหญ่ของข้าศึกจะเริ่มทำการยิงใส่คุณ"

msgid "epicTip17"
