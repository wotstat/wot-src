msgid "hint/LSH_FIRE"
msgstr "ควันทำให้ตรวจจับและส่งพิกัดพาหนะข้าศึกยากขึ้น ไฟจะทำให้พาหนะเสียหาย"

msgid "hint/LSH_FOG"
msgstr "หมอกทำให้ตรวจจับและส่งพิกัดพาหนะข้าศึกยากขึ้น"

msgid "hint/LSH_RAIN"
msgstr "ฝนตกหนักทำให้ตรวจจับและส่งพิกัดพาหนะข้าศึกยากขึ้น"

msgid "hint/LSH_SANDSTORM"
msgstr "พายุทรายทำให้ตรวจจับและส่งพิกัดพาหนะข้าศึกยากขึ้น"

msgid "hint/LSH_SMOKE"
msgstr "ควันทำให้ตรวจจับและส่งพิกัดพาหนะข้าศึกยากขึ้น"

msgid "hint/PPH_AIMING_01"
msgstr "การเคลื่อนพาหนะและหมุนป้อมปืนจะลด<font color='#EE7000'>ความแม่นยำปืน</font>"

msgid "hint/PPH_AIMING_02"
msgstr "วงกลมรอบศูนย์เล็งเป็นการระบุ<font color='#EE7000'>ความแม่นยำปืน</font> โปรดรอเล็กน้อยเพื่อให้ยิงได้แม่นขึ้น"

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "เปิด<font color='#EE7000'>การเล็งอัตโนมัติ</font>เอาไว้ คลิกที่เมาส์ขวาเพื่อทำการยกเลิก"

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "การเล็งอัตโนมัติจะชี้ปืนของคุณ<font color='#EE7000'>ไปยังกลางพาหนะ</font>ที่เล็งเอาไว้เสมอ"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "ฐานของคุณกำลัง<font color='#EE7000'>ถูกยึด</font>! ถ้าหยุดข้าศึกไม่ทัน ทีมข้าศึกจะชนะการรบ"

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "พาหนะข้าศึกแต่ละคันมีความก้าวหน้าการยึด<font color='#EE7000'>ของตัวเอง</font>"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>การยึด</font>ฐานข้าศึกเป็นหนึ่งในวิธีที่จะชนะการรบ"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "เมื่อคุณได้รับความเสียหาย ความก้าวหน้าการยึดของคุณจะ<font color='#EE7000'>ถูกตั้งใหม่</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "เมื่อคุณออกจากวงการยึด คุณจะ<font color='#EE7000'>เสีย</font>ความคืบหน้าการยึดไป"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "พาหนะหลายคันจะยึดฐานได้<font color='#EE7000'>เร็วขึ้น</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "หลังจากพาหนะคันที่<font color='#EE7000'>สาม</font>ไป ความเร็วการยึดจะไม่เพิ่มขึ้น"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "ฐานข้าศึกเกือบถูกยึดแล้ว!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "ทีมของเรากำลังชนะการเข้ายึดฐาน!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "ชิ้นส่วนพาหนะเสียหายร้ายแรง! ทำการซ่อมมันด้วย<font color='#EE7000'>ชุดซ่อมแซม</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_02"
msgstr "ชิ้นส่วนพาหนะเสียหายร้ายแรง! ทำการซ่อมมันด้วย<font color='#EE7000'>ชุดซ่อมแซม</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_03"
msgstr "สมาชิกพลรถถังบาดเจ็บสาหัส! รักษาด้วย<font color='#EE7000'>ชุดปฐมพยาบาล</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_04"
msgstr "สมาชิกพลรถถังบาดเจ็บสาหัส! รักษาด้วย<font color='#EE7000'>ชุดปฐมพยาบาล</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_05"
msgstr "สมาชิกพลรถถังมึนงง! รักษาด้วย<font color='#EE7000'>ชุดปฐมพยาบาล</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_06"
msgstr "พาหนะกำลังไฟไหม้! ใช้<font color='#EE7000'>เครื่องดับเพลิง</font>จากแผงด้านล่าง"

msgid "hint/PPH_CONSUMABLES_07"
msgstr "พาหนะกำลังไฟไหม้! ใช้งาน<font color='#EE7000'>เครื่องดับเพลิง</font>อัตโนมัติ"

msgid "hint/PPH_CONSUMABLES_08"
msgstr "ชิ้นส่วนพาหนะเสียหายร้ายแรง! การติดตั้ง<font color='#EE7000'>ชุดซ่อมแซม</font>ก่อนรบจะช่วยจัดการกับการเสียหายร้ายแรงได้"

msgid "hint/PPH_CONSUMABLES_09"
msgstr "สมาชิกพลรถถังบาดเจ็บสาหัส! การติดตั้ง<font color='#EE7000'>ชุดปฐมพยาบาล</font>ก่อนรบจะช่วยจัดการกับการบาดเจ็บของพลรถถังได้"

msgid "hint/PPH_CONSUMABLES_10"
msgstr "พาหนะกำลังไฟไหม้! การติดตั้ง<font color='#EE7000'>เครื่องดับเพลิง</font>ก่อนรบจะช่วยแก้ปัญหานี้ได้"

msgid "hint/PPH_OTHER_01"
msgstr "คุณถูก<font color='#EE7000'>พบ</font> การยิงอาจเผยตำแหน่งของคุณ"

msgid "hint/PPH_OTHER_02"
msgstr "พาหนะของคุณถูกทำลาย คุณสามารถกด <font color='#EE7000'>Esc</font> เพื่อออกจากการรบได้โดยไม่มีข้อเสีย"

msgid "hint/PPH_OTHER_03"
msgstr "พาหนะของคุณถูกทำลาย คุณสามารถคลิกเมาส์เพื่อ<font color='#EE7000'>สังเกตการณ์</font>พันธมิตรของคุณแทน"

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>ไอคอนหลอดไฟ</font>จะบอกว่าคุณถูกพบโดยข้าศึก!"

msgid "hint/PPH_OTHER_05"
msgstr "ปืนของคุณกำลัง<font color='#EE7000'>บรรจุอยู่</font>"

msgid "hint/PPH_OTHER_06"
msgstr "ปืนของคุณสามารถยิงได้ต่อเมื่อวงรอบศูนย์เล็งเป็น<font color='#EE7000'>สีเขียว</font>แล้ว"

msgid "hint/PPH_SNIPER_01"
msgstr "คุณสามารถเลื่อนลูกกลิ้งเมาส์เพื่อทำ<font color='#EE7000'>การเล็งประณีต</font>ได้"

msgid "hint/PPH_SNIPER_02"
msgstr "คุณสามารถเลื่อนลูกกลิ้งเมาส์เพื่อ<font color='#EE7000'>ออก</font>การเล็งประณีตได้"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>ศูนย์เล็งสีเขียวภายใน</font>หมายถึงมีโอกาสเจาะเกราะได้สูง"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "แต่ศูนย์เล็งสีเขียวภายในนี้ก็ไม่ได้<font color='#EE7000'>รับประกัน</font>ว่าจะเจาะเกราะเข้า"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "ปืนที่มีนั้นไม่ได้แม่นถึง 100% ฉะนั้นกระสุนก็อาจจะ<font color='#EE7000'>ไม่ได้ตกในกลาง</font>จุดที่เล็งเอาไว้เสมอไป"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "ศูนย์เล็งภายในจะระบุโอกาสในการเจาะเกราะข้าศึก<font color='#EE7000'>เปิดใช้มันได้ในการตั้งค่า</font>"

msgid "penetration/chance/high"
msgstr "โอกาสสูง"

msgid "penetration/chance/low"
msgstr "โอกาสต่ำ"

msgid "penetration/chance/medium"
msgstr "โอกาสปานกลาง"
