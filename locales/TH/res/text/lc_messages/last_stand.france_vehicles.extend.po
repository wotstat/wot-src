msgid "F17_AMX_13_90_LS_BOT_short"
msgstr "Corrupted"

msgid "F71_AMX_30_prototype_LS_BOT"
msgstr "Guard A.P. AMX 30"

msgid "F71_AMX_30_prototype_LS_BOT_descr"
msgstr "พัฒนาขึ้นเป็นส่วนหนึ่งของการหารถถังรวมสำหรับประเทศในยุโรป พาหนะรุ่นนี้มีความคล่องตัว กำลังเครื่องยนต์ และระยะการต่อสู้รถถังหวังผลเหนือกว่าพาหนะคันอื่นๆยกเว้น Leopard 1 เกราะของพาหนะรุ่นนี้ถือว่าบางแต่ก็ถือกันว่าความก้าวหน้าของกระสุนต่อต้านรถถังนั้นทำให้เกราะรถถังนั้นล้าสมัย และความอยู่รอดของรถถังจะขึ้นกับความคล่องตัวและอำนาจการยิง"

msgid "F71_AMX_30_prototype_LS_BOT_short"
msgstr "Guard"

msgid "F73_M4A1_Revalorise_LS_BOT"
msgstr "Guard M4A1 Rev."

msgid "F73_M4A1_Revalorise_LS_BOT_descr"
msgstr "ในทศวรรษ 1950 รุ่นดัดแปลงของรถถัง M4 หลายรุ่นถูกส่งไปยังฝรั่งเศสซึ่งเป็นส่วนหนึ่งของโครงการจัดซื้ออาวุธของกลาโหม (MDAP) แผนกออกแบบฝรั่งเศสได้เริ่มทำการปรับปรุงพาหนะดังกล่าวให้ทันสมัยโดยมีเป้าหมายในการยกระดับอำนาจการยิง การริเริ่มนี้ก่อให้เกิดโครงการปรับปรุงให้ทันสมัยในเวลาต่อของกองกำลังป้องกันตัวของอิสราเอล (Sherman M51) รถถังรุ่นดังกล่าวไม่ได้เข้าประจำการในฝรั่งเศส และไม่มีตัวเลขจำนวนของรถต้นแบบที่ถูกสร้างขึ้น"

msgid "F73_M4A1_Revalorise_LS_BOT_short"
msgstr "Guard"

msgid "F74_AMX_M4_1949_LS_BOT"
msgstr "Guard AMX M4 49"

msgid "F74_AMX_M4_1949_LS_BOT_descr"
msgstr "รถถังหนักฝรั่งเศสซึ่งรู้จักในเบื้องต้นในชื่อโครงการ 141 การพัฒนารถถังนี้เริ่มขึ้นทันทีที่สิ้นสุดสงครามโลกครั้งที่สองเนื่องจากฝรั่งเศสมีความต้องการรถถังหนักที่ทันสมัย มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F74_AMX_M4_1949_LS_BOT_short"
msgstr "Guard"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT"
msgstr "Guard AMX M4 54"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_descr"
msgstr "รุ่นดัดแปลงของรถถังหนัก AMX M4 ที่มีต้นแบบจากโครงการ 141 และทำการเสริมเกราะหน้าให้ทนทานกว่าเดิม มีการวางแผนที่จะเสริมเกราะหน้าโดยทำการติดตั้งแผ่นเกราะขนาด 280 มม.อีกด้วย มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_short"
msgstr "Guard"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT"
msgstr "Guard AMX M4 51"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_descr"
msgstr "โครงการ 141 เป็นรุ่นดัดแปลงของรถถังหนัก AMX M4 ที่มีเกราะด้านหน้าเสริมให้แข็งแกร่งกว่าเดิม การพัฒนาเริ่มต้นในเดือนพฤศจิกายน 1949 แต่พาหนะไม่ได้ถูกสร้างขึ้น โครงการยังรวมการคำนวณจำนวนมากสำหรับตัวถังที่แตกต่างกันบนโครงรถที่เหมือนกัน"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_short"
msgstr "Guard"

