msgid "LS_aoeDamageInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeDamageInstantShot/descr"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบเสียหาย"

msgid "LS_aoeDamageInstantShot/long_special"
msgstr "อุปกรณ์ยุทธวิธี ยิงกระสุนที่ทำความเสียหายเป้าหมายและพาหนะข้าศึกทุกคันในรัศมี 35 เมตร ถ้าใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน ถ้าหากไม่ใช้ จะไม่ต้องทำการเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_aoeDamageInstantShot/name"
msgstr "กระสุนพลังงาน"

msgid "LS_aoeDamageInstantShot/onUse"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรเสียหาย"

msgid "LS_aoeDamageInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeDamageInstantShot/short_special"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบเสียหาย"

msgid "LS_aoeDrainEnemyHpInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeDrainEnemyHpInstantShot/descr"
msgstr "ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากข้าศึกและพาหนะข้าศึกโดยรอบ"

msgid "LS_aoeDrainEnemyHpInstantShot/long_special"
msgstr "อุปกรณ์ยุทธวิธี ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากเป้าหมายและพาหนะข้าศึกใกล้ๆกันในรัศมี 35 เมตรรวมไปถึงซ่อมชิ้นส่วนเสียหายและลบสภาวะมึนงง ถ้าถูกใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน ถ้าหากไม่ใช้ จะไม่ต้องทำการเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_aoeDrainEnemyHpInstantShot/name"
msgstr "กระสุนดูดพลัง"

msgid "LS_aoeDrainEnemyHpInstantShot/onUse"
msgstr "ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากข้าศึกและพาหนะข้าศึกโดยรอบในรัศมี 35 เมตรรวมไปถึงซ่อมชิ้นส่วนที่เสียหายและลบสภาวะมึนงง"

msgid "LS_aoeDrainEnemyHpInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeDrainEnemyHpInstantShot/short_special"
msgstr "ยิงกระสุนที่คืนความทนทานด้วยการขโมยความทนทานจากข้าศึกและพาหนะข้าศึกโดยรอบ"

msgid "LS_aoeStunInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeStunInstantShot/descr"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบมึนงง"

msgid "LS_aoeStunInstantShot/long_special"
msgstr "อุปกรณ์ยุทธวิธี ยิงกระสุนที่ทำให้เป้าหมายและพาหนะข้าศึกทุกคันในรัศมี 35 เมตรมึนงง ถ้าใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน ถ้าหากไม่ใช้ จะไม่ต้องทำการเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_aoeStunInstantShot/name"
msgstr "กระสุนมึนงง"

msgid "LS_aoeStunInstantShot/onUse"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบในรัศมี 35 เมตรมึนงง"

msgid "LS_aoeStunInstantShot/restriction"
msgstr "?empty?"

msgid "LS_aoeStunInstantShot/short_special"
msgstr "ยิงกระสุนที่ทำให้เป้าหมายและข้าศึกโดยรอบมึนงง"

msgid "LS_damageShield/always"
msgstr "?empty?"

msgid "LS_damageShield/descr"
msgstr "ทำให้เป็นอมตะ"

msgid "LS_damageShield/long_special"
msgstr "อุปกรณ์ยุทธวิธี สร้างม่านพลังงานที่ป้องกันพาหนะของคุณจากความเสียหายใดๆก็ได้ยกเว้นการพุ่งชน, จมน้ำและการกระแทกเป็นเวลา 10 วินาที ถ้าใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน ถ้าหากไม่ใช้ จะไม่ต้องทำการเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_damageShield/name"
msgstr "ม่านพลัง"

msgid "LS_damageShield/onUse"
msgstr "สร้างม่านพลังที่ปกป้องพาหนะของคุณจากความเสียหายทุกแบบยกเว้นการพุ่งชน, การจมน้ำและการตกจากที่สูงเป็นเวลา 10 วินาที"

msgid "LS_damageShield/restriction"
msgstr "?empty?"

msgid "LS_damageShield/short_special"
msgstr "ทำให้เป็นอมตะ"

msgid "LS_doubleDamage/always"
msgstr "?empty?"

msgid "LS_doubleDamage/descr"
msgstr "กระสุนนัดต่อไปของคุณที่ยิงเข้าจะทำความเสียหายสองเท่า"

msgid "LS_doubleDamage/long_special"
msgstr "อุปกรณ์ยุทธวิธี กระสุนนัดถัดไปของคุณจะทำความเสียหายสองเท่า ถ้าใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน ถ้าหากไม่ใช้ จะไม่ต้องทำการเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_doubleDamage/name"
msgstr "ความเสียหายสองเท่า"

msgid "LS_doubleDamage/onUse"
msgstr "กระสุนนัดต่อไปของคุณที่ยิงเข้าจะทำความเสียหายสองเท่า"

msgid "LS_doubleDamage/restriction"
msgstr "?empty?"

msgid "LS_doubleDamage/short_special"
msgstr "กระสุนนัดต่อไปของคุณที่ยิงเข้าจะทำความเสียหายสองเท่า"

msgid "LS_extraDamageSituational/always"
msgstr "?empty?"

msgid "LS_extraDamageSituational/descr"
msgstr "ให้โอกาสในการทำความเสียหายพาหนะข้าศึกเพิ่มขึ้น\nโอกาสเปิดใช้งาน: 50%"

msgid "LS_extraDamageSituational/long_special"
msgstr "ความสามารถรบ เพิ่มโอกาสในการทำความเสียหายข้าศึกเพิ่มขึ้น เปิดใช้โดยอัตโนมัติโดยมีโอกาส 50% กับการยิง, พุ่งชนหรือความสามารถอื่นๆเช่นกระสุนพลังงาน สามารถใช้ได้หลายครั้งในการรบหนึ่งครั้ง จะถูกลบไปหากใช้อย่างน้อยหนึ่งครั้งในการรบ<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>ความสามารถที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_extraDamageSituational/name"
msgstr "ความเสียหายตามสถานการณ์"

msgid "LS_extraDamageSituational/onUse"
msgstr "ให้โอกาสใน<font color='#feab34'>เพิ่มการทำความเสียหาย</font>พาหนะข้าศึกมากขึ้นกับการยิง, พุ่งชนหรือความสามารถอื่นๆเช่นกระสุนพลังงาน\nโอกาสเปิดใช้งาน: <font color='#e9e2bf'>50%</font>"

msgid "LS_extraDamageSituational/restriction"
msgstr "?empty?"

msgid "LS_extraDamageSituational/short_special"
msgstr "ให้โอกาสในการทำความเสียหายพาหนะข้าศึกเพิ่มขึ้น"

msgid "LS_fastReload/always"
msgstr "?empty?"

msgid "LS_fastReload/descr"
msgstr "เพิ่มอัตราการยิง/บรรจุโม่กระสุน"

msgid "LS_fastReload/long_special"
msgstr "อุปกรณ์ยุทธวิธี เพิ่มเวลาบรรจุปืนปกติเป็นเวลาระยะหนึ่งอย่างมากหรือทำการบรรจุโม่กระสุนโดยทันที ถ้าหากใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและเติมได้ด้วยเงิน ถ้าไม่ใช้ไปก็จะไม่จำเป็นต้องเติมใหม่<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>อุปกรณ์ที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_fastReload/name"
msgstr "การบรรจุเร็ว"

msgid "LS_fastReload/onUse"
msgstr "เพิ่มความเร็วการบรรจุปืนแบบปกติอย่างมากในช่วงเวลาหนึ่งหรือบรรจุโม่กระสุนทันที"

msgid "LS_fastReload/restriction"
msgstr "?empty?"

msgid "LS_fastReload/short_special"
msgstr "เพิ่มอัตราการยิง/บรรจุโม่กระสุน"

msgid "LS_healSituational/always"
msgstr "?empty?"

msgid "LS_healSituational/descr"
msgstr "คืนความทนทานบางส่วนหลังทำลายพาหนะข้าศึก\nโอกาสเปิดใช้งาน: 50%"

msgid "LS_healSituational/long_special"
msgstr "ความสามารถรบ คืนความทนทาน 500 หน่วยทันทีให้กับพาหนะของคุณหลังทำลายพาหนะข้าศึกหนึ่งคัน ดับเพลิง, ลบสภาวะมึนงงและซ่อมชิ้นส่วนเสียหาย เปิดใช้โดยอัตโนมัติโดยมีโอกาส 50% ในกรณีที่ทำความเสียหาย, ทำให้มึนงงหรือทำให้ชิ้นส่วนเสียหายร้ายแรง สามารถใช้ได้หลายครั้งในการรบหนึ่งครั้ง จะถูกลบไปหากใช้อย่างน้อยหนึ่งครั้งในการรบ<br/><br/>มีให้เฉพาะในกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font> เท่านั้น<br/><br/>ความสามารถที่ไม่ได้ถูกใช้ทั้งหมดจะถูกลบไปและคืนให้เป็นเงินเท่ากับ 50% ของราคาในอัพเดตถัดไป"

msgid "LS_healSituational/name"
msgstr "การซ่อมตามสถานการณ์"

msgid "LS_healSituational/onUse"
msgstr "• <font color='#FEAB34'>คืนความทนทาน 500 หน่วย</font>ทันทีให้กับพาหนะของคุณหลังทำลายพาหนะข้าศึกหนึ่งคัน\n• ดับเพลิง, ลบสภาวะมึนงงและซ่อมชิ้นส่วนเสียหาย\n•เปิดใช้โดยอัตโนมัติในกรณีที่ทำความเสียหาย, ทำให้มึนงงหรือทำให้ชิ้นส่วนเสียหายร้ายแรง\n• โอกาสเปิดใช้งาน <font color='#E9E2BF'>50%</font>"

msgid "LS_healSituational/restriction"
msgstr "?empty?"

msgid "LS_healSituational/short_special"
msgstr "คืนความทนทานบางส่วนหลังทำลายพาหนะข้าศึก"

msgid "LS_invisibility/always"
msgstr "?empty?"

msgid "LS_invisibility/descr"
msgstr "หยุดให้ข้าศึกเล็งเป้าพาหนะคุณ, คืนความทนทาน, ซ่อมชิ้นส่วนและดับเพลิง"

msgid "LS_invisibility/long_special"
msgstr "อุปกรณ์ยุทธวิธี หยุดข้าศึกจากการเล็งเป้าที่พาหนะของคุณเป็นเวลา 10 วินาที คืนความทนทาน 32 หน่วยต่อวินาที, ซ่อมชิ้นส่วนทันที, ดับเพลิง, ลบสภาวะมึนงงและรักษาพลรถถังที่บาดเจ็บทุกคน การทำหรือได้รับความเสียหายพาหนะข้าศึก (ด้วยการยิง, พุ่งชนหรือใช้อุปกรณ์ยุทธวิธี) จะเปิดเผยตำแหน่งของคุณทันที ถ้าใช้อย่างน้อยหนึ่งครั้งในการรบ อุปกรณ์จะถูกใช้ไปและสามารถเติมได้ด้วยเงิน หากไม่ได้ใช้ก็จะไม่จำเป็นต้องทำการเติม<br/><br/>มีให้เฉพาะในช่วงกิจกรรม<font color='#cbac77'>การยืนหยัดครั้งสุดท้าย: โลกแดนเหนือ</font><br/><br/>อุปกรณ์ทั้งหมดที่ไม่ได้ใช้จะถูกลบออกไปและชดเชยเป็นเงินเทียบเท่า 50% ของราคาเมื่อทำการเปิดตัวอัพเดตถัดไป"

msgid "LS_invisibility/name"
msgstr "การซ่อมล่องหน"

msgid "LS_invisibility/onUse"
msgstr "ทำให้ข้าศึกจับเป้าคุณไม่ได้เป็นเวลา 10 วินาที คืนความทนทาน 32 หน่วยต่อวินาที, ซ่อมชิ้นส่วนทันที, ดับเพลิง, ลบสภาวะมึนงงและรักษาพลรถถังที่บาดเจ็บทุกคน การทำหรือได้รับความเสียหายพาหนะข้าศึก (ด้วยการยิง, พุ่งชนหรือใช้อุปกรณ์ยุทธวิธี) จะเปิดเผยตำแหน่งของคุณทันที"

msgid "LS_invisibility/restriction"
msgstr "?empty?"

msgid "LS_invisibility/short_special"
