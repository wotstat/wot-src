msgstr "Vickers Medium Mk. II"

msgid "GB05_Vickers_Medium_Mk_II_descr"
msgstr "รถถังกลางอังกฤษ พัฒนาขึ้นจากรากฐานของรถถัง Vickers Medium Mark I ใปนี 1924 ถึง 1925 โดย Vickers รถรุ่นนี้ถูกผลิตจำนวนมากตั้งแต่ปี 1925 ถึง 1934 โดยมียอดการผลิตรวมทั้งหมด 100 คัน"

msgid "GB05_Vickers_Medium_Mk_II_short"
msgstr "Medium II"

msgid "GB06_Vickers_Medium_Mk_III"
msgstr "Vickers Medium Mk. III"

msgid "GB06_Vickers_Medium_Mk_III_descr"
msgstr "รถถังกลางของอังกฤษที่รู้กันในอีกชื่อหนึ่งว่า Vickers \"16-tonners\" มีการผลิตรถต้นแบบขึ้นมาสาม คันโดย Vickers ในช่วงปี 1926 ถึง 1931 และจากแหล่งข้อมูลบางแหล่ง มีการผลิตรถถังเพิ่มขึ้นมาอีกสามคันในปี 1933 และเข้าประจำการถึงปี 1938 แต่ไม่ได้เข้าร่วมการรบ"

msgid "GB06_Vickers_Medium_Mk_III_short"
msgstr "Medium III"

msgid "GB07_Matilda"
msgstr "Matilda"

msgid "GB07_Matilda_descr"
msgstr "พัฒนาขึ้นในช่วงปี 1936 ถึง 1938 และมียอดการผลิตทั้งหมด 2987 คันเมื่อการผลิตยุติลงในเดือนสิงหาคม 1943 รถถังรุ่นนี้เป็นรุ่นเดียวที่เข้าประจำการตลอดการรบในสงครามโลกครั้งที่สอง"

msgid "GB07_Matilda_short"
msgstr "Matilda"

msgid "GB08_Churchill_I"
msgstr "Churchill I"

msgid "GB08_Churchill_I_descr"
msgstr "รถถังต้นแบบ A22 ผลิตโดย Vauxhall Motors ในช่วงฤดูใบไม้ร่วงปี 1940 รถถังรุ่นนี้เข้าสายการผลิตจำนวนมากในช่วงฤดูร้อนของปี 1941 การดัดแปลงรถถังช่วงแรกนั้นไม่มีรางครอบตีนตะขาบ พัดลมรุ่นอื่นและปืนใหญ่สนามขนาด 3 นิ้วในตัวถัง มียอดการผลิต รถถัง Churchill I ทั้งหมด 300 คัน"

msgid "GB08_Churchill_I_short"
msgstr "Churchill I"

msgid "GB09_Churchill_VII"
msgstr "Churchill VII"

msgid "GB09_Churchill_VII_descr"
msgstr "การดัดแปลงรถถัง A22 พร้อมด้วยเกราะรุ่นปรับปรุง ยานเกราะคันแรกของรุ่นนี้ผลิตเสร็จทันก่อนการยกพลขึ้นหาดของพันธมิตรที่นอร์มังดี รถถังรุ่นนี้ยังเป็นตัวถังสำหรับรถถังพ่นไฟ Churchill Crocodile อีกด้วย"

msgid "GB09_Churchill_VII_short"
msgstr "Churchill VII"

msgid "GB100_Manticore"
msgstr "Manticore"

msgid "GB100_Manticore_descr"
msgstr "โครงการรถถังเบาที่ใช้ป้อมปืนแบบส่ายเพื่อใช้ยิงต่อต้านรถถังหลังแนวทหารราบ ไม่มีการสร้างรถต้นแบบขึ้นมีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB100_Manticore_short"
msgstr "Manticore"

msgid "GB101_FV1066_Senlac"
msgstr "FV1066 Senlac"

msgid "GB101_FV1066_Senlac_descr"
msgstr "FV1066 Senlac นั้นเป็นรุ่นดัดแปลงของรถถังเบาที่พัฒนาขึ้นในทศวรรษ 1960 จากข้อกำหนดที่ตั้งไว้โดยฝ่ายเสนาธิการ รถถังคันนี้ควรจะมีความคล่องตัวและความว่องไวที่เทียบเท่า M24 Chaffee ของสหรัฐฯ โครงการนี้มีการใช้ป้อมปืนแบบส่าย มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB101_FV1066_Senlac_long_special"
msgstr "รถถังเบาพิเศษหลากวัตถุประสงค์ระดับ VIII ของอังกฤษที่ไม่ได้มีจุดเด่นหรือจุดด้อยใดๆ ปืนของรถถังไม่ได้มีความแม่นยำมากแต่มีการปรับเสถียรที่ดี อีกทั้งยังติดตั้งกระสุนระเบิดแรงสูงที่เจาะเกราะได้มากและมีประสิทธิภาพกับพาหนะข้าศึกที่เกราะบาง"

msgid "GB101_FV1066_Senlac_short"
msgstr "Senlac"

msgid "GB101_FV1066_Senlac_short_special"
msgstr "หน่วยลาดตระเวนหลากภารกิจติดปืนที่ไว้ใจได้"

msgid "GB102_LHMTV"
msgstr "LHMTV"

msgid "GB102_LHMTV_descr"
msgstr "โครงการรถถังเบาที่มีน้ำหนักน้อยที่สุดซึ่งทำให้ขนส่งทางอากาศรถถังรุ่นนี้ได้ รถถังรุ่นนี้ถูกพัฒนาเป็นเวลาสามปีและมีการผลิตรถต้นแบบขึ้นหนึ่งคัน"

msgid "GB102_LHMTV_short"
msgstr "LHMTV"

msgid "GB103_GSOR3301_AVR_FS"
msgstr "GSOR 3301 AVR FS"

msgid "GB103_GSOR3301_AVR_FS_descr"
msgstr "GSOR 3301 AVR FS นั้นเป็นรุ่นรถถังเบาที่ถูกพัฒนาในช่วงทศวรรษ 1960 โครงการนี้ถือเป็นรุ่นดัดแปลงที่ต่างออกไปโดยใช้อาวุธ เครื่องยนต์และป้อมปืนอีกแบบ มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB103_GSOR3301_AVR_FS_short"
msgstr "AVR FS"

msgid "GB104_GSR_3301_Setter"
msgstr "GSR 3301 Setter"

msgid "GB104_GSR_3301_Setter_descr"
msgstr "ในปี 1964 ฝ่ายเสนาธิการได้ตั้งข้อกำหนดสำหรับยานลาดตระเวนรบแบบใหม่ขึ้น การวิจัยและพัมนารถต้นแบบขนาดจริงและตัวแทนสำหรับการทดลองแนวการสร้างเครื่องยนต์ (หนึ่งชุดสำหรับระบบหล่อเย็นและอีกชุดสำหรับการทดสอบช่วงล่างและส่วนส่งกำลัง) นั้นสำเร็จในปี 1965 การพัฒนาต่อทำให้นำไปสู่การผลิตยาน CVR(T) และนำเข้าประจำการในกองทัพบกอังกฤษ"

msgid "GB104_GSR_3301_Setter_short"
msgstr "Setter"

msgid "GB105_Black_Prince_2019"
msgstr "A43 BP prototype"

msgid "GB105_Black_Prince_2019_descr"
msgstr "ถูกพัฒนาในปี 1943 ถึง 1945 โดยใช้รถถัง Churchill เป็นฐานการออกแบบ และเปลี่ยนให้ตัวถังกว้างขึ้นเพื่ให้ติดตั้งป้อมปืนรุ่นปรับปรุงพร้อมกับปืนขนาด 17 ปอนด์ได้ มีการผลิตรถถังต้นแบบ Black Prince ทั้งหมด 6 คัน ในช่วงปี 1944 ถึง 1945 และเข้ารับการทดสอบแต่ไม่ได้เข้าร่วมการรบแต่อย่างใด"

msgid "GB105_Black_Prince_2019_long_special"
msgstr "รุ่นใกล้เคียงกับรถถัง Black Prince ที่วิจัยได้แต่ระดับต่ำกว่าหนึ่งระดับ รถถังคันนี้มีเกราะที่ไว้ใจได้ดั่งเช่น Churchill VII แต่ติดตั้งปืนขนาด 17 ปอนด์และมีกำลังขับจำเพาะถึง 12 แรงม้า/ตันที่ทำให้รถถังคันนี้เป็นคู่ต่อสู้ที่น่าเกรงขามในสนามรบ อย่างไรก็ตาม ความคล่องตัวและความเสียหายต่อนาทีที่ต่ำอาจกลายเป็นข้อเสียเปรียบในบางกรณีได้"

msgid "GB105_Black_Prince_2019_short"
msgstr "A43 BP"

msgid "GB105_Black_Prince_2019_short_special"
msgstr "ปืนที่เยี่ยมและเกราะที่ใช้ได้"

msgid "GB106_Cobra"
msgstr "Cobra"

msgid "GB106_Cobra_descr"
msgstr "โครงการรถถังกลางที่มีป้อมปืนแบบส่าย พัฒนาขึ้นในปี 1954 โดยนายทหารชั้นปีที่ 7 ของคณะบุคลากรเทคนิคของวิทยาลัยวิทยาศาสตร์ทางทหารประจำกองทัพ (เมือง Shrivenham ในอังกฤษ) มีอยู่ในแบบพิมพ์เขียวและมีรถต้นแบบหนึ่งคัน"

msgid "GB106_Cobra_long_special"
msgstr "รถถังกลางอังกฤษที่มีปืนระบบบรรจุซองกระสุนบนป้อมปืนแบบส่าย กระสุนระเบิดแรงสูงพิเศษทำให้รถถังมีอำนาจการยิงที่มหาศาลแต่ใช้ให้เต็มศักยภาพได้ยาก ยุทธวิธีที่ดีที่สุดนั้นคือการลอบซุ่มโจมตีและทำลายข้าศึกที่ระยะใกล้"

msgid "GB106_Cobra_short"
msgstr "Cobra"

msgid "GB106_Cobra_short_special"
msgstr "ระบบป้อนซองกระสุน อำนาจการยิงสูง"

msgid "GB107_Cavalier"
msgstr "Cavalier"

msgid "GB107_Cavalier_descr"
msgstr "โครงการนี้ถูกพัฒนาโดย Nuffield Mechanizations และ Aero ในปี 1941 โดยมีต้นแบบมาจากการใช้ชิ้นส่วนและส่วนประกอบของ Crusader และจากการขาดยานเกราะ อังกฤษจึงเริ่มทำการผลิตรถถังจำนวนมากโดยไม่มีการทดสอบ มียอดการผลิตทั้งหมด 500 คัน"

msgid "GB107_Cavalier_short"
msgstr "Cavalier"

msgid "GB108_A46"
msgstr "A46"

msgid "GB108_A46_descr"
msgstr "การพัฒนานั้นเริ่มขึ้นในเดือนธันวาคม 1943 มีการวางแผนเริ่มสายการผลิตจำนวนมากในปี 1945 รถถังคันนี้ถูกมุ่งหมายให้มาแทนที่ M3/M5 Stuart ของสหรัฐฯ (และต่อมาเป็น M24 Chaffee) ที่ถูกใช้โดยหน่วยสอดแนมของกรมยานเกราะ มีการสรุปข้อตกลงกับบริษัท Vickers การทดสอบวิธีการแก้ไขทางเทคนิคกับยานเกราะ Tetrarch และ Harry Hopkins ได้ถูกนำมาใช้กับรถถังคันนี้ มีการสร้างรถต้นแบบจากไม้ขึ้นมา อย่างไรก็ตาม หลังจากจบสงครามโลกครั้งที่สอง ก็ได้มีการเปลี่ยนข้อกำหนดทางยุทธวิธีและทางเทคนิค การพัฒนาขั้นต่อไปยังคงดำเนินในชื่อโครงการ FV300"

msgid "GB108_A46_long_special"
msgstr "รถถังคันนี้มีส่วนผสมที่ได้เปรียบของความคล่องตัว การปรับเสถียรปืน และความเสียหายต่อนาที รถถังถูกมุ่งหมายให้ปฏิบัติการในการชี้เป้าแบบเคลื่อนที่และการรบประชิดจากการใช้ปืนที่แม่นยำและเจาะเกราะได้ดีทำให้มันไม่เหมาะกับการยิงอย่างแม่นยำจากระยะไกล"

msgid "GB108_A46_short"
msgstr "A46"

msgid "GB108_A46_short_special"
msgstr "หน่วยสอดแนมมีประสิทธิภาพและมีความคล่องตัวสมบูรณ์แบบ"

msgid "GB109_GSOR_1008"
msgstr "GSOR 1008"

msgid "GB109_GSOR_1008_CFE_J"
msgstr "Jade Coil"

msgid "GB109_GSOR_1008_CFE_J_descr"
msgstr "ในราศี งูธาตุไม้เป็นที่รู้จักจากความหลักแหลม, ความสามารถปรับตัวและความพยายามใฝ่รู้ จุดเด่นของงูธาตุไม้อยู่ในการแปลงสภาพที่คำนวณมาอย่างดี ดังเช่นรากไม้ที่คดใต้พื้นดิน งูเลื้อยอย่างไร้ร่องรอยและค่อยๆกำหนดดินแดนของตัวเอง บางคนกล่าวว่างูธาตุไม้นั้นเป็นญาติของงูเหลือมที่กลืนสวรรค์ในตำนานโบราณ งูธาตุไม้นั้นไม่ได้ตอบเสียงเล่าลือนั้นเพราะความลับคืออาวุธของมัน งูนี้ไปอยู่ในที่ที่ควรอยู่เสมอและค่อยๆเลื้อยหลบเลี่ยงไปตามทางของตัวเองในระหว่างที่ผู้อื่นเดินอย่างซุ่มซ่าม"

msgid "GB109_GSOR_1008_CFE_J_long_special"
msgstr "ป้อมปืนหมุนได้รอบตัวและระบบบรรจุซองกระสุนทำให้ยานเกราะคันนี้แตกต่างจากยานเกราะชนิดเดียวกันคันอื่นๆ มุมกดปืนที่มีและเวลาบรรจุระหว่างนัดที่เร็วทำให้ยานเกราะสามารถปลดปล่อยอำนาจการยิงจากที่กำบังที่ปลอดภัยได้"

msgid "GB109_GSOR_1008_CFE_J_short"
msgstr "Jade Coil"

msgid "GB109_GSOR_1008_CFE_J_short_special"
msgstr "ด้วยความสง่างามของความอดทน งูไม้ก็เลื้อยอย่างไร้ร่องรอย"

msgid "GB109_GSOR_1008_descr"
msgstr "โครงการยานพิฆาตรถถังติดตั้งป้อมปืนแบบส่ายในช่วงต้นทศวรรษ 1960 พัฒนาขึ้นภายใต้โครงการ GSOR เพื่อเพิ่มคุณลักษณะการป้องกันและความคล่องตัวของพาหนะ การพัฒนาหยุดลงภายหลังที่มีการเตรียมชุดพิมพ์เขียวสำหรับการประกอบยานจำลองขึ้นมา"

msgid "GB109_GSOR_1008_long_special"
msgstr "ป้อมปืนหมุนได้รอบตัวและระบบบรรจุซองกระสุนทำให้ยานเกราะคันนี้แตกต่างจากยานเกราะชนิดเดียวกันคันอื่นๆ มุมกดปืนที่มีและเวลาบรรจุระหว่างนัดที่เร็วทำให้ยานเกราะสามารถปลดปล่อยอำนาจการยิงจากที่กำบังที่ปลอดภัยได้"

msgid "GB109_GSOR_1008_short"
msgstr "GSOR 1008"

msgid "GB109_GSOR_1008_short_special"
msgstr "อำนาจการยิงที่สมบูรณ์แบบและมุมกด/มุมยกที่ดี"

msgid "GB10_Black_Prince"
msgstr "Black Prince"

msgid "GB10_Black_Prince_descr"
msgstr "ถูกพัฒนาในปี 1943 ถึง 1945 โดยใช้รถถัง Churchill เป็นฐานการออกแบบ และเปลี่ยนให้ตัวถังกว้างขึ้นเพื่ให้ติดตั้งป้อมปืนรุ่นปรับปรุงพร้อมกับปืนขนาด 17 ปอนด์ได้ มีการผลิตรถถังต้นแบบ Black Prince ทั้งหมด 6 คัน ในช่วงปี 1944 ถึง 1945 และเข้ารับการทดสอบแต่ไม่ได้เข้าร่วมการรบแต่อย่างใด"

msgid "GB10_Black_Prince_short"
msgstr "Black Prince"

msgid "GB110_FV4201_Chieftain_Prototype"
msgstr "FV4201 Chieftain Proto"

msgid "GB110_FV4201_Chieftain_Prototype_descr"
msgstr "การพัฒนารถถังใหม่สำหรับกองทัพบกอังกฤษนั้นเริ่มขึ้นในปี 1951 ในช่วงการวิจัยได้มีการพิจารณาเลือกใช้อาวุธ หน่วยกำเนิดพลังและระบบส่งกำลังจำนวนมากมาใช้งาน ในเดือนมกราคม 1960 รถต้นแบบคันแรกของยานเกราะคันใหม่ก็ประกอบจนสำเร็จ โดยรวมแล้วมีการสร้างรถต้นแบบขึ้น 6 คันที่ได้รับการปรับปรุงหลายครั้งในช่วงการทดสอบ การพัฒนารถต้นแบบนี้ได้นำไปสู่การที่รถถัง Chieftain ได้รับเข้าประจำการในปี 1966"

msgid "GB110_FV4201_Chieftain_Prototype_long_special"
msgstr "รถถังอังกฤษพิเศษระดับ IX ที่มีปืนอันแม่นยำและมุมกด/มุมยกที่ดี นอกจากจะมีความคล่องตัวที่ดีเมื่อเทียบกับบรรดารถถังแบบเดียวกันแล้วมันยังมีระยะการมองเห็นที่ยอดเยี่ยมและเกราะหน้าที่ดี อย่างไรก็ตาม เกราะข้างและเกราะหลังนั้นก็ไม่ได้ถือว่าดีนัก"

msgid "GB110_FV4201_Chieftain_Prototype_short"
msgstr "Chieftain P."

msgid "GB110_FV4201_Chieftain_Prototype_short_special"
msgstr "ปืนที่มีประสิทธิภาพและเกราะหน้าที่ทนทาน"

msgid "GB111_Charlemagne"
msgstr "Charlemagne"

msgid "GB111_Charlemagne_descr"
msgstr "โครงการที่พัฒนาโดยวิทยาลัยวิทยาการรถถัง (School of Tank Technology, STT) ในปี 1958 ซึ่งเป็นการนำเสนอรถถังกลางที่มีความสามารถการแล่นพื้นที่กันดารได้ดี มีพิกัดน้ำหนักสูงสำหรับรถถังกลางและมีรูปทรงที่ต่ำ รถถังคันนี้ถูกมุ่งหมายให้ส่วนหน้าเป็นแบบหัวทวนและใช้ป้อมปืนแบบหล่อขึ้นรูปทั้งหมด เกราะตัวถังและป้อมปืนส่วนหน้านั้นมีแผนที่จะทำให้แข็งแกร่งพอเพื่อต่อกรรถถังหนักโซเวียตได้ คุณลักษณะที่เป็นเอกลักษณ์ของรถถังคันนี้คือปืนที่มีการปรับเสถียรอันสมบูรณ์แบบและความเร็วกระสุนต่ำ"

msgid "GB111_Charlemagne_long_special"
msgstr "รถถังหนักอังกฤษที่มีแนวการออกแบบตามธรรมเนียมเดิม ความเสียหายต่อนัดที่สูงและความคล่องตัวที่ดีทำให้รถถังสามารถขัดขวางแผนการของข้าศึกได้ครั้งแล้วครั้งเล่า มุมกด/มุมยกและการปรับเสถียรปืนใหญ่ที่ติดตั้งเอาไว้จะช่วยให้คุณใช้ภูมิประเทศไม่ราบเรียบให้เป็นประโยชน์ได้ อย่างไรก็ตามคุณควรจะระวังความแม่นยำและความเร็วกระสุนที่ต่ำเอาไว้"

msgid "GB111_Charlemagne_short"
msgstr "Charlemagne"

msgid "GB111_Charlemagne_short_special"
msgstr "เกราะหน้าที่ไว้ใจได้ ความเสียหายต่อนัดที่ยอดเยี่ยม และมุมกด/มุมยกที่ดี"

msgid "GB112_Caliban"
msgstr "Caliban"

msgid "GB112_Caliban_descr"
msgstr "Caliban เป็นโครงการของราชวิทยาลัยกองทัพบกที่พัฒนาขึ้นในปี 1962 รถถังคันนี้ไม่ได้มีรูปทรงที่สวยงามแต่ก็มีคุณลักษณะในด้านความคล่องตัวที่ยอดเยี่ยม เกราะหน้าที่ไว้ใจได้และปืนที่ทรงพลัง แต่กลายเป็นว่าโครงการนี้มีความซับซ้อนและราคาสูงเกินไปอีกทั้งนวัตกรรมจำนวนมากของรถถังคันนี้ก็ไม่ได้เป็นเครื่องรับประกันว่ารถถังจะมีความเหนือกว่ายานเกราะรบที่กำลังผลิตและพัฒนาคันอื่นๆ การพัฒนารถถังจึงหยุดลงในขั้นทำแบบร่างและไม่มีการสร้างรถต้นแบบขึ้นมา"

msgid "GB112_Caliban_long_special"
msgstr "รถถังหนักอังกฤษระดับ VIII ปืน 6 นิ้วที่ิติดตั้งเอาไว้ใช้ระบบป้อนกระสุนอัตโนมัติทำให้มีศักยภาพการทำความเสียหายที่สูงอีกทั้งความคล่องตัวที่ดีทำให้รถถังสามารถเข้าจุดยิงอย่างรวดเร็วและตอบสนองกับสภาวะคับขันในการรบได้อย่างว่องไว อย่างไรก็ตามความแม่นยำและเวลาการเล็งของปืนรถถังคันนี้ถือว่าค่อนข้างช้า"

msgid "GB112_Caliban_short"
msgstr "Caliban"

msgid "GB112_Caliban_short_special"
msgstr "ความเสียหายต่อนัดที่สูงมาก มุมกด/มุมยกที่ดีและเกราะที่ไว้ใจได้"

msgid "GB113_Matilda_LVT"
msgstr "Matilda LVT"

msgid "GB113_Matilda_LVT_descr"
msgstr "ในช่วงฤดูใบไม้ร่วงปี 1941 กองทัพบกออสเตรเลียได้รับรถถังทหารราบ Matilda จำนวน 200 คันซึ่งได้ถูกนำมาใช้ในการต่อสู้ที่เอเชียอาคเนย์ รถถังคันนี้มีเกราะที่ทนทานแต่อาวุธที่ติดตั้งเอาไว้นั้นไม่ได้มีอำนาจการยิงมากและไม่มีกระสุนระเบิดแรงสูงให้ใช้ หลังจากนำเข้าประจำการได้พักหนึ่ง ทางออสเตรเลียเองก็ได้เริ่มสายการผลิตรถถังนี้ในประเทศและทำการทดลองติดตั้งป้อมปืนจากยานเกราะคันอื่นเข้ากับตัวถังเช่น LVT(A)-4 และ LVT(A)-5 แต่ไม่มีผู้ใดทราบว่ามีการนำรถถังดัดแปลงมาใช้ในการรบหรือมีรายละเอียดการออกแบบใดๆอื่นบ้าง"

msgid "GB113_Matilda_LVT_long_special"
msgstr "รถถังกลางอังกฤษระดับ IV ที่รวมตัวถังของ Matilda และป้อมปืนกับปืนใหญ่ของ M8A1 เข้าไว้ด้วยกัน รถถังลูกผสมคันนี้มีประสิทธิภาพในการรบอย่างมากและเป็นคู่ต่อสู้ที่อันตรายต่อข้าศึกทุกคัน ปืนที่ไว้ใจได้แต่ความเร็วที่ปานกลางทำให้รถถังเหมาะกับการเป็นหน่วยสนับสนุนจากระยะไกลแต่ Matilda LVT นั้นก็รับบทบาทนี้ได้เป็นอย่างดี"

msgid "GB113_Matilda_LVT_short"
msgstr "Matilda LVT"

msgid "GB113_Matilda_LVT_short_special"
msgstr "ปืนที่ทรงพลังและเกราะตัวถังที่ไว้ใจได้"

msgid "GB114_Vickers_MBT_Mk3"
msgstr "Vickers MBT Mk. 3"

msgid "GB114_Vickers_MBT_Mk3_desc"
msgstr "Vickers Mk. 3 เป็นการพัฒนาของรถถัง Vickers Mk. 1 รถถังรุ่นนี้ถูกออกแบบมาเพื่อการส่งออกในช่วงกลางทศวรรษ 1970 ในฐานะโครงการเอกเทศและควรจะเป็นตัวเลือกที่ถูกกว่าแทนที่รถถังที่มีราคาสูงเช่น Chieftain ในปี 1977 บริษัท Vickers ได้ลงนามสัญญาการต่อรถถัง Vickers Mk. 3 76 คันให้กองทัพบกเคนยา รถถังเหล่านี้ทำการประกอบที่โรงงาน Vickers Scotswood ในนิวคาสเซิลระหว่างปี 1977 ถึง 1981 ทาง Vickers ได้ลงสัญญาที่จะทำการส่งมอบรถถัง Mk. 3N 108 คันไปยังกองทัพไนจีเรีย ในช่วงปี 1990 ทางไนจีเรียได้ทำการสั่งรถถัง Mk.3 อีก 64 คัน รถถังรุ่นนี้ทำการผลิตจนถึงปี 1995"

msgid "GB114_Vickers_MBT_Mk3_long_special"
msgstr "โครงการรถถังกลางที่มุ่งหมายให้เป็นตัวเลือกราคาถูกแทนที่รถถังที่ซับซ้อนและราคาสูงกว่า MBT Mk.3 นั้นติดตั้งปืน L7 และมีความคล่องตัวและว่องไวที่ยอดเยี่ยม แม้ว่ารถถังจะมีเกราะปานกลาง แต่ Vickers MBT Mk. 3 ก็ยังเป็นคู่ต่อสู้ที่อันตรายกับยานเกราะทุกคันที่ได้เผชิญหน้า"

msgid "GB114_Vickers_MBT_Mk3_short"
msgstr "Vickers 3"

msgid "GB114_Vickers_MBT_Mk3_short_special"
msgstr "ปืนชั้นยอด, ระยะการมองเห็นที่ดี"

msgid "GB115_Gonsalo"
msgstr "Gonsalo"

msgid "GB115_Gonsalo_descr"
msgstr "โครงการดังกล่าวพัฒนาขึ้นที่ราชวิทยาลัยทหารอังกฤษในปี 1962 รถถังถูกมุ่งหมายให้มีความคล่องตัวที่ยอดเยี่ยม เกราะหน้าที่ดีและปืนที่ทรงพลังซึ่งใช้ระบบป้อนกระสุนแบบโม่ โดยดั้งเดิมมีแผนให้ใช้ปืนขนาด 160 มม.ที่มีกระสุนระเบิดแรงสูงและกระสุนหัวรบปรมาณู ในช่วงการหลังของการผลิต ปัญหาทางเทคนิคที่เกิดขึ้นทำให้มีการพิจารณาตั้งชื่อ Gonsalo สำหรับรุ่นรถถังที่ติดตั้งปืน 120 มม.และใช้กระสุนเจาะเกราะกับกระสุนระเบิดแรงสูงแทน การพิจารณาต่อแสดงให้เห็นว่ารถถังคันนี้มีความซับซ้อนและมีค่าการผลิตสูงเกินไปและนวัตกรรมใหม่ๆที่ใช้กับรถถังก็ไม่ได้รับประกันว่าจะมีความได้เปรียบเหนือพาหนะคันอื่นๆที่กำลังพัฒนาและผลิตอยู่ในช่วงเดียวกัน โครงการนี้ถูกปิดตัวลงในช่วงการออกแบบแนวคิดและมีเพียงการร่างแบบพิมพ์เขียวขึ้นแต่ไม่มีการผลิตรถต้นแบบขึ้นมา"

msgid "GB115_Gonsalo_long_special"
msgstr "รถถังหนักอังกฤษพิเศษระดับ VIII ที่มีการออกแบบแบบดั้งเดิมด้วยปืนบรรจุปกติแต่มีรูปทรงที่แปลกออกไป จุดเด่นหลักของรถถังคือกระสุนระเบิดแรงสูงพิเศษที่มีการเจาะเกราะสูงขึ้น บนสนามรบ Gonsalo นั้นเป็นรถถังสนับสนุนที่ดึงศักยภาพออกมาใช้ได้ในกลางการรบ โดยเฉพาะเมื่อทำการเข้าตีโอบข้าศึก"

msgid "GB115_Gonsalo_short"
msgstr "Gonsalo"

msgid "GB115_Gonsalo_short_special"
msgstr "การเจาะเกราะที่ใช้ได้และความคล่องตัวที่ดี"

msgid "GB116_Harry_Hopkins_I"
msgstr "A25 Harry Hopkins I"

msgid "GB116_Harry_Hopkins_I_descr"
msgstr "การพัฒนาของรุ่นดัดแปลง Tetrach I ภายใต้รหัสเรียกขาน Light Tank Mk. VIII หรือ A25 นั้นเริ่มในปี 1941 ตัวถังส่วนหน้าและเกราะป้อมปืนได้รับการเสริมให้หนาขึ้นเพื่อรวมกับแผ่นเกราะข้างให้กลายเป็นเกราะลาดเอียง ไม่มีความเปลี่ยนแปลงในด้านมิติของพาหนะทำให้น้ำหนักรบยังคงอยู่ที่ 8.5 ตัน\nในเดือนพฤศจิกายน 1941 ชื่อรถถังถูกเปลี่ยนเป็น Harry Hopkins I เพื่อเป็นเกียรติให้กับ Harry Hopkins ที่ปรึกษาของประธานาธิบดี Roosevelt ยานเกราะคันนี้ล้มเหลวในการทดสอบที่ตะวันออกกลางเนื่องด้วยปัญหาจากสภาวะอากาศที่ร้อนและภูมิประเทศเป็นทราย รถถังหกคันแรกถูกสร้างขึ้นในปี 1943 ซึ่งถึงเวลานั้นทางกองทัพบกอังกฤษก็ไม่ได้มีความสนใจมากนัก\nแต่ก็เป็นการยากที่จะเรียกว่าโครงการ A25 นั้นล้มเหลวเพราะในปี 1942 ยานพิฆาตรถถัง Alecto ได้ถูกพัฒนาจากตัวถังของ Harry Hopkins I มันไม่ได้เข้าร่วมสงครามแต่ถูกใช้มาจนถึงปลายทศวรรษที่ 1940 ในยุโรปและตะวันออกกลาง มี Harry Hopkins I หนึ่งคันรอดมาจนถึงทุกวันนี้และยังคงอยู่ที่พิพิธภัณฑ์รถถังโบวิงตันในสหราชอาณาจักร"

msgid "GB116_Harry_Hopkins_I_long_special"
msgstr "รถถังเบาอังกฤษมีปืนคุณลักษณะยอดเยี่ยม การเจาะเกราะที่ใช้ได้รวมเข้ากับอัตราการยิงสูงทำให้มันเป็นคู่ต่อสู้ที่น่ากลัว ความเร็วกระสุนที่ไม่น่าเชื่อทำให้มันมีส่วนร่วมกับทีมอย่างมากทั้งในการบุกและตั้งรับ"

msgid "GB116_Harry_Hopkins_I_short"
msgstr "A25 H.H. I"

msgid "GB116_Harry_Hopkins_I_short_special"
msgstr "อัตราการยิงสูงและการเจาะเกราะดี"

msgid "GB11_Caernarvon"
msgstr "Caernarvon"

msgid "GB11_Caernarvon_descr"
msgstr "การพัฒนารถถังสนับสนุนทหารราบรุ่นนี้เริ่มขึ้นในปี 1944 รถต้นแบบคันแรกพร้อมทำการทดสอบในปี 1952 มีรถถัง 21 คันถูกผลิตขึ้นแต่ไม่ได้รับเข้าประจำการ รถถังบางส่วนถูกดัดแปลงให้กลายเป็นรถถังหนัก Conqueror แทนในเวลาต่อมา"

msgid "GB11_Caernarvon_short"
msgstr "Caernarvon"

msgid "GB120_Concept_No_5"
msgstr "Concept No. 5"

msgid "GB120_Concept_No_5_7x7"
msgstr "Concept No. 5 7x7"

msgid "GB120_Concept_No_5_7x7_descr"
msgstr "ในช่วงหลังสงครามโลก การพัฒนายานเกราะล้อหนักก็ยังคงดำเนินอยู่ในอังกฤษ หนึ่งในโครงการที่โดดเด่นคือการออกแบบรถถังอนาคต Concept 5 ซึ่งโดยหลักๆแล้วเป็นรถถังที่ใช้ล้อขับเคลื่อน ยานเกราะเช่นนี้ออกแบบมาไว้เฉพาะสำหรับสมรภูมิการรบเฉพาะกิจซึ่งยานเกราะล้อมีความได้เปรียบมากกว่าเช่นทะเลทรายที่มีก้อนหินกระจัดกระจายเป็นจำนวนมาก ยานเกราะเหล่านี้ใช้ปืน 105 มม.ทำให้สามารถต่อสู้กับรถถังกลางของยุคนั้นได้ โครงการไม่ได้พัฒนาพ้นช่วงการออกแบบแนวคิดเนื่องจากทางกลาโหมต้องการพัฒนารถถังรบหลักและยานเกราะตีนตะขาบมากกว่า"

msgid "GB120_Concept_No_5_7x7_short"
msgstr "Concept 5 7x7"

msgid "GB120_Concept_No_5_descr"
msgstr "ในช่วงหลังสงครามโลก การพัฒนายานเกราะล้อหนักก็ยังคงดำเนินอยู่ในอังกฤษ หนึ่งในโครงการที่โดดเด่นคือการออกแบบรถถังอนาคต Concept 5 ซึ่งโดยหลักๆแล้วเป็นรถถังที่ใช้ล้อขับเคลื่อน ยานเกราะเช่นนี้ออกแบบมาไว้เฉพาะสำหรับสมรภูมิการรบเฉพาะกิจซึ่งยานเกราะล้อมีความได้เปรียบมากกว่าเช่นทะเลทรายที่มีก้อนหินกระจัดกระจายเป็นจำนวนมาก ยานเกราะเหล่านี้ใช้ปืน 105 มม.ทำให้สามารถต่อสู้กับรถถังกลางของยุคนั้นได้ โครงการไม่ได้พัฒนาพ้นช่วงการออกแบบแนวคิดเนื่องจากทางกลาโหมต้องการพัฒนารถถังรบหลักและยานเกราะตีนตะขาบมากกว่า"

msgid "GB120_Concept_No_5_short"
msgstr "Concept 5"

msgid "GB121_GSOR_1010_FB"
msgstr "GSOR 1010 FB"

msgid "GB121_GSOR_1010_FB_descr"
msgstr "ในเดือนธันวาคม 1961 G.S.O.R. (คณะกรรมาธิการข้อกำหนดปฏิบัติการ) 1010 สำหรับยานเกราะลาดตระเวนหุ้มเกราะล้อได้ผ่านการอนุมัติ การพัฒนาแรกมีการเสนอในเดือนมกราคม 1963 นี่เป็นยานเกราะรบสามนายที่มีน้ำหนักเกือบ 14.5 ตัน ต่อมาก็มีโครงการตัวเลือก มันมีน้ำหนักที่มากกว่าและมีอาวุธทรงพลังกว่ากับเกราะป้องกันที่ดีกว่า\nในด้านคุณลักษณะแล้ว GSOR 1010 FB นั้นถือว่าอยู่ระหว่างรถถังเบาและรถถังกลาง ยานเกราะนี้ถือว่าเหมาะสำหรับการปฏิบัติการรบในภูมิประเทศทะเลทราย นีี่เป็นเหตุผลหลักที่ทำไมการพัฒนาไม่ได้ผ่านขั้นขึ้นแบบร่าง ทางกองทัพบกจำเป็นต้องใช้รถถังลาดตระเวนจำนวนสองคันที่สามารถลำเลียงทางอากาศได้ GSOR 1010 FB นั้นถูกยกเลิกแม้ว่าจะมีรถถังล้อเต็มรูปแบบได้ปรากฎขึ้นในการออกแบบของกองทัพอังกฤษมากกว่าหนึ่งครั้ง"

msgid "GB121_GSOR_1010_FB_long_special"
msgstr "รถถังกลางติดล้อของอังกฤษ รถถังติดตั้งปืนที่ดีและมีความเสียหายต่อนัดและค่าการกระจายกระสุนที่ยอดเยี่ยมรวมไปถึงระยะการมองเห็นที่ดีและความคล่องตัวที่ใช้ได้ ในบางสถานการณ์การรบมันสามารถปฏิบัติการเป็นหน่วยสอดแนมได้"

msgid "GB121_GSOR_1010_FB_short"
msgstr "GSOR 1010"

msgid "GB121_GSOR_1010_FB_short_special"
msgstr "ความคล่องตัวที่ดีและการกระจายกระสุนที่ต่ำ"

msgid "GB122_Staghound_Mk_III"
msgstr "Staghound Mk. III"

msgid "GB122_Staghound_Mk_III_descr"
msgstr "ยานเกราะคันนี้พัฒนาขึ้นในสหรัฐฯช่วงปี 1941-1942 และผลิตโดยบริษัท General Motors ตั้งแต่เดือนตุลาคม 1942 ถึงธันวาคม 1943 มียอดการผลิตยานเกราะนี้ 2,844 คัน ยานเกราะเข้าประจำการเฉพาะในกองทัพบกอังกฤษและกองทัพอาณานิคมอังกฤษและไม่ได้ถูกใช้โดยกองทัพบกสหรัฐฯ มีร่นดัดแปลงที่แตกต่างกันสำหรับการปฏิบัติกงานที่ต่างกันไป ในปี 1944 มีการพัฒนา Staghound Mk. III ซึ่งกลายเป็นยานเกราะใช้ล้อที่มีเกราะหนาที่สุดในสงครามโลกครั้งที่สอง ยานเกราะล้อเหล่านี้ถูกใช้ในการรบโดยหน่วยรบของกองทัพแคนาดา หลังสงครามมีการส่ง Staghound Mk. III 14 คันไปยังที่เดนมาร์ก อีกทั้งยังมีการนำยานเกราะรุ่นนี้มาประจำการในกองทัพของเลบานอนอีกด้วย"

msgid "GB122_Staghound_Mk_III_short"
msgstr "Staghound"

msgid "GB123_GSOR_1006_v7"
msgstr "GSOR 1006 Scheme 7"

msgid "GB123_GSOR_1006_v7_descr"
msgstr "โครงการนี้ถูกพัฒนาโดยโรงเรียนวิทยาการรถถังอังกฤษ (School of Tank Technology-STT) ในปี 1961 เป็นพาหนะมีน้ำหนักเบาและอำนาจการยิงสูงสุดที่มุ่งเป้าหมายภารกิจเป็นการลาดตระเวนและสนับสนุน ในโครงการ GSOR 1006 มีการออกแบบขึ้นกว่าสิบแบบด้วยกันทั้งในแบบตีนตะขาบและแบบล้อ หนึ่งในการออกแบบนี้คือ GSOR 1006 Scheme 7 โครงการนี้มีอยู่ในแบบพิมพ์เขียวเท่านั้นแต่ต่อมาก็นำไปสู่การสร้าง GSOR 1010 และเป็นรากฐานให้กับการพัฒนาอื่นๆต่อและนำไปสู่การกำเนิดของสายยานเกราะรบลาดตระเวนตีนตะขาบ"

msgid "GB123_GSOR_1006_v7_short"
msgstr "GSOR 1006/7"

msgid "GB124_AEC_Armoured_Car"
msgstr "AEC Armoured Car"

msgid "GB124_AEC_Armoured_Car_descr"
msgstr "ยานเกราะล้อพัฒนาขึ้นโดยมีรากฐานจากรถบรรทุก AEC Matador 0853 ซึ่งกลายเป็นรถหุ้มเกราะที่หนักที่สุดของอังกฤษที่มีการผลิตเป็นจำนวนมาก ตั้งแต่ปี 1941 ถึง 1943 มียอดการผลิตทั้งหมด 629 คันในรุ่นดัดแปลงที่แตกต่างกัน\nรถหุ้มเกราะ AEC นั้นประจำการในกองทัพจนถึงปี 1977 ด้วยน้ำหนักทำการรบ, ความหนาของเกราะและอาวุธที่ถือว่าทรงพลังนั้นสามารถกล่าวได้ว่ารถหุ้มเกราะคันนี้คือรถถังแบบใช้ล้อ"

msgid "GB124_AEC_Armoured_Car_short"
msgstr "AEC"

msgid "GB125_Saladin"
msgstr "FV601 Saladin"

msgid "GB125_Saladin_descr"
msgstr "ยานเกราะล้อ FV601 Saladin นั้นออกแบบโดยบริษัท Alvis Car and Engineering ซึ่งถูกมุ่งหมายให้มาแทนที่รถหุ้มเกราะ AEC การพัฒนานั้นเริ่มขึ้นในปี 1946 แต่ช่วงดำเนินการจริงนั้นไม่ได้เริ่มจนกระทั่งช่วงต้นทศวรรษ 1950 รถหุ้มเกราะคันนี้มีจุดเด่นจากการมีตัวถังใช้ล้อแบบ 6x6 และใช้ช่วงล่างแบบมีเท้าช้าง รถต้นแบบสองคันแรกของ FV 601 (B) นั้นถูกผลิตขึ้นในปี 1955 สองปีต่อมาก็มีการผลิตรถหุ้มเกราะนำร่องขึ้นมาทั้งหมด 6 คันและในปี 1958 ก็ได้เริ่มทำการผลิตจำนวนมาก รถหุ้มเกราะรุ่นนี้มีการผลิตจนถึงปี 1972 โดยจำนวนที่มากที่สุดเป็นรุ่นดัดแปลง Saladin Mk. 2 มียอดการผลิตทั้งหมด 1,177 คัน รถหุ้มเกราะคันนี้ถูกใช้อย่างแพร่หลายในตะวันออกกลางและแอฟริกา"

msgid "GB125_Saladin_short"
msgstr "Saladin"

msgid "GB126_FSV_Scheme_A"
msgstr "FSV Scheme A"

msgid "GB126_FSV_Scheme_A_descr"
msgstr "ในเดือนธันวาคม 1961 ได้มีการตัดสินใจที่จะรวมข้อกำหนดสมรรถนะของ GSOR 1106 และ 1010 เข้าด้วยกันและสร้างตัวถังพื้นฐานที่สามารถใช้เป็นแม่แบบสำหรับสายยานเกราะรบทั้งสายได้ สองปีต่อมาก็มีการกำหนดคุณลักษณะของ GSOR 3301 ขึ้นซึ่งประกอบด้วยรุ่นดัดแปลงใช้ล้ออเนกประสงค์ มีการวางแผนประกอบรถหุ้มเกราะเอาไว้ห้ารุ่นโดยรุ่นที่เป็นยานเกราะติดตั้งปืนใหญ่ถูกตั้งให้มีความสำคัญสูง อย่างไรก็ตามรุ่นยานเกราะ 6 ล้อของ GSOR 3301 ซึ่งมีระบบขับเคลื่อนหกล้อนั้นมีขนาดที่ใหญ่และหนักกว่าที่ได้วางแผนเอาไว้ซึ่งทำให้โครงการถูกหยุดพัฒนาในที่สุด"

msgid "GB126_FSV_Scheme_A_short"
msgstr "FSV Sch. A"

msgid "GB127_A7E3"
msgstr "A7E3"

msgid "GB127_A7E3_descr"
msgstr "รถต้นแบบออกแบบในอังกฤษช่วงปี 1934 และกลายเป็นว่ารถถังคันนี้ก้าวหน้ารุ่นก่อนๆและทำการทดสอบอย่างเบ็ดเสร็จจำนวนมากจนถึงปี 1937 รถถังไม่ได้ถูกนำเข้าประจำการแต่ชิ้นส่วนของมันถูกใช้ในการประกอบรถถังคันอื่นๆ"

msgid "GB127_A7E3_long_special"
msgstr "รถต้นแบบที่ชิ้นส่วนถูกใช้ในการผลิตรถถังคันอื่นๆ A7E3 นั้นเป็นรถถังที่ว่องไวมีกำลังขับจำเพาะต่อน้ำหนักที่ดี ตัวรถถังติดตั้งปืน 40 มม. (2 pdr Gun Mk.IX) ซึ่งทำความเสียหายต่อนัดและเจาะเกราะได้ดีพอตัว ข้อด้อยของรถถังนั้นคือตัวถังที่ใหญ่และเกราะที่บาง"

msgid "GB127_A7E3_short"
msgstr "A7E3"

msgid "GB127_A7E3_short_special"
msgstr "ปืนที่แม่นยำและความคล่องตัวที่ดี"

msgid "GB128_Nemesis"
msgstr "Nemesis"

msgid "GB128_Nemesis_descr"
msgstr "ในทศวรรษ 1960 เหล่าวิศวกรอังกฤษได้ทำการพัฒนารถถังที่คล่องตัวในความร่วมมือกับบริษัทของเยอรมันและสหรัฐฯ ทำให้มีการใช้ส่วนประกอบจากนอกประเทศในการประกอบรถถังเช่น เครื่องยนต์, ระบบช่วงล่างและองค์ประกอบอื่นๆ ในขณะเดียวกันก็ยังมีการนำแนวคิดและองค์ประกอบของรถถัง Chieftain มาใช้ด้วย รถถังนี้ถูกมุ่งหมายให้ติดตั้งปืนขนาด 110 มม.และปืนคู่อัตโนมัติขนาด 25 มม. รถถังได้รับชื่อเรียกขานเป็น Nemesis เมื่อเทียบกับรถถัง Chieftain ที่หนักกว่าแล้ว รถถังคันนี้ถูกมุ่งหมายให้ทำความเร็วได้สู.กว่าและมีความคล้ายคลึงกับโครงการของเยอรมันในช่วงปลายทศวรรษ 1960 ถึง 1970 โครงการ Nemesis นั้นมีอยู่ในแบบพิมพ์เขียวและแบบจำลองย่อส่วนเพียงหนึ่งคัน"

msgid "GB128_Nemesis_long_special"
msgstr "รถถังกลางที่มีความคล่องตัวดีและเกราะป้อมปืนที่สมบูรณ์แบบ มีการติดตั้งปืน 110 มม.รุ่นทดลองที่ทำความเสียหายได้อย่างน่าประทับใจ การจัดวางส่วนประกอบที่ไม่ปกติจากยานเกราะอังกฤษคันอื่นรวมกับปืนที่เป็นเอกลักษณ์ทำให้มีผลกระทบกับเวลาการบรรจุกระสุนและประสิทธิภาพโดยรวมของปืนซึ่งเป็นเหตุที่ทำให้ยานเกราะมีรูปทรงที่ใหญ่"

msgid "GB128_Nemesis_short"
msgstr "Nemesis"

msgid "GB128_Nemesis_short_special"
msgstr "ปืนที่โดดเด่นและความคล่องตัวดี"

msgid "GB12_Conqueror"
msgstr "Conqueror"

msgid "GB12_Conqueror_FL"
msgstr "Conqueror FL"

msgid "GB12_Conqueror_FL_short"
msgstr "Conqueror FL"

msgid "GB12_Conqueror_descr"
msgstr "พัฒนาขึ้นในปี 1949 ถึง 1952 รถถังรุ่นนี้ผู้ออกแบบตั้งใจออกแบบให้มาเผชิญหน้ารถถังหนักของโซเวียต มีจำนวนรถถัง 185 คันที่ถูกผลิตในช่วงปี 1955 ถึง 1959"

msgid "GB12_Conqueror_short"
msgstr "Conqueror"

msgid "GB130_FV225_Collector"
msgstr "FV225 Collector"

msgid "GB130_FV225_Collector_descr"
msgstr "โครงการรถถังหนักอังกฤษที่มีปืนคู่มีระบบยิงแบบเลือกได้ แนวคิดของรถถังนี้เป็นการตอบสนองการพัฒนารถถังหนัก T-10 ของสหภาพโซเวียต การออกแบบนี้กำหนดให้เพิ่มพลรถถังเป็นห้าคนและเสริมเกราะให้มากขึ้น อย่างไรก็ตาม นี่หมายถึงการเพิ่มน้ำหนักรบของรถถังอย่างมากและทำให้การพัฒนารถถังหยุดลงในเวลาต่อมาไม่นาน"

msgid "GB130_FV225_Collector_long_special"
msgstr "FV225 Collector เป็นรถถังหนักอังกฤษระดับ IX ที่มีความเสียหายต่อนาทีที่ยอดเยี่ยมจากการมีปืนคู่ 110 มม.และกลไกรูปแบบการยิงเลือกได้ รถถังคันนี้ออกแบบมาให้เป็นรถถังหนักบุกทะลวงทำให้มีความคล่องตัวและเกราะหน้าที่ดีแต่มีเกราะข้างที่บางกว่า"

msgid "GB130_FV225_Collector_short"
msgstr "Collector"

msgid "GB130_FV225_Collector_short_special"
msgstr "รูปแบบการยิงเลือกได้, เกราะหน้าที่ดี"

msgid "GB131_Crusher"
msgstr "Crusher"

msgid "GB131_Crusher_descr"
msgstr "ยานเกราะคันนี้มีแนวคิดที่ใกล้เคียงกับรถถังจู่โจม หนึ่งในแนวคิดที่รวมเข้าในโครงการ Crusher คือการลดน้ำหนักด้วยการลดความยาวตัวถัง การย้ายระบบช่วงล่างและล้อรับส่วนหน้าไปด้านหน้าของตัวรถทำให้สามารถลดความยาวตัวถังและทำให้เกราะดีขึ้น อีกคุณลักษณะหนึ่งคือการวางพลรถถังในป้อมปืน ซึ่งนี่ทำให้ลดความยาวตัวถังได้มากขึ้นแต่ก็มีผลกับทัศนวิสัยในรถ อย่างไรก็ตาม เมื่อถึงเวลานั้น รถถังสนับสนุนทหารราบก็ถือว่าไม่มีประโยชน์อีกต่อไป การพัฒนาก็ถูกหยุดในช่วงการออกแบบและมีการสร้างรถต้นแบบจากไม้ขึ้นมาเพียงแค่คันเดียว"

msgid "GB131_Crusher_long_special"
msgstr "Crusher เป็นรถถังหนักอังกฤษที่เน้นเกราะและอาวุธเหนือกว่าสิ่งใด การออกแบบที่เป็นเอกลักษณ์และการเปลี่ยนแปลงของการจัดวางภายในทำให้มีน้ำหนักและขนาดทีี่เพิ่มขึ้นและทำให้มีปัญหากับความคล่องตัวอย่างมาก อย่างไรก็ตาม ส่วนผสมของรถถังที่มีปืน 55 Pdr ยิงเร็วและแผ่นเกราะที่หนาทำให้รถถังเป็นคู่ต่อสู้ที่ีข้าศึกต้องระวัง"

msgid "GB131_Crusher_short"
msgstr "Crusher"

msgid "GB131_Crusher_short_special"
msgstr "ปืนยิงเร็ว เกราะหนา"

msgid "GB132_Taurus_CAT"
msgstr "Taurus CAT"

msgid "GB132_Taurus_CAT_desc"
msgstr "โครงการรถถังที่น่าสนใจพัฒนาขึ้นโดยกองทัพน้อยยานเกราะอังกฤษในปี 1968 ที่มีรหัสเรียกขานเป็น COMBAT ARM TANK มีการกำหนดลำดับความสำคัญการพัฒนารถถังดังนี้: อำนาจการยิง, ความคล่องตัว, การป้องกันและพลรถถังให้น้อยที่ทสุด รถถังนี้น่าจะถูกใช้โดยกองทัพน้อยยานเกราะและเหล่าทหารราบ แต่อย่างไรก็ตาม เนื่องจากการเปลี่ยนแผนการพัฒนของกองทัพบกอังกฤษทำให้ไม่จำเป็นต้องใช้รถถังนี้อีกต่อไปและทำให้โครงการถูกยกเลิก"

msgid "GB132_Taurus_CAT_long_special"
msgstr "Taurus CAT เป็นยานพิฆาตรถถังอังกฤษระดับ VIII นี่เป็นยานเกราะอังกฤษคันแรกที่มีระบบช่วงล่างไฮโดรนิวมาติค อีกทั้งยังเป็นยานเกราะคันแรกของอังกฤษที่ใช้ระบบป้อนกระสุนอัตโนมัติแทนที่ปืนป้อนกระสุนปกติ ยานเกราะคันนี้มีความรวดเร็วและว่องไวและเมื่อรวมกับระบบป้อนกระสุนที่เร็วก็จะทำให้คุณทำการรบเชิงรุกได้อย่างรวดเร็วมากขึ้น"

msgid "GB132_Taurus_CAT_short"
msgstr "Taurus CAT"

msgid "GB132_Taurus_CAT_short_special"
msgstr "ระบบป้อนกระสุนอัตโนมัติ, ระบบช่วงล่างไฮโดรนิวมาติค"

msgid "GB133_Charioteer_MkVII"
msgstr "Charioteer Nomad"

msgid "GB133_Charioteer_MkVII_descr"
msgstr "รุ่นยกระดับของรถถัง Cromwell ที่มีป้อมปืนใหม่และปืนที่ทำให้รถถังแตกต่างจากรุ่นพื้นฐาน ปืนที่ทรงพลังนี้ทำให้ยานเกราะที่ล้าสมัยกลับมามีประสิทธิภาพอีกคร้งและกลายเป็นคู่ต่อสู้ที่น่ากลัว ตามแหล่งข้อมูลต่างๆนั้น มีรถถัง Cromwell จำนวน 200 ถึง 442 คันที่ได้ถูกแปลงตามมาตรฐาน Charioteer ใหม่"

msgid "GB133_Charioteer_MkVII_long_special"
msgstr "รุ่นดัดแปลงของรถถัง Cromwell ชื่อดังที่มีป้อมปืนและปืนทีี่ทันสมัย รถถังคันนี้มีคุณลักษณะความคล่องตัวที่ยอดเยี่ยมอีกทั้งยังมีอำนาจการยิงที่น่าประทับใจสำหรับยานเกราะขนาดเล็ก มันสามารถออกรบในฐานะยานพิฆาตรถถังสนับสนุนปกติหรือบุกทะลวงแนวป้องกันข้าศึกพร้อมกันกับรถถังกลางพันธมิตร"

msgid "GB133_Charioteer_MkVII_short"
msgstr "Nomad"

msgid "GB133_Charioteer_MkVII_short_special"
msgstr "ปืนที่ดีและเจาะเกราะได้มาก"

msgid "GB134_Gryphon"
msgstr "Gryphon"

msgid "GB134_Gryphon_descr"
msgstr "เมื่อการพัฒนารถถัง Chieftain มีความก้าวหน้า ก็มีการหารือการจัดการผลิตยานเกราะชั้นคล้ายกันนอกประเทศอังกฤษโดยใช้ตัวถังของรถต้นแบบแรก โครงการนี้พัฒนาขึ้นโดยใช้ป้อมปืนของแนวคิดรถถัง Concept 1B ของสหรัฐฯ ยานเกราะคันนี้ได้รับรหัสเรียกขานว่า Gryphon นอกเหนือจากป้อมปืนแล้วก็มีการวางแผนใช้ชิ้นส่วนอื่นๆของสหรัฐฯ อุปกรณ์ภายในนั้นยังคงกำหนดให้เป็นของอังกฤษ โดยแรกเริ่มนั้นการออกแบบได้รวมความเป็นไปได้ที่ติดตั้งทั้งปืนใหญ่ของทั้งอังกฤษหรือสหรัฐฯโดยขึ้นกับว่าทำการผลิตจากประเทศใด โครงการนี้ถูกหยุดลงเพื่อหลีกทางให้กับชนิดยานเกราะที่ได้รับความสนใจมากกว่า"

msgid "GB134_Gryphon_long_special"
msgstr "Gryphon เป็นรถถังหนักอังกฤษระดับ X ที่มีระบบเติมกระสุนกลับหลังสองนัด ระบบนี้ทำให้กระสุนอีกนัดเกือบพร้อมยิงเสมอและทำให้ยิงต่อเนื่องได้ในช่วงเริ่มการรบ รถถังคันนี้มีความคล่องตัวที่ดี, ป้อมปืนที่ทนทานและมุมกดปืนที่ยอดเยี่ยมแต่เกราะตัวถังที่ปานกลาง"

msgid "GB134_Gryphon_short"
msgstr "Gryphon"

msgid "GB134_Gryphon_short_special"
msgstr "ระบบเติมกระสุนกลับหลัง, เกราะป้อมปืนที่ไว้ใจได้"

msgid "GB136_Churchill_BPXIV"
msgstr "Churchill Crocodile"

msgid "GB136_Churchill_BPXIV_descr"
msgstr "ถ้าพูดตรงๆแล้วผมเองแทบไม่รู้อะไรเกี่ยวกับฝรั่งเศสก่อนสงครามเลย เมืองแมนเชสเตอร์นั้นใกล้กับไอร์แลนด์มากกว่าฝรั่งเศส แต่พ่อผมก็เคยไปออกรบที่เบลเยียมแม้ว่าตัวเขาเองก็ไม่ได้พูดถึงมันบ่อยนัก มันแปลกดีที่เราเคยเรียกมันว่ามหาสงคราม สงครามเดียวราวกับว่าจะไม่มีความเป็นไปได้ว่าจะเกิดสงครามแบบเดียวกันขึ้นอีก บางทีมันอาจจะเป็นแนวคิดที่อ่อนต่อโลก ประวัติศาสตร์ของมนุษย์นั้นเป็นประวัติศาสตร์ของสงคราม และเราก็รู้เมื่อถึงเวลา เมื่อถึงยามสงคราม ผมเองก็มีบทบาทที่ต้องรับ ชาติ, กษัตริย์, หน้าที, เกียรติยศ นั่นคือสิ่งที่ผมโตมาและนั่นคือสิ่งที่ผมถูกสอนให้ทำการปกป้องไม่ว่าจะต้องแลกด้วยอะไรก็ตาม"

msgid "GB136_Churchill_BPXIV_long_special"
msgstr "หนึ่งในพาหนะที่เข้าร่วมการยกพลขึ้นบกที่นอร์มังดีในช่วงสงครามโลกครั้งที่สอง ยานเกราะนี้ถือว่าไม่ค่อยพบในสนามรบนักเนื่องด้วยน้ำหนักและขนาดของมัน รุ่นมาตรฐานของรถถัง Churchill นั้นมีปัญหาเกี่ยวข้องกับน้ำและฝาปิดข้าง อย่างไรก็ตาม รถถังหนักเหล่านี้ก็ได้เข้าร่วมปฏิบัติการโอเวอร์ลอร์ดและได้จารึกผลงานของมันเอาไว้ในประวัติศาสตร์"

msgid "GB136_Churchill_BPXIV_short"
msgstr "Crocodile"

msgid "GB136_Churchill_BPXIV_short_special"
msgstr "ความเสียหายต่อนาทีที่ดี ปืนที่แม่นยำ"

msgid "GB137_Cromwell_Applique"
msgstr "Cromwell Applique"

msgid "GB137_Cromwell_Applique_desc"
msgstr "รุ่นดัดแปลงของรถถัง Cromwell ที่ใช้เกราะเว้นระยะโดยใช้ชื่อว่า Cromwell Applique รถถังพัฒนาขึ้นโดยบริษัท Rolls Royce ในปี 1943 เพื่อตอบสนองกับประสิทธิภาพที่สูงขึ้นของยานพิฆาตรถถังและยานเกราะของกองทัพบกเยอรมัน มีแผงเกราะเชื่อมเข้าตัวถังและป้อมปืนทำให้เกราะส่วนหน้าเพิ่มขึ้นถึง 101 มม.แต่ก็เพิ่มน้ำหนักของรถถังขึ้นถึง 29 ตัน แผงเกราะเหล่านี้ผลิตโดยบริษัท Sheffield Steel ได้เข้าทดสอบการยิงในวันที่ 21 มิถุนายน 1943 การยิงนั้นแสดงให้เห็นว่ามีรอยแตกที่ขอบแผงทำให้ต้องมีการเสริมความแข็งของรอยต่อการเชื่อม ต่อมารถถังรุ่น 31 ตันต้องแล่น 174 ไมล์บนถนนและ 110 ไมล์บนพื้นดินกันดาร ระบบช่วงล่างผ่านช่วงการเดินทางได้แต่สองล้อขับเสื่อมสภาพอย่างมาก ระบบเบรกจำเป็นต้องทำการปรับปรุงให้ดีขึ้น ส่วนเกราะเว้นระยะก็ได้รับการอนุมัติสำหรับการผลิตจำนวนมากสำหรับรถถัง Cromwell อย่างไรก็ตาม มีการผลิตรถถังรุ่นนี้ขึ้นเพียง 200 คันและถือว่าช้าเกินไปสำหรับสงครามและในที่สุดก็ทำให้รถถัง Cromwell ถูกแทนที่ด้วยรถถัง Comet ที่ซับซ้อนกว่า"

msgid "GB137_Cromwell_Applique_long_special"
msgstr "Cromwell Appliqué เป็นรถถังกลางอังกฤษระดับ V Cromwell รุ่นนี้มีแผ่นเกราะเสริมที่ด้านหน้า การป้องกันเพิ่มขึ้นอาจจะเสริมความสามารถอยู่รอดของรถถังแต่ก็ทำให้น้ำหนักสูงขึ้นด้วยแต่ตัวรถถังก็ยังคงมีความคล่องตัวที่สูง รถถังยังใช้ปืนยิงเร็วของอังกฤษที่คุ้นเคย"

msgid "GB137_Cromwell_Applique_short"
msgstr "Cromwell A"

msgid "GB137_Cromwell_Applique_short_special"
msgstr "เกราะกับความคล่องตัวดีกับอัตราการยิงที่สูง"

msgid "GB139_FV226_Contradictious"
msgstr "FV226 Contradictious"

msgid "GB139_FV226_Contradictious_descr"
msgstr "การออกแบบที่ค่อนข้างสมดุลตามแนวอังกฤษที่เน้นอำนาจการยิงและการป้องกัน จุดเด่นหลักของพาหนะคือการพิจารณาอาวุธที่มีเป็นปืน 20 ปอนด์และปืน 105 มม. L7 แบบใหม่ เพื่อให้มีอัตราการยิงที่จำเป็น เหล่านักออกแบบได้วางแผนที่ติดตั้งปืนเอาไว้บนป้อมปืนแบบผงกได้ เนื่องจากตัวปืนติดตั้งเอาไว้ในมุมยกตรึง ก็สามารถใช้อุปกรณ์แบบง่ายที่ช่วยผ่อนแรงพลบรรจุสองคนได้ แม้ว่าข้อกำหนดที่ระบุจะสามารถทำให้เกิดขึ้นได้ ตัวรถถังนั้นถือว่าหนักและมีขนาดใหญ่เกินไปและทำให้โครงการหยุดพัฒนาลง"

msgid "GB139_FV226_Contradictious_long_special"
msgstr "รถถังหนักอังกฤษที่มีรูปแบบการยิงเลือกได้ รถถังคันนี้เป็นหน่วยสารพัดประโยชน์ในการยิงทีละนัดและหน่วยบุกทะลวงหนักในรูปแบบระดมยิง ด้วยเกราะหน้าที่หนาทั้งในส่วนตัวถังและป้อมปืนอีกทั้งมีความคล่องตัวที่ดีทำให้นักรบหลากภารกิจนี้จะมีประโยชน์ในสนามรบอย่างมาก"

msgid "GB139_FV226_Contradictious_short"
msgstr "Contradictious"

msgid "GB139_FV226_Contradictious_short_special"
msgstr "รูปแบบการยิงเลือกได้, เกราะที่ดี"

msgid "GB13_FV215b"
msgstr "FV215b"

msgid "GB13_FV215b_descr"
msgstr "เป็นแผนเสนอการสร้างรถถังหนักโดยใช้ Conqueror Mk II เป็นฐานการออกแบบ ซึ่งแตกต่างจากรุ่นที่ได้รับการผลิตโดยห้องพลรถถังถูกวางไว้ด้านหลังของตัวรถแทน ไม่มีการผลิตรถต้นแบบขึ้นมา"

msgid "GB13_FV215b_long_special"
msgstr "รถถังหนักคันนี้ติดตั้งปืน 120 มม.ที่น่าประทับใจทั้งในการปรับเสถียร ความแม่นยำ และการเจาะเกราะ ทำให้รถถังเป็นภัยร้ายแรงต่อข้าศึก ด้วยความทนทานที่เพียงพอและเกราะป้อมปืนที่ไว้ใจได้ทำให้รถถังสามารถอยู่รอดในการรบยืดเยื้อได้ อย่างไรก็ตาม การวางห้องทำการรบไว้ที่ด้านหลังนั้นจำกัดความสามารถของรถถังในการรบบางสถานการณ์"

msgid "GB13_FV215b_short_special"
msgstr "ปืนที่มีประสิทธิภาพและความทนทานที่สูง"

msgid "GB140_FV224_Chopper"
msgstr "FV224 Chopper"

msgid "GB140_FV224_Chopper_descr"
msgstr "โครงการรถถังหนักรักษาชายฝั่งพัฒนาขึ้นในสหราชอาณาจักรทันทีหลังสงครามโลกครั้งที่สองจบลง ปืนสองกระบอกบนป้อมปืนรวมกับศูนย์เล็งมุมกว้างและกล้องหาระยะที่ติดตั้งเอาไว้น่าจะทำให้รถถังสามารถทำการรบได้เท่าเทียมกับเรือสนับสนุนการยกพลขึ้นบก ส่วนตีนตะขาบหน้ากว้างควรจะทำให้สามารถแล่นข้ามภูมิประเทศได้ดี อย่างไรก็ตาม เนื่องด้วยการมีระบบช่วงล่างที่ซับซ้อนและบำรุงรักษาได้ยาก, ขนาดลำกล้องปืนที่เล็กเกินไปและการไม่มีระบบป้องกันนิวเคลียร์ โครงการนี้ก็ถูกหยุดลง"

msgid "GB140_FV224_Chopper_short"
msgstr "Chopper"

msgid "GB141_GSOR_the_TANK"
msgstr "รถถัง GSOR"

msgid "GB141_GSOR_the_TANK_descr"
msgstr "รุ่นดัดแปลงปรับปรุงให้ทันสมัยใหญ่ของการออกแบบมาตรฐานสำหรับรถถังหนัก Charlemagne ซึ่งพัฒนาขึ้นในช่วงต้นทศวรรษ 1960 ในฐานะส่วนหนึ่งของโครงการ GSOR ของอังกฤษ พาหนะนั้นติดตั้งด้วยป้อมปืนแบบผงกที่วางแผนเอาไว้สำหรับยานพิฆาตรถถัง GSOR 1008 โครงการนี้ไม่ได้พัฒนาพ้นช่วงร่างแบบพิมพ์เขียว"

msgid "GB141_GSOR_the_TANK_long_special"
msgstr "จุดเด่นหลักของรถถัง GSOR คือการเจาะเกราะของกระสุนระเบิดแรงสูงที่มากทำให้มันสามารถทำความเสียหายมากขึ้นต่อข้าศึกเกราะบาง ปืนของมันยังใช้กระสุนปกติที่มีความเร็วปากกระบอกและการเจาะเกราะสูงและด้วยมุมกดปืนที่ยอดเยี่ยมทำให้มันสามารถใช้ภูมิประเทศให้เป็นประโยชน์ได้"

msgid "GB141_GSOR_the_TANK_short"
msgstr "รถถัง GSOR"

msgid "GB141_GSOR_the_TANK_short_special"
msgstr "การเจาะเกราะสูง, กระสุน HESH"

msgid "GB142_FV230_Canopener"
msgstr "FV230 Canopener"

msgid "GB142_FV230_Canopener_CFE_G"
msgstr "Twin Guardians"

msgid "GB142_FV230_Canopener_CFE_G_descr"
msgstr "ขุนศึกฉูเป่าและจิงเต๋อที่ไร้เทียมทานออกรบท่ามกลางไฟแห่งสงคราม จังหวะฝีเท้าของพวกเขากึกก้องไปทั่วแม่น้ำเหลืองในช่วงต้นราชวงศ์ถัง\n\nหลายพันปีต่อมา พวกเขายังคงถูกจารึกในประวัติศาสตร์หลังจากที่จักรพรรดิได้ให้ทำการสลักรูปปั้นของพวกเขาให้ยืนปกป้องเป็นทวารบาลของวังหลวง ครั้งหนึ่งพวกเขาได้เคยค้ำจุนจักรวรรดิที่รุ่งเรือง ตอนนี้พวกเขากลายเป็นองครักษ์ที่คอยทำการขับไล่วิญญาณร้าย ฉูเป่าปกป้องประตูด้วยความสง่างามอย่างมีวินัยส่วนจิงเต๋อนั้นก็ใช้วินัยอันเข้มงวด ด้วยพละกำลังของพวกเขา คุณเองก็อาจจะเอาชนะความมืดได้เช่นกัน"

msgid "GB142_FV230_Canopener_CFE_G_long_special"
msgstr "รถถังหนักสารพัดประโยชน์นี้โดดเด่นจากเกราะอันน่าประทับใจ ความคล่องตัวที่ใช้ได้ทำให้มันเข้าจุดยิงได้ทันเวลาส่วนมุมกดปืนที่ดีทำให้เนินชันทุกแห่งกลายเป็นปราการได้ ปืนที่ไว้ใจได้ทำให้ทำการระดมยิงเข้าเป้าหมายได้ทุกคัน"

msgid "GB142_FV230_Canopener_CFE_G_short"
msgstr "Twin Guardians"

msgid "GB142_FV230_Canopener_CFE_G_short_special"
msgstr "รูปแบบการระดมยิง, เกราะอันน่าเกรงขาม"

msgid "GB142_FV230_Canopener_descr"
msgstr "โครงการรถถังหนักรักษาชายฝั่งพัฒนาขึ้นในสหราชอาณาจักรในช่วงทศวรรษ 1950 ในฐานะส่วนหนึ่งของโครงการป้องกันชายฝั่งจากการยกพลขึ้นบกที่อาจจะเกิดขึ้นได้ อำนาจการยิงที่น่าประทับใจ, การจัดวางเกราะอันยอดเยี่ยมที่มีเกราะตัวถังลาดเอียงอย่างมากและความคล่องตัวที่ใช้ได้ทำให้รถถังเป็นคู่ต่อสู้ที่น่าเกรงขามในการปะทะกับยานลำเลียงพลขึ้นบก ตัวปืนนั้นมีระบบกลไกที่ประกอบด้วยฝาครอบปิดเปิดได้ที่ปลายปากกระบอกเพื่อป้องกันลำกล้องจากความชื้น\nในช่วงการพัฒนารถถังก็เห็นได้ชัดว่าขีปนาวุธต่อต้านเรือนั้นจะเป็นอนาคตของการรบทางทะเลมากกว่าปืนรักษาฝั่ง ซึ่งทำให้โครงการเห็นว่าไม่มีอนาคตและหยุดลงก่อนที่จะมีการสร้างรถต้นแบบขึ้นมา"

msgid "GB142_FV230_Canopener_short"
msgstr "Canopener"

msgid "GB143_FV229_Contender"
msgstr "FV229 Contender"

msgid "GB143_FV229_Contender_descr"
msgstr "รถถังหนักป้องกันชายฝั่งที่พัฒนาในช่วงปลายทศวรรษ 1950 ในฐานะส่วนหนึ่งของโครงการป้องกันชายฝั่ง โดยหลักๆแล้วถูกออกแบบมาสำหรับการป้องกันกองทัพบกโซเวียตอย่างมีประสิทธิภาพซึ่งคาดไว้ว่าจะยกพลข้ามช่องแคบอังกฤษในช่วงสงครามเย็น รถถังนี้มีแผนทำการติดตั้งระบบปืนกระบอกคู่ที่รับประกันว่าจะทำความเสียหายต่อยานลำเลียงพลเบาและยานสะเทิ้นน้ำสะเทิ้นบกรวมไปถึงต่อสู้กับรถถังในพื้นที่ชายฝั่ง เกราะของรถถังนั้นถูกออกแบบไม่เพียงให้ต้านทานกระสุนรถถังแต่ยังสามารถต้านทานกระสุนจากปืนเรือที่ยิงสนับสนุนการยกพลขึ้นบกด้วย โครงการนี้มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB143_FV229_Contender_short"
msgstr "Contender"

msgid "GB145_Crusher_ASE_4"
msgstr "Nergal"

msgid "GB145_Crusher_ASE_4_descr"
msgstr "ยานเกราะนี้มีปรากฎอยู่ในเอกสารของศูนย์บาบิลอนในชื่อย่อว่า NrGLL-8 และเชื่อว่าสูญหายระหว่างการทดลองเดินทางเข้าห้วงลึกของ Mirium อย่างไรก็ตาม รถถังคันนี้ก็ถูกกู้กลับมาได้พร้อมกับเหล่าพลรถถังและตอนนี้ก็ได้รับชื่อว่าเนอร์กอลเพื่อเป็นเกียรติให้กับเทพประจำปรโลกของบาบิโลน ยานเกราะคันนี้เต็มไปด้วยภาพวาดและคำจารึกที่เป็นเรื่องราวของเนอร์กัลและการเดินทางของเขาไปยังเอียคัลลาที่เป็นแดนของคนตาย หนึ่งในสมาชิกพลรถถังได้วาดภาพดังกล่าวระหว่างที่อยู่ในห้วงมิติลึกหลังจากที่ได้รับอิทธิพลของ Mirium แล้วรู้ตัวว่าพวกเขาจะไม่ได้กลับมา\nหลังจากปฏิบัติการหอคอยมืดสำเร็จ รถถังและอุปกรณ์จากศูนย์ก็ถูกส่งไปยังคณะกรรมการทหารซึ่งเข้ารับช่วงการจัดการพัฒนาต่อ หลังจากที่รถถังได้เจอกับ Mirium และผลของมันกับสภาวะจิต เหล่าพลรถถังของเนอร์กอลก็ได้ขอทำการรักษาตัว ยังไงก็ตาม หลังจากที่การรักษาตัวเสร็จสิ้น พวกเขาก็ได้ขอกลับมาปฏิบัติหน้าที่ในรถถังคันเดิม ทางหน่วยเหนือก็ได้อนุมัติคำขอดังกล่าว..."

msgid "GB145_Crusher_ASE_4_long_special"
msgstr "Nergal เป็นรถถังหนักอังกฤษที่เน้นเกราะและอาวุธเหนือสิ่งอื่นใด การออกแบบที่เป็นเอกลักษณ์และการเปลี่ยนแปลงการจัดวางภายในทำให้มีน้ำหนักและความสูงที่เพิ่มขึ้นทำให้มีปัญหากับความคล่องตัวอย่างมาก แต่ส่ววนผสมของปืน 55 pdr กับแผ่นเกราะหนาก็ทำให้เป็นคู่ต่อสู้ที่น่าเกรงขามอย่างยิ่ง"

msgid "GB145_Crusher_ASE_4_short"
msgstr "Nergal"

msgid "GB145_Crusher_ASE_4_short_special"
msgstr "ปืนยิงเร็ว เกราะหนา"

msgid "GB146_Gabler_s_Destroyer"
msgstr "Gabler’s Destroyer"

msgid "GB146_Gabler_s_Destroyer_descr"
msgstr "โครงการรถถังเบาที่มีเกราะหน้าเทียบเท่ากับรถถังกลาง มีการวางแผนที่จะประกอบตัวถังเชื่อมจากแผ่นเกราะม้วน ส่วนป้อมปืนนั้นจะถูกหล่อขึ้นมา ในด้านอาวุธ ก็น่าจะมีการติดตั้งปืน 57 มม.หรือ 75 มม.หนึ่งกระบอกและปืนกล 7.92 มม.สามกระบอก ยอดป้อมปืนนั้นน่าจะติดตั้งแท่นปล่อยจรวดสองท่อ\nเครื่องยนต์อันทรงพลังนั้นมีเพื่อให้รถถังมีความคล่องตัวอันยอดเยี่ยมบนถนนและในพื้นที่กันดาร ในขณะที่ระบบช่วงล่างนั้นออกแบบให้มีความนุ่มนวลอย่างมาก แม้ว่าความคล่องตัวกับศักยภาพป้องกันตัวที่น่าประทับใจในยุคนั้น ความยากในการผลิตและราคาที่สูงทำให้โครงการนี้ไม่ได้เข้าสู่สายการผลิต"

msgid "GB146_Gabler_s_Destroyer_long_special"
msgstr "Gabler's Destroyer เป็นรถถังเบามีระบบป้อนโม่กระสุนที่เป็นเอกลักษณ์ในระดับของมัน เวลาบรรจุที่เร็วและความเสียหายต่อนัดที่ดีทำให้มันมีประสิทธิภาพในการรบกับพาหนะระดับ V คันอื่นๆ ส่วนความคล่องตัวที่สูงของมันยังทำให้มันเป็นยานลาดตระเวนที่ยอดเยี่ยมอีกด้วย โดยมากมันมักจะเหมาะกับการเป็นหน่วยสนับสนุนโดยการใช้ยุทธวิธีตีฉาบฉวยและชิงจังหวะจากข้าศึก"

msgid "GB146_Gabler_s_Destroyer_short"
msgstr "G. Destroyer"

msgid "GB146_Gabler_s_Destroyer_short_special"
msgstr "ระบบป้อนโม่กระสุนกับความคล่องตัวยอดเยี่ยม"

msgid "GB147_FV4025_Contriver"
msgstr "FV4025 Contriver"

msgid "GB147_FV4025_Contriver_descr"
msgstr "ในช่วงปลายทศวรรษ 1950 ถึงต้น 1960 ทางอังกฤษพยายามอย่างมากเพื่อพัฒนารถถังป้องกันชายฝั่งสองกระบอก ในระหว่างดำเนินการ ก็เห็นชัดว่าเนื่องจากรถถังเหล่านี้จะมีน้ำหนักมากทำให้มีแรงกดพื้นผิวสูงตามและจำเป็นที่จะต้องลดค่าดังกล่าวอย่างมากทำให้เกิดแนวคิดการสร้างรถถังสี่ตืนตะขาบขึ้น มีการใช้ข้อมูลข่าวกรองของรถถัง Object 279 จากสหภาพโซเวียตในการพัฒนายานเกราะนี้ แต่แนวการออกแบบก็ต่างออกไป ตีนตะขาบภายนอกถูกทำให้เบากว่าอันภายในและระบบช่วงล่างก็ถูกเปลี่ยนมาใช้ของอังกฤษที่มีสปริงขดแนวตั้ง ส่วนตัวถังทั้งหมดถูกติดตั้งเอาไว้บนโครงเหล็กรางน้ำลงหมุด อย่างไรก็ตาม การประกอบนั้นซับซ้อนเกินไปทำให้โครงการหยุดลงก่อนที่จะมีการพัฒนาต่อ"

msgid "GB147_FV4025_Contriver_long_special"
msgstr "FV4025 Contriver นั้นเป็นรถถังหนักที่สมดุลดีและไม่มีจุดอ่อนที่ชัดเจนสามารถรับมือกับสถานการณ์ใดๆก็ได้ในสนามรบไม่ว่าจะเป็นการยิงจากที่กำบังพร้อมกับรถถังหนักคันอื่นถึงการตั้งแนวป้องกันต้านทานข้าศึกที่กำลังรุกคืบเข้ามา ระบบปืนคู่ของมันยังเพิ่มความอเนกประสงค์ให้อีกขั้นไม่ว่าจะเป็นการส่งกระสุนที่แม่นยำหรือการยิงถล่มอันหนักหน่วงตามที่จำเป็น"

msgid "GB147_FV4025_Contriver_short"
msgstr "Contriver"

msgid "GB148_FV227_Conceiver"
msgstr "FV227 Conceiver"

msgid "GB148_FV227_Conceiver_descr"
msgstr "โครงการของรถถัง FV227 Conceiver นั้นพัฒนาขึ้นตามแนวคิดรถถังจู่โจมที่เน้นการต้านทานยานเกราะข้าศึกมากกว่าการเข้าตีฐานที่มั่น ภารกิจหลักของรถถังคือการเสริมกำลังให้กับรถถังหลากภารกิจ Centurion ในการรบ มีการวางแผนติดตั้ง FV227 ด้วยปืนลำกล้องใหญ่สองกระบอกเอาไว้ ปืนเหล่านี้่สามารถยิงสลับกันหรือยิงพร้อมกันก็ได้ กล่าวได้ว่าประเทศพัฒนาเกือบทุกประเทศบนโลกมีความพยายามที่จะพัฒนารถถังที่มีระบบปืนสองลำกล้องแต่ก็ไม่มีโครงการใดเหล่านี้ได้ทำการผลิตขึ้นจริง"

msgid "GB148_FV227_Conceiver_short"
msgstr "Conceiver"

msgid "GB149_Centurion_MkI_A"
msgstr "Centurion St. Gloriana"

msgid "GB149_Centurion_MkI_A_descr"
msgstr "รถต้นแบบของ Centurion Mk. I ที่บัญชาการโดย Alice Mashida ที่มีพรสวรรค์ Alice นั้นมาจากตระกูลยอดฝีมือวิถีแห่งรถถังและกลายเป็นคู่อริของตัวละครเอกของเรื่องเมื่อเธอได้นำทีมมหาวิทยาลัยที่ถูกคัดด้วยมือ สาวขี้อายคนนี้ได้เปลี่ยนไปอย่างสิ้นเชิงเมื่อเข้าวิถีแห่งรถถังและกลายเป็นผู้บัญชาการที่แปลงยุทธศาสตร์ได้อย่างง่ายดาย\nสีลายพรางเขียวเทาเข้มของรถถังคันนี้ยังไม่เปลี่ยนไปนับตั้งแต่ปรากฎในทีมมหาวิทยาลัย มีเพียงแต่ตราสัญลักษณ์ที่เป็นแบบใหม่คือแทนที่จะเป็นวงกลมสีตอนนี้ก็ประดับตราสัญลักษณ์ของวิทยาลัยสตรี St. Gloriana เอาไว้ทั้งสองข้างของป้อมปืน"

msgid "GB149_Centurion_MkI_A_long_special"
msgstr "Centurion St. Gloriana นั้นมีความคล่องตัวที่ใช้ได้และเกราะที่ปานกลางแต่คุณลักษณะของปืนใหญ่ไม่ว่าจะเป็นการควบคุม, การเจาะเกราะ, ความเสียหายต่อนาที, ความแม่นยำและมุมกด/มุมยกนั้นถือได้ว่าดีทีเดียว แม้ว่าจะสามารถยิงแลกกับข้าศึกได้ถ้าจำเป็น มันจะดีที่สุดในการเป็นยานรบสนับสนุนเมื่ออยู่ใกล้กับพันธมิตรหรือทำการยิงข้าศึกจากระยะไกล"

msgid "GB149_Centurion_MkI_A_short"
msgstr "Cent Gloriana"

msgid "GB149_Centurion_MkI_A_short_special"
msgstr "อำนาจการเจาะเกราะที่สูงกับการควบคุมปืนที่ดี"

msgid "GB14_M2"
msgstr "M2"

msgid "GB14_M2_descr"
msgstr "รถถังเบาของอเมริกา M2A4 ถูกผลิตขึ้นตั้งแต่ 1940 ถึง 1942 และถูกส่งมอบให้อังกฤษภายใต้สัญญากู้ยืม มีจำนวนการส่งมอบรถถังรุ่นนี้ไปให้อังกฤษสี่คันในช่วงฤดูใบไม้ร่วงปี 1941"

msgid "GB14_M2_short"
msgstr "M2"

msgid "GB150_Churchill_VII_A"
msgstr "Churchill St. Gloriana"

msgid "GB150_Churchill_VII_A_descr"
msgstr "ผู้การรถถังคันนี้คือ Darjeeling ที่เป็นผู้นำทีมรถถังของวิทยาลัยสตรี St. Gloriana เหล่าพลรถถังได้เข้าแข่งขันด้วยยานเกราะอังกฤษและมีความภาคภูมิใจในธรรมเนียมนี้ พวกเขามีมารยาทชั้นสูง, ความอุทิศตนให้กับอาหารอังกฤษและความหลงไหลในชายามบ่าย เหล่านักเรียยังได้ใช้ชื่อปลอมเพื่อเป็นการให้เกียรติกับเครื่องดื่มมีกลิ่นหอมที่หลากหลาย รถถังคันนี้มีลายพรางเขียวมะกอกที่ถือว่าไม่ปกติสำหรับวิทยาลัย ตราของรถถังเป็นรูปโล่ประดับด้วยเมฆ, ดอกไม้และกาน้ำชาทับด้วยแพรสีแดงกับอักษรย่อของวิทยาลัย"

msgid "GB150_Churchill_VII_A_long_special"
msgstr "ยานเกราะคันนี้มีเกราะโดยรวมที่ยอดเยี่ยมทำให้มันทนทานจากการโจมตีส่วนใหญ่ของข้าศึกระดับเดียวกันและระดับต่ำกว่า ปืนของมันมีความเสียหายต่อนาทีที่น่าประทับใจทำให้มันยอดเยี่ยมในการรักษาตำแหน่งและทะลวงแนวข้าศึก อย่างไรก็ตาม การเลือกแนวรบที่ถูกต้องนั้นเป็นเรื่องสำคัญเพราะรถถังมีความคล่องตัวจำกัดทำให้การเปลี่ยนตำแหน่งเป็นไปได้ยาก"

msgid "GB150_Churchill_VII_A_short"
msgstr "Chur Gloriana"

msgid "GB150_Churchill_VII_A_short_special"
msgstr "ความเสียหายต่อนาทีที่สูงและเกราะที่ดี"

msgid "GB151_Headshaker"
msgstr "Headshaker"

msgid "GB151_Headshaker_descr"
msgstr "เมื่ออำนาจการยิงของอาวุธเพิ่มขึ้น ห้องทำการรบปืนอัตตาจรดั้งเดิมก็ไม่ตรงกับข้อกำหนดปัจจุบันอีกต่อไปและนำไปสู่การพัฒนายานเกราะที่มีการจัดวางพื้นฐานแบบใหม่ หนึ่งในโครงการดังกล่าวคือปืนอัตตาจร Headshaker ติดตั้งป้อมปืนมีพลประจำที่หมุนได้ในสองแกน การวางกลไกรับน้ำหนักและกลไกหมุนในส่วนบนของห้องทำการรบทำให้สามารถลดรูปทรงยานเกราะและใช้ปืนที่ทรงพลังและมีช่วงการเล็งที่กว้างกว่า อีกจุดเด่นสำคัญคือระบบหล่อเย็นที่ใช้ครีบระบายความร้อนที่เพิ่มความเชื่อถือได้ของปืน แต่แม้จะมีนวัตกรรมเหล่านี้ โครงการก็ถูกหยุดลงเนื่องด้วยความซับซ้อนและค่าการผลิตที่สูง"

msgid "GB151_Headshaker_long_special"
msgstr "Headshaker เป็นยานพิฆาตรถถังอเนกประสงค์อังกฤษที่มีส่วนผสมที่ไม่ปกติจากการมีกระสุนระเบิดแรงสูงที่เจาะเกราะได้มากและระบบการเล็งสองระดับ การหล่อเย็นปืนทำให้ยานเกราะสามารถยิงอย่างแม่นยำที่ระยะไกล ส่วนความเสียหายต่อนาทีที่ดีและเกราะที่พอใช้ทำให้ยานเกราะเข้าปะทะในระยะประชิดได้อย่างมีประสิทธิภาพ"

msgid "GB151_Headshaker_short"
msgstr "Headshaker"

msgid "GB151_Headshaker_short_special"
msgstr "กระสุนระเบิดแรงสูงเจาะเกราะได้มาก, ระบบการเล็งสองระดับ"

msgid "GB152_AT_FV230_Breaker"
msgstr "AT-FV230 Breaker"

msgid "GB152_AT_FV230_Breaker_descr"
msgstr "หลังจากที่โครงการรถถัง FV230 ปิดตัวลง ทางวิศวกรอังกฤษก็มีแนวคิดในการใช้ตัวถังที่ออกแบบในการสร้างยานพิฆาตรถถัง ด้วยการลดน้ำหนักที่ทำได้ ตีนตะขาบยานเกราะก็ถูกลดความกว้างเหลือ 800 มม.แต่ยังคงระบบช่วงล่างและการจัดวางโครงรถเอาไว้ ในส่วนอาวุธ นักออกแบบก็ได้วางแผนที่จะใช้ปืนลำกล้องเกลียวขนาด 123 มม. ยานเกราะนี้ถูกมุ่งหมายให้มีการป้องกันที่ยอดเยี่ยมกับอำนาจการยิงที่ดีและความคล่องตัวที่ใช้ได้ อย่างไรก็ตาม ระบบขีปนาวุธต่อสู้รถถังก็ถูกให้ความสำคัญสำหรับการปะทะกับรถถังมากว่าทำให้โครงการถูกปิดตัวลงในเวลาต่อมา"

msgid "GB152_AT_FV230_Breaker_long_special"
msgstr "AT-FV230 Breaker เป็นยานพิฆาตรถถังที่มีเกราะหน้าที่ไม่ธรรมดาและปืนสมดุลดีมีอัตราการยิงสูง ส่วนผสมเช่นนี้ทำให้ยานเกราะสามารถกดดันข้าศึกได้อย่างต่อเนื่องและขับไล่ข้าศึกจากแนวป้องกันของตนได้ ยานเกราะนี้มีข้อเสียเดียวคือความเร็วที่ต่ำแต่ก็สามารถชดเชยได้ด้วยการใช้ระบบเครื่องยนต์เร่งความคล่องตัวรุ่นทดลอง"

msgid "GB152_AT_FV230_Breaker_short"
msgstr "Breaker"

msgid "GB155_Pike"
msgstr "Pike"

msgid "GB155_Pike_descr"
msgstr "รถถังหนัก Pike นั้นออกแบบให้กับกองทัพบกอังกฤษประจำเยอรมนีตะวันตก มันเป็นการรวมตัวถังของรถถังรักษาชายฝั่ง FV229 และป้อมปืนของรถถังหนักเยอรมันที่ไม่ได้นำมาผลิตและมีปืนที่ทรงพลัง แรกเริ่มนั้นมุ่งหมายให้รถถังคันนี้ต่อกรกับรถถังหนัก IS-3 ของโซเวียต เนื่องด้วยความยากลำบากในการสื่อสารระหว่างบริษัทอังกฤษและเยอรมัน การพัฒนาก็ล่าช้าอย่างมาก ทำให้มีการเลือกรถถัง Conqueror ของอังกฤษถูกเลือกเข้าประจำการแทนและรถถัง Pike คงอยู่ในแบบร่างเท่านั้น"

msgid "GB155_Pike_long_special"
msgstr "Pike เป็นรถถังหนักอังกฤษระดับ IX ที่ติดตั้งระบบป้อนกระสุนสามนัดที่ทำความเสียหายต่อนัดสูงมาก เมื่อรวมกับเกราะตัวถังและป้อมปืนที่ไว้ใจได้ก็ทำให้ Pike เป็นรถถังที่อันตรายในการตะลุมบอนจุดยิงอย่างมาก ปืนที่มีอาจจะควบคุมไม่ได้สะดวกนักแต่ก็มีความแม่นยำที่ดี"

msgid "GB155_Pike_short"
msgstr "Pike"

msgid "GB155_Pike_short_special"
msgstr "เกราะตัวถังและป้อมปืนที่ไว้ใจได้, ระบบป้อนกระสุนอัตโนมัติ"

msgid "GB156_Black_Prince_II"
msgstr "Black Prince II"

msgid "GB156_Black_Prince_II_descr"
msgstr "โครงการรถถังหนักทหารราบ A43 Black Prince II ที่มีป้อมปืนเชื่อมเข้ารูปและติดตั้งปืนขนาด 77 มม.สองกระบอกที่ทรงพลังที่ออกแบบเอาไว้แต่ไม่ได้มีการผลิตขึ้นมา"

msgid "GB156_Black_Prince_II_long_special"
msgstr "Black Prince II เป็นรถถังหนักอังกฤษระดับ VII ที่โดดเด่นจากระบบปืนคู่ กลไกการเตรียมยิงที่สั้นและอาการค้างที่ต่ำทำให้สามารถยิงปืนคู่ได้หลายครั้งต่อการรบแต่ตัวรถถังเองก็มีเกราะป้อมปืนและตัวถังที่ถือว่าใช้ได้เช่นกัน"

msgid "GB156_Black_Prince_II_short"
msgstr "BP II"

msgid "GB156_Black_Prince_II_short_special"
msgstr "ระบบปืนคู่ เกราะป้อมปืนและตัวถังที่ไว้ใจได้"

msgid "GB157_FV214t"
msgstr "FV214t"

msgid "GB157_FV214t_descr"
msgstr "FV214 Conqueror เป็นรถถังหนักอังกฤษยุคหลังสงครามโลกครั้งที่สอง รถถังถูกออกแบบเพื่อเป็นการโต้ตอบกับรถถังหนัก IS-3 ของโซเวียต รุ่นนี้มีความแตกต่างจากรุ่นปกติจากการมีปืน 114 ที่ทรงพลังกว่า"

msgid "GB157_FV214t_long_special"
msgstr "FV214t เป็นรถถังหนักอังกฤษระดับ IX จากสายของรถถัง Conqueror ที่ถือเป็นแนวใหม่ที่ต่างจากสูตรการออกแบบรถถังหนักอังกฤษดั้งเดิม ด้วยการมีความคล่องตัวและการควบคุมปืนที่ดีและยังมีความสามารถย้ายตำแหน่งข้ามแผนที่ได้อย่างรวดเร็ว"

msgid "GB157_FV214t_short"
msgstr "FV214t"

msgid "GB157_FV214t_short_special"
msgstr "การควบคุมที่ยอดเยี่ยม เกราะป้อมปืนหน้าที่ไว้ใจได้"

msgid "GB158_Executor"
msgstr "Executor"

msgid "GB158_Executor_descr"
msgstr "โครงการของยานเกราะสี่เพลาที่มีความคล่องตัวเพิ่มขึ้นและปืน 110 มม. แม้จะมีการรวมใช้ชิ้นส่วนกับยานเกราะอื่นที่ประจำการอยู่แล้ว การพัฒนาก็ถูกหยุดลงในช่วงพิมพ์เขียวเพื่อหลีกทางให้กับรถถังแนวดั้งเดิมแทน"

msgid "GB158_Executor_long_special"
msgstr "จากการรวมตัวถังใช้ล้อ, เครื่องยนต์ซับซ้อนที่ทรงพลังและอาวุธที่ยอดเยี่ยม รถถัง Executor นั้นถือเป็นสุดยอดนวัตกรรมของรถถังกลางล้อของอังกฤษ วิศวกรรมชั้นยอดทำให้มันสามารถเข้าถึงทุกจุดในสนามรบในขณะที่ปืนของมันทำให้ทำความเสียหายได้อย่างดีไม่ว่าจะเผชิญกับข้าศึกแบบใดก็ตาม"

msgid "GB158_Executor_short"
msgstr "Executor"

msgid "GB15_Stuart_I"
msgstr "Stuart I-IV"

msgid "GB15_Stuart_I_descr"
msgstr "ถูกผลิตจำนวนมากตั้งแต่ปี 1941 และส่งไปยังสหราชอาณาจักรภายใต้สัญญากู้ยืม มียอดการส่งรถถังทั้งหมด 6,889 คันโดยรวมทั้งรุ่น M3 และ M5A1 รถถัง M3 ได้กรับนามเรียกขาน Stuart I โดยอังกฤษ ในขณะที่ M3A1 ได้รับนามเรียกขานเป็น Stuart III รถถังรุ่นนี้เข้าร่วมการรบครั้งแรกที่ Sidi Rezegh"

msgid "GB17_Grant_I"
msgstr "Grant"

msgid "GB17_Grant_I_descr"
msgstr "รุ่นของ M3 Lee ที่ผลิตขึ้นในสหรัฐอเมริกาเพื่อที่จะส่งมอบให้สหราชอาณาจักรเป็นการเฉพาะ และใช้นามเรียกขานตามนายพล Grant (Grant I)"

msgid "GB19_Sherman_Firefly"
msgstr "Sherman Firefly"

msgid "GB19_Sherman_Firefly_descr"
msgstr "เป็นรุ่นรถถัง M4 Sherman ของสหรัฐฯที่พัฒนาโดยอังกฤษ พัฒนาขึ้นในช่วงต้นปี 1944 รุ่นนี้ต่างกับรุ่นของสหรัฐฯเนื่องจากติดตั้งปืนใหญ่ 17 ปอนด์ที่ทรงพลังกว่า วางตำแหน่งวิทยุและกระสุนต่างกัน และไม่มีปืนเหนือป้อม และไม่มีตำแหน่งผู้ช่วยพลขับ มียอดการผลิตรถถังระหว่าง 2,100 และ 2,300 โดยนับรวมรุ่นดัดแปลงทุกรุ่นที่สร้างตั้งแต่ปี 1944 ถึง 1945"

msgid "GB19_Sherman_Firefly_short"
msgstr "Firefly"

msgid "GB20_Crusader"
msgstr "Crusader"

msgid "GB20_Crusader_descr"
msgstr "รถถัง Crusader ถูกพัฒนาโดย Nuffield Mechanisations Ltd ในช่วงปี 1938 ถึง 1940 และมีรถถังจำนวน 5,300 คันถูกผลิตในช่วงปี 1941 ถึง 1943 รถถังรุ่นนี้ถูกใช้งานมากที่สุดในสมรภูมิอัฟริกาเหนือในช่วง 1941-1942"

msgid "GB20_Crusader_short"
msgstr "Crusader"

msgid "GB21_Cromwell"
msgstr "Cromwell"

msgid "GB21_Cromwell_descr"
msgstr "รถถัง Cromwell ถูกพัฒนาขึ้นโดย BRC&W ในปี 1941-1942 มียอดการผลิตทั้งหมด 1070 คันตั้งแต่ 1943-1945 กองทัพอังกฤษใช้รถถังรุ่นนี้อย่างต่อเนื่องในสมรภูมิยุโรปตะวันตกเฉียงเหนือในช่วงปี 1944-1945"

msgid "GB21_Cromwell_short"
msgstr "Cromwell"

msgid "GB22_Comet"
msgstr "Comet"

msgid "GB22_Comet_descr"
msgstr "การพัฒนาเพิ่มเติมของรถถังเร็ว Cromwell รถถังอังกฤษรุ่นนี้เข้าประจำการในสงครามโลกครั้งที่สองและมียอดการผลิตทั้งหมด 1,186 คันตั้งแต่กันยายน 1944 ถึงปลายปี 1945"

msgid "GB22_Comet_short"
msgstr "Comet"

msgid "GB23_Centurion"
msgstr "Centurion Mk. I"

msgid "GB23_Centurion_descr"
msgstr "การพัฒนาของ Centurion เริ่มขึ้นในปี 1943 ออกแบบขึ้นมาเป็นรถถังสารพัดประโยชน์เพื่อมาแทนที่รถถังสนับสนุนทหารราบและรถถังลาดตระเวน Centurion เป็นรถถังอังกฤษคันแรกที่มีเกราะลาดเอียง รถถังเข้าประจำการในปี 1947 มียอดการผลิตรถถังรุ่นนี้ 100 คันตั้งแต่ช่วงปี 1945 ถึง 1946"

msgid "GB23_Centurion_short"
msgstr "Centurion I"

msgid "GB24_Centurion_Mk3"
msgstr "Centurion Mk. 7/1"

msgid "GB24_Centurion_Mk3_descr"
msgstr "รุ่นพัฒนาของรถถัง Centurion ที่ Leyland Motors เป็นผู้พัฒนา โดยมีการเพิ่มตัวถังขนาดใหญ่กว่าเดิม ห้องพลรถถังที่ออกแบบใหม่ ถังเชื้อเพลิงขนาดใหญ่กว่าเดิมและเกราะรุ่นปรับปรุง"

msgid "GB24_Centurion_Mk3_short"
msgstr "Centurion 7/1"

msgid "GB25_Loyd_Carrier"
msgstr "Loyd Gun Carriage"

msgid "GB25_Loyd_Carrier_descr"
msgstr "เป็นการเสนอติดตั้งปืน 76.2 มม บนตัวถังของรถปืนใหญ่ Loyd Carrier พัฒนาจากปี 1940 ถึง 1941 ไม่มีการผลิตรถต้นแบบขึ้นแต่อย่างใด"

msgid "GB25_Loyd_Carrier_short"
msgstr "Loyd GC"

msgid "GB26_Birch_Gun"
msgstr "Birch Gun"

msgid "GB26_Birch_Gun_descr"
msgstr "ในช่วงทศวรรษที่ 1920 วิศวกรอังกฤษได้ทดลองออกแบบปืนอัตตาจรบนตัวถังรถถัง การพัฒนาเริ่มขึ้นในปี 1923 ที่คลังสรรพาวุธหลวงที่ Woolwich รถถังถูกผลิตโดยใช้พื้นฐานของรถถัง Vickers Medium Mark II โดยมีตัวถังที่สามารถรองรับชิ้นส่วนที่ต้องการได้ มียอดการผลิตรถต้นแบบทั้งหมดเจ็ดคันตั้งแต่ช่วง 1926 ถึง 1927 และเข้าร่วมกองกำลังยานเกราะทดลองที่ก่อตั้งในวันที่ 1 พฤษภาคม 1927 ต่อมาหน่วยดังกล่าวถูกยุบลงไปพร้อมกับโครงการปืนอัตตาจร"

msgid "GB26_Birch_Gun_short"
msgstr "Birch Gun"

msgid "GB27_Sexton"
msgstr "Sexton II"

msgid "GB27_Sexton_descr"
msgstr "เป็นรุ่นดัดแปลงของรถถัง Grizzly (M4A1 Sherman) โดยติดตั้งปืนใหญ่สนามขนาด 25 ปอนด์ การผลิตจำนวนมากเริ่มขึ้นที่ Montreal Locomotive Works ในแคนาดา โดยมียอดการผลิตทั้งหมด 2,150 คันในเวลานับตั้งแต่ปี 1943 ถึง 1945"

msgid "GB27_Sexton_short"
msgstr "Sexton II"

msgid "GB28_Bishop"
msgstr "Bishop"

msgid "GB28_Bishop_descr"
msgstr "พัฒนาจากฐานของรถถัง Valentine ป้อมปืนมาตรฐานถูกแทนที่ด้วยห้องทำการรบทรงกล่องที่ติดตั้งปืนใหญ่สนามขนาด 25 ปอนด์เอาไว้ เนื่องด้วยมีมุมเงยปืนที่ต่ำ (15 องศา) ระยะทำการยิงสูงสุดจึงอยู่แค่เพียง 5,800 ม. ซึ่งเป็นระยะครึ่งเดียวของระยะการยิงจริงสภาวะลากจูง ปืนอัตตตาจรนี้เข้าร่วมการรบในอัฟริกาเหนือ ซิซิลี และอิตาลีตอนใต้ ตามแหล่งข้อมูลหลายแหล่ง มียอดการผลิตพาหนะรุ่นนี้ 80-100 คัน"

msgid "GB28_Bishop_short"
msgstr "Bishop"

msgid "GB29_Crusader_5inch"
msgstr "Crusader 5.5-in. SP"

msgid "GB29_Crusader_5inch_descr"
msgstr "ปืนใหญ่อัตตาจรนี้เป็นการดัดแปลง Crusader โดยการติดตั้งปืนใหญ่สนาม 140 มม. รถต้นแบบประกอบสำเร็จภายหลังสงครามโลกครั้งที่สองสิ้นสุดไม่นาน อย่างไรก็ตาม ยานเกราะรุ่นนี้ไมไ่ด้เข้าสายการผลิตหรือเข้าประจำการแต่อย่างใด"

msgid "GB29_Crusader_5inch_short"
msgstr "Crusader SP"

msgid "GB30_FV3805"
msgstr "FV3805"

msgid "GB30_FV3805_descr"
msgstr "ในปี 1947 โครงการพัฒนาปืนอัตตาจรได้รับการอนุมัติจากรัฐบาลอังกฤษ มีการเสนอรุ่นหลายรุ่นที่ใช้ฐานจากรถถัง Centurion หนึ่งในนั้นเป็นรุ่นที่ติดตั้งปืนขนาด 140 มม. มีการผลิตรถต้นแบบขึ้นสองคันในปี 1957 ในปี 1960 การพัฒนาปืนอัตตาจรหยุดลงและพาหนะก็ไม่ได้เข้าประจำการ"

msgid "GB30_FV3805_short"
msgstr "FV3805"

msgid "GB31_Conqueror_Gun"
msgstr "Conqueror Gun Carriage"

msgid "GB31_Conqueror_Gun_descr"
msgstr "เป็นการเสนอติดตั้งปืนใหญ่สนาม 234 มม. กับตัวถังของ Conqueror โดยให้ส่วนส่งกำลังนั้นอยู่ด้านหน้าของตัวรถ มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB31_Conqueror_Gun_short"
msgstr "Conqueror GC"

msgid "GB32_Tortoise"
msgstr "Tortoise"

msgid "GB32_Tortoise_descr"
msgstr "การพัฒนารถถังบุกทะลวงรุ่นนี้เริ่มขึ้นในปี 1942 การออกแบบนั้นเสร็จสิ้นในเดือนกุมภาพันธ์ 1944 และมีคำสั่งผลิตรถถังจำนวน 25 คัน อย่างไรก็ตาม เมื่อถึงช่วงฤดูใบไม้ร่วง ปี 1947 มีการผลิตรถถังนี้เพียงแค่ห้าคัน"

msgid "GB33_Sentinel_AC_I"
msgstr "AC 1 Sentinel"

msgid "GB33_Sentinel_AC_I_descr"
msgstr "รถถังเร็วออสเตรเลียที่พัฒนาขึ้นตามโครงการในปี 1941 มีแผนในการผลิตรถถัง 2,000 คัน แต่ในปี 1942 ถึง 1943 มีการผลิตรถถังเพียง 65 คันโดยใช้หมายเลข 8001 ถึง 8065 เท่านั้น ในเดือนกรฏาคม 1943 การผลิตถูกหยุดลงและโครงการก็ถูกยกเลิก รถถังรุ่นนี้ไม่ได้เข้าร่วมการรบและถูกใช้ในการฝึกรบเท่านั้น ในปี 1946 รถถังรุ่นนี้ก็ถูกปลดประจำการ"

msgid "GB33_Sentinel_AC_I_long_special"
msgstr "รถถังกลางอังกฤษระดับ IV ที่มีอัตราการยิงสูง มุมกด/มุมยกปืนที่ดีและความเร็วสูงสุดที่น่าประทับใจ แต่ด้วยความเสียหายต่อนัดและความเร็วในการเล็งที่ต่ำ มันอาจจะไม่สามารถทำลายเป้าหมายได้เร็วนัก"

msgid "GB33_Sentinel_AC_I_short"
msgstr "Sentinel"

msgid "GB33_Sentinel_AC_I_short_special"
msgstr "อัตราการยิงสูง มุมกด/มุมยกปืนที่ดีและความคล่องตัวที่ยอดเยี่ยม"

msgid "GB35_Sentinel_AC_IV"
msgstr "AC 4 Experimental"

msgid "GB35_Sentinel_AC_IV_descr"
msgstr "รถถังนี้ถูกพัฒนาขึ้นในปี 1943 มีการสั่งผลิตจำนวน 400 คัน รถต้นแบบถูกสร้างขึ้นจากฐานของรถถัง AC 1 ที่มีโครงบนที่ใหญ่กว่าเดิมทำให้สามารถติดตั้งป้อมปืนดัดแปลงจากรถถัง AC 3 พร้อมด้วยปืนใหญ่ขนาด 17 ปอนด์ ในเดือนกรกฏาคม 1943 การพัฒนาโครงการถูกหยุดในช่วงระยะสุดท้ายเนื่องจากโครงการผลิตรถถังเร็วของออสเตรเลียถูกหยุดลง"

msgid "GB35_Sentinel_AC_IV_long_special"
msgstr "รถถังกลางคันนี้มีปืนที่สมบูรณ์แบบซึ่งเจาะเกราะได้สูงสำหรับระดับของมัน นอกจากนี้ รถถังคันนี้ยังมีการซ่อนตัวที่ดีซึ่งทำให้สามารถโจมตีข้าศึกจากระยะไกลได้โดยไม่ถูกตรวจพบ"

msgid "GB35_Sentinel_AC_IV_short"
msgstr "AC 4 Exp."

msgid "GB35_Sentinel_AC_IV_short_special"
msgstr "อัตราการเจาะเกราะและการซ่อนตัวที่สมบูรณ์แบบ"

msgid "GB37_Valliant"
msgstr "Valiant"

msgid "GB37_Valliant_descr"
msgstr "การพัฒนารถถังคันนี้เริ่มต้นขึ้นในปี 1943 โดยโครงการเป็นการพัฒนาต่อ จากรถถัง Valentine ด้วยการเพิ่มอำนาจการยิงและเกราะป้องกัน เมื่อถึงปี 1944 ได้มีการประกอบรถต้นแบบสองคันที่มีระบบช่วงล่างและเครื่องยนต์ ต่างกัน ต่อมาในปีเดียวกัน การพัฒนาทั้งหมดของโครงการก็หยุดลงจาก สงครามที่กำลังใกล้สิ้นสุดและการพัฒนาของรถถัง Centurion ที่ทันสมัย และประสบความสำเร็จมากกว่า"

msgid "GB37_Valliant_long_special"
msgstr "คุณลักษณะที่โดดเด่นของพาหนะคันนี้คือเกราะที่ไว้ใจได้และอัตราการยิงที่สูง อย่างไรก็ตาม ความได้เปรียบเหล่านี้ก็แลกด้วยความคล่องตัวที่ต่ำ ซึ่งเป็นการบังคับให้ Valiant กลายเป็นยานสนับสนุนของรถถังหนักพันธมิตร ภารกิจหลักของพาหนะคันนี้คือการช่วยทะลวงแนวป้องกันข้าศึกและป้องกันข้าศึกจากการเข้าตีโอบ"

msgid "GB37_Valliant_short"
msgstr "Valiant"

msgid "GB37_Valliant_short_special"
msgstr "อัตราการยิงที่สูงและเกราะที่ใช้ได้"

msgid "GB39_Universal_CarrierQF2"
msgstr "Universal Carrier 2-pdr"

msgid "GB39_Universal_CarrierQF2_descr"
msgstr "ยานลำเลียงพลสารพัดประโยชน์นี้ถูกพัฒนาขึ้นในช่วงระหว่างสงครามและเป็นหนึ่งในยานเกราะตีนตะขาบหลักที่ถูกใช้โดยกองทัพสหราชอาณาจักร มีจำนวนยานเกราะรุ่นนี้ 90,000 คันถูกผลิตตั้งแต่ปี 1937 ถึง 1945 ในปี 1940 มีการพัฒนารุ่นติดตั้งปืนต่อต้านรถถัง 40 มม. ขึ้นมาและถูกแปลงเป็นปืนอัตตาจร นอกจากนั้นปืน 40 มม. ยังถูกนำไปติดตั้งบน C21UCG ที่ผลิตในแคนาดาด้วย"

msgid "GB39_Universal_CarrierQF2_short"
msgstr "UC 2-pdr"

msgid "GB40_Gun_Carrier_Churchill"
msgstr "Churchill Gun Carrier"

msgid "GB40_Gun_Carrier_Churchill_descr"
msgstr "ยานเกราะถูกพัฒนาโดยมีพื้นฐานมาจากรถถัง Churchill ห้องพลรถถังถูกวางไว้ด้านหน้าพร้อมด้วยปืนลำกล้อง 3 นิ้ว ในเบื้องต้นมีการสั่งผลิต 100 คัน แต่ต่อมาก็ได้ลดยอดลงเหลือเพียง 24 คัน ในท้ายที่สุดมีรถถังจำนวน 50 คัน ถูกผลิตขึ้นในช่วงปี 1941 ถึง 1942 แต่รถถังเหล่านี้ก็ไม่ได้เข้าร่วมรบแต่อย่างใด"

msgid "GB40_Gun_Carrier_Churchill_short"
msgstr "Churchill GC"

msgid "GB41_Challenger"
msgstr "Challenger"

msgid "GB41_Challenger_descr"
msgstr "สร้างขึ้นในปี 1942 โดยใช้โครงที่ยืดออกของ Cromwell เป็นฐาน หนึ่งในความได้เปรียบของยานพิฆาตรถถังรุ่นนี้คือปืนขนาด 17 ปอนด์ ซึ่งเป็นปืนใหญ่ที่ทรงอานุภาพที่สุดของอังกฤษในเวลานั้น ปืนรุ่นนี้ทำให้ยานพิฆาตรถถังสามารถทำการยิงข้าศึกได้จากระยะถึง 1,000 เมตร อย่างไรก็ดี ยานพิฆาตรถถังรุ่นนี้มีรูปทรงที่ใหญ่และตัวถังต้องรับน้ำหนักมากกว่าปกติ จึงมียอดการผลิตทั้งหมดเพียง 200 คัน"

msgid "GB41_Challenger_short"
msgstr "Challenger"

msgid "GB42_Valentine_AT"
msgstr "Valentine AT"

msgid "GB42_Valentine_AT_descr"
msgstr "ยานเกราะพิฆาตรถถังรุ่นทดลองที่ติดตั้งปืนอยู่กลางตัวถังและหลังแผงเกราะปืน มีการสร้างรถต้นแบบขึ้น แต่การพัฒนายานเกราะก็ชะงักลงเมื่อมียานเกราะพิฆาตรถถังรุ่นใหม่พัฒนาขึ้นมาแทนโดยใช้รถถัง Valentine เป็นฐานและติดตั้งปืน 17 ปอนด์ที่อำนาจการยิงสูงกว่า"

msgid "GB44_Archer"
msgstr "Archer"

msgid "GB44_Archer_descr"
msgstr "ยานพิฆาตรถถังที่ติดเกราะเบาแต่ทรงพลังรุ่นนี้สามารถเข้าต่อสู้กับรถถังข้าศึกชนิดใดก็ได้จากระยะถึง 1,000 เมตร ความเร็วสูงสุดนั้นค่อนข้างต่ำเนื่องจากเครื่องยนต์กำลังน้อยและระบบช่วงลางที่ไม่ทนทาน แต่กระนั้น Archer ก็ถือว่าประสบความสำเร็จในการนำตัวถังขอ Valentine ที่ล้าสมัยมาใช้ใหม่ มียอดการผลิตพาหนะ 665 คันตั้งแต่ช่วงปี 1943 ถึง 1945"

msgid "GB44_Archer_short"
msgstr "Archer"

msgid "GB45_Achilles_IIC"
msgstr "Achilles"

msgid "GB45_Achilles_IIC_descr"
msgstr "Achilles เป็นรุ่นของยานพิฆาตรถถัง M10 GMC ของอเมริกาที่อังกฤษรับมาใช้ ปืนมาตรฐาน M10 ถูกเปลี่ยนด้วยปืนต่อต้านรถถังยิงเร็วขนาด 17 ปอนด์ของอังกฤษเอง นี่ทำให้ยานพิฆาตรถถังสามารถำการต่อสู้กับรถถังเยอรมันได้เป็นอย่างดี ในปี 1944 ได้มีโครงการติดอาวุธใหม่ให้กับยานพิฆาตรถถังโดยมียอดการติดอาวุธใหม่เมื่อสิ้นสุดสงคราม 1,100 คัน"

msgid "GB45_Achilles_IIC_short"
msgstr "Achilles"

msgid "GB48_FV215b_183"
msgstr "FV215b (183)"

msgid "GB48_FV215b_183_descr"
msgstr "โครงการปืนอัตตาจรหนักที่ใช้รถถัง Conqueror Mk II เป็นรากฐานพร้อมด้วยปืนขนาด 183 มม. และติดตั้งป้อมปืนกับห้องพลรถถังไว้ที่ด้านหลัง ยานเกราะนี้ถูกออกแบบมาให้ต่อสู้กับรถถังหนักของโซเวียตที่ระยะไกล (ถึง 1,829 เมตร) และสามารถรับกระสุนที่ยิงมาจากปืน 122 มม. ที่ระยะถึง 500 เมตร ภายหลังการพัฒนาจรวดต่อต้านรถถัง Malkara ขนาด 193 มม. ซึ่งถูกกว่าและมีประสิทธิภาพกว่าในการต่อต้านรถถังรุ่น IS ยานเกราะรุ่นนี้ก็ถือว่าล้าสมัย โครงการถูกยกเลิกภายหลังรถปลอมถูกสร้างขึ้นไม่นาน"

msgid "GB48_FV215b_183_long_special"
msgstr "ยานพิฆาตรถถังอังกฤษระดับ X ที่มีความเสียหายต่อนัดระดับทำลายล้างด้วยการใช้กระสุนระเบิดแรงสูง แม้ว่ามันจะเป็นศัตรูที่ร้ายกาจของข้าศึกทุกคันแต่มันก็มีเวลาบรรจุกับการเล็งที่นานและกระสุนที่กระจายจากจุดเล็งสูง"

msgid "GB48_FV215b_183_short"
msgstr "FV215b 183"

msgid "GB48_FV215b_183_short_special"
msgstr "ความเสียหายต่อนัดมหาศาลและป้อมปืนหมุนไม่รอบตัวกับเกราะที่พอใช้"

msgid "GB50_Sherman_III"
msgstr "Sherman III"

msgid "GB50_Sherman_III_descr"
msgstr "รถถังกลาง M4A2 ของอเมริกานั้นถูกผลิตและติดตั้งเครื่องยนต์ดีเซลและส่งไปให้สหราชอาณาจักรภายใต้สัญญากู้ยืมและได้รับนามเรียกขานเป็น Sherman III มียอดการส่งมอบรถถังรุ่นนี้ไปให้อังกฤษในช่วงสงครามทั้งหมด 5,045 คัน"

msgid "GB50_Sherman_III_short"
msgstr "Sherman III"

msgid "GB51_Excelsior"
msgstr "Excelsior"

msgid "GB51_Excelsior_descr"
msgstr "รถถังบุกทะลวงรุ่นทดลองบนตัวถังของ Cromwell พัฒนาขึ้นเพื่อเป็นการทดแทนรถถังสนับสนุนทหารราบและรถถังเร็ว การพัฒนาเริ่มขึ้นในปี 1942 และมีรถต้นแบบสองคันในรหัสเรียกขาน Excelsior ถูกสร้างขึ้นโดยบริษัท English Electric ในปี 1943-1944 ภายหลังการทดสอบ โครงการถูกยุติลงเพื่อหลีกทางให้รถถัง Churchill ที่ได้ถูกพัฒนาไว้แล้ว"

msgid "GB51_Excelsior_long_special"
msgstr "รถถังคันนี้มีความคล่องตัวที่ดีและอัตราการยิงที่สูงซึ่งทำให้สามารถร่วมมือกับรถถังกลางพันธมิตรคันใดก็ได้ นอกจากนี้ รถถังคันนี้ยังค่อนข้างทนทานด้วยการวางเกราะส่วนหน้าที่ดี"

msgid "GB51_Excelsior_short_special"
msgstr "อัตราการยิงและการอยู่รอดที่สูง ความคล่องตัวที่ดี"

msgid "GB52_A45"
msgstr "FV201 (A45)"

msgid "GB52_A45_descr"
msgstr "การพัฒนาเริ่มขึ้นโดย English Electric เพื่อมาเป็นพาหนะแทน A43 Black Prince ส่วนประกอบบางอย่างถูกใช้ร่วมกันกับ A41 Centurion ในปี 1948 มีการเริ่มการทดสอบรถต้นแบบ โดยรถต้นแบบติดตั้งป้อมปืนของ Centurion Mk II และปืนขนาด 17 ปอนด์ เนื่องจากการเปลี่ยนแปลงนโยบายและหลักนิยมของกองกำลังหุ้มเกราะก็ทำให้การพัฒนาหยุดลง อย่างไรก็ตาม การออกแบบถูกนำมาใช้เป็นพื้นฐานของรถถังหนักหลังสงครามหลายรุ่นด้วยกัน"

msgid "GB52_A45_long_special"
msgstr "พาหนะคันนี้ติดตั้งปืนอัตราการยิงสูงและการเจาะเกราะที่พอใช้ไว้ในป้อมปืนที่ไว้ใจได้ ซึ่งทำให้สามารถทำความเสียหายพาหนะข้าศึกใดๆก็ได้ได้อย่างต่อเนื่อง นอกจากนี้ รถถังคันนี้ยังมีระยะการมองเห็นและความทนทานที่ดีซึ่งจะช่วยยืดระยะการอยู่รอดในการรบที่ดุเดือดได้นานเท่าที่จะเป็นไปได้"

msgid "GB52_A45_short"
msgstr "FV201 (A45)"

msgid "GB52_A45_short_special"
msgstr "ความทนทานที่ยอดเยี่ยม ความเสียหายต่อนาทีที่สูง"

msgid "GB57_Alecto"
msgstr "Alecto"

msgid "GB57_Alecto_descr"
msgstr "ยานเกราะพิฆาตรถถัง พัฒนาขึ้นในช่วงปี 1944-1945 โดยใช้ฐานของรถถังเบา Tetrach โครงการนี้ยกเลิกลงเมื่อสงครามโลกครั้งที่สองสิ้นสุดลง"

msgid "GB58_Cruiser_Mk_III"
msgstr "Cruiser Mk. III"

msgid "GB58_Cruiser_Mk_III_descr"
msgstr "ยานเกราะรุ่นนี้ถูกพัฒนาจากการปรับปรุงรถถัง M1931 Christie ที่กองทัพอังกฤษซื้อมาในปี 1936 ยานเกราะรุ่นนี้ตั้งใจให้เป็นรถถังเบาความเร็วสูงเพื่อใช้ในการบุกทะลวง การปรับแต่งของรถถังรุ่นนี้ถือว่าเป็นความสำเร็จและกลายมาเป็นฐานการออกแบบของรถถังเร็วรุ่นอื่นๆ มีการผลิตรถถังรุ่นนี้ 65 คันและเข้าร่วมการรบในฝรั่งเศสกับอัฟริกาเหนือในปี 1940-1941"

msgid "GB58_Cruiser_Mk_III_short"
msgstr "Cruiser III"

msgid "GB59_Cruiser_Mk_IV"
msgstr "Cruiser Mk. IV"

msgid "GB59_Cruiser_Mk_IV_descr"
msgstr "เป็นรุ่นดัดแปลงของรถถังเร็ว Mk III โดยมีเกราะรุ่นปรับปรุงที่ติดตั้งช่องมองเพิ่มเติมด้วย รถถัง Cruiser Mk IV เข้าร่วมการรบในฝรั่งเศสในปี 1940 และในช่วงต้นของสมรภูมิการรบที่อัฟริกาเหนือ รถถังรุ่นนี้เข้าร่วมการรบครั้งสุดท้ายในช่วงฤดูหนาวของปี 1941 - 1942 และมียอดการผลิตทั้งหมด 655 คันด้วยกัน"

msgid "GB59_Cruiser_Mk_IV_short"
msgstr "Cruiser IV"

msgid "GB60_Covenanter"
msgstr "Covenanter"

msgid "GB60_Covenanter_descr"
msgstr "รถถังเร็วรุ่นใหม่ที่มีนวัตกรรมทางการผลิตหลากหลายเช่นเครื่องยนต์ลูกสูบสองฝั่ง แผงระบายความร้อนด้านหน้าตัวรถและการประกอบรถถังด้วยการเชื่อม รถถังรุ่นนี้เริ่มสั่งให้มีการผลิตในวันที่ 17 เมษายน 1939 โดยมีจำนวนรถถังทั้งหมด 1,771 คันโดยมีรุ่นที่เข้าสายการผลิตจำนวนมากแตกต่างกันสี่รุ่นด้วยกัน รถถัง Covenanter โดยมากจะถูกใช้สำหรับการฝึกในสหราชอาณาจักรตั้งแต่ปี 1940 ถึง 1943"

msgid "GB60_Covenanter_short"
msgstr "Covenanter"

msgid "GB63_TOG_II"
msgstr "TOG II*"

msgid "GB63_TOG_II_descr"
msgstr "พัฒนาขึ้นมาสำหรับการรบในสนามเพลาะ โดยในเบื้องต้นผู้ออกแบบตั้งใจให้อาวุธติดอยู่ส่วนหน้าของตัวถังและป้อมหมุนด้านข้าง อย่างไรก็ดี ผู้ออกแบบตัดสินใจที่จะติดตั้งป้อมปืนแทน ในปี 1943 เมื่อ TOG II* ผลิตเสร็จและพร้อมทำการทดสอบ รถถังก็ถือว่าล้าหลังสำหรับสงครามขณะนั้น จึงไม่ได้รับเข้าประจำการ"

msgid "GB63_TOG_II_long_special"
msgstr "รถถังหนักอังกฤษที่เชื่องช้าแต่มีความทนทานที่น่าประทับใจสำหรับระดับของมันที่จะช่วยให้อยู่รอดในการเผชิญหน้าตัวต่อตัวกับข้าศึกได้ อีกทั้งยังมีปืนที่ยอดเยี่ยมทั้งในความเสถียรและการเจาะเกราะที่สูง ความเร็วที่ต่ำทำให้รถถังนี้ต้องเลือกเคลื่อนที่เข้าแนวรบเพียงฝั่งเดียว"

msgid "GB63_TOG_II_short_special"
msgstr "ความทนทานชั้นยอดและปืนที่ไว้ใจได้"

msgid "GB68_Matilda_Black_Prince"
msgstr "Matilda Black Prince"

msgid "GB68_Matilda_Black_Prince_descr"
msgstr "ยานเกราะรุ่นนี้ติดตั้งปืนใหญ่ดินขับขนาด 6 ปอนด์บนป้อมปืน A27 มีการผลิตรถต้นแบบขึ้นมาเพียงคันเดียว และการพัฒนาก็สิ้นสุดลงเนื่องจากปัญหาในการติดตั้งป้อมปืน ยานเกราะรุ่นนี้ไม่ได้เข้าประจำการในกองทัพ"

msgid "GB68_Matilda_Black_Prince_long_special"
msgstr "ความคล่องตัวที่ต่ำของพาหนะคันนี้ถูกชดเชยด้วยปืนที่ยิงเร็วและเกราะที่ทนทาน ซึ่งทำให้พาหนะคันนี้เหมือนรถถังหนักมากกว่าที่จะเป็นรถถังกลาง พาหนะคันนี้ยังสนับสนุนการบุกของรถถังหนักได้เป็นอย่างดีอีกด้วย"

msgid "GB68_Matilda_Black_Prince_short"
msgstr "Matilda BP"

msgid "GB68_Matilda_Black_Prince_short_special"
msgstr "อัตราการยิงที่สูง เกราะที่ดี"

msgid "GB69_Cruiser_Mk_II"
msgstr "Cruiser Mk. II"

msgid "GB69_Cruiser_Mk_II_descr"
msgstr "The A10 Cruiser Mk. II เป็นการพัฒนาต่อของรุ่น A9 ที่อออกแบบโดย John Carden A10 มีเกราะรุ่นปรับปรุงและไม่มีป้อมปืนกล รถต้นแบบถูกสร้างขึ้นในเดือนกรกฏาคม 1937 และถูกนำมาประจำการเป็นรถถัง Cruiser หนัก มียอดการสั่งรถถัง 175 คันในช่วงปี 1938-1939 ซึ่งทำการผลิตเสร็จในช่วงกันยายน 1940 รถถังรุ่นนี้เข้าร่วมการรบในฝรั่งเศส (1940) กรีก (1941) และอัฟริกาเหนือ (1941)"

msgid "GB69_Cruiser_Mk_II_short"
msgstr "Cruiser II"

msgid "GB70_FV4202_105"
msgstr "FV4202"

msgid "GB70_FV4202_105_descr"
msgstr "รถถังรุ่นทดลองโดยใช้รถถังกลาง Centurion เป็นพื้นฐาน พัฒนาขึ้นในช่วงปี 1956 ถึง 1959 ไม่ได้เข้าสายการผลิตจำนวนมาก นวัตกรรมทางเทคนิคที่คิดค้นในการพัฒนา FV4202 ต่อมาถูกนำมาใช้กับ FV4201 Chieftain"

msgid "GB70_FV4202_105_short"
msgstr "FV4202"

msgid "GB70_N_FV4202_105"
msgstr "FV4202"

msgid "GB70_N_FV4202_105_FL"
msgstr "FV4202 FL"

msgid "GB70_N_FV4202_105_FL_short"
msgstr "FV4202 FL"

msgid "GB70_N_FV4202_105_descr"
msgstr "รถถังรุ่นทดลองโดยใช้รถถังกลาง Centurion เป็นพื้นฐาน พัฒนาขึ้นในช่วงปี 1956 ถึง 1959 ไม่ได้เข้าสายการผลิตจำนวนมาก นวัตกรรมทางเทคนิคที่คิดค้นในการพัฒนา FV4202 ต่อมาถูกนำมาใช้กับ FV4201 Chieftain"

msgid "GB70_N_FV4202_105_long_special"
msgstr "แม้ว่ารถถังกลางคันนี้จะไม่มีความคล่องตัวที่ยอดเยี่ยม แต่มันก็มีปืนที่สมบูรณ์ที่ติดตั้งไว้บนป้อมปืนที่ไว้ใจได้และสามารถต้านทานกระสุนได้หลายนัด"

msgid "GB70_N_FV4202_105_short"
msgstr "FV4202"

msgid "GB70_N_FV4202_105_short_special"
msgstr "ปืนที่ดีและเจาะเกราะได้สูง ระยะการมองเห็นที่เพียงพอ เกราะป้อมปืนที่ไว้ใจได้"

msgid "GB71_AT_15A"
msgstr "AT 15A"

msgid "GB71_AT_15A_descr"
msgstr "รถถังจู่โจมที่มีภารกิจในการบุกทะลวงแนวป้องกันของข้าศึก โครงการออกแบบนั้นพร้อมในวันที่ 5 ตุลาคม ปี 1943 แต่ก็ไม่มีการผลิตรถต้นแบบขึ้นมา อย่างไรก็ดี โครงการดังกล่าวก็กลายมาเป็นฐานการพัฒนารถถังจู่โจมขนาดหนัก A39 Tortoise"

msgid "GB71_AT_15A_long_special"
msgstr "ยานพิฆาตรถถังคันนี้มีการวางเกราะที่สมบูรณ์แบบรวมไปถึงปืนที่แม่นยำและอัตราการยิงที่สูงและมุมการหมุนที่ดี อย่างไรก็ตาม พาหนะคันนี้อ่อนแอต่อการโจมตีจากปืนอัตตาจรเนื่องด้วยความเร็วที่ต่ำ"

msgid "GB71_AT_15A_short_special"
msgstr "เกราะหน้าที่ไว้ใจได้ ปืนที่มีความแม่นยำและอัตราการยิงที่ดี"

msgid "GB72_AT15"
msgstr "AT 15"

msgid "GB72_AT15_descr"
msgstr "รถถังบุกทะลวงที่ออกแบบมาเพื่อทำลายป้อมปราการข้าศึก โครงการออกแบบนั้นพร้อมที่จะทำการผลิตในปี 1943 แต่ไม่มีการสร้างรถต้นแบบขึ้น อย่างไรก็ดี โครงการนี้ก็กลายมาเป็นต้นแบบของรถถังบุกทะลวงหนัก A39 Tortoise"

msgid "GB73_AT2"
msgstr "AT 2"

msgid "GB73_AT2_descr"
msgstr "เป็นการออกแบบรถถังบุกทะลวงแนวป้องกันข้าศึก การออกแบบของรถถังรุ่นนี้เสร็จสิ้นในวันที่ 15 พฤษภาคม 1943 ไม่มีการสร้างรถต้นแบบขึ้นมา แต่โครงการนี้ก็ได้ช่วยเป็นรากฐานการพัฒนารถถังบุกทะลวงหนักอีกคันซึ่งก็คือ A39 Tortoise"

msgid "GB74_AT8"
msgstr "AT 8"

msgid "GB74_AT8_descr"
msgstr "ยานเกราะรุ่นนี้ถูกออกแบบให้เป็นรถถังบุกทะลวง โครงการออกแบบถูกเตรียมในวันที่ 29 พฤษภาคม 1943 ไม่มีการสร้างรถต้นแบบเพราะ Nuffield ได้เสนอโครงการอื่นที่กลายมาเป็นการพัฒนา A39 Tortoise"

msgid "GB75_AT7"
msgstr "AT 7"

msgid "GB75_AT7_descr"
msgstr "ถูกออกแบบให้เป็นรถถังบุกทะลวงโดยการออกแบบเสร็จสิ้นในวันที่ 10 เดือน มิถุนายน 1943 ไม่มีการสร้างรถถังต้นแแบบ แต่อย่างไรก็ตาม ชิ้นส่วนและอะไหล่บางชิ้นของ AT-7 ก็ถูกนำไปใช้ใน A39 Tortoise"

msgid "GB76_Mk_VIC"
msgstr "Light Mk. VIC"

msgid "GB76_Mk_VIC_descr"
msgstr "รุ่นดัดแปลงของรถถังเบา Mk. VI โดยมีการติดตั้งอาวุธที่ดีกว่าเดิม (ปืนกล Besa 15 มม.) ถูกผลิตขึ้นในเดือนธันวาคม 1939 ถึง กรกฏาคม 1940 ในเบื้องต้นรถถังรุ่นนี้ถูกออกแบบเพื่อการใช้งานในประเทศอาณานิคม มียอดการผลิตรถถัง Mk. VIC ทั้งหมด 130 คัน"

msgid "GB76_Mk_VIC_long_special"
msgstr "รถถังเบาอังกฤษระดับ II ที่มีอำนาจการยิงสูงจากปืนบรรจุอัตโนมัติ 40 นัด คุณควรเลือกยิงเป้าหมายที่เกราะบางที่สุดและแล่นออกมายิงจนหมดซองกระสุนจากที่กำบังแล้วหลบกลับไปบรรจุใหม่ จุดเสียหลักของรถถังคันนี้คือเกราะที่บาง"

msgid "GB76_Mk_VIC_short"
msgstr "Light VIC"

msgid "GB76_Mk_VIC_short_special"
msgstr "อัตราการยิงที่ดีและความเสียหายมหาศาลต่อนาที"

msgid "GB77_FV304"
msgstr "FV304"

msgid "GB77_FV304_descr"
msgstr "ต้นแบบปืนอัตตาจรขนาดเบาโดย Vickers การพัฒนาเริ่มต้นขึ้นในปี 1947 อย่างไรก็ตาม ต้นแบบไม่ได้ถูกผลิตขึ้นจนกระทั่งปี 1950 การออกแบบของรถต้นแบบถือว่าล้าสมัยในขณะนั้นและโครงการก็ถูกยกเลิก"

msgid "GB77_FV304_short"
msgstr "FV304"

msgid "GB78_Sexton_I"
msgstr "Sexton I"

msgid "GB78_Sexton_I_descr"
msgstr "ในปี 1943 Montreal Locomotive Works เริ่มสายการผลิตจำนวนมากของปืนอัตตาจร Sexton โดยพัฒนาจากฐานของ RAM II ปืนอัตตาจรนี้คล้ายกับ M7 Priest แต่ติดตั้งปืน 25 ปอนด์แทน มียอดการผลิตทั้งหมด 2,150 คันเมื่อถึงปี 1945 โดยมี 125 คันแรกได้รหัสเรียกขานเป็น \"Sexton I\""

msgid "GB78_Sexton_I_long_special"
msgstr "หนึ่งในสองปืนอัตตาจรพิเศษในเกม มีอัตราการเจาะเกราะของกระสุนระเบิดแรงสูงที่มมากและมีกระสุนเจาะเกราะสองชนิดให้ใช้ซึ่งทำให้ปืนอัตตาจรคันนี้ต่างจากปืนอัตตาจรคันอื่นของระดับเดียวกัน ความเสียหายต่อนัดที่ปานกลางนั้นได้รับการชดเชยจากความเร็วกระสุนและความเสียหายต่อนาทีที่ดี มุมปืนที่กว้างทำให้สามารถยิงได้อย่างมีประสิทธิภาพโดยไม่ต้องหมุนตัวถัง"

msgid "GB78_Sexton_I_short_special"
msgstr "รูปแบบการเล่นเฉพาะตัวและอัตราการเจาะเกราะที่สูง"

msgid "GB79_FV206"
msgstr "FV207"

msgid "GB79_FV206_descr"
msgstr "ปืนอัตตาจรรุ่นดัดแปลงดดยใช้ A45 Conqueror เป็นฐานการออกแบบ มีการวางแผนที่จะติดตั้งปืนใหญ่สนาม 105 มม 140 มม หรือ 152 มม เข้ากับห้องพลขับติดเกราะ การพัฒนายานเกราะรุ่นนี้มีอยู่เพียงขั้นพิมพ์เขียวเท่านั้น"

msgid "GB79_FV206_short"
msgstr "FV207"

msgid "GB80_Charioteer"
msgstr "Charioteer"

msgid "GB80_Charioteer_descr"
msgstr "รุ่นยกระดับของรถถัง Cromwell มีการติดตั้งป้อมปืนใหม่และปืนใหญ่ 20 ปอนด์ขนาด 83.4 มม. ทำให้รถถังคันนี้เป็นศัตรูที่น่ากลัวในการรบ จากแหล่งข้อมูลที่แตกต่างกัน ยอดการดัดแปลงของรถถัง Cromwell มาเป็น Charioteer มีอยู่ตั้งแต่ 200 ถึง 442"

msgid "GB80_Charioteer_short"
msgstr "Charioteer"

msgid "GB81_FV4004"
msgstr "FV4004 Conway"

msgid "GB81_FV4004_descr"
msgstr "ต้นแบบยานพิฆาตรถถังรุ่นนี้ถูกสร้างขึ้นโดยใช้รถถังกลาง Centurion เป็นแบบฐาน พัฒนาขึ้นเพื่อใช้ต่อสู้กับรถถังหนักในยุคนั้นโดยรวมถึงรถถัง IS-3"

msgid "GB81_FV4004_short"
msgstr "Conway"

msgid "GB83_FV4005"
msgstr "FV4005 Stage II"

msgid "GB83_FV4005_descr"
msgstr "โครงการยานพิฆาตรถถังนี้ถูกพัฒนาขึ้นโดยใช้รถถัง Centurion Mk3 เป็นแบบฐานในช่วงต้นทศวรรษ 1950 ในเบื้องต้นมีการทดสอบการใช้รางกระสุนป้อนอัตโนมัติแต่เนื่องด้วยรางกระสุนไม่พอดีกับขนาดป้อมปืนทำให้ถูกยกเลิก มีการสร้างรถต้นแบบขึ้นหนึ่งคันและเข้าทำการทดสอบ แต่ยานพิฆาตรถถังรุ่นนี้ก็ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "GB83_FV4005_short"
msgstr "FV4005"

msgid "GB84_Chieftain_Mk6"
msgstr "Chieftain Mk. 6"

msgid "GB84_Chieftain_Mk6_descr"
msgstr "การพัฒนาโครงการรถถังที่มีเป้าหมายมาแทนที่รถถัง Centurion ได้เริ่มขึ้นในช่วงต้นทศวรรษ 1950 แต่รถต้นแบบแรกๆนั้นปรากฎในช่วงปี 1959 รถถัง FV4201 ได้เข้าประจำการในเดือนพฤษภาคม 1963 และผลิตจนถึงปี 1985 รถถัง Chieftain Mk. 6 นั้นเป็นรถถัง Chieftain Mk. 2 ที่มีระบบเครื่องยนต์ใหม่และมีปืนหลักแบบใหม่ มียอดการผลิตรุ่นดัดแปลงนี้ทั้งหมด 2,265 คัน"

msgid "GB84_Chieftain_Mk6_long_special"
msgstr "รถถังหนักอังกฤษระดับ X ที่มีความเสียหายต่อนาทียอดเยี่ยม การเจาะเกราะที่ดี รูปทรงที่ต่ำและเกราะที่สามารถสะท้อนกระสุนข้าศึกได้ดี มุมกด/มุมยกปืนของรถถังยังทำให้สามารถใช้ภูมิประเทศไม่ราบเรียบได้เป็นอย่างดี อย่างไรก็ตามพยายามอย่าเปิดเผยตัวถังให้ข้าศึกยิงได้"

msgid "GB84_Chieftain_Mk6_short"
msgstr "Chieftain"

msgid "GB84_Chieftain_Mk6_short_special"
msgstr "ความเสียหายต่อนาทีที่ดี ป้อมปืนที่ไว้ใจได้และความคล่องตัวที่ดีพอใช้"

msgid "GB85_Cromwell_Berlin"
msgstr "Cromwell B"

msgid "GB85_Cromwell_Berlin_descr"
msgstr "พาหนะที่มีชื่อเสียงจาก กองพลหุ้มเกราะอังกฤษที่ 7 ที่ถูกขนานนามว่า หนูทะเลทราย จากการปฏิบัติภารกิจในอัฟริกาเหนือ อย่างไรก็ตาม กองพลที่ 7 ก็ไม่ได้รับ Cromwells เข้ากองพลจนปี 1944 เมื่อพวกเขาได้กลับสู่สหราชอาณาจักรเพื่อทำการเตรียมตัวสำหรับวันดีเดย์ กองพลได้ใช้รถถัง Cromwell ทำการรบตั้งแต่ฝรั่งเศสไปจนถึงเยอรมันและเข้าร่วมสวนสนามชัยชนะในวันที่ 7 กันยายน 1945 ที่กรุงเบอร์ลิน"

msgid "GB85_Cromwell_Berlin_long_special"
msgstr "รถถังกลางที่รวดเร็วและว่องไวซึ่งสามารถบุกทะลวงเข้าแนวหลังข้าศึกและถอนตัวกลับมาได้อย่างง่ายดาย รถถังคันนี้ติดตั้งปืนที่ใช้ได้ซึ่งแม้จะยิงระหว่างแล่นความเร็วสูงไม่ดี และเกราะที่ค่อนข้างอ่อน แต่ก็ชดเชยด้วยความคล่องตัวที่สูงมาก"

msgid "GB85_Cromwell_Berlin_short"
msgstr "Cromwell B"

msgid "GB85_Cromwell_Berlin_short_special"
msgstr "ความคล่องตัวที่สูงและปืนที่ใช้ได้"

msgid "GB86_Centurion_Action_X"
msgstr "Centurion Action X"

msgid "GB86_Centurion_Action_X_7x7"
msgstr "Centurion Action X 7x7"

msgid "GB86_Centurion_Action_X_7x7_short"
msgstr "Cent. AX 7x7"

msgid "GB86_Centurion_Action_X_CFE_A"
msgstr "Triumphant"

msgid "GB86_Centurion_Action_X_CFE_A_descr"
msgstr "จูล่งนั้นเป็นคนที่สูงและดูน่าเคารพ เขามักขี่ม้าขาวพร้อมกับทวนสีเงิน เขาคือตัวอย่างของนายพลที่ซื่อสัตย์และยอดเยี่ยม เขาเลือกผู้นำของเขาอย่างดีและเลือกที่จะตามเขาจากฉางชานพร้อมกับปฏิญาณที่จะกู้คืนราชวงศ์ฮั่น เขาตีฝ่าการปิดล้อมและบุกเข้าแนวข้าศึกเจ็ดครั้งเพื่อปกป้องเล่าปี่ วีรกรรมอันโดดเด่นของเขามีทั้งที่ฮันต๋งที่เขาขับไล่กองทัพอันทรงพลังของโจโฉและที่หุบเขากิก๊กที่เขานำเหล่าทหารของเขากลับไปยังเมืองหลวง เมื่อไม่ได้ทำการรบ ความเมตตา, ความหลักแหลมและความเสียสละทำให้เขาเป็นตัวแทนของรัฐบุรุษเต็มไปด้วยคุณธรรมของยุคโบราณ"

msgid "GB86_Centurion_Action_X_CFE_A_long_special"
msgstr "Triumphant เป็นรถถังกลางอังกฤษระดับ X นี่คือหนึ่งในยานเกราะที่อเนกประสงค์ที่สุดในระดับโดยมีความคล่องตัวที่ใช้ได้กับปืนสมดุลดีมีมุมกดปืนที่สบาย ในเวลาเดียวกัน เกราะป้อมปืนของมันสามารถกันความเสียหายจากกระสุนมาตรฐานจำนวนมากของพาหนะระดับเดียวกัน"

msgid "GB86_Centurion_Action_X_CFE_A_short"
msgstr "Triumphant"

msgid "GB86_Centurion_Action_X_CFE_A_short_special"
msgstr "ด้วยอาชาขาวและทวนเงินในทุ่งแห่งฉางปัน\n\nชื่อของเขาถูกจารึกอยู่ในคัมภีร์ประวัติศาสตร์พร้อมกับเหล่าวีรบุรุษ"

msgid "GB86_Centurion_Action_X_descr"
msgstr "ป้อมปืน Action X ถูกวางแผนไว้สำหรับรถถัง Centurion รุ่นหลังๆ รถต้นแบบหนึ่งคันมีป้อมปืนติดตั้งบนตัวถังของ Centurion Mark 7 และรถต้นแบบอีกคันถูกใช้สำหรับการทดสอบขีปนวิถี พาหนะที่ติดตั้งป้อมปืน Action X ไม่ได้เข้าสายการผลิตจำนวนมากหรือเข้าประจำการแต่อย่างใด"

msgid "GB86_Centurion_Action_X_short"
msgstr "Centurion AX"

msgid "GB87_Chieftain_T95_turret"
msgstr "Chieftain/T95"

msgid "GB87_Chieftain_T95_turret_descr"
msgstr "การพัฒนาของ FV4201 Chieftain ทำให้สามารถทำการแลกเปลี่ยนปืนกันกับรถถัง T95 ของสหรัฐฯ ด้วยการเปลี่ยนตัวป้อมปืน โครงการถูกยกเลิกลงเนื่องจากปัญหาจำนวนมากในการฝึกพลรถถังเพื่อให้เชี่ยวชาญในการใช้ระบบปืนทั้งสองระบบ"

msgid "GB87_Chieftain_T95_turret_long_special"
msgstr "รถถังกลางอังกฤษระดับ VIII ที่มีปืนอันแม่นยำและมีมุมกด/มุมยกที่ดี เมื่อรวมกับเกราะที่แข็งแกร่ง ป้อมปืนที่สะท้อนกระสุนได้แล้วการใช้ภูมิประเทศเป็นที่กำบังคือยุทธวิธีที่ดีที่สุด อย่างไรก็ตาม ฝาครอบผู้บังคับการที่ใหญ่นั้นก็เป็นจุดอ่อนที่ข้าศึกส่วนใหญ่มักจะเล็งเป็นอันดับแรก"

msgid "GB87_Chieftain_T95_turret_short"
msgstr "Chieftain/T95"

msgid "GB87_Chieftain_T95_turret_short_special"
msgstr "ปืนที่ดีพอตัวและความคล่องตัวที่ยอดเยี่ยม"

msgid "GB88_T95_Chieftain_turret"
msgstr "T95/Chieftain"

msgid "GB88_T95_Chieftain_turret_descr"
msgstr "การพัฒนาเริ่มขึ้นในเดือนกันยายน 1954 โดยมีส่วนประกอบจำนวนมากคล้ายคลึงกับรถต้นแบบ T96 ในช่วงการพัฒนา ป้อมปืนและปืนใหญ่ของรถถังถูกวางแผนให้สามารถใช้ร่วมกับรถถัง FV4201 Chieftain ของอังกฤษได้จากการเปลี่ยนชิ้นส่วนบางส่วน โครงการถูกยกเลิกลงเนื่องจากความยากลำบากในการฝึกพลรถถังที่ต้องเชี่ยวชาญในระบบควบคุมการยิงทั้งสองระบบไปพร้อมกัน"

msgid "GB88_T95_Chieftain_turret_long_special"
msgstr "รถถังหนักอังกฤษระดับ X ที่มีปืนปรับเสถียรอันแม่นยำและมีมุมกด/มุมยกที่ดีแต่มีความทนทานต่ำ รถถังเหมาะกับการยิงสนับสนุนรถถังหนักพันธมิตรและใช้ภูมิประเทศไม่ราบเรียบเป็นที่กำบัง"

msgid "GB88_T95_Chieftain_turret_short"
msgstr "T95/Chieftain"

msgid "GB88_T95_Chieftain_turret_short_special"
msgstr "ปืนที่มีการปรับเสถียรและมุมกด/มุมยกดี"

msgid "GB91_Super_Conqueror"
msgstr "Super Conqueror"

msgid "GB91_Super_Conqueror_7x7"
msgstr "Super Conqueror 7x7"

msgid "GB91_Super_Conqueror_7x7_descr"
msgstr "รุ่นของรถถัง Conqueror ที่มีเกราะป้องกันเพิ่มเติม ผลิตขึ้นในช่วงแรกของทศวรรษ 1950 และถูกนำไปใช้ในการทดสอบขีปนาวุธนำวิถีต่อต้านรถถัง Dart และ Malkara ในช่วงการทดสอบ รถถังคันนี้ปฏิบัติหน้าที่เป็นรถถังหนักที่อาจจะปรากฏขึ้นในอนาคตได้ ไม่มีการนำรถถังรุ่นนี้เข้าสายการผลิตจำนวนมาก"

msgid "GB91_Super_Conqueror_7x7_short"
msgstr "S. Conq. 7x7"

msgid "GB91_Super_Conqueror_descr"
msgstr "รุ่นของรถถัง Conqueror ที่มีเกราะป้องกันเพิ่มเติม ผลิตขึ้นในช่วงแรกของทศวรรษ 1950 และถูกนำไปใช้ในการทดสอบขีปนาวุธนำวิถีต่อต้านรถถัง Dart และ Malkara ในช่วงการทดสอบ รถถังคันนี้ปฏิบัติหน้าที่เป็นรถถังหนักที่อาจจะปรากฏขึ้นในอนาคตได้ ไม่มีการนำรถถังรุ่นนี้เข้าสายการผลิตจำนวนมาก"

msgid "GB91_Super_Conqueror_short"
msgstr "S. Conqueror"

msgid "GB92_FV217"
msgstr "FV217 Badger"

msgid "GB92_FV217_7x7"
msgstr "FV217 Badger 7x7"

msgid "GB92_FV217_7x7_short"
msgstr "Badger 7x7"

msgid "GB92_FV217_descr"
msgstr "โครงการยานพิฆาตรถถังโดยมีรากฐานจากตัวถังของ Conqueror ถูกพัฒนาขึ้นในช่วงปลายทศวรรษ 1940 มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB92_FV217_short"
msgstr "Badger"

msgid "GB93_Caernarvon_AX"
msgstr "Caernarvon Action X"

msgid "GB93_Caernarvon_AX_descr"
msgstr "การพัฒนาต่อของพาหนะที่ออกแบบโดยบริษัท English Electric ภายใต้แนวคิด \"รถถังหลากภารกิจ\" (FV200) โครงการถูกหยุดลงเพื่อหลีกทางให้กับโครงการรถถัง A41 (Centurion) ไม่มีการผลิตรถต้นแบบขึ้นมา"

msgid "GB93_Caernarvon_AX_long_special"
msgstr "รถถังหนักอังกฤษคันนี้ไม่ได้มีความคล่องตัวที่สูงหรือเกราะตัวถังที่ทนทาน แต่มันมีปืนชั้นยอดที่มีอัตราการยิงที่สูงทำให้ทำความเสียหายพาหนะข้าศึกได้จากระยะใดก็ได้ เกราะป้อมปืนด้านหน้าที่ไว้ใจได้และมุมกด/มุมยกปืนที่ใช้ได้ทำให้สามารถทำการยิงจากพื้นที่ไม่ราบเรียบได้อย่างมีประสิทธิภาพ"

msgid "GB93_Caernarvon_AX_short"
msgstr "Caernarvon AX"

msgid "GB93_Caernarvon_AX_short_special"
msgstr "ปืนที่มีประสิทธิภาพและป้อมปืนที่ไว้ใจได้"

msgid "GB94_Centurion_Mk5-1_RAAC"
msgstr "Centurion Mk. 5/1 RAAC"

msgid "GB94_Centurion_Mk5-1_RAAC_descr"
msgstr "รุ่นหลังสงครามของรถถัง Centurion Mk. 5 โดยมีเกราะหน้าที่ปรับปรุงให้ดีขึ้น ปืนกลเพิ่มเติม และเครื่องยนต์ที่ทรงพลังกว่าเดิม รถถังคันนี้มีถังเชื้อเพลิงหุ้มเกราะเพิ่มอีก 100 แกลลอนในส่วนท้ายและไม่ได้ติดตั้งเกราะฉากกั้น รถถังรุ่นนี้เข้าร่วมการรบในหน่วยรถถังออสเตรเลียในสมรภูมิเวียดนาม"

msgid "GB94_Centurion_Mk5-1_RAAC_long_special"
msgstr "รถถังกลางอังกฤษคันนี้ใช้ภูมิประเทศที่ไม่ราบเรียบให้ประโยชน์ด้วยป้อมปืนที่ไว้ใจได้และมุมกด/มุมยกปืนที่ยอดเยี่ยม นอกจากนี้ รถถังยังมีระยะการมองเห็นและการเจาะเกราะของกระสุนชั้นยอด แต่ทั้งนี้เกราะด้านข้างของรถถังนั้นบางและความเร็วในการเคลื่อนที่ก็ไม่ได้เป็นที่น่าประทับใจนัก"

msgid "GB94_Centurion_Mk5-1_RAAC_short"
msgstr "Centurion 5/1"

msgid "GB94_Centurion_Mk5-1_RAAC_short_special"
msgstr "ระยะการมองเห็นที่ใช้ได้ดีและป้อมปืนที่มีเกราะหนา"

msgid "GB95_Ekins_Firefly_M4A4"
msgstr "Sherman VC Firefly"

msgid "GB95_Ekins_Firefly_M4A4_descr"
msgstr "Sherman VC Firefly ของอังกฤษ (กองพันทหารม้าอาสานอร์ทแฮมเชียร์ที่ 1) ถูกตั้งชื่อตามเมือง Velikiye Luki ของโซเวียต ในวันที่ 8 สิงหาคม 1944 กองทัพอังกฤษได้ทำการซุ่มโจมตีที่ชายป่าใกล้กับ Saint-Aignan-de-Cramesnil และ Sento โดย Joe Ekins ที่เป็นพลปืนประจำ Sherman ได้ทำการระดมยิงใส่รถถัง Tigers และทำลายรถถังเยอรมันทั้งสามคันภายใน 12 นาที ซึ่งปรากฏว่าหนึ่งในรถถังที่ใช้หมายเลข 007 นั้นบัญชาการโดย Michael Wittmann เสือรถถังเยอรมันที่ประสบความสำเร็จที่สุด ที่รู้จักกันในอีกชื่อคือ บารอนดำ อย่างไรก็ตาม เหตุการณ์นี้ยังไม่ชัดเจนว่าใครเป็นผู้ที่สังหารรถถังของ Wittmann ได้สำเร็จเนื่องด้วยมีรถถังอังกฤษหลายคันเข้าโจมตีพร้อมกันในการรบครั้งนั้น"

msgid "GB95_Ekins_Firefly_M4A4_long_special"
msgstr "รถถังกลางอังกฤษคันนี้ไม่ได้มีความคล่องตัวหรือเกราะที่ยอดเยี่ยม อย่างไรก็ตาม ปืนชั้นยอดของมันก็สามารถทำความเสียหายไม่ว่าจะในอยู่ระยะใดก็ตาม ในขณะที่ระยะการมองเห็นที่ใช้ได้จะทำให้ตรวจจับพาหนะข้าศึกได้อย่างง่ายดาย"

msgid "GB95_Ekins_Firefly_M4A4_short"
msgstr "Firefly VC"

msgid "GB95_Ekins_Firefly_M4A4_short_special"
msgstr "ปืนที่แม่นยำเจาะเกราะได้มากและมีอัตราการยิงที่สูง"

msgid "GB96_Excalibur"
msgstr "Excalibur"

msgid "GB96_Excalibur_descr"
msgstr "โครงการของยานพิฆาตรถถังสะเทิ้นน้ำสะเทิ้นบกส่งทางอากาศ มีการผลิตรถต้นแบบขนาดจริงขึ้น แต่การพัฒนาต่อถูกหยุดลง"

msgid "GB96_Excalibur_long_special"
msgstr "ยานพิฆาตรถถังคันนี้มีขนาดที่ใหญ่และเกราะบางแต่ก็ชดเชยด้วยคุณลักษณะปืนที่ยอดเยี่ยมและความคล่องตัวที่ดี เมื่อปฏิบัติการในฐานะหน่วยซุ่มยิงที่ว่องไว Excalibur ค่อนข้างมีประสิทธิภาพในการปะทะกับรถถังกลางเนื่องด้วยป้อมปืนของมัน"

msgid "GB96_Excalibur_short"
msgstr "Excalibur"

msgid "GB96_Excalibur_short_special"
msgstr "ปืนที่สมบูรณ์แบบแต่ป้อมปืนไม่ได้หมุนรอบตัว"

msgid "GB97_Chimera"
msgstr "Chimera"

msgid "GB97_Chimera_descr"
msgstr "โครงการสำหรับรถถังหนักอังกฤษที่ออกแบบเพื่อมาต่อกรกับ IS-3 แม้ว่าจะไม่ใช่แนวทางปกติและมีการใช้วิทยาการประกอบรถถังของเยอรมัน โครงการนี้ถูกหยุดลงและมีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB97_Chimera_long_special"
msgstr "ลูกผสมของรถถังกลางและยานพิฆาตรถถัง มันได้รับความคล่องตัวและความว่องไวจากรถถังและความเสียหายต่อนัดจากยานพิฆาตรถถัง คุณลักษณะเหล่านี้ทำให้มันเป็นยานเกราะที่ยอดเยี่ยมในการโจมตีแล้วหนี เข้าตำแหน่งอย่างรวดเร็ว ทำการยิง แล้วถอยกลับสู่ระยะปลอดภัย"

msgid "GB97_Chimera_short"
msgstr "Chimera"

msgid "GB97_Chimera_short_special"
msgstr "ความเสียหายต่อนัดที่ยอดเยี่ยมและความคล่องตัวที่ดี"

msgid "GB98_T95_FV4201_Chieftain"
msgstr "T95/FV4201 Chieftain"

msgid "GB98_T95_FV4201_Chieftain_descr"
msgstr "งานพัฒนารถถังหนักเริ่มขึ้นที่อังกฤษในปี 1951 โดยมีแผนที่จะให้รถถังคันนี้แลกเปลี่ยนอาวุธได้กับทั้ง FV4201 และ T95 ของสหรัฐฯ (รวมไปถึงป้อมปืน) โครงการนี้ถูกหยุดลงเนื่องจากปัญหาการฝึกพลรถถังเพราะต้องทำการปฏิบัติการกับชุดควบคุมการยิงและปืนใหญ่สองชนิดที่แตกต่างกันไปพร้อมกัน"

msgid "GB98_T95_FV4201_Chieftain_long_special"
msgstr "รถถังหนักอังกฤษระดับ X มีปืนที่ทรงพลัง แม่นยำ และปรับเสถียรอย่างดีพร้อมกับมุมกด/มุมยกที่ดี เมื่อเทียบกับคันอื่นๆแล้วรถถังคันนี้มีความคล่องตัวที่ดี ความเร็วที่สูง ระยะการมองเห็นที่น่าประทับใจและเกราะหน้าที่ไว้ใจได้ แต่ระวังเกราะด้านข้างและเกราะหลังของรถถังคันนี้ที่ค่อนข้างเปราะบางให้ดี"

msgid "GB98_T95_FV4201_Chieftain_short"
msgstr "T95/FV4201"

msgid "GB98_T95_FV4201_Chieftain_short_special"
msgstr "ปืนที่ดีและความเสียหายต่อนัดที่สูงอีกทั้งมีเกราะหน้าที่ไว้ใจได้"

msgid "GB99_Turtle_Mk1"
msgstr "Turtle Mk. I"

msgid "GB99_Turtle_Mk1_descr"
msgstr "ยานเกราะบุกทะลวงที่ออกแบบมาสำหรับการบุกปราการของข้าศึก การพัฒนาเริ่มต้นในปี 1943 โดยมีหนึ่งในการออกแบบที่พัฒนาขึ้นจากโครงการของนักศึกษาได้ถูกเสนอที่โรงเรียนวิทยาการรถถัง (เมือง Chertsey ในอังกฤษ) มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "GB99_Turtle_Mk1_long_special"
msgstr "ยานเกราะคันนี้เหมือนกับยานพิฆาตรถถังอังกฤษที่มีห้องทำการรบแบบอยู่กับที่โดยมีการออกแบบเดียวกัน ความเสียหายต่อนัดที่ต่ำ เกราะหน้าที่ดีและความคล่องตัวที่แย่ แต่ตัวปืนนั้นมีความแม่นยำและความเสียหายต่อนาทีที่สมบูรณ์แบบในขณะที่มุมกด/มุมยกของปืนทำให้สามารถยิงได้จากตำแหน่งใดก็ได้อย่างมีประสิทธิภาพ"

msgid "GB99_Turtle_Mk1_short"
msgstr "Turtle I"

msgid "GB99_Turtle_Mk1_short_special"
msgstr "ความเสียหายต่อนาทีสูงและเกราะที่ไว้ใจได้"

