msgstr "?empty?"

msgid "special_style/well_deserved_award_2023_1"
msgstr "ความทรงจำหอมหวาน"

msgid "special_style/well_deserved_award_2023_1_desc"
msgstr "รูปแบบทุกฤดูที่มีรูปตำแหน่งในเกมที่โด่งดัง"

msgid "special_style/well_deserved_award_2023_1_desc/long"
msgstr "หลังการรบหนึ่งหรือสองครั้ง แผนที่จะเริ่มชัดเจนขึ้น หลังจากการรบหลายสิบครั้ง มันจะง่ายในการหาเส้นทางและหลังจากการรบร้อยครั้งในแผนที่เดียวกัน คุณจะหยุดสังเกตไม่ได้ว่าจะมีจุดบางจุดที่คุ้นเคย เมื่อเวลาผ่านไป ผู้การแต่ละคนจะมีตำแหน่งโปรดของตัวเอง เช่นพุ่มไม้ที่ดูไม่ได้น่าสงสัยแต่เป็นของ \"พวกเขา\" อย่างแน่นอนและแม้กระทั่งเพลงที่จำสลับกับเพลงอื่นไม่ได้"

msgid "special_style/well_deserved_award_2023_2"
msgstr "ผู้การรถถังผ่านศึก"

msgid "special_style/well_deserved_reward_2025"
msgstr "มือเก่า"

msgid "special_style/well_deserved_reward_2025_desc"
msgstr "รูปแบบทุกฤดูที่ฉลองการเดินทางใน World of Tanks ของคุณ"

msgid "special_style/well_deserved_reward_2025_desc/long"
msgstr "รูปแบบทุกฤดูมอบให้กับผู้เล่น World of Tanks จากการยอมรับความอุทิศตนให้กับศิลปะแห่งการบัญชาการรถถัง รูปแบบนี้จะวิวัฒนาการไปตามประสบการณ์ของคุณที่เพิ่มขึ้น เปลี่ยนสีไปตามแต่ละยศรางวัลที่คู่ควรใหม่เพื่อให้ทุกคนได้รู้ว่าใครเป็นผู้การรถถังที่เจนศึกที่สุด!"

msgid "special_style/western_warriors"
msgstr "นักรบแห่งแดนตะวันตก"

msgid "special_style/western_warriors_desc/long"
msgstr "\"กับทุกดาบแหลม เราได้หล่อเกราะขึ้นมา กับทุกธนูที่น้าว เราได้สร้างกำแพงที่เจาะไม่ได้ และสำหรับทุกเสียงคำรามของคนเถื่อน เราก็ตอบสนองด้วยพระวจนะของพระองค์ พวกนายมาปล้นทองจากวิหารของเราแต่นายจะได้เพียงเหล็กกลับไป เข้ามาเลยและสิ่งเดียวที่นายจะได้เห็นจะเป็นหน้าอันบิดเบี้ยวด้วยความกลัวของพวกนายเองที่สะท้อนจากหมวกสะท้อนแสงของเรา นายพูดว่าแดนของเราเต็มไปด้วยฉนวนแห่งสงคราม เข้ามาเลยแล้วเราจะแสดงให้พวกนายเห็นว่าฉนวนเหล่านั้นถูกจุดด้วยสิ่งใด\nเดชะพระนามพระบิดา\nและพระบุตร\nและพระจิต\""

msgid "special_style/wg_fest_2019"
msgstr "งาน WG Fest 2019"

msgid "special_style/wgfest_style_01"
msgstr "WG Fest"

msgid "special_style/white_tiger_2020"
