msgid "A100_T49_LS_BOT"
msgstr "Lost Grenadier"

msgid "A100_T49_LS_BOT_descr"
msgstr "รุ่นดัดแปลงของรถถังเบา M41 โดยมีป้อมปืนที่ใหญ่ขึ้นและติดตั้งปืน 90มม. การทดสอบเริ่มขึ้นในวันที่ 5 พฤษภาคม 1954 การทดสอบถือว่าประสบความสำเร็จแต่รถถังรุ่นนี้ไม่ได้เข้าสายการผลิตจำนวนมากเนื่องจากไม่ได้รับความสนใจจากฝ่ายเสนาธิการของทหาร"

msgid "A100_T49_LS_BOT_short"
msgstr "Lost"

msgid "A12_T32_LS_BOT"
msgstr "Guard T32"

msgid "A12_T32_LS_BOT_descr"
msgstr "รถถังหนักอเมริการุ่นทดลองในสงครามโลกครั้งที่สอง พัฒนาขึ้นโดย M26 Pershing และ T29 เป็นพื้นฐาน รถต้นแบบถูกสร้างขึ้นในปี 1946 อย่างไรก็ตาม T32 ก็ไม่ได้เข้าประจำการและสายการผลิตจำนวนมาก"

msgid "A12_T32_LS_BOT_short"
msgstr "Guard"

msgid "A12_T32_LS_PLAYER"
msgstr "T32"

msgid "A12_T32_LS_PLAYER_descr"
msgstr "รถถังหนักอเมริการุ่นทดลองในสงครามโลกครั้งที่สอง พัฒนาขึ้นโดย M26 Pershing และ T29 เป็นพื้นฐาน รถต้นแบบถูกสร้างขึ้นในปี 1946 อย่างไรก็ตาม T32 ก็ไม่ได้เข้าประจำการและสายการผลิตจำนวนมาก"

msgid "A130_Super_Hellcat_LS_BOT"
msgstr "นักธนู"

msgid "A130_Super_Hellcat_LS_BOT_descr"
msgstr "นักธนู"

msgid "A130_Super_Hellcat_LS_BOT_short"
msgstr "นักธนู"

msgid "A35_Pershing_LS_BOT"
msgstr "Guard Pershing"

msgid "A35_Pershing_LS_BOT_descr"
msgstr "รถถังกลางอเมริกาที่ตั้งชื่อเป็นเกียรติให้แก่นายพล John Pershing ที่นำกองกำลังนอกประเทศของอเมริกาในสงครามโลกครั้งที่หนึ่ง ในปี 1944-1946 ในกองทัพบกสหรัฐฯ รถถัง M26 ถูกจัดระดับเป็นรถถังหนัก แต่ตั้งแต่เดือนกุมภาพันธ์ รถถังเหล่านี้เข้าร่วมการรบในสงครามโลกครั้งที่สอง ในปี 1950-1951 รถถังรุ่นนี้ก็ได้เข้าร่วมการรบในสงครามเกาหลี"

msgid "A35_Pershing_LS_BOT_short"
msgstr "Guard"

msgid "A63_M46_Patton_LS_BOT"
msgstr "Guard M46 Patton"

msgid "A63_M46_Patton_LS_BOT_descr"
msgstr "พัฒนาในปี 1948-1949 M46 Patton เป็นรุ่นที่ปรับปรุงให้ทันสมัยและดีกว่าเดิมของ M26 Pershing มียอดการผลิตจำนวนทั้งสิ้น 1,168 คันและรุ่นพื้นฐาน 2 รุ่น ซึ่งถูกผลิตในช่วงระหว่างปี 1941 และ 1951 รถถัง Patton ถูกใช้อย่างแพร่หลายในสงครามเกาหลี"

msgid "A63_M46_Patton_LS_BOT_short"
msgstr "Guard"

msgid "A66_M103_LS_BOT"
msgstr "Guard M103"

msgid "A66_M103_LS_BOT_descr"
msgstr "การพัฒนาเริ่มตั้งแต่ปี 1948 ในปี 1952 มีการสั่งการผลิต 300 คันเพื่อใช้ในสงครามเกาหลี โดยรู้กันในชื่อ M103"

msgid "A66_M103_LS_BOT_short"
msgstr "Guard"

msgid "A69_T110E5_LS_BOT"
msgstr "Guard T110E5"

msgid "A69_T110E5_LS_BOT_descr"
msgstr "พัฒนาขึ้นในปี 1952 เพื่อให้เป็นรถถังหนักพร้อมด้วยอาวุธที่ทรงพลังกว่าเดิมเมื่อเทียบกับ T-43 (M103) มีการจำกัดขนาดรถถังไว้เพื่อให้รถถังสามารถผ่านอุโมค์แคบในเทือกเขาแอลปส์ได้ มีการพิจารณาการออกแบบหลายแบบแต่โครงการก็ถูกยกเลิกและไม่มีการผลิตรถถังขึ้นมาแต่อย่างใด"

msgid "A69_T110E5_LS_BOT_short"
msgstr "Guard"

