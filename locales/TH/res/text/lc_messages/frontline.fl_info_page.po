msgstr "แรงฮึดสู้"

msgid "reserves/sectionSecondBreath/text"
msgstr "เวลาเตรียมการของกำลังสำรองรบนั้นลดลงอีก 70% เมื่อกลับสู่การรบด้วยพาหนะใหม่"

msgid "rules/backToFight/header"
msgstr "การกลับสู่การรบ"

msgid "rules/backToFight/text"
msgstr "ถ้าพาหนะของคุณถูกทำลาย ให้เลือกพาหนะคันอื่นที่มีเพื่อกลับเข้าสู่การรบและทำการต่อสู้เพื่อคว้าชัยชนะให้ได้ คุณสามารถเลือกหนึ่งในจุดวางกำลังที่มีบนแนวรบได้รวมถึงจุดเกิดในแนวหลังที่จะช่วยให้คุณวางแผนการรบของคุณเองได้ ผู้เล่นทีมป้องกันจะมีตัวเลือกจุดเกิดที่หลากหลายมากกว่าซึ่งหมายความว่าพวกเขาสามารถรวมตัวกันป้องกันฐานป้อมปืนใหญ่ได้ในกรณีที่มีการบุกทะลวงฉับพลัน ระบบจะยังมีเครื่องหมายพิเศษที่เตือนผู้เล่นว่าจุดเกิดดังกล่าวนั้นมีอันตรายสูงหากเลือกจะวางกำลังในจุดที่เลือกเอาไว้"

msgid "rules/base/header"
msgstr "การยึดฐาน"

msgid "rules/base/textBottom"
msgstr "การทำความเสียหายพาหนะ (หรือชิ้นส่วน) ในระหว่างการยึดฐานจะไม่ตั้งการยึดใหม่ แต่จะทำให้การยึดหยุดลงชั่วคราว ในการลบการยึดทั้งหมด ทีมป้องกันต้องทำลายพาหนะข้าศึกทุกคันในวงฐานหรือขับไล่ข้าศึกออกจากวงฐานให้ได้ ทีมป้องกันจะไม่สามารถยึดฐานกลับได้เมื่อทีมจู่โจมยึดไปแล้ว"

msgid "rules/base/textTop"
msgstr "{FFE4C0_Start}ทีมจู่โจม{FFE4C0_End}จะต้องยึดฐานตามลำดับเพื่อเข้าสู่เป้าหมายหลัก ฐานที่ยึดได้จะเพิ่มเวลาการรบให้ 2 นาที การยึดฐานสุดท้ายจะเพิ่มเวลาให้ 4 นาที"

msgid "rules/sectionHeader"
msgstr "กฎทั่วไป"

msgid "rules/service/header"
msgstr "วงเติมเสบียง"

msgid "rules/service/text"
msgstr "วงเติมเสบียงจะคืนความทนทาน พาหนะ รักษาพลรถถังที่บาดเจ็บ ทุกนาย และเติมกระสุนให้ {FFE4C0_Start}อัตราการเติมจะเป็นดังต่อไปนี้: 100 ความทนทาน / หนึ่งพลรถถัง / 10%{FFE4C0_End} ของกระสุนต่อวินาที"

msgid "rules/weapons/header"
msgstr "เป้าหมาย: 3 จาก 5 ป้อมปืนลำกล้องใหญ่"

msgid "rules/weapons/list/back"
msgstr "เกราะหลัง: {{@ colorLegacy 'FFE4C0'}}90 มม.{{/}}"

msgid "rules/weapons/list/roof"
msgstr "กระสุน {{@ colorLegacy 'FFE4C0'}}ไม่สามารถเจาะ{{/}} เกราะหน้าและเกราะหลังคาได้"

msgid "rules/weapons/list/sides"
msgstr "เกราะข้าง: {{@ colorLegacy 'FFE4C0'}}180 มม.{{/}}"

msgid "rules/weapons/list/sides_9"
msgstr "เกราะข้าง: {{@ colorLegacy 'FFE4C0'}}210 มม.{{/}}"

