msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "แหล่งพลังแปรปรวนกำลังใกล้เข้ามา แน่นอนว่ามันเป็นรถถังใหญ่มหึมา"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "ทำลายมันหรือเราจะจบเห่ ไปลุยกันเลยทุกคน!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "ยิงที่จุดอ่อนในเกราะ"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "พวก ยักษ์ใหญ่น่าเกลียดกำลังเดินทางมาหาเรา"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "ซึ่งเป็นแบบที่เราไม่เคยเห็นมาก่อน"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "จุดอ่อนของมันเหมือนจะเห็นได้ชัด เราต้อง"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "ทำลายหัวหน้าใหญ่เพื่อเป็นยังสถานีสัญญาณและปฏิบัติภารกิจให้สำเร็จ"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "พวก นี่คือวันโชคดีของเรา! หัวหน้าใหญ่สองคันแทนที่จะเป็นคันเดียว"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "นั่นก็ถือเป็นของใหม่ แต่เราจะชนะไม่ว่าจะยังไงก็ตาม ยิงไปที่จุดอ่อน"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "ที่เกราะของมันและอย่าลืมทำลายองครักษ์ของมัน"

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "นี่เป็นคู่ต่อสู้ที่น่ากลัวแต่มันก็มีจุดอ่อน"

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "ทำลายเจ้าตัวร้ายนี้แล้วทุกอย่างก็จะจบลง ไปลุยกันเลยพวก!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "ยิงที่จุดอ่อนข้าศึกและอย่าลืมที่จะทำลาย"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "ลูกน้องของมันเพราะไม่งั้นมันจะยากกว่าเดิม"

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "เราต้องทำลายหัวหน้าเพื่อไปยังพลังแปรปรวน"

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "เล็งที่จุดอ่อนในเกราะของมัน"

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "เราจำเป็นต้องทำลายคู่ต่อสู้สุดท้ายนี้เพื่อให้บรรลุภารกิจ"

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "ยิงที่จุดอ่อนของมัน"

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "นี่คืออุปสรรคสุดท้ายของเรา"

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "พยายามหน่อยพวก! มาทำลายสัตว์ประหลาดนี้กัน!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "ข้าศึกนั้นอันตรายมากแต่มันก็มีจุดอ่อน"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "นี่คือโอกาสของเราในการกำจัดมันให้สิ้นซาก"

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "ตอนนี้เราก็ได้เห็นแล้วว่าพลังแปรปรวนเตรียมอะไรให้เรา"

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "คู่ต่อสู้ที่แข็งแกร่งแต่ก็มีจุดอ่อน"

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "ทุกคน มาทำลายสัตว์ร้ายนี้กัน!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "นี่เป็นข้าศึกที่แข็งแกร่งแต่ผมก็รู้ว่าเราทำได้"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "สองหัวหน้าในราคาหัวหน้าเดียวของวันนี้"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "มากันเลยนี่เป็นข้อเสนอร้อนแรง! เล็งไปที่จุดอ่อน"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "ในเกราะแล้วทำลายสัตว์ร้ายเหล่านี้กัน!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "ดูเหมือนหัวหน้าจะจำลำดับไม่ได้แล้ว"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "ออกมาลุยพร้อมกัน ทั้งสองคันต่างก็มีจุดอ่อน เล็งไปที่มันเลย"

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "คู่หัวหน้าใหญ่ที่ดีอีกแล้ว พวกคุณก็รู้ว่าต้องทำอย่างไร"

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "หาจุดอ่อนของมันแล้วเก็บกวาดลูกน้องที่ตามมา"

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "ให้เร็วล่ะ!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "ทุกคน เราถล่มมันเละเลย!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "แต่ดูเหมือนงานของเรายังไม่เสร็จสิ้น"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "ดีมาก! แต่นี่มันก็แค่ครึ่งทาง"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "มันจะกลับมาพร้อมเพื่อนๆของมัน"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "นั่นแหละใช้ได้เลย! มาซ่อมรถถังของเราแล้วไปต่อกัน"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "มันจะไม่แพ้ง่ายๆแน่นอน เตรียมตัวสำหรับยกสองได้"

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "เราถล่มมันได้สาหัสทีเดียวทุกคน แต่มันยังไม่จบลง"

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "ดีมาก! แต่นี่มันก็แค่ครึ่งทาง"

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "พวกมันจะกลับมาพร้อมเพื่อนๆของมัน"

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "นั่นแหละใช้ได้เลย! มาซ่อมรถถังของเราแล้วไปต่อกัน"

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "พวกมันจะไม่แพ้ง่ายๆแน่นอน เตรียมตัวสำหรับยกสองได้"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "นี่คือร้อยเอกสมิธ ระหว่างที่คนของเราอยู่นอกรอยแยก"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "และกำลังต้านทานการโจมตีของรถถังเสียงสะท้อนในนิคมบาบิลอน"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "ภารกิจของเราก็คือการผ่านห้วงมิติทั้งหมดแล้วปิดพลังแปรปรวนลง"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "ในการทำเช่นนั้น เราจะเป็นต้องเติมเครื่องเก็บในทุกห้วงมิติให้เต็ม ออกเดินทางได้!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "เราพบฐานทัพข้าศึกลึกเข้าไปในพื้นที่ของ Mirium"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "พวกมันกำลังเตรียมกองทัพขนาดใหญ่สำหรับการบุก โอกาสเดียวของเรา"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "ในการหยุดพวกมันคือการขวางเส้นทางพวกมัน ภารกิจของเราเป็นการเข้า"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "ไปในห้วงลึกของพลังแปรปรวนแล้วดึงเครื่องส่งสัญญาณที่"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "ทำให้เส้นทางของมันเปิดอยู่ เติม Magnus ด้วย Mirium ให้เต็ม"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "เพราะเรากำลังจะไปให้สุดทาง!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "สวัสดีทุกคน สิ่งที่เราต้องทำคือการปิดเส้นทางสู่โลกของเราไม่ให้"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "รถถังเสียงสะท้อนข้ามมาได้ หน่วยต่อต้านข่าวกรองเราสามารถจัดการเหล่าสายลับ"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "ที่บาบิลอนได้ งานของเราคือ Mirium เติมเครื่องเก็บให้เต็มในทุกห้วงมิติ"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "ถล่มเจ้าพวกที่กำลังรอเราอยู่ข้างล่างนั่น"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "แล้วปิดหลุมนี้กัน เดินเครื่องของคุณได้!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "นี่คือสมิธ งานของเราคือการปิดรอยแยกที่พื้นที่นิคมบาบิลอน"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "เติมเครื่องสะสมให้เต็มด้วย Mirium แล้วทำลาย"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "ทุกอย่างที่ไม่ใช่พวกเรา ไปกันเลยทุกคน ข้าศึกกำลังรออยู่!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "คนของเรากำลังต้านทานรถถัง Mirium จากการตีฝ่า"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "เข้ามายังโลกของเรา ภารกิจของคุณคือการปิดรอยแยกดังกล่าว"

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "ยิ่งเร็วก็ยิ่งดี สะสม Mirium แล้วปิดรอยแยกนั้นให้ได้"

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "รถถังข้าศึกกำลังโจมตีนิคมบาบิลอนอยู่ เจ้าโสโครกนั่น"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "กำลังไต่ออกมาจากรอยแยกมิติและเราต้องขวางทางพวกมัน"

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "เดินทางลึกเข้าไปในพลังแปรปรวนแล้วกำจัดมันที่ต้นตอ ไปกันเลย!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "นี่คือสมิธ ภารกิจของเราคือการปิดกองทัพรถถังเสียงสะท้อนของเยอรมัน"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "เอาไว้ในพลังแปรปรวน เป้าหมายของเรากำลัง"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "อยู่ในห้วงมิติลึก ให้เติม Magnus จนเต็มเพื่อเข้าไปถึงมัน"

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "เราพบฐานทัพข้าศึกในห้วงลึกของแดน Mirium"

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "พวกมันวางแผนจะโจมตีจากที่นั่น"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "ไม่ต้องไปสนใจเด็กสาวคนนั้น ภารกิจของเราคือการเปิด"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus แล้วเปิดเส้นทางไปยังห้วงมิติที่ลึกที่สุด"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "เพื่อให้เราล็อคข้าศึกไว้ที่นั่นเป็นการถาวร"

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "พบฐานทัพข้าศึกในห้วงมิติที่ลึกที่สุด"

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "เราไม่สามารถจัดการมันได้ในตอนนี้ แต่เราดักมันเอาไว้ในนั้นได้"

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "สะสม Mirium เพื่อไปยังก้นบึ้งของรอยแยกมิตินี้"

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "ทุกคนฉันเชื่อในคุณ! พวกเราทำได้!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "รอยแยกใหม่เปิดทันทีที่รอยแยกก่อนหน้าปิดลง"

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "ภารกิจของเรายังเหมือนเดิม: สะสมสสารและ"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "ปิดพลังแปรปรวนเพื่อหยุดการโจมตีโลกของเรา ไปกันเลย!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "รอยแยกได้เปิดขึ้นอีกครั้ง สะสมสสารและเติมเครื่องเก็บให้เต็ม"

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "เราจำเป็นต้องปิดพลังแปรปรวนนั่น พวกหน่วยรบที่อยู่ข้างนอก"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "กำลังพึ่งพาเราอยู่แต่พวกเขาจะต้านทานเอาไว้ไม่ได้นานนัก!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "นิคมบาบิลอนกำลังถูกโจมตีจากรถถังของข้าศึก"

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "สะสมสสารแล้วเพิ่มพลังให้ Magnus เราจำเป็นต้องปิด"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "พลังแปรปรวนเพื่อหยุดรถถังเสียงสะท้อนไม่ให้บุกเข้าโลกของเรา"

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "เป้าหมายเราอยู่ไม่ไกล ระวังตัวแล้วดูที่"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "ตัวตรวจับรถถังอมตะให้ดี"

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "ทำได้ดีมากทุกคน! พยายามเข้าล่ะ"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "เราไม่ได้มาพักกินน้ำชาที่นี่ เราต้องใช้ Mirium มากขึ้น"

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "ทำงานได้เยี่ยมมาก! เราไปต่อกัน เราต้องใช้ Mirium มากขึ้น"

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "ดีมาก! เราต้องเปิด Magnus เพื่อให้เข้าไปได้ลึกกว่าเดิม"

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium จะทำให้เราแข็งแกร่งมากขึ้นในทุกๆห้วงมิติ"

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "แต่อย่าเพิ่งเหลิงไปล่ะ"

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "เราต้องเปิด Magnus ให้ได้ พยายามอีกหน่อย!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "ภารกิจของเรายังคงเหมือนเดิม เราต้องเติมเครื่องรวมสสารให้เต็ม"

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "เรากำลังไปถึงต้นกำเนิดของการบุกนี้แล้ว"

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "งานของเรายังเหมือนเดิม เติมเครื่องรวมสสารให้เต็ม"

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
