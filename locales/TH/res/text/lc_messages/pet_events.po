msgstr "คืนนี้เป็น {{@ style (color $color)}}คืน{{/}}{{@ style (color $color)}}วันเพ็ญ{{@ style (color $defaultColor)}}{{/}}{{/}}ด้วยเวทมนตร์ของ{{@ style (color $color)}}แสงจันทร์{{/}} {{@ style (color $color)}}เจ้าตูบ{{/}}หอนเกือบไม่หยุดจนกระทั่ง {{@ style (color $color)}}ยามเช้า{{@ style (color $defaultColor)}}{{/}}{{/}}{{@ style (color $color)}}เหล่าทหาร{{/}} ที่ตื่นได้พยายามทุกอย่างเพื่อกล่อม{{@ style (color $color)}}เจ้าตูบ{{/}}แต่ก็ดูเหมือนว่าไม่มีอะไรได้ผล"

msgid "text/event_9"
msgstr "ในช่วง {{@ style (color $color)}}การทดสอบ{{/}} ก็เกิด {{@ style (color $color)}}ไฟไหม้{{/}} ที่หนึ่งใน {{@ style (color $color)}}กลุ่มรถถัง{{@ style (color $defaultColor)}}{{/}}{{/}} ก่อนที่จะมีใครตอบสนอง {{@ style (color $color)}}สุนัข{{/}} ของคุณก็ได้พุ่งเข้าไปยัง{{@ style (color $color)}}ยานเกราะ{{/}}{{@ style (color $color)}}ที่กำลังไหม้{{/}} และช่วย{{@ style (color $color)}}พลรถถัง{{/}} {{@ style (color $color)}}หนี{{/}}ออกมาได้{{@ style (color $defaultColor)}}{{/}} เรื่องราวของ {{@ style (color $color)}}ความกล้า{{/}} เช่นนี้แพร่กระจายอย่างรวดเร็วไปทั่ว {{@ style (color $color)}}ฐานทัพ{{/}}"

