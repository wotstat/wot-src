msgid "F06_ARL_44"
msgstr "ARL 44"

msgid "F06_ARL_44_descr"
msgstr "พัฒนาขึ้นโดยแผนกออกแบบของ Atelier de Construction de Rueil ในช่วงสงครามโลกครั้งที่สอง รถถังคันนี้ใช้รากฐานของ B1 Bis ที่ล้าสมัยและติดตั้งปืนที่ทันสมัยและทรงพลังกว่าเดิม รถถังรุ่นนี้ถือว่าไม่ประสบความสำเร็จเมื่อเทียบกับรถถังจากประเทศอื่นๆ มียอดการผลิตรถถังทั้งหมด 60 คัน"

msgid "F06_ARL_44_short"
msgstr "ARL 44"

msgid "F07_AMX_M4_1945"
msgstr "AMX M4 mle. 45"

msgid "F07_AMX_M4_1945_descr"
msgstr "การพัฒนาของรถถังหนักรุ่นนี้เริ่มขึ้นในปีคริสตศักราช 1945 ได้มีการใช้ลักษณะการออกแบบของ Pz.Kpfw. VI Ausf. B Tiger II ที่มีอยู่ในแบบพิมพ์เขียวเท่านั้น ต่อมา AMX M4 (1945) ก็ได้กลายมาเป็นรถต้นแบบของ AMX 50 100"

msgid "F07_AMX_M4_1945_short"
msgstr "AMX M4 45"

msgid "F08_AMX_50_100"
msgstr "AMX 50 100"

msgid "F08_AMX_50_100_descr"
msgstr "รถถังหนัก AMX 50 100 เป็นการพัฒนาต่อของโครงการ M4 รถต้นแบบคันแรกถูกสร้างขึ้นในปี 1949 รถถังขนาด 55 ตันคันนี้ติดตั้งปืน 100 มม.บนป้อมปืนแบบส่าย รถต้นแบบมีการทดสอบด้วยเครื่องยนต์เบนซินและดีเซลในช่วงปี 1950 ถึง 1952 รถถังรุ่นนี้ไม่ได้เข้าสายการผลิตจำนวนมากหรือเข้าประจำการในกองทัพ"

msgid "F08_AMX_50_100_short"
msgstr "AMX 50 100"

msgid "F09_AMX_50_120"
msgstr "AMX 50 120"

msgid "F09_AMX_50_120_descr"
msgstr "รถต้นแบบของรถถัง AMX 50 พัฒนาขึ้นในช่วงต้นทศวรรษ 1950 โดยได้รับอิทธิพลจาก IS-3 และ T-10 ของโซเวียต รถถังมีการติดตั้งเกราะรุ่นพัฒนาและปืนใหญ่ขนาด 120 มม.บนป้อมปืนแบบส่าย"

msgid "F09_AMX_50_120_short"
msgstr "AMX 50 120"

msgid "F100_Panhard_EBR_90"
msgstr "Panhard EBR 90"

msgid "F100_Panhard_EBR_90_descr"
msgstr "ในช่วงต้นทศวรรษ 1960 ปืนขนาด 75 มม.นั้นถือว่าเป็นอาวุธที่ล้าสมัยแล้ว ในช่วงปี 1963-1964 มียานเกราะ 650 คันที่ติดตั้งป้อมปืนแบบ FL 11 ได้รับการติดอาวุธใหม่เป็นปืนขนาด 90 มม.เพื่อเพิ่มอำนาจการยิงให้สูงขึ้น ส่วนยานเกราะคันอื่นๆที่ยังติดตั้งปืนที่ถือว่าล้าสมัยก็ถูกปลดประจำการจากกองทัพบกฝรั่งเศส"

msgid "F100_Panhard_EBR_90_short"
msgstr "EBR 90"

msgid "F106_Panhard_EBR_75_Mle1954"
msgstr "Panhard EBR 75 (FL 10)"

msgid "F106_Panhard_EBR_75_Mle1954_descr"
msgstr "ในปี 1954-1955 มียานเกราะ Panhard EBR ได้รับการติดตั้งป้อมปืน AMX 13 75 FL 10 เพื่อเพิ่มอำนาจการยิงของยานเกราะซึ่งมีวงแหวนป้อมปืนแบบเดียวกันและไม่จำเป็นต้องมีการดัดแปลงตัวถังรถ ยานเกราะที่พัฒนาให้ทันสมัยคันนี้ถูกนำเข้าประจำการเฉพาะในกองทัพบกฝรั่งเศสเท่านั้น"

msgid "F106_Panhard_EBR_75_Mle1954_long_special"
msgstr "ยานเกราะติดล้อแบบสี่เพลาที่มีรูปแบบการเคลื่อนที่สองแบบคือ: แล่นปกติและแบบรวดเร็ว ระยะการมองเห็นที่ปานกลางและอำนาจการยิงที่ต่ำนั้นชดเชยจากการมีความเร็วและความคล่องตัวที่น่าประทับใจ นอกจากนี้การซ่อนตัวที่ดียังทำให้ยานเกราะคันนี้ปฏิบัติหน้าที่เป็นหน่วยลาดตระเวนเคลื่อนที่มีประสิทธิภาพที่สุดกับการลอบโจมตีและเล็ดลอดเข้าแนวหลังข้าศึก"

msgid "F106_Panhard_EBR_75_Mle1954_short"
msgstr "EBR 75 FL 10"

msgid "F106_Panhard_EBR_75_Mle1954_short_special"
msgstr "ความเร็วและความคล่องตัวที่ยอดเยี่ยม การปรับเสถียรปืนและการซ่อนตัวที่ดี"

msgid "F107_Hotchkiss_EBR"
msgstr "Hotchkiss EBR"

msgid "F107_Hotchkiss_EBR_descr"
msgstr "การพัฒนายานเกราะคันนี้เป็นส่วนหนึ่งของโครงการที่ได้รับอนุมัติจากฝ่ายเสนาธิการทหารในช่วงปี 1945 ในปี 1949 บริษัท Hotchkiss ได้ทำการเสนอรถต้นแบบสามเพลาล้อเข้ามา หลังจากการทดสอบ โครงการก็ถูกระงับ รถต้นแบบที่สร้างขึ้นไม่ได้หลงรอดมาถึงทุกวันนี้"

msgid "F107_Hotchkiss_EBR_short"
msgstr "EBR Hotch."

msgid "F108_Panhard_EBR_105"
msgstr "Panhard EBR 105"

msgid "F108_Panhard_EBR_105_descr"
msgstr "รุ่นดัดแปลงของยานเกราะ Panhard EBR ที่ติดตั้งอาวุธที่ทรงพลังกว่าเดิม ยานเกราะคันนี้ใช้ช่วงล่างรุ่นปรับปรุงและป้อมปืน GIAT TS 90 ที่ใช้พลประจำสองนายและยกระดับให้รองรับปืนขนาด 105 มม. ยานเกราะคันนี้ไม่ได้เข้าสายการผลิตจำนวนมากหรือเข้าประจำการในกองทัพแต่อย่างใด"

msgid "F108_Panhard_EBR_105_short"
msgstr "EBR 105"

msgid "F109_AMD_Panhard_178B"
msgstr "Panhard AMD 178B"

msgid "F109_AMD_Panhard_178B_descr"
msgstr "การผลิตของยานเกราะ Panhard AMD 178 ที่พิสูจน์ตัวเองมาแล้ว โดยมีติดตั้งป้อมปืน FL 1 แบบใหม่ ปืน SA 35 ขนาด 47 มม.กับปืนกลร่วมแกนได้เริ่มขึ้นอีกครั้งหลักสงครามโลกครั้งที่สอง การพัฒนาป้อมปืนใหม่เริ่มขึ้นในปี 1940 แต่หยุดลงเมื่อฝรั่งเศสแพ้การรบ รถต้นแบบใหม่ได้รับรหัสเรียกขานเป็น Panhard AMD 178B ยานเกราะที่ผลิตขึ้นมาได้เข้าร่วมการรบในอินโดจีน แอฟริกาตอนเหนือ และตะวันออกใกล้"

msgid "F109_AMD_Panhard_178B_short"
msgstr "AMD 178B"

msgid "F10_AMX_50B"
msgstr "AMX 50 B"

msgid "F10_AMX_50B_descr"
msgstr "การพัฒนาเริ่มต้นขึ้นในปี 1951 โดย DEFA หรือแผนกออกแบบอาวุธของรัฐ ในช่วงปี 1958 AMX 50 B ได้รับการปรับปรุงจำนวนมากซึ่งรวมถึงรูปทรงที่เล็กลง ตัวถังหล่อ และป้อมปืนส่ายแบบใหม่พร้อมด้วยปืนใหญ่ขนาด 120 มม. ถึงแม้ว่ากำลังเครื่องยนต์ Maybach จะมีเพียง 1000 แรงม้า ผู้เชี่ยวชาญจากบริษัท Gruppe M ของเยอรมันก็ได้พยายามหาวิธีที่จะทำให้พาหนะรุ่นนี้สามารถทำความเร็วได้ถึง 65 กม./ชม. มีเพียงรถต้นแบบที่ผลิตสำเร็จเพียงคันเดียว"

msgid "F10_AMX_50B_short"
msgstr "AMX 50 B"

msgid "F110_Lynx_6x6"
msgstr "Panhard AML Lynx 6x6"

msgid "F110_Lynx_6x6_descr"
msgstr "รุ่นพัฒนาต่อของยานเกราะ Panhard AML ที่ติดตั้งช่วงล่างขับเคลื่อนหกล้อ ป้อมปืนใหม่และอาวุธที่ทรงพลังกว่าเดิม"

msgid "F110_Lynx_6x6_short"
msgstr "Lynx 6x6"

msgid "F111_AM39_Gendron_Somua"
msgstr "AM 39 Gendron-Somua"

msgid "F111_AM39_Gendron_Somua_descr"
msgstr "รถต้นแบบคันแรกของยานเกราะรุ่นนี้ถูกพัฒนาในช่วงปี 1932 ถึง 1934 ภายใต้การดูแลของวิศวกรชื่อ Gendron รถต้นแบบคันที่สองที่ประกอบในปี 1935 ผ่านการทดสอบได้สำเร็จ โครงการนี้เกือบถูกยกเลิกจากการที่ทุนทรัพย์ไม่เพียงพอแต่บริษัท SOMUA ก็เลือกที่จะทำการพัฒนาต่อ รถต้นแบบรุ่นปรับปรุงถูกผลิตขึ้นในปี 1938 และเข้าทำการทดสอบสำเร็จในช่วงปี 1938 ถึง 1939 มีการนำยานเกราะบางส่วนเข้าประจำการแต่ไม่มีการผลิตจำนวนมากเนื่องจากการผลิตป้อมปืนล่าช้าเกินที่จะป้อนให้กับการผลิตได้ทัน"

msgid "F111_AM39_Gendron_Somua_long_special"
msgstr "ถือว่าเป็นยานเกราะที่ไม่ปกติของระดับที่สามารถเข้าตำแหน่งสำคัญได้ในพริบตา และใช้สภาพภูมิประเทศไม่ราบเรียบเป็นประโยชน์ได้ด้วยมุมกด/มุมยกปืนที่ดี เกราะที่บอบบางทำให้ต้องทำการรบอย่างระมัดระวังและใช้ความเร็วที่มีหลบหนีและรักษาความทนทานเอาไว้"

msgid "F111_AM39_Gendron_Somua_short"
msgstr "AM Gendron"

msgid "F111_AM39_Gendron_Somua_short_special"
msgstr "ความเร็วและอัตราการยิงที่ยอดเยี่ยม"

msgid "F112_M10_RBFM"
msgstr "M10 RBFM"

msgid "F112_M10_RBFM_descr"
msgstr "พาหนะชนิดนี้เข้าประจำการในกองทัพบกฝรั่งเศสตั้งแต่ปี 1943 ถึง 1944 ในปี 1944 มีพาหนะ 36 คันในสังกัดกรมยานล่ารถถังอาณานิคมภายใต้บัญชาการของ Silvère Seurat ซึ่งเป็นวิศกรปืนใหญ่ทหารเรือได้ทำการติดตั้งศูนย์เล็งของปืนเรือที่ทำให้สามารถเพิ่มระยะการยิงถึง 3,000 เมตร นักแสดงฝรั่งเศสชื่อดัง Jean Gabin (ชื่อเกิด Jean-Alexis Moncorgé) ได้เข้าประจำการในกองทัพโดยปฏิบัติหน้าที่เป็นผู้บังคับการยานพิฆาตรถถังรุ่นนี้"

msgid "F112_M10_RBFM_long_special"
msgstr "ยานพิฆาตรถถังคันนี้ติดตั้งปืนพลังทำลายล้างสูงที่มีมุมกดที่ดีแต่ก็แลกกับเกราะที่บางและขนาดยานเกราะที่ใหญ่ ยานเกราะคันนี้เหมือนกับ M10 Wolverine ที่วิจัยได้แต่ไม่ได้มีความคล่องตัวที่สูงเนื่องจากใช้เครื่องยนต์ที่กำเนิดกำลังได้น้อยกว่า แต่ในขณะเดียวกัน ปืนที่แม่นยำจะทำให้คุณสามารถทำความเสียหายจากระยะไกลและหลีกเลี่ยงการถูกยิงสวนจากข้าศึกได้"

msgid "F112_M10_RBFM_short"
msgstr "M10 RBFM"

msgid "F112_M10_RBFM_short_special"
msgstr "ปืนพลังที่ทรงพลังมีมุมกด/มุมยกชั้นดี"

msgid "F113_Bretagne_Panther"
msgstr "Bretagne Panther"

msgid "F113_Bretagne_Panther_descr"
msgstr "รุ่นดัดแปลงของ Panther คันนี้ถูกผลิตขึ้นในเดือนสิงหาคม 1943 ถึงมิถุนายน 1944 รุ่นดัดแปลง Ausf.A นั้นใช้ป้อมปืนและแท่นลูกปืนปืนใหญ่ใหม่ ยังมีการปรับกล้องเล็งให้ทันสมัยขึ้นอีกด้วย มียอดการผลิตรถถังรุ่นนี้ 2,300 คัน ในปี 1944 หลังจากที่สัมพันธมิตรได้ยกพลขึ้นบกที่นอร์มังดี มีรถถังบางส่วนถูกยึดโดยกองกำลังฝรั่งเศสและถูกนำมาใช้ในการรบกับเยอรมัน"

msgid "F113_Bretagne_Panther_long_special"
msgstr "รถถัง Panther คันนี้รวมคุณลักษณะเด่นของรถถังกลางทั้งหมดเอาไว้ในคันเดียวไม่ว่าจะเป็น ปืนที่แม่นยำมีอัตราการยิงสูง ความคล่องตัวที่ดีและความเร็วสูงสุดที่มากรวมกับตัวถังลาดเอียงที่มีแผ่นเกราะซึ่งไว้ใจได้ แต่จำไว้ว่าขนาดที่ใหญ่ของรถถังเป็นจุดด้อยและพยายามอย่าให้ถูกยิงโดยเฉพาะที่ด้านข้าง"

msgid "F113_Bretagne_Panther_short"
msgstr "Bret. Panther"

msgid "F113_Bretagne_Panther_short_special"
msgstr "ปืนที่ยิงเร็วและแม่นยำอีกทั้งความคล่องตัวที่ดี"

msgid "F114_Projet_4_1"
msgstr "Char Futur 4"

msgid "F114_Projet_4_1_descr"
msgstr "ในฝรั่งเศสปี 1977 ในฐานะส่วนหนึ่งของการพัฒนารถถังใหม่ ได้มีการพิจารณาการออกแบบจำนวนมากซึ่งรวมไปถึง Projet 4 ด้วย แต่แล้วก็ไม่มีการผลิตรถต้นแบบจากโลหะขึ้นมา อย่างไรก็ตาม การพัฒนาต่อของการออกแบบนี้ได้นำไปสู่การสร้างรถถังรบหลัก Leclerc ของฝรั่งเศสขึ้นในเวลาต่อมา"

msgid "F114_Projet_4_1_long_special"
msgstr "รถถังกลางฝรั่งเศสระดับ IX ติดตั้งระบบป้อนซองกระสุน รถถังคันนี้ต่างจากพาหนะทั่วไปจากการมีความทนทานที่เพิ่มขึ้น การเจาะเกราะที่สูง และความแม่นยำที่ใช้ได้ รถถังคันนี้มีความเร็วที่ดีในสนามรบและทำการยิงระยะไกลได้อย่างมีประสิทธิภาพ อย่างไรก็ตาม โปรดจำไว้ว่าเวลาบรรจุกระสุนนั้นไม่ได้เร็วนักซึ่งคุณต้องเลือกเป้าหมายให้ดี"

msgid "F114_Projet_4_1_short"
msgstr "Char Futur 4"

msgid "F114_Projet_4_1_short_special"
msgstr "ระบบป้อนซองกระสุนและการเจาะเกราะที่ดี"

msgid "F115_Lorraine_50t"
msgstr "Lorraine 50 t"

msgid "F115_Lorraine_50t_descr"
msgstr "โครงการรถถังกลางฝรั่งเศสที่พัฒนาขึ้นในปี 1950 ซึ่งมีการติดตั้งปืนขนาด 120 มม.บนตัวถังของรถถังทดลองคันต่างๆเช่น Lorraine 40 t ที่ได้รับการทดสอบในช่วงเวลาเดียวกัน โครงการนี้หยุดลงที่ช่วงการร่างแบบพิมพ์เขียว"

msgid "F115_Lorraine_50t_long_special"
msgstr "รถถังหนักระดับ IX ที่ยังคงแนวคิดของยานเกราะเร็วมีอำนาจการยิงสูงซึ่งมีต้นแบบจาก Lorraine 40 t ป้อมปืนที่ทนทานซึี่งมีปืนบรรจุปกติติดตั้งเอาไว้บนระบบช่วงล่างที่เป็นที่คุ้นเคยอันดี ความคล่องตัวยังคงเป็นเช่นเดิมแต่มีเกราะหน้าที่หนาขึ้น อย่างไรก็ตาม เป้าหมายของรถถังยังคงเดิมคือการสนับสนุนพันธมิตร"

msgid "F115_Lorraine_50t_short"
msgstr "Lorraine 50 t"

msgid "F115_Lorraine_50t_short_special"
msgstr "ความคล่องตัวที่ยอดเยี่ยมและปืนที่แม่นยำ"

msgid "F116_Bat_Chatillon_Bourrasque"
msgstr "Bat.-Châtillon Bourrasque"

msgid "F116_Bat_Chatillon_Bourrasque_DV"
msgstr "Miel"

msgid "F116_Bat_Chatillon_Bourrasque_DV_descr"
msgstr "รถถังกลางสัญชาติฝรั่งเศสที่ถูกดัดแปลงเพื่อส่งของขวัญและของที่ระลึกเป็นการเร่งด่วน (มักระเบิดบ่อยครั้ง) พลรถถังของมันประกอบด้วยหมีเท็ดดี้ที่เป็นได้ทุกอย่างยกเว้นทำตัวน่ารักเมื่อเข้าสู่การรบรถถัง ความคล่องตัวและปืน 105 มม. ที่ไม่น่าเชื่อทำให้พาหนะสามารถสร้างหายนะรุนแรงเหนือจินตนาการในสนามรรบ—และยังคงเป็นพาหนะที่น่ารักที่สุดในชุดสะสมของนักขับรถถัง"

msgid "F116_Bat_Chatillon_Bourrasque_DV_long_special"
msgstr "รถถังที่ว่องไวมีปืนที่ทรงพลังซึ่งใช้ระบบป้อนกระสุนแบบสองนัด เกราะที่บางและความทนทานที่ต่ำทำให้มันไม่เหมาะกับการรบในแนวหน้า แต่ในอีกทางหนึ่ง ความคล่องตัวและความเร็วที่สูงทำให้มันสามารถตีโอบในมุมที่ไม่คาดคิดเช่นด้านข้างหรือด้านหลังของข้าศึก ยิงกระสุนสองนัดติดต่อกันแล้วหลบหนีเพื่อบรรจุชุดใหม่แล้ววนกลับมาโจมตีอีกครั้ง"

msgid "F116_Bat_Chatillon_Bourrasque_DV_short"
msgstr "Miel"

msgid "F116_Bat_Chatillon_Bourrasque_DV_short_special"
msgstr "ความคล่องตัวและการอำพรางที่ดี ซองกระสุนที่มีประสิทธิภาพ"

msgid "F116_Bat_Chatillon_Bourrasque_descr"
msgstr "โครงการรถถังฝรั่งเศสที่พัฒนาขึ้นโดย Batignolles-Châtillon รถถังคันนี้ถูกมุ่งหมายให้ติดตั้งป้อมปืนที่มีพลประจำสองนายและรองรับปืนขนาด 105 มม.ได้ มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F116_Bat_Chatillon_Bourrasque_long_special"
msgstr "รถถังที่ว่องไวมีปืนที่ทรงพลังซึ่งใช้ระบบป้อนกระสุนแบบสองนัด เกราะที่บางและความทนทานที่ต่ำทำให้มันไม่เหมาะกับการรบในแนวหน้า แต่ในอีกทางหนึ่ง ความคล่องตัวและความเร็วที่สูงทำให้มันสามารถตีโอบในมุมที่ไม่คาดคิดเช่นด้านข้างหรือด้านหลังของข้าศึก ยิงกระสุนสองนัดติดต่อกันแล้วหลบหนีเพื่อบรรจุชุดใหม่แล้ววนกลับมาโจมตีอีกครั้ง"

msgid "F116_Bat_Chatillon_Bourrasque_short"
msgstr "Bourrasque"

msgid "F116_Bat_Chatillon_Bourrasque_short_special"
msgstr "ความคล่องตัวและการอำพรางที่ดี ซองกระสุนที่มีประสิทธิภาพ"

msgid "F117_Alt_Proto_AMX_30"
msgstr "AltProto AMX 30"

msgid "F117_Alt_Proto_AMX_30_descr"
msgstr "ในปี 1958 บริษัท AMX ได้เริ่มทำการพัฒนารถถังกลางใหม่ภายใต้โครงการ Franco-German Standardpanzer (รถถังมาตรฐาน) ซึ่งมุ่งหมายให้เป็นยานเกราะขนาด 30 ตันมีความคล่องตัวสูงและใช้ปืนที่ทรงพลัง ในเบื้องต้น รถถังของโครงการได้รับรหัสเรียกขานเป็น Char 30 AP และติดตั้งปืน 105 มม. F1 ของฝรั่งเศสเอาไว้ แต่ในช่วงระหว่างการพัฒนา รถถังคันนี้ก็มีการปรับแต่งอย่างต่อเนื่องจนทำให้กลายเป็น AMX 30 ในที่สุด โครงการถูกหยุดลงหลังจากได้มีการสร้างรถต้นแบบไม้ขึ้นมาหนึ่งคัน"

msgid "F117_Alt_Proto_AMX_30_long_special"
msgstr "รถถังกลางฝรั่งเศสพิเศษระดับ VIII ที่มีการเจาะเกราะใช้ได้และมุมกด/มุมยกปืนที่ดี รถถังคันนี้มีความคล่องตัวที่ดีและสามารถใช้ประโยชน์จากภูมิประเทศไม่ราบเรียบได้ด้วยการใช้แผ่นเกราะปืนที่มี อย่างไรก็ตามระวังความทนทานที่ต่ำกับเกราะที่บางของมันและหลีกเลี่ยงการรบในพื้นที่เปิดโล่งให้ดี"

msgid "F117_Alt_Proto_AMX_30_short"
msgstr "A.P. AMX 30"

msgid "F117_Alt_Proto_AMX_30_short_special"
msgstr "ความคล่องตัว มุมกด/มุมยกปืนและการเจาะเกราะที่ดี"

msgid "F118_Char_Mle_75"
msgstr "Char Mle. 75"

msgid "F118_Char_Mle_75_descr"
msgstr "การพัฒนารถถังคันนี้เริ่มขึ้นในปี 1975 มีการติดตั้งระบบช่วงล่างลมผสมน้ำมันและล้อรองรับที่ใช้เป็นล้อขับของยานเกราะ ในด้านนี้ Char Mle. 75 นั้นเหมือนกับยานเกราะฝรั่งเศสคันอื่นๆ ป้อมปืนของมันนั้นถือว่าเป็นแบบที่ได้รับความนิยมในยุคนั้นจากการมีรูปทรงที่ต่ำที่สุดเท่าที่จะเป็นไปได้ ทำให้พลรถถังทั้งหมดต้องประจำอยู่ในตัวถัง รถถังคันนี้ถูกออกแบบมาให้มีขนาดเล็กอย่างมากและมีความคล่องตัวสูง"

msgid "F118_Char_Mle_75_long_special"
msgstr "รถถังเบาฝรั่งเศสพิเศษระดับ IX ที่มีคุณลักษณะโดดเด่นสองอย่างพร้อมกันคือ เครื่องยนต์กังหันแก๊สและกลไกการยิงแบบเป็นชุด ด้วยคุณลักษณะดังกล่าว รถถังเบาคันนี้นั้นสมบูรณ์แบบอย่างมากสำหรับการปฏิบัติหน้าที่เป็นหน่วยสอดแนมเคลื่อนที่และหน่วยไล่ล่ารถถังเบาข้าศึก"

msgid "F118_Char_Mle_75_short"
msgstr "Char Mle. 75"

msgid "F118_Char_Mle_75_short_special"
msgstr "กลไกการยิงเป็นชุดและเครื่องยนต์กังหันแก๊ส"

msgid "F119_Char_Murat"
msgstr "Char Murat"

msgid "F119_Char_Murat_descr"
msgstr "โครงการรถถังนี้มีสองจุดเด่นหลักคือการปรับห้องทำการรบใหม่และระบบขับเคลื่อนตัวหนอนสองวงที่ตามผู้พัฒนานั้นสามารถเร่งอำนาจการยิงและความคล่องตัวได้ แผ่นกั้นแบ่งห้องทำการรบเป็นห้องพลรถถังและห้องปืนแยกจากกัน ระบบป้อนกระสุนอัตโนมัติประกอบด้วยระบบป้อนกระสุนหลักสามนัดและรางกลไกช่วยเหลือ การออกแบบนี้ทำให้สามารถบรรจุปืนและเติมรางกระสุนหลักโดยไม่ต้องยึดปืนในมุมบรรจุกระสุนเฉพาะและเพิ่มอัตราการยิงอย่างมากและทำให้พลรถถังปฏิบัติงานได้อย่างสะดวก วงตีนตะขาบนั้นแบ่งออกเป็นสองส่วนที่ทำให้รถถังรักษาความคล่องตัวได้แม้จะแล่นทับทุ่นระเบิด อย่างไรก็๖าม ระบบขับเคลื่อนตัวหนอนสองวงทำให้ตัวถังมีน้ำหนักเพิ่มขึ้นและทำให้ขับและเลี้ยวได้ยากขึ้น โครงการนี้ไม่ได้พัฒนาพ้นช่วงขึ้นแบบพิมพ์เขียว"

msgid "F119_Char_Murat_long_special"
msgstr "Char Murat เป็นรถถังกลางฝรั่งเศสระดับ IX ที่มีความคล่องตัวอันน่าประทับใจและอำนาจการยิงที่ดีจากการมีปืน 105 มม.ที่ใช้โม่กระสุนสามนัด รถถังคันนี้ยังมีความว่องไวที่ยอดเยี่ยม, การปรับเสถียรที่ดีพอตัวและเวลาบรรจุระหว่างนัดที่เร็ว Char Murat นั้นเป็นยานสนับสนุนที่ยอดเยี่ยมทำให้คุณสามารถเข้าโจมตี, เข้ายิงและถอนตัวได้อย่างสบาย"

msgid "F119_Char_Murat_short"
msgstr "Char Murat"

msgid "F119_Char_Murat_short_special"
msgstr "ระบบบรรจุโม่กระสุน, ความคล่องตัวและความว่องไวสูง"

msgid "F120_Projet_Louis"
msgstr "Projet Louis"

msgid "F120_Projet_Louis_descr"
msgstr "รถถังเบารุ่นทดลองนั้นมีความแตกต่างจากการจัดวางแบบดั้งเดิม ตัวเครื่องยนต์และระบบส่งกำลังหลักนั้นถูกวางเอาไว้ที่ส่วนหน้าในขณะที่ระบบหล่อเย็นนั้นติดตั้งเอาไว้ที่ด้านหลัง เครื่องยนต์รุ่น 880-10 ที่มีการจัดวางลูกสูบแบบเรียงทำให้รถถังมีความคล่องตัวที่ยอดเยี่ยมและระบบขับเคลื่อนเฟืองหนอนคู่ที่ติดตั้งล้อขับสองล้อ ผู้การรถถังและพลปืนจะประจำในป้อมปืนขนาดย่อมที่มีรูปทรงต่ำและมีหน้าตัดด้านหน้าและด้านข้างเล็ก ดังเช่นการพัฒนาของฝรั่งเศสแบบอื่นๆ ปืนสามารถผงกขึ้นแนวตรงได้ด้วยการยกส่วนหลังคาป้อมปืนเหนือลำกล้องบรรจุกระสุน แต่เนื่องด้วยข้อจำกัดเวลาและงบประมาณทำให้โครงการปิดตัวลงในช่วงขึ้นแบบพิมพ์เขียว"

msgid "F120_Projet_Louis_long_special"
msgstr "Projet Louis เป็นรถถังเบาฝรั่งเศสระดับ IX ที่มีการจัดวางไม่ปกติ ระบบปืนอัตโนมัติ 75 มม.มีตับกระสุนที่มีกระสุนจำนวนมากและเวลาบรรจุระหว่างตับที่สั้นและเวลาบรรจุเต็มที่เร็ว มันออกแบบมาเพื่อการยิงอย่างต่อเนื่องแม้จะทำความเสียหายที่น้อยแต่ต่อเนื่องใส่ข้าศึก"

msgid "F120_Projet_Louis_short"
msgstr "Projet Louis"

msgid "F120_Projet_Louis_short_special"
msgstr "ปืนบรรจุอัตโนมัติ, ความคล่องตัวที่ดี"

msgid "F122_VCS_6x6_TS90"
msgstr "VCS 6x6 TS 90"

msgid "F122_VCS_6x6_TS90_descr"
msgstr "VCS 6x6 TS 90 นั้นพัฒนาขึ้นมาสำหรับการส่งออกยานลาดตระเวนที่สามารถเข้าทำการต่อสู้กับรถถังได้ การออกแบบนั้นมีความคล้ายคลึงอย่างที่สุดกับยานลำเลียงพล Renault VAB ยานเกราะนี้ถูกนำเสนอให้สื่อมวลชนเห็นในเดือนมิถุนายน 1976 อย่างไรก็ตาม ยานเกราะก็ไม่ได้เข้าสายการผลิตจำนวนมาก โครงการนี้ได้นำไปสู่การพัฒนา VBC-90"

msgid "F122_VCS_6x6_TS90_long_special"
msgstr "VCS 6x6 TS 90 เป็นรถถังเบาล้อฝรั่งเศสระดับ IX ที่มีความคล่องตัวอันยอดเยี่ยมและมีความเร็วเดินหน้าและถอยหลังสูง รถถังนี้ไม่ได้มีรูปแบบการขับเคลื่อนคู่และการเปลี่ยนรูปแบบไปมา ตัวรถถังติดตั้งปืนปรับเสถียร 90 มม.ที่มีเวลาการเล็งดีและโม่กระสุนสองนัดที่มีความเร็วเวลาบรรจุระหว่างนัดในเวลาเพียง 1.5 วินาที"

msgid "F122_VCS_6x6_TS90_short"
msgstr "VCS 6x6"

msgid "F122_VCS_6x6_TS90_short_special"
msgstr "ยานเกราะล้อ, โม่กระสุน 2 นัด"

msgid "F123_ERAC_105_Proto"
msgstr "ERAC 105 Proto"

msgid "F123_ERAC_105_Proto_descr"
msgstr "โครงการของยานลาดตระเวนหุ้มเกราะสะเทิ้นน้ำสะเทิ้นบก (ฝรั่งเศส: engin de reconnaissance amphibie de combat) จากช่วงต้นทศวรรษ 1960 รถต้นแบบใช้งานได้จริงเริ่มประกอบในปี 1963 ยานเกราะนี้มีน้ำหนักเบาแต่ก็มีอำนาจการยิงสูงและสามารถแล่นข้ามช่องน้ำได้ ความได้เปรียบของมันคือความสามารถแล่นข้ามภูมิประเทศที่ดีทั้งในโคลนและหิมะในขณะที่ตัวถังอลูมิเนียมทำให้มีการป้องกันตัวที่ดีกว่ายานสะเทิ้นน้ำสะเทิ้นบกส่วนใหญ่ของยุคนั้น แม้ว่าจะการทดสอบจะให้ผลในทางบวก ERAC 105 Proto ก็ไม่ได้เข้าประจำการเนื่องด้วยเหตุผลทางเศรษฐกิจ"

msgid "F123_ERAC_105_Proto_long_special"
msgstr "ERAC 105 Proto เป็นรถถังเบาฝรั่งเศสระดับ IX มีมุมกดปืน -8° ที่น่าประทับใจ ขนาดที่ย่อมของมันทำให้เป็นหน่วยลาดตระเวนชี้เป้าแบบไม่เผยตัวที่ยอดเยี่ยมในขณะที่ความแม่นยำชั้นยอดและความเสียหายต่อนาทีที่ดีพอตัวทำให้ความเสียหายได้อย่างมีประสิทธิภาพ ปืน 105 มม.ที่มีนั้นถือเป็นปืนที่ยิงได้หนักที่สุดนบรรดารถถังเบาระดับเดียวกัน"

msgid "F123_ERAC_105_Proto_short"
msgstr "ERAC 105 Pr"

msgid "F123_ERAC_105_Proto_short_special"
msgstr "ความเสียหายต่อนัดสูง ขนาดย่อม"

msgid "F124_AMX_13FL11"
msgstr "AMX 13 (FL 11)"

msgid "F124_AMX_13FL11_descr"
msgstr "แม้จะมีความต้องการที่จะส่งรถถัง AMX-13 คันใหม่ไปยังอินโดจีน มันก็ไม่ได้เหมาะกับสมรภูมิดังกล่าวนัก ป้อมปืนและปืนใหญ่ของมันใหญ่เกินไปในขณะที่ระบบป้อนกระสุนอัตโนมัติของมันนั้นก็ราคาแพง, บำรุงรักษายากและแทบจะไม่มีประโยชน์เพราะข้าศึกแทบจะไม่มียานเกราะเลย นอกจากนี้ สิ่งที่ต้องควรใช้คือรถถังเบาที่สามารถขนส่งทางอากาศได้ ซึ่งนั่นทำให้มีการติดตั้ง AMX-13 ด้วยป้อมปืน FL-11 จากยานเกราะ Panhard EBR โดยไม่มีระบบป้อนกระสุนอัตโนมัติ การไม่มีระบบนี้ทำให้สามารถใช้กระสุนที่หลากหลายมากขึ้นเพื่อทำการสนับสนุนเหล่าทหารราบ มียอดการสั่งผลิตรถถังรุ่นนี้ 20 คัน แต่มีการผลิตขึ้นเพียงแค่ห้าคัน หลังจากสงครามกับเวียตนามจบลงในปี 1954 รถถังที่เหลือก็ถูกส่งไปประจำที่โมรอคโคที่ปฏิบัติงานจนกระทั่งปลดประจำการ"

msgid "F124_AMX_13FL11_long_special"
msgstr "รถถังลูกผสมคันนี้ใช้ตัวถังจาก AMX 13 และป้อมปืน FL 11 จากยานเกราะ Panhard EBR และมีการติดตั้งปืน 75 มม.แบบดั้งเดิมเอาไว้ซึ่งมีคุณลักษณะเกือบเหมือนกับปืน 75 มม.ที่ติดตั้งเอาไว้บนรถถังเบาฝรั่งเศสคันอื่นๆ รถถังคันนี้มีความคล่องตัวที่ยอดเยี่ยม, ความเร็วสูงสุด/ความเร็วถอยหลังที่มากและมีการอำพรางที่ดี"

msgid "F124_AMX_13FL11_short"
msgstr "AMX 13 FL 11"

msgid "F124_AMX_13FL11_short_special"
msgstr "การอำพรางที่ดีและความคล่องตัวชั้นยอด"

msgid "F127_AMX_ELC_901"
msgstr "AMX ELC 901"

msgid "F127_AMX_ELC_901_descr"
msgstr "ELC AMX 901 นั้นเป็นต้นแบบแรกของรถถังที่ออกแบบภายใต้โครงการ Engin Léger de Combat (ยานรบเบา) การทดสอบเกิดขึ้นในปี 1955 ทำให้เห็นข้อผิดพลาดทางการออกแบบหลายประการ รุ่นปรับปรุงของรถถังในชื่อ AMX ELC 90 bis ก็ได้รับการแก้ไขอย่างถี่ถ้วนและทำการเปลี่ยนแปลงที่จำเป็นทั้งหมด มันแตกต่างอย่างมากจากรถต้นแบบและถือได้ว่าเป็นยานเกราะแบบใหม่คนละแบบจากคันต้นแบบ"

msgid "F127_AMX_ELC_901_long_special"
msgstr "AMX ELC 901 เป็นรถถังเบาฝรั่งเศสระดับ VI ที่เรียกได้ว่าเป็นรุ่นดัดแปลงของ AMX ELC bis ที่ปลดล็อคได้ รถถังคันนี้มีความได้เปรียบแบบเดียวกันคือรูปทรงที่ต่ำอย่างมาก, การอำพรางที่ยอดเยี่ยมและความคล่องตัวชั้นยอด ด้วยปืน 90 มม.ที่ติดตั้งเอาไว้ ทำให้มุมการหมุนป้อมปืนจำกัดที่ 30° จากการที่รถถังมีขนาดเล็ก"

msgid "F127_AMX_ELC_901_short"
msgstr "AMX ELC 901"

msgid "F127_AMX_ELC_901_short_special"
msgstr "ความเสียหายต่อนัดสูง การอำพรางตัวยอดเยี่ยม"

msgid "F128_SFAC_105"
msgstr "SFAC 105"

msgid "F128_SFAC_105_descr"
msgstr "หลังสงครามโลกครั้งที่สอง ฝรั่งเศสได้รับการออกแบบยานเกราะจำนวนมากของเยอรมันรวมไปถึงเอกสารของยานพิฆาตรถถังตระกูล Waffenträger และยานรบหลากภารกิจที่มีระบบปืนคู่ด้วย ผลของการศึกษาข้อมูลเหล่านี้ทำให้ฝรั่งเศสเริ่มสร้างชุดยานพิฆาตรถถังขึ้นมาใหม่โดยหนึ่งในนั้นเป็น SFAC 105 ที่มีความคล่องตัวดีและปตอ.สองกระบอก อย่างไรก็ตาม โครงการนี้ไม่ได้คืบหน้าถึงช่วงสร้างยานต้นแบบเพราะแทนที่จะสร้างยานพิฆาตรถถัง ฝรั่งเศสก็เริ่มทำการพัฒนาปืนใหญ่สนามอัตตาจรแทน"

msgid "F128_SFAC_105_long_special"
msgstr "ยานพิฆาตรถถังเกราะเบาฝรั่งเศสที่ติดตั้งปืนลำกล้องคู่เอาไว้ ชุดเล็งรุ่นทดลองที่มีทำให้สามารถเล็งอย่างรวดเร็วและเพิ่มความแม่นยำการยิงในขณะที่เวลาบรรจุกระสุนเร็วทำให้ SFAC 105 ทำการรบเหมือนมีโม่กระสุนสองนัด อย่างไรก็ตาม แม้จะมีความคล่องตัวที่ยอดเยี่ยม ยานเกราะคันนี้ก็มีการป้องกันตัวขั้นพื้นฐานเท่านั้น"

msgid "F128_SFAC_105_short"
msgstr "SFAC 105"

msgid "F128_SFAC_105_short_special"
msgstr "ระบบปืนลำกล้องคู่, ความคล่องตัวที่ดี"

msgid "F129_ARL_44_BPXIV"
msgstr "Char de transition"

msgid "F129_ARL_44_BPXIV_descr"
msgstr "เรารู้ดีว่าการยึดครองนั้นไม่สามารถอยู่ได้ตลอดไป ลองนึกดูสิ พวกเขาคิดว่าผู้คนชาวฝรั่งเศสจะยอมหรือ? เป็นไปไม่ได้ มันมีเหตุผลอยู่ว่าทำไมทั่วโลกรู้เกี่ยวกับการปฏิวัติในฝรั่งเศส ไม่มีใครทำให้เราใช้ชีวิตแบบนั้นได้ ใช่ว่าเราจะยอมศิโรราบให้กับทุกคำสั่งที่นายของเราส่งมา การเป็นคนฝรั่งเศสคือความรักในเสรีภาพ ฉะนั้นเมื่อพวกเขาพยายามจะแย่งมันไปจากเราในครั้งนี้ แม้จะเป็นเวลาที่มืดมนที่สุด ผมก็ยังเชื่อในฝรั่งเศสอยู่เสมอ และเมื่อการรบมาถึงนอร์มังดี ในฐานะชาวนอร์มังเอง ผมก็รู้ว่านั่นคือเวลาที่จะแสดงให้เห็นว่าพวกเราเป็นใครและยืนหยัดเพื่อสิ่งใด"

msgid "F129_ARL_44_BPXIV_long_special"
msgstr "รถถังหนักรุ่นทดลองนี้เข้าร่วมการยกพลขึ้นบกที่นอร์มังดีในช่วงสงครามโลกครั้งที่สอง เหล่าวิศวกรฝรั่งเศสพยายามอย่างมากที่จะออกแบบรถถังหนักในยุคนั้นและมีเพียงรถต้นแบบเดียวที่นำออกทำการรบในสนามรบ รถถังคันนี้ได้รับอนุมัติให้เข้าประจำการในแบบจำกัดและต่อมาถูกนำมาผลิตจำนวนมากก่อนที่จะจบสงครามโลกครั้งที่สอง"

msgid "F129_ARL_44_BPXIV_short"
msgstr "CDT"

msgid "F129_ARL_44_BPXIV_short_special"
msgstr "ปืมที่ทรงพลัง, เกราะหน้าที่ดี"

msgid "F130_Sentinelle"
msgstr "Sentinelle"

msgid "F130_Sentinelle_descr"
msgstr "โครงการร่วมของกระทรวงกลาโหมอิตาลีและฝรั่งเศสที่ได้รับชื่อว่า Sentinelle ได้มีการนำ Char Lourd AP 58 เป็นรากฐานของยานเกราะและนำป้อมปืนกับอาวุธจากอิตาลีมาติดตั้ง ในขณะที่กล้องเล็งและอุปกรณ์สื่อสารเป็นของฝรั่งเศส รถถังคันนี้ถูกออกแบบให้มีรูปทรงที่ค่อนข้างต่ำและมีอาวุธที่ทรงพลัง อย่างไรก็ตาม เนื่องด้วยการปรับกระสุนให้เป็นมาตรฐานตามสนธิสัญญาแอตแลนติคเหนือ (NATO) รถถังคันนี้ก็ไม่มีความจำเป็นอีกต่อไป โครงการนี้ถูกหยุดลงก่อนที่จะมีการสร้างรถต้นแบบขึ้นมา"

msgid "F130_Sentinelle_long_special"
msgstr "Sentinelle เป็นรถถังหนักฝรั่งเศสระดับ IX แต่ด้วยความคล่องตัว, ขนาดและเกราะที่มีทำให้มันเหมือนรถถังกลางมากกว่า มีเพียงป้อมปืนด้านหน้าที่มีเกราะหนาพอ จุดเด่นหลักของรถถังคือปืนใหญ่บรรจุโม่สองนัดที่รวดเร็วและมีการควบคุมดีทำความเสียหายต่อนัดได้ 390 หน่วย ขนาดที่เล็ก, ความคล่องตัวที่ดีและมุมกดปืนที่ใช้ได้ดีนั้นทำให้มันมีประสิทธิภาพเมื่อทำการรบแบบรถถังกลาง"

msgid "F130_Sentinelle_short"
msgstr "Sentinelle"

msgid "F130_Sentinelle_short_special"
msgstr "ปืนบรรจุอัตโนมัติเร็ว ความคล่องตัวดี"

msgid "F131_Brennos"
msgstr "Brennos"

msgid "F131_Brennos_descr"
msgstr "หลังจากสงครามโลกครั้งที่สอง ทางฝรั่งเศสได้ตัดสินใจที่จะสร้างรถถังหนักโดยใช้ประสบการณ์ที่ได้รับเป็นปัจจัยการออกแบบ มีการพิจารณาการโครงการออกแบบรถถังหนักฝรั่งเศสของทั้งช่วงก่อนและระหว่างสงคราม เห็นได้ชัดว่าการออกแบบของเยอรมันมีอิทธิพลต่อชิ้นส่วนและส่วนประกอบหลายอย่างเนื่องจากฝรั่งเศสมีข้อมูลจำนวนมากเกี่ยวกับรถถัง Panther และ King Tiger ทางฝรั่งเศสได้พิจารณายืมแนวคิดจากแม้กระทั่งสหภาพโซเวียตด้วยการพยายามสร้างรูปทรงหัวทวนที่โด่งดังของ IS-3 ในรถถังคันใหม่ แม้ว่าป้อมปืนจะคล้ายกับ King Tiger ก็มีการวางแผนใช้ป้อมปืนแบบหล่อขึ้นรูปด้วยความรู้เพิ่มเติมของฝรั่งเศสในแบบฝาครอบผู้การและปืน 20 มม.สองกระบอก ในระหว่างการพัฒนาโดยละเอียดก็เห็นได้ชัดว่าแนวคิดรถถังนี้ถือว่าล้าสมัยแล้วและถ้านำรถถังเข้าสู่การผลิตจำนวนมาก รถถังก็จะถือว่าล้าสมัย โครงการนี้ไม่มีการพัฒนาพ้นช่วงร่างแบบพิมพ์เขียว"

msgid "F131_Brennos_long_special"
msgstr "Brennos นั้นมีปืนที่ถือว่าใช้ได้ดีสำหรับรถถังหนักระดับ VIII โดยมีการปรับเสถียร, อำนาจเจาะเกราะและเวลาเล็งที่ยอดเยี่ยม เครื่องยนต์ที่ทรงพลังทำให้เร่งความเร็๋วได้ดีในช่วงเวลาสั้นๆ อย่างไรก็ตาม รถถังนี้มีเกราะตัวถังที่ถือว่าปานกลางและมีจุดอ่อนป้อมปืนที่ใหญ่"

msgid "F131_Brennos_short"
msgstr "Brennos"

msgid "F131_Brennos_short_special"
msgstr "การปรับเสถียรที่ยอดเยี่ยม อำนาจการเจาะเกราะสูง"

msgid "F132_Vercingetorix"
msgstr "Vercingétorix"

msgid "F132_Vercingetorix_descr"
msgstr "โครงการพัฒนาขึ้นในช่วงกลางทศวรรษ 1950 เพื่อเป็นตัวเลือกโครงการ AMX 50 ตัวถังนั้นออกแบบเพื่อให้ต่ำที่สุดเท่าที่จะทำได้และได้มีการใช้แนวเทคนิคหลายอย่างที่องค์ประกอบของ AMX 30 ที่จะเกิดขึ้นในอนาคต อย่างไรก็ตาม การประเมินเบื้องต้นแสดงให้เห็นว่าในการทำให้เกราะใช้งานได้ดีและติดตั้งอาวุธยุคใหม่จะทำให้รถถังมีน้ำหนักถึง 60 ตันซึ่งเกิดข้อกำหนดของกองทัพบกอย่างมาก รถถังนี้จึงไม่มีการสร้างขึ้นมา"

msgid "F132_Vercingetorix_long_special"
msgstr "Vercingétorix เป็นรถถังกลางฝรั่งเศสระดับ IX ที่มีเกราะ, อาวุธและความคล่องตัวเหมือนกับรถถังหนักมากกว่า มันมีเกราะป้อมปืนที่ไว้ใจได้และปืน 120 มม.ที่เหมาะกับการรบระยะประชิด จุดเด่นของรถถังคือเครื่องยนต์กังหันก๊าซทำให้มีรูปแบบรวดเร็วและแปลงรถถังเป็นรถถังกลางที่แท้จริงในการเปลี่ยนจุดยิงอย่างรวดเร็ว"

msgid "F132_Vercingetorix_short"
msgstr "Vercingétorix"

msgid "F132_Vercingetorix_short_special"
msgstr "เครื่องยนต์กังหันก๊าซ เกราะป้อมปืนที่ไว้ใจได้"

msgid "F134_Lorraine_120_Alby"
msgstr "Lorraine 120 Alby"

msgid "F134_Lorraine_120_Alby_descr"
msgstr "ปืนอัตตาจรมีการจัดวางห้องทำการรบที่รวมการป้องกันที่ดีและอำนาจการยิงเอาไว้ในขนาดที่ย่อมที่สุดและน้ำหนัก 45 ตัน หนึ่งในเป้าหมายนั้นคือการพัฒนายานเกราะให้สามารถหมุนเพิ่มได้โดยไม่ต้องหันตัวถัง นี่ทำให้นำไปสู่การออกแบบห้องทำการรบ โครงการนี้กำหนดให้ทำการติดตั้งปืน 105 มม.หรือ 120 มม.แบบลำกล้องเกลียว ตัวลดแสงปากกระบอกนั้นถูกวางแผนให้ติดตั้งภายหลัง\nการสร้างต้นแบบนั้นแสดงให้เห็นถึงจุดอ่อนหลายอย่าง ความคล่องตัวนั้นถือว่าปานกลางและอัตราใช้น้ำมันนั้นสูงมาก การติดตั้งปืนใหญ่นั้นยากลำบากเพราะป้อมปืนยื่นออกมากว่าสี่เมตรทำให้เกิดปัญหาเวลาแล่นบนภูมิประเทศกันดารและพลขับต้องระวังกว่าเดิม นอกจากนี้น้ำหนักที่มากและขนาดที่ใหญ่ของปืน 120 มม.ทำให้ยานเกราะหนักด้านหน้าและทำให้ชิ้นส่วนรับน้ำหนักส่วนหน้าเสื่อมสภาพเร็วกว่าเดิม การพัฒนาโครงการนี้ก็ถูกยกเลิกในเวลาต่อมา"

msgid "F134_Lorraine_120_Alby_long_special"
msgstr "Lorraine 120 Alby เป็นยานพิฆาตรถถังฝรั่งเศสระดับ VIII มันถูกออกแบบตามแนวยานพิฆาตรถถังฝรั่งเศสดั้งเดิมคือมีทรงต่ำ, ความคล่องตัวดี, เกราะหน้าที่แข็งแกร่งและปืนป้อนกระสุนอัตโนมัติ 120 มม. จุดเด่นหลักของมันคือโครงบนที่หันไปตามปืนทำให้เคลื่อนได้ 30° ไปทางซ้ายขวาโดยไม่ต้องหันตัวถัง"

msgid "F134_Lorraine_120_Alby_short"
msgstr "Alby"

msgid "F134_Lorraine_120_Alby_short_special"
msgstr "ระบบป้อนกระสุนอัตโนมัติ, เกราะหน้าที่ดี"

msgid "F135_AS_XX_40_t"
msgstr "AS-XX 40 t"

msgid "F135_AS_XX_40_t_descr"
msgstr "ต้นแบบของรถถังกลางฝรั่งเศสพัฒนาขึ้นในปี 1978 ในฐานะส่วนหนึ่งของโครงการวิจัยการปรับแต่งแบบใหม่ แนวคิดหลักของพาหนะคือการเพิ่มความปลอดภัยพลรถถังสูงสุด และด้วยเหตุนี้เอง ตัวปืนและกระสุนจึงถูกวางไว้นอกห้องทำการรบซึ่งลดโอกาสการได้รับบาดเจ็บลง ในกรณีที่เกิดไฟไหม้ พลรถถังสามารถปล่อยลังที่เกิดการไหมได้ด้วยกระสุนไฟ กระสุนส่วนใหญ่นั้นวางเอาไว้ในรางกลไกที่ส่งไปยังตัวปืนและเติมอัตโนมัติจากสองลังหุ้มเกราะที่ด้านหลัง เนื่องจากการพัฒนานั้นซับซ้อนและต้องใช้แรงงานอย่างมาก การพัฒนาจึงหยุดที่ขั้นสร้างแบบจำลองจากไม้"

msgid "F135_AS_XX_40_t_long_special"
msgstr "พัฒนาต่อจากจุดเด่นของรถถังรุ่นก่อนๆหน้า AS-XX 40 t นั้นเป็นรถถังกลางที่ว่องไวอย่างมากอีกทั้งติดตั้งปืนบรรจุอัตโนมัติที่พร้อมจะเข้าปะทะเสมอ รูปทรงขนาดย่อมของมันและการเร่งความเร็วที่สูงทำให้มันเป็นยานรบสนับสนุนที่ไว้ใจได้ มันยอดเยี่ยมในการแล่นตีโอบแบบไม่คาดคิดแต่ความสามารถอยู่รอดที่ต่ำทำให้ผู้ใช้ต้องวางแผนให้ดีก่อนใช้แผนการบุกที่ก้าวร้าว"

msgid "F135_AS_XX_40_t_short"
msgstr "AS-XX 40 t"

msgid "F136_AMX_67_Imbattable"
msgstr "AMX 67 Imbattable"

msgid "F136_AMX_67_Imbattable_descr"
msgstr "ในช่วงปลายทศวรรษ 1960 ฝรั่งเศสกำลังใช้รถถัง AMX-30 ที่สามารถต้านทานยานเกราะของข้าศึกที่น่าจะเป็นไปได้อยู่ ในขณะเดียวกัน พวกเขาก็พยายามพัฒนายานเกราะที่มีเกราะที่ดีกว่าเดิมซึ่งหนึ่งในนั้นคือ AMX 67 Imbattable รถถังรุ่นนี้โดดเด่นจากการมีอาวุธที่ทรงพลังสามารถโจมตีข้าศึกได้จากระยะไกลอีกทั้งมีอัตราการยิงสูง จุดเด่นของรถถังคือการติดตั้งปืนในป้อมปืนทรงต่ำอีกทั้งมีจุดติดอาวุธเหนือหัวที่มีระบบป้อนกระสุนอัตโนมัติ โครงการนี้มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F136_AMX_67_Imbattable_long_special"
msgstr "AMX 67 Imbattable นั้นถือว่าเป็นรถถังหนักที่ไม่ปกติเพราะการออกแบบแลกเกราะที่หนากับความคล่องตัวที่น่าประทับใจและปืนบรรจุอัตโนมัติที่มีสมดุลดี ในสนามรบ รถถังถือว่ายอดเยี่ยมสำหรับบทบาทการยิงสนับสนุนพันธมิตรด้วยการยิงกดดันในจังหวะที่สำคัญ และด้วยระบบป้อนกระสุนรุ่นทดลองก็จะทำให้มันพร้อมที่จะยิงเมื่อต้องการ"

msgid "F136_AMX_67_Imbattable_short"
msgstr "Imbattable"

msgid "F137_LEOX"
msgstr "Leox"

msgid "F137_LEOX_descr"
msgstr "ในปี 1970 สเปนได้เผชิญกับปัญหาเนื่องด้วยกองรถถังสหรัฐฯที่มีอยู่รวมไปถึง M74 นั้นเริ่มล้าสมัย และด้วยเหตุทางการเมืองทางสหรัฐฯและอังกฤษก็ไม่สามารถส่งอาวุธให้กับสเปนรวมไปถึงเยอรมนีเพราะปืนของรถถัง Leopard 1 ของเยอรมันนั้นเป็นของอังกฤษซึ่งทำให้สเปนทำการซื้อรถถัง AMX 30 ของฝรั่งเศสและในปี 1974 ก็เริ่มทำการผลิตรุ่นได้รับสิทธิบัตรในชื่อ AMX 30E ที่ไม่ได้ปรับปรุงให้ทันสมัย รถถังฝรั่งเศสรุ่นนี้ถือว่ามีความน่าเชื่อถือไม่พอและสเปนก็ต้องทำการปรับรถถัง M47, M48 และ AMX 30 ที่เก่าให้ทันสมัย ในปี 1979 หลังจากจบการผลิต AMX 30E ก็เริ่มทำการปรับปรุงให้ทันสัยรวมไปถึง El Niño ซึ่งเป็น AMX 30 ที่มีตัวถังยาวขึ้นกับ Leox อันเป็นรุ่นดัดแปลงที่ใช้ตัวถังของ Leopard 1 และป้อมปืนของ AMX 30E"

msgid "F137_LEOX_long_special"
msgstr "Leox เป็นรถถังฝรั่งเศสระดับ IX ซึ่งมีเครื่องยนต์ทรงพลังที่ทำให้ทำความเร็วสูงสุดได้อย่างน่าประทับใจและเปลี่ยนตำแหน่งในสนามรบได้อย่างรวดเร็ว นอกจากนี้ ปืนที่แม่นยำของรถถังยังสามารถทำความเสียหายร้ายแรกให้ข้าศึกได้จำนวนมากจากทุกระยะการยิง"

msgid "F137_LEOX_short"
msgstr "Leox"

msgid "F137_LEOX_short_special"
msgstr "ความเร็วสูงสุดที่น่าประทับใจ, การเจาะเกราะที่สูง"

msgid "F138_Renault_R35_FCM_36"
msgstr "Renault R35/FCM 36"

msgid "F138_Renault_R35_FCM_36_desc"
msgstr "ในฐานะส่วนหนึ่งของโครงการปี 1930 ที่พัฒนาและสร้างรถถังใหม่ขึ้น ทางฝรั่งเศสได้พยายามทำงานเพื่อปรับรวมป้อมปืนของยานเกราะที่ต่างกัน หนึ่งในโครงการทดลองนั้นคือรถถังเบา R35 ที่มีป้อมปืนของ FCM 36 รถถังคันนี้ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F138_Renault_R35_FCM_36_long_special"
msgstr "Renault R35/FCM 36 เป็นรถถังเบาฝรั่งเศสระดับ II ที่รวมตัวถังของ Renault R35 เข้ากับป้อมปืนของ FCM 36 ตัวรถถังมีปืน 37 มม.ที่มีอัตราการยิงสูงมากและมีเกราะป้องกันที่ไว้ใจได้ ส่วนผสมของคุณลักษณะเหล่านี้ทำให้รถถังสามารถยึดจุดยิงและฝ่าการยิงของข้าศึกได้"

msgid "F138_Renault_R35_FCM_36_short"
msgstr "R35/FCM 36"

msgid "F138_Renault_R35_FCM_36_short_special"
msgstr "เกราะที่ดี, อัตราการยิงสูง"

msgid "F139_Terrifiant"
msgstr "Terrifiant"

msgid "F139_Terrifiant_descr"
msgstr "ในทศวรรษ 1950 การพัฒนารถถังหนักฝรั่งเศสก็ได้ถูกหยุดลง ความพยายามหลายครั้งที่จะพัฒนาการออกแบบจากสงครามโลกครั้งที่สองล้มเหลวในการสร้างรถถังที่สามารถทัดเทียมกับคู่แข่งได้ซึ่งทำให้ฝรั่งเศสได้เลือกที่จะขอความช่วยเหลือจากสหรัฐอเมริกา พวกเขาซื้อเอกสารและแบบพิมพ์เขียวสำหรับช่วงล่างของโครงการรถถัง TS-6 ที่ไม่ได้ถูกสร้างขึ้นจริง นักออกแบบฝรั่งเศสได้ติดตั้งป้อมปืนที่มีปืนใหญ่ขนาด 128 มม. ผลลัพธ์ที่ได้กลายเป็นรถถังที่หนักเกินไปและความพยายามในการติดตั้งเครื่องยนต์มากกว่า 1,000 แรงม้านั้นล้มเหลวและทำให้โครงการหยุดลง"

msgid "F139_Terrifiant_long_special"
msgstr "Terrifiant เป็นรถถังหนักฝรั่งเศสระดับ IX ที่เหมือนกับรถถังหนักฝรั่งเศสคันอื่นๆจากการมีเกราะตัวถังและเกราะป้อมปืนส่วนหน้าที่แข็งแกร่ง, ปืนที่ททรงพลังทำความเสียหายต่อนัดสูงและมีความแม่นยำใช้ได้อีกทั้งมีความคล่องตัวดีพอใช้"

msgid "F139_Terrifiant_short"
msgstr "Terrifiant"

msgid "F139_Terrifiant_short_special"
msgstr "เกราะหน้าที่ไว้ใจได้, ความเสียหายต่อนัดสูง"

msgid "F13_AMX38"
msgstr "AMX 38"

msgid "F13_AMX38_descr"
msgstr "พัฒนาขึ้นในปี 1937-1938 ภายใต้โครงการ \"พาหนะ 20 ตัน\" และมุ่งหมายให้มาแทนที่รถถัง D2 โครงการนี้มีการรวมรุ่นป้อมปืนคู่ขนาด 37มม.หรือ 47 มม.ไว้ ในปี 1938 มีการสร้างพาหนะขึ้นสองคันสำหรับการทดสอบภาคสนาม แต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F13_AMX38_short"
msgstr "AMX 38"

msgid "F140_Fantome"
msgstr "Fantôme"

msgid "F140_Fantome_descr"
msgstr "ในช่วงปี 1963 ถึง 1964 บริษัท Porsche ได้พัฒนารถถังสำหรับทศวรรษ 1970 ซึ่งถูกปฏิเสธในที่สุด ต่อมา โครงการนี้ก็ได้ตกอยู่ในมือของฝรั่งเศสซึ่งทางบริษัท Creusot-Loire ได้ทำการเสนอเป็นรถถังรวมของฝรั่งเศส, เยอรมนีและประเทศอื่นๆ อย่างไรก็ตาม รถถังคันนี้ถือว่าราคาแพงเกินไปทำให้เป็นปัจจัยสำคัญที่ทำให้โครงการถูกปิดตัวลง"

msgid "F140_Fantome_long_special"
msgstr "Fantôme เป็นรถถังกลางฝรั่งเศสระดับ IX ที่มีคุณลักษณะอันคุ้นเคยของรถถังฝรั่งเศสเช่นความคล่องตัวที่ดีและปืนป้อนกระสุนอัตโนมัติ แต่สิ่งที่ทำให้มันแตกต่างจากคันอื่นๆคือระบบช่วงล่างไฮโดรนิวมาติคที่ทำให้รถถังสามารถทำมุมกดและมุมยกปืนที่มากขึ้นกว่าเดิมและเพิ่มประสิทธิภาพของรถถังในภูมิประเทศไม่ราบเรียบ"

msgid "F140_Fantome_short"
msgstr "Fantôme"

msgid "F140_Fantome_short_special"
msgstr "ระบบป้อนกระสุนอัตโนมัติ, ระบบช่วงล่างไฮโดรนิวมาติค"

msgid "F141_Durendal"
msgstr "Durendal"

msgid "F141_Durendal_desc"
msgstr "การออกแบบเบื้องต้นสำหรับรถถังกลางที่มีต้นแบบจากการพัฒนาของฝรั่งเศสและอิตาลี"

msgid "F141_Durendal_long_special"
msgstr "Durendal เป็นรถถังกลางสนับสนุนฝรั่งเศสระดับ X ที่มีระบบปืนบรรจุอัตโนมัติที่ไม่ปกติซึ่งมีสองตับกระสุนที่ทำให้ยิงสองนัดได้อย่างรวดเร็ว นี่ทำให้รถถังทำความเสียหายได้อย่างมหาศาลในช่วงสั้นๆ มันยังมีความคล่องตัวอันยอดเยี่ยมและทำให้สามารถเข้าโจมตีจากมุมที่ไม่คาดคิดได้"

msgid "F141_Durendal_short"
msgstr "Durendal"

msgid "F141_Durendal_short_special"
msgstr "ระบบป้อนกระสุนอัตโนมัติมีซองกระสุนแยก ความคล่องตัวที่ดี"

msgid "F142_M47_Chevalier"
msgstr "M47 Chevalier"

msgid "F142_M47_Chevalier_descr"
msgstr "โครงการปรับให้ทันสมัยครั้งใหญ่สำหรับ M47 ซึ่งประจำการอยู่ในกองทัพบกฝรั่งเศส เป้าหมายหลักนั้นคือการปรับให้รถถังนั้นทันสมัยพอจนกระทั่งมีการผลิตรถถัง AMX 30 ได้ในจำนวนมากพอ การออกแบบนั้นมีการกำหนดให้ติดตั้งปืนใหม่, ระบบควบคุมการยิงขั้นสูง, การเสริมเกราะให้ดีขึ้น, การติดตั้งใบไถและถังน้ำมันเชื้อเพลิงรวมไปถึงการลดจำนวนพลรถถัง ตำแหน่งผู้ช่วยพลขับนั้นถูกแทนที่ด้วยรางกระสุน อย่างไรก็ตาม AMX 30 นั้นก็เข้าประจำการเร็วกว่าที่คาดเอาไว้และการปรับ M47 ให้ทันสมัยนั้นก็ถือว่าล้าสมัยสำหรับกองทัพบกฝรั่งเศส มีแผนที่จะทำการส่งออกรถถังแต่ก็ไม่ได้มีความสนใจจากต่างประเทศ มีการผลิตรถต้นแบบหนึ่งคันพร้อมด้วยปืนใหม่เพื่อแสดงสมรรถนะของการติดตั้งอาวุธใหม่ แต่ไม่มีประวัติของรถต้นแบบหลังจากนั้น"

msgid "F142_M47_Chevalier_long_special"
msgstr "M47 Chevalier เป็นรถถังกลางฝรั่งเศสระดับ IX แม้ว่าจะไม่มีพลังในการปะทะซึ่งหน้า การมีปืนควบคุมได้ราบรื่นและมุมกดที่ยอดเยี่ยม, ความคล่องตัวที่ดีและเกราะป้อมปืนที่ใช้ได้ทำให้มันเป็นหน่วยสารพัดประโยชน์ที่ใช้ได้ เกราะกลวงที่กระจายอยู่รอบคันก็ยังช่วยเป็นการป้องกันเสริมและทำให้รถถังมีความสามารถอยู่รอดมากขึ้น"

msgid "F142_M47_Chevalier_short"
msgstr "M47 Chevalier"

msgid "F142_M47_Chevalier_short_special"
msgstr "เกราะป้อมปืนที่ทนทาน, มุมกดปืนที่ดี"

msgid "F143_Fauteur"
msgstr "Fauteur"

msgid "F143_Fauteur_descr"
msgstr "ในช่วงต้นทศวรรษ 1970 ทาง AMX ได้ส่งเสริมโครงการพัฒนารถถังที่ติดตั้งเกราะหนัก, อาวุธอันทรงพลังเป็นปืนยิงเร็ว แม้ว่าเกราะจะเป็นแบบดั้งเดิม อำนาจการยิงนั้นก็มีต้นแบบจากหลักการใหม่ เหล่าวิศวกรได้วางแผนเพื่อทำการติดตั้งปืนลูกผสมที่ใช้กำลังไฟฟ้าเพื่อเพิ่มประสิทธิภาพของดินขับ แก็สขับนั้นถูกทำให้ร้อนด้วยอาร์คไฟฟ้าระหว่างขั้วไฟฟ้าที่กระบอกปืนและเพิ่มการเผาไหม้และเร่งอำนาจของกระสุน โครงการนี้ปิดตัวลงเนื่องด้วยข้อจำกัดทางเทคนิค"

msgid "F143_Fauteur_long_special"
msgstr "Fauteur เป็นผลลัพธ์ของสูตรรถถังหนักที่ไว้ใจได้และมีการควบคุมดินขับแบบก้าวหน้าทำให้เป็นยานเกราะที่น่าเกรงขามซึ่งเหมาะกับทั้งการรบระยะใกล้และระยะไกล เกราะที่ดีทำให้มันต้านทานการยิงของข้าศึกได้ในขณะที่ความคล่องตัวที่ดีพอตัวทำให้มันนำอำนาจการยิงเข้าแนวหน้าได้ดีพอตัว"

msgid "F143_Fauteur_short"
msgstr "Fauteur"

msgid "F147_AMX29_Belier"
msgstr "AMX 29 Bélier"

msgid "F147_AMX29_Belier_descr"
msgstr "ในปี 1963 บริษัท AMX ได้รับมอบหมายงานในการพัฒนารถถังกลางขนาดย่อมที่มีความคล่องตัวระดับเดียวกับ BC 25 t และมีอาวุธที่ทรงพลังกว่า รถถังคันนี้ได้รับรหัสเรียกขานเป็น AMX 29 Bélier (\"แกะตัวผู้\") จุดเด่นของรถถังคือปืนลำกล้องเกลียว 127 มม. CN-127-F1 บรรจุอัตโนมัติ รถถังคันนี้ถูกออกแบบให้มีพลรถถังสามนาย การทดสอบนั้นยืนยันว่ารถถังมีความคล่องตัวและอำนาจการยิงที่สูงแต่ก็พบข้อเสียร้ายแรงคือแรงสะท้อนปืนที่สูง, จำนวนกระสุนที่จำกัด, ราคาที่สูงและความซับซ้อนเกินไปของระบบป้อนกระสุนอัตโนมัติทำให้โครงการถูกปิดลงในปี 1969"

msgid "F147_AMX29_Belier_long_special"
msgstr "AMX 29 Bélier เป็นรถถังกลางสนับสนุนฝรั่งเศสระดับ X รูปทรงที่ต่ำ, การอำพรางที่ยอดเยี่ยมและความคล่องตัวที่สูงทำให้เคลื่อนที่ในแบบที่คาดเดาไม่ได้และสามารถทำการโจมตีได้อย่างมีประสิทธิภาพ ด้วยปืน 127 มม.ที่มีระบบป้อนกระสุนอัตโนมัติปรับปรุงสองนัดก็ทำให้สามารถลดเวลาบรรจุได้อย่างมากถ้ากะจังหวะการยิงนัดต่อไปอย่างเหมาะสม"

msgid "F147_AMX29_Belier_short"
msgstr "Bélier"

msgid "F147_AMX29_Belier_short_special"
msgstr "ระบบเติมกระสุนปรับปรุง, ความคล่องตัวที่ยอดเยี่ยม"

msgid "F14_AMX40"
msgstr "AMX 40"

msgid "F14_AMX40_descr"
msgstr "การพัฒนาเริ่มขึ้นในเดือนมีนาคม ปี 1940 ซึ่งแผ่นเกราะทั้งหมดมีรูปทรงที่ซับซ้อนและเป็นทรงโค้งและตัวถังรถแทบจะไม่มีมุมฉากเลย AMX 40 ถูกออกแบบมาเพื่อแทนที่ Somua S35 และ S40 ในปี 1941-1942 แต่โครงการถูกหยุดลงในเดือนในเดือนกรกฏาคม ปี 1940 รถถังนี้มีอยู่ในพิมพ์เขียวเท่านั้น"

msgid "F14_AMX40_short"
msgstr "AMX 40"

msgid "F15_AMX_12t"
msgstr "AMX 12 t"

msgid "F15_AMX_12t_descr"
msgstr "การออกแบบรถถังเบาความเร็วสูงนี้เริ่มขึ้นในปี 1946 แต่ก็ไม่มีผลิตรถถังชนิดนี้ต่อ อย่างไรก็ตามแบบร่างของรถถังชนิดนี้ก็กลายมาเป็นฐานการพัฒนาของ AMX-13 ที่เป็นที่รู้จักกันดี มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F15_AMX_12t_short"
msgstr "AMX 12 t"

msgid "F16_AMX_13_75"
msgstr "AMX 13 75"

msgid "F16_AMX_13_75_descr"
msgstr "รถถังเบาที่คล่องตัวพร้อมด้วยป้อมปืนแบบส่ายและปืนใหญ่ป้อนกระสุนเองขนาด 75 มม. ที่สามารถทำการยิงได้ 10 นัดต่อนาที ในช่วงนั้น ปืนบนรถถังนี้มีอำนาจการเจาะเกราะเหนือกว่าปืนของรถถังกลางส่วนใหญ่คันอื่นๆ"

msgid "F16_AMX_13_75_short"
msgstr "AMX 13 75"

msgid "F17_AMX_13_90"
msgstr "AMX 13 90"

msgid "F17_AMX_13_90_descr"
msgstr "ในช่วงต้นทศวรรษ 1960 ปืนใหญ่ 75 มม. ที่มีความเร็วปากกระบอก 1000 ม./วิ ถือว่าล้าสมัยแล้ว พาหนะรุ่นนี้ได้รับการติดตั้งปืน 90 มม. F3 ที่ใช้กระสุนระเบิดแรงสูงต่อต้านรถถังที่ทรงพลังกว่า การปรับปรุงให้ทันสมัยนี้ไม่ต้องทำการเปลี่ยนแปลงอย่างมากต่อป้อมปืนหรือรูปทรงพาหนะ พาหนะคันแรกถูกสร้างขึ้นในเดือนกุมภาพันธ์ 1967 พาหนะที่มีอยู่เข้ารับการปรับปรุงให้ทันสมัยเช่นกัน"

msgid "F17_AMX_13_90_short"
msgstr "AMX 13 90"

msgid "F18_Bat_Chatillon25t"
msgstr "Bat.-Châtillon 25 t"

msgid "F18_Bat_Chatillon25t_7x7"
msgstr "Bat.-Châtillon 25 t 7x7"

msgid "F18_Bat_Chatillon25t_7x7_descr"
msgstr "รถถังกลางติดป้อมปืนแบบส่ายและใช้ปืนใหญ่ขนาด 90 มม. พัฒนาขึ้นโดย Batignolles-Châtillon ในช่วงกลางทศวรรษ 1950 มีการผลิตรถต้นแบบขึ้นสองคัน แต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F18_Bat_Chatillon25t_7x7_short"
msgstr "B-C 25 t 7x7"

msgid "F18_Bat_Chatillon25t_descr"
msgstr "รถถังกลางติดป้อมปืนแบบส่ายและใช้ปืนใหญ่ขนาด 90 มม. พัฒนาขึ้นโดย Batignolles-Châtillon ในช่วงกลางทศวรรษ 1950 มีการผลิตรถต้นแบบขึ้นสองคัน แต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F18_Bat_Chatillon25t_short"
msgstr "B-C 25 t"

msgid "F19_Lorraine40t"
msgstr "Lorraine 40 t"

msgid "F19_Lorraine40t_descr"
msgstr "รถถังทดลองฝรั่งเศสคันนี้ถูกพัฒนาในช่วงทศวรรษที่ 1940 มีการผลิตรถต้นแบบขึ้นมาสองคันในปี 1952 นอกจากป้อมปืนแบบส่ายแล้ว รถถังยังมีระบบช่วงล่างติดล้ออัดลมที่แกนกลางและเกราะหน้าทรงหอก ซึ่งการออกแบบผ่านการทดสอบแต่ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F19_Lorraine40t_long_special"
msgstr "รถถังกลางที่ว่องไวอย่างมากบรรจุซองกระสุนสี่นัดที่สามารถทำความเสียหาย 1,200 หน่วยได้ในระยะเวลาอันสั้น ความคล่องตัวที่สูงของรถถังนั้นก็ต้องแลกกับเกราะที่ธรรมดาซึ่งทำให้ยุทธวิธีในการใช้รถถังคันนี้คือการลอบตีจากด้านข้าง"

msgid "F19_Lorraine40t_short"
msgstr "Lorr. 40 t"

msgid "F19_Lorraine40t_short_special"
msgstr "ระบบป้อนแบบซองกระสุนและความคล่องตัวที่ยอดเยี่ยม"

msgid "F22_AMX_105AM"
msgstr "AMX 13 105 AM mle. 50"

msgid "F22_AMX_105AM_descr"
msgstr "การพัฒนาปืนอัตตาจรโดยมีต้นแบบจาก AMX 13 75 เริ่มขึ้นในช่วงปลายทศวรรษที่ 1940 พาหนะมีการติดตั้งปืนใหญ่สนาม Obusier de 105 mm TF50 ในช่วงต้นทศวรรษที่ 1950 ปืนอัตตาจรเข้าประจำการในกองทัพบกฝรั่งเศส มียอดการผลิตพาหนะทั้งหมด 429 คัน 92 คันถูกส่งออกไปเนเธอร์แลนด์"

msgid "F22_AMX_105AM_short"
msgstr "AMX 13 AM"

msgid "F23_AMX_13F3AM"
msgstr "AMX 13 F3 AM"

msgid "F23_AMX_13F3AM_descr"
msgstr "ในช่วงสิ้นสุดทศวรรษที่ 1950 วิศวกรของ Creusot-Loire ได้พัฒนาพาหนะใหม่โดยใช้ฐานของรถถัง AMX 13 และติดตั้งปืนขนาด 155 มม. ปืนอัตตาจรรุ่นนี้เข้าสายการผลิตตั้งแต่ปี 1962 ถึง 1997 โดยมียอดผลิต 600 คัน ยังประจำการอยู่ในกองทัพของฝรั่งเศส อาร์เจนตินา ชิลี เอกวาดอร์ โมรอคคอ และประเทศอื่นๆ"

msgid "F23_AMX_13F3AM_short"
msgstr "AMX 13 F3"

msgid "F24_Lorraine155_50"
msgstr "Lorraine 155 mle. 50"

msgid "F24_Lorraine155_50_descr"
msgstr "พัฒนาขึ้นในฝรั่งเศสหลังสงครามโดยใช้รากฐานจาก Lorraine 40 t รถคันนี้ผ่านการทดสอบในปี 1950 แต่ไม่ได้เข้าประจำการหรือสายการผลิตจำนวนมาก"

msgid "F24_Lorraine155_50_short"
msgstr "Lorr. 155 50"

msgid "F25_Lorraine155_51"
msgstr "Lorraine 155 mle. 51"

msgid "F25_Lorraine155_51_descr"
msgstr "พัฒนาขึ้นในปี 1951 โดยมีรากฐานจาก Lorraine 40 t และติดตั้งปืนใหญ่สนาม 155-มม. รถต้นแบบผ่านการทดสอบพร้อมกับรถถัง แต่ Lorraine 40 t ไม่ได้เข้าประจำการและโครงการปืนอัตตาจรก็ถูกหยุดลงเช่นกัน"

msgid "F25_Lorraine155_51_short"
msgstr "Lorr. 155 51"

msgid "F27_FCM_36Pak40_long_special"
msgstr "ยานพิฆาตรถถังฝรั่งเศสระดับ III ที่มีปืนอันทรงพลังและแม่นยำอีกทั้งมีระยะการมองเห็นที่ไกลทำให้คุณสามารถตรวจจับและทำลายข้าศึกได้อย่างรวดเร็ว แต่ด้วยเกราะที่ปานกลาง คุณควรหลบอยู่หลังที่กำบังและทำการยิงต่อสู้จากระยะกลางหรือระยะไกล"

msgid "F27_FCM_36Pak40_short_special"
msgstr "ปืนที่ใช้ได้และระยะการมองเห็นที่ยอดเยี่ยม"

msgid "F32_Somua_Sau_40"
msgstr "Somua SAu 40"

msgid "F32_Somua_Sau_40_descr"
msgstr "โครงการปืนอัตตาจรเพื่อทำการสนับสนุนหน่วยยานเกราะเบา ทำการออกแบบในช่วงปี 1935 ถึง 1937 โดยมีรากฐานมาจากพาหนะ S35 และ S40 การออกแบบมีการดัดแปลงส่วนบนของตัวถังหุ้มเกราะและติดตั้งปืน 75 มม. Mle 1929 เข้าไว้ ส่วนบนของห้องทำการรบติดตั้งป้อมปืนที่นั่งเดี่ยวและปืนกล 7.5 มม. Mle 1931 มีการขอผลิตจำนวนมากสำหรับ SAu 40 ในเดือนตุลาคม 1939 รถต้นแบบ (และตามแห่งข้อมูลตามประวัติศาสตร์บางแห่ง SAu 40 รุ่นนำร่องอีกสี่คัน) ได้ถูกส่งไปยังแนวหน้าและใช้ทำการรบในเดือนมิถุนายน 1940"

msgid "F32_Somua_Sau_40_short"
msgstr "SAu 40"

msgid "F33_S_35CA"
msgstr "S35 CA"

msgid "F33_S_35CA_descr"
msgstr "พัฒนาโดยมีรากฐานจากพาหนะ R35 และ S35 ที่ล้าสมัยแล้ว การออกแบบที่เรียบง่ายทำให้สามารถติดตั้งห้องทำการรบแบบเปิดพร้อมกับปืนใหญ่ 17 ปอนด์ของอังกฤษบนตัวถังได้ อย่างไรก็ตาม โครงการถูกหยุดลงในช่วงการออกแบบเนื่องจากการขาดแคลนตัวถังพาหนะก่อนสงครามและความล้าสมัยของตัวถังดังกล่าวรวมไปถึงปืนที่ไม่มีประสิทธิภาพและไม่เหมือนปกติ"

msgid "F33_S_35CA_short"
msgstr "S35 CA"

msgid "F34_ARL_V39"
msgstr "ARL V39"

msgid "F34_ARL_V39_descr"
msgstr "เป็นรถถังต้นแบบของ ARL 40 ในเบื้องต้นออกแบบให้เป็นปืนอัตตาจรสำหรับการบุกทะลวง การผลิตจำนวนมากตั้งระยะเวลาเริ่มไว้ในปีคริสตศักราช 1940 แต่ไม่ได้เริ่มขึ้นเนื่องจากการเข้ายึดของฝ่ายเยอรมัน"

msgid "F34_ARL_V39_short"
msgstr "ARL V39"

msgid "F35_AMX_AC_Mle1946"
msgstr "AMX AC mle. 46"

msgid "F35_AMX_AC_Mle1946_descr"
msgstr "เป็นแผนเสนอทำการสร้างยานพิฆาตรถถังหนักบนฐานของรถถัง M4 การพัฒนาเริ่มขึ้นในปีคริสตศักราช 1946 การปรับปรุงรถถังทำให้มีส่วนคล้ายคลึงกับยานพิฆาตรถถัง Jagdpanther มีอยู่แค่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F35_AMX_AC_Mle1946_short"
msgstr "AMX AC 46"

msgid "F36_AMX_AC_Mle1948"
msgstr "AMX AC mle. 48"

msgid "F36_AMX_AC_Mle1948_FL"
msgstr "AMX AC mle. 48 FL"

msgid "F36_AMX_AC_Mle1948_FL_short"
msgstr "AMX AC 48 FL"

msgid "F36_AMX_AC_Mle1948_descr"
msgstr "เป็นโครงการแบบร่างของยานเกราะพิฆาตรถถังหนักที่พัฒนาขึ้นในปี 1947-1948 โดยได้รับอิทธิพลจาก Jagdpanther ยานเกราะรุ่นนี้ติดตั้งปืนขนาด 120 มม.เป็นอาวุธหลัก คุณลักษณะที่โดดเด่นของยานเกราะรุ่นนี้คือปืนกล MG 151/20 ขนาด 20 มม. สามกระบอกที่ติดตั้งในห้องรบและด้านหลัง มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F36_AMX_AC_Mle1948_short"
msgstr "AMX AC 48"

msgid "F37_AMX50_Foch"
msgstr "AMX 50 Foch"

msgid "F37_AMX50_Foch_descr"
msgstr "ตั้งแต่ปลายทศวรรษ 1940 จนถึงต้นทศวรรษ 1950 ฝรั่งกำลังพัฒนายานพิฆาตรถถังขนาดหนัก โครงการนี้ถูกพัฒนาขึ้นโดยได้รับอิทธิพลจากยานพิฆาตรถถังเยอรมันในช่วงสงครามโลกครั้งที่สอง โดยมีการติดตั้งปืนขนาด 120 มม. ไว้ มีการสร้างรถต้นแบบขึ้นอย่างน้อยหนึ่งคันและเข้าร่วมขบวนสวนสนามที่กรุงปารีสในวันที่ 14 กรกฏาคม 1950 ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F37_AMX50_Foch_short"
msgstr "Foch"

msgid "F38_Bat_Chatillon155_58"
msgstr "Bat.-Châtillon 155 58"

msgid "F38_Bat_Chatillon155_58_descr"
msgstr "ต้นแบบปืนใหญ่อัตตาจรที่ใช้องค์ประกอบของตัวถัง M47 ของสหรัฐฯ เมื่อเทียบกับ Bat.-Châtillon 155 55 พาหนะคันนี้มีป้อมปืนที่ต่างออกไปและมีระบบป้อนซองกระสุน มีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F38_Bat_Chatillon155_58_short"
msgstr "B-C 155 58"

msgid "F39_AMR_P103"
msgstr "AMR P.103"

msgid "F39_AMR_P103_descr"
msgstr "รถถังเบาที่พัฒนาในปี 1935 โดยวิศวกรของ Citroën รถถังคันนี้ได้เข้าทำการทดสอบในเดือนเมษายนปีเดียวกันซึ่งแสดงให้เห็นว่าองค์ประกอบส่วนใหญ่และพลรถถังได้รับการป้องกันที่ไว้ใจได้ อย่างไรก็ตาม เนื่องจากตัวถังและระบบขับเคลื่อนไฮดรอลิคที่ไม่น่าเชื่อถือนักและความเร็วที่ต่ำ โครงการก็ถูกยุติลงเพื่อหลีกทางให้ AMR 35 รถต้นแบบที่สร้างขึ้นเพียงคันเดียวก็ถูกถอดชิ้นส่วนในเวลาต่อมา"

msgid "F39_AMR_P103_long_special"
msgstr "AMR P.103 นั้นเป็นรถถังเบาอเนกประสงค์ระดับ II ที่มีความคล่องตัวดีทำให้สามารแล่นเข้าจุดสำคัญในสนามรบอย่างรวดเร็ว ปืนของมันนั้นมีอัตราการยิงที่สูงและระยะการมองเห็นที่ไกลทำให้ชี้เป้าข้าศึกได้อย่างมีประสิทธิภาพโดยเฉพาะในช่วงท้ายๆของการรบ"

msgid "F39_AMR_P103_short"
msgstr "AMR P.103"

msgid "F39_AMR_P103_short_special"
msgstr "ระยะการมองเห็นดีและอัตราการยิงสูง"

msgid "F42_AMR_35"
msgstr "AMR 35"

msgid "F42_AMR_35_descr"
msgstr "รถถังลาดตระเวนเบาที่พัฒนาโดย Renault มียอดการผลิตของรุ่นดัดแปลงที่ต่างกันจำนวน 200 คันถูกผลิตขึ้นตั้งแต่ปี 1936 ถึง 1940 รถถังรุ่นนี้เข้าร่วมการรบในช่วงแรกของสงครามโลกครั้งที่สอง หลังจากที่ฝรั่งเศสถูกยึด รถถังส่วนใหญ่นั้นถูกยึดโดยฝ่ายเยอรมันและถูกแปลงเป็นปืนอัตตาจรติดตั้งปืนวิถีโค้งขนาด 8 ซม."

msgid "F42_AMR_35_long_special"
msgstr "รถถังมีขนาดที่เล็กและปืนที่ไว้ใจได้สำหรับระดับของมัน มันไม่ได้มีความเร็วที่สูงหรือเกราะที่ใช้ได้ฉะนั้นจึงเป็นการดีที่จะใช้การซ่อนตัวของรถถัง รูปทรงที่ต่ำของรถถังทำให้ถูกพบและยิงเข้าได้ยาก นอกจากนี้ มุมกด/มุมยกปืนที่ดีทำให้สามารถใช้ภูมิประเทศไม่ราบเรียบให้เป็นประโยชน์ได้"

msgid "F42_AMR_35_short"
msgstr "AMR 35"

msgid "F42_AMR_35_short_special"
msgstr "ปืนที่ดีและการซ่อนตัวที่ยอดเยี่ยม"

msgid "F44_Somua_S35"
msgstr "Somua S35"

msgid "F44_Somua_S35_descr"
msgstr "อำนาจการยิง เกราะป้องกัน และความคล่องตัวที่ดีทำให้ S35 เป็นหนึ่งในรถถังที่ดีที่สุดในยุคของมัน อย่างไรก็ตามป้อมปืนที่เล็กบังคับให้ผู้บังคับการต้องรับภาระงานหลายงานพร้อมกัน: ค้นหาเป้าหมายข้าศึก ทำการเล็งและบรรจุกระสุน และประสานงานการทำงานของพลรถถัง ภาระงานเหล่านี้ลดความหยั่งรู้สถานการณ์ของผู้บังคับการและลดประสิทธิภาพของรถถังในสนามรบ ในช่วงที่ฝรั่งเศสถูกยึดในวันที่ 22 มิถุนายน 1940 มียอดการผลิตรถถังรุ่นนี้ทั้งหมด 427 คัน"

msgid "F44_Somua_S35_short"
msgstr "Somua S35"

msgid "F50_FCM36_20t"
msgstr "FCM 36"

msgid "F50_FCM36_20t_descr"
msgstr "พัฒนาขึ้นในช่วงกลางทศวรรษ 1930 ในฐานะรถถังสนับสนุนทหารราบ ถือเป็นรถถังฝรั่งเศสรุ่นเดียวที่ใช้เครื่องยนต์ดีเซล ในปี 1939 มียอดการผลิตรถถัง 100 คัน"

msgid "F50_FCM36_20t_short"
msgstr "FCM 36"

msgid "F62_ELC_AMX"
msgstr "AMX ELC bis"

msgid "F62_ELC_AMX_descr"
msgstr "พัฒนาขึ้นในช่วงปี 1957 ถึง 1961 เพื่อเป็นพาหนะต่อสู้รถถังหนักที่สามารถขนส่งทางอากาศได้ให้กับทหารอากาศฝรั่งเศส พาหนะรุ่นนี้ติดตั้งปืนใหญ่ขนาด 90 มม.และมีตัวถังที่เตี้ยมาก ที่นั่งของพลรถถังสองคนนั้นอยู่ในป้อมปืนซึ่งสามารถหมุนได้ 360 องศาแต่ก็ต่อเมื่อพาหนะไม่ได้เคลื่อนที่เท่านั้น มีการวางแผนรุ่นดัดแปลงที่ติดตั้งปืนแบบอื่น และมีการผลิตรถต้นแบบขึ้นเพียงคันเดียว แต่ก็ไม่ได้เข้าประจำการ"

msgid "F62_ELC_AMX_short"
msgstr "AMX ELC bis"

msgid "F64_AMX_50Fosh_B"
msgstr "AMX 50 Foch B"

msgid "F64_AMX_50Fosh_B_7x7"
msgstr "AMX 50 Foch B 7x7"

msgid "F64_AMX_50Fosh_B_7x7_short"
msgstr "Foch B 7x7"

msgid "F64_AMX_50Fosh_B_descr"
msgstr "โครงการยานพิฆาตรถถัง AMX 50 Foch ติดตั้งปืนใหญ่ขนาด 120 มม.พร้อมระบบป้อนกระสุนอัตโนมัติ อย่างไรก็ตามการสร้าง AMX 50 120 ที่ใช้อาวุธเหมือนกันก็เริ่มในช่วงเดียวกัน โครงการถือว่าไม่มีประสิทธิภาพพอเมื่อทำการเปรียบเทียบกัน ตัวรถมีอยู่ในแบบพิมพ์เขียวเท่านั้น"

msgid "F64_AMX_50Fosh_B_short"
msgstr "Foch B"

msgid "F67_Bat_Chatillon155_55"
msgstr "Bat.-Châtillon 155 55"

msgid "F67_Bat_Chatillon155_55_descr"
msgstr "ในช่วงกลางทศวรรษ 1950 Batignolles-Châtillon ได้พัฒนาต้นฉบับปืนอัตตาจรหนักที่มีองค์ประกอบบางส่วนจากตัวถัง M47 ของสหรัฐฯ พาหนะคันนี้ติดตั้งปืนใหญ่สนาม 155 มม.เข้ากับป้อมปืนหมุนได้ มีการสร้างรถต้นแบบอย่างน้อยหนึ่งคัน ไม่ได้เข้าสายการผลิตจำนวนมาก"

msgid "F67_Bat_Chatillon155_55_short"
msgstr "B-C 155 55"

msgid "F68_AMX_Chasseur_de_char_46"
msgstr "AMX Chasseur de chars"

msgid "F68_AMX_Chasseur_de_char_46_descr"
msgstr "ในปี 1946 บริษัท AMX ได้เสนอการออกแบบพาหนะแบบใหม่โดยมีเครื่องยนต์ที่ทรงพลังและน้ำหนักที่เบาที่จะทำให้พาหนะรุ่นนี้คล่องแคล่วอย่างมาก และปืน 90 มม.พร้อมด้วยกลไกป้อนกระสุนทำให้สามารถยิงได้อย่างรวดเร็ว อย่างไรก็ตามมิติที่ใหญ่ เกราะที่บาง และความซับซ้อนของการออกแบบทำให้รถถังรุ่นนี้ไม่น่าสนใจ และโครงการก็ไม่ได้มีการสร้างรถต้นแบบขึ้นแต่อย่างใด"

msgid "F68_AMX_Chasseur_de_char_46_long_special"
msgstr "นี่คือหนึ่งในพาหนะที่เร็วที่สุดในบรรดาพาหนะระดับเดียวกัน นอกจากนี้ยังได้ติดตั้งปืนที่สมบูรณ์แบบเอาไว้ อย่างไรก็ตาม ส่วนนี้ก็ถูกชดเชยด้วยเกราะที่บางซึ่งทำให้พาหนะไม่ควรถูกยิงแม้แต่น้อย แต่ทั้งนี้มันก็ยังเป็นพาหนะที่ยิงให้โดนได้ยาก!"

msgid "F68_AMX_Chasseur_de_char_46_short"
msgstr "AMX CDC"

msgid "F68_AMX_Chasseur_de_char_46_short_special"
msgstr "ปืนที่ไว้ใจได้ ความคล่องตัวที่สมบูรณ์แบบ ระยะการมองเห็นที่ดี"

msgid "F69_AMX13_57_100"
msgstr "AMX 13 57"

msgid "F69_AMX13_57_100_GrandFinal"
msgstr "AMX 13 57 GF"

msgid "F69_AMX13_57_100_GrandFinal_descr"
msgstr "บริษัท AMX เป็นผู้ออกแบบรถถังเบารุ่นนี้โดยตั้งใจว่าจะติดตั้งปืนใหญ่ 57 มม. L/100 แต่ปัญหาในช่วงการพัฒนาทำให้โครงการล่า้าและในช่วงทศวรรษที่ 1950 รถถังรุ่นนี้ก็ยังไม่พร้อมนำเสนอ ถึงตอนนั้น ได้มีการผลิตรุ่นดัดแปลงตัวถังพร้อมกับติดตั้งปืนใหญ่ 75 มม. บนป้อมปืนแทน และรุ่นปืนขนาด 57 มม.ก็ถูกยกเลิก"

msgid "F69_AMX13_57_100_GrandFinal_long_special"
msgstr "รถถังเบาคันนี้ติดตั้งปืนใช้ระบบป้อนกระสุนแบบซองที่มีศักยภาพการทำความเสียหายสูง รถถังนี้เหมาะที่สุดในการรบประชิด กระุสนแปดนัดของมันสามารถทำความเสียหายมหาศาลในเวลาอันสั้น"

msgid "F69_AMX13_57_100_GrandFinal_short"
