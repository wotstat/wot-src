msgid "mode/fort_rush_battle/condition"
msgstr "7ต่อ7 %(parSecondary_open)sI%(parSecondary_close)s ระดับ&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "เข้าควบคุมเสาอากาศ ยึดเครือข่าย\r\nแล้วดึงข้อมูลส่งสัญญาณให้ได้"

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "สมรรถนะคอมพิวเตอร์ของคุณนั้นไม่เพียงพอสำหรับรูปแบบนี้ คุณอาจจะพบปัญหาทางเทคนิคกับกราฟฟิคและการเคลื่อนที่ของพาหนะ และเป็นไปได้ที่โปรแกรมลูกข่ายเกมจะล่ม"

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "สมรรถนะต่ำ"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) สมรรถนะต่ำ"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "รูปแบบนี้จำเป็นต้องใช้คอมพิวเตอร์สมรรถนะสูงกว่าปกติ คุณอาจจะประสบปัญหากับการโหลดแผนที่ กราฟฟิค และการเคลื่อนที่ของพาหนะ ในกรณีที่สมรรถนะเครื่องไม่เพียงพอ โปรดลองลดคุณภาพกราฟฟิคในการตั้งค่าของคุณลง"

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "สมรรถนะที่ลดลง"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) สมรรถนะที่ลดลง"
