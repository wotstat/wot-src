msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s Klass&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Ta kontroll över antennerna. Säkra nätverket. Skydda sändningen."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Din dators prestanda räcker inte för detta läge. Du kan uppleva grafikproblem och problem att köra din vagn. Det är även troligt att spelklienten kommer krascha."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Låg prestanda"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Låg prestanda"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Striderna kräver hög datorprestanda. Du kommer uppleva att kartorna laddar långsamt, grafikproblem och problem att köra din vagn. Om du upplever att din dator inte klarar av detta bör du sänka kvalitetsinställningarna."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Reducerad prestanda"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Reducerad prestanda"
