msgid "battleship/name"
msgstr "Signalrök"

msgid "battleship/shortDescr"
msgstr "Rök som anger mål för en salva från slagskeppets tunga artilleri. Åsamkar stor skada på fientligt materiel och anläggningar i verkansområdet."

msgid "distraction_ability/name"
msgstr "Falsk order"

msgid "distraction_ability/shortDescr"
msgstr "Låt gefreiter Keller ge falska order över den erövrade tyska radion som får fienden att undersöka en den angivna positionen."

msgid "recon_ability/name"
msgstr "Spaningsrunda"

msgid "recon_ability/shortDescr"
msgstr "Skicka kapten Dubois att spana av den angivna positionen. Under spaningen står vagnen still. Spaningen fortsätter tills förmågan avbryts."

msgid "scc_airstrike_ability/name"
msgstr "Flygunderstöd"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Kallar in ett flyganfall mot angiven punkt."
