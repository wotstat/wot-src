msgid "alert"
msgstr "Du kan inte välja en stridsreserv under aktiv strid."

msgid "description/one/reserve"
msgstr "Väljer du reserven %(reserve_name)s flera gånger\nökas dess effekt."

msgid "description/second/reserve"
msgstr "Väljer du reserven %(first_reserve_name)s eller %(second_reserve_name)sflera gånger\nökas dess effekt."

msgid "number_1"
msgstr "1:a"

msgid "number_2"
msgstr "2:a"

msgid "number_3"
msgstr "3:e"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Lägger ut ett minfält i det angivna området som är aktivt under en viss tid."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Åsamkar avsevärd skada på fiendevagnar inom ett litet område."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Chockar fiendevagnar och åsamkar skada inom ett stort område."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Ökar huvudutbildningen för spelarens besättning och allierade besättningar."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Ger en bonus till erövringshastighet, erövringsblockering och omladdning."

msgid "shortDescription/reserve/reconAbility"
msgstr "Upptäcker fiendevagnar och minfält."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Återställer en procentandel av vagnens träffpoäng."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Skyler alla vagnar inom och bakom röken."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Ger en ökad kamouflageförmåga och siktsträcka. Minskar fiendevagnars kamouflageförmåga."

msgid "title"
msgstr "%(number_name)s reservplatsen tillgänglig"
