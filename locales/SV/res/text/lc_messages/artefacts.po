msgid "br_respawn/name"
msgstr "Återvändning"

msgid "br_respawn/platoon/descr"
msgstr "Låter dig återvända till striden när din vagn har förstörts. Gäller bara under de första %(duration)s min av striden.\n\nFör att få en allierad att återvända måste du hålla dig utanför strid under %(timeToResurrect)s s. Laddningar av Återvändning delas mellan plutonsmedlemmar."

msgid "br_respawn/solo/descr"
msgstr "Låter dig återvända till striden när din vagn har förstörts. Gäller bara under de första %(duration)s min av striden.\n\nNär du förstörs återvänder din vagn automatiskt för en ny insats."

msgid "br_smoke/battleDescr"
msgstr "Ger alla vagnar inom räckvidden för förnödenheten en %(duration)s sekunders kamouflagebonus."

msgid "br_smoke/descr"
msgstr "Ger alla vagnar inom räckvidden för förnödenheten en kamouflagebonus."

