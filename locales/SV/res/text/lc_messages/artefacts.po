msgid "artillery/longDescr"
msgstr "Kallar in artillerield med spränggranater mot ett litet område. Vagnar i mitten av verkansområdet tar mest skada. Speciellt effektiv mot tungt bepansrade vagnar."

msgid "artillery/name"
msgstr "Artilleriattack"

msgid "artillery/shortDescr"
msgstr "Åsamkar avsevärd skada på fiendevagnar inom ett litet område."

msgid "autoExtinguishers/always"
msgstr "%(vehicleFireChance)s minskad risk för motorbrand"

