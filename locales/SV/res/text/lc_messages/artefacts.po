msgid "berserker/battleDescr"
msgstr "Ökar genomslagsförmåga och eldhastighet med en faktor av %(gunPiercing)s, samtidigt som den minskar sikttid och siktesspridning med %(gunAimingTime)s, men minskar vagnens träffpoäng med %(healthDebuff)s under %(duration)s s.\n\n*Skada åsamkad av förmågan Bärsärk kan inte förstöra din vagn."

msgid "berserker/descr"
msgstr "Ökar genomslagsförmåga och eldhastighet med en faktor av %(gunPiercing)s, samtidigt som den minskar sikttid och siktesspridning med %(gunAimingTime)s, men minskar vagnens träffpoäng med %(healthDebuff)s under %(duration)s s.\n\n*Skada åsamkad av förmågan Bärsärk kan inte förstöra din vagn."

msgid "berserker/longDescr"
msgstr "Ökar genomslagsförmåga och eldhastighet med {green_Open}en faktor av %(gunPiercing)s{green_Close}, samtidigt som den minskar sikttid och siktesspridning {green_Open}med %(gunAimingTime)s{green_Close}, men minskar vagnens träffpoäng{whiteSpanish_Open} med {red_Open}%(healthDebuff)s{red_Close} under %(duration)s s.{whiteSpanish_Close}\n\n*Skada åsamkad av förmågan Bärsärk kan inte förstöra din vagn."

msgid "berserker/name"
msgstr "Bärsärk"

msgid "berserker/shortDescr"
msgstr "Ökar genomslagsförmåga och eldhastighet med {green_Open}en faktor av %(gunPiercing)s{green_Close}, samtidigt som den minskar sikttid och siktesspridning {green_Open}med %(gunAimingTime)s{green_Close}, men minskar vagnens träffpoäng{whiteSpanish_Open} med {red_Open}%(healthDebuff)s{red_Close} under %(duration)s s.{whiteSpanish_Close}\n\n*Skada åsamkad av förmågan Bärsärk kan inte förstöra din vagn."

