msgstr "Visar hur mycket en granat kan avvika från siktpunkten per 100 m till målet. Standardvärdet (första värdet) gäller för ett varmt eldrör, det bättre värdet (andra värdet) gäller för ett kallt eldrör."

msgid "tank_params/desc/speedLimits"
msgstr "Vagnens hastighet i enlighet med dess tekniska specifikationer."

msgid "tank_params/desc/stagedJetBoostersChargeDuration"
msgstr "Hur länge raketmotorn kan användas vid aktivering."

msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "Hur många gånger per strid raketmotorn kan användas."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Hur lång tid det tar efter användning innan raketmotorn kan användas igen."

