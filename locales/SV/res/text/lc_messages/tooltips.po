msgid "tank_params/desc/accuracyDispersionCap"
msgstr "Förbättring av siktesspridning vid maximal precisionsnivå."

msgid "tank_params/desc/accuracyDispersionPerLevel"
msgstr "Förbättring av siktesspridning per nivå av precision."

msgid "tank_params/desc/accuracyLevelGainTime"
msgstr "Tid som krävs för att gå upp en nivå i precisions."

msgid "tank_params/desc/accuracySpeedLimit"
msgstr "Över den här hastigheten kan inte precisionsnivån ökas."

msgid "tank_params/desc/accuracyWhileMovingDispersionCap"
msgstr "Förbättring av siktesspridning under rörelse eller skrov/kanonrotation vid maximal precisionsnivå."

msgid "tank_params/desc/activeCoincideceShootingCharge"
msgstr "Mängden Koincidensbaserat elektromekaniskt siktesladdning som genereras per träff på fiendevagn i Kampläge."

msgid "tank_params/desc/aimingTime"
msgstr "Tid för siktesspridningen att minska med 60% (standard / specialläge)."

msgid "tank_params/desc/aimingTimeCoincidenceElectromechanicalSight"
msgstr "Minskning av tiden det tar för siktesringen att krympa med 60% av den som ges av siktet."

msgid "tank_params/desc/aimingTimeTurbo"
msgstr "Extra sikttid som krävs i turboläge."

msgid "tank_params/desc/attainableSpeed"
msgstr "Vagnens hastighet efter 5 sekunders acceleration från stillastående över en horisontell yta.\nVärden visas för hårt/halvmjukt/mjukt underlag."

msgid "tank_params/desc/autoReloadTime"
msgstr "Tid för automatisk omladdning för varje granat i magasinet."

msgid "tank_params/desc/autoReloadTime/boost"
msgstr "Tid för automatisk omladdning för varje granat i magasinet"

msgid "tank_params/desc/autoReloadTime/boost/description"
msgstr "Det förbättrade systemet minskar tiden för att automatiskt ladda nästa granat när den laddade granaten avfyras när motsvarande indikator visas."

msgid "tank_params/desc/autoReloadTime/boost/shortDescription"
msgstr "Förbättrad automatladdare minskar omladdningstiden för automatisk omladdning av granater."

msgid "tank_params/desc/autoShootClipFireRate"
msgstr "Tiden det tar från att den sista granaten i magasinet (eller båda kanonerna) avfyrats och att ett nytt magasin laddats. / Antal eldrör eller granater i magasinet."

msgid "tank_params/desc/avgDamage"
msgstr "Genomsnittlig skada åsamkad av en standardgranat efter pansargenomslag. Skadepotentialen är +/-25% av angivet värde för skadeverkan."

msgid "tank_params/desc/avgDamagePerMinute"
msgstr "Total skada som kan åsamkas en fiendevagn på 1 minut om alla granater träffar och slår igenom pansaret."

msgid "tank_params/desc/avgDamagePerSecond"
msgstr "Potentiell skada åsamkad en fiende på 1 sekund av ihållande eldgivning om alla träffar slår igenom pansaret."

msgid "tank_params/desc/avgPiercingPower"
msgstr "Genomsnittlig genomslagsförmåga för en standardgranat efter normalisering. Värdet avviker +/-25% från angivet värde för genomslagsförmåga."

msgid "tank_params/desc/boosterCoolingTime"
msgstr "Den tid det tar för raketmotorerna att helt svalna efter att deras kritiska värmenivå har uppnåtts."

msgid "tank_params/desc/boosterDuration"
msgstr "Maximal varaktighet för raketmotorn vid aktivering."

msgid "tank_params/desc/burstFireRate"
msgstr "Omladdningstid mellan granater i salvan. / Antal salvor i magasinet. / Antal granater i salvan."

msgid "tank_params/desc/chargeTime"
msgstr "Tiden för att förbereda de två pjäserna för samtidig eldgivning. / Fördröjning av omladdning efter en salva avfyrats."

msgid "tank_params/desc/chargeableBurstDispersion"
msgstr "Siktesspridning för andra granaten i en salva, angivet i maximal avvikelse från siktpunkten på ett avstånd av 100 m."

msgid "tank_params/desc/chargeableBurstPenetrationCount"
msgstr "Antal träffar som slår igenom pansaret som krävs för att aktivera läget."

msgid "tank_params/desc/chargeableBurstReload"
msgstr "Tiden det tar att ladda om mellan första och andra skottet i en salva."

msgid "tank_params/desc/chargeableBurstSize"
msgstr "Antal granater i varje salva."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Reparationstid för skadat band."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Den tid det tar att reparera ett skadat huvud/reservband."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "Hur snabbt vagnens skrov roterar runt sin egen axel och hur snabbt den svänger när den är i rörelse (rörlighet)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "Nuvarande siktsträcka för vagnen. Maximalt avstånd du kan upptäcka en fiende på är 445m. Vidare ökning av denna parameter gör det lättare att upptäcka fiender inom 445m (standard/specialläge)."

msgid "tank_params/desc/clipFireRate"
msgstr "Tiden det tar från att den sista granaten i magasinet (eller båda kanonerna) avfyrats och att ett nytt magasin laddats. / Tiden det tar från avfyrande av en granat och att nästa granat i magasinet, pjäsen eller salvan laddats. / Antal pjäser eller granater i magasinet."

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Varaktighet för effekten av koincidensbaserat elektromekaniskt sikte vid aktivering."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Hur lång tid som krävs innan stabilisatorn kan aktiveras igen efter användning."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Hur lång tid stabilisatorn är aktiv."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Antal skott per minut borträknat omladdningstid."

msgid "tank_params/desc/coolingDelay"
msgstr "Hur lång tid det tar innan kanonen börjar kylas ned efter eldöppnande."

msgid "tank_params/desc/coolingTime"
msgstr "Hur långt tid det tar för en fullt uppvärmd kanon att kylas ned helt. Kanonen kan användas under den här tiden."

msgid "tank_params/desc/damage"
msgstr "Skada åsamkad av en standardgranat som penetrerar fiendens pansar."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Hur långt tid som krävs innan målvisaren kan användas igen. Nedkylningen påbörjas när kanonen avfyras."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Hur lång tid det tar från stridens början tills lasermålvisaren kan användas för första gången."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Hur länge markerade fiendevagnar förblir synliga och tar ökad skada från granater."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "Hur mycket skadeverkan ökas för fiendevagnar när de är markerade."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "Hur mycket siktet förbättrar siktesspridningen."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Visar hur lång tid det tar för kanonen att kylas ned nog för ökad träffsäkerhet efter eldöppnande."

msgid "tank_params/desc/enginePower"
msgstr "Parametern anger vagnens acceleration, toppfart och skrovtraversionshastighet."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Värdet anger vagnens acceleration och prestanda på olika typer av underlag (standard / specialläge)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "Hur mycket raketmotorn ökar vagnens accelerationsförmåga."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Värdet påverkar vagnens accelerationsförmåga, topphastighet och skrovrotationsförmåga i turboläge."

msgid "tank_params/desc/explosionRadius"
msgstr "Verkansområdet för en exploderande spränggranat som anger på hur långt avstånd från träffpunkten som granaten kan åsamka skada eller chockverkan."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Hur mycket tid som läggs till omladdningstiden för salvan efter sista granaten avfyrats."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Vagnens hastighet i enlighet med dess tekniska specifikationer."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "Skadebonusen per minut vid maximal omladdningseffektivitetsnivå."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Maximalt antal omladdningseffektivitetsnivåer som kan uppnås."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "Den tid en omladdningseffektivitetsnivå varar innan den går ut."

