msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "Ökning av siktesspridning vid förflyttning i turboläge."

msgid "tank_params/desc/overheatDuration"
msgstr "Hur långt tid det tar för en överhettad kanon att kylas ned. Kanonen kan inte användas när den kyls ned."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "Mängden Koincidensbaserat elektromekaniskt siktesladdning som genereras per sekund i Kampläge."

msgid "tank_params/desc/piercingPower"
msgstr "Hur tjockt pansar en normaliserad standardgranat kan slå igenom."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Hur snabbt vagnens skrov roterar runt sin egen axel och hur snabbt den svänger när den är i rörelse (rörlighet)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "Tiden som krävs för att växla mellan olika lägen beror på motorns kondition. En skadad motor ökar tiden det tar att växla. Du kan inte växla läge när motorn är förstörd."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "Tiden som krävs för att växla mellan olika lägen beror på motorns kondition. En skadad motor ökar tiden det tar att växla. Du kan inte växla läge när motorn är förstörd."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Hur snabbt skrovet roterar horisontellt i förskansningsläge."

msgid "tank_params/desc/pitchLimits"
msgstr "Gräns för kanonens vertikala rörelser i relation till skrovet och upphängningen."

msgid "tank_params/desc/powerModeDuration"
msgstr "Hur lång tid det tar att nå topphastighet och högsta motorstyrka i direktverkansläge."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Hur lång tid det tar att aktivera direktverkansläge."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "Förbättring av siktesspridning vid full förvärmning."

msgid "tank_params/desc/preheatDmgCap"
msgstr "Förbättring av genomsnittlig skadeverkan vid full förvärmning."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Högre hastighet förhindrar förvärmning och kan göra att den minskar."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Hur lång tid det tar för vagnen att nå full förvärmning från noll."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Hur lång tid det tar för vagnen att nå noll från full förvärmning."

msgid "tank_params/desc/preheatTransitionDelay"
