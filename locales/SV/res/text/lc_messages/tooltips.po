msgstr "Tiden innan full omladdning, då ett enkelladdat skott inte kan avfyras."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Ökad siktesspridning för enkelladdade skott. Anges i träffpunktens maximala avvikelse från siktpunkten på ett avstånd av 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Genomsnittlig genomslagsförmåga för en enkelladdad granat efter normalisering. Värdet avviker +/-25% från angivet värde för genomslagsförmåga."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Ökar antalet skott per minut för enkelladdade skott (jämfört med vanliga skott)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Utgångshastighet för en enkelladdad granat."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Maximal precisionsnivå som kan uppnås."

