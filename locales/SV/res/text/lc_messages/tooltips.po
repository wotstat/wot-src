msgid "tank_params/desc/propellantChargeLimit"
msgstr "Högsta laddningsnivå som kan nås utan att stänga av laddbegränsaren"

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "Hur mycket laddning som förbrukas vid eldgivning."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "Hur mycket laddning som automatiskt genereras per sekund."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "Hur mycket laddning som går förlorad per sekund när laddbegränsaren är aktiv, tills den når gränsen."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "Hur lång tid som måste gå innan laddbegränsaren kan växlas av/på igen."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "Hur mycket sikttiden ökar vid överladdning."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "Hur mycket extra skada som granaten åsamkar vid full laddning när laddbegränsaren är avstängd."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "Hur mycket extra skada granaten åsamkar utöver skadebonus vid överladdning."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "Hur mycket siktesspridningen på 100m ökar vid överladdning."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "Hur mycket extra skada som granaten åsamkar när laddbegränsaren är aktiv."

msgid "tank_params/desc/radioDistance"
msgstr "Kommunikation—spridning av information om fiendens positioner inom det egna laget. Kommunikationsräckvidden representeras av en cirkel med en radie som bestäms av denna parameter. När två eller fler cirklar överlappar varandra kan information delas mellan dessa och alla andra vagnar som kan nås inom kedjan."

msgid "tank_params/desc/reactivationDelay"
msgstr "Hur lång tid som krävs innan raketmotorn kan aktiveras igen efter användning."

msgid "tank_params/desc/reactivationLimit"
msgstr "Hösta värmenivå som kan hållas innan raketmotorn stängs av."

msgid "tank_params/desc/relativeArmor"
msgstr "En uppsättning parametrar som visar vagnens förmåga att överleva skada åsamkad av fienden."

msgid "tank_params/desc/relativeCamouflage"
msgstr "En uppsättning parametrar som visar hur effektivt vagnen är dold när den är stillastående, i rörelse och när den avfyrar kanonen. Kamouflagemålning ökar detta."

msgid "tank_params/desc/relativeMobility"
msgstr "En uppsättning parametrar som indikerar hur bra vagnen är på att byta position och röra sig över slagfältet."

msgid "tank_params/desc/relativePower"
msgstr "En uppsättning parametrar som indikerar hur bra vagnen är på att förstöra fiendevagnar."

msgid "tank_params/desc/relativeVisibility"
msgstr "En uppsättning parametrar som indikerar hur bra vagnen är på att upptäcka fiendevagnar."

msgid "tank_params/desc/reloadTime"
msgstr "Antalet skott per minut."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Hur mycket snabbare kanonen laddar om när siktet är aktivt."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Tiden det tar att ladda om kanonen (eller båda pjäserna om vagnen har en dubbelpjäs) efter eldgivning."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
msgstr "Hur lång tid det tar att ladda om kanonen efter eldgivning (enkelskott/salveld)."

msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
msgstr "Hur mycket vagnens backhastighet minskas när raketmotorn är aktiv."

msgid "tank_params/desc/rocketAccelerationEnginePower"
msgstr "Parametern anger vagnens acceleration, toppfart och skrovtraversionshastighet."

msgid "tank_params/desc/rocketAccelerationReuseAndDuration"
msgstr "Raketmotorer som ökar motorstyrka och topphastighet. Manöverförmågan minskas när raketmotorn används och den kan inte stängas av manuellt."

msgid "tank_params/desc/rocketAccelerationSpeedLimits"
msgstr "Nominell hastighet med aktiverad raketmotor."

msgid "tank_params/desc/secondaryAvgDamage"
msgstr "Genomsnittlig skadeverkan för förstärkningsvapen efter pansargenomslag. Skadepotentialen är +/-25% av den angivna nominella skadeverkan."

msgid "tank_params/desc/secondaryAvgPiercingPower"
msgstr "Genomsnittlig genomslagsförmåga för förstärkningsvapen efter normalisering. Värdet avviker +/-25% från det angivna nominella värdet för genomslagsförmåga."

msgid "tank_params/desc/secondaryReloadTimeSecs"
msgstr "Tid det tag att ladda om förstärkningsvapen efter det avfyrats."

msgid "tank_params/desc/secondaryTotalBurstSize"
msgstr "Antal granater tillgängliga för förstärkningsvapen vid varje aktivering."

msgid "tank_params/desc/shellLoadingTime"
msgstr "Hur långt tid det tar att ladda granater i början av striden och att växla mellan olika granattyper."

msgid "tank_params/desc/shotDispersionAngle"
msgstr "Siktesspridningen anger det maximala avstånd en granat avviker från siktespunkten på ett avstånd av 100m."

msgid "tank_params/desc/shotDispersionAngle/twinGun"
msgstr "Siktesspridningen anger det maximala avstånd en granat avviker från siktespunkten på ett avstånd av 100m (standard/special)."

