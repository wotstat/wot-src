msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Värdet påverkar hur länge plasmaefterbrännkammaren varar efter aktivering."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Egenskapen påverkar vagnens accelerationsförmåga, topphastighet och skrovrotation när plasmaefterbrännkammaren aktiverats."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
