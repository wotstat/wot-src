msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Hur lång tid det tar att nå varje nivå av uppvärmning."

msgid "tank_params/desc/heatingPerShot"
msgstr "Hur mycket värme kanonen genererar per avfyrat skott."

msgid "tank_params/desc/hullArmor"
msgstr "Skrovpansarets tjocklek: front / sida / bak respektive."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "Ökning av siktesspridning vid skrovrörelser i turboläge."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Värdet anger mängden skada åsamkad av rammning. Vid en kollision räknar systemet med pansartjocklek vid anslagspunkten, skillnaden i vagnarnas vikt och deras respektive hastigheter."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Värdet anger skadan åsamkad upphängningen vid rammning. Vid en kollision räknar systemet med pansartjocklek vid anslagspunkten, skillnaden i vagnarnas vikt och deras respektive hastigheter."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Anger hur svår en vagn i rörelse är att upptäcka. Högre värde gör det svårare att upptäcka vagnen. Följande parametrar är indikerade: vagn i rörelse / vagn i rörelse efter skott."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Anger hur svår en stillastående vagn är att upptäcka. Högre värde gör det svårare att upptäcka vagnen. Följande parametrar är indikerade: stillastående vagn / stillastående vagn efter skott."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
