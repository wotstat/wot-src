msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Utvecklad av Osaka Artilleriarsenal som en ersättning för Typ 2589. Vagnarna Chi-Ni och Chi-Ha genomgick gemensamma tester under 1937. Chi-Ha ansågs dock vara den bättre stridsvagnen. Endast en prototyp tillverkades."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Type-3 Chi-Nu-Kai är en kombination av upphängningen och tornet från Type-3 Chi-Nu och kanonen från Type-4 Chi-To. Endast en prototyp konstruerades. Den stod klar för tester i mars 1945."

msgid "Chi_Nu_Kai_long_special"
msgstr "Detta är en genomsnittlig medeltung vagn utan några uppenbara nackdelar. Den passar i de flesta situationer."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Hög träffsäkerhet, god genomslagsförmåga, tjockt pansar på kanonmanteln"

msgid "Continental_AOSI_1195_6"
msgstr "Continental AOSI-1195-6"

msgid "Edelweiss_Engine"
msgstr "Edelweiss"

msgid "Edelweiss_Radio"
msgstr "Edelweiss"

