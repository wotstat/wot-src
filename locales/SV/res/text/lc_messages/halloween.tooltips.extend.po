msgid "Contact/status/inBattle/halloween"
msgstr "I strid i Babylon: Mörka tornet"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Ett skott som skadar och chockar målet, och alla fiendevagnar inom 35 m radie."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Ett skott som återställer träffpoäng genom att stjäla dem från målet och fiendevagnar inom 35 m från träffpunkten."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Ett skott som chockar målet och alla fiendevagnar inom 35 m radie."

msgid "advanced/hw_damageShield"
msgstr "Skyddar mot all skada (förutom kollision, drunkning och fallskada) under 7 sekunder."

msgid "advanced/hw_fastReload"
msgstr "Ökar eldhastigheten / laddar om magasinet."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Återställer träffpoäng, släcker bränder, tar bort chockverkan och reparerar skadade moduler."

msgid "advanced/hw_invisibility"
msgstr "Gör vagnen tillfälligt osynlig för fienden. Återställer träffpoäng, reparerar moduler, släcker bränder, tar bort chockverkan och läker alla skadade besättningsmedlemmar."

msgid "advanced/hw_teamRepairKit"
msgstr "Reparerar skadade moduler, släcker bränder, tar bort chockverkan och återställer en del av träffpoängen för allierade vagnar inom verkansområdet."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Stridsförmågor höjer vagnens stridseffektivitet i Babylon: Mörka tornet, låter dig slutföra uppdragsmål och tjäna värdefulla belöningar. Placera dem på vagnarnas specialplatser för att använda dem."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Platser för stridsförmågor"

msgid "hwShell/alt/description"
msgstr "%(bold)s har en chans att tappas av förstörda fiender."

msgid "hwShell/alt/description/bold"
msgstr "En specialgranat"
