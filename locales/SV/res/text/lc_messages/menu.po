msgid "extraParams/desc"
msgstr "En egenskap som inte direkt påverkar vagnens förmåga att förstöra fienden."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Den totala bonusen beräknas baserat på både additiva och multiplikativa bonusar, så resultatet kan variera något från det angivna värdet."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Värdet anger tiden mellan avfyrning av artillerigranat och att varningen aktiveras."

msgid "extraParams/name/commanderLampDelay"
msgstr "Värdet visar hur snabbt vagnschefen kan avgöra att vagnen har blivit upptäckt av fienden. Ju högre värde, desto kortare fördröjning."

msgid "extraParams/name/crewHitChance"
msgstr "Värdet anger chansen för besättningen att undvika skador."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Värdet anger extra chocktid som läggs till en redan chockad fiende."

msgid "extraParams/name/crewStunDuration"
msgstr "Värdet anger hur lång tid mottagen chock varar."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Värdet anger hur mycket det minsta värdet för skadepotential och potentiellt pansargenomslag har förändrat gentemot basvärdet (–25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Värdet anger hur mycket det högsta värdet för skadepotential och potentiellt pansargenomslag har förändrat gentemot basvärdet (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Värdet anger mängden skada åsamkad av rammning. Vid en kollision räknar systemet med pansartjocklek vid anslagspunkten, skillnaden i vagnarnas vikt och deras respektive hastigheter."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Värdet anger hur lång tid det tar för vagnschefen att upptäcka och rapportera kritiska skador på fiendevagnen du siktar på."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Värdet anger hur synliga fiender som är helt täckta av växtlighet (både grupperad och enskild växtlighet). Gäller för både stillastående och rörliga vagnar."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Värdet anger hur synliga rörliga fiendevagnar är. Ju högre värde, desto lättare är de att upptäcka."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Värdet anger förändringar av chansen att åsamka kritiska skador på fiendens besättning och moduler. Effekten gäller alla granattyper förutom i vagnar med automatkanoner."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Värdet anger nedkylningstiden för förnödenheter."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Värdet anger hur mycket brandtiden och brandskadan har minskats."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Värdet anger maskeringseffekten bakom vegetation."

msgid "extraParams/name/hpRecover"
msgstr "Värdet visar ökningen av återställda träffpoäng från en Reparationslåda. Ju högre värde, desto fler träffpoäng återställs."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Värdet anger upphängningens terrängkörningsförmåga på halvmjukt underlag. Ju högre värde, desto snabbare nås topphastighet för underlaget."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Värdet anger minskningen av negativa effekter från förstörda observationsenheter på siktsträckan. Ju lägre värde, desto bättre siktsträcka."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Värdet visar ökningen av maximal genomslagspotential för granater när målet är inom 50 m. Ju högre värde, desto bättre genomslagsförmåga."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Värdet anger hur länge fiendens positioner rapporteras efter din vagn förstörts."

msgid "extraParams/name/radiomanHitChance"
msgstr "Värdet anger chansen för signalisten att undvika skador."

msgid "extraParams/name/shellVelocity"
msgstr "Värdet anger hur mycket snabbare alla typer av granater rör sig. Ju högre värde desto snabbare granater."

msgid "extraParams/name/softGroundFactor"
msgstr "Värdet anger upphängningens terrängkörningsförmåga på mjukt underlag. Ju högre värde, desto snabbare nås topphastighet för underlaget."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Värdet anger hur mycket effekten av chock påverkar besättningen."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Värdet visar minskningen av skada på upphängningen. Ju högre värde, desto mindre skada tar upphängningen."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Värdet anger minskningen av den negativa effekten av ett skadat ammunitionsställ på omladdningstiden. Ju högre värde, desto kortare omladdningstid."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Värdet visar minskningen av förlust av motorstyrka från en skadad motor. Ju högre värde desto mindre styrka förlorar motorn."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Värdet anger tåligheten hos ammunitionsställ, bränsletankar och motor. Ju högre värde desto hållbarare är dina moduler."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Värdet anger tåligheten hos ammunitionsstället. Ju högre värde desto hållbarare är ammunitionsstället."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Värdet anger skadan som åsamkas skrovet då upphängningen skadas vid kollision eller rammning. Den påverkar inte skada åsamkad sidorna eller toppen av tornet vid en kollision."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Värdet anger reparationshastigheten för upphängningen. Ju högre värde desto kortare tid tar reparationen."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Värdet anger upphängningens tålighet. Ju högre värde desto hållbarare är upphängningen mot både granater och kollision/rammning."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Värdet anger hur länge fiender förblir synliga efter de lämnat din siktsträcka. Standardvärdet är 10 sekunder."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Värdet visar minskning av skada åsamkad vagnen av kollisioner. Ju högre värde desto mindre skada tar vagnen."

msgid "extraParams/name/vehicleFireChance"
msgstr "Värdet anger risken för motorbrand när motorn skadas."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Värdet anger bränsletankarnas motstånd mot kritisk skada. Bränsletankar börjar alltid brinna då de förstörs."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Värdet anger hur mycket träffsäkerheten påverkas när vagnen rör sig eller när skrov eller torn roterar. Ju lägre värde desto mindre påverkas siktet."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Parametern visar siktets storlek efter eldgivning."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Värdet anger siktesspridning vid rörelser. Ju lägre värde desto träffsäkrare är kanonen."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Värdet anger siktesspridning vid skrovrotation. Ju lägre värde desto träffsäkrare är kanonen."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Värdet anger siktesspridning vid kanonrörelser. Ju lägre värde desto träffsäkrare är kanonen."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Värdet anger påverkan på siktesspridning från en skadad kanon. Ju högre värde desto mindre spridning."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Värdet skadan åsamkad vagnen av spränggranater och rammning. Ju kraftigare det träffade området är bepansrat, desto större effekt."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Parametern visar kamouflagevärde efter eldgivning."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Värdet anger hur länge din vagn förblir synlig när du lämnat fiendens siktsträcka. Standardvärdet är 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Värdet anger upphängningens skademinskning vid rammning. Vid en kollision räknar systemet med pansartjocklek vid anslagspunkten, skillnaden i vagnarnas vikt och deras respektive hastigheter."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Värdet anger skademinskning vid rammning. Vid en kollision räknar systemet med pansartjocklek vid anslagspunkten, skillnaden i vagnarnas vikt och deras respektive hastigheter."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Värdet anger mycket snabbare ammunitionstyp kan växlas i en laddad kanon."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Värdet anger hur mycket snabbare interna och externa moduler repareras från \"rött\" till \"gult\". Ju högre värde desto snabbare reparationer."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Värdet anger upphängningens manöverförmåga i terräng. Ju högre värde, desto snabbare når du din topphastighet för underlaget."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Värdet anger förmågan att ändra riktning för hjulfordon."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Värdet anger minskning av skadeeffekten på besättningsmedlemmarnas huvudutbildning (gäller ej vagnschefen)."

