msgstr "Du bröt mot spelets regler på kartan {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}, {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} gradpoäng har dragits av och du har tillfälligt stängts av från {whiteSpanish_Open}Pansarstorm{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Du bröt mot spelets regler på kartan {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}, {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nDu har tillfälligt stängts av från {whiteSpanish_Open}Pansarstorm{whiteSpanish_Close} och din rankning har sänkts."
