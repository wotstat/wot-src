msgstr "Gynnsam rörlighet"

msgid "LS_nitroSituational/onUse"
msgstr "<font color='#feab34'>Ökar</font> vagnens <font color='#feab34'>rörlighet</font> tillfälligt när du tar skada från en fiendevagn.\nAktiveringschans: <font color='#e9e2bf'>50%</font>."

