msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Delta i en slumpvis matchad strid i en vagn av valfri klass."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Välkommen till spelet! Kämpa med andra fans från hela världen och fira spektakulära segrar!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Första striden"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Forska fram och köp valfri vagn klass IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Att köpa en vagn i en ny klass är en viktig milstolpe. Med varje ny klass blir vagnarna intressantare. En vältränad besättning gör stor skillnad."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "En vagn klass IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Utkämpa tre slumpvis matchade strider i vagnar klass IV–X med ett utseendeelement på vagnen."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Du kan anpassa utseendet på dina vagnar med förinställda stilar, eller genom att skapa en egen stil med kamouflage, inskriptioner, emblem och dekaler."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Vagnsutseenden"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Börja träna en besättningsmedlem i valfri förmåga."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Besättningsmedlemmar kan träna fler förmågor för att bli effektivare eller kunna göra nya saker."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Besättningsförmågor"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Tjäna 150 000 krediter i slumpvis matchade strider utkämpade i vagnar klass IV–X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Ju högre stridsklass desto mer krediter kostar det att underhålla vagnen, fylla på ammunition samt köpa moduler och utrustning."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Samla krediter"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Forska fram och köp valfri vagn klass V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "I klass V börjar de riktigt seriösa vagnarna dyka upp och dina färdigheter sätts på prov på allvar. Nu kommer en fullt tränad besättning verkligen till pass."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "En vagn klass V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Utkämpa 10 slumpvis matchade strider i vagnar klass V–X med tre utrustningsdelar monterade."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Belagd optik eller Förbättrad ventilation? Rätt utrustning förbättrar vagnens styrkor och minskar svagheter."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montering av utrustning"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Slutför ett grundscenario i Topografiläget."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "För att få självförtroende på slagfältet är det bäst att ha goda kunskaper om anfallsvägar, taktik och kartan, inklusive nyckelpositioner och viktiga objekt."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografi"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Slutför fyra avancerade scenarion på samma karta i Topografi."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Delta i Topografi då och då för att studera kartor för slumpvis matchade strider. De fyra scenariona låter dig utforska terrängen från olika utgångslägen."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Avancerad topografi"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Utkämpa 10 slumpvis matchade strider i vagnar klass V–X med personliga reserver aktiverade."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "När du aktiverar personliga reserver får du en bonus på all stridserfarenhet, besättningserfarenhet och Fri erfarenhet, eller krediter du tjänar i strid."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Personliga reserver"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Segra och var en av de 10 spelare i laget som tjänar mest erfarenhet sex gånger i slumpvis matchade strider utkämpade i vagnar klass V–X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Uppdragen ger dig fem gånger mer erfarenhet för en seger. Strider räknas bara om du är en av de 10 spelare i laget som tjänar mest erfarenhet."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 uppdrag som ger 5× erf."

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Forska fram och montera en modul på en vagn av valfri klass."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Du får stridserfarenhet efter varje strid. Du måste tjäna stridserfarenhet för att kunna forska fram nya moduler som förbättrar vagnens egenskaper."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Stridserfarenhet"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Forska fram och köp valfri vagn klass VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Ju högre vagnsklass, desto mer tid och ansträngning krävs för att forska fram nya vagnar. Fri erfarenhet hjälper dig göra snabbare framsteg."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "En vagn klass VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Slutför ett personligt uppdrag i valfri kampanj."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanjer är uppdragsserier för olika vagnstyper. När du slutför en serie får du värdefulla belöningar och unika vagnar."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Personliga uppdrag"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Träna en besättning med en Allmän lärobok."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Läromedel låter dig öka besättningens träning avsevärt genom att direkt ge en besättningsmedlem, eller hela besättningen, en viss mängd erfarenhet."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Läromedel"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Utkämpa 10 slumpvis matchade strider i vagnar klass VI–X utrustade med en besättningsanvisning."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Anvisningar kan öka besättningens förmågor under en strid. Precis som förnödenheter kan anvisningar köpas eller fås som belöning."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Besättningsanvisningar"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Köp ett Nybörjarpaket i affären i spelet."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Du kan köpa allt du behöver i affären i spelet, bl.a guld, Premiumvagnar och mycket mer. Där hittar du alltid massor av erbjudanden och rabatter."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Affär"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Utkämpa 10 slumpvis matchade strider i Premiumvagnar klass VI–X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Dessa vagnar kräver ingen forskning. De tjänar extra stridserfarenhet, besättningserfarenhet och krediter samt låter dig flytta besättningar utan omskolning."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premiumvagnar"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Utkämpa 10 slumpvis matchade strider i vagnar klass VI–X utrustade med en utrustningsanvisning."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Anvisningar låter dig öka effekten av monterad utrustning. Precis som förnödenheter kan du köpa anvisningar eller få dem som belöning."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Utrustningsanvisningar"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Var en av de 10 spelare i laget som tjänar mest erfarenhet 15 gånger i slumpvis matchade strider utkämpade i vagnar klass VI–X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Uppdragen ger dig fem gånger mer erfarenhet för en seger. Strider räknas bara om du är en av de 10 spelare i laget som tjänar mest erfarenhet."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 uppdrag som ger 5× erf."

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Forska fram och köp valfri vagn klass VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "I den här vagnsklassen ställs ännu högre krav på dina färdigheter. Vagnarna blir mer kraftfulla och effektiva – men så blir även motståndarna."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "En vagn klass VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Delta i 10 slumpvis matchade strider i vagnar klass VII–X utrustade med Stor förbandslåda, Stor reparationslåda och Automatisk brandsläckare."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Stora förnödenheter reparerar skadade moduler snabbare än deras mindre motsvarighet. De minskar även chocktid och brandrisk samt har kortare nedkylningstid."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Stora förnödenheter"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Tjäna dubbel erfarenhet för dagens första seger i slumpvis matchade strider i en vagn av valfri klass."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Alla dina vagnar kan tjäna dubbel erfarenhet första gången du segrar med dem varje dag. Utnyttja det för att uppgradera dina vagnar ännu snabbare."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Erfarenhetsbonus"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Skapa ett ritningsfragment för en vagn du inte forskat fram."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Ritningar minskar erfarenheten som krävs för att forska fram en vagn. Erhålls som belöning eller konverteras från allmänna och nationella ritningsfragment."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Vagnsritningar"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Var en av de 10 spelare i laget som tjänar mest erfarenhet 20 gånger i slumpvis matchade strider utkämpade i vagnar klass VII–X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Uppdragen ger dig fem gånger mer erfarenhet för en seger. Strider räknas bara om du är en av de 10 spelare i laget som tjänar mest erfarenhet."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 uppdrag som ger 5× erf."

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Forska fram och köp valfri vagn klass VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "I klass VIII behöver du utnyttja allt du lärt dig. Fienden kommer dra nytta av minsta misstag, så spänningen är otroligt hög och ger ovärderlig erfarenhet."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "En vagn klass VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Använd Fri erfarenhet för att forska fram en valfri modul."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Om du saknar stridserfarenhet för att forska fram en modul eller vagn kan du använda Fri erfarenhet som du kan tjäna med alla vagnar."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Fri erfarenhet"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Ladda flera olika granattyper och delta i en slumpvis matchad strid i en vagn klass III–X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Pansarprojektiler, spränggranater och tungstensprojektiler är olika granattyper för olika stridssituationer. Välj rätt för att få övertaget!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Ammunition"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Sälj en oanvänd modul från förrådet."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Oanvända moduler, granater, utrustning, förnödenheter o.dyl. förvaras i förrådet. Du kan sälja överskottsmateriel för att få in krediter."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Förråd"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Tjäna 25 000 krediter i slumpvis matchade strider utkämpade i vagnar klass III–X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Krediter används för att köpa granater och nya vagnar, reparera vagnar efter strid m.m. Det är viktigt att lära sig spara och använda dem klokt."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Krediter"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Utkämpa tre slumpvis matchade strider i vagnar klass III–X med förnödenheter monterade på alla tillgängliga platser."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Förnödenheter kan laga kritiska vagnskador och läka besättningen under stridens gång. Använd förnödenheter vid rätt tillfälle för att överleva på slagfältet."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Förnödenheter"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Utkämpa tre slumpvis matchade strider i en vagn klass III–X med valfri utrustning monterad."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Du kan extrautrusta dina vagnar för att förbättra vissa stridsegenskaper. Beroende på vilken spelstil du föredrar kan du välja olika utrustningsuppsättning."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Utrustning"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Slutför ett scenario på valfri karta i Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Slutför fyra grundläggande scenarion på samma karta i Topografi"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Rekognoscering"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Slutför fyra avancerade scenarion på samma karta i Topografi"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "A i Geografi"
