msgid "entryPoint/tooltip/description"
msgstr "Detta är speciallådor med unikt och värdefullt spelinnehåll.\nDu kan köpa lådor i affären i spelet eller Premiumaffären."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Drakbåtslådor tillfälligt ej tillgängliga"

