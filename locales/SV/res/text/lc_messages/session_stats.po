msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Förhållandet mellan total mängd blockerad skada och antalet genomförda strider under sessionen. Deltavärdet visar effekten av nuvarande spelsession på totalvärdet."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Förhållandet mellan total skada åsamkad under din observation, skada åsamkad vagnar du immobiliserat genom att förstöra deras band eller chockat och antalet genomförda strider under sessionen. Deltavärdet visar effekten av nuvarande spelsession på totalvärdet."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Förhållandet mellan total åsamkad skada och total mottagen skada under sessionen. Deltavärdet visar effekten av nuvarande spelsession på totalvärdet."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Förhållandet mellan antal förstörda fiendevagnar och antalet gånger spelarens vagn förstördes. Deltavärdet visar effekten av nuvarande spelsession på totalvärdet."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Förhållandet mellan upptäckta fiendevagnar och strider utkämpade under sessionen."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Procent strider spelarens vagn inte slagits ut."

