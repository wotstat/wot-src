msgid "hint/LSH_FIRE"
msgstr "Rök försvårar upptäckande av fiendevagnar och signalering av deras position. Brand skadar vagnar."

msgid "hint/LSH_FOG"
msgstr "Dimma försvårar upptäckande av fiendevagnar och signalering av deras position."

msgid "hint/LSH_RAIN"
msgstr "Kraftigt regn försvårar upptäckande av fiendevagnar och signalering av deras position."

msgid "hint/LSH_SANDSTORM"
msgstr "Sandstormar försvårar upptäckande av fiendevagnar och signalering av deras position."

msgid "hint/LSH_SMOKE"
msgstr "Rök försvårar upptäckande av fiendevagnar och signalering av deras position."

msgid "hint/PPH_AIMING_01"
msgstr "Torn- och skrovrörelser minskar <font color='#EE7000'>kanonens träffsäkerhet</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Cirkeln runt siktet visar <font color='#EE7000'>träffområdet</font>. Vänta lite så ökar träffsäkerheten."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatiskt Sikte</font> aktiverat. Tryck höger musknapp för att stänga av."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatiskt Sikte siktar alltid <font color='#EE7000'>mot centrum</font> av ditt mål"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Din bas håller på att <font color='#EE7000'>erövras!</font> Om ni inte försvarar den vinner fiendelaget striden."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Varje fiendevagn genererar <font color='#EE7000'>sina egna</font> erövringsframsteg"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Att <font color='#EE7000'>erövra</font> fiendebasen är ett av sätten du kan vinna striden"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "När du blir skadad <font color='#EE7000'>nollställs</font> dina erövringsframsteg"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Du <font color='#EE7000'>förlorar</font> dina erövringspoäng om du lämnar bascirkeln"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Flera vagnar erövrar en bas <font color='#EE7000'>snabbare</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Takten på baserövringen ökar inte efter den <font color='#EE7000'>tredje</font> vagnen"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Fiendebasen är nästan erövrad!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Ditt lag vinner baserövringsracet!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Vagnsmodul kritiskt skadad! Reparera den med <font color='#EE7000'>reparationslådan</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Vagnsmodul kritiskt skadad! Reparera den med <font color='#EE7000'>reparationslådan</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Besättningsmedlem skadad! Använd <font color='#EE7000'>förbandslådan</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Besättningsmedlem skadad! Använd <font color='#EE7000'>förbandslådan</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Besättningsmedlem chockad! Använd <font color='#EE7000'>förbandslådan</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vagnen brinner! Använd <font color='#EE7000'>brandsläckaren</font> i bottenpanelen."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vagnen brinner! <font color='#EE7000'>Automatisk brandsläckare</font> aktiverad."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Vagnsmodul kritiskt skadad! Du kan utrusta dig med <font color='#EE7000'>en reparationslåda</font> före strid för att hantera kritiska träffar."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Besättningsmedlem skadad! Du kan utrusta dig med <font color='#EE7000'>en förbandslåda</font> före strid för att hantera besättningsskador."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Besättningsmedlem skadad! Du kan utrusta dig med <font color='#EE7000'>en brandsläckare</font> före strid för att hantera bränder."

msgid "hint/PPH_OTHER_01"
msgstr "Du är <font color='#EE7000'>upptäckt</font> – eldöppnande kan avslöja din position!"

msgid "hint/PPH_OTHER_02"
msgstr "Din vagn är förstörd. Du kan trycka <font color='#EE7000'>Esc</font> för att lämna striden utan negativa konsekvenser."

msgid "hint/PPH_OTHER_03"
msgstr "Din vagn är förstörd. Du kan trycka på musknappen för att se på striden som <font color='#EE7000'>åskådare</font>."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Glödlampsikonen</font> visar att du är upptäckt av fienden!"

msgid "hint/PPH_OTHER_05"
msgstr "Din kanon är inte <font color='#EE7000'>omladdad</font> än"

msgid "hint/PPH_OTHER_06"
msgstr "Din kanon kan bara avfyras när cirkeln runt siktet är <font color='#EE7000'>helt grön</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Använd mushjulet för att gå in i <font color='#EE7000'>prickskytteläget</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Använd mushjulet för att <font color='#EE7000'>lämna</font> prickskytteläget"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Ett <font color='#EE7000'>grönt inre sikte</font> indikerar en hög chans att slå igenom fiendens pansar"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Även om inre siktet är grönt är du inte <font color='#EE7000'>garanterad</font> pansargenomslag"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Kanonen är aldrig 100% träffäsäker, så skottet kanske <font color='#EE7000'>inte aldrig träffar mitt i</font> siktet"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Det inre siktet indikerar chansen att slå igenom fiendens pansar. <font color='#EE7000'>Aktivera det i inställningarna</font>."

msgid "penetration/chance/high"
msgstr "Hög chans"

msgid "penetration/chance/low"
msgstr "Låg chans"

msgid "penetration/chance/medium"
msgstr "Medelchans"
