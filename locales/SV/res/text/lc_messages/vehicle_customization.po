msgid "special_style/NY2020_christmas_desc"
msgstr "En pepparkaksskytt sitter i en pepparkaksvagn. Är vagnen gjord av kött, eller är han gjord av pansar? Han måste skrika, för han kan inte veta."

msgid "special_style/NY2020_christmas_desc/long"
