msgid "special_style/NY2020_new_year_desc"
msgstr "En stil baserad på den persiske prinsen Dyuds legendariska matta. Nej, den kunde inte flyga, men den kunde definitivt lyfta känslan i ett rum."

msgid "special_style/NY2020_new_year_desc/long"
msgstr "?empty?"

msgid "special_style/NY2020_regular_clone"
