msgstr "En allterrängsstil kan köpas under delmoment I av Pansarjakt 2020. Den är uppkallad efter jaktens gudinna i den grekiska mytologin."

msgid "special_style/sh2020_paid_2"
msgstr "Ullrs Sköld"

msgid "special_style/sh2020_paid_2_desc"
msgstr "En allterrängsstil kan köpas under delmoment II av Pansarjakt 2020. Den är uppkallad efter jaktens gud i den nordiska mytologin."

