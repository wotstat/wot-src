msgid "entryPoint/tooltip/description"
msgstr "Detta är speciella lådor som innehåller nya och unika vagnar klass VIII–X och andra belöningar.\nDu kan erhålla lådorna som bonus vid köp i Premiumaffären samt från andra sorters lådor."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Lådor kan inte öppnas eller köpas för tillfället på grund av tekniska problem. Vi ber om ursäkt för besväret."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Gudomligt välsignade lådor tillfälligt ej tillgängliga"

msgid "eventName/lowerCase"
msgstr "Gudomlig välsignelse"

msgid "eventName/upperCase"
msgstr "GUDOMLIG VÄLSIGNELSE"

msgid "infoPage/footer/description/autoOpen"
msgstr "Om du inte öppnar alla lådor innan evenemanget avslutas kommer de öppnas automatiskt."

msgid "infoPage/footer/description/compensation"
msgstr "Om du redan äger alla vagnar i lådan får du en Utvald prislåda som garanterad belöning istället för en vagn."

msgid "infoPage/footer/description/guaranteed"
msgstr "Du är garanterad en Premiumvagn klass VIII–IX för varje %(guaranteed0)s Himmelska-, %(guaranteed1)s Välsignade och %(guaranteed2)s Utvalda prislådor du öppnar. Om du öppnar så många lådor utan att få en vagn så kommer den %(guaranteed0)s:e/%(guaranteed1)s:e/%(guaranteed2)s:e lådan (beroende på typ av låda) innehålla en Premiumvagn klass VIII–IX du inte redan äger. Därefter nollställs räkningen."

msgid "infoPage/footer/title/compensation"
msgstr "När alla vagnar mottagits"

msgid "infoPage/header/description"
msgstr "Öppna lådor för en chans att få värdefullt spelinnehåll!\nSe vinsttablån nedan."

msgid "noBoxesView/description/"
msgstr "Du har inga lådor.\nDu kan skaffa dem i Premiumaffären."

msgid "singleRewardView/tooltip/boxName/"
msgstr "Utvald prislåda"

msgid "singleRewardView/tooltip/description/"
msgstr "Om du redan äger alla vagnar i lådan får du en Utvald prislåda som garanterad belöning istället för en vagn."

