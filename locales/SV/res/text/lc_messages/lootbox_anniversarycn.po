msgstr "Lådorna kan innehålla Premiumvagnar klass VIII, spelvaluta eller annat värdefullt spelinnehåll."

msgid "boxTooltip/description/text/gold"
msgstr "Lådorna kan innehålla Premiumvagnar klass X, spelvaluta eller annat värdefullt spelinnehåll."

msgid "boxTooltip/description/text/silver"
msgstr "Lådorna kan innehålla Premiumvagnar klass IX, spelvaluta eller annat värdefullt spelinnehåll."

msgid "boxTooltip/howGet/text/bronze"
