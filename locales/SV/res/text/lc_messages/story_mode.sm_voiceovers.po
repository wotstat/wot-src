msgid "vo_sm_char10_m05_stg21_02"
msgstr "Högkvarteret: Landstigningsplats Echo-5 säkrad. Pansar framrycker. Ge dem allt tillgängligt eldunderstöd."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Stabsofficer: Omdirigera flyget att understödja pansarets framryckning."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Stabsofficer: Ingenjörstrupper, röj vägen för vidare framryckning."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Stabsofficer: Stranden är säkrad. Sätter in huvudstyrkan nu. Utmärkt jobbat."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Stabsofficer: Håll position. Förstärkningar är på väg."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Högkvarteret: Skydda landstigningsplatsen till varje pris."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Stabsofficer: En stridsvagn till och ännu en chans. Var försiktig den här gången."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Stabsofficer: Vi börjar få slut på reserver. Se till att den här gången räknas, befälhavare."

