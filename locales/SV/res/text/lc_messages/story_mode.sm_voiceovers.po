msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfirepilot: Dålig sikt, kan inte ge understöd!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfirepilot: För mycket luftvärnseld, kan inte ge understöd!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfirepilot: Luftvärnselden är för kraftig. Kan inte justera elden."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfirepilot: Känns som en snöstorm av flak här uppe, va?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfirepilot: Kan inte justera elden när de skjuter så här."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfirepilot: De där luftvärnsbatterierna vid bunkrarna måste tystas."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfirepilot: Vi kan gå lite lägre nu."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfirepilot: Jag kan leda elden för de stora kanonerna om du markerar med rök."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfirepilot: Pansar, det är upp till er nu!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfirepilot: Jag ser röken."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfirepilot: Vidarebefordrar koordinater till slagskeppet för direktverkan."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfirepilot: Tusan, en av våra är nedskjuten! Kan inte gå lägre än."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfirepilot: Vi måste slå ut luftvärnspjäserna nu!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfirepilot: Luftvärn utslaget, jag går lägre nu. Redo att leda tätare eld från slagskeppet."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfirepilot: Lystring! Jag ser en stor fiendestyrka på väg mot er. "

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfirepilot: De kommer med allt de har."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfirepilot: Hör upp, en ny fiendestyrka är på väg. Håll ögonen öppna där nere."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfirepilot: Varning, här kommer den sista och största vågen fiender."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfirepilot: De kommer från alla håll. Var redo."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfirepilot: Ser signalröken tydligt. Skickar koordinaterna till slagskeppet."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfirepilot: Ah, där är röksignalen. Jag vidarebefordrar positionen till slagskeppet."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfirepilot: Rök i målet. Skickar positionen till slagskeppet."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfirepilot: Jag ser röken, ser ut som våra vänner behöver lite hjälp."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Eldledare USS Frankford: Inväntar koordinater för eldunderstöd."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Eldledare USS Frankford: Blind eld är riskabelt, kan träffa våra egna."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Eldledare USS Frankford: Korrekt målangivelse krävs, håller elden."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Eldledare USS Frankford: Detta är eldledningen på USS Frankford. Svar: nej."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Eldledare USS Frankford: Kan inte ge understödja framryckningen. För dålig sikt."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Eldledare USS Frankford: Kan inte se klipporna eller värnen, kan bara se vårt pansar på stranden."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Eldledare USS Frankford: Observerar pansar i strid vid klipporna."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Eldledare USS Frankford: Vi ger understödseld i den riktningen."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Eldledare USS Frankford: Hoppas Sherman vet vad han skjuter på."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Eldledare USS Frankford: Sherman har växlat mål. Vi justerar elden."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Eldledare USS Frankford: Sherman har slutat skjuta. Uppgiften slutförd."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Eldledare USS Frankford: Vi kan inte nå ställningarna längre inåt landet."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Eldledare USS Frankford: Vi drar oss tillbaka till säkrare position. Lycka till på stranden."

