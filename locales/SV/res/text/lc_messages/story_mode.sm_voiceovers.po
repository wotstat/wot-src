msgid "vo_sm_char11_m03_stg18_03"
msgstr "Pilot: Hallå där på marken, detta är Eagle-One."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Pilot: Vi flyger an mot staden nu, en hel massa vagnar i siktet."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Pilot: Och vi är redo att släppa våra paket. Se till att hålla er ur vägen där nere."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Pilot: Eagle-One, slut kom."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Pilot: Eagle-One här, det är uppfattat klart och tydligt."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Pilot: Vi har en liten grupp mål samlade på torget."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Pilot: Börjar anflygning nu."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Pilot: Allt vi inte gör till fyrverkerier är ert. God jakt! Kom."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Pilot: Var kom de ifrån? Jag trodde eskorten hade rensat åt oss."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Pilot: Eagle One här, kom."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Pilot: Ni har en rejäl grupp pansarfordon på väg från byn mot er."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Pilot: Vi gör ett nytt anfa... Förbannat!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Pilot: Jaktplan klockan åtta... Kan inte skaka av mig honom."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Pilot: Var i helvete är vår eskort! A-a-ahh!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Pilot: Storm Petrel här."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Pilot: Det är uppfattat. Kungstigern kommer strax ha en dålig dag."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Pilot: Förbannat också!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Pilot: Fiende förstörd."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Pilot: Storm Petrel, inte sjöfågel."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Pilot: Jag ser den."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Pilot: Målet förstört om 3... 2... 1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Pilot: Redo för nästa målangivelse, Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Pilot: Förbannat!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Pilot: Det är inte bara en Jagdtiger där nere. De gömmer sig bland byggnaderna."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Pilot: Vi behöver något mer lite mer kraft. Dags att kalla in något större!"

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Pilot: Det var allt! Redo för nästa!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Pilot: Redo att anfalla på din signal."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Pilot: Direktträff!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr "Pilot: Uppfattat! Anfaller!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Pilot: Äntligen! Återgår till bas. Vi ses snart, grabbar!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Pilot: Redo och inväntar mål."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Pilot: Inväntar målangivelse."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Pilot: Behöver målangivelse för anfall."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Pilot: Kan inte träffa den förrän du immobiliserar den."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Pilot: Målet måste stå stilla om jag ska träffa rätt."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Pilot: Ett stillastående mål är nyckeln till att träffa!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Pilot: Vänder planet, återkommer strax."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Pilot: Byter position, tillbaka snart."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Pilot: Redo att anfalla."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Pilot: Signalera när jag ska anfalla."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Pilot: Väntar fortfarande."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Pilot: Väntar fortfarande på order."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Pilot: Det är uppfattat. Påbörjar anflygning nu."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Pilot: Taget. Går till attack."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Pilot: Uppfattat. Anfaller målet."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Pilot: Uppfattar. Går in för anfall."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smith: Inte pappret i sig."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smith: Viljan hos miljoner människor. Män och kvinnor som kämpat för att ge det där pappret mening."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smith: Aldrig igen."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Vagnschef, kapten Smith: Rulla ut. Kom ihåg, det här är ett hemligt uppdrag."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smith: Undvik onödig stridskontakt och ge bara eld om det är absolut nödvändigt."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smith: Om vi väcker hela garnisonen är våra chanser minimala."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smith: Om det är möjligt tar vi alltid en omväg och gömmer oss."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smith: Ingen tid att förlora. Utgå. Varje sekund räknas."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smith: Släpp det. Vi är alla här för att stoppa ett blodbad. På båda sidor."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smith: HALT! Bakåt!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smith: Backa!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smith: Backa! Snabbare!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smith: Bakåt, nu!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smith: Göm dig!"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smith: Det verkar som de inte riktigt såg oss."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smith: Mörkret är till vår fördel – det tar dem längre tid att identifiera en amerikansk stridsvagn."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smith: Om vi tar oss igenom snabbt, kommer de inte att identifiera oss."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smith: Murphy, ta oss bakom det där hörnet."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smith: Bra, Murphy. Vi måste komma närmare. Och skjut inte!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smith: Smyg ännu närmare. Där!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smith: Kör snabbt så upptäcker de oss inte."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smith: Ju snabbare vi kör, desto mindre tid har de att lägga märke till oss."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smith: Om vi rör oss snabbt, har de inte tid att få en bra titt på oss."

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smith: Vi behöver spana framåt. Dubois, kolla läget."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smith: Jag sa släpp det, Kowalski."

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smith: De rör på sig. Dubois, kom tillbaka."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smith: Då ser vi till att ta den där kartan. Utgå."

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smith: Jäklar! Fiende klockan 12. Kowalski, eld!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smith: Murphy, undanmanöver. Kowalski, ta hand om honom snabbt."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smith: Vi har ingen tid för lek. Vi måste hålla ljudnivån nere."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smith: Nog, Kowalski. Vi kommer inte nå fram till våra gossar utan Keller."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smith: Utgå, innan någon annan dyker upp."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smith: Tiger! Ta skydd! Förbannat."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smith: Svar nej. Kan inte ta den risken. Keller. Försök att distrahera honom."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smith: Keller, kom igen. Sätt igång."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smith: Använd radion för att lura dem."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smith: Rulla ut innan han kommer tillbaka."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smith: Dubois, hitta den där kartan."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smith: Vad är det?"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smith: Då samlar vi kartbitar då. Utgå."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smith: Utmärkt. Murphy, rita av den."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smith: Vidare till nästa ställe. Tiden börjar bli knapp."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smith: Vidare till nästa ledningsplats."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smith: Kör vidare. Varje minut räknas."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smith: Dubois, kolla efter kartan."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smith: Murphy, hur går det för oss?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smith: Nu vet vi åtminstone att det finns andra ledningsplatser. Utgå."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smith: Dubois? Hittar du något?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smith: Vidare till nästa ledningsplats. Tiden börjar bli knapp."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smith: Dubois, nu är det du."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smith: Vidare till nästa ställe."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smith: Murphy, hur går det för oss?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smith: Låt oss se vad kan hitta."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smith: Keller, är det här en ledningsplats?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smith: Dra er tillbaka!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smith: Anfall inte!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smith: Öppna inte eld!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smith: Öppna inte eld! Det är inte därför vi är här!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smith: Ta det lugnt! Vårt jobb är att leverera ett meddelande, inte starta ett blodbad!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smith: Backa nu! De kommer upptäcka oss!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smith: Dra er tillbaka! Låt dem inte se oss!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smith: Backa, Murphy! Håll oss gömda!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smith: Oupptäckta. Låt det förbli så."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smith: Fienden kan inte se oss."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smith: Backa, nu! De har nästan fått syn på oss!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smith: Dra er tillbaka! De är på väg att upptäcka oss!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smith: Murphy, ta oss i skydd! De har inte insett vilka vi är än!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smith: Kör på! De är fortfarande inte säkra!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smith: Ta oss in bland skuggorna! De kände inte igen oss!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smith: Murphy, vänd om! Annars listar de ut oss!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smith: Jag tror vi ska dra oss tillbaka."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smith: Vi kan inte riskera uppdraget. Vi drar oss tillbaka."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smith: Kom ihåg vårt uppdrag! Om det är säkrare att dra oss tillbaka, är det så vi gör."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smith: Byt ställning. De kommer att genomsöka det här området."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smith: Kör på. Det kryllar snart av Panzers här."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smith: De missade oss. Håll er nere och var tysta."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smith: Bekämpa målen!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smith: Klart för drabbning! Håll fokus!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smith: Stridskontakt!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smith: Klart! Utgå!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smith: Målet nedkämpat!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smith: Utslagen!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smith: Tuff jäkel. Låt oss hitta ett annat sätt till nästa gång."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smith: Bäst att spana framåt innan vi går in."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smith: Tillbaka till stridsvagnen. Nu kör vi."

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smith: Nog med spaning. Nu kör vi."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smith: Uppsittning. Dags att rulla."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smith: Ingen tid att förlora. Utgå."

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smith: Keller kan locka iväg dem med en falsk order."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smith: Fokusera på målet. Vi behöver kartbitarna för att rädda våra mannar."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smith: Utgå! Det här är inte tid för en tupplur."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smith: Varje sekund räknas. Sätt igång."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smith: Inget val. Vi måste slåss."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smith: Hitta en annan väg åt oss."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smith: Använd radion. Locka bort dem."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smith: Vänta tills deras patrull rör sig."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smith: Vagnen är lagad, men vi förlorade mycket tid. Fokusera nu."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smith: De har högsta beredskap. De kommer skjuta så fort de ser oss nu."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smith: Var kom de ifrån?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smith: Vi har alldeles för lite tid. Framåt!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smith: Murphy, se bara till att vi kommer fram i ett stycke."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smith: Tiger! Förbannat!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smith: Den jagar oss."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smith: Kan inte slå igenom hans frontpansar, men han kommer att gå igenom vårt som papper."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smith: Fortsätt bara röra dig – farten är vår enda fördel!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smith: Fiendens artilleri har vaknat. Undanmanöver!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smith: Gör bara vad du kan."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smith: Tigern är nära. Håll avståndet, Murphy!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smith: Tiger är för nära! Vi måste bryta stridskontakten!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smith: Dra dig undan nu! Han har oss i sikte!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smith: Han har siktat in sig på oss! Undvik nu!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smith: Tigern missade! Ge honom inte en chans till!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smith: Spara ammunitionen. Det är ingen idé att skjuta på Tigerns frontpansar."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smith: Glöm Tigern – koncentrera dig på mindre mål."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smith: Bandet utslaget! Den är immobiliserad!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smith: Artilleri! Skarp sväng höger!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smith: Artillerianfall! Gira vänster!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smith: Inkommande eld! Halt!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smith: Artilleri! Undanmanöver!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smith: Artilleribeskjutning! Vänd nu!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smith: De här kan vi ta hand om. Kowalski, fritt eldöppnande."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smith: De här kan vi slå ut. Kowalski, du har tillstånd att öppna eld."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smith: Slösa inte ammunition på Ferdinanden!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smith: Ignorera Ferdinanden – vi kan inte skada den."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smith: Minfältet är bakom oss. Murphy, plattan i mattan. Våra grabbar väntar."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smith: Keller, byt till allierad frekvens, koppla fram mig."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smith: Lystring alla enheter, detta är kapten Jack Smith, 2nd Armored Division."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smith: Vi närmar oss västerifrån i en M24 Chaffee."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smith: Skjut inte. Jag upprepar, skjut inte."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smith: Vi har brådskande order från högkvarteret, 3:e kåren. Lösen: \"Fackla\". Kom."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smith: Äntligen hemma, grabbar. Kriget är över här nu."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smith: Förbannat. Vi svek dem allihop."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smith: För mycket oväsen. Vi lyser upp varje radar från här till Berlin."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smith: Det här är inte en skjutbana. Vi måste vara tystare."

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smith: Vi måste röra oss tystare. Varje skott drar till sig mer oönskad uppmärksamhet."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smith: Allt detta oväsen kommer att dra till sig förstärkningar. Vi kommer inte hinna fram till våra grabbar i tid."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smith: Fick du något napp?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smith: Var den bra?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smith: Nej."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smith: En gata? Hur? Genom att lista alla våra namn?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smith: Fokusera på vägen."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keller: Nie wieder."

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Signalist, gefreiter Keller: Det finns en ledningsplats precis utanför stan. De har kartor över minfälten där."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keller: Det ser ut som en patrull. De borde snart röra sig vidare."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keller: Ledningsplatsen med kartorna, den är där uppe, på kullen."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keller: Det var en befälsstridsvagn."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keller: Om dess radio fortfarande är intakt och inställd på rätt frekvenser, skulle jag kunna..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keller: Nein, ge patrullerna falska order. Distrahera dem. Så vi kan smyga förbi."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keller: Ja, kapten Smith."

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keller: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Lystring, Panzer Fyra! Fientlig aktivitet vid punkt Berta.)"

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keller: Sofort aufklären!\n(Undersök omedelbart!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keller: Det här är ledningsplatsen."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keller: De här markeringarna visar även ledningsplatser. Där finns delar av minkartan."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keller: För våra... tyska spaningstrupper. Där borde vi titta."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keller: Här."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keller: Alla officerare har inte ansvar över minfälten."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keller: Ser ut som om vi har hittat en till ledningsplats. Vi borde kolla den."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keller: Ja, det kanske finns en bit av kartan med."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keller: Nej."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keller: De... de märkte oss inte."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keller: De har slutat leta... för tillfället."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keller: Jag kanske kan leda bort dem från vår väg."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keller: Sänder."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keller: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Lystring! Omgruppera till sektor Berta. Verkställ omedelbart!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keller: Anropar."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keller: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Brådskande order! Omgruppering till punkt Dora begärs!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keller: Byter till deras frekvens."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keller: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Fientlig aktivitet i sektor Emil. Undersök omedelbart!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keller: Sänder nu."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keller: Zurückziehen auf Stellung Gustav! Schnell! Schnell!\n(Fall tillbaka till position Gustav! Högsta prioritet!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keller: Sänder."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keller: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Grupp Nord rapporterar kontakt med fienden! Begär förstärkning!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keller: Det finns ingen inom räckhåll på den här frekvensen."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keller: Inga enheter svarar i det här området."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keller: Det finns inga tyska styrkor i närheten som kan ta emot order."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keller: Inget svar. Det finns inte en enda tysk stridsvagn i närheten. Tror jag."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keller: Svar nej."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keller: Jag kan inte."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keller: Det fungerar inte."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keller: Det är plutonschefens vagn, han kommer inte att ta order från oss."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keller: Plutonschefen... Han kommer inte att ta order från oss."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keller: Plutonschefens vagn. Tar bara order från bataljonshögkvarteret."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keller: De har grävt ner sig här. Det är meningslöst att ge dem några order."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keller: Den där stridsvagnen är skadad. De använder den som en eldpost."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keller: Det är en skadad stridsvagn. Den kan inte röra sig."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keller: Deras band är trasiga. De står still vad vi än gör."

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keller: Achtung! De återvänder till sina ställningar."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keller: De kommer tillbaka. Var försiktig."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keller: Akta dig! De vänder om."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keller: Vi kanske borde... eh... ta oss till ledningsplatsen?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keller: Innan de byter patrullväg?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keller: Låt mig försöka distrahera dem."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keller: Det är en patrull. Den borde röra sig snart."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keller: Vi hade tur. Ödet vill att vi ska slutföra uppdraget."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keller: Kapten, de rapporterar en ensam amerikansk stridsvagn på radion."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keller: De kommer att leta efter oss nu."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keller: Jag hör order om att... att skicka förstärkningar."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keller: En specialenhet är på jakt efter oss nu..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keller: Det där är en patrull. Om vi tajmar det rätt kan vi smyga förbi."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keller: Patrullerna följer strikta rutter. Vi kan smyga igenom när de kör vidare."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keller: En patrull. De kommer att lämna den här positionen snart."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keller: De stridsvagnarna kan inte röra sig längre, men de använder dem som fasta eldställningar..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keller: Garnisonen har ont om reservdelar men de använder fortfarande stridsvagnarna som pjäsvärn."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keller: Bränslebristen innebär att de bara... bara är pjäsvärn nu."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keller: Men deras kanoner är fortfarande farliga..."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keller: Kapten... Panzer! Precis där!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keller: Kanske... kanske borde vi sakta ner?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keller: Ja, sir."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keller: Men det lutande tornet i Pisa är i... Pisa..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keller: Den här radion är för kommunikation. Vi använder den för att distrahera patruller."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keller: Jag vill inte..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keller: Jag kan försöka. Men det skulle vara tysk musik."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keller: Vi har faktiskt över 1 000."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keller: Det har jag. Hård på utsidan, mjuk inuti."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keller: Tja... faktiskt... två besättningar pratade om ett spöke som hemsöker staden på natten."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keller: Nej... jag trodde aldrig att jag skulle vara i någon stridsvagn..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keller: Egentligen är jag livrädd. Jag är bara för rädd för att visa det."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kowalski: Nigdy więcej."

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Skytt, sergeant Kowalski: Varför tog vi med oss tysken? Han kommer leda oss rakt i en fälla."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kowalski: Åh visst, lita på tysken som ledde oss in i den här fällan till stad."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kowalski: Kalla hit alla tyskar?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kowalski: Chaffee är inte direkt byggd för en sån strid. Men... om Murphy..."

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kowalski: Kom igen då, säg något till dem."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kowalski: Har du glömt hur man talar tyska, Keller?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kowalski: Säg åt den där Tigern att ge sig iväg härifrån!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kowalski: Va? Jag trodde att varje ledningsplats hade en bit av kartan. Keller?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kowalski: Tja, vi kan iallafall räkna några fler Panzers till vår poängställning."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kowalski: Tja, vi kan iallafall räkna några fler Panzers till vår poängställning."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kowalski: Och hittade några nya spännande ledningsplatser också."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kowalski: Tänk om det är en..."

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kowalski: Blinda idioter."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kowalski: Ha! Hur kunde de missa oss?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kowalski: Vi sticker innan fler tyskar dyker upp."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kowalski: Blinda idioter. De kommer inte få en chans till."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kowalski: Äntligen! Dags för lite action!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kowalski: Klart. Vem är på tur?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kowalski: Fick dig!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kowalski: Inte så mäktig nu, eller hur? Men vi har förlorat mycket tid."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kowalski: Låt oss inte rusa in blint. Vad tror du?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kowalski: Kanske Dubois kan ta en spaningsrunda?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kowalski: Nej."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kowalski: Sluta slösa tid! Den här kartan är vår biljett genom minfältet."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kowalski: Rör på dig, annars börjar jag putta vagnen själv!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kowalski: De ber om det. Visa dem gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kowalski: Okej, kör inte rakt in i deras kanoner den här gången."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kowalski: Okej, uppvärmningen är över. Nu tar vi i på allvar."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kowalski: Titta vad vi har här!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kowalski: Våra kanoner öppnar snart eld. Skynda!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kowalski: Inkommande eld! Vi är upptäckta!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kowalski: Tigern siktar! Om vi inte skakar av oss honom nu är vi slut!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kowalski: Tiger är på väg att ge eld... Jag känner igen det där siktet!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kowalski: Kurde! Om det var jag hade jag inte missat."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kowalski: Är det allt du har, Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kowalski: Świetnie! Precis där jag ville ha den!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kowalski: Titta vad vi har här! Lätta mål!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kowalski: Värdelöst. Du kunde lika väl kasta sten på den!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kowalski: Murphy, har du glömt? Det finns minor överallt här!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kowalski: Dostał!"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kowalski: Slakten har börjat. Vi var för långsamma..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kowalski: Bara på bröllop."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kowalski: Menar du att du friar till mig, Murphy?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kowalski: Murphy, kan vi prata om din körstil."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kowalski: Kör du medvetet över varje gupp och på sluttningar för att få tanken att luta?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kowalski: Dina allierade också."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kowalski: Ibland oroar jag mig för dig, Murphy."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kowalski: På allvar. Jag oroar mig verkligen för dig."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kowalski: Inte längre."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kowalski: Det tvivlar jag på."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kowalski: För att vara en lärare i en stridsvagn är du märkligt lugn, Keller."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kowalski: Hmm. Det var... förvånansvärt ärligt."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kowalski: Dubois, vad nynnar du på där borta?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Ja, uppfattat! Förflyttar mig till punkt Berta!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Uppfattat, rör oss till Berta.)"

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Uppfattat, påbörjar omgruppering.)"

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Uppfattat, påbörjar spaning.)"

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Förstått, faller tillbaka.)"

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Uppfattat, på väg.)"

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Sharf: Befälhavare, begränsat flygunderstöd står redo."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Du kan kalla in ett anfall vid behov."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Du känner till radio, va? Hela ön vet redan att ni är där."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Försök erövra den där vagnen intakt om det är möjligt. Högkvarteret vill undersöka den."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Ser den tysk ut?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Med tanke på antalet fiendevagnar måste de ha byggt underhållsverkstäder"

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: någonstans på ön."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Snabba på. Roboten väntar inte."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Jag sa ju att jag borde följt med er. Ni avancerar för långsamt."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Försök slå ut den utan att skada den allvarligt. Vi behöver den intakt."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni: Försök bara. Okej?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Var väldigt försiktiga. Det är en fälla."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Vi har snappat upp deras radiofrekvens."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Vi har följt deras radiotrafik i flera minuter."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Du har inte varit tyst länge nog för mig att informera dig."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Pröva att vara tyst ibland Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni: Nya uppdragsmål mottagna: Vagnen måste erövras intakt."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Vad har den? Några ovanliga moduler? Någon specialutrustning?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Är du säker på att du inte vill prova den här nya vagnen, befälhavare?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Med tanke på bakhållet framför er kunde den extra eldkraften vara till fördel."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, du förstår att han inte kan höra dig, va?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Jag tar bara emot hans sändningar, jag sänder inte vidare våra."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Lägesrapport. Möter vi bara tyskt pansar?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Som jag misstänkte. Det är mer komplicerat än väntat."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: Enligt uppsnappade sändningar..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Kom ihåg: Vagnen måste erövras intakt för analys. Och, okej..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: Jag vill undersöka den själv."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Rättelse: vi har inga konkreta bevis för att de är tyskar."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Aktuella underrättelser pekar på en internationell grupp legosoldater."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Den där rösten... Det är något bekant med deras befälhavare. Jag har hört den förut någonstans..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: Det vore väldigt snällt."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Ja tack."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Vad hände?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Detta är precis varför jag insisterar på att erövra vagnarna intakta."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Ta hem de experimentella vagnarna till mig så ska jag bygga dig något... imponerande."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Befälhavare, jag rekommenderar att du prövar den här nya vagnen. Den kan ge tillgång till unika stridsförmågor."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Det kanske är bäst att vi lämnar den."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Den kommer förbli intakt och våra ingenjörer kan bärga den efter uppdraget."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Är det några experimentella maskiner bland dem? Finns det något ovanligt?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Den här Adler-gruppen... Vi måste undersöka dem."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: De kan hjälpa oss identifiera vår mystiska befälhavares bakgrund."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Vi spårar roboten på radarn. Vi har inte mycket tid."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Nytt uppdragsmål: säkra kommandocentralen. Vi kanske kan ändra dess bana därifrån."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Verkställ omedelbart."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Vilka överraskningar har den här vagnen att bjuda på?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Den här nya tunga stridsvagnen har förstärkt pansar. Perfekt för att möta flera motståndare samtidigt."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Befälhavare, jag rekommenderar att vi erövrar den."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Vårt tekniska team är på väg till kontrollrummet. Håll ställningarna. Vi behöver tid."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Vi måste hålla dem tillbaka lite längre."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Okej då... inte nu!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Vi kan inte ta kontrollen. Hur vi än försöker kan vi inte ändra dess bana. Men..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: något är konstigt här."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Tillfället tar snart slut. Slösa inte tid."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Uppdragstiden går. Rör på er nu."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Ju länge du står stilla, desto längre tid har de att mobilisera sitt försvar."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Fortsätt till målet."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Vi förlorade tätvagnen. Håll formationen!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Befälsvagnen är utslagen. Vi förbereder en ny åt honom."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Vi har inte obegränsat med förstärkningar. Var mer försiktig."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Reagera snabbare nästa gång, annars blir det inga fler gånger."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Deras fältverkstäder har ett begränsat antal av de här vagnarna."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Var snäll och ta det försiktigare nästa gång."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Vi misslyckades. Vi fick slut på tid."

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Alla vagnar utslagna. Uppdraget misslyckades."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Flyget anfaller. Gör redo för träff."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Flyget har gett eld mot målet. Träff om några sekunder."

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Ogiltigt mål för flygunderstöd."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Artillerianfall upptäckt. Omgruppera omedelbart!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Fientligt artilleri avfyrat. Sekunder till nedslag! Omgruppera! Omedelbart!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Fiendens observatörer leder artillerield på oss. Flytta er ur träffområdet omedelbart!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Svar nej."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Vädret. Molnigt. Temperatur 8 grader. Vindstyrka 6 m/s nord-nordost."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni: Jag har teorier. men jag behöver mer bevis innan jag delar med mig."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Den sista som kallade mig sötnos förlorade två fingrar."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Men en lugn kväll på rätt ställe... så kanske jag kan överväga saken."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, du tar onödiga risker."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: Och ett liv med för mycket risk tar snabbt slut. Som din företrädares."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Klok man."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Jag tar det som en komplimang."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: Det är inte magi."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: Det är en fokuserad elektromagnetisk puls som tillfälligt slår ut deras elektriska system."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Se bara komma tillbaka levande. Att ersätta tränade operatörer är administrativt påfrestande."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Om du avslutar den meningen med någon som helst jämförelse med mig,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: så kommer jag personligen se till att ditt nästa uppdrag är på Nordpolen."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Han klarade den. Jag har all dokumentationen här."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Allt det här känns... beräknat."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Varenda barriär, varenda försvar - de köper tid, de försöker inte stoppa oss helt."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Jag tror vi är en del av någon annans ekvation. Och jag gillar inte att vara en variabel."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Jag beräknar överlevnadschanser baserat på aktuella uppdragsförhållanden."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Jag bestämde mig för att inte dela resultatet. Moral är också en variabel."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Jag håller koll på dem."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Vi ser 23% lägre kvalitet sen uppdraget började, men 47% högre frekvens."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Lär känna dina allierade."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Aldrig."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Den här experimentella enheten är ett allvarligt hot. Anpassa er taktik omedelbart."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Befälsvagnen utslagen. Den där maskinen är effektivare än väntat."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Se på den här röran! Som vargar i fårhagen."

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Men som vi säger i min by, \"det är andra vågen som bryter dammen.\""

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Tyskar... Vem kunde tro det?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: En flyr! Vi måste stoppa honom innan han hämtar vänner!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Ja, men han är ensam nu. Mycket enklare att slå ut honom än när han återvänder med sina kompisar."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: Det är mer min stil! Skjut först, lista ut vad det där med långa eldröret är senare!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Såg du det där skottet?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: Det kommer lära honom att visa sig här med sin flådiga kanon!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Erövra? Med all respekt, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: så föredrar jag att skjuta först och fylla i rekvisitionsblanketter senare."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Den där saken förvandlade oss nästan till skrot! Men, okej, vi försöker att inte träffa något viktigt..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: bara hans ammunitionsställ."

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Titta där, en till vagn jag aldrig sett förut!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: Vid det här laget vet jag inte ens vem vi slåss mot längre."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Det liknar något helt motsatt."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Jag hoppas att vi hittar deras ammunitionsdepå snart. Jag är inte säker på att jag har tillräckligt med granater för dem alla."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Ännu en nedkämpad! Jag gillar de här grabbarna!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Ställ er i kö, ställ er i kö! En i taget. Jag har något för var och en av er."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Han går mig på nerverna! Vänta, reparerar han sig där ute eller vad?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Vänta bara, jag kommer snart och plockar isär dig skruv för skruv!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Är du absolut säker att du är på vår sida Leni? Den här saken försöker döda oss!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Vänta ett tag. Nu förstår jag... Du! Inte högkvarteret. Det är du som vill ha den där stridsvagnen."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Du är galen i... långa kanoner som träffar på avstånd!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Åh, verkligen? Och exakt hur vet du det, fräulein synsk?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Skickade de dig en inbjudan till sitt bakhållskalas?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Lyssnar du på deras radiokommunikation? Och det berättar du NU?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: Jag älskar dig med, Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Kolla på den där skönheten! Hon är fantastisk!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Ah, nein-nein-nein! Den här sköra utrustningen är inget för mig. Den här skönheten behöver en varsam hand."

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Befälhavare, du borde köra den."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Om jag kör den kommer våra mekaniker samla bitarna i hinkar!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: Nu snackar vi! Vi är redo att köra rätt in i deras lilla fälla!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"När du har den största hammare, ser varenda problem ut som en väldigt liten spik!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: Det är precis vad vi behöver! Dags att smiska dem, befälhavare!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Kolla bara på det där monstret! Befälhavare, att bara köra förbi den är rent brottsligt!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Du kanske skulle hoppa i den ändå, va?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Åh, nej! Det är ett dåligt tecken! Ett dåligt tecken för dem. Nu förstör vi deras bakhåll!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Mål! Ha! Du börjar bli förutsägbar, Ulysses. Alltid samma inövade order."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Fienden? DU är fienden!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Hallå där, herr Skurk, varför kommer du inte hit och snackar öga mot öga?"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Självklart vet jag det! Jag... håller bara moralen uppe."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: Ah, här är den listigaste delen av deras bakhåll."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: De kan inte slå igenom vårt pansar med granater, så de försöker kasta sten på oss istället."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Sluga jäklar!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Nej, det är det konstiga. Jag vet inte ens vem vi slåss mot längre."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Äntligen! BAKHÅLLET! Hallå, Leni, vad mer står på menyn?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Vilka andra överraskningar har herr Onding i planerna för oss?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Nej, nej, berätta inte! Inga ledtrådar, jag vill se själv! Vi är redo för allt de slänger på oss!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Undkomma? Vad menar han med 'undkomma'? Vi försöker inte undkomma."

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: Vi kommer för DIG herr Läskigarösten. Och ja, Leni, jag vet att han inte kan höra mig."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: När jag får händerna på den där campande råttan ska jag plocka honom i småbitar!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: Så ska det låta. Jag ska göra mitt bästa, Leni."

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! Och så faller den. Förutsägbar som ett schweiziskt urverk, fast tysk."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Åh, titta, fler lekkamrater! Jag var orolig att vi skulle få slut på mål att öva på!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: En gammal vän till dig? Vill du att vi ska ta med honom också?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: Låt mig gissa, du vill ha honom oskadd också?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Jag ska göra mitt allra bästa."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Oj! Vad i helsike var det där?! Okej, okej, där fick de mig. Jag räknade INTE med det."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Vad i hela helsike var det där?! Stridsvagnens elektronik bara... slutade fungera!"

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Hallå, varför börjar vi inte också bygga stridsvagnar med ess i rockärmen?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Jag hade inte haft något emot lite spionprylar på min vagn!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Är det ett löfte, fräulein? Du måste hålla vad du lovar!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: Ah, jag förstår. Fienden har anammat strategin \"lämna dina vagnar efter dig och hoppas på det bästa\"."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Vågat försök!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: Uppfattat, Ulysses. Jag sparar mitt bästa material till senare."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Mein Gott, fräulein! Du är mer besatt av de här nya stridsvagnarna"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: än min onkel Pavel med sin samling pinnar och grenar han hittat över hela landet!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Men jag måste medge, han har flera helt fantastiska exemplar."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Ooooh, nån känner sig nere! Verkar som vi sårade hans känslor."

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Oroa dig inte, fräulein, jag lovade att jag skulle leverera honom till dig, eller hur?"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Men jag kan inte garantera att han kommer fram utan några... skråmor."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy: Du kan ställa alla dina frågor själv."

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Söte Jesus... Den där roboten är mycket större än den såg ut på håll!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Som min onkels historier om fiskarna han fångat, förutom att den här faktiskt ÄR så stor!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Det... det kan inte hända. Vi var så nära! Allt det här... för inget?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Jag ska skjuta mig igenom var och en och bana väg rakt till det där kontrollcentret."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Den skickar vi den där roboten rätt i havet!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Befälhavare, du borde ta den där besten."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: De jäklarna kanske har skjutit upp sin robot, men de lämnar inte den här ön i ett stycke."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Jag förstår, jag föredrar också något lite smidigare än de här tunga bestarna."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: Bästa försvar är att hålla sig rörlig."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Du går ingenstans din jävel. Det enda stället du kommer \"evakuera\" till"

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: är vårt förhörsrum. Och jag ska personligen hjälpa till att leverera dig."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Kom igen, ta hit alla du har kvar! Marschera bara hit-"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: låt oss slippa jaga er när ni försöker komma undan med svansen mellan benen."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: Vi avslutar det här och nu!"

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Perfekt tajming! Jag behövde få utlopp för min ilska."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: Ah, äntligen! Vår gamle vän med det stora egot kommer för att leka med oss."

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: Dags att göra upp vår dispyt en gång för alla. Nu finns det bara en fråga-"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: vem av oss kommer skicka honom till skroten?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Till Lenis verkstad menar jag."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Så, det var det. Åh, Leni min vän, jag vet att du ville ha honom intakt, men..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: vi kanske repade lacken litegrand."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter, va? Jag ska se till att komma ihåg det namnet."

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Vet du vad vi kallar stridsvagnar som inte rör sig på tjeckiska? Måltavlor!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: Och jag tänker inte bli någons måltavla idag."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Det växer rötter under våra band! Dags att rulla!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Rör på dig, befälhavare! Äventyret väntar!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Långröret är tillbaka i sin ställning. Tryck tillbaka honom!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Tillbaka i ditt hål, din långnästa ohyra!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Vad i helsike är det där?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Kanonröret är längre än listan över min faster Katarinas misslyckade äktenskap."

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: Och tro mig, den är inte kort!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Va? Har han en verkstad i fickan?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Otroligt! Vagnen med den långa kanonen är reparerad! Vi satte definitivt några bra hål i den där besten!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Han är lagad! Hur i helsike gör han det där?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Förbannat! Befälsvagnen är utslagen, håll dem sysselsatta tills han är tillbaka!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Befälhavaren är utslagen! Håll ut, han är tillbaka på nolltid!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Byter du vagn igen? Vi ska inte göra det till en tradition."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: Tur att vi har reserver. Utmana inte ödet bara."

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Hallå! Ta det lugnt! Jag tror inte de lämnade så många av sina leksaker."

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Försök hålla den här i ett stycke."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Förbannat! De fick mig! Ha inte för roligt utan mig!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Där är min vagn utslagen. Jag skaffar en ny!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Boom. Men den här gången är det jag! Häng på, jag är snart tillbaka!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: Förbannat! Den där överväxta besten fick mig faktiskt!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Okej, tuffing, du vann den här rundan... men jag kommer tillbaka!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Hallå världen! Det är jag igen! Saknat mig?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Jag är tillbaka. Ny stridsvagn. Den gamla hade ett konstigt knackande i motorn... och alldeles för många hål."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: Förbannat! Jag är ute. Slår du ut några åt mig, är du snäll?"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Vad? Hur? Nej, nej, nej... Det kan inte vara sant. Vi förlorade? Jag kan inte tro det."

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Nu var det slut på alla våra vagnar... Jag är så förbannad! Helt rasande!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Titta vem som dök upp på kalaset."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Den där set dyr ut. Låt oss se hur bra den brinner."

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BOOM! Leni, det är synd att du inte kan se hur befälhavaren just slog ut den där prototypen."

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Bra jobbat befälhavare! Jag hoppas de sparat kvittot, den är inte så effektiv som de trodde."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Så mycket snack... Prototyp hit och avancerad teknologi dit..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Vi förstörde den! Deras fälttest misslyckades!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Nu kör vi! Dags att knäcka lite pansar!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Kanonen uppvärmd! Ge dem ett ordentligt välkomnande!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: Det var det, vi är klara här. Rulla ut!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Den sista utslagen. Slösa ingen tid, kör, kör!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Det var det. Vem står på tur?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Boom! Det är en som inte kommer störa oss mer!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Ännu en biter gräset! Bra jobbat!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Det är så det går till. Nu hittar vi dig ett nytt mål!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: Stryk en till. Vem är ditt nästa mål?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Den är min!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Slog ut honom!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Nästa tack!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Fyrverkerier på väg! Luta dig tillbaka och njut av föreställningen!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Bomber fällda! Låt oss se hur de gillar lite regn från ovan."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Piloten kan inte utföra mirakel!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Oj, det var en överraskande utveckling!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Zap! Nu är de lätta måltavlor. På dem bara!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Ser ut som de har lite strömavbrott!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: De är grillade! Dags att rulla rätt över dem!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Modulärt pansar gör underverk! Precis som min onkel Pavel brukar säga,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"En bra mekaniker kan laga allt utom ett brustet hjärta!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Den moderna ingenjörskonstens underverk!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Byter pansarplåtar snabbare än min mormor byter åsikt!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Din stridsvagn är som ny! Glänsande och utan extrahål."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Bytte du ut dina plåtar, va? Nu ser inte vagnen ut som schweizerost längre."

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Mycket mindre aptitretande!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Någon spanar på oss med kikare och en radio! Ta dina band därifrån!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Den där lömska artilleriobservatören har sett oss! Kör! Kör!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Deras observatör har satt ett osynligt hårkors på dig! Dags att göra honom besviken! Utgå!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Boom på väg! Rör på dig om du inte vill bli en del av geografin!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: De har kallat in de stora kanonerna! Bäst du rör på dig!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Snabbt! Skjut dem med dina fräcka granater när de visar upp sig!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Den där vagnen har något lurt för sig! Stoppa den innan den hinner färdigt!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Kolla! De lagar sig själva helt magiskt! Det fixar vi!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, du skulle älska den här teknologin! De lagar sig själva mitt i striden!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Ska jag ta med ett prov tillbaka?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Oj! Den här tror han är en racingbil! Låt honom inte kyssa ditt pansar!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Vad i hela?! Har han raketer på sin stridsvagn?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: De har bränt dina fräcka manicker, befälhavare! Det är gammal hederlig pansarstrid som gäller nu!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Din vagn specialmagi är bort, befälhavare! De träffade dig med anti-kulgranater!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni, snabb fråga; vet underrättelseenheten faktiskt hur många fiender som finns här på ön?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Vet de något överhuvudtaget?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: Nåväl, det är åtminstone något!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy: De här legosoldaterna har bättre utrustning än vi har! Någon förser dem med seriösa pengar."

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Ooh, mystisk! Jag älskar när du är sådär hemlighetsfull."

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni, sötnos, när allt det här är över ska jag ta med dig till Prag."

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Det finns en liten krog, bästa kringlorna, gulasch,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: och ett sånt där ställe där du bara kan luta dig tillbaka och njuta av kvällen. Du är alldeles för spänd!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Ett liv utan risker är som gulasch utan paprika; en intetsägande besvikelse!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Vänta... Va? Hade jag en företrädare? Vad hände med honom? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Min morfar sa alltid: \"Lita på din instinkt, men kontrollera din ammunition två gånger.\""

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Han skulle gillat dig. Han uppskattade alltid farliga kvinnor."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Det var det också!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Den här experimentella ammunitionen är fantastisk! Den slår ut deras system som med magi!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Du måste vara fantastisk på barnkalas."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: \"Det är ingen kanin, barn, det är bara en domesticerad Oryctolagus cuniculus.\""

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Du, Leni, vad vill du ha för souvenir när det här är över?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Jag tänker att jag kan ta med den där prickskyttevagnens kanonrör."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Du verkar gilla alla de här långdistansvapnen."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Är det tyska för \"jag bryr mig om dig\"? Jag är rörd!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni, om du vore här hade du sett hur vacker den här experimentella vagnen är."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Eleganta linjer, kraftig motor, precis som..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: ...precis som tysk ingenjörskonst ska vara! Vad trodde du jag skulle säga?"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Spara ammunition? Vad kommer härnäst, återanvända tepåsar? Diska plastskedar? Torka pappershanddukar?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Jag sätter fem dollar på att vår mystiska legosoldatschef med den läskiga rösten har en tjusig mustasch."

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Alla riktiga skurkar har mustascher."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Tio dollar på att han snurrar den när han tror att ingen ser."

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Har du tänkt på deras formation! Våra vänner har studerat militärhandböcker."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Kapitel ett: \"Hur du blir omringad och nedkämpad i tre enkla steg.\""

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Övermod, inkompetens; både slutar med samma explosion, min vän."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Vet du vad som är konstigt? Jag uppskattar faktiskt det här uppdraget."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Bildskönt landskap, ovanliga nya stridsvagnar, mystiska fiender..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Jag skulle kalla det \"aktiv rekreation\"!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Psykologisk utvärdering? Skulle vi göra en psykologisk utvärdering?!"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: Åh... så samtalet med den snälla damen var en utvärdering..."

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: Vad pratar du om?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Du skojar, va?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Ha! Deras elitenhet var inte så elit när allt kommer omkring!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Bara några fiender kvar mellan oss och roboten."

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Min mormor hade kunnat rensa vägen med sin träslev!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Förbannat! Den där överdimensionerade besten fick befälhavaren. Nu blev det personligt!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Fick den där saken verkligen befälhavaren? Okej, nu är jag arg!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Corvin: Ulysses här. Vi har landstigit. Förbannat... stranden är en stridsvagnskyrkogård."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Inga överlevande från första vågen. Vi har ingen tid att förlora."

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Vi måste nå kommandocentralen och stoppa avskjutningen till varje pris."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Kontakt framåt! Tyskt pansar klockan elva. Öppna eld."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Ny kontakt! Nedhållande eld!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Han drar sig tillbaka."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Vi måste fortsätta röra oss. På det här hållet har vi ingen chans mot sån eldkraft."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Vi måste minska avståndet, hitta ett sätt att flanka den. Framryck!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Håll fokus! Vi måste nedkämpa fienden här först."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Vi tar hand om den där långnästa bråkmakaren senare."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Nya fiender framåt."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Förbannat, den här gången är de fler."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Jag har sett sämre odds i Nordafrika. Fortsätt kämpa framåt så bryter vi igenom."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Samarbeta. Sikta på flankerna!"

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Den med långa eldröret är tillbaka! Nedhållande eld, NU!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Fortsätt framåt. Snabbaste sättet till roboten är genom den här fabriken."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Håll ställningarna. Ser ut som vi hittat något... intressant."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Övergivna stridsvagnar. Okända modeller."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: De här granaterna ser experimentella ut. De slår förmodligen ut fienden tillfälligt."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Befälhavare, den där experimentella vagnen kan ge oss ett avgörande taktiskt övertag."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Jag rekommenderar starkt att du tar befäl över den."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Se upp!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Lystring framåt! Många!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Såna klara order håller oss vi liv, min glada vän."

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Försiktigt!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: De rör sig för att omringa oss. Till era positioner!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Ingen tid för utdragna strider. Håll det snabbt och avgörande!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Håll ögonen på bräschen i muren. Vår vän inne i centret kan beskjuta oss genom den. Håll dig i skydd."

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Ingen tid att argumentera. Klockan går, rör på dig!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Nytt hot identifierat. De använder någon form av experimentell ammunition"

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: som tillfälligt slår ut elektroniken i våra vagnar."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Det här är inte vanliga legosoldater, de har avancerad teknologi vi aldrig sett förut."

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Se här, en till fältverkstad... och igen stridsvagnar jag inte kan identifiera."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: Utmärkt fynd."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Den här vagnen är utrustad med någon sorts modulära pansarplåtar som snabbt kan bytas ut i fält."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Det kan komma till nytta."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Nu borde vi anpassa vår taktik."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy och jag tar täten, så ger du understödseld bakom oss."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: Det håller den nya vagnen säkrare och låter dig utnyttja den där imponerande kanonen."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Låter som den här Adler-Gruppe är någon sorts elitenhet,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: mycket farligare än allt vi stött på hittills."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, det är dags att lägga skämten åt sidan och visa dem vad vi verkligen går för."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Vårt huvudmål är att stoppa den där roboten från att avfyras. Allt annat är sekundärt."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Bli inte distraherad."

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Vi har nästan nått målet. En sista ansträngning!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Nej! NEJ! FÖRBANNAT OCKSÅ, NEJ!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Vi lyckades inte hindra avskjutningen. Roboten stiger."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Uppfattat."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: En till fältverkstad framför oss. Det finns okända tunga vagnar där."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Ser ut att vara avsevärt mer bepansrade än allt vi stött på hittills."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Överraskningen är... det är inget speciellt med den."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: Ja, förutom ovanligt kraftigt pansar och ovanligt långsam hastighet."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: Och det är precis vad vi behöver just nu."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Robotavskjutningsplatsen säkrad. Vi håller ställningarna vid bunkeringången."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Nya fiender på väg. Omgrupperar till bättre försvarsställningar."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Teddy, det verkar som du fick som du ville. Ser ut som alla kommer hit istället för att evakuera."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Det verkar vara den största vågen hittills."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Vi ser rörelser i centret. Prototypen med det långa eldröret är tillbaka."

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, vad är statusen för den där roboten?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Vad menar du?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Stå still så slutar vi som den första vågen. Nu rör vi på oss."

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Vi jobbar mot klockan. Dags att framrycka."

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Sitter vi still är vi enkla mål. Rör på dig."

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Stridskontakt i centret! Håll honom nedhållen!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Prickskytten är tillbaka. Håll trycket uppe, låt honom inte få ett klart skott!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Pansarvärnskanonvagnen i centret reparerad och igång!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Hur fixade han skadan så snabbt?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Håll dig uppmärksam! Befälhavaren är utslagen, men inte länge!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Befälhavaren är träffad! Fortsätt kämpa, han är tillbaka snart!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Du är tillbaka i striden, perfekt! Men nu är vi lite mer försiktiga."

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: Det var för nära ögat. Vi försöker hålla vagnen intakt nästa gång, eller hur?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: De här verkstäderna har inte obegränsat med nya stridsvagnar."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Var försiktigare nästa gång."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Förbannat! Jag är utslagen! Jag är snart tillbaka."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: De fick mig! Håll stridskänning, jag kommer tillbaka!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Jag är träffad! Fortsätta kämpa, jag återkommer snart!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Jag är nere. Förbannat, den där saken är tuffare än de andra."

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Tog en direktträff... De här nya vagnarna är inget skämt."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Tillbaka i strid. Hoppas vi slipper överraskningar den här gången."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Tillbaka i striden. Förbannat... Ibland är det bara för många av dem."

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Ulysses: Min vagn är nere. Jag är ute ur striden, avsluta uppdraget till varje pris!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Förbannat... Vi var för långsamma. Den här gången är det vårt fel."

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: Det var det. Vi har slut på stridsvagnar. Den här striden är över."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Fienden har förstärkningar på väg. Gör dig redo."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Ny fiende siktad. Det där är ingen vanlig vagn. Var på din vakt."

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Snyggt skott! Experimentell vagn förstörd. Det är ett problem mindre att lösa."

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Snyggt jobbat! Det var det för deras fina leksak. Håll trycket uppe."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Stort mål nedkämpat. Låt oss se vad de har mer."

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Deras bästa var inte bra nog. Nu avslutar vi striden."

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Kontakt! Öppna eld!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Anfaller fienden. Fokusera."

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Sista målet nedkämpat. Utgå."

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: Det var den sista. Området rensat, nu kör vi."

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Fiendegrupp nedkämpad, dags att framrycka."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Målet utslaget."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Fiende nedkämpad."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Bra skott!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Vi har eliminerat hotet."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Fick honom."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Jag täcker din rygg, tryck på!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Flygunderstöd på väg. Klart för nedslag."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Flyganfall bekräftat. Håll dig utanför verkansområdet."

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Flyget kan inte träffa den platsen. Justera din målangivelse."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Målet chockat. Nu har vi chansen att slå till hårt!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Fiendesystemen utslagna. Avsluta dem!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Fiendens specialförmågor utslagna. Anfall! Nu!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Sprickan i skrovet är lagad. Stridseffektivitet tillbaka på topp."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Pansarmoduler utbytta. Din vagn är stridsklar igen."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Pansarplåtar utbytta. Ditt skydd är tillbaka till basnivån igen."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Ditt pansar är lagat! Fortsätt med uppdraget."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Artilleriobservatör identifierad! Lämna verkansområdet omedelbart!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Artilleri på väg! Omgruppera - NU!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Fientligt artilleri på väg! Vi har sekunder innan det slår ned, rör på dig!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: De använder experimentella system. Hindra dem! Använd din specialammunition nu!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Målet förbereder en specialattack. Chocka honom innan han är klar."

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Fienden reparerar sig själv. Det är inte bra."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: De använder fältreparationer. Vi måste skada dem snabbare än de kan laga sig."

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Fienden accelererar till rammningsfart! Undanmanöver!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Fienden närmar sig i full fart. Låt dem inte få kontakt."

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Befälhavare, de har träffat ditt systemgränssnitt! Elektronisk utrustning är tillfälligt satt ur spel."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Direkt träff i kontrollmodulen. Din fräcka elektronik är tillfälligt satt ur spel."

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, du måste spara på ammunitionen. Skjut mindre, sikta på svaga punkter."

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Jag ser inget värde i meningslösa spekulationer och vadhållning."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Deras positionering pekar på övermod, snarare än inkompetens. Underskatta dem inte."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, du behöver verkligen omvärdera vad du ser som rekreation."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Är du säker på att du klarade den psykiatriska utvärderingen innan uppdraget?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Tror du vi blir manipulerade?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, du är ovanligt tyst. Vad tänker du på?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: Och?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, jag behöver din ärliga uppfattning. Blir Teddys skämt bättre eller sämre?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Analyserar du verkligen hans skämt?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: Låt oss avancera, vi närmar oss avskjutningsplatsen. Vi måste säkra den innan uppskjutning."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Befälhavaren utslagen! Den där nya vagnen visar sig vara ett allvarligt problem."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Vi underskattade den där saken. Koncentrera dig, befälhavaren är snart tillbaka."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Den här vagnens kanon verkar ha förmåga att öka skadeverkan."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Den kan leverera exceptionell skada när den används rätt, under vissa förhållanden."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Precis vad vi behöver mot de där tunga enheterna."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: Och se på den här pjäsen. Den här vagnens kanon verkar ha förmåga att öka skadeverkan."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Den kan leverera exceptionell skada när den används rätt, under vissa förhållanden."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Precis vad vi behöver mot de där tunga enheterna."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Den här vagnen har precisionsriktmedel."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Det verkar som att ju längre du står still, desto mer träffsäkra blir dina skott."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Perfekt för långa stridsavstånd."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Men vad som är mer intressant är att vagnen har precisionsriktmedel."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Det verkar som att ju längre du står still, desto mer träffsäkra blir dina skott."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Perfekt för långa stridsavstånd."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Intressant; den här har en sekundärbeväpning installerad."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Du kan ge nedhållande eld medan du laddar om huvudpjäsen."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Taktisk fördel mot klent pansar."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: Åh, ja. En sak till. Den här har även en sekundärbestyckning."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Du kan ge nedhållande eld medan du laddar om huvudpjäsen."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Taktisk fördel mot klent pansar."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Den här vagnen har icke-standardutrustning. Det här är inte konventionella modifikationer,"

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: de har byggt något speciellt här. Ta en provtur, befälhavare."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Se vad den här teknologin går för."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: Det är avancerad teknik integrerad i den här vagnens system."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Vi bör utnyttja dess förmåga till dess fulla potential."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Befälhavare, experimentera med kontrollerna, ta reda på vad systemen kan åstadkomma i strid."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Tekniken i den här prototypen är enastående. Det här är inte vanliga fältuppgraderingar,"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: de är helt banbrytande. Pröva den, befälhavare."

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Testa systemen till det yttersta och visa våra motståndare vad deras egen teknologi går för."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "En av våra prototyper erövrades av fienden. Identifiera mål noggrant."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta och Dora, sök stridskänning försiktigt. Uppehåll dem så länge som möjligt."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Fiendestyrkor närmar sig fabriken. Kampfgruppen Bera och Dora, anfall."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Uppehåll dem så länge som möjligt."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Lystring, team Zeppelin. Omgruppera till fabriken. Inta försvarsställning och håll."

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, håll eldberedskap över utgångarna. Låt dem inte lämna anläggningen."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Verkställ protokoll Valkyrie. Alla enheter bekräftar."

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Alla enheter, inta försvarsställning. Adler-Gruppe, anfall."

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Alla enheter. Anfall fienden. Dubbla skottpengar till den som eliminerar dem."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Vad i helvete?! Arkitekt, vi är inte redo! Jag har fortfarande stridsvagnar i utblåsområdet!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Alla enheter, ta er bort från avskjutningsplatsen NU!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Förbannat! Förbannat!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Alla kvarvarande enheter, ta er bort från utblåsområdet! Skydda uppskjutningen! Håll linjen!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Alla kvarvarande enheter, sammanstråla vid kommandocentralen. Anfall fienden. Håll dem i stridskontakt."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Håll försvarsställningar i väntan på vidare order. Dra er tillbaka till evakueringspunkterna på mitt kommando."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Jag vet att ni kan höra mig. Jag väntade mig inte att möta såna motståndare."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Men nu har jag studerat er taktik, era förmågor. Vårt nästa möte kommer bli något helt annat."

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter, klart slut."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "För fem dagar sedan tappade vi kontakten med en hemlig militär robotbas i Norska havet."

msgid "vo_sm_norway_intro_02"
msgstr "Spaningsflyget rapporterade spår efter strid"

msgid "vo_sm_norway_intro_03"
msgstr "och att industribyggnaderna på platsen var delvis förstörda."

msgid "vo_sm_norway_intro_04"
msgstr "Men det viktigaste var att han nämnde en robot redo att avskjutas på avfyrningsplatsen,"

msgid "vo_sm_norway_intro_05"
msgstr "precis innan vi förlorade kontakten med honom."

msgid "vo_sm_norway_intro_06"
msgstr "En insatsstyrka skickades till platsen för att undersöka."

msgid "vo_sm_norway_outro_01"
msgstr "Det vi uppfattade som ett vapen visade sig vara något mycket farligare."

msgid "vo_sm_norway_outro_02"
msgstr "Roboten placerade en artificiell satellit i omloppsbana,"

msgid "vo_sm_norway_outro_03"
msgstr "som började sända hemliga Reich-handlingar:"

msgid "vo_sm_norway_outro_04"
msgstr "ritningar på avancerad teknologi"

msgid "vo_sm_norway_outro_05"
msgstr "och koordinater till hemliga militärbaser med färdiga vapenprov."

msgid "vo_sm_norway_outro_06"
msgstr "Mannen bakom allt det här kallar sig själv Arkitekten."

msgid "vo_sm_norway_outro_07"
msgstr "Hans motiv är inte helt klara, men hans handlingar har redan börjat påverka världsordningen."

msgid "vo_sm_norway_outro_08"
msgstr "För att stoppa detta hot behöver vi en styrka kapabel att försvara världen från det annalkande kaoset."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Lystring! Lystring!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Vi anropar alla soldater och officerare i Wehrmacht, Luftwaffe och Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Det tyska överkommandot har undertecknat en villkorslös kapitulation.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Kriget är över...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Vi uppmanar alla de som fortfarande gör meningslöst motstånd;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Att lägga ned sina vapen och överlämna sig till de allierade styrkorna.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Era liv kommer behövas för att bygga ett nytt, förnyat Tyskland...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(Det är bara ett trick!)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Vi kämpar vidare tills vi får order från högkvarteret.)"
