msgid "Contact/status/inBattle/last_stand"
msgstr "I Sista striden"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Ett skott som skadar målet och alla fiendevagnar inom 35 m radie."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Ett skott som återställer träffpoäng genom att stjäla dem från målet och fiendevagnar inom 35 m från träffpunkten."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Ett skott som chockar målet och alla fiendevagnar inom 35 m radie."

msgid "advanced/ls_damageShield"
msgstr "Skyddar mot all skada (förutom kollision, drunkning och fallskada) under 10 sekunder."

msgid "advanced/ls_doubleDamage"
msgstr "Nästa skott som träffar gör dubbel skada."

msgid "advanced/ls_equipment"
msgstr "Taktiska verktyg höjer vagnens stridseffektivitet i Sista striden, låter dig slutföra delmoment och tjäna värdefulla belöningar. Placera dem på vagnarnas specialplatser för att använda dem."

msgid "advanced/ls_extraDamageSituational"
msgstr "Ger en chans att öka skadan åsamkad en fiendevagn."

msgid "advanced/ls_fastReload"
msgstr "Ökar eldhastigheten / laddar om magasinet."

msgid "advanced/ls_healSituational"
msgstr "Återställer träffpoäng när du förstör en fiendevagn."

msgid "advanced/ls_invisibility"
msgstr "Hindrar tillfälligt fienden från att välja dig som mål, återställer träffpoäng, reparerar moduler, släcker bränder, tar bort chockverkan och läker alla skadade besättningsmedlemmar."

msgid "advanced/ls_nitro"
msgstr "Ökar tillfälligt vagnens rörlighet."

msgid "advanced/ls_nitroSituational"
msgstr "Ökar vagnens rörlighet tillfälligt när du tar skada från en fiendevagn."

msgid "advanced/ls_selfRepairKit"
msgstr "Återställer träffpoäng, släcker bränder, tar bort chockverkan och reparerar skadade moduler."

msgid "advanced/ls_teamRepairKit"
msgstr "Reparerar skadade moduler, släcker bränder, tar bort chockverkan och återställer en del av träffpoängen för allierade vagnar inom verkansområdet."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktiska verktyg kan placeras på specialplatser för att öka din effektivitet i Sista striden, slutföra delmoment och tjäna värdefulla belöningar."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Specialplatser för taktiska verktyg"
