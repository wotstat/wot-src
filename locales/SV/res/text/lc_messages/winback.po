msgid "dailyQuestsIntroView/info/mode/description"
msgstr "Uppvärmningen låter dig fräscha upp dina grundkunskaper i spelet. Striderna utkämpas mot AI-kontrollerade vagnar och resultatet räknas inte till din statistik. Du kan lämna uppvärmningen när som helst och fortsätta med slumpvis matchade strider."

msgid "dailyQuestsIntroView/info/mode/title"
msgstr "Uppvärmning"

msgid "dailyQuestsIntroView/info/quests/description"
msgstr "Slutför uppdrag, gå igenom alla delmoment i Tillbaka i strid och få värdefulla belöningar. Varje slutfört standard-, premium- eller bonusuppdrag räknas för belöningen. Uppdrag kan slutföras i uppvärmning eller slumpvis matchade strider."

msgid "dailyQuestsIntroView/info/quests/descriptionBP"
msgstr "Slutför uppdrag, gå igenom alla delmoment i Tillbaka i strid och få värdefulla belöningar. Under Stridspass kommer Stridspasspoäng läggas till som belöning. Uppdrag kan slutföras i uppvärmning eller slumpvis matchade strider."

msgid "dailyQuestsIntroView/info/quests/title"
msgstr "Tillbaka i strid"

msgid "dailyQuestsIntroView/info/rewards/description"
msgstr "Som belöning kan du få hyra av Premiumvagnar klass VIII, forskningsbara vagnar klass VI och rabatt på forskning och köp av vagnar. När alla delmoment slutförts får du huvudbelöningen."

msgid "dailyQuestsIntroView/info/rewards/title"
msgstr "Belöningar"

msgid "dailyQuestsIntroView/title"
msgstr "TILLBAKA I STRID"

