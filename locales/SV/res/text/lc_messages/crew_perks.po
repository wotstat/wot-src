msgstr "Ökar vagnens {greenBright_Start}topphastighet framåt{greenBright_End} och {greenBright_Start}bakåt{greenBright_End} med %(vehicleForwardMaxSpeed)s. {greenBright_Start}Negativa effekter från en skadad motor{greenBright_End} minskas med %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/hudDescription"
msgstr "Minskar negativa effekter från en skadad motor."

