msgstr "Fullt tränad förmåga ökar vagnens {greenBright_Start}topphastighet framåt{greenBright_End} och {greenBright_Start}bakåt{greenBright_End} med %(vehicleForwardMaxSpeed)s. {greenBright_Start}Negativa effekter från en skadad motor{greenBright_End} minskas med %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/name"
msgstr "Ingenjör"

msgid "driver_motorExpert/shortDescription"
msgstr "Minskar negativa effekter från en skadad motor."

