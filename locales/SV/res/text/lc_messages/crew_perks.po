msgstr "Vagnschefen ersätter utslagna besättningsmedlemmar."

msgid "commander_tutor/maxLvlDescription"
msgstr "Fullt tränad ökar förmågan intjänad {greenBright_Start}erfarenhet{greenBright_End} med %(xpBonusFactorPerLevel)s för alla besättningsmedlemmar samt låter vagnschefen {greenBright_Start}ersätta utslagna besättningsmedlemmar{greenBright_End} med %(woundedCrewEfficiency)s effektivitet."

