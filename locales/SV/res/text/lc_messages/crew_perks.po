msgstr "Mentor"

msgid "commander_tutor/shortDescription"
msgstr "Vagnschefen ersätter utslagna besättningsmedlemmar."

msgid "commander_universalist/alt/description"
msgstr "Vagnschefen kan ersätta huvudutbildningen för en utslagen besättningsmedlem. Effektiviteten minskar för varje utslagen besättningsmedlem."

msgid "commander_universalist/alt/info"
msgstr "En förmåga får effekt när den tränats till minst 1% och effekten ökar med träningsgraden."

msgid "commander_universalist/currentLvlDescription"
msgstr "Låter vagnschefen {greenBright_Start}ersätta utslagna besättningsmedlemmar{greenBright_End} med %(woundedCrewEfficiency)s effektivitet."

msgid "commander_universalist/hudDescription"
msgstr "När besättningsmedlemmar blir utslagna kan vagnschefen ta över deras uppgifter."

msgid "commander_universalist/maxLvlDescription"
msgstr "Fullt tränad förmåga låter vagnschefen {greenBright_Start}ersätta utslagna besättningsmedlemmar{greenBright_End} med %(woundedCrewEfficiency)s effektivitet."

msgid "commander_universalist/name"
msgstr "Mångsysslare"

msgid "commander_universalist/shortDescription"
msgstr "Låter vagnschefen ersätta utslagna besättningsmedlemmar."

msgid "driver_badRoadsKing/alt/description"
msgstr "Minskar negativa effekter på vagnens manöverförmåga och acceleration vid körning på halvmjukt underlag. Minskar avsevärt de negativa effekterna vid körning på mjukt underlag så att det likställs med halvmjukt underlag.\nManöverförmågan på mjukt- och halvmjukt underlag kan inte bli bättre än manöverförmågan på fast underlag."

msgid "driver_badRoadsKing/alt/info"
msgstr "En förmåga får effekt när den tränats till minst 1% och effekten ökar med träningsgraden."

msgid "driver_badRoadsKing/currentLvlDescription"
msgstr "Fullt tränad förmåga minskar {greenBright_Start}hastighetsförlusten på halvmjukt underlag{greenBright_End} med %(mediumGroundFactor)s&zwnbsp; och sätter {greenBright_Start}hastighetsförlusten på mjukt underlag{greenBright_End} till %(softGroundFactor)s av värdet för halvmjukt underlag."

msgid "driver_badRoadsKing/maxLvlDescription"
msgstr "Fullt tränad förmåga minskar {greenBright_Start}hastighetsförlusten på halvmjukt underlag{greenBright_End} med %(mediumGroundFactor)s&zwnbsp; och sätter {greenBright_Start}hastighetsförlusten på mjukt underlag{greenBright_End} till %(softGroundFactor)s av värdet för halvmjukt underlag."

msgid "driver_badRoadsKing/name"
msgstr "Terrängkörning"

