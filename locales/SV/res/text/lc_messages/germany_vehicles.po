msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Denna stridsvagn tillverkades av ČKD för tjeckoslovakiska armén under 1938. Under den tyska ockupationen tillverkades och användes vagnen flitigt av Wehrmacht i invasionerna av Polen, Frankrike och Sovjetunionen. Den stred i fronten fram till mitten av 1942. Ungefär 1 400 exemplar tillverkades i åtta utföranden (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

