msgstr "Dessa uppdrag är kumulativa: du behöver slutföra målen under ett antal strider."

msgid "quest/advice/resultLimiter/info/1/description"
msgstr "du kan slutföra det under flera strider; resultatet av varje strid läggs samman tills totalvärdet som krävs uppnås."

msgid "quest/advice/resultLimiter/info/1/title"
msgstr "Primära mål:"

msgid "quest/advice/resultLimiter/info/2/description"
msgstr "det slutförs i en enda strid (resultaten räknas inte samman). För att motta belöningar måste du uppfylla detta mål angivet antal gånger, samtidigt som du slutför huvudmålet."

