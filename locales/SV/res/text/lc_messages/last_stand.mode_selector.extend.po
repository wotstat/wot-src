msgstr "Du kan tjäna Stridspasspoäng i {whiteSpanish_open}Sista striden{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Stridspasspoäng"

msgid "mode/last_stand/calendar"
msgstr "Evenemanget pågår i %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "Evenemanget avslutas om %(date)s."

msgid "mode/last_stand/description"
msgstr "Bekämpa vågor av fiender.\nStrider i vagnar klass VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Din dators prestanda räcker inte för detta läge. Du kan uppleva grafikproblem och problem att köra din vagn. Det är även troligt att spelklienten kommer krascha."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Låg prestanda"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Låg prestanda"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Striderna kräver hög datorprestanda.\nDu kommer uppleva att kartorna laddar långsamt, grafikproblem och problem att köra din vagn. Om du upplever att din dator inte klarar av detta bör du sänka kvalitetsinställningarna."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Reducerad prestanda"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Reducerad prestanda"
