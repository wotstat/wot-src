msgid "boxTooltip/description/text/bronze"
msgstr "Diese Kisten können Premiumfahrzeuge der Stufe VIII, Spielwährung und andere wertvolle Belohnungen enthalten."

msgid "boxTooltip/description/text/gold"
msgstr "Diese Kisten können seltene Fahrzeuge der Stufe X, Spielwährung und andere wertvolle Belohnungen enthalten."

msgid "boxTooltip/description/text/silver"
msgstr "Diese Kisten können Premiumfahrzeuge der Stufe IX, Spielwährung und andere wertvolle Belohnungen enthalten."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Kann als Geschenk für den Kauf von Gegenständen im Premium-Laden sowie durch Öffnen anderer Kisten erhalten werden."

msgid "boxTooltip/howGet/text/gold"
msgstr "Kann durch Öffnen anderer Kistentypen erhalten werden."

msgid "boxTooltip/howGet/text/silver"
msgstr "Kann durch Öffnen anderer Kistentypen erhalten werden."

