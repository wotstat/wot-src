msgid "guaranteed/tooltip/description1/"
msgstr "Wenn Sie alle Fahrzeuge bereits besitzen, erhalten Sie stattdessen eine Gunstkiste."

msgid "infoPage/footer/description/compensation"
msgstr "Wenn Sie bereits alle Fahrzeuge aus der Kiste besitzen, erhalten Sie anstatt eines Fahrzeugs eine Gunstkiste als Belohnung."

msgid "infoPage/footer/description/guaranteed"
msgstr "Jede %(guaranteed0)s. Beute-, %(guaranteed1)s. Ruhm- und %(guaranteed2)s. Gunstkiste enthält garantiert ein Fahrzeug. Wenn Sie sie öffnen und keine von ihnen ein solches Fahrzeug enthält, finden Sie ein Fahrzeug, das sie noch nicht besitzen, in der %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. Kiste (abhängig von der Art der Kiste). Wenn das passiert, wird der Zähler zurückgesetzt."

msgid "infoPage/footer/title/compensation"
msgstr "Vergütung"

msgid "infoPage/footer/title/guaranteed"
msgstr "Garantierte Belohnung"

msgid "infoPage/header/rewards/description"
msgstr "Aus jeder Gruppe wird maximal eine Belohnung enthalten sein."
