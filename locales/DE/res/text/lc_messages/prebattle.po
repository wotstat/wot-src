msgid "hints/confirmDialog/message"
msgstr "Sie sind auf dem Weg, ein wahrer Profi unter den Panzerkommandanten zu werden! Ab sofort werden die Ladebildschirme vor dem Gefecht statt den Einsteigertipps die Teamzusammenstellung anzeigen. Sie können die Tipps aber jederzeit wieder über die Einstellungen im Spielmenü aktivieren."

msgid "hints/confirmDialog/title"
msgstr "Neue Ladebildschirme vor dem Gefecht"

msgid "hints/hint1/description"
msgstr "Achten Sie auf die Durchschlagsanzeige in der Mitte Ihres Fadenkreuzes. Die Farbe zeigt Ihnen an, wo Sie die Panzerung des Gegners durchschlagen können."

msgid "hints/hint1/green/description"
msgstr "Hohe Durchschlagswahrscheinlichkeit"

msgid "hints/hint1/green/header"
msgstr "Grüne Markierung"

msgid "hints/hint1/header"
msgstr "Panzerung durchschlagen"

msgid "hints/hint1/red/description"
msgstr "Niedrige Durchschlagswahrscheinlichkeit"

msgid "hints/hint1/red/header"
msgstr "Rote Markierung"

msgid "hints/hint10/description"
msgstr "Ihr Geschütz bewegt sich immer zur Mitte des Bildschirms. Die begrenzte Richtgeschwindigkeit kann aber dazu führen, dass dies etwas dauert."

msgid "hints/hint10/header"
msgstr "Fadenkreuz"

msgid "hints/hint10/penetration/description"
msgstr "Grün zeigt Schwachstelle in der Panzerung an"

msgid "hints/hint10/penetration/header"
