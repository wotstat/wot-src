msgid "entryPoint/tooltip/description"
msgstr "Dies sind besondere Kisten, die Premiumfahrzeuge, 3D-Aufsätze, Kreditpunkte und andere wertvolle Spielgegenstände enthalten.\nSie können sie im Nachschub erhalten."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Derzeit können Kisten aus technischen Gründen nicht gekauft oder geöffnet werden. Wir bitten für die Unannehmlichkeiten um Entschuldigung."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kisten sind vorübergehend nicht verfügbar"

msgid "eventName/lowerCase"
msgstr "Glorreich in Grün"

msgid "eventName/upperCase"
msgstr "GLORREICH IN GRÜN"

