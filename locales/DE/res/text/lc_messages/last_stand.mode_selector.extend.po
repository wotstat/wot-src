msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Sie können im Modus {whiteSpanish_open}„Letztes Gefecht“{whiteSpanish_close} Punkte für den Battle Pass verdienen."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Punkte für den Battle Pass"

msgid "mode/last_stand/calendar"
msgstr "Das Event dauert %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "Das Event endet in %(date)s."

msgid "mode/last_stand/description"
msgstr "Kämpfen Sie gegen Wellen gegnerischer Fahrzeuge.\nGefechte in Fahrzeugen der Stufe VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Die Leistung Ihres Computers reicht für diesen Modus nicht aus. Es können Probleme bei Grafik und Fahrzeugbewegung auftreten. Clientabstürze sind ebenfalls möglich."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Geringe Leistung"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Geringe Leistung"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Dieser Modus erfordert eine hohe Computerleistung.\nEs können Probleme beim Laden von Karten, der Grafik und der Fahrzeugbewegung auftreten. Reicht die Leistung nicht aus, sollten Sie die Grafikqualität in den Einstellungen heruntersetzen."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Verringerte Leistung"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Verringerte Leistung"
