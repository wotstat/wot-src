msgid "Contact/status/inBattle/last_stand"
msgstr "In einem Gefecht für „Letztes Gefecht“"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Feuert einen Schuss ab, der Schaden am Ziel und allen gegnerischen Fahrzeugen in einem Radius von 35 m verursacht."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Feuert einen Schuss ab, der Strukturpunkte wiederherstellt, indem er sie dem Ziel und nahen gegnerischen Fahrzeugen in einem Radius von 35 m abzieht."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Feuert einen Schuss ab, der das Ziel und alle gegnerischen Fahrzeuge in einem Radius von 35 m betäubt."

msgid "advanced/ls_damageShield"
msgstr "Schützt 10 Sekunden lang vor jeglichem Schaden (außer durch Rammen, Versinken und Aufprall)"

msgid "advanced/ls_doubleDamage"
msgstr "Der nächste Treffer verursacht doppelten Schaden."

msgid "advanced/ls_equipment"
msgstr "Taktische Geräte helfen Ihnen, in Gefechten von „Letztes Gefecht“ effektiver zu kämpfen, Stufen abzuschließen und wertvolle Belohnungen zu verdienen. Klicken Sie auf einen Platz für ein taktisches Gerät, um eins auszurüsten."

msgid "advanced/ls_extraDamageSituational"
msgstr "Steigert mit einer gewissen Chance den Schaden gegen gegnerische Fahrzeuge."

msgid "advanced/ls_fastReload"
msgstr "Erhöht die Feuerrate / lädt das Magazin nach."

msgid "advanced/ls_healSituational"
msgstr "Stellt nach Zerstören eines gegnerischen Fahrzeugs einige Strukturpunkte wieder her."

msgid "advanced/ls_invisibility"
msgstr "Verhindert vorübergehend, dass Gegner Ihr Fahrzeug anvisieren, stellt Strukturpunkte wieder her, repariert Module, löscht Brände, entfernt den Betäubungseffekt und versorgt alle verwundeten Besatzungsmitglieder."

msgid "advanced/ls_nitro"
msgstr "Steigert vorübergehend die Beweglichkeit des Fahrzeugs."

msgid "advanced/ls_nitroSituational"
msgstr "Steigert vorübergehend die Beweglichkeit des Fahrzeugs, nachdem Schaden durch ein gegnerisches Fahrzeug erlitten wurde."

msgid "advanced/ls_selfRepairKit"
msgstr "Stellt Strukturpunkte wieder her, löscht Brände, entfernt Betäubung und repariert beschädigte Module."

msgid "advanced/ls_teamRepairKit"
msgstr "Repariert beschädigte Module, löscht Brände, entfernt Betäubung und stellt bei verbündeten Fahrzeugen im Effektradius einige Strukturpunkte wieder her."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktische Geräte können in besonderen Plätzen ausgerüstet werden und helfen Ihnen, effektiver in Gefechten von „Letztes Gefecht“ zu kämpfen, Stufen abzuschließen und wertvolle Belohnungen zu verdienen."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Plätze für Taktische Geräte"
