msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Drachenbootkisten"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRACHENBOOTKISTEN"

msgid "entryPoint/tooltip/description"
msgstr "Dies sind besondere Kisten, die einzigartige und wertvolle Spielgegenstände enthalten.\nSie können die Kisten im Nachschub oder im Premium-Laden erhalten."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Drachenbootkisten sind vorübergehend nicht verfügbar."

msgid "eventName/lowerCase"
msgstr "Drachen zähmen und Wind reiten"

msgid "eventName/upperCase"
msgstr "DRACHEN ZÄHMEN UND WIND REITEN"

msgid "infoPage/footer/description/compensation"
msgstr "Wenn Sie bereits alle Fahrzeuge von der Liste möglicher Inhalte besitzen, werden alle folgenden in Drachenbootkisten gefundenen Fahrzeuge mit ihrem vollen Wert in Gold vergütet."

msgid "infoPage/footer/description/guaranteed"
msgstr "Spätestens jede %(guaranteed0)s. Drachenbootkiste enthält garantiert ein Fahrzeug der Stufe VIII–IX. Wenn Sie also zuvor noch keins erhalten haben, wird spätestens die %(guaranteed0)s&zwnbsp;. Drachenbootkiste garantiert ein Fahrzeug der Stufe VIII–IX enthalten, das Sie noch nicht besitzen. Der Zähler wird durch den Erhalt zurückgesetzt."

msgid "noBoxesView/description/"
msgstr "Sie haben keine Kisten.\nSie können diese im Nachschub erhalten."
