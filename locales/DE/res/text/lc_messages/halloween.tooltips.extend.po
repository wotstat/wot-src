msgid "Contact/status/inBattle/halloween"
msgstr "Im Gefecht für „Babylon: Dunkelturm“"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Feuert einen Schuss ab, der das Ziel und alle gegnerischen Fahrzeuge in einem Radius von 35 m beschädigt und betäubt."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Feuert einen Schuss ab, der Strukturpunkte wiederherstellt, indem er sie dem Ziel und nahen gegnerischen Fahrzeugen in einem Radius von 35 m abzieht."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Feuert einen Schuss ab, der das Ziel und alle gegnerischen Fahrzeuge in einem Radius von 35 m betäubt."

msgid "advanced/hw_damageShield"
msgstr "Schützt 7 Sekunden lang vor jeglichem Schaden (außer durch Rammen, Versinken und Aufprall)"

msgid "advanced/hw_fastReload"
msgstr "Erhöht die Feuerrate / lädt das Magazin nach."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Stellt Strukturpunkte wieder her, löscht Brände, entfernt Betäubung und repariert beschädigte Module."

msgid "advanced/hw_invisibility"
msgstr "Macht das eigene Fahrzeug vorübergehend für Gegner unsichtbar, stellt Strukturpunkte wieder her, repariert Module, löscht Brände, entfernt den Betäubungseffekt und versorgt alle verwundeten Besatzungsmitglieder."

msgid "advanced/hw_teamRepairKit"
msgstr "Repariert beschädigte Module, löscht Brände, entfernt Betäubung und stellt bei verbündeten Fahrzeugen im Effektradius einige Strukturpunkte wieder her."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Kampffähigkeiten helfen Ihnen, in Gefechten für „Babylon: Dunkelturm“ effektiver zu kämpfen, Ziele abzuschließen und wertvolle Belohnungen zu verdienen. Klicken Sie auf einen Platz für eine Kampffähigkeit, um sie auszurüsten."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Plätze für Kampffähigkeiten"

msgid "hwShell/alt/description"
msgstr "%(bold)s kann mit einer gewissen Wahrscheinlichkeit nach dem Zerstören eines Gegners im Gefecht gefunden werden."

msgid "hwShell/alt/description/bold"
msgstr "Eine alternative Granate"
