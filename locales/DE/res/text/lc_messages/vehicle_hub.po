msgstr "Selbstlader"

msgid "abilities/common/name/overheatGun"
msgstr "Maschinenkanone mit Temperaturkontrolle gegen Überhitzen"

msgid "abilities/common/name/rocketAcceleration"
msgstr "Jet-Booster"

