msgid "tank_params/avgParamComment/maxMutableDamage"
msgstr "Minimaler – maximaler Schaden auf 50 m %(units)s"

msgid "tank_params/avgParamComment/maxPiercingPower"
msgstr "Minimaler – maximaler Wert auf 50 m %(units)s"

msgid "tank_params/avgParamComment/minMutableDamage"
msgstr "Minimaler – maximaler Schaden auf %(distance)s m %(units)s"

msgid "tank_params/avgParamComment/minPiercingPower"
msgstr "Minimaler – maximaler Wert auf %(distance)s m %(units)s"

msgid "tank_params/avgParamComment/piercingPower"
msgstr "Minimum–Maximum Wert %(units)s"

msgid "tank_params/desc/accuracyDispersionCap"
msgstr "Der Bonus auf Streuung auf 100 m, der auf maximaler Genauigkeitsstufe verliehen wird."

msgid "tank_params/desc/accuracyDispersionPerLevel"
msgstr "Der Bonus auf Streuung auf 100 m, der pro Genauigkeitsstufe verliehen wird."

msgid "tank_params/desc/accuracyLevelGainTime"
msgstr "Die Zeit, um eine Genauigkeitsstufe zu erhalten."

msgid "tank_params/desc/accuracySpeedLimit"
msgstr "Bei Überschreiten dieser Geschwindigkeit wird keine Genauigkeitsstufe mehr generiert."

msgid "tank_params/desc/accuracyWhileMovingDispersionCap"
msgstr "Der Bonus auf Streuung bei Bewegung, Wannendrehung oder Geschützrichten, der auf maximaler Genauigkeitsstufe verliehen wird."

msgid "tank_params/desc/activeCoincideceShootingCharge"
msgstr "Ladung für das elektromechanische Fügungssichtgerät, die im Angriffsmodus pro Treffer an gegnerischen Fahrzeugen erzeugt wird."

msgid "tank_params/desc/aimingTime"
msgstr "Der Zeitraum, in dem sich der Zielkreisdurchmesser um 60 % verkleinert (Standard-/Spezialmodus)."

msgid "tank_params/desc/aimingTimeCoincidenceElectromechanicalSight"
msgstr "Bonus auf den Zeitraum für die Verkleinerung des Zielkreisdurchmessers um 60 %, der durch das Sichtgerät verliehen wird."

msgid "tank_params/desc/aimingTimeTurbo"
msgstr "Zusätzliche Zielerfassungsdauer, die im Turbomodus erforderlich wird."

msgid "tank_params/desc/attainableSpeed"
msgstr "Geschwindigkeit eines Fahrzeugs nach 5 Sekunden Beschleunigung aus dem Stand auf einer Ebene.\nWerte werden für harten/normalen/weichen Boden angezeigt."

msgid "tank_params/desc/autoReloadTime"
msgstr "Zeit zum sukzessiven automatischen Nachladen einer Granate in das Magazin."

msgid "tank_params/desc/autoReloadTime/boost"
msgstr "Normale Zeit zum sukzessiven automatischen Nachladen jeder Granate in das Magazin"

msgid "tank_params/desc/autoReloadTime/boost/description"
msgstr "Das verbesserte System senkt die normale Zeit zum automatischen Nachladen der nächsten Granate, nachdem die geladene Granate abgefeuert wurde, sobald die entsprechende Markierung angezeigt wird."

msgid "tank_params/desc/autoReloadTime/boost/shortDescription"
msgstr "Der verbesserte Ladeautomat reduziert die normale Zeit für das automatische Nachladen von Granaten."

msgid "tank_params/desc/autoShootClipFireRate"
msgstr "Zeit zwischen dem Abfeuern der letzten Granate im Magazin (oder beiden Geschützen) und dem Laden des neuen Magazins. / Anzahl Geschütze oder Granaten im Magazin."

msgid "tank_params/desc/autoreloaderSurgeBoostedReloadTime"
msgstr "Die Zeit, auf welche die Nachladezeit bei Einsatz des Mechanismus gesetzt wird."

msgid "tank_params/desc/autoreloaderSurgeChargeTimeFast"
msgstr "Die Zeit, in der eine Ladung aufgefüllt wird, wenn das Magazin voll ist."

msgid "tank_params/desc/autoreloaderSurgeChargeTimeSlow"
msgstr "Die Zeit, in der eine Ladung aufgefüllt wird, wenn das Magazin nicht voll ist."

msgid "tank_params/desc/autoreloaderSurgeInitCharges"
msgstr "Die Anzahl Ladungen, die zu Beginn des Gefechts verfügbar ist."

msgid "tank_params/desc/autoreloaderSurgeMaxCharges"
msgstr "Die Anzahl der Ladungen zum Beschleunigen der Nachladezeit, die maximal verfügbar sein können."

msgid "tank_params/desc/auxiliaryRocketLauncherAvgDamage"
msgstr "Mittlerer Schaden von Geschossen des Raketenwerfers nach Durchschlag. Die potenzielle Abweichung des Schadens beträgt ±25 % des mittleren Wertes."

msgid "tank_params/desc/auxiliaryRocketLauncherDispersion"
msgstr "Streuung, angegeben durch die maximale Abweichung der Granate vom Zielpunkt auf eine Entfernung von 100 m."

msgid "tank_params/desc/auxiliaryRocketLauncherPenetration"
msgstr "Mittlere Panzerungsstärke, die von Geschossen des Raketenwerfers durchschlagen wird. Die Streuung beträgt ±25 % des mittleren Wertes."

msgid "tank_params/desc/auxiliaryRocketLauncherReloadTime"
msgstr "Erforderliche Zeit zum Nachladen des Raketenwerfers."

msgid "tank_params/desc/auxiliaryRocketLauncherVelocity"
msgstr "Angabe der Fluggeschwindigkeit der ungelenkten Rakete."

msgid "tank_params/desc/avgDamage"
msgstr "Mittlerer Schaden von Standardgranaten nach Durchschlag. Die potenzielle Abweichung des Schadens beträgt +/- 25 % des mittleren Wertes."

msgid "tank_params/desc/avgDamagePerMinute"
msgstr "Die Schadensmenge, die potentiell innerhalb einer Minute an einem Fahrzeug verursacht wird, wenn alle Treffer die Panzerung durchschlagen."

msgid "tank_params/desc/avgDamagePerSecond"
msgstr "Schaden, der potenziell in 1 Sekunde mit kontinuierlichem Feuer an einem gegnerischen Fahrzeug verursacht werden kann, wenn alle Treffer die Panzerung durchschlagen."

msgid "tank_params/desc/avgPiercingPower"
msgstr "Mittlere Panzerungsstärke, die von Standardgranaten nach Granatennormalisierung durchschlagen wird. Die Streuung beträgt +/- 25 % des mittleren Wertes."

msgid "tank_params/desc/boosterCoolingTime"
msgstr "Die erforderliche Zeit, bis die Booster komplett abgekühlt sind, nachdem die kritische Hitzestufe erreicht wurde."

msgid "tank_params/desc/boosterDuration"
msgstr "Maximale Dauer des Effekts des Boosters nach Aktivierung."

msgid "tank_params/desc/burstFireRate"
msgstr "Ladezeit der Granaten im Behälter / Anzahl der Behälter im Magazin / Anzahl der Granaten im Behälter"

msgid "tank_params/desc/bustleFeedDamagePerShot"
msgstr "Mittlerer Schaden von Schüssen mit Hochladungs-Einheitsmunition nach Durchschlag. Die potenzielle Abweichung des Schadens beträgt ±25 % des mittleren Wertes."

msgid "tank_params/desc/bustleFeedMaxSpeed"
msgstr "Im Modus der externen Munitionszufuhr ist die nominelle Vorwärtsgeschwindigkeit reduziert. Die Rückwärtsgeschwindigkeit ist nicht betroffen."

msgid "tank_params/desc/bustleFeedRateOfFire"
msgstr "Im Modus der externen Munitionszufuhr ist die Anzahl der Granaten pro Minute reduziert."

msgid "tank_params/desc/bustleFeedSwitchingToEASMMode"
msgstr "Mindestdauer zur Vorbereitung des Geschützes nach dem Aktivieren der externen Munitionszufuhr. Während dieser Zeit kann der Modus nicht gewechselt werden."

msgid "tank_params/desc/bustleFeedSwitchingToStandardMode"
msgstr "Mindestdauer zur Vorbereitung des Geschützes nach dem Zurückstellen auf den Standardmodus. Während dieser Zeit kann der Modus nicht gewechselt werden."

msgid "tank_params/desc/chargeTime"
msgstr "Vorbereitungszeit für gleichzeitiges Abfeuern beider Geschütze. / Dauer der Nachladesperre nach dem Abfeuern einer Salve."

msgid "tank_params/desc/chargeableBurstDispersion"
msgstr "Die Streuung für den zweiten Schuss im Garbenmodus, bestimmt durch die maximale Abweichung der Granate vom Zielpunkt auf einer Entfernung von 100 m."

msgid "tank_params/desc/chargeableBurstPenetrationCount"
msgstr "Anzahl durchschlagender Treffer an gegnerischen Fahrzeugen, die erforderlich sind, um den Modus zu aktivieren."

msgid "tank_params/desc/chargeableBurstReload"
msgstr "Nachladezeit zwischen dem ersten und dem zweiten Schuss im Garbenmodus."

msgid "tank_params/desc/chargeableBurstSize"
msgstr "Anzahl von Granaten in der Garbenfeuerkassette."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Zeit für die Reparatur einer beschädigten Kette."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Zeit für die Reparatur einer beschädigten Haupt-/Reservekette."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "Geschwindigkeit, mit der die Wanne sich um ihre eigene Achse drehen kann und Geschwindigkeit der Richtungsänderungen in Bewegung (Beweglichkeit)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "Die aktuelle Sichtweite Ihres Fahrzeugs. Über 445 m können keine gegnerischen Fahrzeuge aufgeklärt werden. Eine weitere Steigerung der Sichtweite ermöglicht es, gegnerische Fahrzeuge auf einer Entfernung von bis zu 445 m leichter aufzuklären. (Standard-/Spezialmodus)"

msgid "tank_params/desc/clipFireRate"
msgstr "Zeit zwischen dem Abschuss der letzten Granate im Magazin (oder der beiden Geschütze) und dem Nachladen des neuen Magazins / Zeit zwischen dem Abschuss einer Granate und Nachladen der nächsten Granate im Magazin, Geschütz oder Behälter / Anzahl der Geschütze oder Granaten im Magazin"

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Dauer des Effekts des elektromechanischen Fügungssichtgeräts nach der Aktivierung."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Die erforderliche Zeit, bis der Stabilisator nach der Nutzung erneut aktiviert werden kann."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Die Zeit, die der Stabilisator aktiv bleibt."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Anzahl Schuss pro Minute ohne Nachladezeit."

msgid "tank_params/desc/coolingDelay"
msgstr "Zeit nach dem Abfeuern, bis das Geschütz abzukühlen beginnt."

msgid "tank_params/desc/coolingTime"
msgstr "Zeit, bis das vollständig erhitzte Geschütz abgekühlt ist. Das Geschütz kann während dieser Zeit genutzt werden."

msgid "tank_params/desc/damage"
msgstr "Schaden, den eine Standardgranate nach dem Durchschlagen der gegnerischen Panzerung verursacht."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Die erforderliche Zeit, bis die Erfassung erneut genutzt werden kann. Die Abklingzeit beginnt, sobald der Schuss abgefeuert wurde."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Die nach Beginn des Gefechts erforderliche Zeit, bis die Erfassung zum ersten Mal genutzt werden kann."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Die Zeit, für die markierte gegnerische Fahrzeuge aufgeklärt bleiben und zusätzlichen Schaden von Granaten erleiden."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "Der zusätzliche Schaden, den markierte gegnerische Fahrzeuge von Granaten erleiden."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "Der Bonus auf Streuung auf 100 m, der durch das Sichtgerät verliehen wird."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Zeigt, wie viel Zeit nach einem Schuss benötigt wird, damit das Geschütz abkühlen und die Genauigkeit steigen kann."

msgid "tank_params/desc/enginePower"
msgstr "Dieser Parameter beeinflusst die Beschleunigung, Höchstgeschwindigkeit und Wendegeschwindigkeit des Fahrzeugs."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Dieser Wert beeinflusst die Fahrzeugbeschleunigung und -leistung auf verschiedenen Böden (Standard-/Spezialmodus)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "Der Bonus auf die Beschleunigung des Fahrzeugs, der von den Boostern verliehen wird."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Dieser Wert beeinflusst die Beschleunigung, Höchstgeschwindigkeit und Wendegeschwindigkeit des Fahrzeugs im Turbomodus."

msgid "tank_params/desc/explosionRadius"
msgstr "Der Schadensradius nach Explosion der HE-Granate. Zeigt die Fähigkeit, Schaden auf Distanz vom Punkt des Einschlags zu verursachen."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Die Zeit, die dem Nachladen der verbleibenden Kassette nach Feuern der letzten Granate hinzugefügt wird."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Die Fahrzeuggeschwindigkeit, wie sie in den technischen Daten festgelegt ist."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "Der Bonus auf den mittleren Schaden pro Minute bei maximaler Nachladeeffizienzstufe."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Die Maximalzahl Nachladeeffizienzstufen, die angesammelt werden kann."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "Die Dauer, die die Nachladeeffizienzstufe wirkt, ehe sie ausläuft."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "Die Anzahl der durch das Zerstören eines gegnerischen Fahrzeugs mit einer Granate erhaltenen Nachladeeffizienzstufen."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "Die Anzahl der durch einen Treffer mit einer Granate an einem aufgeklärten gegnerischen Fahrzeug erhaltenen Nachladeeffizienzstufen."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "Die Menge, um die die Nachladezeit des Geschützes pro Nachladeeffizienzstufe reduziert wird."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "Der Malus auf Streuung bei Geschützrichten im Turbomodus."

msgid "tank_params/desc/gunYawLimits"
msgstr "Maximaler Winkel, in den das Geschütz (von Normalstellung nach links und rechts) ausgerichtet werden kann, solange die Wanne bewegungslos bleibt."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "Der Bonus auf den mittleren Schaden für jede angesammelte Hitzestufe."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Die Zeit, die das Fahrzeug keine Granaten abfeuern oder wechseln kann."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Die Zeit, die ein Fahrzeug auf maximaler Hitzestufe bleiben kann, ohne zu überhitzen."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Die Zeit, die für das Erreichen jeder Hitzestufe nötig ist."

msgid "tank_params/desc/heatingPerShot"
msgstr "Die Hitze, die das Geschütz bei jedem Schuss entwickelt."

msgid "tank_params/desc/hullArmor"
msgstr "Dicke der Wannenpanzerung: Front / Seiten / Heck."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "Der Malus auf Streuung bei Wannendrehung im Turbomodus."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Dieser Wert gibt die Schadensmenge an, die durch Rammen verursacht wird. Wenn Fahrzeuge zusammenstoßen, berechnet das System die Stärke der Panzerung an der Stelle des Aufpralls, den Gewichtsunterschied der Fahrzeuge und ihre jeweilige Geschwindigkeit."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Dieser Wert gibt die Schadensmenge an, die dem Fahrwerk durch Rammen zugefügt wird. Wenn Fahrzeuge zusammenstoßen, berechnet das System die Stärke der Panzerung an der Stelle des Aufpralls, den Gewichtsunterschied der Fahrzeuge und ihre jeweilige Geschwindigkeit."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Zeigt die Tarnung eines Fahrzeugs in Bewegung an. Je größer der Parameter, desto getarnter ist das Fahrzeug. Folgende Parameter sind angegeben: für ein sich bewegende Fahrzeug / für ein sich bewegendes Fahrzeug nach Schussabgabe."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Zeigt die Tarnung eines bewegungslosen Fahrzeugs an. Je größer der Parameter, desto getarnter ist das Fahrzeug. Folgende Parameter sind angegeben: für ein stehendes Fahrzeug / für ein stehendes Fahrzeug nach Schussabgabe."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "Die Ladung für den Ionenladung-Nachbrenner, die pro Sekunde bei einer Geschwindigkeit von über 40 km/h im Turbomodus generiert wird."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Dieser Wert beeinflusst, wie lange der Ionenladung-Nachbrenner nach der Aktivierung wirkt."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Dieser Wert beeinflusst die Beschleunigung, Höchstgeschwindigkeit und Wendegeschwindigkeit des Fahrzeugs nach Aktivierung des Ionenladung-Nachbrenners."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "Zusätzliche Geschwindigkeit, die durch Aktivierung des Ionenladung-Nachbrenners gewonnen wird."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "Die Ladung für den Ionenladung-Nachbrenner, die pro Sekunde im Turbomodus generiert wird."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Der mittlerer Schaden von Schüssen mit Einzelladung nach Durchschlag. Die potenzielle Abweichung des Schadens beträgt +/- 25 % des mittleren Wertes."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Die Zeit vor dem vollständigen Nachladen, in der Schüsse mit Einzelladung nicht abgefeuert werden können."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Die Erhöhung der Geschützstreuung beim Feuern von Schüssen mit Einzelladung. Angegeben durch die maximale Abweichung der Granate vom Zielpunkt auf eine Entfernung von 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Die mittlere Panzerungsstärke, die von Schüssen mit Einzelladung nach Granatennormalisierung durchschlagen wird. Die Streuung beträgt +/- 25 % des mittleren Wertes."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Die Erhöhung der Schüsse pro Minute beim Schießen von Schüssen mit Einzelladung (im Vergleich zu normalen Schüssen)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Die Geschwindigkeit von Schüssen mit Einzelladung."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Die Maximalzahl Genauigkeitsstufen, die angesammelt werden kann."

msgid "tank_params/desc/maxHealth"
msgstr "Menge der Strukturpunkte des Fahrzeugs."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "Der maximale Winkel, den das Rad drehen kann. Beeinflusst die Manövrierbarkeit und das Handling des Fahrzeugs."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "Der Malus auf Streuung bei Bewegung im Turbomodus."

msgid "tank_params/desc/overheatDuration"
msgstr "Zeit zum vollständigen Abkühlen des überhitzten Geschützes. Das Geschütz kann während des Abkühlens nicht genutzt werden."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "Die Ladung für das elektromechanische Fügungssichtgerät, die im Angriffsmodus pro Sekunde erzeugt wird."

msgid "tank_params/desc/piercingPower"
msgstr "Dicke der Panzerung, die von einer Standardgranate nach Granatennormalisierung durchschlagen werden kann."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Geschwindigkeit, mit der die Wanne sich um ihre eigene Achse drehen kann und Geschwindigkeit der Richtungsänderungen in Bewegung (Beweglichkeit)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "Die für den Moduswechsel benötigte Zeit hängt vom Zustand des Motors ab. Ein beschädigter Motor verlängert die Wechselzeit. Mit zerstörtem Motor kann nicht gewechselt werden."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "Die für den Moduswechsel benötigte Zeit hängt vom Zustand des Motors ab. Ein beschädigter Motor verlängert die Wechselzeit. Mit zerstörtem Motor kann nicht gewechselt werden."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Geschwindigkeit, mit der die Wanne im Bunkermodus angehoben oder abgesenkt wird."

msgid "tank_params/desc/pitchLimits"
msgstr "Maximale vertikale Winkel, die das Geschütz bewegt werden kann, relativ zur Fahrzeugwanne und unter Berücksichtigung des Fahrwerks."

msgid "tank_params/desc/powerModeDuration"
msgstr "Die erforderliche Zeit, um die maximale Vorwärtsgeschwindigkeit und Motorleistung für den Direktantrieb zu erreichen."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Die erforderliche Zeit, um den Direktantrieb zu aktivieren."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "Der Bonus auf Streuung auf 100 m bei voller Vorwärmung."

msgid "tank_params/desc/preheatDmgCap"
msgstr "Der Bonus auf mittleren Schaden bei voller Vorwärmung."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Das Überschreiten dieser Geschwindigkeitsgrenze verhindert, dass Vorwärmung generiert wird und kann diese sogar wieder absenken."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Die erforderliche Zeit, die das Fahrzeug braucht, bis eine volle Vorwärmung komplett abgeklungen ist."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Die erforderliche Zeit, die das Fahrzeug braucht, um von Null auf eine volle Vorwärmung zu kommen."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Während dieser Verzögerung wird die Vorwärmstufe weder ansteigen noch abklingen."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "Die maximale Ladungsstufe kann erreicht werden, ohne den Begrenzer zu deaktivieren."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "Die Menge verlorener Ladung nach Schussabgabe."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "Die Menge automatisch pro Sekunde erzeugter Ladung."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "Die Menge pro Sekunde verlorener Ladung nach Aktivierung der Begrenzers, bis die Grenze erreicht wird."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "Die Verzögerung, nach der der Begrenzer wieder umgeschaltet werden kann."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "Der Malus auf die Zielerfassungszeit, wenn die Grenze überschritten wird."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "Der gewährte Bonus auf den mittleren Schaden bei voller Ladung, wenn die Grenze überschritten wird."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "Die plötzliche Erhöhung des durch Schüsse verursachten Schadens, wenn die Grenze überschritten wird."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "Der Malus auf die Streuung auf 100 m, wenn die Grenze überschritten wird."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "Der gewährte Bonus auf den mittleren Schaden bei maximaler Ladung, wenn der Begrenzer aktiv ist."

msgid "tank_params/desc/radioDistance"
msgstr "Verständigung – Weiterleitung von Informationen über Stellungen von Fahrzeugen zwischen Verbündeten. Die Verständigungsreichweite wird durch einen Kreis mit dem Radius wiedergegeben, der für diesen Wert festgelegt ist. Überlappen mehrere Kreise, werden die Informationen auf die gesamte Reichweite verteilt."

msgid "tank_params/desc/reactivationDelay"
msgstr "Die erforderliche Abkühlzeit, bis der Booster nach der Nutzung erneut aktiviert werden kann."

msgid "tank_params/desc/reactivationLimit"
msgstr "Die maximale Hitzestufe, die erreicht werden kann, ehe die Booster nicht mehr erneut aktiviert werden können."

msgid "tank_params/desc/relativeArmor"
msgstr "Eine Reihe von Parametern, die zeigen, wie gut das Fahrzeug Schaden von gegnerischen Fahrzeugen widerstehen kann."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Eine Reihe von Parametern, die Auskunft über die Effizienz der Tarnung Ihres Fahrzeugs geben, wenn es bewegungslos ist, sich bewegt und/oder feuert. Am Fahrzeug angebrachte Tarnung steigert den Tarnungsparameter."

msgid "tank_params/desc/relativeMobility"
msgstr "Eine Reihe von Parametern, die zeigen, wie schnell das Fahrzeug seine Stellung auf dem Schlachtfeld wechseln kann."

msgid "tank_params/desc/relativePower"
msgstr "Eine Reihe von Parametern, die zeigen, wie gut das Fahrzeug gegnerische Fahrzeuge zerstören kann."

msgid "tank_params/desc/relativeVisibility"
msgstr "Eine Reihe von Parametern, die zeigen, wie gut das Fahrzeug gegnerische Fahrzeuge aufklären kann."

msgid "tank_params/desc/reloadTime"
msgstr "Anzahl Schuss pro Minute."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Bonus auf die Nachladezeit, wenn das Sichtgerät aktiv ist."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Die Dauer, das Geschütz (oder beide Geschütze bei Fahrzeugen mit Doppelgeschütz-System) nach einem Schuss nachzuladen."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
