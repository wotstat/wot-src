msgid "hint/LSH_FIRE"
msgstr "Rauch erschwert das Entdecken gegnerischer Fahrzeuge und das Übermitteln ihrer Position. Feuer verursacht Schaden an Fahrzeugen."

msgid "hint/LSH_FOG"
msgstr "Nebel erschwert das Entdecken gegnerischer Fahrzeuge und das Übermitteln ihrer Position."

msgid "hint/LSH_RAIN"
msgstr "Starker Regen erschwert das Entdecken gegnerischer Fahrzeuge und das Übermitteln ihrer Position."

msgid "hint/LSH_SANDSTORM"
msgstr "Sandstürme erschweren das Entdecken gegnerischer Fahrzeuge und das Übermitteln ihrer Position."

msgid "hint/LSH_SMOKE"
msgstr "Rauch erschwert das Entdecken gegnerischer Fahrzeuge und das Übermitteln ihrer Position."

msgid "hint/PPH_AIMING_01"
msgstr "Bewegung von Fahrzeug und Turm senken die <font color='#EE7000'>Genauigkeit</font>."

msgid "hint/PPH_AIMING_02"
msgstr "Der Kreis um das Fadenkreuz zeigt die <font color='#EE7000'>Genauigkeit des Geschützes</font> an. Zielen Sie einen Moment, dann wird der Schuss genauer."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatisches Zielen</font> aktiviert. Klicken Sie zum Deaktivieren die rechte Maustaste."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Das automatische Zielen richtet Ihr Geschütz immer <font color='#EE7000'>auf die Mitte</font> Ihres anvisierten Ziels aus."

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Ihre Basis wird <font color='#EE7000'>erobert!</font> Wenn Sie nicht zurückschlagen, gewinnt das gegnerische Team das Gefecht."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Jedes gegnerische Fahrzeug hat <font color='#EE7000'>einen eigenen</font> Eroberungsfortschritt."

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Die <font color='#EE7000'>Eroberung</font> der gegnerischen Basis ist eine Möglichkeit, das Gefecht zu gewinnen."

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Wenn Sie Schaden erleiden, wird Ihr Eroberungsfortschritt <font color='#EE7000'>zurückgesetzt</font>."

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Wenn Sie den Basiskreis verlassen, geht Ihr Eroberungsfortschritt <font color='#EE7000'>verloren</font>."

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Mehrere Fahrzeuge zusammen erobern eine Basis <font color='#EE7000'>schneller</font>."

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Nach dem <font color='#EE7000'>dritten</font> Fahrzeug erhöht sich die Eroberungsgeschwindigkeit nicht mehr."

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Die gegnerische Basis ist fast erobert!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Ihr Team gewinnt das Rennen um die Basiseroberung!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Das Fahrzeugmodul ist kritisch getroffen! Reparieren Sie es mit der <font color='#EE7000'>Ersatzteilkiste</font> im unteren Feld."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Das Fahrzeugmodul ist kritisch getroffen! Reparieren Sie es mit der <font color='#EE7000'>Ersatzteilkiste</font>, die Sie unten finden."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Das Besatzungsmitglied ist verletzt! Behandeln Sie es mit dem <font color='#EE7000'>Erste-Hilfe-Kasten</font> im unteren Feld."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Das Besatzungsmitglied ist verletzt! Behandeln Sie es mit dem <font color='#EE7000'>Erste-Hilfe-Kasten</font>, den Sie unten finden."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Die Besatzung des Fahrzeugs wurde betäubt! Behandeln Sie sie mit dem <font color='#EE7000'>Erste-Hilfe-Kasten</font> im unteren Feld."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Das Fahrzeug brennt! Nutzen Sie den <font color='#EE7000'>Feuerlöscher</font> im unteren Feld."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Das Fahrzeug brennt! Das <font color='#EE7000'>automatische Feuerlöschsystem</font> wurde aktiviert."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Das Fahrzeugmodul ist kritisch getroffen! Rüsten Sie vor dem Gefecht eine <font color='#EE7000'>Ersatzteilkiste</font> als Verbrauchsmaterial aus, um kritische Treffer zu beheben."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Das Besatzungsmitglied ist verletzt! Rüsten Sie vor dem Gefecht einen <font color='#EE7000'>Erste-Hilfe-Kasten</font> als Verbrauchsmaterial aus, um verletzte Besatzungsmitglieder behandeln zu können."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Das Fahrzeug brennt! Rüsten Sie vor dem Gefecht einen <font color='#EE7000'>Feuerlöscher</font> als Verbrauchsmaterial aus, um Brände löschen zu können."

msgid "hint/PPH_OTHER_01"
msgstr "Sie wurden <font color='#EE7000'>aufgeklärt</font>. Schüsse abzugeben kann Ihre Position verraten!"

msgid "hint/PPH_OTHER_02"
msgstr "Ihr Fahrzeug wurde zerstört. Drücken Sie die <font color='#EE7000'>Esc-Taste</font>, um das Gefecht ohne Strafe zu verlassen."

msgid "hint/PPH_OTHER_03"
msgstr "Ihr Fahrzeug wurde zerstört. Klicken Sie die Maustaste, um Ihren Verbündeten <font color='#EE7000'>zuzuschauen</font>."

msgid "hint/PPH_OTHER_04"
msgstr "Das <font color='#EE7000'>Glühbirnensymbol</font> zeigt an, dass Ihre Gegner Sie aufgeklärt haben!"

msgid "hint/PPH_OTHER_05"
msgstr "Ihr Geschütz <font color='#EE7000'>lädt noch nach</font>."

msgid "hint/PPH_OTHER_06"
msgstr "Ihr Geschütz kann nur feuern, wenn der Kreis um das Fadenkreuz <font color='#EE7000'>vollständig grün</font> ist."

msgid "hint/PPH_SNIPER_01"
msgstr "Durch Scrollen des Mausrads gelangen Sie in den <font color='#EE7000'>Zielfernrohrmodus</font>."

msgid "hint/PPH_SNIPER_02"
msgstr "Durch Scrollen des Mausrads <font color='#EE7000'>verlassen</font> Sie den Zielfernrohrmodus."

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Ein <font color='#EE7000'>inneres grünes Fadenkreuz</font> zeigt eine hohe Wahrscheinlichkeit an, die Panzerung des Gegners zu durchschlagen."

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Auch wenn das innere Fadenkreuz grün ist, ist das Durchschlagen der Panzerung <font color='#EE7000'>nicht garantiert</font>."

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Geschütze sind nicht zu 100 % genau, also landen Schüsse vielleicht <font color='#EE7000'>nicht immer in der Mitte</font> des Fadenkreuzes."

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Ein inneres Fadenkreuz zeigt die Wahrscheinlichkeit an, die Panzerung des Gegners zu durchschlagen. Diese Funktion können Sie <font color='#EE7000'>in den Einstellungen aktivieren</font>."

msgid "penetration/chance/high"
msgstr "Hohe Chance"

msgid "penetration/chance/low"
msgstr "Geringe Chance"

msgid "penetration/chance/medium"
msgstr "Mittlere Chance"
