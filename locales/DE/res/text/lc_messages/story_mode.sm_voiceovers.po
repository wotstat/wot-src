msgid "vo_sm_char10_m05_stg04_02"
msgstr "Führungsstab-Offizier: Die Panzer stecken am Strand fest. Sie brauchen die Unterstützung der Flotte."

msgid "vo_sm_char10_m05_stg13_06"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg13_07"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg14_01"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg14_01_01"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg21_02"
msgstr "Führungsstab-Offizier: Brückenkopf Echo-5 gesichert. Panzer rücken vor. Volles Unterstützungsfeuer angefordert."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Führungsstab-Offizier: Luftunterstützung umleiten, um Vorstoß der Panzer beizustehen."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Führungsstab-Offizier: Pioniergruppen, räumt die Hindernisse für den weiteren Vormarsch."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Führungsstab-Offizier: Der Strand ist gesichert. Wir entsenden die Haupttruppen. Hervorragende Arbeit."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Führungsstab-Offizier: Haltet die Position. Verstärkung ist unterwegs."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Führungsstab-Offizier: Schützt den Brückenkopf um jeden Preis."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Führungsstab-Offizier: Ein weiterer Panzer, eine weitere Chance. Passt diesmal besser auf."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Führungsstab-Offizier: Uns gehen die Reserven aus. Setzen Sie diesen gut ein, Kommandant."

