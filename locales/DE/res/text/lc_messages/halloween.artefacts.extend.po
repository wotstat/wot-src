msgid "damageShield/onUse"
msgstr "Erzeugt einen Energieschild, der das Fahrzeug 7 s lang vor jeglichem Schaden außer Rammen, Versinken und Aufprall schützt."

msgid "damageShield/restriction"
msgstr "?empty?"

msgid "damageShield/short_special"
msgstr "Gewährt Unverwundbarkeit."

