msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "Der Pojistka ist eine komplette Werkstatt auf Ketten. Harte Kanten, saubere Verkabelung, jedes System reagiert sofort. Wir sind ausgerückt, um einen verrückten Wissenschaftler aufzuhalten, und trafen auf etwas, das er seine Elektrische Intelligenz nennt. Seine Wächter lernen noch, sie beobachten jede unserer Bewegungen. Er hat sie gebaut, um uns zu ersetzen. Nun gut. Dann will ich ihnen heute mal etwas beibringen. Ich suche mir eine Anhöhe, wähle mein Ziel und lass diese hübschen Granaten ihre Arbeit verrichten. Wenn er wirklich glaubt, dass eine denkende Maschine uns überleben wird, dann wollen wir mal sehen, wie sie mit etwas Druck klarkommt."

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "Umfangreiche Modernisierung des Kampfpanzers"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silberkugel"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "Stolz der Panzerschmiede der Allianz"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Jeder überladene Generator lädt die Silberkugel mit Plasma auf. Je mehr Ladungen, desto höher das Schadenspotenzial des Plasmas. Schießen Sie, wenn die Schilde des Blitzträgers deaktiviert sind, um maximalen Schaden zu verursachen."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Zusätzlicher Schaden durch Plasma"
