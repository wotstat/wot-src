msgid "comp7/deserter/cancel"
msgstr "Abbrechen"

msgid "comp7/deserter/message"
msgstr "Das Gefecht ist noch nicht vorbei. Wenn Sie das Gefecht verlassen, bevor es zu Ende ist, schwächen Sie damit Ihr Team.\n{brown_open}Ihre Wertung wird reduziert und Sie werden von Gefechten in diesem Modus ausgeschlossen.{brown_close}\nSind Sie sicher, dass Sie das Gefecht verlassen wollen?"

msgid "comp7/deserter/msgTitle"
msgstr "Sie werden Ihre Wertungspunkte verlieren!"

msgid "comp7/deserter/submit"
msgstr "Desertieren"

msgid "comp7/deserter/title"
msgstr "Desertieren vom Schlachtfeld"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Sie haben um {whiteSpanish_Open}%(time)s{whiteSpanish_Close} auf der Karte {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} gegen die Spielregeln verstoßen.\nIhnen wurden {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Wertungspunkte abgezogen und Sie wurden vorübergehend von Gefechten im Spielmodus {whiteSpanish_Open}„Ansturm“{whiteSpanish_Close} ausgeschlossen."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Sie haben um {whiteSpanish_Open}%(time)s{whiteSpanish_Close} auf der Karte {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} gegen die Spielregeln verstoßen.\nSie wurden vorübergehend von Gefechten im Spielmodus {whiteSpanish_Open}„Ansturm“{whiteSpanish_Close} ausgeschlossen und Ihre Wertung wurde reduziert."
