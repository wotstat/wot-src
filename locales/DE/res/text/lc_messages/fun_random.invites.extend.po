msgid "invites/note/change_and_leave/PREBATTLE_FUN_RANDOM"
msgstr "Wenn Sie die Einladung annehmen, werden Sie automatisch aus dem Zug in „%(modeName)s“ entfernt und wechseln auf den Server %(host)s."

