msgid "invites/note/leave/QUEUE_FUN_RANDOM"
msgstr "Haben Sie die Einladung angenommen, verlassen Sie den Modus „%(modeName)s“."

msgid "invites/prebattle/alreadyJoined/FUN_RANDOM"
msgstr "Sie sind dem Zug bereits beigetreten."

