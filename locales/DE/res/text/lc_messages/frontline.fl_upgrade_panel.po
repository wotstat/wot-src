msgid "alert"
msgstr "Sie können im aktiven Kampf keine Kampfreserve auswählen."

msgid "description/one/reserve"
msgstr "Wenn Sie die Reserve %(reserve_name)s mehrfach auswählen,\nwerden ihre Werte verbessert."

msgid "description/second/reserve"
msgstr "Wenn Sie die Reserve %(first_reserve_name)s oder %(second_reserve_name)s mehrfach auswählen,\nwerden die Werte der ausgewählten Reserve verbessert."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Legt im gewünschten Bereich für einen bestimmten Zeitraum ein aktives Minenfeld."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Verursacht innerhalb eines kleinen Radius beträchtlichen Schaden an Gegnerfahrzeugen."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Betäubt Gegnerfahrzeuge und verursacht mittelmäßigen Schaden in einem großen Radius."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Fügt den Besatzungen des Spielers und der Verbündeten einen Bonus auf die Hauptspezialisierung hinzu."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Bietet einen Bonus auf Eroberungsgeschwindigkeit, Blockieren der Eroberung und Versorgung."

msgid "shortDescription/reserve/reconAbility"
msgstr "Klärt Gegnerfahrzeuge und Minenfelder auf."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Stellt einen bestimmten Anteil der Strukturpunkte Ihres Fahrzeugs wieder her."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Verbirgt alle Fahrzeuge im und hinter dem Nebel."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Bietet einen Bonus auf Tarnung und Sichtweite. Reduziert die Tarnung gegnerischer Fahrzeuge."

msgid "title"
msgstr "Der %(number_name)s verfügbare Reserveplatz"
