msgstr "Abgassystem-Isolierung"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Erhöht den Tarnwert eines stehenden oder sich bewegenden Fahrzeugs"

msgid "additionalInvisibilityDevice/long_special"
msgstr "Die Wirksamkeit hängt vom Fahrzeugtyp ab. Steigert den Tarnwert eines stehenden oder sich bewegenden Fahrzeugs. Nützlich für aktives wie passives Aufklären aus riskanten Stellungen."

msgid "additionalInvisibilityDevice/name"
msgstr "Geräuscharmes Abgassystem"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Erhöht den Tarnwert eines stehenden oder sich bewegenden Fahrzeugs."

