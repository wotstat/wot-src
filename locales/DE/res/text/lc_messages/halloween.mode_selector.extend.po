msgid "mode/halloween/battlePassTooltip/body"
msgstr "Über bestimmte Aufträge im Event „{whiteSpanish_open}Babylon: Dunkelturm{whiteSpanish_close}“ können Sie Punkte für den Battle Pass verdienen."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Punkte für den Battle Pass"

msgid "mode/halloween/calendar"
msgstr "Das Event dauert %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Das Event endet in %(date)s."

msgid "mode/halloween/description"
msgstr "Kämpfen und sammeln Sie Materie ein.\nGefechte in Spezialfahrzeugen."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Die Leistung Ihres Computers reicht für diesen Modus nicht aus. Es können Probleme bei Grafik und Fahrzeugbewegung auftreten. Clientabstürze sind ebenfalls möglich."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Geringe Leistung"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Geringe Leistung"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Dieser Modus erfordert eine hohe Computerleistung.\nEs können Probleme beim Laden von Karten, der Grafik und der Fahrzeugbewegung auftreten. Reicht die Leistung nicht aus, sollten Sie die Grafikqualität in den Einstellungen heruntersetzen."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Verringerte Leistung"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Verringerte Leistung"
