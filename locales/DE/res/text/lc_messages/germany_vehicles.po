msgid "PzIV_Hydro"
msgstr "Pz.Kpfw. IV hydrostat."

msgid "PzIV_Hydro_descr"
msgstr "Die Entwicklung deutscher Fahrzeuge mit hinten liegendem, hydrostatischem Antrieb wurde im Juli 1944 begonnen. Das Chassis des Pz.Kpfw. IV Ausf. G wurde für die damit verbundenen Tests verwendet. Der erste Prototyp stand Ende Oktober 1944 bereit. Er blieb das einzige jemals gebaute Fahrzeug."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

msgid "PzIV_Schmalturm_A"
msgstr "Pz.Kpfw. IV Schmalturm"

