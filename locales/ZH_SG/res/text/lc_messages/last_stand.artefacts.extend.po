msgid "LS_invisibility/always"
msgstr "?empty?"

msgid "LS_invisibility/descr"
msgstr "阻止敌人瞄准您的战车，恢复血量，修复模块并灭火。"

msgid "LS_invisibility/long_special"
msgstr "战术装置。阻止敌人瞄准您的战车，持续时间为10秒。每秒恢复32点血量，立即修理模块，扑灭火灾，移除震晕效果，并治疗所有受伤的乘员。造成或受到敌方战车伤害时（开火、撞击或使用战术装置）将立即暴露您的位置。若在战斗中使用过至少一次，此装置在战斗后就会耗尽，后续可花费银币补充。若未曾使用，则不需要补充。<br/><br/>仅可在<font color='#cbac77'>“背水一战：北境大地”</font>活动中使用。<br/><br/>所有未使用的装置将被移除并在下个版本补偿等于其价值50%的银币。"

msgid "LS_invisibility/name"
msgstr "暗影治疗"

msgid "LS_invisibility/onUse"
msgstr "阻止敌人瞄准您的战车，持续时间为10秒。每秒恢复32点血量、立即修复模块、灭火、移除震晕效果并治疗所有受伤的乘员。造成或受到敌方战车伤害时（开火、撞击或使用战术装置）将立即暴露您的位置。"

msgid "LS_invisibility/restriction"
msgstr "?empty?"

msgid "LS_invisibility/short_special"
msgstr "暂时阻止敌人瞄准您的战车，恢复血量、修复模块、灭火、移除震晕效果并治疗所有受伤的乘员。"

