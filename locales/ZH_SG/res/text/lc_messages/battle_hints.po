msgid "hint/LSH_FIRE"
msgstr "烟雾会让侦察敌方战车和传输其位置变得更加困难。火灾则会对战车造成伤害。"

msgid "hint/LSH_FOG"
msgstr "浓雾会让侦察敌方战车和传输其位置变得更加困难。"

msgid "hint/LSH_RAIN"
msgstr "豪雨会让侦察敌方战车和传输其位置变得更加困难。"

msgid "hint/LSH_SANDSTORM"
msgstr "沙尘暴会让侦察敌方战车和传输其位置变得更加困难。"

msgid "hint/LSH_SMOKE"
msgstr "烟雾会让侦察敌方战车和传输其位置变得更加困难。"

msgid "hint/PPH_AIMING_01"
msgstr "战车和炮塔移动时会降低<font color='#EE7000'>火炮准度</font>"

msgid "hint/PPH_AIMING_02"
msgstr "准星周围的圆圈代表<font color='#EE7000'>火炮准度</font>。稍作等待可以更精准地射击。"

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "已开启<font color='#EE7000'>自动瞄准</font>。点击鼠标右键以取消。"

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "自动瞄准总是会瞄准目标坦克的<font color='#EE7000'>中心</font>位置"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "敌人正在<font color='#EE7000'>占领</font>己方基地！如果不及时将他们驱离，敌方团队将获胜。"

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "每辆敌方坦克都有<font color='#EE7000'>各自的</font>占领进度"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>占领</font>敌方基地是获胜的方式之一"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "当您受到伤害时，占领进度将<font color='#EE7000'>重置</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "离开基地占领圈后，占领进度将<font color='#EE7000'>重置</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "多辆战车能<font color='#EE7000'>更快</font>地占领基地"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "占领圈内有<font color='#EE7000'>三辆</font>战车后，后续进入的战车不会提高占领速度"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "即将占领敌方基地！"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "己方团队将比敌方团队更快占领基地！"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "战车模块严重受损！使用底部面板中的<font color='#EE7000'>修理箱</font>进行修复。"

msgid "hint/PPH_CONSUMABLES_02"
msgstr "战车模块严重受损！使用底部面板中的<font color='#EE7000'>修理箱</font>进行修复。"

msgid "hint/PPH_CONSUMABLES_03"
msgstr "乘员受伤！使用底部面板中的<font color='#EE7000'>急救包</font>进行治疗。"

msgid "hint/PPH_CONSUMABLES_04"
msgstr "乘员受伤！使用底部面板中的<font color='#EE7000'>急救包</font>进行治疗。"

msgid "hint/PPH_CONSUMABLES_05"
msgstr "全体乘员被震晕！使用底部面板中的<font color='#EE7000'>急救包</font>进行治疗。"

msgid "hint/PPH_CONSUMABLES_06"
msgstr "战车起火！使用底部面板中的<font color='#EE7000'>灭火器</font>来灭火。"

msgid "hint/PPH_CONSUMABLES_07"
msgstr "战车起火！自动<font color='#EE7000'>灭火器</font>已激活。"

msgid "hint/PPH_CONSUMABLES_08"
msgstr "战车模块严重受损！加入战斗前安装<font color='#EE7000'>修理箱</font>可助您应对这种情况。"

msgid "hint/PPH_CONSUMABLES_09"
msgstr "乘员受伤！加入战斗前安装<font color='#EE7000'>急救包</font>可助您应对这种情况。"

msgid "hint/PPH_CONSUMABLES_10"
msgstr "战车起火！加入战斗前安装<font color='#EE7000'>灭火器</font>可助您应对这种情况。"

msgid "hint/PPH_OTHER_01"
msgstr "您在射击时有可能暴露自己的位置——敌人已<font color='#EE7000'>侦察到</font>您！"

msgid "hint/PPH_OTHER_02"
msgstr "您的战车被摧毁。您可以按<font color='#EE7000'>Esc</font>键离开战斗且不会受到惩罚。"

msgid "hint/PPH_OTHER_03"
msgstr "您的战车被摧毁。您可以点击鼠标左右键<font color='#EE7000'>观察</font>您的队友。"

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>灯泡图标</font>表示您已被敌方侦察到！"

msgid "hint/PPH_OTHER_05"
msgstr "您的火炮仍在<font color='#EE7000'>装填中</font>"

msgid "hint/PPH_OTHER_06"
msgstr "准星周围的圆圈必须<font color='#EE7000'>完全变绿</font>才能进行射击"

msgid "hint/PPH_SNIPER_01"
msgstr "您可以滚动鼠标滚轮进入<font color='#EE7000'>狙击模式</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "您可以滚动鼠标滚轮<font color='#EE7000'>退出</font>狙击模式"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>内绿色准星</font>表示有较高几率击穿敌方的装甲"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "即使当内准星为绿色时，也<font color='#EE7000'>不保证</font>一定能击穿装甲"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "火炮并非百分之百精准，因此炮弹<font color='#EE7000'>并非总会落在准星的中心</font>"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "内准星代表击穿敌方装甲的几率。在<font color='#EE7000'>设定中开启</font>。"

msgid "penetration/chance/high"
msgstr "高几率"

msgid "penetration/chance/low"
msgstr "低几率"

msgid "penetration/chance/medium"
msgstr "中等几率"
