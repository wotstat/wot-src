msgid "battlePassSeasonDescription"
msgstr "全新主题3D风格"

msgid "beCareful"
msgstr "小心"

msgid "comp7Core10"
msgstr "您在战前准备期间可以切换至更适合的战车。"

msgid "comp7Core10Status"
msgstr "战前准备"

msgid "comp7Core11"
msgstr "战前准备界面会显示您的战车，以及其配备的乘员和炮弹。别忘了在进入战斗前做好整备。"

msgid "comp7Core11Status"
msgstr "战前准备"

msgid "comp7Core12"
msgstr "一旦您选定战车，请点击确认选择按钮让队友知悉。"

msgid "comp7Core12Status"
msgstr "战前准备"

msgid "comp7Core13"
msgstr "点击确认选择按钮后，您将无法更换战车。"

msgid "comp7Core13Status"
msgstr "确认您的选择"

msgid "comp7Core14"
msgstr "占领地图上的特殊点位以解锁战术技能并获得优势！"

msgid "comp7Core14Status"
msgstr "关键点位"

msgid "comp7Core15"
msgstr "地图上的关键点位。占领此区域后，您可以使用装甲师雷达战术技能。激活时，所有敌方战车将在数秒内保持可见。"

msgid "comp7Core15Status"
msgstr "通信中心"

msgid "comp7Core16"
msgstr "地图上的关键点位。占领此区域后，您可以使用炮击战术技能。激活时，玩家可以用火炮弹幕攻击选定区域。"

msgid "comp7Core16Status"
msgstr "炮兵总部"

msgid "comp7Core17"
msgstr "如果炮击战术技能命中了您的队友，他们不会受到伤害，但会被震晕。"

msgid "comp7Core17Status"
msgstr "炮击"

msgid "comp7Core18"
msgstr "请注意：地图在此模式中可能与在随机战中不同。"

msgid "comp7Core18Status"
msgstr "活动地图"

msgid "comp7Core19"
msgstr "创建7人小队可以提升您的胜率。"

msgid "comp7Core19Status"
msgstr "团队配合是关键"

msgid "comp7Core21"
msgstr "您可以在战斗中按下Tab键或Alt键来查看队友角色技能的充能等级。"

msgid "comp7Core21Status"
msgstr "队友角色技能"

msgid "comp7Core22"
msgstr "您可以通过团队列表来查看队友是否获得了战术技能。敌方战术技能不会显示。"

msgid "comp7Core22Status"
msgstr "战术技能"

msgid "comp7Core23"
msgstr "如果战车当前受角色技能影响，玩家标志上方将会显示对应的图标。"

msgid "comp7Core23Status"
msgstr "角色技能效果"

msgid "comp7Core24"
msgstr "按H键（默认）开启语音聊天。使用此功能与您的团队更加高效地进行沟通。"

msgid "comp7Core24Status"
msgstr "语音聊天"

msgid "comp7Core25"
msgstr "如果您使用语音聊天时遇到任何问题，请检查您的游戏客户端设置。"

msgid "comp7Core25Status"
msgstr "语音聊天"

msgid "comp7Core29"
msgstr "按住Alt键时，您视野范围内的所有战车会在玩家标志上方显示战车角色。您还能看到己方玩家角色技能的充能等级。"

msgid "comp7Core29Status"
msgstr "战车角色"

msgid "comp7Core31"
msgstr "您可以在游戏设置中为角色和战术技能重新分配快捷键。"

msgid "comp7Core31Status"
msgstr "控制设置"

msgid "comp7Core32"
msgstr "一段时间后，您将可以重新占领关键点位。"

msgid "comp7Core32Status"
msgstr "关于关键点位"

msgid "comp7Core33"
msgstr "使用对应的战术技能前，您无法占领关键点位。"

msgid "comp7Core33Status"
msgstr "关于关键点位"

msgid "comp7Core34"
msgstr "占领关键点位将为您带来一定数量的威望点数。"

msgid "comp7Core34Status"
msgstr "关于关键点位"

msgid "comp7Core35"
msgstr "查看活动规则，了解关于威望点数的更多详情。"

msgid "comp7Core35Status"
msgstr "关于威望点数"

msgid "comp7Core37"
msgstr "模式的变项会改变战车的特定参数：如战车血量、消耗品冷却时间、保持可见的时间等。"

msgid "comp7Core37Status"
msgstr "天梯战变项"

msgid "comp7Core5"
msgstr "每辆战车将获得一个视角色而定、拥有3个充能等级的特殊技能。激活时技能的充能等级越高，效果就越强。"

msgid "comp7Core5Status"
msgstr "关于角色技能"

msgid "comp7Core6"
msgstr "威望点数可通过战斗中的出色表现、占领关键点位、使用战术技能等方式获取。"

msgid "comp7Core6Status"
msgstr "关于威望点数"

msgid "comp7Core8"
msgstr "玩家不会获得关于对手的信息，直至发现对方。"

msgid "comp7Core8Status"
msgstr "战争迷雾"

msgid "comp7Light7"
msgstr "您可以点击活动界面中的“关于活动”按钮了解更多关于天梯战轻装版的信息。"

msgid "comp7Light7Status"
msgstr "模式详情"

msgid "comp7Light9"
msgstr "拥有多辆角色不同的VIII级战车，您就能在任意战斗中挑选最适合的战车并根据队友的选择进行调整。"

msgid "comp7Light9Status"
msgstr "扩展车库"

msgid "comp7Ranked0"
msgstr "为评级点数而战，达到最高段位并证明自己的实力。"

msgid "comp7Ranked0Status"
msgstr "排位系统"

msgid "comp7Ranked1"
msgstr "您在战斗中获得的威望点数越多，胜利时获得的评级点数越多，失败时损失的点数越少。"

msgid "comp7Ranked1Status"
msgstr "威望点数和评级点数"

msgid "comp7Ranked2"
msgstr "在天梯战中，战斗会匹配段位相近的玩家。"

msgid "comp7Ranked20"
msgstr "在战斗结束前离开会让您的队友陷入劣势。这么做会导致您被暂时封禁和损失评级点数。"

msgid "comp7Ranked20Status"
msgstr "逃离"

msgid "comp7Ranked26"
msgstr "排行榜仅显示勇士和传奇段位的玩家。所有登上排行榜的玩家将获得每日奖励。"

msgid "comp7Ranked26Status"
msgstr "排行榜"

msgid "comp7Ranked27"
msgstr "逃离会导致暂时禁止加入游戏模式。继续违规将导致封禁时间延长。"

msgid "comp7Ranked27Status"
msgstr "临时封禁"

msgid "comp7Ranked28"
msgstr "在游戏模式中参加战斗以解锁天梯战渐变风格的新元素。"

msgid "comp7Ranked28Status"
msgstr "渐变风格"

msgid "comp7Ranked2Status"
msgstr "棋逢对手"

msgid "comp7Ranked3"
msgstr "传奇段位中的玩家都是登峰造极的高手。想要达到此段位，您需要成为评级点数排行榜上的前10%。"

msgid "comp7Ranked36"
msgstr "请注意：如果您在战斗结束前离开，您损失的评级点数将超过惨败时损失的评级点数。"

msgid "comp7Ranked36Status"
msgstr "逃离"

msgid "comp7Ranked3Status"
msgstr "传奇"

msgid "comp7Ranked4"
msgstr "如果长期不参加此模式的战斗，您会损失评级点数。此规则适用于白银、黄金、勇士和传奇段位。"

msgid "comp7Ranked4Status"
msgstr "评级不活跃"

msgid "comp7Ranked7"
msgstr "您可以点击活动界面中的“关于活动”按钮了解更多关于天梯战的信息。"

msgid "comp7Ranked7Status"
msgstr "模式详情"

msgid "comp7Ranked9"
msgstr "拥有多辆角色不同的X级战车，您就能在任意战斗中挑选最适合的战车并根据队友的选择进行调整。"

msgid "comp7Ranked9Status"
msgstr "扩展车库"

msgid "devMaps0"
msgstr "随机事件的位置会在地图上\n用烟雾标出，小地图上也会出现相关标记。\n具随机事件的地图可以在游戏设置中关闭。"

msgid "devMaps0Status"
msgstr "带有随机事件的地图"

msgid "devMaps1"
msgstr "您的战车可能在发生随机事件的区域遭摧毁（如飞机坠毁的区域）。\n带有随机事件的地图可以在游戏设置中关闭。"

msgid "devMaps1Status"
msgstr "带有随机事件的地图"

msgid "dualGunVehicles"
msgstr "双管火炮系统的战车"

msgid "epicModeHiddenFeatures"
msgstr "掌握前线战"

msgid "epicModeIntroduction"
msgstr "模式特点"

msgid "epicModeUseful"
msgstr "了解前线战"

msgid "epicRandom0"
msgstr "您可能会在此战斗类型中遇到一些性能上的问题"

msgid "epicTip1"
msgstr "当基地被占领后，防守团队所有在区域中的战车将成为轰炸目标。"

msgid "epicTip10"
msgstr "除了名气和荣誉，军衔还能在每场战斗后带给你有用的加成。"

msgid "epicTip11"
msgstr "前线战模式包含很多获得经验和银币的新方式。"

msgid "epicTip12"
msgstr "不断向其他团队后方推进，前线战也会随之移动。这能让您的重生点更加接近目标。"

msgid "epicTip13"
msgstr "战车位于占领圈时承受伤害，这辆战车的占领进度将在一段时间内被干扰。"

msgid "epicTip14"
msgstr "在特殊界面中激活并扩充战斗储备。利用储备在战场上造成破坏。"

msgid "epicTip15"
msgstr "如战术需要，您可以随时在重生界面更换战线。"

msgid "epicTip16"
msgstr "不要进入受保护的区域。敌方火炮会攻击你。"

msgid "epicTip17"
msgstr "您被卡在地图某处了吗？使用放弃功能（按住J）来离开你的战车并开始刷新。"

msgid "epicTip18"
msgstr "打开大地图（默认为M键），更清晰的查看战场概况。"

msgid "epicTip19"
msgstr "您只能收到小地图可见区域的盟友的通讯消息。"

msgid "epicTip2"
msgstr "如果您想赚点外快，前线战提供了大量奖励。"

msgid "epicTip20"
msgstr "将鼠标移动到小地图上时滑动滚轮可以调整小地图的可视范围。"

msgid "epicTip21"
msgstr "您可以点击小地图向队友标记基地或目标。"

msgid "epicTip22"
msgstr "当您的坦克耗尽，试试自由观看模式。这样可以在等待返回战场的期间做好战术规划。"

msgid "epicTip23"
msgstr "当占领基地且战斗时间结束时，比赛将进入加时。战斗将持续到所有基地被清除。"

msgid "epicTip3"
msgstr "前线战模式的战场面积为9平方公里，大小是标准地图的9倍。"

msgid "epicTip4"
msgstr "每次占领区域都会增加战斗时间。最后区域奖励额外时间。"

msgid "epicTip5"
msgstr "如果您的战车在战斗中被击毁，则需要一段时间进行修理。选择另一辆战车重新加入战斗。"

msgid "epicTip6"
msgstr "每5分钟您会有一辆新战车抵达。"

msgid "epicTip7"
msgstr "在同一条前线上，进攻方必须先占领第一战线的区域，才能进入第二战线的区域。"

msgid "epicTip8"
msgstr "当第一战线的所有区域被占领后，第二战线的所有区域都会被削弱。"

msgid "epicTip9"
msgstr "可以通过消灭对方团队获胜。只是这几乎不可能实现。"

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "请遵守规则"

msgid "howToPlay"
msgstr "如何玩"

msgid "mapbox0"
msgstr "位于局部天气区域内外的战车无法互相侦察，也无法跨区传输敌人位置。火灾会对战车造成伤害。"

msgid "mapbox0Status"
msgstr "局部天气"

msgid "payAttention"
msgstr "请注意"

msgid "ranked1"
msgstr "当您的表现符合战车的角色定位时将会获得更多的经验！在车库中查看模式介绍页面可以了解战车角色的描述和战斗中对应的行为。"

msgid "ranked10"
msgstr "随着您排位战进度的推进，您将能够使用点券购买独特战车和自定义元素（包括带有折扣的道具）。想要查看这些道具的列表，请点击横幅。\n非赛季期您将无法购买道具或使用折扣。"

msgid "ranked11"
msgstr "每日红利战斗仅在联盟中时开放。根据资格赛的结果和完成的特殊任务决定获得的场次。每日红利战斗无法保留至次日。"

msgid "ranked12"
msgstr "在年底时，表现最好的玩家将进入排行榜。他们将获得额外徽章并赢得社区的尊敬和荣誉。"

msgid "ranked13"
msgstr "部分军衔是永久的，一旦获得不会再失去。阶段中的永久军衔会有附加的标识。每个梯队的起始军衔为永久军衔且不会失去。"

msgid "ranked2"
msgstr "每达到下一个梯队和联盟您将获得标准和每日红利战斗。红利战斗会自动将获得的臂章加倍且战斗失败时不会消耗次数。每辆X级战车每天只能使用一次红利战斗。"

msgid "ranked3"
msgstr "注意跟踪黄金时段：一旦时段结束，排位战将在第二天前关闭，您将收到对应的通知。"

msgid "ranked4"
msgstr "一些军衔有所谓的盾牌。在这些军衔输掉战斗时，不会失去军衔，而是会削弱盾牌。如果军衔盾牌没有被完全耗尽，获得带盾军衔的臂章会完全恢复盾牌。"

msgid "ranked5"
msgstr "永不放弃！不仅获胜团队的前7名玩家能获得臂章，战败团队的第一名也将获得臂章。记住，在红利战斗中获得的臂章数被加倍。"

msgid "ranked6"
msgstr "完成全部的梯队之后，玩家会进入三个联盟之一：黄金联盟、白银联盟或青铜联盟。玩家继续作战，战斗结果会影响他们的表现并确定在排行榜上的名次。"

msgid "ranked7"
msgstr "玩家每完成一个梯队就会获得一个军衔代币。在全部三个赛季中表现最好的玩家们会获得他们应得的最终大奖。"

msgid "ranked8"
msgstr "赛季结束时，最优秀的玩家会获得战车的一个独特徽章和风格。这些奖励记录了这些玩家的荣耀，标志着他们超凡的技术。"

msgid "ranked9"
msgstr "您会根据在排位战中的表现获得点券。点券可以用于兑换指令和改进型装备。此外，还有其他不错的奖励：银币、消耗品等等。"

msgid "rankedStatus1"
msgstr "遵守战车角色定位获得经验"

msgid "rankedStatus10"
msgstr "排位战道具"

msgid "rankedStatus11"
msgstr "每日红利战斗"

msgid "rankedStatus12"
msgstr "年度顶级玩家"

msgid "rankedStatus13"
msgstr "模式规则"

msgid "rankedStatus2"
msgstr "红利战斗"

msgid "rankedStatus3"
msgstr "黄金时段"

msgid "rankedStatus4"
msgstr "模式规则"

msgid "rankedStatus5"
msgstr "模式规则"

msgid "rankedStatus6"
msgstr "联盟中的战斗"

msgid "rankedStatus7"
msgstr "年度奖励"

msgid "rankedStatus8"
msgstr "赛季结束奖励"

msgid "rankedStatus9"
msgstr "军衔奖励"

msgid "security"
msgstr "安全第一"

msgid "technicalAdvice"
msgstr "技术建议"

msgid "tip0"
msgstr "沼泽地形会大幅降低战车的行驶速度和转向能力。"

msgid "tip100"
msgstr "乘员熟练度会影响对应的战车属性。"

msgid "tip101"
msgstr "第六感专长让车长能够确定自己的战车是否已被敌人侦察到。"

msgid "tip102"
msgstr "特长整体熟练度参数决定了乘员所有已训练特长的效率。"

msgid "tip103"
msgstr "您可以在重新训练时更改乘员的专精。"

msgid "tip106"
msgstr "装备可以提高乘员和战车的属性。"

msgid "tip107"
msgstr "完成所有模块和后续战车研发的战车可获得精英称号。"

msgid "tip108"
msgstr "精英战车获得的战斗经验，包含高级战车，可以转换为全局经验。"

msgid "tip11"
msgstr "利用灌木从和树叶，可以使您的坦克歼击车很难被发现。战车静止时隐蔽性更强。"

msgid "tip111"
msgstr "有时占领基地比摧毁敌方所有战车更有效，更安全。"

msgid "tip114"
msgstr "与他人共享账号违反游戏规则，账号可能被封停。"

msgid "tip115"
msgstr "游戏规则明确禁止共享账号，违反者可能会永远失去账号。"

msgid "tip116"
msgstr "密码越复杂越好。"

msgid "tip117"
msgstr "请定期更改您的密码。"

msgid "tip118"
msgstr "游戏规则禁止买卖账号，如果您违反规则，将失去您的账号。"

msgid "tip119"
msgstr "不要点击进入不熟悉的网址，因为那有可能是欺骗或黑客行为。"

msgid "tip120"
msgstr "《坦克世界》官方网站是购买金币的唯一途径。使用其他的网站购买金币会有极大的风险遭受金钱损失。"

msgid "tip121"
msgstr "选择保存密码虽然方便，但是不安全。"

msgid "tip122"
msgstr "在门户网站您可以找到关于如何确保账户安全的说明，请仔细阅读。"

msgid "tip123"
msgstr "在战斗中，按住Ctrl键可显示鼠标。"

msgid "tip124"
msgstr "使用修理箱来修复损坏的模块，急救包可以治疗受伤的乘员。"

msgid "tip125"
msgstr "用热键来切换弹药类型和消耗品（默认1-6）。"

msgid "tip126"
msgstr "右键点击小地图可以快速移动火炮模式的镜头。"

msgid "tip127"
msgstr "按Ctrl+Tab可以切换团队名单的外观。"

msgid "tip128"
msgstr "在面板中右键单击玩家姓名，可以查看操作菜单。"

msgid "tip129"
msgstr "想要投诉一名玩家，右键单击对应的玩家名，点击相应选项。"

msgid "tip130"
msgstr "根据您的选择目标：地形特征、队友、敌人或物体会出现不同语句组合的命令菜单。"

msgid "tip131"
msgstr "按住T或Z键移动鼠标至命令菜单来选择要发送的命令。"

msgid "tip132"
msgstr "使用快捷键F2–F8选择命令菜单中的命令。"

msgid "tip134"
msgstr "粗鲁并不是说服盟友的正确方式，而且游戏规则也不允许这样。"

msgid "tip135"
msgstr "盟友最愿意支持有礼貌的玩家。"

msgid "tip136"
msgstr "打仗应该在战场上而不是口角中。"

msgid "tip137"
msgstr "不要在聊天中发送没有意义的消息，这样会分散玩家在战斗中的注意力。"

msgid "tip138"
