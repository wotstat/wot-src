msgid "Chassis_R97_Object_140_hound_TLXXL"
msgstr "Object 140 Resistor"

msgid "R113M_WT"
msgstr "R-113 Resistor"

msgid "R97_Object_140_hound_TLXXL"
msgstr "Resistor"

msgid "R97_Object_140_hound_TLXXL_descr"
msgstr "Resistor的每一发炮弹，都灌满了高能等离子体。这样的火炮在手，von Krieger最新的怪物肯定撑不过一个下午。这玩意火力全开，凶悍无比——正合我意。至于他的Blitztrager？块头大，可不代表更厉害。我们命中的每一发炮弹，都在否定他亲手打造的一切。不过，说句实话，我不确定驾驶它的还是不是原来的那个人了。最近他说话的样子，总让我觉得，有别的东西正在替他说话。不过这都无所谓，不管谁在操控，都得尝尝这等离子体的威力。"

msgid "R97_Object_140_hound_TLXXL_short"
msgstr "Resistor"

msgid "R97_Object_140_hound_TLXXL_short_special"
msgstr "主战坦克的重要改装"

msgid "TD-12_WT"
msgstr "TD-12 Resistor"

msgid "Turret_1_R97_Object_140_hound_TLXXL"
msgstr "Object 140 Resistor"

msgid "_100mm_D54_TS_WT"
msgstr "100 mm U-8TS Resistor"

msgid "_100mm_UBR-412PB_WT"
msgstr "Silver Bullet"

msgid "_100mm_UBR-412PB_WT_descr"
msgstr "同盟军械士的骄傲"

msgid "_100mm_UBR-412PB_WT_long_special"
msgstr "每台超载的发电机都会释放等离子体，为默认炮弹(Silver Bullet)充能。充能越多，等离子体附加的伤害就越高。在Blitztrager失去保护罩时射击它以造成最大伤害。"

msgid "_100mm_UBR-412PB_WT_short_special"
msgstr "可使用等离子体造成额外伤害"
