msgid "medalBrunoPietro_heroInfo"
msgstr "彼得罗布鲁诺是意大利的坦克王牌。在面对敌人具备非凡勇气，被授予意大利的最高军事奖项勇金奖(Medaglia d'oro al Valore Militare）。"

msgid "medalBurda"
msgstr "布尔德勋章"

msgid "medalBurda_condition"
msgstr "• 驾驶坦克或坦克歼击车。\n• 摧毁的战车必须至少比玩家高出1级。\n• 仅随机战模式下可获取。"

msgid "medalBurda_descr"
msgstr "在一场战斗中摧毁2辆敌方自行火炮。"

msgid "medalBurda_heroInfo"
msgstr "亚历山大·布尔德：近卫军上校，苏联坦克王牌。1941年10月4日，在维亚济马布良斯克战役的一次伏击战中，击毁一个德军装甲车队，其中包括十辆轻型坦克、中型坦克，两门牵引反坦克炮，五辆步兵卡车。"

msgid "medalCarius"
msgstr "卡洛斯勋章 %(rank)s"

msgid "medalCarius_descr"
msgstr "根据摧毁敌方战车数量。"

msgid "medalCarius_heroInfo"
msgstr "奥托·卡洛斯(Otto Carius）：二战中最著名的坦克王牌，在其光辉的军旅生涯中，先后驾驶过Pz.Kpfw. 38(t),Pz.Kpfw. VI Tiger和Jagdtiger坦克歼击车。"

msgid "medalCoolBlood"
msgstr "冷血"

msgid "medalCoolBlood_condition"
msgstr "• 使用5级以上的自行火炮。\n• 不能击毁队友战车。\n• 仅随机战中可获得。"

msgid "medalCoolBlood_descr"
msgstr "在100米距离内，击毁至少2辆敌方轻型坦克。"

msgid "medalCrucialContribution"
msgstr "英雄连"

msgid "medalCrucialContribution_condition"
msgstr "• 所有小队成员均获得此荣誉。\n• 仅在随机战模式下可获得。"

msgid "medalCrucialContribution_descr"
msgstr "小队击毁至少12辆敌方坦克。"

msgid "medalDeLanglade"
msgstr "拉格兰勋章"

msgid "medalDeLanglade_condition"
msgstr "• 击毁目标必须位于占领圈内。\n• 依次或同时进入占领状态的目标均统计在内。\n• 仅随机战模式可用。"

msgid "medalDeLanglade_descr"
msgstr "一场战斗中，击毁四辆试图占领己方基地的敌方战车。"

msgid "medalDeLanglade_heroInfo"
msgstr "保罗·吉拉特·朗格拉德(Paul Girot de Langlade）：二战期法国陆军中校，1943年9月晋升为上校并在leclerc将军麾下征战。1944年9月12-13日，袭击了德军第112装甲团占领的法国栋派尔村，异常惨烈的战斗后，45辆黑豹坦克仅4辆幸存。"

msgid "medalDumitru"
msgstr "杜米特鲁勋章"

msgid "medalDumitru_condition"
msgstr "• 驾驶坦克或坦克歼击车。\n• 仅随机战模式下可获取。\n• 2.3版本之前颁发。"

msgid "medalDumitru_descr"
msgstr "在一场战斗中，击毁3辆敌方自行火炮。"

msgid "medalDumitru_heroInfo"
msgstr "扬.杜米特鲁，罗马尼亚坦克王牌，仅参加第二次世界大战25天，其中5天在德方阵营，罗马尼亚转换阵营以后加入了反法西斯阵营。1945年3月26日杜米特鲁摧毁了6辆坦克歼击车并缴获一门150毫米榴弹炮。"

msgid "medalEkins"
msgstr "埃金斯勋章 %(rank)s"

msgid "medalEkins_descr"
msgstr "摧毁VIII–XI级敌方战车。"

msgid "medalEkins_heroInfo"
msgstr "乔·阿肯斯（Joy Ekins）英国国土自卫队北安普敦师的坦克炮手，一些资料认为正是阿肯斯击毙了著名德国坦克王牌米歇尔·魏特曼。"

msgid "medalFadin"
msgstr "法丁勋章"

msgid "medalFadin_condition"
msgstr "• 使敌方战车起火并最终焚毁的攻击也统计在内。\n• 对于装备自动装填式火炮的战车，仅统计装填机中的最后一发炮弹。\n• 仅随机战模式可用。"

msgid "medalFadin_descr"
msgstr "用最后一发炮弹击毁最后一辆敌方战车。"

msgid "medalFadin_heroInfo"
msgstr "亚历山大·法丁(Alexander Fadin）：苏联英雄，T-34坦克车长。在一个步兵排的支援下，法丁仅用一辆坦克，成功占领并控制达术科卡村五个小时，击毁1辆坦克，1辆自行火炮，18个机枪据点及50多名敌军军官及士兵。他的车组乘员还用同轴机枪击落了一架敌军战机。"

msgid "medalGore"
msgstr "格尔勋章"

msgid "medalGore_condition"
msgstr "• 造成的伤害在2000点以上。\n• 不能击毁队友战车。\n• 仅随机战模式中可获取。"

msgid "medalGore_descr"
msgstr "使用自行火炮造成超过自身血量8倍的伤害。"

msgid "medalGore_heroInfo"
msgstr "英国上校阿德里安·克莱门茨高尔。1943年2月负责守卫在突尼斯卡塞林路口，他用一个坦克中队，一个步兵连和步兵支援火炮连的力量，成功抵御住德军非洲军团-五个步兵营和一个坦克营的部队，并让德军在战斗中损失了11辆坦克。"

msgid "medalHalonen"
msgstr "哈罗恩勋章"

msgid "medalHalonen_condition"
msgstr "• 目标战车必须至少比玩家的坦克歼击车高2级。\n• 仅随机战可用。"

msgid "medalHalonen_descr"
msgstr "在一场战斗中，用坦克歼击车击毁2辆或以上的敌方战车。"

msgid "medalHalonen_heroInfo"
msgstr "埃尔基·哈罗恩(Erkki Halonen）：芬兰陆军中士，坦克王牌，在1944年6月至7月间，指挥三号突击炮(StuG III)摧毁3辆T-34，2辆KV-1坦克，2辆ISU-152自行反坦克炮。"

msgid "medalKay"
msgstr "凯斯勋章 %(rank)s"

msgid "medalKay_descr"
msgstr "依据玩家获得战斗英雄称号的次数。"

msgid "medalKay_heroInfo"
msgstr "道格拉斯·凯(Douglas Kay），英国陆军中士，“萤火虫”坦克炮手，参加了著名的诺曼底登陆，因普及坦克战史而闻名。"

msgid "medalKnispel"
msgstr "科尼斯佩尔勋章 %(rank)s"

msgid "medalKnispel_descr"
msgstr "依据玩家造成以及受到的伤害总数值。"

msgid "medalKnispel_heroInfo"
msgstr "库尔特·科尼斯佩尔(Kurt Knispel），德国二战坦克王牌，在东线和西线均有过作战记录，驾驶过Pz.Kpfw. II, Pz.Kpfw. III, Pz.Kpfw. IV, Pz.Kpfw. VI Tiger,和Pz.Kpfw. VI Ausf. B Tiger II作战。"

msgid "medalKolobanov"
msgstr "卡罗诺夫勋章"

msgid "medalKolobanov_condition"
msgstr "• 仅随机战模式下可获取。"

msgid "medalKolobanov_descr"
msgstr "独自对抗5辆以上敌方战车并最终获胜。"

msgid "medalKolobanov_heroInfo"
msgstr "齐诺维奇·克洛班诺夫(Zinoviy Kolobanov）：苏联坦克王牌，在1941年8月19日的战斗中，他驾驶一辆KV-1击毁德军共：22辆坦克，2门火炮，2辆半履带装甲车。"

msgid "medalKursk"
msgstr "库尔斯克战役英雄"

msgid "medalKursk_condition"
msgstr "• 奖励给在活动期间达成了全部相应条件的所有玩家。"

msgid "medalKursk_descr"
msgstr "在库尔斯克战役活动期间完成5个任务。"

msgid "medalLafayettePool"
msgstr "普尔勋章"

msgid "medalLafayettePool_condition"
msgstr "• 目标均为5级以上战车。\n• 仅随机战模式可用。"

msgid "medalLafayettePool_descr"
msgstr "击毁敌方战车:"

msgid "medalLafayettePool_ext_descr"
msgstr "    %(condition)s — 决战。"

msgid "medalLafayettePool_heroInfo"
msgstr "拉斐叶特 G 普尔是著名的美国坦克王牌，曾击毁258辆各种武装战车。"

msgid "medalLafayettePool_standard_descr"
msgstr "    %(condition)s — 标准战,攻防战,遭遇战。"

msgid "medalLavrinenko"
msgstr "拉维尼克勋章 %(rank)s"

msgid "medalLavrinenko_condition"
msgstr "• 每场统计计入最高到100点分数。"

msgid "medalLavrinenko_descr"
msgstr "阻止我方基本被占领总分数。"

msgid "medalLavrinenko_heroInfo"
msgstr "德米特里·拉夫里年科(Dmitry Lavrinenko）苏联英雄，近卫军中尉，坦克王牌。在短短两个月的时间里的28场战斗中击毁52辆坦克而被誉为最出色的苏联坦克手。"

msgid "medalLeClerc"
msgstr "雷克斯克勋章 %(rank)s"

msgid "medalLeClerc_condition"
msgstr "• 玩家团队必须获胜。\n• 一场战斗中获得的所有基地占领点数均统计在内。"

msgid "medalLeClerc_descr"
msgstr "玩家占领敌方基地过程中的总得分。"

msgid "medalLeClerc_heroInfo"
msgstr "菲利普·勒克莱尔(Philippe Leclerc）：二战中，反抗纳粹德国的自由法国将军，是巴黎解放运动的领导人之一。"

msgid "medalLehvaslaiho"
msgstr "雷哈瓦西莱洛勋章"

msgid "medalLehvaslaiho_condition"
msgstr "• 目标战车必须比玩家高1级以上。\n• 仅随机战模式可用。"

msgid "medalLehvaslaiho_descr"
msgstr "在一场战斗中，使用中型坦克至少击毁2辆敌方坦克或坦克歼击车。"

msgid "medalLehvaslaiho_heroInfo"
msgstr "雷哈瓦希莱洛，芬兰坦克王牌，战斗中击毁了7辆坦克和坦克歼击车。"

msgid "medalMonolith"
msgstr "坚如磐石"

msgid "medalMonolith_condition"
msgstr "• 自行火炮的速度必须低于10公里/小时。\n• 撞击你的敌方战车时速高于你的自行火炮。\n• 不能击毁队友战车。\n• 仅随机战模式中可获取。"

msgid "medalMonolith_descr"
msgstr "驾驶自行火炮时，撞击摧毁敌方战车并存活。"

msgid "medalNikolas"
msgstr "尼克斯勋章"

msgid "medalNikolas_condition"
msgstr "• 目标战车必须比玩家高1级以上。\n• 仅随机战模式可用。"

msgid "medalNikolas_descr"
msgstr "在一场战斗中，使用中型坦克至少击毁4辆敌方坦克或坦克歼击车。"

msgid "medalNikolas_heroInfo"
msgstr "阿尔弗雷德·尼克斯是一名英国坦克炮手。在阿拉曼战役中击毁了十四辆敌方战车。"

msgid "medalOrlik"
msgstr "奥利克勋章"

msgid "medalOrlik_condition"
msgstr "• 目标战车必须比玩家高1级以上。\n• 仅随机战模式可用。"

msgid "medalOrlik_descr"
msgstr "在一场战斗中,使用轻型坦克击毁2辆或2辆以上的敌方坦克或坦克歼击车。"

msgid "medalOrlik_heroInfo"
msgstr "罗马·埃德蒙·奥利克(Roman Edmund Orlik）：波兰陆军中士，1939年9月他驾驶已经落后的TKS轻型坦克，击毁了13辆德军坦克。"

msgid "medalOskin"
msgstr "奥斯丁勋章"

msgid "medalOskin_condition"
msgstr "• 目标战车必须比玩家高1级以上。\n• 仅随机战模式可用。"

msgid "medalOskin_descr"
msgstr "在一场战斗中，使用中型坦克击毁3辆敌方坦克或坦克歼击车。"

msgid "medalOskin_heroInfo"
msgstr "亚历山大·奥斯丁(Alexander Oskin）：苏联英雄，1944年8月11日，在奥格伦多夫附近执行侦察任务时，指挥自己的T-34中型坦克连续击毁三辆“虎王”重型坦克。"

msgid "medalPascucci"
msgstr "帕斯库奇勋章"

msgid "medalPascucci_condition"
msgstr "• 驾驶坦克或坦克歼击车。\n• 仅随机战模式下可获取。"

msgid "medalPascucci_descr"
msgstr "一次战斗中击毁2辆敌方自行火炮。"

msgid "medalPascucci_heroInfo"
msgstr "帕斯库奇少尉是二战时期一名意大利坦克指挥官。参加公羊坦克师在北非作战。在阿拉曼战役中一次鲁莽的作战中，他牺牲了自己，帮助剩余的战友逃出了敌人包围。"

msgid "medalPoppel"
msgstr "波佩勋章 %(rank)s"

msgid "medalPoppel_descr"
msgstr "依据玩家在所有战斗中侦察到敌方坦克和自行火炮的总数量。"

msgid "medalPoppel_heroInfo"
msgstr "尼古拉·波佩，坦克部队中将,苏军指挥官,政治军官。在1941年夏，在迪布诺(乌克兰）精心策划了一次用缴获的坦克向敌人后方发动奇袭的行动。"

msgid "medalRadleyWalters"
msgstr "拉德利-沃尔特斯勋章"

msgid "medalRadleyWalters_condition"
msgstr "• 目标均为5级以上战车。\n• 仅随机战模式可用。"

msgid "medalRadleyWalters_descr"
msgstr "击毁敌方战车:"

msgid "medalRadleyWalters_ext_descr"
