msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "这辆Pojistka简直就是一座履带上的移动维修工坊。棱角分明、线路整齐，每个系统都响应及时。我们上战场是为了阻止一名疯狂科学家，结果却对上了他称为“电子智能”的东西。他的哨兵仍在学习，观察我们的一举一动。他打造这些哨兵是为了取代我们。好，今天就让我帮它们上一课。我找到一处山脊，锁定一个目标，然后用这些龇牙咧嘴的炮弹替我完成剩下的工作。如果他真相信他那能思考的机器能比我们撑得久，那就让我们见识它在压力下能如何接招。"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "主战坦克的重要改装"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silver Bullet"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "同盟军械士的骄傲"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "每台超载的发电机都会释放等离子体，为默认炮弹(Silver Bullet)充能。充能越多，等离子体附加的伤害就越高。在Blitztrager失去保护罩时射击它以造成最大伤害。"

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "可使用等离子体造成额外伤害"
