msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "由亨舍尔( Henschel ）公司于1937研制。 1942年开始大批量生产，共制造1354辆。第一次亮相是在进攻列宁格勒的战役中，从突尼斯到库尔斯克战场的最前沿。Tiger I频繁参加各战事直至一战结束。1944年夏天停止生产。"

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

