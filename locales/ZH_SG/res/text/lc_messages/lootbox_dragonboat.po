msgid "common/boxCategory/upperCase/dragonboat"
msgstr "端午补给箱"

msgid "entryPoint/tooltip/description"
msgstr "这些是包含独特和珍贵游戏内物品的特殊补给箱。\n您可以在游戏内商店或高级商店中购买这些补给箱。"

msgid "entryPoint/tooltip/warningTitle"
msgstr "端午补给箱暂时不可用"

msgid "eventName/lowerCase"
msgstr "驭龙乘风"

msgid "eventName/upperCase"
msgstr "驭龙乘风"

msgid "infoPage/footer/description/compensation"
msgstr "如果您车库中已拥有端午补给箱掉落列表中的所有战车，补给箱后续掉落的所有战车将全额补偿与之等值的金币。"

msgid "infoPage/footer/description/guaranteed"
msgstr "每%(guaranteed0)s个端午补给箱必定包含一辆VIII–IX级战车。如果您开启了指定数量的补给箱但仍未获得此类战车，您开启的第%(guaranteed0)s个端午补给箱必定掉落一辆您未在车库中拥有的VIII–IX级战车。掉落后计数器重置。"

msgid "noBoxesView/description/"
msgstr "您没有补给箱。\n您可以在游戏内商店中购买补给箱。"
