msgid "T51D1"
msgstr "T51D1"

msgid "T57"
msgstr "T57"

msgid "T57_descr"
msgstr "在M3A3的基础上设计的试验型自行火炮，并通过了1942年秋的测试，但最后并没有量产。"

msgid "T67"
msgstr "T67"

msgid "T67_descr"
msgstr "项目研发始于1942年春季。经过多次试验于1942年秋季得出结论，采用75毫米火炮替代57毫米火炮。曾生产出两辆原型车，但从未投入量产和参加部队服役。"

msgid "T71"
msgstr "T71 DA"

msgid "T71_descr"
msgstr "配备摇摆式炮塔的实验型空降轻型坦克。由底特律阿森纳公司于1952至1953年研发，用于取代M41。因战车武器被视为无效而终止研发。仅制造出一台木质原型车。"

msgid "T7_Combat_Car"
msgstr "T7 Combat Car"

msgid "T7_Combat_Car_descr"
msgstr "由美国骑兵部队研发的一种配备机关枪的轻型半履带战车。首次原型车试验开始于1937年并持续到1939年，后来由于当局更青睐履带式战车被T7项目所取代而项目终止。"

msgid "T7_Combat_Car_short"
msgstr "T7 Car"

