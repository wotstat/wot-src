msgid "T34_hvy"
msgstr "T34"

msgid "T34_hvy_BF"
msgstr "T34 B"

msgid "T34_hvy_BF_descr"
msgstr "1945年研发的T30改进型重型坦克，安装了120毫米T53火炮和新式Continental AV-1790发动机。战后军队对重型坦克的研发兴趣降温，因此T-34从未参加部队服役。制造出的原型车被用于战场训练。"

msgid "T34_hvy_BF_long_special"
msgstr "这是一辆拥有坚固装甲炮塔的重型坦克，能够击倒几乎任何挡在面前的敌人。这辆战车在近距离作战会发挥最强效果，前提是你要为装甲薄弱的车体找到掩护。"

msgid "T34_hvy_BF_short_special"
msgstr "优秀的单发伤害，良好的炮塔装甲"

msgid "T34_hvy_FL"
msgstr "T34 FL"

msgid "T34_hvy_FL_short"
msgstr "T34 FL"

msgid "T34_hvy_descr"
msgstr "1945年研发的T30改进型重型坦克，安装了120毫米T53火炮和新式Continental AV-1790发动机。战后军队对重型坦克的研发兴趣降温，因此T-34从未参加部队服役。制造出的原型车被用于战场训练。"

msgid "T34_hvy_long_special"
msgstr "这是一辆拥有坚固装甲炮塔的重型坦克，能够击倒几乎任何挡路的敌人。这辆战车在近距离作战会发挥最强力的效果，前提是你要为装甲薄弱的车体找到掩护。"

msgid "T34_hvy_short_special"
msgstr "高单发伤害，炮塔装甲坚固"

msgid "T40"
