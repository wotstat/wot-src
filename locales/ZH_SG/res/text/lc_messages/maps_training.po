msgid "17_munchen/team1/heavyTank/descr"
msgstr "<a_ht_bridge>桥梁</a_ht_bridge>是此战术的关键点。%(p)向西移动，您应该在战斗开场抢占<a_ht_southernEmbrasure>南部缺口</a_ht_southernEmbrasure>的位置。此位置可以让您高效率地射击<a_ht_bridge>桥梁</a_ht_bridge>后方的敌人。之后，您可以登上铁路路堤。清除视野范围内所有敌人后，您可以移动至<a_ht_monument>纪念碑</a_ht_monument>侧翼包抄位于<a_ht_lake>湖泊</a_ht_lake>附近的敌方战车。"

msgid "17_munchen/team1/heavyTank/title"
msgstr "桥梁攻击"

msgid "17_munchen/team1/mediumTank/descr"
msgstr "<a_mt_crossing>通道</a_mt_crossing>是此战术的关键点。%(p)向东移动，利用<a_mt_depot>仓库</a_mt_depot>作为掩体。此方向的关键射击位置正是<a_mt_crossing>通道</a_mt_crossing>。成功夺取此位置后，您可以在火车的掩护下移动至敌方防线后方并击毁<a_mt_lake>湖泊</a_mt_lake>附近的敌人。之后，您应该击毁<a_mt_ruinedStreet>废弃街道</a_mt_ruinedStreet>上的敌人，随后清除<a_mt_bridge>桥梁</a_mt_bridge>附近剩余的敌方战车。"

msgid "17_munchen/team1/mediumTank/title"
msgstr "路口攻击"

msgid "17_munchen/team2/heavyTank/descr"
msgstr "<b_ht_bridge>桥梁</b_ht_bridge>是此战术的关键点。%(p)移动到东部侧翼，您可以紧靠铁路路堤抢占<b_ht_bridge>桥梁</b_ht_bridge>附近的射击位置。从此位置击毁敌方战车后，您可以从桥下推进并射击视野范围内左右两侧和<b_ht_crashedTrain>火车残骸</b_ht_crashedTrain>方向的敌人。随后您应该绕过<b_ht_streetWithTrums>有电车的街道</b_ht_streetWithTrums>，穿过<b_ht_church>教堂</b_ht_church>在敌方防线后方移动，然后占据有利位置来清除位于<b_ht_ruinedStreet>废弃街道</b_ht_ruinedStreet>的敌人。"

msgid "17_munchen/team2/heavyTank/title"
msgstr "桥梁攻击"

msgid "17_munchen/team2/mediumTank/descr"
msgstr "<b_mt_crossing>通道</b_mt_crossing>是此战术的关键点。%(p)战斗开场后，操控性强的战车应该前往<b_mt_lake>湖泊</b_mt_lake>右侧并占据<b_mt_crashedTrain>火车残骸</b_mt_crashedTrain>附近的位置来侦察路堤后方的敌人，并抢先造成伤害。在此之后，您可以移动至<b_mt_crossing>通道</b_mt_crossing>附近的关键位置。在此方向赢得优势并清除<b_mt_hill>山丘</b_mt_hill>上的位置后，您应该迂回包抄防守南部<b_mt_ruinedStreet>废弃街道</b_mt_ruinedStreet>的敌人。"

