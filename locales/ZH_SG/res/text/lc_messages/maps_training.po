msgid "28_desert/team1/heavyTank/descr"
msgstr "<a_ht_mountains>山区</a_ht_mountains>是此战术的关键点。%(p)绕过<a_ht_easternVillage>东部村庄</a_ht_easternVillage>，您就可以前往<a_ht_mountains>山区</a_ht_mountains>。消灭中距离的敌人后，您应该穿过<a_ht_gorge>峡谷</a_ht_gorge>并在通往<a_ht_thoroughfare>通道</a_ht_thoroughfare>的道路上与敌人近距离交战。成功利用<a_ht_dunes>沙丘</a_ht_dunes>作为掩体后，您应该击毁位于<a_ht_balcony>高台</a_ht_balcony>处防守基地的战车。随后穿过<a_ht_ravine>沟壑</a_ht_ravine>解决西部基地内的敌方战车。"

msgid "28_desert/team1/heavyTank/title"
