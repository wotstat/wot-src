msgstr "Project-Id-Version: World Of Tanks\nReport-Msgid-Bugs-To:\nPOT-Creation-Date: 2010-06-01 10:00+0300\nPO-Revision-Date: 2010-06-01 10:00+0300\nLast-Translator: WoT Translator <noreply@wargaming.net>\nLanguage-Team: WoT Team <noreply@wargaming.net>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=utf-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: \n"

msgid "articleBP/subtitle"
msgstr "战令是一种游戏活动，玩家可以参与其中，完成进度阶段，并获得点数和珍贵奖励。作为完成特定阶段的奖励，玩家将获得特殊货币“战令代币”，可用于在游戏内商店的对应版块中购买独特战车和其他实用物品。"

msgid "articleBP/title"
msgstr "关于战令"

msgid "battleTasksDetails/stPatrick/subtitle"
msgstr "每天有数个可追踪进度的任务供您完成。完成后，您将获得进度点数和银币。"

msgid "battleTasksDetails/subtitle"
msgstr "每天有数个可追踪进度的任务供您完成。完成后，您将获得进度点数、钢铁印记和银币。"

msgid "battleTasksDetails/title"
msgstr "任务"

msgid "battleTypes/battleTypesHeader/29"
msgstr "单人战斗"

msgid "battleTypes/battleTypesHeader/30"
msgstr "小队战斗"

msgid "battleTypes/text/place"
msgstr "第%(place)s名"

msgid "battleTypes/text/places"
msgstr "第%(place)s名"

msgid "eventTime"
msgstr "模式将于%(startDate)s至%(endDate)s期间开放"

msgid "footer"
msgstr "在战斗中获得您应得的奖励！\n狩猎季节现已展开！"

msgid "generalDescription/accent"
msgstr "每辆战车拥有2个普通和2个独特战斗能力，外加重生机制。"

msgid "generalDescription/subtitle"
msgstr "车库中有8辆特殊战车，分为3个类别。它们具有不同的战术用途和特点。您在车库中无法更改它们的配置，但所有特殊战车自带的模块可在战斗中升级。"

msgid "generalDescription/title"
msgstr "猎手"

msgid "infoBlock/moreGreen/subtitle"
msgstr "幸运草将所有黄色物资变成了绿色，但仍然包含您需要的一切：经验、血量恢复、炮弹、能力使用次数，以及最重要的幸运印记。"

msgid "infoBlock/moreGreen/title"
msgstr "漆上好运！"

msgid "infoBlock/sealsLuck/subtitle"
msgstr "获取印记的方式：在钢铁猎手模式中完成进度阶段，以及在模式战斗中收集物资、获得高排名。组队战斗时，获得的所有幸运印记将平均分配。每辆活动战车在完成每日首场战斗时能获得双倍数量的印记。想要获得此加成，玩家需要在战斗中有出色的表现。"

msgid "infoBlock/sealsLuck/title"
msgstr "幸运印记"

msgid "infoBlock/specialAwards/subtitle"
msgstr "在钢铁猎手的战斗中赚取幸运印记，并在幸运草商店中兑换特殊奖励。"

msgid "infoBlock/specialAwards/title"
msgstr "特殊奖励"

msgid "maps/map1/title"
msgstr "阿尔萨吉尔 4.04"

msgid "maps/map2/title"
msgstr "404区域"

msgid "maps/map3/title"
msgstr "费尔努费尔"

msgid "maps/subtitle"
msgstr "狩猎将在三张地图上进行：{{@ colorLegacy 'ede6d9e5'}}阿尔萨吉尔 4.04、404区域和费尔努费尔{{/}}。这些地图比随机战的地图更大。第一张是遍布沙坑和干涸小溪的开阔沙漠地形。第二张则是很容易隐蔽起来与敌人周旋的密集都市地形。第三张为斯堪的纳维亚半岛上白雪皑皑的苔原，起伏的地形上分布着小村庄和结冰的池塘。"

msgid "maps/title"
msgstr "3张地图"

msgid "marauders/footer"
msgstr "摧毁游猎者，以获得丰厚物资。"

msgid "marauders/marauder1"
msgstr "{{@ colorLegacy 'eeede9'}}兔{{/}}——胆小、迅捷"

msgid "marauders/marauder2"
msgstr "{{@ colorLegacy 'eeede9'}}狼{{/}}——富有攻击性、对猎物穷追不舍"

msgid "marauders/marauder3"
msgstr "{{@ colorLegacy 'eeede9'}}熊{{/}}——领地意识强、非常可怕"

msgid "marauders/text"
msgstr "AI控制的战车，它们在钢铁猎手比赛完结后的地图上游荡，从散落的战车残骸上收集物资。在战斗中不构成威胁。已发现以下类型："

msgid "marauders/title"
msgstr "游猎者"

msgid "mosaic/info1/stPatrick/subtitle"
msgstr "大逃杀模式，玩家可在战斗中升级战车。"

msgid "mosaic/info1/stPatrick/title"
msgstr "钢铁猎手"

msgid "mosaic/info1/subtitle"
msgstr "大逃杀模式，玩家可在战斗中升级战车。"

msgid "mosaic/info1/title"
msgstr "钢铁猎手"

msgid "mosaic/info2/stPatrick/subtitle"
msgstr "使用每辆特殊战车完成每日首场战斗时可获双倍数量的印记。想要获得此加成，玩家必须在单人战斗中排名前10，或在小队战斗中排名前7。"

msgid "mosaic/info2/stPatrick/title"
msgstr "双倍幸运印记"

msgid "mosaic/info2/subtitle"
msgstr "所有活动战车可免费使用。钢铁印记可用于兑换自定义元素。"

msgid "mosaic/info2/title"
msgstr "经济系统"

msgid "mosaic/info3/stPatrick/subtitle"
msgstr "一种特殊货币，可在幸运草商店兑换珍贵物品。在钢铁猎手模式中完成进度阶段，并且在模式战斗中收集物资、获得高排名以获取尽可能多的幸运印记。组队战斗时，获得的所有幸运印记将平均分配。"

msgid "mosaic/info3/stPatrick/title"
msgstr "幸运印记"

msgid "mosaic/info3/subtitle"
msgstr "努力取得好战绩并完成任务，以推进进度。"

msgid "mosaic/info3/title"
msgstr "进度"

msgid "mosaic/info4/stPatrick/subtitle"
msgstr "通过完成每日任务和在战斗中获高排名来完成进度阶段，并获得包括幸运印记在内的各种奖励。"

msgid "mosaic/info4/stPatrick/title"
msgstr "进度"

msgid "mosaic/info4/subtitle"
msgstr "重生机制让您可以在战车被摧毁后重返战斗。战车重生后等级不变。"

msgid "mosaic/info4/title"
msgstr "重生"

msgid "mosaic/title"
msgstr "一般信息"

msgid "pointsBPDetailsSettings/subtitle"
msgstr "特殊战令资源，可于各种不同模式中获取，包括钢铁猎手。点数数量取决于您在战斗结果中的排名。钢铁猎手战车没有点数上限。"

msgid "pointsBPDetailsSettings/title"
msgstr "战令点数"

msgid "pointsSHDetailsSettings/stPatrick/subtitle"
msgstr "战斗结果中排名第一的猎手将获得幸运印记加成。猎手也将根据排名获得额外的进度点数。"

msgid "pointsSHDetailsSettings/stPatrick/title"
msgstr "战斗结果排名加成"

msgid "pointsSHDetailsSettings/subtitle"
msgstr "每场战斗后，您将根据自己在战斗结果中的排名获得相应数量的进度点数。"

msgid "pointsSHDetailsSettings/title"
msgstr "点数分配"

msgid "progressionDetails/stPatrick/subtitle"
msgstr "参与幸运草对决并获得珍贵奖励！您需要特殊点数来推进进度，点数可通过完成活动的每日任务和参加钢铁猎手的战斗来获取。"

msgid "progressionDetails/stPatrick/subtitle2"
msgstr "完成主要进度后，您可以继续参与战斗并获取幸运印记。幸运印记可在幸运草商店中兑换特殊奖励。"

msgid "progressionDetails/stPatrick/title2"
msgstr "幸运印记"

msgid "progressionDetails/subtitle"
msgstr "完成猎手之路并获得珍贵奖励！您需要特殊点数来推进进度，点数可通过完成活动的每日任务和参加钢铁猎手的战斗来获取。"

msgid "progressionDetails/subtitle2"
msgstr "完成主要进度后，您可以继续完成任务获取钢铁印记，用以在游戏内商店中兑换自定义元素。"

msgid "progressionDetails/title"
msgstr "进度"

msgid "progressionDetails/title2"
msgstr "钢铁印记"

msgid "radarDetails/text1"
msgstr "无线电侦测能让您在小地图上精确定位敌方战车和空投。按X键手动激活该系统。一段时间后可以再次激活。此外，您在战斗中可以通过研发对应的科技来提升无线电侦测的半径或缩短它的冷却时间。"

msgid "radarDetails/text2"
msgstr "波兰工程师知道，强化战车的某一强项自然会导致另一项参数的下降。所以他们充分考虑了战车的武器和战斗能力，防止敌人发现其弱点。时间将证明这一决策是正确的。"

msgid "radarDetails/title"
msgstr "无线电侦测"

msgid "respawn/block1/subtitle"
msgstr "战车一旦被摧毁将自动重生。此机制在战斗开始后的首{{@ colorLegacy 'eeede9'}}{{soloRespawnPeriod}}分钟{{/}}内有效。"

msgid "respawn/block1/title"
msgstr "单人游戏时"

msgid "respawn/block2/subtitle"
msgstr "想要协助队友重生，需要脱离交战{{@ colorLegacy 'eeede9'}}{{platoonTimeToResurrect}}秒{{/}}。此机制在战斗的首{{@ colorLegacy 'eeede9'}}{{platoonRespawnPeriod}}分钟{{/}}内有效。小队成员共享重生次数。"

msgid "respawn/block2/title"
msgstr "组队游戏时"

msgid "respawn/text"
msgstr "重生机制让您可以在战车被摧毁后重返战斗。战车重生后等级不变。"

msgid "respawn/title"
msgstr "重生"

msgid "sectorDetails/text1"
msgstr "新版视野系统基于锥形视野。如果敌人、物资或空投位于视锥外，则您将无法看到它们。"

msgid "sectorDetails/text2"
msgstr "如果敌方战车过于靠近您，可被自动侦察到。请注意，在战斗中，您可能会遇到受到伤害但却看不见攻击者的情况。您战车的视锥与炮塔“绑定”，因此要确保不时旋转炮塔扫视四周来寻找目标。"

msgid "sectorDetails/title"
msgstr "视锥"

msgid "shopDetails/stPatrick/text1"
msgstr "幸运印记，可用于在商店的特殊版块中兑换特殊钢铁猎手奖励。"

msgid "shopDetails/text1"
msgstr "您可以用钢铁印记在游戏内商店的对应版块中兑换钢铁猎手风格和贴花。"

msgid "shopDetails/text2"
msgstr "{{@ colorLegacy 'ecca9d'}}拥有《坦克世界》高级账号的玩家在战斗中可获得更多钢铁印记。{{/}}"

msgid "shopDetails/title"
msgstr "商店"

msgid "stPatrickFooter"
msgstr "在战斗中获得您应得的奖励。\n狩猎季现在开启！"

msgid "stPatrickSubTitle"
msgstr "幸运草对决"

msgid "tableBPDetailsSettings/subtitle"
msgstr "每场战斗后，您将根据自己在战斗结果中的排名获得相应数量的战令点数。"

msgid "tableBPDetailsSettings/title"
msgstr "点数分配"

msgid "title"
msgstr "钢铁猎手"

msgid "towerBlock/ammunition/stPatrick/subtitle"
msgstr "恢复血量、修复模块并包含您战斗中需要的一切：一次重生次数、炮弹、用来升级战车的经验，同时有一定几率包含修理箱或一个独特战斗能力的一次使用次数。"

msgid "towerBlock/ammunition/stPatrick/title"
msgstr "消耗品"

msgid "towerBlock/ammunition/subtitle"
msgstr "修复模块、恢复血量并包含“血量恢复”的一次使用次数、弹药，以及增强战车所需的经验。这种物资可以帮助您更快地升级战车，并快速做好备战准备。"

msgid "towerBlock/ammunition/title"
msgstr "消耗品"

msgid "towerBlock/cargo/subtitle"
msgstr "拾取空投后，您将获得一次重生次数，以及巨大的对敌优势。这是最珍贵的物资，可以修复模块并恢复战车血量。同时还包含经验、弹药和全部四种能力的使用次数。拾取空投需要花费较长的时间。不仅如此，所有猎手都能在小地图上看到空投的位置，所以您需要全力以赴才能捷足先登。"

msgid "towerBlock/cargo/title"
msgstr "空投"

msgid "towerBlock/euipment/subtitle"
msgstr "包含经验(但数量少于“消耗品”类型物资)和弹药。它还可能包含修理箱或其中一个独特战斗能力的一次使用次数。这种物资让您有机会扭转战局。"

msgid "towerBlock/euipment/title"
msgstr "补给品"

msgid "towerBlock/subtitle"
msgstr "想要升级您的战车，留意有物资的特殊位置，物资包含战车升级所需的经验，以及弹药和战斗能力使用次数。包含的资源数量取决于物资类型。"

msgid "towerBlock/title"
msgstr "物资"

msgid "towerBlock/trophies/subtitle"
msgstr "击毁敌方战车后，您可以拾取它们一半的能力使用次数，还能恢复血量、修复您战车的受损模块，并获得经验和弹药。此外，您还有机会获得四个能力之一的一次使用次数。带有战利品物资的战车残骸会以红色烟雾标记在地图上。收集这种物资所需的时间较短。"

msgid "towerBlock/trophies/title"
msgstr "战利品"

msgid "zones/subtitle"
msgstr "此模式适合不惧正面交锋的玩家，一直躲在角落是行不通的。地图会随时间推移缩圈，可活动范围也会随之缩小，迫使猎手们正面对决。"

msgid "zones/subtitle2"
msgstr "关闭的区域是随机选取的，而频率则取决于战斗中剩余的战车数量。一定要时刻注意并提前离开不安全的区域。"

msgid "zones/title"
msgstr "逐渐缩小的游戏区域"

msgid "zones/zoneRed/subtitle"
msgstr "在摧毁区域中，您的战车会持续损失血量直至完全损毁。想要逃离摧毁区域，必须争分夺秒。"

msgid "zones/zoneRed/title"
msgstr "红色：摧毁区域"

msgid "zones/zoneYellow/subtitle"
msgstr "您的战车在危险区域中不会受到伤害，但这种颜色的区域随时都可能关闭。请做好相应的撤退计划。"

msgid "zones/zoneYellow/title"
msgstr "黄色：危险区域"
