msgid "hwInvisibility/always"
msgstr "?empty?"

msgid "hwInvisibility/descr"
msgstr "战车暂时进入隐形状态、恢复血量、修复模块并灭火。"

msgid "hwInvisibility/long_special"
msgstr "战斗能力。让敌人无法侦察到您的战车，持续时间为10秒。每秒恢复35血量，修复模块，移除所有负面效果，并使战车不会受到腐蚀伤害。射击或受到敌方战车伤害时（开火、撞击或使用战斗能力）将立即暴露您的位置。激活后3秒内不会被敌人射击中断。若在战斗中使用过至少一次，此能力在战斗后就会耗尽，后续可花费银币补充。若未曾使用，则不需要补充。<br/><br/>仅可在<font color='#cbac77'>“巴比伦：黑塔”</font>活动中使用。<br/><br/>所有未使用的能力将被移除并在下个版本补偿等于其价值50%的银币。"

msgid "hwInvisibility/name"
msgstr "隐身治疗"

msgid "hwInvisibility/onUse"
msgstr "让敌人无法侦察到您的战车，持续时间为10秒。每秒恢复35血量，修复模块，移除所有负面效果，并使战车不会受到腐蚀伤害。射击或受到敌方战车伤害时（开火、撞击或使用战斗能力）将立即暴露您的位置。激活后3秒内不会被敌人射击中断。"

msgid "hwInvisibility/restriction"
msgstr "?empty?"

msgid "hwInvisibility/short_special"
msgstr "让敌人无法侦察到您的战车，恢复血量，修理模块，扑灭火灾，移除震晕效果，并治疗乘员。"

