msgid "hwAoeDrainEnemyHpInstantShot/descr"
msgstr "进行一次可偷取目标和其附近敌方战车血量的射击。"

msgid "hwAoeDrainEnemyHpInstantShot/long_special"
msgstr "战斗能力。进行一次可偷取目标和其半径35米内所有敌方战车血量的射击，同时修复受损模块并移除震晕效果。若在战斗中使用过至少一次，此能力在战斗后就会耗尽，后续可花费银币补充。若未曾使用，则不需要补充。<br/><br/>仅可在<font color='#cbac77'>“巴比伦：黑塔”</font>活动中使用。<br/><br/>所有未使用的能力将被移除并在下个版本补偿等于其价值50%的银币。"

msgid "hwAoeDrainEnemyHpInstantShot/name"
msgstr "吸血炮弹"

msgid "hwAoeDrainEnemyHpInstantShot/onUse"
msgstr "进行一次可偷取目标和其半径35米内所有敌方战车血量的射击，同时修复受损模块并移除震晕效果。"

msgid "hwAoeDrainEnemyHpInstantShot/restriction"
