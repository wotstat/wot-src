msgid "_105mm_APCR_OFL_E1_WT"
msgstr "Silver Bullet"

msgid "_105mm_APCR_OFL_E1_WT_descr"
msgstr "同盟军械士的骄傲"

msgid "_105mm_APCR_OFL_E1_WT_long_special"
msgstr "每台超载的发电机都会释放等离子体，为默认炮弹(Silver Bullet)充能。充能越多，等离子体附加的伤害就越高。在Blitztrager失去保护罩时射击它以造成最大伤害。"

msgid "_105mm_APCR_OFL_E1_WT_short_special"
msgstr "可使用等离子体造成额外伤害"

