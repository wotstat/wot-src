msgstr "?empty?"

msgid "autoExtinguishers/short_special"
msgstr "自动灭火"

msgid "berserker/battleDescr"
msgstr "穿透力和射速提高至%(gunPiercing)s倍，同时炮控和稳定性效率提高%(gunAimingTime)s，但效果持续的%(duration)s秒期间会受到等同于您战车总血量%(healthDebuff)s的伤害。\n\n*淌血升能能力造成的伤害不会摧毁您的战车。"

msgid "berserker/descr"
msgstr "穿透力和射速提高至%(gunPiercing)s倍，同时炮控和稳定性效率提高%(gunAimingTime)s，但效果持续的%(duration)s秒期间会受到等同于您战车总血量%(healthDebuff)s的伤害。\n\n*淌血升能能力造成的伤害不会摧毁您的战车。"

msgid "berserker/longDescr"
msgstr "穿透力和射速提高至{green_Open}%(gunPiercing)s倍{green_Close}，同时炮控和稳定性效率提高{green_Open}%(gunAimingTime)s{green_Close}，但效果持续的{whiteSpanish_Open}%(duration)s秒{whiteSpanish_Close}期间会受到等同于您战车总血量{red_Open}%(healthDebuff)s{red_Close}的伤害。\n\n*淌血升能能力造成的伤害不会摧毁您的战车。"

msgid "berserker/name"
msgstr "淌血升能"

msgid "berserker/shortDescr"
msgstr "穿透力和射速提高至{green_Open}%(gunPiercing)s倍{green_Close}，同时炮控和稳定性效率提高{green_Open}%(gunAimingTime)s{green_Close}，但效果持续的{whiteSpanish_Open}%(duration)s秒{whiteSpanish_Close}期间会受到等同于您战车总血量{red_Open}%(healthDebuff)s{red_Close}的伤害。\n\n*淌血升能能力造成的伤害不会摧毁您的战车。"

