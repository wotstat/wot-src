msgid "br_bomber/battleDescr"
msgstr "震晕敌方战车并对其造成%(minDamage)s到%(maxDamage)s点伤害。中心地带的战车受到的伤害最多。\n\n*生效前有%(delay)s秒延迟。"

msgid "br_bomber/descr"
msgstr "震晕敌方战车并对其造成%(minDamage)s到%(maxDamage)s点伤害。中心地带的战车受到的伤害最多。\n\n*生效前有%(delay)s秒延迟。"

