msgid "adaptationHealthRestore/name"
msgstr "适应性装甲"

msgid "adaptationHealthRestore/shortDescr"
msgstr "立即{green_Open}恢复%(immediatelyRestore)s点{green_Close}战车血量。能力效果持续的{whiteSpanish_Open}%(duration)s秒{whiteSpanish_Close}期间，受到的所有炮弹伤害和战斗能力伤害都会累积并转化为血量，并在能力效果结束后，额外为战车恢复等同于{green_Open}所受总伤害%(restoringCoefficient)s的血量{green_Close}。\n\n*血量转化的恢复效果也会影响小范围内的队友战车。"

msgid "additInvisibilityDeviceBattleBooster/descr"
msgstr "%s 战车静止或移动时的隐蔽性——需安装低噪音排气系统(任意级别)或赏金排气系统。"

