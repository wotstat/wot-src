msgid "shotPassion/battleDescr"
msgstr "炮控效率和火炮稳定性降低%(gunAimingTime)s，但您每次造成击穿都会使您的伤害提高%(damageIncreasePerShot)s，持续%(duration)s秒。效果可叠加5层。未造成伤害或未命中的射击重置伤害加成为0层。\n\n*电流猛击命中同样会增加伤害加成层数。"

msgid "shotPassion/descr"
msgstr "炮控效率和火炮稳定性降低%(gunAimingTime)s，但您每次造成击穿都会使您的伤害提高%(damageIncreasePerShot)s，持续%(duration)s秒。效果可叠加5层。未造成伤害或未命中的射击重置伤害加成为0层。\n\n*电流猛击命中同样会增加伤害加成层数。"

msgid "shotPassion/longDescr"
msgstr "炮控效率和火炮稳定性降低{red_Open}%(gunAimingTime)s{red_Close}，但您每次造成击穿都会使您的伤害提高{green_Open}%(damageIncreasePerShot)s{green_Close}，持续{whiteSpanish_Open}%(duration)s秒{whiteSpanish_Close}。效果{whiteSpanish_Open}可叠加5层{whiteSpanish_Close}。未造成伤害或未命中的射击重置伤害加成为0层。\n\n*电流猛击命中同样会增加伤害加成层数。"

msgid "shotPassion/name"
msgstr "斗志渐涨"

msgid "shotPassion/shortDescr"
msgstr "炮控效率和火炮稳定性降低{red_Open}%(gunAimingTime)s{red_Close}，但您每次造成击穿都会使您的伤害提高{green_Open}%(damageIncreasePerShot)s{green_Close}，持续{whiteSpanish_Open}%(duration)s秒{whiteSpanish_Close}。效果{whiteSpanish_Open}可叠加5层{whiteSpanish_Close}。未造成伤害或未命中的射击重置伤害加成为0层。\n\n*电流猛击命中同样会增加伤害加成层数。"

