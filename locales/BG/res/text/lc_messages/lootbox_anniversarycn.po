msgid "#PluralForms"
msgstr "nplurals=2; plural=(n != 1);"

msgid "boxTooltip/description/text/bronze"
msgstr "Когато бъдат отворени, тези кутии могат да ви предоставят машини, валути в играта и други ценни награди."

msgid "boxTooltip/description/text/gold"
msgstr "Когато бъдат отворени, тези кутии може да ви осигурят машини, валути в играта, елементи за персонализация и други ценни награди."

msgid "boxTooltip/description/text/silver"
msgstr "Когато бъдат отворени, тези кутии може да ви осигурят машини, валути в играта, елементи за персонализация и други ценни награди."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Може да се получи от Магазина в играта и при отваряне на кутии от всеки друг вид."

msgid "boxTooltip/howGet/text/gold"
msgstr "Може да се получи при отваряне на кутии от всякакъв друг вид."

msgid "boxTooltip/howGet/text/silver"
msgstr "Може да се получи при отваряне на кутии от всякакъв друг вид."

msgid "common/boxCategory/lowerCase/bronze"
msgstr "Наградна кутия с плячка"

msgid "common/boxCategory/lowerCase/gold"
msgstr "Наградна кутия с дарове"

msgid "common/boxCategory/lowerCase/silver"
msgstr "Наградна кутия с приношения"

msgid "common/boxCategory/upperCase/bronze"
msgstr "НАГРАДНА КУТИЯ С ПЛЯЧКА"

msgid "common/boxCategory/upperCase/gold"
msgstr "НАГРАДНА КУТИЯ С ДАРОВЕ"

msgid "common/boxCategory/upperCase/silver"
msgstr "НАГРАДНА КУТИЯ С ПРИНОШЕНИЯ"

msgid "entryPoint/tooltip/description"
msgstr "Това са специални кутии, съдържащи нови и уникални предмети. Те могат да бъдат получени от Магазина в играта."

msgid "entryPoint/tooltip/timerText"
msgstr "Събитието ще завърши след"

msgid "eventName/lowerCase"
msgstr "ТРЕЗОР НА ШЕПОТИТЕ"

msgid "eventName/upperCase"
msgstr "ТРЕЗОР НА ШЕПОТИТЕ"

msgid "guaranteed/tooltip/description1/"
msgstr "Ако вече притежавате всички машини, вместо това получавате наградна кутия с дарове."

msgid "infoPage/footer/description/compensation"
msgstr "Ако вече притежавате всички машини от кутиите, ще получите наградна кутия с дарове като награда вместо машина."

msgid "infoPage/footer/description/guaranteed"
msgstr "Всяка %(guaranteed0)s наградна кутия с плячка, %(guaranteed1)s наградна кутия с приношения и %(guaranteed2)s наградна кутия с дарове гарантирано съдържат машина. Ако ги отворите без да се падне подобна машина, тогава машина, която вече не притежавате, ще се падне, когато отворите %(guaranteed0)s-ата/%(guaranteed1)s-ата/%(guaranteed2)sата кутия (в зависимост от вида на кутията). Когато това се случи, броячът се нулира."

msgid "infoPage/footer/title/compensation"
msgstr "Компенсация"

msgid "infoPage/footer/title/guaranteed"
msgstr "Гарантирана награда"

msgid "infoPage/header/rewards/description"
msgstr "Не може да се падне повече от една награда на група"
