msgid "battleHints/wtBattleStart_boss"
msgstr "Преследвайте натрапниците!\nОставете времето да изтече, за да спечелите."

msgid "battleHints/wtBattleStart_hunters"
msgstr "Унищожете Blitzträger!\nПревземете генераторите, за да деактивирате щита му."

msgid "battleHints/wtBossHyperionDeploy"
msgstr "! ВНИМАНИЕ !\nХиперион стреля!"

msgid "battleHints/wtBossHyperionReady"
msgstr "Хиперион е зареден!"

