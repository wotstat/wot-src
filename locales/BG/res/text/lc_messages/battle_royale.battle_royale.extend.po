msgid "fullStats/alive"
msgstr "Оцелели играчи"

msgid "fullStats/deathZone/closed/description"
msgstr "Зоната е затворена"

msgid "fullStats/deathZone/warning/description"
msgstr "Зоната се затваря"

msgid "fullStats/description"
msgstr "Основната цел е да бъдете последния оцелял играч (или взвод). Събирайте ресурси, подобрявайте машината си и оцелейте!"

msgid "fullStats/destroyed"
msgstr "Унищожени от вас"

msgid "fullStats/icons/airDrop/description"
msgstr "Доставка по въздух: опит, възстановяване на живот, ремонт на модули, заряди за всички бойни способности, амуниции."

msgid "fullStats/icons/corpseLoot/description"
msgstr "Военни трофеи: опит, възстановяване на живот, ремонт на модули, заряди за някои бойни способности, амуниции."

msgid "fullStats/icons/defaultLoot/description"
msgstr "Припаси: опит, възможен заряд за бойна способност, амуниции."

msgid "fullStats/icons/extendedLoot/description"
msgstr "Снаряжение: опит, възстановяване на живот, ремонт на модули, заряд за възстановяване, амуниции."

msgid "fullStats/stPatrick/icons/corpseLoot/description"
msgstr "Военни трофеи: опит, възстановяване на живот, ремонт на модули, заряди за някои бойни способности, амуниции."

msgid "fullStats/stPatrick/icons/extendedLoot/description"
msgstr "Снаряжение: опит, възстановяване на точки живот, ремонт на модули, шанс за получаване на заряди за бойни способности, амуниции."

msgid "fullStats/stPatrick/icons/shamrocks/description"
msgstr "Щастливите печати се съдържат във всички видове трофеи. Те могат да бъдат разменени за награди след битка в Магазина на Трилистника."

msgid "fullStats/subTitle"
msgstr "Битка за ценни ресурси по правила \"всеки против всеки\"."

msgid "fullStats/title"
msgstr "Стоманен ловец"
