msgid "Contact/status/inBattle/halloween"
msgstr "В битка във Вавилон: Тъмната кула"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Произвежда изстрел, който поврежда и зашеметява целта и всички вражески машини в радиус от 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Произвежда изстрел, който възстановява точките живот, като ги краде от целта и близките вражески машини в радиус от 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Произвежда изстрел, който зашеметява целта и всички вражески машини в радиус от 35 m."

msgid "advanced/hw_damageShield"
msgstr "Предпазва от всякакви повреди (с изключение на таран, удавяне и сблъсък) за 7 секунди."

msgid "advanced/hw_fastReload"
msgstr "Повишава скорострелността / презарежда касетата"

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Възстановява точки живот, потушава пожар, премахва зашеметяващия ефект и поправя повредените модули."

msgid "advanced/hw_invisibility"
msgstr "Временно прави машината ви невидима за враговете, възстановява точките живот, поправя модули, гаси пожар, премахва ефекта на зашеметяване и лекува всички ранени членове на екипажа."

msgid "advanced/hw_teamRepairKit"
msgstr "Поправя повредени модули, потушава пожар, премахва зашеметяващия ефект и възстановява точки живот на съюзническите машини в обсега си."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Бойните способности ви помагат да се биете по-ефективно в битките за Вавилон: Тъмната кула, да изпълнявате цели и печелите ценни награди. За да се оборудвате с тях, щракнете върху един от слотовете за бойни способности."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Слотове за бойни способности"

msgid "hwShell/alt/description"
msgstr "%(bold)s могат да бъдат намерени в битка с определена вероятност след унищожаване на враг."

msgid "hwShell/alt/description/bold"
msgstr "Алтернативен снаряд"
