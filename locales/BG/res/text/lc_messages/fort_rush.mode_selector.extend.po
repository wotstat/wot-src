msgid "mode/fort_rush_battle/condition"
msgstr "7 на 7 %(parSecondary_open)sI%(parSecondary_close)s ниво&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Поеми контрола над антените. Задръж мрежата. Осигури предаването."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Производителността на вашия компютър е недостатъчна за този режим. Може да се наблюдават проблеми с графиката и движението на машините. Възможно е и блокиране на клиента на играта."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Ниска производителност"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Ниска производителност"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Този режим изисква висока производителност на компютъра. Ще имате проблеми със зареждане на картите, графиката и движението на машините. В случай на недостатъчна производителност, опитайте по-ниски настройки на графиката."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Намалена производителност"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Намалена производителност"
