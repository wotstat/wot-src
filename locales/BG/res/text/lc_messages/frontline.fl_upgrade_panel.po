msgid "alert"
msgstr "Не можете да избирате боен резерв по време на активни битки."

msgid "description/one/reserve"
msgstr "Многократното избиране на %(reserve_name)sрезерва\n ще подобри характеристиките му."

msgid "description/second/reserve"
msgstr "Многократното избиране на %(first_reserve_name)s или %(second_reserve_name)s резерв\nще подобри характеристиките на избрания."

msgid "number_1"
msgstr "1ви"

msgid "number_2"
msgstr "2ри"

msgid "number_3"
msgstr "3ти"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Разполага минно поле в избраната област за определен период от време."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Нанася значителни поражения на вражески машини в малък радиус."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Зашеметява вражески машини и нанася средни поражения в обширен радиус."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Добавя бонус към основната квалификация на екипажа на играча и на съюзниците."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Носи бонус към скоростта на завладяване, блокирането на завладяване и презареждането."

msgid "shortDescription/reserve/reconAbility"
msgstr "Открива вражески машини и минни полета."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Възстановява определен процент от живота на машината ви."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Скрива всички машини в и зад дима."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Носи бонус към маскировката и обзора. Намалява маскировката на вражески машини."

msgid "title"
msgstr "Наличен %(number_name)s резервен слот"
