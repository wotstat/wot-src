msgid "invites/note/change_and_leave/PREBATTLE_FUN_RANDOM"
msgstr "След като приемете поканата, ще бъдете автоматично премахнати от взвода \"%(modeName)s\" и ще бъдете прехвърлени към сървъра %(host)s."

msgid "invites/note/change_and_leave/QUEUE_FUN_RANDOM"
msgstr "След като приемете поканата, ще излезете от режима %(modeName)s и ще бъдете прехвърлени към сървъра %(host)s."

msgid "invites/note/leave/PREBATTLE_FUN_RANDOM"
msgstr "След като приемете поканата, автоматично ще бъдете премахнат от взвода %(modeName)s."

msgid "invites/note/leave/QUEUE_FUN_RANDOM"
msgstr "След като приемете поканата, ще излезете от режима %(modeName)s."

msgid "invites/prebattle/alreadyJoined/FUN_RANDOM"
msgstr "Вече се присъединихте към този взвод."

msgid "invites/text/FUN_RANDOM"
msgstr "Покана за присъединяване към взвод \"%(modeName)s\""
