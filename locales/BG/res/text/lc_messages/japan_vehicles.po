msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Разработван от Osaka Artillery Arsenal, за да замести Type 2589. Танковете Chi-Ni и the Chi-Ha преминават съвместни изпитания през 1937 г. Chi-Ha е определен за по-успешен. Произведен е един прототип."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Средният танк Type 3 Chi-Nu Kai е комбинация от окачването и купола на Type 3 Chi-Nu и оръдието на Type 4 Chi-To. Произведен е само един прототип. Бил е готов за изпитания през март 1945 г."

msgid "Chi_Nu_Kai_long_special"
msgstr "Това е класически среден танк без никакви особени предимства или недостатъци. Подходящ е за всякакви ситуации в битка."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Висока точност, бронебойност, добра броня на маската на оръдието"

