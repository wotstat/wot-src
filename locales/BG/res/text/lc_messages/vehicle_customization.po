msgid "special_style/ranked_3_3rd"
msgstr "Класика от Класацията, вариант 3"

msgid "special_style/ranked_3_3rd_desc"
msgstr "Всесезонен стил, даван в края на три сезона 2019/2020 на режим Битки за Класацията."

