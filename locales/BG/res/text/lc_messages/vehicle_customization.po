msgid "camouflage/Chimera_lbz_camo_w/description"
msgstr "2. Според легендите е убита от Белерофонт, древногръцки герой, който яздел крилатия кон Пегас, докато се сражавал с нея. Според друга версия корабът на герой се казва Пегас, а Химера е каньон в Ликия."

msgid "camouflage/Chimera_lbz_camo_w/label"
msgstr "Белерофонт, зимен"

