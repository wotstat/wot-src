msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Можете да печелите точки за Боен пропуск в режим {whiteSpanish_open}Последна битка{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Точки за Боен пропуск"

msgid "mode/last_stand/calendar"
msgstr "Събитието ще продължи %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "Събитието ще завърши след %(date)s."

msgid "mode/last_stand/description"
msgstr "Бийте се срещу вълни от врагове.\nБитки с машини ниво VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Производителността на вашия компютър е недостатъчна за този режим. Може да се наблюдават проблеми с графиката и движението на машините. Възможно е и блокиране на клиента на играта."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Ниска производителност"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Ниска производителност"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Този режим изисква висока производителност на компютъра.\nЩе имате проблеми със зареждане на картите, графиката и движението на машините. В случай на недостатъчна производителност, опитайте по-ниски настройки на графиката."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Намалена производителност"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Намалена производителност"
