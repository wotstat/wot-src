msgid "notrecruitedtankman/ny20snowmen/additionalAlert"
msgstr "?empty?"

msgid "notrecruitedtankman/ny20snowmen/desc"
msgstr "\"...И ще поразя с голяма щедрост и страхотни подаръци онези, които са били добри през изминалата година. И ще знаете, че името ми е Празник, когато положа щедростта си върху вас.\""

msgid "notrecruitedtankman/ny20snowmen/howToGetInfo"
msgstr "?empty?"

msgid "notrecruitedtankman/ny20snowmen/label"
