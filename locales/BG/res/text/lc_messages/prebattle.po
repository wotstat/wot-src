msgid "hints/confirmDialog/confirm"
msgstr "Тъй вярно!"

msgid "hints/confirmDialog/message"
msgstr "Вие сте на път да станете професионален танкист! Отсега нататък екраните за зареждане на битки ще показват състава на отбора вместо съвети за начинаещи. Винаги можете да активирате отново съветите в Настройки в менюто на играта."

msgid "hints/confirmDialog/title"
msgstr "Нови екрани за зареждане на битки"

msgid "hints/hint1/description"
msgstr "Дръжте под око маркера за пробиване в центъра на мерника на оръдието ви. Цветът му ви казва къде можете да пробиете бронята на врага."

msgid "hints/hint1/green/description"
msgstr "Висок шанс за пробиване"

msgid "hints/hint1/green/header"
msgstr "Зелен маркер"

msgid "hints/hint1/header"
msgstr "Пробиване на броня"

msgid "hints/hint1/red/description"
msgstr "Нисък шанс за пробиване"

msgid "hints/hint1/red/header"
msgstr "Червен маркер"

msgid "hints/hint10/description"
msgstr "Оръдието на машината ви винаги се движи към центъра на екрана, но ограничената скорост на движение означава, че това може да отнеме известно време."

msgid "hints/hint10/header"
msgstr "Прицел на оръдието"

msgid "hints/hint10/penetration/description"
msgstr "Зелено: слаби места в броня"

msgid "hints/hint10/penetration/header"
