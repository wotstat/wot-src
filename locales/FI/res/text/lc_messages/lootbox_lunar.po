msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) hehkuva aarre"
msgstr[1] "%(remainingCount) hehkuvaa aarretta"
msgstr[2] "%(remainingCount) hehkuvaa aarretta"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Takuupalkinto on vaunu hehkuvan aarteen mahdollisten sisältöjen listalta.\nJos avaat %(remainingCount) saamatta tällaista vaunua, saat sen avatessasi %(count) hehkuvan aarteen. Näin tapahtuessa laskuri nollautuu."
