msgstr "KIINALAISEN UUDENVUODEN SAALIS"

msgid "guaranteedTitle/nextBox"
msgstr "Taattu palkinto seuraavassa aarteessa!"

msgid "guaranteedTitle/text"
msgstr "Suurin määrä hehkuvia aarteita ennen takuupalkintoa: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Mikäli et avaa hehkuvia aarteita ennen tapahtuman päättymistä, ne avataan automaattisesti."

msgid "infoPage/footer/description/compensation"
msgstr "Mikäli omistat jo kaikki vaunut hehkuvan aarteen mahdollisen sisällön listalta, hyvitetään kaikki seuraavat vaunut, jotka saat hehkuvista aarteista, kullalla niiden täyden arvon mukaan."

msgid "infoPage/footer/description/guaranteed"
msgstr "Joka %(guaranteed0)s. hehkuva aarre sisältää taatusti tason VIII–IX vaunun. Jos avaat niitä saamatta tällaista vaunua, saat sellaisen tason VIII–IX vaunun, jota et vielä omista, kun avaat %(guaranteed0)s&zwnbsp;. hehkuvan aarteen. Kun näin käy, laskuri nollautuu."

msgid "infoPage/header/description"
msgstr "Avaa hehkuvia aarteita saadaksesi mahdollisuuden saada arvokkaita pelihyödykkeitä! Katso lisätietoja alta."

msgid "multipleRewardView/header/subTitle/"
msgstr "\"%(name)\" -arkusta (%(boxesCount) hehkuvaa aarretta avattu)"

msgid "noBoxesView/description/"
msgstr "Sinulla ei ole hehkuvia aarteita.\nVoit saada niitä pelinsisäisestä Kaupasta."

