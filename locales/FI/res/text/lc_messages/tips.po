msgid "battlePassSeasonDescription"
msgstr "UUSIA TEEMOITETTUJA KOLMIULOTTEISIA TYYLEJÄ"

msgid "beCareful"
msgstr "Ole varovainen"

msgid "comp7Core10"
msgstr "Voit vaihtaa sopivampaan vaunuun taisteluun esivalmisteluvaiheessa."

msgid "comp7Core10Status"
msgstr "Taistelun esivalmisteluvaihe"

msgid "comp7Core11"
msgstr "Taistelun esivalmisteluvaiheen ruutu näyttää vaunusi, joista löytyvät miehistöt ja ammukset. Älä unohda valmistella niitä ennen liittymistäsi taisteluun."

msgid "comp7Core11Status"
msgstr "Taistelun esivalmisteluvaihe"

msgid "comp7Core12"
msgstr "Valittuasi vaunusi kerro siitä liittolaisillesi klikkaamalla \"Vahvista valinta\" -nappia."

msgid "comp7Core12Status"
msgstr "Taistelun esivalmisteluvaihe"

msgid "comp7Core13"
msgstr "Painettuasi \"Vahvista valinta\" -nappia et voi enää vaihtaa vaunuja."

msgid "comp7Core13Status"
msgstr "Vahvista valintasi"

msgid "comp7Core14"
msgstr "Valtaa erityiskohteita kartalta päästäksesi käsiksi taktisiin taitoihin ja saadaksesi etulyöntiaseman!"

msgid "comp7Core14Status"
msgstr "Kohdealueet"

msgid "comp7Core15"
msgstr "Kohdealue kartalla. Tämän alueen valtaaminen antaa sinulle käyttöösi taktisen \"Divisioonan tutka\" -taidon. Aktivoitaessa kaikki vihollisvaunut pysyvät havaittuna muutaman sekunnin ajan."

msgid "comp7Core15Status"
msgstr "Viestintäkeskus"

msgid "comp7Core16"
msgstr "Kohdealue kartalla. Tämän alueen valtaaminen antaa sinulle käyttöösi taktisen \"Tykistöisku\" -taidon. Aktivoitaessa pelaaja voi valita alueen, johon isketään tykistökeskityksellä."

msgid "comp7Core16Status"
msgstr "Tykistöpäämaja"

msgid "comp7Core17"
msgstr "Jos taktinen \"Tykistöisku\" -taito osuu liittolaiseesi, eivät he saa vahinkoa. He kuitenkin lamautuvat."

msgid "comp7Core17Status"
msgstr "Tykistöisku"

msgid "comp7Core18"
msgstr "Huomio: Tämän pelimuodon kartat saattavat erota niiden vastineista satunnaistaisteluissa."

msgid "comp7Core18Status"
msgstr "Tapahtuman kartat"

msgid "comp7Core19"
msgstr "Seitsemän pelaajan osaston luominen voi parantaa mahdollisuuksiasi voittoon."

msgid "comp7Core19Status"
msgstr "Ryhmätyö on avain voittoon"

msgid "comp7Core21"
msgstr "Voit tarkastella liittolaistesi roolitaitojen lataustasoa painamalla Tab tai Alt -näppäimiä."

msgid "comp7Core21Status"
msgstr "Liittolaisten roolitaidot"

msgid "comp7Core22"
msgstr "Voit katsoa joukkuelistasta, josko liittolaisesi ovat saaneet yhtään taktista taitoa. Vihollisen taktisia taitoja ei näytetä."

msgid "comp7Core22Status"
msgstr "Taktiset taidot"

msgid "comp7Core23"
msgstr "Jos roolitaidot vaikuttavat vaunuun näytetään niihin liittyvä kuvake pelaajan merkin yläpuolella."

msgid "comp7Core23Status"
msgstr "Roolitaidon vaikutukset"

msgid "comp7Core24"
msgstr "H -näppäin (oletuksena) ottaa äänikeskustelun käyttöön. Käytä tätä ominaisuutta viestiäksesi tehokkaammin joukkueesi kanssa."

msgid "comp7Core24Status"
msgstr "Äänikeskustelu"

msgid "comp7Core25"
msgstr "Tarkasta peliohjelmasi asetukset, jos sinulla on mitään ongelmia äänikeskustelun kanssa."

msgid "comp7Core25Status"
msgstr "Äänikeskustelu"

msgid "comp7Core29"
msgstr "Kun painat Alt -näppäintä näytetään kaikkien näkökykysi kantamalla olevien vaunujen rooli pelaajan merkin yläpuolela. Liittolaisvaunujen tapauksessa näet myös heidän roolitaitonsa lataustason."

msgid "comp7Core29Status"
msgstr "Vaunujen roolit"

msgid "comp7Core31"
msgstr "Voit asettaa uudet pikanäppäimet taktisille ja roolitaidoille pelin asetuksista."

msgid "comp7Core31Status"
msgstr "Hallinta-asetukset"

msgid "comp7Core32"
msgstr "Voit vallata kohdealueet uudelleen tietyn ajan jälkeen."

msgid "comp7Core32Status"
msgstr "Kohdealueista"

msgid "comp7Core33"
msgstr "Et voi vallata kohdealuetta ennen kuin olet käyttänyt sitä vastaavan taktisen taidon."

msgid "comp7Core33Status"
msgstr "Kohdealueista"

msgid "comp7Core34"
msgstr "Kohdealueen valtaaminen tuo sinulle arvovaltapisteitä."

msgid "comp7Core34Status"
msgstr "Kohdealueista"

msgid "comp7Core35"
msgstr "Tutustu tapahtuman sääntöihin saadaksesi lisätietoa arvovaltapisteistä."

msgid "comp7Core35Status"
msgstr "Arvovaltapisteistä"

msgid "comp7Core37"
msgstr "Pelimuodossa on muuttujia, jotka vaihtavat vaunun tiettyjä parametrejä, kuten kestopisteitä, kulutustarvikkeiden jäähtymisaikaa, vaunun näkyvissä pysymisen aikaa ja paljon muuta."

msgid "comp7Core37Status"
msgstr "Rynnistyksen muuttujat"

msgid "comp7Core5"
msgstr "Roolistaan riippuen kullakin vaunulla on erikoistaito kolmella lataustasolla. Mitä korkeampi lataustaso taitoa aktivoitaessa sitä vahvempi vaikutus."

msgid "comp7Core5Status"
msgstr "Roolitaidoista"

msgid "comp7Core6"
msgstr "Arvovaltapisteitä voi ansaita vaikuttavasta suoriutumisesta taistelussa, kohdealueiden valtaamisesta, taitojen käyttämisestä yms."

msgid "comp7Core6Status"
msgstr "Arvovaltapisteistä"

msgid "comp7Core8"
msgstr "Pelaajilla ei ole tietoa vastustajiensa vaunuista ennen kuin ne havaitaan."

msgid "comp7Core8Status"
msgstr "Sodan usva"

msgid "comp7Light7"
msgstr "Voit saada lisätietoa Kevyt-Rynnistyksestä klikkaamalla \"TAPAHTUMASTA\" -nappia tapahtuman ruudulta."

msgid "comp7Light7Status"
msgstr "Pelimuodon tiedot"

msgid "comp7Light9"
msgstr "Kokoelmalla eri rooleihin soveltuvia tason VIII vaunuja voit aina valita parhaan mahdollisen vaunun mihin hyvänsä taisteluun ja mukautua myös liittolaistesi vaunuvalintoihin."

msgid "comp7Light9Status"
msgstr "Laajenna tallia"

msgid "comp7NightMaps38"
msgstr "Yökartat virkistävät tuttuja taistelukenttiä yöllisillä olosuhteilla, uusilla tarkkailupisteillä, päivitetyillä kohdealueilla ja erilaisilla havaintomekaniikoilla."

msgid "comp7NightMaps38Status"
msgstr "YÖKARTAT"

msgid "comp7Ranked0"
msgstr "Taistele luokituspisteistä saavuttaaksesi korkeimmat luokitukset ja todistaaksesi ylivertaisuutesi."

msgid "comp7Ranked0Status"
msgstr "Luokitusjärjestelmä"

msgid "comp7Ranked1"
msgstr "Mitä enemmän arvovaltapisteitä ansaitset taistelussa, sitä enemmän luokituspisteitä saat voitosta ja sitä vähemmän menetät niitä tappiosta."

msgid "comp7Ranked1Status"
msgstr "Arvovalta- ja luokituspisteet"

msgid "comp7Ranked2"
msgstr "Rynnistyksessä pelaajat paritetaan taisteluihin samoilta luokituksilta."

msgid "comp7Ranked20"
msgstr "Taistelusta poistuminen ennen sen loppumista saattaa liittolaisesi epäsuotuisaan asemaan. Niin tekeminen johtaa väliaikaiseen estoon ja luokituspisteiden menettämiseen."

msgid "comp7Ranked20Status"
msgstr "Karkuruus"

msgid "comp7Ranked26"
msgstr "Vain mestarin ja legendan luokituksen saaneet pelaajat näytetään tuloslistalla. Kaikki tuloslistalle päässeet pelaajat saavat päivittäisiä palkintoja."

msgid "comp7Ranked26Status"
msgstr "Tuloslista"

msgid "comp7Ranked27"
msgstr "Karkureilta estetään väliaikaisesti pelimuotoon osallistuminen. Eston kesto kasvaa kunkin peräkkäisen rikkomuksen myötä."

msgid "comp7Ranked27Status"
msgstr "Väliaikainen esto"

msgid "comp7Ranked28"
msgstr "Taistele pelimuodossa avataksesi uusia elementtejä edistyvään Rynnistyksen tyyliin."

msgid "comp7Ranked28Status"
msgstr "Edistyvä tyyli"

msgid "comp7Ranked2Status"
msgstr "Pelaajista parhaat"

msgid "comp7Ranked3"
msgstr "Legendan luokitus myönnetään vain parhaista parhaille. Tämän luokituksen saadaksesi sinun tulee olla tuloslistan pelaajien parhaan 10% joukossa ansaittujen luokituspisteiden mukaan."

msgid "comp7Ranked36"
msgstr "Huomio: Jos poistut taistelusta ennen sen päättymistä, menetät enemmän luokituspisteitä kuin menettäisit kammottavasta tappiosta."

msgid "comp7Ranked36Status"
msgstr "Karkuruus"

msgid "comp7Ranked3Status"
msgstr "Legenda"

msgid "comp7Ranked4"
msgstr "Jos lopetat tämän pelimuodon pelaamisen, menetät luokituspisteitä. Tämä sääntö koskee hopeista, kultaista, mestarin ja legendan luokitusta."

msgid "comp7Ranked4Status"
msgstr "Luokitustoimettomuus"

msgid "comp7Ranked7"
msgstr "Voit saada lisätietoa Rynnistyksestä klikkaamalla \"TAPAHTUMASTA\" -nappia tapahtuman ruudulta."

msgid "comp7Ranked7Status"
msgstr "Pelimuodon tiedot"

msgid "comp7Ranked9"
msgstr "Kokoelmalla eri rooleihin soveltuvia tason X vaunuja voit aina valita parhaan mahdollisen vaunun mihin hyvänsä taisteluun ja mukautua myös liittolaistesi vaunuvalintoihin."

msgid "comp7Ranked9Status"
msgstr "Laajenna tallia"

msgid "devMaps0"
msgstr "Satunnaistapahtuman sijainti merkitään\nkartalle savulla ja pienoiskartalle merkillä.\nSatunnaistapahtumia sisältävät kartat voi poistaa kierrosta asetusten \"Peli\" -välilehdeltä."

msgid "devMaps0Status"
msgstr "Kartat satunnaistapahtumilla"

msgid "devMaps1"
msgstr "Vaunusi voi tuhoutua satunnaistapahtuman alueella (esimerkiksi lentokoneen maahansyöksyn aikana).\nSatunnaistapahtumia sisältävät kartat voi poistaa kierrosta asetusten \"Peli\" -välilehdeltä."

msgid "devMaps1Status"
msgstr "Kartat satunnaistapahtumilla"

msgid "dualGunVehicles"
msgstr "Kaksoistykkijärjestelmällä varustetut vaunut"

msgid "epicModeHiddenFeatures"
msgstr "Etulinjan mestariksi"

msgid "epicModeIntroduction"
msgstr "Pelimuodon ominaisuudet"

msgid "epicModeUseful"
msgstr "Opi Etulinjan tavoille"

msgid "epicRandom0"
msgstr "Voit kokea kevyitä suorituskykyyn liittyviä ongelmia tässä taistelutyypissä."

msgid "epicTip1"
msgstr "Kaikki alueelle jäävät puolustavan osapuolen vaunut joutuvat pommituksen kohteeksi, kun tukikohta on vallattu."

msgid "epicTip10"
msgstr "Kunnian ja maineen lisäksi sotilasarvot antavat sinulle myös hyödyllisiä bonuksia jokaisesta taistelusta."

msgid "epicTip11"
msgstr "Etulinjalla on monia uusia tapoja ansaita kokemusta ja krediittejä."

msgid "epicTip12"
msgstr "Etulinjaa voidaan siirtää työntämällä toista joukkuetta taaksepäin. Tällä tavoin voit palatataistelukentälle lähempänä kohteitasi."

msgid "epicTip13"
msgstr "Kun valtausympyrän sisällä oleva vaunu ottaa vahinkoa, vaunulta estetään joksikin aikaa valtaamisen edistäminen."

msgid "epicTip14"
msgstr "Aktivoi ja paranna taistelureservejäsi erikoisruudulla. Käytä niitä kylvämään tuhoa taistelukentällä."

msgid "epicTip15"
msgstr "Voit aina vaihtaa rintamalohkoja uudelleensyntymis-ruudussa, mikäli strateginen tilanne sitä vaatii."

msgid "epicTip16"
msgstr "Älä mene suojelluille alueille. Vihollisen tykistöasemat avaavat sinuun tulen."

msgid "epicTip17"
msgstr "Oletko juuttunut kartalla jonnekin? Käytä hylkäys-toimintoa (oletuksena J) hylätäksesi vaunusi ja palataksesi uudella vaunulla taisteluun."

msgid "epicTip18"
msgstr "Avaa suurempi versio pienoiskartasta (oletuksena M) saadaksesi paremman yleiskuvan taistelukentästä."

msgid "epicTip19"
msgstr "Voit saada viestejä vain liittolaisilta, jotka ovat näkyvillä pienoiskartalla."

msgid "epicTip2"
msgstr "Etulinjalla voit saada paljon hienoja palkintoja, jos haluat ansaita hieman ylimääräistä."

msgid "epicTip20"
msgstr "Voit säätää pienoiskarttallasi näkyvää aluetta hiiren rullalla pitäessäsi kursoria kartan päällä."

msgid "epicTip21"
msgstr "Voit osoittaa tukikohtia tai kohteita joukkuekavereillesi klikkaamalla niitä pienoiskartalla."

msgid "epicTip22"
msgstr "Jos vaunusi loppuvat, kannattaa kokeilla \"vapaa kamera\" -tilaa. Sen avulla voit suunnitella strategiaasi odottaessasi mahdollisuutta palata taisteluun."

msgid "epicTip23"
msgstr "Mikäli tukikohtaa vallataan taisteluajan loppuessa, siirtyy peli jatkoajalle. Taistelu jatkuu, kunnes kaikki tukikohdat on puhdistettu vihollisista."

msgid "epicTip3"
msgstr "Etulinjalla taistelukenttä on 9 neliökilometriä, mikä on yhdeksän kertaa minkä hyvänsä tavallisen kartan koko."

msgid "epicTip4"
msgstr "Taisteluaikaa lisätään joka kerta, kun alue vallataan. Viimeinen alue tuo lisäaikaa."

msgid "epicTip5"
msgstr "Mikäli vaunusi tuhoutuu taistelussa, tarvitaan sen korjaamiseen jonkin aikaa. Valitse toinen vaunu ja palaa taisteluun."

msgid "epicTip6"
msgstr "Reserveihisi toimitetaan ylimääräinen vaunu joka viides minuutti."

msgid "epicTip7"
msgstr "Hyökkääjät voivat ajaa seuraavan linjan alueelle vasta vallattuaan saman rintamalohkon edeltävän linjan."

msgid "epicTip8"
msgstr "Kun kaikki ensimmäisen linjan alueet on vallattu, heikentyvät kaikki toisen linjan alueet."

msgid "epicTip9"
msgstr "On mahdollista voittaa taistelu tuhoamalla vihollisjoukkue. Valitettavasti se on ERITTÄIN epätodennäköistä."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Noudata ohjeita"

msgid "howToPlay"
msgstr "Kuinka pelata"

msgid "mapbox0"
msgstr "Paikallisen sääalueen sisällä olevat vaunut eivät voi havaita alueen ulkopuolella olevia vaunuja ja sama päinvastoin. Myös vihollisvaunujen sijaintitietojen vaihtaminen alueen ulkopuolelle on mahdotonta. Tulipalo vahingoittaa vaunuja."

msgid "mapbox0Status"
msgstr "Paikallinen sää"

msgid "payAttention"
msgstr "Ole tarkkaavainen"

msgid "ranked1"
msgstr "Saat enemmän kokemusta vaunusi roolin mukaisesta suorittamisesta! Vaunujen roolit ja niiden mukaisten toimien kuvaukset ovat saatavissa tallissa \"Tietoja pelimuodosta\" -sivulla."

msgid "ranked10"
msgstr "Taistelemalla tiesi luokitettujen taisteluiden etenemisen läpi saat mahdollisuuden ostaa ainutlaatuisia vaunuja ja muokkauselementtejä arvopapereilla (mukaan lukien tarjouksessa olevat). Klikkaa banneria nähdäksesi listan näistä.\nEt pääse käsiksi tavaroihin tai tarjouksiin, jos kausi ei ole meneillään."

msgid "ranked11"
msgstr "Päivittäiset bonustaistelut ovat saatavilla vain liigoissa. Niitä saadaan karsintojen ja erikoistehtävien suorittamisen perusteella. Päivittäiset bonustaistelut eivät siirry seuraavalle päivälle."

msgid "ranked12"
msgstr "Vuoden päättyessä tehokkaimmat pelaajat pääsevät tuloslistalle. He saavat ylimääräisen arvomerkin ja saavat ihailua ja kunnioitusta yhteisöltä."

msgid "ranked13"
msgstr "Jotkut sijoitusluokat ovat pysyviä. Kun tämä sijoitusluokka on saatu, sitä ei voi menettää. Keskivaiheilla olevat pysyvät sijoitusluokat on merkitty erikseen. Lisäksi kunkin divisioonan aloittavat sijoitusluokat ovat pysyviä, eikä niitä voi menettää."

msgid "ranked2"
msgstr "Saat tavallisia ja päivittäisiä bonustaisteluita kunkin divisioonan läpäisemisestä ja liigan saavuttamisesta. Bonustaistelu tuplaa automaattisesti taistelusta ansaitsemiesi natsojen määrän, eikä sitä käytetä epäonnistuttaessa. Kullekin tason X vaunulle on saatavilla vain yksi bonustaistelu päivässä."

msgid "ranked3"
msgstr "Pysy kärryillä taisteluajasta. Kun se loppuu, luokitetut taistelut eivät enää ole saatavilla ennen seuraavaa päivää ja saat asiasta kertovan ilmoituksen."

msgid "ranked4"
msgstr "Joillain sijoitusluokilla on niin kutsutut kilvet. Hävitessäsi näillä sijoitusluokilla, kilpesi heikkenee, mutta et menetä sijoitusluokkaa. Mikäli kilpi ei ole tyystin lopussa, palautuu se täysin ansaitessasi natsan kilvellisen sijoitusluokan taistelussa."

msgid "ranked5"
msgstr "Älä koskaan anna periksi! Natsaa eivät saa ainoastaan voittavan joukkueen 7 parasta pelaajaa, vaan myös hävinneen joukkueen parhaat pelaajat. Muista, että jokainen bonustaistelussa ansaittu natsa tuplataan."

msgid "ranked6"
msgstr "Läpäistyään kaikki divisioonat pelaajat saavuttavat yhden kolmesta liigasta: Kultaisen, Hopeisen tai Pronssisen. He jatkavat taistelemista ja heidän taistelutuloksensa vaikuttavat heidän suoriutumiseensa ja määrittävät sijoituksen tuloslistalla."

msgid "ranked7"
msgstr "Pelaajat ansaitsevat luokituspoletteja kunkin divisioonan läpäisemisestä. Parhaiten kolmen kauden aikana suoriutuneet pelaajat saavat ansaitut loppupalkintonsa."

msgid "ranked8"
msgstr "Kauden päättyessä parhaat pelaajat saavat ainutlaatuisen arvomerkin ja tyylin vaunuilleen. Nämä palkinnot antavat pelaajille mahdollisuuden kantaa ylpeänä merkkejä verrattomista taidoistaan."

msgid "ranked9"
msgstr "Saat arvopapereita luokitetuissa taisteluissa menestymisestä. Arvopapereita voi vaihtaa direktiiveihin ja paranneltuihin varusteisiin. Lisäksi tarjolla on muita vaivan arvoisia palkintoja: krediittejä, kulutustarvikkeita yms."

msgid "rankedStatus1"
msgstr "Kokemusta vaunun roolin mukaisesta suoriutumisesta"

msgid "rankedStatus10"
msgstr "Luokitettujen taisteluiden tavarat"

msgid "rankedStatus11"
msgstr "Päivittäiset bonustaistelut"

msgid "rankedStatus12"
msgstr "Vuoden parhaat pelaajat"

msgid "rankedStatus13"
msgstr "Pelimuodon säännöt"

msgid "rankedStatus2"
msgstr "Bonustaistelut"

msgid "rankedStatus3"
msgstr "Taisteluaika"

msgid "rankedStatus4"
msgstr "Pelimuodon säännöt"

msgid "rankedStatus5"
msgstr "Pelimuodon säännöt"

msgid "rankedStatus6"
msgstr "Taistelut liigoissa"

msgid "rankedStatus7"
msgstr "Vuotuiset palkinnot"

msgid "rankedStatus8"
msgstr "Kauden loppupalkinnot"

msgid "rankedStatus9"
msgstr "Palkinnot sijoitusluokista"

msgid "security"
msgstr "Turvallisuus ennen kaikkea"

msgid "technicalAdvice"
msgstr "Tekninen neuvo"

msgid "tip0"
msgstr "Soinen maasto alentaa vaunun kääntymisnopeutta ja liikkuvuutta huomattavasti."

msgid "tip100"
msgstr "Miehistön jäsenen tehokkuus vaikuttaa kyseessä olevan vaunun ominaisuuksiin."

msgid "tip101"
msgstr "\"Kuudes aisti\" -ominaisuus antaa komentajalle kyvyn tunnistaa, havaitseeko vihollinen vaunua."

msgid "tip102"
msgstr "Pätevyystehokkuus on parametri, joka määrittää kaikkien miehistön jäsenen kouluttamien pätevyyksien tehon."

msgid "tip103"
msgstr "Voit vaihtaa miehistön jäsenen päätaitoa kouluttamalla hänet uudelleen."

msgid "tip106"
msgstr "Varusteet parantavat miehistön tehokkuutta ja vaunun ominaisuuksia."

msgid "tip107"
msgstr "Vaunut, joiden kaikki moduulit on tutkittu, saavat eliittistatuksen."

msgid "tip108"
msgstr "Eliittivaunuilla (mukaan lukien premium-vaunut) ansaittua taistelukokemusta voidaan muuntaa vapaaksi kokemukseksi."

msgid "tip11"
msgstr "Käytä puskia ja kasvillisuutta, jotta PST-vaunuasi on vaikeampi havaita. Ota huomioon, että paikallaan olevia vaunuja on vaikeampi havaita."

msgid "tip111"
msgstr "Joskus tukikohdan valtaaminen on helpompi ja turvallisempi vaihtoehto kuin kaikkien vihollisvaunujen tuhoaminen."

msgid "tip114"
msgstr "Tilin jakaminen rikkoo pelisääntöjä ja voi johtaa tilille pääsyn menettämiseen."

msgid "tip115"
msgstr "Pelisäännöt kieltävät tilien jakamisen. Rikkojat voivat menettää kummatkin tilit lopullisesti."

msgid "tip116"
msgstr "Mitä monimutkaisempi salasanasi on, sen parempi."

msgid "tip117"
msgstr "Vaihda salasanaasi säännöllisesti."

msgid "tip118"
msgstr "Pelisäännöt kieltävät tilien ostamisen ja myymisen. Jos rikot näitä sääntöjä, voit menettää tilisi."

msgid "tip119"
msgstr "Älä avaa linkkejä tuntemattomille sivuille. Olet vaarassa joutua huijatuksi ja hakkeroiduksi."

msgid "tip120"
msgstr "Voit ostaa kultaa vain World of Tanksin virallisilta verkkosivuilta. Jos yrität ostaa kultaa muilta verkkosivuilta, voit menettää rahasi."

msgid "tip121"
msgstr "Mahdollisuus tallentaa salasana on kätevä, mutta turvaton."

msgid "tip122"
msgstr "Portaalissa voi löytää ohjeet miten pidät tilisi turvallisena. Lue ne huolellisesti."

msgid "tip123"
msgstr "Taistelussa, pidä Ctrl-näppäintä pohjassa nähdäksesi hiiren kursorin."

msgid "tip124"
msgstr "Korjataksesi moduulin, käytä korjaussarjaa. Parantaaksesi miehistön jäsenen, käytä ensiapupakkausta."

msgid "tip125"
msgstr "Käyttääksesi kulutustarvikkeita ja vaihtaaksesi ammustyyppien välillä, käytä pikanäppäimiä (oletuksena 1-6)."

msgid "tip126"
msgstr "Liikuttaaksesi kameraa tykistötilassa välittömästi, klikkaa hiiren oikealla painikkeella pienoiskartalla."

msgid "tip127"
msgstr "Vaihtaaksesi joukkuelistan ulkoasua, paina 'Ctrl+Tab'."

msgid "tip128"
msgstr "Klikkaa hiiren oikealla painikkeella pelaajan nimeä sivuilla sijaitsevissa joukkuepaneeleissa nähdäksesi mahdolliset toiminnot."

msgid "tip129"
