msgid "punishmentWindow/message/ban/comp7"
msgstr "Rikoit pelisääntöjä {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartalla kello {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nSinulta on vähennetty {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} luokituspistettä ja sinua on väliaikaisesti estetty osallistumasta {whiteSpanish_Open}\"Rynnistys\"{whiteSpanish_Close} -pelimuodon taisteluihin."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Rikoit pelisääntöjä {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartalla kello {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nSinua on väliaikaisesti estetty osallistumasta {whiteSpanish_Open}\"Rynnistys\"{whiteSpanish_Close} -pelimuodon taisteluihin ja luokitustasi on alennettu."
