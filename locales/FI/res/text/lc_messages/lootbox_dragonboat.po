msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Lohikäärmeveneen laatikot"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "LOHIKÄÄRMEVENEEN LAATIKOT"

msgid "entryPoint/tooltip/description"
msgstr "Nämä ovat erikoislaatikoita, jotka sisältävät ainutlaatuisia ja arvokkaita pelitarvikkeita.\nVoit saada laatikoita pelinsisäisestä Kaupasta tai Premium-kaupasta."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Lohikäärmeveneen laatikot eivät ole väliaikaisesti saatavilla"

msgid "eventName/lowerCase"
msgstr "Kesytä lohikäärme, ratsasta tuulella"

msgid "eventName/upperCase"
msgstr "KESYTÄ LOHIKÄÄRME, RATSASTA TUULELLA"

msgid "infoPage/footer/description/compensation"
msgstr "Mikäli omistat jo kaikki vaunut laatikon mahdollisen sisällön listalta, hyvitetään kaikki seuraavat vaunut, jotka saat lohikäärmeveneen laatikoista, kullalla niiden täyden arvon mukaan."

msgid "infoPage/footer/description/guaranteed"
msgstr "Joka %(guaranteed0)s. lohikäärmeveneen laatikko sisältää taatusti tason VIII-IX vaunun. Jos avaat niitä saamatta tällaista vaunua, saat sellaisen tason VIII-IX vaunun, jota et vielä omista, kun avaat %(guaranteed0)s&zwnbsp;. lohikäärmeveneen laatikon. Kun näin käy, laskuri nollautuu."

msgid "noBoxesView/description/"
msgstr "Sinulla ei ole laatikoita.\nVoit saada niitä pelinsisäisestä Kaupasta."
