msgstr "Täysin koulutettuna lyhentää {greenBright_Start}ammustyyppien vaihtamiseen kuluvaa aikaa{greenBright_End} ladatuilla tykeillä %(vehicleReloadTimeAfterShellChange)s&zwnbsp;."

msgid "loader_intuition/name"
msgstr "Aavistus"

msgid "loader_intuition/shortDescription"
msgstr "Nopeuttaa merkittävästi ammustyyppien vaihtamista ladatulla tykillä."

