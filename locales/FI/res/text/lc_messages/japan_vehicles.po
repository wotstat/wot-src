msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Osaka Artillery Arsenalin kehittämä korvaaja Type 2589 vaunulle. Chi-Ni ja Chi-Ha vaunut läpäisivät yhdistetyt testit vuonna 1937. Chi-Ha vaunua pidettiin onnistuneempana. Yksi prototyyppi rakennettiin."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Keskiraskas Type 3 Chi-Nu Kai vaunu on yhdistelmä Type 3 Chi-Nu vaunun telakoneistoa ja tykkitornia, sekä Type 4 Chi-To vaunun tykkiä. Vain yksi prototyyppi rakennettiin. Vaunu oli valmis testeihin maaliskuussa 1945."

msgid "Chi_Nu_Kai_long_special"
msgstr "Tämä on tavallinen keskiraskas vaunu, jolla ei ole merkittäviä vahvuuksia tai heikkouksia. Se sopii tilanteeseen kuin tilanteeseen."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Hyvin tarkka, läpäisevä ja mukavasti panssaroitu tykin kilpi"

msgid "Continental_AOSI_1195_6"
msgstr "Continental AOSI-1195-6"

