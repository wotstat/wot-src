msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Hopealuoti"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "Liittouman aseseppien ylpeys"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Jokainen ylikuormitettu generaattori lataa hopealuodin plasmalla. Mitä enemmän latauksia, sitä enemmän vahinkoa plasma aiheuttaa. Maksimivahinkoa tehdäksesi ammu, kun Blitzträgerin suojakilpi on alhaalla."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Lisää vahinkoa plasmalla"
