msgid "hint/LSH_FIRE"
msgstr "Savu vaikeuttaa vihollisvaunujen havaitsemista ja niiden asemista kertomista. Tulipalo aiheuttaa vahinkoa vaunuihin."

msgid "hint/LSH_FOG"
msgstr "Sumu vaikeuttaa vihollisvaunujen havaitsemista ja niiden asemista kertomista."

msgid "hint/LSH_RAIN"
msgstr "Rankkasade vaikeuttaa vihollisvaunujen havaitsemista ja niiden asemista kertomista."

msgid "hint/LSH_SANDSTORM"
msgstr "Hiekkamyrskyt vaikeuttavat vihollisvaunujen havaitsemista ja niiden asemista kertomista."

msgid "hint/LSH_SMOKE"
msgstr "Savu vaikeuttaa vihollisvaunujen havaitsemista ja niiden asemista kertomista."

msgid "hint/PPH_AIMING_01"
msgstr "Vaunun ja tornin liike heikentää <font color='#EE7000'>tykin tarkkuutta</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Ympyrä tähtäimen ympärillä osoittaa <font color='#EE7000'>tykin tarkkuutta</font>. Odota pieni hetki lisää ampuaksesi tarkemmin."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automaattitähtäys</font> käytössä. Klikkaa hiiren oikeaa nappia peruuttaaksesi sen."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automaattitähtäin tähtää aina tykkisi kohteenasi olevan vaunun <font color='#EE7000'>keskiosaan</font>"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Tukikohtaasi <font color='#EE7000'>vallataan!</font> Jos sitä ei estetä, voittaa vihollisjoukkue taistelun."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Kullakin vihollisvaunulla <font color='#EE7000'>on oma</font> valtauksen edistymisensä"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Vihollisen tukikohdan <font color='#EE7000'>valtaaminen</font> on yksi tavoista voittaa taistelu"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Saadessasi vahinkoa valtauksen edistymisesi <font color='#EE7000'>nollautuu</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Poistuessasi tukikohdan ympyrästä valtauksen edistymisesi <font color='#EE7000'>menetetään</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Useampi vaunu valta tukikohtaa <font color='#EE7000'>nopeammin</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "<font color='#EE7000'>Kolmannen</font> vaunun jälkeen tukikohdan valtausnopeus ei enää kasva"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Vihollistukikohta on lähes vallattu!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Joukkueesi on voittamassa valtauskisan!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Vaunun moduuli vahingoittui kriittisesti! Korjaa se käyttämällä <font color='#EE7000'>korjaussarja</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Vaunun moduuli vahingoittui kriittisesti! Korjaa se käyttämällä <font color='#EE7000'>korjaussarja</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Miehistön jäsen loukkaantui kriittisesti! Hoida ne <font color='#EE7000'>ensiapupakkauksella</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Miehistön jäsen loukkaantui kriittisesti! Hoida ne <font color='#EE7000'>ensiapupakkauksella</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Miehistön jäsen lamaantui! Hoida ne <font color='#EE7000'>ensiapupakkauksella</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vaunu on tulessa! Käytä <font color='#EE7000'>palosammutinta</font> alapaneelista."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vaunu on tulessa! Automaattinen <font color='#EE7000'>palosammutin</font> aktivoitui."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Vaunun moduuli vahingoittui kriittisesti! <font color='#EE7000'>Korjaussarjan</font> asentaminen ennen taistelua auttaa huolehtimaan kriittisistä osumista."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Miehistön jäsen loukkaantui kriittisesti! <font color='#EE7000'>Ensiapupakkauksen</font> asentaminen ennen taistelua auttaa huolehtimaan kriittisistä osumista."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Vaunu on tulessa. <font color='#EE7000'>Palosammuttimen</font> asentaminen ennen taistelua auttaa huolehtimaan tulipaloista."

msgid "hint/PPH_OTHER_01"
msgstr "Sinut on <font color='#EE7000'>havaittu</font> – ampuminen voi paljastaa asemasi!"

msgid "hint/PPH_OTHER_02"
msgstr "Vaunusi tuhoutui. Voit painaa <font color='#EE7000'>Esc</font> -näppäintä poistuaksesi taistelusta ilman rangaistusta."

msgid "hint/PPH_OTHER_03"
msgstr "Vaunusi tuhoutui. Voit klikata hiiren nappia <font color='#EE7000'>seurataksesi</font> liittolaisiasi."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Hehkulamppu -kuvake</font> osoittaa, että viholliset ovat havainneet sinut!"

msgid "hint/PPH_OTHER_05"
msgstr "Tykkisi <font color='#EE7000'>lataa</font> vielä"

msgid "hint/PPH_OTHER_06"
msgstr "Tykilläsi voi ampua vain, kun tähtäimen ympärillä oleva kehä on <font color='#EE7000'>täysin vihreä</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Voit skrollata hiiren pyörää päästäksesi <font color='#EE7000'>tarkka-ampuja -tilaan</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Voit skrollata hiiren pyörää poistuaksesi <font color='#EE7000'>tarkka-ampuja -tilasta</font>"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Sisempi vihreä tähtäin</font> kertoo suuresta mahdollisuudesta vihollisen panssarin läpäisemiseen"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Panssarin läpäisy <font color='#EE7000'>ei ole varmaa</font> edes silloin, kun sisempi tähtäin on vihreä"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Tykit eivät ole 100% tarkkoja, joten ammukset <font color='#EE7000'>eivät aina osu keskelle</font> tähtäinympyrää"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Sisempi tähtäin kertoo vihollispanssarin läpäisyn todennäköisyydestä. <font color='#EE7000'>Ota se käyttöön asetuksista</font>."

msgid "penetration/chance/high"
msgstr "Hyvä mahdollisuus"

msgid "penetration/chance/low"
msgstr "Huono mahdollisuus"

msgid "penetration/chance/medium"
msgstr "Kohtuullinen mahdollisuus"
