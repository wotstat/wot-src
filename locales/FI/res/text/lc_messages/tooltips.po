msgstr "Bonus keskimääräiseen vahinkoon jokaisesta kertyneestä lämpötasosta."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Aika, jona vaunu ei voi ampua tai vaihtaa ammuksia."

msgid "tank_params/desc/heatTimeBeforeOverheat"
