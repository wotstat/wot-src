msgid "alert"
msgstr "Et voi valita taistelureserviä aktiivisen taistelun aikana."

msgid "description/one/reserve"
msgstr "\"%(reserve_name)s\" -reservin valitseminen toistuvasti\nparantaa sen ominaisuuksia."

msgid "description/second/reserve"
msgstr "\"%(first_reserve_name)s\" tai \"%(second_reserve_name)s\" reservin valitseminen toistuvasti\nparantaa valitun reservin ominaisuuksia."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Sijoittaa aktiivisen miinakentän valitulle alueelle tietyksi ajaksi."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Aiheuttaa pienellä säteellä merkittävää vahinkoa vihollisvaunuihin."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Lamauttaa vihollisvaunuja ja aiheuttaa kohtalaista vahinkoa suuren säteen sisällä."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Lisää bonuksen pelaajan ja liittolaisten miehistöjen päätaitoon."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Tarjoaa bonuksen valtausnopeuteen, valtauksen estämiseen ja täydennykseen."

msgid "shortDescription/reserve/reconAbility"
msgstr "Havaitsee vihollisvaunut ja miinakentät."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Palauttaa tietyn prosenttiosuuden vaunusi kestopisteistä."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Piilottaa kaikki savun sisällä ja takana olevat vaunut."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Tarjoaa bonuksen naamioitumiseen ja näkökykyyn. Heikentää vihollisvaunujen naamioitumista."

msgid "title"
msgstr "%(number_name)s reservipaikka saatavilla"
