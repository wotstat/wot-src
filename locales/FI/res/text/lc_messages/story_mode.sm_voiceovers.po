msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfiren lentäjä: Näkyvyys on huono, en voi auttaa!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfiren lentäjä: Liian paljon ilmatorjuntatulta, en voi auttaa!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfiren lentäjä: Raskasta ilmatorjuntaa, tulenjohtaminen ei ole mahdollista."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfiren lentäjä: Tämähän on oikea flak-myrsky?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfiren lentäjä: Emme voi johtaa laivan tulitusta tällaisen tulituksen alla."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfiren lentäjä: Nuo bunkkereiden vieressä olevat ilmatorjuntapatterit pitää hiljentää."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfiren lentäjä: Onnistuin sukeltamaan alemmas."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfiren lentäjä: Voin alkaa nyt kutsumaan isojen tykkien tulta käyttämällä savumerkkejä maassa."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfiren lentäjä: Vaunut, teidän vuoronne!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfiren lentäjä: Olen havainnut savun."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfiren lentäjä: Välitetään koordinaatteja taistelulaivalle suoraa osumaa varten."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfiren lentäjä: Hitto, yksi omistamme putoaa! En pääse vieläkään matalammalle."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfiren lentäjä: Meidän täytyy hoidella nyt toiset ilmatorjuntatykit!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfiren lentäjä: Ilmatorjunta vaiennettu, laskeudun alemmas. Valmiina ohjaamaan tehokkaampaa tulta taistelulaivaltamme."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfiren lentäjä: Huomio! Iso vihollisryhmä nähty liikkumassa teitä kohti."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfiren lentäjä: Ne heittävät peliin kaiken, mitä heiltä löytyy."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfiren lentäjä: Olkaa valppaana siellä alhaalla, uusi vihollisryhmä lähestyy."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfiren lentäjä: Varoitus, viimeinen ja suurin vihollisaalto on tulossa."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfiren lentäjä: Ne lähestyvät joka puolelta. Valmistautukaa taisteluun."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfiren lentäjä: Sain selvän näköhavainnon savumerkistä. Koordinaatteja lähetetään taistelulaivalle."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfiren lentäjä: Ah, siellä on savumerkkimme. Välitän sijainnin taistelulaivalle."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfiren lentäjä: Savu nousee kohteella. Lähetämme tarkan sijainnin taistelulaivalle."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfiren lentäjä: Näen savun, näyttää siltä, että ystävämme tarvitsevat apua."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "USS Frankfordin komentaja: Odotamme tulituen koordinaatteja."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "USS Frankfordin komentaja: Sokkona ampuminen on riskialtista, saattaisimme osua omiimme."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "USS Frankfordin komentaja: Tarvitsen tarkat kohteet, emme ammu vielä."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "USS Frankfordin komentaja: Tässä USS Frankfordin komentaja. Ei käy."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "USS Frankfordin komentaja: Etenijöiden tukeminen ei onnistu. Näkyvyys liian huono."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "USS Frankfordin komentaja: Ei näköhavaintoa kallioista ja bunkkereista, vain sillanpäässä olevat vaunumme ovat näkyvissä."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "USS Frankfordin komentaja: Näen vaunuja hyökkäämässä kohti kallioita."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "USS Frankfordin komentaja: Tarjoamme tulitukea sille suunnalle."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "USS Frankfordin komentaja: Toivottavasti tämä Sherman tietää, minne hän ampuu."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "USS Frankfordin komentaja: Sherman on vaihtanut kohdetta. Kohdistamme oman tulemme samaan kohteeseen."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "USS Frankfordin komentaja: Sherman on lakannut ampumasta. Työ täällä on tehty."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "USS Frankfordin komentaja: Emme yllä kauempana sisämaassa oleviin bunkkereihin."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "USS Frankfordin komentaja: Vetäydymme turvallisen matkan päähän. Onnea rannalla."

