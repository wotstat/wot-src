msgid "vo_sm_char10_m05_stg21_02"
msgstr "Päämajan upseeri: Echo-5 sillanpää varmistettu. Vaunut etenevät. Tarjotkaa täyttä tulitukea."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Päämajan upseeri: Ohjaamme ilmatuen uudelleen auttamaan vaunuja etenemään."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Päämajan upseeri: Pioneeriryhmät, raivatkaa esteet etenemisen tieltä."

