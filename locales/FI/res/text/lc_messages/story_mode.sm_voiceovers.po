msgid "vo_sm_char10_m05_stg28_01"
msgstr "Päämajan upseeri: Ranta on putsattu. Lähetämme pääjoukot. Loistavaa työtä."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Päämajan upseeri: Pitäkää asemanne. Täydennykset ovat matkalla."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Päämajan upseeri: Suojelkaa sillanpäätä hinnalla millä hyvänsä."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Päämajan upseeri: Uusi vaunu, uusi mahdollisuus. Ole tällä kerralla varovaisempi."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Päämajan upseeri: Reservimme ovat loppumassa. Pidä huoli, että tällä on väliä, komentaja."

