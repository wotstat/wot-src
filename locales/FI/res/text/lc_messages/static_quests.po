msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Aloita satunnaistaistelu minkä hyvänsä tason vaunulla."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Tervetuloa peliin! Taistele toisten ympäri maailmaa tulevien pelin fanien kanssa ja koe ilmiömäisiä voittoja!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Ensimmäinen taistelu"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Tutki ja osta mikä tahansa tason IV vaunu."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Uuden vaunun ostaminen on tärkeä hetki. Jokaisen uuden tason myötä vaunut tulevat kiinnostavammiksi. Myös hyvin koulutettu miehistö parantaa pelaamista."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Tason IV vaunu"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Taistele kolme satunnaistaistelua tasojen IV–X vaunuilla, joissa on muokkauselementtejä käytössä."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Voit muokata vaunuja muuttamalla ulkoasua esiasetetuilla tyyleillä tai luomalla oman tyylisi käyttäen maastokuviota, kirjoituksia, tunnuksia ja koristeita."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Vaunun ulkoasu"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Aloita kouluttamaan minkä hyvänsä miehistön jäsenen mitä hyvänsä pätevyyttä."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Miehistön jäsen voi kouluttaa lisäpätevyyksiä parantamaan tehokkuuttaan tai hankkia uusia kykyjä."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Miehistön pätevyydet"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Ansaitse 150 000 krediittiä satunnaistaisteluissa tasojen IV–X vaunuilla."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Mitä suurempi taistelun taso, sitä enemmän krediittejä tarvitset vaunusi ylläpitoon, ammusten täydentämiseen ja moduulien sekä varusteiden ostamiseen."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Krediittien kerääminen"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Tutki ja osta mikä tahansa tason V vaunu."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Taso V on se raja, jolla vaunut käyvät vakavammiksi ja pelitaitosi laitetaan toden teolla koetukselle. Täysin koulutettu miehistö on totta vieköön avuksi."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Tason V vaunu"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Taistele kymmenen satunnaistaistelua tasojen V–X vaunuilla, joissa on kolme varustetta asennettuna."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Pinnoitetut optiikat vai paranneltu ilmanvaihto? Oikea varuste voi tehdä vaunun vahvuuksista entistä parempi ja loiventaa sen heikkouksia."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Varusteiden asentaminen"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Suorita yksi perusskenaario \"Maantieto\" -pelimuodossa."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Avain itseluottamukseen taistelukentällä on hyvä reittien, taktiikoiden ja karttojen – tärkeimmät asemat ja kohteet mukaan lukien – tunteminen."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Maantieto"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Suorita neljä edistynyttä skenaariota yhdellä kartalla \"Maantieto\" -pelimuodossa."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Käy aina silloin tällöin \"Maantieto\" -pelimuodossa oppimassa satunnaistaisteluiden karttojen saloja. Neljässä skenaariossa voit tutkia karttoja eri kulmista."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Maantietoa kokeneille"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Taistele kymmenen satunnaistaistelua tasojen V–X vaunuilla henkilökohtainen reservi aktiivisena."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Aktivoitaessa voit saada ylimääräisiä bonuksia taistelukokemukseen, vapaaseen ja miehistökokemukseen tai krediitteihin kunkin taistelun jälkeen."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Henkilökohtaiset reservit"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Ole joukkueesi 10 eniten kokemusta ansainneen pelaajan joukossa kuusi kertaa voitetuissa satunnaistaisteluissa tason V–X vaunuilla."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Tehtävät tuovat viisinkertaisesti kokemusta taistelusta. Tätä varten sinun tulee voittaa ja olla joukkueesi 10 eniten kokemusta ansainneen joukossa."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "Kuusi tehtävää x5 kokemukseen"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Tutki minkä hyvänsä tason vaunun moduuli ja ota se käyttöön."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Taistelukokemusta saa jokaisen taistelun jälkeen. Ansaitse taistelukokemusta tutkiaksesi uusia moduuleja, jotka parantavat vaunusi tehokkuutta."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Taistelukokemus"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Tutki ja osta mikä tahansa tason VI vaunu."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Jokainen uusi taso vaatii enemmän vaivaa ja aikaa vaunujen tutkimiseen. Vapaa kokemus auttaa sinua etenemään nopeammin ja koulutettu miehistö alkaa olla kätevä."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Tason VI vaunu"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Suorita yksi henkilökohtainen tehtävä mistä hyvänsä kampanjasta."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanjat ovat tehtäväketjuja erityyppisille vaunuille. Suorittamisen jälkeen niistä saa hyödyllisiä palkintoja ja ainutlaatuisia vaunuja."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Henkilökohtaiset tehtävät"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Kouluta miehistö yleisellä koulutusoppaalla."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Miehistökirjat antavat mahdollisuuden nopeuttaa merkittävästi miehistön koulutusta lisäämällä tietyn määrän kokemusta yhdelle tai kaikille miehistön jäsenille."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Miehistökirjat"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Taistele 10 satunnaistaistelua tason V–X vaunuilla, joilla on miehistödirektiivi asennettuna."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Direktiivit voivat parantaa miehistön pätevyyksiä yhden taistelun ajan. Direktiivejä voi ostaa tai saada palkinnoksi."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Miehistön direktiivit"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Osta erityinen \"Tulokaspaketti\" pelinsisäisestä Kaupasta."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Voit ostaa kaiken tarvitsemasi pelinsisäisestä Kaupasta. Sieltä löydät kultaa, premium-vaunuja ja paljon muuta. Löydät säännöllisesti kampanjoita, jotka tarjoavat mahtavia alennuksia. "

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Kauppa"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Taistele kymmenen satunnaistaistelua tasojen VI–X premium-vaunuilla."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Näitä vaunuja ei tarvitse tutkia. Ne tuovat enemmän taistelu- ja miehistökokemusta sekä krediittejä ja niihin voi siirtää miehistön ilman uudelleenkoulutusta."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium-vaunut"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Taistele kymmenen satunnaistaistelua tasojen VI–X vaunuilla, joilla on varusteiden direktiivi asennettuna."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Direktiivit antavat mahdollisuuden parantaa asennetun varusteen tehoa. Kulutustarvikkeiden tapaan direktiivejä voi ostaa tai saada palkinnoksi."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Varusteiden direktiivit"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Ole joukkueesi 10 eniten kokemusta ansainneen pelaajan joukossa 15 kertaa satunnaistaisteluissa tason VI–X vaunuilla."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Tehtävät tuovat viisinkertaisesti kokemusta taistelusta. Tätä varten sinun tulee voittaa ja olla joukkueesi 10 eniten kokemusta ansainneen joukossa."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 tehtävää x5 kokemukseen"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Tutki ja osta mikä tahansa tason VII vaunu."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Tällä tasolla taitovaatimukset kasvavat entisestään. Vaunuista tulee varteenotettavampia ja tehokkaampia – samoin vihollisistasi."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Tason VII vaunu"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Taistele 10 satunnaistaistelua tason VII–X vaunuilla, joista löytyy suuri ensiapupakkaus, suuri korjaussarja ja automaattinen palosammutin."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Käytössä ollessaan suuret kulutustarvikkeet korjaavat vahingoittuneita moduuleita pieniä nopeammin. Ne myös lyhentävät lamautuksen kestoa ja pienentävät tulipalon todennäköisyyttä. Lisäksi niiden jäähtymisaika on lyhyempi."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Suuret kulutustarvikkeet"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Ansaitse tuplakokemus päivän ensimmäisestä voitostasi satunnaistaisteluissa minkä hyvänsä tason vaunulla."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Voit saada kokemuksesi tuplana kunkin vaunun päivän ensimmäisestä voitosta. Käytä tätä ominaisuutta päivittääksesi vaunujasi entistäkin nopeammin."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Kokemuskerroin"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Luo piirustuksen palanen mille hyvänsä tutkimattomalle vaunulle."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Piirustukset tarjoavat alennusta kokemushintaan ja nopeuttavat vaunun tutkimista. Niitä voi saada palkintona tai muuntamalla piirustusten palasista."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Vaunun piirustukset"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Ole joukkueesi 10 eniten kokemusta ansainneen pelaajan joukossa 20 kertaa satunnaistaisteluissa tason VII–X vaunuilla."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Tehtävät tuovat viisinkertaisesti kokemusta taistelusta. Tätä varten sinun tulee voittaa ja olla joukkueesi 10 eniten kokemusta ansainneen joukossa."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 tehtävää x5 kokemukseen"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Tutki ja osta mikä tahansa tason VIII vaunu."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Tason VIII vaunut vaativat kaiken keräämäsi tiedon käyttämistä. Viholliset eivät jätä sinua rauhaan, vaan tarjoavat hurjaa vauhtia ja korvaamatonta kokemusta."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Tason VIII vaunu"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Käytä vapaata kokemusta tutkimaan mikä hyvänsä moduuli."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Jos sinulla ei ole riittävästi taistelukokemusta moduulin tai vaunun tutkimiseen, voit käyttää vapaata kokemusta, jota voi ansaita millä hyvänsä vaunulla."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Vapaa kokemus"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Lastaa mukaan erilaisia ammuksia ja aloita satunnaistaistelu tason III–X vaunulla."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Panssarinläpäisevät, sirpalekranaatit ja alikaliiperiammukset sopivat kukin eri tilanteisiin taistelussa. Valitse viisaasti, jotta saat niistä edun!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Ammukset"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Myy käyttämätön moduuli varastosta."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Käyttämättömät moduulit, ammukset, varusteet, kulutustarvikkeet ja muut tavarat varastoidaan varikolle. Voit myydä ylimääräiset tavarat krediittejä vastaan."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Varikko"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Ansaitse 25 000 krediittiä satunnaistaisteluissa tason III–X vaunuilla."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Krediittejä käytetään ammuksien ja uusien vaunujen ostamiseen, korjaamiseen ja paljoon muuhun. On tärkeä tietää, kuinka niitä säästetään ja käytetään viisaasti."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Krediittejä"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Taistele kolme satunnaistaistelua tasojen III–X vaunuilla kulutustarvikkeet kaikkiin saatavilla oleviin paikkoihin asennettuna."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Kulutustarvikkeet korjaavat kriittistä vaunun vahinkoa ja parantavat miehistön vammoja. Kulutustarvikkeiden oikea-aikainen käyttö on tärkeää taito."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Kulutustarvikkeet"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Taistele kolme satunnaistaistelua tasojen III–X vaunuilla, jossa on mikä hyvänsä varuste asennettuna."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Vaunuja voi säätää varusteilla koettaessaan parantaa osaa niiden ominaisuuksista. Varustevalikoima riippuu vaunusta ja pelityylistä."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Varusteet"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Maantieto"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Suorita yksi skenaario millä hyvänsä kartalla \"Maantieto\" -pelimuodossa"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Suorita neljä perusskenaariota yhdellä kartalla \"Maantieto\" -pelimuodossa"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Tiedustelu"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Suorita neljä edistynyttä skenaariota yhdellä kartalla \"Maantieto\" -pelimuodossa"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "10+ maantiedosta"
