msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Anomalian lähde lähestyy. Tietenkin se on iso paha vaunu."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Tuhoa se ja tämä on ohi. Antaa mennä tyypit!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Ammu panssarin heikkoihin kohtiin."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Tyypit, iso ja ruma hirviömäinen kone liikkuu suuntaamme,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "jotain, minkälaista emme ole koskaan ennen nähneet."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Sen heikot kohdat vaikuttavat olevan näkyvissä. Meidän tulee"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "tuhota pomo päästäksemme releelle ja suorittaaksemme tehtävän."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "On onnenpäivämme! Kaksi pomoa yhden sijaan –"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "se on kyllä uutta. Mutta voitamme silti. Ampukaa niiden"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "panssarin heikkoihin kohtiin ja muistakaa tuhota niiden henkivartijat."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Tämä on vakavasti otettava vihollinen, mutta silläkin on heikot kohtansa."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Tuhoa tämä olento ja kaikki on ohi. Antaa mennä, tyypit!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Ammu vihollisen heikkoihin kohtiin. Ja muista tuhota"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "sen kätyrit tai tilanne perkelöityy."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Meidän pitää tuhota pomo sulkeaksemme anomalian."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Tähtää heikkoihin kohtiin sen panssarissa."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Meidän pitää tuhota viimeinen vihollinen päättääksemme tehtävän."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Ammu sen heikkoihin kohtiin."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Tämä on viimeinen este tiellämme."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Nyt kasaan, tyypit! Tuhotaan tämä hirviö!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Vihollinen on erittäin vaarallinen, mutta silläkin on heikot kohtansa."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Tämä on tilaisuutemme viimeistellä se lopullisesti."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Nyt pääsemme näkemään, mitä anomalia on varallemme valmistellut."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Vahva vihollinen, mutta sillä on heikot kohtansa."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Hoidellaan tämä peto, tyypit!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Tämä on erittäin vahva vihollinen. Mutta tiedän, että voimme hoitaa sen."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Tänään sitten kaksi pomoa yhden hinnalla."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Antaa mennä, hyvä diilihän tämä on! Tähdätkää heikkoihin kohtiin"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "niiden panssarissa. Tuhotaan nämä hirviöt!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Näyttää siltä, että pomot eivät päässeet sopuun järjestyksestä ja"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "tulivat yhdessä. Molemmilta löytyy heikot kohtansa. Tähdätkää niihin."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Siinäpä taas mukava pari pomoja. No, tiedätte, mitä tehdä."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Ammu niiden heikkoihin kohtiin ja hoitele niiden kätyrit."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Vikkelästi!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Annoimme sille aikamoista kyytiä!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Mutta näyttää siltä, ettemme ole vielä valmiita."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Hienoa! Mutta olemme vasta puolimatkassa."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Se on palaamaisillaan ja sillä on tovereita mukanaan."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Niin sitä pitää! Korjataan vaunumme ja jatketaan."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Sitä ei päihitetä näin helpolla. Valmistautukaa toiseen erään."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Löimme lujaa! Mutta tämä ei ole vielä ohi."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Hienoa! Mutta olemme vasta puolimatkassa."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Ne ovat palaamaisillaan ja niillä on tovereita mukanaan."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Niin sitä pitää! Korjataan vaunumme ja jatketaan."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Niitä ei päihitetä näin helpolla. Valmistautukaa toiseen erään."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Kapteeni Smith äänessä. Kun miehemme repeämän ulkopuolella"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "pidättelevät kaikuvaunujen hyökkäystä Babylon-keskusta vastaan,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "on meidän tehtävämme matkata kaikkien vaiheiden läpi ja sulkea anomalia."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Sen tehdäksemme meidän tulee täyttää jokaisen vaiheen kerääjät. Eteenpäin!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Syvällä mirium-avaruuden sisältä löydettiin vihollistukikohta."

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Ne valmistelevat valtavaa armeijaa hyökkäykseen. Ainoa mahdollisuutemme"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "niiden pysäyttämiseksi on sulkea niiden tie. Tehtävämme on mennä"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "syvään anomalian vaiheeseen ja tuoda takaisin rele, joka"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "pitää niiden reitin avoinna. Lataa Magnus miriumilla,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "menemme päätepysäkille asti!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Tervehdys kaikki! Meidän pitää sinetöidä kaikuvaunujen reitti"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "todellisuuteemme. Vastavakoilu voi hoidella vakoojat"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "Babylonista – meidän tehtävämme on mirium. Täyttäkää kaikki kerääjät,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "antakaa selkäsauna kaikille meitä odottaville vihollisille"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "ja sulkekaa tämä reikä. Moottorit käyntiin!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Smith tässä. Tehtävämme on sinetöidä repeämä Babylon-"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "keskuksen alueella. Täyttäkää kerääjät miriumilla ja tuhotkaa"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "kaikki, jotka eivät ole meitä. Antaa mennä, vihollinen odottaa!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Miehemme estävät mirium-vaunuja murtautumasta"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "maailmaamme. Tehtävänne on sulkea repeämä."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Mitä pikemmin, sen parempi. Kerätkää miriumia ja paikatkaa tuo reikä."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Vihollisvaunut hyökkäävät Babylon-keskuksen kimppuun. Se kuona"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "ryömii tänne repeämästä ja meidän pitää sulkea heidän tiensä."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Nyt syvälle anomaliaan ja neutraloimaan sen lähde. Matkaan!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Smith äänessä. Tehtävämme on sinetöidä armeijallinen saksalaisia"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "kaikuvaunuja anomalia sisään. Kohteemme on tällä hetkellä"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "syvässä vaiheessa. Täyttäkää Magnus päästäksenne sinne."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Mirium-avaruuden syvyyksistä löydettiin vihollisen tukikohta."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "He suunnittelevat sieltä hyökkäystä."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Älä kiinnitä pikku-tyttöön mitään huomiota. Tehtävämme on aktivoida"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus ja avata reitti syvimpään vaiheeseen,"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "jotta voimme lukita vihollisen sinne ikiajoiksi."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "Syvimmästä vaiheesta löydettiin vihollisen tukikohta."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Me emme voi voittaa heitä, mutta voimme vangita heidät sinne."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Kerää miriumia päästäksesi aivan tämän repeämän pohjalle."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Uskon teihin! Me selviämme tästä!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Uusi repeämä avautui pian edellisen sulkemisen jälkeen."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Tehtävämme pysyy samana: kerätkää materiaa ja"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "sinetöikää anomalia pysäyttääksenne hyökkäys todellisuuteemme. Antaa mennä!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Repeämä on taas auki. Kerää materiaa ja täytä kerääjä."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Meidän pitää sulkea tuo pirun anomalia. Ulkopuolella"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "luotetaan meihin, mutta he eivät kestä enää pitkään!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Vihollisvaunut hyökkäävät yhä Babylon-kompleksiin."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Kerää materiaa ja lataa Magnus. Meidän pitää sulkea"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "anomalia pysäyttääksemme kaikuvaunujen hyökkäyksen maailmaamme."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Kohteemme on lähellä. Pysykää valppaana ja tarkkailkaa silmä kovana"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "Kuolemattoman havaitsinta."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Hyvin tehty! Jatkakaa samaan malliin! Tänne ei"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "tultu pitämään teetaukoa. Tarvitsemme lisää miriumia."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Mahtavaa tiimityötä! Sitten liikkeelle, tarvitsemme lisää miriumia."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Hyvää työtä! Meidän pitää aktivoida Magnus päästäksemme vieläkin syvemmälle."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium tekee meistä vahvempia jokaisessa uudessa vaiheessa."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Älkää vain antako sen viedä mennessään."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Meidän pitää aktivoida Magnus. Vielä viimeinen pusku!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Tehtävämme pysyy samana: meidän tulee täyttää kerääjä."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Lähestymme hyökkäyksen alkulähdettä."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Tehtävämme on sama: täyttäkää kerääjä."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Kiva laulu. Keskittykää!"

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Meidän pitää kerätä miriumia ja mennä syvemmälle."

msgid "narrator"
msgstr "Smith"
