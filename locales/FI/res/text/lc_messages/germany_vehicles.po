msgid "PzVI_MapsTraining_Player_HT_2"
msgstr "Tiger I (tr.)"

msgid "PzVI_Porsche_Turm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_Porsche_Turm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger\nAusf. E"

msgid "PzVI_Standardketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H1"

msgid "PzVI_Vetstaerktketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "Tiger I vaunun kehitys aloitettiin vuonna 1937 Henschel-yhtiön toimesta. Massatuotanto alkoi vuonna 1942, kaikkiaan 1 354 vaunua valmistettiin. Vaunulla taisteltiin ensimmäisen kerran Leningradissa, ja Tiger vaunut olivat taisteluiden eturintamilla Tunisiasta Kurskiin. Vaikkakin tuotanto lopetettiin kesällä 1944, Tiger I jatkoi sotatoimiin osallistumista sodan loppuun asti."

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

msgid "PzV_PzIV_CN"
msgstr "Pz.Kpfw. V Berge-Panther"

msgid "PzV_PzIV_CN_descr"
msgstr "Vaunun valmisti 653. raskaan Panzerjäger pataljoonan Maintenance and Recovery Company Bergepanther ARV vaunun sekä Pz. IV vaunun tykkitornin pohjalta."

msgid "PzV_PzIV_CN_short"
