msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Vaunun kehitti ČKD-yhtiö Tšekkoslovakian armeijalle vuonna 1938. Saksan valtauksen aikana vaunu oli Wehrmachtin palveluksessa ja sitä käytettiin myös Puolan ja Ranskan kampanjoissa sekä itärintamalla. Vaunu näki toimintaa etulinjalla vuoden 1942 puoliväliin asti. Noin 1 400 vaunua valmistettiin kahdeksana eri muunnelmana (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

