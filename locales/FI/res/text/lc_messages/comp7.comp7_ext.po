msgid "whatsNewView/drawConditions/description"
msgstr "Mikäli aika päättyy eikä kumpikaan joukkue ole saavuttanut selvää voittoa, ratkaistaan tasapelin tulos seuraavassa järjestyksessä: selviytyneet vaunut, tehty vahinko ja ensimmäinen tuhottu vaunu. Mikäli kumpikaan joukkue ei tehnyt vahinkoa, julistetaan taistelu tasapeliksi."

msgid "whatsNewView/drawConditions/heading"
msgstr "Tasapelin ehtoja päivitetty {{tag}}"

msgid "whatsNewView/mapChanges/heading"
msgstr "Kartat"

msgid "whatsNewView/newLTRoles/description"
