msgid "special_style/NY2020_christmas_desc"
msgstr "Piparkakusta tehty tykkimies piparkakkuvaunun kyydissä. Onko vaunu tehty miehestä vai mies vaunusta? Hän kirkuu, sillä hän ei tiedä."

msgid "special_style/NY2020_christmas_desc/long"
