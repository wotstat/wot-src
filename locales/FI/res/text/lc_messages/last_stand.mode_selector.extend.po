msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Voit ansaita Taistelupassin pisteitä {whiteSpanish_open}\"Viimeiseen mieheen\"{whiteSpanish_close} -pelimuodossa."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Taistelupassin pisteet"

msgid "mode/last_stand/calendar"
msgstr "Tapahtuma kestää %(date)s ajan."

msgid "mode/last_stand/calendarDay"
msgstr "Tapahtuman päättymiseen %(date)s."

msgid "mode/last_stand/description"
msgstr "Taistele vihollisaaltoja vastaan.\nTaisteluita tason VIII vaunuilla."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Tietokoneesi suorituskyky ei riitä tähän pelitilaan. Voit kohdata ongelmia grafiikan ja vaunujen liikkumisen kanssa. Pelin kaatuminen on myös todennäköistä."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Heikko suorituskyky"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Heikko suorituskyky"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Tämä pelimuoto vaatii hyvää suorituskykyä tietokoneelta.\nKohtaat ongelmia kartan lataamisen, grafiikoiden ja vaunujen liikkeen kanssa. Mikäli kohtaat ongelmia, koeta heikentää grafiikan laatua asetuksistasi."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Heikentynyt suorituskyky"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Heikentynyt suorituskyky"
