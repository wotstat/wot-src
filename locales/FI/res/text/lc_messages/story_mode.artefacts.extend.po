msgid "battleship/name"
msgstr "Savumerkki"

msgid "battleship/shortDescr"
msgstr "Savumerkki, jolla merkitään alue taistelulaivan tykistöiskua varten, joka aiheuttaa vahinkoa siellä oleville vihollisen varusteille ja kohteille."

msgid "distraction_ability/name"
msgstr "Väärä käsky"

msgid "distraction_ability/shortDescr"
msgstr "Pistä Gefr. Keller välittämään kaapatulla saksalaisella radiolla väärä käsky, jolla ohjaa vihollisia tutkimaan tiettyä sijaintia."

msgid "recon_ability/name"
msgstr "Tiedustele ympäriinsä"

msgid "recon_ability/shortDescr"
msgstr "Lähetä kapteeni Dubois tiedustelemaan tiettyä sijaintia. Tiedustellessaan vaunu pysähtyy ja pysyy paikallaan. Kyky jatkaa toimimista, kunnes se peruutetaan."

msgid "scc_airstrike_ability/name"
msgstr "Ilmatuki"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Kutsuu ilmaiskun osoitettuun asemaan."
