msgid "Contact/status/inBattle/last_stand"
msgstr "Viimeiseen mieheen taistelussa"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Ampuu laukauksen, joka vahingoittaa kohdetta ja kaikkia vihollisvaunuja 35 m säteellä"

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Ampuu laukauksen, joka palauttaa kestopisteitä varastamalla niitä kohteelta ja lähellä olevilta vihollisvaunuilta 35 m säteellä."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Ampuu laukauksen, joka lamauttaa kohteen ja kaikki vihollisvaunut 35 m säteellä."

msgid "advanced/ls_damageShield"
msgstr "Suojelee miltä hyvänsä vahingolta (paitsi törmäämiseltä, hukkumiselta ja putoamiselta) kymmenen sekunnin ajan."

msgid "advanced/ls_doubleDamage"
msgstr "Seuraava menestyksekäs laukauksesi aiheuttaa tuplasti vahinkoa."

msgid "advanced/ls_equipment"
msgstr "Taktiset laitteet auttavat sinua taistelemaan tehokkaammin Viimeiseen mieheen -taisteluissa, suorittamaan vaiheita ja ansaitsemaan arvokkaita palkintoja. Ottaaksesi ne käyttöön klikkaa yhtä taktisten laitteiden paikoista."

msgid "advanced/ls_extraDamageSituational"
msgstr "Antaa mahdollisuuden tehdä enemmän vahinkoa vihollisvaunuun."

msgid "advanced/ls_fastReload"
msgstr "Kasvattaa tulinopeutta / lataa lippaan."

msgid "advanced/ls_healSituational"
msgstr "Palauttaa hieman kestopisteitä vihollisvaunun tuhoamisen jälkeen."

msgid "advanced/ls_invisibility"
msgstr "Estää hetkellisesti vihollisia tähtäämästä vaunuasi, palauttaa kestopisteitä, korjaa moduulit, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja hoitaa kaikki loukkaantuneet miehistön jäsenet."

msgid "advanced/ls_nitro"
msgstr "Parantaa hetkellisesti vaunusi liikkuvuutta."

msgid "advanced/ls_nitroSituational"
msgstr "Parantaa hetkellisesti vaunusi liikkuvuutta kärsittyäsi vahinkoa vihollisvaunulta."

msgid "advanced/ls_selfRepairKit"
msgstr "Palauttaa kestopisteitä, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja korjaa vahingoittuneet moduulit."

msgid "advanced/ls_teamRepairKit"
msgstr "Korjaa vahingoittuneet moduulit, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja palauttaa hieman kestopisteitä liittolaisvaunuille kyvyn säteellä."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktiset laitteet voi ottaa käyttöön erikoispaikkoihin auttamaan sinua taistelemaan tehokkaammin Viimeiseen mieheen -taisteluissa, suorittamaan vaiheita ja ansaitsemaan arvokkaita palkintoja."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktisten laitteiden paikat"
