msgid "Contact/status/inBattle/halloween"
msgstr "Babylon: Pimeän tornin taistelussa"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Ampuu laukauksen, joka lamauttaa ja vahingoittaa kohdetta ja kaikkia vihollisvaunuja 35 m säteellä."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Ampuu laukauksen, joka palauttaa kestopisteitä varastamalla niitä kohteelta ja lähellä olevilta vihollisvaunuilta 35 m säteellä."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Ampuu laukauksen, joka lamauttaa kohteen ja kaikki vihollisvaunut 35 m säteellä."

msgid "advanced/hw_damageShield"
msgstr "Suojelee miltä hyvänsä vahingolta (paitsi törmäämiseltä, hukkumiselta ja putoamiselta) seitsemän sekunnin ajan."

msgid "advanced/hw_fastReload"
msgstr "Kasvattaa tulinopeutta / lataa lippaan."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Palauttaa kestopisteitä, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja korjaa vahingoittuneet moduulit."

msgid "advanced/hw_invisibility"
msgstr "Tekee vaunustasi hetkellisesti näkymättömän vihollisille, palauttaa kestopisteitä, korjaa moduulit, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja hoitaa kaikki loukkaantuneet miehistön jäsenet."

msgid "advanced/hw_teamRepairKit"
msgstr "Korjaa vahingoittuneet moduulit, sammuttaa tulipalon, poistaa lamautuksen vaikutuksen ja palauttaa hieman kestopisteitä liittolaisvaunuille kyvyn säteellä."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Taistelukyvyt auttavat sinua taistelemaan tehokkaammin Babylon: Pimeän tornin taisteluissa, suorittamaan tavoitteita ja ansaitsemaan arvokkaita palkintoja. Ottaaksesi ne käyttöön klikkaa yhtä taistelukykyjen paikoista."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Taistelukykyjen paikat"

msgid "hwShell/alt/description"
msgstr "%(bold)s voidaan löytää taistelussa tietyllä todennäköisyydellä vihollisen tuhoamisen jälkeen."

msgid "hwShell/alt/description/bold"
msgstr "Vaihtoehtoinen ammus"
