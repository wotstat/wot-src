msgid "br_respawn/name"
msgstr "Taisteluun palaaminen"

msgid "br_respawn/platoon/descr"
msgstr "Mahdollistaa taisteluun palaamisen vaunusi tuhoutumisen jälkeen. Tämä mekaniikka toimii taistelun ensimmäisten %(duration)s min aikana.\n\nLiittolaisen palauttamiseksi taisteluun tulee pysyä pois taistelusta %(timeToResurrect)s s. Taisteluun palaamisen käyttökerrat ovat jaettuja osaston jäsenten kesken."

msgid "br_respawn/solo/descr"
msgstr "Mahdollistaa taisteluun palaamisen vaunusi tuhoutumisen jälkeen. Tämä mekaniikka toimii taistelun ensimmäisten %(duration)s min aikana.\n\nVaunusi palaa automaattisesti taisteluun tuhouduttuaan."

msgid "br_smoke/battleDescr"
msgstr "Lisää %(duration)s sekunnin naamiointibonuksen kaikille kulutustarvikkeen vaikutusalueella oleville vaunuille."

msgid "br_smoke/descr"
msgstr "Lisää naamiointibonuksen kaikille kulutustarvikkeen vaikutusalueella oleville vaunuille."

msgid "br_smoke/longDescr"
msgstr "Lisää %(duration)s sekunnin naamiointibonuksen kaikille kulutustarvikkeen vaikutusalueella oleville vaunuille."

