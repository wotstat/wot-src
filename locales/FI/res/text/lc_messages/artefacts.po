msgstr "Jäähdytetty pakokaasujärjestelmä"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Parantaa paikallaan olevan tai liikkuvan vaunun naamiointia"

msgid "additionalInvisibilityDevice/long_special"
msgstr "Tehokkuus riippuu vaunun tyypistä. Parantaa paikallaan olevan tai liikkuvan vaunun naamiointia. Hyödyllistä aktiiviseen tiedusteluun sekä passiiviseen havainnointiin riskialttiista asemista."

msgid "additionalInvisibilityDevice/name"
msgstr "Hiljainen pakokaasujärjestelmä"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Parantaa paikallaan olevan tai liikkuvan vaunun naamiointia."

msgid "additionalInvisibilityDevice_tier1/name"
msgstr "Hiljainen pakokaasujärjestelmä, luokka 1"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Hiljainen pakokaasujärjestelmä, luokka 2"

msgid "additionalInvisibilityDevice_tier3/name"
msgstr "Hiljainen pakokaasujärjestelmä, luokka 3"

msgid "additional_armor_plates_1/name"
msgstr "Ylimääräinen panssarilevy (tyyppi 1)"

msgid "additional_armor_plates_2/name"
msgstr "Ylimääräinen panssarilevy (tyyppi 2)"

msgid "afterburning/descr"
msgstr "Parantaa nopeuttasi ja kiihtyvyyttäsi rajoitetun ajan."

msgid "afterburning/name"
msgstr "Turboahdin"

msgid "aimingStabilizer/long_special"
msgstr "Tykkisi hajonnan pienentäminen on ensiarvoisen tärkeää: mitä pienempi hajonta on alkujaan, sitä pienempi tähtäysympyrä ja sitä vähemmän aikaa kuluu sen supistumiseen. Lisäksi heittolaukauksella (joka ammutaan ilman kunnon tähtäystä tai liikkeestä) on parempi mahdollisuus osua kohteeseen."

msgid "aimingStabilizer/name"
msgstr "Pystyvakaaja"

msgid "aimingStabilizerBattleBooster/descr"
msgstr "%s hajontaan ampumisen jälkeen, vaunun liikkuessa tai tornin pyöriessä, kun pystyvakaaja, vakautusjärjestelmä tai vakaaja (palkkio) on asennettuna."

msgid "aimingStabilizerBattleBooster/gain/deluxe"
msgstr "-5%"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5%"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Tehostaa parannellun pystyvakaajan (mikä hyvänsä luokka), vakautusjärjestelmän ja vakaajan (palkkio) vaikutusta taistelun ajan. Ottaaksesi käyttöön ja aktivoidaksesi tämän direktiivin täytyy sinulla olla nämä varusteet asennettuna vaunuusi."

msgid "aimingStabilizerBattleBooster/name"
msgstr "Vakaajan rasvaus"

msgid "aimingStabilizerBattleBooster/short_special"
msgstr "Parantaa vakaajan toimintaa"

msgid "aimingStabilizer_Mk1/name"
msgstr "Pystyvakaaja, luokka 1"

