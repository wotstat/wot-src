msgid "28_desert/team1/heavyTank/descr"
msgstr "<a_ht_mountains>Vuoret</a_ht_mountains> ovat tämän taktiikan avain.%(p)<a_ht_easternVillage>Itäisen kylän</a_ht_easternVillage> ohittaen voit jatkaa kohti <a_ht_mountains>vuoria</a_ht_mountains>. Tuhottuasi viholliset keskipitkältä matkalta voit ylittää <a_ht_gorge>rotkon</a_ht_gorge> ja käydä lähitaisteluun <a_ht_thoroughfare>väylän</a_ht_thoroughfare> suun lähellä. Otettuasi suojaa <a_ht_dunes>dyyneistä</a_ht_dunes> voit tuhota tukikohdan puolustajat <a_ht_balcony>hyllyltä</a_ht_balcony>. Sen jälkeen ylitä <a_ht_ravine>rotko</a_ht_ravine> ja viimeistele vihollisvaunut läntisestä tukikohdasta."

msgid "28_desert/team1/heavyTank/title"
msgstr "Vuorihyökkäys"

msgid "28_desert/team1/mediumTank/descr"
msgstr "<a_mt_hills>Kukkulat</a_mt_hills> ovat tämän taktiikan avain.%(p)<a_mt_temple>Temppeliä</a_mt_temple> maamerkkinä käyttäen sinun tulisi ottaa tuliasema <a_mt_longDune>pitkän dyynin</a_mt_longDune> suojista. Tämä antaa mahdollisuuden hallita <a_mt_temple>temppelin</a_mt_temple> lähellä ja <a_mt_hills>kukkuloilla</a_mt_hills> olevia vihollisia. <a_mt_hills>Kukkoloilla</a_mt_hills> piileskelee usein monia vihollisia, joten ole varuillasi. Läntisen tukikohdan vihollista lähestyessäsi sinun tulee tuhota kohteet <a_mt_shelf>yläasemasta</a_mt_shelf>, jonka jälkeen voit turvallisesti iskeä <a_mt_westernVillage>läntisen kylän</a_mt_westernVillage> vihollisten kylkeen."

msgid "28_desert/team1/mediumTank/title"
msgstr "Kukkulahyökkäys"

msgid "28_desert/team2/heavyTank/descr"
msgstr "<b_ht_hills>Kukkulat</b_ht_hills> ovat tämän taktiikan avain.%(p)<b_ht_shelf>Yläasemaa</b_ht_shelf> pitkin liikkuen pääset ottamaan tuliaseman, josta käsin voit ampua <b_ht_bigDune>suuren dyynin</b_ht_bigDune> juurella olevia vihollisia. Puhdistettuasi tien voit liikkua <b_ht_longDune>pitkälle dyynille</b_ht_longDune>. Sitä suojana käyttäen voit raivata väylän vihollisen puolustuslinjoille. Käytä <b_ht_detour>kiertotietä</b_ht_detour> päästäksesi itäistä tukikohtaa puolustavien vihollisten selustaan."

msgid "28_desert/team2/heavyTank/title"
msgstr "Kukkulahyökkäys"

msgid "28_desert/team2/mediumTank/descr"
msgstr "Tämän taktiikan avain on ajaa ylös <b_mt_rocks>kallioille</b_mt_rocks>.%(p)<b_mt_westernVillage>Läntisen kylän</b_mt_westernVillage> ohi ajaen pääset vikkelästi tuliasemaan <b_mt_rocks>kallioille</b_mt_rocks> ilman, että mahdolliset kohteet tiellä vievät huomiotasi. Tuhottuasi vihollisjoukot tästä asemasta käsin sinun tulisi liikkua <b_mt_gorge>rotkoon</b_mt_gorge> ja viimeistellä kaikki kohteet sieltä. Kiipeä sen jälkeen <b_mt_mountain>vuorelle</b_mt_mountain> ja laskeudu vikkelästi <b_mt_easternVillage>itäiseen kylään</b_mt_easternVillage>. Tuhottuasi itäisen tukikohdan viholliset voit viimeistellä helposti jäljellä olevan vastarinnan <b_mt_river>joen</b_mt_river> lähistöltä."

msgid "28_desert/team2/mediumTank/title"
msgstr "Kivikkohyökkäys"

