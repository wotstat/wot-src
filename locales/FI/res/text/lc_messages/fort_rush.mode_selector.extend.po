msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s Taso&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Ota antennit haltuusi. Pidä verkko. Turvaa lähetys."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Tietokoneesi suorituskyky ei riitä tähän pelitilaan. Voit kohdata ongelmia grafiikan ja vaunujen liikkumisen kanssa. Pelin kaatuminen on myös todennäköistä."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Heikko suorituskyky"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Heikko suorituskyky"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Tämä pelimuoto vaatii hyvää suorituskykyä tietokoneelta. Kohtaat ongelmia kartan lataamisen, grafiikoiden ja vaunujen liikkeen kanssa. Mikäli kohtaat ongelmia, koeta heikentää grafiikan laatua asetuksistasi."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Heikentynyt suorituskyky"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Heikentynyt suorituskyky"
