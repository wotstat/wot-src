msgstr "Suurin määrä moduuleja ennen taakuupalkintoa: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Mikäli et avaa kaikkia moduuleita ennen tapahtuman päättymistä, avataan ne automaattisesti."

msgid "infoPage/footer/description/compensation"
msgstr "Mikäli omistat jo kaikki vaunut moduulin mahdollisen sisällön listalta, hyvitetään kaikki seuraavat vaunut, jotka saat moduuleista, kullalla niiden täyden arvon mukaan."

msgid "infoPage/footer/description/guaranteed"
msgstr "Joka %(guaranteed0)s. moduuli sisältää taatusti premium-vaunun. Jos avaat niitä saamatta tällaista vaunua, saat sellaisen premium-vaunun, jota et vielä omista, kun avaat %(guaranteed0)s. moduulin. Kun näin käy, laskuri nollautuu."

msgid "infoPage/header/description"
msgstr "Avaa moduuli saadaksesi mahdollisuuden saada arvokkaita pelihyödykkeitä! Katso lisätietoja alta."

msgid "multipleRewardView/header/subTitle/"
msgstr "\"%(name)\" -arkusta (%(boxesCount) moduulia avattu)"

msgid "noBoxesView/description/"
msgstr "Sinulla ei ole yhtään moduulia. Voit saada niitä\npelinsisäisestä Kaupasta tai Premium-kaupasta."

msgid "preview/backLabel"
msgstr "MODUULEIHIN"

msgid "quantityTitle/boxesAvailable"
msgstr "Moduuleja saatavilla: %(boxesCount)"

