msgid "mode/halloween/battlePassTooltip/body"
msgstr "Tietyt tehtävät {whiteSpanish_open}\"Babylon: Pimeä torni\"{whiteSpanish_close} -tapahtumassa antavat sinulle mahdollisuuden ansaita Taistelupassin pisteitä."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Taistelupassin pisteet"

msgid "mode/halloween/calendar"
msgstr "Tapahtuma kestää %(date)s ajan."

msgid "mode/halloween/calendarDay"
msgstr "Tapahtuman päättymiseen %(date)s."

msgid "mode/halloween/description"
msgstr "Taistele ja kerää materiaa.\nTaisteluita erikoisvaunuilla."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Tietokoneesi suorituskyky ei riitä tähän pelitilaan. Voit kohdata ongelmia grafiikan ja vaunujen liikkumisen kanssa. Pelin kaatuminen on myös todennäköistä."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Heikko suorituskyky"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Heikko suorituskyky"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Tämä pelimuoto vaatii hyvää suorituskykyä tietokoneelta.\nKohtaat ongelmia kartan lataamisen, grafiikoiden ja vaunujen liikkeen kanssa. Mikäli kohtaat ongelmia, koeta heikentää grafiikan laatua asetuksistasi."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Heikentynyt suorituskyky"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Heikentynyt suorituskyky"
