msgstr "* Parantaminen tälle tasolle on saatavilla vain {{@ colorLegacy 'FFE4C0'}}ostetuille{{/}} taistelureserveille {{@ colorLegacy 'FFE4C0'}}\"Kohtalon oikku\"{{/}} -skenaariossa."

msgid "reserveCategories/levels/header"
msgstr "Kuinka avata paikkoja ja parantaa taistelureservejä"

msgid "reserveCategories/levels/text"
msgstr "Oletusarvoisesti sinulle on tarjolla yksi taistelureservi. Muut avataan saavuttamalla kersantin ja luutnantin sotilasarvot. Kaikkia kolmea reserviä parannetaan saavutettaessa kapteenin ja majurin arvot."

msgid "reserveCategories/progression/tableCell"
msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} tai {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}} taso"

