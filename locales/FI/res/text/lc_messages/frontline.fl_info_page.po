msgid "reserveCategories/config/header"
msgstr "Reservikokoonpanot vaunutyypeittäin"

msgid "reserveCategories/config/text"
msgstr "{{@ colorLegacy 'FFE4C0'}}Normaalitaistelussa{{/}} ja {{@ colorLegacy 'FFE4C0'}}Operatiivisessa tuessa{{/}} kaikki kolme taistelureservien paikkaa ovat saatavilla kaikille vaunutyypeille. Järjestys, jossa ne avataan, riippuu kuitenkin vaunutyypistä."

