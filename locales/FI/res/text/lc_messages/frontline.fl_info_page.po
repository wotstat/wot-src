msgstr "Majuri"

msgid "progression/ranksTable/private"
msgstr "Yksityinen"

msgid "progression/ranksTable/sergeant"
msgstr "Kersantti"

msgid "progression/sectionHeader"
msgstr "Edistyminen Etulinjalla"

msgid "progression/text"
msgstr "Tätä pelimuotoa pelatessasi kohoat sotilasarvoissa, etenet Etulinjan edistymisen läpi ja ansaitset palkintoja."

