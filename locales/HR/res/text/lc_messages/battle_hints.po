msgid "hint/LSH_FIRE"
msgstr "Dim otežava otkrivanje neprijateljskih vozila i izvještavanje o njihovim položajima. Vatra nanosi štetu vozilima."

msgid "hint/LSH_FOG"
msgstr "Magla otežava otkrivanje neprijateljskih vozila i izvještavanje o njihovim položajima."

msgid "hint/LSH_RAIN"
msgstr "Pljusak otežava otkrivanje neprijateljskih vozila i izvještavanje o njihovim položajima."

msgid "hint/LSH_SANDSTORM"
msgstr "Pješčana oluja otežava otkrivanje neprijateljskih vozila i izvještavanje o njihovim položajima."

msgid "hint/LSH_SMOKE"
msgstr "Dim otežava otkrivanje neprijateljskih vozila i izvještavanje o njihovim položajima."

msgid "hint/PPH_AIMING_01"
msgstr "Kretanje vozila i kupole umanjuje <font color='#EE7000'>preciznost topa</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Krug oko ciljnika naznačava <font color='#EE7000'>preciznost topa</font>. Pričekajte malo za precizniji hitac."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatsko ciljanje</font> uključeno. Kliknite desnim gumbom miša za otkazivanje."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatsko ciljanje uvijek cilja top <font color='#EE7000'>u središte</font> ciljanog vozila"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Vaša baza se <font color='#EE7000'>osvaja!</font> Ako se ne odbije, neprijateljski tim će dobiti bitku."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Svako neprijateljsko vozila ima <font color='#EE7000'>vlastiti</font> napredak osvajanja."

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Osvajanje</font> neprijateljske baze je jedan od načina pobjeđivanja u bitci"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Kada primite štetu, vaš napredak osvajanja <font color='#EE7000'>se poništava</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Kada napustite krug baze, vaš napredak osvajanja <font color='#EE7000'>se gubi</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Više vozila osvaja bazu <font color='#EE7000'>brže</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Nakon <font color='#EE7000'>trećeg</font> vozila, osvjanja baze se ne ubrzava"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Neprijateljska baza je gotovo osvojena!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Vaš tim pobjeđuje u utrci osvajanja baze!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modul vozila kritično oštećen! Popravite ga korištenjem <font color='#EE7000'>Alata za popravke</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modul vozila kritično oštećen! Popravite ga korištenjem <font color='#EE7000'>Alata za popravke</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Član posade ozlijeđen! Liječite ga <font color='#EE7000'>Priborom za prvu pomoć</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Član posade ozlijeđen! Liječite ga <font color='#EE7000'>Priborom za prvu pomoć</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Posada vozila ošamućena! Liječite ga <font color='#EE7000'>Priborom za prvu pomoć</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vozilo gori! Koristite <font color='#EE7000'>Aparat za gašenje požara</font> na donjoj ploči."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vozilo gori! <font color='#EE7000'>Aparat za automatsko gašenje požara</font> aktiviran."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Modul vozila kritično oštećen! Opremanje <font color='#EE7000'>Alatom za popravke</font> prije bitke pomaže u otklanjanju kritičnih pogodaka."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Član posade ozlijeđen! Opremanj <font color='#EE7000'>Priborom za prvu pomoć</font> prije bitke pomaže u liječenju ozlijeda posade."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Vozilo gori! Opremanje <font color='#EE7000'>Aparatom za gašenje požara</font> prije bitke pomaže u borbi protiv požara."

msgid "hint/PPH_OTHER_01"
msgstr "<font color='#EE7000'>Otkriveni ste</font> - paljba može otkriti vaš položaj!"

msgid "hint/PPH_OTHER_02"
msgstr "Vaše vozilo je uništeno. Možete pritistnuti <font color='#EE7000'>Esc</font> za napuštanje bitke bez kazne."

msgid "hint/PPH_OTHER_03"
msgstr "Vaše vozilo je uništeno. Možete pritisnuti gumb miša za <font color='#EE7000'>gledanje</font> vaših saveznika."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Ikona žarulje</font> označava da vas je neprijatelj opazio!"

msgid "hint/PPH_OTHER_05"
msgstr "Vaš top se još uvijek <font color='#EE7000'>puni</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Vaš top može pucati samo ako je krug oko ciljnika <font color='#EE7000'>potpuno zelen</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Možete pomicati kotačić miša za ulazak u <font color='#EE7000'>snajperski režim</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Možete pomicati kotačić miša za <font color='#EE7000'>izlazak</font> iz snajperskog režima"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Unutarnji zeleni ciljnik</font> označava veliku vjerojatnost probijanja neprijateljskog oklopa"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Čak i kada je unutarnji ciljnik zelen, probijanje oklopa <font color='#EE7000'>nije zajamčeno</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Topvi nisu 100% precizni pa hici ne moraju <font color='#EE7000'>uvijek završiti u sredini</font> ciljnika"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Unutarnji ciljnik označava vjerojatnost probijanja neprijateljskog oklopa. <font color='#EE7000'>Uključite ga u Postavkama</font>."

msgid "penetration/chance/high"
msgstr "Velika vjerojatnost"

msgid "penetration/chance/low"
msgstr "Mala vjerojatnost"

msgid "penetration/chance/medium"
msgstr "Srednja vjerojatnost"
