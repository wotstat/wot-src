msgid "entryPoint/tooltip/description"
msgstr "Ovo su posebne kutije koje sadrže nova i jedinstvena vozila razine VIII-X i više nagrada.\nKutije možete primiti kao poklon za kupnju predmeta u premium prodavaonici, a može se i primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Kutije se trenutno ne mogu otvoriti niti kupiti iz tehničkih razloga. Ispričavamo se zbog privremenih neugodnosti."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kutije Božjeg blagoslova su privremeno nedostupne"

msgid "eventName/lowerCase"
msgstr "Božji blagoslov"

msgid "eventName/upperCase"
msgstr "BOŽJI BLAGOSLOV"

msgid "infoPage/footer/description/autoOpen"
msgstr "Ako ne otvorite sve kutije prije kraja akcije, one će biti automatski otvorene kasnije."

msgid "infoPage/footer/description/compensation"
msgstr "Ako već imate sva vozila iz kutije, dobit ćete odabranu kutiju kao zajamčenu nagradu ili umjesto primljenog vozila."

msgid "infoPage/footer/description/guaranteed"
msgstr "Svaka %(guaranteed0)snebeska, %(guaranteed1)s rajske pomoći i %(guaranteed2)s odabrana kutija jamačno sadrži vozilo razine VIII-X. Ako ih otvorite bez primitka takvog vozila, tada će vozilo razine VIII-X koje još nemate biti primljeno kada otvorite %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. kutiju (ovisno o tipu kutije). Kada primite, brojač se poništava."

msgid "infoPage/footer/title/compensation"
msgstr "Ako sva vozila primljena"

msgid "infoPage/header/description"
msgstr "Otvorite kutije za priliku primitka vrijednih predmeta u igri!\nPogledajte ispod za spisak mogućih nagrada."

msgid "noBoxesView/description/"
msgstr "Nemate nijednu kutiju.\nMožete ih uzeti u premium prodavaonici."

msgid "singleRewardView/tooltip/boxName/"
msgstr "Odabrana kutija"

msgid "singleRewardView/tooltip/description/"
msgstr "Ako već imate sva vozila iz kutije, dobit ćete odabranu kutiju kao zajamčenu nagradu umjesto vozila."

