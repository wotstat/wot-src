msgid "boxTooltip/description/text/bronze"
msgstr "Kada su otvorene, ove kutije vam mogu dati premium vozila razine VIII, valute u igri i ostale vrijedne nagrade."

msgid "boxTooltip/description/text/gold"
msgstr "Kada su otvorene, ove kutije vam mogu dati rijetka vozila razine X, valute u igri i ostale vrijedne nagrade."

msgid "boxTooltip/description/text/silver"
msgstr "Kada su otvorene, ove kutije vam mogu dati premium vozila razine IX, valute u igri i ostale vrijedne nagrade."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Može se dobiti kao poklon za kupnju predmeta u premium prodavaonici, a može se i primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

msgid "boxTooltip/howGet/text/gold"
msgstr "Možete se primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

msgid "boxTooltip/howGet/text/silver"
msgstr "Možete se primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

