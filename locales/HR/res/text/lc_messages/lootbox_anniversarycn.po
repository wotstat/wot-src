msgid "#PluralForms"
msgstr "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"

msgid "boxTooltip/description/text/bronze"
msgstr "Kada su otvorene, ove kutije vam mogu dati vozila, valute u igri i ostale vrijedne nagrade."

msgid "boxTooltip/description/text/gold"
msgstr "Kada su otvoreni, ove kutije vam mogu dati vozila, valute u igri, elemente prilagodbe i ostale vrijedne nagrade."

msgid "boxTooltip/description/text/silver"
msgstr "Kada su otvoreni, ove kutije vam mogu dati vozila, valute u igri, elemente prilagodbe i ostale vrijedne nagrade."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Može se dobiti iz prodavaonice u igri i primiti nakon otvaranja kutija bilo kojeg tipa."

msgid "boxTooltip/howGet/text/gold"
msgstr "Možete se primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

msgid "boxTooltip/howGet/text/silver"
msgstr "Možete se primiti prilikom otvaranja bilo kojeg drugog tipa kutija."

msgid "common/boxCategory/lowerCase/bronze"
msgstr "Kutija s plijenom za nagrade"

msgid "common/boxCategory/lowerCase/gold"
msgstr "Kutija s plijenom od blagodati"

msgid "common/boxCategory/lowerCase/silver"
msgstr "Kutija s plijenom za darivanje"

msgid "common/boxCategory/upperCase/bronze"
msgstr "KUTIJA S PLIJENOM ZA NAGRADE"

msgid "common/boxCategory/upperCase/gold"
msgstr "KUTIJA S PLIJENOM OD BLAGODATI"

msgid "common/boxCategory/upperCase/silver"
msgstr "KUTIJA S PLIJENOM ZA DARIVANJE"

msgid "entryPoint/tooltip/description"
msgstr "Ovo su posebne kutije koje sadrže nove i jedinstvene predmete. Mogu se dobiti u prodavaonici u igri."

msgid "entryPoint/tooltip/timerText"
msgstr "Akcija će završiti za"

msgid "eventName/lowerCase"
msgstr "Trezor šapata"

msgid "eventName/upperCase"
msgstr "TREZOR ŠAPATA"

msgid "guaranteed/tooltip/description1/"
msgstr "Ako sva vozila već imate, umjesto njih ćete dobiti Kutiju s plijenom od blagodati."

msgid "infoPage/footer/description/compensation"
msgstr "Ako već imate sva vozila iz kutija, dobit ćete Kutiju s plijenom od blagodati kao nagradu umjesto vozila."

msgid "infoPage/footer/description/guaranteed"
msgstr "Svaka kutija%(guaranteed0)ss plijenom za nagrade, %(guaranteed1)s s plijenom za darivanje i %(guaranteed2)s s plijenom blagodati jamačno sadrži vozilo. Ako ih otvorite bez primitka takvog vozila, tada će vozilo koje još nemate biti primljeno kada otvorite %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. kutiju (ovisno o tipu kutije). Kada primite, brojač se poništava."

msgid "infoPage/footer/title/compensation"
msgstr "Nadoknada"

msgid "infoPage/footer/title/guaranteed"
msgstr "Zajamčena nagrada"

msgid "infoPage/header/rewards/description"
msgstr "Ne može se dobiti više od jedne nagrade po grupi"
