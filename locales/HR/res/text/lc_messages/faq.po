msgid "answer_1"
msgstr "O: Idi u Garažu i postavi kupljenu opremu u slobodan slot lijevo od slota granata."

msgid "answer_10"
msgstr "O: Odredi neprijateljski položaj i manevriraj vozilo tako da je grm između vas i neprijatelja. Ne brini ako top viri izvan grma; neće te učiniti vidljivijim."

msgid "answer_11"
msgstr "O: Ovo je prodiranje različitih tipova granata na raspolaganju za taj top."

msgid "answer_12"
msgstr "O: Ne, neće nestati, ali neće imati učinka dok član posade nije preobučen za to vozilo."

msgid "answer_13"
msgstr "O: Da. Imat ćeš koristi od oboje."

msgid "answer_14"
msgstr "O: Centriraj pokazivač cilja na neprijateljsko vozilo i pritisni desni gumb miša."

msgid "answer_15"
msgstr "O: Pritisni i drži desnu tipku miša i pogledaj oko sebe."

msgid "answer_16"
msgstr "O: Oslabljuje učinak \"paljenja\" fugasne granate ako granata ne probija oklop. Također smanjuje štetu od udaranja, štiti posadu od ozljeda i smanjuje trajanje ošamućenja."

msgid "answer_17/contains_links"
msgstr "O: {openSupportURL[openTag]:s}Centar Korsiničke Podrške{openSupportURL[closeTag]:s}"

msgid "answer_2"
msgstr "O: Desni klik na vozilo, odaberi \"Prodaj\" i demontiraj svu opremu."

msgid "answer_3"
msgstr "O: Igrač nema razinu ali vozilo ima. Možete vidjeti razinu u donjem dijelu Garaže: rimska brojka u gornjem lijevom kutu ikone vozila."

msgid "answer_4"
msgstr "O: Ne. Nabijač, poboljšan mehanizam topa i stabilizator su montirani na vozilo i ostaju tamo čak i kad je top zamjenjen."

msgid "answer_5"
msgstr "O: Pritisni Shift za uključenje/isključenje režima samohodni top-haubica."

msgid "answer_6"
msgstr "O: Za odabir tipa granate, kliknite na traženu granatu u traci usluge."

msgid "answer_7"
msgstr "O: Kamuflažna mreža utječe na vozilo na koje je montirana. Postaje učinkovita tri sekunde nakon što se vozilo zaustavi i neće nestati nakon bitke."

msgid "answer_8"
msgstr "O: Ne, aparati za gašenje požara nestaju samo ako su korišteni u bitci."

msgid "answer_9"
msgstr "O: Laki tenkovi su dizajnirani za otkrivanje neprijateljskih vozila. Izviđači često obavljaju svoje zadatke bez pokušaja sudjelovanja u borbi s neprijateljem."

msgid "question_1"
msgstr "P: Kupio sam opremu u Prodavaonici. Kako je montiram na moje vozilo?"

msgid "question_10"
msgstr "P: Koji je najbolji način korištenja grmova za skrivanje?"

msgid "question_11"
msgstr "P: Što znače parametri prodiranja u karakteristikama topa, npr., \"112/189/29\"?"

msgid "question_12"
msgstr "P: Ako pošaljem člana posade na drugo vozilo da li će mu nestati dodatne sposobnosti?"

msgid "question_13"
msgstr "P: Ako kupim premium račun i premium vozilo istovremeno, da li ću imat koristi od oboje?"

msgid "question_14"
msgstr "P: Kako uključiti automatsko nišanjenje?"

msgid "question_15"
msgstr "P: Kako gledam oko sebe bez rotacije kupole?"

msgid "question_16"
msgstr "Za što se koristi dvoslojni oklop?"

msgid "question_17"
msgstr "P: Koga moram kontaktirati za tehnička i financijska pitanja?"

msgid "question_2"
msgstr "P: Kako mogu prodati vozilo?"

msgid "question_3"
msgstr "P: Koji je moj nivo?"

msgid "question_4"
msgstr "P: Da li će moj nabijač topa, poboljšani mehanizam topa, stablizator i poboljšano ciljanje biti uništeni nakon zamjene topa?"

msgid "question_5"
msgstr "P: Kako uključim/isključim režim samohodnog topa-haubice?"

msgid "question_6"
msgstr "P: Kako odabirem tip granata prije bitke?"

msgid "question_7"
msgstr "P: Ako kupim maskirnu mrežu da li će biti kompatibilna s mojim vozilima? Da li će nestati nakon bitke?"

msgid "question_8"
msgstr "P: Da li aparati za gašenje požara nestanu nakon bitke?"

msgid "question_9"
msgstr "P: Zašto drugi tipovi vozila ponekad značajno nadmaše moje lake tenkove kada je u pitanju vatrena moć?"
