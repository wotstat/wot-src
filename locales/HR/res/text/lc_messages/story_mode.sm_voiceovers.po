msgid "vo_sm_char11_m03_stg18_03"
msgstr "Pilot: Hej, kopnene snage, ovdje Orao Jedan."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Pilot: Obrušavamo se sada u grad, cijela hrpa tenkova na vidiku."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Pilot: Spremni smo istovariti nešto paketa. Maknite se odatle."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Pilot: Orao Jedan kraj."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Pilot: Ovdje Orao Jedan, jasno i glasno."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Pilot: Imate malu nakupinu meta nabijenih na trgu."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Pilot: Postrojavamo se za prelet sada."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Pilot: Što god ne pretvorimo u vatromet, vaše je. Sretan lov! Prijem."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Pilot: Odakle su se stvorili? Bio sam siguran da je naša zračna potpora očistila nebo."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Pilot: Ovdje Orao Jedan, prijem."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Pilot: Imate lijepu grupu oklopnih vozila u pokretu prema vama iz sela."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Pilot: Preletit ćemo i...prokletstvo!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Pilot: Lovci iza nas...ne mogu otresti ovog lika s repa."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Pilot: Gdje je naša pratnja, dovraga! Aaaaaahhh!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Pilot: Ovdje Mala Burnica."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Pilot: Razumio. Kraljevski Tigar će uskoro imati loš dan."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Pilot: Razvali ga!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Pilot: Neprijatelj uništen."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Pilot: Mala Burnica. Ne Galeb."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Pilot: Vidim ga."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Pilot: Meta uništena za 3...2...1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Pilot: Čekam nove mete, Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Pilot: Prokletstvo!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Pilot: Nije samo Jagdtiger dole. Skriveni su u zgradama."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Pilot: Trebamo nešto jačeg udarca. Vrijeme da pozovemo nešto veće."

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Pilot: To je to! Spreman za slijedećeg!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Pilot: Spreman za napad na tvoj signal."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Pilot: Izravan pogodak!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr "Pilot: Razumio! Uključujem se!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Pilot: Konačno! Idem natrag na aerodrom. Vidimo se uskoro, dečki!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Pilot: Spreman i čekam metu."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Pilot: Čekam potvrdu mete."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Pilot: Potrebne koordinate za ciljni udar."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Pilot: Ne mogu ga pogoditi dok ga ne imobilizraš."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Pilot: Trebam nepokretnu metu za precizan udar."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Pilot: Nepokretnost je ključ uspješnog pogotka!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Pilot: Okrećem se, vraćam se uskoro."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Pilot: Promjena položaja, uskoro sam nazad u akciji."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Pilot: Spreman za napad."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Pilot: Daj znak kada udariti."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Pilot: Još uvijek čekam."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Pilot: Nastavljam čekati upute."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Pilot: Razumio. Postrojavam se za napad."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Pilot: Primljeno. Prilazim za udar."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Pilot: Potvrdno. Zahvaćam cilj."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Pilot: Potvrđujem. Prilazim za pogodak."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smith: Ne sami papir."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smith: Volja milijuna. Muškarci i žene koji su se borili da bi taj papir nešto značio."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smith: Nikad više."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Zapovjednik, satnik Smith: Pokret. Upamtite, ovo je tajna operacija."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smith: Izbjegavajte nepotrebne sukobe i pucajte samo kada je to nužno potrebno."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smith: Ako uzbunimo cijeli garnizon naše šanse su gotovo nikakve."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smith: Kadgod je moguće, pronađite obilazak i sakrijte se."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smith: Nema vremena za gubljenje. Idemo. Svaka sekunda je vrijedna."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smith: Dosta. Ovdje smo da zaustavimo klanje. Za obje strane."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smith: STOP! Unatrag!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smith: Unazad!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smith: Unazad! Brže!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smith: Unatrag, sada!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smith: Sakrij se!"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smith: Izgleda da nas nisu dobro spazili."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smith: Tama je na našoj strani-treba im dulje da identificiraju američki tenk."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smith: Ako prođemo brzo, neće nas otkriti."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smith: Murphy, dovedi nas iza ugla."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smith: Dobro, Murphy. Trebamo mrvicu bliže. I ne pucaj!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smith: Prišuljajmo se bliže. Tako!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smith: Kreći se brzo i neće nas otkriti."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smith: Što brže idemo, to imaju manje vremena da nas otkriju."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smith: Ako se krećemo brzo, neće imati vremena da nas dobro pogledaju."

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smith: Trebamo izviđati naprijed. Dubois, provjeri situaciju."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smith: Rekao sam dosta, Kowalski."

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smith: Kreću. Dubois, vrati se nazad unutra."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smith: Ajmo po te mape. Pokret."

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smith: Prokletstvo! Neprijatelj ravno naprijed. Kowalski, paljba!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smith: Murphy, manevri izbjegavanja. Kowalski, dovrši ga brzo."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smith: Nemamo vremena za zezanje. Trebamo se stišati."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smith: Dosta, Kowalski. Bez Kellera se nećemo probiti do naših dečkiju."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smith: Idemo prije nego se netko pojavi."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smith: Tiger! U zaklon!! Dovraga."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smith: Ne. Ne možemo riskirati. Keller. Pokušaj ga odvratiti."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smith: Daj, Keller. Učini to."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smith: Iskoristi radio da ih prevariš."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smith: Pokret prije nego se vrati."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smith: Dubois, pronađi tu mapu."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smith: Što je?"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smith: Dakle, skupljamo dijeliće mape. Krenimo."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smith: Izvrsno. Murphy, obilježi."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smith: Idemo do slijedeće točke. Vrijeme istječe."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smith: Idemo do slijedećeg položaja."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smith: Krenimo. Svaka minuta je vrijedna."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smith: Dubois, pogledaj da li je mapa tu."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smith: Murphy, kakav nam je napredak?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smith: Barem sada znamo za druge zapovjedne položaje. Pokret."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smith: Dubois? Jesi pronašao nešto?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smith: Pokret do slijedeće točke. Vrijeme istječe."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smith: Dubois, tvoj red."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smith: Idemo do slijedećeg položaja."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smith: Murphy, kakav nam je napredak?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smith: Da vidimo što ćemo pronaći."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smith: Keller, je li ovo zapovjedni položaj?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smith: Povlačenje!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smith: Bez kontakta!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smith: Ne pucaj!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smith: Ne pucaj! Nismo zbog toga tu!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smith: Polako! Naš cilj je isporučiti poruku, a ne započeti krvoproliće!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smith: Sada unatrag! Otkrit će nas!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smith: Povlačenje! Ne smiju nas vidjeti!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smith: Unatrag, Murphy! Drži nas skrivene!!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smith: Neotkriveni. Neka tako ostane."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smith: Neprijatelj nas ne vidi."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smith: Povlačenje, sada! Skoro su nas otkrili!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smith: Povlačenje! Otkrit će nas!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smith: Murphy, pronađi nam zaklon! Još ne znaju tko smo!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smith: Brže! Još nisu sigurni!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smith: Idi u one sjenke!! Nisu nas prepoznali!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smith: Murphy, okreni se! Ili će shvatiti!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smith: Mislim da bi se trebali povući."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smith: Ne smijemo ugroziti zadatak. Povucimo se."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smith: Upamtite naš zadatak!! Ako je povlačenje sigurnije, to ćemo napraviti."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smith: Promjeni položaj. Pročešljat će ovo područje."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smith: Brže. Ovo mjesto će uskoro biti puno pancera."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smith: Promašili su nas. Ostanite tiho i mirno."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smith: Angažirajte mete!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smith: Na borbene položaje!! Ostanite koncentrirani!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smith: Kontakt!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smith: Čisto! Pokret!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smith: Cilj oboren!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smith: Uništen!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smith: Žilavi gad. Slijedeći put ćemo pronaći drugu mogućnost."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smith: Bolje izviditi prije nego uđemo."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smith: Natrag u tenk. Idemo."

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smith: Dosta izviđanja. Krenimo."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smith: Svi gore. Vrijeme je za pokret."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smith: Nemojmo tratiti vrijeme. Kreni."

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smith: Keller ih može odvući lažnom zapovijedi."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smith: Fokus na cilj. Trebamo te dijeliće mape kako bi spasili naše ljude."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smith: Idemo! Nije vrijeme za drijemanje."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smith: Svaka sekunda je bitna. Mičite se."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smith: Nemamo izbora. Moramo se boriti."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smith: Pronađi nam drugi put."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smith: Koristi radio. Odvedi ih od nas."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smith: Čekaj da se pokrene njihova ophodnja."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smith: Tenk je popravljen, ali smo izgubili puno vremena. Ostanite na oprezu."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smith: Pod uzbunom su. Sada će pucati čim nas vide."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smith: Odakle su se stvorili?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smith: Preblizu smo. Guraj naprijed!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smith: Murphy, samo nas dovedi tamo u jednom komadu."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smith: Tiger! Prokletstvo!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smith: Lovi nas."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smith: Ne mogu probiti njegov prednji oklop, a on će nas rasparati kao papir."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smith: Samo se kreći, brzina je naša jedina prednost!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smith: Neprijateljsko topništvo se budi. Trebamo manevrirati!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smith: Samo napravi što možeš."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smith: Tiger je blizu. Drži razmak, Murphy!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smith: Tiger je preblizu! Trebamo se odvojiti!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smith: Povuci se odmah! Ima nas na nišanu!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smith: Naciljao nas je! Izbjegavanje!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smith: Tiger je promašio! Nemoj mu dati drugu priliku!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smith: Čuvaj streljivo! Nema koristi od pucanja u prednji oklop Tigera."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smith: Zaboravi Tigera-koncentriraj se na manje mete."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smith: Gusjenica razvaljena! Nepokretan je!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smith: Topništvo! Oštro udesno!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smith: Topnički udar! Nalijevo!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smith: Dolazi! Potpuno zaustavljanje!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smith: Arti! Izbjegavajući manevri!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smith: Topnička baraža! Okreni se sada!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smith: Ovo možemo riješiti. Kowalski, oružje na gotovs."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smith: Ove se može uništiti. Kowalski, slobodno djeluj."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smith: Ne troši streljivo na Ferdinanda!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smith: Ignoriraj Ferdinanda-ne možemo mu nauditi."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smith: Minsko polje je iza nas. Murphy, gas do daske. Naši dečki čekaju."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smith: Keller, prebaci se na savezničku frekvenciju i spoji me."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smith: Pozor svim jedinicama, ovdje satnik Jack Smith, 2. oklopna divizija."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smith: Približavamo se u M24 Chaffee sa zapada."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smith: Ne pucajte. Ponavljam, ne pucajte."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smith: Imamo hitne zapovijedi iz stožera III. korpusa. Izazov: \"Baklja\". Gotovo."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smith: Doma smo, momci. Ovaj rat je gotov tu."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smith: Dovraga. Sve smo ih iznevjerili."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smith: Previše buke. Palimo svaki radar odavde do Berlina."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smith: Ovo nije streljana. Trebamo biti nevidljiviji."

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smith: Trebamo se kretati tiše. Svaki hitac privlači neželjenu pažnju."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smith: Sva ta buka donosi pojačanja. Nećemo stići na vrijeme do naših dečkiju."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smith: Jesi li uhvatio što?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smith: Dobar?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smith: Ne."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smith: Ulicu? Kako? Navodeći naša imena?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smith: Fokusiraj se na cestu."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keller: Nie wieder."

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Vezist, Gefr. Keller: Ima...zapovjedni položaj odmah izvan grada. Tamo drže mape minskih polja."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keller: Izgleda kao ophodnja. Uskoro bi trebali nastaviti."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keller: Zapovjedni položaj s mapama je tamo gore, na brdu."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keller: To je bio zapovjedni tenk."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keller: Ako je radio netaknut i ugođen na prave frekvencije, mogao bih..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keller: Nein, daj ophodnji lažne zapovjedi. Odvrati ih. Tako da se možemo provući."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keller: Da, satniče Smith."

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keller: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Pozor, Pancer Četiri! Neprijateljska aktivnost u sektoru Točka Berta.)"

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keller: Sofort aufklären!\n(Istraži odmah!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keller: Ovo je zapovjedni položaj."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keller: Ove oznake prikazuju također zapovjedne položaje. Imaju dijeliće mapa prolaza."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keller: Za naše...njemačke izviđače. Trebali bi tamo potražiti."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keller: Ovdje."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keller: Nisu svi časnici odgovorni za minska polja."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keller: Izgleda da smo pronašli još jedan zapovjedni položaj. Trebali bi ga provjeriti."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keller: Da, možda je i tu dijelić mape."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keller: Ne."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keller: Nisu...nisu nas opazili."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keller: Odustali su od potrage...za sada."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keller: Možda ih mogu odvući s puta."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keller: Idemo uživo."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keller: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Pozor! Zauzmi novi položaj u sektoru Berta. Izvrši odmah!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keller: Prospajam."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keller: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Hitna zapovijed! Potrebno je pregrupiranje na točku Dora!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keller: Prebacujem se na njihovu frekvenciju."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keller: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Neprijateljska aktivnost u sektoru Emil! Istražiti odmah!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keller: Odašiljem sada."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keller: Zurückziehen auf Stellung Gustav! Schnell! Schnell!\n(Povući se na poziciju Gustav! Najviši prioritet!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keller: Odašiljam."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keller: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Borbena grupa Sjever javlja neprijateljski kontakt! Potrebna pojačanja!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keller: U dosegu nema nikoga na ovoj frekvenciji."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keller: Nijedna jedinica ne odgovara na ovom području."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keller: Nema njemačkih jedinica u blizini koje bi primile zapovijedi."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keller: Nema odgovora. Nema nijednog njemačkog tenka u blizini. Barem mislim."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keller: Ne."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keller: Ne mogu."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keller: Neće raditi."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keller: To je tenk zapovjednika voda, neće primiti zapovijedi od nas."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keller: Zapovjednik voda...neće primiti zapovijedi od nas."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keller: Tenk zapovjednika voda. Primaju zapovijedi samo od stožera bojne."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keller: Ukopani su tu. Nema smisla zapovijediti im išta."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keller: Ovaj tenk je oštećen. Koriste ga kao streljački položaj."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keller: To je oštećen tenk. Ne mogu se micati."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keller: Gusjenice su slomljene. Ionako će ostati."

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keller: Achtung! Vraćaju se na položaj."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keller: Vraćaju se. Budite oprezni."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keller: Pozor! Okreću se."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keller: Možda bi se trebali...ovaj...uputiti na zapovjedni položaj?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keller: Prije promjene ophodnji?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keller: Pokušat ću ih odvratiti."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keller: To je ophodnja. Uskoro bi se trebali pokrenuti."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keller: Imamo sreće. Sama sudbina želi da izvršimo ovaj zadatak."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keller: Satničke, na radiu javljaju o odmetnutom američkom tenku."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keller: Sada će nas tražiti."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keller: Čujem zapovijedi za...za slanje pojačanja."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keller: Sada nas lovi posebna jedinica..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keller: To je ophodnja. Ako tempiramo, možemo se provući."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keller: Ophodnja slijedi striktnu rutu. Možemo se provući kada odu."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keller: Ophodnja. Uskoro će napustiti ovaj položaj."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keller: Ovi se tenkovi više ne mogu micati, ali ih koriste kao fiksne položaje..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keller: Garnizonu ponestaje rezervnih djelova, ali još koriste ove tenkove kao bunkere."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keller: Nestašica goriva znači da su oni sada samo...samo utvrđenja."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keller: Ali njihovi topovi su još uvijek opasni..."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keller: Satniče...Pancer! Tamo!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keller: Možda...možda bi trebali usporiti?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keller: Da, gospodine."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keller: Ali Krivi toranj Pize je u...Pizi..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keller: Ovaj radio je za komunikaciju. Koristimo ga za odvraćanje ophodnji."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keller: Ne bih želio..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keller: Mogu pokušati. Ali bi to bila njemačka glazba."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keller: Ustvari, iznad 1000 je."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keller: Imam. Tvrdo izvana, mekano iznutra."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keller: Pa...ustvari...dvije posade su raspravljale o duhu koji noću proganja grad."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keller: Ne...nikada nisam mislio da ću biti u bilo kakvom tenku..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keller: Ustvari, prestravljen sam. Samo me je previše strah da to pokažem."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kowalski: Nigdy więcej."

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Topnik, nar. Kowalski: Zašto smo poveli ovog Švabu? Odvest će nas ravno u zamku."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kowalski: Da, naravno, vjerovati Nijemcu koji nas je uveo u zamku u ovaj grad."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kowalski: Pozvati sve Nijemce ovdje?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kowalski: Chaffee nije baš napravljen za takvu borbu. Iako...ako bi Murphy..."

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kowalski: Dobro, ajde više, reci im nešto konačno."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kowalski: Zaboravio si govoriti njemački, Keller?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kowalski: Reci tom Tigeru da se makne odavde!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kowalski: Što? Mislio sam da svaki položaj ima dijelić mape. Keller?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kowalski: Pa, barem smo dodali par Pancera na naš konto."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kowalski: Pa, barem smo dodali par Pancera na naš konto."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kowalski: I našli smo par otmjenih položaja."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kowalski: Što ako je..."

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kowalski: Slijepi idioti."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kowalski: Ha! Kako su nasa promašili?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kowalski: Idemo prije nego se Švabe pojave."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kowalski: Slijepi idioti. Neće dobiti drugu priliku."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kowalski: Konačno! Vrijeme za malo akcije!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kowalski: Čisto. Tko je slijedeći?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kowalski: Jasno!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kowalski: Nisi sada tako snažan, zar ne? Ali, izgubili smo mnogo vremena."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kowalski: Nemojmo juriti naslijepo. Što misliš?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kowalski: Možda Dubois može malo izviditi?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kowalski: Ne."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kowalski: Dosta je traćenja vremena! Ova mapa je karta kroz minsko polje."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kowalski: Pokret ili ću sam početi gurati ovaj tenk!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kowalski: Sami to traže. Pokažimo im gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kowalski: OK, ajmo ovoga puta ne ići ravno na njihove topove."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kowalski: U redu, zagrijavanje je gotovo. Sada idemo za istač."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kowalski: Pogledaj što to imamo tu!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kowalski: Naši topovi će početi pucati svakog trena. Požuri!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kowalski: Dolaze! Opazili su nas!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kowalski: Tiger cilja! Ako ga ne otresemo sada, gotovi smo!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kowalski: Tiger će uskoro zapucati...znam to ciljanje!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kowalski: Kurde! Da sam to bio ja, ne bih promašio."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kowalski: To je sve što imaš, Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kowalski: Świetnie! Točno gdje ga želim!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kowalski: Pogledaj što to imamo tu! Lake mete!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kowalski: Nema koristi. Bilo bi isto da ga gađaš kamenjem!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kowalski: Murphy, jesi li zaboravio? Mine su svuda oko nas!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kowalski: Dostał!"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kowalski: Počinje klaonica. Prespori smo..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kowalski: Samo na vjenčanjima."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kowalski: Je li to prošnja, Murphy?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kowalski: Murphy, ajmo popričati o tvom stilu vožnje."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kowalski: Da li namjerno udaraš svaku rupu i voziš na kosini kako bi se tenk naginjao?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kowalski: Tvoji saveznici također."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kowalski: Nekad me brineš, Murphy."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kowalski: Ozbiljno. Baš brinem za tebe."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kowalski: Ne više."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kowalski: Sumnjam."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kowalski: Za učitelja u tenku si čudno miran, Keller."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kowalski: Ha. To je...iznenađujuće iskreno."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kowalski: Dubois, što to mrmljaš tamo?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Na zapovijed! Pokret na točku Berta!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Razumijem, pokret na Berta.)"

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Na zapovijed, počinjemo pregrupiranje.)"

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Na zapovijed, počinjemo izviđanje.)"

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Razumijem, povlačenje.)"

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Potvrđujem, na putu.)"

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Sharf: Zapovjedniče, imamo ograničenu zračnu potporu na čekanju."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Možete zatražiti udar kada je potrebno."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Svjesni ste radio tehnologije, ne? Cijeli otok već zna da ste tamo."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Ako je moguće, zarobite vozilo netaknuto. Zapovjedništvo ga želi ispitati."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Sliči li nečemu njemačkom?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Uzevši u obzir broj neprijateljskih vozila, mora da su uspostavili postrojenje za održavanje"

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: negdje na ovom otoku."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Brže malo. Raketa neće čekati."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Rekao sam ti da sam trebao biti razmješten s tobom. Napreduješ previše polako."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Pokušajte ga onda onesposobiti bez nanošenja značajne štete. Treba nam taj uzorak netaknut."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni: Samo pokušaj. OK?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Budi iznimno pažljiv. To je zamka."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Otkrili smo njihovu radio frekvenciju."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Pratimo njihov radio promet posljednjih sedam minuta."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Nisi dovoljno dugo prestao pričati kako bih te informirao."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Možda ponekad probaj tišinu, Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni: Novi ciljevi primljeni: to vozilo se mora zarobiti netaknuto."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Što ima? Neki nestandardni modul? Neku posebnu opremu?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Zapovjedniče, jeste li sigurni da ne želite isprobati ovaj novi tenk?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Uzimajući u obzir zasjedu koja nas čeka, dodatna vatrena moć bi nam bila od koristi."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, shvaćaš li da te ne mogu čuti?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Presrećem samo njegov prijenos, ne odašiljam naš."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Izvješće o statusu. Čeka li nas samo njemački oklop?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Kao što sam i sumnjala. Ovo je kompliciranije nego što smo mislili."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: Prema presretnutim komunikacijama..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Podsjetnik: to vozilo se mora zarobiti netaknuto za analizu. Da, dobro..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: Želim ga sama ispitati."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Ispravak: nemamo konačnih dokaza da su Nijemci."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Trenutne obavještajne informacije sugeriraju da se radi o međunarodnoj plačenićkoj grupi."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Taj glas..nešto mi je poznato u vezi njihovog zapovjednika. Negdje sam ga čula prije..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: To bi bilo jako lijepo od tebe."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Da, molim."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Što se desilo?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Upravo zato inzistiram da se ta vozila moraju zarobiti netaknuta."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Donesi mi eksperimentalno vozilo i izgradit ću ti nešto...dojmljivo."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Zapovjedniče, predlažem isprobavanje ovog novog tenka. Mogao bi pružiti jedinstvene borbene mogućnosti."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Pa, možda njegovo ostavljanje tamo nije najbolji izbor."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Zasigurno će ostati netaknut i naši inžinjeri ga mogu povući nakon zadatka."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Ima li među njima kakvih eksperimentalnih strojeva? Išta neobično?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Ova grupa Adler...trebamo ih istražiti."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: Mogli bi pomoći identificirati pozadinu našeg tajnovitog zapovjednika."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Pratimo raketu na našim radarskim sustavima. Vremenski prozor je uzak."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Novi cilj: osigurati centar kontrole leta. Možda ćemo moći promjeniti putanju s udaljenosti."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Izvrši odmah."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Kakva iznenađenja krije ovaj tenk?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Ovaj novi teški tenk ima poboljšani oklop. Optimalan za sučeljavanje s više meta."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Zapovjedniče, predlažem akviziciju."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Naš tehnički tim ide prema sobi kontrole leta. Držite položaj. Treba nam vremena."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Trebamo ih još malo zadržati."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Dobro, dobro...ne sada!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Ne možemo premostiti kontrole. Bez obzira što pokušali ne možemo promjeniti putanju. Ali..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: nešto je čudno ovdje."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Vaš prozor za priliku se brzo zatvara. Ne tratite vrijeme."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Sat zadatka otkucava. Krenite sada."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Što dulje ostajete na mjestu, to će oni imati više vremena za mobilizaciju svojih obrana."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Nastavite ka cilju."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Izgubili smo vodeći tenk. Drži formaciju!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Zapovjednikov tenk je eliminiran! Pripremamo mu novi."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Nemamo neograničena pojačanja. Budite više pažljiviji."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Slijedeći put reagirajte brže ili neće biti slijedećeg puta."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Njihove baze za popravak sadrže ograničeni broj tenkova."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Molim da slijedeći put radite s većom pozornošću."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Cilj nije ostvaren. Isteklo nam je vrijeme."

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Svi tenkovi izgubljeni. Neuspjeh zadatka potvrđen."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Angažirana je značka podrška. Spremite se za udar."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Zrakoplov je napao metu. Udar za nekoliko sekundi."

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Mjesto mete nije važeće za zračnu podršku."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Detektiran topnički udar. Odmah se premjestite!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Neprijateljsko topništvo je pucalo. Udar za nekoliko sekundi. Pokret! Odmah!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Neprijateljski osmatrač upućuje vatru na naš položaj. Odmah se maknite iz zone eksplozije!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Negativno."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Vremenski uvjeti. Oblačno. Temperatura 8 stupnjeva. Brzina vjetra 6 metara u sekundi, sjever-sjeveroistok."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni: Imam teorije. Ali trebam više dokaza prije nego što ih podjelim."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Posljednja osoba koja me nazvala \"draga\" je izgubila dva prsta."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Ali tiha večer na pravom mjestu...mogla bih razmisliti."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, nepotrebno riskiraš."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: A život s previše rizika brzo završava. Kao tvoji prethodnici."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Pametan čovjek."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Shvatit ću to kao kompliment."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: To nije čarolija."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: To je koncentrirani elektromagnetski impuls koji privremeno remeti njihove električne sustave."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Samo se vrati živ. Zamjena obučenog operativca je administrativno opterećenje."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Ako završiš tu rečenicu s bilo kakvom usporedbom sa mnom,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: osobno ću se pobrinuti da je tvoj slijedeći zadatak na Arktiku."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Prošao je. Imam svu dokumentaciju ovdje."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Sve ovo se čini...proračunato."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Svaka barijera, svaka obrana-kupuju vrijeme, ne pokušavaju nas potpuno zaustaviti."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Mislim da igramo ulogu u nečijoj drugoj jednadžbi. A ne volim biti varijabla."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Izračunavam vjerojatnost preživljavanja na temelju trenutnih varijabli zadatka."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Odlučila sam ne dijeliti rezultate. Moral je također varijabla."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Pratila sam ih."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Postoji 23% smanjenja u kvaliteti od početka zadatka, ali 47% povećanja u učestalosti."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Znaj svoje saveznike."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Nikada."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Ova eksperimentalna jedinica je prava prijetnja. Odmah prilagodite taktiku."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Zapovjednikov tenk je uništen. Stroj je učinkovitiji od očekivanog."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Pogledaj ovaj nered! Kao vukovi u toru ovaca."

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Ali kao što kažemo u mojem selu: \"Drugi val ruši branu\"."

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Nijemci...tko bi pomislio?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: Jedan bježi! Moramo ga zaustaviti prije nego dovede prijatelje!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Da, ali sada je sam. Mnogo ga je lakše uništiti nego kada se vrati sa svojim drugovima."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: E, to je više moj stil! Pucaj prvo, saznaj kasnije kakva je to stvar s dugom cijevi!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Jesi li vidio taj hitac?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: To će ga naučiti da se ovdje hvali s tim topom!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Zarobiti? Uz svo dužno poštovanje, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: više mi se sviđa prvo pucati, a poslije ispuniti papirologiju o akviziciji."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Ta stvar nas je skoro pretvorila u staro željezo! Ali, u redu, pokušat ću ne pogodoti ništa bitno..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: samo njegovo spremište streljiva."

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Pogledaj-još jedan tenk koji nikada nisam vidio!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: Trenutno ne znam ni protiv koga se borimo."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Sliči nečemu potpuno suprotnom."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Nadam se da ćemo uskoro pronaći skladište streljiva. Nisam siguran imamo li dovoljno granata za sve njih."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Pao je još jedan! Sviđaju mi se ovi momci!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Stvori liniju, stvori liniju! Jedan po jedan. Imam mali poklon za svakog od vas."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Ide mi na živce! Čekaj, je li se to on popravlja tamo ili što?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Čekaj, čekaj...uskoro ću doći do tebe i rastaviti te vijak po vijak!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Jesi li apsolutno sigurna da se boriš na našoj strani, Leni? Ova stvar nas pokušava ubiti!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Čekaj malo. Vidim...Ti! Ne ZAPOVJEDNIŠTVO. Ti želiš da uzmemo ovaj tenk."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Luda si za...dugačkim topovima koji mogu pogoditi sa udaljenosti!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Oh, uistinu? A odakle točno to znaš, fräulein vidovnjakinjo?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Poslali su ti pozivnicu na zabavu zasjede?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Slušaš njihove komunikacije? I odlučila si nam to SADA spomenuti?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: I ja tebe volim, Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Pogledaj tu ljepoticu! Veličanstvena je!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Ah, nein-nein-nein! Ova osjetljiva oprema nije za mene. Ova ljepota zahtjeva nježan dodir."

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Zapovjedniče, trebali bi sjesti za volan."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Ako ja vozim ovu stvar naši inžinjeri će skupljati komade u kantama!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: To te ja pitam! Spremni smo proći izravno kroz njihovu zamku!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"Kada imaš najveći čekić, svaki problem izgleda kao vrlo mali čavao!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: To nam treba! Vrijeme je za šamaranje, zapovjedniče!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Samo pogledaj ovu zvijer! Zapovjedniče, proći pored nje bi bio zločin!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Možda bi trebali ipak ući unutra, ha?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Oh, ne! To je loš znak! Loš znak za njih, idemo im upropastiti zasjedu!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Mete! Ha! Postaješ predvidljiv, Ulysses. Uvijek iste zapovjedi obuke."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Neprijatelj? TI si neprijatelj!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Hej, herr Negativac, zašto ne dođeš ovdje i obratiš nam se licem u lice?"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Naravno da sam to znao! Samo sam...održavao moral tima na visini."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: Ah, evo najsvirepijeg dijela njihove zasjede."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: Ne mogu probiti naš oklop granatama pa bacaju kamenje na nas."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Pametni prokletnici!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Ne, to je čudan dio. Više ni ne znam protiv koga se borimo."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Konačno! ZASJEDA! Leni, što je još na jelovniku?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Koja još iznenađenja nam sprema gosp. Zli?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Ne, nemoj mi reći! Bez nagovještaja, želim sam vidjeti! Spremni smo za sve što bace na nas!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Bijeg? Kako to misli \"bijeg\"? Ne pokušavamo pobjeći."

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: TEBE hvatamo, gosp. Strašni Glas. I, da, Leni, znam da me ne može čuti."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: Oh, kada se dočepam tog kamperskog štakora, rastavit ću ga na komade!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: To je već bolje. Leni, dat ću sve od sebe."

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! I pao je. Predvidljiv kao švicarski sat-osim što je Nijemac."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Oh, vidi, još suigrača! Zabrinuo sam se da će nam ponestati meta za vježbu!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: Tvoj stari prijatelj? Hoćeš da i njega povedem?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: Da pogodim-i njega želiš netaknutog?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Dat ću sve od sebe."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Ideš! Što je, dovraga, to bilo? U redu, u redu...tamo su me sredili. Nisam vidio da TO dolazi."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Što je, stotinu mu gromova, to bilo?! Elektronika tenka je jednostavno...prestala raditi!"

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Hej, zašto i mi ne počinjemo raditi tenkove s adutima u rukavu?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Ne bi mi škodilo par špijunskih spravica na mojem tenku!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Je li to obećanje, fräulein? Jer te držim za njega!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: Ah, vidim. Neprijatelj je prihvatio strategiju \"ostavi tenkove i nadaj se najboljem\"."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Odvažan potez!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: Primljeno, Ulysses. Sačuvat ću svoj najbolji materijal za kasnije."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Mein Gott, fräulein! Opsjednutija si s tim novim tenkovima"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: od mog ujka Pavela s njegovom zbirkom štapova i grana koje je pronašao širom zemlje!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Iako, moram priznati, ima nekoliko nevjerojatnih."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Ooooh, netko pada! Izgled da su povrijeđeni osjećaji."

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Ne brini, fräulein, obećao sam da ću ti ga isporučiti, zar ne?"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Iako ne mogu jamčiti da će doći bez nekoliko...ogrebotina."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy: Sama ga možeš pitati sva pitanja."

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Sveta majko...ta raketa je veća nego što je izgledala izdaleka!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Kao priče moga ujaka o ribi koju je upecao-osim što ova JE toliko velika!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Ovo...se ne događa. Bili smo tako blizu! Sve ovo...uzalud?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Probit ću svakog od njih i progristi put ravno do kontrolnog središta."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Onda šaljemo tu prokletu raketu ravno u more!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Zapovjedniče, trebali bi srediti tu zvijer."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: Ti prokletnici su možda lansirali svoju raketu, ali neće netaknuti napustiti ovaj otok."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Shvaćam. I meni se sviđa nešto okretnije od tih teških zvijeri."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: Najbolja obrana je ostati pokretan."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Ne ideš nikuda, prokletniče. Jedino mjesto na koje ćeš se \"evakuirati\""

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: je naša soba za ispitivanje. I osobno ću pomoći isporučiti te tamo."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Hajde, daj sve što imaš! Marširaj ovdje-"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: poštedi nas muke da te ganjamo kada ćeš pokušati pobjeći podvijenog repa."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: Završimo to ovdje i sada!"

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Savršeni tajming! Trebao sam se ispuhati."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: Ah, konačno! Naš stari prijatelj s kompleksom velikog ega se odlučio pridružiti zabavi."

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: Vrijeme je da jednom za svagda rješimo naše razmirice. Ostalo je samo jedno pitanje-"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: koji od nas će ga poslati na otpad?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Mislim, u Leninu radionicu."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Pa, to je to. Oh, Leni, draga, znam da si ga htjela netaknutog, ali..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: možda smo mu malo okrznuli boju."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter, ha? Potrudit ću se upamtiti to ime."

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Znaš li kako na češkom zovemo tenkove koji se ne kreću? Vježba gađanja!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: I ne mislim danas postati ničija streljana."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Pod gusjenicama nam raste korjenje! Vrijeme je za pokret!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Kreni ili nestani, zapovjedniče! Pustolovina je pred nama!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Duga cijev se vratila na svoj položaj. Gurni ga dole!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Nazad u svoj brlog, ti dugocijevna pošasti!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Što je, dovraga, ta stvar?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Cijev topa je dulja od spiska propalih brakova moje tete Katarine."

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: I, vjeruj mi, to nešto govori!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Što? Je li u džepu nosi radionicu?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Nevjerojatno! Duga cijev je popravljena! Definitivno smo izbušili tu zvijer!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Zakrpan je! Kako je, dovraga, to učinio?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Prokletstvo! Zapovjednikov tenk je onesposobljen-zabavite ih dok se ne vrati!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Zapovjednik je vani! Držite se, vratit će se začas!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Opet mjenjamo vožnju? Nemojmo to pretvoriti u tradiciju."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: Dobro da imamo rezerve, ali nemojte izazivati sreću."

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Hej! Polako! Mislim da nam nisu ostavili previše svojih igračaka!"

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Pokušajte sačuvati ovoga u jednom komadu."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Dovraga! Sredili su me! Nemojte se previše zabavljati bez mene!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Moja vožnja je otišla, uzet ću drugu!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Bum! Ali ovaj put sam ja! Ne miči se, vratit ću se!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: Dovraga! Ta obrasla zvijer me je čak i sredila!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Dobro, veliki momče, ovaj put si pobjedio...ali, vratit ću se!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Pozdrav, svijete! To sam opet ja! Jesam li vam nedostajao?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Vratio sam se. Novi tenk. Stari je imao čudno lupanje u motoru...i previše rupa."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: Prokletstvo! Gotov sam. Skinite par komada za mene, može?"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Što? Kako? Ne, ne, ne...to ne može biti. Izgubili smo? Ne vjerujem."

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Pa, odoše svi naši tenkovi...Bijesan sam! Potpuno sam bijesan!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Opa, vidi tko se pojavio na zabavi."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Ta stvarčica izgleda skupoo. Da vidimo koliko dobro gori."

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BUM! Leni, šteta što ne možeš vidjeti kako je zapovjednik upravo skinuo onaj prototip."

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Bravo, zapovjedniče! Nadam se da su zadržali račun-nije učinkovit kao što su mislili."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Toliko priče...Prototip ovo, napredna tehnologija ono..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Uništio sam ga! Njihovo terensko testiranje je pošlo po krivu!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Idemo! Vrijeme je za lomljenje oklopa!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Topovi na gotovs'! Dajmo im pravu dobrodošlicu!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: To je to, gotovi smo ovdje-pokret!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Pao je i posljednji-ne tratimo vrijeme, pokret, pokret!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Pa, to je riješeno-tko je slijedeći?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Bum! Ovaj nas više neće smetati!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Još jedan jede prašinu! Dobar posao!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Tako se to radi-pronađimo ti novu metu!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: Prekriži još jednog-tko je tvoja slijedeća meta?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Ovaj je moj!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Sredio sam ga!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Slijedeći, molim!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Dolazi vatromet! Zavalimo se i uživajmo u predstavi!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Idu bombe! Da vidimo kako im se sviđa malo kiše odozgo."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Naši piloti ne mogu izvoditi čuda!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Pa, to je šokantan razvoj događaja!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Paf! Sada su glineni golubovi-poskidajmo ih!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Izgleda da im je malo nestalo struje!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: Sprežni su! Vrijeme je da ih pregazimo!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Modularni oklop čini svoju čaroliju! Kao što kaže moj ujak Pavel,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"Dobar mehaničar može popraviti sve osim slomljenog srca!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Čuda modernog inžinjerstva!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Promjena oklopnih ploča brže nego što moja baka promjeni mišljenje!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Tvoj tenk je kao nov! Blistav i bez dodatnih rupa."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Zamjenili ste te oklopne ploče, ha? Sada tvoj tenk više ne izgleda kao švicarski sir."

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Mnogo manje primamljiv!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Netko s dalekozorom i radiom nas promatra! Miči svoje gusjenice otamo!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Taj podli topnički osmatrač nas je opazio! Kreni! Kreni!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Njihov promatrač boji tvoj tenk nevidljivim ciljnicima! Vrijeme je da ga razočaramo! Pokret!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Dolazi bum! Kreni ako ne želiš biti dio krajolika!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: Pozvali su velike topove! Bolje da se pokreneš!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Brzo! Pogodi ih sa svojim otmjenim granatama dok se hvališu!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Taj tenk nešto smjera! Ugasi prije nego završi!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Pogledaj to! Krpaju se poput čarolije! Popravit ćemo to!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, voljela bi ovu tehnologiju! Popravljaju same sebe usred bitke!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Da donesem natrag uzorak?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Ideš! Ovaj misli da je trkači auto! Ne daj mu da ti poljubi oklop!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Što dovraga...?! Je li pričvrstio raketu na svoj tenk?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: Spržili su tvoje otmjene spravice, zapovjedniče! Natrag na tenkiranje stare škole!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Posebna čarolija vašeg tenka je gotova, zapovjedniče! Pogodili su vas protu-zabavnim granatama!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni, brzo pitanje-zna li naša obavještajna koliko je neprijatelja na ovom otoku?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Znaju li išta?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: I to je nešto!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy: Ti plaćenici imaju bolju opremu nego mi! Netko ih podržava s ozbiljnim novcem."

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Uuu...misteriozno! Volim kada ste tajnoviti!"

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni, draga, kada rat završi, vodim te u Prag."

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Ima mala krčma-najbolji pereci, gulaš,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: mjesto gdje se samo zavališ i uživaš u večeri. Prenapeta si!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Život bez rizika je kao gulaš bez paprike-bezukusan i razočaravajući!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Čekaj...što? Bio je prethodnik? Što mu se desilo? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Moj djed je uvijek govorio: \"Vjeruj svojim instinktima, ali dvaput provjeri streljivo.\""

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Svidjela bi mu se. Uvijek je cjenio opasne žene."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Apsolutno je!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Ovo eksperimentalno streljivo je nevjeorjatno! Način na koji onesposobljava njihove sustave je poput čarolije!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Mora da si sjajna na dječjim rođendanskim zabavama."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: \"To nije zec, djeco, to je samo udomaćeni Oryctolagus cuniculus.\""

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Hej, Leni, kada rat završi, kakav bi htjela suvenir?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Razmišljam da ti donesem cijev topa onog snajperskog tenka."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Izgleda da ti se sviđaju ta sva dalekometna oružja."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Je li to \"Stalo mi je do tebe\" na njemačkom? Dirnut sam!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni, da si ovdje, cjenila bi koliko je lijep ovaj eksperimentalni tenk."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Glatke linije, snažan motor, baš kako..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: ...baš kako bi njemačko inžinjerstvo trebalo biti! Što si mislila da ću reći?"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Čuvati streljivo? Što je slijedeće, ponovno korištenje vrećica čaja? Pranje plastičnih žlica? Sušenje papirnatih ručnika?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Kladim se da u pet dolara da naš tajnoviti plaćenički zapovjednik sa zastrašujućim glasom ima otmjene brkove."

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Svi pravi zlikovci imaju brkove."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Deset dolara da ih uvrće kada misli da ga nitko ne promatra."

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Jeste li primjetili njihovu formaciju! Naši prijatelji su čitali vojne priručnike."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Prvo poglavlje: \"Kako postati opkoljen i biti uništen u tri laka koraka.\""

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Prevelika samouvjerenost, nesposobnost-oboje završava s istom eksplozijom, prijatelju."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Znaš li što je čudno? Ustvari uživam u ovom zadatku."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Slikoviti krajobrazi, neobični novi tenkovi, tajnoviti neprijatelji..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Nazvao bih ovo \"aktivnim odmorom\"!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Psihološka procjena? Trebali smo imati psihološku procjenu?"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: Ah...dakle, ono čavrljanje s finom gospođom je bila procjena..."

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: O čemu pričaš?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Šališ se, zar ne?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Ha! Njihova elitna jedinica i nije baš tako elitna!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Još samo nekoliko neprijatelja između nas i te rakete."

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Moja baka bi raščistila ovu stazu s drvenom žlicom!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Dovraga! Ta obrasla zvijer je sredila zapovjednika-ovo je postalo osobno!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Ta stvar je ustvari sredila zapovjednika? U redu, sada sam bijesan!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Corvin: Ulysses ovdje. Iskrcali smo se. Dovraga...plaža je groblje tenkova."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Nema preživjelih iz prvog vala. Ne smijemo tratiti vrijeme."

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Trebamo doći do zapovjednog centra i zaustaviti lansiranje pod svaku cijenu."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Kontakt sprijeda! Njemački tenkovi, 11 sati. Slobodna paljba."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Novi kontakt! Potiskujuća paljba!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Povlači se."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Trebamo se nastaviti kretati. Na ovoj udaljenosti nemamo šanse protiv te vatrene moći."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Trebamo smanjiti razmak, pronaći način za obuhvat s boka. Guraj naprijed!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Ostani koncentriran! Moramo prvo ovdje eliminirati neprijatelje."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Kasnije ćemo se pobrinuti za smutljivca duge cijevi."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Novi neprijatelji otkriveni naprijed."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Dovraga, ovaj put ih je više."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Imali smo manje šanse u Sjevernoj Afrci. Nastavi gurati naprijed, probit ćemo se."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Radimo zajedno. Ciljajte njihove bokove."

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Dugocijevni se vratio! Potiskujuća paljba, SADA!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Nastavi se kretati. Najbrži put do rakete je kroz ovu tvornicu."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Drži položaj. Izgleda da samo pronašli nešto...zanimljivo."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Napušteni tenkovi. Nepoznati modeli."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: Ove granate izgledaju kao eksperimentalne. Vjerojatno će privremeno onesposobiti neprijateljska vozila."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Zapovjedniče, taj eksperimentalni tenk bi nam mogao dati taktičku prednost."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Toplo preporučujem da preuzmete kontrolu."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Pazi!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Pozor naprijed! Višestruki!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Jasne zapovjedi poput ovih nas drže na životu, moj veseli prijatelju."

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Oprez!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: Pokrenuli su se da nas okruže. Zauzmite svoje položaje!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Nema vremena za duge bitke. Budite brzi i odlučni!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Pazi na onu rupu u zidu. Naš prijatelj u sredini nas može pogoditi kroz nju. Ostani u zaklonu."

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Nema vremena za raspravu. Vrijeme ide, pokret, pokret!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Nova prijetnja identificirana. Koriste neku vrstu eksperimentalnog streljiva"

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: koje privremeno onesposobljava elektroniku našeg vozila."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Ovo nisu standardni plaćenici-imaju naprednu tehnologiju koju još nikada nismo vidjeli."

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Pogledaj tamo, još jedna terenska servisna stanica...i opet tenkovi koje ne mogu identificirati."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: Izvrstan pronalazak."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Ovaj tenk je opremljen nekakvim modularnim oklopnim pločama koje se mogu brzo zamjeniti na terenu."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Moglo bi biti korisno."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Sada bi trebali prilagoditi našu taktiku."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy i ja idemo na vrh dok ćeš ti pružiti vatrenu podršku iz pozadine."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: To će više čuvati novi tenk i tebi omogućiti maksimalno iskorištenje tog dojmljivog topa."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Izgleda da je Adler-Gruppe neka vrsta elitne jedinice,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: daleko opasnija od svega na što smo dosad naišli."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, vrijeme je da se šale ostave postrani i da im pokažemo od čega smo napravljeni."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Naš glavni cilj je zaustavljanje lansiranja rakete. Sve ostalo je na drugom mjestu."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Ne dajte se omesti."

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Skoro smo na cilju. Još jedan zadnji poguranac!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Ne! NE! DOVRAGA, NE!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Nismo uspjeli spriječiti lansiranje. Projektil se penje."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Potvrđujem."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: Naprijed je još jedna terenska baza za popravke. Tamo su i nepoznati teški tenkovi."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Izgleda da su značajnije oklopljeni nego bilo što na što smo naišli do sada."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Iznenađenje je...da nema ništa posebno oko toga."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: Dobro, osim neobično jakog oklopa i neobično male brzine."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: I to nam točno sada treba."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Lansirno mjesto osigurano. Držimo položaj na ulazu u bunker."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Dolaze novi neprijatelji. Premještamo se na bolji obrambeni položaj."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Pa, Teddy, želja ti se ispunila. Izgleda da svi dolaze ovdje umjesto da se evakuiraju."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Izgleda da je ovo do sada najveći val."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Opaženo kretanje u sredini. Vratio se prototip s velikom cijevi."

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, kakvo je stanje te rakete?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Kako to misliš?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Ostani miran i završit ćemo kao prvi val. Krenimo."

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Na normi smo. Vrijeme je za napredovanje."

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Mirovanje nas čini glinenim golubovima. Pokret."

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Kontakt u sredini! Drži ga prikovanim!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Vratio se snajper-drži pritisak, ne daj mu čisti hitac!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Lovac na tenkove u sredini-popravljen i ispravan!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Kako su tako brzo popravili štetu?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Ostanite na oprezu! Zapovjednik je vani, ali ne zadugo!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Zapovjednik je pogođen! Nastavite gurati, vratit će se uskoro!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Nazad ste u borbi, savršeno! Ali budimo sada oprezniji!"

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: To je bilo preblizu. Hajdemo slijedeći put tenk zadržati netaknutim, može?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: Ove baze za popravke nemaju neograničene količine novih tenkova."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Budite pažljiviji sljedeći put."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Dovraga! Pogođen sam! Brzo ću se vratiti."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: Dohvatili su me! Ostanite u borbi, vrati ću se!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Pogođen! Nastavite gurati-brzo sam natrag!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Izbačen. Dovraga, ovaj stvar je žilavija od ostalih."

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Primio izravan pogodak...ovi novi tenkovi nisu šala."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Vratio sam se. Nadam se ovaj put bez iznenađenja."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Nazad u borbi. Prokletstvo...ponekad ih je jednostavno previše."

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Ulysses: Moj tenk je pogođen. Izvan stroja sam-završite zadatak pod svaku cijenu!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Prokletstvo...prespori smo. Za ovo smo mi krivi."

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: To je to. Nemamo više tenkova. Borba je gotova."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Stižu neprijateljska pojačanja. Spremite se."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Novi neprijatelji primjećeni. Ovo nije običan tenk-ostanite na oprezu."

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Dobar hitac! Eksperimentalna jedinica uništena. Jedan problem manje."

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Lijepo učinjeno! To je to od njihove šminkerske igračke. Držimo pritisak."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Velika meta neutralizirana. Da vidimo što još imaju."

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Njihovo najbolje jednostavno nije dovoljno dobro. Završimo ovu borbu."

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Kontakt! Slobodna paljba!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Borba protiv neprijatelja.Pozor!"

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Posljednja meta uništena-pokret."

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: To je posljednji-područje je čisto, idemo."

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Neprijateljska grupa neutralizirana, vrijeme je za napredovanje."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Meta neutralizirana."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Neprijatelj eliminiran."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Dobar pogodak!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Eliminirao sam prijetnju."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Imam ga."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Pokrio sam te, pogurni ih!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Dolazi zračna potpora. Spremi se za udar."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Udar potvrđen. Držite se podalje od zone udara."

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Zračna potpora ne može pogoditi taj položaj. Podesite svoje koordinate ciljanja."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Meta ošamućena-sada je naša prilika da ih udarimo jako!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Neprijateljski sustavi su osakaćeni. Dokrajčite ih!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Neprijateljske posebne mogućnosti su onesposobljene. Napad! Sada!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Vaš proboj trupa je začepljen. Borbena učinkovitost se vratila na optimalne razine."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Modularni oklop zamjenjen. Vaše vozilo je ponovo spremno za borbu."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Oklopne ploče zamjenjene. Vaše razine zaštite su sada na osnovnim standardima."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Vaš oklop je popravljen! Nastavite sa zadatkom."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Opažen je topnički osmatrač! Odmah raščistite područje udara!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Dolazi topništvo! Pokret-SADA!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Dolazi neprijateljsko topništvo! Imamo par sekundi prije pogotka-pokret!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: Razmještaju eksperimentalne sustave. Ometajte ih! Koristite svoje posebno streljivo sada!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Meta priprema poseban napad. Ošamutite ga prije nego završi."

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Neprijatelj se sam popravlja. To nije dobro."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: Provode popravke na bojištu. Trebamo isporučiti štetu brže nego što je mogu popraviti."

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Neprijatelj ubrzava na brzinu sudaranja! Manevri izbjegavanja!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Neprijatelj se približava punom brzinom. Ne dajte da ostvare kontakt."

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Zapovjedniče, pogodili su vaše sučelje sustava! Elektronička oprema privremeno izvan stroja."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Izravan hitac na upravljačke module. Vaša moderna elektronika je privremeno izvan stroja."

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, treba čuvati streljivo. Manje pucaj, gađaj slabe točke."

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Ne vidim nikakvog smisla u bespredmetnoj špekulaciji i okladama."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Njihov razmještaj ukazuje na preveliko samopouzdanje, a ne nesposobnost. Nemojte ih potcjeniti."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, tvoj koncept rekreacije iziskuje ozbiljno razmatranje."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Jeste li sigurni da si prošao psihološku procjenu prije ovog zadatka?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Misliš da se s nama manipulira?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, neobično si tiha. O čemu razmišljaš?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: I?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, trebam tvoju iskrenu procjenu. Da li su Teddyeve šale bolje ili lošije?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Ti zapravo analiziraš njegove šale?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: Gurnimo naprijed-približavamo se mjestu lansiranja. Trebamo ga osigurati prije lansiranja."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Zapovjednik je pao! To novo vozilo se pokazuje kao pravi problem."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Ulysses: Potcjenili smo tu stvar. Ostanite koncentrirani, zapovjednik će se uskoro vratiti."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Izgleda da glavni top ovog tenka ima sposobnost pojačavanja štete."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Pod određenim uvjetima može isporučiti izvanrednu štetu kada je ispravno razmješten."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Upravo što nam treba protiv tih teških jedinica."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: I pogledaj naoružanje. Glavni top tenka izgleda da ima sposobnost pojačavanja štete."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Pod određenim uvjetima može isporučiti izvanrednu štetu kada je ispravno razmješten."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Upravo što nam treba protiv tih teških jedinica."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Ovaj tenk ima sustave preciznog ciljanja."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Izgleda da ako što dulje ostaješ miran da hici postaju sve precizniji."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Savršeno za dalekometna sučeljavanja."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Ali što je zanimljivije je da ovaj tenk ima sustave preciznog ciljanja."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Izgleda da ako što dulje ostaješ miran da hici postaju sve precizniji."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Savršeno za dalekometna sučeljavanja."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Zanimljivo: ovaj ima instalirano i sekundarno naoružanje."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Možeš održavati potiskujuću paljbu dok se puni glavni top."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Taktička prednost protiv slabog oklopa."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: Ah, dobro. Još nešto. Ovaj ima instalirano i sekundarno naoružanje."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Možeš održavati potiskujuću paljbu dok se puni glavni top."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Taktička prednost protiv slabog oklopa."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Ovo vozilo ima nešto nestandardne opreme. To nisu standardne modifikacije-"

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: ovdje je napravljeno nešto posebno. Odvedite ga na testnu vožnju, zapovjedniče."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Pogledajte što može ta tehnologija."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: U sustave ovog tenka je ugrađena napredna tehnologija."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Trebali bi iskoristiti ove mogućnosti do njihovog punog potencijala."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Zapovjedniče, eksperimentirajte s kontrolama-otkrijte što ovi sustavi mogu u borbi."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Izrada ovog prototipa je izvanredna. Ovo nisu standardna poboljšanja na bojištu-"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: ovo mijenja sve. Iskušajte ga, zapovjedniče."

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Pogurajta ove sustave do njihovih granica i pokažite našim suparnicima što njihova tehnologija može."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "Neprijatelj je zarobio jedan prototip našeg vozila. Pažljivo identificirajte mete."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta i Dora, uključite se oprezno. Zadržite ih što je duže moguće."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Neprijateljske snage se približavaju tvornici. Kampfgruppe Berta i Dora, uključite se."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Zadržite ih što je duže moguće."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Tim Zeppelin, pozor. Pokrenite se ka tvornici. Zauzmite obrambeni položaj i držite ga."

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, zadržite vatrenu kontrolu nad izlazima. Ne dajte da pobjegnu iz postrojenja."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Započnite Protokol Valkira. Sve jedinice potvrdite."

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Sve jedinice, zauzmite obrambene položaje. Adler-Gruppe, uključi se."

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Sve jedinice. Uključite se protiv neprijatelja. Dvostruka nagrada za one koji ih eliminiraju."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Što dovraga...?! Arhitekt, nismo spremni! Još ima tenkova u zoni udara!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Sve jedinice, izvucite se sa mjesta lansiranja-SADA!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Dovraga! Dovraga!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Sve preostale jedinice, maknite se izvan polumjera udara! Pokrivajte lansiranje! Držite liniju!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Sve preostale jedinice-prema zapovjednom središtu. Uključite se protiv neprijatelja. Zadržite ih u bitci."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Zadržite obrambene položaje do daljnjih zapovjedi. Nakon zapovjedi, povucite se na evakuacijske točke."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Znam da me čujete. Nisam očekivao sučeljavanje s takvim suparnicima."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Ali sada sam proučio vašu taktiku, vaše mogućnosti. Naš slijedeći susret će biti potpuno različit."

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter gotov."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "Prije pet dana smo izgubili kontakt s tajnim vojno-svemirskim kompleksom u Norveškom moru."

msgid "vo_sm_norway_intro_02"
msgstr "Pilot izviđačkog zrakoplova je izvjestio o tragovima bitke"

msgid "vo_sm_norway_intro_03"
msgstr "i djelomičnom uništenju industrijskih zgrada na lokaciji."

msgid "vo_sm_norway_intro_04"
msgstr "Ali, najvažnije, opisao je raketu spremnu za lansiranje na lansirnoj rampi,"

msgid "vo_sm_norway_intro_05"
msgstr "točno prije nego smo izgubili komunikaciju s njim."

msgid "vo_sm_norway_intro_06"
msgstr "U istragu lokacije je poslana ekipa za brzi odaziv."

msgid "vo_sm_norway_outro_01"
msgstr "Što smo smatrali oružjem ispada da je nešto mnogo opasnije."

msgid "vo_sm_norway_outro_02"
msgstr "Raketa je u orbitu lansirala umjetni satelit"

msgid "vo_sm_norway_outro_03"
msgstr "koji je počeo odašiljati tajnu dokumentaciju Reicha:"

msgid "vo_sm_norway_outro_04"
msgstr "nacrte naprednih tehnologija"

msgid "vo_sm_norway_outro_05"
msgstr "i koordinate tajne vojne baze s gotovim uzorcima oružja."

msgid "vo_sm_norway_outro_06"
msgstr "Čovjek iza ovih poziva se naziva Arhitekt."

msgid "vo_sm_norway_outro_07"
msgstr "Njegovi motivi nisu potpuno jasni, ali njegova djela su već počela mijenjati svjetski poredak."

msgid "vo_sm_norway_outro_08"
msgstr "Kako bi poništili ovu prijetnju, trebamo snage sposobne obraniti svijet od nadolazećeg kaosa."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Pozor! Pozor!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Obraćamo se svim vojnicima i časnicima Wehrmachta, Luftwaffe i Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Njemačko vrhovno zapopvjedništvo je potpisalo bezuvjetnu predaju.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Rat je gotov...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Pozivamo one koji još pružaju besmisleni otpor;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Da polože svoje oružje i predaju se postrojbama Saveznika.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Vaši životi će biti potrebni za izgradnju nove, obnovljenje Njemačke...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(To je još samo jedan trik.)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Borit ćemo se dok ne dobijemo zapovijed od zapovjedništva.)"
