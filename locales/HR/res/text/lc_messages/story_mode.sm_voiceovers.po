msgid "vo_ob_char01_intro_01"
msgstr "Brooks: Mrzim Tigrove."

msgid "vo_ob_char01_intro_03"
msgstr "Brooks: Narednik Brooks, 2. oklopna. I mi smo naletili na Tigra."

msgid "vo_ob_char01_intro_03_01"
msgstr "Brooks: Sada nas je dvoje."

msgid "vo_ob_char01_intro_05"
msgstr "Brooks: Pođite s nama. Več je počeo napad na grad..."

msgid "vo_ob_char01_intro_05_01"
msgstr "Brooks: Trebamo požuriti."

msgid "vo_ob_char01_intro_07"
msgstr "Brooks: Nešto takvo."

msgid "vo_ob_char01_intro_09"
msgstr "Brooks: I treba li \"Betsy\" utjerati strah u kosti neprijateljima?"

msgid "vo_ob_char01_intro_11"
msgstr "Brooks: Neprijatelj ispred nas!"

msgid "vo_ob_char01_intro_12"
msgstr "Brooks: Prvo sredi Stuga!"

msgid "vo_ob_char01_intro_17"
msgstr "Brooks: Hajdemo prvo zauizeti grad pa ćemo vidjeti..."

msgid "vo_ob_char01_m01_stg00_01"
msgstr "Brooks: Nemamo vremena za gubljenje. Pokret."

msgid "vo_ob_char01_m01_stg00_02"
msgstr "Brooks: Probudi se! Idemo naprijed."

msgid "vo_ob_char01_m01_stg00_03"
msgstr "Brooks: Drži priključak, Sherman."

msgid "vo_ob_char01_m01_stg00_04"
msgstr "Brooks: Trebaju nas u gradu, hajde."

msgid "vo_ob_char01_m01_stg00_05"
msgstr "Brooks: Naprijed, naprijed, naprijed!"

msgid "vo_ob_char01_m01_stg010_01"
msgstr "Brooks: Samohodni top ispred nas. Uništi ga pod hitno!"

msgid "vo_ob_char01_m01_stg010_04"
msgstr "Brooks: Sređeni su! Dobar posao, Sherman."

msgid "vo_ob_char01_m01_stg011_01"
msgstr "Brooks: Vod-novi neprijatelj!"

msgid "vo_ob_char01_m01_stg012_02"
msgstr "Brooks: Pokret u sredinu. Koncentriraj se."

msgid "vo_ob_char01_m01_stg014_01"
msgstr "Brooks: Bravo. Hajdemo sada počistiti posljednji trg. Naprijed!"

msgid "vo_ob_char01_m01_stg015_01"
msgstr "Brooks: Pozor! Više neprijatelja nego što smo očekivali!"

msgid "vo_ob_char01_m01_stg015_05"
msgstr "Brooks: Nova neprijateljska grupa! Ne daj da te zaokruže, Srećko!"

msgid "vo_ob_char01_m01_stg016_02"
msgstr "Brooks: Hvala na pomoći. Dobili smo ovu bitku, ali još je bitaka pred nama."

msgid "vo_ob_char01_m01_stg016_04"
msgstr "Brooks: No, no, Betsy..."

msgid "vo_ob_char01_m01_stg01_01"
msgstr "Brooks: Napad je več počeo, trebamo požuriti."

msgid "vo_ob_char01_m01_stg01_03"
msgstr "Brooks: U čast tvojeg djeda?"

msgid "vo_ob_char01_m01_stg01_07"
msgstr "Brooks: Sherman, za nama. Nemojmo više tratiti vrijeme."

msgid "vo_ob_char01_m01_stg02_04"
msgstr "Brooks: Zvuči previše njemački."

msgid "vo_ob_char01_m01_stg03_01"
msgstr "Brooks: Neprijatelj desno ispred nas! Slobodna paljba!"

msgid "vo_ob_char01_m01_stg03_02"
msgstr "Brooks: Neprijatelj ravno ispred nas! Slobodna paljba!"

msgid "vo_ob_char01_m01_stg04_01"
msgstr "Brooks: Uništen. Krenimo u grad."

msgid "vo_ob_char01_m01_stg04_03"
msgstr "Brooks: Usađuje strah...ali nije baš originalan."

msgid "vo_ob_char01_m01_stg05_01"
msgstr "Brooks: Kreni, kreni! Saveznici na čekaju."

msgid "vo_ob_char01_m01_stg06_01"
msgstr "Brooks: Dva suparnika ispred nas. Paljba!"

msgid "vo_ob_char01_m01_stg07_02"
msgstr "Brooks: Pažljivo gledaj, zapovjedniče! Idemo ih zaobići s desne strane."

msgid "vo_ob_char01_m01_stg08_01"
msgstr "Brooks: Eno njemačkog tenka. Paljba AP granatama!"

msgid "vo_ob_char01_m02_stg01_01"
msgstr "Brooks: Pokret. Svi budite na oprezu. Zrakoplovstvo udara po gradu."

msgid "vo_ob_char01_m02_stg01_01_01"
msgstr "Brooks: Ali još uvijek je puno neprijateljskih vozila."

msgid "vo_ob_char01_m02_stg01_03"
msgstr "Brooks: Ne uzbuđuj se previše, MacLeod. To je..."

msgid "vo_ob_char01_m02_stg01_03_01"
msgstr "Brooks: Dovraga! Evo našeg prvog jurišnog odreda. Je li to bio Tiger?"

msgid "vo_ob_char01_m02_stg02_01"
msgstr "Brooks: I evo ih!"

msgid "vo_ob_char01_m02_stg02_03"
msgstr "Brooks: Koncentriraj se, MacLeod!"

msgid "vo_ob_char01_m02_stg03_01"
msgstr "Brooks: VK na drugoj obali! Slobodna paljba!"

msgid "vo_ob_char01_m02_stg04_02"
msgstr "Brooks: Ovo je prvi put da čujem da moliš za metu."

msgid "vo_ob_char01_m02_stg05_01"
msgstr "Brooks: Most je blokiran. Moramo okolo."

msgid "vo_ob_char01_m02_stg05_03"
msgstr "Brooks: Optimizam je dobra priprema za zadatak. Blizu je plićak."

msgid "vo_ob_char01_m02_stg05_04"
msgstr "Brooks: Prokleti si vračar. Kako si to napravio?"

msgid "vo_ob_char01_m02_stg05_06"
msgstr "Brooks: Zašto nas nisi upozorio? To je bio neprijatelj."

msgid "vo_ob_char01_m02_stg06_01"
msgstr "Brooks: Neprijatelj ispred nas!"

msgid "vo_ob_char01_m02_stg06_01_01"
msgstr "Brooks: Čuvaj granate, Srećko! Ne pucaj napamet, koristi optiku."

msgid "vo_ob_char01_m02_stg06_03"
msgstr "Brooks: Dokrajčimo ih i pokret."

msgid "vo_ob_char01_m02_stg06_03_01"
msgstr "Brooks: Moramo dostići drugi jurišni odred."

msgid "vo_ob_char01_m02_stg07_02"
msgstr "Brooks: Samo ne paničari. Tiger je Tiger."

msgid "vo_ob_char01_m02_stg07_02_01"
msgstr "Brooks: Nevjerojatno su opasni."

msgid "vo_ob_char01_m02_stg07_04"
msgstr "Brooks: Opet ti o medalji! Jesi li tu samo zbog odlikovanja?"

msgid "vo_ob_char01_m02_stg08_01"
msgstr "Brooks: Dobre vijesti: uhvatili smo drugu grupu."

msgid "vo_ob_char01_m02_stg08_02"
msgstr "Brooks: Dovraga! Obuhvat! Obuhvat!"

msgid "vo_ob_char01_m02_stg08_04"
msgstr "Brooks: Dovraga! Pucaj za ozbiljno!"

msgid "vo_ob_char01_m02_stg08_05"
msgstr "Brooks: Vod, molim pozornost: sve savezničke grupe su uništene."

msgid "vo_ob_char01_m02_stg08_05_01"
msgstr "Brooks: Sada smo sami. Trebamo izvršiti zadatak. Pokret."

msgid "vo_ob_char01_m02_stg09_01"
msgstr "Brooks: Neprijatelj ispred nas!"

msgid "vo_ob_char01_m02_stg09_03"
msgstr "Brooks: Mislim da ovo nisu posljednji."

msgid "vo_ob_char01_m02_stg09_03_01"
msgstr "Brooks: Izvidnica smatra da bi trebali vidjeti više od Tigera."

msgid "vo_ob_char01_m02_stg10_01"
msgstr "Brooks: Dovraga...to nije Panther, to je King Tiger."

msgid "vo_ob_char01_m02_stg10_03"
msgstr "Brooks: Za ovo bi svakako trebao dobiti medalju."

msgid "vo_ob_char01_m02_stg10_05"
msgstr "Brooks: Ne možemo ga probiti sprijeda. Obuhvatimo ga."

msgid "vo_ob_char01_m02_stg11_01"
msgstr "Brooks: Pokret! Ne daj im da ciljaju!"

msgid "vo_ob_char01_m02_stg11_03"
msgstr "Brooks: Dovraga! Gusjenica pogođena. Nepokretan sam!"

msgid "vo_ob_char02_intro_02"
msgstr "Brooks: Ali tako lijepo gore."

msgid "vo_ob_char02_intro_04"
msgstr "Brooks: I onaj je lijepo gorio."

msgid "vo_ob_char02_intro_06"
msgstr "Brooks: Hej, naredniče Brooks, zašto \"Gromovnik\"?"

msgid "vo_ob_char02_intro_06_01"
msgstr "Brooks: Za tjeranje straha u kosti neprijatelju samo imenom?"

msgid "vo_ob_char02_intro_08"
msgstr "Brooks: Hm...moj Firefly isto treba ime. Zvat ću je \"Betsy\"."

msgid "vo_ob_char02_intro_10"
msgstr "Brooks: U čast moje bake. Bojao sam je se..."

msgid "vo_ob_char02_intro_13"
msgstr "Brooks: Hej, Sherman, jesi budan? U zadnji čas!"

msgid "vo_ob_char02_intro_14"
msgstr "Brooks: Gamad!"

msgid "vo_ob_char02_intro_15"
msgstr "Brooks: Dobar hitac, Sherman! Drago mi je da si opet onaj stari!"

msgid "vo_ob_char02_intro_16"
msgstr "Brooks: Još dva! Naredniče Brooks, gdje je moja medalja?"

msgid "vo_ob_char02_intro_18"
msgstr "MacLeod: Tipično..."

msgid "vo_ob_char02_m01_stg00_01"
msgstr "MacLeod: Pokret, Sherman."

msgid "vo_ob_char02_m01_stg00_02"
msgstr "MacLeod: Sherman, probudi se."

msgid "vo_ob_char02_m01_stg00_03"
msgstr "MacLeod: Nemoj samo stajati tu. Vozi!"

msgid "vo_ob_char02_m01_stg00_04"
msgstr "MacLeod: Je li tvoj tenk opet zapeo ili što?"

msgid "vo_ob_char02_m01_stg00_05"
msgstr "MacLeod: Pokret ili ćemo propustiti predstavu!"

msgid "vo_ob_char02_m01_stg010_02"
msgstr "MacLeod: Ugh, ti...odgovarat ćeš za ovo!"

msgid "vo_ob_char02_m01_stg010_03"
msgstr "MacLeod: Koristi optiku, Srećko!"

msgid "vo_ob_char02_m01_stg010_03_01"
msgstr "MacLeod: Ah! Upravo je izašlo. Valjda ću te zvati Srećko!"

msgid "vo_ob_char02_m01_stg012_01"
msgstr "MacLeod: Sve je u redu, Srećko. Nedostaje nam tvoj stil ovdje."

msgid "vo_ob_char02_m01_stg013_01"
msgstr "MacLeod: Ideš! Ima za sve."

msgid "vo_ob_char02_m01_stg015_02"
msgstr "MacLeod: Što kažeš na malo natjecanja, Srećko?"

msgid "vo_ob_char02_m01_stg015_03"
msgstr "MacLeod: Hajde, spali ih!"

msgid "vo_ob_char02_m01_stg015_04"
msgstr "MacLeod: Kakav plamen!"

msgid "vo_ob_char02_m01_stg016_01"
msgstr "MacLeod: To je bilo vruće! Imaš moje poštovanje."

msgid "vo_ob_char02_m01_stg016_01_01"
msgstr "MacLeod: Prošlo je vremena otkad sam vidio takvo nešto!"

msgid "vo_ob_char02_m01_stg016_03"
msgstr "MacLeod: Ej, naredniče Brooks, što je s tom medaljom?"

msgid "vo_ob_char02_m01_stg016_05"
msgstr "MacLeod: Ha!"

msgid "vo_ob_char02_m01_stg01_02"
msgstr "MacLeod: Smislimo ime i za Shermana."

msgid "vo_ob_char02_m01_stg01_04"
msgstr "MacLeod: Ha! Njegovo ime je bilo Ruaraidh."

msgid "vo_ob_char02_m01_stg01_05"
msgstr "MacLeod: To će zasigurno uplašiti neprijatelja."

msgid "vo_ob_char02_m01_stg01_05_01"
msgstr "MacLeod: Ali, bojim se da ga neću moći slovkati!"

msgid "vo_ob_char02_m01_stg01_06"
msgstr "MacLeod: OK, Sherman, idemo. Predstava je već počela!"

msgid "vo_ob_char02_m01_stg02_01"
msgstr "MacLeod: Vozi okolo, Sherman."

msgid "vo_ob_char02_m01_stg02_02"
msgstr "MacLeod: Ako ga uhvatiš, izgubit ćeš brzinu i postati laka meta."

msgid "vo_ob_char02_m01_stg02_03"
msgstr "MacLeod: Možda \"Borbena kola\"? Što kažeš na to ime?"

msgid "vo_ob_char02_m01_stg03_03"
msgstr "MacLeod: Ajmo! Napravimo par dodatnih rupa u toj kanti!"

msgid "vo_ob_char02_m01_stg04_02"
msgstr "MacLeod: Što kažeš na \"Stroj smrti\"?"

msgid "vo_ob_char02_m01_stg04_04"
msgstr "MacLeod: Kaže \"Gromovnik\"!"

msgid "vo_ob_char02_m01_stg05_02"
msgstr "MacLeod: Momcima se sviđa što radiš! Kakav spektakularan vatromet!"

msgid "vo_ob_char02_m01_stg06_02"
msgstr "MacLeod: Paljba, Stroju smrti, paljba!"

msgid "vo_ob_char02_m01_stg06_03"
msgstr "MacLeod: Trebamo kraće ime."

msgid "vo_ob_char02_m01_stg06_04"
msgstr "MacLeod: Ajde, okreni kupolu! Sprži te trule kante!"

msgid "vo_ob_char02_m01_stg07_01"
msgstr "MacLeod: Dovraga! To je bilo blizu."

msgid "vo_ob_char02_m01_stg09_01"
msgstr "MacLeod: Nećeš nam pobjeći! U progon..."

msgid "vo_ob_char02_m01_stg09_01_01"
msgstr "MacLeod: Žeteoc? Što kažeš na Žeteoca?"

msgid "vo_ob_char02_m02_stg01_02"
msgstr "MacLeod: Neka lov počne!"

msgid "vo_ob_char02_m02_stg01_02_01"
msgstr "MacLeod: Dakle, Srećko, izgleda da će ovo biti dan kada je Macleod od tebe preoteo titulu \"Lovac na tigrove\"!"

msgid "vo_ob_char02_m02_stg01_04"
msgstr "MacLeod: Ne. Rupe različitih veličina. To su bili srednji tenkovi."

msgid "vo_ob_char02_m02_stg02_02"
msgstr "MacLeod: Pfff...sitniš. Ništa zanimljivo."

msgid "vo_ob_char02_m02_stg02_04"
msgstr "MacLeod: Da, gospodine! Samo tako, Srećko!"

msgid "vo_ob_char02_m02_stg03_02"
msgstr "MacLeod: To nije baš pametno od njih. S našom optikom su lake mete."

msgid "vo_ob_char02_m02_stg04_01"
msgstr "MacLeod: Evo drugoga. Hej, Srećko, ostavi mi barem jednoga!"

msgid "vo_ob_char02_m02_stg04_03"
msgstr "MacLeod: Prokletstvo! Jesam li to rekao naglas?"

msgid "vo_ob_char02_m02_stg05_02"
msgstr "MacLeod: Više optimizma, naredniče! Sad će biti prolaz."

msgid "vo_ob_char02_m02_stg05_05"
msgstr "MacLeod: Dobro vidim. Vidio sam avion."

msgid "vo_ob_char02_m02_stg05_07"
msgstr "MacLeod: Da? Mislio sam da je naš."

msgid "vo_ob_char02_m02_stg06_02"
msgstr "MacLeod: Kao da smo na streljani. Što li su mislili?"

msgid "vo_ob_char02_m02_stg07_01"
msgstr "MacLeod: Mislim da će se oni igrati lovice."

msgid "vo_ob_char02_m02_stg07_01_01"
msgstr "MacLeod: Prilično su skrenuli. Kroz tvoj plićak."

msgid "vo_ob_char02_m02_stg07_01_02"
msgstr "MacLeod: Oni tigrovi imaju naša imena ispisana na njima."

msgid "vo_ob_char02_m02_stg07_03"
msgstr "MacLeod: I to je dobro."

msgid "vo_ob_char02_m02_stg07_03_01"
msgstr "MacLeod: Koliko ih trebam razvaliti da bih konačno zaradio svoju medalju?"

msgid "vo_ob_char02_m02_stg07_05"
msgstr "MacLeod: Nije me uopće briga."

msgid "vo_ob_char02_m02_stg07_05_01"
msgstr "MacLeod: Samo je želim poslati mami, da je usrećim, znaš?"

msgid "vo_ob_char02_m02_stg07_05_02"
msgstr "MacLeod: Hvalit će se susjedima. I biti ponosna na mene."

msgid "vo_ob_char02_m02_stg07_05_03"
msgstr "MacLeod: Konačno."

msgid "vo_ob_char02_m02_stg08_03"
msgstr "MacLeod: To je jedan žilavi mješanac."

msgid "vo_ob_char02_m02_stg08_03_01"
msgstr "MacLeod: Gađaj slabe točke, Srećko! Bokove i stražnjicu!"

msgid "vo_ob_char02_m02_stg08_04"
msgstr "MacLeod: Ovaj lijepo gori!"

msgid "vo_ob_char02_m02_stg08_05"
msgstr "MacLeod: To je žilavi mješanac! Traži njegove slabe točke, Srećko."

msgid "vo_ob_char02_m02_stg08_05_01"
msgstr "MacLeod: Gađaj u trbuh-uvijek je tanak ispod prednjeg oklopa!"

msgid "vo_ob_char02_m02_stg08_06"
msgstr "MacLeod: To je žilavi mješanac! Traži njegove slabe točke, Srećko!"

msgid "vo_ob_char02_m02_stg08_07"
msgstr "MacLeod: Gađaj u trbuh-uvijek je tanak ispod prednjeg oklopa!"

msgid "vo_ob_char02_m02_stg08_08"
msgstr "MacLeod: Ciljaj u zapovjednikove kupole-teže ih je pogoditi, ali lakše probiti."

msgid "vo_ob_char02_m02_stg09_02"
msgstr "MacLeod: Ne zaboravi se kretati, Srećko! Ili ćete pogoditi u slabe točke."

msgid "vo_ob_char02_m02_stg09_02_01"
msgstr "MacLeod: Ili se možeš sakriti iza tenkovskih olupina."

msgid "vo_ob_char02_m02_stg09_02_02"
msgstr "MacLeod: Neće te srediti tako daleko-imaš jaku kupolu."

msgid "vo_ob_char02_m02_stg09_04"
msgstr "MacLeod: Ti izviđaći...vjerojatno ne znaju ništa."

msgid "vo_ob_char02_m02_stg09_04_01"
msgstr "MacLeod: Tko još može biti tamo? Pantheri?"

msgid "vo_ob_char02_m02_stg10_02"
msgstr "MacLeod: Ovog još nisam vidio."

msgid "vo_ob_char02_m02_stg10_04"
msgstr "MacLeod: E, konačno!"

msgid "vo_ob_char02_m02_stg10_06"
msgstr "MacLeod: Srećko! Bokovi! Straga! Gađaj slabe točke!"

msgid "vo_ob_char02_m02_stg11_02"
msgstr "MacLeod: Nema šanse da može držati korak s nama Shermanima."

msgid "vo_ob_char02_m02_stg11_04"
msgstr "MacLeod: Srećko, sredi ih, brzo!"

msgid "vo_ob_char02_m02_stg12_01"
msgstr "MacLeod: Brooks! Dovraga, Brooks, reci nešto!"

msgid "vo_ob_char02_m02_stg13_01"
msgstr "MacLeod: Obuhvati ih! Gađaj slabe točke!"

msgid "vo_ob_char02_m02_stg13_02"
msgstr "MacLeod: Srećko, gađaj bokove i stražnjicu!"

msgid "vo_ob_char02_m02_stg13_03"
msgstr "MacLeod: Kupola je čvrsta samo sprijeda. Nastavi se kretati!"

msgid "vo_ob_char02_m02_stg14_01"
msgstr "MacLeod: To je to."

msgid "vo_ob_char02_m02_stg14_02"
msgstr "MacLeod: Gore. Lijepo gore."

msgid "vo_ob_char02_m02_stg14_03"
msgstr "MacLeod: Lovac na tigrove: to je službeno tvoja titula, kompa."

msgid "vo_sm_char01_m03_stg01_02"
msgstr "Brooks: Ovdje stožer. Narednik Brooks Lovcima na tigrove."

msgid "vo_sm_char01_m03_stg01_02_01"
msgstr "Brooks: Grad i predgrađa su posuti minama. Budite pažljivi."

msgid "vo_sm_char01_m03_stg01_04"
msgstr "Brooks: Drago mi je da to čujem, MacLeod."

msgid "vo_sm_char01_m03_stg01_04_01"
msgstr "Brooks: Ali budite na oprezu tamo. Duž puta očekujte golema minska polja."

msgid "vo_sm_char01_m03_stg01_06"
msgstr "Brooks: Što dobro protrljati?"

msgid "vo_sm_char01_m03_stg03_02"
msgstr "Brooks: Zašto misliš da i Srećko ima ritual?"

msgid "vo_sm_char01_m03_stg04_02"
msgstr "Brooks: Nemojte biti previše samouvjereni. Ciljajte na istu metu. Držite se zajedno."

msgid "vo_sm_char01_m03_stg07_03"
msgstr "Brooks: Starac? Stvarno?"

msgid "vo_sm_char01_m03_stg07_05"
msgstr "Brooks: Samo sam šest godina stariji od tebe, MacLeod."

msgid "vo_sm_char01_m03_stg08_02"
msgstr "Brooks: Možda su samo ljubazni i puštaju da pričate, MacLeod!"

msgid "vo_sm_char01_m03_stg10_02"
msgstr "Brooks: MacLeod, daj mi izvješće o statusu."

msgid "vo_sm_char01_m03_stg10_04"
msgstr "Brooks: Stari dobri MacLeod."

msgid "vo_sm_char01_m03_stg11_02"
msgstr "Brooks: Imate Srećka. Donosi više sreće od bilo koje amajlije."

msgid "vo_sm_char01_m03_stg11_02_01"
msgstr "Brooks: Pronađite drugi put, momci!"

msgid "vo_sm_char01_m03_stg14_02"
msgstr "Brooks: Glave gore, lovci."

msgid "vo_sm_char01_m03_stg14_02_01"
msgstr "Brooks: Saveznički bombarderi se približavaju vašem položaju. Pozor."

msgid "vo_sm_char01_m03_stg14_02_02"
msgstr "Brooks: Držite udaljenost od tih neprijateljskih tenkova."

msgid "vo_sm_char01_m03_stg15_02"
msgstr "Brooks: Jeste li dobro?"

msgid "vo_sm_char01_m03_stg18_02"
msgstr "Brooks: Bez savjeta, MacLeod. Ali imamo zračnu potporu. Spajam pilota sada."

msgid "vo_sm_char01_m03_stg21_02"
msgstr "Brooks: Ostani na meti, MacLeod. Moramo očistiti još jedan kvadrant."

msgid "vo_sm_char01_m03_stg21_02_01"
msgstr "Brooks: Kasnije možete uz šalicu čaja raspravljati o svojim praznovjerjima."

msgid "vo_sm_char01_m03_stg21_04"
msgstr "Brooks: Što god ti kažeš."

msgid "vo_sm_char01_m03_stg25_03"
msgstr "Brooks: Ne budi glup, ne trebam amajlije."

msgid "vo_sm_char01_m03_stg25_05"
msgstr "Brooks: Planiranje i strategija, MacLeod, planiranje i strategija."

msgid "vo_sm_char01_m03_stg26_02"
msgstr "Brooks: Stolna što?"

msgid "vo_sm_char01_m03_stg28_03"
msgstr "Brooks: Dovraga, obavještajna nije izvjestila o ovome..."

msgid "vo_sm_char01_m03_stg28_07"
msgstr "Brooks: Radimo najbolje što možemo."

msgid "vo_sm_char01_m03_stg30_02"
msgstr "Brooks: Imam izvješće da je Orao Jedan živ. Dobar posao, momci."

msgid "vo_sm_char01_m03_stg30_03"
msgstr "Brooks: U pravu si, MacLeod, nekad trebamo amajlije."

msgid "vo_sm_char01_m03_stg30_03_01"
msgstr "Brooks: Da, imam jednu bezvezariju s glupošću."

msgid "vo_sm_char01_m03_stg30_05"
msgstr "Brooks: (smijeh)"

msgid "vo_sm_char01_m03_stg32_04"
msgstr "Brooks: Srećko, vrijeme je za pokret. Nismo na razgledavanju."

msgid "vo_sm_char01_m03_stg32_05"
msgstr "Brooks: Naprijed, Srećko! U ovoj borbi je svaka sekunda bitna. "

msgid "vo_sm_char01_m03_stg32_06"
msgstr "Brooks: Srećko, moramo izvršiti zadatak. Idemo."

msgid "vo_sm_char01_m03_stg33_02"
msgstr "Brooks: Betsy je stvarno to rekla?"

msgid "vo_sm_char01_m03_stg34_01"
msgstr "Brooks: Vrijeme nije na našoj strani. Bez junačenja sada."

msgid "vo_sm_char01_m03_stg34_01_01"
msgstr "Brooks: Uvijek stavite neprijatelja u škripac ako možete. Neka cvile i udarite ih po bokovima."

msgid "vo_sm_char01_m03_stg40_01"
msgstr "Brooks: Šaljem vam pojačanja. Držite se."

msgid "vo_sm_char01_m03_stg40_02"
msgstr "Brooks: Potpora stiže. Uskoro bi trebal biti tamo."

msgid "vo_sm_char01_m03_stg40_03"
msgstr "Brooks: Novi saveznički tenkovi na putu."

msgid "vo_sm_char01_m03_stg42_05"
msgstr "Brooks: Opet u stroju, zapovjedniče. Glavu dolje i gurajte naprijed."

msgid "vo_sm_char01_m03_stg42_06"
msgstr "Brooks: Pažljivo s ovim tenkom. Pričuve nam ponestaju."

msgid "vo_sm_char01_m03_stg42_07"
msgstr "Brooks: Imaš još jedan pokušaj. Neka se računa."

msgid "vo_sm_char01_m04_stg01_02"
msgstr "Brooks: Ovdje stožer, govori nar. Brooks."

msgid "vo_sm_char01_m04_stg01_04"
msgstr "Brooks: Ne, nisu."

msgid "vo_sm_char01_m04_stg01_04_01"
msgstr "Brooks: Nadam se."

msgid "vo_sm_char01_m04_stg02_02"
msgstr "Brooks: Ne. Nešto veliko i teško. Saveznici su već imali nekoliko pokušaja."

msgid "vo_sm_char01_m04_stg02_02_01"
msgstr "Brooks: Poslano nekoliko vodova tenkova. Nijedan se nije vratio."

msgid "vo_sm_char01_m04_stg03_02"
msgstr "Brooks: Ne, obavještajna kaže da je naš cilj još uvijek u gradu."

msgid "vo_sm_char01_m04_stg05_01"
msgstr "Brooks: Zadržite ih! Sada nije vrijeme za rizik. Koncentrirajte se na drugi zadatak."

msgid "vo_sm_char01_m04_stg06_02"
msgstr "Brooks: Predlažem korištenje asa u rukavu."

msgid "vo_sm_char01_m04_stg07_01"
msgstr "Brooks: Stožer Maloj Burnici, javite se."

msgid "vo_sm_char01_m04_stg07_03"
msgstr "Brooks: Meta je King Tiger na mostu u kvadrantu C3."

msgid "vo_sm_char01_m04_stg08_03"
msgstr "Brooks: Čekaj, MacLeod. Ulozi su previsoki."

msgid "vo_sm_char01_m04_stg08_03_01"
msgstr "Brooks: Radite zajedno. Imobilizirajte Tigra. Mala Burnica će napraviti još jedan prelet."

msgid "vo_sm_char01_m04_stg08_03_02"
msgstr "Brooks: Imobilizirajte Tigra. Mala Burnica će napraviti još jedan prelet."

msgid "vo_sm_char01_m04_stg13_03"
msgstr "Brooks: Nemamo jasne informacije, MacLeod."

msgid "vo_sm_char01_m04_stg13_03_01"
msgstr "Brooks: Nešto eksperimentalno. Prototip. I to dobar."

msgid "vo_sm_char01_m04_stg14_02"
msgstr "Brooks: MacLeod, nemamo vremena za to. Nije tvoj problem."

msgid "vo_sm_char01_m04_stg15_01"
msgstr "Brooks: Zaobiđite ga kroz ulice. I dajte Bennettu koordinate."

msgid "vo_sm_char01_m04_stg15_03"
msgstr "Brooks: Mala Burnica."

msgid "vo_sm_char01_m04_stg17_02"
msgstr "Brooks: Typ 205."

msgid "vo_sm_char01_m04_stg17_04"
msgstr "Brooks: Zašto \"Mali Miš?\""

msgid "vo_sm_char01_m04_stg19_02"
msgstr "Brooks: To su informacije. Do sada su se već trebali vratiti u bazu."

msgid "vo_sm_char01_m04_stg23_02"
msgstr "Brooks: Oprosti, MacLeod. Izletilo valjda."

msgid "vo_sm_char01_m04_stg24_06"
msgstr "Brooks: Mogao bih, ali sređivanje bi moglo potrajati."

msgid "vo_sm_char01_m04_stg26_02"
msgstr "Brooks: To je bila tajna operacija."

msgid "vo_sm_char01_m04_stg26_02_01"
msgstr "Brooks: Ali ti si sam odlučio da želiš srediti tog Jagdtigera."

msgid "vo_sm_char01_m04_stg26_04"
msgstr "Brooks: Zapeli su u frontalnim napadima."

msgid "vo_sm_char01_m04_stg27_01"
msgstr "Brooks: Bombarderi se poravnavaju za nalet sada. Spremite se za vatromet."

msgid "vo_sm_char01_m04_stg28_02"
msgstr "Brooks: Otkada si ti počeo gunđati, MacLeod?"

msgid "vo_sm_char01_m04_stg30_03"
msgstr "Brooks: Tko je rekao da su to bili njegovi prvi Tigrovi? Što misliš zašto sam ga poveo na zadatak?"

msgid "vo_sm_char01_m04_stg31_02"
msgstr "Brooks: ČIniš dobar tim, MacLeod."

msgid "vo_sm_char01_m04_stg33_02"
msgstr "Brooks: Dovraga! Srećko, budi oprezan i...sretno!"

msgid "vo_sm_char01_m04_stg35_01"
msgstr "Brooks: Pojačanja stižu na vaš položaj."

msgid "vo_sm_char01_m04_stg35_01_01"
msgstr "Brooks: Saveznički tenkovi koje ste spasili. MacLeod, vaši napori nisu bili uzalud."

msgid "vo_sm_char01_m04_stg42_02"
msgstr "Brooks: Stigla je nova grupa saveznika."

msgid "vo_sm_char01_m04_stg42_02_01"
msgstr "Brooks: Nadamo se da ćemo uz njihovu pomoć lakše savladati Malog Miša."

msgid "vo_sm_char01_m04_stg42_03"
msgstr "Brooks: Ali upamtite, posljednji hitac mora biti naš."

msgid "vo_sm_char01_m04_stg42_03_01"
msgstr "Brooks: Mora biti naš trofej. Srećko, Bennet, nemojte nas iznevjeriti."

msgid "vo_sm_char01_m04_stg47_01"
msgstr "Brooks: Sjajan posao, momci. Šaljem tim za izvlačenje."

msgid "vo_sm_char01_m04_stg47_01_01"
msgstr "Brooks: MacLeod, moramo izvući tebe i Miša. Ključno je da padne u naše ruke."

msgid "vo_sm_char01_m04_stg47_01_02"
msgstr "Brooks: Smatrajte medalje vašima."

msgid "vo_sm_char01_m04_stg47_03"
msgstr "Brooks: Što onda želiš, MacLeod? Novi čin?"

msgid "vo_sm_char02_m03_stg01_01"
msgstr "MacLeod: Dobro, gospodo, vrijeme je za pokret i čišćenje ovog grada!"

msgid "vo_sm_char02_m03_stg01_03"
msgstr "MacLeod: Brooks?! Narednik Brooks?! To su dobre vijesti! u sigurnim smo rukama!"

msgid "vo_sm_char02_m03_stg01_05"
msgstr "MacLeod: Da, gospodine!"

msgid "vo_sm_char02_m03_stg01_05_01"
msgstr "MacLeod: Dečki! Dobro protrljajte svoje sretne novčiće prije ispaljivanja prvog hica!"

msgid "vo_sm_char02_m03_stg01_07"
msgstr "MacLeod: Što? Nisam praznovjeran, to je samo tradicija!"

msgid "vo_sm_char02_m03_stg02_01"
msgstr "MacLeod: Ah, evo naših golupčića."

msgid "vo_sm_char02_m03_stg02_01_01"
msgstr "MacLeod: Plaćam prvu rundu škotskog \"čaja\" za onog koji uništi najviše!"

msgid "vo_sm_char02_m03_stg02_01_02"
msgstr "MacLeod: Pokažimo im kako mi to radimo, Srećko!"

msgid "vo_sm_char02_m03_stg03_01"
msgstr "MacLeod: Malo pretiho za mene. Gdje je izazov?"

msgid "vo_sm_char02_m03_stg03_01_01"
msgstr "MacLeod: Uglavnom...Srećko, ispljuni ga-što je tvoj sretni ritual?"

msgid "vo_sm_char02_m03_stg03_03"
msgstr "MacLeod: Svi imamo malo trikove za sreću, zar ne, Srećko?"

msgid "vo_sm_char02_m03_stg03_03_01"
msgstr "MacLeod: Možda ples? Brza igranka prije uletavanja u okršaj?"

msgid "vo_sm_char02_m03_stg04_01"
msgstr "MacLeod: To te ja pitam! Ovi momci izgledaju kao da imaju žara u sebi."

msgid "vo_sm_char02_m03_stg05_01"
msgstr "MacLeod: Mudre riječi, starče Brooks. Srećko, pomogni mi s ovim, hoćeš li?"

msgid "vo_sm_char02_m03_stg05_01_01"
msgstr "MacLeod: Držat ću zvijer zaokupljenom, a vi joj se prišuljajte zdesna."

msgid "vo_sm_char02_m03_stg05_01_02"
msgstr "MacLeod: Dajmo joj pravo iznenađenje, može?"

msgid "vo_sm_char02_m03_stg06_01"
msgstr "MacLeod: Ovo je tvrd orah, Srećko! Razvali!"

msgid "vo_sm_char02_m03_stg07_01"
msgstr "MacLeod: Ne daj da pobjegne! Upropastit će cijelo iznenađenje!"

msgid "vo_sm_char02_m03_stg07_02"
msgstr "MacLeod: Gotovo!"

msgid "vo_sm_char02_m03_stg07_04"
msgstr "MacLeod: Samo malo prijateljskog podbadanja uz dužno poštovanje, \"gooospoooodineee\"!"

msgid "vo_sm_char02_m03_stg07_06"
msgstr "MacLeod: Da, da, znam."

msgid "vo_sm_char02_m03_stg08_01"
msgstr "MacLeod: Momci, čemu takva šutnja danas?"

msgid "vo_sm_char02_m03_stg08_03"
msgstr "MacLeod: Ha!"

msgid "vo_sm_char02_m03_stg09_00"
msgstr "MacLeod: Izgleda da smo uzburkali nešto u ovom neredu."

msgid "vo_sm_char02_m03_stg09_00_01"
msgstr "MacLeod: Ne zaboravi pospremiti svoj trup iza ovih humaka ili spaljenih neprijatelja, Srećko."

msgid "vo_sm_char02_m03_stg09_00_02"
msgstr "MacLeod: Samo im dajte vrh kupole-to je najtvrđi dio tvojeg tenka."

msgid "vo_sm_char02_m03_stg09_01"
msgstr "MacLeod: U redu,ovo je opasni izazivač, nema zbora."

msgid "vo_sm_char02_m03_stg09_01_01"
msgstr "MacLeod: Ne možemo u glavu s njim, držite se plana."

msgid "vo_sm_char02_m03_stg09_01_02"
msgstr "MacLeod: Zaokupit ću mu pažnju, a vi s prišuljajte s boka. Ali pazite na sebe, Srećko"

msgid "vo_sm_char02_m03_stg09_02"
msgstr "MacLeod: Ako okrene nišan na vas, ne glumite heroja-sakrijte se."

msgid "vo_sm_char02_m03_stg09_02_01"
msgstr "MacLeod: Njegov top prolazi kroz Shermane kao kroz putar."

msgid "vo_sm_char02_m03_stg09_03"
msgstr "MacLeod: Samo ga zaokupite i ugurat ću se da ga ugrizem odostraga."

msgid "vo_sm_char02_m03_stg10_01"
msgstr "MacLeod: Uf, ovo je bilo gadno!"

msgid "vo_sm_char02_m03_stg10_03"
msgstr "MacLeod: Još nisam naletio ni na jednog Tigra. Moramo ih pronaći da vidimo tko je najbolji!"

msgid "vo_sm_char02_m03_stg10_05"
msgstr "MacLeod: Star! Ha!"

msgid "vo_sm_char02_m03_stg11_01"
msgstr "MacLeod: U redu, stanite, momci!"

msgid "vo_sm_char02_m03_stg11_01_01"
msgstr "MacLeod: Mine. A ti si se smijao amajlijama, Brooks."

msgid "vo_sm_char02_m03_stg11_01_02"
msgstr "MacLeod: Trebamo svu moguću sreću."

msgid "vo_sm_char02_m03_stg12_01"
msgstr "MacLeod: Hej, Srećko! Našli smo drugi put. Pokret."

msgid "vo_sm_char02_m03_stg12_01_01"
msgstr "MacLeod: Što bi vi bez starog dobrog MacLeoda!"

msgid "vo_sm_char02_m03_stg12_02"
msgstr "MacLeod: Sjedili bi tu do mraka! Ha!"

msgid "vo_sm_char02_m03_stg12_03"
msgstr "MacLeod: Oh! Našli ste obilazak! Izvrsno!"

msgid "vo_sm_char02_m03_stg12_03_01"
msgstr "MacLeod: Već sam počeo misliti da smo zapeli do večeri čekajući inžinjere."

msgid "vo_sm_char02_m03_stg13_01"
msgstr "MacLeod: Pogledaj to, Srećko! Dva Tigra! Naše natjecanje se vratilo."

msgid "vo_sm_char02_m03_stg14_01"
msgstr "MacLeod: Ali ova ulica je preuska. Probijanje prednjeg oklopa Tigra nije laki pothvat."

msgid "vo_sm_char02_m03_stg14_03"
msgstr "MacLeod: Fino! Sada samo čekaj, uskoro ćemo vidjeti lijepi rad."

msgid "vo_sm_char02_m03_stg14_03_01"
msgstr "MacLeod: Naši momci u zraku će kirurški precizno ukloniti te čelične zvijeri."

msgid "vo_sm_char02_m03_stg15_01"
msgstr "MacLeod: Ideš, što je to bilo?! Bilo je preglasno!"

msgid "vo_sm_char02_m03_stg15_01_01"
msgstr "MacLeod: Ideš, što je to bilo?!"

msgid "vo_sm_char02_m03_stg15_03"
msgstr "MacLeod: Da, neokrznuti smo, ali sam izgubio moj sretni novčić!"

msgid "vo_sm_char02_m03_stg15_03_01"
msgstr "MacLeod: I ne vidim nekoliko zgrada koje su bile tu."

msgid "vo_sm_char02_m03_stg16_01"
msgstr "MacLeod: Srećko! Gledaj, drugi Tigar je tamo, još je živ."

msgid "vo_sm_char02_m03_stg16_01_01"
msgstr "MacLeod: Iskoristimo ovu novu pukotinu. Stisnimo s obje strane."

msgid "vo_sm_char02_m03_stg17_01"
msgstr "MacLeod: Dobar hitac! Još jedan Tigar u našoj evidenciji!"

msgid "vo_sm_char02_m03_stg18_01"
msgstr "MacLeod: Pa, ne možeš vjerovati! Još Tigrova! Čime smo zaslužili ovakve poklone?"

msgid "vo_sm_char02_m03_stg18_01_01"
msgstr "MacLeod: Dovraga, još je gužva ovdje. Brooks, imaš savjet?"

msgid "vo_sm_char02_m03_stg19_01"
msgstr "MacLeod: Volim njegov stil! Lucky, držimo se naših pravila. Iskoristi ovaj novi prolaz."

msgid "vo_sm_char02_m03_stg19_01_01"
msgstr "MacLeod: Pritisnut ću sprijeda, a ti se prišuljaj sa strane."

msgid "vo_sm_char02_m03_stg20_01"
msgstr "MacLeod: Učinimo da ovaj nitkov pleše kao da je u vrućoj tavi."

msgid "vo_sm_char02_m03_stg20_01_01"
msgstr "MacLeod: Čekaj dok obojica napunimo tako da ne zna s koje strane dolaze hici."

msgid "vo_sm_char02_m03_stg20_02"
msgstr "MacLeod: Možda izgledaju čvrsto sprijeda. Ali njihovi bokovi i stražnji dio su mekani i slasni!"

msgid "vo_sm_char02_m03_stg21_01"
msgstr "MacLeod: Mora biti nešto što ti donosi sreću, Srećko. Možda imaš..."

msgid "vo_sm_char02_m03_stg21_03"
msgstr "MacLeod: Tradicija, Brooks. Ne praznovjerje."

msgid "vo_sm_char02_m03_stg21_05"
msgstr "MacLeod: U redu, vrijeme je da završimo ovu veliku turneju. Orao Jedan, prijem?"

msgid "vo_sm_char02_m03_stg21_05_01"
msgstr "MacLeod: Daj nam ptičju perspektivu-koliko još vjernih lutajućih fanova imamo na trgu?"

msgid "vo_sm_char02_m03_stg22_02"
msgstr "MacLeod: Moram reći da mi se sviđa ovaj momak!"

msgid "vo_sm_char02_m03_stg22_02_01"
msgstr "MacLeod: Šteta što se ne bavi tenkovima. U našoj posadi bi nam dobrodošao mladić poput njega."

msgid "vo_sm_char02_m03_stg23_01"
msgstr "MacLeod: Pa, ovaj što je letio, letio je."

msgid "vo_sm_char02_m03_stg23_01_01"
msgstr "MacLeod: Orao Jedan, oprezno tamo gore, neprijateljski lovci padaju s neba."

msgid "vo_sm_char02_m03_stg24_01"
msgstr "MacLeod: Mine! Mrzim mine. Nađi obilazak, Srećko. Privući ću im pažnju."

msgid "vo_sm_char02_m03_stg25_01"
msgstr "MacLeod: Recimo da je Srećko rođen pod sretnom zvijezdom."

msgid "vo_sm_char02_m03_stg25_01_01"
msgstr "MacLeod: A što s tobom Brooks? Imaš li amajliju?"

msgid "vo_sm_char02_m03_stg25_02"
msgstr "MacLeod: Potkova u džepu? Možda bezvezarija s glupošću?"

msgid "vo_sm_char02_m03_stg25_04"
msgstr "MacLeod: Čekaj...jesam li pogodio?"

msgid "vo_sm_char02_m03_stg26_01"
msgstr "MacLeod: Gledajte, momci, tako to rade legende!"

msgid "vo_sm_char02_m03_stg26_01_01"
msgstr "MacLeod: Da nije zbog ozljede, Brooks bi isto bio s nama!"

msgid "vo_sm_char02_m03_stg26_01_02"
msgstr "MacLeod: Nas trojica zajedno...Pa, nema pomoći. Sada je stolna..."

msgid "vo_sm_char02_m03_stg26_03"
msgstr "MacLeod: Stolna legenda, gospodine!"

msgid "vo_sm_char02_m03_stg27_01"
msgstr "MacLeod: Dovraga! Zadnje što nam treba je ulazak samohodnog topa na zabavu."

msgid "vo_sm_char02_m03_stg27_01_01"
msgstr "MacLeod: Nemoj samo sjediti tu, Srećko-pokret! Neka riskiraju pogoditi svoje."

msgid "vo_sm_char02_m03_stg28_02"
msgstr "MacLeod: Brooks, odakle su se pojavili ovi nepozvani gosti?"

msgid "vo_sm_char02_m03_stg28_02_01"
msgstr "MacLeod: Nije ih se spominjalo na brifingu?"

msgid "vo_sm_char02_m03_stg28_04"
msgstr "MacLeod: Oh, moji voljeni obavještajci...uvijek se drže svoje tradicije."

msgid "vo_sm_char02_m03_stg28_04_01"
msgstr "MacLeod: Orao Jedan, koliko ih možeš maknuti s naših leđa?"

msgid "vo_sm_char02_m03_stg28_06"
msgstr "MacLeod: Orao Jedan, prijem! Orao-Jedan! Prokletsvo!"

msgid "vo_sm_char02_m03_stg28_06_01"
msgstr "MacLeod: Brooks, reci mi da imaš lovaca koji će im pomoći!"

msgid "vo_sm_char02_m03_stg28_08"
msgstr "MacLeod: Srećko, vidiš li ga? Hajde, Orao Jedan, možeš ih otresti. Dovraga!"

msgid "vo_sm_char02_m03_stg28_08_01"
msgstr "MacLeod: Završimo ovo, Srećko. Stisnut ćemo ih s obje strane. Bez ljupkosti."

msgid "vo_sm_char02_m03_stg29_01"
msgstr "MacLeod: Izgleda da imamo više društva nego što smo očekivali."

msgid "vo_sm_char02_m03_stg29_01_01"
msgstr "MacLeod: Koncentracija na istu metu. Skidamo ih jednog po jednog, Srećko."

msgid "vo_sm_char02_m03_stg29_01_02"
msgstr "MacLeod: A za desert ćemo servirati lijepu krišku topništva!"

msgid "vo_sm_char02_m03_stg30_01"
msgstr "MacLeod: Uff...ovo je bilo gadno. Oh, pogledaj ovo! Pronašao sam svoj sretni novčić!"

msgid "vo_sm_char02_m03_stg30_04"
msgstr "MacLeod: Čekaj. Što??? Ozbilno? Moram to vidjeti!"

msgid "vo_sm_char02_m03_stg31_01"
msgstr "MacLeod: Pokret, Srećko, ili će naš čaj biti hladan i gadan kao škotska zima."

msgid "vo_sm_char02_m03_stg31_02"
msgstr "MacLeod: Idemo, Srećko! Oni Tigrovi se neće sami uništiti!"

msgid "vo_sm_char02_m03_stg31_03"
msgstr "MacLeod: Srećko, ovdje nema mina. Vrijeme je za pokret."

msgid "vo_sm_char02_m03_stg31_04"
msgstr "MacLeod: Srećko, nismo na pikniku. Idemo!"

msgid "vo_sm_char02_m03_stg31_05"
msgstr "MacLeod: Nemoj samo tu stajati, Srećko. Topništvo nikad ne spava."

msgid "vo_sm_char02_m03_stg32_01"
msgstr "MacLeod: Srećko, nađimo put oko ovih mina."

msgid "vo_sm_char02_m03_stg32_02"
msgstr "MacLeod: Srećko, nemoj samo sjediti. Izvidi alternativni put."

msgid "vo_sm_char02_m03_stg32_03"
msgstr "MacLeod: Zurenje u te mine neće učiniti da nestanu, Srećko."

msgid "vo_sm_char02_m03_stg32_03_01"
msgstr "MacLeod: Pronađimo obilazak."

msgid "vo_sm_char02_m03_stg33_01"
msgstr "MacLeod: Kao što je moja baka govorila, \"Uvijek obuhvati neprijatelja s boka i rokaj po njihovim bokovima s pancirnim granatama.\""

msgid "vo_sm_char02_m03_stg33_03"
msgstr "MacLeod: Više-manje."

msgid "vo_sm_char02_m03_stg35_01"
msgstr "MacLeod: Upamtite: stisnite neprijatelja s obje strane i uvijek će jednom od nas izložiti slabu točku."

msgid "vo_sm_char02_m03_stg35_02"
msgstr "MacLeod: Satjerajmo ih u kut, obuhvat s obje strane."

msgid "vo_sm_char02_m03_stg35_02_01"
msgstr "MacLeod: Tako će morati izložiti ranjivu točku."

msgid "vo_sm_char02_m03_stg35_03"
msgstr "MacLeod: Napravimo kako treba: napad s obje strane i jedan od nas će dobiti priliku probiti taj fini tanki bočni oklop!"

msgid "vo_sm_char02_m03_stg36_01"
msgstr "MacLeod: Pazi kamo ideš, Srećko!"

msgid "vo_sm_char02_m03_stg36_02"
msgstr "MacLeod: Čuvaj se mina!"

msgid "vo_sm_char02_m03_stg36_03"
msgstr "MacLeod: Čekaj! Ove mine baš ne vole naše tenkove!"

msgid "vo_sm_char02_m03_stg36_04"
msgstr "MacLeod: Mine. Mrzim mine."

msgid "vo_sm_char02_m03_stg36_05"
msgstr "MacLeod: Oprezno! Mine ovdje imaju gadnu narav."

msgid "vo_sm_char02_m03_stg36_06"
msgstr "MacLeod: Mine naprijed! Bolje da nađemo drugi put."

msgid "vo_sm_char02_m03_stg37_01"
msgstr "MacLeod: Srećko! To je baš bio udarac! Jesi dobro?"

msgid "vo_sm_char02_m03_stg37_02"
msgstr "MacLeod: Čekaj! Kuda tako brzo ideš?"

msgid "vo_sm_char02_m03_stg37_02_01"
msgstr "MacLeod: Popravi gusjenice i bježimo unatrag odavde!"

msgid "vo_sm_char02_m03_stg37_03"
msgstr "MacLeod: Srećko, znaš, ako si htio iskopati rupu, ima i lakših načina!"

msgid "vo_sm_char02_m03_stg37_04"
msgstr "MacLeod: Teški putevi, Srećko. Te mine su podmukla gomila."

msgid "vo_sm_char02_m03_stg37_05"
msgstr "MacLeod: Pa, to je jedan način za pronaći minu. Ne najbolji, ali radi."

msgid "vo_sm_char02_m03_stg37_06"
msgstr "MacLeod: Skockaj se, Srećko. Svi smo bili s par mina."

msgid "vo_sm_char02_m03_stg38_01"
msgstr "MacLeod: Pazi, Srećko! Sljedeća mina bi ti mogla biti posljednja."

msgid "vo_sm_char02_m03_stg38_02"
msgstr "MacLeod: Izgleda da ti se baš sviđa popravljati gusjenice, Srećko."

msgid "vo_sm_char02_m03_stg38_03"
msgstr "MacLeod: Što?! Opet? Odakle ta ljubav za minama, Srećko?"

msgid "vo_sm_char02_m03_stg39_01"
msgstr "MacLeod: Dovraga, upravo smo izgubili jedan od naših tenkova."

msgid "vo_sm_char02_m03_stg39_02"
msgstr "MacLeod: Kvragu! Ode još jedan od naših!"

msgid "vo_sm_char02_m03_stg39_03"
msgstr "MacLeod: Izgubili smo saveznički tenk. Sada trebamo udvostručiti naše napore."

msgid "vo_sm_char02_m03_stg41_01"
msgstr "MacLeod: Moj tenk je uništen. Vraćam se za sekundu s novim! Nemojte da vam previše nedostajem."

msgid "vo_sm_char02_m03_stg41_02"
msgstr "MacLeod: Ah, kvragu! To je bio moj omiljeni tenk. U redu, uskoro ide druga runda!"

msgid "vo_sm_char02_m03_stg41_03"
msgstr "MacLeod: Pogođen sam. Ne brini, vraćam se s drugim-nadam se da imaju u mojoj omiljenoj boji."

msgid "vo_sm_char02_m03_stg41_04"
msgstr "MacLeod: Pa, to je baš krasno. Još jedan tenk izgubljen. Daj mi minutu, uskoro se vraćam."

msgid "vo_sm_char02_m03_stg41_05"
msgstr "MacLeod: Izgleda da opet tražim novi tenk."

msgid "vo_sm_char02_m03_stg41_05_01"
msgstr "MacLeod: Čekaj tu, vratit ću se prije nego kažeš \"Gdje je MacLeod?\""

msgid "vo_sm_char02_m03_stg42_01"
msgstr "MacLeod: Natrag u sedlu, ha? Pokaži im od čega si napravljen!"

msgid "vo_sm_char02_m03_stg42_02"
msgstr "MacLeod: Dobro jutro, vrijeme je za drugu rundu! Možeš ti to."

msgid "vo_sm_char02_m03_stg42_03"
msgstr "MacLeod: Nemamo prodavaonicu tenkova ovdje. Čuvaj ovoga."

msgid "vo_sm_char02_m03_stg42_04"
msgstr "MacLeod: Ha! Ne može te se zaustaviti, zar ne? Vraćaš se po još, vidim!"

msgid "vo_sm_char02_m04_stg01_01"
msgstr "MacLeod: Lovci na tigrove na mjestu susreta."

msgid "vo_sm_char02_m04_stg01_01_01"
msgstr "MacLeod: Brooks, ako te mogu pozvati, jesi li tamo?"

msgid "vo_sm_char02_m04_stg01_03"
msgstr "MacLeod: Zašto takva formalnost, Brooks? Svi znamo da si ti."

msgid "vo_sm_char02_m04_stg01_03_01"
msgstr "MacLeod: Sada mi reci znaju li naši saveznici da smo u gradu?"

msgid "vo_sm_char02_m04_stg01_03_02"
msgstr "MacLeod: Neće početi pucati na nas, je li tako?"

msgid "vo_sm_char02_m04_stg01_05"
msgstr "MacLeod: Zašto me taj odgovor ne ispunjava povjerenjem?"

msgid "vo_sm_char02_m04_stg02_01"
msgstr "MacLeod: Što tražimo, Brooks? Zasigurno ne ovu sitnu ribu?"

msgid "vo_sm_char02_m04_stg03_01"
msgstr "MacLeod: Netko se uspio vratiti. Vidim saveznički tenk. Jesmo li propustili akciju?"

msgid "vo_sm_char02_m04_stg03_03"
msgstr "MacLeod: Ah, obavještajna..."

msgid "vo_sm_char02_m04_stg04_01"
msgstr "MacLeod: Dovraga! Tu je još jedan."

msgid "vo_sm_char02_m04_stg04_01_01"
msgstr "MacLeod: To je...oh, Brooks, to je opet ta zvijer. Kraljevski Tigar."

msgid "vo_sm_char02_m04_stg04_01_02"
msgstr "MacLeod: Srećko, znamo što činiti. Spreman?"

msgid "vo_sm_char02_m04_stg06_01"
msgstr "MacLeod: Što predlažeš? Pobjeći? Ostaviti ga tu?"

msgid "vo_sm_char02_m04_stg08_02"
msgstr "MacLeod: Dobar pokušaj, ali izgleda kao..."

msgid "vo_sm_char02_m04_stg09_01"
msgstr "MacLeod: Dajmo starom Brooksu razloga za smijeh, Srećko."

msgid "vo_sm_char02_m04_stg09_01_01"
msgstr "MacLeod: Ciljaj prednje ili stražnje pogonske kotače. Najlakši način za zaustaviti neprijatelja."

msgid "vo_sm_char02_m04_stg09_01_02"
msgstr "MacLeod: Ciljaj prednje ili stražnje pogonske kotače. Najlakši način za zaustaviti neprijatelja."

msgid "vo_sm_char02_m04_stg10_01"
msgstr "MacLeod: Samo pucaj. Prije ili kasnije će gusjenica otpasti."

msgid "vo_sm_char02_m04_stg10_01_01"
msgstr "MacLeod: A ova kočija će se pretvoriti u bundevu."

msgid "vo_sm_char02_m04_stg10_01_02"
msgstr "MacLeod: Samo pucaj. Prije ili kasnije će gusjenica otpasti."

msgid "vo_sm_char02_m04_stg11_01"
msgstr "MacLeod: Tako treba! Odličan hitac. Galebe, ti si na potezu."

msgid "vo_sm_char02_m04_stg13_01"
msgstr "MacLeod: Zvučiš kao moja stara učiteljica biologije. Gđa. McBezmozgić."

msgid "vo_sm_char02_m04_stg13_02"
msgstr "MacLeod: Srećko, hajdemo prije nego se pojavi još jedna Kraljevska Maca."

msgid "vo_sm_char02_m04_stg13_02_01"
msgstr "MacLeod: Brooks, daj nam trag, što tražimo?"

msgid "vo_sm_char02_m04_stg13_02_02"
msgstr "MacLeod: Nešto veće od Kraljevskog Tigra? Cara?"

msgid "vo_sm_char02_m04_stg14_01"
msgstr "MacLeod: Vidim savezničke tenkove naprijed. Kao i obično, nasrću i pokušavaju se probiti."

msgid "vo_sm_char02_m04_stg14_01_01"
msgstr "MacLeod: Neće pored Jagdtigera tako proći. Srećko, brojimo li Jagtigere?"

msgid "vo_sm_char02_m04_stg14_03"
msgstr "MacLeod: Brooks, izgleda da si predugo bio u stožeru."

msgid "vo_sm_char02_m04_stg14_03_01"
msgstr "MacLeod: Kužim, trebaš pisati izvješća. Ali naši saveznici tamo trebaju pomoć."

msgid "vo_sm_char02_m04_stg15_02"
msgstr "MacLeod: Bennett?"

msgid "vo_sm_char02_m04_stg15_04"
msgstr "MacLeod: To je već bolje. Srećko, pomognimo našem krilatom prijatelju da ostvari par bodova!"

msgid "vo_sm_char02_m04_stg16_01"
msgstr "MacLeod: Riješimo ove limene kante. Moramo brzo doći do tog Jagdtigera."

msgid "vo_sm_char02_m04_stg16_01_01"
msgstr "MacLeod: Ako naletimo na tvrđe orahe, ciljaj u pogonske kotače."

msgid "vo_sm_char02_m04_stg16_01_02"
msgstr "MacLeod: Daj našoj \"morskoj ptici\" malo da vježba gađanje."

msgid "vo_sm_char02_m04_stg16_01_03"
msgstr "MacLeod: Ciljaj pogonske kotače. Daj našoj \"morskoj ptici\" malo da vježba gađanje."

msgid "vo_sm_char02_m04_stg17_01"
msgstr "MacLeod: Kako se uopće zove taj prototip?"

msgid "vo_sm_char02_m04_stg17_01_01"
msgstr "MacLeod: Ima kodno ime? Ili bih ga sam trebao smisliti?"

msgid "vo_sm_char02_m04_stg17_03"
msgstr "MacLeod: Dosadno ime. Zvat ću ga...Mali Miš."

msgid "vo_sm_char02_m04_stg17_05"
msgstr "MacLeod: Da sam ja njemački inžinjer nazvao bih ga tako samo iz šale."

msgid "vo_sm_char02_m04_stg18_01"
msgstr "MacLeod: Koliko vas je tamo? Kasnim na sastanak s Jagdtigerom."

msgid "vo_sm_char02_m04_stg18_01_01"
msgstr "MacLeod: Srećko, požurimo. Gospodin ne dopušta dami da čeka."

msgid "vo_sm_char02_m04_stg19_01"
msgstr "MacLeod: Ideš! A tko si ti?"

msgid "vo_sm_char02_m04_stg19_01_01"
msgstr "MacLeod: Brooks! Zašto nas nisi upozorio na prijateljske jedinice?"

msgid "vo_sm_char02_m04_stg19_01_02"
msgstr "MacLeod: Nemoj mi reći da je obavještajna opet zabrljala!"

msgid "vo_sm_char02_m04_stg19_03"
msgstr "MacLeod: Dakle, tako izgleda naša obavještajna."

msgid "vo_sm_char02_m04_stg19_03_01"
msgstr "MacLeod: Pođi s nama, nije mudro sam napustiti grad."

msgid "vo_sm_char02_m04_stg19_05"
msgstr "MacLeod: Bože...brbljaš kao i momci iz posljednje operacije."

msgid "vo_sm_char02_m04_stg19_05_01"
msgstr "MacLeod: OK, pokret, kasnimo na sastanak."

msgid "vo_sm_char02_m04_stg20_01"
msgstr "MacLeod: Galeb!"

msgid "vo_sm_char02_m04_stg20_01_01"
msgstr "MacLeod: Mislim, Mala Burnica! Našli smo ti sočnu metu. Ovog je teško promašiti."

msgid "vo_sm_char02_m04_stg20_01_02"
msgstr "MacLeod: Srećko, ciljaj pogonski kotač!"

msgid "vo_sm_char02_m04_stg20_01_03"
msgstr "MacLeod: Srećko, ciljaj pogonski kotač!"

msgid "vo_sm_char02_m04_stg23_01"
msgstr "MacLeod: Razumio. Uskoro ćemo imati me...čekaj. Što?!"

msgid "vo_sm_char02_m04_stg23_01_01"
msgstr "MacLeod: Oh, Brooks, ti kop...to je bila naša mala tajna!"

msgid "vo_sm_char02_m04_stg23_03"
msgstr "MacLeod: Da, naravno. Razumijem, starost."

msgid "vo_sm_char02_m04_stg24_01"
msgstr "MacLeod: Blizu smo, momci. Naši anđeli čuvari će se uskoro pobrinuti za tvoje prokletstvo."

msgid "vo_sm_char02_m04_stg24_03"
msgstr "MacLeod: Što je sad?"

msgid "vo_sm_char02_m04_stg24_05"
msgstr "MacLeod: Brooks, imaš li kojim slučajem još jednog asa u rukavu, velikog poput bombardera, recimo?"

msgid "vo_sm_char02_m04_stg24_07"
msgstr "MacLeod: Pričekat ćemo. Jel' tako, Srećko?"

msgid "vo_sm_char02_m04_stg25_01"
msgstr "MacLeod: Brooks? A da malo ubrzaš stvari?"

msgid "vo_sm_char02_m04_stg25_01_01"
msgstr "MacLeod: Imamo društvo ovdje. Veliko društvo. Obavještajna, ubaci se, nemoj samo stajati tamo!"

msgid "vo_sm_char02_m04_stg26_01"
msgstr "MacLeod: Brooks, osim nas i onih momaka, napada li još netko grad?"

msgid "vo_sm_char02_m04_stg26_01_01"
msgstr "MacLeod: Mislio sam da smo na tajnoj operaciji, a ne na potpunom gradskom čišćenju."

msgid "vo_sm_char02_m04_stg26_03"
msgstr "MacLeod: I dalje je tako. Samo sam mislio da će biti malo više potpore za osvajanje grada."

msgid "vo_sm_char02_m04_stg26_05"
msgstr "MacLeod: Onda u redu. Sreća je na našoj strani. Tako je, zar ne, Srećko?"

msgid "vo_sm_char02_m04_stg27_02"
msgstr "MacLeod: Bilo je i vrijeme!"

msgid "vo_sm_char02_m04_stg28_01"
msgstr "MacLeod: Zašto uvijek mi moramo dovršiti posao?"

msgid "vo_sm_char02_m04_stg28_03"
msgstr "MacLeod: Ha! Izgleda da obojica starimo, Brooks!"

msgid "vo_sm_char02_m04_stg28_03_01"
msgstr "MacLeod: Što kažeš na partiju binga u našem umirovljeničkom klubu?"

msgid "vo_sm_char02_m04_stg29_01"
msgstr "MacLeod: Srećko, znaš što ti je činiti. Uništi te gusjenice."

msgid "vo_sm_char02_m04_stg29_01_01"
msgstr "MacLeod: Trebamo upoznati Jagdtigra s Bennet. Zasigurno će se slagati."

msgid "vo_sm_char02_m04_stg29_01_02"
msgstr "MacLeod: Srećko, znaš što ti je činiti. Uništi te gusjenice."

msgid "vo_sm_char02_m04_stg30_02"
msgstr "MacLeod: Tako treba! To je tri za tebe, Bennett."

msgid "vo_sm_char02_m04_stg30_02_01"
msgstr "MacLeod: Provedi pola dana s nama u gradu i uhvatit ćeš nas."

msgid "vo_sm_char02_m04_stg31_01"
msgstr "MacLeod: Nemoj mi reći da smo jednaki! Brooks, ima li isto Tigrova kao i mi?"

msgid "vo_sm_char02_m04_stg31_03"
msgstr "MacLeod: Mrzim kada mi ne daješ izravan odgovor."

msgid "vo_sm_char02_m04_stg32_01"
msgstr "MacLeod: Kakav mračan prizor. Izgleda da naš Mali Miš ima oštre zube."

msgid "vo_sm_char02_m04_stg32_01_01"
msgstr "MacLeod: Drži oči otvorene, Srećko. Bennett, jesi s nama?"

msgid "vo_sm_char02_m04_stg33_01"
msgstr "MacLeod: Dovraga, ovaj prokleti motor me izdao!"

msgid "vo_sm_char02_m04_stg33_01_01"
msgstr "MacLeod: Srećko, morat ćeš pogurati bez mene."

msgid "vo_sm_char02_m04_stg33_01_02"
msgstr "MacLeod: Napravit ću što mogu da te pokrivam odavde i navodim Bennettove udare."

msgid "vo_sm_char02_m04_stg33_01_03"
msgstr "MacLeod: Prokleti motor!"

msgid "vo_sm_char02_m04_stg34_01"
msgstr "MacLeod: Vidim ga. Kvragu, to je jedan pretili miš. Koliko tona ima?"

msgid "vo_sm_char02_m04_stg34_01_01"
msgstr "MacLeod: Ah, nema veze. Što je teži, to je veće opterećenje na gusjenice."

msgid "vo_sm_char02_m04_stg34_01_02"
msgstr "MacLeod: Jel' tako, Srećko? Znaš gdje treba ciljati."

msgid "vo_sm_char02_m04_stg36_01"
msgstr "MacLeod: Oklopljen je sa svih strana. Ne možemo to probiti."

msgid "vo_sm_char02_m04_stg36_01_01"
msgstr "MacLeod: Ali imamo asa u rukavu. Krov je definitivno tanak."

msgid "vo_sm_char02_m04_stg36_01_02"
msgstr "MacLeod: Srećko, koncentriraj se na gusjenice."

msgid "vo_sm_char02_m04_stg36_01_03"
msgstr "MacLeod: Srećko, koncentriraj se na gusjenice."

msgid "vo_sm_char02_m04_stg37_01"
msgstr "MacLeod: Imam te, Mišu! Mala Burnica, dovrši ga i idemo kući."

msgid "vo_sm_char02_m04_stg38_01"
msgstr "MacLeod: Koji...neprijatelj nije uništen."

msgid "vo_sm_char02_m04_stg38_01_01"
msgstr "MacLeod: Srećko, dok se Bennet vraća, pobrinimo se za nepozvane goste."

msgid "vo_sm_char02_m04_stg39_01"
msgstr "MacLeod: Stigli su mu kompići. Riješimo prvo njih tako da nam ne smetaju."

msgid "vo_sm_char02_m04_stg40_01"
msgstr "MacLeod: Kuda ide? Skriva li se? Srećko, otjerao si ga."

msgid "vo_sm_char02_m04_stg40_01_01"
msgstr "MacLeod: Još jedna runda pozdrava od Bennetta i gotovi smo."

msgid "vo_sm_char02_m04_stg41_01"
msgstr "MacLeod: Eto. Uhvatio sam ga. Bennett, dovrši ovu uzbudljivu, ali zamornu pustolovinu."

msgid "vo_sm_char02_m04_stg42_01"
msgstr "MacLeod: Hmmm...ovo postaje naporno."

msgid "vo_sm_char02_m04_stg42_01_01"
msgstr "MacLeod: Što je s tobom? Trebao bi biti u plamenu sada."

msgid "vo_sm_char02_m04_stg42_01_02"
msgstr "MacLeod: Prokletstvo! Srećko, mislim da sam ga razljutio."

msgid "vo_sm_char02_m04_stg43_01"
msgstr "MacLeod: Srećko, oprezno. Imamo svježu hrpu neprijatelja."

msgid "vo_sm_char02_m04_stg44_01"
msgstr "MacLeod: Srećko, ciljaj samo gusjenice. Ne troši granate, ne možemo probiti njegov oklop."

msgid "vo_sm_char02_m04_stg45_01"
msgstr "MacLeod: Bennet, stjeran je u kut poput štakora! Daj sve od sebe!"

msgid "vo_sm_char02_m04_stg46_01"
msgstr "MacLeod: To! Sređeno!"

msgid "vo_sm_char02_m04_stg46_03"
msgstr "MacLeod: Hvala na pomoći, Bennett. Dužnici smo ti!"

msgid "vo_sm_char02_m04_stg47_02"
msgstr "MacLeod: Pfff, odličja. Imam ih dosta."

msgid "vo_sm_char02_m04_stg47_04"
msgstr "MacLeod: Bingo! Što kažete na partiju binga? Srećko, hoćeš li?"

msgid "vo_sm_char02_m04_stg53_01"
msgstr "MacLeod: Imobilizirali smo ga, Bennett. Slobodno udaraj."

msgid "vo_sm_char02_m04_stg54_01"
msgstr "MacLeod: Mala Burnica, mete gusjenice su van stroja. Tvoj je."

msgid "vo_sm_char02_m04_stg55_01"
msgstr "MacLeod: Gusjenice van stroja. Zrakoplovci, vaš red za ples."

msgid "vo_sm_char02_m04_stg56_01"
msgstr "MacLeod: Meta je imobilizirana, Bennett."

msgid "vo_sm_char02_m05_stg59_02"
msgstr "MacLeod: Par šala je kao motorno ulje za ekipu! Pomaže da idu bez kvara."

msgid "vo_sm_char02_m05_stg60_02"
msgstr "MacLeod: Dakle, moji govori nisu bitni? Slomio si mi srce, prijatelju!"

msgid "vo_sm_char03_m05_stg01_02"
msgstr "Connolly: Prokletstvo! Izgubili smo našeg zapovjednika! Momci, sada je na nama."

msgid "vo_sm_char03_m05_stg01_02_01"
msgstr "Connolly: Svi budite oprezni-mine su svuda oko nas."

msgid "vo_sm_char03_m05_stg03_01"
msgstr "Connolly: Dovraga! Bunkeri su uništili tenk za čišćenje mina!"

msgid "vo_sm_char03_m05_stg03_03"
msgstr "Connolly: Dovraga! Mine! Mrzim mine!"

msgid "vo_sm_char03_m05_stg04_01"
msgstr "Connolly: Moramo uništiti te proklete bunkere."

msgid "vo_sm_char03_m05_stg04_01_01"
msgstr "Connolly: Jedva ih možemo načeti iz tenka, ali nije da baš imamo izbora."

msgid "vo_sm_char03_m05_stg04_01_02"
msgstr "Connolly: Možda ćemo imati sreće i ugurati jednog kroz pukotinu i sve to srušiti!"

msgid "vo_sm_char03_m05_stg04_04"
msgstr "Connolly: Nastavite s paljbom, moramo ih uništiti. To nam je jedina nada."

msgid "vo_sm_char03_m05_stg08_01"
msgstr "Connolly: Bunkeri su pali. Tenkovi za čišćenje mina mogu sada prokrčiti put."

msgid "vo_sm_char03_m05_stg09_01"
msgstr "Connolly: Put je otvoren...konačno! U napad!"

msgid "vo_sm_char03_m05_stg11_01"
msgstr "Connolly: Neprijateljski tenkovi primjećeni ispred nas. Spremite se za gužvu."

msgid "vo_sm_char03_m05_stg12_01"
msgstr "Connolly: Dovraaga, moramo brzo uništiti ovaj bunker. Moramo odmah stići do PZO topova."

msgid "vo_sm_char03_m05_stg13_01"
msgstr "Connolly: Ha-ha! Izgleda da su im popustili živci!"

msgid "vo_sm_char03_m05_stg13_01_01"
msgstr "Connolly: Zbrisali su i napustili svoje PZO topove čim su čuli zvuk naših tenkova."

msgid "vo_sm_char03_m05_stg18_01"
msgstr "Connolly: Sljedeći bunker će biti tvrdi orah."

msgid "vo_sm_char03_m05_stg18_01_01"
msgstr "Connolly: Obilježite ga dimom i neka bojni brod puca na njega."

msgid "vo_sm_char03_m05_stg19_01"
msgstr "Connolly: Ovaj sljedeći bunker je dobro branjen. Moramo ga udariti punom snagom s obje strane."

msgid "vo_sm_char03_m05_stg19_01_01"
msgstr "Connolly: Pomognite Francuzu da napravi svoje dok ih satnik Murphy i ja zadržavamo."

msgid "vo_sm_char03_m05_stg20_01"
msgstr "Connolly: Sada kada smo podržali satnika Dubois imamo dovoljno vatrene moći za napad na onaj bunker na vrhu brda."

msgid "vo_sm_char03_m05_stg22_01"
msgstr "Connolly: Naša sljedeća meta je veliki priobalni top."

msgid "vo_sm_char03_m05_stg22_01_01"
msgstr "Connolly: Ako ga uklonimo naš bojni brod se može postaviti za potpunu topničku podršku."

msgid "vo_sm_char03_m05_stg25_01"
msgstr "Connolly: Ah, pogledajte ovo, momci! RAF dolazi punom snagom."

msgid "vo_sm_char03_m05_stg25_01_01"
msgstr "Connolly: Kakav prizor! To je prekasno letenje!"

msgid "vo_sm_char03_m05_stg32_01"
msgstr "Connolly: Momci, okupite se. Neprijatelj nam neće dati ni milimetra pa nećemo ni mi njima."

msgid "vo_sm_char03_m05_stg33_01"
msgstr "Connolly: To je to! Okrenuli smo tijek."

msgid "vo_sm_char03_m05_stg35_01"
msgstr "Connolly: Obilježite mete dimom za bojni brod."

msgid "vo_sm_char03_m05_stg35_02"
msgstr "Connolly: Ne zaboravite posatviti dim."

msgid "vo_sm_char03_m05_stg35_03"
msgstr "Connolly: Koristite dimne oznake. Piloti mogu prenijeti te koordinate."

msgid "vo_sm_char03_m05_stg35_04"
msgstr "Connolly: To je žilava meta. Obilježite je dimom."

msgid "vo_sm_char03_m05_stg36_01"
msgstr "Connolly: Sherman, vrijeme je za pokret! Bitka ne čeka na nas."

msgid "vo_sm_char03_m05_stg36_02"
msgstr "Connolly: Sherman, probudi se!"

msgid "vo_sm_char03_m05_stg36_03"
msgstr "Connolly: Zašto si stao, Sherman? Mehanički problemi?"

msgid "vo_sm_char03_m05_stg36_04"
msgstr "Connolly: Daj, Sherman, nema vremena za ćaskanje. Bojišnica je ispred nas!"

msgid "vo_sm_char03_m05_stg36_05"
msgstr "Connolly: Sherman, vrijeme nije na našoj strani! Idemo!"

msgid "vo_sm_char03_m05_stg37_02"
msgstr "Connolly: Čaj bi bio bolji, ali i kava je dobra."

msgid "vo_sm_char03_m05_stg38_02"
msgstr "Connolly: Bolje je držati se tla, satniče Murphy. Sigurnije je. Za sve."

msgid "vo_sm_char03_m05_stg40_01"
msgstr "Connolly: Pozor, gospodo. Pristiže nova neprijateljska grupa."

msgid "vo_sm_char03_m05_stg45_01"
msgstr "Connolly: Lijepo vas je vidjeti ponovno u pokretu! Budite na oprezu tamo."

msgid "vo_sm_char03_m05_stg45_02"
msgstr "Connolly: Uzdigli iz pepela, jači nego prije. Evo nas!"

msgid "vo_sm_char03_m05_stg46_01"
msgstr "Connolly: Kvragu! Moj tenk je izbačen iz stroja. Nastavite bez mene."

msgid "vo_sm_char03_m05_stg46_02"
msgstr "Connolly: Pa, ovo je kraj vožnje. Ali, dobro smo se potrudili."

msgid "vo_sm_char03_m05_stg46_03"
msgstr "Connolly: Moj tenk je vani, ali nismo mi. Uskoro ćemo se vratiti u borbu."

msgid "vo_sm_char04_m05_stg03_02"
msgstr "Skidaju nas jednog po jednog! Prema liticama!"

msgid "vo_sm_char04_m05_stg03_02_01"
msgstr "Stajati kao glineni golub na otvorenom je samoubojstvo."

msgid "vo_sm_char04_m05_stg03_02_02"
msgstr "Litice mogu pružiti nešto zaštite."

msgid "vo_sm_char04_m05_stg16_02"
msgstr "Murphy: Ovdje satnik Murphy. Upravo smo se iskrcali, ali nas pritišće bunker gore na padini."

msgid "vo_sm_char04_m05_stg16_02_01"
msgstr "Murphy: Trebamo podršku kako bi se pokrenuli!"

msgid "vo_sm_char04_m05_stg17_01"
msgstr "Murphy: Bunker je gotov! Put je širom otvoren. Krenimo!"

msgid "vo_sm_char04_m05_stg17_01_01"
msgstr "Murphy: Hej, pogledaj ovo! Naši momci ih melju! Vrijeme je da se uključimo!"

msgid "vo_sm_char04_m05_stg19_02"
msgstr "Murphy: Zvuči dobro. Zagorčajte im život!"

msgid "vo_sm_char04_m05_stg20_02"
msgstr "Murphy: U redu, krenimo i udarimo ih jako!"

msgid "vo_sm_char04_m05_stg22_02"
msgstr "Murphy: Ho-ho! S takvom vatrenom moći iza nas možemo gurati u unutrašnjost bez prestanka."

msgid "vo_sm_char04_m05_stg23_01"
msgstr "Murphy: Izgleda da je PZO utihnula."

msgid "vo_sm_char04_m05_stg23_01_01"
msgstr "Murphy: Izgleda da oni topnici bježe brže od zeca kada nas ugledaju."

msgid "vo_sm_char04_m05_stg23_01_02"
msgstr "Murphy: Mora da je naša šarmantna osobnost, zar ne?"

msgid "vo_sm_char04_m05_stg28_02"
msgstr "Murphy: To! Uspjeli smo!"

msgid "vo_sm_char04_m05_stg28_02_01"
msgstr "Murphy: Uhvatite dah i onda krenimo i dobro natamburajmo neprijatelja."

msgid "vo_sm_char04_m05_stg30_02"
msgstr "Murphy: Idemo na položaj. Upamtite, imamo iza nas topove bojnog broda."

msgid "vo_sm_char04_m05_stg33_02"
msgstr "Murphy: Bila je gadna borba. Ali, uspjeli smo! Nastavimo ovako dalje!"

msgid "vo_sm_char04_m05_stg35_05"
msgstr "Murphy: Gdje je tvoj dimni marker? Moj rođak je na brodu. I on voli pucati!"

msgid "vo_sm_char04_m05_stg35_06"
msgstr "Murphy: Čovječe, volio bih da imamo jedan od tih dimnih markera. Oduvijek sam htio pozvati veće topove."

msgid "vo_sm_char04_m05_stg35_07"
msgstr "Murphy: Obilježite ih dimom i neka bojni brod odradi ostalo."

msgid "vo_sm_char04_m05_stg36_06"
msgstr "Murphy: Sherman, što se čeka? Vrijeme je da stisneš gas!"

msgid "vo_sm_char04_m05_stg36_07"
msgstr "Murphy: Sherman, nemamo cijeli dan! Pokreni se, sada!"

msgid "vo_sm_char04_m05_stg36_08"
msgstr "Murphy: Sherman, trebamo napredovati!"

msgid "vo_sm_char04_m05_stg36_09"
msgstr "Murphy: Nema vremena za sjedenje, Sherman! Pokreni se!"

msgid "vo_sm_char04_m05_stg37_01"
msgstr "Murphy: Sada bi mi dobro došla šalica kave."

msgid "vo_sm_char04_m05_stg38_01"
msgstr "Murphy: Sljedeći put bih volio letiti na jednom od onih bombardera. Volim nebo."

msgid "vo_sm_char04_m05_stg39_01"
msgstr "Murphy: Hey, Dubois, misliš da je tvoj tenk brži od mog?"

msgid "vo_sm_char04_m05_stg40_02"
msgstr "Murphy: U napad! Za najbolje vinograde na planeti!"

msgid "vo_sm_char04_m05_stg40_04"
msgstr "Murphy: Čekaj, što sam rekao?"

msgid "vo_sm_char04_m05_stg41_01"
msgstr "Murphy: Hey, Dubois, znaš neke francuske pjesmice za podizanje morala?"

msgid "vo_sm_char04_m05_stg41_03"
msgstr "Murphy: Stvarno? Nikad nisam znao što su riječi značile."

msgid "vo_sm_char04_m05_stg42_01"
msgstr "Murphy: Kako zovete četvrtaš sa sirom u Parizu?"

msgid "vo_sm_char04_m05_stg43_01"
msgstr "Murphy: Dubois, je li istina da francuski tenkovi imaju kifle umjesto poluga?"

msgid "vo_sm_char04_m05_stg43_03"
msgstr "Murphy: Ozbiljan kao i ti, samo sa osmjehom."

msgid "vo_sm_char04_m05_stg44_02"
msgstr "Murphy: Što to znači, Dubois?"

msgid "vo_sm_char04_m05_stg45_03"
msgstr "Murphy: Nazad u akciju, ha? Nastavi tiskati, vjerujemo u tebe."

msgid "vo_sm_char04_m05_stg45_04"
msgstr "Murphy: Vratio si se! To je duh! Zagoračj im život."

msgid "vo_sm_char04_m05_stg46_04"
msgstr "Murphy: Tenk pogođen! Izgleda da idemo pješke, dečki."

msgid "vo_sm_char04_m05_stg46_05"
msgstr "Murphy: Pa, to je to. Moj tenk je van stroja, ali ću se vratiti!"

msgid "vo_sm_char04_m05_stg46_06"
msgstr "Murphy: Naša pila je razbijena. Dobro sam, ne brinite. Vratit ću se u novoj!"

msgid "vo_sm_char04_m06_outro_02"
msgstr "Murphy: Što? Luda hrabrost pet hazardera?"

msgid "vo_sm_char04_m06_outro_11"
msgstr "Murphy: Nikad više."

msgid "vo_sm_char04_m06_stg02_01"
msgstr "Vozač, satnik Murphy: Hej, polako! Minska polja ispred nas!"

msgid "vo_sm_char04_m06_stg02_02"
msgstr "Murphy: Hej, Keller, nekad si ovdje služio...imaš kakvu pametnu zamisao?"

msgid "vo_sm_char04_m06_stg02_04"
msgstr "Murphy: Onda idemo u grad! Vrijeme je za mape, perece i šnicle!"

msgid "vo_sm_char04_m06_stg06_06"
msgstr "Murphy: Hajde, Profesore, daj nam tvoje radio čarolije."

msgid "vo_sm_char04_m06_stg06_12"
msgstr "Murphy: Da sam bar imao takvog Kellera prije šest mjeseci..."

msgid "vo_sm_char04_m06_stg06_14"
msgstr "Murphy: Dovraga. Ovo je uistinu nevidljivi zadatak."

msgid "vo_sm_char04_m06_stg06_14_01"
msgstr "Murphy: Mislio sam da govorimo u prenesenom značenju."

msgid "vo_sm_char04_m06_stg07_02"
msgstr "Murphy: I nema straže na vidiku! Fortuna je danas na našoj strani."

msgid "vo_sm_char04_m06_stg08_08"
msgstr "Murphy: Opa, momci, imamo lov na Uskršnje jaje!"

msgid "vo_sm_char04_m06_stg09_03"
msgstr "Murphy: Na zapovijed, satniče, samo sekundu. Dovraga. Dubois, daj mi olovku. Izgubio sam svoju."

msgid "vo_sm_char04_m06_stg09_05"
msgstr "Murphy: Oh, u redu. Keller, imaš li...Bleistift?"

msgid "vo_sm_char04_m06_stg09_08"
msgstr "Murphy: Ha! Hvala, Keller."

msgid "vo_sm_char04_m06_stg10_02"
msgstr "Murphy: Oh!! Novi dijelić slagalice! Tako je lijepo dobiti poklone od tebe, Dubois!"

msgid "vo_sm_char04_m06_stg11_02"
msgstr "Murphy: Jack Murphy za tebe, monsieur Delacroix! Kada ćeš zapamtiti moje ime?"

msgid "vo_sm_char04_m06_stg12_03"
msgstr "Murphy: Samo tren. Gdje mi je olovka..."

msgid "vo_sm_char04_m06_stg12_05"
msgstr "Murphy: Dobro, dobro, kupit ću ti cijelu kutiju olovaka, Dubois!"

msgid "vo_sm_char04_m06_stg12_05_01"
msgstr "Murphy: Stižemo! Ovo je moj omiljeni dijelić!"

msgid "vo_sm_char04_m06_stg15_03"
msgstr "Murphy: Sigurno si svuda gledao?"

msgid "vo_sm_char04_m06_stg15_05"
msgstr "Murphy: Hej, možda je poput mojih čarapa-uvijek na zadnjem mjestu gdje tražiš!"

msgid "vo_sm_char04_m06_stg16_02"
msgstr "Murphy: Sekunda...sve se poklapa. Čovječe, kakav labirint!"

msgid "vo_sm_char04_m06_stg16_02_01"
msgstr "Murphy: Zvao bih ga minskotaurov labirint!! Haha. Shvaćaš? Ne?"

msgid "vo_sm_char04_m06_stg16_02_02"
msgstr "Murphy: Daj, to je bilo super!"

msgid "vo_sm_char04_m06_stg16_04"
msgstr "Murphy: Umoran si od punjenja granata, Dubois?"

msgid "vo_sm_char04_m06_stg18_03"
msgstr "Murphy: Provjerimo. Pozor svi."

msgid "vo_sm_char04_m06_stg19_02"
msgstr "Murphy: Oh, a ja sam se nadao za tajno njemačko skladište zlata."

msgid "vo_sm_char04_m06_stg19_02_01"
msgstr "Murphy: Reci, Keller, držite li nešto zlata ovdje?"

msgid "vo_sm_char04_m06_stg19_04"
msgstr "Murphy: Točno to bih ja rekao da skrivam zlato ovdje."

msgid "vo_sm_char04_m06_stg19_04_01"
msgstr "Murphy: Satniče Smith, hoćemo li potražiti...mapu?"

msgid "vo_sm_char04_m06_stg21_03"
msgstr "Murphy: Provukli se pored njih!"

msgid "vo_sm_char04_m06_stg21_04"
msgstr "Murphy: Jesi vidio to? Ne-vid-lji-vi smo!"

msgid "vo_sm_char04_m06_stg23_04"
msgstr "Murphy: Ovaj..možda bi se trebali povući? Prije nego postane gusto?"

msgid "vo_sm_char04_m06_stg23_05"
msgstr "Murphy: Glasujem za taktičko povlačenje. Netko sa mnom?"

msgid "vo_sm_char04_m06_stg24_03"
msgstr "Murphy: Vrijeme je da nađemo mjesto za skrivanje prije nego dođe dobrodošlica!"

msgid "vo_sm_char04_m06_stg25_02"
msgstr "Murphy: Pfff...naša nevidljiva tenkovska operacija radi! Tko bi rekao?"

msgid "vo_sm_char04_m06_stg26_04"
msgstr "Murphy: Vrijeme je za ples s pancerima!"

msgid "vo_sm_char04_m06_stg26_05"
msgstr "Murphy: Pokažimo im što ovaj Chaffee može napraviti!"

msgid "vo_sm_char04_m06_stg26_06"
msgstr "Murphy: Ajmo, dame i gospodo!"

msgid "vo_sm_char04_m06_stg27_02"
msgstr "Murphy: Ideš! Tako se to radi!"

msgid "vo_sm_char04_m06_stg28_03"
msgstr "Murphy: U sridu!"

msgid "vo_sm_char04_m06_stg29_02"
msgstr "Murphy: Dovraga, ta meta je bila ogromna!"

msgid "vo_sm_char04_m06_stg30_02"
msgstr "Murphy: Satniče, možda bi Dubois trebao ići prvi provjeriti?"

msgid "vo_sm_char04_m06_stg31_07"
msgstr "Murphy: Prehladno je tamo, a ja sam zaboravio svoju jaknu."

msgid "vo_sm_char04_m06_stg35_02"
msgstr "Murphy: Možda je vrijeme da gledamo kako naš profesor čarobira s radiom?"

msgid "vo_sm_char04_m06_stg42_02"
msgstr "Murphy: Hej, razgledavanje je super, ali ne bi li trebali biti u lovu na one dijeliće mapa?"

msgid "vo_sm_char04_m06_stg43_03"
msgstr "Murphy: Probudi se, evo jaja s tenkovima!"

msgid "vo_sm_char04_m06_stg44_02"
msgstr "Murphy: Izgleda da ćemo to učiniti na glasan način!"

msgid "vo_sm_char04_m06_stg45_02"
msgstr "Murphy: Kladim se da ima bolji način za obilaženje ovog nereda!"

msgid "vo_sm_char04_m06_stg46_02"
msgstr "Murphy: Hej, Keller, pokaži im svoj trik s radiom!"

msgid "vo_sm_char04_m06_stg47_02"
msgstr "Murphy: Kako bi bilo da im dosadi i da odemo?"

msgid "vo_sm_char04_m06_stg48_02"
msgstr "Murphy: Hej, ekipa, možda slijedeći put probati da ne eksplodira?"

msgid "vo_sm_char04_m06_stg53_02"
msgstr "Murphy: Netko je mali podlac! Nevaljanko!"

msgid "vo_sm_char04_m06_stg54_02"
msgstr "Murphy: Vrijeme brzo teče, moramo biti brži."

msgid "vo_sm_char04_m06_stg55_01"
msgstr "Murphy: Ha! Sredili smo ovo! A rekli su da će biti gadno."

msgid "vo_sm_char04_m06_stg55_04"
msgstr "Murphy: Ne brinite, dečki, stari Murphy se prebacuje na ludi način vožnje."

msgid "vo_sm_char04_m06_stg56_02"
msgstr "Murphy: Daj, Dubois, previše brineš! Što je najgore što se može desiti?"

msgid "vo_sm_char04_m06_stg56_04"
msgstr "Murphy: Ne može, profesore! Gas do daske ili lijes!"

msgid "vo_sm_char04_m06_stg56_06"
msgstr "Murphy: Smiri se, mon ami! Mapa mi je u glavi."

msgid "vo_sm_char04_m06_stg57_02"
msgstr "Murphy: Tiger? To je to? Gdje su sva ona čudesna oružja o kojima slušam?"

msgid "vo_sm_char04_m06_stg58_02"
msgstr "Murphy: Manevar? MANEVAR?"

msgid "vo_sm_char04_m06_stg58_02_01"
msgstr "Murphy: U ovom uskom prolazu je to točno jedan i pol širine Chaffeea?"

msgid "vo_sm_char04_m06_stg58_02_02"
msgstr "Murphy: Gdje bih točno trebao manevrirati?"

msgid "vo_sm_char04_m06_stg59_03"
msgstr "Murphy: Daj, molim te! Tiger, nemate li druge tenkove koje možeš ganjati?"

msgid "vo_sm_char04_m06_stg60_03"
msgstr "Murphy: Ne sviđa mi se kako ovaj Tiger usmjerava cijev na nas!"

msgid "vo_sm_char04_m06_stg61_02"
msgstr "Murphy: Jesi li osjetio taj vjetrić? Ja bome jesam!"

msgid "vo_sm_char04_m06_stg62_01"
msgstr "Murphy: Samo ogrebotina! Jedva sam i osjetio!"

msgid "vo_sm_char04_m06_stg62_02"
msgstr "Murphy: Hej! Upravo sam uglancao ovaj tenk!"

msgid "vo_sm_char04_m06_stg63_03"
msgstr "Murphy: Ciljaj gusjenice, Kowalski!"

msgid "vo_sm_char04_m06_stg64_02"
msgstr "Murphy: Nisi tako opak bez gusjenica, ha?"

msgid "vo_sm_char04_m06_stg68_01"
msgstr "Murphy: Ups! Ova mina nije bila na mapi!"

msgid "vo_sm_char04_m06_stg68_02"
msgstr "Murphy: Mine! Ah, da. Znao sam to."

msgid "vo_sm_char04_m06_stg69_01"
msgstr "Murphy: Dovraga! Odakle se ovaj stvorio?"

msgid "vo_sm_char04_m06_stg70_02"
msgstr "Murphy: Čemu takva ozbiljnost? Ovo je bilo eksplozivno? Kužiš? Zbog mina?"

msgid "vo_sm_char04_m06_stg70_02_01"
msgstr "Murphy: Dajte, momci!"

msgid "vo_sm_char04_m06_stg71_02"
msgstr "Murphy: Bogamu...svi ti ljudi...bili smo tako blizu!"

msgid "vo_sm_char04_m06_stg73_01"
msgstr "Murphy: Dubois, je li istina da francuski tenkovi imaju espreso strojeve?"

msgid "vo_sm_char04_m06_stg73_03"
msgstr "Murphy: Odgovorio si tako ozbiljno da sam ti skoro povjerovao. Šalio si se, zar ne?"

msgid "vo_sm_char04_m06_stg74_02"
msgstr "Murphy: Ne...ja sam sa svojim momcima išao sjevernije."

msgid "vo_sm_char04_m06_stg74_02_01"
msgstr "Murphy: Ali ću zasigurno posjetiti nakon rata."

msgid "vo_sm_char04_m06_stg74_02_02"
msgstr "Murphy: I popet ću se na Pizzin toranj."

msgid "vo_sm_char04_m06_stg75_01"
msgstr "Murphy: Dubois, jesi li znao da pričaš u snu?"

msgid "vo_sm_char04_m06_stg75_03"
msgstr "Murphy: Što znači ''Wee, wee, ma share-ee''?"

msgid "vo_sm_char04_m06_stg76_01"
msgstr "Murphy: Dubois, jesi li razmišljao da me naučiš malo francuski?"

msgid "vo_sm_char04_m06_stg76_03"
msgstr "Murphy: Što? Ne razumijem."

msgid "vo_sm_char04_m06_stg76_05"
msgstr "Murphy: Što? Oh...wow...pokušavaš nadmudriti mudrijaša, zar ne?"

msgid "vo_sm_char04_m06_stg76_05_01"
msgstr "Murphy: Dobar pokušaj, ali se igraš s vatrom, Dubois!"

msgid "vo_sm_char04_m06_stg77_01"
msgstr "Murphy: Plešeš li polku, Kowalski?"

msgid "vo_sm_char04_m06_stg77_03"
msgstr "Murphy: Napravimo to! Imat ćemo tulum gdje će svi plesati polku!"

msgid "vo_sm_char04_m06_stg77_05"
msgstr "Murphy: Naravno! Mislim...ne tako. Znaš na što mislim. Nadam se."

msgid "vo_sm_char04_m06_stg78_02"
msgstr "Murphy: U čemu je problem?"

msgid "vo_sm_char04_m06_stg78_04"
msgstr "Murphy: To zovem \"taktičko manevriranje\". Neka neprijatelj uvijek pogađa!"

msgid "vo_sm_char04_m06_stg79_01"
msgstr "Murphy: Kowalski, da smo u bendu, koji bi instrument svirao?"

msgid "vo_sm_char04_m06_stg79_03"
msgstr "Murphy: Ovaj...ja bih bio solo gitara..."

msgid "vo_sm_char04_m06_stg80_01"
msgstr "Murphy: Keller, misliš da bi mogao naštimati radio da čujemo neku glazbu?"

msgid "vo_sm_char04_m06_stg80_03"
msgstr "Murphy: Samo malo? Glazba bi nam podigla moral!"

msgid "vo_sm_char04_m06_stg80_05"
msgstr "Murphy: Oh. U redu. Možda je onda bolje da se ne igramo s postavkama."

msgid "vo_sm_char04_m06_stg81_01"
msgstr "Murphy: Sanjao sam noćas da smo svi bili u ribolovu."

msgid "vo_sm_char04_m06_stg81_03"
msgstr "Murphy: Stara cipela."

msgid "vo_sm_char04_m06_stg81_05"
msgstr "Murphy: Hej, znao sam da si duboko u sebi optimist."

msgid "vo_sm_char04_m06_stg81_05_01"
msgstr "Murphy: Uvijek tražiš ono dobro."

msgid "vo_sm_char04_m06_stg82_01"
msgstr "Murphy: Satniče, ispričaj nam smiješnu šalu."

msgid "vo_sm_char04_m06_stg82_03"
msgstr "Murphy: Netko drugi? Kowalski? Keller? Dubois, oprosti, ne pitam tebe."

msgid "vo_sm_char04_m06_stg82_05"
msgstr "Murphy: Pa...idi naprijed ako želiš."

msgid "vo_sm_char04_m06_stg82_07"
msgstr "Murphy: ...zato."

msgid "vo_sm_char04_m06_stg83_02"
msgstr "Murphy: \"Kukavice umiru mnogo puta prije svoje smrti;\""

msgid "vo_sm_char04_m06_stg83_02_01"
msgstr "Murphy: \"Hrabri nikada ne dožive smrt osim jednom\", zar ne?"

msgid "vo_sm_char04_m06_stg83_04"
msgstr "Murphy: Da? Zvučalo mi je francuski."

msgid "vo_sm_char04_m06_stg84_01"
msgstr "Murphy: Misliš da će po nama imenovati ulicu?"

msgid "vo_sm_char04_m06_stg84_03"
msgstr "Murphy: U pravu si. Trebamo ime posade!"

msgid "vo_sm_char04_m06_stg84_05"
msgstr "Murphy: Hm...predugačko ime. Sviđa mi se RJEŠAVATELJI PROBLEMA."

msgid "vo_sm_char04_m06_stg85_01"
msgstr "Murphy: Hej, Kowalski, smiješ li se ti ikada?"

msgid "vo_sm_char04_m06_stg85_03"
msgstr "Murphy: Izazov prihvaćen! Probit ću taj tvoj oklop!"

msgid "vo_sm_char04_m06_stg85_05"
msgstr "Murphy: U redu, slušaj: Kuc-kuc."

msgid "vo_sm_char04_m06_stg85_06"
msgstr "Murphy: Trebaš pitati \"Tko je?\""

msgid "vo_sm_char04_m06_stg85_07"
msgstr "Murphy: Dobro, ovo će biti teže nego što sam mislio."

msgid "vo_sm_char04_m06_stg87_01"
msgstr "Murphy: Što je to?!"

msgid "vo_sm_char04_m06_stg87_03"
msgstr "Murphy: U mojoj je čizmi. Oh! To je olovka."

msgid "vo_sm_char04_m06_stg88_01"
msgstr "Murphy: Hej, Keller, hvataš li nešto zanimljivo na njemačkim kanalima?"

msgid "vo_sm_char04_m06_stg88_03"
msgstr "Murphy: Ha! To smo mi! Fantomski tenk! Najgora noćna mora Nijemaca!"

msgid "vo_sm_char04_m06_stg88_04"
msgstr "Murphy: Keller, kladim se da nikad nisi mislio da ćeš se šuljati okolo u američkom tenku!"

msgid "vo_sm_char04_m06_stg88_06"
msgstr "Murphy: Život je čudan, zar ne? Kao kutija čokolade!"

msgid "vo_sm_char04_m06_stg90_03"
msgstr "Murphy: Oh!!! Kowalski! Moraš čitati tekst Marseljeze!"

msgid "vo_sm_char04_m06_stg90_03_01"
msgstr "Murphy: Ima nečeg...nekakvih stvari, stvarno krvavih stvari!"

msgid "vo_sm_char04_m06_stg91_02"
msgstr "Murphy: Da!"

msgid "vo_sm_char04_m06_stg92_01"
msgstr "Murphy: Ako netko pita, mi smo putujući cirkus."

msgid "vo_sm_char04_m06_stg92_03"
msgstr "Murphy: Treba nam priča-sada smo špijuni!"

msgid "vo_sm_char04_m06_stg93_01"
msgstr "Murphy: Misliš li da mogu dobiti špijunsko naliv pero nakon ovog zadatka?"

msgid "vo_sm_char04_m06_stg93_03"
msgstr "Murphy: Tako si sitničav, Dubois!"

msgid "vo_sm_char05_m05_stg18_02"
msgstr "Dubois: Bonjour, monsieurs! Govori satnik Dubois."

msgid "vo_sm_char05_m05_stg18_02_01"
msgstr "Dubois: Iskrcali smo se na H1, ali nas pritišće žestoka neprijateljska paljba."

msgid "vo_sm_char05_m05_stg18_02_02"
msgstr "Dubois: Hitno trebamo pomoć!"

msgid "vo_sm_char05_m05_stg19_04"
msgstr "Dubois: Ah, put je čist. Konačno! En avant, pridružimo se borbi. Vive la France!"

msgid "vo_sm_char05_m05_stg21_01"
msgstr "Dubois: Merci mon ami! Jedan smo korak bliže oslobađanju moje domovine."

msgid "vo_sm_char05_m05_stg27_01"
msgstr "Dubois: Magnifique! Priobalni topovi su tihi."

msgid "vo_sm_char05_m05_stg27_01_01"
msgstr "Dubois: Sada se bojni brod može približiti i pružiti nam snažnu podršku."

msgid "vo_sm_char05_m05_stg27_01_02"
msgstr "Dubois: Gledajmo vatromet!"

msgid "vo_sm_char05_m05_stg29_01"
msgstr "Dubois: Spreman za borbu. Nikada više neću napustiti francusko tlo. Plus jamais de retraite!"

msgid "vo_sm_char05_m05_stg33_03"
msgstr "Dubois: Ovo je tek početak. Kraj rata je na vidiku."

msgid "vo_sm_char05_m05_stg35_08"
msgstr "Dubois: Obilježite mete dimom, mes amis. Neka bojni brod oslobodi Francusku!"

msgid "vo_sm_char05_m05_stg35_09"
msgstr "Dubois: Dobro postavljen dimni signal donosi sreći i obasipa neprijatelja paljbom!"

msgid "vo_sm_char05_m05_stg36_10"
msgstr "Dubois: Vrijeme je za pokret, Sherman, vite-vite!"

msgid "vo_sm_char05_m05_stg36_11"
msgstr "Dubois: Sherman, moramo ići, allons!"

msgid "vo_sm_char05_m05_stg36_12"
msgstr "Dubois: Sherman, požuri! Francuska čeka!"

msgid "vo_sm_char05_m05_stg39_02"
msgstr "Dubois: Satniče Murphy, ovo nije natjecanje; ovdje se radi o oslobađanju moje domovine."

msgid "vo_sm_char05_m05_stg39_02_01"
msgstr "Dubois: I to pitanje...smiješno! Imam teški tenk, kako mogu biti brži?"

msgid "vo_sm_char05_m05_stg40_03"
msgstr "Dubois: Za Francusku!"

msgid "vo_sm_char05_m05_stg41_02"
msgstr "Dubois: Pjevušim \"Marseljezu\". Pristaje bitci. Njene riječi nas još žešće pokreću."

msgid "vo_sm_char05_m05_stg42_02"
msgstr "Dubois: Burgeri? Ne jedemo burgere u Francuskoj, Murphy."

msgid "vo_sm_char05_m05_stg42_02_01"
msgstr "Dubois: Draži su nam naši sendviči s pecivom, sa finim sirom i narescima."

msgid "vo_sm_char05_m05_stg43_02"
msgstr "Dubois: Satniče Murphy, nekad se pitam koliko ozbiljno shvaćate ovaj rat."

msgid "vo_sm_char05_m05_stg44_01"
msgstr "Dubois: Sur le risque disparu, sur l’espoir sans souvenir, j’écris ton nom..."

msgid "vo_sm_char05_m05_stg44_03"
msgstr "Dubois: Znači da su gotovi, Murphy."

msgid "vo_sm_char05_m05_stg45_05"
msgstr "Dubois: Dobrodošli natrag u borbu. Vaša otpornost je nadahnjujuća."

msgid "vo_sm_char05_m05_stg46_07"
msgstr "Dubois: Mon dieu, naš tenk je gotov! Moramo se povući."

msgid "vo_sm_char05_m05_stg46_08"
msgstr "Dubois: Za ovaj tenk je ovo kraj. Dali smo sve od sebe, mes amis."

msgid "vo_sm_char05_m05_stg46_08_01"
msgstr "Dubois: Ali ja ću nastaviti oslobađanje Francuske!"

msgid "vo_sm_char05_m05_stg46_09"
msgstr "Dubois: Posljednji tenk je uništen, ali ne i naš duh. Vratit ću se!"

msgid "vo_sm_char05_m06_outro_01"
msgstr "Dubois: Tako da naposljetku može zaustaviti krvoproliće."

msgid "vo_sm_char05_m06_outro_03"
msgstr "Dubois: Komad papira. Jedan običan komad papira može sve zaustaviti."

msgid "vo_sm_char05_m06_outro_05"
msgstr "Dubois: Što onda?"

msgid "vo_sm_char05_m06_outro_09"
msgstr "Dubois: Plus jamais."

msgid "vo_sm_char05_m06_stg04_02"
msgstr "Punitelj, satnik Dubois: Da, gospodine!"

msgid "vo_sm_char05_m06_stg04_03"
msgstr "Dubois: Tenkovi uočeni."

msgid "vo_sm_char05_m06_stg06_11"
msgstr "Dubois: Magnifique! Čak je i radilo!"

msgid "vo_sm_char05_m06_stg08_02"
msgstr "Dubois: Da, gospodine!"

msgid "vo_sm_char05_m06_stg08_03"
msgstr "Dubois: Pronašao sam! Sada možemo kroz grad...merde!"

msgid "vo_sm_char05_m06_stg08_05"
msgstr "Dubois: Cijela bojišnica je minirana. Ne možemo do naših snaga."

msgid "vo_sm_char05_m06_stg09_01"
msgstr "Dubois: Pronašao sam!"

msgid "vo_sm_char05_m06_stg09_04"
msgstr "Dubois: Već sam ti posudio svoju olovku. Izgubio si je."

msgid "vo_sm_char05_m06_stg09_07"
msgstr "Dubois: Nemoj. Izgubit će i tvoju."

msgid "vo_sm_char05_m06_stg10_01"
msgstr "Dubois: Murphy, imam nešto za tebe. Uzmi."

msgid "vo_sm_char05_m06_stg11_01"
msgstr "Dubois: Pogodak!"

msgid "vo_sm_char05_m06_stg11_03"
msgstr "Dubois: Mislio sam...ah...mon Dieu, možda će mi čak i nedostajati tvoje glupe šale kada ovo završi."

msgid "vo_sm_char05_m06_stg12_01"
msgstr "Dubois: Pronašao sam!! Još jedan djelić."

msgid "vo_sm_char05_m06_stg12_04"
msgstr "Dubois: Rekao sam ti."

msgid "vo_sm_char05_m06_stg13_01"
msgstr "Dubois: Ništa ovdje, mes amis."

msgid "vo_sm_char05_m06_stg14_02"
msgstr "Dubois: Ne. Ovo nije zapovjednički položaj koji trebamo."

msgid "vo_sm_char05_m06_stg15_02"
msgstr "Dubois: Prazno."

msgid "vo_sm_char05_m06_stg15_04"
msgstr "Dubois: Prilično sam temeljit."

msgid "vo_sm_char05_m06_stg15_06"
msgstr "Dubois: Mon Dieu...uspoređuješ li tajne vojne dokumente s...ah...nema veze."

msgid "vo_sm_char05_m06_stg15_07"
msgstr "Dubois: Mon Dieu...uspoređuješ li tajne vojne dokumente s...ah...nema veze."

msgid "vo_sm_char05_m06_stg15_07_01"
msgstr "Dubois: Satniče, ovdje je još označenih zapovjedničkih položaja."

msgid "vo_sm_char05_m06_stg16_03"
msgstr "Dubois: Upravo sam se provukao kroz minsko polje i konačno mogu dobiti malo...mira i tišine."

msgid "vo_sm_char05_m06_stg16_05"
msgstr "Dubois: I to."

msgid "vo_sm_char05_m06_stg17_03"
msgstr "Dubois: Opusti se, Kowalski. Da nas je Keller htio izdati već bi to i učinio."

msgid "vo_sm_char05_m06_stg19_01"
msgstr "Dubois: Gledaj, čini se kao zapovjednički položaj."

msgid "vo_sm_char05_m06_stg21_05"
msgstr "Dubois: To je bilo blizu, mes amis."

msgid "vo_sm_char05_m06_stg24_04"
msgstr "Dubois: Moramo se odmah prebaciti, mes amis. Istraživat će."

msgid "vo_sm_char05_m06_stg25_03"
msgstr "Dubois: Magnifique. Zaostali su. Možemo nastaviti naš zadatak."

msgid "vo_sm_char05_m06_stg26_07"
msgstr "Dubois: En avant!"

msgid "vo_sm_char05_m06_stg27_03"
msgstr "Dubois: Cilj eliminiran. Jesu li ove granate uvijek bilo ovako teške?"

msgid "vo_sm_char05_m06_stg27_04"
msgstr "Dubois: Jeste li svi dobro? Ja sam dobro."

msgid "vo_sm_char05_m06_stg28_04"
msgstr "Dubois: Neprijatelj oboren!"

msgid "vo_sm_char05_m06_stg31_01"
msgstr "Dubois: Potvrđujem!"

msgid "vo_sm_char05_m06_stg31_02"
msgstr "Dubois: Krećem u izviđanje."

msgid "vo_sm_char05_m06_stg31_03"
msgstr "Dubois: Provjerit ću i javiti se."

msgid "vo_sm_char05_m06_stg31_04"
msgstr "Dubois: Krećem na osmatrački položaj."

msgid "vo_sm_char05_m06_stg31_05"
msgstr "Dubois: Vrijeme je da protegnem noge. Da vidim što je naprijed."

msgid "vo_sm_char05_m06_stg31_06"
msgstr "Dubois: Murphy, želiš li me zamjeniti?"

msgid "vo_sm_char05_m06_stg31_08"
msgstr "Dubois: Trebao sam znati..."

msgid "vo_sm_char05_m06_stg31_09"
msgstr "Dubois: Kowalski, možda bi trebao..."

msgid "vo_sm_char05_m06_stg31_11"
msgstr "Dubois: Dobro onda, idem sam."

msgid "vo_sm_char05_m06_stg31_12"
msgstr "Dubois: Nekoga zanima lagana tjelovježba?"

msgid "vo_sm_char05_m06_stg31_13"
msgstr "Dubois: I mislio sam tako. Krećem."

msgid "vo_sm_char05_m06_stg32_01"
msgstr "Dubois: Neprijatelj opažen!"

msgid "vo_sm_char05_m06_stg32_02"
msgstr "Dubois: Panceri na vidiku."

msgid "vo_sm_char05_m06_stg32_03"
msgstr "Dubois: Pozor. Neprijateljski oklop."

msgid "vo_sm_char05_m06_stg32_04"
msgstr "Dubois: Vidim ih."

msgid "vo_sm_char05_m06_stg32_05"
msgstr "Dubois: Neprijatelj na vidiku."

msgid "vo_sm_char05_m06_stg33_01"
msgstr "Dubois: Još ništa, ali mora da su blizu."

msgid "vo_sm_char05_m06_stg33_02"
msgstr "Dubois: Čisti pogled, ali ostani na oprezu."

msgid "vo_sm_char05_m06_stg33_03"
msgstr "Dubois: Ne vidim nikakvo kretanje. Kriju se negdje."

msgid "vo_sm_char05_m06_stg33_04"
msgstr "Dubois: Trenutno prazno...ali možda bi trebali još pričekati."

msgid "vo_sm_char05_m06_stg33_05"
msgstr "Dubois: Ništa za sada. Ali pričekajmo da li će se pojaviti njihova ophodnja."

msgid "vo_sm_char05_m06_stg42_03"
msgstr "Dubois: Gospodo, moram li vas podsjetiti da uspjeh našeg zadatka ovisi o skupljanju ove mape."

msgid "vo_sm_char05_m06_stg43_04"
msgstr "Dubois: Mon Dieu, vrijeme ne staje kada se divimo pogledu."

msgid "vo_sm_char05_m06_stg48_03"
msgstr "Dubois: Svaka sekunda je bitna. Sada budite jako oprezni."

msgid "vo_sm_char05_m06_stg53_03"
msgstr "Dubois: Pozor! Neprijateljski tenk naprijed!"

msgid "vo_sm_char05_m06_stg55_03"
msgstr "Dubois: Mon Dieu! Murphy, bacio si urok na nas!"

msgid "vo_sm_char05_m06_stg55_05"
msgstr "Dubois: A u kojem si režimu bio prije ovoga?!"

msgid "vo_sm_char05_m06_stg56_01"
msgstr "Dubois: Murphy, budi oprezan, za Boga miloga! U minskom smo polju!"

msgid "vo_sm_char05_m06_stg56_05"
msgstr "Dubois: Murphy, znaš li kuda ideš? Nisi povukao zadnji djelić mape!"

msgid "vo_sm_char05_m06_stg56_07"
msgstr "Dubois: To me i brine!"

msgid "vo_sm_char05_m06_stg59_04"
msgstr "Dubois: Mon Dieu, Tiger je iza nas!"

msgid "vo_sm_char05_m06_stg59_05"
msgstr "Dubois: Cette bête će nas svaki čas uhvatiti! Murphy, brže!"

msgid "vo_sm_char05_m06_stg68_03"
msgstr "Dubois: Murphy, znam da si to napravio namjerno! Prestani, molim te, sa tvojim šalama!"

msgid "vo_sm_char05_m06_stg72_05"
msgstr "Dubois: Ima pametnijih načina kako izvršiti ovaj zadatak osim pucanja na sve što se miče."

msgid "vo_sm_char05_m06_stg73_02"
msgstr "Dubois: Da. Ali ne bi stalo u Chaffeea."

msgid "vo_sm_char05_m06_stg74_01"
msgstr "Dubois: Murphy, jesi li ikada bio u Parizu?"

msgid "vo_sm_char05_m06_stg74_04"
msgstr "Dubois: Pusti ga. To je njegov način zabave."

msgid "vo_sm_char05_m06_stg75_02"
msgstr "Dubois: Ne, nisam."

msgid "vo_sm_char05_m06_stg75_04"
msgstr "Dubois: Znači da sam sanjao Francusku."

msgid "vo_sm_char05_m06_stg76_02"
msgstr "Dubois: Très bien. Ponavljaj za mnom: ''Comment? Je ne comprends pas.''"

msgid "vo_sm_char05_m06_stg76_04"
msgstr "Dubois: Preveo si. Tražio sam da ponoviš."

msgid "vo_sm_char05_m06_stg82_04"
msgstr "Dubois: Zašto ne?"

msgid "vo_sm_char05_m06_stg82_06"
msgstr "Dubois: Znaš li zašto Francuzi jedu puževe? Jer ne volimo brzu hranu."

msgid "vo_sm_char05_m06_stg83_01"
msgstr "Dubois: Murphy, podsjećaš me na lika iz Tri mušketira."

msgid "vo_sm_char05_m06_stg83_03"
msgstr "Dubois: To je Shakespeare, Murphy."

msgid "vo_sm_char05_m06_stg86_01"
msgstr "Dubois: Keller, je li istina da Nijemci imaju više od 300 vrsti kruha?"

msgid "vo_sm_char05_m06_stg86_03"
msgstr "Dubois: Impresivno. Ali jesi li probao francuski baget?"

msgid "vo_sm_char05_m06_stg86_05"
msgstr "Dubois: Savršena metafora za Francusku!"

msgid "vo_sm_char05_m06_stg87_02"
msgstr "Dubois: Gdje? Ne vidim ništa."

msgid "vo_sm_char05_m06_stg87_04"
msgstr "Dubois: Mon Dieu..."

msgid "vo_sm_char05_m06_stg90_02"
msgstr "Dubois: Marseljeza."

msgid "vo_sm_char05_m06_stg91_01"
msgstr "Dubois: Lijevo ili ovdje, Murphy?"

msgid "vo_sm_char05_m06_stg91_03"
msgstr "Dubois: Oh, Murphy..."

msgid "vo_sm_char05_m06_stg92_02"
msgstr "Dubois: Što?"

msgid "vo_sm_char05_m06_stg93_02"
msgstr "Dubois: Da i to možeš izgubiti?"

msgid "vo_sm_char06_m05_stg01_01"
msgstr "McCormick: Slušajte, dečki! Glavu dolje i krećite se brzo!"

msgid "vo_sm_char06_m05_stg01_01_01"
msgstr "McCormick: Koncentrirajte se na bunkere; trebamo prokrčiti put za naše snage."

msgid "vo_sm_char06_m05_stg01_01_02"
msgstr "McCormick: Čeka nas posao za obaviti, neka se isplati!"

msgid "vo_sm_char07_m04_stg19_04"
msgstr "Razumijem!"

msgid "vo_sm_char07_m05_stg01_03"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_04"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_05"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_06"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_07"
msgstr "Pazi na neprijateljsko topništvo!"

msgid "vo_sm_char07_m05_stg01_08"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_09"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_10"
msgstr "?empty?"

