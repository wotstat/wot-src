msgid "vo_sm_char10_m05_stg21_02"
msgstr "Stožerni časnik: Echo-5 mostobran osiguran. Tenkovi napreduju. Pružite punu vatrenu podršku."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Stožerni časnik: Preusmjerite zračnu potporu za pomoć tenkovskom napredovanju."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Stožerni časnik: Inžinjerski timovi, maknite prepreke za daljnje napredovanje."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Stožerni časnik: Plaža je čista. Šalju se glavne snage. Odličan posao."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Stožerni časnik: Držite položaj. Pojačanja su na putu."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Stožerni časnik: Branite mostobran pod svaku cijenu."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Stožerni časnik: Još jedan tenk, još jedna prilika. Budite oprezni ovog puta."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Stožerni časnik: Ponestaju nam pričuve. Iskoristite ovo, zapovjedniče."

