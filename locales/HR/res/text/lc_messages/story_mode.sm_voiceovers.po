msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire pilot: Vidljivost je slaba, ne mogu pomoći!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire pilot: PZO je prejak, ne mogu pomoći!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire pilot: Teška paljba, podešavanje vatre nije moguće."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire pilot: Kao u oluji protuavionaca, ha?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire pilot: Pod ovom paljbom ne možemo podesiti paljbu broda."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire pilot: Moramo skinuti one PZO bitnice pored bunkera."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire pilot: Uspio sam se malo spustiti."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire pilot: Sada mogu prizvati paljbu velikih topova korištenjem dimnih signala."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire pilot: Tenkovi, vi ste na redu!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire pilot: Spazio sam dim."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire pilot: Prosljeđujem koordinate bojnom brodu za izravnu paljbu."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire pilot: Dovraga, jedan od naših je pogođen! Još se ne mogu spustiti."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire pilot: Moramo odmah maknuti još jedan PZO top!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire pilot: PZO topovi uklonjeni, spuštam se. Spreman za usmjeravanje guste paljbe našeg bojnog broda."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire pilot: Pozor! Opažena velika neprijateljska grupa koja se kreće prema vama."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire pilot: Daju sve od sebe."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire pilot: Oprez, pristiže nova neprijateljska grupa. Budite pažljivi tamo dolje."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire pilot: Pažnja! Posljednji i najveći neprijateljski val pristiže!"

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire pilot: Dolaze sa svih strana. Držite se."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire pilot: Jasno vidim dimni signal. Koordinate se šalju bojnom brodu."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire pilot: Eh, evo našeg dmingo markera. Prenosim položaj bojnom brodu."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire pilot: Dim je na meti. Šaljem točnu lokaciju bojnom brodu."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire pilot: Vidim dim, izgleda da našim prijateljima treba pomoć."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Zapovjednik USS Frankford: Čekam koordinate za vatrenu potporu."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Zapovjednik USS Frankford: Paljba naslijepo je rizična, mogu pogoditi naše."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Zapovjednik USS Frankford: Trebam precizne koordinate, zadržavam paljbu."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Zapovjednik USS Frankford: Ovdje Zapovjednik USS Frankford. Odbijam."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Zapovjednik USS Frankford: Nije moguće podržavati napredovanje. Vidljivost je preslaba."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Zapovjednik USS Frankford: Ne vidim litice i bunkere, samo naše tenkove na plaži."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Zapovjednik USS Frankford: Vidim tenkove kako idu prema liticama."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Zapovjednik USS Frankford: Podrat ćemo ih paljbom u tom smjeru."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Zapovjednik USS Frankford: Nadam se da ovaj Sherman zna gdje puca."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Zapovjednik USS Frankford: Sherman je promjenio metu. Podešavamo i našu."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Zapovjednik USS Frankford: Sherman je prestao pucati. Posao obavljen."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Zapovjednik USS Frankford: Ne možemo doseći bunkere koji su dalje u unutrašnjosti."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Zapovjednik USS Frankford: Povlačimo se na sigurnu udaljenost. Sretno na obali."

