msgid "PzVIB_Tiger_II_IGR"
msgstr "Tiger II"

msgid "PzVIB_Tiger_II_IGR_descr"
msgstr "Također poznat kao Kraljevski Tigar. Izrađivan od siječnja 1944. do ožujka 1945. Ukupno je izrađeno 489 vozila."

msgid "PzVIB_Tiger_II_IGR_short"
msgstr "Tiger II"

msgid "PzVI_IGR"
msgstr "Tiger I"

msgid "PzVI_IGR_descr"
msgstr "Razvoj Tigra I je započeo 1937. u tvrtki Henschel. Serijska proizvodnja je počela 1942. i ukupno je izrađeno 1354 vozila. Tenk je imao vatreno krštenje u borbama za Lenjingrad i Tigrovi su bili na čelu bitaka u bitkama od Tunisa do Kurska. Iako je proizvodnja prestala u ljeto 1944. Tigar I je bio u akciji do kraja rata."

msgid "PzVI_IGR_short"
msgstr "Tiger I"

msgid "PzV_IGR"
msgstr "Panther"

msgid "PzV_IGR_descr"
msgstr "Ovaj slavni tenk je izrađivan od siječnja 1943. do travnja 1945. Ukupno je izrađeno 5796 vozila i osam vozila na šasiji serije F."

msgid "PzV_IGR_short"
msgstr "Panther"

msgid "R106_KV85_IGR"
msgstr "KV-85"

msgid "R106_KV85_IGR_descr"
msgstr "Daljnji razvoj tenka KV-1S. Za razliku od prethodnih modifikacija, KV-85 je imao poboljšano naoružanje. Vozilo je razvijeno u proljeće 1943. u tvornici Kirov u Čeljabinsku. Tenk je ušao u službu 8. kolovoza 1943. i serijski se proizvodio do rujna i ukupno je izrađeno 148 vozila. KV-85 su koristile udarne oklopne pukovnije Crvene Armije."

