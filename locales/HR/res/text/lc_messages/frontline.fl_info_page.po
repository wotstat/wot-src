msgid "reserveCategories/config/footerText"
msgstr "U scenariju {{@ colorLegacy 'FFE4C0'}}Zaplet sudbine{{/}}, redosljed u kojem se otključavaju borbene pričuve ne ovisi o tipu vozila."

msgid "reserveCategories/config/header"
msgstr "Konfiguracije pričuve prema tipu vozila"

msgid "reserveCategories/config/text"
msgstr "U scenarijima {{@ colorLegacy 'FFE4C0'}}Standardna bitka{{/}} i {{@ colorLegacy 'FFE4C0'}}Operativna podrška{{/}}, sva tri mjesta borbenih pričuva su dostupna svim tipovima vozila. Međutim, redosljed u kojem se otključavaju ovisi o tipu vozila."

msgid "reserveCategories/config/vehicles/destroyer"
msgstr "Lovci na tenkove"

msgid "reserveCategories/config/vehicles/heavy"
msgstr "Teški tenkovi"

msgid "reserveCategories/config/vehicles/light"
msgstr "Laki tenkovi"

msgid "reserveCategories/config/vehicles/middle"
msgstr "Srednji tenkovi"

msgid "reserveCategories/config/vehicles/selfPropelled"
msgstr "Samohodni topovi"

msgid "reserveCategories/levelUpNote"
msgstr "* Poboljšanje na ovu razinu je dostupno samo na {{@ colorLegacy 'FFE4C0'}}kupljene{{/}} borbene pričuve u scenariju {{@ colorLegacy 'FFE4C0'}}Zaplet sudbine{{/}}."

msgid "reserveCategories/levels/header"
msgstr "Kako otključati mjesta i poboljšati borbene pričuve"

msgid "reserveCategories/levels/text"
msgstr "Zadano, dostupna vam je jedna borbena pričuva. Ostale se otključavaju po dosizanju rangova narednika i poručnika. Sve tri pričuve će biti poboljšane po dosizanju rangova satnika i bojnika."

msgid "reserveCategories/progression/tableCell"
msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} ili {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}} razina"

