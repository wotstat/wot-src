msgid "hwInvisibility/always"
msgstr "?empty?"

msgid "hwInvisibility/descr"
msgstr "Čini vaše vozilo nevidljivo neprijateljima, obnavlja HP, popravlja module i gasi požar."

msgid "hwInvisibility/long_special"
msgstr "Borbena sposobnost. Čini vas nevidljivim neprijateljima na 10 s. Obnavlja 35 HP po sekundi, popravlja module, uklanja sve negativne učinke i daje neranjivost na koroziju. Paljba ili primanje štete od neprijateljskog vozila (paljbom, sudaranjem ili korištenjem borbene sposobnosti) će odmah otkriti vaš položaj. Neprijateljski hici ne mogu prekinuti 3 s nakon aktivacije. Ako se koristi najmanje jednom u bitci sposobnost se troši i ne može se opskrbiti za kredite. Ako se ne koristi, nije potrebna opskrba.<br/><br/>Dostupno samo tijekom akcije <font color='#cbac77'>Babilon: Mračni toranj</font>.<br/><br/>Sve neiskorištene sposobnosti će biti uklonjene i nadoknađene kreditima jednakim 50% njihova troška u slijedećoj nadogradnji."

msgid "hwInvisibility/name"
msgstr "Nevidljivo izlječenje"

msgid "hwInvisibility/onUse"
msgstr "Čini vaše vozilo nevidljivim za neprijatelje 10 sekundi. Obnavlja 35 HP u sekundi, popravlja module, uklanja sve negativne učinke i daje neranjivost na koroziju. Pucanje ili primanje štete od neprijateljskog vozila (pucanjem, udaranjem ili korištenjem borbenih sposobnosti) odmah će otkriti vaš položaj. Neprijateljski hici ne mogu prekinuti 3 sekunde nakon aktivacije."

msgid "hwInvisibility/restriction"
msgstr "?empty?"

msgid "hwInvisibility/short_special"
msgstr "Sakriva vas od neprijatelja, obnavlja HP, popravlja module, gasi požar, uklanja ošamućenje i liječi posadu."

