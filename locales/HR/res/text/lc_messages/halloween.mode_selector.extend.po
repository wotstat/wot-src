msgid "mode/halloween/battlePassTooltip/body"
msgstr "Određeni zadaci u akciji {whiteSpanish_open}Babilon: Mračni toranj{whiteSpanish_close} će vam omogućiti zaradu bodova Borbene propusnice."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Bodovi borbene propusnice"

msgid "mode/halloween/calendar"
msgstr "Akcija će početi %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Akcija će završiti %(date)s."

msgid "mode/halloween/description"
msgstr "Borite se i skupljajte tvar.\nBorbe u posebnim vozilima."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Performanse vašeg računala su nedovoljne za ovaj režim. Možete imati poteškoća s grafikom i kretanjem vozila. Moguće je i rušenje klijenta igre."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Niske performanse"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Niske performanse"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Ovaj režim zahtjeva visoke performanse računala.\nImat ćete poteškoća s učitavanjem mape, grafikom i kretanjem vozila. U slučaju nedovoljnih performansi, pokušajte s nižom kvalitetom grafike u vašim postavkama."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Umanjene performanse"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Umanjene performanse"
