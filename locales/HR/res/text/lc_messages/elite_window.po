msgid "elite_window/buttons/ok"
msgstr "Razumijem!"

msgid "elite_window/buttons/post_progression"
msgstr "Na promjene"

msgid "elite_window/buttons/vanity_progression"
msgstr "Na elitne nagrade"

msgid "elite_window/elite/description"
msgstr "Elitni status se daje vozilima sa svim istraženim dostupnim modulima, nadogradnjama i tehničkim granama, uključujući i vozila slijedećih razina. Borbeno iskustvo u elitnim vozilima se može pretvoriti u slobodno iskustvo zlatom ili koristiti za ubrzanje obuke posade."

msgid "elite_window/elite/title"
msgstr "Elitni status"

msgid "elite_window/post_progression/description"
msgstr "Terenska promjena je sada dostupna"

msgid "elite_window/prestige/description"
msgstr "Nakon primitka elitnog statusa, vozilo počinje zarađivati elitne bodove i primati elitne razine koje predstavljaju vašu posvećenost određenom vozilu. U bitci se prikazuje odgovarajući ševron nakon što dobijete prvu elitnu razinu."

msgid "elite_window/prestige/title"
msgstr "Elitni sustav"

msgid "elite_window/title"
msgstr "OSTVAREN ELITNI STATUS"

msgid "elite_window/vanity_progression/description"
msgstr "Primite ekskluzivne nagrade za vozila razine XI uključujuči jedinstveni volumetrijski stil, pratitelj statistike i ovojnicu topa!"

msgid "elite_window/vanity_progression/title"
msgstr "Sustav elitnih nagrada je sada dostupan"
