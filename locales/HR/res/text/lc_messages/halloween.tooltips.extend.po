msgid "Contact/status/inBattle/halloween"
msgstr "U bitci Babilon: Mračni toranj"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Ispaljuje hitac koji oštećuje i ošamućuje metu i sva neprijateljska vozila unutar polumjera od 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Ispaljuje hitac koji obnavlja HP tako da ga krade od mete i obližnjih neprijateljskih vozila unutar polumjera od 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr " Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila unutar polumjera od 35 m."

msgid "advanced/hw_damageShield"
msgstr "Štiti protiv bilo koje štete (osim utapanja, sudaranja i udara) na 7 sekundi."

msgid "advanced/hw_fastReload"
msgstr "Povećava brzinu paljbe / puni spremnik"

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Obnavlja HP, gasi požar, uklanja učinak ošamućenja i popravlja oštećene module."

msgid "advanced/hw_invisibility"
msgstr "Privremeno čini vaše vozilo nevidljivo neprijateljima, obnavlja HP po sekundi, popravlja module, gasi požar, uklanja učinak ošamućenja i liječi sve ozlijeđene članove posade."

msgid "advanced/hw_teamRepairKit"
msgstr "Popravlja oštećene module, gasi požar, uklanja učinak ošamućenja i obnavlja nešto HP savezničkim vozilima unutar svojeg polumjera."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Borbene sposobnosti vam omogućuju učinkovitiju borbu u bitkama Babilon: Mračni toranj, ostvarivanje ciljeva i osvajanje vrijednih nagrada. Za opremanje, kliknite na jedno od mjesta borbenih sposobnosti."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Mjesta za borbene sposobnosti"

msgid "hwShell/alt/description"
msgstr "%(bold)s može se naći u bitci s određenom vjerojatnošću nakon uništenja neprijatelja."

msgid "hwShell/alt/description/bold"
msgstr "Alternativna granata"
