msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Približava se izvor anomalije. Naravno da je veliki debeli tenk."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Uništi ga i ovome je kraj. Idemo, momci!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Pucajte u slabe točke u oklopu."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Dečki, veliko ružno čudovište ide ka nama,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "kakvo još nikada nismo vidjeli."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Izgleda da su njegove slabe točke vidljive. Trebamo"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "uništiti glavnoga kako bi došli do releja i izvršili zadatak."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Momci, danas nam je sretan dan! Dva glavna umjesto jednog-"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "to je nešto novo. Ali svejedno ćemo pobjediti. Pucajte u ranjive"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "točke u njihovom oklopu i ne zboravite uništiti njihove tjelohranitelje."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Ovo je ozbiljan suparnik, ali ima svoje slabe točke."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Uništite ovo stvorenje i gotovo je. Idemo, momci!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Pucajte na slabe točke neprijatelja. I ne zaboravite uništiti"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "njegove pobočnike ili će postati čupavo."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Moramo uništiti glavnoga da zatvorimo anomaliju."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Ciljajte u slabe točke u njegovom oklopu."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Moramo uništiti posljednjeg protivnika za izvršenje zadatka."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Pucajte u njegove ranjive točke."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Ovo je posljednja prepreka na našem putu."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Skockajte se, momci! Uništimo ovo čudovište!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Neprijatelj je vrlo opasan, ali ima slabe točke."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Ovo je naša prilika dovršiti ga jednom za svagda."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Sada ćemo vidjeti što nam je anomalija pripremila."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Jaki suparnik, ali ima svoje slabe točke."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Momci, sredimo ovu zvijer!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Ovo je vrlo snažan suparnik. Ali, mi to možemo, znam to."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Danas dva glavna za cijenu jednog."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Hajde, ovo je super ponuda! Ciljajte u ranjive točke"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "u njihovom oklopu. Uništimo ova čudovišta!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Izgleda da glavni nisu mogli dokučiti red i"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "došli su ovdje zajedno. Oba imaju slabe točke, ciljajte u njih."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Opet lijepi par glavnih. Momci, znate što treba činiti."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Pucajte u njihove slabe točke i počistite njihove pobočnike."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "I to brzo!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Dobro smo ga izbubetali, momci!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Ali izgleda da nismo još gotovi."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Lijepo! Ali tek smo na pola puta."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Vratit će se sa svojim prijateljima."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Tako treba! Popravimo tenkove i idemo opet."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Neće ga se tako lako potući. Spremite se za drugu rundu."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Dobro smo ih natukli, momci! Ali još nije gotovo."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Lijepo! Ali tek smo na pola puta."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Vratit će se sa svojim prijateljima."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Tako treba! Popravimo tenkove i idemo opet."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Neće ih se tako lako potući. Spremite se za drugu rundu."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Govori satnik Smith. Dok naši momci izvan procjepa"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "brane napad eho tenkova na Babilon kompleks,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "naš zadatak je proći kroz sve faze i zatvoriti anomaliju."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Kako bi to učinili, trebamo popuniti kolektore u svim fazama. Pokret!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Neprijateljska baza je opažena duboko unutar Mirium prostora."

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Spremaju golemu vojsku za invaziju. Naša jedina prilika"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "da ih zaustavimo je blokirati im put. Naš zadatak je ući"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "u duboku fazu anomalije i izvući relej koji"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "drži njihov put otvorenim. Napunite Magnus miriumom,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "idemo do kraja!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Pozdrav svima! Trebamo zatvoriti put do naše stvarnosti za"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "eho tenkove. Protuobavještajna se može pobrinuti za špijune"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "u Babilonu-naš zadatak je Mirium. Napunite kolektore u svim fazama,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "naprašite one stvari koje nas čekaju tamo dole"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "i zatvorite tu rupu. Pokrenite motore!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Govori Smith. Naš zadatak je zatvoriti procjep u području"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "kompleksa Babilon. Napunite kolektore miriumom i uništite"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "sve što nismo mi. Idemo, momci, neprijatelj čeka!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Naši momci zadržavaju Mirium tenkove od proboja"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "u stvarni svijet. Naš zadatak je zatvoriti procjep."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Što prije, to bolje. Skupite mirium i zakrpajte tu rupu."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Neprijateljski tenkovi se približavaju kompleksu Babilon. Ta prljavština"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "izvire iz procjepa i moramo blokirati njihov put."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Uđite duboko u anomaliju i neutralizirajte njen izvor. Idemo!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Govori Smith. Naš zadatak je začepiti vojsku njemačkih"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "eho tenkova unutar anomalije. Naša meta je trenutno"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "u dubokoj fazi. Napunite Magnus da dođete do nje."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Neprijateljska baza je otkrivena u dubinama Mirium prostora."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Od tamo planiraju svoj napad."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Ne obraćajte pozornost na djevojčicu. Naš zadatak je aktivirati"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnusa i otvoriti put u najdublju fazu"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "tako da možemo tamo zauvijek zatvoriti neprijatelja."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "Neprijateljska baza je opažena u najdubljoj fazi."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Ne možemo ih sada poraziti, ali ih možemo tamo zatočiti."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Skupite mirium za pokret na dno ovog procjepa."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Vjerujem u vas, momci! Mi to možemo!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Novi procjep se otvorio ubrzo nakon zatvaranja posljednjeg."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Naš zadatak ostaje isti: prikupiti tvar i"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "začepiti anomaliju kako bi zaustavili invaziju u našu stvarnost. Idemo!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Procjep se ponovo otvorio. Skupite tvar i napunite kolektor."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Trebamo zatvoriti tu prokletu anomaliju. Momci vani"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "se oslanjaju na nas, ali neće moći izdržati još dugo!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Kompleks Babilon je još uvijek pod napadom neprijateljskih tenkova."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Skupite tvar i napunite Magnusa. Moramo zatvoriti"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "anomaliju kako bi zaustavili eho tenkove u najezdi u naš svijet."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Naša meta je blizu. Budite na oprezu i pazite"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "na detektor Besmrtnog."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Bravo, momci! Držite korak! Nismo"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "ovdje na čajanci. Trebamo još miriuma."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Odličan timski rad! Idemo dalje, trebamo još miriuma."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Dobar posao! Trebamo aktivirati Magnusa kako bi otišli još dublje."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium nas čini jačim sa svakom novom fazom."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Samo se nemojte zanijeti."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Trebamo aktivirati Magnusa. Još jedan konačni napor!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Naš zadatak ostaje isti: trebamo napuniti kolektor."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Približavamo se izvoru invazije."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Naša zadaća ostaje ista: napuniti kolektor."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "LIjepa pjesma. Koncentrirajte se, momci."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Trebamo skupiti mirium i ići dublje."

msgid "narrator"
msgstr "Smith"
