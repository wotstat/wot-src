msgid "IS_3_II_Halloween_event"
msgstr "Dvostruki"

msgid "IS_3_II_Halloween_event_descr"
msgstr "Kao dio programa mirium poboljšanja, IS-3-II je opremljen prijenosnim sakupljačem tvari. Snažan i dobro naoružan, iako ponešto spor, ovaj tenk se pokazao vrlo učinkovitim unutar anomalije kada njime upravljaju vješti operateri. Kako je Mirium istraživanje napredovalo, Double je postao glavna udarna snaga za jedinice koje operiraju unutar zone."

msgid "IS_3_II_Halloween_event_long_special"
msgstr "Teški tenk s dvostrukom cijevi topa, pristojne štete po hicu i pouzdanog oklopa."

msgid "IS_3_II_Halloween_event_short"
msgstr "Dvostruki"

