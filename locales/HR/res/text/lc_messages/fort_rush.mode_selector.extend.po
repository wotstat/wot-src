msgid "mode/fort_rush_battle/description"
msgstr "Zauzmite antene. Držite mrežu. Osigurajte prijenos."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Performanse vašeg računala su nedovoljne za ovaj režim. Možete imati poteškoća s grafikom i kretanjem vozila. Moguće je i rušenje klijenta igre."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Niske performanse"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Niske performanse"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Ovaj režim zahtjeva visoke performanse računala. Imat ćete poteškoća s učitavanjem mape, grafikom i kretanjem vozila. U slučaju nedovoljnih performansi, pokušajte s nižom kvalitetom grafike u vašim postavkama."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Umanjene performanse"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Umanjene performanse"
