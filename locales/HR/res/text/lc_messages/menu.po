msgid "roleExp/roleDescr/role_ATSPG_assault"
msgstr "Vozila slabe pokretljivosti, ali pouzdanog prednjeg oklopa. Iskazuju visoku učinkovitost u borbama na prvoj liniji."

msgid "roleExp/roleDescr/role_ATSPG_sniper"
msgstr "Vozila slabog oklopa, ali s pristojnim topovima zahtjevaju taktiku zasjede u većini borbenih situacija."

msgid "roleExp/roleDescr/role_ATSPG_support"
msgstr "Vozila savršenih topova čije učinkovito korištenje zahtjeva udovoljavanje određenih uvjeta. Mogu nanijeti veliku štetu u kratkom vremenu."

msgid "roleExp/roleDescr/role_ATSPG_universal"
msgstr "Lovci na tenkove prosječnih karakteristika vozila podjednako učinkoviti na svim udaljenostima."

msgid "roleExp/roleDescr/role_HT_assault"
msgstr "Teško oklopljena vozila koja mogu učinkovito razmjeniti svoj HP i zaustaviti napredovanje neprijatelja i biti u vrhu napada."

msgid "roleExp/roleDescr/role_HT_break"
msgstr "Vozila dobre pokretljivosti i pouzdanog oklopa što ih čini učinkovitim i na prvoj liniji napada u pozicijskoj bliskoj borbi i tijekom obuhvatnih manevara."

msgid "roleExp/roleDescr/role_HT_support"
msgstr "Vozila savršenih topova čije učinkovito korištenje zahtjeva udovoljavanje određenih uvjeta. Mogu nanijeti veliku štetu u kratkom vremenu."

msgid "roleExp/roleDescr/role_HT_universal"
msgstr "Višenamjenski tenkovi koji se mogu lako prilagoditi bilo kojoj borbenoj situaciji."

msgid "roleExp/roleDescr/role_LT_scout"
msgstr "Izviđački laki tenkovi su mala, okretna vozila izgrađena za uočavanje neprijatelja. Njihove niske siluete i jaka skrovitost, kao i izvrsna upravljivost i velika maksimalna brzina, čine ih vještima i u pasivnom i u aktivnom izviđanju, ali slaba izdržljivost i niska vatrena moć sprječavaju ih da pruže značajnu vatrenu podršku saveznicima."

msgid "roleExp/roleDescr/role_LT_support"
msgstr "Laki tenkovi podrške koriste svoju visoku pokretljivost, izvrsnu upravljivost i snažne topove za brzu promjenu bokova i nanošenje značajne štete prije povlačenja na sigurno. Iako u određenim situacijama mogu provoditi izviđanje, njihova velika veličina i loša prikrivenost čine ih manje učinkovitima u izviđanju od ostalih lakih tenkova."

msgid "roleExp/roleDescr/role_LT_universal"
msgstr "Svestrani laki tenkovi su svestrana vozila sposobna za izviđanje i pružanje vatrene podrške saveznicima. Iako su manje učinkoviti u izviđanju od izviđača i imaju manju vatrenu moć od lakih tenkova podrške, uravnoteženi profili svestranih tenkova omogućuju im da obje uloge obavljaju sposobno i lako se prilagode širokom rasponu borbenih situacija."

msgid "roleExp/roleDescr/role_MT_assault"
msgstr "Vozila pristojnog oklopa koji ih čini najpogodnijim za blisku borbu i neodstupanje protiv neprijateljskih teških tenkova."

msgid "roleExp/roleDescr/role_MT_sniper"
msgstr "Vozila odličnih topova i slabog oklopa koja iskazuju učinkovitu izvedbu na velikim udaljenostima."

msgid "roleExp/roleDescr/role_MT_support"
msgstr "Vozila savršenih topova čije učinkovito korištenje zahtjeva udovoljavanje određenih uvjeta. Mogu nanijeti veliku štetu u kratkom vremenu."

msgid "roleExp/roleDescr/role_MT_universal"
msgstr "Dobro uravnotežena vozila sposobna izvoditi razne borbene zadatke. Lako se prilagođavaju pojedinostima mape i taktičkoj situaciji."

msgid "roleExp/roleDescr/role_SPG"
msgstr "Podrška izdaleka savezničkim napadima. Pomoćna vozila čija učinkovitost obično ovisi o borbenoj situaciji i akcijama tima."

