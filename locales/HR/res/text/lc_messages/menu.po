msgid "extraParams/desc"
msgstr "Parametar koji ne utječe izravno na učinkovitost prilikom uništavanja neprijateljskih vozila."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Ukupni bonus se računa korištenjem modifikatora zbrajanja i množenja tako da može biti veći ili manji od vrijednosti naznačenih ovdje."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Ovaj parametar prikazuje vrijeme između hica samohodnog topa i primitka upozorenja."

msgid "extraParams/name/commanderLampDelay"
msgstr "Ovaj parametar prikazuje odgodu prije nego što zapovjednik identificira da li je vaše vozilo otkriveno od strane neprijatelja. Što je vrijednost veća, to je odgoda kraća."

msgid "extraParams/name/crewHitChance"
msgstr "Ovaj parametar pokazuje vjerojatnost izbjegavanja ozljeda vaših članova posade."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Ovaj parametar pokazuje trajanje dodatnog ošamućenja već ošamućenog vozila."

msgid "extraParams/name/crewStunDuration"
msgstr "Ovaj parametar prikazuje trajanje primljenog ošamućenja."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Ovaj parametar prikazuje minimalnu potencijalnu štetu i minimalnu vrijednost proboja u usporedbi s osnovnom vrijednošću (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Ovaj parametar prikazuje minimalnu potencijalnu štetu i minimalnu vrijednost proboja u usporedbi s osnovnom vrijednošću (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Ovaj parametar prikazuje količinu štete nanešene sudaranjem. Kada se vozila sudare, sustav razmatra debljinu oklopa u točci udara, razliku između masa vozila i njihove brzine."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Ovaj parametar prikazuje odgodu prije nego što zapovjednik otkrije kritičnu štetu neprijateljskom vozilu u vašem ciljniku."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Ovaj parametar prikazuje otkrivenost neprijatelja koji su potpuno skriveni raslinjem (i izoliranim i grupiranim). Primjenjuje se i na nepokretno i na pokretno vozilo."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Ovaj parametar prikazuje otkrivenost pokretnih neprijateljskih vozila. Što je veća vrijednost, veća je vjerojatnost otkrivanja."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Ovaj parametar prikazuje promjene vjerojatnosti nanošenja kritične štete neprijateljskoj posadi i modulima. Učinak vrijedi za sve tipove granata osim u vozilima s automatskim topovima."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Ovaj parametar prikazuje vrijeme hlađenja potrošnog materijala."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Ovaj parametar određuje smanjenje trajanja požara i količinu štete koju nanosi."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Ovaj parametar prikazuje učinak skrovitosti iza raslinja."

msgid "extraParams/name/hpRecover"
msgstr "Ovaj parametar prikazuje povećanje obnovljenog HP kada se koristi Alat za popravke. Što je veća vrijednost, to će više HP biti obnovljeno."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Ovaj parametar prikazuje kapacitet ovjesa na umjereno mekanom terenu. Što je veća vrijednost, manje je vremena potrebno za dosizanje linearne brzine."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Ovaj parametar smanjuje kaznu na najveću udaljenost gledanja kada su uništene osmatračke sprave. Što je vrijednost manja, to je vidljivost bolja."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Ovaj parametar prikazuje povećanje u najvećoj potencijalnoj vrijednosti probojnosti za granate na udaljenostima manjim od 50 m. Što je veća vrijednost, to je bolja probojnost."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Ovaj parametar prikazuje dodatno vrijeme slanja neprijateljskih položaja nakon što je vaše vozilo uništeno."

msgid "extraParams/name/radiomanHitChance"
msgstr "Ovaj parametar prikazuje vjerojatnost izbjegavanja ozljeda vašeg vezista."

msgid "extraParams/name/shellVelocity"
msgstr "Ovaj parametar prikazuje povećanje brzine granata za sve tipove granata. Što je vrijednost veća, to je brzina granata veća."

msgid "extraParams/name/softGroundFactor"
msgstr "Ovaj parametar prikazuje kapacitet ovjesa na mekanom terenu. Što je veća vrijednost, manje je vremena potrebno za dosizanje linearne brzine."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Ovaj parametar prikazuje stupanj negativnih učinaka od ošamućenja posade."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Ovaj parametar prikazuje smanjenje nadolazeće štete ovjesu. Što je veća vrijednost, to će biti manja primljena šteta."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Ovaj parametar prikazuje smanjenje kazne na vrijeme punjenja topa zbog oštećenog spremnika streljiva. Što je vrijednost veća, to je vrijeme punjenja kraće."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Ovaj parametar priakzuje smanjenje u gubitku snage oštećenog motora. Što je vrijednost veća, tim će motor izgubiti manje snage."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Ovaj parametar prikazuje izdržljivost spremnika streljiva, rezervoara i motora. Što je veća vrijednost,to su moduli izdržljiviji."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Ovaj parametar prikazuje izdržljivost spremnika streljiva. Što je veća vrijednost, to je spremnik streljiva izdržljiviji."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Ovaj parametar prikazuje štetu nanešenu štetom ovjesa prilikom sudara. Ne utječe na štetu nanešenu bokovima ili vrhu kupole prilikom sudara."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Ovaj parametar prikazuje brzinu popravka ovjesa. Što je veća vrijednost, to je veća brzina popravaka."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Ovaj parametar prikazuje otpornost ovjesa. Što je veća vrijednost, to je vaš ovjes otporniji na granate i udar/sudaranje."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Ovaj parametar prikazuje trajanje vidljivosti neprijatelja nakon što napuste vaš vidokrug vidljivosti. Zadana vrijednost je 10 sekundi."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Ovaj parametar prikazuje smanjenje štete koje vozilo primi prilikom udarca. Što je vrijednost veća, to će primljena šteta biti manja."

msgid "extraParams/name/vehicleFireChance"
msgstr "Ovaj parametar prikazuje vjerojatnost požara motora kada je oštećen."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Ovaj parametar prikazuje izdržljivost rezervoara protiv kritične štete. Nakon uništenja rezervoari uvijek uzrokuju požar."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Ovaj parametar prikazuje smanjenje preciznosti topa po kretanju i zakretanju trupa i kupole. Što je vrijednost manja, to je manje rasipanje kruga ciljanja."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Ovaj parametar prikazuje veličinu kruga ciljnika nakon paljbe."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Ovaj parametar prikazuje rasipanje tijekom kretanja. Što je vrijednost niža, to je top precizniji."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Ovaj parametar prikazuje rasipanje tijekom zakretanja kupole. Što je vrijednost niža, to je top precizniji."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Ovaj parametar prikazuje rasipanje tijekom zakretanja topa. Što je vrijednost niža, to je top precizniji."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Ovaj parametar prikazuje rasipanje oštećenog topa. Što je vrijednost veća, to je rasipanje manje."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Ovaj parametar prikazuje štetu primljenu od HE granata. Što je veći oklop u području sudara, to je učinak veći."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Ovaj parametar prikazuje skrovitost nakon paljbe."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Ovaj parametar prikazuje trajanje vidljivosti vašeg vozila neprijateljima nakon što napustite njihov vidokrug vidljivosti. Zadana vrijednost je 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Ovaj parametar prikazuje količinu štete nanešene ovjesu primljene sudaranjem. Kada se vozila sudare, sustav razmatra debljinu oklopa u točci udara, razliku između masa vozila i njihove brzine."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Ovaj parametar prikazuje količinu štete primljene sudaranjem. Kada se vozila sudare, sustav razmatra debljinu oklopa u točci udara, razliku između masa vozila i njihove brzine."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Ovaj parametar prikazuje brzinu promjene tipa granata u napunjenom topu."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Ovaj parametar prikazuje brzinu popravaka vanjskih i unutarnjih modula od \"crvenog\" do \"žutog\" stanja. Što je vrijednost veća, to su popravci brži."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Ovaj parametar prikazuje kapacitet prenošenja ovjesa. Što je veća vrijednost, manje je vremena potrebno za dosizanje linearne brzine."

