msgid "mechanicEngineer_descr"
msgstr "Istraži sva vozila u svim tehnološkim stablima."

msgid "medalAbrams"
msgstr "Abramsova medalja %(rank)s"

msgid "medalAbrams_descr"
msgstr "Za ukupan broj timskih pobjeda u kojima je igrač preživio bitku."

msgid "medalAbrams_heroInfo"
msgstr "General Creighton Abrams je zapovjedao američkim oklopnim snagam u Drugom svjetskom ratu i u Vijetnamu stekavši reputaciju agresivnog i uspješnog zapovjednika."

msgid "medalAntiSpgFire"
msgstr "Za protutopovsku paljbu"

msgid "medalAntiSpgFire_condition"
