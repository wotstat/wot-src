msgid "comp7/deserter/cancel"
msgstr "Odustani"

msgid "comp7/deserter/message"
msgstr "Bitka još nije gotova. Ako napustite bitku prije kraja, ostavljate svoj tim na cjedilu.\n{brown_open}Vaš rejting će biti umanjen i biti ćete blokirani iz bitaka u ovom režimu.{brown_close}\nJeste li sigurni da želite napustiti bitku?"

msgid "comp7/deserter/msgTitle"
msgstr "Izgubit ćete bodove rejtinga!"

msgid "comp7/deserter/submit"
msgstr "Dezertiraj"

msgid "comp7/deserter/title"
msgstr "Dezertiranje s bojišnice"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Prekršili ste pravila igre na mapi {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} u {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close}Umanjeni su vam bodovi rejtinga i privremeno ste blokirani iz bitaka u režimu {whiteSpanish_Open}Navala{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Prekršili ste pravila igre na mapi {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} u {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nPrivremeno ste blokirani iz bitaka u režimu {whiteSpanish_Open}Navala{whiteSpanish_Close} i vaš rejting je umanjen."
