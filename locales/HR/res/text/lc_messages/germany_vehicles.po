msgid "PzIV_descr"
msgstr "Proizvodio se u većem broju od bilo kog drugog tenka njemačkih oklopnih snaga. Od ožujka 1942. ovaj tenk je bio opremljen topom s dugom cijevi. Proizvodio se od listopada 1937. do ožujka 1945. Ukupno je proizvedeno 8519 tenkova i komandnih vozila."

msgid "PzIV_schmalturm"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_schmalturm_descr"
msgstr "U studenom 1944. Krupp je predstavio nekolko projekata usmjerenih k pobojšanju tenkova i lovaca na tenkove u trenutnoj službi. Među njima je bio i projekt montiranja Pantherove Schmalturm (male kupole) na Pz IV Ausf. J. Projekt nije uzet u razmatranje jer bi preopteretio ovjes i proizvodnja Pz IV je ugašena."

msgid "PzIV_schmalturm_long_special"
msgstr "Montiranje kupole Panthera na ovo vozilo daje prilično snažan top kojeg će neprijatelj zasigurno primjetiti. Rezultat toga je fantastično vozilo podrške koje može nanijeti štetu s bilo koje udaljenosti."

msgid "PzIV_schmalturm_short"
msgstr "Pz. IV S."

msgid "PzIV_schmalturm_short_special"
msgstr "Precizan top pristojne probojnosti i velike brzine paljbe"

msgid "PzIV_short"
msgstr "Pz. IV"

msgid "PzIVturm"
msgstr "Pz.Kpfw. V/IV"

msgid "PzI_ausf_C"
msgstr "Pz.Kpfw. I Ausf. C"

msgid "PzI_ausf_C_descr"
msgstr "Početna narudžba za ovaj tenk je izvršena 1939. Isprva je zamišljen kao brzi izvidnički tenk zračnih snaga. Serijska proizvodnja je započela početkom 1942. Početkom 1943. su dva vozila priključena Prvoj oklopnoj diviziji. DOdatnih 38 vozila je priključeno 58. rezervnom tenkovskom korpusu u ljeto 1944."

msgid "PzI_ausf_C_short"
msgstr "Pz. I C"

msgid "PzI_descr"
msgstr "Pz. I Ausf. A je prvi njemački tenk koji se proizvodio serijski. Dizajn je poboljšan 1935, uključujuči produženi trup i jači motor. Serijska proizvodnja ove verzije, Pz. I Ausf. B, je dosegla 675 tenkova. Standardno naoružanje je bilo slabo, ali neka vozila su poboljšana na bojišnicama u španjolskom građanskom ratu kako bi se montirao top od 20 mm."

msgid "PzI_short"
msgstr "Pz. I"

