msgid "VK3002DB_V1"
msgstr "VK 30.01 (D)"

msgid "VK3002DB_V1_descr"
msgstr "U zimi 1941.-1942. WaPrüf 6 je izdao tehničke zahtjeve za novi 30tonsi tenk. Narudžbe su predane MANu i Daimle-Benzu. Prototipovi su trebali biti spremni do svibnja 1942., ali 13. svibnja su predane samo usporedne karakteristike. Dala se prednost projektu MANa, a projekt Daimler-Benza je otkazan."

msgid "VK3002DB_V1_short"
msgstr "VK 30.01 D"

msgid "VK7201"
