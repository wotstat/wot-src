msgid "PzIV_Hydro_descr"
msgstr "Razvoj vozila sa stražnjim hidrostatkim pogonom je počeo u Njemačkoj u srpnju 1944. Za testiranja je korištena šasija Pz. IV Ausf. G. Prvi prototip je izrađen krajem listopada 1944. Izrađeno je samo jedno vozilo."

msgid "PzIV_Hydro_short"
