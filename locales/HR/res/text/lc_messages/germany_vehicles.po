msgid "Auf_Panther"
msgstr "Aufklärungspanzer Panther"

msgid "Auf_Panther_descr"
msgstr "Projekt teškog izviđačkog vozila na temlju tenka Panther. Korištenje trupa i šasije postojćeg tenka bi značajno pomogla serijskoj proizvodnjinovih vozila, a manja kupola bi smanjila masu i poboljšala pokretljivost vozila. Mađutim, projekt je napušten u razvojnoj fazi."

msgid "Auf_Panther_long_special"
msgstr "Njemački laki tenk koji iskazuje veliku učinkovitost paljbe. Njegov precizan top s izvanrednomi depresijom i velika brzina granate omogućuju učinkovitu borbu korištenjem nepravilnosti terena. Osrednja šteta po hicu ne omogućuje ovom vozilu borbu na malim udaljenostima, ali i dalje je odličan snajper."

msgid "Auf_Panther_short"
msgstr "Aufkl.Panther"

msgid "Auf_Panther_short_special"
msgstr "Precizan top i velika količina HP"

msgid "B-1bis_captured"
msgstr "Pz.Kpfw. B2 740 (f)"

msgid "B-1bis_captured_descr"
msgstr "Tijekom kampanje u Evropu njemačke trupe su zarobile 161 teški B1 bis tenk koji je kasnije dobio oznaku Pz. Kpfw. B2 740 (f). Sva vozila su poboljšana i dobila radio opremu i dvostruke otvore na zapovjednikovoj kupoli. Dio vozila s demontiranim naoružanjem je služio za obuku, a 16 vozila je pretvoreno u samohodne haubice. Većina vozila je pretvoreno u tenkove s bacačima plamena."

msgid "B-1bis_captured_short"
msgstr "Pz. B2"

