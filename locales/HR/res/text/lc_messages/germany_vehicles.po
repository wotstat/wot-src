msgid "PzIII_IV"
msgstr "Pz.Kpfw. III/IV"

msgid "PzIII_IV_descr"
msgstr "Projekt novog vozila s nakošenim oklopnim pločama i komponentama Pz. Kpfw. III i Pz. Kpfw. IV je odobren 4. siječnja 1944. U ožujku iste godine je potpisan ugovor za tri prototipa, ali je program prekinut 12. srpnja. U serijsku proizvodnju je ušao samo lovac na tenkove na sličnoj osnovi."

msgid "PzIII_IV_short"
msgstr "Pz. III/IV"

msgid "PzII_J"
msgstr "Pz.Kpfw. II Ausf. J"

msgid "PzII_J_descr"
msgstr "Izviđački tenk s pojačanim oklopom. Vozilo je bilo daljnji razvoj Pz. Kpfw. II. U listopadu 1939. je naručena pretproizvodna grupa i prvi prototip je izrađen u srpnju 1940. Sedam vozila je 1943. i 1944. korišteno u 12. Panzer diviziiji na Istočnom frontu. Ukupno je izrađeno 22 tenka."

msgid "PzII_J_short"
msgstr "Pz. II J"

msgid "PzII_ausf_J"
