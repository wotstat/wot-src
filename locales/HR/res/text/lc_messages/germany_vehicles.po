msgid "Pz38t_Standardketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. A"

msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Tenk je razvijen za čehoslovačku vojsku od strane tvrtke ČKD 1938. Tijekom njemačke okupacije je vozilo služilo u Wehrmachtu i korišteno je u kampanjama u Poljskoj i Francuskoj, kao i na Istočnom Frontu. Tenk je bio na prvoj crti bojišnice do sredine 1942. Izrađeno je otprilike 1400 vozila u osam inačica (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

