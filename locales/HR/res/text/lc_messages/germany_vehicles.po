msgid "Pz35t_descr"
msgstr "Razvijen u trvrtci Škoda 1935. Vozilo je bilo u službi čehoslovačke vojske pod oznakom LT vz. 35. Tijekom okupacije Čehoslovačke tenkovi su preimenovani u Pz.Kpfw. 35 (t) i uvedeni u službu Wehrmachta. Vozilo je aktivno koristila 1. laka divizija (6. oklopna nakon reorganizacije) do kraja 1941. Ukupno je izrađeno 434 tenka."

msgid "Pz35t_short"
msgstr "Pz. 35 (t)"

msgid "Pz38_NA"
msgstr "Pz.Kpfw. 38 (t) n.A."

msgid "Pz38_NA_descr"
msgstr "Razvijen od strane tvrtke BMM kao laki izviđački tenk na šasiji Pz.Kpfw. 38 (t) od srpnja 1940. Na vozilu se koristila tehnologija varenja umjesto zakovica. Novi motor i poboljšani prijenos je omogućavao najveću brzinu od 64 km/sat. Razvoj je prekinut u korist VK 1303. Izrađeno je pet prototipova."

msgid "Pz38_NA_short"
msgstr "Pz. 38 nA"

msgid "Pz38t"
msgstr "Pz.Kpfw. 38 (t)"

msgid "Pz38t_Ausf_G_turm"
