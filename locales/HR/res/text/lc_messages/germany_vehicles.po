msgid "PzVIB_Tiger_II_F"
msgstr "Tiger II (H)"

msgid "PzVIB_Tiger_II_FL"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_FL_short"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_F_descr"
msgstr "Najteže oklopljen tenk koji je nosio najmoćniji protutenkovski top. Nedostaci vozila su uključivali preopterećeni ovjes i grupu motor-prijenos kao i općenito prevelika masa. Kada je napadao neprijatelja na velikim udaljenostima, Tiger II je imao prednost u smislu topa i oklopa. Međutim, zbog prevelike mase vozila, relativno niske izdržljivosti motora i prijenosa i malog broja izrađenih vozila, Tiger II nije imao značajan utjecaj na tijek rata."

msgid "PzVIB_Tiger_II_F_short"
msgstr "Tiger II (H)"

