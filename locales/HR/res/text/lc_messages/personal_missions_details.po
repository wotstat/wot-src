msgstr "sličan je osnovnom i ima svoj vlastiti napredak izvršenja. Ovaj uvjet je složeniji i imate isti broj pokušaja za njegovo izvršenje."

msgid "quest/advice/sumLimiters/info/2/title"
msgstr "Dopunski uvjet:"

msgid "quest/advice/sumLimiters/limiter/1/description"
msgstr "Po vrijednosti: zadatak ima određenu minimalnu vrijednost koju morate doseći. Ako ta vrijednost nije doegnuta, rezultat bitke se neće računati. Po vremenu: računa se samo rezultat koji je ostvaren u određenom vremenskom periodu."

msgid "quest/advice/sumLimiters/limiter/1/title"
msgstr "Ograničenje."

msgid "quest/advice/sumLimiters/limiter/2/description"
msgstr "Ako ste ošamutili neprijateljsko vozilo, nanesena šteta i uništenje tog vozila se neće računati u vašim zadacima koji zahtjevaju imobiliziranje neprijateljskog vozila uništenjem njihovih gusjenica ili štetu nakon vašeg otkrivanja."

msgid "quest/advice/sumLimiters/limiter/2/title"
msgstr "Ograničenja za samohodne topove."

msgid "quest/advice/sumLimiters/warning"
msgstr "VAŽNO: ako odustanete od zadatka, sav napredak će biti izgubljen."

msgid "quest/advice/sumSPGLimiter/description"
msgstr "Svaki zadatak ovog tipa ima ograničeni broj pokušaja za izvršenje određenog uvjeta."

msgid "quest/advice/sumSPGLimiter/info/1/description"
msgstr "rezultati svake bitke se zbrajaju. Ako nije dosegnuta tražena vrijednost i nema preostalih pokušaja, zadatak se smatra neuspješnim i napredak misije se poništava. Zadatak će biti pokrenut ponovno."

msgid "quest/advice/sumSPGLimiter/info/1/title"
msgstr "Osnovni uvjet:"

msgid "quest/advice/sumSPGLimiter/info/2/description"
msgstr "sličan je osnovnom i ima svoj vlastiti napredak izvršenja. Ovaj uvjet je složeniji i imate isti broj pokušaja za njegovo izvršenje."

msgid "quest/advice/sumSPGLimiter/info/2/title"
msgstr "Dopunski uvjet:"

msgid "quest/advice/sumSPGLimiter/limiter/1/description"
msgstr "Ako ste ošamutili neprijateljsko vozilo, nanesena šteta i uništenje tog vozila se neće računati u vašim zadacima koji zahtjevaju imobiliziranje neprijateljskog vozila uništenjem njihovih gusjenica ili štetu nakon vašeg otkrivanja."

msgid "quest/advice/sumSPGLimiter/limiter/1/title"
msgstr "Ograničenja za samohodne topove."

msgid "quest/advice/sumSPGLimiter/warning"
msgstr "VAŽNO: ako odustanete od zadatka, sav napredak će biti izgubljen."

msgid "quest_1_1"
msgstr "LT-1: Za pobjedu"

msgid "quest_1_10"
msgstr "LT-10: Najveći rezultat"

msgid "quest_1_10_advise"
msgstr "Dobar izviđač zna kada treba biti oprezan, a kada agresivan. Pazite na tijek bitke."

msgid "quest_1_10_descr"
msgstr "Što ste učinkovitiji u bitci to ćete zaraditi više iskustva. Pokažite im za što je sposoban laki tenk!"

msgid "quest_1_10_short"
msgstr "LT-10"

msgid "quest_1_11"
msgstr "LT-11: Fer borba"

msgid "quest_1_11_advise"
msgstr "Laki tenkovi visoke razine mogu imati veliku vatrenu moć. S jedne strane, vaš top može biti slabiji od onog na teškom tenku, ali, s druge strane, vaš top će najvjerojatnije lijepo probiti stražnji oklop teškog tenka."

msgid "quest_1_11_descr"
msgstr "Što je veća razina vašeg lakog tenka, to ćete dobiti veću vatrenu moć, zajedno s brzinom, vidokrugom i dobrim skrivanjem."

msgid "quest_1_11_short"
msgstr "LT-11"

msgid "quest_1_12"
msgstr "LT-12: Duh"

msgid "quest_1_12_advise"
msgstr "Kada vas neprijatelj otkrije morat ćete se stalno kretati. Ali, ako još niste otkriveni pronađite položaj u grmlju gdje možete ostati sakriveni dok otkrivate neprijatelj. Prethodno opremite vaš tenk za skrivenost."

msgid "quest_1_12_descr"
msgstr "Dobra skrivenost povećava vaše šanse preživljavanja u bitci. Laki tenkovi imaju odličnu mogućnost sakrivanja zahvaljujući njihovoj relativno niskoj silueti."

msgid "quest_1_12_short"
msgstr "LT-12"

msgid "quest_1_13"
msgstr "LT-13: Ključ do pobjede"

msgid "quest_1_13_advise"
msgstr "Kombinirajte aktivno i pasivno otkrivanje, izbjegavajte paljbu što je duže moguće. Laki tenk koji preživi do kraja bitke je prednost svojim saveznicima i gubitak za neprijateljski tim."

msgid "quest_1_13_descr"
msgstr "Ako imate nekoliko lakih tenkova u svojoj Garaži, oslonite se na onoga koji može najduže preživjeti. Laki tenk na kraju igre pokazuje svoj puni potencijal: oba tima igraju opreznije i svako otkriveno neprijateljsko vozilo završava u nišanu vaših saveznika."

msgid "quest_1_13_short"
msgstr "LT-13"

msgid "quest_1_14"
msgstr "LT-14: Borbena straža"

msgid "quest_1_14_advise"
msgstr "Svi vaši saveznici vjeruju u pobjedu. Što duže preživite, što ste duže aktivniji u igri i otkrivate neprijatelja to je veći vaš doprinos pobjedi tima."

msgid "quest_1_14_descr"
msgstr "Ako imate glasovni chat, imate mogućnost stvaranja dinamičkog voda u bitci i pozvati saveznike u pomoć na odabranoj liniji napada."

msgid "quest_1_14_short"
msgstr "LT-14"

msgid "quest_1_15"
msgstr "LT-15: Agresivni majstor izviđanja"

msgid "quest_1_15_advise"
msgstr "Niste slon u staklarni. Nema potrebe da srljate naprijed. Budite strpljivi i pojavljujte se na mjestima gdje vas neprijatelj ne očekuje. Vaša prednost je brzina i vidokrug-koristite ih mudro. Ne zaboravite da vaše vozilo ima i top."

msgid "quest_1_15_descr"
msgstr "Vrijeme je da pokažete neprijatelju što pravi laki tenk može napraviti."

msgid "quest_1_15_short"
msgstr "LT-15"

msgid "quest_1_1_advise"
msgstr "Ipak, pokušajte izbjeći izravnu borbu. Umjesto toga, pokušate pogoditi neprijatelja u stranu ili pozadinu. Promatrajte gdje je uperen neprijateljski top i priđite s druge strane."

msgid "quest_1_1_descr"
msgstr "Na nižim razinama neki laki tenkovi imaju vatrenu moć gotovo kao i teška vozila."

msgid "quest_1_1_short"
msgstr "LT-1"

msgid "quest_1_2"
msgstr "LT-2: Izviđanje"

msgid "quest_1_2_advise"
msgstr "Ali otkrivanje nekoliko neprijateljskih vozila i vaše uništenje bi bilo traćenje vašeg vrijednog tenka. Dobar izviđač može otkrivati neprijatelja i uspješno ostati živ."

msgid "quest_1_2_descr"
msgstr "Jedan od glavnih ciljeva lakih tenkova je otkrivanje neprijateljskih vozila."

msgid "quest_1_2_short"
msgstr "LT-2"

msgid "quest_1_3"
msgstr "LT-3: Potjera"

msgid "quest_1_3_advise"
msgstr "Uvijek pokušajte obuhvatiti neprijatelja i pogoditi ga straga gdje je oklop najranjiviji. Nemojte biti na jednom mjestu. Ako često mijenjate položaj neprijatelj će vas teško nanišaniti. Zapamtite da laki tenkovi imaju iste šanse otkrivanja kada se kreću i kada su nepokretni."

msgid "quest_1_3_descr"
msgstr "Vaš laki tenk ima dovoljno brzine za brzo prelaženje mape i pružanje podrške saveznicima gdje je vaša pomoć potrebna."

msgid "quest_1_3_short"
msgstr "LT-3"

msgid "quest_1_4"
msgstr "LT-4: Iznuđeno zaustavljanje"

msgid "quest_1_4_advise"
msgstr "Kako bi najučinkovitije uništili gusjenicu i imobilizrali metu, ciljajte pogonski kotač na prednjoj ili stražnjoj strani ovjesa. Zapamtite da iako vaš top nije sposoban probiti oklop neprijateljskog vozila uvijek možete uništiti gusjenicu. Fugasne granate su najbolje za tu svrhu. Dobit ćete iskustvo za štetu koju nanesu vaši saveznici neprijateljskim vozilima koje ste vi imobilizirali."

msgid "quest_1_4_descr"
msgstr "Uništi gusjenicu neprijateljskog vozila i tako ga imobiliziraj i izloži vatri snažnijim topovima suigrača. Kada uništite gusjenicu neprijateljskog vozila, privremeno ga imobilizirate. To će pomoći vama i vašim saveznicima kako bi bolje nišanili."

msgid "quest_1_4_short"
msgstr "LT-4"

msgid "quest_1_5"
msgstr "LT-5: Istureni osmatrač"

msgid "quest_1_5_advise"
msgstr "Jednom kad ste otkrili neprijatelja držite ga otkrivenim dovoljno dugo da saveznici naciljaju i opale. Ne zaboravite privući pažnju vaših saveznika na osmotreno vozilo odabirom \"Zahtjevam paljbu na...\" iz izbornika naredbi."

msgid "quest_1_5_descr"
msgstr "Na višim razinama laki tenkovi su vrlo ranjivi na neprijateljsku vatru. Radite ono što laki tenkovi najbolje rade-otkrivajte neprijateljske položaje-kako bi ostvarili najbolju učinkovitost u bitci."

msgid "quest_1_5_short"
msgstr "LT-5"

msgid "quest_1_6"
msgstr "LT-6: Borbena podrška"

msgid "quest_1_6_advise"
msgstr "Što vam je veći vidokrug, tim bolje. Pokušajte otkriti neprijateljska vozila, pogoditi njihove gusjenice i imobilizirati ih dok ste na sigurnoj udaljenosti. Oprema kao obložena optika i slično vam pomažu u otkrivanju neprijatelja sa sigurne udaljenosti."

msgid "quest_1_6_descr"
msgstr "Šteta nanešena s vašom pomoći je najvažnija statistika za lake tenkove. Ako je ta statistika visoka, to znači da ste od koristi vašem timu u bitci."

msgid "quest_1_6_short"
msgstr "LT-6"

msgid "quest_1_7"
msgstr "LT-7: Lovac na samohodne topove"

msgid "quest_1_7_advise"
msgstr "Eliminiranje neprijateljskog topništva nije lako. Pričekajte dok se neprijatelj ne upusti u borbu s vašim suigračima i potom jurnite na neprijateljsku bazu (samohodni topovi se obično tamo nalaze). Kada ih otkrijete, nemojte ući u njihove ciljnike već ih pokušajte zaobići i uništiti."

msgid "quest_1_7_descr"
msgstr "Topništvo je primarna meta lakih tenkova. Ako ga uništite osjetno ćete povećati šanse za pobjdu vašeg tima."

msgid "quest_1_7_short"
msgstr "LT-7"

msgid "quest_1_8"
msgstr "LT-8: Makni se iz naše baze!"

msgid "quest_1_8_advise"
msgstr "Ako niste sto posto sigurni da će vaše granate probiti neprijateljski oklop, koristite fugasnu granatu. One imaju veću šansu oštećivanja neprijateljskog vozila. Upamtite, ako nanesete barem jedan HP štete neprijateljskom vozilu to će poništiti osvajanje vaše baze. Kada pokušavate osvojiti bazu, pokušajte izbjegavati neprijateljsku vatru što je više moguće."

msgid "quest_1_8_descr"
msgstr "U žaru borbe je lako zaboraviti na obranu vlastite ili neutralne baze. Takva nerazboritost može neprijatelju dati prednost i omogućiti brzo osvajanje cilja. Upamtite da je vaš tenk dovoljno brz da prekine kontakt i povuče se u obranu baze i odbijanje napadača preciznim hicima ili smjelim sudaračkim napadom i tako spasi vaš tim od neizbježnog poraza."

msgid "quest_1_8_short"
msgstr "LT-8"

msgid "quest_1_9"
msgstr "LT-9: Oko sokolovo"

msgid "quest_1_9_advise"
msgstr "Nadogradnja vaše kupole može poboljšati vaš vidokrug. To će vam pomoći da otkrite neprijateljska vozila daleko prije nego se približe."

msgid "quest_1_9_descr"
msgstr "Laki tenkovi su oči tima. Pomažu u otkrivanju neprijateljskih vozila i drže ih vidljivima tijekom bitke."

msgid "quest_1_9_short"
msgstr "LT-9"

msgid "quest_2_1"
msgstr "TT-1: Debi"

msgid "quest_2_10"
msgstr "TT-10: Valjani argument"

msgid "quest_2_10_advise"
msgstr "Žar bitke je pravo vrijeme kada vaš tenk može pokazati sve što može. Vaša odlična zaštita oklopom, ako se učinkovito koristi, će osigurati preživljavanje i u najbeznadežnijim situacijama. Što dulje vaš tenk preživi u bitci, to ćete više štete nanijeti neprijatelju."

msgid "quest_2_10_descr"
msgstr "Neka vaš top stalno radi i ostanite živi što je duže moguće."

msgid "quest_2_10_short"
msgstr "HT-10"

msgid "quest_2_11"
msgstr "TT-11: Bez ogrebotine"

msgid "quest_2_11_advise"
msgstr "Koristite pribor za prvu pomoć ili alat za popravke ako neprijatelj ošteti module vašeg vozila ili ozlijedi posadu."

msgid "quest_2_11_descr"
msgstr "Svaki oštećeni modul i ozlijeđeni član posade može postati problem. Pokušajte ih zaštititi što je više moguće prilikom proboja kroz neprijateljske linije."

msgid "quest_2_11_short"
msgstr "HT-11"

msgid "quest_2_12"
msgstr "TT-12: Čvrsti oklop"

msgid "quest_2_12_advise"
msgstr "Što je više moguće izložite svoj prednji oklop neprijatelju i sakrijte bokove i slabe točke. Nakosite oklop da povećate njegovu učinkovitost."

msgid "quest_2_12_descr"
msgstr "Vaš oklop može podnijeti veliku količinu štete ako ga dobro koristite."

msgid "quest_2_12_short"
msgstr "HT-12"

msgid "quest_2_13"
msgstr "HT-13: Jurišajte na obranu!"

msgid "quest_2_13_advise"
msgstr "Kada igrate kao dio voda, koncentrirajte paljbu na neprijatelja. Pazite jedan na drugoga, probijajte neprijatelja i pronađite put do pobjede."

msgid "quest_2_13_descr"
msgstr "Nisu svi teški tenkovi spori i tromi. Neka vozila mogu doći na pravo mjesto u pravo vrijeme i suprotstaviti se neprijatelju."

msgid "quest_2_13_short"
msgstr "HT-13"

msgid "quest_2_14"
msgstr "HT-14: Zauzmite to brdo!"

msgid "quest_2_14_advise"
msgstr "Koordinirajte vaše akcije sa suigračima i pokušajte pokriti što je moguće više bojišnice razornom paljbom."

msgid "quest_2_14_descr"
msgstr "Uništite sve tipove neprijateljskih vozila, zaustavite ih i ostavite ih bez šanse za pobjedu."

msgid "quest_2_14_short"
msgstr "HT-14"

msgid "quest_2_15"
msgstr "TT-15: Kaljeni čelik"

msgid "quest_2_15_advise"
msgstr "Djelujte oprezno. Preživite! Pokušajte zaštititi vaše bočni i stražnji oklop od neprijateljske vatre. Teški tenk može iznijeti gotovo svaku bitku i zato je uvijek visokovrijedna meta za neprijateljske samohodne topove. Ostanite hladne glave i ne dopustite da vas se satjera u kut."

msgid "quest_2_15_descr"
msgstr "Teški tenk može jako udariti, ali može i primiti udarce i nastaviti se boriti. Zaokupite neprijatelja i držite pritisak."

msgid "quest_2_15_short"
msgstr "HT-15"

msgid "quest_2_1_advise"
msgstr "Susret ćete se s ostalim teškim tenkovima s vrlo debelim oklopom. Naučite gađati njihove tanje ploče i slabe točke."

msgid "quest_2_1_descr"
msgstr "Topovi teških tenkova su snažni, ali i dalje ima smisla vješto ciljati."

msgid "quest_2_1_short"
msgstr "TT-1"

msgid "quest_2_2"
msgstr "TT-2: Pucanje iz neposredne blizine"

msgid "quest_2_2_advise"
msgstr "Učinkovitost snajperskog režima značajno opada kada se neprijatelj približava. Nekada je bolje prebaciti se u arkadno ciljanje pritiskom na Shift ili korištenjem kotačića miša."

msgid "quest_2_2_descr"
msgstr "Čak i u najžešćoj bitci tvoj tenk može uništiti neprijatelja i preživjeti."

msgid "quest_2_2_short"
msgstr "TT-2"

msgid "quest_2_3"
msgstr "TT-3: Svežder"

msgid "quest_2_3_advise"
msgstr "Svaki tip vozila ima svoju jedinstvenu taktiku na bojišnici. Primjerice, srednji tenkovi mogu lako zaobići protivnike, teški tenkovi će se vjerojatno susreti s neprijateljem izravno i lovci na tenkove se vole postaviti na brdima ili sakrivati u grmovima."

msgid "quest_2_3_descr"
msgstr "Dokaži da tvoj tenk može uništiti neprijateljsko vozilo bilo kojeg tipa."

msgid "quest_2_3_short"
msgstr "TT-3"

msgid "quest_2_4"
msgstr "TT-4: Udari ih gdje ih boli"

msgid "quest_2_4_advise"
msgstr "Možete imobilizirati neprijateljsko vozilo pogotkom u njegov motor dok vam samo jedan precizan hitac u spremište streljiva može dati prednost u najtežim duelima. Unutarnji moduli su prsten kupole, motor, rezervoari, spremište streljiva i radio."

msgid "quest_2_4_descr"
msgstr "Morate poznavati ne samo svoj tenk već i protivnikova vozila. Pažljivo proučite vozila koja ćete najvjerojatnije sresti u bitci i gađajte njihove slabe točke "

msgid "quest_2_4_short"
msgstr "TT-4"

msgid "quest_2_5"
msgstr "TT-5: Meta naciljana!"

msgid "quest_2_5_advise"
msgstr "Stalno procjenjujte situaciju na bojišnici. Često je bolje povući se iz nepovoljne situacije tako da kasnije možete nanijeti više štete."

msgid "quest_2_5_descr"
msgstr "Ne dajte neprijatelju šansu-pogodite ga prvom prilikom. Svaki uspješni pogodak približava vaš tim bliže pobjedi."

msgid "quest_2_5_short"
msgstr "TT-5"

msgid "quest_2_6"
msgstr "TT-6: Objed u dva slijeda"

msgid "quest_2_6_advise"
msgstr "Što se srednjih tenkova tiče, trebate paziti na njihovu brzinu i pokretljivost jer obično izbjegavaju izravnu borbu. Uvijek promatrajte minimapu kako bi brzo reagirali na neočekivane dolaske srednjih tenkova."

msgid "quest_2_6_descr"
msgstr "Većina teških tenkova ima ekstremno debeo oklop na gornjoj ploči i prednjem dijelu kupole. Ako ih ne možete zaobići, pokušajte pogoditi točke gdje je prednji oklop najtanji. Slabe točke obično uključuju poklopce, promatračke sprave, zapovjednikovu kupolu i donju ploču."

msgid "quest_2_6_short"
msgstr "TT-6"

msgid "quest_2_7"
msgstr "TT-7: Sve je pod kontrolom"

msgid "quest_2_7_advise"
msgstr "Budite oprezni kada se približavate neprijateljskoj bazi-spremite se za \"toplu\" dobrodošlicu. Ako vam je draža obrambena taktika, koristite teren kako bi našli najbolji zaklon i točke prednosti odakle ćete biti u mogućnosti braniti vlastitu bazu (ili neutralnu bazu u bitci Susreta) protiv nadolazećeg neprijatelja."

msgid "quest_2_7_descr"
msgstr "Taktika proboja je odlična za teške tenkove. Probijete neprijateljske obrambene linije i zauzmite njihovu bazu. Međutim, ne podcjenjujte neprijatelja-i on može primjeniti istu taktiku."

msgid "quest_2_7_short"
msgstr "TT-7"

msgid "quest_2_8"
msgstr "TT-8: Iz svih oruđa"

msgid "quest_2_8_advise"
msgstr "Kao teški tenk vi ste kičma vašeg tima. Neprijateljski teški tenkovi su jednako bitni. Navalite na njih i pokušajte ih uništiti prve ili u najmanju ruku ih držite zaposlenima što je duže moguće."

msgid "quest_2_8_descr"
msgstr "Upamtite, oklop je vaša ključna snaga. Nanesite što je više štete moguće dok vaš protivnik stalno uživa u porukama o neprobijanju."

msgid "quest_2_8_short"
msgstr "TT-8"

msgid "quest_2_9"
msgstr "TT-9: Poražavajući udarac"

msgid "quest_2_9_advise"
msgstr "Vozačeva sposobnost Kontrolirani udar i predmet opreme Dvoslojni oklop može značajno smanjiti štetu koju neprijatelj može nanijeti vašem vozilu sudaranjem i istovremeno povećati štetu vašeg napada sudaranjem."

msgid "quest_2_9_descr"
msgstr "Često tijekom borbe u skučenom prostoru nećete imati dovoljno vremena za punjenje. U toj situaciji dokrajčite neprijatelja sudaranjem! Što je oklop neprijateljskog vozila slabiji u točci sudaranja, to ćete nanijeti više štete."

msgid "quest_2_9_short"
msgstr "TT-9"

msgid "quest_3_1"
msgstr "ST-1: Prvi koraci"

msgid "quest_3_10"
msgstr "ST-10: Svestrani ratnik"

msgid "quest_3_10_advise"
msgstr "Vaše vozilo je pokretljivo. Pokušajte iskoristiti tu prednost za obuhvat neprijateljskih vozila i napad straga ili s bokova. Vozila sa slabim oklopom se mogu uništiti sudaranjem."

msgid "quest_3_10_descr"
msgstr "Srednji tenk nastupa dobro na svim tipovima mapa i protiv bilo kojeg neprijateljskog vozila. Ako proučite osobine svojeg vozila, znati ćete kako izaći kao pobjednik u bilo kojoj borbenoj situaciji."

msgid "quest_3_10_short"
msgstr "ST-10"

msgid "quest_3_11"
msgstr "ST-11: Zabij se u njih!"

msgid "quest_3_11_advise"
msgstr "Što je veća brzina i masa vašeg vozila to ćete više štete nanijeti neprijateljskom vozilu sudaranjem."

msgid "quest_3_11_descr"
msgstr "Neke situacije na bojišnici iziskuju neuobičajene taktike."

msgid "quest_3_11_short"
msgstr "ST-11"

msgid "quest_3_12"
msgstr "ST-12: Spalitelj"

msgid "quest_3_12_advise"
msgstr "Probijajući hici koji pogode motor ili rezervoar mogu uzrokovati požar. Proučite nacrte vozila i naučite gdje se nalaze ti ključni moduli."

msgid "quest_3_12_descr"
msgstr "Zapaljenje neprijateljskih vozila je jedan od najučinkovitijih načina da ih se uništi."

msgid "quest_3_12_short"
msgstr "ST-12"

msgid "quest_3_13"
msgstr "ST-13: Agresivne akcije"

msgid "quest_3_13_advise"
msgstr "Čim uništite neprijatelja, pređite na drugu metu. Vaši suigrači najvjerojatnije trebaju pomoć negdje drugdje."

msgid "quest_3_13_descr"
msgstr "Dobijate iskustvo za sve učinkovite akcije. Skrivanje na rubu mape nije baš učinkovito-pokušajte biti što je moguće bliže akciji i pokrivati svoje saveznike."

msgid "quest_3_13_short"
msgstr "ST-13"

msgid "quest_3_14"
msgstr "ST-14: Timska igra"

msgid "quest_3_14_advise"
msgstr "Odaberite svaku metu pojedinačno i koncentrirajte paljbu. Krećite se agresivno! Možete uništiti neprijateljska vozila i brzo probiti najtvrđe obrane. Ne zaboravite privući pažnju vaših saveznika na otkrivena vozila odabiranjem \"Zahtjevam paljbu na..\" iz izbornika naredbi."

msgid "quest_3_14_descr"
msgstr "U bitci se oslanjate na vaše vještine kao i na vještine članova voda i saveznika. Ako se svi članovi tima bore kao jedan, pobjeda je zagarantirana!"

msgid "quest_3_14_short"
msgstr "ST-14"

msgid "quest_3_15"
msgstr "ST-15: Lov na lovca"

msgid "quest_3_15_advise"
msgstr "Razmislite gdje bi postavili vaš lovac na tenkove da ga vozite. To bi moglo biti mjesto gdje se upravo sada skriva neprijateljski lovac na tenkove. Lovci na tenkove se obično postavljaju kako bi pokrili uobičajene pravce napada pa ih pokušajte udariti iz neočekivanog položaja."

msgid "quest_3_15_descr"
msgstr "Možete preokrenuti tijek bitke neutraliziranjem neprijateljskih lovaca na tenkove."

msgid "quest_3_15_short"
msgstr "ST-15"

msgid "quest_3_1_advise"
msgstr "Udari protivnika kad god možeš, ali isto tako pokušaj izbjeći njihovu paljbu."

msgid "quest_3_1_descr"
msgstr "Na nižim razinama većina srednjih tenkova se može pohvatati s bilo kojim drugim tipom vozila."

msgid "quest_3_1_short"
msgstr "ST-1"

msgid "quest_3_2"
msgstr "ST-2: Dobar pogodak"

msgid "quest_3_2_advise"
msgstr "Marker vjerojatnosti proboja na vašem ciljniku prikazuje vjerojatnost proboja neprijateljskog vozila na određenoj točci. Crveni marker označava da nema vjerojatnosti, žuti malu vjerojatnost, a zeleni veliku vjerojatnost proboja. Pokušajte ciljati na bokove ili stražnji dio vozila. Tražite slabe točke."

msgid "quest_3_2_descr"
msgstr "Svaki uspješni pogodak približava vaš tim pobjedi. Međutim, nije tako lako dobro pogoditi neprijateljsko vozilo."

msgid "quest_3_2_short"
msgstr "ST-2"

msgid "quest_3_3"
msgstr "ST-3: Udarna snaga"

msgid "quest_3_3_advise"
msgstr "Krećite se agresivno iza neprijateljskih linija i stvarajte metež te stavite suprotni tim u nepovoljan položaj."

msgid "quest_3_3_descr"
msgstr "Srednji tenkovi su pokretljiva vozila s impresivnim topovima."

msgid "quest_3_3_short"
msgstr "ST-3"

msgid "quest_3_4"
msgstr "ST-4: Ne mrdaj, molim te"

msgid "quest_3_4_advise"
msgstr "Ciljajte na pogonske kotače, nazubljene kotače na prednjoj ili stražnjoj strani ovjesa. Tenk je laka meta kada je imobiliziran. Nemojte zaboraviti skrenuti pažnju saveznika na ciljano vozilo odabirom \"Zahtjevam paljbu na...\" iz izbornika naredbi."

msgid "quest_3_4_descr"
msgstr "Uništenje gusjenica neprijatelja i njihova imobilizacija ih čini ranjivim za više hitaca od vas ili vaših saveznika."

msgid "quest_3_4_short"
msgstr "ST-4"

msgid "quest_3_5"
msgstr "ST-5: Protuizviđanje"

msgid "quest_3_5_advise"
msgstr "Ne dajte lakim tenkovima da ostvare svoj glavni cilj! Spriječite ih u otkrivanju i imobilizaciji vozila vaših suigrača."

msgid "quest_3_5_descr"
msgstr "Jedan od ciljeva srednjih tenkova je uništenje lakih tenkova."

msgid "quest_3_5_short"
msgstr "ST-5"

msgid "quest_3_6"
msgstr "ST-6: Brza paljba"

msgid "quest_3_6_advise"
msgstr "Vaš tenk kombinira pokretljivost i vatrenu moć-koristite oboje. Možete pomoći suigračima na jednom boku, potom se povući u bazu i štititi samohodne topove i onda iznenada udariti neprijatelja iz pozadine i to sve u jednoj bitci."

msgid "quest_3_6_descr"
msgstr "Srednji tenkovi su fleksibilni i sposobni ostvariti razne ciljeve na bojišnici."

msgid "quest_3_6_short"
msgstr "ST-6"

msgid "quest_3_7"
msgstr "ST-7: Iznenadni udarac"

msgid "quest_3_7_advise"
msgstr "Neprijateljsko topništvo može nanijeti veliku štetu vašim suigračima. Probijte bokove, sjurite se u neprijateljsku bazu i neutralizirajte njihove samohodne topove."

msgid "quest_3_7_descr"
msgstr "Neprijateljski samohodni topovi su vaš primarni cilj. Njihova neutralizacija će odvesti vaš tim jedan korak bliže pobjedi."

msgid "quest_3_7_short"
msgstr "ST-7"

msgid "quest_3_8"
msgstr "ST-8: Sukob"

msgid "quest_3_8_advise"
msgstr "Usredotočite se na vozila iste razine ili više od vašeg vozila. Samo ćete borbom protiv jednakih ili vozila više razine poboljšati vaše vještine vožnje srednjih tenkova i zaraditi vrijedne nagrade nakon bitke."

msgid "quest_3_8_descr"
msgstr "Uništite neprijateljska vozila iste ili više razine i time značajno doprinosite pobjedi vašeg tima."

msgid "quest_3_8_short"
msgstr "ST-8"

msgid "quest_3_9"
msgstr "ST-9: Dostojni protivnik"

msgid "quest_3_9_advise"
msgstr "Obuhvatite neprijateljska vozila, pucajte na njih iz zasjede ili gađajte njihove slabe točke-što god je potrebno. Upamtite da su teški tenkovi sporiji od vas i da njihove kupole imaju manju brzinu zakretanja."

msgid "quest_3_9_descr"
msgstr "Traženje i uništavanje neprijateljskih teških tenkova je težak zadatak, ali puno koristi timu."

msgid "quest_3_9_short"
msgstr "ST-9"

msgid "quest_4_1"
msgstr "LNT-1: Učinkovito djelovanje"

msgid "quest_4_10"
msgstr "LNT-10: Skrivena napast"

msgid "quest_4_10_advise"
msgstr "Koristite kamuflažu i maskirnu mrežu. Držite razmak i neka vaši suigrači obave otkrivanje. Služite timu tako da ste izvan vidokruga, ali na položaju da zapucate kada se ukaže prilika."

msgid "quest_4_10_descr"
msgstr "Ako je vaš lovac na tenkove dobro zaklonjen možete udariti na neprijatelja bez da uzvrate na vas."

msgid "quest_4_10_short"
msgstr "Lnt-10"

msgid "quest_4_11"
msgstr "LNT-11: Ključna uloga"

msgid "quest_4_11_advise"
msgstr "Glavni izazov lovaca na tenkove je preživljavanje bitke dovoljno dugo da ostvare svoj puni potencijal nanošenja štete. Morate napasti protivnika, ali također i preživjeti."

msgid "quest_4_11_descr"
msgstr "Vaš moćni top je sila na koju se mora računati. Naravno, ako ga znate koristiti."

msgid "quest_4_11_short"
msgstr "Lnt-11"

msgid "quest_4_12"
msgstr "LNT-12: Lov na veliku divljač"

msgid "quest_4_12_advise"
msgstr "Imate potencijal voditi svoj tim do pobjede. Ako znate slabe točke neprijateljskih vozila, debljina njihovog oklopa ih ne može spasiti."

msgid "quest_4_12_descr"
msgstr "Naoružani s mudrošću i odličnim topom možete uništiti neprijateljska vozila prije nego se približe. Jednom kad je teški tenk otkriven, možete mu nanijeti puno štete prije nego vas vidi."

msgid "quest_4_12_short"
msgstr "Lnt-12"

msgid "quest_4_13"
msgstr "Lnt-13: Lovci na tenkove"

msgid "quest_4_13_advise"
msgstr "Većina lovaca na tenkove daju veliku štetu jednim hicem. Koordinirajte se sa svojim članovima voda i pucajte u salvama. Nema puno vozila koja mogu podnijeti višestruke pogotke."

msgid "quest_4_13_descr"
msgstr "Koncentrirajte paljbu i brzo uništavajte neprijateljske tenkove. Pokušajte se koncentrirati na vozila koja su već primila štetu-što su brže uništena, to je veći vaš doprinos pobjedi."

msgid "quest_4_13_short"
msgstr "LnT-13"

msgid "quest_4_14"
msgstr "LnT14: Veliki lov"

msgid "quest_4_14_advise"
msgstr "Sačuvajte vitalnost svojeg vozila i izbjegavajte neprijateljsku vatru. To nije velika nauka-što ste duže živi, to više štete nanosite."

msgid "quest_4_14_descr"
msgstr "Vaš cilj je u svakoj bitci nanijeti što je moguće više štete. Nasreću, vaše vozilo je najpogodnije za tu svrhu."

msgid "quest_4_14_short"
msgstr "Lnt-14"

msgid "quest_4_15"
msgstr "LNT-15: Trijumf"

msgid "quest_4_15_advise"
msgstr "Što više štete nanesete tijekom bitke to je veća šansa pobjede za vaš tim. Jednostavno pravilo koje treba zapamtiti."

msgid "quest_4_15_descr"
msgstr "Kada diplomacija ne uspije, topovi počinju pričati. Pripremite svoju riječ u topu."

msgid "quest_4_15_short"
msgstr "LnT-15"

msgid "quest_4_1_advise"
msgstr "Lovci na tenkove imaju jaku vatrenu moć, ali relativno teško preživljavaju. Pokušajte pucati s udaljenosti-preciznost vaših topova vam to omogućava."

msgid "quest_4_1_descr"
msgstr "Lovci na tenkovi su odličan izbor za igrače koji vole uništavati neprijateljska vozila sa velike udaljenosti."

msgid "quest_4_1_short"
msgstr "LnT-1"

msgid "quest_4_2"
msgstr "LnT-2: Ciljana paljba"

msgid "quest_4_2_advise"
msgstr "Uspješan pogodak može oštetiti ili uništiti module neprijateljskog vozila ili ozlijediti posadu. Ponekad su visokoeksplozivne granate bolje za tu svrhu."

msgid "quest_4_2_descr"
msgstr "Uništenje modula vozila i ozljeđivanje članova posade može vozilo učiniti beskorisnim."

msgid "quest_4_2_short"
msgstr "LnT-2"

msgid "quest_4_3"
msgstr "LnT-3: Dobar lov"

msgid "quest_4_3_advise"
msgstr "Mnogi lovci na tenkove imaju tanki oklop i većina nema kupolu. Najsigurnija taktika je paljba s velike udaljenosti."

msgid "quest_4_3_descr"
msgstr "Najveća prednost lovaca na tenkove je njihova velika vatrena moć."

msgid "quest_4_3_short"
msgstr "LnT-3"

msgid "quest_4_4"
msgstr "LNT-4: Zasjeda"

msgid "quest_4_4_advise"
msgstr "Probajte naći dobar zaklon od paljbe. Gusti grm ili srušeno drvo će biti dovoljno. Visoka vrijednost kamuflaže će vam pomoći da ostanete neotkriveni-isto kao i paljba s velike udaljenosti."

msgid "quest_4_4_descr"
msgstr "Skrivenost je ključni faktor u preživljavanju lovaca na tenkove."

msgid "quest_4_4_short"
msgstr "LnT-4"

msgid "quest_4_5"
msgstr "LNT-5: Dalekometni top"

msgid "quest_4_5_advise"
msgstr "Potpuno naciljajte metu prije pucanja. Brzopleti hitac je često promašeni hitac."

msgid "quest_4_5_descr"
msgstr "Kada vozite lovac na tenkove bitno je znati kako učinkovito pucati na velike udaljenosti."

msgid "quest_4_5_short"
msgstr "LnT-5"

msgid "quest_4_6"
msgstr "LNT-6: Neće proći!"

msgid "quest_4_6_advise"
msgstr "PObrinite se da je vaše vozilo sakriveno iza grmlja ili srušenih stabala prije nego otvorite vatru. Ako je vaše vozilo 15 m iza grmlja ili srušenog stabla imate veće šanse ostati skriveni nakon otvaranja vatre."

msgid "quest_4_6_descr"
msgstr "Pokušajte držati razmak od neprijateljskih vozila što je moguće većim. Uništite ih dok prilaze jer će biti puno teže oduprijeti se napadu u bliskoj borbi."

msgid "quest_4_6_short"
msgstr "LnT-6"

msgid "quest_4_7"
msgstr "LNT-7: Prvi udar"

msgid "quest_4_7_advise"
msgstr "Ako neprijateljsko vozilo juriša na vas i ne možete probiti njegov prednji oklop, možda ga možete imobilizirati uništenjem njegovih gusjenica i pobjeći. Proučite parametre vlastitog vozila. Neki lovci na tenkove imaju jaki prednji oklop koji može odbiti puno hitaca."

msgid "quest_4_7_descr"
msgstr "Ne dajte neprijatelju da vam se previše približi: većina lovaca na tenkove ima tanki oklop."

msgid "quest_4_7_short"
msgstr "LnT-7"

msgid "quest_4_8"
msgstr "LNT-8: Veliki kalibar"

msgid "quest_4_8_advise"
msgstr "Pokušajte u svakoj prilici oštetiti neprijateljsko vozilo, ali istovremeno pokušajte preživjeti."

msgid "quest_4_8_descr"
msgstr "Kao vozač lovca na tenkove od vas se očekuje da nanešete više štete neprijatelju nego HP svojeg vozila."

msgid "quest_4_8_short"
msgstr "LnT-8"

msgid "quest_4_9"
msgstr "LNT-9: Točno mjesto"

msgid "quest_4_9_advise"
msgstr "Gađajte slabe točke neprijateljskog vozila kao što su bokovi, pozadina i donja nakošena ploča. Također je korisno znati gdje se na neprijateljskom vozilu nalaze spremnik streljiva i rezervoari. Kako bi najučinkovitije igrali ne zaboravite uzeti nekoliko posebnih granata u bitku. Te granate mogu probiti puno veći oklop nego standardne."

msgid "quest_4_9_descr"
msgstr "Odlične karakteristike vašeg topa nadoknađuju relativno slab oklop vašeg vozila."

msgid "quest_4_9_short"
msgstr "LnT-9"

msgid "quest_5_1"
msgstr "ShT-1: Odvažna tvrdnja"

msgid "quest_5_10"
msgstr "ShT-10: Cijeli spektar usluga"

msgid "quest_5_10_advise"
msgstr "?empty?"

msgid "quest_5_10_descr"
msgstr "Situacija u bitci se može brzo promjeniti-uvijek pazite na minimapu i pobrinite se da imate jasan pregled neprijateljskih vozila. Morat ćete se cijelo vrijeme kretati po mapi umjesto da ostajete na jednom položaju. Vaši saveznici se pouzdaju u vatrenu moć vašeg samohodnog topa pa dajte sve od sebe na pravom mjestu i u pravo vrijeme."

msgid "quest_5_10_short"
msgstr "ShT-10"

msgid "quest_5_11"
msgstr "ShT-11: Područje učinka"

msgid "quest_5_11_advise"
msgstr "?empty?"

msgid "quest_5_11_descr"
msgstr "Osim znatne štete koje mogu nanijeti dobro smješteni hici, većina samohodnih topova ima granate koje mogu također ošamutiti sva krivo smještena vozila unutar radijusa štete nakon eksplozije granate. Na mnogim mapama su mjesta gdje se neprijateljska vozila zajedno gužvaju. Iskoristite priliku i pošaljite im eksplozivne \"pozdrave\"."

msgid "quest_5_11_short"
msgstr "ShT-11"

msgid "quest_5_12"
msgstr "ShT-12: Zlo oko"

msgid "quest_5_12_advise"
msgstr "?empty?"

msgid "quest_5_12_descr"
msgstr "Vaši saveznici su uništili ošamućeno neprijateljsko vozilo? To su dobre vijesti za vas jer vas je vaš doprinos primaknuo korak bliže pobjedi! Vaš cilj je davati vatrenu potporu i pomagati saveznicima u pravo vrijeme i na pravom mjestu."

msgid "quest_5_12_short"
msgstr "ShT-12"

msgid "quest_5_13"
msgstr "ShT-13: S za suradnju"

msgid "quest_5_13_advise"
msgstr "?empty?"

msgid "quest_5_13_descr"
msgstr "Vod dobro vođenih samohodnih topova bi trebao jako zabrinuti neprijatelja. Koordinirajte svoje akcije i koncentrirajte vatru na jednu po jednu metu."

msgid "quest_5_13_short"
msgstr "ShT-13"

msgid "quest_5_14"
msgstr "ShT-14: Dio posade, dio broda"

msgid "quest_5_14_advise"
msgstr "?empty?"

msgid "quest_5_14_descr"
msgstr "Suradnja unutar voda je ključe pobjede cijelog tima. Označite neprijateljska vozila koja ciljate kako bi ih vaši suigrači u vodu odmah mogli zasuti paljbom jednom kada su ošamućeni ili imobilizirani. Upamtite: usamljeni vojnik teško može dobiti bitku."

msgid "quest_5_14_short"
msgstr "ShT-14"

msgid "quest_5_15"
msgstr "ShT-15: Bogovi rata"

msgid "quest_5_15_advise"
msgstr "?empty?"

msgid "quest_5_15_descr"
msgstr "Samohodni top koji preživi što je duže moguće je prava vrijednost tima. Ispaljujte jednu granatu za drugom, ali nemojte pasti pod neprijateljsku paljbu. Budite strpljivi i promislite dvapu prije nego \"pritisnete okidač\" jer je \"jedan hitac-jedan pogodak\" najbolja strategija za vozilo koje dugo puni granatu."

msgid "quest_5_15_short"
msgstr "ShT-15"

msgid "quest_5_1_advise"
msgstr "?empty?"

msgid "quest_5_1_descr"
msgstr "Veliki radijus štete nakon eksplozije granate je ključna osobina samohodnih topova. Čak i ako ne uspijete izravno pogoditi neprijateljsko vozilo još uvijek ima šanse uzrokovanja velike glavobolje tako što ste ga ošamutili. Neprijateljsko vozilo je označeno znakom ošamućenosti koje je vidljivo vašim saveznicima. Ako vaši saveznici nanesu štetu vozilu koje ste ošamutili, dobit ćete dodatne kredite i iskustvo za štetu koja je nanešena uz vašu pomoć."

msgid "quest_5_1_short"
msgstr "ShT-1"

msgid "quest_5_2"
msgstr "ShT-2: Vrijeme je novac"

msgid "quest_5_2_advise"
msgstr "?empty?"

msgid "quest_5_2_descr"
msgstr "Neprijateljsko vozilo ostaje ošamućeno na određeni period i ne može dati sve od sebe na bojišnici. Upamtite: ošamućeno vozilo postaje laka meta."

msgid "quest_5_2_short"
msgstr "ShT-2"

msgid "quest_5_3"
msgstr "ShT-3: Polako i sigurno se ošamuti"

msgid "quest_5_3_advise"
msgstr "?empty?"

msgid "quest_5_3_descr"
msgstr "Skriveni i moćni lovci na tenkove i dobro oklopljeni teški tenkovi mogu preokrenuti tijek bitke. Oni su vaše primarne mete i nanošenje štete njima (ili pomaganje u njihovom uništenju) bi trebao biti primarni cilj za igrača u samohodnom topu. Većina teškaša i lovaca na tenkove su spori i nezgrapni što povećava vjerojatnost uspješnog hica."

msgid "quest_5_3_short"
msgstr "ShT-3"

msgid "quest_5_4"
msgstr "ShT-4: Provest ću te!"

msgid "quest_5_4_advise"
msgstr "?empty?"

msgid "quest_5_4_descr"
msgstr "Naučite glavne pravce neprijateljskih teških tenkova i položaje gdje se obično skrivaju lukavi lovci na tenkove. Ciljanje unaprijed na određeni dio mape povećava vjerojatnost za najučinkovitiju i najrazorniju paljbu na neprijateljske položaje. Ovi tipovi vozila obično koriste predvidljive taktike na određenim mapama. Budite pametni: analizirajte sastav neprijateljskog tima i odaberite najbolji položaj na samom početku bitke."

msgid "quest_5_4_short"
msgstr "ShT-4"

msgid "quest_5_5"
msgstr "ShT-5: Dijeljenje je užitak"

msgid "quest_5_5_advise"
msgstr "?empty?"

msgid "quest_5_5_descr"
msgstr "Ošamućivanje neprijateljskih vozila ne samo da vas dovodi korak bliže pobjedi već dobijate i dodatno iskustvo i kredite ako vaši saveznici oštete vozila koja ste ošamutili. Nemojte zaboraviti označiti područje na koje ciljate (zadano tipka T) kako bi obavjestili svoje saveznike."

msgid "quest_5_5_short"
msgstr "ShT-5"

msgid "quest_5_6"
msgstr "ShT-6: Malj bogova"

msgid "quest_5_6_advise"
msgstr "?empty?"

msgid "quest_5_6_descr"
msgstr "Primarni cilj samohodnih topova je pružanje vatrene potpore saveznicima. Ošamućena neprijateljska vozila su slabi borci i vaši suigrači će znati cijeniti vašu pomoć. Međutim, budite pažljivi kada pucate: aljkavi hitac može ošamutiti i savezničko vozilo. Prijateljska paljba se ne će tolerirati."

msgid "quest_5_6_short"
msgstr "ShT-6"

msgid "quest_5_7"
msgstr "ShT-7: Pažljivo razmatranje"

msgid "quest_5_7_advise"
msgstr "?empty?"

msgid "quest_5_7_descr"
msgstr "Kako bi izvršili ovaj zadatak, selektivno birajte svoje mete. Nemojte koncentrirati paljbu na jedno neprijateljsko vozilo, čak i ako je laka meta. Najbolja strategija je da udarite po velikim grupama neprijateljskih vozila jednim hicem. Proučite mape i naučite osnovne pravce vozila."

msgid "quest_5_7_short"
msgstr "ShT-7"

msgid "quest_5_8"
msgstr "ShT-8: Dao sam sve od sebe"

msgid "quest_5_8_advise"
msgstr "?empty?"

msgid "quest_5_8_descr"
msgstr "Dobijate iskustvo za sve učinkovite akcije. Pokušajte biti MVP: nanosite štetu, pomagajte u uništavanju neprijateljskih vozila i preživite bitku. Mjenjajte svoj položaj nakon svakog hica-u suprotnom protupaljba neprijateljskih samohodnih topova može uništiti vaše vozilo."

msgid "quest_5_8_short"
msgstr "ShT-8"

msgid "quest_5_9"
msgstr "ShT-9: Kolateralna šteta"

msgid "quest_5_9_advise"
msgstr "?empty?"

msgid "quest_5_9_descr"
msgstr "Moćne HE granate samohodnih topova ne samo da smanjuju HP neprijateljskih vozila već imaju i veliku šansu uništiti module ili ozlijediti članove posade sa štetom rasprskavanja."

msgid "quest_5_9_short"
msgstr "ShT-9"

