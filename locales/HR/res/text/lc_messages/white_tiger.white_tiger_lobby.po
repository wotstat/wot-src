msgstr "Von Krieger je izgradio stroj za razmišljanje koji naziva Električna inteligencija. Skriva se tamo gdje naše oružje ne može dosegnuti. Svaki hitac koji ispalimo postaje njegova lekcija. Ali nismo završili s podučavanjem."

msgid "welcomeScreen/description_2"
msgstr "Preuzmite kontrolu nad legendarnim Blitzträgerom  pod zapovjedništvom Maxa von Kriegera u bitci protiv goniča ili vodite izmjenjeni odred goniča u sukob s Blitzträgerom!"

msgid "welcomeScreen/description_3"
msgstr "Dobit ćete vrijedne nagrade za izvršenje etapa napretka. Za završavanje ovih etapa trebate osvojiti tokene posebnih zadataka akcije."

msgid "welcomeScreen/header_1"
msgstr "Rođen od munje"

msgid "welcomeScreen/header_2"
msgstr "Učenje stroja"

msgid "welcomeScreen/header_3"
msgstr "Napredak i nagrade"

msgid "welcomeScreen/title"
msgstr "Waffenträger: Postanak"
