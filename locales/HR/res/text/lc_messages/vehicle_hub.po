msgid "abilities/common/description/autoLoaderGun"
msgstr "Omogućuje ispaljivanje niza granata iz spremnika jednu po jednu dok se svaka granata automatski puni tijekom vremena."

msgid "abilities/common/description/autoLoaderGunBoost"
msgstr "Omogućuje ispaljivanje niza granata iz spremnika jednu po jednu dok se svaka granata automatski puni tijekom vremena. Daje bonus na brzinu punjenja slijedeće granate tijekom punjenja."

msgid "abilities/common/description/autoShootGun"
msgstr "Ispaljuje brze rafale granata kako bi nanio veliku štetu u kratkom vremenu nauštrb probojnosti i preciznosti. Najučinkovitiji u bliskoj borbi."

msgid "abilities/common/description/damageMutable"
msgstr "Ispaljuje svjetleće granate i nanosi maksimalnu štetu unutar 50 m. Šteta granate pada s udaljenosti što ga čini najučinkovitijim u bliskoj borbi."

msgid "abilities/common/description/dualAccuracy"
msgstr "Jedinstveni sustav hlađenja koji omogućava dvostruko ciljanje: čekanje nakon punjenja omogućuje precizniju paljbu topa. Poboljšana preciznost je pokazana drugim, manjim ciljnikom."

msgid "abilities/common/description/dualGun"
msgstr "Sustav dvostrukog topa s mogućnošću ispaljivanja iz obje cijevi odvojeno ili istovrmeno. Dvostruki hici nanose veliku rafalnu štetu, ali dolaze s duljim punjenjem."

msgid "abilities/common/description/hydraulicChassis"
msgstr "Omogućuje promjenu kuteva elevacije trupa vozila što nudi prilike za paljbu s više položaja u bitci. Aktivacija ovisi o raznim uvjetima."

msgid "abilities/common/description/hydraulicWheeledChassis"
msgstr "Mijenja položaj dodatnih kotača kako bi se značajno povećala brzina, ali na štetu pokretljivosti. Najbolje koristiti za prelaženje velikih udaljenosti žurne napade."

msgid "abilities/common/description/magazineGun"
msgstr "Omogućuje ispaljivanje niza granata is spremnika prije no što je potrebno kompletno punjenje. Isporučuje veliku rafalnu štetu, ali ostavlja vozilo ranjivim tijekom punjenja. Može puniti samo cijeli spremnik odjednom."

msgid "abilities/common/description/overheatGun"
msgstr "Top može pucati stalno bez potrebe za punjenjem. Svaki hitac stvara toplinu: što je temperatura veća, to se više neki parametri mjenjaju. Stalna paljba će uzrokovati pregrijavanje topa što će spriječiti daljnju paljbu dok se ne ohladi."

msgid "abilities/common/description/rocketAcceleration"
msgstr "Povećava snagu motora i najveću brzinu za brzo kretanje po bojištu. Kada je aktiviran, mlazni potisnici umanjuju pokretljivost i ne mogu se ručno isključiti."

msgid "abilities/common/description/shellParamsSwitcher"
msgstr "Top vozila ima posebne uređaje koji omogućuju izmjenu nekih parametara granata prije paljbe. Parametri za različite granate razlikuju se ovisno o odabranom režimu, a svaki režim omogućuje vam brzu prilagodbu različitim borbenim situacijama."

msgid "abilities/common/description/siegeMode"
msgstr "Kada je aktiviran, ovaj posebni režim povećava i/ili mijenja određene parametre bitke. Najbolje ga je aktivirati kada ste na položaju i spremni za sukob s neprijateljem."

msgid "abilities/common/description/stun"
msgstr "Ošamućuje neprijateljska vozila unutar određenog polumjera eksplozije, čak i bez izravnog pogotka. Kratko pogoršava njihovu pokretljivost, preciznost i vrijeme punjenja. Ošamućeni neprijatelji su obilježeni oznakom ošamućenja."

msgid "abilities/common/description/trackWithinTrack"
msgstr "Omogućuje kretanje vozila na umanjenoj brzini kada je uništena glavna gusjenica. Gubitak dodatne vanjske gusjenice još više umanjuje pokretljivost, ali se vozilo još uvijek može okretati i micati."

msgid "abilities/common/description/turboshaftEngine"
msgstr "Omogućuje značajno brže putovanje vozila dok znatno smanjuje parametre upravljanja topom."

msgid "abilities/common/description/twinGun"
msgstr "Kada je aktiviran, ovaj posebni režim nanosi dvostruku štetu i povećava i/ili mijenja određene parametre bitke. Najbolje koristiti u bliskim susretima."

