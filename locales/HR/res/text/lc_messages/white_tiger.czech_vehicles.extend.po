msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "Ova Pojistka je cijela mobilna radionica za gazišta. Oštri kutovi, čisto ožičenje, svaki sustav odgovara na prvi zahtjev. Krenuli smo zaustaviti jednog poremećenog znanstvenika i na kraju smo se suočili s nečim što on naziva Električnom Inteligencijom. Njegovi Stražari još uvijek uče, prate svaki naš potez. Izgradio ih je da nas zamijene. Dobro. Onda je današnja lekcija moja. Pronalazim greben, smještam se na metu i puštam ove nasmiješene školjke da obave ostalo. Ako stvarno vjeruje da njegov stroj za razmišljanje može nadživjeti nas, da vidimo što će smisliti pod pritiskom."

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "Velika modernizacija glavnog borbenog tenka"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Srebrni metak"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "Ponos oružara Saveza"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Svaki preopterećeni generator će puniti srebrni metak plazmom. Što je više naboja, to više štete plazma nanosi. Pucajte za maksimalnu štetu kada je Blitzträgereov štit onemogućen."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Dodatna šteta plazmom"
