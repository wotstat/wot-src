msgid "battlePassSeasonDescription"
msgstr "NOVI TEMATSKI 3D STILOVI"

msgid "beCareful"
msgstr "Budi oprezan"

msgid "comp7Core10"
msgstr "Možete se prebaciti u prikladnije vozilo tijekom pripreme prije bitke."

msgid "comp7Core10Status"
msgstr "Priprema prije bitke"

msgid "comp7Core11"
msgstr "Ekran pripreme prije bitke prikazuje vaša vozila opremljena s posadom i granatama. Ne zaboravite ih pripremiti prije ulaska u bitku."

msgid "comp7Core11Status"
msgstr "Priprema prije bitke"

msgid "comp7Core12"
msgstr "Kada odaberete vozilo, javite to saveznicima klikom na gumb Potvrdi odabir."

msgid "comp7Core12Status"
msgstr "Priprema prije bitke"

msgid "comp7Core13"
msgstr "Nakon klika na gumb Potvrdi odabir, ne možete mijenjati vozila."

msgid "comp7Core13Status"
msgstr "Potvrdite svoj odabir"

msgid "comp7Core14"
msgstr "Osvojite posebne točke na mapi za pristup Taktičkim vještinama i ostvarite prednost!"

msgid "comp7Core14Status"
msgstr "Točke interesa"

msgid "comp7Core15"
msgstr "Točke interesa na mapi. Osvajanje ovog položaja će vam omogućiti korištenje Taktičke vještine naziva Divizijski radar. Kada je uključena, sva neprijateljska vozila će biti otkrivena na nekoliko sekundi."

msgid "comp7Core15Status"
msgstr "Komunikacijski centar"

msgid "comp7Core16"
msgstr "Točke interesa na mapi. Osvajanje ovog položaja će vam omogućiti korištenje Taktičke vještine naziva Topnički udar. Kada je uključena, igrač može odabrati područje udara topničkom baražom."

msgid "comp7Core16Status"
msgstr "Stožer topništva"

msgid "comp7Core17"
msgstr "Ako Taktička vještina Topnički udar pogodi saveznika, neće biti oštećeni. Međutim, biti će ošamućeni."

msgid "comp7Core17Status"
msgstr "Topnički udar"

msgid "comp7Core18"
msgstr "Imajte na umu: mape u ovom režimu se mogu razlikovati od njihovih pandana u slučajnim bitkama."

msgid "comp7Core18Status"
msgstr "Mape u akciji"

msgid "comp7Core19"
msgstr "Stvaranje voda od 7 igrača može povećati vašu vjerojatnost pobjede."

msgid "comp7Core19Status"
msgstr "Timska igra je ključna"

msgid "comp7Core21"
msgstr "Možete provjeriti razinu naboja vještina uloga vaših saveznika pritiskom na tipke Tab ili Alt."

msgid "comp7Core21Status"
msgstr "Savezničke vještine uloga"

msgid "comp7Core22"
msgstr "Možete provjeriti timski spisak i vidjeti da li su vaši saveznici stekli neke Taktičke vještine. Neprijateljske Taktičke vještine se ne prikazuju."

msgid "comp7Core22Status"
msgstr "Taktičke vještine"

msgid "comp7Core23"
msgstr "Ako vještina uloga utječe na vozilo, iznad oznake igrača će biti prikazana odgovarajuća ikona."

msgid "comp7Core23Status"
msgstr "Učinci vještine uloga"

msgid "comp7Core24"
msgstr "Tipka H (zadano) uključuje glasovni razgovor. Koristite ovu mogućnost za učinkovitiju komunikaciju s vašim timom."

msgid "comp7Core24Status"
msgstr "Glasovni razgovor"

msgid "comp7Core25"
msgstr "Ako imate problema s glasovnim razgovorom, provjerite postavke u klijentu igre."

msgid "comp7Core25Status"
msgstr "Glasovni razgovor"

msgid "comp7Core29"
msgstr "Pritiskom na Alt, uloga bilo kojeg vozila unutar vašeg vidokruga će biti prikazana iznad oznake igrača. Za savezničke igrače ćete vidjeti i njihovu razinu naboja vještine uloga."

msgid "comp7Core29Status"
msgstr "Uloge vozila"

msgid "comp7Core31"
msgstr "Možete preraspodjeliti kratice za uloge i Taktičke vještine u postavkama igre."

msgid "comp7Core31Status"
msgstr "Postavke upravljanja"

msgid "comp7Core32"
msgstr "Nakon određenog vremena ćete moći ponovno osvojiti točke interesa."

msgid "comp7Core32Status"
msgstr "O točkama interesa"

msgid "comp7Core33"
msgstr "Ne možete osvojiti točke interesa dok ne iskoristite odgovarajuću Taktičku vještinu."

msgid "comp7Core33Status"
msgstr "O točkama interesa"

msgid "comp7Core34"
msgstr "Osvajanje točaka interesa vam donosi određeni broj bodova Prestiža."

msgid "comp7Core34Status"
msgstr "O točkama interesa"

msgid "comp7Core35"
msgstr "Pogledajte pravila akcije kako bi saznali više o bodovima Prestiža."

msgid "comp7Core35Status"
msgstr "O bodovima Prestiža"

msgid "comp7Core37"
msgstr "Režim ima modifikatore koji mijenjaju određene parametre vozila, kao što je HP vozila, vrijeme hlađenja potrošnog materijala, preostalo vrijeme vidljivosti i više."

msgid "comp7Core37Status"
msgstr "Modifikatori Navale"

msgid "comp7Core5"
msgstr "Ovisno o ulozi, svako vozilo ima posebnu vještinu s tri razine naboja. Što je razina naboja veća kada je vještina aktivirana, to je jači učinak."

msgid "comp7Core5Status"
msgstr "O vještinama uloga"

msgid "comp7Core6"
msgstr "Bodovi Prestiža se mogu osvojiti za dojmljivu izvedbu u bitci, osvajanje točaka interesa, korištenje vještina, itd."

msgid "comp7Core6Status"
msgstr "O bodovima Prestiža"

msgid "comp7Core8"
msgstr "Igrači neće imati informacije o vozilima svojih protivnika dok nisu opaženi."

msgid "comp7Core8Status"
msgstr "Magla rata"

msgid "comp7Light7"
msgstr "You can learn more about Onslaught Light by clicking the ABOUT THE EVENT button on the event screen."

msgid "comp7Light7Status"
msgstr "Detalji režima"

msgid "comp7Light9"
msgstr "Sa zbirkom vozila razine VIII u različitim ulogama, uvijek možete odabrati najbolje vozilo za bilo koju bitku i usput se prilagoditi i savezničkim vozilima."

msgid "comp7Light9Status"
msgstr "Povećaj Garažu"

msgid "comp7NightMaps38"
msgstr "Noćne mape osvježavaju poznata bojišta s noćnim uvjetima, novim osmatračkim položajima, ažuriranim točkama interesa i izmjenjenom mehanikom otkrivanja."

msgid "comp7NightMaps38Status"
msgstr "NOĆNE MAPE"

msgid "comp7Ranked0"
msgstr "Borite se za bodove rejtinga za dosizanje najvišeg ranga i dokažite svoju nadmoć."

msgid "comp7Ranked0Status"
msgstr "Sustav rangiranja"

msgid "comp7Ranked1"
msgstr "Što više bodova Prestiža zaradite u bitci, to ćete više bodova rejtinga dobiti za pobjedu, a manje ćete izgubiti za poraz."

msgid "comp7Ranked1Status"
msgstr "Bodovi Prestiža i bodovi rejtinga"

msgid "comp7Ranked2"
msgstr "U Navali, bitke se uparuju od igrača sličnog ranga."

msgid "comp7Ranked20"
msgstr "Napuštanje bitke prije kraja stavlja vaše saveznike u nepovoljan položaj. To će rezultirati u privremenoj blokadi i oduzimanju bodova rejtinga."

msgid "comp7Ranked20Status"
msgstr "Dezertiranje"

msgid "comp7Ranked26"
msgstr "Samo igrači ranga Šampion i Legenda su prikazani na tablici. Svi igrači koji se pojave na tablici će primiti dnevne nagrade."

msgid "comp7Ranked26Status"
msgstr "Ljestvica"

msgid "comp7Ranked27"
msgstr "Dezerterima će se privremeno blokirati sudjelovanje u režimu igre. Trajanje blokiranja će se povećati za svaki slijedeći pristup."

msgid "comp7Ranked27Status"
msgstr "Privremena blokada"

msgid "comp7Ranked28"
msgstr "Borite se u režimu igre kako bi otključali nove elemente progresivnog stila Navale."

msgid "comp7Ranked28Status"
msgstr "Progresivni stil"

msgid "comp7Ranked2Status"
msgstr "Zaslužni igrači"

msgid "comp7Ranked3"
msgstr "Rang Legenda se dodjeljuje samo najboljima od najboljih. Kako bi dosegli ovaj rang, morate biti u najboljih 10% igrača na tablici po zarađenim bodovima rejtinga."

msgid "comp7Ranked36"
msgstr "Imajte na umu: ako napustite bitku prije kraja, izgubit ćete više bodova rejtinga nego da ste doživjeli strašan poraz."

msgid "comp7Ranked36Status"
msgstr "Dezertiranje"

msgid "comp7Ranked3Status"
msgstr "Legenda"

msgid "comp7Ranked4"
msgstr "Ako prestanete igrati u ovom režimu, izgubit ćete bodove rejtinga. Ovo pravilo se odnosi na rangove Srebro, Zlato, Šampion i Legenda."

msgid "comp7Ranked4Status"
msgstr "Neaktivnost ranga"

msgid "comp7Ranked7"
msgstr "Možete saznati više o Navali klikom na gumb O AKCIJI na ekranu akcije."

msgid "comp7Ranked7Status"
msgstr "Detalji režima"

msgid "comp7Ranked9"
msgstr "Sa zbirkom vozila razine X u različitim ulogama, uvijek možete odabrati najbolje vozilo za bilo koju bitku i usput se prilagoditi i savezničkim vozilima."

msgid "comp7Ranked9Status"
msgstr "Povećaj Garažu"

msgid "devMaps0"
msgstr "Mjesto nasumičnog događaja će biti označeno\ndimom na mapi i oznakom na minimapi.\nMape s nasumičnim događajima se mogu isključiti u postavkama u kartici Igra."

msgid "devMaps0Status"
msgstr "Mape s nasumičnim događajima"

msgid "devMaps1"
msgstr "Vaše vozilo može biti uništeno u području nasumičnog događaja (primjerice, tijekom pada aviona).\nMape s nasumičnim događajima se mogu isključiti u postavkama u kartici Igra."

msgid "devMaps1Status"
msgstr "Mape s nasumičnim događajima"

msgid "dualGunVehicles"
msgstr "Vozila sa sustavom dvostruke topovske cijevi"

msgid "epicModeHiddenFeatures"
msgstr "Veteran Bojišnice"

msgid "epicModeIntroduction"
msgstr "Svojstva režima"

msgid "epicModeUseful"
msgstr "Učenje Bojišnice"

msgid "epicRandom0"
msgstr "Možete doživjeti manje probleme s izvedbom u ovom tipu bitke."

msgid "epicTip1"
msgstr "Kada je baza osvojena, sva vozila tima branitelja koja su ostala u zoni su meta bombardiranja."

msgid "epicTip10"
msgstr "Pored slave i priznanja, rangovi vam daju korisne bonuse nakon svake bitke."

msgid "epicTip11"
msgstr "Bojišnica uključuje puno novih način za zaradu iskustva i kredita."

msgid "epicTip12"
msgstr "Bojišnica se može pomaknuti potiskivanjem drugog tima. Na ovaj način se možete oživiti bliže vašem cilju."

msgid "epicTip13"
msgstr "Kada vozilo unutar kruga osvajanja pretrpi štetu, napredak osvajanja tog vozila se blokira na određeno vrijeme."

msgid "epicTip14"
msgstr "Aktivirajte i povećajte borbene pričuve na posebnom ekranu. Iskoristite ih za razaranje na bojištu."

msgid "epicTip15"
msgstr "Uvijek možete promijeniti bojišnice na ekranu oživaljvanja ako strateška situacija tako nalaže."

msgid "epicTip16"
msgstr "Nemojte ulaziti u zaštićene zone. Neprijateljsko topništvo će početi pucati na vas."

msgid "epicTip17"
msgstr "Zapeli ste negdje na mapi? Koristite funkcionalnost napuštanja (zadano tipka J) kako bi napustili svoje vozilo i počeli iznova."

msgid "epicTip18"
msgstr "Otvorite veliku verziju minimape (zadano tipka M) za bolji pregled bojišta."

msgid "epicTip19"
msgstr "Dobit ćete poruke od saveznika koji su vidljivi na vašoj minimapi."

msgid "epicTip2"
msgstr "Bojišnica nudi mnogo odličnih nagrada ako želite dodatno zaraditi."

msgid "epicTip20"
msgstr "Možete podesiti vidljivo područje vaše minimape kotačićem viša dok ste iznad nje."

msgid "epicTip21"
msgstr "Možete istaknuti baze ili ciljeve suigračima klikanjem na njih na minimapi."

msgid "epicTip22"
msgstr "Kada vam ponestane tenkove, isprobajte režim slobodne kamere. Na ovaj način možete planirati strategiju dok se ne vratite u bitku."

msgid "epicTip23"
msgstr "Kada se osvaja baza i kada ističe vrijeme, susret ulazi u produžetak. Bitka će nastaviti dok sve baze nisu očišćene."

msgid "epicTip3"
msgstr "U režimu Bojišnice bojište je površine 9 km² što je devet puta veće od bilo koje standardne mape."

msgid "epicTip4"
msgstr "Vrijeme bitke se produžuje svaki put kada je zona osvojena. Posljednja zona daje dodatno vrijeme."

msgid "epicTip5"
msgstr "Ako je vaše vozilo uništeno u bitci, potrebno je neko vrijeme da se popravi. Odaberite drugo vozilo i vratite se u bitku."

msgid "epicTip6"
msgstr "Jedno dodatno vozilo se isporučuje u vaše pričuve svakih pet minuta."

msgid "epicTip7"
msgstr "Napadači mogu ući u zonu druge linije tek kada je zauzeta zona u prvoj linije iste fronte."

msgid "epicTip8"
msgstr "Kada su osvojene sve zone u prvoj liniji sve zone u drugoj liniji su oslabljene."

msgid "epicTip9"
msgstr "Moguće je pobijediti u bitci eliminiranjem protivničkog tima, ali je KRAJNJE nesigurno."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Slijedi pravila"

msgid "howToPlay"
msgstr "Kako igrati"

msgid "mapbox0"
msgstr "Vozila unutar lokalne vremenske zone ne mogu opaziti vozila izvan zone i obrnuto ili razmijeniti informacije o položajima neprijateljskih vozila izvan zone. Vatra oštećuje vozila."

msgid "mapbox0Status"
msgstr "Lokalno vrijeme"

msgid "payAttention"
msgstr "Pazi"

msgid "ranked1"
msgstr "Dobijate više iskustva za sukladnost s ulogom vašeg vozila! Opisi uloga vozila i njihove odgovarajuće akcije su dostupne u Garaži na informativnoj stranici O režimima."

msgid "ranked10"
msgstr "Za vaše probijanje kroz napredak rangiranih bitaka ćete moći kupiti jedinstvena vozila i elemente prilagodbe obveznicama (uključujući i ona na popustu). Za pregled spiska ovih predmeta, kliknite na banner.\nNe možete pristupiti predmetima ili popustima van sezone."

msgid "ranked11"
msgstr "Dnevni bonusi su dostupni samo u Ligama. Oni se dobijaju na osnovi rezultata kvalifikacija i za izvršenje posebnih zadataka. Dnevne bonus bitke se ne prenose u slijedeći dan."

msgid "ranked12"
msgstr "Na kraju godine najučinkovitiji igrači će se plasirati na tablicu. Dobit će dodatnu značku i ostvariti slavu i poštovanje zajednice."

msgid "ranked13"
msgstr "Neki rangovi su stalni. Kada se taj rang dobije ne može se izgubiti. Stalni rangovi srednjih etapa su dodatno označeni. Svi početni rangovi svake divizije su također stalni i ne mogu se izgubiti."

msgid "ranked2"
msgstr "Dobijate bitke standardnog i dnevnog bonusa za dosizanje slijedećih divizija i liga. Bitka bonusa automatski udvostručuje primljene ševrone u bitci i ne troši se u slučaju neuspjeha. Samo jedna bitka bonusa dnevno je dostupna za svako vozilo razine X."

msgid "ranked3"
msgstr "Pazite na udarni termin: jednom kad istekne rangirane bitke su nedostupne do slijedećeg dana i primit ćete odgovarajuću obavijest."

msgid "ranked4"
msgstr "Neki rangovi imaju tzv. štitove. Kada izgubite na takvom rangu, oslabljujete štit bez gubitka ranga. Ako štit ranga nije potpuno istrošen, primitak ševrona na rangu sa štitom potpuno oporavlja štit."

msgid "ranked5"
msgstr "Ne predajte se! Ševron se ne dodjeljuje samo najboljima 7 u pobjedničkom timu već i najboljem igraču u gubitničkom timu. Upamtite kako će svaki ševron primljen u bitci bonusa biti udvostručen."

msgid "ranked6"
msgstr "Nakon završetka svih divizija, igrači dosežu jednu od tri liga: zlatnu, srebrnu ili brončanu. Nastavljaju se boriti i rezultati njihovih bitaka utječu na izvedbu i određuju njihov položaj na tablici."

msgid "ranked7"
msgstr "Igrači dobijaju token ranga za svaku završenu diviziju. Igrači koji ispolje najbolju izvedbu kroz tri sezone će primiti zasluženu završnu nagradu."

msgid "ranked8"
msgstr "Na kraju sezone najbolji igrači će dobiti jedinstvenu značku i stil za vozila. Te nagrade predstavljaju oznake ponosa za igrače-simbol njihova nedostižna majstorstva."

msgid "ranked9"
msgstr "Dobijate obveznice za vaš uspjeh u rangiranim bitkama. Obveznice se mogu razmjeniti za smjernice i poboljšanu opremu. K tome, ima i ostalih vrijednih nagrada: krediti, potrošni materijal, itd."

msgid "rankedStatus1"
msgstr "Iskustvo za sukladnost s ulogom vozila"

msgid "rankedStatus10"
msgstr "Predmeti rangiranih bitaka"

msgid "rankedStatus11"
msgstr "Dnevne bonus bitke"

msgid "rankedStatus12"
msgstr "Najbolji igrači godine"

msgid "rankedStatus13"
msgstr "Pravila režima"

msgid "rankedStatus2"
msgstr "Bitke bonusa"

msgid "rankedStatus3"
msgstr "Udarni termin"

msgid "rankedStatus4"
msgstr "Pravila režima"

msgid "rankedStatus5"
msgstr "Pravila režima"

msgid "rankedStatus6"
msgstr "Bitaka u ligama"

msgid "rankedStatus7"
msgstr "Godišnje nagrade"

msgid "rankedStatus8"
msgstr "Nagrade za kraj sezone"

msgid "rankedStatus9"
msgstr "Nagrade za rangove"

msgid "security"
msgstr "Sigurnost iznad svega"

msgid "technicalAdvice"
msgstr "Tehnički savjet"

msgid "tip0"
msgstr "Blatnjav teren značajno umanjuje brzinu i okretanje vozila."

msgid "tip100"
msgstr "Učinkovitost člana posade utječe na odgovarajuće karakteristike vozila."

msgid "tip101"
msgstr "Osobina Šesto čulo omogućava zapovjedniku identifikaciju je li vozilo otkriveno od strane neprijatelja."

msgid "tip102"
msgstr "Učinkovitost sposobnosti je parametar koji određuje učinkovitost svih sposobnosti koje je izučio član posade."

msgid "tip103"
msgstr "Kvalifikaciju člana posade možete promjeniti prilikom njihove preobuke."

msgid "tip106"
msgstr "Oprema poboljšava učinkovitost posade i karakteristike vozila."

msgid "tip107"
msgstr "Vozila sa svim istraženim modulima i sljedećim vozilima stječe elitni status."

msgid "tip108"
msgstr "Borbeno iskustvo stečeno na elitnim vozilima, uključujuči premium vozila, se može pretvoriti u slobodno iskustvo."

msgid "tip11"
msgstr "Koristite grmlje i raslinje kako bi učinili vašeg lovca na tenkove teže vidljivim. Obratite pažnju da su nepokretna vozila manje vidljiva."

msgid "tip111"
msgstr "Ponekad je zauzimanje baze lakša i sigurnija opcija nego uništavanje svih neprijateljskih vozila."

msgid "tip114"
msgstr "Dijeljenje korisničkog računa krši pravila igre i može uzrokovati gubitak pristupa korisničkom računu."

msgid "tip115"
msgstr "Pravila igre zabranjuju dijeljenje korisničkih računa. Prekršitelji mogu izgubiti oba korisnička računa zauvijek."

msgid "tip116"
msgstr "Što je zaporka složenija, tim bolje."

msgid "tip117"
msgstr "Redovito mijenjajte vašu zaporku."

msgid "tip118"
msgstr "Pravila igre zabranjuju kupnju i prodaju korisničkih računa. Ako prekršite ova pravila možete izgubiti vaš korisnički račun."

msgid "tip119"
msgstr "Nemojte slijediti linkove na nepoznate stranice. Izlažete se riziku prevare ili hakiranja."

msgid "tip120"
msgstr "Samo na službenoj World of Tanks stranici možete kupiti zlato. Ako pokušate kupiti zlato na drugim stranicama, izlažete se riziku gubitka novca."

msgid "tip121"
msgstr "Opcija spremanja zaporke je prikladna, ali potencijalno nesigurna."

msgid "tip122"
msgstr "Na portalu možete naći upute kako održati korisnički račun sigurnim. Pročitajte ih pažljivo."

msgid "tip123"
msgstr "U bitci pritisnite CTRL kako bi prikazali kursor miša."

msgid "tip124"
msgstr "Za popravku modula koristite alat za popravke, a za liječenje člana posade pribor za prvu pomoć."

msgid "tip125"
msgstr "Za korištenje potrošnog materijala i biranje tipova granate koristite prečace tipaka (zadano 1-6)."

msgid "tip126"
msgstr "U topničkom režimu za trenutno pomicanje kamere kliknite desnim gumbom miša na minimapu."

msgid "tip127"
msgstr "Pritisnite CTRL+TAB za promjenu prikaza spiska timova."

msgid "tip128"
msgstr "Pritisnite desnim gumbom miša na ime igrača na panelima timova kako bi vidjeli moguće akcije."

msgid "tip129"
msgstr "Pritisnite desnim gumbom miša na ime igrača na panelima timova kako bi se požalili na igrača u odgovarajućem kontekstualnom izborniku."

msgid "tip130"
msgstr "Skup dostupnih naredbi u izborniku naredbi se mijenja ovisno o tome da li je kursor na značajki terena, savezniku, neprijatelju ili objektu."

msgid "tip131"
msgstr "Kako bi odabrali naredbu u izborniku naredbi, držite T ili Z i pomaknite miša kako bi istakli željenu naredbu."

msgid "tip132"
msgstr "Koristite prečice F2-F8 kako bi brzo odabrali naredbe u izborniku naredbi."

msgid "tip134"
