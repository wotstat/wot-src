msgid "tip185"
msgstr "Laka vozila s kotačima imaju najviše dinamičke karakteristike koje im omogućavaju da budu prvi zauzimanju povoljnog položaja ili pronalazak sigurne zaštite od neprijateljske paljbe."

msgid "tip186"
