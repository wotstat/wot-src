msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Razvijen od strane Osaka Artillery Arsenal kao zamjena za Type 2589. Chi-Ni i Chi-Ha su zajedno prošli testiranja 1937. Chi-Ha se pokazao kao uspješniji. Izrađen je jedan prototip."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Srednji tenk Type 3 Chi-Nu-Kai je kombinacija Type 3 Chi-Nu ovjesa i oklopa i Type 4 Chi-To topa. Izrađen je samo jedan prototip koji je bio spreman za testiranje u ožujku 1945."

msgid "Chi_Nu_Kai_long_special"
msgstr "Ovo je standardni srednji tenk koji nema neke značajne prednosti ili mane. Pgodan je za bilo koju borbenu situaciju i cijenit će ga igrači koji vole igru bez prekida."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Visoka preciznost, probojnost, dobar oklop blende topa"

msgid "Continental_AOSI_1195_6"
msgstr "Continental AOSI-1195-6"

