msgstr "Zahtjevi za lakim zračno pokretnim tenkom su stvoreni u zimu 1941. Vozilo je razvijeno u tvrtci Marmon-Herrington. Od travnja 1943. do veljače 1944. je izrađeno 830 vozila od kojih su 260 predana Velikoj Britaniji unutar Zakona o zajmu i najmu."

msgid "M22_Locust_long_special"
msgstr "Iznimno dinamičan i skriveni izviđač s dobrim topom. Vozilo praktički nema mana osim malog kapaciteta streljiva."

msgid "M22_Locust_short"
msgstr "Locust"

msgid "M22_Locust_short_special"
msgstr "Odlična brzina i dinamika, dobra skrivenost"

