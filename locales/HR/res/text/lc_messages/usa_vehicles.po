msgid "M7_Priest_descr"
msgstr "Temeljen na šasijama tenkova M3 i M4, proizvodio se od travnja 1942. do veljače 1945. Ukupno je proizvedeno 4316 vozila. Prvi put se koristio u bitci kod El Alameina."

msgid "M7_med"
