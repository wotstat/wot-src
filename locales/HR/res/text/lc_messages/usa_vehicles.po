msgid "T23E3_long_special"
msgstr "T23E3 je solidan tenk podrške učinkovit u svakoj borbenoj situaciji. Pristojni kutevi elevacije/depresije topa i brzina paljbe osiguravaju učinkovitu borbu korištenjem nepravilnosti terena dok dobar vidokrug učinkovito otkriva neprijatelja."

msgid "T23E3_short_special"
msgstr "Dobra brzina paljbe, preceiznost i vidokrug"

msgid "T23T80"
msgstr "T23T80"

msgid "T23_descr"
msgstr "Eksperimentalni srednji tenk razvijan je od kraja 1942. do ljeta 1944. T23T80 nije se serijski proizvodio niti je korišten u borbi."

msgid "T25_2_SH"
msgstr "Gavran"

msgid "T25_2_SH_descr"
msgstr "Ovo vozilo savršeno uravnotežuje moderno i klasično. Dokazane tehnologije u kombinaciji s najnovijim napretcima su služile kao osnova ovog tenka kojeg je pravo zadovoljstvo voziti-sve dok vam ne smeta hrđavi metal, naravno."

msgid "T25_2_SH_short"
