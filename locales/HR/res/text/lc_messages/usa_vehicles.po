msgid "T26_E4_SuperPershing_descr"
msgstr "U srvhu povećanja vatrene moći, novi dugi 90mm top je montiran na T26E1 u siječnju 1945. Prototip je označen kao T26E4. Razvoj je prekinut u siječnju 1947. zbog problema s topom i mehanizmom punjenja. U tom periodu je izrađeno ukupno 25 vozila, ali nikad nisu ušli u upotrebu."

msgid "T26_E4_SuperPershing_long_special"
msgstr "Ovo vozilo ima odličan prednji oklop (i zaštitne ploče!) koje odbijaju mnoge hice i uzvraća topom koji je odličan za njegovu razinu. Vozilo je prosječne pokretljivosti tako da smjer napada morate odabrati mudro."

msgid "T26_E4_SuperPershing_short"
msgstr "T26E4"

msgid "T26_E4_SuperPershing_short_special"
msgstr "Precizan top, odličan prednji oklop"

