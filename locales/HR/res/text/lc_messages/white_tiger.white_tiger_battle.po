msgstr "Počistite sve generatore!"

msgid "battleHints/wtOvertime_header"
msgstr "PRODUŽETAK"

msgid "battleHints/wtOvertime_hunters"
msgstr "Zauzmi bilo koji generator!"

msgid "battleTimer/overtime/messageText"
msgstr "Produžetak!"

msgid "battleTimer/timeRemaining/boss/messageText"
msgstr "Vrijeme je na vašoj strani!"

msgid "battleTimer/timeRemaining/hunter/messageText"
msgstr "Vrijeme istječe!"

msgid "botNames/Ermelinda"
msgstr "Ermelinda"

msgid "efficiencyRibbons/damageCircuitOverload"
msgstr "Šteta od kratkog spoja"

msgid "efficiencyRibbons/damageHyperion"
msgstr "Šteta od Hyperiona"

msgid "hunterRespawn/hintText"
msgstr "Odaberite točku oživljavanja ili će vam jedna biti automatski odabrana"

msgid "hunterRespawn/timerText"
msgstr "Vrijeme za povratak u bitku..."

msgid "loading/boss/hint1"
msgstr "1. Preživjeti u bitci što je dulje moguće. Ako vas goniči ne uspiju uništiti, pobjedili ste."

msgid "loading/boss/hint2"
msgstr "2. Uklonite neprijatelje za micanje njihovih naboja plazme i bonusa na vatrenu moć. Prvo uklonite najmoćnijeg neprijatelja!"

msgid "loading/boss/hint3"
msgstr "3. Punite svoje Hyperion superoružje nanoseći štetu goničima. Ispalite ga za nanošenje goleme štete na velikom području."

msgid "loading/boss/hint4"
msgstr "4. Podržavat će vas sama Ermelinda. Ona može privremeno blokirati generatore dok njena energetska aura daje vama i Stražarim brže punjenje i dovoljno energije za vaš onesposobljeni EMP."

msgid "loading/hunter/hint1"
msgstr "1. Uništite Blitzträger prije isteka vremena! Preopteretite generatore za privremeno spuštanje njegovog štita."

msgid "loading/hunter/hint2"
msgstr "2. Sa svakim preopterećnim generatorom, goniči prikupljaju plazmu i stiču značajno pojačanje vatrene moći. Bonus se poništava nakon uništenja."

msgid "loading/hunter/hint3"
msgstr "3. Pazite se moćnog superoružja Hyperion. Blitzträger ga puni nanošenjem štete goničima."

msgid "loading/hunter/hint4"
msgstr "4. Pazite se nagle smetnje od Ermelindinog novog tenka. Ona može privremeno blokirati generatore, dati pojašanu energiju saveznicima i koristiti Blitzträger tehnologiju."

msgid "minimap/respawnEntry/hintText"
msgstr "Počet ćete ovdje"

msgid "pbt/defeat/1/1"
msgstr "Starac je danas izgubio. Električna inteligencija nije."

msgid "pbt/defeat/2/3"
msgstr "Isteklo vrijeme, istekle opcije. Očekivano. Pokušaj opet."

msgid "pbt/victory/1/3"
msgstr "Sat kaže da je vrijeme isteklo, goniči. Kao i evolucija."

msgid "pbt/victory/2/1"
msgstr "Goniči, pobjedili ste. Električna Inteligencija vam zahvaljuje."

