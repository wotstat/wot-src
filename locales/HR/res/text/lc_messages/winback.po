msgid "dailyQuestsIntroView/info/mode/description"
msgstr "Zagrijavanje će vas podsjetiti na osnove igre. Bitke se igraju protiv vozila kojima upravlja AI i rezultati se ne računaju u vašoj statistici. Možete napustiti Zagrijavanje bilo kada i nastaviti sa slučajnim bitkama."

msgid "dailyQuestsIntroView/info/mode/title"
msgstr "Zagrijavanje"

msgid "dailyQuestsIntroView/info/quests/description"
msgstr "Izvršite zadatke, završite etape napretka Nazad u akciju i primite vrijedne nagrade u igri. Svaki izvršeni standardni, premium ili bonus zadatak se računa kao napredak prema nagradi. Zadaci se mogu izvršiti u Zagrijavanju ili slučajnim bitkama."

msgid "dailyQuestsIntroView/info/quests/descriptionBP"
msgstr "Izvršite zadatke, završite etape napretka Nazad u akciju i primite vrijedne nagrade u igri. Tijekom Borbene propusnice, bodovi Borbene propusnice će se dodati u fond nagrada. Zadaci se mogu izvršiti u Zagrijavanju ili slučajnim bitkama."

msgid "dailyQuestsIntroView/info/quests/title"
msgstr "Nazad u stroj"

msgid "dailyQuestsIntroView/info/rewards/description"
msgstr "Kao nagradu možete osvojiti premium vozilo najma razine VIII, vozilo razine VI koje se može istražiti i popuste na istraživanje i kupnju vozila. Nakon završetka napretka ćete primiti glavnu nagradu."

