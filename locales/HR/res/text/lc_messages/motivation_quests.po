msgid "common/congratulation"
msgstr "Čestitamo! Izvršili ste zadatak i dobili sljedeće nagrade"

msgid "common/requirements"
msgstr "Dostupno za izvršenje u vozilima razine IV ili višoj."

msgid "g1/advice"
msgstr "Možete pobjediti u bitci uništenjem svih neprijateljskih vozila ili zauzimanjem neprijateljske baze. Budite oprezni i ne jurite naprijed. Suradnja s vašim saveznicima je ključ za izbjegavanje uništenja."

msgid "g1/description"
msgstr "Ispunjenje uvjeta za tri bitke zaredom je neobavezan."

msgid "g1/name"
msgstr "Dani rata"

msgid "g10/advice"
msgstr "Možete nanijeti ogromnu štetu neovisno o tipu vašeg vozila. Odaberite mete koje možete pogoditi bez promašaja, pokušajte preživjeti što je duže moguće i biti ćete ugodno iznenađeni linjom \"Nanesena šteta\" na ekranu rezultata bitke."

msgid "g10/description"
msgstr "Ispunjenje uvjeta za dvije bitke zaredom je neobavezan."

msgid "g10/name"
msgstr "Uzor: Šteta"

msgid "g2/advice"
msgstr "Teški tenkovi imaju moćne topove i čvrst prednji oklop koji je teško probiti. Međutim, ova prednost je izjednačena sa slabom pokretljivišću pa ih je lako obuhvatiti i pogoditi slabe točke straga ili sa boka."

msgid "g2/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g2/name"
msgstr "Usred mete: teški tenkovi"

msgid "g3/advice"
msgstr "Srednji tenkovi su svestrane jedinice koje ispunjavaju širok krug zadataka na bojišnici; od pokrivanja glavne udarne snage do obuhvatnih napada. Ne dopustite da vas obuhvate dok vam se približavaju."

msgid "g3/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g3/name"
msgstr "Usred mete: srednji tenkovi"

msgid "g4/advice"
msgstr "Laki tenkovi imaju slab oklop i topove, ali to nadoknađuju izvrsnom brzinom i skrivenošću. Prvenstveni zadatak lakih tenkova je otkrivanje neprijatelja i odvraćanje njihove pažnje."

msgid "g4/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g4/name"
msgstr "Usred mete: laki tenkovi"

msgid "g5/advice"
msgstr "Lovci na tenkove su zastrašujući protivnici s teškim naoružanjem i odličnim skrivanjem, ali su uglavnom osrednje pokretljivosti. Pokušajte ih otkriti i uništiti što je prije moguće."

msgid "g5/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g5/name"
msgstr "Usred mete: lovci na tenkove"

msgid "g6/advice"
msgstr "Što je manje preostalo neprijateljskih vozila, to ste bliže pobjedi. Djelujte mudro, pokušajte preživjeti i nanesite što je više moguće štete. Koristite teren za paljbu bez vlastitog otkrivanja."

msgid "g6/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g6/name"
msgstr "Izgradnja kolekcije"

msgid "g7/advice"
msgstr "Svako vozilo ima unutarnje i vanjske module i posadu. Kritični pogoci značajno smanjuju borbenu učinkovitost neprijatelja. Proučite slabe točke vozila kako bi bili učinkovitiji u nanošenju kritične štete neprijatelju i što bolje sakrili ranjive točke vlastitog vozila."

msgid "g7/description"
msgstr "Postignuti rezulati u svim bitkama u bilo kojem vozilu se zbrajaju."

msgid "g7/name"
msgstr "Probijajući hici"

msgid "g8/advice"
msgstr "Jedan način za pobjedu je zauzimanje neprijateljske baze. Kada su neprijateljski tenkovi usredotočeni na žestoku borbu možete se provući pored njih i zauzeti bazu. Upamtite da je zauzimanje baze veće što je više voizla unutar kruga baze. Najveća brzina zauzimanja se postiže s tri kruga unutar kruga baze."

msgid "g8/name"
msgstr "Plan B"

msgid "g9/advice"
msgstr "Zarađujete iskustvo za otkrivanje, nanošenje štete i uništenje neprijateljskih vozila, zauzimanje neprijateljske baze, obranu vlastite baze i pobjedu u bitci."

msgid "g9/description"
msgstr "Ispunjenje uvjeta za dvije bitke zaredom je neobavezan."

msgid "g9/name"
msgstr "Uzor: iskustvo"

msgid "group"
msgstr "Obuka novaka"
