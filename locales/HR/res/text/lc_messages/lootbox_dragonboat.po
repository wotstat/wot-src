msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Kutije Zmajskog broda"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "KUTIJE ZMAJSKOG BRODA"

msgid "entryPoint/tooltip/description"
msgstr "Ovo su posebne kutije koje sadrže jedinstvene i vrijedne predmete u igri.\nMožete dobiti ove kutije u prodavaonici u igri ili u premium prodavaonici."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kutije Zmajskog broda su privremeno nedostupne"

msgid "eventName/lowerCase"
msgstr "Ukrotite zmaja, jašite vjetar"

msgid "eventName/upperCase"
msgstr "UKROTITE ZMAJA, JAŠITE VJETAR"

msgid "infoPage/footer/description/compensation"
msgstr "Ako već imate sva vozila sa spiska mogućeg sadržaja kutije, sva slijedeća vozila koja dobijete iz kutija Zmajskog broda će biti kompenzirana zlatom jednakom njihovoj vrijednosti."

msgid "infoPage/footer/description/guaranteed"
msgstr "Svaka %(guaranteed0)s kutija Zmajskog broda jamačno sadrži vozilo razine VIII-IX. Ako ih otvorite bez primitka takvog vozila, tada će vozilo razine VIII-IX koje još nemate biti primljeno kada otvorite %(guaranteed0)s&zwnbsp;. kutiju Zmajskog broda. Kada primite, brojač se poništava."

msgid "noBoxesView/description/"
msgstr "Nemate nijednu kutiju.\nMožete ih uzeti u prodavaonici u igri."
