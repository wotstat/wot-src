msgid "alert"
msgstr "Ne možete odabrati borbenu pričuvu tijekom aktivne borbe."

msgid "description/one/reserve"
msgstr "Opetovano biranje %(reserve_name)spričuve\n će poboljšati njene karakteristike."

msgid "description/second/reserve"
msgstr "Opetovano biranje %(first_reserve_name)s ili %(second_reserve_name)spričuve\n će poboljšati karakteristike one koja je odabrana."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Polaže aktivno minsko polje u odabranom području na određeno vrijeme."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Nanosi značajnu štetu neprijateljskim vozilima unutar malog polumjera."

msgid "shortDescription/reserve/bomberAbility"
