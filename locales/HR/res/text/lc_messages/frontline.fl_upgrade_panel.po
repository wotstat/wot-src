msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Obnavlja određeni postotak HP vašeg vozila."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Skriva sva vozila unutar i iza dima."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Daje bonus na skrovitost i vidokrug. Umanjuje skrovitost neprijateljskih vozila."

