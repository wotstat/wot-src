msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Započnite slučajnu bitku u vozilu bilo koje razine."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Dobrodošli u igru! Borite se protiv drugih fanova širom svijeta i proslavite spektakularne pobjede!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Prva bitka"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Istražite i kupite bilo koje vozilo razine IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Kupnja novog vozila je važan događaj. Sa svakom novom razinom, vozila su sve zanimljivija. Obučena posada će također poboljšati sveukupnu igru."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Vozilo razine IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Odigrajte tri slučajne bitke u vozilima razine IV-X s bilo kojim nanesenim elementom prilagodbe."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Možete prilagoditi vozila promjenom njihove vanjštine s unaprijed određenim stilovima ili stvaranjem vlastitog korištenjem kamuflaže, natpisa, amblema i naljepnica."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Vanjština vozila"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Počnite obuku bilo koje sposobnosti za bilo kojeg člana posada."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Članovi posade mogu obučiti dodatne sposobnosti za poboljšanje njihove učinkovitosti ili stjecanje novih mogućnosti."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Sposobnosti posade"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Osvojite 150 000 kredita u slučajnim bitkama u vozilima razine IV-X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Što je viša razina bitke, to će vam trebati više kredita za održavanje vozila, dopunu streljiva i kupnju modula i opreme."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Skupljanje kredita"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Istraživanje i kupnja bilo kojeg vozila razine V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Na razini V se počinju pojavljivati ozbiljna vozila, i gdje se vaše vještine uistinu ispituju. Potpuno obučena posada će stvarno dobro doći."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Vozilo razine V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u vozilima razine V-X s tri montirana komada opreme."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Obložena optika ili Poboljšano provjetravanje? Ispravna oprema može istaknuti jake strane vašeg vozila i potisnuti njegove mane."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montiranje opreme"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Završite jedan osnovni scenarij u režimu Topografije."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Kako bi stekli samopouzdanje na bojištu, najbolje je da dobro razumijete puteve, taktike i mape, uključujući ključne položaja i objekte na njima."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografija"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Završite četiri napredna scenarija na jednoj mapi u Topografiji."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Uđite povremeno u režim Topografije kako bi proučili mape za slučajne bitke. Četiri scenarija vam omogućuju istraživanje lokacija iz različitih kuteva."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Napredna topografija"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u vozilima razine V-X s uključenom osobnom pričuvom."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Kada su uključene, možete dobiti dodatne bonuse na borbeno iskustvo, slobodno iskustvo i iskustvo posade ili kredite nakon svake bitke."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Osobne pričuve"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Budite u najboljih 10 igrača u vašem timu šest puta po osvojenom iskustvu u pobjedničkim slučajnim bitkama u vozilima razine V-X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Ovi zadaci omogućuju osvajanje pet puta više iskustva za uspješnu bitku. Trebate pobjediti i biti među najboljih 10 igrača u svojem timu po osvojenom iskustvu."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 zadataka za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Istražite modul i montirajte ga na vozilo bilo koje razine."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Borbeno iskustvo se dodjeljuje nakon svake bitke. Osvojite borbeno iskustvo za istraživanje novih modula koji poboljšavaju učinkovitost vašeg vozila."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Borbeno iskustvo"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Istražite i kupite bilo koje vozilo razine VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Na svakoj slijedećoj razini istraživanje vozila iziskuje više vremena i trude. Slobodno iskustvo pomaže u bržem napredovanju, a i izučena posada neće škoditi."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Vozilo razine VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Izvršite jedan osobni zadatak u bilo kojoj kampanji."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanje su niz zadataka za različite tipove vozila. Kada se završe, mogu se dobiti korisne nagrade i jedinstvena vozila."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Osobni zadaci"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Obučite posadu univerzalnim priručnikom."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Knjižice posade omogućuju značajno ubrzanje obuke posade dodavanjem određene količine iskustva jednom ili svim članovima posade."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Knjižice posade"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u vozilima razine VI-X opremljenih smjernicom za posadu."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Smjernice mogu poboljšati sposobnosti posade u jednoj bitci. Kao i potrošni materijal, mogu se kupiti ili primiti kao nagrada."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Smjernice za posadu"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Kupite posebni Početnički paket u prodavaonici u igri."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Sve što trebate možete kupiti u prodavaonici u igri, uključujući zlato, premium vozila i više. Naći ćete i redovne promidžbe koje nude sjajne pogodbe."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Prodavaonica"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u premium vozilima razine VI-X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Ova vozila ne treba istraživati. Ona zarađuju više borbenog iskustva, iskustva posade i kredita što vam omogućuje prebacivanje posade bez preobuke."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium vozila"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u vozilima razine VI-X sa smjernicom za posadu."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Smjernice omogućuju povećanje učinkovitosti montirane opreme. Poput potrošnog materijala, smjernice se mogu kupiti ili primiti kao nagrada."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Smjernice za opremu"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Budite u najboljih 10 igrača u vašem timu po osvojenom iskustvu 15 puta u slučajnim bitkama u vozilima razine VI-X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Ovi zadaci omogućuju osvajanje pet puta više iskustva za uspješnu bitku. Trebate pobjediti i biti među najboljih 10 igrača u svojem timu po osvojenom iskustvu."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 zadataka za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Istraživanje i kupnja bilo kojeg vozila razine VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Za ovu razinu vozila, dodatno se povećava tražena razina vještine. Vozila su sve snažnija i učinkovitija-kao i vaši protivnici."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Vozilo razine VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Odigrajte 10 slučajnih bitaka u vozilima razine VII-X opremljene Velikim priborom za prvu pomoć, Velikim alatom za popravke i Automatskim aparatom za gašenje požara."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Kada su opremljeni, veliki potrošni materijal popravlja oštećene module brže od malih. Umanjuju i trajanje ošamućenja i vjerojatnost požara te imaju kraće vrijeme hlađenja."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Veliki potrošni materijal"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Primite dvostruko iskustvo za vašu prvu pobjedu u danu u slučajnoj bitci u vozilu bilo koje razine."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Za vašu prvu pobjedu u danu u svakom vozilu možete osvojiti dvostruko iskustva. Koristite ovu osobinu za još bržu nadogradnju vaših vozila."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Množitelj iskustva"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Izradite dijelić nacrta za bilo koje neistraženo vozilo."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Nacrti daju popust na iskustvo i omogućuju ubrzanje istraživanja vozila. Mogu se dobiti kao nagrada ili pretvoriti iz univerzalnih i nacionalnih dijelića."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Nacrti vozila"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Budite u najboljih 10 igrača u vašem timu po osvojenom iskustvu 20 puta u slučajnim bitkama u vozilima razine VII-X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Ovi zadaci omogućuju osvajanje pet puta više iskustva za uspješnu bitku. Trebate pobjediti i biti među najboljih 10 igrača u svojem timu po osvojenom iskustvu."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 zadataka za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Istražite i kupite bilo koje vozilo razine VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Vozila razine VIII traže korištenje svog stečenog znanja. Neprijatelji neće dati da se dosađujete i pružit će visokooktansku zabavu i neprocjenjivo iskustvo."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Vozilo razine VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Koristite slobodno iskustvo za istraživanje bilo kojeg modula."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Ako nemate dovoljno borbenog iskustva za istraživanje modula ili vozila, možete koristiti slobodno iskustvo koje se može zaraditi na bilo kojem vozilu."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Slobodno iskustvo"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Ukrcajte nešto alternativnih granata na početku slučajne bitke u vozilu razine III-X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Pancirne (AP), fugasne (HE) i APCR granate se koriste za razine situacije u bitci. Odaberite mudro i steknite prednost!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Streljivo"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Prodajte nekorišteni modul iz Skladišta."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Nekorišteni moduli, granate, oprema, potrošni materijal i ostali predmeti su pohranjeni u Skladištu. Višak predmeta možete prodati za kredite."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Skladište"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Osvojite 25 000 kredita u slučajnimbitkama u vozilima razine III-X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Krediti se koriste za kupnju granata i novih vozila, popravak vozila i još. Važno je znati kako ih uštedjeti i mudro ih koristiti."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Krediti"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Odigrajte tri slučajne bitke u vozilima razine III-X s potrošnim materijalom montiranim na svim dostupnim mjestima."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Potrošni materijal može popraviti kritičnu štetu vozila i izliječiti ozljede posade u bitci. Uporaba u pravo vrijeme je kritična za preživljavanje na bojištu."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Potrošni materijal"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Odigrajte tri slučajne bitke u vozilima razine III-X s bilo kojom montiranom opremom."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Vozila se mogu opremiti opremom kako bi se poboljšale neke njihove karakteristike. Oprema će ovisiti o vozilu i stilu igre."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Oprema"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografija"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Završite jedan scenarij na bilo kojoj mapi u Topografiji"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Nepoznata zemlja"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Završite četiri osnovna scenarija na jednoj mapi u Topografiji"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Izviđanje"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Završite četiri napredna scenarija na jednoj mapi u Topografiji"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Petica iz zemljopisa"
