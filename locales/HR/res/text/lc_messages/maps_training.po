msgid "06_ensk/team1/heavyTank/descr"
msgstr "Ključna točka ove taktike je <a_ht_centralStreet>centralna ulica</a_ht_centralStreet>.%(p)Položaji u <a_ht_smallYard>malom dvorištu</a_ht_smallYard>°omogućuju borbu protiv neprijatelja u <a_ht_centralStreet>centralnoj ulici</a_ht_centralStreet> i u <a_ht_largeYard>velikom dvorištu</a_ht_largeYard>. Upamtite da na mapi ima puno linija paljbe pa zato kada igrate u <a_ht_smallYard>malom</a_ht_smallYard> ili <a_ht_largeYard>velikom dvorištu</a_ht_largeYard>, kao i kada se krećete prema <a_ht_centralStreet>centralnoj ulici</a_ht_centralStreet>, trebate biti oprezni i paziti na <a_ht_square>trg</a_ht_square>. Nakon proboja neprijateljskih linija u velikom dvorištu, možete doseći neprijateljsku bazu kroz <a_ht_stadium>stadion</a_ht_stadium>. Odatle možete vidjeti položaje branitelja na suprotnom boku u <a_ht_southernVillage>južnom selu</a_ht_southernVillage>."

msgid "06_ensk/team1/heavyTank/title"
msgstr "Gradski napad"

msgid "06_ensk/team1/mediumTank/descr"
msgstr "<a_mt_storages>Skladište</a_mt_storages> je ključna točka ove taktike.%(p)Krećući se lijevim bokom, možete zauzeti položaj pored <a_mt_industrialArea>industrijskog područja</a_mt_industrialArea>. Odatle možete pucati i na <a_mt_forest>područje raslinja</a_mt_forest> i pored <a_mt_storages>skladišta</a_mt_storages>. Pod zaklonom nasipa i zgrada možete se sigurno približiti neprijatelju u <a_mt_southernVillage>južnom selu</a_mt_southernVillage>. Ako ih tu sve uništite, imate priliku doseći bazu i obuhvatiti neprijatelja na <a_mt_stadium>stadionu</a_mt_stadium> ili pored<a_mt_platform>platforme</a_mt_platform>."

msgid "06_ensk/team1/mediumTank/title"
msgstr "Napad na skladište"

msgid "06_ensk/team2/heavyTank/descr"
msgstr "Ključna točka ove taktike je <b_ht_centralStreet>centralna ulica</b_ht_centralStreet>.%(p)Položaji u <b_ht_largeYard>velikom dvorištu</b_ht_largeYard> vam omogućuju borbu protiv neprijatelja smještenog na suprotnim stranama <b_ht_centralStreet>centralne ulice</b_ht_centralStreet> kao i u dubini <b_ht_smallYard>malog dvorišta</b_ht_smallYard>. Imajte na umu da je na mapi mnogo vatrenih linija, posebno kada se krećete u <b_ht_centralStreet>centralnu ulicu</b_ht_centralStreet> ili na putu ka <b_ht_smallYard>˛malom dvorištu</b_ht_smallYard> u neprijateljsku bazu. Budite oprezni i pazite na <b_ht_square>trg</b_ht_square>. Nakon probijanja obrane u gradu i dosizanja neprijateljske baze, možete napasti branitelje suprotnog boka u <b_ht_northernVillage>sjevernom selu</b_ht_northernVillage>."

msgid "06_ensk/team2/heavyTank/title"
msgstr "Gradski napad"

msgid "06_ensk/team2/mediumTank/descr"
msgstr "Ključna točka ove taktike je <b_mt_industrialArea>industrijsko područje</b_mt_industrialArea>.%(p)Krećući se desnim bokom, možete zauzeti položaj pored <b_mt_storages>skladišta</b_mt_storages> za paljbu na neprijatelja na suprotnoj strani industrijskog područja. Potom, pod zaštitom skladišta, bi se trebali kretati u samo <b_mt_industrialArea>industrijsko područje</b_mt_industrialArea>. Odatle se možete, korištenjem raznih zaklona, uspješno boriti protiv neprijatelja u <b_mt_industrialArea>industrijskom području</b_mt_industrialArea>, <b_mt_forest>području raslinja</b_mt_forest> i <b_mt_northernVillage>sjevernog sela</b_mt_northernVillage>. Nakon proboja kroz neprijateljske linije i dolaska do baze, moguće je očistiti preostale mete u <b_mt_northernSuburb>sjevernom predgrađu</b_mt_northernSuburb>."

msgid "06_ensk/team2/mediumTank/title"
msgstr "Napad preko industrijskog područja"

