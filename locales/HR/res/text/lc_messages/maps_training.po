msgid "02_malinovka/team1/heavyTank/descr"
msgstr "Ključ ove taktike je %(a_ht_millMountainPhrase1).%(p)Kretanjem pod zaštitom %(a_ht_southernForestPhrase) se možete sigurno uspeti što je više moguće granici mape. Tada morate odmah zauzeti %(a_ht_millMountainPhrase2) gdje možete pucati sakrivši trup vozila iza terena. Kontrola ove planine vam omogućuje i otvaranje paljbe na pristupne puteve %(a_ht_villagePhrase) i obuhvat neprijatelja s boka. Stijene će vas štititi od neprijatelja koji se skrivaju u %(a_ht_northernForestPhrase). Osigurana šuma otvara put ka Bazi 2."

msgid "02_malinovka/team1/heavyTank/title"
msgstr "Napad na vjetrenjaču"

msgid "02_malinovka/team1/mediumTank/descr"
msgstr "Ključ ove taktike je %(a_mt_ledgePhrase1).%(p)Krenite na središte uz %(a_mt_swampPhrase), zauzmite %(a_mt_elevationPhrase) od kuda možete gađati neprijatelja na %(a_mt_ledgePhrase2). Potom, vozeći kroz vodu, možete se stisnuti uz greben i pucati na mete koje se penju uz planinu. Skrivanje iza brda i grmlja na %(a_mt_ledgePhrase3) će vam omogućiti paljbu na neprijateljska vozila u %(a_mt_northernForestPhrase) i blizu baze. Nakon uništenja neprijatelja s boka na %(a_mt_fieldPhrase) dobit ćete pristup nezaštićenoj Bazi 2."

msgid "02_malinovka/team1/mediumTank/title"
msgstr "Napad preko grebena"

msgid "02_malinovka/team2/heavyTank/descr"
msgstr "Ključ ove taktike je %(b_ht_millMountainPhrase1).%(p)Kretanjem pod zaštitom %(b_ht_northernForestPhrase) se možete sigurno uspeti što je više moguće granici mape. Tada morate odmah zauzeti %(b_ht_millMountainPhrase2) gdje možete pucati sakrivši trup vozila iza terena. Kontrola ove planine vam omogućuje i otvaranje paljbe na pristupne puteve %(b_ht_villagePhrase) i obuhvat neprijatelja s boka. Stijene će vas štititi od neprijatelja koji se skrivaju u %(b_ht_southernForestPhrase). Osigurana šuma otvara put ka Bazi 1."

msgid "02_malinovka/team2/heavyTank/title"
msgstr "Napad na vjetrenjaču"

msgid "02_malinovka/team2/mediumTank/descr"
msgstr "Ključ ove taktike je %(b_mt_cowshedsPhrase1).%(p)Krećući se duž desnog boka možete zauzeti položaj %(b_mt_northLedgePhrase) odakle imate neprijatelja na suprotnoj strani. Ostavši neotkriveni, možete doseći neprijateljska vozila iz rub %(b_mt_fieldPhrase) i zauzeti %(b_mt_cowshedsPhrase2). Pazite da ne padnete u vodu. Pod zaštitom zgrada možete napasti neprijateljske položaje pored baze i sigurno se kretati do %(b_mt_swampPhrase) gdje možete otkriti i pucati na mete u %(b_mt_southernForestPhrase)."

msgid "02_malinovka/team2/mediumTank/title"
msgstr "Napad preko polja"

