msgid "28_desert/team1/heavyTank/descr"
msgstr "<a_ht_mountains>Planine</a_ht_mountains> su ključna točka ove taktike.%(p)Prolaženjem pored <a_ht_easternVillage>istočnog sela</a_ht_easternVillage>, možete napredovati ka <a_ht_mountains>planinama</a_ht_mountains>. Nakon uništenja neprijatelja vatrom sa srednje udaljenosti, trebali bi proći <a_ht_gorge>˛klnac</a_ht_gorge> i uključiti se u bitku na prilazima <a_ht_thoroughfare>prolazu</a_ht_thoroughfare>. Nakon zaklanjanja u <a_ht_dunes>dinama</a_ht_dunes>, trebali bi uništiti branitelje baze na <a_ht_balcony>balkonu</a_ht_balcony>. Potom prijeđite <a_ht_ravine>klanac</a_ht_ravine> i dokrajčite neprijatelja u zapadnoj bazi."

msgid "28_desert/team1/heavyTank/title"
msgstr "Planinski napad"

msgid "28_desert/team1/mediumTank/descr"
msgstr "<a_mt_hills>Brda</a_mt_hills> su ključna točka ove taktike.%(p)Zadržavajući <a_mt_temple>hram</a_mt_temple> kao orjentir, trebali bi zauzeti vatreni položaj pod okriljem <a_mt_longDune>dugačke dine</a_mt_longDune>. To će omogućiti kontrolu nad neprijateljem pored <a_mt_temple>hrama</a_mt_temple> i na <a_mt_hills>brdima</a_mt_hills>. Mnogo se vozila sakriva iza <a_mt_hills>brda</a_mt_hills> pa budite uvijek na oprezu. Približavajući se zapadnoj bazi neprijatelja, trebate uništiti mete na <a_mt_shelf>uzvišenju</a_mt_shelf> nakon čega možete slobodno obuhvatiti neprijatelja pored <a_mt_westernVillage>zapadnog sela</a_mt_westernVillage>."

msgid "28_desert/team1/mediumTank/title"
msgstr "Brdski napad"

msgid "28_desert/team2/heavyTank/descr"
msgstr "<b_ht_hills>Brda</b_ht_hills> su ključna točka ove taktike.%(p)Krećući se duž <b_ht_shelf>uzvišenja</b_ht_shelf> možete zauzeti položaj za paljbu na neprijatelja pored baze ili <b_ht_bigDune>velike dine</b_ht_bigDune>. Nakon čišćenja puta, krenite na <b_ht_longDune>dugačku dinu</b_ht_longDune>. Koristite je kao zaklon, očistite put do obrambenih linija neprijatelja. Idite kroz <b_ht_detour>zaobilaznicu</b_ht_detour> do pozadine neprijatelja koji brani istočnu bazu."

msgid "28_desert/team2/heavyTank/title"
msgstr "Brdski napad"

msgid "28_desert/team2/mediumTank/descr"
msgstr "Ključna točka ove taktike je vožna do <b_mt_rocks>stijena</b_mt_rocks>.%(p)Vožnjom pored <b_mt_westernVillage>zapadnog sela</b_mt_westernVillage> bi trebali brzo zauzeti vatreni položaj na <b_mt_rocks>stijenama</b_mt_rocks> bez odvraćanja pažnje od mogućih meta na cesti. Nakon čišćenja neprijateljskih snaga s ovog položaja, trebali bi se pokrenuti u <b_mt_gorge>klanac</b_mt_gorge> i tamo dokrajčiti sve mete. Potom se uspnite <b_mt_mountain>planinom</b_mt_mountain> i brzo spustite do <b_mt_easternVillage>istočnog sela</b_mt_easternVillage>. Nakon uništenja neprijatelja u istočnoj bazi, možete lako dokrajčiti preostali otpor oko <b_mt_river>rijeke</b_mt_river>."

msgid "28_desert/team2/mediumTank/title"
msgstr "Napad preko stijena"

