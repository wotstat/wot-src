msgid "queue/tip/21"
msgstr "Na ovom poligonu otpor neće biti žestok, ali budite uvijek na oprezu u stvarnim bitkama i naučite detalje mape i karakteristike neprijateljskih vozila."

msgid "queue/tip/3"
