msgid "07_lakeville/team1/heavyTank/descr"
msgstr "Ključna točka ove taktike je <a_ht_mountainPass>prolaz</a_ht_mountainPass>.%(p)Zauzimanjem položaja na <a_ht_mountainPass>prolaz</a_ht_mountainPass> možete učinkovito pucati na neprijatelj i na drugoj strani <a_ht_mountainPass>prolaza</a_ht_mountainPass> i na <a_ht_southernEntrance>južnom prilazu</a_ht_southernEntrance>. Proboj obrane u ovom smjeru čisti put ka neprijateljskoj bazi. Od tamo možete pucati na neprijateljska vozila koja brane <a_ht_path>stazu</a_ht_path> kao i na neprijatelja koji se bori u <a_ht_town>gradu</a_ht_town>."

