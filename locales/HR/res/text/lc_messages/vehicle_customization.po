msgid "main_style/ski_patrol_desc/long"
msgstr "Švedska je poznata po oštrim i snježnim zimama. I zato skije nisu luksuz niti zabava već osnovno sredstvo prijevoza koje koristi posada za blisko izviđanje. Kada se posao obavi, mogu se izazvati obližnje posade na skijaški izazov."

msgid "main_style/usa_veteran"
