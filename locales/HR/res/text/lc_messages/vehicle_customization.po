msgid "main_style/usa_veteran_desc"
msgstr "O, reci vidiš li, svjetlosti rane zore,\nŠto smo tako ponosno slavili na posljednjim odsjajima sumraka.\nČije široke pruge i sjajne zvijezde kroz opasnu borbu.\nPreko bedema koje smo gledali kako se elegantno vijore?"

