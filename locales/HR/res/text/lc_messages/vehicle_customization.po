msgid "special_style/steam_april_2023_desc"
msgstr "Svevremenski stil izrađen za World of Tanks Steam igrače."

msgid "special_style/steam_april_2023_desc/long"
msgstr "Stil izrađen od strane vodećeg dizajnera popularne emisije \"Pump My Tank.\" Pored boje, ima dodatne subwoofere, DJ platformu i TV ekrane instalirane na svakom poklopcu, a vlasnik vozila dobija službeni status nabrijanog tenka."

