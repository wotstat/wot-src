msgid "introduction/slide/2/subtitle"
msgstr "POKLAPANJE KATEGORIJE"

msgid "introduction/slide/2/title"
msgstr "KATEGORIJE OPREME"

msgid "introduction/slide/3/description/left"
msgstr "Trošak većine opreme neće nadmašiti 50 000 kredita za vozila razine II-IV, 300 000 kredita za vozila razine V-VII i 600 000 za vozila razine VIII-XI."

msgid "introduction/slide/3/description/right"
msgstr "Neka nova oprema ima tri klase. Čak i ako je klasa različita, oprema ima određeni učinak. Što je klasa viša, to je veći trošak opreme. Svaka klasa opreme odgovara svojem rasponu razina vozila."

msgid "introduction/slide/3/subtitle/left"
msgstr "PROMJENE OPREME"

msgid "introduction/slide/3/subtitle/right"
msgstr "NOVA OPREMA"

