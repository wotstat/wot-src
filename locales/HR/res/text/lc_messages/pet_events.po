msgid "joke/event_1"
msgstr "Ako vaš pas ikada počne svjetliti, prijavite se u ambulantu. Ili ne. Niste čuli ovo od mene."

msgid "joke/event_10"
msgstr "Dog je položio plivački ispit s izvrsnim ocjenama. Vojnik? Ne baš."

msgid "joke/event_11"
msgstr "To je bilo taktičko izvlačenje...ili grickalice."

msgid "joke/event_12"
msgstr "Kome trebaju repelenti zmija kada imate rep koji maše i lavež koji straši?"

msgid "joke/event_13"
msgstr "Skupljanje smeća? Nema šanse, više kao kuriranje artefakata koji podižu moral!"

msgid "joke/event_14"
msgstr "Ne znamo što ga pokreće, ali pretpostavljamo teniske loptice i kaos."

msgid "joke/event_15"
msgstr "Zaboravite detektore mina, ponekad je sve što trebate oštro oko i mašući rep."

msgid "joke/event_16"
msgstr "Vaš pas je službeno postao najpouzdaniji tragač za hranom u odredu."

msgid "joke/event_17"
msgstr "Nitko ne zna odakle je došao, ali moral je porastao i zalihe sira su se smanjile."

msgid "joke/event_18"
msgstr "Njihovo posljednje odašiljanje? \"Zalaj jednom za opasnost, dvaput za punjenje.\""

msgid "joke/event_19"
msgstr "Nije neovlašteno ulazio. Samo je bio jako izgubljen. I naoružan."

msgid "joke/event_2"
msgstr "Izgleda da je netko konačno rješio tajnu ubrzavanja birokracije-četiri šape i bez pitanja."

msgid "joke/event_20"
msgstr "Zaboravi senzore-umjesto njih pored svake cijevi postavi psa."

msgid "joke/event_21"
msgstr "Znaš da je ozbiljno kada pas ima bolji lanac opskrbe nego logistika."

msgid "joke/event_22"
msgstr "Ni naši najbolji mehaničari nisu tako brzo dodali francuski ključ."

msgid "joke/event_23"
msgstr "Kada priroda udari, pošalji jedinicu lajavaca."

msgid "joke/event_24"
msgstr "Jedini član posade koji se službeno kvalificirao kao \"borbeno spreman\" i \"jako dobar pesek\"."

msgid "joke/event_25"
msgstr "Hej, ako se igračka počinje sama kretati...sad je tvoja smjena."

msgid "joke/event_26"
msgstr "Pravo streljivo na obuci? Dobro da tvoj pas provjerava."

msgid "joke/event_27"
msgstr "Novak mjeseca: četiri noge, bez lopate, puno prljavštine."

msgid "joke/event_28"
msgstr "Zvati psa \"chefom\" je malo pretjerano, ali rep bi bio odličan alat za mješanje."

msgid "joke/event_29"
msgstr "Liječnikove zapovijedi: dva kompleta pilula i jedan dobri štenac po sobi."

msgid "joke/event_3"
msgstr "Nema licencu viličara, ali dovoljno prostora za vožnju."

msgid "joke/event_30"
msgstr "Brisanje podova? Provjereno. Brisanje prašine? Provjereno. Linjanje? Dvaput provjereno. Održavanje kućanstva odobreno!"

msgid "joke/event_4"
msgstr "Vaš dog je pronašao tajnu zalihu...ili je odlučio opremiti cijelu novu garažu."

msgid "joke/event_5"
msgstr "Izgleda da je najučinkovitija formula za tjeranje mase fermentirana riba i četiri noge."

msgid "joke/event_6"
msgstr "Pas i mačka rade zajedno? Apokalipsa mora da dolazi prije roka."

msgid "joke/event_7"
msgstr "Ako vaš pas počinje čuvati rezervne dijelove, ne brinite-samo želi promicanje u mlađeg mehaničara."

msgid "joke/event_8"
msgstr "Kako zoveš zavijajućeg psa na punoj mjesečini? \"Vukolaj\"."

msgid "joke/event_9"
msgstr "Protupožarne vježbe spašavaju živote. Psi, izgleda, spašavaju ljude."

msgid "rewards/synergy_value"
msgstr "+"

msgid "rewards/title"
msgstr "Izgubljen, ali ne i nestao:"

msgid "submit"
msgstr "Imam ga!"

msgid "text/event_1"
msgstr "{{@ style (color $color)}}Stranac{{/}} u {{@ style (color $color)}}formalnom {{/}}{{@ style (color $color)}}odjelu {{/}}vam se približava. \"Vaš {{@ style (color $color)}}pas{{/}} je pomogao u {{@ style (color $color)}}potrazi{{/}} i {{@ style (color $color)}}savladavanju{{/}} {{@ style (color $color)}}opasnog {{/}}{{@ style (color $color)}}predmeta{{@ style (color $defaultColor)}}. {{/}}{{/}}Podaci o ovom incidentu će biti {{@ style (color $color)}}obrisani{{/}} iz svih {{@ style (color $color)}}zapisa{{@ style (color $defaultColor)}}.{{/}}{{/}} Hvala vam na vašoj pomoći.\" Čovjek vam uručuje {{@ style (color $color)}}paket{{/}} i napušta {{@ style (color $color)}}Garažu{{/}}."

msgid "text/event_10"
msgstr "Tijekom {{@ style (color $color)}}borbene {{/}}{{@ style (color $color)}}vježbe {{/}}na {{@ style (color $color)}}vodi{{/}}, jedan od {{@ style (color $color)}}vojnika {{/}}se {{@ style (color $color)}}zapetljao {{/}}u {{@ style (color $color)}}užadi za {{/}}{{@ style (color $color)}}vezivanje {{/}}i {{@ style (color $color)}}pao {{/}}{{@ style (color $color)}}u vodu{{@ style (color $defaultColor)}}. {{/}}{{/}}Srećom, vaš {{@ style (color $color)}}pas {{/}}je bio blizu i uspio je {{@ style (color $color)}}izvući {{/}}{{@ style (color $color)}}utapajućeg {{/}}{{@ style (color $color)}}vojnika {{/}}na {{@ style (color $color)}}sigurno{{@ style (color $defaultColor)}}. {{/}}{{/}}Priča je uskoro postala simbol {{@ style (color $color)}}hrabrosti {{/}}u {{@ style (color $color)}}jedinici{{/}}."

msgid "text/event_11"
msgstr "Primjetili ste da vaš {{@ style (color $color)}}pas{{/}} trči iz {{@ style (color $color)}}skladišta{{/}} s {{@ style (color $color)}}vrećicom{{/}} u njegovim {{@ style (color $color)}}ustima{{@ style (color $defaultColor)}}. {{/}}{{/}}Dok ste se spremali {{@ style (color $color)}}ukoriti{{/}} ga za {{@ style (color $color)}}krađu {{/}}{{@ style (color $color)}}zaliha{{/}}, {{@ style (color $color)}}domar{{/}} se nasmijao \"Ne mogu si pomoći i opraštam tako dobrom {{@ style (color $color)}}peseku{{/}}\". Ali izgleda da nešto dodatne {{@ style (color $color)}}obuke{{/}} u {{@ style (color $color)}}ponašanju{{/}} ne bi škodilo."

msgid "text/event_12"
msgstr "Tijekom {{@ style (color $color)}}rutinske{{/}}{{@ style (color $color)}} inspekcije{{/}} {{@ style (color $color)}}vojnici{{/}} su otkrili {{@ style (color $color)}}zmijsko {{/}}{{@ style (color $color)}}gnijezdo{{/}} pored jedne od {{@ style (color $color)}}baraka{{@ style (color $defaultColor)}}.{{/}}{{/}} Dok su razglabali kako to {{@ style (color $color)}}riješiti{{/}}, vaš vjerni {{@ style (color $color)}}pas{{/}} je otjerao {{@ style (color $color)}}gmazove{{/}} {{@ style (color $color)}}lajanjem{{/}} i {{@ style (color $color)}}neustrašivim skakanjem{{@ style (color $defaultColor)}}.{{/}}{{/}} Do {{@ style (color $color)}}večeri{{/}} je {{@ style (color $color)}}područje{{/}} bilo opet {{@ style (color $color)}}sigurno{{/}}. {{@ style (color $color)}}Hrabrost vašeg psa{{/}} će zasigurno biti {{@ style (color $color)}}nagrađena{{/}}."

msgid "text/event_13"
msgstr "Primjetili smo da vaš {{@ style (color $color)}}pas {{/}}ponekad {{@ style (color $color)}}otrči {{/}}{{@ style (color $color)}}{{/}}negdje {{@ style (color $color)}}ujutro{{@ style (color $defaultColor)}}. {{/}}{{/}}Ispada da neki {{@ style (color $color)}}piloti {{/}}imaju običaj {{@ style (color $color)}}maženja {{/}}{{@ style (color $color)}}psića {{/}}za {{@ style (color $color)}}{{/}}{{@ style (color $color)}}sreću {{/}}prije {{@ style (color $color)}}polijetanja{{@ style (color $defaultColor)}}. {{/}}{{/}}Radoznalo ste {{@ style (color $color)}}slijedili {{/}}vašeg {{@ style (color $color)}}prijatelja {{/}}{{@ style (color $color)}}koji {{/}}{{@ style (color $color)}}maše repom {{/}}i otkrili {{@ style (color $color)}}tajnu {{/}}{{@ style (color $color)}}zalihu {{/}}— {{@ style (color $color)}}malu {{/}}{{@ style (color $color)}}škrinju {{/}}punu {{@ style (color $color)}}čepova {{/}}{{@ style (color $color)}}od boca{{/}}, {{@ style (color $color)}}dugmadi {{/}}i {{@ style (color $color)}}izgriženih {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}čarapa{{/}}."

msgid "text/event_14"
msgstr "Vaš {{@ style (color $color)}}pas {{/}}je pronašao {{@ style (color $color)}}čudni {{/}}{{@ style (color $color)}}uređaj {{/}}u {{@ style (color $color)}}staroj {{/}}{{@ style (color $color)}}garaži{{@ style (color $defaultColor)}}. {{/}}{{/}}Nakon što je {{@ style (color $color)}}uključen{{/}}{{@ style (color $color)}}{{@ style (color $defaultColor)}}, {{/}}{{/}}{{@ style (color $color)}}uređaj je {{/}}počeo {{@ style (color $color)}}obrađivati {{/}}{{@ style (color $color)}}igračke {{/}}unutar sebe i stvarati potpuno {{@ style (color $color)}}nove {{/}}{{@ style (color $color)}}predmete{{@ style (color $defaultColor)}}. {{/}}{{/}}Tijekom svih {{@ style (color $color)}}preobrazbi{{/}}, uspjeli ste dobiti nekoliko {{@ style (color $color)}}korisnih {{/}}{{@ style (color $color)}}predmeta{{/}}."

msgid "text/event_15"
msgstr "Tijekom {{@ style (color $color)}}vježbe {{/}}na {{@ style (color $color)}}poligonu{{/}}{{@ style (color $color)}}{{/}}, nekoliko {{@ style (color $color)}}tenkova {{/}}je naletilo u polje posuto {{@ style (color $color)}}lažnim {{/}}{{@ style (color $color)}}minama{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}pas {{/}}je odjurio naprijed, {{@ style (color $color)}}privukao {{/}}{{@ style (color $color)}}pažnju {{/}}i pomogao {{@ style (color $color)}}posadi {{/}}{{@ style (color $color)}}da opazi {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}opasnost {{/}}na vrijeme. Zahvaljujući {{@ style (color $color)}}brzoj reakciji vašeg{{/}} {{@ style (color $color)}} ljubimca{{/}}, {{@ style (color $color)}}tenkovi {{/}}{{@ style (color $color)}}su se pregrupirali {{/}}i prešli {{@ style (color $color)}}zapreke {{/}}na siguran način. Kakav god bio ishod, {{@ style (color $color)}}nagrada {{/}}za ovakvu {{@ style (color $color)}}hrabrost {{/}}je zajamčena."

msgid "text/event_16"
msgstr "Dok je {{@ style (color $color)}}istraživao {{/}}{{@ style (color $color)}}Garažu{{/}}, vaš {{@ style (color $color)}}pas {{/}}je nanjušio {{@ style (color $color)}}zalihu {{/}}{{@ style (color $color)}}starih obroka {{/}}skrivenih iza nekih {{@ style (color $color)}}sanduka{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Vojnici {{/}}su se lijepo nasmijali {{@ style (color $color)}}{{@ style (color $defaultColor)}}\"{{/}}blagu{{@ style (color $defaultColor)}}\"{{/}}{{/}} i predali ga {{@ style (color $color)}}intendantu{{@ style (color $defaultColor)}}. {{/}}{{/}}Vašem {{@ style (color $color)}}psu {{/}}je obećana {{@ style (color $color)}}nagrada {{/}}za {{@ style (color $color)}}neočekivani {{/}}{{@ style (color $color)}}pronalazak{{/}}."

msgid "text/event_17"
msgstr "Čuli ste {{@ style (color $color)}}buku {{/}}koja dolazi iz {{@ style (color $color)}}baraka{{@ style (color $defaultColor)}}. {{/}}{{/}}Dok ste prilazili, vidjeli ste {{@ style (color $color)}}vojnike {{/}}okupljene kako gledaju vašeg {{@ style (color $color)}}psa {{/}}{{@ style (color $color)}}kako se bori protiv {{/}}golemog, {{@ style (color $color)}}nabildanog {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}miša{{@ style (color $defaultColor)}}. {{/}}{{/}}U jednom trenu, sve je {{@ style (color $color)}}omela {{/}}{{@ style (color $color)}}objava{{/}}—i kada su se vratili {{@ style (color $color)}}čudni {{/}}{{@ style (color $color)}}glodavac {{/}}je {{@ style (color $color)}}nestao{{@ style (color $defaultColor)}}. {{/}}{{/}}U znak zahvalnosti za tako {{@ style (color $color)}}zabavni {{/}}{{@ style (color $color)}}spektakl{{/}}, {{@ style (color $color)}}vojnici {{/}}su vašem psu {{@ style (color $color)}}dali {{/}}nekoliko {{@ style (color $color)}}korisnih {{/}}{{@ style (color $color)}}predmeta{{/}}."

msgid "text/event_18"
msgstr "Dok je {{@ style (color $color)}}istraživao {{/}}{{@ style (color $color)}}staru {{/}}{{@ style (color $color)}}zapovjednu {{/}}{{@ style (color $color)}}prostoriju{{/}}, vaš {{@ style (color $color)}}pas {{/}}je počeo {{@ style (color $color)}}lajati {{/}}na {{@ style (color $color)}}prašnjavi portret{{@ style (color $defaultColor)}}. {{/}}{{/}}Malo {{@ style (color $color)}}čišćenja{{/}} i {{@ style (color $color)}}papirić {{/}}je pao iz {{@ style (color $color)}}okvira{{/}}.{{br}}Govorio je o {{@ style (color $color)}}zaboravljenoj {{/}}{{@ style (color $color)}}tenkovskoj {{/}}{{@ style (color $color)}}jedinici {{/}}koja je {{@ style (color $color)}}nestala {{/}}tijekom {{@ style (color $color)}}noćnih {{/}}{{@ style (color $color)}}manevara{{/}}—njihov posljednji {{@ style (color $color)}}pozivni {{/}}{{@ style (color $color)}}znak {{/}}je bio {{@ style (color $color)}}Željezna {{/}}{{@ style (color $color)}}šapa{{/}}."

msgid "text/event_19"
msgstr "Tijekom još jedne {{@ style (color $color)}}ophodnje{{/}} po {{@ style (color $color)}}teritoriju{{/}}, vaš {{@ style (color $color)}}pas{{/}} je odjednom {{@ style (color $color)}}odjurio{{/}} u {{@ style (color $color)}}grmlje{{/}} i {{@ style (color $color)}}istjerao{{/}} {{@ style (color $color)}}stranca{{/}} {{@ style (color $color)}}koji se skrivao{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Ophodnja{{/}} je {{@ style (color $color)}}zadržala{{/}} {{@ style (color $color)}}uljeza{{/}} i {{@ style (color $color)}}incident{{/}} je {{@ style (color $color)}}zapisan{{/}} za daljnju {{@ style (color $color)}}istragu{{/}}."

msgid "text/event_2"
msgstr "{{@ style (color $color)}}Pas {{/}}trči prema vama, mašući {{@ style (color $color)}}repom{{@ style (color $defaultColor)}}. {{/}}{{/}}Hrpa {{@ style (color $color)}}papira {{/}}u njegovim {{@ style (color $color)}}zubima{{@ style (color $defaultColor)}}. {{/}}{{/}}Na prvi pogled izgledaju kao {{@ style (color $color)}}izvješća{{/}}, {{@ style (color $color)}}tablice{{/}} i ostala {{@ style (color $color)}}dokumentacija{{@ style (color $defaultColor)}}. {{/}}{{/}}Ekipi u {{@ style (color $color)}}uredu {{/}}će najvjerojatnije biti drago da to dobiju natrag."

msgid "text/event_20"
msgstr "Dok je {{@ style (color $color)}}šetao{{/}} {{@ style (color $color)}}područjem{{/}}, vaš {{@ style (color $color)}}pas{{/}} je odjednom počeo {{@ style (color $color)}}lajati{{/}} na jednu od {{@ style (color $color)}}vodovodnih cijevi{{@ style (color $defaultColor)}}. {{/}}{{/}}Nakon što su {{@ style (color $color)}}tehničari{{/}} {{@ style (color $color)}}provjerili{{/}} {{@ style (color $color)}}okolinu{{/}}, otkrili su {{@ style (color $color)}}kvar{{/}} koji je mogao dovesti do ozbiljnog {{@ style (color $color)}}pada {{/}}{{@ style (color $color)}}sustava{{/}}."

msgid "text/event_21"
msgstr "Vaš {{@ style (color $color)}}pas {{/}}vam je donio {{@ style (color $color)}}vreću {{/}}punu raznih {{@ style (color $color)}}čudnih, {{/}}{{@ style (color $color)}}korisnih {{/}}{{@ style (color $color)}}stvari{{@ style (color $defaultColor)}}. {{/}}{{/}}Unatoč vašem trudu, niste mogli {{@ style (color $color)}}otkriti {{/}}odakle su {{@ style (color $color)}}došle{{/}}{{@ style (color $color)}}{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}četveronožni {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}priajtelj {{/}}je samo sjedio i izgledao {{@ style (color $color)}}samozadovoljan {{/}}i savršeno {{@ style (color $color)}}smiren {{/}}ostatak {{@ style (color $color)}}dana{{/}}."

msgid "text/event_22"
msgstr "{{@ style (color $color)}}Mehaničari {{/}}su uspjeli {{@ style (color $color)}}naučiti {{/}}vašeg {{@ style (color $color)}}psa {{/}}da {{@ style (color $color)}}donese {{/}}i {{@ style (color $color)}}identifcira {{/}}{{@ style (color $color)}}alat{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Čudesni {{/}}{{@ style (color $color)}}pesek {{/}}je proveo cijeli {{@ style (color $color)}}dan {{/}}{{@ style (color $color)}}radeći {{/}}{{@ style (color $color)}}pored {{/}}njih, samouvjereno {{@ style (color $color)}}noseći {{/}}ispravnu {{@ style (color $color)}}opremu {{/}}kao iskusni {{@ style (color $color)}}član {{/}}{{@ style (color $color)}}posade{{/}}."

msgid "text/event_23"
msgstr "{{@ style (color $color)}}Mrtvo {{/}}{{@ style (color $color)}}stablo {{/}}je palo na jednog {{@ style (color $color)}}stražara {{/}}tijekom {{@ style (color $color)}}ophodnje{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}pas {{/}}ne samo da je {{@ style (color $color)}}potrčao {{/}}{{@ style (color $color)}}po {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}pomoć {{/}}već je i {{@ style (color $color)}}pomogao {{/}}{{@ style (color $color)}}izvući {{/}}{{@ style (color $color)}}ozlijeđenog {{/}}{{@ style (color $color)}}čovjeka {{/}}ispod {{@ style (color $color)}}trupca{{@ style (color $defaultColor)}}. {{/}}{{/}}Ova {{@ style (color $color)}}priča se {{/}}brzo {{@ style (color $color)}}proširila {{/}}među {{@ style (color $color)}}odredima {{/}}{{@ style (color $color)}}ophodnje{{/}}."

msgid "text/event_24"
msgstr "Vaš {{@ style (color $color)}}pas{{/}} je sudjelovao u {{@ style (color $color)}}dodjeli {{/}}{{@ style (color $color)}}nagrada{{/}} za najiskusnije {{@ style (color $color)}}tenkiste{{@ style (color $defaultColor)}}. {{/}}{{/}}Savjesni {{@ style (color $color)}}pas{{/}} se ponašao kao {{@ style (color $color)}}pomoćnik{{/}}, djeleći {{@ style (color $color)}}odličja{{/}} i {{@ style (color $color)}}poklone{{/}} {{@ style (color $color)}}domaćinu{{@ style (color $defaultColor)}}. {{/}}{{/}}Ovaj {{@ style (color $color)}}doprinos{{/}} nije prošao {{@ style (color $color)}}nezamjećen{{/}}-{{@ style (color $color)}}psić{{/}} je osvojio zasluženu {{@ style (color $color)}}nagradu{{/}}."

msgid "text/event_25"
msgstr "Vaš {{@ style (color $color)}}pas {{/}}se vratio u {{@ style (color $color)}}bazu {{/}}noseći {{@ style (color $color)}}poderanog {{/}}{{@ style (color $color)}}plišanca {{/}}{{@ style (color $color)}}lisice{{@ style (color $defaultColor)}}. {{/}}{{/}}Neki {{@ style (color $color)}}vojnici {{/}}su tvrdili da su čuli {{@ style (color $color)}}šapat {{/}}u {{@ style (color $color)}}šumi {{/}}netom prije.{{br}}Kasnije te {{@ style (color $color)}}večeri{{/}}, jedan od njih {{@ style (color $color)}}je {{/}}prepoznao {{@ style (color $color)}}igračku{{/}}—odgovarala je {{@ style (color $color)}}amblemu {{/}}{{@ style (color $color)}}lisice {{/}}davno {{@ style (color $color)}}raspuštene {{/}}{{@ style (color $color)}}izviđačke {{/}}{{@ style (color $color)}}jedinice {{/}}koja je {{@ style (color $color)}}nestala {{/}}godinama prije tijekom {{@ style (color $color)}}zimskih {{/}}{{@ style (color $color)}}manevara{{@ style (color $defaultColor)}}. {{/}}{{/}}Nisu {{@ style (color $color)}}preostali {{/}}nikakvi zapisi."

msgid "text/event_26"
msgstr "Tijekom {{@ style (color $color)}}distribucije {{/}}{{@ style (color $color)}}zaliha {{/}}na {{@ style (color $color)}}terenu {{/}}za {{@ style (color $color)}}obuku{{/}}, vaš {{@ style (color $color)}}pas {{/}}je počeo {{@ style (color $color)}}agresivno {{/}}{{@ style (color $color)}}lajati{{@ style (color $defaultColor)}}. {{/}}{{/}}Uzbuđeni, {{@ style (color $color)}}časnici {{/}}{{@ style (color $color)}}su {{/}}ispitali {{@ style (color $color)}}sanduke {{/}}i otkrili da je neka od {{@ style (color $color)}}opreme {{/}}bila {{@ style (color $color)}}bojeva {{/}}{{@ style (color $color)}}borbena {{/}}{{@ style (color $color)}}oprema {{/}}greškom pomješana s {{@ style (color $color)}}testnim {{/}}{{@ style (color $color)}}tranšama{{/}}."

msgid "text/event_27"
msgstr "Tijekom {{@ style (color $color)}}vojnog {{/}}{{@ style (color $color)}}treninga{{/}} vaš {{@ style (color $color)}}ljubimac{{/}} je postao opsjednut {{@ style (color $color)}}kopanjem {{/}}{{@ style (color $color)}}rovova{{@ style (color $defaultColor)}}. {{/}}{{/}}Ovaj {{@ style (color $color)}}entuzijazam{{/}} se brzo {{@ style (color $color)}}proširio{{/}} do {{@ style (color $color)}}novaka{{/}} koji su se počeli {{@ style (color $color)}}natjecati{{/}} s {{@ style (color $color)}}psom{{/}} u {{@ style (color $color)}}brzini{{/}} i {{@ style (color $color)}}dubini{{/}} iskopa-na opću {{@ style (color $color)}}radost{{/}} {{@ style (color $color)}}instruktora{{/}}."

msgid "text/event_28"
msgstr "Danas je bio {{@ style (color $color)}}dan {{/}}{{@ style (color $color)}}kuhanja {{/}}{{@ style (color $color)}}od kuće {{/}}u {{@ style (color $color)}}taboru{{/}}, kada je {{@ style (color $color)}}vojnicima {{/}}dozvoljeno {{@ style (color $color)}}pripremati {{/}}{{@ style (color $color)}}lokalna {{/}}{{@ style (color $color)}}jela {{/}}iz dostupnih {{@ style (color $color)}}namirnica{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}pas {{/}}je potrošio cijeli {{@ style (color $color)}}dan {{/}}{{@ style (color $color)}}trčeći {{/}}{{@ style (color $color)}}između {{/}}{{@ style (color $color)}}postaja {{/}}{{@ style (color $color)}}kuhinja {{/}}i {{@ style (color $color)}}pomagao {{/}}{{@ style (color $color)}}nositi {{/}}{{@ style (color $color)}}zalihe{{/}}—zaradivši više od nekoliko {{@ style (color $color)}}ugriza {{/}}od {{@ style (color $color)}}prijateljskih {{/}}{{@ style (color $color)}}ruku{{/}}."

msgid "text/event_29"
msgstr "Danas je bio {{@ style (color $color)}}važan {{/}}{{@ style (color $color)}}dan{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}ljubimac{{/}} ga je proveo u {{@ style (color $color)}}bolnici{{/}}, {{@ style (color $color)}}razveseljavajući{{/}} {{@ style (color $color)}}{{/}}{{@ style (color $color)}}ranjenike{{/}} izvođenjem nekoliko {{@ style (color $color)}}trikova{{/}} koje ste ga naučili i {{@ style (color $color)}}posjetio je{{/}} svakog {{@ style (color $color)}}vojnika{{@ style (color $defaultColor)}}. {{/}}{{/}}Neko vrijeme {{@ style (color $color)}}odjel{{/}} je bio ispunjen {{@ style (color $color)}}smijehom{{/}} i {{@ style (color $color)}}mahanjem repom{{/}}."

msgid "text/event_3"
msgstr "Gledate kako {{@ style (color $color)}}pas{{/}} sretno pomaže {{@ style (color $color)}}dječacima{{/}} iz {{@ style (color $color)}}skladišta{{/}} nositi {{@ style (color $color)}}vreće{{/}} i ostali {{@ style (color $color)}}teret{{@ style (color $defaultColor)}}. {{/}}{{/}}Na kraju dana, zahvalni {{@ style (color $color)}}predradnik{{/}} vam uručuje mali {{@ style (color $color)}}paket{{/}} kao zahvalu za koristan šteneći rad."

msgid "text/event_30"
msgstr "Danas je vaš {{@ style (color $color)}}pas {{/}}pomogao često zaboravljenom {{@ style (color $color)}}uslužnom {{/}}{{@ style (color $color)}}osoblju{{@ style (color $defaultColor)}}. {{/}}{{/}}Marljivi {{@ style (color $color)}}pas {{/}}je nosio {{@ style (color $color)}}sredstva {{/}}{{@ style (color $color)}}za čišćenje {{/}}i čak pokušao {{@ style (color $color)}}vući {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}krpu {{/}}po {{@ style (color $color)}}podu {{/}}bez ičije pomoći. Takav {{@ style (color $color)}}šeprtljavi {{/}}ali {{@ style (color $color)}}odlučni {{/}}{{@ style (color $color)}}trud {{/}}je svima podigao {{@ style (color $color)}}moral {{/}}za ostatak {{@ style (color $color)}}dana{{/}}."

msgid "text/event_4"
msgstr "{{@ style (color $color)}}Pas{{/}} je dovukao {{@ style (color $color)}}drveni {{/}}{{@ style (color $color)}}sanduk{{/}} pun čudnog, rasparenog {{@ style (color $color)}}alata{{@ style (color $defaultColor)}}. {{/}}{{/}}Nitko ne zna odakle je došao, ali izgleda da ga je netko namjerno {{@ style (color $color)}}spakirao{{/}}."

msgid "text/event_5"
msgstr "{{@ style (color $color)}}Pas {{/}}je pronašao {{@ style (color $color)}}konzervu {{/}}sa {{@ style (color $color)}}švedskom {{/}}{{@ style (color $color)}}naljepnicom{{@ style (color $defaultColor)}}. {{/}}{{/}}Odgirzavši {{@ style (color $color)}}{{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}poklopac{{/}}, počeo je sumanuto {{@ style (color $color)}}trčati {{/}}{{@ style (color $color)}}za {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}vojnicima {{/}}koji su {{@ style (color $color)}}bježali {{/}}od odvratnog {{@ style (color $color)}}mirisa {{/}}{{@ style (color $color)}}konzerve{{@ style (color $defaultColor)}}. {{/}}{{/}}Jedan od {{@ style (color $color)}}ljudi {{/}}koji je protrčavao vam je ponudio {{@ style (color $color)}}nagradu {{/}}da zaustavite {{@ style (color $color)}}mučenje{{/}}."

msgid "text/event_6"
msgstr "Jedan od {{@ style (color $color)}}kuhara{{/}} je proveo cijeli dan lijepeći {{@ style (color $color)}}postere{{/}} o {{@ style (color $color)}}nestalom{{/}}{{@ style (color $color)}} mačiću{{/}} po {{@ style (color $color)}}Garaži{{@ style (color $defaultColor)}}. {{/}}{{/}}Vaš {{@ style (color $color)}}pas{{/}} je odlučio pomoći u {{@ style (color $color)}}potrazi{{/}} i, nakon nekoliko sati, je pronašao {{@ style (color $color)}}čupavog {{/}}{{@ style (color $color)}}bjegunca{{/}} koji se skrivao pored jedne od {{@ style (color $color)}}baraka{{/}}."

msgid "text/event_7"
msgstr "Vaš {{@ style (color $color)}}pas{{/}} je pronašao {{@ style (color $color)}}čudan {{/}}{{@ style (color $color)}}uređaj{{/}} i nosio ga okolo po {{@ style (color $color)}}Garaži{{/}} cijeli dan. Konačno ga je jedan od {{@ style (color $color)}}mehaničara{{/}} prepoznao kao {{@ style (color $color)}}rezervnu {{/}}{{@ style (color $color)}}komponentu {{/}}{{@ style (color $color)}}tenka{{/}} i pažljivo ga odnio u {{@ style (color $color)}}radionicu{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Pas{{/}} je bio vrlo ponosan na svoje {{@ style (color $color)}}otkriće{{@ style (color $defaultColor)}}. {{/}}{{/}}Što god to bilo, izgleda da ćete biti {{@ style (color $color)}}nagrađeni{{/}} za {{@ style (color $color)}}pronalazak{{/}}."

msgid "text/event_8"
msgstr "Danas je bio {{@ style (color $color)}}pun{{/}}{{@ style (color $color)}} mjesec{{@ style (color $defaultColor)}}. {{/}}{{/}}Opčinjen {{@ style (color $color)}}mjesečinom{{/}}, {{@ style (color $color)}}pas{{/}} je zavijao gotovo bez prestanka do {{@ style (color $color)}}jutra{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Vojnici{{/}} koji su se probudili su pokušavali sve da smire {{@ style (color $color)}}štenca{{/}}, ali ništa nije pomoglo."

msgid "text/event_9"
msgstr "Tijekom {{@ style (color $color)}}testiranja{{/}} izbio je {{@ style (color $color)}}požar{{/}} na jednom od {{@ style (color $color)}}tenkova{{@ style (color $defaultColor)}}. {{/}}{{/}}Prije nego je itko morao reagirati, vaš {{@ style (color $color)}}pas{{/}} je uletio u {{@ style (color $color)}}goruće {{/}}{{@ style (color $color)}}vozilo {{/}}i pomogao {{@ style (color $color)}}posadi{{/}} u {{@ style (color $color)}}bijegu{{@ style (color $defaultColor)}}. {{/}}{{/}}Priča o takvoj {{@ style (color $color)}}hrabrosti{{/}} se brzo proširila {{@ style (color $color)}}bazom{{/}}."

