msgid "battleship/name"
msgstr "Dimni signal"

msgid "battleship/shortDescr"
msgstr "Dimni signal koji obilježava područje topničkog plotuna bojnog broda koji nanosi štetu neprijateljskoj opremi i objektima."

msgid "distraction_ability/name"
msgstr "Lažna zapovijed"

msgid "distraction_ability/shortDescr"
msgstr "Neka Gefr. Keller koristi zarobljeni njemački radio za odašiljanje lažne zapovijedi koja će uputiti neprijatelja na određenu lokaciju."

msgid "recon_ability/name"
msgstr "Izviđanje"

msgid "recon_ability/shortDescr"
msgstr "Pošaljite satnika Duboisa na izviđanje na određeni položaj. Kada je u izvidnici, tenk se zaustavlja i ostaje na mjestu. Sposobnost nastavlja s radom do otkazivanja."

msgid "scc_airstrike_ability/name"
msgstr "Zračna potpora"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Pozovite zračni udar na određeni položaj."
