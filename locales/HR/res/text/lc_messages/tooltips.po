msgid "advanced/ARMOR_PIERCING"
msgstr "Najuobičajeniji tip granate koji uzrokuje štetu samo kada probije oklop vozila. Granata se može odbiti ako pogodi oklop pod kutom. Probojna snaga pancirnih granata opada s prijeđenom udaljenosti."

msgid "advanced/ARMOR_PIERCING_CR"
msgstr "Ima veliku brzinu i nanosi štetu samo kada probije oklop vozila. Granata se može odbiti ako pogodi oklop pod kutom. Probojna snaga potkalibarskih granata opada s prijeđenom udaljenosti."

msgid "advanced/ARMOR_PIERCING_CR_NOT_PIERCING_DAMAGE"
msgstr "Pored osnovnih prednosti i mana svojeg tipa, ova granata ima veću vjerojatnost nanijeti štetu čak i bez probijanja neprijateljskog oklopa."

msgid "advanced/ARMOR_PIERCING_CR_TRAY"
msgstr "APDS granate imaju prednosti i mane, ali šteta koju nanose ovisi o udaljenosti od mene. Nanose najveću štetu na udaljenostima do 50 metara."

msgid "advanced/ARMOR_PIERCING_NOT_PIERCING_DAMAGE"
msgstr "Pored osnovnih prednosti i mana svojeg tipa, ova granata ima veću vjerojatnost nanijeti štetu čak i bez probijanja neprijateljskog oklopa."

msgid "advanced/ARMOR_PIERCING_TRAY"
msgstr "APDS granate imaju prednosti i mane, ali šteta koju nanose ovisi o udaljenosti od mene. Nanose najveću štetu na udaljenostima do 50 metara."

msgid "advanced/HIGH_EXPLOSIVE"
msgstr "Nanose štetu čak i ako ne probije oklop. Ima veću vjerojatnost nanošenja štete, ali može biti malena. Eksplodira u dodiru s oklopom vozila ili preprekom. Ne može se odbiti od oklopa."

msgid "advanced/HIGH_EXPLOSIVE_MODERN"
msgstr "Može nanijeti HP štetu, oštetiti unutarnje module i ozlijediti članove posade čak i bez probijanja oklopa. Ima povećanu vjerojatnost nanošenja štete u usporedbi s drugim vrstama granata iako količina nanešene štete može biti mala. Može probiti tanku zaštitu i neke objekte koji se mogu uništavati, ali pritom gubi nešto probojnosti. Eksplodira ako oklop nije probijen."

msgid "advanced/HOLLOW_CHARGE"
msgstr "Ima povećanu probojnu snagu koja se značajno smanjuje ako se pogodi paravan. Kumulativne granate uzrokuju štetu samo nakon proboja oklopa vozila. Rikošeti su vrlo rijetki. Probojna snaga ove granate se ne smanjuje s prijeđenom udaljenosti."

msgid "advanced/LOW_CHARGE_SHOT/fireMode"
msgstr "Posebna mehanika"

msgid "advanced/LOW_CHARGE_SHOT/fireRate"
msgstr "omogućuje raniju paljbu"

msgid "advanced/LOW_CHARGE_SHOT/footer"
msgstr "%(fireMode)sza top vozila%(fireRate)s s promjenjenim parametrima granate."

msgid "advanced/additionalInvisibilityDevice"
msgstr "Učinkovitost ovisi o tipu vozila. Povećava skrovitost nepokretnog ili pokretnog vozila. Korisno za aktivno izviđanje kao i za pasivno izviđanje s rizičnih položaja."

msgid "advanced/aimingStabilizer"
msgstr "Poboljšava ciljanje: smanjuje rasipanje ciljnika tijekom paljbe, zakretanja kupole ili kretanja vozila."

msgid "advanced/antifragmentationLining"
msgstr "Umanjuje štetu od sudaranja i eksplozija fugasnih granata nakon neprobijanja, umanjuje trajanje ošamučenja posade i vjerojatnost ozljeđivanja članova posade."

msgid "advanced/autoExtinguishers"
msgstr "Automatski gasi požar u vozilu odmah pri zapaljenju. Pasivni učinak smanjuje vjerojatnost zapaljenja."

msgid "advanced/camouflageNet"
msgstr "Umanjuje vidljivost vozila na kratko vrijeme nakon što se vozilo zaustavi. Učinak se isključuje ako se vozilo pomakne unaprijed ili unatrag i kada se okreće trup (osim za vozila za hidropneumatskim ovjesom u režimu opsade)."

msgid "advanced/coatedOptics"
msgstr "Povećava vidokrug vašeg vozila što omogućuje rano osmatranje neprijateljskih vozila."

msgid "advanced/commander"
msgstr "Utječe na vidokrug. Blago poboljšava učinkovitost ostalih članova posade."

msgid "advanced/commandersView"
msgstr "Smanjuje skrovitost nepokretnih i pokretnih neprijateljskih vozila iza raslinja."

msgid "advanced/demountKit/common"
msgstr "Demontiraj standardnu opremu ili nagradnu opremu bez trošenja valute igre."

msgid "advanced/driver"
msgstr "Utječe na dinamičke karakteristike vozila."

msgid "advanced/economyBonds"
msgstr "Rijetka posebna valuta koja se koristi za kupnju jedinstvenih predmeta."

msgid "advanced/economyConvertExp"
msgstr "Možete koristiti ovaj resurs igre za istraživanje bilo kojeg vozila ili modula te za obuku vaše posade."

msgid "advanced/economyCredits"
msgstr "Glavna valuta u igri. Zarađuje se u bitkama ili kupuje zlatom."

msgid "advanced/economyGold"
msgstr "Predstavlja premium valutu koja se može utrošiti u razne svrhe."

msgid "advanced/economyPremium"
msgstr "Daje 50% više iskustva i kredita nakon svake bitke kao i dodatne mogućnosti."

msgid "advanced/economyPremium/header"
msgstr "WoT premium račun"

msgid "advanced/economyTankExperience"
msgstr "Resurs igre koji se zarađuje u bitci. Iskustvo se koristi za istraživanje novih modula i vozila."

msgid "advanced/enhancedAimDrives"
msgstr "Smanjuje vrijeme ciljanja ciljnika"

msgid "advanced/equipment"
msgstr "Oprema značajno poboljšava karakteristike vašeg vozila. Može se demontirati korištenjem kompleta za demontiranje ili valutom igre i montirati na druga vozila."

msgid "advanced/excellentFuel"
msgstr "Povećava snagu motora i brzinu zakretanja kupole tijekom trajanja bitke."

msgid "advanced/extraHealthReserve"
msgstr "Povećava HP vozila. Poboljšava izdržljivost ovjesa, kao i brzinu popravaka. Potpuno obnavlja HP ovjesa nakon popravaka."

msgid "advanced/gamemodeRandom"
msgstr "Bitka s automatskim podešavanjem saveznika i neprijatelja."

msgid "advanced/gamemodeSpecial"
msgstr "Sudjelovanje u prvenstvima, turnirima i bitkama na Globalnoj mapi."

msgid "advanced/gamemodeStronghold"
msgstr "Bitke za industrijske resurse protiv neprijateljskih odreda."

msgid "advanced/gamemodeTeam"
msgstr "Bitka između prethodno stvorenih ravnopravnih timova."

msgid "advanced/gamemodeTraining"
msgstr "Bitka s ručnim uparivanjem saveznika i neprijatelja."

msgid "advanced/grousers"
msgstr "Povećava brzinu zakretanja vozila. Smanjuje gubitak ubrzanja na svim tipovima terena."

msgid "advanced/gunner"
msgstr "Utječe na ciljanje topa, preciznost paljbe, brzinu zakretanja kupole i brzinu zakretanja topa."

msgid "advanced/handExtinguishers"
msgstr "Gasi požar u vašem vozilu prilikom aktiviranja."

msgid "advanced/header/shellType/ARMOR_PIERCING"
msgstr "AP granata"

msgid "advanced/header/shellType/ARMOR_PIERCING_CR"
msgstr "APCR granata"

msgid "advanced/header/shellType/HIGH_EXPLOSIVE"
msgstr "HE granata"

msgid "advanced/header/shellType/HOLLOW_CHARGE"
msgstr "HEAT granata"

msgid "advanced/improvedConfiguration"
msgstr "Poboljšava brzinu popravka i HP spremišta streljiva, rezervoara i motora. Smanjuje kaznu od oštećenog spremišta streljiva i motora i smanjuje vjerojatnost požara motora. Sprječava jedan požar rezervoara, eksploziju spremišta streljiva i uništenje motora u bitci."

msgid "advanced/improvedRadioCommunication"
msgstr "Povećava vrijeme u kojem neprijatelj ostaje otkriven i smanjuje vrijeme vaše otkrivenosti."

msgid "advanced/improvedRotationMechanism"
msgstr "Smanjuje rasipanje ciljnika tijekom paljbe, zakretanja kupole ili kretanja vozila i povećava brzinu zakretanja kupole i trupa."

msgid "advanced/improvedSights"
msgstr "Smanjuje veličinu kruga ciljanja kako bi se povećala preciznost potpuno naciljanog topa. Slijedom toga vaš top ima veću vjerojatnost pogađanja mete."

msgid "advanced/improvedVentilation"
msgstr "Poboljšava sposobnosti posade koje utječu na karakteristike vozila."

msgid "advanced/info"
msgstr "Dodatne informacije"

msgid "advanced/instructions"
msgstr "Djeluje tijekom jedne bitke. Ovisno o tipu, povećava učinak montirane opreme ili poboljšava obučene ili aktivira još uvijek neobučene sposobnosti članova posade."

msgid "advanced/largeMedkit"
msgstr "Trenutno liječi ozlijeđenog člana posade i uklanja učinak ošamućenja. Pasivni učinak poboljšava zaštitu posade i umanjuje trajanje ošamućenja."

msgid "advanced/largeRepairkit"
msgstr "Trenutno popravlja sve oštećene module. Pasivni učinak ubrzava vrijeme popravka."

msgid "advanced/loader"
msgstr "Utječena vrijeme punjenja topa."

msgid "advanced/modernizedAimDrivesAimingStabilizer"
msgstr "Umanjuje vrijeme ciljanja nišana i rasipatnje tijekom paljbe, zakretanja kupole ili kretanja vozila."

msgid "advanced/modernizedExtraHealthReserveAntifragmentationLining"
msgstr "Povećava HP vozila i njegove unutarnje module. Povećava HP ovjesa i brzinu popravka. Smanjuje kaznu od oštećenog spremišta streljiva i motora. Potpuno obnavlja HP ovjesa nakon popravka."

msgid "advanced/modernizedImprovedSightsEnhancedAimDrives"
msgstr "Smanjuje veličinu kruga ciljanja i vremena ciljanja končanice"

msgid "advanced/modernizedTurbochargerRotationMechanism"
msgstr "Povećava snagu motora i najveću brzinu. Smanjuje rasipanje ciljnika tijekom paljbe, zakretanja kupole ili kretanja vozila i povećava brzinu zakretanja kupole i trupa."

msgid "advanced/qualityFuel"
msgstr "Povećava snagu motora i brzinu zakretanja kupole tijekom trajanja bitke."

