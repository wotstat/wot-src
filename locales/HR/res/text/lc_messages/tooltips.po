msgid "notrecruitedtankman/onslaught_p3_3/label"
msgstr "Navala. Godina Pegaza"

msgid "notrecruitedtankman/onslaught_p3_4/desc"
msgstr "Kao majstor tetovaže na Floridi, Andy je stekao reputaciju pričalice koja satima može sa svakim pričati o bilo čemu. Nakon što se prijavio u vojsku, Andyeva zarazna karizma je našla još prijemčljiviju publiku s njegovom prirodnom sposobnošću da ujedini tenkiste što ga čini dušom (\"Soul\") njegove posade."

msgid "notrecruitedtankman/onslaught_p3_4/howToGetInfo"
