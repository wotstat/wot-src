msgid "Durden/Name"
msgstr "Cornelius"

msgid "Eekeeboo/Descr"
msgstr "Tenkist stručnjak ugodnog glasa koga se možda sjećate iz Tenkovske Akademije ili jedne od mnogih slučajeva kada je pronađen izvrnut na bojišnici. Čak i ako se ne sjećate, pogledajte ga!"

