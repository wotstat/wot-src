msgid "shotPassion/battleDescr"
msgstr "Na %(duration)s s umanjuje učinkovitost poboljšanja i stabilizacije topa za %(gunAimingTime)s, ali svaki probijajući hitac koji pogodite će povećati vašu nanešenu štetu za %(damageIncreasePerShot)s. Slaže se do 5 puta. Pogoci bez štete ili promašaji poništavaju slaganje bonusa štete na 0.\n\n*Pogoci električnog izboja se računaju ka slaganju bonusa štete."

msgid "shotPassion/descr"
msgstr "Na %(duration)s s umanjuje učinkovitost poboljšanja i stabilizacije topa za %(gunAimingTime)s, ali svaki probijajući hitac koji pogodite će povećati vašu nanešenu štetu za %(damageIncreasePerShot)s. Slaže se do 5 puta. Pogoci bez štete ili promašaji poništavaju slaganje bonusa štete na 0.\n\n*Pogoci električnog izboja se računaju ka slaganju bonusa štete."

msgid "shotPassion/longDescr"
msgstr "{whiteSpanish_Open}Na %(duration)s s{whiteSpanish_Close} umanjuje učinkovitost poboljšanja i stabilizacije topa {red_Open}za %(gunAimingTime)s{red_Close}, ali svaki probijajući hitac koji pogodite će povećati vašu nanešenu štetu {green_Open}za %(damageIncreasePerShot)s.{green_Close} Slaže {whiteSpanish_Open}se do 5 puta{whiteSpanish_Close}. Pogoci bez štete ili promašaji poništavaju slaganje bonusa štete na 0.\n\n*Pogoci električnog izboja se računaju ka slaganju bonusa štete."

msgid "shotPassion/name"
msgstr "Rastući zanos"

msgid "shotPassion/shortDescr"
msgstr "{whiteSpanish_Open}Na %(duration)s s{whiteSpanish_Close} umanjuje učinkovitost poboljšanja i stabilizacije topa {red_Open}za %(gunAimingTime)s{red_Close}, ali svaki probijajući hitac koji pogodite će povećati vašu nanešenu štetu {green_Open}za %(damageIncreasePerShot)s.{green_Close} Slaže {whiteSpanish_Open}se do 5 puta{whiteSpanish_Close}. Pogoci bez štete ili promašaji poništavaju slaganje bonusa štete na 0.\n\n*Pogoci električnog izboja se računaju ka slaganju bonusa štete."

