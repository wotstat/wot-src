msgid "selfBuff/battleDescr"
msgstr "Na %(duration)s s smanjuje rasipanje topa i vrijeme ciljanja za %(gunAimingTime)s te poboljšava stabilizaciju topa i brzinu paljbe. \n\n*Ne utječe na vrijeme između ispaljivanja granate i punjenja sljedeće granate u spremnik, top ili kontejner."

msgid "selfBuff/descr"
msgstr "Na %(duration)s s smanjuje rasipanje topa i vrijeme ciljanja za %(gunAimingTime)s te poboljšava stabilizaciju topa i brzinu paljbe. \n\n*Ne utječe na vrijeme između ispaljivanja granate i punjenja sljedeće granate u spremnik, top ili kontejner."

msgid "selfBuff/longDescr"
msgstr "{whiteSpanish_Open}Na %(duration)s s{whiteSpanish_Close} smanjuje rasipanje topa i {green_Open}vrijeme ciljanja za %(gunAimingTime)s{green_Close} te poboljšava stabilizaciju topa i brzinu paljbe. \n\n*Ne utječe na vrijeme između ispaljivanja granate i punjenja sljedeće granate u spremnik, top ili kontejner."

