msgid "serviceChannelMessages/resourceWell/enabled/text"
msgstr "Radionica je ponovno otvorena!"

msgid "serviceChannelMessages/resourceWell/end/text"
msgstr "Započinjemo rad na slijedećem projektu. Javit ćemo vam kada završimo razvoj. Vidimo se uskoro!"

msgid "serviceChannelMessages/resourceWell/end/title"
msgstr "Radionica se zatvara"

msgid "serviceChannelMessages/resourceWell/noSerialVehicles/text"
msgstr "Završena je isporuka vozila s brojevima. Počinjemo sastavljati %(vehicle)s u standardnoj konfiguraciji. Požurite, broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/noVehicles/text"
msgstr "Sastavljanje vozila završeno. Sva vozila su isporučena svojim vlasnicima."

msgid "serviceChannelMessages/resourceWell/noVehicles/title"
msgstr "Izvješće radionice"

msgid "serviceChannelMessages/resourceWell/noVehicles/twoParallelProducts/text"
msgstr "Isporuka %(soldOutVehicle)s završena. Još imate priliku kupiti %(availableVehicle)s. Ako ste potrošili resurse, ali niste na vrijeme završili kupnju, oni će vam biti uskoro vraćeni na račun. Požurite, broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/noVehiclesWithReturn/text"
msgstr "Sastavljanje vozila završeno. Sva vozila su isporučena svojim vlasnicima. Svi utrošeni resursi će uskoro biti vraćeni na vaš račun."

msgid "serviceChannelMessages/resourceWell/oneVehicleStart/text"
msgstr "Zapovjedniče, imate priliku postati vlasnik %(vehicle)s s numeriranim 3D stilom. Broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/pause/text"
msgstr "Radionica je privremeno nedostupna zbog održavanja."

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/additionalText"
msgstr "Broj stila: %(serialNumber)s"

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/text"
msgstr "Jedinstveno vozilo %(vehicle)s primljeno iz radionice."

msgid "serviceChannelMessages/resourceWell/reward/title"
msgstr "%(vehicle)s primljeno!"

msgid "serviceChannelMessages/resourceWell/reward/vehicle/text"
msgstr "%(vehicle)s primljeno iz radionice."

msgid "serviceChannelMessages/resourceWell/start/title"
msgstr "Radionica je otvorena"

msgid "serviceChannelMessages/resourceWell/twoVehiclesStart/text"
msgstr "Zapovjedniče, ovo je vaša prilika da zgrabite %(firstVehicle)s i %(secondVehicle)s! Ali budite brzi, zalihe su ograničene!"
