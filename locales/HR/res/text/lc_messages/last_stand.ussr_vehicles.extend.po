msgid "R20_T-44_LS_PLAYER"
msgstr "T-44"

msgid "R20_T-44_LS_PLAYER_descr"
msgstr "Referentni uzorak vozila označenog kao T-44A. Razvijen od strane konstrukcijskog ureda tvornice No. 183. Vozilo je ušlo u službu 23. studenog 1944., ali nikad nije bilo u borbi. Od kraja studenog 1944. do rujna 1945. je ukupno izrađeno 570 vozila."

