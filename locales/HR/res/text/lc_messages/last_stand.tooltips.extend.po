msgid "Contact/status/inBattle/last_stand"
msgstr "U bitci Posljednjeg uporišta"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Ispaljuje hitac koji oštećuje metu i sva neprijateljska vozila unutar polumjera od 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Ispaljuje hitac koji obnavlja HP tako da ga krade od mete i obližnjih neprijateljskih vozila unutar polumjera od 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila unutar polumjera od 35 m."

msgid "advanced/ls_damageShield"
msgstr "Štiti protiv bilo koje štete (osim utapanja, sudaranja i udara) na 10 sekundi."

msgid "advanced/ls_doubleDamage"
msgstr "Vaš sljedeći uspješni hitac nanosi dvostruku štetu."

msgid "advanced/ls_equipment"
msgstr "Taktičke naprave vam omogućuju učinkovitiju borbu u bitkama Posljednjeg uporišta, završavanje etapa i osvajanje vrijednih nagrada. Za opremanje, kliknite na jedno od mjesta taktičkih naprava."

msgid "advanced/ls_extraDamageSituational"
msgstr "Daje priliku za nanošenje povećane štete neprijateljskom vozilu."

msgid "advanced/ls_fastReload"
msgstr "Povećava brzinu paljbe / puni spremnik"

msgid "advanced/ls_healSituational"
msgstr "Obnavlja nešto HP nakon uništenja neprijateljskog vozila."

msgid "advanced/ls_invisibility"
msgstr "Privremeno onemogućuje neprijatelju ciljanje vašeg vozila, obnavlja HP po sekundi, popravlja module, gasi požar, uklanja učinak ošamućenja i liječi sve ozlijeđene članove posade."

msgid "advanced/ls_nitro"
msgstr "Privremeno pojačava pokretljivost vašeg vozila."

msgid "advanced/ls_nitroSituational"
msgstr "Privremeno povećava pokretljivost vašeg vozila nakon primanja štete od neprijateljskog vozila."

msgid "advanced/ls_selfRepairKit"
msgstr "Obnavlja HP, gasi požar, uklanja učinak ošamućenja i popravlja oštećene module."

msgid "advanced/ls_teamRepairKit"
msgstr "Popravlja oštećene module, gasi požar, uklanja učinak ošamućenja i obnavlja nešto HP savezničkim vozilima unutar svojeg polumjera."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktičke naprave se mogu opremiti u posebna mjesta i pomažu vam učinkovitije se boriti u bitkama Posljednjeg uporišta, završavanju etapa i osvajanju vrijednih nagrada."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Mjesta taktičkih naprava"
