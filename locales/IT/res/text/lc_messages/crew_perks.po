msgid "driver_tidyPerson/maxLvlDescription"
msgstr "Una volta addestrato completamente, riduce le {greenBright_Start}probabilità di incendio del motore{greenBright_End} del %(vehicleFireChance)s&zwnbsp;."

msgid "driver_tidyPerson/name"
msgstr "Meccanico pignolo"

