msgid "KZ_V8"
msgstr "KZ V8"

msgid "LTP"
msgstr "LTP"

msgid "LTP_descr"
msgstr "Proposta di veicolo leggero sviluppata dal tenente Provornov nell'estate del 1942. Non venne prodotto alcun prototipo."

