msgstr "nplurals=2; plural=(n != 1);"

msgid "mode/fort_rush_battle/condition"
msgstr "7 contro 7 %(parSecondary_open)sI%(parSecondary_close)s livello&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Assumi il controllo delle antenne. Mantieni il controllo della rete. Fai in modo che la trasmissione possa avvenire senza intoppi."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Le prestazioni del tuo computer sono insufficienti per questa modalità. Potresti riscontrare problemi con grafica e movimento dei veicoli. Sono possibili anche crash del client di gioco."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Basse prestazioni"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Basse prestazioni"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Questa modalità richiede prestazioni del computer elevate. Riscontrerai problemi con caricamento di mappe, grafica e movimento dei veicoli. In caso di prestazioni insufficienti, prova ad abbassare la qualità grafica dalle Impostazioni."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Prestazioni ridotte"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Prestazioni ridotte"
