msgstr "Pz.Kpfw. VI H\nAusf. H2"

msgid "PzVI_MapsTraining_Player_HT_2"
msgstr "Tiger I (tr.)"

msgid "PzVI_Porsche_Turm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_Porsche_Turm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger\nAusf. E"

msgid "PzVI_Standardketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H1"

msgid "PzVI_Vetstaerktketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "Lo sviluppo è iniziato nel 1937 dalla Henschel. È entrato in produzione di massa nel 1942 con un totale di 1354 veicoli costruiti. Utilizzato per la prima volta in combattimento nella battaglia di Leningrado. Fu visto in azione in Tunisia e durante la Battaglia di Kursk. Anche se la produzione fu interrotta nell'estate del 1944, il Tiger I, fu usato in battaglia fino alla fine della guerra."

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

msgid "PzV_PzIV_CN"
msgstr "Pz.Kpfw. V Berge-Panther"

msgid "PzV_PzIV_CN_descr"
msgstr "Questo veicolo fu prodotto dalla compagnia di manutenzione e riparazione del 653° battaglione cacciacarri pesanti, utilizzando un Bergepanther ARV e la torretta di un Pz. IV."

msgid "PzV_PzIV_CN_short"
msgstr "Pz. V BP"

msgid "PzV_PzIV_ausf_Alfa"
