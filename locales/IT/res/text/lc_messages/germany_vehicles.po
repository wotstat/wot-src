msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Sviluppato dalle industrie ČKD per l'esercito cecoslovacco nel 1938. Durante l'occupazione tedesca questo veicolo fu utilizzato dalla Wehrmacht durante le campagne di Polonia, di Francia e sul Fronte Orientale. Rimase in servizio sulla linea del fronte fino al 1942. Furono prodotti circa 1400 esemplari, nelle otto versioni (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

