msgid "boxTooltip/description/text/bronze"
msgstr "Una volta aperte, queste casse potrebbero farti ottenere veicoli Premium di livello VIII, valute di gioco e altre preziose ricompense."

msgid "boxTooltip/description/text/gold"
msgstr "Una volta aperte, queste casse potrebbero farti ottenere rari veicoli di livello X, valute di gioco e altre preziose ricompense."

msgid "boxTooltip/description/text/silver"
msgstr "Una volta aperte, queste casse potrebbero farti ottenere veicoli Premium di livello IX, valute di gioco e altre preziose ricompense."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Può essere ottenuta come regalo per l'acquisto di articoli nel Negozio Premium, nonché ricevuta quando si aprono casse di qualsiasi altro tipo."

msgid "boxTooltip/howGet/text/gold"
msgstr "Si può ricevere aprendo casse di qualsiasi altro tipo."

msgid "boxTooltip/howGet/text/silver"
msgstr "Si può ricevere aprendo casse di qualsiasi altro tipo."

