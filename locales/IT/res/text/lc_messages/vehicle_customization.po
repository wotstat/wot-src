msgid "special_style/bp2021_5_2_desc"
msgstr "Uno stile per tutte le stagioni conferito in una determinata Fase della Stagione V di Pass di battaglia."

msgid "special_style/bp2021_5_3"
msgstr "Vento del sud"

msgid "special_style/bp2021_5_3_desc"
msgstr "Uno stile per tutte le stagioni conferito in una determinata Fase della Stagione V di Pass di battaglia."

