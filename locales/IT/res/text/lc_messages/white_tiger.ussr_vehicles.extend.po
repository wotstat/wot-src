msgid "_100mm_UBR-412PB_WT_descr"
msgstr "Orgoglio degli armaioli dell'Alleanza"

msgid "_100mm_UBR-412PB_WT_long_special"
msgstr "Ogni Generatore sovraccaricato caricherà il Proiettile d'argento con del Plasma. Più sono le Cariche, maggiore sarà il danno causato dal Plasma. Spara quando lo scudo del Blitzträger non è in funzione per causare il massimo dei danni."

msgid "_100mm_UBR-412PB_WT_short_special"
msgstr "Danno aggiuntivo con il Plasma"
