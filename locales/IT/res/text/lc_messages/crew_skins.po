msgstr "Un medico della squadra internazionale della nave spaziale Miracle, che ha raggiunto con successo Marte."

msgid "cosm_george/LastName"
msgstr "George"

msgid "cosm_george/Name"
msgstr "Monica"

msgid "cosm_horton/Descr"
msgstr "Un ingegnere ricercatore della squadra internazionale della nave spaziale Miracle, che ha raggiunto con successo Marte."

msgid "cosm_horton/LastName"
msgstr "Horton"

msgid "cosm_horton/Name"
