msgid "mode/halloween/battlePassTooltip/body"
msgstr "Alcune missioni nell'evento {whiteSpanish_open}Babylon: Torre nera{whiteSpanish_close} ti permetteranno di ottenere Punti Pass di battaglia."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Punti Pass di battaglia"

msgid "mode/halloween/calendar"
msgstr "L'evento durerà per %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "L'evento terminerà tra %(date)s."

msgid "mode/halloween/description"
msgstr "Combatti e raccogli la materia.\nBattaglie con veicoli speciali."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Le prestazioni del tuo computer sono insufficienti per questa modalità. Potresti riscontrare problemi con grafica e movimento dei veicoli. Sono possibili anche crash del client di gioco."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Basse prestazioni"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Basse prestazioni"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Questa modalità richiede prestazioni del computer elevate.\nRiscontrerai problemi con caricamento di mappe, grafica e movimento dei veicoli. In caso di prestazioni insufficienti, prova ad abbassare la qualità grafica dalle Impostazioni."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Prestazioni ridotte"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Prestazioni ridotte"
