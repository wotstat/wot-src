msgid "comp7_light/deserter/cancel"
msgstr "Annulla"

msgid "comp7_light/deserter/message"
msgstr "La tua squadra ha bisogno di te! Abbandonare una battaglia prima della fine o prima che il tuo veicolo venga distrutto è considerata diserzione.\nCiò potrebbe {brown_open}portare a una sanzione disciplinare.{brown_close}"

