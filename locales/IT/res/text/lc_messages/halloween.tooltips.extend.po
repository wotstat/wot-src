msgid "Contact/status/inBattle/halloween"
msgstr "In una battaglia di Babylon: Torre nera"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Spara un colpo che danneggia e stordisce il bersaglio e tutti i veicoli nemici entro un raggio di 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Spara un colpo che ripristina integrità rubandola dal bersaglio e dai veicoli nemici circostanti entro un raggio di 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Spara un colpo che stordisce il bersaglio e tutti i veicoli nemici entro un raggio di 35 m."

msgid "advanced/hw_damageShield"
msgstr "Protegge da qualsiasi danno (a eccezione di speronamento, affondamento e impatto) per 7 secondi."

msgid "advanced/hw_fastReload"
msgstr "Aumenta la cadenza di fuoco / ricarica il caricatore."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Ripristina integrità, spegne gli incendi, rimuove l'effetto dello stordimento e ripara i moduli danneggiati."

msgid "advanced/hw_invisibility"
msgstr "Rende temporaneamente invisibile il tuo veicolo ai nemici, ripristina integrità, ripara i moduli, estingue gli incendi, rimuove l'effetto dello stordimento e cura tutti i membri dell'equipaggio feriti."

msgid "advanced/hw_teamRepairKit"
msgstr "Ripara i moduli danneggiati, estingue gli incendi, rimuove l'effetto dello stordimento e ripristina una parte di integrità ai veicoli alleati nel suo raggio."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Le Abilità di combattimento ti aiutano a combattere in modo più efficace nelle battaglie di Babylon: Torre nera, a completare gli obiettivi e a ottenere preziose ricompense. Per equipaggiarle, clicca su uno degli spazi dedicati alle Abilità di combattimento."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Spazi Abilità di combattimento"

msgid "hwShell/alt/description"
msgstr "%(bold)s può essere trovato in battaglia con una determinata probabilità dopo aver distrutto un nemico."

msgid "hwShell/alt/description/bold"
msgstr "Un proiettile alternativo"
