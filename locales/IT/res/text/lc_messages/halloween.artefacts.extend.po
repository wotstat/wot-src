msgid "hwAoeDrainEnemyHpInstantShot/name"
msgstr "Proiettile vampiresco"

msgid "hwAoeDrainEnemyHpInstantShot/onUse"
msgstr "Spara un colpo che ripristina integrità rubandola dal bersaglio e dai veicoli nemici circostanti entro un raggio di 35 m, oltre che riparare i moduli danneggiati e rimuovere l'effetto di stordimento."

msgid "hwAoeDrainEnemyHpInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDrainEnemyHpInstantShot/short_special"
msgstr "Spara un colpo che ripristina integrità rubandola dal bersaglio e dai veicoli nemici circostanti."

msgid "hwAoeStunInstantShot/always"
msgstr "?empty?"

msgid "hwAoeStunInstantShot/descr"
msgstr "Spara un colpo che stordisce il bersaglio e i veicoli nemici circostanti."

msgid "hwAoeStunInstantShot/long_special"
msgstr "Abilità di combattimento. Spara un colpo che stordisce il bersaglio e tutti i veicoli nemici entro un raggio di 35 m. Può essere usata più volte in una battaglia. Viene rimossa dopo essere stata usata almeno una volta in una battaglia.<br /><br />Disponibile solo durante l'evento <font color='#cbac77'>Progetto Babylon</font>.<br /><br />Con il prossimo aggiornamento, tutte le abilità non utilizzate saranno rimosse e sarà data una compensazione in crediti pari al 50% del loro costo."

