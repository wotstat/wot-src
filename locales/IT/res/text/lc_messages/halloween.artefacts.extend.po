msgid "hwAoeDrainEnemyHpInstantShot/descr"
msgstr "Spara un colpo che ripristina integrità rubandola dal bersaglio e dai veicoli nemici circostanti."

msgid "hwAoeDrainEnemyHpInstantShot/long_special"
