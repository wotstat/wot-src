msgid "alert"
msgstr "Non è possibile scegliere una Riserva di combattimento mentre si combatte attivamente."

msgid "description/one/reserve"
msgstr "Scegliendo ripetutamente la Riserva %(reserve_name)s\nne migliorerai le caratteristiche."

msgid "description/second/reserve"
msgstr "Scegliendo ripetutamente la Riserva %(first_reserve_name)s o %(second_reserve_name)s\nmigliorerai le caratteristiche di quella selezionata."

msgid "number_1"
msgstr "1º"

msgid "number_2"
msgstr "2º"

msgid "number_3"
msgstr "3º"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Schiera un campo minato attivo nell'area selezionata per un determinato periodo di tempo."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Causa danni considerevoli ai veicoli nemici in un'area a piccolo raggio."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Stordisce i veicoli nemici e causa danni medi in un'area a grande raggio."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Aggiunge un bonus alla qualificazione primaria del proprio equipaggio e di quelli alleati."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Fornisce un bonus a velocità di cattura, interruzione della cattura e rifornimento."

msgid "shortDescription/reserve/reconAbility"
msgstr "Avvista i veicoli nemici e rileva i campi minati."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Ripristina una determinata percentuale d'integrità del tuo veicolo."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Nasconde tutti i veicoli sia all'interno che dietro la cortina fumogena."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Fornisce un bonus al mimetismo e al raggio visivo. Riduce il mimetismo dei veicoli nemici."

msgid "title"
msgstr "%(number_name)s spazio per Riserva disponibile"
