msgid "rankedDivisionFighter_condition"
msgstr "• Ottenibile solo in Battaglie Classificate."

msgid "rankedDivisionFighter_descr"
msgstr "Prendi parte a uno specifico numero di battaglie in Divisioni di grado più alto della Divisione di qualificazione."

msgid "rankedStayingPower"
msgstr "Citius, Altius, Fortius! %(rank)s"

msgid "rankedStayingPower_condition"
