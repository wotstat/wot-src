msgid "Contact/status/inBattle/last_stand"
msgstr "In una battaglia di Ultima resistenza"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Spara un colpo che danneggia il bersaglio e tutti i veicoli nemici entro un raggio di 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Spara un colpo che ripristina integrità rubandola dal bersaglio e dai veicoli nemici circostanti entro un raggio di 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Spara un colpo che stordisce il bersaglio e tutti i veicoli nemici entro un raggio di 35 m."

msgid "advanced/ls_damageShield"
msgstr "Protegge da qualsiasi danno (a eccezione di speronamento, affondamento e impatto) per 10 secondi."

msgid "advanced/ls_doubleDamage"
msgstr "Il prossimo colpo che metti a segno causa il doppio dei danni."

msgid "advanced/ls_equipment"
msgstr "I Dispositivi tattici ti aiutano a combattere in modo più efficace nelle battaglie di Ultima resistenza, a completare le Fasi e a ottenere preziose ricompense. Per equipaggiarli, clicca su uno degli spazi dedicati ai Dispositivi tattici."

msgid "advanced/ls_extraDamageSituational"
msgstr "Fornisce una probabilità di causare danno aumentato a un veicolo nemico."

msgid "advanced/ls_fastReload"
msgstr "Aumenta la cadenza di fuoco / ricarica il caricatore."

msgid "advanced/ls_healSituational"
msgstr "Ripristina una parte dell'integrità dopo la distruzione di un veicolo nemico."

msgid "advanced/ls_invisibility"
msgstr "Impedisce temporaneamente ai nemici di prendere di mira il tuo veicolo, ripristina integrità, ripara i moduli, estingue gli incendi, rimuove l'effetto dello stordimento e cura tutti i membri dell'equipaggio feriti."

msgid "advanced/ls_nitro"
msgstr "Aumenta temporaneamente la mobilità del tuo veicolo."

msgid "advanced/ls_nitroSituational"
msgstr "Aumenta temporaneamente la mobilità del tuo veicolo dopo aver subito danni da un veicolo nemico."

msgid "advanced/ls_selfRepairKit"
msgstr "Ripristina integrità, spegne gli incendi, rimuove l'effetto dello stordimento e ripara i moduli danneggiati."

msgid "advanced/ls_teamRepairKit"
msgstr "Ripara i moduli danneggiati, estingue gli incendi, rimuove l'effetto dello stordimento e ripristina una parte di integrità ai veicoli alleati nel suo raggio."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "I Dispositivi tattici possono essere equipaggiati in spazi dedicati per aiutarti a combattere in modo più efficace nelle battaglie di Ultima resistenza, completare le Fasi e ottenere preziose ricompense."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Spazi dei Dispositivi tattici"
