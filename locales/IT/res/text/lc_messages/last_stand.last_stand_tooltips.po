msgid "bannerTooltip/available"
msgstr "Evento disponibile per %(timer)"

msgid "bannerTooltip/callToAction"
msgstr "%(mode) — Modalità di gioco. Clicca per scoprirla"

msgid "bannerTooltip/description"
msgstr "Una speciale modalità PvE che ti piazza di fronte a ondate di forze nemiche. Scegli il tuo veicolo preferito, distruggi i carri eco e resisti all'assalto. Ti attendono ricompense esclusive e tanto altro!"

