msgid "vo_sm_char10_m05_stg21_02"
msgstr "Ufficiale del QG: Testa di ponte Echo-5 messa in sicurezza. Carri in avanzata. Fornire fuoco di supporto completo."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Ufficiale del QG: Reindirizzare il supporto aereo per assistere l'avanzata dei carri armati."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Ufficiale del QG: Squadre di ingegneri, eliminate gli ostacoli per avanzare ulteriormente."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Ufficiale del QG: La spiaggia è libera. Inviamo le forze principali. Ottimo lavoro."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Ufficiale del QG: Difendete la posizione. Rinforzi in arrivo."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Ufficiale del QG: Proteggete la testa di ponte a qualunque costo."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Ufficiale del QG: Un altro carro, un'altra possibilità. Fai attenzione questa volta."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Ufficiale del QG: Stiamo terminando le riserve. Fatti valere, comandante."

