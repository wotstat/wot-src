msgid "vo_sm_char10_m05_stg04_02"
msgstr "Ufficiale del QG: I carri armati sono bloccati sulla spiaggia. Flotta, fornite supporto."

msgid "vo_sm_char10_m05_stg13_06"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg13_07"
