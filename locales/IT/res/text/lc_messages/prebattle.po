msgstr "Il cannone di un veicolo ha una dispersione maggiore quando si è in movimento. Rimani fermo, osserva il cerchio di dispersione del cannone attorno al reticolo e spara quando il puntamento è concluso."

msgid "hints/hint8/header"
msgstr "Dispersione del cannone"

msgid "hints/hint8/high"
msgstr "35 km/h"

msgid "hints/hint8/low"
msgstr "0 km/h"

