msgid "comp7/deserter/cancel"
msgstr "Annulla"

msgid "comp7/deserter/message"
msgstr "Questa battaglia non è ancora terminata. Se la lasci prima della fine, abbandonerai la tua squadra.\n{brown_open}Il tuo punteggio sarà ridotto e ti sarà impedito l'accesso alle battaglie in questa modalità.{brown_close}\nSei sicuro di voler lasciare la battaglia?"

msgid "comp7/deserter/msgTitle"
msgstr "Perderai Punti Classifica!"

msgid "comp7/deserter/submit"
msgstr "Diserta"

msgid "comp7/deserter/title"
msgstr "Diserzione dal campo di battaglia"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Hai violato il Regolamento di gioco sulla mappa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} alle {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Punti Classifica ti sono stati dedotti e sei stato temporaneamente bloccato dal prendere parte a battaglie nella modalità {whiteSpanish_Open}Aggressione{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Hai violato il Regolamento di gioco sulla mappa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} alle {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nSei stato temporaneamente bloccato dal prendere parte a battaglie nella modalità {whiteSpanish_Open}Aggressione{whiteSpanish_Close} e il tuo punteggio è stato ridotto."
