msgstr "Isolamento scarico"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Aumenta il mimetismo di un veicolo fermo o in movimento"

msgid "additionalInvisibilityDevice/long_special"
msgstr "L'efficacia dipende dal tipo di veicolo. Aumenta il mimetismo di un veicolo fermo o in movimento. È utile tanto per la ricognizione attiva quanto per il pattugliamento passivo da posizioni pericolose."

msgid "additionalInvisibilityDevice/name"
msgstr "Sistema di scarico silenzioso"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Aumenta il mimetismo di un veicolo fermo o in movimento."

