msgid "LS_damageShield/onUse"
msgstr "Crea uno scudo di energia che protegge per 10 secondi il tuo veicolo da qualsiasi danno, a eccezione di speronamento, affondamento e impatto."

msgid "LS_damageShield/restriction"
msgstr "?empty?"

msgid "LS_damageShield/short_special"
msgstr "Garantisce invulnerabilità."

msgid "LS_doubleDamage/always"
msgstr "?empty?"

