msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Il rapporto tra il danno totale causato e il numero di battaglie combattute durante una sessione. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Rapporto tra veicoli nemici distrutti e battaglie combattute."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Livello medio dei veicoli che hai pilotato per la sessione di gioco."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Il rapporto tra l'Exp totale ottenuta e il numero di battaglie combattute durante una sessione. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Il rapporto tra il danno totale bloccato e il numero di battaglie combattute durante una sessione. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Il rapporto tra danno causato su tuo avvistamento/danno causato dai tuoi alleati a veicoli da te immobilizzati distruggendone i cingoli o stordendoli e il numero di battaglie combattute in una sessione. Il delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Il rapporto tra i parametri \"Danno causato\" e \"Danno ricevuto\". La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Il rapporto tra il numero di veicoli nemici distrutti e il numero di volte che il veicolo del giocatore è stato distrutto. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Rapporto tra veicoli nemici avvistati e battaglie combattute nella sessione."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Percentuale delle battaglie totali combattute nelle quali il veicolo del giocatore non è stato distrutto."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Percentuale delle vittorie in Battaglie Casuali per la sessione. Il Delta mostra gli effetti della sessione di gioco in corso sul parametro totale."

msgid "propertyInfo/prop/descr/wins"
msgstr "Il numero di vittorie in Battaglie Casuali durante la sessione. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

msgid "propertyInfo/prop/descr/wtr"
msgstr "Il WTR risultante dai valori medi dell'intera sessione. La delta mostra gli effetti dell'attuale sessione di gioco sul parametro totale."

