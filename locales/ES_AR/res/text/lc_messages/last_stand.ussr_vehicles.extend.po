msgid "R20_T-44_LS_PLAYER"
msgstr "T-44"

msgid "R20_T-44_LS_PLAYER_descr"
msgstr "Una muestra de referencia del vehículo designado T-44A. Desarrollado por la Oficina de Construcción de la Planta n.º 183. El vehículo entró en servicio el 23 de noviembre de 1944, pero nunca entró en combate. Desde finales de noviembre de 1944 hasta septiembre de 1945, se fabricaron un total de 570 vehículos."

