msgid "alert"
msgstr "No puedes elegir una reserva de combate mientras luchas."

msgid "description/one/reserve"
msgstr "Si eliges varias veces la reserva %(reserve_name)s,\nmejorarás sus características."

msgid "description/second/reserve"
msgstr "Si eliges varias veces la reserva %(first_reserve_name)s o %(second_reserve_name)s,\nmejorarás las características de la que elijas."

msgid "number_1"
msgstr "1.°"

msgid "number_2"
msgstr "2.°"

msgid "number_3"
msgstr "3.°"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Despliega un campo minado activo en el área seleccionada durante cierto período."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Inflige mucho daño a los vehículos enemigos en un pequeño radio de acción."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Aturde a los vehículos enemigos e inflige una cantidad de daño intermedia en un radio amplio."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Agrega una bonificación a la cualificación principal de los tripulantes del jugador y sus aliados."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Otorga una bonificación a la velocidad de captura, al bloqueo de captura y al reabastecimiento."

msgid "shortDescription/reserve/reconAbility"
msgstr "Detecta vehículos enemigos y campos minados."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restaura cierto porcentaje de los puntos de vida de tu vehículo."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Oculta todos los vehículos dentro y detrás del humo."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Otorga una bonificación al ocultamiento y el alcance de visión. Reduce el ocultamiento de los vehículos enemigos."

msgid "title"
msgstr "El %(number_name)s espacio de reserva disponible"
