msgid "selectableRewardTooltip/discount/description"
msgstr "Un {{researchDiscount}} de descuento en investigación y un {{purchaseDiscount}} de descuento en la compra de un vehículo de nivel {{level}}. Se puede seleccionar cualquier vehículo investigable."

msgid "selectableRewardTooltip/discount/footer"
msgstr "El descuento de {{@ style (color $color)}}investigación{{/}} se agrega al descuento de los fragmentos de planos del vehículo. Se aplica el mayor descuento de {{@ style (color $color)}}compra{{/}} disponible."

