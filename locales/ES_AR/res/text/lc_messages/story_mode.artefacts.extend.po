msgid "battleship/name"
msgstr "Señal de humo"

msgid "battleship/shortDescr"
msgstr "Señal de humo que marca una zona para lanzar una salva de artillería de un acorazado, que daña el equipamiento y los objetos enemigos situados allí."

msgid "distraction_ability/name"
msgstr "Orden falsa"

msgid "distraction_ability/shortDescr"
msgstr "Haz que el soldado Keller use la radio alemana capturada y así transmitir una orden falsa a los enemigos para que investiguen una ubicación específica."

msgid "recon_ability/name"
msgstr "Explorar alrededores"

msgid "recon_ability/shortDescr"
msgstr "Envía al capitán Dubois a reconocer una ubicación específica. Cuando está en reconocimiento, el tanque se detiene y permanece inmóvil. La habilidad sigue activa hasta que se cancela."

msgid "scc_airstrike_ability/name"
msgstr "Apoyo aéreo"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Pide un ataque aéreo sobre una posición específica."
