msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Cajas bote dragón"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "CAJAS BOTE DRAGÓN"

msgid "entryPoint/tooltip/description"
msgstr "Son cajas especiales que contienen objetos únicos y valiosos del juego.\nPuedes conseguirlas en la tienda del juego o en la Tienda Premium."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Cajas bote dragón temporalmente no disponibles"

msgid "eventName/lowerCase"
msgstr "Doma al dragón, monta el viento"

msgid "eventName/upperCase"
msgstr "DOMA AL DRAGÓN, MONTA EL VIENTO"

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos incluidos en las cajas, las próximas veces que recibas vehículos de las cajas bote dragón obtendrás una compensación en oro equivalente al valor total del vehículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza que hay un vehículo de nivel VIII - IX cada %(guaranteed0)s cajas bote dragón. Si las abres y no consigues un vehículo de este tipo, obtendrás uno de nivel VIII - IX que aún no tengas cuando abras la caja %(guaranteed0)s&zwnbsp;. Cuando suceda, el contador se reiniciará."

msgid "noBoxesView/description/"
msgstr "No tienes cajas.\nPuedes conseguirlas en la tienda del juego."
