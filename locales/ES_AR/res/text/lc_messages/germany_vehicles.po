msgid "PzV_PzIV_ausf_Alfa_descr"
msgstr "El vehículo fue fabricado por la Compañía de Recuperación y Mantenimiento del 653rd Heavy Panzerjäger Battalion sobre la base del Bergepanther ARV y la torreta del Pz. IV."

