msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Desarrollado por la compañía ČKD para el ejército Checoslovaco en 1938. Durante la ocupación Alemana, el vehículo entró en servicio en la Wehrmacht y fue usado en las campañas de Polonia y Francia. El tanque entró en combate en la línea del frente hasta mediados de 1942. Aproximadamente 1.400 vehículos de ocho modificaciones (Ausf. A/B/C/D/E/F/S/G) fueron fabricados."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

