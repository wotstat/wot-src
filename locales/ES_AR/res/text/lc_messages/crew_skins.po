msgid "ny25_blogger03/Name"
msgstr "SantaBaby"

msgid "ny25_blogger04/Descr"
msgstr "Hüter des RNG und Beschützer der Paid Actors - der Hailand kommt und beschert euch gute Gefechte!"

msgid "ny25_blogger04/LastName"
