msgstr "Círc. disper. del cañón"

msgid "hints/hint12/description"
msgstr "La cantidad de blindaje que debe penetrar un disparo depende del ángulo en el que impacte: ¡el ángulo de impacto es un factor crucial que afecta a la penetración del disparo!"

msgid "hints/hint12/header"
msgstr "Ángulo de blindaje"

msgid "hints/hint12/notPenetrated/description"
msgstr "Inclin.: blindaje grueso"

msgid "hints/hint12/notPenetrated/header"
msgstr "No penetra"

msgid "hints/hint12/penetrated/description"
msgstr "Ángulo recto: blindaje más delgado"

msgid "hints/hint12/penetrated/header"
msgstr "Penetración"

msgid "hints/hint13/description"
msgstr "La comunicación por radio entre aliados funciona automáticamente. Si un vehículo es detectado por un enemigo, se vuelve visible para todos los enemigos dentro de su alcance de señal."

msgid "hints/hint13/header"
msgstr "Comunicación"

