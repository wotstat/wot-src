msgid "hints/confirmDialog/message"
msgstr "¡Estás en camino de convertirte en un tanquista profesional! A partir de ahora, las pantallas de carga de las batallas mostrarán la composición del equipo en lugar de los consejos para principiantes. Siempre puedes volver a activar los consejos en la Configuración, en el Menú del juego."

msgid "hints/confirmDialog/title"
msgstr "Nuevas pantallas de carga de batalla"

msgid "hints/hint1/description"
msgstr "No pierdas de vista el marcador de penetración situado en el centro de la retícula de tu cañón; su color te indica dónde puedes penetrar el blindaje del enemigo."

msgid "hints/hint1/green/description"
msgstr "Alta probabilidad de penetración"

msgid "hints/hint1/green/header"
msgstr "Marcador verde"

msgid "hints/hint1/header"
msgstr "Penetración de blindaje"

msgid "hints/hint1/red/description"
msgstr "Baja probabilidad de penetración"

msgid "hints/hint1/red/header"
msgstr "Marcador rojo"

msgid "hints/hint10/description"
msgstr "El cañón de tu vehículo siempre se desplaza hacia el centro de la pantalla, pero su velocidad de desplazamiento es limitada, por lo que puede tomar algún tiempo."

msgid "hints/hint10/header"
msgstr "Retícula del cañón"

msgid "hints/hint10/penetration/description"
msgstr "El verde indica los puntos débiles del blindaje enemigo"

msgid "hints/hint10/penetration/header"
msgstr "Indicador de penetración"

