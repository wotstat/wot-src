msgid "Contact/status/inBattle/last_stand"
msgstr "En una batalla de Batalla final"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Dispara un proyectil que daña al objetivo y a todos los vehículos enemigos ubicados en un radio de 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Dispara un proyectil que restaura los puntos de vida al robárselos al objetivo y a los vehículos enemigos cercanos ubicados en un radio de 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Dispara un proyectil que aturde al objetivo y a todos los vehículos enemigos ubicados en un radio de 35 m."

msgid "advanced/ls_damageShield"
msgstr "Te protege de todo el daño (excepto de embestidas, ahogamiento y los impactos por caídas) durante 10 segundos."

msgid "advanced/ls_doubleDamage"
msgstr "Tu próximo disparo exitoso causa el doble de daño."

msgid "advanced/ls_equipment"
msgstr "Los dispositivos tácticos son de gran ayuda para luchar en Batalla final, completar objetivos y ganar recompensas valiosas. Para equipar dispositivos tácticos, haz clic en uno de los espacios correspondientes."

msgid "advanced/ls_extraDamageSituational"
msgstr "Brinda una probabilidad de infligir más daño a un vehículo enemigo."

msgid "advanced/ls_fastReload"
msgstr "Aumenta la cadencia de fuego/recarga el cargador."

msgid "advanced/ls_healSituational"
msgstr "Restaura algunos puntos de vida tras destruir un vehículo enemigo."

msgid "advanced/ls_invisibility"
msgstr "Impide que los enemigos ataquen tu vehículo, restaura puntos de vida, repara módulos, apaga incendios, elimina el efecto de aturdimiento y cura a todos los tripulantes heridos."

msgid "advanced/ls_nitro"
msgstr "Aumenta temporalmente la movilidad de tu vehículo."

msgid "advanced/ls_nitroSituational"
msgstr "Tras recibir daño de un vehículo enemigo, aumenta temporalmente la movilidad de tu vehículo."

msgid "advanced/ls_selfRepairKit"
msgstr "Restaura puntos de vida, apaga los incendios, elimina el aturdimiento y repara los módulos dañados."

msgid "advanced/ls_teamRepairKit"
msgstr "Repara los módulos dañados, apaga los incendios, elimina el aturdimiento y restaura una parte de los puntos de vida de los vehículos enemigos ubicados dentro del radio de acción."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Los dispositivos tácticos se pueden equipar en espacios especiales para ayudarte a luchar mejor en las batallas de Batalla final, completar etapas y obtener recompensas valiosas."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Espacios de dispositivos tácticos"
