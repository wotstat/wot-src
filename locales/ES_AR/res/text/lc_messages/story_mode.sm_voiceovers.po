msgid "vo_sm_char10_m05_stg21_02"
msgstr "Oficial del Cuartel General: Cabeza de playa Eco-5 asegurada. Tanques avanzando. Apóyenlos con todo."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Oficial del Cuartel General: Redirijan el apoyo aéreo para ayudar al avance de los tanques."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Oficial del Cuartel General: Equipos de ingenieros, despejen los obstáculos para seguir avanzando."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Oficial del Cuartel General: Playa despejada. Enviando fuerzas principales. Excelente trabajo."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Oficial del Cuartel General: No se muevan; los refuerzos están en camino."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Oficial del Cuartel General: Protejan la cabeza de playa a toda costa."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Oficial del Cuartel General: Otro tanque, otra oportunidad. Ten cuidado esta vez."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Oficial del Cuartel General: Nos estamos quedando sin reservas. Que esta vez cuente, comandante."

