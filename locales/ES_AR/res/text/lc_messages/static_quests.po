msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Comienza una Batalla Aleatoria en un vehículo de cualquier nivel."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "¡Bienvenido al juego! ¡Enfrenta a otros aficionados del mundo y celebra victorias fenomenales!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Primera batalla"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Investiga y compra cualquier vehículo de nivel IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "La compra de un vehículo es algo especial. En cada nivel, los vehículos son más interesantes, y el estilo de juego también mejora con una tripulación entrenada."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Vehículo de nivel IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Lucha en tres Batallas Aleatorias en vehículos de nivel IV al X con cualquier elemento de personalización."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Puedes personalizar los vehículos cambiando su exterior con estilos predeterminados o crear el tuyo con camuflaje, inscripciones, emblemas y calcomanías."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Exterior del vehículo"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Comienza a entrenar cualquier pericia de un tripulante."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Los tripulantes pueden entrenar pericias adicionales para mejorar su eficacia u obtener nuevas capacidades."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Pericias de la tripulación"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Gana 150 000 créditos en Batallas Aleatorias en vehículos de nivel IV al X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Cuanto mayor sea el nivel de batalla, más créditos necesitarás para mantener el vehículo, reponer la munición y comprar módulos y equipamiento."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Acumulación de créditos"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Investiga y compra cualquier vehículo de nivel V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "El nivel V es donde comienzan a aparecer vehículos más serios y donde tu destreza en el juego se pone a prueba. Una tripulación bien entrenada te será muy útil."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Vehículo de nivel V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos de nivel V al X con tres piezas de equipamiento montadas."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "¿Ópticas revestidas o Ventilación mejorada? El equipamiento correcto puede potenciar las fortalezas de tu vehículo y reducir sus debilidades."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montar equipamiento"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Completa un escenario básico en el modo Topografía."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Para moverte por el campo de batalla con seguridad, es ideal conocer bien los caminos, las tácticas y los mapas, incluidos los objetos y las posiciones clave."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografía"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Completa cuatro escenarios avanzados de un mapa en Topografía."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Abre Topografía de vez en cuando para estudiar los mapas de las Batallas Aleatorias. En los cuatro escenarios, podrás explorar el sitio desde distintos ángulos."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Topografía avanzada"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos de nivel V al X con una reserva personal activada."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Al activarlas, puedes obtener bonificaciones a la XP de combate, la XP libre y la XP de tripulación o los créditos después de una batalla."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Reservas personales"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Quedar entre los 10 mejores jugadores del equipo según la XP obtenida seis veces en Batallas Aleatorias con vehículos de nivel V al X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "En estas misiones, puedes ganar cinco veces más XP en cada batalla. Tendrás que ganar y quedar entre los mejores 10 jugadores de tu equipo según XP obtenida."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 misiones de XP ×5"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Investiga un módulo y móntalo en un vehículo de cualquier nivel."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Después de cada batalla, ganarás XP de combate, que podrás usar para investigar nuevos módulos y así mejorar el rendimiento de tu vehículo."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "XP de combate"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Investiga y compra cualquier vehículo de nivel VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Con cada nivel, la investigación tomará más tiempo y más esfuerzo. La XP libre ayudará a avanzar más rápido, y una tripulación entrenada también será útil."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Vehículo de nivel VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Completa una misión personal en cualquier campaña."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Las campañas son grupos de misiones para distintos tipos de vehículos. Al completarlas, ganas recompensas útiles y vehículos únicos."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Misiones Personales"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Entrena una tripulación con un manual universal."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Los libros de tripulación añaden una determinada cantidad de XP a uno o a todos los tripulantes para acelerar considerablemente el entrenamiento."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Libros de tripulación"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos de nivel VI al X con una directiva de tripulación."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Las directivas mejoran las pericias de tripulación en una batalla. Como los consumibles, también se pueden comprar o recibir como recompensa."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Directivas para la tripulación"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Compra un Paquete de novato especial en la tienda del juego."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Puedes comprar todo lo que necesites en la tienda del juego, incluido oro, vehículos premium y mucho más. Encontrarás promociones regulares que ofrecen grandes rebajas."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Tienda"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos premium de nivel VI al X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "A estos vehículos no hace falta investigarlos, ganan más XP de combate, XP de tripulación y créditos, y te permiten transferir la tripulación sin reentrenarla."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Vehículos premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos de nivel VI al X con una directiva de equipamiento."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Las directivas permiten aumentar la eficacia del equipamiento montado. Al igual que los consumibles, las directivas se pueden comprar o recibir como recompensa."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Directivas de equipamiento"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Queda entre los 10 mejores jugadores de tu equipo según XP obtenida 15 veces en Batallas Aleatorias con vehículos de nivel VI al X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "En estas misiones, puedes ganar cinco veces más XP en cada batalla. Tendrás que ganar y quedar entre los mejores 10 jugadores de tu equipo según XP obtenida."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 misiones de XP ×5"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Investiga y compra cualquier vehículo de nivel VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Para este nivel de vehículo, hace falta más destreza. Los vehículos son más formidables y eficientes, al igual que tus oponentes."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Vehículo de nivel VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Lucha en 10 Batallas Aleatorias en vehículos de nivel VII - X con un kit de primeros auxilios grande, un kit de reparación grande y un matafuegos automático."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Cuando están equipados, los consumibles grandes reparan los módulos dañados más rápido que los chicos. También reducen la duración del aturdimiento y la probabilidad de incendio, y tienen un tiempo de recuperación más corto."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Consumibles grandes"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Recibe el doble de XP en tu primera victoria del día en Batallas Aleatorias en un vehículo de cualquier nivel."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Puedes recibir el doble de XP en tu primera victoria del día con cada vehículo. Aprovecha esta bonificación para mejorar tus vehículos más rápido."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Multiplicador de XP"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Crea un fragmento de plano para cualquier vehículo sin investigar."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Los planos brindan descuentos de XP y aceleran la investigación de un vehículo; se reciben como recompensa o transformando fragmentos universales y nacionales."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Planos de vehículo"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Queda entre los 10 mejores jugadores de tu equipo según XP obtenida 20 veces en Batallas Aleatorias con vehículos de nivel VII al X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "En estas misiones, puedes ganar cinco veces más XP en cada batalla. Tendrás que ganar y quedar entre los mejores 10 jugadores de tu equipo según XP obtenida."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 misiones de XP ×5"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Investiga y compra cualquier vehículo de nivel VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Los vehículos de nivel VIII requieren de todo tu conocimiento. Los enemigos no dejarán que te aburras, así que tendrás mucha acción y ganarás mucha experiencia."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Vehículo de nivel VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Usa XP libre para investigar cualquier módulo."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Si no tienes suficiente XP de combate para investigar un módulo o vehículo, puedes usar XP libre, que se gana en cualquier vehículo."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "XP libre"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Carga unos proyectiles alternativos y juega una Batalla Aleatoria en un vehículo de nivel III al X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Los proyectiles penetrantes, HE y APCR se utilizan en distintas situaciones de batalla. ¡Piensa bien antes de elegir para tener ventaja sobre los rivales!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munición"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Vende un módulo no utilizado del Depósito."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Los módulos, los proyectiles, el equipamiento, los consumibles y otros objetos no usados se guardan en el Depósito, y puedes venderlos para conseguir créditos."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depósito"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Gana 25 000 créditos en Batallas Aleatorias con vehículos de nivel III al X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Los créditos sirven para comprar proyectiles, vehículos nuevos y reparar vehículos, entre otras cosas. Es importante saber cómo ahorrarlos y usarlos bien."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Créditos"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Lucha en tres Batallas Aleatorias en vehículos de nivel III al X con consumibles en todos los espacios disponibles."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Los consumibles reparan el daño crítico del vehículo y sanan a la tripulación herida; es importante saber cuándo usarlos para sobrevivir en el campo de batalla."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Consumibles"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Lucha en tres Batallas Aleatorias en vehículos de nivel III al X con cualquier equipamiento montado."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Los vehículos pueden llevar equipamiento para mejorar algunas de sus características. La selección de equipamiento depende del vehículo y del estilo de juego."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Equipamiento"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografía"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Completa un escenario de cualquier mapa en Topografía."

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Tierra incógnita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Completa cuatro escenarios básicos de un mapa en Topografía."

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Reconocimiento"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Completa cuatro escenarios avanzados de un mapa en Topografía"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Un 10 en Geografía"
