msgid "autoOpenView/boxCount"
msgid_plural "plural/autoOpenView/boxCount"
msgstr[0] "%(count) módulo restante"
msgstr[1] "%(count) módulos restantes"
msgstr[2] "%(count) módulos restantes"

msgid "awardViews/footer/backButton/"
msgstr "Volver a los módulos"

msgid "boxTooltip/description/text/wt"
msgstr "Al abrir estos módulos, puedes conseguir vehículos premium, monedas del juego y otras recompensas valiosas."

msgid "boxTooltip/howGet/text/wt"
msgstr "Puedes encontrar los módulos en la tienda del juego."

msgid "common/boxCategory/lowerCase/wt"
msgstr "Módulo"

msgid "common/boxCategory/upperCase/wt"
msgstr "MÓDULO"

msgid "common/getButton/lowerCase"
msgstr "Obtener módulos"

msgid "common/getButton/upperCase"
msgstr "OBTENER MÓDULOS"

msgid "common/loader"
msgstr "Abriendo módulo..."

msgid "common/selectTooltip"
msgstr "No hay suficientes módulos para abrir cinco de una vez."

msgid "common/statistics/emptyHeader"
msgstr "Abre los módulos para ver las estadísticas."

msgid "common/statistics/header"
msgstr "Módulos abiertos:"

msgid "confirmRerollLootBox/description/wt"
msgstr "El módulo se abrirá de nuevo para darte la oportunidad de recibir recompensas distintas."

msgid "confirmResetLootBoxStatistics/description"
msgstr "Se borrará toda la información sobre los módulos abiertos."

msgid "entryPoint/boxes"
msgstr "A LOS MÓDULOS"

msgid "entryPoint/tooltip/description"
msgstr "Estos son módulos especiales que contienen objetos nuevos y únicos. Se pueden obtener en la tienda del juego."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Debido a problemas técnicos, no se pueden abrir ni obtener módulos en este momento. Te pedimos disculpas por las molestias ocasionadas."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Módulos no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "Monta la tormenta"

msgid "eventName/upperCase"
msgstr "MONTA LA TORMENTA"

msgid "guaranteedTitle/nextBox"
msgstr "¡Recompensa garantizada en el siguiente módulo!"

msgid "guaranteedTitle/text"
msgstr "Módulos máximos antes de una recompensa garantizada: %(count)"

msgid "infoPage/footer/description/autoOpen/wt"
msgstr "Si no abres los módulos antes de que termine el evento, se abrirán automáticamente."

msgid "infoPage/footer/description/compensation/wt"
msgstr "Si ya tienes todos los vehículos incluidos en los módulos, las próximas veces que recibas vehículos de los módulos obtendrás una compensación en oro equivalente al valor total del vehículo."

msgid "infoPage/footer/description/guaranteed/wt"
msgstr "Se garantiza que haya un vehículo cada %(guaranteed)s módulos. Si los abres y no consigues un vehículo, obtendrás uno que aún no tengas cuando abras el módulo %(guaranteed)s. Cuando suceda, el contador se reiniciará."

msgid "infoPage/footer/description/reroll/wt"
msgstr "Si no estás conforme con las recompensas de un módulo, puedes volver a abrirlo para tener la oportunidad de recibir objetos distintos de la misma lista. Cada módulo se puede volver a abrir solo una cantidad limitada de veces:"

msgid "infoPage/footer/title/autoOpen"
msgstr "Apertura automática"

msgid "infoPage/footer/title/compensation"
msgstr "Compensación"

msgid "infoPage/header/description"
msgstr "¡Abre el módulo para tener la oportunidad de recibir objetos valiosos del juego! Más detalles a continuación."

msgid "multipleRewardView/header/subTitle/"
msgstr "De %(name) (%(boxesCount) módulos abiertos)"

msgid "noBoxesView/description/"
msgstr "Puedes encontrar los módulos en la tienda del juego"

msgid "noBoxesView/goToButton/"
msgstr "A módulos disponibles"

msgid "preview/backLabel"
msgstr "A LOS MÓDULOS"

msgid "quantityTitle/boxesAvailable"
msgstr "Módulos disponibles: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No hay más módulos"

msgid "singleRewardView/tooltip/description/"
msgstr "Si ya tienes todos los vehículos incluidos en los módulos, las próximas veces que recibas vehículos de los módulos, obtendrás una compensación en oro."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) módulo"
msgstr[1] "%(remainingCount) módulos"
msgstr[2] "%(remainingCount) módulos"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "La recompensa garantizada es un vehículo de la lista del posible contenido del módulo.\nSi abres %(remainingCount) y no recibes dicho vehículo, lo conseguirás cuando abras el módulo %(count). Cuando esto suceda, el contador se reiniciará."

msgid "tooltip/reroll/text/wt"
msgstr "Volver a abrir un módulo te da la oportunidad de recibir recompensas distintas de la misma lista."
