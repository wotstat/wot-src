msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Este tanque experimental fue un desarrollo del AMX 13. El tanque fue puesto a prueba, pero nunca entró en producción ni en servicio. Dos vehículos fueron construidos."

