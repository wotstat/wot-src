msgid "Maus_IGR"
msgstr "Maus"

msgid "Maus_IGR_descr"
msgstr "Desarrollado desde Junio de 1942 hasta Julio de 1944, con dos prototipos construidos, de los cuales solo uno fue equipado con una torreta y armamento."

msgid "Maus_IGR_short"
