msgid "medalOskin_heroInfo"
msgstr "Alexander Oskin, un Héroe de la Unión Soviética, fue un comandante de tanque que destruyo tres King Tigers con su T-34 durante una operación de reconocimiento cerca de Oglenduv el 11 de agosto de 1944."

msgid "medalPascucci"
msgstr "Medalla de Pascucci"

msgid "medalPascucci_condition"
