msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Puedes ganar puntos del Pase de batalla en el modo {whiteSpanish_open}Batalla final{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Puntos del Pase de batalla"

msgid "mode/last_stand/calendar"
msgstr "El evento durará %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "El evento terminará el %(date)s."

msgid "mode/last_stand/description"
msgstr "Lucha contra oleadas de enemigos.\nBatallas en vehículos de nivel VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "El rendimiento de tu computadora es insuficiente para este modo. Es posible que experimentes problemas con los gráficos y el movimiento de vehículos. También es probable que el cliente presente errores graves."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Bajo rendimiento"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Bajo rendimiento"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Este modo requiere de un alto rendimiento de la computadora.\nExperimentarás problemas con la carga de mapas, gráficos y movimiento de vehículos. En caso de que el desempeño sea insuficiente, cambia a una calidad inferior de gráficos en los ajustes."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Rendimiento reducido"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Rendimiento reducido"
