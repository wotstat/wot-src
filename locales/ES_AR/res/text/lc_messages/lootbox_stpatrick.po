msgstr "COFRE ESMERALDA"

msgid "common/getButton/lowerCase"
msgstr "Obtener cofres"

msgid "common/getButton/upperCase"
msgstr "OBTENER COFRES"

msgid "common/loader"
msgstr "Abriendo cofre..."

msgid "common/statistics/emptyHeader"
msgstr "Abre cofres para ver las estadísticas."

msgid "common/statistics/header"
msgstr "Cofres abiertos: %(count)"

msgid "confirmResetLootBoxStatistics/description"
msgstr "Se borrará toda la información sobre los cofres abiertos."

msgid "entryPoint/boxes"
msgstr "A LOS COFRES"

msgid "entryPoint/tooltip/description"
msgstr "Son cofres especiales que incluyen vehículos premium, accesorios 3D, créditos y otros objetos valiosos del juego.\nSe pueden conseguir en la tienda del juego."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Debido a problemas técnicos, no se pueden abrir ni comprar cofres en este momento. Te pedimos disculpas por las molestias ocasionadas."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Cofres no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "Gloria verdosa"

msgid "eventName/upperCase"
msgstr "GLORIA VERDOSA"

msgid "guaranteedTitle/nextBox"
msgstr "¡Recompensa garantizada en el siguiente cofre!"

msgid "guaranteedTitle/text"
msgstr "Cofres máximos antes de una recompensa garantizada: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Si no abres los cofres antes de que termine el evento, se abrirán automáticamente."

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos incluidos en los cofres, las próximas veces que recibas vehículos de los cofres obtendrás una compensación en oro equivalente al valor total del vehículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza que haya un vehículo de nivel VIII-IX cada %(guaranteed0)s cofres. Si los abres y no consigues un vehículo de este tipo, obtendrás uno de nivel VIII-IX que aún no tengas cuando abras el cofre %(guaranteed0)s&zwnbsp;. Cuando suceda, el contador se reiniciará."

msgid "infoPage/header/description"
msgstr "¡Abre el cofre para tener la oportunidad de recibir objetos valiosos del juego! Más detalles a continuación."

msgid "multipleRewardView/header/subTitle/"
msgstr "De %(name) (%(boxesCount) cofres abiertos)"

msgid "noBoxesView/description/"
msgstr "No tienes cofres. \nPuedes conseguirlos en la tienda del juego."

msgid "preview/backLabel"
msgstr "A LOS COFRES"

msgid "quantityTitle/boxesAvailable"
msgstr "Cofres disponibles: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No hay cofres disponibles"

msgid "singleRewardView/tooltip/description/"
msgstr "Si ya tienes todos los vehículos incluidos en los cofres, las próximas veces que recibas vehículos de los cofres, obtendrás una compensación en oro."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) cofre"
msgstr[1] "%(remainingCount) cofres"
msgstr[2] "%(remainingCount) cofres"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "La recompensa garantizada es un vehículo de la lista del posible contenido del cofre.\nSi abres %(remainingCount) y no recibes dicho vehículo, lo conseguirás cuando abras el cofre %(count). Cuando esto suceda, el contador se reiniciará."
