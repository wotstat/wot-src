msgid "05_prohorovka/team1/heavyTank/descr"
msgstr "El punto clave de esta táctica es la %(a_ht_alleyPhrase1).%(p)Si avanzas por la %(a_ht_railwayPhrase), podrás tomar la posición de disparo que está cerca del %(a_ht_villagePhrase), desde la cual podrás controlar al enemigo de la %(a_ht_mountainPhrase). Despeja estas posiciones y avanza con seguridad hacia la %(a_ht_alleyPhrase2). Cuando ganes tus batallas en esta zona, es recomendable que aproveches las irregularidades del terreno y la vegetación para acabar con las fuerzas enemigas restantes que haya en el %(a_ht_southernFieldsPhrase)."

msgid "05_prohorovka/team1/heavyTank/title"
msgstr "Ataque por la avenida"

msgid "05_prohorovka/team1/mediumTank/descr"
msgstr "El punto clave de esta táctica es la %(a_mt_mountainPhrase2).%(p)Si avanzas por el flanco este, luego de cruzar la %(a_mt_railwayPhrase), es recomendable que tomes la posición de disparo de la %(a_mt_mountainPhrase1). Si ganas tus batallas en esta dirección, podrás controlar las posiciones enemigas del %(a_mt_villagePhrase) y detrás de la vía. Si avanzas y destruyes a los demás enemigos que hayan quedado en la vía, podrás tomar una posición segura en las laderas del %(a_mt_southernFieldsPhrase) para disparar a los enemigos que están en la %(a_mt_alleyPhrase)."

msgid "05_prohorovka/team1/mediumTank/title"
msgstr "Ataque por la montaña"

msgid "05_prohorovka/team2/heavyTank/descr"
msgstr "El punto clave de esta táctica es la %(b_ht_alleyPhrase1).%(p)Si avanzas por la %(b_ht_railwayPhrase), podrás tomar la posición de disparo que está cerca del %(b_ht_villagePhrase), desde la cual podrás controlar al enemigo de la %(b_ht_mountainPhrase). Despeja estas posiciones y avanza con seguridad hacia la %(b_ht_alleyPhrase2). Cuando ganes tus batallas en esta zona, es recomendable que aproveches las irregularidades del terreno y la vegetación para acabar con las fuerzas enemigas restantes que haya en el %(b_ht_northernFieldsPhrase)."

msgid "05_prohorovka/team2/heavyTank/title"
msgstr "Ataque por la avenida"

msgid "05_prohorovka/team2/mediumTank/descr"
msgstr "El punto clave de esta táctica es la %(b_mt_mountainPhrase1).%(p)Si avanzas por el flanco este, luego de cruzar la %(b_mt_railwayPhrase), es recomendable que tomes la posición de disparo de la %(b_mt_mountainPhrase2). Si ganas tus batallas en esta dirección, podrás controlar las posiciones enemigas del %(b_mt_villagePhrase) y detrás de la vía. Si avanzas y destruyes a los demás enemigos que hayan quedado en la vía, podrás tomar una posición segura en las laderas del %(b_mt_northernFieldsPhrase) para disparar a los enemigos que están en la %(b_mt_alleyPhrase)."

