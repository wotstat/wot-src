msgid "entryPoint/tooltip/description"
msgstr "Estas son cajas especiales que contienen objetos nuevos y únicos. Se pueden obtener en la tienda del juego."

msgid "entryPoint/tooltip/timerText"
msgstr "El evento terminará en"

msgid "eventName/lowerCase"
msgstr "Bóveda de los susurros"

msgid "eventName/upperCase"
msgstr "BÓVEDA DE LOS SUSURROS"

msgid "guaranteed/tooltip/description1/"
msgstr "Si ya tienes todos los vehículos, recibirás una caja de bendición en su lugar."

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos de las cajas, recibirás una caja de bendición como recompensa en lugar de un vehículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza que hay un vehículo cada %(guaranteed0)s cajas de botín, %(guaranteed1)s cajas de ofrenda y %(guaranteed2)s cajas de bendición. Si las abres y no consigues un vehículo de este tipo, obtendrás uno que aún no tengas cuando abras la caja %(guaranteed0)s/%(guaranteed1)s/%(guaranteed2)s (según el tipo de caja). Cuando suceda, el contador se reiniciará."

msgid "infoPage/footer/title/compensation"
msgstr "Compensación"

msgid "infoPage/footer/title/guaranteed"
msgstr "Recompensa garantizada"

msgid "infoPage/header/rewards/description"
msgstr "No se puede obtener más de una recompensa por grupo"
