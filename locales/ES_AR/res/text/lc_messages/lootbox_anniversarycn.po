msgid "boxTooltip/description/text/bronze"
msgstr "Al abrir estas cajas, puedes conseguir vehículos, monedas del juego y otras recompensas valiosas."

msgid "boxTooltip/description/text/gold"
msgstr "Al abrir estas cajas, puedes conseguir vehículos, monedas del juego, elementos de personalización y otras recompensas valiosas."

msgid "boxTooltip/description/text/silver"
msgstr "Al abrir estas cajas, puedes conseguir vehículos, monedas del juego, elementos de personalización y otras recompensas valiosas."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Se puede obtener en la tienda del juego y también al abrir cajas de cualquier otro tipo."

msgid "boxTooltip/howGet/text/gold"
msgstr "Se puede obtener al abrir cajas de cualquier otro tipo."

msgid "boxTooltip/howGet/text/silver"
msgstr "Se puede obtener al abrir cajas de cualquier otro tipo."

