msgid "Contact/status/inBattle/halloween"
msgstr "En una batalla de Babylon: Torre oscura"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Dispara un proyectil que daña y aturde al objetivo y a todos los vehículos enemigos ubicados en un radio de 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Dispara un proyectil que restaura los puntos de vida al robárselos al objetivo y a los vehículos enemigos cercanos ubicados en un radio de 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Dispara un proyectil que aturde al objetivo y a todos los vehículos enemigos ubicados en un radio de 35 m."

msgid "advanced/hw_damageShield"
msgstr "Te protege de todo el daño (excepto de embestidas, ahogamiento y los impactos por caídas) durante 7 segundos."

msgid "advanced/hw_fastReload"
msgstr "Aumenta la cadencia de fuego/recarga el cargador."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Restaura puntos de vida, apaga los incendios, elimina el aturdimiento y repara los módulos dañados."

msgid "advanced/hw_invisibility"
msgstr "Hace que tu vehículo sea invisible temporalmente a ojos de los enemigos, restaura puntos de vida, repara módulos, apaga incendios, elimina el efecto de aturdimiento y cura a todos los tripulantes heridos."

msgid "advanced/hw_teamRepairKit"
msgstr "Repara los módulos dañados, apaga los incendios, elimina el aturdimiento y restaura una parte de los puntos de vida de los vehículos enemigos ubicados dentro del radio de acción."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Las habilidades de combate son de gran ayuda para luchar en Babylon: Torre oscura, completar objetivos y ganar recompensas valiosas. Para equipar las habilidades de combate, haz clic en uno de los espacios correspondientes."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Espacios de habilidades de combate"

msgid "hwShell/alt/description"
msgstr "Luego de destruir a un enemigo, hay una determinada probabilidad de encontrar %(bold)s en batalla."

msgid "hwShell/alt/description/bold"
msgstr "un proyectil alternativo"
