msgid "hint/LSH_FIRE"
msgstr "El humo dificulta la detección de vehículos enemigos y la tarea de informar sobre sus posiciones. El fuego causa daño a los vehículos."

msgid "hint/LSH_FOG"
msgstr "La niebla dificulta la detección de vehículos enemigos y la tarea de informar sobre sus posiciones."

msgid "hint/LSH_RAIN"
msgstr "La lluvia torrencial dificulta la detección de vehículos enemigos y la tarea de informar sobre sus posiciones."

msgid "hint/LSH_SANDSTORM"
msgstr "La tormenta de arena dificulta la detección de vehículos enemigos y la tarea de informar sobre sus posiciones."

msgid "hint/LSH_SMOKE"
msgstr "El humo dificulta la detección de vehículos enemigos y la tarea de informar sobre sus posiciones."

msgid "hint/PPH_AIMING_01"
msgstr "El movimiento del vehículo y de la torreta disminuye la <font color='#EE7000'>precisión del cañón</font>."

msgid "hint/PPH_AIMING_02"
msgstr "El círculo alrededor de la retícula indica la <font color='#EE7000'>precisión del cañón</font>. Espera un poco para disparar con más precisión."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Autoapuntar</font> activado. Haz clic con el botón derecho del mouse para cancelar."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Con Autoapuntar, tu cañón siempre apunta <font color='#EE7000'>al centro</font> del vehículo objetivo."

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "¡Están <font color='#EE7000'>capturando</font> tu base! Si no los detienes, tus enemigos ganarán la batalla."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Cada vehículo enemigo tiene <font color='#EE7000'>su propio</font> progreso de captura."

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Capturar</font> la base enemiga es una de las formas de ganar la batalla."

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Cuando recibes daño, tu progreso de captura <font color='#EE7000'>se reinicia</font>."

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Cuando sales del círculo de la base, <font color='#EE7000'>pierdes</font> el progreso de captura."

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Varios vehículos capturan una base <font color='#EE7000'>más rápido</font>."

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "La velocidad de captura máxima se alcanza con <font color='#EE7000'>tres</font> vehículos."

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "¡Ya casi terminan de capturar la base enemiga!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "¡Tu equipo está capturando la base más rápido!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "¡Módulo de vehículo con daño crítico! Usa <font color='#EE7000'>el kit de reparación</font> del panel inferior para repararlo."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "¡Módulo de vehículo con daño crítico! Usa <font color='#EE7000'>el kit de reparación</font> del panel inferior para repararlo."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "¡Tripulante con heridas críticas! Usa <font color='#EE7000'>el kit de primeros auxilios</font> del panel inferior para sanarlo."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "¡Tripulante con heridas críticas! Usa <font color='#EE7000'>el kit de primeros auxilios</font> del panel inferior para sanarlo."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "¡La tripulación está aturdida! Usa <font color='#EE7000'>el kit de primeros auxilios</font> del panel inferior para sanarla."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "¡El vehículo está en llamas! Usa <font color='#EE7000'>el matafuegos</font> del panel inferior."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "¡Vehículo en llamas! <font color='#EE7000'>matafuegos</font> automático activado."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "¡Módulo de vehículo con daño crítico! Equipa <font color='#EE7000'>un kit de reparación</font> antes de la batalla para reparar los impactos críticos."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "¡Tripulante con heridas críticas! Equipa <font color='#EE7000'>un kit de primeros auxilios</font> antes de la batalla para sanar las heridas de la tripulación."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "¡El vehículo está en llamas! Equipa <font color='#EE7000'>un matafuegos</font> antes de la batalla para apagar los incendios."

msgid "hint/PPH_OTHER_01"
msgstr "Te <font color='#EE7000'>detectaron</font>: si disparas, ¡podrías revelar tu posición!"

msgid "hint/PPH_OTHER_02"
msgstr "Destruyeron tu vehículo. Presiona <font color='#EE7000'>Esc</font> para abandonar la batalla sin penalización."

msgid "hint/PPH_OTHER_03"
msgstr "Destruyeron tu vehículo. Haz clic con el mouse para <font color='#EE7000'>ver</font> a tus aliados."

msgid "hint/PPH_OTHER_04"
msgstr "¡El <font color='#EE7000'>ícono con forma de bombilla</font> indica que tus enemigos te detectaron!"

msgid "hint/PPH_OTHER_05"
msgstr "Tu cañón sigue <font color='#EE7000'>recargándose</font>."

msgid "hint/PPH_OTHER_06"
msgstr "Solo puedes disparar si el círculo que está alrededor de la retícula es <font color='#EE7000'>completamente verde</font>."

msgid "hint/PPH_SNIPER_01"
msgstr "Usa la rueda del mouse para ingresar al <font color='#EE7000'>modo Francotirador</font>."

msgid "hint/PPH_SNIPER_02"
msgstr "Usa la rueda del mouse para <font color='#EE7000'>salir</font> del modo Francotirador."

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "La <font color='#EE7000'>retícula verde interna</font> indica una gran probabilidad de penetrar el blindaje enemigo."

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Incluso si la retícula interna es verde, <font color='#EE7000'>no hay garantía</font> de penetrar el blindaje."

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Los cañones no son 100 % precisos, por lo que, a veces, los disparos <font color='#EE7000'>no acertarán en el centro</font> de la retícula."

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "La retícula interna refleja la probabilidad de penetrar el blindaje enemigo. <font color='#EE7000'>Actívala en la Configuración</font>."

msgid "penetration/chance/high"
msgstr "Probabilidad alta"

msgid "penetration/chance/low"
msgstr "Probabilidad baja"

msgid "penetration/chance/medium"
msgstr "Probabilidad media"
