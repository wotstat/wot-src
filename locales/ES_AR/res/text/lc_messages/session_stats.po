msgid "propertyInfo/prop/descr/averageDamage"
msgstr "La proporción de daño total causado en la cantidad de batallas libradas durante la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Relación entre vehículos destruidos y batallas luchadas."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Nivel promedio de los vehículos que manejaste durante la sesión de juego."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "La proporción de experiencia total obtenida en la cantidad de batallas libradas durante la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "La proporción de daño total bloqueado en la cantidad de batallas libradas durante la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "La proporción de daño por detección y daño causado por los aliados cuando destruyes las orugas de un enemigo y lo inmovilizas o cuando lo aturdes en relación a la cantidad de batallas libradas durante la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "La proporción de los parámetros de \"Daño causado\" y \"Daño recibido\". Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "La proporción de los vehículos destruidos por la cantidad de veces que tu vehículo ha sido destruido. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Relación entre vehículos divisados y batallas luchadas durante la sesión."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Porcentaje de batallas total en las que el vehículo del jugador no fue destruido."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Porcentaje de victorias en Batallas Aleatorias durante la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/wins"
msgstr "La cantidad de victorias en Batallas Aleatorias en la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/wtr"
msgstr "El WTP por los valores promedio para toda la sesión. Delta refleja el efecto de la sesión de juego actual sobre el parámetro total."

