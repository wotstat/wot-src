msgid "comp7/deserter/cancel"
msgstr "Cancelar"

msgid "comp7/deserter/message"
msgstr "Esta batalla aún no terminó. Si te vas antes de que termine, defraudarás a tu equipo.\n{brown_open}Reduciremos tu puntuación, y no podrás acceder a las batallas de este modo. {brown_close}\n¿Confirmas que quieres abandonar la batalla?"

msgid "comp7/deserter/msgTitle"
msgstr "¡Perderás tus puntos de rango!"

msgid "comp7/deserter/submit"
msgstr "Desertar"

msgid "comp7/deserter/title"
msgstr "Deserción del campo de batalla"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Infringiste las reglas del juego en el mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} a las {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Te quitamos puntos de rango y bloqueamos temporalmente tu acceso a las batallas del modo {whiteSpanish_Open}Asedio{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Infringiste las reglas del juego en el mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} a las {whiteSpanish_Open}%(time)s{whiteSpanish_Close}. Bloqueamos temporalmente tu acceso a las batallas en el modo {whiteSpanish_Open}Asedio{whiteSpanish_Close}; \nte quitamos puntos de rango."
