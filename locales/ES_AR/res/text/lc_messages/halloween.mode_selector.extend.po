msgid "mode/halloween/battlePassTooltip/body"
msgstr "Algunas misiones del evento {whiteSpanish_open}Babylon: Torre oscura{whiteSpanish_close} te permitirán ganar puntos del Pase de batalla."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Puntos del Pase de batalla"

msgid "mode/halloween/calendar"
msgstr "El evento durará %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "El evento terminará el %(date)s."

msgid "mode/halloween/description"
msgstr "Lucha y junta materia.\nBatallas en vehículos especiales."

msgid "mode/halloween/performance/highRisk/description"
msgstr "El rendimiento de tu computadora es insuficiente para este modo. Es posible que experimentes problemas con los gráficos y el movimiento de vehículos. También es probable que el cliente presente errores graves."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Bajo rendimiento"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Bajo rendimiento"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Este modo requiere de un alto rendimiento de la computadora.\nExperimentarás problemas con la carga de mapas, gráficos y movimiento de vehículos. En caso de que el desempeño sea insuficiente, cambia a una calidad inferior de gráficos en los ajustes."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Rendimiento reducido"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Rendimiento reducido"
