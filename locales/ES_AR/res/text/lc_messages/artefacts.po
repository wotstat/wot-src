msgid "adaptationHealthRestore/battleDescr"
msgstr "Restaura un %(immediatelyRestore)s de los puntos de vida del vehículo de inmediato. Durante los %(duration)s s que dure la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida (más otro %(restoringCoefficient)s del daño recibido) en cuanto la habilidad termine.\n\n*La recuperación de PV convertidos también afecta a los vehículos aliados ubicados dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/descr"
msgstr "Restaura un %(immediatelyRestore)s de los puntos de vida del vehículo de inmediato. Durante los %(duration)s s que dure la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida (más otro %(restoringCoefficient)s del daño recibido) en cuanto la habilidad termine.\n\n*La recuperación de PV convertidos también afecta a los vehículos aliados ubicados dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/longDescr"
msgstr "{green_Open}Restaura un %(immediatelyRestore)s{green_Close} de los puntos de vida del vehículo de inmediato. Durante los {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} que dure la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida (más {green_Open}otro %(restoringCoefficient)s del daño recibido{green_Close}) en cuanto la habilidad termine.\n\n*La recuperación de PV convertidos también afecta a los vehículos aliados ubicados dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/name"
msgstr "Blindaje adaptable"

msgid "adaptationHealthRestore/shortDescr"
msgstr "{green_Open}Restaura un %(immediatelyRestore)s{green_Close} de los puntos de vida del vehículo de inmediato. Durante los {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} que dure la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida (más {green_Open}otro %(restoringCoefficient)s del daño recibido{green_Close}) en cuanto la habilidad termine.\n\n*La recuperación de PV convertidos también afecta a los vehículos aliados ubicados dentro de un radio de acción pequeño."

msgid "additInvisibilityDeviceBattleBooster/descr"
msgstr "%s al ocultamiento de un vehículo inmóvil o en movimiento con Sistema de escape silencioso (cualquier clase) o Sistema de escape de recompensa montado."

msgid "additInvisibilityDeviceBattleBooster/gain/deluxe"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/gain/simple"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/long_special"
msgstr "Mejora el efecto de Sistema de escape silencioso o Sistema de escape de recompensa durante el transcurso de la batalla. La directiva solo funcionará si tienes el equipamiento correspondiente montado."

msgid "additInvisibilityDeviceBattleBooster/name"
msgstr "Aislamiento de escape"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Aumenta el ocultamiento de un vehículo inmóvil o en movimiento"

msgid "additionalInvisibilityDevice/long_special"
msgstr "La efectividad depende del tipo de vehículo. Aumenta el ocultamiento de un vehículo inmóvil o en movimiento. Útil para realizar tareas de exploración activa y para detectar enemigos de forma pasiva desde posiciones riesgosas."

msgid "additionalInvisibilityDevice/name"
msgstr "Sistema de escape silencioso"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Aumenta el ocultamiento de un vehículo inmóvil o en movimiento."

msgid "additionalInvisibilityDevice_tier1/name"
msgstr "Sistema de escape silencioso, clase 1"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Sistema de escape silencioso, clase 2"

msgid "additionalInvisibilityDevice_tier3/name"
msgstr "Sistema de escape silencioso, clase 3"

msgid "additional_armor_plates_1/name"
msgstr "Revestimiento de blindaje adicional (tipo 1)"

msgid "additional_armor_plates_2/name"
msgstr "Revestimiento de blindaje adicional (tipo 2)"

msgid "afterburning/descr"
msgstr "Aumenta la velocidad y la aceleración de tu vehículo por tiempo limitado."

msgid "afterburning/name"
msgstr "Turbocargador"

msgid "aimingStabilizer/long_special"
msgstr "Reducir la dispersión del cañón es clave: mientras más baja sea la dispersión inicial, más pequeño será el círculo de apuntamiento y apuntarás tu cañón más rápido. Además, un disparo improvisado (realizado sin la máxima precisión o estando en movimiento) tendrá más posibilidades de impactar en el objetivo."

msgid "aimingStabilizer/name"
msgstr "Estabilizador vertical"

msgid "aimingStabilizerBattleBooster/descr"
msgstr "%s a la dispersión luego de disparar, durante el movimiento y al rotar la torreta con Estabilizador vertical, Equipamiento avanzado de estabilización o Estabilizador de recompensa."

msgid "aimingStabilizerBattleBooster/gain/deluxe"
msgstr "-5%"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5%"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Mejora el efecto de Estabilizador vertical (cualquier clase), Equipamiento avanzado de estabilización o Estabilizador de recompensa durante la batalla. Para equipar y activar esta directiva, estos objetos de equipamiento se deben montar en el vehículo."

msgid "aimingStabilizerBattleBooster/name"
msgstr "Engrasado del Estabilizador"

msgid "aimingStabilizerBattleBooster/short_special"
msgstr "Mejora el efecto del estabilizador"

msgid "aimingStabilizer_Mk1/name"
msgstr "Estabilizador vertical, clase 1"

msgid "aimingStabilizer_Mk2/name"
msgstr "Estabilizador vertical, clase 2"

