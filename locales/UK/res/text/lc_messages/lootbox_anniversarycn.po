msgid "entryPoint/tooltip/description"
msgstr "Це спеціальні коробки з новими й унікальними предметами. Їх можна отримати у внутрішньоігровому Магазині."

msgid "entryPoint/tooltip/timerText"
msgstr "До кінця події"

msgid "eventName/lowerCase"
msgstr "Шепітне сховище"

msgid "eventName/upperCase"
msgstr "ШЕПІТНЕ СХОВИЩЕ"

msgid "guaranteed/tooltip/description1/"
msgstr "Якщо всі машини у вас уже є, ви отримаєте Коробку благ як компенсацію."

msgid "infoPage/footer/description/compensation"
msgstr "Якщо у вас уже є вся техніка з коробок, замість машини ви отримаєте Коробку благ як нагороду."

msgid "infoPage/footer/description/guaranteed"
msgstr "Кожна %(guaranteed0)s Коробка винагород, %(guaranteed1)s Коробка дарів і %(guaranteed2)s Коробка благ гарантовано містить машину. Якщо після їхніх відкриттів ви так і не отримали техніку, з %(guaranteed0)s-ї Коробки винагород/%(guaranteed1)s-ї Коробки дарів/%(guaranteed2)s-ї Коробки благ випаде машина, якої у вас ще немає (залежно від типу коробки). Після цього лічильник буде скинуто."

msgid "infoPage/footer/title/compensation"
msgstr "Компенсація"

msgid "infoPage/footer/title/guaranteed"
msgstr "Гарантована нагорода"

msgid "infoPage/header/rewards/description"
msgstr "Може випасти не більше як одна нагорода на групу"
