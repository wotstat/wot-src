msgstr "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"

msgid "boxTooltip/description/text/bronze"
msgstr "У коробках можна знайти техніку, ігрову валюту й інші цінні нагороди."

msgid "boxTooltip/description/text/gold"
msgstr "У коробках можна знайти техніку, ігрову валюту, елементи зовнішнього вигляду й інші цінні нагороди."

msgid "boxTooltip/description/text/silver"
msgstr "У коробках можна знайти техніку, ігрову валюту, елементи зовнішнього вигляду й інші цінні нагороди."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Можна придбати у внутрішньоігровому Магазині чи отримати, відкриваючи коробки будь-якого іншого виду."

msgid "boxTooltip/howGet/text/gold"
msgstr "Можна отримати, відкриваючи коробки будь-якого іншого виду."

msgid "boxTooltip/howGet/text/silver"
msgstr "Можна отримати, відкриваючи коробки будь-якого іншого виду."

