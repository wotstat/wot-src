msgid "Contact/status/inBattle/halloween"
msgstr "У бою режиму «Вавилон: Темна вежа»"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Робить постріл, що пошкоджує й оглушує ціль та всю техніку супротивника в радіусі 35 м."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Робить постріл, що відновлює очки міцності, викрадаючи їх у цілі й техніки супротивника в радіусі 35 м."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Робить постріл, що оглушує ціль і техніку супротивника в радіусі 35 м."

msgid "advanced/hw_damageShield"
msgstr "Протягом 7 секунд захищає машину від будь-якої шкоди, крім тарана, затоплення й зіткнень."

msgid "advanced/hw_fastReload"
msgstr "Підвищує скорострільність/перезаряджає магазин."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Відновлює очки міцності, гасить пожежу, знімає ефект оглушення й лагодить пошкоджені модулі."

msgid "advanced/hw_invisibility"
msgstr "Тимчасово робить вашу машину невидимою для супротивника, відновлює міцність, лагодить модулі, гасить пожежу, знімає ефект оглушення й лікує всіх поранених членів екіпажу."

msgid "advanced/hw_teamRepairKit"
msgstr "Лагодить модулі, гасить пожежу, знімає ефект оглушення й відновлює певну кількість очок міцності союзним машинам в області дії."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Бойові вміння дають змогу ефективніше діяти в боях режиму «Вавилон: Темна вежа», виконувати цілі й заробляти цінні нагороди. Щоб спорядити їх, натисніть на слот бойового вміння."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Слоти бойових умінь"

msgid "hwShell/alt/description"
msgstr "%(bold)s з певною ймовірністю можна знайти в бою після знищення суперника."

msgid "hwShell/alt/description/bold"
msgstr "Альтернативний снаряд"
