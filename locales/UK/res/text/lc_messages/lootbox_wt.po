msgid "confirmRerollLootBox/description/wt"
msgstr "Модуль буде відкрито знову, і ви матимете шанс отримати інші нагороди."

msgid "confirmResetLootBoxStatistics/description"
msgstr "Усю інформацію про відкриті модулі буде видалено."

msgid "entryPoint/boxes"
msgstr "ДО МОДУЛІВ"

msgid "entryPoint/tooltip/description"
msgstr "Це спеціальні модулі з новими й унікальними предметами. Їх можна отримати у внутрішньоігровому Магазині."

msgid "entryPoint/tooltip/warningDescription"
msgstr "З технічних причин наразі неможливо відкривати чи купувати модулі. Вибачте за тимчасові незручності."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Модулі тимчасово недоступні"

msgid "eventName/lowerCase"
msgstr "Верхи на буревії"

msgid "eventName/upperCase"
msgstr "ВЕРХИ НА БУРЕВІЇ"

msgid "guaranteedTitle/nextBox"
msgstr "У наступному модулі буде гарантована нагорода!"

msgid "guaranteedTitle/text"
msgstr "Максимум модулів до гарантованої нагороди: %(count)"

msgid "infoPage/footer/description/autoOpen/wt"
msgstr "Якщо не відкриєте модулі до кінця події, це відбудеться автоматично."

msgid "infoPage/footer/description/compensation/wt"
msgstr "Якщо вже маєте всю техніку зі списку можливого вмісту модулів, за всі подальші машини з них ви отримуватимете компенсацію їхньої повної вартості золотом."

msgid "infoPage/footer/description/guaranteed/wt"
msgstr "Кожен %(guaranteed)s-й модуль гарантовано містить техніку. Якщо після їхнього відкриття ви так і не отримали техніку, з %(guaranteed)s-го модуля випаде машина, якої у вас іще немає. Після цього лічильник буде скинуто."

msgid "infoPage/footer/description/reroll/wt"
msgstr "Якщо вас не влаштовують нагороди з модуля, ви можете відкрити її повторно заради шансу отримати інші предмети з того самого переліку. Кожен модуль можна відкрити повторно лише обмежену кількість разів:"

msgid "infoPage/footer/title/autoOpen"
msgstr "Автовідкриття"

msgid "infoPage/footer/title/compensation"
msgstr "Компенсація"

msgid "infoPage/header/description"
msgstr "Відкривайте модулі заради шансу отримати цінне ігрове майно! Подробиці нижче."

msgid "multipleRewardView/header/subTitle/"
