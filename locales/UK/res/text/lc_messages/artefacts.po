msgstr "Додаткові бронепластини (Тип 1)"

msgid "additional_armor_plates_2/name"
msgstr "Додаткові бронепластини (Тип 2)"

msgid "afterburning/descr"
msgstr "На короткий час значно збільшує швидкість та поліпшує динаміку розгону."

msgid "afterburning/name"
msgstr "Турбонагнітач"

msgid "aimingStabilizer/long_special"
msgstr "Зменшення розкиду — важливий фактор, адже чим меншим буде початковий розкид гармати, тим з меншого за діаметром кола почнеться зведення, тобто воно відбуватиметься швидше. Крім того, «завчасний» постріл (постріл без зведення або на ходу) також буде точнішим."

msgid "aimingStabilizer/name"
msgstr "Стабілізатор вертикальної наводки"

msgid "aimingStabilizerBattleBooster/descr"
msgstr "%s від розкиду після пострілу, під час руху й повороту башти з встановленим обладнанням «Стабілізатор вертикальної наводки», «Комплекс стабілізаційного обладнання» чи «Трофейний стабілізатор»."

msgid "aimingStabilizerBattleBooster/gain/deluxe"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Витрачається за 1 бій. Посилює ефект обладнання «Стабілізатор вертикальної наводки» (будь-якого класу), «Комплекс стабілізаційного обладнання» та «Трофейний стабілізатор». Коли встановлюється настанова, це обладнання має бути на техніці, інакше настанова не працюватиме."

msgid "aimingStabilizerBattleBooster/name"
msgstr "Змазування стабілізаторів"

msgid "aimingStabilizerBattleBooster/short_special"
msgstr "Посилює ефект від стабілізатора"

msgid "aimingStabilizer_Mk1/name"
msgstr "Стабілізатор вертикальної наводки (Клас 1)"

