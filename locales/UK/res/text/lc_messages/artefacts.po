msgstr "Малошумна система вихлопу (Клас 1)"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Малошумна система вихлопу (Клас 2)"

msgid "additionalInvisibilityDevice_tier3/name"
msgstr "Малошумна система вихлопу (Клас 3)"

