msgid "fullStats/alive"
msgstr "Загалом уцілілих"

msgid "fullStats/deathZone/closed/description"
msgstr "Зону закрито"

msgid "fullStats/deathZone/warning/description"
msgstr "Зона закривається"

msgid "fullStats/description"
msgstr "Головне завдання — залишитися останнім уцілілим гравцем (або взводом). Збирайте ресурси, поліпшуйте машину, виживайте!"

msgid "fullStats/destroyed"
msgstr "Знищено вами"

msgid "fullStats/icons/airDrop/description"
msgstr "Повітряний вантаж: досвід, відновлення міцності, ремонт модулів, заряди для всіх бойових умінь, боєзапас."

msgid "fullStats/icons/corpseLoot/description"
msgstr "Трофеї: досвід, відновлення міцності, ремонт модулів, заряди для деяких бойових умінь, боєзапас."

msgid "fullStats/icons/defaultLoot/description"
msgstr "Постачання: досвід, можливий заряд для бойового вміння, боєзапас."

msgid "fullStats/icons/extendedLoot/description"
msgstr "Спорядження: досвід, відновлення міцності, ремонт модулів, заряд Відновлення, боєзапас."

msgid "fullStats/stPatrick/icons/corpseLoot/description"
msgstr "Трофеї: досвід, відновлення міцності, ремонт модулів, заряди для деяких бойових умінь, боєзапас."

msgid "fullStats/stPatrick/icons/extendedLoot/description"
msgstr "Спорядження: досвід, відновлення міцності, ремонт модулів, шанс отримати заряди бойових умінь, боєзапас."

msgid "fullStats/stPatrick/icons/shamrocks/description"
msgstr "Щасливі печатки є в усіх типах здобичі. Після бою їх можна обміняти на нагороди в Крамниці трилисника."

msgid "fullStats/subTitle"
msgstr "Битва за цінні ресурси за правилами «один проти всіх»."

msgid "fullStats/title"
msgstr "Сталевий мисливець"
