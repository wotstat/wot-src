msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Ящики човна-дракона"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "ЯЩИКИ ЧОВНА-ДРАКОНА"

msgid "entryPoint/tooltip/description"
msgstr "Ці особливі ящики містять унікальне й цінне ігрове майно.\nЯщики можна отримати у внутрішньоігровому та Преміум магазинах."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Ящики човна-дракона тимчасово недоступні"

msgid "eventName/lowerCase"
msgstr "Приборкайте дракона, осідлайте вітер"

msgid "eventName/upperCase"
msgstr "ПРИБОРКАЙТЕ ДРАКОНА, ОСІДЛАЙТЕ ВІТЕР"

msgid "infoPage/footer/description/compensation"
msgstr "Якщо вже маєте всю техніку зі списку можливого вмісту Ящиків човна-дракона, за всі подальші машини з них ви отримуватимете компенсацію їхньої повної вартості золотом."

msgid "infoPage/footer/description/guaranteed"
msgstr "Кожен %(guaranteed0)s-й Ящик човна-дракона гарантовано містить машину VIII–IX рівня. Якщо після їхніх відкриттів ви так і не отримали техніку, з %(guaranteed0)s&zwnbsp;-го ящика випаде машина VIII–IX рівня, якої у вас іще немає. Після цього лічильник буде скинуто."

msgid "noBoxesView/description/"
msgstr "У вас немає ящиків.\nЇх можна придбати в ігровому Магазині."
