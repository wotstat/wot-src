msgstr "БОЖЕ БЛАГОСЛОВЕННЯ"

msgid "guaranteed/tooltip/description1/"
msgstr "Якщо у вас уже є всі машини, ви отримаєте Коробку обраних як компенсацію."

msgid "infoPage/footer/description/compensation"
msgstr "Якщо у вас уже є вся техніка з коробок, замість машини ви отримаєте Коробку обраних як нагороду."

msgid "infoPage/footer/description/guaranteed"
msgstr "Кожна %(guaranteed0)s Небесна коробка, %(guaranteed1)s Коробка небесної благодаті й %(guaranteed2)s Коробка обраних гарантовано містить машину. Якщо після їхніх відкриттів ви так і не отримали техніку, з %(guaranteed0)s-ї Небесної коробки/%(guaranteed1)s-ї Коробки небесної благодаті/%(guaranteed2)s-ї Коробки обраних випаде машина, якої у вас ще немає (залежно від типу коробки). Після цього лічильник буде скинуто."

msgid "infoPage/footer/title/compensation"
msgstr "Компенсація"

msgid "infoPage/footer/title/guaranteed"
msgstr "Гарантована нагорода"

msgid "infoPage/header/rewards/description"
msgstr "Може випасти не більше як одна нагорода на групу"
