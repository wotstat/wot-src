msgstr "Т-34 зр. 1943 р."

msgid "T-43M_MapsTraining_Player_MT_2"
msgstr "Т-43 зр. 1943 р."

msgid "T-43_MapsTraining_Player_MT_2"
msgstr "Т-43 (навч.)"

msgid "T-43_descr_MapsTraining_Player_MT_2"
msgstr "Розроблявся для заміни Т-34 з весни 1942 р. Був запропонований до прийняття на озброєння, проте подальші роботи над танком були припинені на користь поліпшення Т-34. Серійно не випускався."

msgid "T-43_mod_100_MapsTraining_Player_MT_2"
msgstr "Т-43 зр. 1943 р."

