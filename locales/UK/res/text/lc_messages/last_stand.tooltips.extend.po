msgid "Contact/status/inBattle/last_stand"
msgstr "У бою Останнього рубежу"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Робить постріл, що пошкоджує ціль і всю техніку супротивника в радіусі 35 м."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Робить постріл, що відновлює очки міцності, викрадаючи їх у цілі й техніки супротивника в радіусі 35 м."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Робить постріл, що оглушує ціль і техніку супротивника в радіусі 35 м."

msgid "advanced/ls_damageShield"
msgstr "Впродовж 10 секунд захищає машину від будь-якої шкоди, крім тарана, потоплень і зіткнень."

msgid "advanced/ls_doubleDamage"
msgstr "Ваше наступне влучення завдає вдвічі більше шкоди."

msgid "advanced/ls_equipment"
msgstr "Тактичні пристрої дозволяють ефективніше діяти в боях Останнього рубежу, проходити етапи й отримувати цінні нагороди. Щоб спорядити їх, натисніть на слот тактичного пристрою."

msgid "advanced/ls_extraDamageSituational"
msgstr "Дає шанс завдати підвищеної шкоди машині супротивника."

msgid "advanced/ls_fastReload"
msgstr "Підвищує скорострільність/перезаряджає магазин."

msgid "advanced/ls_healSituational"
msgstr "Відновлює частину міцності після знищення машини супротивника."

msgid "advanced/ls_invisibility"
msgstr "Тимчасово не дозволяє супротивнику вибирати вашу машину ціллю, відновлює міцність, лагодить модулі, гасить пожежу, знімає ефект оглушення й лікує всіх поранених членів екіпажу."

msgid "advanced/ls_nitro"
msgstr "Тимчасово підвищує рухливість вашої машини."

msgid "advanced/ls_nitroSituational"
msgstr "Тимчасово підвищує рухливість вашої машини після отримання шкоди від супротивника."

msgid "advanced/ls_selfRepairKit"
msgstr "Відновлює очки міцності, гасить пожежу, знімає ефект оглушення й лагодить пошкоджені модулі."

msgid "advanced/ls_teamRepairKit"
msgstr "Лагодить модулі, гасить пожежу, знімає ефект оглушення й відновлює певну кількість очок міцності союзним машинам в області дії."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Тактичні пристрої можна спорядити в спеціальні слоти, що дозволить діяти ефективніше в боях Останнього рубежу, проходити етапи й отримувати цінні нагороди."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Слоти для тактичних пристроїв"
