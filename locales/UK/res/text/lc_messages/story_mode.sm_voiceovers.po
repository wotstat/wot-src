msgstr "?empty?"

msgid "vo_sm_char07_m05_stg68_01"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg69_01"
msgstr "?empty?"

msgid "vo_sm_char08_m05_stg01_13"
msgstr "Пілот «Спітфайра»: Не берую кориґувати вогонь, нич не видно!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Пілот «Спітфайра»: Сильний зенітний вогонь, не берую помогти!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Пілот «Спітфайра»: Зенітки не дауть кориґувати вогонь."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Пілот «Спітфайра»: Дуже плотний зетнітний вогонь."

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Пілот «Спітфайра»: Не можемо кориґувати вогонь лінкора при сюй ситуації."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Пілот «Спітфайра»: Перше мусуте знищити зенітки коло бункеру."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Пілот «Спітфайра»: Спускаюся долу."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Пілот «Спітфайра»: Тепир я можу кориґувати вогонь лінкора по вашим димовими сигналами на землі."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Пілот «Спітфайра»:  Ко є в танку, ваш виход!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Пілот «Спітфайра»: Вижу дим."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Пілот «Спітфайра»: Передаю координати лінкору для удару."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Пілот «Спітфайра»: Ґута би тя побила, їдного нашого пудбили!"

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Пілот «Спітфайра»: Ми досі не можемо спуститися долу. Розбити би побистріше ці зенітки!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Пілот «Спітфайра»: Зенітки розбито. Спускаюся долу. Тепер маємо дати ліпший вогонь нашого лінкора."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Пілот «Спітфайра»: Осторожно! Вижу велику купу противнику, котрі йдут на вас."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Пілот «Спітфайра»: Вони отправили на вас всьо, шо мають."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Пілот «Спітфайра»: Осторожно! Приближаєся нова купу противнику. Сокотіться."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Пілот «Спітфайра»: Осторожно! На вас пре пуслідня і майсильна волна противника."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Пілот «Спітфайра»: Вони пруть з усіх боків. Готуйтеся!"

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Пілот «Спітфайра»: Вижу димовий сигнал. Передаю координати на лінкор."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Пілот «Спітфайра»: От і дим маєш. Вижу ціль. Передаю координати лінкору. "

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Пілот «Спітфайра»: Дим на цілі. Передаю точну позицію лінкору."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Пілот «Спітфайра»: Вижу дим. Похоже, нашим леґіням на землі треба помогти."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Командир USS Frankford: Гармати готові. Чекаємо координати."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Командир USS Frankford: Наосліп не стріляти, наші вже на березі."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Командир USS Frankford: Не стріляти, чекаємо точні координати."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Командир USS Frankford: Говорить командир есмінця «Франкфорд». Ніяк ні."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Командир USS Frankford: Не можемо підтримати вогнем. Видимість занизька."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Командир USS Frankford: Не бачимо ні скель, ні бункерів. Тільки наші танки на пляжі."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Командир USS Frankford: Бачу танки, що стріляють у бік скель."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Командир USS Frankford: Ми підтримаємо їх вогнем у тому ж напрямку."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Командир USS Frankford: Сподіваюся, цей «Шерман» знає, куди стріляє."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Командир USS Frankford: «Шерман» змінив ціль. Стріляємо в тому ж напрямку, як і він."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Командир USS Frankford: «Шерман» припинив вогонь. Чудова робота."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Командир USS Frankford: Ми не зможемо влучити в бункери на другій лінії."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Командир USS Frankford: Відступаємо на безпечну відстань. Удачі на березі."

