msgstr "Pz.Kpfw. I Ausf. C"

msgid "PzI_ausf_C_descr"
msgstr "Замовлення на розроблення нового танка було видано 1939 р. Спочатку машина розроблялася як швидкохідний розвідувальний танк для повітряно-десантних частин. У липні 1942 р. було розпочато виробництво танка. На початку 1943 р. дві машини поступили на озброєння в 1-у танкову дивізію для випробування в бою. Решта 38 машин були передані до складу 58-го резервного танкового корпусу влітку 1944 р."

msgid "PzI_ausf_C_short"
msgstr "Pz. I C"

msgid "PzI_descr"
msgstr "Pz. I Ausf. A був першим масовим німецьким танком.\n1935 р. конструкцію машини доопрацювали й почали серійний випуск Pz. I Ausf. B з подовженим корпусом і шасі, а також потужнішим двигуном. Разом випустили 675 машин цієї модифікації. Танк відрізнявся дуже слабким озброєнням, тому під час Громадянської війни в Іспанії кілька машин в польових умовах модифікували під встановлення 20-мм гармати."

msgid "PzI_short"
msgstr "Pz. I"

msgid "PzJgd_ketten_I"
msgstr "Panzerjäger I"

msgid "PzJgd_ketten_II"
msgstr "Panzerjäger I verstärkteketten"

msgid "PzV-IVketten"
msgstr "Pz.Kpfw. V/IV"

msgid "PzVIB_Tiger_II_F"
msgstr "Tiger II (H)"

msgid "PzVIB_Tiger_II_FL"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_FL_short"
msgstr "Tiger II FL"

msgid "PzVIB_Tiger_II_F_descr"
msgstr "Найзахищеніший танк Другої світової війни з найпотужнішою протитанковою гарматою, але з перевантаженою моторно-трансмісійною групою та шасі, а також із надто великою масою. За умови вогневого бою на великій дистанції, переваги озброєння та броньового захисту танка Tiger II були разючими. Однак через велику масу, низьку надійність двигуна й трансмісії, а також внаслідок невеликої кількості вироблених машин, Tiger II не мав серйозного впливу на хід бойових дій."

msgid "PzVIB_Tiger_II_F_short"
msgstr "Tiger II (H)"

