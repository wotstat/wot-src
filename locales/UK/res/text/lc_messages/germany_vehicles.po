msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Розроблений компанією ČKD для потреб Чехословацької армії 1938 р. Під час німецької окупації перебував на озброєнні Вермахту. У складі німецьких танкових частин застосовувався у польській та французькій кампаніях, а також на радянсько-німецькому фронті. У бойових частинах першої лінії використовувався до середини 1942 р. Було випущено приблизно 1 400 танків у восьми варіантах (Ausf A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

