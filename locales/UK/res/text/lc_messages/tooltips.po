msgstr "?empty?"

msgid "notrecruitedtankman/lunar26_commander/label"
msgstr "?empty?"

msgid "notrecruitedtankman/ny19men/desc"
msgstr "«...Ходи-но сюди, спробуй мене привітати! Я й сам тебе привітаю, розумнику, добродію, щасти тобі!..»"

