msgstr "Купити та встановити"

msgid "modules/controls/button/field_modification"
msgstr "Польова модернізація"

msgid "modules/controls/button/mount"
msgstr "Встановити"

msgid "modules/controls/button/research"
msgstr "Дослідити"

msgid "modules/controls/button/sell"
msgstr "Продати зі Складу"

msgid "modules/controls/button/tooltip/disableReason/battle"
msgstr "Машина в бою. Змінити модулі можна після завершення бою."

msgid "modules/controls/button/tooltip/disableReason/damaged"
msgstr "Машину пошкоджено. Відремонтуйте її, щоб змінити модулі."

msgid "modules/controls/button/tooltip/disableReason/incompatible"
msgstr "Неможливо встановити модуль. Несумісний модуль: {{module}}."

msgid "modules/controls/button/tooltip/disableReason/prebattle"
msgstr "Машина в складі формування."

msgid "modules/controls/descriptor/buyVehicle"
msgstr "Придбайте цю машину, щоб мати змогу змінити її модулі."

msgid "modules/controls/descriptor/disableModule"
msgstr "Щоб мати змогу дослідити цей модуль, дослідіть попередні."

msgid "modules/controls/descriptor/disableVehicle"
msgstr "Дослідіть цю машину, щоб мати змогу дослідити її модулі."

msgid "modules/controls/descriptor/eliteVehicle"
msgstr "Всі модулі досліджено."

msgid "modules/controls/descriptor/moduleMounted"
msgstr "Цей модуль вже встановлено."

msgid "modules/controls/descriptor/researched"
msgstr "Виберіть модуль або машину для дослідження."

msgid "modules/controls/descriptor/vehicleInBattle"
