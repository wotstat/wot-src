msgid "Contact/status/inBattle/halloween"
msgstr "I en Babylon: Dark Tower-kamp"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Affyrer et skud, der uddeler skade og gør målet, og alle fjendtlige køretøjer i en radius på 35 m, fortumlede."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Affyrer et skud, der gendanner hp ved at stjæle dem fra målet og fjendtlige køretøjer i nærheden i en radius af 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Affyr et skud, der gør målet, og alle fjendtlige køretøjer i en radius på 35 m, fortumlede."

msgid "advanced/hw_damageShield"
msgstr "Beskytter mod enhver skade (undtagen ved påkørsel, drukning og faldskade) i 7 sekunder."

msgid "advanced/hw_fastReload"
msgstr "Forøger skudkadence / lader magasin."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Gendanner hp, slukker brande, fjerner fortumlet effekt og reparerer skadede moduler."

msgid "advanced/hw_invisibility"
msgstr "Gør midlertidigt dit køretøj usynligt over for fjender, gendanner hp, reparerer moduler, slukker brand, fjerner fortumlet effekt og behandler alle sårede mandskabsmedlemmer."

msgid "advanced/hw_teamRepairKit"
msgstr "Reparerer skadede moduler, slukker brande, fjerner fortumlet effekt og gendanner nogle hp til allierede køretøjer i dens radius."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Kampevner hjælper dig til at kæmpe mere effektivt i Babylon: Dark Tower-kampe, fuldføre mål og optjene værdifulde belønninger. For at udstyre dem skal du klikke på en af kampevne-pladserne."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Kampevne-pladser"

msgid "hwShell/alt/description"
msgstr "%(bold)s kan med en vis sandsynlighed findes i kamp efter at have ødelagt en fjende."

msgid "hwShell/alt/description/bold"
msgstr "En alternativ granat"
