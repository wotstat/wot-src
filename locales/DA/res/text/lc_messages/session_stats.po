msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Ratioen af samlet skade uddelt i forhold til antallet af kampe i sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Ratio af fjendtlige køretøjer ødelagt mod antal kampe."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Gennemsnitligt køretøjsniveau du har kørt i spilsessionen."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Ratioen af samlet optjent xp i forhold til antallet af kampe i sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Ratioen af samlet skade blokeret i forhold til antallet af kampe i sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Ratioen af skade ved din observering, og skade uddelt af allierede, efter du har ødelagt et bælte og immobiliseret det fjendtlige køretøj, eller gjort det fortumlet, i forhold til antallet af kampe i en spilsession. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Rationen af \"Skade uddelt\" i forhold til \"Skade modtaget parametrene. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Rationen af fjendtlige køretøjer ødelagt i forhold til antallet af gange spillerens køretøj blev ødelagt. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Ratio af fjendtlige køretøjer opdaget mod antal kampe i sessionen."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Procentdel af samlet antal kampe, hvor spillerens køretøj ikke blev ødelagt."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Procentdel af sejre i standard kampe i sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/wins"
msgstr "Antallet af sejre i standard kampe i sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

msgid "propertyInfo/prop/descr/wtr"
msgstr "WTR efter gennemsnitsværdier for hele sessionen. Delta viser effekten på den nuværende spilsession på den samlede parameter."

