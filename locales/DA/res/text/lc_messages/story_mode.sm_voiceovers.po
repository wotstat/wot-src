msgid "vo_sm_char11_m03_stg18_03"
msgstr "Pilot: Halløj, landstyrker, dette er Eagle One."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Pilot: Vi overflyver byen nu, har en ordentlig bunke kampvogne i sigte."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Pilot: Og vi er klar til at lade det regne ned med gaver. Hold hovederne nede."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Pilot: Eagle One slut."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Pilot: Dette er Eagle One, højt og tydeligt."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Pilot: Du har en lille bunke mål samlet på pladsen."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Pilot: Vi gør klar til en overflyvning nu."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Pilot: Alt hvad vi ikke gør til fyrværkeri kan I ordne. God jagt! Skift."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Pilot: Hvor kom de fra? Jeg troede vores luftstøtte havde ryddet himlen."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Pilot: Dette er Eagle One, skift."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Pilot: Du har en stor gruppe pansrede køretøjer på vej fra landsbyen."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Pilot: Vi angriber dem og... for pokker da!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Pilot: Jagerfly, klokken otte... kan ikke ryste ham af."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Pilot: Hvor er vores eskorte, for hulen da! A-a-ahh!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Pilot: Storm Petrel her."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Pilot: Modtaget. King Tiger får snart en dårlig dag."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Pilot: Hvad dælen!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Pilot: Fjende ødelagt."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Pilot: Storm Petrel. Ikke Seagull."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Pilot: Jeg ser den."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Pilot: Mål ødelagt om 3... 2... 1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Pilot: Standby for nye mål, Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Pilot: Pokkers!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Pilot: Det er ikke kun en Jagdtiger dernede. De gemmer sig i bygningerne."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Pilot: Vi skal have noget med mere slagkraft. Tid til noget større!"

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Pilot: Det var det! Klar til den næste!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Pilot: Klar til at angribe på jeres signal."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Pilot: Direkte træffer!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr "Pilot: Modtaget! Angriber!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Pilot: Endelig! Vi tager tilbage til flyvepladsen. Vi ses, drenge!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Pilot: Klar og venter på målet."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Pilot: Afventer bekræftelse af mål."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Pilot: Koordinater påkrævet til angreb."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Pilot: Vi kan ikke ramme den, før I gør den immobil."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Pilot: Det mål skal være stationært, ellers ryger vores præcision."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Pilot: Det er essentielt, at målet er stoppet!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Pilot: Vender rundt, jeg er snart tilbage."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Pilot: Kommer i position, snart tilbage."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Pilot: Klar til angreb."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Pilot: Giv signal til angreb."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Pilot: Stadig standby her."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Pilot: Afventer stadig instrukser."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Pilot: Modtaget. Påbegynder anflyvningen nu."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Pilot: Modtaget. Kommer i position til angreb."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Pilot: Forstået. Angriber målet."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Pilot: Bekræftet. Kommer tættere på til et angreb."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smith: Ikke selve papiret."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smith: Viljen hos millioner. Mænd og kvinder, som har kæmpet for at give det papir betydning."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smith: Aldrig igen."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Kommandør, kaptajn Smith: Rul afsted. Husk, dette er en hemmelig op."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smith: Undgå unødvendige træfninger og afgiv kun ild, hvis det er absolut nødvendigt."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smith: Hvis vi alarmerer hele garnisonen, har vi nærmest ingen chance."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smith: Hvor det er muligt, tager vi en omvej og skjuler os."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smith: Ingen tid at spilde. Sæt i gang. Hvert sekund tæller."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smith: Drop det. Vi er her for at stoppe myrderiet. På begge sider."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smith: STOP! Bak!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smith: Bak!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smith: Bak! Hurtigere!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smith: Kom i bakgear, nu!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smith: Gem os!"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smith: Ser ud til de ikke rigtig fik øje på os."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smith: Mørket er til vores fordel — det tager dem længere tid at identificere en amerikansk kampvogn."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smith: Hvis vi smutter hurtigt igennem, vil de ikke nå at identificere os."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smith: Murphy, få os bag det hjørne."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smith: Godt, Murphy. Vi skal nærme os langsomt. Og afgiv ikke ild!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smith: Lad os snige os endnu tættere. Der!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smith: Hurtigere bevægelser og de vil ikke opdage os."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smith: Jo hurtigere vi kører, jo mindre tid har de til at bemærke os."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smith: Hvis vi kører hurtigt nok, har de ikke tid til at få et godt kig på os."

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smith: Vi skal observere forude. Dubois, undersøg situationen."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smith: Jeg sagde drop det, Kowalski."

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smith: De er på vej væk. Dubois, kom tilbage."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smith: Lad os finde de her kort. Sæt i værk."

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smith: Pokkers! Fjende kl. 12. Kowalski, fyr!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smith: Murphy, undvigelsesmanøvrer. Kowalski, gør det af med ham."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smith: Vi har ingen tid at spilde. Hold larmen nede."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smith: Så er det nok, Kowalski. Vi kommer ikke igennem til vores folk uden Keller."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smith: Lad os komme væk, før andre dukker op."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smith: Tiger! Kom i dækning. Pokkers."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smith: Nej. Kan ikke risikere det. Keller, prøv at distrahere ham."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smith: Keller, kom så. Gør det."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smith: Brug radioen til at snyde dem."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smith: Kom afsted, inden han kommer tilbage."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smith: Dubois, find det kort."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smith: Hvad er det?"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smith: Så vi indsamler kortstykker. Lad os komme i gang."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smith: Glimrende. Murphy, marker det."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smith: Lad os komme videre til næste punkt. Tiden løber."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smith: Lad os bevæge os til den næste post."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smith: Lad os komme videre. Hvert minut tæller."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smith: Dubois, kig efter kortet."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smith: Murphy, hvordan ser det ud?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smith: I det mindste kender vi til andre kommandoposter nu. Afsted."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smith: Dubois? Fundet noget?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smith: Afsted til næste punkt. Tiden løber."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smith: Dubois, så er det dig."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smith: Lad os bevæge os til den næste position."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smith: Murphy, hvordan ser det ud?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smith: Lad os se, hvad vi kan finde."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smith: Keller, er det her en kommandopost?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smith: Fald tilbage!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smith: Start ikke en ildkamp!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smith: Afgiv ikke ild!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smith: Afgiv ikke ild! Det er ikke derfor, vi er her!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smith: Ro på! Vores job er at levere en besked, ikke starte et blodbad!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smith: Tilbage, nu! De vil opdage os!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smith: Tilbage! Lad dem ikke se os!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smith: Bak, Murphy! Hold os skjult!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smith: Uopdaget. Lad os holde det sådan."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smith: Fjenden kan ikke se os."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smith: Tilbage, nu! De har næsten set os!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smith: Fald tilbage! De er lige ved at få øje på os!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smith: Murphy, få os i dækning! De ved endnu ikke, hvem vi er!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smith: Kom i gang! De er stadig usikre!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smith: Ind i skyggerne! De vil ikke kunne genkende os!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smith: Murphy, vend rundt! Ellers får de færten!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smith: Jeg synes vi skal trække os tilbage."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smith: Vi kan ikke risikere missionen. Lad os falde tilbage."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smith: Husk vores mission! Hvis det er sikrere at falde tilbage, så er det det vi gør."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smith: Skift position. De vil undersøge dette område."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smith: Afsted. Det kommer til at vrimle med Panzere her."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smith: De så os ikke. Hold hovedet nede og ikke en lyd."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smith: Åbn ild!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smith: Kampstationer! Hold fokus!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smith: Kontakt!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smith: Klar! Afsted!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smith: Mål nedkæmpet!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smith: Ødelagt!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smith: Hård satan. Næste gang lad os finde en anden løsning."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smith: Må hellere observere forude, før vi kommer tættere på."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smith: Tilbage i kampvognen. Lad os komme videre."

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smith: Nok observering. Videre."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smith: Sæt jer op. Tid til at komme afsted."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smith: Lad os ikke spilde tiden. Afsted."

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smith: Keller kan trække dem væk med en falsk ordre."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smith: Fokuser på målet. Vi har brug for de kortstykker for at redde vores folk."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smith: Afsted! Det er ikke tid til en lur."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smith: Hvert sekund tæller. Kom i gang."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smith: Intet valg. Vi må kæmpe."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smith: Find os en anden vej."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smith: Brug radioen. Før dem væk fra os."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smith: Vent til deres patrulje har bevæget sig."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smith: Kampvognen er repareret, men vi har mistet en masse tid. Hold hovedet koldt."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smith: De er opmærksomme. Nu vil de skyde på os, så snart de ser os."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smith: Hvor kom de fra?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smith: Vi er for tæt på. Kom fremad!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smith: Murphy, bare få os frem i ét stykke."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smith: Tiger! Pokkers!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smith: Han jager os."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smith: Kan ikke gennembryde hans frontpanser, men han skyder gennem vores som var det papir."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smith: Bare hold os kørende — hastigheden er vores eneste fordel!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smith: Fjendens artilleri vågner op. Vi må manøvrere!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smith: Bare gør dit bedste."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smith: Tigeren er tæt på. Hold distancen, Murphy!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smith: Tigeren er for tæt på! Vi må væk!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smith: Træk os væk nu! Han har os i sigte!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smith: Han har indkig på os! Undvig!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smith: Tigeren skød forbi! Vi må ikke give ham en ny chance!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smith: Spar på ammunitionen. Det nytter ikke at skyde på en Tigers frontpanser."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smith: Glem Tigeren — fokuser på de mindre mål."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smith: Bæltet er røget! Han er immobiliseret!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smith: Artilleri! Skarpt til højre!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smith: Artillerinedslag! Mod venstre!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smith: Under beskydning! Stop!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smith: Arty! Undvigemanøvrer!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smith: Artilleribeskydning! Drej nu!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smith: De her kan vi klare. Kowalski, fri ild."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smith: Disse kan ødelægges. Kowalski, bare skyd."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smith: Spild ikke ammunition på en Ferdinand!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smith: Ignorer Ferdinand — vi kan ikke skade den."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smith: Minefelt bag os. Murphy, fuld gas. Vores folk venter."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smith: Keller, skift til allieret frekvens, stil mig igennem."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smith: Alle enheder, dette er kaptajn Jack Smith, 2nd Armored Division."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smith: Vi nærmer os i en M24 Chaffee fra vest."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smith: Skyd ikke. Jeg gentager, skyd ikke."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smith: Vi har hasteordrer fra III Corps HQ. Challenge: \"Torch\". Skift."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smith: Vi er hjemme, drenge. Denne krig slutter her."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smith: For pokker da, vi har fejlet dem alle."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smith: For meget støj. Vi lyser op på enhver radar herfra og til Berlin."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smith: Det er ikke et skydetelt. Vi skal være mere snu."

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smith: Vi skal være mere stille. Hvert skud bringer os uønsket opmærksomhed."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smith: Al denne støj bringer forstærkninger hertil. Vi når ikke frem i tide."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smith: Fangede du noget?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smith: En god en?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smith: Nej."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smith: En gade? Hvordan? Med alle vores navne?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smith: Hold fokus på vejen."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keller: Nie wieder."

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Radiooperatør, Gefr. Keller: Der er en... kommandopost lige udenfor byen. De opbevarer kort over minefelterne der."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keller: Ligner en patrulje. De burde snart bevæge sig videre."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keller: Kommandoposten med kortene. Den er deroppe, på bakken."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keller: Det var et kommandokøretøj."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keller: Hvis dens radio er intakt og sat til de rette frekvenser, kunne jeg..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keller: Nein, giv patruljerne falske ordrer. Distrahere dem. Så vi kan slippe igennem."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keller: Ja, kaptajn Smith."

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keller: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Varsel, Panzer fire! Fjendtlig aktivitet ved punkt Berta)."

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keller: Sofort aufklären!\n(Undersøg omgående!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keller: Dette er kommandoposten."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keller: Disse markeringer viser også kommandoposter. De har fragmenter af kortet med passagen."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keller: For vores... tyske spejdere. Vi burde undersøge stedet."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keller: Her."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keller: Ikke alle officerer har ansvar for minefelterne."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keller: Ser ud til har fundet endnu en kommandopost. Vi burde undersøge den."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keller: Ja, der er måske også et kortstykke."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keller: Nej."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keller: De... de så os ikke."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keller: De har opgivet eftersøgningen... indtil videre."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keller: Jeg kan måske trække dem væk fra vores vej."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keller: Går i luften."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keller: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Varsel! Indtag ny position i sektor Berta. Straks!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keller: Stiller igennem."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keller: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Hasteordre! Omgrupper ved punkt Dora!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keller: Skifter til deres frekvens."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keller: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Fjendtlig aktivitet i sektor Emil! Undersøg straks nærmere!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keller: Sender nu."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keller: Zurückziehen auf Stellung Gustav! Schnell! Schnell!\n(Fald tilbage til position Gustav! Højeste prioritet!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keller: Sender."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keller: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Kampgruppe Nord melder om fjendtlig aktivitet! De har brug for forstærkninger!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keller: Der er ingen på denne frekvens i rækkevidde."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keller: Ingen enheder svarer i dette område."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keller: Der er ingen tyske styrker i nærheden til at modtage ordrer."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keller: Intet svar. Der er ikke en eneste tysk kampvogn i nærheden. Tror jeg."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keller: Nej."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keller: Det kan jeg ikke."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keller: Virker ikke."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keller: Det er delingskommandørens kampvogn, han vil ikke tage imod ordrer fra os."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keller: Delingskommandør... han vil ikke tage imod ordrer fra os."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keller: Delingskommandørens kampvogn. Han tager kun imod ordrer fra bataljonens hovedkvarter."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keller: De har forskanset sig her. Nytter ikke at give dem andre ordrer."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keller: Denne kampvogn er skadet. De bruger den som dækning."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keller: Det er en beskadiget kampvogn. Den bevæger sig ikke."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keller: Deres bælter er ødelagte. De skal nok blive der."

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keller: Achtung! De falder tilbage til deres position."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keller: De kommer tilbage. Vær forsigtig."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keller: Pas på! De vender rundt."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keller: Måske skulle vi... øhh... bevæge os mod kommandoposten?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keller: Før patruljerne skifter?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keller: Lad mig prøve at distrahere dem."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keller: Dette er en patrulje. De burde snart bevæge sig videre."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keller: Der var vi heldige. Skæbnen selv hjælper os med denne mission."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keller: Kaptajn, de melder om en amerikansk kampvogn på radioen."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keller: De vil være på udkig efter os nu."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keller: Jeg hører ordrer om at... at sende forstærkninger."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keller: En særlig enhed leder efter os nu..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keller: Dette er en patrulje. Med rette timing kan vi smutte igennem."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keller: Patruljerne følger fastlagte ruter. Vi kan smutte igennem, når de kører videre."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keller: En patrulje. De skal nok snart forlade positionen."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keller: Disse kampvogne kan alligevel ikke bevæge sig, men de bruger dem som skudpositioner..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keller: Garnisonen er ved at løbe tør for reservedele, men de kan stadig bruge disse kampvogne som bunkere."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keller: Brændstofmanglen betyder at disse nu kun er... befæstede positioner."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keller: Men deres kanoner er stadig farlige."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keller: Kaptajn... Panzer! Lige der!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keller: Måske... måske skulle vi sætte farten ned?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keller: Javel."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keller: Men det skæve tårn er i Pisa... Pisa..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keller: Denne radio er til kommunikation. Vi bruger den til at distrahere patruljer."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keller: Jeg ville ikke..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keller: Jeg kan prøve. Men det ville være tysk musik."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keller: Det er faktisk over 1.000."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keller: Det har jeg. Hårdt ydre, men blødt inden i."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keller: Faktisk så... to mandskaber snakkede om et spøgelse i byen om natten."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keller: Nej... jeg havde aldrig troet jeg ville være i en kampvogn overhovedet..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keller: Jeg er faktisk skrækslagen. Jeg er bare for bange til at vise det."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kowalski: Nigdy więcej."

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Skytte, sergent Kowalski: Hvorfor tog vi denne pølsetysker med? Han vil lede os direkte i en fælde."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kowalski: Ja, selvfølgelig. Stol på den tysker, der har ført os ind i denne fælde af en by."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kowalski: Kalde alle tyskere her?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kowalski: Chaffee er ikke ligefrem bygget til den kamp. Men... hvis Murphy..."

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kowalski: Så gør det da, sig noget til dem."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kowalski: Har du glemt, hvordan man taler tysk, Keller?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kowalski: Sig til den Tiger, at han skal skrubbe af!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kowalski: Hvad? Jeg troede hver post havde et kortstykke. Keller?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kowalski: I det mindste fik vi da tilføjet et par Panzers til vores liste."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kowalski: I det mindste fik vi da tilføjet et par Panzers til vores liste."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kowalski: Og fandt også nogle nye kommandoposter."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kowalski: Hvad hvis det er en..."

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kowalski: Blinde idioter."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kowalski: Ha! Hvordan skød de forbi?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kowalski: Lad os komme væk, før flere krauts dukker op."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kowalski: Blinde idioter. De får ikke endnu en chance."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kowalski: Endelig! Så sker der noget!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kowalski: Klar. Hvem er det så?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kowalski: Fik dig!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kowalski: Ikke så mægtig nu, vel? Men vi mistede en masse tid."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kowalski: Lad os ikke køre ind i blinde. Hvad synes du?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kowalski: Måske kan Dubois kigge sig lidt omkring?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kowalski: Nej."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kowalski: Stop med at spilde tiden! Dette kort er vores billet gennem minefeltet."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kowalski: Kom videre, eller jeg begynder snart at skubbe kampvognen selv!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kowalski: De beder om det. Lad os vise dem noget gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kowalski: Okay, denne gang prøv at undgå deres skudbane."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kowalski: Okay, opvarmningen er forbi. Nu skal vi i gang med arbejdet."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kowalski: Se hvad vi har her!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kowalski: Vores kanoner er klar til at skyde ethvert øjeblik nu. Fart på!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kowalski: Skud! De har set os!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kowalski: Tigeren sigter! Hvis vi ikke får rystet ham af, er vi færdige!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kowalski: Tigeren er ved at skyde... jeg kender det sigte!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kowalski: Kurde! Hvis det var mig, havde jeg ramt plet."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kowalski: Er det alt, Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kowalski: Świetnie! Lige hvor den skulle sidde!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kowalski: Se hvad vi har her! Nemme mål!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kowalski: Nytter ikke. Vi kunne lige så godt kaste sten på den!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kowalski: Murphy, glemte du? Der er miner over det hele!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kowalski: Dostał!"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kowalski: Myrderiet begynder. Vi var for langsomme..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kowalski: Kun til bryllupper."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kowalski: Er det et frieri, Murphy?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kowalski: Murphy, lad os snakke om din kørestil."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kowalski: Er det med vilje, at du rammer hvert eneste bump på vejen og kører op ad skråninger for at få kampvognen til at hælde?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kowalski: Samme for dine allierede."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kowalski: Nogle gange er jeg bange for, du er gået fra forstanden, Murphy."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kowalski: Helt alvorligt, jeg er nervøs på dine vegne."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kowalski: Ikke længere."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kowalski: Det tvivler jeg på."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kowalski: For en skolelærer i en kampvogn er du underligt rolig, Keller."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kowalski: Okay. Det var da overraskende... ærligt."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kowalski: Dubois, hvad er det du nynner?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Javel, forstået! Rykker mod punkt Berta!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Forstået, rykker mod Berta)."

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Javel, omgrupperer)."

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Javel, påbegynder rekognoscering)."

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Forstået, falder tilbage)."

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Bekræftet, er undervejs)."

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Scharf: Kommandør, vi har begrænset luftstøtte klar."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Du kan anmode om luftangreb efter behov."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Du kender til radioteknologi, ikke? Hele øen ved allerede, du er der."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Hvis det er muligt, så erobr køretøjet intakt. Overkommandoen vil have det undersøgt."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Ligner det noget tysk?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Med tanke på antallet af køretøjer, må de have værkstedsfaciliteter"

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: et eller andet sted på denne ø."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Skynd dig. Raketten venter ikke."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Jeg sagde jo, jeg skulle være taget med dig. Du rykker for langsomt frem."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Prøv i stedet at slå den ud, uden at forårsage for meget skade. Vi skal bruge den intakt."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni: Prøv bare. Okay?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Vær ekstremt forsigtig. Det er en fælde."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Vi har opdaget deres radiofrekvens."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Har aflyttet deres radiobeskeder i de sidste syv minutter."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Du har ikke stoppet med at snakke, så jeg kunne give dig besked."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Måske prøv at være stille en gang imellem, Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni: Nyt mål modtaget: Det køretøj skal erobres intakt."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Hvad har det? Nogle moduler, der ikke er standard? Særligt udstyr?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Kommandør, er du sikker på, du ikke vil prøve denne nye kampvogn?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Med tanke på bagholdet, der venter, ville den ekstra ildkraft være fordelagtig."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, du er klar over, at han ikke kan høre dig?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Jeg opfanger kun hans meldinger, jeg udsender ikke vores."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Statusmelding. Er det kun tysk panser, vi er oppe imod?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Som jeg mistænkte. Dette er mere kompliceret, end vi troede."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: Ifølge de opfangede radiobeskeder..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Påmindelse: Det køretøj skal erobres intakt til analyse. Og ja, okay..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: Jeg vil også gerne selv undersøge det."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Rettelse: Vi har ingen endelig bekræftelse på at de er tyske."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Nuværende efterretninger peger mod en international gruppe af lejesoldater."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Den stemme... noget bekendt ved deres kommandør. Jeg har hørt den før, et eller andet sted..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: Det ville være meget pænt af dig."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Ja, tak."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Hvad skete der?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Det er lige nøjagtig derfor, jeg bliver ved med at insistere på at erobre disse køretøjer intakte."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Bring mig de eksperimentelle køretøjer, og jeg skal bygge dig noget... imponerende."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Kommandør, jeg foreslår at prøve den nye kampvogn. Den kan give dig unikke kampevner."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Nuvel, måske er det et fornuftigt valg at efterlade den der."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Den skal nok forblive intakt, og vores ingeniører kan bjærge den efter missionen."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Nogen eksperimentelle maskiner blandt dem? Noget usædvanligt?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Denne Adler-gruppe... vi må undersøge dem."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: De kunne hjælpe til med at identificere vores mystiske kommandørs baggrund."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Vi sporer raketten på vores radarsystemer. Der er kun et snævert vindue."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Nyt mål: Indtag kontrolcenteret for flyvningen. Måske kan vi fjernstyre dens retning."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Udfør det straks."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Hvilke overraskelser har denne kampvogn til os?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Denne nye tunge kampvogn har forstærket panser. Optimalt til at bekæmpe flere mål samtidigt."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Kommandør, jeg anbefaler bjærgning."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Vores teknikere er på vej til kontrolrummet for flyvningen. Hold jeres positioner. Vi skal bruge tid."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Vi skal holde dem væk lidt længere."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Ja, det er fint... ikke nu!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Vi kan ikke overtage kontrollen. Uanset hvad vi prøver, kan vi ikke ændre dens retning. Men..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: der er noget mystisk her."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Dit vindue er ved at lukke sig. Spild ikke tiden."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Missionstiden løber ud. Kom i gang."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Jo længere du er stationær, jo mere tid har de til at forberede deres forsvar."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Fortsæt til målet."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Vi har mistet den forreste kampvogn. Hold formationen!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Kommandørens kampvogn er slået ud. Vi klargør en ny til ham."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Vi har ikke ubegrænsede forstærkninger. Vær mere forsigtig."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Næste gang, reager hurtigere, ellers er der ikke en næste gang."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Deres værksteder indeholder et begrænset antal af disse kampvogne."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Vær venlig at benytte mere omtanke næste gang."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Mål fejlet. Vi løb tør for tid."

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Alle kampvogne gået tabt. Missionen er fejlet."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Luftstøtte indsat. Gør klar til nedslag."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Flyene har angrebet målet. Nedslag om et par sekunder."

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Målet kan ikke nås af luftstøtten."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Artilleriaffyring opdaget. Kom væk derfra!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Fjendtligt artilleri affyret. Nedslag om få sekunder. Flyt jer! Nu!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Fjendtlig observatør tilkalder beskydning på vores position. Kom væk fra nedslagsområdet nu!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Afvist."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Vejrforhold. Overskyet. Temperaturen er 8 grader. Vindhastighed 6 meter i sekundet, nord-nordøst."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni: Jeg har nogle teorier. Men jeg skal bruge flere beviser, før jeg kan dele dem."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Den sidste person, der kaldte mig skat, mistede to fingre."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Men en stille aften det rigtige sted... ændrer jeg måske mening."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, du tager unødvendige risici."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: Og livet med for mange risici ender for tidligt. Som din forgængers."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Klogt valg."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Det tager jeg som et kompliment."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: Det er ikke magi."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: Det er en fokuseret elektromagnetisk puls, der midlertidigt kan forstyrre deres elektriske systemer."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Bare kom tilbage i live. Det er en administrativ byrde at erstatte trænet personel."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Hvis du gør den sætning færdig, med en sammenligning af mig,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: så vil jeg personligt sørge for, din næste mission bliver i Arktis."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Han bestod. Jeg har dokumentation på det lige her."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Alt dette føles... udspekuleret."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Hver barriere, hvert forsvar — de køber sig tid, men prøver ikke at stoppe os helt."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Jeg tror, vi er en del af nogle andres planer, og jeg bryder mig ikke om at være en brik i et spil."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Jeg udregner overlevelsesmuligheder baseret på de nuværende missionsparametre."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Jeg har besluttet mig for ikke at dele resultatet. Moral er også vigtigt."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Jeg har fulgt dem."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Der er en forringelse i kvalitet på 23% siden missionen begyndte, men en forøgelse på 47% i frekvens."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Kend dine allierede."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Aldrig."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Denne eksperimentelle enhed er en ægte trussel. Juster straks taktikken."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Kommandørens kampvogn er ødelagt. Den maskine er mere effektiv end først forventet."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Se al denne ravage! Som en flok ulve, der hærger blandt en flok får."

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Men som vi siger i min landsby, \"Den anden bølge bryder dæmningen\"."

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Tyskere... hvem skulle have troet det?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: Der er en, der løber! Vi må stoppe ham, før han henter sine venner!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Ja, men nu er han alene. Meget nemmere at slå ham, end når han vender tilbage med sine kammerater."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: Se, det er mere min stil! Skyd først, se hvad den langløbede ting er bagefter!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Så du det skud?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: Det skal nok lære ham, ikke at vifte rundt med den fine kanon her!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Erobre? Med al respekt, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: jeg foretrækker at skyde først og lave rekvisitionen bagefter."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Den ting gjorde os næsten til skrotmetal! Men fint nok, jeg skal nok prøve ikke at ramme noget vigtigt..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: kun hans ammunitionsstativ."

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Se der — endnu en kampvogn, jeg aldrig har set før!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: Nu ved jeg snart ikke længere, hvem vi kæmper mod."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Det ligner noget, der er helt det modsatte."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Jeg håber snart vi finder deres ammunitionsdepot. Jeg er ikke sikker på, at jeg har nok granater til dem alle."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Endnu en slået ud! Jeg kan lide det!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Dan en linje, dan en linje! Kom én af gangen. Jeg har en lille gave til hver af jer."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Han går mig på nerverne! Vent, reparerer han sig selv, eller hvad?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Bare vent — jeg skal nok få fat i dig, og skille dig ad, møtrik efter møtrik!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Er du helt sikker på, du er på vores side, Leni? Den tingest prøver at gøre det af med os!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Vent lidt. Nu forstår jeg... dig! Ikke OVERKOMMANDOEN. Det er dig, der vil have fingre i denne kampvogn."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Du er skør med... lange kanoner, der kan ramme plet på lang afstand!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Er det en fælde? Og hvordan ved du det, fräulein spåkone?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Sendte de dig en invitation til deres bagholdsfest?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Aflytter du deres beskeder? Og det siger du først NU?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: Jeg elsker også dig, Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Se engang på den smukke sag! Hun er fantastisk!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Ah, nein-nein-nein! Dette delikate udstyr er ikke noget for mig. Denne skønhed har brug for en nænsom behandling."

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Kommandør, du bør overtage."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Hvis jeg kører den, så skal vores ingeniører samle delene op i spandevis!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: Sådan skal det gøres! Vi er klar til at køre lige ind i deres lille fælde!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"Når du har den største hammer, så ligner ethvert problem et meget lille søm!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: Det er lige, hvad vi skal bruge! Nu skal der deles øretæver ud, kommandør!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Bare se dette bæst! Kommandør, det vil være kriminelt bare at køre forbi!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Måske skulle du alligevel sætte dig ind?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Åh nej! Det er et dårligt tegn! Et dårligt tegn for dem, lad os ødelægge deres baghold!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Mål! Ha! Du er ved at blive forudsigelig, Ulysses. Altid de samme kommandoer."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Fjende? DU er fjenden!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Hey, Herr Skurk, hvorfor kommer du ikke herover og snakker med os ansigt til ansigt?"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Selvfølgelig ved jeg det! Jeg... giver os bare noget god moral."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: Okay, her er den mest snedige del af deres baghold."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: De kan ikke gennembryde vores panser med granater, så de prøver at kaste sten på os i stedet."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Snu lømler!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Nej, det er det mærkeligste. Kan ikke engang se, hvem vi kæmper mod."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Endelig! BAGHOLDET! Hey Leni, hvad er der ellers på menuen?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Hvilke andre overraskelser har Mr. Evil planlagt for os?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Nej nej, lad være at sige det! Ingen spoilere, jeg vil selv se det! Vi er klar til alt, hvad de kan komme med!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Undslippe? Hvad mener han med 'undslippe'? Vi prøver ikke at undslippe."

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: Vi kommer efter DIG og din skumle stemme. Og ja, Leni, jeg ved han ikke kan høre mig."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: Når jeg får fat i den tarvelige rotte, skiller jeg ham ad stykke for stykke!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: Nu ligner det noget. Jeg skal gøre mit bedste, Leni."

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! Og ned kommer den. Forudsigeligt som et schweizisk ur — bortset fra det er tysk."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Hov, se! Flere legekammerater! Jeg var lige ved at tro, vi ville løbe tør for mål at øve os på!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: En af dine gamle venner? Skal jeg også tage ham med?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: Lad mig gætte — ham vil du også gerne have intakt?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Jeg skal gøre mit yderste."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Hov, hvad pokker var det? Okay, okay... der fik de mig. DET var uventet."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Hvad I alverden var det? Kampvognens elektriske systemer... stoppede bare med at virke?"

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Hvorfor giver vi ikke også vores kampvogne et par esser i ærmet?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Jeg ville da gerne have et par spiondimser på min kampvogn!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Lover du mig det, fräulein? Jeg glemmer det ikke!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: Jeg forstår. Fjenden har også en \"efterlad dine kampvogne og håb på det bedste\"-strategi."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Modigt!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: Modtaget, Ulysses. Jeg gemmer mit bedste materiale til senere."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Mein Gott, fräulein! Du er mere optaget af disse nye kampvogne"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: end min onkel Pavel, med hans samling af kviste og grene, han har fundet over hele landet!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Jeg må dog indrømme, nogle af dem er ret flotte."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Åh nej, nogen har det ikke så godt! Ser ud til vi har såret hans følelser."

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Vær ikke nervøs, fräulein, jeg lovede at tage ham med til dig, ikke?"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Jeg kan dog ikke garantere, at han ankommer uden et par... skrammer."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy: Du kan selv udspørge ham."

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Du milde makron... den raket er meget større end den så ud til på lang afstand!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Som min onkels historier om de fisk, han plejede at fange — bortset fra at denne her ER så stor!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Det her... det her sker bare ikke. Vi var så tæt på! Alt det... for ingenting?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Jeg kommer til at smadre hver eneste af dem og skære en vej igennem lige til det kontrolcenter."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Så sender vi den forbandede raket lige i havet!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Kommandør, du bør tage det bæst."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: De banditter har måske nok affyret deres raket, men de kommer ikke til at forlade øen uden skrammer."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Jeg forstår. Jeg foretrækker også noget, der er mere smidigt end de her tunge drenge."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: Det bedste forsvar er at blive i bevægelse."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Du går ingen steder, din lømmel. Det eneste sted du \"evakuerer\" til"

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: er vores forhørslokale. Og jeg skal nok selv tage dig med dertil."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Kom så bare, med alle I har tilbage! Marcher lige herover —"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: spar os besværet med at jagte jer, når I beslutter jer for at løbe væk med halen mellem benene."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: Lad os gøre arbejdet færdig, lige her og nu!"

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Perfekt timing! Jeg har noget vrede, jeg skal ud med."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: Endelig! Vores gamle ven med hans store ego vil tage del i morskaben."

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: Nu kan vi afgøre vores lille kamp, én gang for alle. Spørgsmålet er bare —"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: hvem af os skal sende ham til skrotpladsen?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Jeg mener, til Lenis værksted."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Det var det. Kære Leni, jeg ved du ville have ham intakt, men..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: vi har måske givet hans maling et par skrammer."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter? Det navn skal jeg nok huske."

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Ved du, hvad vi i Tjekkoslovakiet kalder kampvogne, der ikke bevæger sig? Målskydning!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: Og jeg har ikke lyst til at lege mål i dag."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Vi er ved at gro fast her. Tid til at komme videre!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Flyt dig eller bliv flyttet, kommandør! Eventyret venter!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Langløb er tilbage i position. Skub ham ned!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Tilbage i din hule, din langløbede bums!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Hvad i alverden er det?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Kanonløbet er længere end min tante Katarinas lange liste af fejlede ægteskaber."

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: Og tro mig, det siger en hel del!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Hvad? Havde han lige et værksted i lommen?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Utroligt! Langløb er repareret! Vi fik med sikkerhed gennemhullet det bæst!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Han er lappet sammen! Hvordan pokker gjorde han det?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Pokkers! Kommandørens kampvogn er nede — hold dem optaget, indtil han er tilbage!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Kommandøren er ude! Hold fast, han er tilbage på ingen tid!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Skifter du slæde igen? Lad os ikke gøre det til en tradition."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: Godt vi har nogle ekstra — men pas på."

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Hov! Ro på! Jeg tror ikke de efterlod os ret meget af deres legetøj."

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Prøv at lade være med at ødelægge flere."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Pokkers! De fik mig — lad nu være med at more jer for meget uden mig!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Der røg min slæde — jeg snupper en ny!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Av — så blev det min tur! Ro på, jeg er straks tilbage!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: For pokker da! Det forvoksede bæst fik mig!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Okay, du vinder denne runde... men jeg vender tilbage!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Goddag, verden! Det er mig igen! Savnede I mig?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Jeg er tilbage. Ny kampvogn. Den gamle havde en underlig motorstøj... og lidt for mange huller."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: For hulen da! Jeg er nede. Gør det af med dem for mig, gider du?"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Hvad? Hvordan? Nej, nej, nej... det kan ikke passe. Vi tabte? Jeg kan ikke tro det."

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Nu har vi ikke flere kampvogne... jeg er rasende! Forbandet!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Se nu hvem der dukkede op til festen."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Den ser dyr ud. Lad os se den brænde."

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BOOM! Leni, sikke en skam du ikke kunne se, hvordan kommandøren lige gjorde det af med den prototype."

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Godt klaret, kommandør! Jeg håber, de har gemt kvitteringen — den er ikke så god, som de troede."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Så meget snak... prototype her, avanceret teknologi der..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Jeg har ødelagt den! Deres testkørsel gik skævt!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Nu går det løs! Lad os smadre noget panser!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Kanonerne er klar! Lad os give dem en varm velkomst!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: Det var det, vi er færdige her — lad os rulle videre!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Det var den sidste. Lad os ikke spilde tiden. Videre, videre!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Så er arbejdet gjort færdigt. Hvem er de næste?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Boom! Den kommer ikke til at genere os mere!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Endnu en går i gulvet! Godt gjort!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Sådan skal det gøres, lad os finde et nyt mål til dig!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: Og endnu en nede — hvem er dit næste mål?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Den er min!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Fik ham!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Næste!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Så er der dømt fyrværkeri! Lad os slappe af og nyde forestillingen!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Bomberne er sluppet! Lad os se, om de bryder sig om lidt nedbør."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Vores pilot kan ikke udføre mirakler!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Det var en chokerende udvikling!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Zap! Nu er de bare som sild i en tønde — lad os snuppe dem!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Ser ud til, de har en strømafbrydelse!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: De er kortsluttet! Lad os gøre det af med dem!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Modulært panser virker perfekt! Som min onkel Pavel altid sagde,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"En god mekaniker kan fikse alt, på nær et knust hjerte!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Et vidunder af moderne ingeniørkunst!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Skifter panserplader hurtigere end min bedstemor kunne skifte mening!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Din kampvogn er som ny! Uden rust og ekstra huller."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Udskiftede panserpladerne? Nu ligner din kampvogn ikke længere en hullet ost."

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Meget mindre appetitlig!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Nogen overvåger os med kikkert og en radio! Få gang i bælterne!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Den snu artilleriobservatør har set os! Kom væk!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Deres observatør har oplyst din kampvogn med et usynligt sigte! Skynd dig væk!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Boom er på vej! Kom væk, medmindre du vil være en del af landskabet!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: De har tilkaldt de store kanoner! Du skal væk, nu!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Skynd dig! Ram dem med dine særlige granater, mens de viser sig frem!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Den kampvogn pønser på noget! Luk ned for den, inden det er for sent!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Se bare! De lapper sig selv, som om det er ren magi! Det skal vi nok fikse!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, du vil elske denne teknologi! De reparerer sig selv midt under kampen!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Skal jeg bringe et eksemplar med tilbage?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Hold da op! Ham her tror, han er med i et racerløb! Lad ham ikke kysse dit panser!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Hvad hulen! Har han monteret raketter på kampvognen?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: De har ødelagt dit særlige udstyr, kommandør! Tilbage til den gamle skole for nu!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Din kampvogns særlige magi er væk, kommandør! De har ramt dig med deres anti-sjove granater!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni, hurtigt spørgsmål — har vi efterretninger om, hvor mange fjender, der er på denne ø?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Ved de overhovedet noget som helst?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: Det var da noget!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy: Disse lejesoldater har bedre grej end vi har! Nogen bakker dem op med seriøse summer."

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Ooh, mystisk! Jeg elsker, når du er helt hemmelighedsfuld."

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni, søde, når dette er overstået, så tager jeg dig med til Prag."

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Der er den her lille kro — bedste saltkringler og gullasch,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: lige den type sted, hvor du kan slappe af og nyde aftenen. Du er for anspændt!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Et liv uden risici er som gullasch uden paprika — smagløst og uinteressant!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Vent... hvad? Var der en forgænger? Hvad skete der med ham? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Min bedstefar sagde altid: \"Stol på dine instinkter, men dobbelttjek din ammunition\"."

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Han ville have synes om dig. Han værdsatte altid farlige kvinder."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Det var det også ment som!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Denne eksperimentelle ammunition er fantastisk! Den slår bare deres systemer fra som var det magi!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Du må være fantastisk til børnefødselsdage."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: \"Det er ikke en kanin, børn, det er bare en tam oryctolagus cuniculus\"."

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Hey Leni, når det her er overstået, hvilken slags souvenir vil du gerne have?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Jeg tænkte måske at give dig den skarpskyttes kanonløb."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Du virker til godt at kunne lide langtrækkende våben."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Er det tysk for, \"jeg kan godt lide dig\"? Jeg er rørt!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni, hvis du var her, ville du sætte pris på, hvor smuk denne eksperimentelle kampvogn er."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Slanke kurver, kraftfuld motor, lige som..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: ...lige som tysk ingeniørkunst bør være! Hvad troede du, jeg ville sige?"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Spar på ammunitionen? Hvad bliver det næste? Genbruge teposer? Vaske plasticskeer? Tørre papirservietter?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Jeg vil vædde fem dollars på, at vores mystiske lejesoldaters kommandør med den uhyggelige stemme, har et sjovt overskæg."

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Alle gode skurke har overskæg."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Ti dollars på, at han vikler det om sin finger, når han tror ingen kigger."

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Har du set deres formation? Vores venner har læst militære tekstbøger."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Kapitel et: \"Hvordan du bliver omringet og udslettet med tre nemme skridt\"."

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Overmod, inkompetence — begge dele ender med en eksplosion, min ven."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Ved du, hvad der lidt mærkeligt? Jeg nyder faktisk denne mission."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Billedskønne landskaber, usædvanlige nye kampvogne, mystiske fjender..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Jeg vil kalde dette for \"aktiv rekreation\"!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Psykologisk evaluering? Skulle vi have haft en psykologisk evaluering?"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: Nå... så den snak med den søde dame var en evaluering..."

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: Hvad mener du?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Det er en vittighed, ikke?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Ha! Deres eliteenhed var ikke så elite endda!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Bare et par enkelte fjender mere mellem os og den raket."

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Min bedstemor kunne rydde vejen med hendes træske!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Pokkers! Det overdimensionerede bæst fik kommandøren — nu er det blevet personligt!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Den tingest fik ram på kommandøren? Okay, nu er jeg vred!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Corvin: Ulysses her. Vi er landet. Pokkers... stranden er en kampvognskirkegård."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Ingen overlevende fra første bølge. Vi kan ikke spilde tiden."

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Vi skal nå kommandocentralen og stoppe affyringen for enhver pris."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Kontakt lige frem! Tyske kampvogne, klokken elleve. Fri ild."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Ny kontakt! Støtteild!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Han trækker sig tilbage."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Vi skal holde os i gang. På denne afstand har vi ikke en chance mod den ildkraft."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Vi skal tættere på, find en måde at flankere den på. Skub fremad!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Hold fokus! Vi skal eliminere fjenderne her først."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Vi tager os af den langløbede lømmel senere."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Nye fjender opdaget forude."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Pokkers, denne gang er der flere af dem."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Jeg har set værre odds i Nordafrika. Bliv ved med at trænge frem, vi skal nok bryde igennem."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Arbejd sammen. Sigt mod deres flanker!"

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Den langløbede er tilbage! Støtteild, NU!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Hold jer i bevægelse. Den hurtigste vej til raketten er gennem denne fabrik."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Hold positionen. Ser ud til vi har fundet noget... interessant."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Forladte kampvogne. Ukendte modeller."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: Disse granater ser eksperimentelle ud. De vil formentlig midlertidigt deaktivere fjendens køretøjer."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Kommandør, den eksperimentelle kampvogn kunne give os en kritisk taktisk fordel."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Jeg anbefaler på det kraftigste, at du overtager den."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Pas på!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Lige forude! Flere!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Klare kommandoer som disse holder os i live, min muntre ven."

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Forsigtig!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: De forsøger at omringe os. Indtag jeres positioner!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Vi har ikke tid til lange kampe. Gør det kort og beslutsomt!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Se det hul i muren. Vores ven i midten kan beskyde os gennem det. Hold jer i dækning."

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Ingen tid til diskussion. Tiden løber — videre!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Ny trussel identificeret. De bruger en eller anden slags eksperimentel ammunition,"

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: der midlertidigt slår vores elektronik ud."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Det her er ikke almindelige lejesoldater — de har avanceret grej, som vi aldrig har set før."

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Se der, endnu et feltværksted... og igen nogle kampvogne, som jeg ikke kan identificere."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: God fangst."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Denne kampvogn er udstyret med en slags modulært panser, som hurtigt kan udskiftes i felten."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Det kunne godt være nyttigt."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Nu bør vi justere vores taktik."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy og jeg tager fronten, mens du yder dækningsild bag os."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: Det vil holde den nye kampvogn i sikkerhed, så du kan få det meste ud af den imponerende kanon."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Ser ud som om denne Adler-gruppe er en slags eliteenhed,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: der er langt farligere, end noget andet vi hidtil har mødt."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, læg vittighederne på hylden, og vis dem, hvad vi kan."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Vores primære mål er at stoppe raketaffyringen. Alt andet er sekundært."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Bliv ikke distraheret."

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Du er næsten ved målet. Et sidste fremstød!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Nej! Nej! FOR HELVEDE, NEJ!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Vi fik ikke stoppet affyringen. Missilet er på vej op."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Bekræftet."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: Endnu et reparationsværksted forude. Der er ukendte tunge kampvogne her."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Ser ud til at være markant mere pansrede, end noget andet vi har mødt indtil videre."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Overraskelsen er... der er ikke noget særligt ved det."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: Altså, bortset fra et usædvanligt stærkt panser og en usædvanlig langsom hastighed."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: Og det er præcis, hvad vi har brug for lige nu."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Affyringssted sikret. Vi holder positionen ved indgangen til bunkeren."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Nye fjender på vej. Skifter til en bedre defensiv position."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Ser ud til du får dit ønske, Teddy. De kommer alle her i stedet for at evakuere."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Dette ser ud til at være den største bølge hidtil."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Bevægelse opdaget i midten! Den langløbede prototype er tilbage."

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, hvad er status på raketten?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Hvad mener du?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Stå stille, og vi ender som den første bølge. Lad os komme videre."

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Tiden løber. Fremad."

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Det gør os til nemme mål at sidde her. Vi skal videre."

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Kontakt i midten! Hold ham nede!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Skarpskytten er tilbage — hold presset oppe, lad ham ikke få et rent skud!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Kampvognsjæger i midten — repareret og klar!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Hvordan reparerede han skaden så hurtigt?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Hold øjnene åbne! Kommandøren er nede, men ikke længe!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Kommandøren er ramt! Hold presset, han er snart tilbage!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Du er tilbage i kampen, perfekt! Men lad os være lidt mere forsigtige."

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: Det var for tæt på. Næste gang, så pas bedre på din kampvogn, okay?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: Disse reparationsværksteder har ikke en ubegrænset mængde nye kampvogne."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Vær mere forsigtig næste gang."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Fordømt! Jeg er nede! Er snart tilbage."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: De fik mig! Hold jer inde i kampen, jeg er straks tilbage!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Jeg er ramt! Hold presset — jeg vender tilbage!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Jeg er nede. Pokkers — den tingest er hårdere end de andre."

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Tog en direkte træffer... disse nye kampvogne mener det alvorligt."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Jeg er tilbage. Forhåbentlig ingen overraskelser denne gang."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Tilbage i kampen. Pokkers... nogle gange er der bare for mange af dem."

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Ulysses: Min kampvogn er ramt. Jeg er ude af kampen — gør missionen færdig for enhver pris!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Fordømt... vi var for langsomme. Det var vores fejl."

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: Det var det. Ikke flere kampvogne. Kampen er forbi."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Fjendtlige forstærkninger på vej. Gør klar."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Ny fjende opdaget. Det er ikke en almindelig kampvogn — hold jer klar."

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Godt skud! Eksperimentel enhed ødelagt. Det er ét problem mindre."

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Flot arbejde! Det var deres bedste. Lad os holde presset."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Stort mål neutraliseret. Lad os se, hvad de ellers kan byde på."

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Deres bedste var ikke godt nok. Lad os gøre denne kamp færdig."

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Kontakt! Fri ild!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Går i kamp. Hold jer vågne."

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Sidste mål nede — videre!"

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: Det var den sidste — området ryddet, videre."

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Fjendtlig gruppe neutraliseret — vi rykker frem."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Mål nedkæmpet."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Fjende elimineret."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Godt skud!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Jeg har elimineret truslen."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Jeg fik ham."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Jeg har din ryg, bevæg dig frem!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Luftstøtte på vej. Afvent nedslaget."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Angreb bekræftet. Hold jer ude af nedslagsområdet."

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Luftstøtten kan ikke ramme den position. Juster jeres målkoordinater."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Mål fortumlet — nu kan vi slå til!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Fjendens systemer er slået ud. Gør det af med dem!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Fjendens særlige evner er deaktiverede. Angrib! Nu!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Dit brud på skroget er blevet forseglet. Kampeffektivitet tilbage på optimalt niveau."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Modulært panser udskiftet. Dit køretøj er kampklart igen."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Panserplader udskiftet. Dit beskyttelsesniveau er nu tilbage til normal standard."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Dit panser er repareret! Fortsæt med missionen."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Artilleriobservatør opdaget! Ryd straks nedslagsområdet!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Artilleribeskydning på vej! Kom væk — NU!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Fjendtlig artilleribeskydning på vej! Vi har få sekunder til nedslag — kom væk!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: De indsætter eksperimentelle systemer. Slå dem ud af drift! Brug din særlige ammunition nu!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Målet klargør et særligt angreb. Gør dem fortumlet, før han er færdig."

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Fjenden reparerer sig selv. Det er skidt."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: De implementerer reparationer i felten. Vi skal uddele skade hurtigere end de kan reparere det."

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Fjenden sætter fart på til en påkørsel! Undvigemanøvrer!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Fjenden nærmer sig i fuld fart. Lad dem ikke skabe kontakt."

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Kommandør, de har ramt dit elektriske system. Elektronisk udstyr er midlertidigt ude af drift."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Direkte træffer til kontrolmoduler. Dine komplekse elektroniske systemer er midlertidigt nede."

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, du skal spare på ammunitionen. Færre skud, bedre sigte."

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Jeg kan ikke se værdien i nyttesløse spekulationer og væddemål."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Deres positionering tyder på overmod, ikke inkompetence. Undervurder dem ikke."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, din tro på rekreation har brug for en seriøs genovervejelse."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Er du sikker på du bestod den psykologiske evaluering før denne mission?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Tror du vi bliver manipuleret?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, du er usædvanligt stille. Hvad tænker du på?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: Og?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, jeg har brug for din ærlige mening. Bliver Teddys vittigheder værre eller bedre?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Du analyserer rent faktisk hans vittigheder?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: Lad os skubbe frem — vi nærmer os affyringsstedet. Vi skal sikre det før affyringen."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Kommandøren er nede! De nye køretøjer er virkelig en udfordring."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Ulysses: Vi undervurderede den tingest. Bevar fokus, kommandøren er straks tilbage."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Denne kampvogns primære kanon ser ud til at have evner til at forstærke skaden."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Under bestemte forudsætninger kan den uddele exceptionel skade, når den bruges korrekt."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Lige hvad vi skal bruge mod disse tunge enheder."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: Og se på bevæbningen. Denne kampvogns primære kanon ser ud til at have evner til at forstærke skaden."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Under bestemte forudsætninger kan den uddele exceptionel skade, når den bruges korrekt."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Lige hvad vi skal bruge mod disse tunge enheder."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Denne kampvogn har et forbedret målsøgningssystem."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Det ser ud til, at jo længere du forbliver stationær, jo mere præcise bliver dine skud."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Perfekt til skarpskydning."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Men endnu mere interessant, denne kampvogn har et forbedret målsøgningssystem."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Det ser ud til, at jo længere du forbliver stationær, jo mere præcise bliver dine skud."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Perfekt til skarpskydning."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Interessant, denne har sekundær bevæbning installeret."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Du kan bevare dækningsilden, selv når din primære kanon lader."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Taktisk fordel mod svagt panser."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: Okay, endnu en ting. Denne har også sekundær bevæbning installeret."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Du kan bevare dækningsilden, selv når din primære kanon lader."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Taktisk fordel mod svagt panser."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Dette køretøj har noget udstyr, der ikke er standard. Det her er ikke almindelige modifikationer —"

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: de har opfundet noget ganske særligt her. Prøv det af, kommandør."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Se, hvad teknologien kan gøre."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: Der er avanceret teknologi integreret i denne kampvogns systemer."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Vi bør udnytte disse evner til deres fulde potentiale."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Kommandør, eksperimenter med styringen — opdag, hvad disse systemer kan gøre i kamp."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Ingeniørarbejdet på denne prototype er bemærkelsesværdigt. Det her er ikke almindelige kampmodifikationer —"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: de kan være udslagsgivende. Prøv det, kommandør."

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Prøv alt det, disse systemer kan yde, og vis vores modstandere, hvad deres egen teknologi kan gøre."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "Et af vores prototype-køretøjer blev erobret af fjenden. Identificer målene med omhu."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta og Dora, indled kampen med forsigtighed. Forsink dem så længe som muligt."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Fjendtlige styrker nærmer sig fabrikken. Kampfgruppe Berta og Dora, indled kampen."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Forsink dem så længe som muligt."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Bemærk, Team Zeppelin. Bevæg jer til fabrikken. Indtag defensive positioner og hold stand."

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, bevar kontrol med udgangene. Lad dem ikke undslippe området."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Igangsæt Protokol Valkyrie. Alle enheder bekræft."

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Alle enheder, indtag defensive positioner. Adler-gruppe, indled kampen."

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Alle enheder. Indled kampen. Dobbelt bonus til dem, der eliminerer fjenden."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Hvad i alverden?! Arkitekt, vi er ikke klar! Jeg har stadig kampvogne i sprængningsområdet!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Alle enheder, kom væk fra affyringsstedet — NU!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Fordømt! Fordømt!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Alle tilbageværende enheder, kom ud af sprængningsområdet! Dæk affyringen! Hold linjen!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Alle tilbageværende enheder — saml jer ved kommandocentralen. Indled kampen. Hold dem optaget."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Indtag defensive positioner indtil videre ordrer. Ved kommando, fald tilbage til evakueringszonen."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Jeg ved, du kan høre mig. Jeg forventede ikke at møde sådanne modstandere."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Men vid, at jeg har studeret din taktik, dine evner. Vores næste møde vil være ganske anderledes."

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter slut."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "For fem dage siden mistede vi kontakten til et militært rumfartskompleks i Norskehavet."

msgid "vo_sm_norway_intro_02"
msgstr "Rekognosceringsflyets pilot meldte om spor efter kamp"

msgid "vo_sm_norway_intro_03"
msgstr "og delvise ødelæggelser af industribygningerne på stedet."

msgid "vo_sm_norway_intro_04"
msgstr "Men vigtigst af alt, han beskrev en raket, der stod klar til affyring på rampen,"

msgid "vo_sm_norway_intro_05"
msgstr "lige før vi mistede kontakten til ham."

msgid "vo_sm_norway_intro_06"
msgstr "Et indsatshold blev sendt til stedet for at undersøge sagen."

msgid "vo_sm_norway_outro_01"
msgstr "Det vi troede, var et våben, er i virkeligheden noget langt mere farligt."

msgid "vo_sm_norway_outro_02"
msgstr "Raketten sendte en satellit i omløb,"

msgid "vo_sm_norway_outro_03"
msgstr "der begyndte at udsende hemmelig Reich-kommunikation:"

msgid "vo_sm_norway_outro_04"
msgstr "plantegninger over avancerede teknologier"

msgid "vo_sm_norway_outro_05"
msgstr "og koordinater på hemmelige militærbaser med allerede byggede våbenprototyper."

msgid "vo_sm_norway_outro_06"
msgstr "Manden bag alt dette kalder sig selv for Arkitekten."

msgid "vo_sm_norway_outro_07"
msgstr "Hans motiver er uklare, men hans handlinger er allerede begyndt at ændre verdensordenen."

msgid "vo_sm_norway_outro_08"
msgstr "For at imødegå denne trussel, har vi brug for en styrke, der kan forsvare verden fra det kommende kaos."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Giv agt! Giv agt!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Vi kalder alle soldater og officerer i Wehrmacht, Luftwaffe og Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Den tyske overkommando har underskrevet en betingelsesløs overgivelse.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Krigen er forbi...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Vi kalder alle dem, der stadig yder nyttesløs modstand;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Til at nedlægge jeres våben og overgive jer til de Allierede styrker.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Jeres liv er nødvendige til genopbygningen af et nyt og sundt Tyskland...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(Dette er bare endnu et trick.)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Indtil vi får en befaling fra vores kommando, kæmper vi videre.)"
