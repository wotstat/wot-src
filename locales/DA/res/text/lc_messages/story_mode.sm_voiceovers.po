msgid "vo_sm_char10_m05_stg04_02"
msgstr "HQ-officer: Kampvogne sidder fast på stranden. Flåde, giv ildstøtte."

msgid "vo_sm_char10_m05_stg13_06"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg13_07"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg14_01"
msgstr "?empty?"

