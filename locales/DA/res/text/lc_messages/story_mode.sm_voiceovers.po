msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire-pilot: Ringe sigtbarhed, kan ikke assistere!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire-pilot: For meget antiluftskyts, kan ikke assistere!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire-pilot: Svær AA, kan ikke justere beskydningen."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire-pilot: Føles som en snestorm af flak heroppe."

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire-pilot: Vi kan ikke justere skibets sigte under denne beskydning."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire-pilot: Vi skal have antiluftskytset nær bunkerne nedkæmpet."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire-pilot: Jeg er dykket lavere ned."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire-pilot: Nu kan jeg tilkalde de store kanoner ved at bruge røgsignalerne på jorden."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire-pilot: Kampvogne, så er det jeres tur!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire-pilot: Jeg ser røgen."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire-pilot: Videregiver koordinaterne til krigsskibet, så de kan afgive ild."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire-pilot: Pokkers, en af vores gik ned! Kan stadig ikke komme lavere."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire-pilot: Vi skal nedkæmpe mere antiluftskyts nu!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire-pilot: Antiluftskyts nede, jeg dykker. Klar til at dirigere mere ild fra vores krigsskib."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire-pilot: Pas på! Stor fjendtlig gruppe observeret på vej mod jer."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire-pilot: De giver den alt hvad de har."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire-pilot: Hold jer vågne, der er en ny fjendtlig gruppe på vej. Nu skal I være på mærkerne."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire-pilot: Advarsel, den sidste, og største, gruppe fjender er på vej."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire-pilot: De nærmer sig fra alle sider. Hold stand."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire-pilot: Har klart udsyn til røgsignalet. Koordinater sendt videre til krigsskibet."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire-pilot: Okay, der er vores røgmarkering. Jeg videregiver positionen til krigsskibet."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire-pilot: Røgen er på målet. Sender det præcise punkt til krigsskibet."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire-pilot: Jeg ser røgen, det ser ud til vores venner kunne bruge en hånd."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "USS Frankford-kaptajn: Afventer koordinater til ildstøtte."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "USS Frankford-kaptajn: Det er for risikabelt at skyde i blinde, vi kunne ramme vores egne."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "USS Frankford-kaptajn: Skal bruge præcis position, afventer ildstøtte."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "USS Frankford-kaptajn: Dette er kaptajnen på USS Frankford. Negativ."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "USS Frankford-kaptajn: Kan ikke støtte angrebet. Udsigtsforholdene er for dårlige."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "USS Frankford-kaptajn: Klipper og bunkere er ikke i syne, vi kan kun se vores kampvogne på stranden."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "USS Frankford-kaptajn: Ser kampvogne rykke frem mod klipperne."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "USS Frankford-kaptajn: Vi giver ildstøtte i den retning."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "USS Frankford-kaptajn: Håber den Sherman ved, hvad han skyder på."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "USS Frankford-kaptajn: Sherman har skiftet mål. Vi retter ildstøtten ind."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "USS Frankford-kaptajn: Sherman har stoppet beskydningen. Arbejdet er færdiggjort."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "USS Frankford-kaptajn: Vi kan ikke nå bunkerne længere inde i landet."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "USS Frankford-kaptajn: Trækker os tilbage til en sikker afstand nu. Held og lykke på stranden."

msgid "vo_sm_char10_m05_stg01_19"
