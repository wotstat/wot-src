msgstr "?empty?"

msgid "vo_sm_char10_m05_stg21_02"
msgstr "HQ-officer: Echo 5 landgangsområde sikret. Kampvogne rykker frem. Giver fuld ildstøtte."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "HQ-officer: Diriger luftstøtte til at hjælpe kampvognene med fremrykningen."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "HQ-officer: Ingeniørtropper, ryd forhindringerne, så der kan rykkes frem."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "HQ-officer: Stranden er ryddet. Sender hovedstyrken. Fremragende klaret."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "HQ-officer: Hold stand. Forstærkninger er på vej."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "HQ-officer: Beskyt landgangsområdet for enhver pris."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "HQ-officer: Endnu en kampvogn, endnu en chance. Vær forsigtig denne gang."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "HQ-officer: Vi er ved at løbe tør for reserver. Gør arbejdet færdigt denne gang, kommandør."

