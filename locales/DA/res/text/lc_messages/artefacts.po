msgid "br_respawn/name"
msgstr "Respawn"

msgid "br_respawn/platoon/descr"
msgstr "Gør det muligt at vende tilbage til kampen, når dit køretøj bliver ødelagt. Denne mekanisme virker i de første %(duration)s min af en kamp.\n\nFor at respawne en allieret, hold dig ude af kamp i %(timeToResurrect)s s. Respawn-ladninger er delt mellem delingsmedlemmer."

msgid "br_respawn/solo/descr"
msgstr "Gør det muligt at vende tilbage til kampen, når dit køretøj bliver ødelagt. Denne mekanisme virker i de første %(duration)s min af en kamp.\n\nNår dit køretøj er blevet ødelagt, vil det automatisk respawne."

msgid "br_smoke/battleDescr"
msgstr "Tilføjer en sløringsbonus i %(duration)s sekunder til alle køretøjer indenfor rækkevidde af forbrugsvaren."

msgid "br_smoke/descr"
