msgid "comp7/deserter/cancel"
msgstr "Afbryd"

msgid "comp7/deserter/message"
msgstr "Kampen er ikke slut endnu. Hvis du forlader kampen, før den er slut, vil du skuffe dit hold.\n{brown_open}Din rangering vil blive reduceret og du vil blive blokeret fra kampe i denne kamptype.{brown_close}\nEr du sikker på du vil forlade kampen?"

msgid "comp7/deserter/msgTitle"
msgstr "Du vil miste dine rangeringspoint!"

msgid "comp7/deserter/submit"
msgstr "Deserter"

msgid "comp7/deserter/title"
msgstr "Desertering fra slagmarken"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Du overtrådte spillereglerne på {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}-kortet kl. {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} rangeringspoint er blevet fratrukket, og du er midlertidigt blevet blokeret fra kampe i {whiteSpanish_Open}Onslaught{whiteSpanish_Close}-kamptypen."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Du overtrådte spillereglerne på {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}-kortet kl. {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nDu er midlertidigt blevet blokeret fra kampe i {whiteSpanish_Open}Onslaught{whiteSpanish_Close}-kamptypen og din rangering er blevet reduceret."
