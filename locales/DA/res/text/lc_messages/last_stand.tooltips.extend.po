msgid "Contact/status/inBattle/last_stand"
msgstr "i en Sidste slag-kamp"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Affyr et skud, der skader målet og alle fjendtlige køretøjer i en radius på 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Affyrer et skud, der gendanner hp ved at stjæle dem fra målet og fjendtlige køretøjer i nærheden i en radius af 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Affyr et skud, der gør målet, og alle fjendtlige køretøjer i en radius på 35 m, fortumlede."

msgid "advanced/ls_damageShield"
msgstr "Beskytter mod enhver skade (undtagen ved påkørsel, drukning og faldskade) i 10 sekunder."

msgid "advanced/ls_doubleDamage"
msgstr "Dit næste succesfulde skud uddeler dobbelt så meget skade."

msgid "advanced/ls_equipment"
msgstr "Taktisk grej hjælper dig til at kæmpe mere effektivt i Sidste slag-kampe, fuldføre stadier og optjene værdifulde belønninger. For at udstyre dem skal du klikke på en af taktisk grej-pladserne."

msgid "advanced/ls_extraDamageSituational"
msgstr "Giver en chance for at uddele forøget skade til et fjendtligt køretøj."

msgid "advanced/ls_fastReload"
msgstr "Forøger skudkadence / lader magasin."

msgid "advanced/ls_healSituational"
msgstr "Gendanner nogle hp efter at have ødelagt et fjendtligt køretøj."

msgid "advanced/ls_invisibility"
msgstr "Forhindrer midlertidigt fjender i at få dit køretøj på sigtekornet, gendanner hp, reparerer moduler, slukker brand, fjerner fortumlet effekt og behandler alle sårede mandskabsmedlemmer."

msgid "advanced/ls_nitro"
msgstr "Forbedrer midlertidigt dit køretøjs mobilitet."

msgid "advanced/ls_nitroSituational"
msgstr "Forbedrer midlertidigt dit køretøjs mobilitet efter du har modtaget skade fra et fjendtligt køretøj."

msgid "advanced/ls_selfRepairKit"
msgstr "Gendanner hp, slukker brande, fjerner fortumlet effekt og reparerer skadede moduler."

msgid "advanced/ls_teamRepairKit"
msgstr "Reparerer skadede moduler, slukker brande, fjerner fortumlet effekt og gendanner nogle hp til allierede køretøjer i dens radius."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktisk grej kan udstyres i særlige pladser, der vil hjælpe dig med at kæmpe effektivt i Sidste slag-kampe, fuldføre stadier og optjene værdifulde belønninger."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktisk grej-pladser"
