msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s niveau&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Tag kontrol over antennerne. Hold netværket. Gør transmissionen sikker."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Din computers ydeevne er ikke tilstrækkelig til denne kamptype. Du vil måske opleve problemer med grafikken og køretøjets bevægelser. Det er også sandsynligt at klienten vil crashe."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Lav ydeevne"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Lav ydeevne"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Denne kamptype kræver høj ydelse af computeren. Du vil opleve problemer med kortindlæsning, grafik og køretøjsbevægelser. I tilfælde af utilstrækkelig ydeevne, prøv en lavere grafikindstilling i dine indstillinger."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Reduceret ydeevne"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Reduceret ydeevne"
