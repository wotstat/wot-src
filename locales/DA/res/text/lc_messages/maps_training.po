msgid "03_campania_big/team1/heavyTank/descr"
msgstr "Det kritiske punkt ved denne taktik er den <a_ht_unfinishedBridge>ufærdige bro</a_ht_unfinishedBridge>.%(p)På vej mod den østlige flanke, bør du køre til højre for den <a_ht_unfinishedBridge>ufærdige bro</a_ht_unfinishedBridge>. Ved at køre op ad den <a_ht_lowerHairpinTurn>nedre hårnål</a_ht_lowerHairpinTurn>, kan du rydde fjendens placeringer under <a_ht_shelf>forhøjningen</a_ht_shelf>. Fra dette punkt kan du på effektiv vis kontrollere fjendens køretøjer på området ved den <a_ht_easternVillage>østlige by</a_ht_easternVillage>. Efter at have ryddet denne flanke, kan du indtage positionen nær <a_ht_monastery>klostret</a_ht_monastery> for at gøre det af med de sidste styrker i <a_ht_garden>haven</a_ht_garden> og på den modsatte side af <a_ht_valley>dalen</a_ht_valley>."

msgid "03_campania_big/team1/heavyTank/title"
msgstr "Angreb ved den ufærdige bro"

msgid "03_campania_big/team1/mediumTank/descr"
msgstr "Det kritiske punkt ved denne taktik er <a_mt_courtyardFountain>gårdspringvandet</a_mt_courtyardFountain>.%(p)På vej over den østlige flanke, finder du en af de første skudpositioner hvor den <a_mt_upperHairpinTurn>øvre hårnål</a_mt_upperHairpinTurn> møder <a_mt_courtyardFountain>gårdspringvandet</a_mt_courtyardFountain>. Denne position gør det muligt at beskyde fjendtlige køretøjer, på vej i denne retning, samt den <a_mt_lowerHairpinTurn>nedre hårnål</a_mt_lowerHairpinTurn>. Derefter kan du rydde området bag <a_mt_courtyardFountain>gårdspringvandet</a_mt_courtyardFountain>, hvilket åbner op for passagen gennem <a_mt_valley>dalen</a_mt_valley> i bagerste del mod øst. For at overraske fjenden, bør du ødelægge alle fjendtlige styrker nær <a_mt_monastery>klostret</a_mt_monastery>."

msgid "03_campania_big/team1/mediumTank/title"
msgstr "Angreb ved gårdspringvandet"

msgid "03_campania_big/team2/heavyTank/descr"
msgstr "Det kritiske punkt ved denne taktik er den <b_ht_easternVillage>østlige by</b_ht_easternVillage>.%(p)Når du bevæger dig langs den østlige flanke, kan du forvente at fjenden har indtaget positioner i udkanten af den <b_ht_easternVillage>østlige by</b_ht_easternVillage>. Før du bevæger dig frem, kan du bruge gadehjørner til i sikkerhed at beskyde fjenden i denne retning. Derefter, når du har ryddet positionerne i og under <b_ht_shelf>forhøjningen</b_ht_shelf>, kan du bevæge dig mod den fjendtlige base. Kør ned til dalen, indtag en position nær den <b_ht_unfinishedBridge>ufærdige bro</b_ht_unfinishedBridge>, og ødelæg alle fjendtlige køretøjer over den <b_ht_southernAscent>sydlige stigning</b_ht_southernAscent>."

msgid "03_campania_big/team2/heavyTank/title"
msgstr "Angreb ved den østlige by"

msgid "03_campania_big/team2/mediumTank/descr"
msgstr "Det kritiske punkt ved denne taktik er <b_mt_courtyardFountain>gårdspringvandet</b_mt_courtyardFountain>.%(p)Du bør bevæge dig ned i <b_mt_valley>dalen</b_mt_valley> og til højre under dække af buskene. På vej mod toppen af den vestlige flanke, kan du indtage en af de bedste positioner på denne side: <b_mt_lakeShelf>forhøjningen</b_mt_lakeShelf> over <b_mt_lake>søen</b_mt_lake>. Når du har gjort det af med alle fjendtlige køretøjer i din synsrækkevidde, kan du køre videre og rydde ved <b_mt_courtyardFountain>gårdspringvandet</b_mt_courtyardFountain>. Efter at have gennembrudt fjendens forsvar, kan du indtage en skudposition langs den <b_mt_lowerHairpinTurn>nedre hårnål</b_mt_lowerHairpinTurn>."

msgid "03_campania_big/team2/mediumTank/title"
msgstr "Angreb ved gårdspringvandet"

