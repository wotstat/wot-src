msgid "02_malinovka/team1/heavyTank/descr"
msgstr "Det kritiske punkt ved denne taktik er %(a_ht_millMountainPhrase1).%(p)Ved at bevæge dig under dække af den %(a_ht_southernForestPhrase), kan du sikkert bevæge dig opad ved at holde dig nær kortets grænse. Derefter skal du straks indtage %(a_ht_millMountainPhrase2), hvor du kan skjule køretøjets skrog bag terrænet. Kontrol med dette bjerg gør det også muligt at beskyde adgangsruterne til %(a_ht_villagePhrase) og flankere fjenden. Klipperne vil dække dig fra fjender, der skjuler sig i den %(a_ht_northernForestPhrase). Den sikrede skov åbner op for vejen til Base 2."

msgid "02_malinovka/team1/heavyTank/title"
msgstr "Angreb ved vindmøllen"

msgid "02_malinovka/team1/mediumTank/descr"
msgstr "Det kritiske punkt ved denne taktik er %(a_mt_ledgePhrase1).%(p)Ved bevægelse mod midten langs %(a_mt_swampPhrase), kan du indtage %(a_mt_elevationPhrase), hvorfra du kan ramme fjenden på %(a_mt_ledgePhrase2). Derefter, ved at køre gennem vandet, kan du klemme dig op mod afsatsen og beskyde mål, der er på vej op ad bjerget. Ved at holde dig bag bakkerne og buskene på %(a_mt_ledgePhrase3), kan du observere og beskyde fjendtlige køretøjer i den %(a_mt_northernForestPhrase) og nær basen. Efter at have ødelagt fjenden fra flanken på %(a_mt_fieldPhrase), får du adgang til den ubeskyttede Base 2."

msgid "02_malinovka/team1/mediumTank/title"
msgstr "Angreb ved afsatsen"

msgid "02_malinovka/team2/heavyTank/descr"
msgstr "Det kritiske punkt ved denne taktik er %(b_ht_millMountainPhrase1).%(p)Ved at bevæge dig under dække af den %(b_ht_northernForestPhrase), kan du sikkert bevæge dig opad ved at holde dig nær kortets grænse. Derefter skal du straks indtage %(b_ht_millMountainPhrase2), hvor du kan skjule køretøjets skrog bag terrænet. Kontrol med dette bjerg gør det også muligt at beskyde adgangsruterne til %(b_ht_villagePhrase) og flankere fjenden. Klipperne vil dække dig fra fjender, der skjuler sig i den %(b_ht_southernForestPhrase). Den sikrede skov åbner op for vejen til Base 1."

msgid "02_malinovka/team2/heavyTank/title"
msgstr "Angreb ved vindmøllen"

msgid "02_malinovka/team2/mediumTank/descr"
msgstr "Det kritiske punkt ved denne taktik er %(b_mt_cowshedsPhrase1).%(p)Ved at bevæge dig langs den højre flanke, kan du indtage en position på den %(b_mt_northLedgePhrase), hvorfra du kan nå fjenden i den modsatte position. Mens du forbliver uopdaget, kan du ramme fjendtlige køretøjer langs kanten af %(b_mt_fieldPhrase) og indtage %(b_mt_cowshedsPhrase2). Vær forsigtig ikke at falde i vandet. Under dække af bygningerne, kan du angribe fjendtlige positioner nær basen, og sikkert bevæge dig mod %(b_mt_swampPhrase), hvor du kan observere og ramme mål i den %(b_mt_southernForestPhrase)."

msgid "02_malinovka/team2/mediumTank/title"
msgstr "Angreb ved marken"

