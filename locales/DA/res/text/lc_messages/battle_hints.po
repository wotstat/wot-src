msgid "hint/LSH_FIRE"
msgstr "Røg vanskeliggør opdagelsen af fjendtlige køretøjer og videregivelse af deres positioner. Ild uddeler skade til køretøjer."

msgid "hint/LSH_FOG"
msgstr "Tåge vanskeliggør opdagelsen af fjendtlige køretøjer og videregivelse af deres positioner."

msgid "hint/LSH_RAIN"
msgstr "Kraftig regn vanskeliggør opdagelsen af fjendtlige køretøjer og videregivelse af deres positioner."

msgid "hint/LSH_SANDSTORM"
msgstr "Sandstorme vanskeliggør opdagelsen af fjendtlige køretøjer og videregivelse af deres positioner."

msgid "hint/LSH_SMOKE"
msgstr "Røg vanskeliggør opdagelsen af fjendtlige køretøjer og videregivelse af deres positioner."

msgid "hint/PPH_AIMING_01"
msgstr "Bevægelse af køretøj og tårn reducerer <font color='#EE7000'>kanonens præcision</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Cirklen omkring sigtekornet viser <font color='#EE7000'>kanonens præcision</font>. Vent lidt for et mere præcist skud."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Autosigte</font> aktiveret. Klik på højre museknap for at slå det fra."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Autosigte peger altid din kanon <font color='#EE7000'>mod midten</font> af køretøjet i dit sigte"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Din base er ved at blive <font color='#EE7000'>erobret!</font> Hvis det ikke bliver slået tilbage, vil det fjendtlige hold vinde kampen."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Hvert fjendtligt køretøj har <font color='#EE7000'>sit eget</font> erobringsfremskridt"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Erobring</font> af den fjendtlige base er én af måderne at vinde en kamp på"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Når du modtager skade, vil dit erobringsfremskridt blive <font color='#EE7000'>nulstillet</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Når du forlader basecirklen, vil dit erobringsfremskridt <font color='#EE7000'>gå tabt</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Flere køretøjer kan erobre en base <font color='#EE7000'>hurtigere</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Efter det <font color='#EE7000'>tredje</font> køretøj, bliver hastigheden på basens erobring ikke sat op"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Fjendens base er næsten erobret!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Dit hold vinder kapløbet om at erobre baser!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Køretøjsmodul kritisk skadet! Reparer det med <font color='#EE7000'>reparationssættet</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Køretøjsmodul kritisk skadet! Reparer det med <font color='#EE7000'>reparationssættet</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Mandskabsmedlem såret! Behandl dem med <font color='#EE7000'>førstehjælpssættet</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Mandskabsmedlem såret! Behandl dem med <font color='#EE7000'>førstehjælpssættet</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Mandskab fortumlet! Behandl dem med <font color='#EE7000'>førstehjælpssættet</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Køretøj i brand! Brug <font color='#EE7000'>brandslukkeren</font> i det nederste panel."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Køretøj i brand! Automatisk <font color='#EE7000'>brandslukker</font> aktiveret."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Køretøjsmodul kritisk skadet! At montere <font color='#EE7000'>et reparationssæt</font> før kamp kan hjælpe ved kritiske træffere."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Mandskabsmedlem såret! At montere <font color='#EE7000'>et førstehjælpssæt</font> før kamp kan hjælpe hvis mandskabet bliver såret."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Køretøj i brand! At montere <font color='#EE7000'>en brandslukker</font> før kamp kan hjælpe ved brand."

msgid "hint/PPH_OTHER_01"
msgstr "Du er blevet <font color='#EE7000'>opdaget</font> — skud kan afsløre din position!"

msgid "hint/PPH_OTHER_02"
msgstr "Dit køretøj blev ødelagt. Du kan trykke <font color='#EE7000'>Esc</font> for at forlade kampen uden straf."

msgid "hint/PPH_OTHER_03"
msgstr "Dit køretøj blev ødelagt. Du kan klikke på musen for at <font color='#EE7000'>se med</font> hos dine allierede."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Lyspære-ikonet</font> viser, at du er blevet opdaget af fjenden!"

msgid "hint/PPH_OTHER_05"
msgstr "Din kanon <font color='#EE7000'>lader</font> stadig"

msgid "hint/PPH_OTHER_06"
msgstr "Din kanon kan kun affyres, hvis cirklen omkring sigtekortet er <font color='#EE7000'>fuldstændig grøn</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Du kan rulle på musehjulet for at gå i <font color='#EE7000'>skarpskytte-tilstand</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Du kan rulle på musehjulet for at <font color='#EE7000'>forlade</font> skarpskytte-tilstand"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Et <font color='#EE7000'>indre grønt sigtekorn</font> viser en høj chance for at gennembryde fjendens panser"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Selv hvis det indre sigtekorn er grønt, er der <font color='#EE7000'>ingen garanti</font> for at gennembryde panseret"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Kanoner er ikke 100% præcise, så skud <font color='#EE7000'>lander ikke altid i midten</font> af sigtekornet"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Et indre sigtekorn viser chancen for at gennembryde fjendens panser. <font color='#EE7000'>Aktiver det i indstillingerne</font>."

msgid "penetration/chance/high"
msgstr "Høj chance"

msgid "penetration/chance/low"
msgstr "Lav chance"

msgid "penetration/chance/medium"
msgstr "Medium chance"
