msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Start en standard kamp i et køretøj på ethvert niveau."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Velkommen til spillet! Kæmp mod andre fans fra hele verden, og du kan fejre spektakulære sejre!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Første kamp"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Udforsk og køb et niveau IV køretøj."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Køb af et nyt køretøj er en stor begivenhed. Med hvert nyt niveau bliver køretøjerne mere interessante. Et veltrænet mandskab vil også forbedre oplevelsen."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Niveau IV køretøj"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Deltag i tre standard kampe i niveau IV-X køretøjer med et påført tilpasningselement af enhver art."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Du kan tilpasse køretøjer ved at ændre deres udseende med foruddefinerede stile, eller ved at skabe din egen stil med sløring, inskriptioner, emblemer og mærker."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Køretøjs ydre"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Start træningen af en evne for et mandskabsmedlem."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Mandskabsmedlemmer kan træne yderligere evner for at forbedre deres effektivitet eller få nye egenskaber."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Mandskabsevner"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Optjen 150.000 credits i standard kampe i niveau IV–X køretøjer."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Jo højere kampniveau, jo flere credits skal du bruge til at vedligeholde dit køretøj, genforsyne ammunition og købe moduler og udstyr."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Opsparing af credits"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Udforsk og køb et niveau V køretøj."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Niveau V er hvor de mere seriøse køretøjer begynder at træde frem, og hvor dine evner bliver prøvet af. Et fuldt trænet mandskab vil være en stor fordel."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Niveau V køretøj"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Deltag i 10 standard kampe i niveau V-X køretøjer med tre stykker udstyr monteret."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Belagt optik eller forbedret ventilation? Det rette udstyr kan booste dit køretøjs stærke sider og reducere dets svagheder."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montering af udstyr"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Fuldfør et basalt scenarie i Topografi-kamptypen."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "For at klare sig godt på slagmarken, skal du være fortrolig med angrebsveje, taktikker og kort, herunder nøglepositionerne og de vigtigste objekter på dem."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografi"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Fuldfør fire avancerede scenarier på et kort i Topografi."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Prøv Topografi-kamptypen for at studere kort i standard kampe. De fire scenarier gør det muligt for dig at udforske stedet fra forskellige vinkler."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Avanceret Topografi"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Deltag i 10 standard kampe i niveau V–X køretøjer med en aktiveret personlig reserve."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Ved aktivering kan du få yderligere bonusser til kamp xp, fri xp og mandskabs xp eller credits efter hver kamp."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Personlige reserver"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Vær i top 10 på dit hold efter optjent xp i alt seks gange i sejrrige standard kampe i niveau V–X køretøjer."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Disse missioner gør det muligt for dig at optjene fem gange mere xp per sejrrig kamp. Du skal vinde og være i top 10 på dit hold efter optjent xp."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 missioner for ×5 xp"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Udforsk et modul og monter det på et køretøj på ethvert niveau."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Kamp xp tildeles efter hver kamp. Optjen kamp xp for at udforske nye moduler, der forbedrer dit køretøjs effektivitet."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Kamp xp"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Udforsk og køb et niveau VI køretøj."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "På hvert efterfølgende niveau kræves mere tid og kræfter at udforske køretøjer. Fri xp hjælper dig til hurtigere fremskridt og et trænet mandskab er nyttigt."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Niveau VI køretøj"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Fuldfør en personlig mission i enhver kampagne."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampagner er kæder af missioner for forskellige typer af køretøjer. Når de fuldføres, kan du modtage nyttige belønninger og unikke køretøjer."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Personlige missioner"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Træn et mandskab med en universel manual."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Mandskabsbøger gør det markant hurtigere for dig at træne mandskabet ved at tilføje en bestemt mængde xp til et eller flere mandskabsmedlemmer."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Mandskabsbøger"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Spil 10 standard kampe i niveau VI–X køretøjer udstyret med et mandskabsdirektiv."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Direktiver kan forbedre mandskabets evner i en kamp. Direktiver kan, som forbrugsvarer, købes eller modtages som en belønning."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Direktiver for mandskab"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Køb en særlig Nybegynderpakke i in-game butikken."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Du kan købe alt du skal bruge i in-game butikken, herunder guld, premium køretøjer, og mere til. Du vil ofte kunne finde nogle rigtig gode tilbud."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Butik"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Deltag i 10 standard kampe i niveau VI–X premium køretøjer."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Disse køretøjer skal ikke udforskes. De optjener mere kamp xp, mandskabs xp og credits, og de gør det muligt for dig at overføre mandskab uden omskoling."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium køretøjer"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Deltag i 10 standard kampe i niveau VI–X køretøjer med et udstyrsdirektiv."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Direktiver gør det muligt for dig at øge effektiviteten af monteret udstyr. Direktiver kan, som forbrugsvarer, købes eller modtages som en belønning."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Direktiver for udstyr"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Vær i top 10 på dit hold efter optjent xp i alt 15 gange i standard kampe i niveau VI–X køretøjer."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Disse missioner gør det muligt for dig at optjene fem gange mere xp per sejrrig kamp. Du skal vinde og være i top 10 på dit hold efter optjent xp."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 missioner for ×5 xp"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Udforsk og køb et niveau VII køretøj."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "På dette køretøjsniveau øges kravene til dine evner endnu mere. Køretøjerne bliver bedre og mere effektive — og det gør dine modstandere også."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Niveau VII køretøj"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Spil 10 standard kampe i niveau VII-X køretøjer udstyret med et stort førstehjælpssæt, stort reparationssæt og automatiske brandslukkere."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Når de er blevet monteret, reparerer store forbrugsvarer skadede moduler hurtigere end små. De reducerer også varigheden på fortumling og risikoen for brand, og har en kortere cooldown."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Store forbrugsvarer"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Modtag dobbelt så meget xp for din første sejr på dagen i standard kampe i et køretøj på ethvert niveau."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Du kan modtage to gange så meget xp for din første sejr på dagen i ethvert køretøj. Brug denne egenskab til hurtigere at opgradere dine køretøjer."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Xp-multiplikator"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Opret et plantegningsfragment for ethvert uudforsket køretøj."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Plantegninger giver rabat til xp og gør udforskning af køretøjer hurtigere. Kan fås som belønning eller konverteres fra universelle og nationale fragmenter."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Plantegninger til køretøjer"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Vær i top 10 på dit hold efter optjent xp i alt 20 gange i standard kampe i niveau VII–X køretøjer."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Disse missioner gør det muligt for dig at optjene fem gange mere xp per sejrrig kamp. Du skal vinde og være i top 10 på dit hold efter optjent xp."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 missioner for ×5 xp"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Udforsk og køb et niveau VIII køretøj."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "I niveau VIII køretøjer skal du bruge al din viden og erfaring. Fjenderne lader dig ikke slappe af, men vil give dig intens og uvurderlig erfaring."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Niveau VIII køretøj"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Brug fri xp til at udforske ethvert modul."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Hvis du ikke har nok kamp xp til at udforske et modul eller køretøj, kan du bruge fri xp, som kan optjenes på ethvert køretøj."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Fri xp"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Medtag nogle alternative granater og start en standard kamp i et niveau III-X køretøj."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Panserbrydende, høj-eksplosive og panserbrydende komposit-rigide granater bruges i forskellige situationer i kamp. Vælg med omhu for at få en fordel!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Ammunition"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Sælg et ubrugt modul fra depotet."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Ubrugte moduler, granater, udstyr, forbrugsvarer og andre ting, gemmes i depotet. Du kan sælge overflødige ting for credits."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depot"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Optjen 25.000 credits i standard kampe i niveau III–X køretøjer."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Credits bruges til at købe granater og nye køretøjer, reparere køretøjer og mere. Det er vigtigt at vide, hvordan du sparer dem op og bruger dem på bedste vis."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Credits"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Deltag i tre standard kampe i niveau III–X køretøjer med forbrugsvarer monteret i alle tilgængelige pladser."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Forbrugsvarer kan reparere skade på køretøjer og helbrede såret mandskab i kamp. Brug af forbrugsvarer på rette tid er essentielt i at overleve på slagmarken."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Forbrugsvarer"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Deltag i tre standard kampe i et niveau III–X køretøj med monteret udstyr af enhver art."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Køretøjer kan få udstyr monteret, der forbedrer nogle af deres karakteristika. Udstyrets sammensætning vil afhænge af køretøjet og spillestilen."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Udstyr"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Fuldfør et scenarie på ethvert kort i Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Fuldfør fire grundlæggende scenarier på et kort i Topografi"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Rekognoscering"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Fuldfør fire avancerede scenarier på et kort i Topografi"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Et 12-tal i geografi"
