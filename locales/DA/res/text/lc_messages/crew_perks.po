msgstr "Når den er fuldt trænet, forøges {greenBright_Start}holdbarhed på ammunitionsstativet{greenBright_End} med %(vehicleAmmoBayStrength)s&zwnbsp;."

msgid "loader_pedant/name"
msgstr "Sikker opbevaring"

msgid "loader_pedant/shortDescription"
