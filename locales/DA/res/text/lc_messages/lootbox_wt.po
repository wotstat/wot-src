msgstr "Max antal moduler til en garanteret belønning: %(count)"

msgid "infoPage/footer/description/autoOpen/wt"
msgstr "Hvis du ikke åbner moduler, før eventet er slut, vil de blive åbnet automatisk."

msgid "infoPage/footer/description/compensation/wt"
msgstr "Hvis du allerede ejer alle køretøjerne fra listen over muligt indhold i moduler, vil alle følgende køretøjer du modtager fra moduler blive kompenseret med guld, der modsvarer deres fulde værdi."

msgid "infoPage/footer/description/guaranteed/wt"
msgstr "Hver %(guaranteed)s moduler vil med garanti indeholde et køretøj. Hvis du åbner dem uden at finde et sådant køretøj, så vil du finde et køretøj, som du ikke allerede ejer, i det %(guaranteed)s. modul. Når køretøjet findes, nulstilles tælleren."

msgid "infoPage/footer/description/reroll/wt"
msgstr "Hvis du ikke er tilfreds med belønningerne fra et modul, kan du genåbne det med mulighed for at modtage andre ting fra samme liste. Hvert modul kan kun genåbnes et begrænset antal gange:"

msgid "infoPage/footer/title/autoOpen"
msgstr "Auto-åbn"

msgid "infoPage/footer/title/compensation"
msgstr "Kompensation"

msgid "infoPage/header/description"
msgstr "Åbn modulet for muligheden for at modtage værdifulde in-game ting! Se flere detaljer nedenfor."

msgid "multipleRewardView/header/subTitle/"
msgstr "Fra %(name) (%(boxesCount) moduler åbnet)"

