msgid "T110E4_7x7"
msgstr "T110E4 7x7"

msgid "T110E4_7x7_descr"
msgstr "I 1954 blev der i Detroit afholdt en konference om tunge kampvognes fremtid. Blandt andre avancerede projekter, fremlagde Chrysler Corporation planerne til en ny kampvogn baseret på TS-31-projektet. Den vigtigste forudsætning var at sikre, at kampvognen kunne passe gennem Bern National-tunnelen. Der blev overvejet adskillige varianter, men i sidste ende blev projektet aflyst."

msgid "T110E4_7x7_short"
msgstr "T110E4 7x7"

msgid "T110_cl"
msgstr "T110E5 CL"

msgid "T119_M"
