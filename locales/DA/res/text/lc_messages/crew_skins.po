msgid "Space01/Descr"
msgstr "Denne astronaut bærer en af de første trykdragter, der gør det sikkert under acceleration, beskytter mod trykfald og giver tilstrækkelig ilt til vejrtrækning. Denne dragt blev udviklet i USA i midten af 1930'erne."

msgid "Space01/LastName"
msgstr "Harland"

msgid "Space01/Name"
msgstr "Malcolm"

msgid "Space02/Descr"
msgstr "Denne kosmonaut bærer SK&zwnbsp;-&zwnbsp;1-dragten, specifikt udviklet til mandskabet på Vostok rumskibet. Den blev brugt i den første bemandede rumflyvning den 12. april 1961."

msgid "Space02/LastName"
msgstr "Bykhovsky"

msgid "Space02/Name"
msgstr "Pavel"

msgid "Space03/Descr"
msgstr "Denne kosmonaut bærer Berkut dragten, der har et integreret livsopretholdelsessystem, brugt ved den første rumvandring nogensinde den 18. marts 1965."

msgid "Space03/LastName"
msgstr "Simonchuk"

msgid "Space03/Name"
msgstr "Fyodor"

msgid "Space04/Descr"
msgstr "Denne astronaut bærer A7L-dragten, som NASA benyttede til bemandede rummissioner og under Apollo 11's månelanding i juli 1969."

msgid "Space04/LastName"
