msgid "PzIV_Hydro_descr"
msgstr "Udviklingen af køretøjer med et agter-placeret hydrostatisk drev startede i Tyskland i juli 1944. Chassiset af en Pz. IV Ausf. G blev brugt til de relevante tests. Den første prototype blev bygget i oktober 1944. Kun et køretøj blev produceret."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

msgid "PzIV_Schmalturm_A"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_Standart"
