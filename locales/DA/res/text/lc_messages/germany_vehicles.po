msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Udviklet af ČKD fabrikken for den tjekkoslovakiske hær i 1938. Under den tyske besættelse kom køretøjet i tjeneste i Wehrmacht og blev brugt i aktion i den polske og franske kampagne, såvel som på Østfronten. Kampvognen var i kamp på frontlinjen indtil midten af 1942. Omkring 1.400 køretøjer i otte versioner (Ausf. A/B/C/D/E/F/S/G) blev bygget."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

