msgstr "Sidste slag: Terra Nord"

msgid "bannerTooltip/performanceRisk/text/highRisk"
msgstr "Din computers ydeevne er ikke tilstrækkelig til denne kamptype. Du vil måske opleve problemer med grafikken og køretøjets bevægelser. Det er også sandsynligt at klienten vil crashe."

msgid "bannerTooltip/performanceRisk/text/mediumRisk"
msgstr "Denne kamptype kræver høj ydelse af computeren. Du vil opleve problemer med kortindlæsning, grafik og køretøjsbevægelser. I tilfælde af utilstrækkelig ydeevne, prøv en lavere grafikindstilling i indstillingerne."

msgid "bannerTooltip/performanceRisk/title/highRisk"
msgstr "Lav ydeevne"

msgid "bannerTooltip/performanceRisk/title/mediumRisk"
msgstr "Mulig reduceret ydeevne"

