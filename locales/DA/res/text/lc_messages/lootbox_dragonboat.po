msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Dragebåds-kasser"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRAGEBÅDS-KASSER"

msgid "entryPoint/tooltip/description"
msgstr "Disse er særlige kasser, der indeholder unikke og værdifulde in-game ting.\nDu kan finde kasser i in-game butikken eller premium butikken."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Dragebåds-kasser midlertidigt utilgængelige"

msgid "eventName/lowerCase"
msgstr "Tæm dragen, rid på vinden"

msgid "eventName/upperCase"
msgstr "TÆM DRAGEN, RID PÅ VINDEN"

msgid "infoPage/footer/description/compensation"
msgstr "Hvis du allerede ejer alle køretøjer fra listen over muligt indhold i æskerne, vil alle følgende køretøjer du modtager fra dragebåds-kasser blive kompenseret med guld, der modsvarer deres fulde værdi."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s dragebåds-kasser vil med garanti indeholde et niveau VIII–IX køretøj. Hvis du åbner dem uden at finde et sådant køretøj, så vil du finde et niveau VIII–IX køretøj, som du ikke allerede ejer, i den %(guaranteed0)s&zwnbsp;. dragebåds-kasse. Når køretøjet findes, nulstilles tælleren."

msgid "noBoxesView/description/"
msgstr "Du har ingen kasser.\nDu kan finde dem i in-game butikken."
