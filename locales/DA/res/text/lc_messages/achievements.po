msgid "medalRadleyWalters_heroInfo"
msgstr "Sydney Valpy Radley-Walters var et canadisk tank es i det 27'ende Armerede Regiment. I 1944-1945 ødelagde han 18 tyske køretøjer med hans Sherman Firefly."

msgid "medalRadleyWalters_standard_descr"
