msgid "se12019Medal"
msgstr "Hold linjen"

msgid "se12019Medal_condition"
msgstr "• Tildelt alle spillere, som opfyldte den respektive betingelse under eventet."

msgid "se12019Medal_descr"
msgstr "Vind 10 kampe under Homefront eventet."

msgid "se2020Medal"
msgstr "Den store sejr"

msgid "se2020Medal_condition"
