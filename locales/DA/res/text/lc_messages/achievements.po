msgid "medalLafayettePool_heroInfo"
msgstr "Lafayette G. Pool er kendt som det mest exceptionelle amerikanske tank es som i alt ødelagde 258 armerede køretøjer og militærkøretøjer."

msgid "medalLafayettePool_standard_descr"
