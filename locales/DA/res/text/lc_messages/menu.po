msgid "extraParams/desc"
msgstr "En parameter, der ikke direkte påvirker effektiviteten i at ødelægge fjendtlige køretøjer."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Den samlede bonus udregnes ved at bruge både additive og multiplikative modifikationer, så den kan både være højere eller lavere end værdierne, der vises her."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Denne parameter viser tiden mellem SPG-skuddet og modtagelse af advarslen."

msgid "extraParams/name/commanderLampDelay"
msgstr "Denne parameter viser forsinkelsen hvormed en kommandør identificerer om dit køretøj er blevet opdaget af fjenden. Jo højere værdi, jo mindre forsinkelse."

msgid "extraParams/name/crewHitChance"
msgstr "Denne parameter viser chancen for at undgå skader til dit mandskab."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Denne parameter viser varigheden af yderligere fortumling på et allerede fortumlet køretøj."

msgid "extraParams/name/crewStunDuration"
msgstr "Denne parameter viser varigheden på den modtagne fortumling."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Denne parameter viser ændringen af den minimale potentielle skade og potentielle gennembrydning, sammenlignet med standardværdien (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Denne parameter viser ændringen af den maksimale potentielle skade og potentielle gennembrydning, sammenlignet med standardværdien (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Denne parameter viser mængden af skade uddelt ved påkørsler. Når køretøjer støder sammen, ser systemet på tykkelsen af panseret ved skadestedet, forskellen på køretøjernes vægt, samt deres respektive hastighed."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Denne parameter viser forsinkelsen til kommandøren opdager kritisk skade på det fjendtlige køretøj i dit sigtekorn."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Denne parameter viser hvor blotlagte fjender er, der er fuldt ud skjult bag bevoksning (både enkelt og grupperet bevoksning). Gælder stationære køretøjer og køretøjer i bevægelse."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Denne parameter viser hvor blotlagte fjendtlige køretøjer i bevægelse er. Jo højere værdi, jo højere chance for at opdage dem."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Denne parameter viser ændringerne til chancen for at uddele kritisk skade til fjendtligt mandskab og moduler. Effekten virker med alle typer granater, undtagen i køretøjer med maskinkanoner."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Denne parameter viser cooldown-tiden på forbrugsvarer."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Denne parameter afgør reduceringen af en brands varighed og mængden af skade den uddeler."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Denne parameter viser effekten af sløring bag buskads."

msgid "extraParams/name/hpRecover"
msgstr "Denne parameter viser forøgelsen i gendannede hp, når der bruges et reparationssæt. Jo højere værdi, jo flere hp vil blive gendannet."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Denne parameter viser krydsningsevne på moderat blødt terræn. Jo højere værdi, jo mindre tid kræver det at opnå lineær hastighed."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Denne parameter viser reduktionen i straffen til den maksimale synsrækkevidde, når observationsudstyr er ødelagt. Jo lavere værdi, jo bedre synsrækkevidde."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Denne parameter viser forøgelsen i maksimal gennembrydning for granater på en afstand af mindre end 50 m. Jo højere værdi, jo bedre gennembrydning."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Denne parameter viser den yderligere oplysningstid om fjendtlige positioner, efter dit køretøj er blevet ødelagt."

msgid "extraParams/name/radiomanHitChance"
msgstr "Denne parameter viser chancen for at undgå skader til din radiooperatør."

msgid "extraParams/name/shellVelocity"
msgstr "Denne parameter viser forøgelsen i skudhastighed for alle typer granater. Jo højere værdi, jo højere skudhastighed."

msgid "extraParams/name/softGroundFactor"
msgstr "Denne parameter viser krydsningsevne på blødt terræn. Jo højere værdi, jo mindre tid kræver det at opnå lineær hastighed."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Denne parameter viser graden af negative effekter fra fortumlet mandskab."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Denne parameter viser reduktionen i modtaget skade på affjedringen. Jo højere værdi, jo mindre skade vil blive modtaget."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Denne parameter viser reduktionen i straffen til kanonens ladetid, når ammunitionsstativet er skadet. Jo højere værdi, jo kortere ladetid."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Denne parameter viser reduktionen i motorkraft, når motoren er skadet. Jo højere værdi, jo mindre motorkraft vil gå tabt."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Denne parameter viser holdbarheden af ammunitionsstativet, brændstoftanke og motor. Jo højere værdi, jo mere holdbare er dine moduler."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Denne parameter viser holdbarheden af ammunitionsstativet. Jo højere værdi, jo mere holdbar er dit ammunitionsstativ."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Denne parameter viser skaden forårsaget af skade på affjedringen ved påkørsel. Den påvirker ikke skaden uddelt til siden eller toppen af tårnet ved påkørsel."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Denne parameter viser reparationshastigheden på affjedringen. Jo højere værdi, jo højere reparationshastighed."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Denne parameter viser affjedringens holdbarhed. Jo højere værdi, jo mere holdbar er din affjedring overfor både granater og påkørsel."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Denne parameter viser varigheden hvori fjendtlige køretøjer er synlige, efter de forlader din synsrækkevidde. Standardværdien er 10 sekunder."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Denne parameter viser reduktionen i skade modtaget af et køretøj efter fald. Jo højere værdi, jo mindre skade vil blive modtaget."

msgid "extraParams/name/vehicleFireChance"
msgstr "Denne parameter viser risikoen for motorbrand, når den bliver skadet."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Denne parameter viser holdbarheden på brændstoftanke mod kritisk skade. Når de bliver ødelagt, vil brændstoftanke altid bryde i brand."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Denne parameter viser reduktionen i kanonens præcision ved bevægelse, samt rotation af skrog eller tårn. Jo lavere værdi, jo mindre spredning er der indenfor sigtecirklen."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Denne parameter viser størrelsen på sigtecirklen efter skydning."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Denne parameter viser spredning i bevægelse. Jo lavere værdi, jo mere præcis er kanonen."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Denne parameter viser spredningen ved rotation af skroget. Jo lavere værdi, jo mere præcis er kanonen."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Denne parameter viser spredningen ved bevægelse af kanonen. Jo lavere værdi, jo mere præcis er kanonen."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Denne parameter viser spredningen med en beskadiget kanon. Jo højere værdi, jo lavere spredning."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Denne parameter viser skaden modtaget fra HE-granater. Jo mere panser i det ramte område, jo højere effekt."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Denne parameter viser sløringen efter skydning."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Denne parameter viser varigheden hvori dit køretøj forbliver synligt for fjender, efter du forlader deres synsrækkevidde. Standardværdien er 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Denne parameter viser mængden af skade til affjedringen ved påkørsler. Når køretøjer støder sammen, ser systemet på tykkelsen af panseret ved skadestedet, forskellen på køretøjernes vægt, samt deres respektive hastighed."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Denne parameter viser mængden af skade modtaget ved påkørsler. Når køretøjer støder sammen, ser systemet på tykkelsen af panseret ved skadestedet, forskellen på køretøjernes vægt, samt deres respektive hastighed."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Denne parameter viser hastighed på at skifte mellem granattyper i en ladet kanon."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Denne parameter viser reparationshastighed på interne og eksterne moduler fra \"rød\" tilstand til \"gul\" tilstand. Jo højere værdi, jo hurtigere reparation."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Denne parameter viser krydsningsevne på affjedringen. Jo højere værdi, jo mindre tid kræver det at opnå lineær hastighed."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Denne parameter viser hastigheden på at skifte retning i et hjulkøretøj."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Denne parameter viser reduktionen af straf til den primære kvalifikation for ethvert mandskabsmedlem, når de er såret (undtagen kommandøren)."

