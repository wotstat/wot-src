msgid "guaranteed/tooltip/description1/"
msgstr "Hvis du allerede ejer alle køretøjerne, vil du i stedet modtage en Udvalgt loot-æske."

msgid "infoPage/footer/description/compensation"
msgstr "Hvis du allerede ejer alle køretøjerne fra æskerne, vil du modtage en Udvalgt loot-æske som belønning i stedet for et køretøj."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s Himmelsk, %(guaranteed1)s Hjælp fra oven og %(guaranteed2)s Udvalgt loot-æsker vil med garanti indeholde et køretøj. Hvis du åbner dem uden at finde et sådant køretøj, så vil du finde et køretøj, som du ikke allerede ejer, i den %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. æske (afhængig af typen af æske). Når køretøjet findes, nulstilles tælleren."

msgid "infoPage/footer/title/compensation"
msgstr "Kompensation"

msgid "infoPage/footer/title/guaranteed"
msgstr "Garanteret belønning"

msgid "infoPage/header/rewards/description"
msgstr "Ikke mere end én belønning per gruppe kan findes"
