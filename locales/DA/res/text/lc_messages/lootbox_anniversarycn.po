msgid "boxTooltip/description/text/bronze"
msgstr "Ved åbning kan disse æsker give dig niveau VIII premium køretøjer, in-game valuta og andre værdifulde belønninger."

msgid "boxTooltip/description/text/gold"
msgstr "Ved åbning kan disse æsker give dig sjældne niveau X køretøjer, in-game valuta og andre værdifulde belønninger."

msgid "boxTooltip/description/text/silver"
msgstr "Ved åbning kan disse æsker give dig niveau IX premium køretøjer, in-game valuta og andre værdifulde belønninger."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Kan modtages som gave for køb af ting i premium butikken, samt ved åbning af enhver anden slags æske."

msgid "boxTooltip/howGet/text/gold"
msgstr "Kan modtages ved åbning af enhver anden slags æske."

msgid "boxTooltip/howGet/text/silver"
msgstr "Kan modtages ved åbning af enhver anden slags æske."

msgid "common/boxCategory/lowerCase/bronze"
msgstr "Himmelsk loot-æske"

msgid "common/boxCategory/lowerCase/gold"
msgstr "Udvalgt loot-æske"

msgid "common/boxCategory/lowerCase/silver"
msgstr "Hjælp fra oven loot-æske"

msgid "common/boxCategory/upperCase/bronze"
msgstr "HIMMELSK LOOT-ÆSKE"

msgid "common/boxCategory/upperCase/gold"
msgstr "UDVALGT LOOT-ÆSKE"

msgid "common/boxCategory/upperCase/silver"
msgstr "HJÆLP FRA OVEN LOOT-ÆSKE"

msgid "entryPoint/tooltip/description"
msgstr "Dette er særlige æsker, der indeholder nye og unikke niveau VIII-X køretøjer og flere belønninger.\nDu kan modtage æsker som en gave for køb af ting i premium butikken, samt ved åbning af enhver anden slags æske."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Æsker kan ikke åbnes eller købes i øjeblikket på grund af tekniske udfordringer. Vi beklager den midlertidige ulejlighed."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Guds velsignelse-æsker er midlertidigt utilgængelige"

msgid "eventName/lowerCase"
msgstr "Guds velsignelse"

msgid "eventName/upperCase"
msgstr "GUDS VELSIGNELSE"

msgid "infoPage/footer/description/autoOpen"
msgstr "Hvis du ikke åbner alle æsker, før eventet er slut, vil de senere blive åbnet automatisk."

msgid "infoPage/footer/description/compensation"
msgstr "Hvis du allerede ejer alle køretøjerne fra æsken, vil du modtage en Udvalgt loot-æske som en garanteret belønning, eller i stedet for et køretøj."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s Himmelsk, %(guaranteed1)s Hjælp fra oven og %(guaranteed2)s Udvalgt loot-æsker vil med garanti indeholde et niveau VIII–X køretøj. Hvis du åbner dem uden at finde et sådant køretøj, så vil du finde et niveau VIII–X køretøj, som du ikke allerede ejer, i den %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. æske (afhængig af typen af æske). Når køretøjet findes, nulstilles tælleren."

msgid "infoPage/footer/title/compensation"
msgstr "Hvis alle køretøjer er modtaget"

msgid "infoPage/header/description"
msgstr "Åbn æsker for muligheden for at modtage værdifulde in-game ting!\nSe listen nedenfor over mulige belønninger."

msgid "noBoxesView/description/"
msgstr "Du har ingen æsker.\nDu kan finde dem i premium butikken."

msgid "singleRewardView/tooltip/boxName/"
msgstr "Udvalgt loot-æske"

msgid "singleRewardView/tooltip/description/"
msgstr "Hvis du allerede ejer alle køretøjerne fra æsken, vil du modtage en Udvalgt loot-æske som en garanteret belønning, i stedet for et køretøj."

