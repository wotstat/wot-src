msgid "awardViews/footer/backButton/"
msgstr "Tilbage til skatte"

msgid "common/boxCategory/lowerCase/lunar"
msgstr "Ildrød skat"

msgid "common/boxCategory/upperCase/lunar"
msgstr "ILDRØD SKAT"

msgid "common/getButton/lowerCase"
msgstr "Få skatte"

msgid "common/getButton/upperCase"
msgstr "FÅ SKATTE"

msgid "common/loader"
msgstr "Åbner Ildrød skat..."

msgid "common/statistics/emptyHeader"
msgstr "Åbn skatte for at se statistik."

msgid "common/statistics/header"
msgstr "Ildrøde skatte åbnet: %(count)"

msgid "confirmResetLootBoxStatistics/description"
msgstr "Al information om åbnede Ildrøde skatte vil blive slettet."

msgid "entryPoint/boxes"
msgstr "TIL SKATTE"

msgid "entryPoint/tooltip/description"
msgstr "Dette er særlige kasser, som kan indeholde nye og unikke ting, herunder premium køretøjer, 2D-stile og mere til. Du kan finde dem i in-game butikken."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Ildrøde skatte kan ikke åbnes eller købes i øjeblikket på grund af tekniske udfordringer. Vi beklager den midlertidige ulejlighed."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Ildrøde skatte er midlertidigt utilgængelige"

msgid "eventName/lowerCase"
msgstr "Måneskat"

msgid "eventName/upperCase"
msgstr "MÅNESKAT"

msgid "guaranteedTitle/nextBox"
msgstr "Garanteret belønning i den næste skat!"

msgid "guaranteedTitle/text"
msgstr "Max antal Ildrøde skatte til en garanteret belønning: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Hvis du ikke åbner Ildrøde skatte, før eventet er slut, vil de blive åbnet automatisk."

msgid "infoPage/footer/description/compensation"
msgstr "Hvis du allerede ejer alle køretøjer fra listen over muligt indhold i Ildrøde skatte, vil alle følgende køretøjer du modtager fra Ildrøde skatte blive kompenseret med guld, der modsvarer deres fulde værdi."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s Ildrøde skatte vil med garanti indeholde et niveau VIII–IX køretøj. Hvis du åbner dem uden at finde et sådant køretøj, så vil du finde et niveau VIII–IX køretøj, som du ikke allerede ejer, i den %(guaranteed0)s&zwnbsp;. Ildrøde skat. Når køretøjet findes, nulstilles tælleren."

msgid "infoPage/header/description"
msgstr "Åbn Ildrøde skatte for muligheden for at modtage værdifulde in-game ting! Se flere detaljer nedenfor."

msgid "multipleRewardView/header/subTitle/"
msgstr "Fra %(name) (%(boxesCount) Ildrøde skatte åbnet)"

msgid "noBoxesView/description/"
msgstr "Du har ingen Ildrøde skatte.\nDu kan finde dem i in-game butikken."

msgid "preview/backLabel"
msgstr "TIL SKATTE"

msgid "quantityTitle/boxesAvailable"
msgstr "Skatte tilgængelige: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "Ingen tilgængelige skatte"

msgid "singleRewardView/tooltip/description/"
msgstr "Hvis du allerede ejer alle køretøjer fra listen over muligt indhold i Ildrøde skatte, vil alle følgende køretøjer du modtager fra Ildrøde skatte blive kompenseret med guld."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) Ildrød skat"
msgstr[1] "%(remainingCount) Ildrøde skatte"
msgstr[2] "%(remainingCount) Ildrøde skatte"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Den garanterede belønning er et køretøj fra listen over muligt indhold i Ildrøde skatte.\nHvis du åbner %(remainingCount), uden at de indeholder et sådant køretøj, vil det være at finde, når du åbner den %(count). Ildrøde skat. Når det sker, vil tælleren blive nulstillet."
