msgid "battleship/name"
msgstr "Røgsignal"

msgid "battleship/shortDescr"
msgstr "Et røgsignal, der markerer området for en skudsalve fra et slagskibs kanoner, som vil uddele skade til fjendtligt udstyr og objekter på stedet."

msgid "distraction_ability/name"
msgstr "Falsk ordre"

msgid "distraction_ability/shortDescr"
msgstr "Få Gefr. Keller til at bruge den erobrede tyske radio til at udsende en falsk ordre, der får fjenden til at undersøge en specifik lokation."

msgid "recon_ability/name"
msgstr "Observer område"

msgid "recon_ability/shortDescr"
msgstr "Send kaptajn Dubois på rekognoscering af en specifik lokation. I løbet af opgaven stopper kampvognen og forbliver stationær. Evnen fortsætter, indtil den annulleres."

msgid "scc_airstrike_ability/name"
msgstr "Luftstøtte"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Tilkald et luftangreb på en udvalgt position."
