msgstr "ER 29 bis"

msgid "ER_29_bis_A"
msgstr "ER 29 bis A"

msgid "ER_51"
msgstr "ER 51"

msgid "ER_52"
msgstr "ER 52"

msgid "ER_52_32"
msgstr "ER 52/32"

msgid "ER_53"
msgstr "ER 53"

