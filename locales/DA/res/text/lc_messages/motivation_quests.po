msgid "common/congratulation"
msgstr "Tillykke! Du fuldførte missionen og modtager følgende belønninger"

msgid "common/requirements"
msgstr "Tilgængelig for fuldførelse i niveau IV køretøjer eller højere."

msgid "g1/advice"
msgstr "Du kan vinde kampen ved at ødelægge alle fjendtlige køretøjer eller erobre fjendens base. Vær forsigtig og løb ikke i forvejen. Samarbejde med dine allierede er nøglen til at undgå at blive ødelagt."

msgid "g1/description"
msgstr "Opfyldelse af kravet i 3 kampe i træk er valgfrit."

msgid "g1/name"
msgstr "Dage med krig"

msgid "g10/advice"
msgstr "Du kan give massiv skade uanset din køretøjstype. Vælg mål som du kan ramme uden problemer, prøv at overlev så længe som muligt og du vil blive positivt overrasket over \"Skade uddelt\" linjen på skærmen med kampresultater."

msgid "g10/description"
msgstr "Opfyldelse af kravet i 2 kampe i træk er valgfrit."

msgid "g10/name"
msgstr "Rollemodel: Skade"

msgid "g2/advice"
msgstr "Tunge kampvogne har kraftige kanoner og solidt frontpanser som er vanskeligt at skyde igennem. Denne fordel opvejes dog af deres ringe manøvredygtighed, hvilket gør det nemt at flankere dem og ramme svage punkter fra siden og bagtil."

msgid "g2/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g2/name"
msgstr "Bullseye: Tunge kampvogne"

msgid "g3/advice"
msgstr "Medium kampvogne er alsidige enheder som forfølger en bred række objektiver på enhver slagmark, lige fra at dække den primære styrke til at udføre flankeringsmanøvrer. Lad dem ikke komme forbi dig på siderne, men ødelæg dem mens de nærmer sig."

msgid "g3/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g3/name"
msgstr "Bullseye: Medium kampvogne"

msgid "g4/advice"
msgstr "Lette kampvogne har svagt panser og kanoner, men de kompenserer for dette med god hastighed og sløring. Den primære opgave for lette kampvogne er at observere og distrahere fjendtlige køretøjer."

msgid "g4/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g4/name"
msgstr "Bullseye: Lette kampvogne"

msgid "g5/advice"
msgstr "Kampvognsjægere er formidable modstandere med tung bevæbning og særlig god sløring, men i de fleste tilfælde gennemsnitlig manøvredygtighed. Prøv at observere og ødelægge dem så hurtigt som muligt."

msgid "g5/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g5/name"
msgstr "Bullseye: Kampvognsjægere"

msgid "g6/advice"
msgstr "Jo færre fjendtlige køretøjer tilbage, jo tættere er sejren. Tænk klogt, prøv at overleve og uddele så meget skade som muligt. Brug terrænet til at afgive ild uden at blotte dig selv."

msgid "g6/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g6/name"
msgstr "Bygger en samling"

msgid "g7/advice"
msgstr "Hvert køretøj har interne og eksterne moduler og mandskab. Kritiske træffere på dem nedsætter markant fjendens evner i kampen. Studer køretøjers svage punkter for at være mere effektiv i at uddele kritiske træffere til fjendtlige køretøjer og til at skjule sårbare punkter på dit eget køretøj."

msgid "g7/description"
msgstr "Resultater opnået i alle kampe i ethvert køretøj lægges sammen."

msgid "g7/name"
msgstr "Gennembrydende skud"

msgid "g8/advice"
msgstr "En måde at vinde på er at erobre fjendens base. Når de fjendtlige kampvogne er fokuseret på intens kamp, kan du smutte ubemærket forbi dem og indtage basen. Husk at jo flere køretøjer der opholder sig i basens cirkel, jo hurtigere vil den blive erobret. Den maksimale erobringshastighed nås med 3 køretøjer i cirklen."

msgid "g8/name"
msgstr "Backup plan"

msgid "g9/advice"
msgstr "Du optjener xp for at observere, uddele skade og ødelægge fjendtlige køretøjer, erobre fjendens base, forsvare din egen base og vinde kampen."

msgid "g9/description"
msgstr "Opfyldelse af kravet i 2 kampe i træk er valgfrit."

msgid "g9/name"
msgstr "Rollemodel: Xp"

msgid "group"
msgstr "Rekruttræning"
