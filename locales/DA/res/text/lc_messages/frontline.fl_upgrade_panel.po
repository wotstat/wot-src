msgid "alert"
msgstr "Du kan ikke vælge en kampreserve under aktiv kamp."

msgid "description/one/reserve"
msgstr "Gentagne valg af %(reserve_name)s-reserven\nvil forbedre dens karakteristika."

msgid "description/second/reserve"
msgstr "Gentagne valg af %(first_reserve_name)s- eller %(second_reserve_name)s-reserven\nvil forbedre karakteristika på den valgte."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Udlægger et aktivt minefelt i det valgte område i en vis periode."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Uddeler stor skade til fjendtlige køretøjer i en lille radius."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Gør fjendtlige køretøjer fortumlede og uddeler mellemhøj skade i et område med en stor radius."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Tilføjer en bonus til den primære kvalifikation hos spillerens og allierede mandskaber."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Giver en bonus til erobringshastighed, erobringsblokering og genforsyning."

msgid "shortDescription/reserve/reconAbility"
msgstr "Observerer fjendtlige køretøjer og minefelter."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Gendanner en vis procentdel af dit køretøjs hp."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Skjuler alle køretøjer i og bag røgen."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Giver en bonus til sløring og synsrækkevidde. Reducerer sløringen på fjendtlige køretøjer."

msgid "title"
msgstr "Den %(number_name)s reserveplads tilgængelig"
