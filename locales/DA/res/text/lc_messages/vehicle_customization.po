msgid "special_style/white_tiger_2020_hounds_desc"
msgstr "En helårsstil, der kan modtages under Den sidste Waffenträger 2020."

msgid "special_style/white_tiger_2021"
msgstr "Transduktor (på)"

msgid "special_style/white_tiger_2021_desc"
msgstr "En helårsstil, der kan modtages under Waffenträger vender tilbage-eventet i 2021."

