msgid "M22_Locust"
msgstr "M22 Locust"

msgid "M22_Locust_descr"
msgstr "Reikalavimai lengvam aviadesantiniam tankui sukurti 1941 metų žiemą. Mašina kurta Marmon-Herrington kompanijoje. Viso, nuo 1943 balandžio iki 1944 vasario, pagaminta 830 vienetų. Iš jų 260 buvo perduoti Jungtinei Karalystei pagal Lend-Lizo programą."

msgid "M22_Locust_long_special"
msgstr "Ypatingai dinamiškas ir nepastebimas žvalgybinis tankas su geru pabūklu. Mašina praktiškai neturi trūkumų, išskyrus nedidelę amunicijos skyriaus talpą."

msgid "M22_Locust_short"
msgstr "Locust"

msgid "M22_Locust_short_special"
msgstr "Puikus maksimalus greitis ir dinamika, gera maskuotė"

