msgid "roleExp/roleDescr/role_ATSPG_assault"
msgstr "Prasto mobilumo mašinos, bet su patikimais priekiniais šarvais. Jos efektyviai pasirodo kovodamos pirmose linijose."

msgid "roleExp/roleDescr/role_ATSPG_sniper"
msgstr "Mašinos, kurių silpni šarvai, bet geri pabūklai, o tai skatina išnaudoti kovos iš pasalų taktiką."

msgid "roleExp/roleDescr/role_ATSPG_support"
msgstr "Mašinos su tobulais pabūklais, bet norint juos efektyviai išnaudoti reikia laikytis tam tikrų sąlygų. Šios mašinos gali per trumpą laiką padaryti labai daug žalos."

msgid "roleExp/roleDescr/role_ATSPG_universal"
msgstr "Prieštankiniai su vidutiniškomis charakteristikomis, kurie vienodai tinka iš bet kokio atstumo."

msgid "roleExp/roleDescr/role_HT_assault"
msgstr "Gerai šarvuotos mašinos, kurios gali efektyviai keistis su priešais savo patvarumo taškais, sustabdyti priešų atakas ir būti atakos smaigalyje."

msgid "roleExp/roleDescr/role_HT_break"
msgstr "Mobilios ir patikimus šarvus turinčio mašinos, kurios puikiai tinka tiek pirmose atakos linijose pozicinėse artimose kovose, tiek ir įvairiems apvažiavimo manevrams."

msgid "roleExp/roleDescr/role_HT_support"
msgstr "Mašinos su tobulais pabūklais, bet norint juos efektyviai išnaudoti reikia laikytis tam tikrų sąlygų. Šios mašinos gali per trumpą laiką padaryti labai daug žalos."

msgid "roleExp/roleDescr/role_HT_universal"
msgstr "Daugiatiksliai tankai, kurie lengvai prisitaiko prie bet kurios situacijos mūšyje."

msgid "roleExp/roleDescr/role_LT_universal"
msgstr "Greitos ir manevringos mašinos, kurios gali vykti į žvalgybą ir daryti žalą apvažiuodamos priešus iš šonų."

msgid "roleExp/roleDescr/role_LT_wheeled"
msgstr "Mašinos su išskirtinėmis dinamiškumo savybėmis, efektyvus panaudojimas labai priklauso nuo žemėlapio ir taktinės situacijos."

msgid "roleExp/roleDescr/role_MT_assault"
msgstr "Mašinos su neblogais šarvais, kurie leidžia gerai jaustis artimoje kovoje ir ginti savo pozicijas nuo priešo sunkiųjų tankų."

msgid "roleExp/roleDescr/role_MT_sniper"
msgstr "Mašinos su puikiais pabūklais ir silpnais šarvais, tad jos efektyviausiai jaučiasi kovodamos iš tolimo nuotolio."

msgid "roleExp/roleDescr/role_MT_support"
msgstr "Mašinos su tobulais pabūklais, bet norint juos efektyviai išnaudoti reikia laikytis tam tikrų sąlygų. Šios mašinos gali per trumpą laiką padaryti labai daug žalos."

msgid "roleExp/roleDescr/role_MT_universal"
msgstr "Gerai subalansuotos mašinos, kurios gali atlikti daug kovinių užduočių. Jos lengvai prisitaiko prie žemėlapio ypatumų ir taktinės situacijos."

msgid "roleExp/roleDescr/role_SPG"
msgstr "Sąjungininkų atakų palaikymas iš tolimojo nuotolio. Tai pagalbinės mašinos, kurių efektyvumas priklauso nuo situacijos mūšyje bei komandos draugų veiksmų."

