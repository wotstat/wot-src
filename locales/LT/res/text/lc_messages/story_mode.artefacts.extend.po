msgid "battleship/name"
msgstr "Signaliniai dūmai"

msgid "battleship/shortDescr"
msgstr "Signaliniai dūmai pažymi vietą laivo artilerijai apšaudyti, o ši daro žalą priešų technikai ir objektams nurodytoje zonoje."

msgid "distraction_ability/name"
msgstr "Netikras nurodymas"

msgid "distraction_ability/shortDescr"
msgstr "Nurodykite Gefr. Keller pasinaudoti užgrobta vokiečių radijo stotimi ir pateikti netikrą nurodymą važiuoti į pasirinktą poziciją."

msgid "recon_ability/name"
msgstr "Žvalgyba"

msgid "recon_ability/shortDescr"
msgstr "Nusiųskite Kpt. Dubois žvalgybai pasirinktoje vietoje. Besižvalgantis tankas sustoja ir nejuda. Gebėjimas veikia tol, kol jis yra nutraukiamas."

msgid "scc_airstrike_ability/name"
msgstr "Pagalba iš oro"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Iškvieskite smūgį iš oro pasirinktoje vietoje."
