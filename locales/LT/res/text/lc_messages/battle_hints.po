msgid "hint/LSH_FIRE"
msgstr "Dūmai apsunkina priešų aptikimą ir jų pozicijų perdavimą. Ugnis daro žalą mašinoms."

msgid "hint/LSH_FOG"
msgstr "Rūkas apsunkina mašinų aptikimą ir jų pozicijų perdavimą."

msgid "hint/LSH_RAIN"
msgstr "Smarki liūtis apsunkina mašinų aptikimą ir jų pozicijų perdavimą."

msgid "hint/LSH_SANDSTORM"
msgstr "Smėlio audros apsunkina mašinų aptikimą ir jų pozicijų perdavimą."

msgid "hint/LSH_SMOKE"
msgstr "Dūmai apsunkina mašinų aptikimą ir jų pozicijų perdavimą."

msgid "hint/PPH_AIMING_01"
msgstr "Judant mašinai ar jos bokšteliui <font color='#EE7000'>ginklo taiklumas</font> sumažėja"

msgid "hint/PPH_AIMING_02"
msgstr "Apskritimas apie taikiklį parodo <font color='#EE7000'>ginklo taiklumą</font>. Truputį palaukę šausite taikliau."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatinis taikymasis</font> aktyvuotas. Atšaukite paspausdami dešinį pelės klavišą."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatinis taikymasis visada taikosi į nustatytosios <font color='#EE7000'>mašinos centrą</font>"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Jūsų bazė <font color='#EE7000'>užimama!</font>. Jei to nesustabdysite, priešai laimės mūšį."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Kiekviena mašina turi <font color='#EE7000'>savo atskirą</font> užėmimo progresą"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Priešų bazės <font color='#EE7000'>užėmimas</font> yra vienas iš būdų laimėti mūšį"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Jei gaunate žalos, jūsų užėmimo progresas <font color='#EE7000'>pradingsta</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Jei paliekate užėmimo lauką, užėmimo progresas <font color='#EE7000'>pradingsta</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Kelios mašinos užgrobia bazę <font color='#EE7000'>greičiau</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Po <font color='#EE7000'>trečios</font> mašinos bazės užėmimo greitis nebedidėja"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Priešų bazė beveik užimta!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Jūsų komanda laimi bazės užgrobimo lenktynėse!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Mašinos modulis kritiškai pažeistas! Suremontuokite jį su <font color='#EE7000'>remonto komplektu</font>, esančiu ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Mašinos modulis kritiškai pažeistas! Suremontuokite jį su <font color='#EE7000'>remonto komplektu</font>, esančiu ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Įgulos narys kritiškai sužeistas! Pasirūpinkite įgula su <font color='#EE7000'>vaistinėle</font>, esančia ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Įgulos narys kritiškai sužeistas! Pasirūpinkite įgula su <font color='#EE7000'>vaistinėle</font>, esančia ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Mašinos įgula apkurtinta! Pasirūpinkite ja su <font color='#EE7000'>vaistinėle</font>, esančia ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Mašinoje kilo gaisras! Panaudokite <font color='#EE7000'>gesintuvą</font>, esantį ekrano apačioje."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Mašinoje kilo gaisras! Automatinis <font color='#EE7000'>gesintuvas</font> aktyvuotas."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Mašinos modulis kritiškai pažeistas! Pasiėmę į mūšį <font color='#EE7000'>remonto komplektą</font> galite lengviau susitvarkyti su kritiniais smūgiais."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Įgulos narys kritiškai sužeistas! Pasiėmę į mūšį <font color='#EE7000'>vaistinėlę</font> galite geriau susitvarkyti su įgulos sužeidimais."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Mašinoje kilo gaisras! Pasiėmę į mūšį <font color='#EE7000'>gesintuvą</font> galite jį užgesinti."

msgid "hint/PPH_OTHER_01"
msgstr "Jūs buvote <font color='#EE7000'>pastebėti</font> – šaudami galite atskleisti savo poziciją!"

msgid "hint/PPH_OTHER_02"
msgstr "Jūsų mašina sunaikinta. Galite paspausti <font color='#EE7000'>Esc</font> ir išeiti iš mūšio be nuobaudos."

msgid "hint/PPH_OTHER_03"
msgstr "Jūsų mašina sunaikinta. Paspaudę pelės klavišą galite <font color='#EE7000'>stebėti</font> savo komandos narius."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Lemputė</font> praneša, jog jus pastebėjo priešai!"

msgid "hint/PPH_OTHER_05"
msgstr "Jūsų ginklas dar <font color='#EE7000'>neužsitaisė</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Galite šauti tik tada, jei apskritimas aplink taikiklį yra <font color='#EE7000'>visiškai žalias</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Į <font color='#EE7000'>snaiperio režimą</font> galite pereiti pasukę pelės ratuką"

msgid "hint/PPH_SNIPER_02"
msgstr "Iš snaiperio režimo galite <font color='#EE7000'>išeiti</font> pasukę pelės ratuką"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Žalias vidinis taikiklis</font> parodo didelį šansą pramušti priešo šarvus"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Net jei vidinis taikiklis žalias, šarvų pramušimas <font color='#EE7000'>negarantuojamas</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Ginklai nėra 100% taiklūs, tad šūviai gali <font color='#EE7000'>nepataikyti į taikiklio</font> centrą"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Vidinis taikiklis parodo šarvų pramušimo tikimybę. <font color='#EE7000'>Įjunkite tai nustatymuose</font>."

msgid "penetration/chance/high"
msgstr "Didelė tikimybė"

msgid "penetration/chance/low"
msgstr "Maža tikimybė"

msgid "penetration/chance/medium"
msgstr "Vidutinė tikimybė"
