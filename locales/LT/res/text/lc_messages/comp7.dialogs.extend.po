msgid "comp7/deserter/cancel"
msgstr "Atšaukti"

msgid "comp7/deserter/message"
msgstr "Kova dar nesibaigė. Jei paliksite mūšį jam nesibaigus, nuvilsite savo komandą.\n{brown_open}Jūsų rangas bus sumažintas ir nebegalėsite dalyvauti šio režimo mūšiuose.{brown_close}\nAr tikrai norite palikti mūšį?"

msgid "comp7/deserter/msgTitle"
msgstr "Jūs prarasite reitingo taškų!"

msgid "comp7/deserter/submit"
msgstr "Dezertyruoti"

msgid "comp7/deserter/title"
msgstr "Dezertyravimas iš mūšio"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Jūs pažeidėte žaidimo taisykles žemėlapyje {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nIš jūsų atimta {whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} reitingo taškų ir jūs laikinai negalite dalyvauti {whiteSpanish_Open}Prasiveržimo{whiteSpanish_Close} mūšiuose."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Jūs pažeidėte žaidimo taisykles žemėlapyje {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nJūs laikinai negalite žaisti režime {whiteSpanish_Open}Prasiveržimas{whiteSpanish_Close} ir jūsų reitingas sumažintas."
