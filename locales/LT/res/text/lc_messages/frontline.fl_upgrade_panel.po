msgid "alert"
msgstr "Negalite pasirinkti kovinio rezervo kovodami."

msgid "description/one/reserve"
msgstr "Pakartotinai pasirinkdami rezervą %(reserve_name)s\npagerinsite jo veikimo efektą."

msgid "description/second/reserve"
msgstr "Pakartotinai pasirinkdami rezervą %(first_reserve_name)s ar %(second_reserve_name)s\n pagerinsite jo veikimo efektyvumą."

msgid "number_1"
msgstr "Pirma"

msgid "number_2"
msgstr "Antra"

msgid "number_3"
msgstr "Trečia"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Tam tikram laikui pasirinktoje teritorijoje pakloja aktyvų minų lauką."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Daro ženklią žalą priešų mašinoms nedidelio spindulio zonoje."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Didelėje zonoje apkurtina priešų mašinas ir daro vidutinišką žalą."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Prideda bonusą pagrindinei žaidėjo ir sąjungininkų įgulų specializacijai."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Suteikia bonusą užėmimo greičiui, užėmimo blokavimui ir papildymui."

msgid "shortDescription/reserve/reconAbility"
msgstr "Aptinka priešų mašinas ir minų laukus."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Atstato tam tikrą jūsų mašinos patvarumo taškų procentą."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Paslepia visas mašinas esančias dūmuose ar besislepiančias už jų."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Suteikia bonusą maskuotei ir apžvalgos atstumui. Sumažina priešų mašinų maskuotę."

msgid "title"
msgstr "%(number_name)s rezervo vieta pasiekiama"
