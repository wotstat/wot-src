msgid "beCareful"
msgstr "Būkite dėmesingi"

msgid "comp7Core10"
msgstr "Galite pasirinkti labiau tinkančią mašiną vykstant pasiruošimui prieš kovą."

msgid "comp7Core10Status"
msgstr "Pasiruošimas prieš kovą"

msgid "comp7Core11"
msgstr "Pasiruošimo prieš kovą langas parodo jūsų mašinas su įgulomis ir amunicija. Nepamirškite jų paruošti prieš įeinant į kovą."

msgid "comp7Core11Status"
msgstr "Pasiruošimas prieš kovą"

msgid "comp7Core12"
msgstr "Pasirinkę mašiną praneškite apie tai komandai, paspausdami Patvirtinti pasirinkimą mygtuką."

msgid "comp7Core12Status"
msgstr "Pasiruošimas prieš kovą"

msgid "comp7Core13"
msgstr "Paspaudę Patvirtinti pasirinkimą mygtuką nebegalėsite pasikeisti mašinos."

msgid "comp7Core13Status"
msgstr "Patvirtinti pasirinkimą"

msgid "comp7Core14"
msgstr "Užimkite specialius taškus žemėlapyje ir naudodamiesi taktiniais įgūdžiais pelnykite pranašumą!"

msgid "comp7Core14Status"
msgstr "Svarbūs taškai"

msgid "comp7Core15"
msgstr "Svarbus taškas žemėlapyje. Šios vietos užėmimas leis jums pasinaudoti taktiniu įgūdžiu Diviziono radaras. Jį aktyvavus, visos priešų mašinos liks matomos keletą sekundžių."

msgid "comp7Core15Status"
msgstr "Komunikacijų centras"

msgid "comp7Core16"
msgstr "Svarbus taškas žemėlapyje. Šios vietos užėmimas leis jums pasinaudoti taktiniu įgūdžiu Artilerijos smūgis. Jį aktyvavus, žaidėjas gali pasirinkti, kurią vietą žemėlapyje apšaudyti sviedinių lietumi."

msgid "comp7Core16Status"
msgstr "Artilerijų štabas"

msgid "comp7Core17"
msgstr "Jei taktinis įgūdis Artilerijos smūgis pataiko jūsų komandos narį, jis nebus sužalotas, bet bus apkurtintas."

msgid "comp7Core17Status"
msgstr "Artilerijos smūgis"

msgid "comp7Core18"
msgstr "Dėmesio: Šio režimo žemėlapiai gali skirtis nuo jų atitikimų Atsitiktiniuose mūšiuose."

msgid "comp7Core18Status"
msgstr "Renginio žemėlapiai"

msgid "comp7Core19"
msgstr "7 žaidėjų būrio sudarymas gali padidinti jūsų galimybes laimėti."

msgid "comp7Core19Status"
msgstr "Komandinis žaidimas svarbiausia"

msgid "comp7Core21"
msgstr "Galite pamatyti savo komandos narių rolės įgūdžių užkrovą mūšyje, paspaudę Tab arba Alt klavišus."

msgid "comp7Core21Status"
msgstr "Komandos rolės įgūdžiai"

msgid "comp7Core22"
msgstr "Galite peržiūrėti komandos sąrašą ir pamatyti, ar jūsų draugai jau turi taktinį įgūdį. Priešų taktiniai įgūdžiai nerodomi."

msgid "comp7Core22Status"
msgstr "Taktiniai įgūdžiai"

msgid "comp7Core23"
msgstr "Jei rolės įgūdis paveikia mašiną, atitinkantis ženklelis bus parodomas virš žaidėjo žymeklio."

msgid "comp7Core23Status"
msgstr "Rolės įgūdžių efektai"

msgid "comp7Core24"
msgstr "H klavišas (pagal nutylėjimą) įjungia balso pokalbį. Pasinaudokite šia funkcija ir bendraukite su savo komanda efektyviau."

msgid "comp7Core24Status"
msgstr "Balso pokalbiai"

msgid "comp7Core25"
msgstr "Jei susiduriate su balso kanalo nesklandumais, peržiūrėkite nustatymus žaidime."

msgid "comp7Core25Status"
msgstr "Balso pokalbiai"

msgid "comp7Core29"
msgstr "Laikant Alt klavišą kiekvienos jūsų matymo lauke esančios mašinos rolė bus pavaizduota virš to žaidėjo žymeklio. Taip pat galėsite matyti komandos mašinų užkrovos lygį."

msgid "comp7Core29Status"
msgstr "Mašinų rolės"

msgid "comp7Core31"
msgstr "Galite pakeisti rolės ir taktinių įgūdžių klavišus žaidimo nustatymuose."

msgid "comp7Core31Status"
msgstr "Kontrolės nustatymai"

msgid "comp7Core32"
msgstr "Po tam tikro laiko galėsite vėl užimti svarbų tašką."

msgid "comp7Core32Status"
msgstr "Apie svarbius taškus"

msgid "comp7Core33"
msgstr "Jūs negalite užimti svarbaus taško, kol nepanaudojote atitinkamo taktinio įgūdžio."

msgid "comp7Core33Status"
msgstr "Apie svarbius taškus"

msgid "comp7Core34"
msgstr "Svarbaus taško užėmimas suteikia jums nemažai prestižo taškų."

msgid "comp7Core34Status"
msgstr "Apie svarbius taškus"

msgid "comp7Core35"
msgstr "Peržiūrėkite renginio taisykles ir sužinokite daugiau apie prestižo taškų rinkimą."

msgid "comp7Core35Status"
msgstr "Apie prestižo taškus"

msgid "comp7Core37"
msgstr "Režimas turi modifikatorius, kurie gali pakeisti tam tikrus mašinos parametrus, tokius kaip mašinos patvarumas, ekipuotės atstatymo laikas, laikas, per kurį išliekate matomu, ir daugiau."

msgid "comp7Core37Status"
msgstr "Prasiveržimo modifikatoriai"

msgid "comp7Core5"
msgstr "Priklausomai nuo rolės, kiekviena mašina turi specialų įgūdį su trimis užkrovos lygiais. Kuo didesnė užkrova, tuo stipresnis bus aktyvuoto įgūdžio efektas."

msgid "comp7Core5Status"
msgstr "Apie rolės įgūdžius"

msgid "comp7Core6"
msgstr "Prestižo taškus galima gauti efektyviai pasirodžius mūšyje, užimant svarbius taškus, naudojant įgūdžius ir ne tik."

msgid "comp7Core6Status"
msgstr "Apie prestižo taškus"

msgid "comp7Core8"
msgstr "Žaidėjai neturi jokios informacijos apie priešų mašinas, iki kol jos būna pastebėtos."

msgid "comp7Core8Status"
msgstr "Karo rūkas"

msgid "comp7Light7"
msgstr "Sužinokite daugiau apie Prasiveržimo šviesą paspaudę mygtuką APIE RENGINĮ renginio lange."

msgid "comp7Light7Status"
msgstr "Režimo informacija"

msgid "comp7Light9"
msgstr "Su skirtingų rolių VIII lygio mašinų kolekcija visada galite išsirinkti geriausią mašiną bet kuriam mūšiui, bei kartu prisitaikyti prie komandos."

msgid "comp7Light9Status"
msgstr "Garažo didinimas"

msgid "comp7Ranked0"
msgstr "Kovokite dėl reitingo taškų ir pasiekite aukščiausius rangus, parodant savo pranašumą."

msgid "comp7Ranked0Status"
msgstr "Rangų sistema"

msgid "comp7Ranked1"
msgstr "Kuo daugiau surenkate prestižo taškų, tuo daugiau reitingo taškų gausite laimėję ir mažiau prarasite pralaimėję."

msgid "comp7Ranked1Status"
msgstr "Prestižo taškai ir reitingo taškai"

msgid "comp7Ranked2"
msgstr "Prasiveržime, mūšiai sudaromi grupuojant panašaus rango žaidėjus."

msgid "comp7Ranked20"
msgstr "Mūšio palikimas prieš jam pasibaigiant suteikia priešų komandai pranašumą. Tai darydami būsite laikinai užblokuojami ir prarasite reitingo taškus."

msgid "comp7Ranked20Status"
msgstr "Dezertyravimas"

msgid "comp7Ranked26"
msgstr "Tik žaidėjai, turintys Čempiono arba Legendų rangus rodomi turnyrinėje lentelėje. Visi šią lentelę pasiekę žaidėjai gaus kasdienius prizus."

msgid "comp7Ranked26Status"
msgstr "Reitingas"

msgid "comp7Ranked27"
msgstr "Mūšį palikę žaidėjai bus laikinai užblokuoti ir negalės žaisti režime. Bloko trukmė ilgės su kiekvienu pakartotinu pažeidimu."

msgid "comp7Ranked27Status"
msgstr "Laikinas blokas"

msgid "comp7Ranked28"
msgstr "Žaiskite žaidimo režime ir atrakinkite naujus Prasiveržimo progresinio stiliaus elementus."

msgid "comp7Ranked28Status"
msgstr "Progresinis stilius"

msgid "comp7Ranked2Status"
msgstr "Vertingi žaidėjai"

msgid "comp7Ranked3"
msgstr "Legendos rangas suteikiamas tik geriausiems iš geriausių. Norėdami pasiekti šį rangą, turite patekti tarp 10% daugiausiai reitingo taškų surinkusių žaidėjų lentelėje."

msgid "comp7Ranked36"
msgstr "Dėmesio: jei paliekate mūšį prieš jam pasibaigus, prarandate daugiau reitingo taškų, nei visiškai pralaimėjus."

msgid "comp7Ranked36Status"
msgstr "Dezertyravimas"

msgid "comp7Ranked3Status"
msgstr "Legenda"

msgid "comp7Ranked4"
msgstr "Jei nustosite žaisti šitą režimą, prarasite reitingo taškų. Ši taisyklė galioja Sidabro, Aukso, Čempiono ir Legendos rangams."

msgid "comp7Ranked4Status"
msgstr "Rango neaktyvumas"

msgid "comp7Ranked7"
msgstr "Sužinokite daugiau apie Prasiveržimą paspaudę mygtuką APIE RENGINĮ renginio lange."

msgid "comp7Ranked7Status"
msgstr "Režimo informacija"

msgid "comp7Ranked9"
msgstr "Su skirtingų rolių X lygio mašinų kolekcija visada galite išsirinkti geriausią mašiną bet kuriam mūšiui, bei kartu prisitaikyti prie komandos."

msgid "comp7Ranked9Status"
msgstr "Garažo didinimas"

msgid "devMaps0"
msgstr "Atsitiktinių įvykių vieta bus pažymėta\ndūmais mūšio lauke ir ženkliuku žemėlapyje.\nŽemėlapius su atsitiktiniais įvykiais galima išmesti nustatymus skiltyje Žaidimas."

msgid "devMaps0Status"
msgstr "Žemėlapiai su atsitiktiniais įvykiais"

msgid "devMaps1"
msgstr "Atsitiktinio įvykio vietoje jūsų mašina gali būti sunaikinta (pavyzdžiui nukritus lėktuvui).\nŽemėlapius su atsitiktiniais įvykiais galima išmesti nustatymus skiltyje Žaidimas."

msgid "devMaps1Status"
msgstr "Žemėlapiai su atsitiktiniais įvykiais"

msgid "dualGunVehicles"
msgstr "Mašinos su dvivamzdžio pabūklo sistema"

msgid "epicModeHiddenFeatures"
msgstr "Fronto linijos meistras"

msgid "epicModeIntroduction"
msgstr "Režimo ypatybės"

msgid "epicModeUseful"
msgstr "Naudinga apie Fronto liniją"

msgid "epicRandom0"
msgstr "Šiame mūšių tipe galite patirti nedidelius greitaveikos sulėtėjimus."

msgid "epicTip1"
msgstr "Užėmus bazę, visos zonoje likusios besiginančios komandos mašinos tampa taikiniais bombardavimui."

msgid "epicTip10"
msgstr "Be šlovės ir garbės, rangai suteikia naudingų bonusų po kiekvieno mūšio."

msgid "epicTip11"
msgstr "Režimas \"Fronto linija\" suteikia daug naujų būdų patirties ir kreditų uždirbimui."

msgid "epicTip12"
msgstr "Fronto linija gali būti perkeliama išstūmus priešininkus atgal. Taip jūs galėsite sugrįžti į mūšį arčiau prie taikinių."

msgid "epicTip13"
msgstr "Jeigu bazės apskritime esanti mašina patiria žalą, bazės užėmimo progresas yra sustabdomas tam tikram laikui."

msgid "epicTip14"
msgstr "Aktyvuokite ir kelkite kovinius rezervus specialiame lange. Panaudokite juos naikinimui mūšio lauke."

msgid "epicTip15"
msgstr "Jeigu reikia, jūs galite pasirinkti kitą frontą grįžimo į mūšį lange."

msgid "epicTip16"
msgstr "Nevažiuokite į apsaugotas zonas. Priešų artileriniai pabūklai pradės į jus šaudyti."

msgid "epicTip17"
msgstr "Jūsų mašina užstrigo kažkur žemėlapyje? Pasinaudokite galimybe palikti mašiną (J pagal nutylėjimą) ir tęskite kovą su kita mašina."

msgid "epicTip18"
msgstr "Pasididinkite mini žemėlapį (M pagal nutylėjimą) norėdami geriau apžiūrėti mūšio lauką."

msgid "epicTip19"
msgstr "Jūs gausite pranešimus tik iš tų sąjungininkų, kurie matomi jūsų mini žemėlapyje."

msgid "epicTip2"
msgstr "Režime \"Fronto linija\" galite užsidirbti daug papildomų apdovanojimų."

msgid "epicTip20"
msgstr "Jūs galite keisti mini žemėlapyje matomos teritorijos dydį su kursoriumi ir pelės viduriniu ratuku."

msgid "epicTip21"
msgstr "Jūs galite atkreipti sąjungininkų dėmesį į bazes ar taikinius paspausdami ant jų mini žemėlapyje."

msgid "epicTip22"
msgstr "Kai jūsų mašina sunaikinama, išbandykite laisvos kameros režimą. Taip galėsite suplanuoti savo strategiją ir būsimus veiksmus, kai grįšite į mūšį."

msgid "epicTip23"
msgstr "Jeigu užimant bazę baigiasi mūšio laikas, prasideda pratęsimas. Mūšis tęsis tol, kol situacija visose bazėse bus aiški."

msgid "epicTip3"
msgstr "Fronto linijos režime žemėlapio dydis yra 9 km², tai yra devynis kartus didesnis žemėlapis nei bet kuris standartinis."

msgid "epicTip4"
msgstr "Mūšio laikas padidinamas kiekvieną kartą užėmus zoną. Paskutinė zona suteikia papildomo laiko."

msgid "epicTip5"
msgstr "Jeigu jūsų mašina sunaikinama mūšyje, jos remontui reikės laiko. Pasirinkite kitą mašiną ir grįžkite į mūšį."

msgid "epicTip6"
msgstr "Kas 5 minutes į jūsų rezervą atkeliauja viena papildoma mašina."

msgid "epicTip7"
msgstr "Puolėjai gali patekti į antros linijos zoną tik tada, kai pirma linija tame fronte jau užimta."

msgid "epicTip8"
msgstr "Kai užimamos visos zonos pirmoje linijoje, antroje linijoje esančios zonos susilpnėja."

msgid "epicTip9"
msgstr "Teoriškai įmanoma laimėti mūšį sunaikinus visas priešininkų mašinas. Tokia galimybė labai reta."

