msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire pilotas: Matomumas prastas, negaliu padėti!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire pilotas: Per daug priešlėktuvinių pabūklų, negaliu padėti!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire pilotas: Sunkusis priešlėktuvinis pabūklas, negaliu smogti."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire pilotas: Čia viršuje tarsi kulkų pūga!"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire pilotas: Dėl didelio apšaudymo negalime nutaikyti laivo šūvių."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire pilotas: Mums reikia, kad tų priešlėktuvinių pabūklų prie bunkerių nebebūtų."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire pilotas: Man pavyko nusileisti žemiau."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire pilotas: Dabar galite pradėti kviesti didžiųjų pabūklų šūvius su signaliniais dūmais."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire pilotas: Tankai, eilė jums!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire pilotas: Pastebėjau dūmus."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire pilotas: Perduodu koordinates laivui, jis tuoj smogs."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire pilotas: Velnias, vienas mūsų numuštas! Negaliu nusileisti žemiau."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire pilotas: Mums reikia sunaikinti dar vieną priešlėktuvinį pabūklą dabar!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire pilotas: Priešlėktuviniai pabūklai sunaikinti, aš leidžiuosi žemiau. Pasiruoškite nurodyti laivui, kur smogti."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire pilotas: Dėmesio! Didelė grupė priešų artinasi link jūsų."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire pilotas: Jie daro viską, ką gali."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire pilotas: Atsargiai, prie jūsų artinasi dar viena grupė priešų. Būkite atidūs."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire pilotas: Perspėjimas, artinasi paskutinė ir didžiausia priešų banga."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire pilotas: Jie artinasi iš visų pusių. Pasiruoškite."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire pilotas: Aiškiai matau signalinius dūmus. Koordinatės perduodamos laivui."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire pilotas: Štai ir mūsų signaliniai dūmai. Perduodu poziciją mūsų kariniam laivui."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire pilotas: Dūmai ties taikiniu. Perduodu tikslią poziciją kariniam laivui."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire pilotas: Aš matau dūmus, panašu, kad mūsų draugams reikia pagalbos."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "USS Frankford vadas: Laukiame koordinačių smogti."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "USS Frankford vadas: Šauti aklai rizikinga, galime pataikyti į saviškius."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "USS Frankford vadas: Reikia tikslių taikinių, kol kas nešaudome."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "USS Frankford vadas: Kalba USS Frankford vadas. Neigiama."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "USS Frankford vadas: Nepavyksta padėti puolimui. Matomumas per prastas."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "USS Frankford vadas: Nesimato uolų ir bunkerių, matome tik mūsų tankus paplūdimyje."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "USS Frankford vadas: Matome link uolų važiuojančius tankus."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "USS Frankford vadas: Mes padėsime šūviais ta kryptimi."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "USS Frankford vadas: Tikiuosi, kad tas Sherman žino, kur jis šaudo."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "USS Frankford vadas: Sherman pakeitė taikinį. Mes bandome prisitaikyti."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "USS Frankford vadas: Sherman nustojo šaudyti. Mūsų darbas baigtas."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "USS Frankford vadas: Mes negalime pasiekti toliau nuo kranto esančių bunkerių."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "USS Frankford vadas: Atsitraukiame iki saugaus atstumo. Sėkmės sausumoje."

