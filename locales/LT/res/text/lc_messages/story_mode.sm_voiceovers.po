msgid "vo_ob_char01_intro_01"
msgstr "Brooks: Aš nekenčiu Tiger tankų."

msgid "vo_ob_char01_intro_03"
msgstr "Brooks: Seržantas Brooks, 2-oji šarvuočių. Mes irgi sutikome Tiger."

msgid "vo_ob_char01_intro_03_01"
msgstr "Brooks: Dabar mes dviese."

msgid "vo_ob_char01_intro_05"
msgstr "Brooks: Einam su mumis. Miesto puolimas jau prasidėjo..."

msgid "vo_ob_char01_intro_05_01"
msgstr "Brooks: Mums reikia paskubėti."

msgid "vo_ob_char01_intro_07"
msgstr "Brooks: Kažkas panašaus."

msgid "vo_ob_char01_intro_09"
msgstr "Brooks: Ir ar \"Betsė\" turėtų kelti baimę priešams?"

msgid "vo_ob_char01_intro_11"
msgstr "Brooks: Priešai ties 3 valanda!"

msgid "vo_ob_char01_intro_12"
msgstr "Brooks: Pirmiausia pričiupk Stug!"

msgid "vo_ob_char01_intro_17"
msgstr "Brooks: Geriau pirmiau užimkime miestą. Po to pažiūrėsime..."

msgid "vo_ob_char01_m01_stg00_01"
msgstr "Brooks: Negaiškime laiko. Judam."

msgid "vo_ob_char01_m01_stg00_02"
msgstr "Brooks: Kelkis! Mes judame pirmyn."

msgid "vo_ob_char01_m01_stg00_03"
msgstr "Brooks: Neatsilik, Sherman."

msgid "vo_ob_char01_m01_stg00_04"
msgstr "Brooks: Jie mūsų laukia mieste – paskubėk."

msgid "vo_ob_char01_m01_stg00_05"
msgstr "Brooks: Pirmyn, pirmyn, pirmyn!"

msgid "vo_ob_char01_m01_stg010_01"
msgstr "Brooks: Artilerija ties 12 valanda. Skubiai ją sunaikink!"

msgid "vo_ob_char01_m01_stg010_04"
msgstr "Brooks: Pavyko! Gerai padirbėjai, Sherman."

msgid "vo_ob_char01_m01_stg011_01"
msgstr "Brooks: Būry, naujas priešas!"

msgid "vo_ob_char01_m01_stg012_02"
msgstr "Brooks: Judėkite arčiau centro. Būkite atidūs."

msgid "vo_ob_char01_m01_stg014_01"
msgstr "Brooks: Gerai. Dabar išvalykime paskutinę aikštę. Pirmyn!"

msgid "vo_ob_char01_m01_stg015_01"
msgstr "Brooks: Dėmesio! Daugiau priešų, nei tikėjomės!"

msgid "vo_ob_char01_m01_stg015_05"
msgstr "Brooks: Nauja priešų grupė! Neleisk jiems tavęs apvažiuoti, laimės kūdiki!"

msgid "vo_ob_char01_m01_stg016_02"
msgstr "Brooks: Ačiū už pagalbą. Mes laimėjome šį mūšį, bet laukia dar daug kovų."

msgid "vo_ob_char01_m01_stg016_04"
msgstr "Brooks: Nagi, nagi, Betse."

msgid "vo_ob_char01_m01_stg01_01"
msgstr "Brooks: Puolimas jau prasidėjo – mums reikia paskubėti."

msgid "vo_ob_char01_m01_stg01_03"
msgstr "Brooks: Tavo senelio garbei?"

msgid "vo_ob_char01_m01_stg01_07"
msgstr "Brooks: Sherman, paskui mus. Negaiškime daugiau laiko."

msgid "vo_ob_char01_m01_stg02_04"
msgstr "Brooks: Skamba per daug vokiškai."

msgid "vo_ob_char01_m01_stg03_01"
msgstr "Brooks: Priešai ties 2 valanda! Šaukite laisvai!"

msgid "vo_ob_char01_m01_stg03_02"
msgstr "Brooks: Priešai ties 12 valanda! Šaukite laisvai!"

msgid "vo_ob_char01_m01_stg04_01"
msgstr "Brooks: Sunaikinti. Pirmyn į miestą."

msgid "vo_ob_char01_m01_stg04_03"
msgstr "Brooks: Tai gal ir kelia baimę... Bet nėra labai originalu."

msgid "vo_ob_char01_m01_stg05_01"
msgstr "Brooks: Nagi, nagi, judam! Mūsiškiai laukia."

msgid "vo_ob_char01_m01_stg06_01"
msgstr "Brooks: Du priešai ties 12 valanda. Šaukite!"

msgid "vo_ob_char01_m01_stg07_02"
msgstr "Brooks: Žiūrėkite atidžiai, vade! Apvažiuokime juos iš dešinės."

msgid "vo_ob_char01_m01_stg08_01"
msgstr "Brooks: Tai vokiečių Panzer. Šaukite šarvamušiais!"

msgid "vo_ob_char01_m02_stg01_01"
msgstr "Brooks: Važiuojam. Visi būkite atidūs. Miestą puola iš oro."

msgid "vo_ob_char01_m02_stg01_01_01"
msgstr "Brooks: Bet ten vis tiek bus pilna priešų mašinų."

msgid "vo_ob_char01_m02_stg01_03"
msgstr "Brooks: Tik per daug neįsijausk, MacLeod. Tai..."

msgid "vo_ob_char01_m02_stg01_03_01"
msgstr "Brooks: Velnias! Štai iš mūsų pirmasis puolimo pulkas. Ar tą padarė Tiger?"

msgid "vo_ob_char01_m02_stg02_01"
msgstr "Brooks: O štai ir jie!"

msgid "vo_ob_char01_m02_stg02_03"
msgstr "Brooks: Būk atidus, MacLeod!"

msgid "vo_ob_char01_m02_stg03_01"
msgstr "Brooks: Kitame krante VK! Šaukite laisvai!"

msgid "vo_ob_char01_m02_stg04_02"
msgstr "Brooks: Pirmą kartą tave girdžiu taip prašantį taikinio."

msgid "vo_ob_char01_m02_stg05_01"
msgstr "Brooks: Tiltas užblokuotas. Teks apvažiuoti."

msgid "vo_ob_char01_m02_stg05_03"
msgstr "Brooks: Optimizmas padeda pasiruošti misijai. Netoliese yra brasta."

msgid "vo_ob_char01_m02_stg05_04"
msgstr "Brooks: O tu tikras ekstrasensas. Kaip tau taip pavyko?"

msgid "vo_ob_char01_m02_stg05_06"
msgstr "Brooks: Tada kodėl neperspėjai mūsų? Tai buvo priešas."

msgid "vo_ob_char01_m02_stg06_01"
msgstr "Brooks: Priešai ties 12 valanda!"

msgid "vo_ob_char01_m02_stg06_01_01"
msgstr "Brooks: Pataupyk savo sviedinius, laimės kūdiki! Nešaudyk bet kaip, naudok optiką."

msgid "vo_ob_char01_m02_stg06_03"
msgstr "Brooks: Užbaikime juos ir judėkime pirmyn."

msgid "vo_ob_char01_m02_stg06_03_01"
msgstr "Brooks: Mums reikia pasivyti antrąjį puolimo pulką."

msgid "vo_ob_char01_m02_stg07_02"
msgstr "Brooks: Tik nepulkite į paniką. Tiger yra Tiger."

msgid "vo_ob_char01_m02_stg07_02_01"
msgstr "Brooks: Jie labai pavojingi."

msgid "vo_ob_char01_m02_stg07_04"
msgstr "Brooks: Vėl tekalbi apie savo medalį! Ar tu čia atėjai tik dėl papuošimų?"

msgid "vo_ob_char01_m02_stg08_01"
msgstr "Brooks: Geros žinios: mes pasivijome antrąjį pulką."

msgid "vo_ob_char01_m02_stg08_02"
msgstr "Brooks: Velnias! Apvažiuokit jį! Apvažiuokit jį!"

msgid "vo_ob_char01_m02_stg08_04"
msgstr "Brooks: Prakeikimas! Šaudykit kiek galit!"

msgid "vo_ob_char01_m02_stg08_05"
msgstr "Brooks: Visų jūsų dėmesiui: Visi mūsiškių pulkai sunaikinti."

msgid "vo_ob_char01_m02_stg08_05_01"
msgstr "Brooks: Mes dabar vieni. Mums reikia užbaigti misiją. Pirmyn."

msgid "vo_ob_char01_m02_stg09_01"
msgstr "Brooks: Priešai! 12 valanda!"

msgid "vo_ob_char01_m02_stg09_03"
msgstr "Brooks: Nemanau, jog čia buvo visi."

msgid "vo_ob_char01_m02_stg09_03_01"
msgstr "Brooks: Žvalgybos duomenimis turėtume matyti daugiau Tiger tankų."

msgid "vo_ob_char01_m02_stg10_01"
msgstr "Brooks: O dieve... Tai ne Panther. Tai King Tiger."

msgid "vo_ob_char01_m02_stg10_03"
msgstr "Brooks: Už tą tikrai turėtum gauti medalį."

msgid "vo_ob_char01_m02_stg10_05"
msgstr "Brooks: Mes negalime jo pramušti iš priekio. Apvažiuokim."

msgid "vo_ob_char01_m02_stg11_01"
msgstr "Brooks: Judėk! Neleisk jiems taikytis!"

msgid "vo_ob_char01_m02_stg11_03"
msgstr "Brooks: Prakeikimas! Pataikė man į vikšrą. Negaliu pajudėti!"

msgid "vo_ob_char02_intro_02"
msgstr "MacLeod: Bet jie taip gražiai dega."

msgid "vo_ob_char02_intro_04"
msgstr "MacLeod: Tas irgi gražiai degė."

msgid "vo_ob_char02_intro_06"
msgstr "MacLeod: Ei, seržante Brooks – kodėl \"Perkūnas\"?"

msgid "vo_ob_char02_intro_06_01"
msgstr "MacLeod: Manai išgąsdinsi priešus vien pavadinimu?"

msgid "vo_ob_char02_intro_08"
msgstr "MacLeod: Hm... Mano Firefly neturi vardo. Pavadinsiu ją \"Betse\"."

msgid "vo_ob_char02_intro_10"
msgstr "MacLeod: Tai mano močiutės garbei. Aš jos tikrai prisibijodavau..."

msgid "vo_ob_char02_intro_13"
msgstr "MacLeod: Hey, Sherman, atsibudai? Pačiu laiku!"

msgid "vo_ob_char02_intro_14"
msgstr "MacLeod: Jūs, parazitai!"

msgid "vo_ob_char02_intro_15"
msgstr "MacLeod: Geras šūvis, Sherman! Gera tave matyti vėl ant kojų!"

msgid "vo_ob_char02_intro_16"
msgstr "MacLeod: Dar du taškai man! Seržante Brooks, kur mano medalis?"

msgid "vo_ob_char02_intro_18"
msgstr "MacLeod: Tipiška..."

msgid "vo_ob_char02_m01_stg00_01"
msgstr "MacLeod: Važiuojam, Sherman."

msgid "vo_ob_char02_m01_stg00_02"
msgstr "MacLeod: Sherman, pabusk."

msgid "vo_ob_char02_m01_stg00_03"
msgstr "MacLeod: Nestovėk ten. Važiuok!"

msgid "vo_ob_char02_m01_stg00_04"
msgstr "MacLeod: Ar tavo tankas vėl užstrigo, ar kas?"

msgid "vo_ob_char02_m01_stg00_05"
msgstr "MacLeod: Pasiskubinam, kitaip praleisime vakarėlį!"

msgid "vo_ob_char02_m01_stg010_02"
msgstr "MacLeod: Ah, tu nelemtas... Už šitą atsakysi!"

msgid "vo_ob_char02_m01_stg010_03"
msgstr "MacLeod: Naudok optikas, laimės kūdiki!"

msgid "vo_ob_char02_m01_stg010_03_01"
msgstr "MacLeod: Ah! Tiesiog išsprūdo. Tada tiesiog vadinsiu tave laimės kūdikiu!"

msgid "vo_ob_char02_m01_stg012_01"
msgstr "MacLeod: Viskas gerai, laimės kūdiki. Mes čia tikrai pasiilgome tavo stiliaus."

msgid "vo_ob_char02_m01_stg013_01"
msgstr "MacLeod: Oho! Čia jų užteks visiems."

msgid "vo_ob_char02_m01_stg015_02"
msgstr "MacLeod: Nori gal truputį pasivaržyti, laimės kūdiki?"

msgid "vo_ob_char02_m01_stg015_03"
msgstr "MacLeod: Nagi supleškink juos!"

msgid "vo_ob_char02_m01_stg015_04"
msgstr "MacLeod: Va čia tai liepsna!"

msgid "vo_ob_char02_m01_stg016_01"
msgstr "MacLeod: O tai buvo karšta! Nusipelnei pagarbos."

msgid "vo_ob_char02_m01_stg016_01_01"
msgstr "MacLeod: Jau seniai nemačiau nieko panašaus!"

msgid "vo_ob_char02_m01_stg016_03"
msgstr "MacLeod: Ei, seržante Brooks, o kaip tas medalis?"

msgid "vo_ob_char02_m01_stg016_05"
msgstr "MacLeod: Ha!"

msgid "vo_ob_char02_m01_stg01_02"
msgstr "MacLeod: Tai tada sugalvokime vardą mūsų Sherman tankui."

msgid "vo_ob_char02_m01_stg01_04"
msgstr "MacLeod: Ha! Jo vardas buvo Ruaraidh."

msgid "vo_ob_char02_m01_stg01_05"
msgstr "MacLeod: Tai tikrai išgąsdins priešus."

msgid "vo_ob_char02_m01_stg01_05_01"
msgstr "MacLeod: Bet aš bijau, kad nesugebėsi jo teisingai parašyti!"

msgid "vo_ob_char02_m01_stg01_06"
msgstr "MacLeod: Gerai, Sherman, važiuojam. Vakarėlis jau prasidėjo!"

msgid "vo_ob_char02_m01_stg02_01"
msgstr "MacLeod: Važiuok per aplinkui, Sherman."

msgid "vo_ob_char02_m01_stg02_02"
msgstr "MacLeod: Jei užkliūsi, prarasi greitį ir tapsi lengvu taikiniu."

msgid "vo_ob_char02_m01_stg02_03"
msgstr "MacLeod: O gal \"Battlewagon\"? Kaip toks pavadinimas?"

msgid "vo_ob_char02_m01_stg03_03"
msgstr "MacLeod: Va taip va! O tam kledarui galime nepagailėti sviedinių!"

msgid "vo_ob_char02_m01_stg04_02"
msgstr "MacLeod: O kaip tada \"Mirties mašina\"?"

msgid "vo_ob_char02_m01_stg04_04"
msgstr "MacLeod: Sako \"Perkūnas\"!"

msgid "vo_ob_char02_m01_stg05_02"
msgstr "MacLeod: Mūsų vyrams patinka šitas veiksmas! Koks nuostabus ugnies šou!"

msgid "vo_ob_char02_m01_stg06_02"
msgstr "MacLeod: Šauk, Mirties mašina, šauk!"

msgid "vo_ob_char02_m01_stg06_03"
msgstr "MacLeod: Reikia trumpesnio pavadinimo."

msgid "vo_ob_char02_m01_stg06_04"
msgstr "MacLeod: Nagi! Suk savo bokštelį! Supleškink tuos kibirus!"

msgid "vo_ob_char02_m01_stg07_01"
msgstr "MacLeod: Dievulėliau! Nedaug trūko."

msgid "vo_ob_char02_m01_stg09_01"
msgstr "MacLeod: O jūs nuo šito nepabėgsite! Važiuojam paskui..."

msgid "vo_ob_char02_m01_stg09_01_01"
msgstr "MacLeod: Giltinė? O kaip Giltinė?"

msgid "vo_ob_char02_m02_stg01_02"
msgstr "MacLeod: Pradėkime medžioklę!"

msgid "vo_ob_char02_m02_stg01_02_01"
msgstr "MacLeod: Taigi, laimės kūdiki, panašu, kad šiandien pagaliau MacLeod atims iš tavęs \"Tiger medžiotojo\" titulą!"

msgid "vo_ob_char02_m02_stg01_04"
msgstr "MacLeod: Ne. Kitokio dydžio skylės. Tai buvo vidutiniai tankai."

msgid "vo_ob_char02_m02_stg02_02"
msgstr "MacLeod: Pfft... Nekoks laimikis. Nieko įdomaus."

msgid "vo_ob_char02_m02_stg02_04"
msgstr "MacLeod: O taip! Taip ir toliau, laimės kūdiki!"

msgid "vo_ob_char02_m02_stg03_02"
msgstr "MacLeod: O jie tai tikri kvailiai. Su mūsų optika jie lengvi taikiniai."

msgid "vo_ob_char02_m02_stg04_01"
msgstr "MacLeod: O štai ir antras. Ei, laimės kūdiki, palik man paskutinį, gerai?"

msgid "vo_ob_char02_m02_stg04_03"
msgstr "MacLeod: Velnias! Ar aš tai pasakiau garsiai?"

msgid "vo_ob_char02_m02_stg05_02"
msgstr "MacLeod: Galvok optimistiškai, seržante! Priekyje bus pravažiavimas."

msgid "vo_ob_char02_m02_stg05_05"
msgstr "MacLeod: Aš turiu geras akis. Mačiau lėktuvą."

msgid "vo_ob_char02_m02_stg05_07"
msgstr "MacLeod: Ane?! Maniau jis mūsų."

msgid "vo_ob_char02_m02_stg06_02"
msgstr "MacLeod: Mes tarsi šaudykloje. Ką jie sau galvoja?"

msgid "vo_ob_char02_m02_stg07_01"
msgstr "MacLeod: Aš manau, tai jie bandys mus pasivyti."

msgid "vo_ob_char02_m02_stg07_01_01"
msgstr "MacLeod: O jie apvažiavo nemažą lanką. Pro tavo brastą."

msgid "vo_ob_char02_m02_stg07_01_02"
msgstr "MacLeod: Tie tigrai pažymėti mūsų vardais."

msgid "vo_ob_char02_m02_stg07_03"
msgstr "MacLeod: Ir tai yra gerai."

msgid "vo_ob_char02_m02_stg07_03_01"
msgstr "MacLeod: Kiek dar jų turėsiu sunaikinti, iki kol gausiu medalį?"

msgid "vo_ob_char02_m02_stg07_05"
msgstr "MacLeod: Man nė trupučio nerūpi."

msgid "vo_ob_char02_m02_stg07_05_01"
msgstr "MacLeod: Aš tenoriu jį parsiųsti namo mamai – bent kiek ją pradžiuginti, žinai?"

msgid "vo_ob_char02_m02_stg07_05_02"
msgstr "MacLeod: Ji parodys jį visiems savo kaimynams. Ir didžiuosis manimi."

msgid "vo_ob_char02_m02_stg07_05_03"
msgstr "MacLeod: Galiausiai."

msgid "vo_ob_char02_m02_stg08_03"
msgstr "MacLeod: Va čia tai tvirtas parazitas."

msgid "vo_ob_char02_m02_stg08_03_01"
msgstr "MacLeod: Taikykis į silpnąsias vietas, laimės kūdiki! Į šonus ir galą!"

msgid "vo_ob_char02_m02_stg08_04"
msgstr "MacLeod: Šitas gerai dega!"

msgid "vo_ob_char02_m02_stg08_05"
msgstr "MacLeod: Va čia tai tvirtas parazitas! Ieškok jo silpnųjų vietų, laimės kūdiki."

msgid "vo_ob_char02_m02_stg08_05_01"
msgstr "MacLeod: Taikykis į pilvą – po priekiniais šarvais visada būna ploniau!"

msgid "vo_ob_char02_m02_stg08_06"
msgstr "MacLeod: Va čia tai tvirtas parazitas! Ieškok jo silpnųjų vietų, laimės kūdiki!"

msgid "vo_ob_char02_m02_stg08_07"
msgstr "MacLeod: Taikykis į pilvą – po priekiniais šarvais visada būna ploniau!"

msgid "vo_ob_char02_m02_stg08_08"
msgstr "MacLeod: Taikykis į kupolus – į juos sunku pataikyti, bet lengva pramušti."

msgid "vo_ob_char02_m02_stg09_02"
msgstr "MacLeod: Tik nepamiršk judėti, laimės kūdiki. Arba jie pataikys į tavo silpnąsias vietas."

msgid "vo_ob_char02_m02_stg09_02_01"
msgstr "MacLeod: Arba gali paslėpti savo korpusą už sunaikintų tankų."

msgid "vo_ob_char02_m02_stg09_02_02"
msgstr "MacLeod: Tuomet jie tau nieko nepadarys – turi labai tvirtą bokštelį."

msgid "vo_ob_char02_m02_stg09_04"
msgstr "MacLeod: O tie vyrai iš žvalgybos... Jie tikriausiai nežino nieko."

msgid "vo_ob_char02_m02_stg09_04_01"
msgstr "MacLeod: Kas dar ten galėtų būti? Panther tankai?"

msgid "vo_ob_char02_m02_stg10_02"
msgstr "MacLeod: O tokio dar anksčiau nemačiau."

msgid "vo_ob_char02_m02_stg10_04"
msgstr "MacLeod: O, pagaliau!"

msgid "vo_ob_char02_m02_stg10_06"
msgstr "MacLeod: Laimės kūdiki! Šonai! Galas! Šaudyk į silpnąsias vietas!"

msgid "vo_ob_char02_m02_stg11_02"
msgstr "MacLeod: Šitas kvailys tikrai nepasivys Sherman tankų."

msgid "vo_ob_char02_m02_stg11_04"
msgstr "MacLeod: Laimės kūdiki, pričiupk juos – paskubėk!"

msgid "vo_ob_char02_m02_stg12_01"
msgstr "MacLeod: Brooks! Prakeikimas, Brooks, atsakyk ką nors!"

msgid "vo_ob_char02_m02_stg13_01"
msgstr "MacLeod: Apvažiuok juos! Smok į silpnąsias vietas!"

msgid "vo_ob_char02_m02_stg13_02"
msgstr "MacLeod: Laimės kūdiki, smok į šonus ir galą!"

msgid "vo_ob_char02_m02_stg13_03"
msgstr "MacLeod: Bokštelio tvirtas tik priekis. Nesustok!"

msgid "vo_ob_char02_m02_stg14_01"
msgstr "MacLeod: Va taip."

msgid "vo_ob_char02_m02_stg14_02"
msgstr "MacLeod: Jie dega. Gražiai dega."

msgid "vo_ob_char02_m02_stg14_03"
msgstr "MacLeod: Tiger medžiotojas: dabar tai oficialus tavo titulas."

msgid "vo_sm_char01_m03_stg01_02"
msgstr "Brooks: Pranešimas iš štabo. Seržantas Brooks Tiger medžiotojams."

msgid "vo_sm_char01_m03_stg01_02_01"
msgstr "Brooks: Mieste ir aplink jį pilna minų. Važiuokite atsargiai."

msgid "vo_sm_char01_m03_stg01_04"
msgstr "Brooks: Gera tai girdėti, MacLeod."

msgid "vo_sm_char01_m03_stg01_04_01"
msgstr "Brooks: Bet likite budrūs. Pakeliui jūsų laukia dideli minų laukai."

msgid "vo_sm_char01_m03_stg01_06"
msgstr "Brooks: Ką gerai patrinti?"

msgid "vo_sm_char01_m03_stg03_02"
msgstr "Brooks: Kodėl manai, kad Laimės kūdikis irgi turi ritualą?"

msgid "vo_sm_char01_m03_stg04_02"
msgstr "Brooks: Per daug neįsijausk. Taikykitės kartu į vieną taikinį. Išlikite grupėje."

msgid "vo_sm_char01_m03_stg07_03"
msgstr "Brooks: Senis? Rimtai?"

msgid "vo_sm_char01_m03_stg07_05"
msgstr "Brooks: Aš vos šešiais metai vyresnis, MacLeod."

msgid "vo_sm_char01_m03_stg08_02"
msgstr "Brooks: Gal jie tiesiog mandagūs ir leidžia tau vienam kalbėti, MacLeod!"

msgid "vo_sm_char01_m03_stg10_02"
msgstr "Brooks: MacLeod, laukiu raporto."

msgid "vo_sm_char01_m03_stg10_04"
msgstr "Brooks: Senas, geras MacLeod."

msgid "vo_sm_char01_m03_stg11_02"
msgstr "Brooks: Jūs gi turite Laimės kūdikį. Jis suteikia daugiau sėkmės, nei bet koks talismanas."

msgid "vo_sm_char01_m03_stg11_02_01"
msgstr "Brooks: Ieškokite kito kelio, vyrai!"

msgid "vo_sm_char01_m03_stg14_02"
msgstr "Brooks: Galvas aukštyn, medžiotojai."

msgid "vo_sm_char01_m03_stg14_02_01"
msgstr "Brooks: Mūsų bombonešiai artinasi prie jūsų. Būkite atsargūs."

msgid "vo_sm_char01_m03_stg14_02_02"
msgstr "Brooks: Laikykite atstumo nuo priešų tankų."

msgid "vo_sm_char01_m03_stg15_02"
msgstr "Brooks: Jums viskas gerai?"

msgid "vo_sm_char01_m03_stg18_02"
msgstr "Brooks: Patarimų neturiu, MacLeod. Bet turiu pagalbą iš oro. Susisiekiu su nauju pilotu."

msgid "vo_sm_char01_m03_stg21_02"
msgstr "Brooks: Nenukrypk nuo tikslo, MacLeod. Dar reikia išvalyti vieną aikštę."

msgid "vo_sm_char01_m03_stg21_02_01"
msgstr "Brooks: Savo pramanus galėsite aptarti prie puodelio arbatos vėliau."

msgid "vo_sm_char01_m03_stg21_04"
msgstr "Brooks: Kaip pasakysi."

msgid "vo_sm_char01_m03_stg25_03"
msgstr "Brooks: Neprisigalvok nesąmonių, mums nereikia sėkmės talismanų."

msgid "vo_sm_char01_m03_stg25_05"
msgstr "Brooks: Planavimas ir strategija, MacLeod, planavimas ir strategija."

msgid "vo_sm_char01_m03_stg26_02"
msgstr "Brooks: Stalo kas?"

msgid "vo_sm_char01_m03_stg28_03"
msgstr "Brooks: Velnias, žvalgyba apie tai nepranešė..."

msgid "vo_sm_char01_m03_stg28_07"
msgstr "Brooks: Mes darome viską, ką galime."

msgid "vo_sm_char01_m03_stg30_02"
msgstr "Brooks: Gavau pranešimą, kad Erelis vienas vis dar gyvas. Puikiai padirbėjote."

msgid "vo_sm_char01_m03_stg30_03"
msgstr "Brooks: Tu teisus, MacLeod, kartais mums prireikia sėkmės talismanų."

msgid "vo_sm_char01_m03_stg30_03_01"
msgstr "Brooks: Ir taip, turiu vieną. Tintinnabulumą su fascinus."

msgid "vo_sm_char01_m03_stg30_05"
msgstr "Brooks: (juokiasi)"

msgid "vo_sm_char01_m03_stg32_04"
msgstr "Brooks: Laimės kūdiki, metas važiuoti. Ne vaizdu grožėtis susirinkome."

msgid "vo_sm_char01_m03_stg32_05"
msgstr "Brooks: Pirmyn, Laimės kūdiki! Čia kiekviena sekundė svarbi."

msgid "vo_sm_char01_m03_stg32_06"
msgstr "Brooks: Laimės kūdiki, mes turime atlikti misiją. Važiuojam pirmyn."

msgid "vo_sm_char01_m03_stg33_02"
msgstr "Brooks: Betsė tikrai tą pasakė?"

msgid "vo_sm_char01_m03_stg34_01"
msgstr "Brooks: Laikas ne mūsų pusėje. Nebandykite būti herojais."

msgid "vo_sm_char01_m03_stg34_01_01"
msgstr "Brooks: Jei tik galite, suspauskite savo priešą iš šonų. Išgąsdinkite juos ir smokite jiems į šonus."

msgid "vo_sm_char01_m03_stg40_01"
msgstr "Brooks: Jums siunčiamas pastiprinimas. Laikykitės."

msgid "vo_sm_char01_m03_stg40_02"
msgstr "Brooks: Pastiprinimas pakeliui. Turėtų atvykti ne už ilgo."

msgid "vo_sm_char01_m03_stg40_03"
msgstr "Brooks: Nauji mūsiškių tankai pakeliui."

msgid "vo_sm_char01_m03_stg42_05"
msgstr "Brooks: Atgal prie tikslo, vade. Per daug neišsišokite ir važiuokite į priekį."

msgid "vo_sm_char01_m03_stg42_06"
msgstr "Brooks: Prižiūrėk šį tanką. Mes neturime daug rezervų."

msgid "vo_sm_char01_m03_stg42_07"
msgstr "Brooks: Turi dar vieną progą. Išnaudok ją."

msgid "vo_sm_char01_m04_stg01_02"
msgstr "Brooks: Pranešimas iš štabo, kalba seržantas Brooks."

msgid "vo_sm_char01_m04_stg01_04"
msgstr "Brooks: Ne, nešaudys."

msgid "vo_sm_char01_m04_stg01_04_01"
msgstr "Brooks: Tikiuosi."

msgid "vo_sm_char01_m04_stg02_02"
msgstr "Brooks: Ne. Kažko didelio ir sunkaus. Mūsiškiai jau bandė sunaikinti tai kelis kartus."

msgid "vo_sm_char01_m04_stg02_02_01"
msgstr "Brooks: Išsiuntė kelis būrius. Nei vienas negrįžo."

msgid "vo_sm_char01_m04_stg03_02"
msgstr "Brooks: Ne, mūsų žvalgyba praneša, kad taikinys vis dar miete."

msgid "vo_sm_char01_m04_stg05_01"
msgstr "Brooks: Sustokite! Dabar ne laikas rizikuoti! Dabar jūs turite kitą užduotį."

msgid "vo_sm_char01_m04_stg06_02"
msgstr "Brooks: Aš rekomenduoju pasinaudoti savo koziriu."

msgid "vo_sm_char01_m04_stg07_01"
msgstr "Brooks: Štabas Audrapaukščiui, atsiliepkite."

msgid "vo_sm_char01_m04_stg07_03"
msgstr "Brooks: Jūsų taikinys yra King Tiger, esantis ant C3 tilto."

msgid "vo_sm_char01_m04_stg08_03"
msgstr "Brooks: Sustok, MacLeod. Per daug rizikinga."

msgid "vo_sm_char01_m04_stg08_03_01"
msgstr "Brooks: Dirbkite drauge. Neleiskite Tiger pajudėti. Audrapaukštis atliks dar vieną manevrą."

msgid "vo_sm_char01_m04_stg08_03_02"
msgstr "Brooks: Neleiskite Tiger pajudėti. Audrapaukštis atliks dar vieną manevrą."

msgid "vo_sm_char01_m04_stg13_03"
msgstr "Brooks: Mes neturime aiškios informacijos, MacLeod."

msgid "vo_sm_char01_m04_stg13_03_01"
msgstr "Brooks: Tai eksperimentinis produktas. Prototipas. Ir, akivaizdžiai, neblogas."

msgid "vo_sm_char01_m04_stg14_02"
msgstr "Brooks: MacLeod, tam nėra laiko. Tai ne jūsų problema."

msgid "vo_sm_char01_m04_stg15_01"
msgstr "Brooks: Apvažiuokite juos gatvelėmis. Tada perduokite koordinates Bennett."

msgid "vo_sm_char01_m04_stg15_03"
msgstr "Brooks: Audrapaukštis."

msgid "vo_sm_char01_m04_stg17_02"
msgstr "Brooks: Typ 205."

msgid "vo_sm_char01_m04_stg17_04"
msgstr "Brooks: Kodėl \"Peliukas\"?"

msgid "vo_sm_char01_m04_stg19_02"
msgstr "Brooks: Tokia informacija. Jie jau turėjo būti sugrįžę į bazę."

msgid "vo_sm_char01_m04_stg23_02"
msgstr "Brooks: Atleisk, MacLeod. Tikriausiai išsprūdo."

msgid "vo_sm_char01_m04_stg24_06"
msgstr "Brooks: Gal ir taip, bet reiktų laiko suorganizuoti."

msgid "vo_sm_char01_m04_stg26_02"
msgstr "Brooks: Tai ir buvo slapta operacija."

msgid "vo_sm_char01_m04_stg26_02_01"
msgstr "Brooks: Bet tu nusprendei, kad gali pats susidoroti su Jagdtiger."

msgid "vo_sm_char01_m04_stg26_04"
msgstr "Brooks: Jie užstrigo fronto atakose."

msgid "vo_sm_char01_m04_stg27_01"
msgstr "Brooks: Bombonešiai ruošiasi puolimui. Pasiruoškite fejerverkams."

msgid "vo_sm_char01_m04_stg28_02"
msgstr "Brooks: Nuo kada tu niurzgi, MacLeod?"

msgid "vo_sm_char01_m04_stg30_03"
msgstr "Brooks: O kas sakė, kad tai jo pirmi Tiger tankai? Kaip manai, kodėl jis yra šioje misijoje?"

msgid "vo_sm_char01_m04_stg31_02"
msgstr "Brooks: Ką ši komanda darytų be tavęs, MacLeod?"

msgid "vo_sm_char01_m04_stg33_02"
msgstr "Brooks: Velnias! Laimės kūdiki, būk atsargus ir... sėkmės!"

msgid "vo_sm_char01_m04_stg35_01"
msgstr "Brooks: Pastiprinimas jau pakeliui."

msgid "vo_sm_char01_m04_stg35_01_01"
msgstr "Brooks: Mūsiškių tankai, kuriuos išgelbėjai. MacLeod, tavo pastangos nenuėjo veltui."

msgid "vo_sm_char01_m04_stg42_02"
msgstr "Brooks: Prisistatė nauja grupė mūsiškių."

msgid "vo_sm_char01_m04_stg42_02_01"
msgstr "Brooks: Tikiuosi, kad su jais bus lengviau susidoroti su Peliuku."

msgid "vo_sm_char01_m04_stg42_03"
msgstr "Brooks: Tačiau nepamiškite, paskutinis šūvis turi būti mūsų."

msgid "vo_sm_char01_m04_stg42_03_01"
msgstr "Brooks: Tai bus mūsų trofėjus. Laimės kūdiki, Bennett, nenuvilkite mūsų."

msgid "vo_sm_char01_m04_stg47_01"
msgstr "Brooks: Puikiai padirbėjote. Siunčiu komandą evakuacijai."

msgid "vo_sm_char01_m04_stg47_01_01"
msgstr "Brooks: MacLeod, mums reikia išgabenti tave ir Peliuką lauk. Jis privalo atitekti mums."

msgid "vo_sm_char01_m04_stg47_01_02"
msgstr "Brooks: Jau galite tikėtis medalių."

msgid "vo_sm_char01_m04_stg47_03"
msgstr "Brooks: O ko tada nori, MacLeod? Naujo rango?"

msgid "vo_sm_char02_m03_stg01_01"
msgstr "MacLeod: Gerai, džentelmenai, metas važiuoti ir apvalyti šį miestą!"

msgid "vo_sm_char02_m03_stg01_03"
msgstr "MacLeod: Brooks?! Seržantas Brooks?! Va čia tai gera žinia! Mes saugiuose rankose!"

msgid "vo_sm_char02_m03_stg01_05"
msgstr "MacLeod: Taip, taip, vade!"

msgid "vo_sm_char02_m03_stg01_05_01"
msgstr "MacLeod: Vyrai! Gerai patrinkite savo sėkmingas monetas prieš šaudami pirmą šūvį!"

msgid "vo_sm_char02_m03_stg01_07"
msgstr "MacLeod: Ką? Aš ne prietaringas, tai tokia tradicija!"

msgid "vo_sm_char02_m03_stg02_01"
msgstr "MacLeod: O, štai ir mūsų balandėliai."

msgid "vo_sm_char02_m03_stg02_01_01"
msgstr "MacLeod: Statau škotiškos \"arbatos\" tam, kuris sunaikins daugiausiai!"

msgid "vo_sm_char02_m03_stg02_01_02"
msgstr "MacLeod: Parodykim jiems, ką galime, Laimės kūdiki!"

msgid "vo_sm_char02_m03_stg03_01"
msgstr "MacLeod: Čia kažkaip labai tylu. O kur iššūkis?"

msgid "vo_sm_char02_m03_stg03_01_01"
msgstr "MacLeod: Gerai... Laimės kūdiki, pasakok – koks yra tavo sėkmės ritualas?"

msgid "vo_sm_char02_m03_stg03_03"
msgstr "MacLeod: Mes visi turime savų būdų prisikviesti sėkmę, ar ne, Laimės kūdiki?"

msgid "vo_sm_char02_m03_stg03_03_01"
msgstr "MacLeod: Gal koks šokis? Lengvas apšilimas prieš važiuojant į kovą?"

msgid "vo_sm_char02_m03_stg04_01"
msgstr "MacLeod: Nu va, visai kitas reikalas! Jie atrodo taip, lyg nenusileistų be kovos."

msgid "vo_sm_char02_m03_stg05_01"
msgstr "MacLeod: Protingi žodžiai, seni Brooks. Laimės kūdiki, padėsi man susidoroti su šituo?"

msgid "vo_sm_char02_m03_stg05_01_01"
msgstr "MacLeod: Aš nukreipsiu to monstro dėmesį, o tu apvažiuok jį iš dešinės."

msgid "vo_sm_char02_m03_stg05_01_02"
msgstr "MacLeod: Paruoškime jiems tinkamą staigmeną, gerai?"

msgid "vo_sm_char02_m03_stg06_01"
msgstr "MacLeod: O šito lengvai nepraskelsi! Laimės kūdiki, sudraskyk jį!"

msgid "vo_sm_char02_m03_stg07_01"
msgstr "MacLeod: Neleiskite niekam pasprukti! Jis sugadins visą mūsų staigmeną!"

msgid "vo_sm_char02_m03_stg07_02"
msgstr "MacLeod: Darbas baigtas!"

msgid "vo_sm_char02_m03_stg07_04"
msgstr "MacLeod: Tai tik draugiškas juokelis su visa derama pagarba, \"se-e-ere\"!"

msgid "vo_sm_char02_m03_stg07_06"
msgstr "MacLeod: Gerai, gerai, žinau."

msgid "vo_sm_char02_m03_stg08_01"
msgstr "MacLeod: Vyrai, o kodėl jūs šiandien tokie tylūs?"

msgid "vo_sm_char02_m03_stg08_03"
msgstr "MacLeod: Ha!"

msgid "vo_sm_char02_m03_stg09_00"
msgstr "MacLeod: Panašu, kad šio chaoso metu užkliudėme skruzdėlyną."

msgid "vo_sm_char02_m03_stg09_00_01"
msgstr "MacLeod: Nepamiršk paslėpti savo korpuso už sunaikintų priešų lūženų, Laimės kūdiki."

msgid "vo_sm_char02_m03_stg09_00_02"
msgstr "MacLeod: Palik jiems matyti tik bokštelį – tai tvirčiausia tavo tanko dalis."

msgid "vo_sm_char02_m03_stg09_01"
msgstr "MacLeod: Gerai, tai gana rimtas priešininkas, nėra laiko kvailioti."

msgid "vo_sm_char02_m03_stg09_01_01"
msgstr "MacLeod: Mes negalime jo įveikti kaktomuša, tad laikomės plano."

msgid "vo_sm_char02_m03_stg09_01_02"
msgstr "MacLeod: Aš nukreipsiu jo dėmesį, o tu atsidurk jam už nugaros. Tačiau pasisaugok, Laimės kūdiki."

msgid "vo_sm_char02_m03_stg09_02"
msgstr "MacLeod: Jei jis nusitaikys į tave, nevaidink didvyrio – slėpkis."

msgid "vo_sm_char02_m03_stg09_02_01"
msgstr "MacLeod: Jo pabūklas pjauna Sherman tankus, kaip sviestą."

msgid "vo_sm_char02_m03_stg09_03"
msgstr "MacLeod: Truputį užsiimk su juo, o aš rasiu progą įkąsti jam iš nugaros."

msgid "vo_sm_char02_m03_stg10_01"
msgstr "MacLeod: Oho, šitas buvo ne iš kelmo spirtas!"

msgid "vo_sm_char02_m03_stg10_03"
msgstr "MacLeod: Dar nesutikome nė vieno Tiger. Kaip mes be jų išsiaiškinsime kuris iš mūsų geriausias!"

msgid "vo_sm_char02_m03_stg10_05"
msgstr "MacLeod: Senas! Ha!"

msgid "vo_sm_char02_m03_stg11_01"
msgstr "MacLeod: Oj, palaukit, vyrai!"

msgid "vo_sm_char02_m03_stg11_01_01"
msgstr "MacLeod: Minos. O tu dar juokavai apie sėkmės talismanus, Brooks."

msgid "vo_sm_char02_m03_stg11_01_02"
msgstr "MacLeod: Mums čia labai reikia sėkmės!"

msgid "vo_sm_char02_m03_stg12_01"
msgstr "MacLeod: Ei, Laimės kūdiki! Radau kitą kelią. Važiuojam."

msgid "vo_sm_char02_m03_stg12_01_01"
msgstr "MacLeod: Ką darytumėt be seno, gero MacLeod!"

msgid "vo_sm_char02_m03_stg12_02"
msgstr "MacLeod: Sėdėtumėte čia iki pat sutemų! Ha!"

msgid "vo_sm_char02_m03_stg12_03"
msgstr "MacLeod: Aha! Radai apvažiavimą! Nuostabu!"

msgid "vo_sm_char02_m03_stg12_03_01"
msgstr "MacLeod: O aš jau galvojau, kad teks laukti iki vakaro, kol atvyks inžinieriai."

msgid "vo_sm_char02_m03_stg13_01"
msgstr "MacLeod: Tik pasižiūrėk, Laimės kūdiki! Du Tiger tankai! Mūsų varžybos tęsiasi."

msgid "vo_sm_char02_m03_stg14_01"
msgstr "MacLeod: Bet ši gatvė per siaura. Pramušti Tiger priekinius šarvus nėra paprasta."

msgid "vo_sm_char02_m03_stg14_03"
msgstr "MacLeod: Puiku! Dabar tik palauk, tuoj išvysime fejerverkus."

msgid "vo_sm_char02_m03_stg14_03_01"
msgstr "MacLeod: Mūsiškiai sunaikins tuos plieninius siaubūnus iš dangaus."

msgid "vo_sm_char02_m03_stg15_01"
msgstr "MacLeod: Oho, kas ten buvo?! Kaip garsiai!"

msgid "vo_sm_char02_m03_stg15_01_01"
msgstr "MacLeod: Oho, kas ten buvo?!"

msgid "vo_sm_char02_m03_stg15_03"
msgstr "MacLeod: Taip, mes dar gyvi, bet pamečiau savo sėkmingą monetą!"

msgid "vo_sm_char02_m03_stg15_03_01"
msgstr "MacLeod: Ir aš nebematau kelių pastatų, kurie čia buvo."

msgid "vo_sm_char02_m03_stg16_01"
msgstr "MacLeod: Laimės kūdiki! Žiūrėk, tai antrasis Tiger, vis dar važiuoja."

msgid "vo_sm_char02_m03_stg16_01_01"
msgstr "MacLeod: Pasinaudokime šiuo nauju tarpu. Suspauskime jį iš abiejų pusių."

msgid "vo_sm_char02_m03_stg17_01"
msgstr "MacLeod: Geras šūvis! Dar vienas Tiger tankas mūsų skaičiuoklėje!"

msgid "vo_sm_char02_m03_stg18_01"
msgstr "MacLeod: Kad mane kur! Daugiau Tiger tankų! Ir už ką mes nusipelnėme tokių dovanų?"

msgid "vo_sm_char02_m03_stg18_01_01"
msgstr "MacLeod: Velnias, čia tai ankštoka. Brooks, turi patarimų?"

msgid "vo_sm_char02_m03_stg19_01"
msgstr "MacLeod: Man patinka jo stiliukas! Laimės kūdiki, žinai, ką daryti. Pasinaudok nauju pravažiavimu."

msgid "vo_sm_char02_m03_stg19_01_01"
msgstr "MacLeod: Aš spausiu jį iš priekio, o tu prasmuk pro šoną."

msgid "vo_sm_char02_m03_stg20_01"
msgstr "MacLeod: Priverskime tuos šmikius šokti lyg karštoje keptuvėje."

msgid "vo_sm_char02_m03_stg20_01_01"
msgstr "MacLeod: Palauk kol abu užsitaisysime, tada jis nežinos, iš kurios pusės laukti smūgio."

msgid "vo_sm_char02_m03_stg20_02"
msgstr "MacLeod: Gal jie ir atrodo grėsmingai iš priekio. Bet jų galas ir šonai minkšti ir sultingi!"

msgid "vo_sm_char02_m03_stg21_01"
msgstr "MacLeod: Kažkas tau vis tiek atneša sėkmę, Laimės kūdiki. Gal tu turi..."

msgid "vo_sm_char02_m03_stg21_03"
msgstr "MacLeod: Tradicijos, Brooks. Ne prietarai."

msgid "vo_sm_char02_m03_stg21_05"
msgstr "MacLeod: Gerai, jau kaip ir laikas užbaigti šią kelionę. Erelis vienas, ar girdite?"

msgid "vo_sm_char02_m03_stg21_05_01"
msgstr "MacLeod: Kokia situacija iš paukščio skrydžio – kiek nekantraujančių fanų susirinko aikštėje?"

msgid "vo_sm_char02_m03_stg22_02"
msgstr "MacLeod: Turiu pasakyti, man jis patinka!"

msgid "vo_sm_char02_m03_stg22_02_01"
msgstr "MacLeod: Gaila, kad jis nedirba su tankais. Mums tikrai praverstų toks šaunuolis įguloje."

msgid "vo_sm_char02_m03_stg23_01"
msgstr "MacLeod: Nu ką, panašu, kad tai paskutinis jo skrydis."

msgid "vo_sm_char02_m03_stg23_01_01"
msgstr "MacLeod: Ereli vienas, tu ten atsargiai, priešų lėktuvai krenta iš dangaus."

msgid "vo_sm_char02_m03_stg24_01"
msgstr "MacLeod: Minos! Aš nekenčiu minų. Surask apvažiavimą, Laimės kūdiki. Aš nukreipsiu jų dėmesį."

msgid "vo_sm_char02_m03_stg25_01"
msgstr "MacLeod: Tarkime, kad Laimės kūdikis gimė po laiminga žvaigžde."

msgid "vo_sm_char02_m03_stg25_01_01"
msgstr "MacLeod: O kaip tu, Brooks? Turi savo sėkmės talismaną?"

msgid "vo_sm_char02_m03_stg25_02"
msgstr "MacLeod: Kokią pasagą kišenėje? O gal net Tintinnabulumą su fascinus pakabuku?"

msgid "vo_sm_char02_m03_stg25_04"
msgstr "MacLeod: Pala. Nejaugi atspėjau?"

msgid "vo_sm_char02_m03_stg26_01"
msgstr "MacLeod: Tik pažiūrėkite, va taip dirba legendos!"

msgid "vo_sm_char02_m03_stg26_01_01"
msgstr "MacLeod: Jei ne jo trauma, Brooks irgi būtų čia su mumis!"

msgid "vo_sm_char02_m03_stg26_01_02"
msgstr "MacLeod: Mes trise, kartu... Na, nieko negali padaryti. Dabar jis stalo..."

msgid "vo_sm_char02_m03_stg26_03"
msgstr "MacLeod: Stalo legenda, sere!"

msgid "vo_sm_char02_m03_stg27_01"
msgstr "MacLeod: Kas per velniava! Va ko trūko, tai priešų artilerijos."

msgid "vo_sm_char02_m03_stg27_01_01"
msgstr "MacLeod: Nestovėk tiesiog, Laimės kūdiki – judėk! Tegul jie rizikuoja pataikyti į saviškius."

msgid "vo_sm_char02_m03_stg28_02"
msgstr "MacLeod: Brooks, iš kur čia tie nekviesti svečiai?"

msgid "vo_sm_char02_m03_stg28_02_01"
msgstr "MacLeod: Aptarime apie juos nebuvo nė žodžio."

msgid "vo_sm_char02_m03_stg28_04"
msgstr "MacLeod: Ah, mano mylimoji žvalgyba... visuomet laikosi savo tradicijų."

msgid "vo_sm_char02_m03_stg28_04_01"
msgstr "MacLeod: Ereli vienas, su kiek priešų gali susidoroti?"

msgid "vo_sm_char02_m03_stg28_06"
msgstr "MacLeod: Erelis vienas, baigiau! Erelis vienas! Velnias!"

msgid "vo_sm_char02_m03_stg28_06_01"
msgstr "MacLeod: Brooks, pasakyk, kad turi kovotojų, galinčių jiems padėti!"

msgid "vo_sm_char02_m03_stg28_08"
msgstr "MacLeod: Laimės kūdiki, ar matai jį? Nagi, Erelis vienas, tu gali jų atsikratyti. Kas per šūdas!"

msgid "vo_sm_char02_m03_stg28_08_01"
msgstr "MacLeod: Metas užsibaigti darbus čia, Laimės kūdiki. Mes suspausime juos iš abiejų pusių. Negaiškim."

msgid "vo_sm_char02_m03_stg29_01"
msgstr "MacLeod: Panašu, kad čia daugiau kompanijos, nei tikėjausi."

msgid "vo_sm_char02_m03_stg29_01_01"
msgstr "MacLeod: Taikomės į tą patį taikinį. Iššaudysim juos po vieną, Laimės kūdiki."

msgid "vo_sm_char02_m03_stg29_01_02"
msgstr "MacLeod: O desertui aš mielai paimsiu riekelę tos artilerijos!"

msgid "vo_sm_char02_m03_stg30_01"
msgstr "MacLeod: Pheu... Nebuvo lengva. O, tik pažiūrėk! Radau savo sėkmingąją monetą!"

msgid "vo_sm_char02_m03_stg30_04"
msgstr "MacLeod: Pala. Ką??? Rimtai? Man reikia tai pamatyti!"

msgid "vo_sm_char02_m03_stg31_01"
msgstr "MacLeod: Traukis iš kelio, Laimės kūdiki, arba mūsų arbata bus šalta ir šlykšti kaip škotiška žiema."

msgid "vo_sm_char02_m03_stg31_02"
msgstr "MacLeod: Važiuojam, Laimės kūdiki! Tie Tiger tankai patys savęs nesusinaikins!"

msgid "vo_sm_char02_m03_stg31_03"
msgstr "MacLeod: Čia nėra minų, Laimės kūdiki. Lekiam."

msgid "vo_sm_char02_m03_stg31_04"
msgstr "MacLeod: Laimės kūdiki, mes ne stovyklauti susirinkom. Varom!"

msgid "vo_sm_char02_m03_stg31_05"
msgstr "MacLeod: Nestovėk ten tiesiog, Laimės kūdiki. Artilerija niekad nemiega."

msgid "vo_sm_char02_m03_stg32_01"
msgstr "MacLeod: Laimės kūdiki, ieškokime kelio aplink tas minas."

msgid "vo_sm_char02_m03_stg32_02"
msgstr "MacLeod: Nestovėk ten, Laimės kūdiki. Surask mums kitą kelią."

msgid "vo_sm_char02_m03_stg32_03"
msgstr "MacLeod: Žiūrėdamas į tas minas jų nepradanginsi, Laimės kūdiki."

msgid "vo_sm_char02_m03_stg32_03_01"
msgstr "MacLeod: Metas surasti apvažiavimą."

msgid "vo_sm_char02_m03_stg33_01"
msgstr "MacLeod: Kaip mano močiutė sakydavo, \"visuomet apvažiuok priešą ir pramušk jo šonus su šarvamušiais.\""

msgid "vo_sm_char02_m03_stg33_03"
msgstr "MacLeod: Na, daugmaž."

msgid "vo_sm_char02_m03_stg35_01"
msgstr "MacLeod: Nepamiršk: jei suspausi priešą iš dviejų pusių, tai bent vienam mūsų jis visada parodys savo silpną vietą."

msgid "vo_sm_char02_m03_stg35_02"
msgstr "MacLeod: Įkalinkime juos, pridenkime iš abiejų pusių."

msgid "vo_sm_char02_m03_stg35_02_01"
msgstr "MacLeod: Taip jie negalės paslėpti savo silpnų vietų."

msgid "vo_sm_char02_m03_stg35_03"
msgstr "MacLeod: Laikykimės paprasto plano: pulkime iš abiejų pusių, nes bent vienam tada teks pasimėgauti plonais jų šarvais!"

msgid "vo_sm_char02_m03_stg36_01"
msgstr "MacLeod: Žiūrėk, kur dedi koją, Laimės kūdiki!"

msgid "vo_sm_char02_m03_stg36_02"
msgstr "MacLeod: Pasisaugok minų!"

msgid "vo_sm_char02_m03_stg36_03"
msgstr "MacLeod: Palauk! Šios minos nėra labai draugiškos mūsų tankams!"

msgid "vo_sm_char02_m03_stg36_04"
msgstr "MacLeod: Minos. Nekenčiu minų."

msgid "vo_sm_char02_m03_stg36_05"
msgstr "MacLeod: Atsargiai! Čionykštės minos nėra labai svetingos."

msgid "vo_sm_char02_m03_stg36_06"
msgstr "MacLeod: Priekyje minos! Ieškokime kito kelio."

msgid "vo_sm_char02_m03_stg37_01"
msgstr "MacLeod: Laimės kūdiki! Ten tai buvo sprogimas! Tau viskas gerai?"

msgid "vo_sm_char02_m03_stg37_02"
msgstr "MacLeod: Palauk! Kur tu taip leki?"

msgid "vo_sm_char02_m03_stg37_02_01"
msgstr "MacLeod: Suremontuok savo vikšrus ir važiuok laukan!"

msgid "vo_sm_char02_m03_stg37_03"
msgstr "MacLeod: Laimės kūdiki, nei nori iškasti duobę, yra lengvesnių būdų!"

msgid "vo_sm_char02_m03_stg37_04"
msgstr "MacLeod: Aiškios ribos, Laimės kūdiki. Tas minas sunku pastebėti."

msgid "vo_sm_char02_m03_stg37_05"
msgstr "MacLeod: Na, tai vienas būdas surasti miną. Ne pats geriausias, bet veikia."

msgid "vo_sm_char02_m03_stg37_06"
msgstr "MacLeod: Susikaupk, Laimės kūdiki. Visiems yra tekę susidurti su viena ar kita mina."

msgid "vo_sm_char02_m03_stg38_01"
msgstr "MacLeod: Atsargiai, Laimės kūdiki! Kitas kartas gali būti paskutinis."

msgid "vo_sm_char02_m03_stg38_02"
msgstr "MacLeod: Panašu, kad tau patinka remontuoti vikšrus, Laimės kūdiki."

msgid "vo_sm_char02_m03_stg38_03"
msgstr "MacLeod: Ką? Ir vėl? Iš kur pas tave tokia meilė minoms, Laimės kūdiki?"

msgid "vo_sm_char02_m03_stg39_01"
msgstr "MacLeod: Velnias, praradome vieną savo tankų."

msgid "vo_sm_char02_m03_stg39_02"
msgstr "MacLeod: Kas vyksta?! Praradome dar vieną mūsiškį!"

msgid "vo_sm_char02_m03_stg39_03"
msgstr "MacLeod: Praradome mūsiškių tanką. Reikės dar labiau pasistengti."

msgid "vo_sm_char02_m03_stg41_01"
msgstr "MacLeod: Mano tankas sunaikintas. Tuoj sugrįšiu su nauju! Per daug manęs nepasiilgsi."

msgid "vo_sm_char02_m03_stg41_02"
msgstr "MacLeod: Ah, nepasisekė! O tai buvo mano mėgstamiausias tankas. Na ką, antras raundas!"

msgid "vo_sm_char02_m03_stg41_03"
msgstr "MacLeod: Mane pramušė. Nesijaudink, tuoj grįšiu su nauju – tikiuosi jie turi mano mėgstamiausią spalvą."

msgid "vo_sm_char02_m03_stg41_04"
msgstr "MacLeod: Nu, puikumėlis. Praradome dar vieną tanką. Duok man minutėlę, tuoj grįšiu."

msgid "vo_sm_char02_m03_stg41_05"
msgstr "MacLeod: Panašu, kad man teks ieškotis naujo tanko."

msgid "vo_sm_char02_m03_stg41_05_01"
msgstr "MacLeod: Tvirtai laikykis, aš grįšiu greičiau, nei spėsi ištarti \"Kur MacLeod?\""

msgid "vo_sm_char02_m03_stg42_01"
msgstr "MacLeod: Atgal prie vairo, ką? Parodyk jiems, ką sugebi!"

msgid "vo_sm_char02_m03_stg42_02"
msgstr "MacLeod: Pabudome ir kelkimės, metas antram raundui! Tu gali."

msgid "vo_sm_char02_m03_stg42_03"
msgstr "MacLeod: Mes čia tankų nepradavinėjame. Atsargiai su šituo."

msgid "vo_sm_char02_m03_stg42_04"
msgstr "MacLeod: Ha! Tavęs niekas negali sustabdyti, ar ne? Matau, tau dar neužteko!"

msgid "vo_sm_char02_m04_stg01_01"
msgstr "MacLeod: Tiger medžiotojai, į susitikimo tašką."

msgid "vo_sm_char02_m04_stg01_01_01"
msgstr "MacLeod: Brooks, jei galiu tave taip vadinti operacijos metu, ar tu ten?"

msgid "vo_sm_char02_m04_stg01_03"
msgstr "MacLeod: Kam toks formalumas, Brooks? Mes juk žinom, kad ten tu."

msgid "vo_sm_char02_m04_stg01_03_01"
msgstr "MacLeod: Dabar pasakyk man ar mūsiškiai žino, kad mes mieste?"

msgid "vo_sm_char02_m04_stg01_03_02"
msgstr "MacLeod: Jie juk į mus nešaudys, ar ne?"

msgid "vo_sm_char02_m04_stg01_05"
msgstr "MacLeod: Kodėl tavo atsakymas man neleidžia jaustis užtikrintai?"

msgid "vo_sm_char02_m04_stg02_01"
msgstr "MacLeod: Ko mes ieškome, Brooks? Juk ne kokio mažyčio taikinuko?"

msgid "vo_sm_char02_m04_stg03_01"
msgstr "MacLeod: Kažkas sugrįžta. Matau mūsiškių tanką. Ar mes praleidome kovą?"

msgid "vo_sm_char02_m04_stg03_03"
msgstr "MacLeod: Ah, žvalgyba..."

msgid "vo_sm_char02_m04_stg04_01"
msgstr "MacLeod: Po velnių! Prie mūsų dar vienas."

msgid "vo_sm_char02_m04_stg04_01_01"
msgstr "MacLeod: Tai... ah, Brooks, tai vėl tas monstras. King Tiger."

msgid "vo_sm_char02_m04_stg04_01_02"
msgstr "MacLeod: Laimės kūdiki, žinai ką daryti. Pasiruošęs?"

msgid "vo_sm_char02_m04_stg06_01"
msgstr "MacLeod: O ką siūlai? Pabėgti? Palikti jį čia?"

msgid "vo_sm_char02_m04_stg08_02"
msgstr "MacLeod: Geras bandymas, bet panašu, kad..."

msgid "vo_sm_char02_m04_stg09_01"
msgstr "MacLeod: Suteikime seniui Brooks progą dar kartą nusišypsoti, Laimės kūdiki."

msgid "vo_sm_char02_m04_stg09_01_01"
msgstr "MacLeod: Taikykis į priekinį arba galinį vikšrų ratą. Lengviausias būdas sustabdyti priešininką."

msgid "vo_sm_char02_m04_stg09_01_02"
msgstr "MacLeod: Taikykis į priekinį arba galinį vikšrų ratą. Lengviausias būdas sustabdyti priešininką."

msgid "vo_sm_char02_m04_stg10_01"
msgstr "MacLeod: Nenustok šaudyti. Anksčiau ar vėliau tie vikšrai nukris."

msgid "vo_sm_char02_m04_stg10_01_01"
msgstr "MacLeod: Ir tada iš karietos liks tik moliūgas."

msgid "vo_sm_char02_m04_stg10_01_02"
msgstr "MacLeod: Nenustok šaudyti. Anksčiau ar vėliau tie vikšrai nukris."

msgid "vo_sm_char02_m04_stg11_01"
msgstr "MacLeod: Va taip! Geras šūvis. Žuvėdra, tavo eilė."

msgid "vo_sm_char02_m04_stg13_01"
msgstr "MacLeod: Skambi kaip mano buvusi biologijos mokytoja, ponia McFuddlebrains."

msgid "vo_sm_char02_m04_stg13_02"
msgstr "MacLeod: Laimės kūdiki, pajudėkime, kol dar nepasirodė dar vienas karališkasis kačiukas."

msgid "vo_sm_char02_m04_stg13_02_01"
msgstr "MacLeod: Brooks, duok užuominą, ko mes čia ieškome?"

msgid "vo_sm_char02_m04_stg13_02_02"
msgstr "MacLeod: Kažko didesnio nei King Tiger? Kokio imperatoriaus?"

msgid "vo_sm_char02_m04_stg14_01"
msgstr "MacLeod: Priekyje matau mūsiškių tankus. Kaip įprasta, jie buriasi ir bando stumtis pirmyn."

msgid "vo_sm_char02_m04_stg14_01_01"
msgstr "MacLeod: Jie taip neįveiks Jagdtiger. Laimės kūdiki, ar mes skaičiuojame Jagdtiger tankus?"

msgid "vo_sm_char02_m04_stg14_03"
msgstr "MacLeod: Brooks, panašu, kad per daug laiko praleidai štabe."

msgid "vo_sm_char02_m04_stg14_03_01"
msgstr "MacLeod: Aš suprantu, tau reikia rašyti ataskaitas. Bet mūsiškiams reikia pagalbos."

msgid "vo_sm_char02_m04_stg15_02"
msgstr "MacLeod: Bennett?"

msgid "vo_sm_char02_m04_stg15_04"
msgstr "MacLeod: Daug geriau. Laimės kūdiki, tegul mūsų sparnuotasis draugas užsidirba kelis taškus!"

msgid "vo_sm_char02_m04_stg16_01"
msgstr "MacLeod: Sparčiai susidorokime su šitomis skardinėmis. Mums reikia kuo greičiau pasiekti Jagdtiger."

msgid "vo_sm_char02_m04_stg16_01_01"
msgstr "MacLeod: Jei pasitaikys koks stipresnis priešas, taikykis į jo varomuosius ratukus."

msgid "vo_sm_char02_m04_stg16_01_02"
msgstr "MacLeod: Tegul mūsų \"jūrų paukštis\" gauna į ką pašaudyti."

msgid "vo_sm_char02_m04_stg16_01_03"
msgstr "MacLeod: Taikykis į jo varomuosius ratukus. Tegul mūsų \"jūrų paukštis\" gauna į ką pašaudyti."

msgid "vo_sm_char02_m04_stg17_01"
msgstr "MacLeod: Kaip iš viso šitas prototipas vadinasi?"

msgid "vo_sm_char02_m04_stg17_01_01"
msgstr "MacLeod: Jis turi kokį kodą? Ar man pačiam reikės ką nors sugalvoti?"

msgid "vo_sm_char02_m04_stg17_03"
msgstr "MacLeod: Nuobodus pavadinimas. Aš pavadinsiu jį...Peliuku."

msgid "vo_sm_char02_m04_stg17_05"
msgstr "MacLeod: Jei būčiau vokiečių inžinierius, tai pavadinčiau jį taip vien dėl to, nes juokinga."

msgid "vo_sm_char02_m04_stg18_01"
msgstr "MacLeod: Kiek jūsų ten dar yra? Aš vėluoju į pasimatymą su Jagdtiger."

msgid "vo_sm_char02_m04_stg18_01_01"
msgstr "MacLeod: Laimės kūdiki, pasiskubinkime. Nedžentelmeniška leisti damai laukti."

msgid "vo_sm_char02_m04_stg19_01"
msgstr "MacLeod: Oho! Ir kas gi čia?"

msgid "vo_sm_char02_m04_stg19_01_01"
msgstr "MacLeod: Brooks! Kodėl neperspėjai, kad čia bus mūsiškių?"

msgid "vo_sm_char02_m04_stg19_01_02"
msgstr "MacLeod: Nesakyk man, kad žvalgyba ir vėl susimovė!"

msgid "vo_sm_char02_m04_stg19_03"
msgstr "MacLeod: Tai štai kaip atrodo mūsų žvalgyba."

msgid "vo_sm_char02_m04_stg19_03_01"
msgstr "MacLeod: Prisijunkite prie mūsų, neprotinga važiuoti iš miesto vieniems."

msgid "vo_sm_char02_m04_stg19_05"
msgstr "MacLeod: Dieve. Jūs tokie pat kalbūs, kaip ir vyrukai iš praeitos operacijos."

msgid "vo_sm_char02_m04_stg19_05_01"
msgstr "MacLeod: Gerai, važiuojam, mes vėluojame į susitikimą."

msgid "vo_sm_char02_m04_stg20_01"
msgstr "MacLeod: Žuvėdra!"

msgid "vo_sm_char02_m04_stg20_01_01"
msgstr "MacLeod: Norėjau pasakyti Audrapaukšti! Mes radome tau labai gerą taikinį. Šito lengvai nepraleisi."

msgid "vo_sm_char02_m04_stg20_01_02"
msgstr "MacLeod: Laimės kūdiki, taikykis į varomuosius ratus!"

msgid "vo_sm_char02_m04_stg20_01_03"
msgstr "MacLeod: Laimės kūdiki, taikykis į varomuosius ratus!"

msgid "vo_sm_char02_m04_stg23_01"
msgstr "MacLeod: Supratau. Mes tuoj turėsime taik...pala. Ką?!"

msgid "vo_sm_char02_m04_stg23_01_01"
msgstr "MacLeod: Ah...Brooks, tu k... Tai turėjo būti mūsų paslaptis!"

msgid "vo_sm_char02_m04_stg23_03"
msgstr "MacLeod: Taip, žinoma. Senatvė, aš suprantu."

msgid "vo_sm_char02_m04_stg24_01"
msgstr "MacLeod: Gerai, mes jau netoli. Jūsų angelas sargas tuoj išgelbės visus nuo prakeiksmo."

msgid "vo_sm_char02_m04_stg24_03"
msgstr "MacLeod: O kas dabar?"

msgid "vo_sm_char02_m04_stg24_05"
msgstr "MacLeod: Brooks, tu juk neturi užsislėpęs kokio nors kozirio, ko nors bombonešio dydžio, juk neturi?"

msgid "vo_sm_char02_m04_stg24_07"
msgstr "MacLeod: Mes išlauksime. Ar ne, Laimės kūdiki?"

msgid "vo_sm_char02_m04_stg25_01"
msgstr "MacLeod: Brooks? Gal norėtum pasiskubinti?"

msgid "vo_sm_char02_m04_stg25_01_01"
msgstr "MacLeod: Mes sulaukėme kompanijos. Daug kompanijos. Žvalgyba, darom kažką, nestovėkite ten tiesiog!"

msgid "vo_sm_char02_m04_stg26_01"
msgstr "MacLeod: Brooks, Be mūsų ir šitų vyrų, ar dar kas nors puola miestą?"

msgid "vo_sm_char02_m04_stg26_01_01"
msgstr "MacLeod: Aš galvojau, kad mes čia vykdome slaptą operaciją, o ne užimame visą miestą."

msgid "vo_sm_char02_m04_stg26_03"
msgstr "MacLeod: Ir aš vis dar noriu. Tiesiog tikėjausi, kad užimdami miestą sulauksime daugiau pagalbos."

msgid "vo_sm_char02_m04_stg26_05"
msgstr "MacLeod: Gerai tada. Sėkmė mūsų pusėje! Ar ne taip, Laimės kūdiki?"

msgid "vo_sm_char02_m04_stg27_02"
msgstr "MacLeod: Jau pats laikas!"

msgid "vo_sm_char02_m04_stg28_01"
msgstr "MacLeod: Kodėl visada darbą užbaigti turime mes patys?"

msgid "vo_sm_char02_m04_stg28_03"
msgstr "MacLeod: Ha! Panašu, kad mes abu senstam, Brooks!"

msgid "vo_sm_char02_m04_stg28_03_01"
msgstr "MacLeod: Gal norėtum sužaisti Bingo mūsų pensininkų klube?"

msgid "vo_sm_char02_m04_stg29_01"
msgstr "MacLeod: Laimės kūdiki, žinai ką daryti. Sunaikink vikšrus."

msgid "vo_sm_char02_m04_stg29_01_01"
msgstr "MacLeod: Mums reikia supažindinti Jagdtiger ir Bennett. Aš manau, kad jie gerai sutars."

msgid "vo_sm_char02_m04_stg29_01_02"
msgstr "MacLeod: Laimės kūdiki, žinai ką daryti. Sunaikink vikšrus."

msgid "vo_sm_char02_m04_stg30_02"
msgstr "MacLeod: Va čia tai nusiteikimas! Bennett, tu jau turi tris."

msgid "vo_sm_char02_m04_stg30_02_01"
msgstr "MacLeod: Praleisk su mumis dar pusdienį šiame mieste ir gal mus pasivysi."

msgid "vo_sm_char02_m04_stg31_01"
msgstr "MacLeod: Nesakyk man, kad mes lygūs! Brooks, ar jis sumedžiojo tiek pat Tiger tankų, kiek mes?"

msgid "vo_sm_char02_m04_stg31_03"
msgstr "MacLeod: Man nepatinka, kai neduodi normalaus atsakymo."

msgid "vo_sm_char02_m04_stg32_01"
msgstr "MacLeod: Va čia tai nekoks vaizdelis. Panašu, kad mūsų Peliukas turi iltis."

msgid "vo_sm_char02_m04_stg32_01_01"
msgstr "MacLeod: Būk atsargus, Laimės kūdiki. Bennett, tu su mumis?"

msgid "vo_sm_char02_m04_stg33_01"
msgstr "MacLeod: Kas per nesąmonė, šitas nevykęs variklis neužsiveda!"

msgid "vo_sm_char02_m04_stg33_01_01"
msgstr "MacLeod: Laimės kūdiki, turėsi tęsti be manęs."

msgid "vo_sm_char02_m04_stg33_01_02"
msgstr "MacLeod: Aš pridengsiu tave kiek galėsiu iš čia ir komanduosiu Bennett smūgius."

msgid "vo_sm_char02_m04_stg33_01_03"
msgstr "MacLeod: Tas prakeiktas variklis!"

msgid "vo_sm_char02_m04_stg34_01"
msgstr "MacLeod: Aš matau jį. Po velnių, ta peršerta pelė. Kiek tonų ji sveria?"

msgid "vo_sm_char02_m04_stg34_01_01"
msgstr "MacLeod: Aj, nesvarbu. Kuo jis sunkesnis, tuo daugiau įtampos vikšrams."

msgid "vo_sm_char02_m04_stg34_01_02"
msgstr "MacLeod: Ar ne, Laimės kūdiki? Žinai kur taikytis."

msgid "vo_sm_char02_m04_stg36_01"
msgstr "MacLeod: Jis gerai padengtas iš visų pusių. Negalime pramušti."

msgid "vo_sm_char02_m04_stg36_01_01"
msgstr "MacLeod: Bet mes turime savo kozirį. Jo viršus tikrai nėra tvirtas."

msgid "vo_sm_char02_m04_stg36_01_02"
msgstr "MacLeod: Laimės kūdiki, taikykis į vikšrus."

msgid "vo_sm_char02_m04_stg36_01_03"
msgstr "MacLeod: Laimės kūdiki, taikykis į vikšrus."

msgid "vo_sm_char02_m04_stg37_01"
msgstr "MacLeod: Prigavom pelę! Audrapaukšti, užbaik tai ir galėsime keliauti namo."

msgid "vo_sm_char02_m04_stg38_01"
msgstr "MacLeod: Kas per...priešas nesunaikintas."

msgid "vo_sm_char02_m04_stg38_01_01"
msgstr "MacLeod: Laimės kūdiki, kol Bennett suka dar vieną ratą, susitvarkykime su nekviestais svečiais."

msgid "vo_sm_char02_m04_stg39_01"
msgstr "MacLeod: Atvyko jo draugai. Pirmiausia susidorokime su jais, kad netrukdytų kovoti."

msgid "vo_sm_char02_m04_stg40_01"
msgstr "MacLeod: Kur jis keliauja? Jis slepiasi? Laimės kūdiki, tu jį nubaidei."

msgid "vo_sm_char02_m04_stg40_01_01"
msgstr "MacLeod: Dar viena pasisveikinimo dovanėlė iš Bennett ir užbaigsim."

msgid "vo_sm_char02_m04_stg41_01"
msgstr "MacLeod: Puiku. Prigavom jį. Bennett, metas užbaigti šį jaudinantį, bet varginantį nuotykį."

msgid "vo_sm_char02_m04_stg42_01"
msgstr "MacLeod: Hmm...man tai jau pradeda nebepatikti."

msgid "vo_sm_char02_m04_stg42_01_01"
msgstr "MacLeod: Kas tau negerai? Tu jau turėtum būti liepsnose."

msgid "vo_sm_char02_m04_stg42_01_02"
msgstr "MacLeod: Negerai! Laimės kūdiki, man atrodo, kad mes jį suerzinome."

msgid "vo_sm_char02_m04_stg43_01"
msgstr "MacLeod: Laimės kūdiki, būk atsargus, prisistatė daugiau priešų."

msgid "vo_sm_char02_m04_stg44_01"
msgstr "MacLeod: Laimės kūdiki, taikykis į vikšrus. Nešvaistyk sviedinių, mes negalime pramušti jo šarvų."

msgid "vo_sm_char02_m04_stg45_01"
msgstr "MacLeod: Bennett, jis prigautas, kaip kokia žiurkė! Duok jam viską, ką turi!"

msgid "vo_sm_char02_m04_stg46_01"
msgstr "MacLeod: Taip! Atlikta!"

msgid "vo_sm_char02_m04_stg46_03"
msgstr "MacLeod: Ačiū už pagalbą, Bennett. Mes tau skolingi!"

msgid "vo_sm_char02_m04_stg47_02"
msgstr "MacLeod: Pfff, kokie dar medaliai. Aš jų jau turiu."

msgid "vo_sm_char02_m04_stg47_04"
msgstr "MacLeod: Bingo! Ką manai apie bingo? Laimės kūdiki, prisijungsi?"

msgid "vo_sm_char02_m04_stg53_01"
msgstr "MacLeod: Mes jį sustabdėme, Bennett. Gali smogti."

msgid "vo_sm_char02_m04_stg54_01"
msgstr "MacLeod: Audrapaukšti, taikinys liko be vikšrų. Dabar jis tavo."

msgid "vo_sm_char02_m04_stg55_01"
msgstr "MacLeod: Vikšrai sunaikinti. Oro pajėgų eilė šokti."

msgid "vo_sm_char02_m04_stg56_01"
msgstr "MacLeod: Taikinys sustabdytas, Bennett."

msgid "vo_sm_char02_m05_stg59_02"
msgstr "MacLeod: Vienas kitas juokelis yra tarsi tepalai varikliui! Leidžia gerai veikti ir nesugesti."

msgid "vo_sm_char02_m05_stg60_02"
msgstr "MacLeod: Tai mano pasisakymai nesvarbūs? Sužalojai mano širdį, drauge!"

msgid "vo_sm_char03_m05_stg01_02"
msgstr "Connolly: Velnias! Praradome vadą! Vyrai, dabar viskas mūsų rankose."

msgid "vo_sm_char03_m05_stg01_02_01"
msgstr "Connolly: Visi, pasisaugokite – aplink mus pilna minų."

msgid "vo_sm_char03_m05_stg03_01"
msgstr "Connolly: Prakeikimas! Bunkeriai sunaikino išminavimo tanką!"

msgid "vo_sm_char03_m05_stg03_03"
msgstr "Connolly: Nu rupūžė! Minos! Nekenčiu minų!"

msgid "vo_sm_char03_m05_stg04_01"
msgstr "Connolly: Mums reikia sunaikinti tuos nelemtus bunkerius."

msgid "vo_sm_char03_m05_stg04_01_01"
msgstr "Connolly: Su tankais mes vos ką jiems galim padaryti, bet nėra kito pasirinkimo."

msgid "vo_sm_char03_m05_stg04_01_02"
msgstr "Connolly: Gal mums pasiseks, jei vienas šūvis prasprūs pro tarpą ir viską sugriaus!"

msgid "vo_sm_char03_m05_stg04_04"
msgstr "Connolly: Toliau šaudykit į tuos bunkerius, mes privalome juos sunaikinti. Tai vienintelė mūsų viltis."

msgid "vo_sm_char03_m05_stg08_01"
msgstr "Connolly: Bunkeriai sunaikinti. Išminavimo tankas gali paruošti mums kelią."

msgid "vo_sm_char03_m05_stg09_01"
msgstr "Connolly: Kelias atviras... pagaliau! Važiuojam pirmyn!"

msgid "vo_sm_char03_m05_stg11_01"
msgstr "Connolly: Pastebėti priešų tankai. Pasiruoškite kovai."

msgid "vo_sm_char03_m05_stg12_01"
msgstr "Connolly: Velnias, reikia kuo greičiau sunaikinti tą bunkerį. O priešlėktuvinius pabūklus pasiekti turime dabar."

msgid "vo_sm_char03_m05_stg13_01"
msgstr "Connolly: Ha ha! Panašu, jiems jau trūko kantrybė!"

msgid "vo_sm_char03_m05_stg13_01_01"
msgstr "Connolly: Jis sugadino ir apleido savo priešlėktuvinę techniką vos išgirdę mūsų tankus."

msgid "vo_sm_char03_m05_stg18_01"
msgstr "Connolly: Kitas bunkeris neatrodo lengvai sunaikinamas."

msgid "vo_sm_char03_m05_stg18_01_01"
msgstr "Connolly: Pažymėk jį signaliniais dūmais ir tegu karinis laivas su juo susitvarko."

msgid "vo_sm_char03_m05_stg19_01"
msgstr "Connolly: Kitas bunkeris gerai saugomas. Mums reikia smogti iš abiejų pusių, ir iš visų jėgų."

msgid "vo_sm_char03_m05_stg19_01_01"
msgstr "Connolly: Padėk prancūzams prasiveržti, o mes su kapitonu Murphy prilaikysime juos čia."

msgid "vo_sm_char03_m05_stg20_01"
msgstr "Connolly: O dabar kartu su Kapitonu Dubois galime duoti pakankamai galios ir sunaikinti tą bunkerį ant kalno."

msgid "vo_sm_char03_m05_stg22_01"
msgstr "Connolly: Kitas mūsų taikinys yra tas didelis pakrantės pabūklas."

msgid "vo_sm_char03_m05_stg22_01_01"
msgstr "Connolly: Jei jį sunaikiname, karinis laivas galės priplaukti arčiau ir nepagailėti priešams artilerijos sviedinių."

msgid "vo_sm_char03_m05_stg25_01"
msgstr "Connolly: Tik pažiūrėkit! Karališkosios oro pajėgos atskrenda su trenksmu."

msgid "vo_sm_char03_m05_stg25_01_01"
msgstr "Connolly: Neblogas vaizdelis! Tikrai gražiai skrenda!"

msgid "vo_sm_char03_m05_stg32_01"
msgstr "Connolly: Nagi, vyrai, susirenkam. Priešas neleis mums daugiau pajudėti pirmyn, bet mes irgi neatsitrauksim."

msgid "vo_sm_char03_m05_stg33_01"
msgstr "Connolly: Va taip va! Mes valdom situaciją."

msgid "vo_sm_char03_m05_stg35_01"
msgstr "Connolly: Pažymėk taikinius laivui su dūmais."

msgid "vo_sm_char03_m05_stg35_02"
msgstr "Connolly: Nepamiršk užmesti dūmų."

msgid "vo_sm_char03_m05_stg35_03"
msgstr "Connolly: Panaudok signalinius dūmus. Pilotas galės perduoti koordinates."

msgid "vo_sm_char03_m05_stg35_04"
msgstr "Connolly: Tai tvirtas taikinys. Pažymėk jį dūmais."

msgid "vo_sm_char03_m05_stg36_01"
msgstr "Connolly: Sherman, laikas pajudėti! Kova mūsų nelauks."

msgid "vo_sm_char03_m05_stg36_02"
msgstr "Connolly: Sherman, kelkis!"

msgid "vo_sm_char03_m05_stg36_03"
msgstr "Connolly: Kodėl sustojai, Sherman? Iškilo kokia nors problema?"

msgid "vo_sm_char03_m05_stg36_04"
msgstr "Connolly: Nagi, Sherman, negaišk laiko. Fronto linija priekyje!"

msgid "vo_sm_char03_m05_stg36_05"
msgstr "Connolly: Sherman, laikas ne mūsų pusėje! Važiuojam!"

msgid "vo_sm_char03_m05_stg37_02"
msgstr "Connolly: Norėčiau arbatos, bet tiks ir kava."

msgid "vo_sm_char03_m05_stg38_02"
msgstr "Connolly: Kapitone, Murphy, rekomenduočiau palaikyti šią poziciją. Taip saugiau."

msgid "vo_sm_char03_m05_stg40_01"
msgstr "Connolly: Džentelmenai, neskubam. Artinasi nauja priešų grupuotė."

msgid "vo_sm_char03_m05_stg45_01"
msgstr "Connolly: Smagu vėl tave matyti kovoje! Tik būk atsargus."

msgid "vo_sm_char03_m05_stg45_02"
msgstr "Connolly: Pakilę iš pelenų ir stipresni nei anksčiau. Dabar jau nieko nelaukiam!"

msgid "vo_sm_char03_m05_stg46_01"
msgstr "Connolly: Prakeikimas! Mano tankui galas. Važiuokit be manęs."

msgid "vo_sm_char03_m05_stg46_02"
msgstr "Connolly: Panašu, kad čia baigiasi mano kelionė. Bet padarėm tikrai nemažai."

msgid "vo_sm_char03_m05_stg46_03"
msgstr "Connolly: Mano tankui galas, bet mums ne. Jau greitai galėsime grįžti į kovą."

msgid "vo_sm_char04_m05_stg03_02"
msgstr "Jie gaudo mus po vieną! Keliaukit link uolų!"

msgid "vo_sm_char04_m05_stg03_02_01"
msgstr "Stovėti atviroje vietoje yra savižudybė, mes lyg tupinčios antys."

msgid "vo_sm_char04_m05_stg03_02_02"
msgstr "Gal už uolų pavyks pasislėpti."

msgid "vo_sm_char04_m05_stg16_02"
msgstr "Murphy: Čia kapitonas Murphy. Ką tik išsilaipinome, bet bunkeriai neleidžia mums pajudėti."

msgid "vo_sm_char04_m05_stg16_02_01"
msgstr "Murphy: Mums reikia pagalbos, patys negalim pajudėti!"

msgid "vo_sm_char04_m05_stg17_01"
msgstr "Murphy: Bunkeriui galas! Kelias atviras. Galim pajudėti!"

msgid "vo_sm_char04_m05_stg17_01_01"
msgstr "Murphy: Nagi, pažiūrėkit! Mūsiškiai mala priešus į miltus! Metas prisijungti ir mums!"

msgid "vo_sm_char04_m05_stg19_02"
msgstr "Murphy: Geras planas. Parodykim jiems, ką galime!"

msgid "vo_sm_char04_m05_stg20_02"
msgstr "Murphy: Gerai, važiuojam ir smogiam galingai!"

msgid "vo_sm_char04_m05_stg22_02"
msgstr "Murphy: Ho ho! Su tokia galia mūsų pusėje galime juos triuškinti nesustodami."

msgid "vo_sm_char04_m05_stg23_01"
msgstr "Murphy: Panašu, kad priešlėktuvinis ginklas nutilo."

msgid "vo_sm_char04_m05_stg23_01_01"
msgstr "Murphy: Panašu, kad tie šauliai vos pamatę mus skuodžia greičiau, nei išsigandę zuikučiai."

msgid "vo_sm_char04_m05_stg23_01_02"
msgstr "Murphy: Taip tikriausiai yra dėl mūsų užburiančio žavesio, ar ne?"

msgid "vo_sm_char04_m05_stg28_02"
msgstr "Murphy: Taip! Mums pavyko!"

msgid "vo_sm_char04_m05_stg28_02_01"
msgstr "Murphy: Bent akimirkai pasilsėkim, o tada galėsim važiuoti ir jų nepasigailėti."

msgid "vo_sm_char04_m05_stg30_02"
msgstr "Murphy: Užimkite pozicijas. Nepamirškite, kad mūsų pusėje yra ir karinis laivas."

msgid "vo_sm_char04_m05_stg33_02"
msgstr "Murphy: Tai buvo sunki kova. Bet mums pavyko! Tad lekiam, kol dar galim!"

msgid "vo_sm_char04_m05_stg35_05"
msgstr "Murphy: Kur mūsų signaliniai dūmai? Mano pusbrolis laive, o jam patinka šaudyti!"

msgid "vo_sm_char04_m05_stg35_06"
msgstr "Murphy: Seni, kaip norėčiau dabar turėti signalinių dūmų. Visada norėjau iškviesti didesnius ginklus."

msgid "vo_sm_char04_m05_stg35_07"
msgstr "Murphy: Pažymėk juos dūmais ir leisk laivui su jais susidoroti."

msgid "vo_sm_char04_m05_stg36_06"
msgstr "Murphy: Sherman, ko lauki? Mestas paspausti pedalą!"

msgid "vo_sm_char04_m05_stg36_07"
msgstr "Murphy: Sherman, mes neturime visos dienos! Važiuojam dabar!"

msgid "vo_sm_char04_m05_stg36_08"
msgstr "Murphy: Sherman, mums reikia važiuot pirmyn!"

msgid "vo_sm_char04_m05_stg36_09"
msgstr "Murphy: Neturim laiko stovėti vietoj, Sherman. Judam!"

msgid "vo_sm_char04_m05_stg37_01"
msgstr "Murphy: Dabar man nepakenktų puodelis kavos."

msgid "vo_sm_char04_m05_stg38_01"
msgstr "Murphy: Kitą kartą norėčiau skirti viename tų bombonešių. Man patinka dangus."

msgid "vo_sm_char04_m05_stg39_01"
msgstr "Murphy: Nagi, Dubois, manai tavo tankas greitesnis už mano?"

msgid "vo_sm_char04_m05_stg40_02"
msgstr "Murphy: Puolam! Už geriausius vynuogynus pasaulyje!"

msgid "vo_sm_char04_m05_stg40_04"
msgstr "Murphy: Pala, ką aš sakiau?"

msgid "vo_sm_char04_m05_stg41_01"
msgstr "Murphy: Dubois, gal žinai kokios prancūziškos muzikos, kuri pakeltų nuotaiką?"

msgid "vo_sm_char04_m05_stg41_03"
msgstr "Murphy: Rimtai? Niekada nežinojau, ką reiškia tie žodžiai."

msgid "vo_sm_char04_m05_stg42_01"
msgstr "Murphy: Kaip jūs Paryžiuje vadinat ketvirtį svaro sūrio?"

msgid "vo_sm_char04_m05_stg43_01"
msgstr "Murphy: Dubois, ar tiesa, kad prancūzų tankai vietoje svirčių turi bagetes?"

msgid "vo_sm_char04_m05_stg43_03"
msgstr "Murphy: Tiek pat rimtai, kiek tu, bet su šypsena."

msgid "vo_sm_char04_m05_stg44_02"
msgstr "Murphy: Ką tai turėtų reikšti, Dubois?"

msgid "vo_sm_char04_m05_stg45_03"
msgstr "Murphy: Vėl į kovą? Tuomet nesustojam, mes tavimi tikime."

msgid "vo_sm_char04_m05_stg45_04"
msgstr "Murphy: Sugrįžai? Labai gerai! Nepasigailėk jų."

msgid "vo_sm_char04_m05_stg46_04"
msgstr "Murphy: Tankui galas! Panašu, kad nieko nebegalim padaryti."

msgid "vo_sm_char04_m05_stg46_05"
msgstr "Murphy: Na, taip jau yra. Mano tankas nebeveikia, bet aš dar sugrįšiu!"

msgid "vo_sm_char04_m05_stg46_06"
msgstr "Murphy: Mūsų tankas sugadintas. Man viskas gerai, nesijaudink. Aš sugrįšiu su nauju!"

msgid "vo_sm_char04_m06_outro_02"
msgstr "Murphy: Kas? Penkių nutrūktgalvių drąsa?"

msgid "vo_sm_char04_m06_outro_11"
msgstr "Murphy: Daugiau niekada."

msgid "vo_sm_char04_m06_stg02_01"
msgstr "Vairuotojas, kapt. Murphy: Pala, laikyk arklius! Priekyje minų laukas!"

msgid "vo_sm_char04_m06_stg02_02"
msgstr "Murphy: Ei, Keller, tau teko tarnauti kažkur čia – turi kokių idėjų?"

msgid "vo_sm_char04_m06_stg02_04"
msgstr "Murphy: Tuomet keliaujam į miestą! Laikas žemėlapiams, riestainiams ir šniceliams"

msgid "vo_sm_char04_m06_stg06_06"
msgstr "Murphy: Nagi, profesoriau, parodyk, ką gali su tuo radiju."

msgid "vo_sm_char04_m06_stg06_12"
msgstr "Murphy: Kaip gaila, kad Keller nebuvo prieš šešis mėnesius..."

msgid "vo_sm_char04_m06_stg06_14"
msgstr "Murphy: Velnias, čia tikrai tyli misija."

msgid "vo_sm_char04_m06_stg06_14_01"
msgstr "Murphy: Galvojau, kad kalbėjote metaforiškai."

msgid "vo_sm_char04_m06_stg07_02"
msgstr "Murphy: Ir nematyti jokių patrulių! Sėkmė šiandien mūsų pusėje."

msgid "vo_sm_char04_m06_stg08_08"
msgstr "Murphy: O vyruti, mūsų laukia tikra velykinių kiaušinių medžioklė!"

msgid "vo_sm_char04_m06_stg09_03"
msgstr "Murphy: Taip, taip, kapitone, tik luktelk. Velnias, Dubois, paskolink pieštuką. Pamečiau savo."

msgid "vo_sm_char04_m06_stg09_05"
msgstr "Murphy: Ah taip. Keller, gal turi... bleistiftą?"

msgid "vo_sm_char04_m06_stg09_08"
msgstr "Murphy: Geras! Ačiū, Keller."

msgid "vo_sm_char04_m06_stg10_02"
msgstr "Murphy: Oho! Dar viena dėlionės dalis! Taip smagu gauti iš tavęs dovanų, Dubois!"

msgid "vo_sm_char04_m06_stg11_02"
msgstr "Murphy: Tau aš Jack Murphy, monsieur Delacroix! Kada tu išmoksi mano vardą?"

msgid "vo_sm_char04_m06_stg12_03"
msgstr "Murphy: Luktelk. Kur yra mano pieštukas..."

msgid "vo_sm_char04_m06_stg12_05"
msgstr "Murphy: Gerai, gerai, nupirksiu tau visą dėžę pieštukų, Dubois!"

msgid "vo_sm_char04_m06_stg12_05_01"
msgstr "Murphy: Gerai! Mes artėjame! Šis fragmentas mano mėgstamiausias!"

msgid "vo_sm_char04_m06_stg15_03"
msgstr "Murphy: O tu tikrai visur ieškojai?"

msgid "vo_sm_char04_m06_stg15_05"
msgstr "Murphy: Tu nežinai, gal jis kaip mano kojinės – visada ten, kur vėliausiai pasižiūri!"

msgid "vo_sm_char04_m06_stg16_02"
msgstr "Murphy: Sekundėlę... Viskas susideda į vieną. Seni, koks labirintas!"

msgid "vo_sm_char04_m06_stg16_02_01"
msgstr "Murphy: Sakyčiau net MINO-tauro labirintas! Haha. Pagaunat? Ne?"

msgid "vo_sm_char04_m06_stg16_02_02"
msgstr "Murphy: Bet šitas buvo toks geras!"

msgid "vo_sm_char04_m06_stg16_04"
msgstr "Murphy: Jau pavargai užtaisinėti sviedinius, Dubois?"

msgid "vo_sm_char04_m06_stg18_03"
msgstr "Murphy: Pažiūrėkim. Visi, tik palaukite."

msgid "vo_sm_char04_m06_stg19_02"
msgstr "Murphy: Ak, o aš jau tikėjausi rasti paslėpto vokiečių aukso."

msgid "vo_sm_char04_m06_stg19_02_01"
msgstr "Murphy: Sakyk, Keller, o jūs čia kažkur laikote aukso?"

msgid "vo_sm_char04_m06_stg19_04"
msgstr "Murphy: Aš irgi taip sakyčiau, jei čia slėpčiau auksą."

msgid "vo_sm_char04_m06_stg19_04_01"
msgstr "Murphy: Kapitone Smith, ar mums pradėti ieškoti žemėlapio?"

msgid "vo_sm_char04_m06_stg21_03"
msgstr "Murphy: Gerai čia prasmukome!"

msgid "vo_sm_char04_m06_stg21_04"
msgstr "Murphy: Ar matei? Mes ne-ma-tomi!"

msgid "vo_sm_char04_m06_stg23_04"
msgstr "Murphy: Ei, kapitone? Gal mums atsitraukti? Kol dar situacija nepablogėjo."

msgid "vo_sm_char04_m06_stg23_05"
msgstr "Murphy: Aš balsuoju už taktinį atsitraukimą. Kas su manimi?"

msgid "vo_sm_char04_m06_stg24_03"
msgstr "Murphy: Laikas susirasti naują slėptuvę, kol mūsų nesutiko vakarėlio šeimininkai!"

msgid "vo_sm_char04_m06_stg25_02"
msgstr "Murphy: Oho! Mūsų slaptoji tankų operacija veikia! Kas būtų pagalvoję?"

msgid "vo_sm_char04_m06_stg26_04"
msgstr "Murphy: Laikas pašokti su šiais Panzeriais!"

msgid "vo_sm_char04_m06_stg26_05"
msgstr "Murphy: Parodykime jiems, ką sugeba šis Chaffee!"

msgid "vo_sm_char04_m06_stg26_06"
msgstr "Murphy: Ponios ir ponai, štai ir mes!"

msgid "vo_sm_char04_m06_stg27_02"
msgstr "Murphy: Valio! Va taip mes varome!"

msgid "vo_sm_char04_m06_stg28_03"
msgstr "Murphy: Tiesiai į dešimtuką!"

msgid "vo_sm_char04_m06_stg29_02"
msgstr "Murphy: Po paraliais, tas taikinys buvo didžiulis!"

msgid "vo_sm_char04_m06_stg30_02"
msgstr "Murphy: Kapitone, gal pirmiau turėtų apsidairyti Dubois?"

msgid "vo_sm_char04_m06_stg31_07"
msgstr "Murphy: Čia labai šalta, o aš pamiršau savo švarką."

msgid "vo_sm_char04_m06_stg35_02"
msgstr "Murphy: Gal jau atėjo laikas leisti profesoriui įsijungti savo magišką radiją?"

msgid "vo_sm_char04_m06_stg42_02"
msgstr "Murphy: Ei, kapitone, čia vaizdas gal ir neblogas, bet ar nereikia kuo greičiau surinkti tą žemėlapį?"

msgid "vo_sm_char04_m06_stg43_03"
msgstr "Murphy: Pabudome ir kelkimės, priešai nelauks!"

msgid "vo_sm_char04_m06_stg44_02"
msgstr "Murphy: Panašu, kad judėsime garsiuoju būdu!"

msgid "vo_sm_char04_m06_stg45_02"
msgstr "Murphy: Galiu lažintis, kad yra geresnis kelias!"

msgid "vo_sm_char04_m06_stg46_02"
msgstr "Murphy: Ei, Keller, parodyk jiems savo triuką!"

msgid "vo_sm_char04_m06_stg47_02"
msgstr "Murphy: O gal tiesiog palaukime kol jiems atsibos ir jie dings?"

msgid "vo_sm_char04_m06_stg48_02"
msgstr "Murphy: Ei vyrai, gal pabandome kitą kartą nesprogti?"

msgid "vo_sm_char04_m06_stg53_02"
msgstr "Murphy: Kažkas bando prasmukti! Blogas berniukas!"

msgid "vo_sm_char04_m06_stg54_02"
msgstr "Murphy: Laikrodis tiksi vis greičiau, mums reikia pasiskubinti."

msgid "vo_sm_char04_m06_stg55_01"
msgstr "Murphy: Gerai! Čia viskas aišku! O man pasakojo, kad bus sunku."

msgid "vo_sm_char04_m06_stg55_04"
msgstr "Murphy: Nesijaudinkite, bičiuliai, senasis Murphy persijungia į bebaimės eigos režimą."

msgid "vo_sm_char04_m06_stg56_02"
msgstr "Murphy: Eik tu... Dubois, tu per daug jaudinies! Kas blogiausia gali atsitikti?"

msgid "vo_sm_char04_m06_stg56_04"
msgstr "Murphy: Nieko nebus, profesoriau! Arba gazuojam, arba mirštam!"

msgid "vo_sm_char04_m06_stg56_06"
msgstr "Murphy: Nurimk, mon ami! Žemėlapis yra mano galvoje."

msgid "vo_sm_char04_m06_stg57_02"
msgstr "Murphy: Tiger? Tik tiek? O kur visi tie stebuklingi ginklai, apie kuriuos taip pasakoja?"

msgid "vo_sm_char04_m06_stg58_02"
msgstr "Murphy: Manevruoti? MANEVRUOTI?"

msgid "vo_sm_char04_m06_stg58_02_01"
msgstr "Murphy: Šiame siaurame koridoriuje, kuris lygiai vieno su puse Chaffee pločio?"

msgid "vo_sm_char04_m06_stg58_02_02"
msgstr "Murphy: Kur tu manai, kad aš pamanevruosiu?"

msgid "vo_sm_char04_m06_stg59_03"
msgstr "Murphy: Nagi, Tiger! O tu neturi ko daugiau vaikytis?"

msgid "vo_sm_char04_m06_stg60_03"
msgstr "Murphy: Man nepatinka, kad to Tiger pabūklas nukreiptas į mus!"

msgid "vo_sm_char04_m06_stg61_02"
msgstr "Murphy: Ar pajautei tą vėjo gūsį? Nes aš pajaučiau!"

msgid "vo_sm_char04_m06_stg62_01"
msgstr "Murphy: Tik įbrėžimas! Vos pajaučiau!"

msgid "vo_sm_char04_m06_stg62_02"
msgstr "Murphy: Ei! Aš ką tik nublizginau šį tanką!"

msgid "vo_sm_char04_m06_stg63_03"
msgstr "Murphy: Kowalski, taikykis į vikšrus!"

msgid "vo_sm_char04_m06_stg64_02"
msgstr "Murphy: Ne toks stiprus be savo vikšrų, ką?"

msgid "vo_sm_char04_m06_stg68_01"
msgstr "Murphy: Oj, tos minos nebuvo žemėlapyje!"

msgid "vo_sm_char04_m06_stg68_02"
msgstr "Murphy: Minos! Ak, taip. Tu jau tą žinojai."

msgid "vo_sm_char04_m06_stg69_01"
msgstr "Murphy: Dievulėliau! Iš kur išdygo šitas mažius?!"

msgid "vo_sm_char04_m06_stg70_02"
msgstr "Murphy: Ko toks rimtas? Juk čia buvo bomba! Pagauni? Nes sprogo mina."

msgid "vo_sm_char04_m06_stg70_02_01"
msgstr "Murphy: Ak, nagi, vyrai!..."

msgid "vo_sm_char04_m06_stg71_02"
msgstr "Murphy: Veelnias... tie vyrai... juos taip gerai pažinojau!"

msgid "vo_sm_char04_m06_stg73_01"
msgstr "Murphy: Dubois, ar tiesa, kad prancūzų tankuose yra espresso mašinos?"

msgid "vo_sm_char04_m06_stg73_03"
msgstr "Murphy: Atsakei taip rimtai, kad beveik patikėjau. Bet tu juk juokavai?"

msgid "vo_sm_char04_m06_stg74_02"
msgstr "Murphy: Ne, aš su savo vyrais keliavome toliau į šiaurę."

msgid "vo_sm_char04_m06_stg74_02_01"
msgstr "Murphy: Bet aš būtinai aplankysiu po karo."

msgid "vo_sm_char04_m06_stg74_02_02"
msgstr "Murphy: Ir būtinai užlipsiu ant picos bokšto."

msgid "vo_sm_char04_m06_stg75_01"
msgstr "Murphy: Dubois, ar žinojai, kad tu kalbi per miegus?"

msgid "vo_sm_char04_m06_stg75_03"
msgstr "Murphy: Ką reiškia ''Kuur, kuur ma-ano dalis''?"

msgid "vo_sm_char04_m06_stg76_01"
msgstr "Murphy: Dubois, o tu nenori pamokyti manęs prancūzų?"

msgid "vo_sm_char04_m06_stg76_03"
msgstr "Murphy: Ką? Aš nesuprantu."

msgid "vo_sm_char04_m06_stg76_05"
msgstr "Murphy: Ką? Oho... Ar tu bandai atimti mano juokų karaliaus titulą?"

msgid "vo_sm_char04_m06_stg76_05_01"
msgstr "Murphy: Geras bandymas, bet tu žaidi su ugnimi, Dubois!"

msgid "vo_sm_char04_m06_stg77_01"
msgstr "Murphy: Kowalski, o tu šoki polką?"

msgid "vo_sm_char04_m06_stg77_03"
msgstr "Murphy: Tai pabandom! Surengiam vakarėlį, kuriame visi šoks polką! "

msgid "vo_sm_char04_m06_stg77_05"
msgstr "Murphy: Tai žinoma! Na... ne tai norėjau pasakyti. Tu gi žinai apie ką aš. Tikiuosi."

msgid "vo_sm_char04_m06_stg78_02"
msgstr "Murphy: Kokios problemos?"

msgid "vo_sm_char04_m06_stg78_04"
msgstr "Murphy: Aš tai vadinu ''taktiniu manevravimu.'' Visuomet privers priešą spėti!"

msgid "vo_sm_char04_m06_stg79_01"
msgstr "Murphy: Kowalski, jei mes būtume muzikinėje grupėje, kokį instrumentą grotum?"

msgid "vo_sm_char04_m06_stg79_03"
msgstr "Murphy: Ką... Aš būčiau pagrindinis gitaristas..."

msgid "vo_sm_char04_m06_stg80_01"
msgstr "Murphy: Keller, kaip manai, ar galėtum su šiuo radiju pagauti muzikos stotį?"

msgid "vo_sm_char04_m06_stg80_03"
msgstr "Murphy: Bent trumpam? Muzika padėtų moralei!"

msgid "vo_sm_char04_m06_stg80_05"
msgstr "Murphy: Aj, gerai. Tada gal geriau nekeičiame nustatymų."

msgid "vo_sm_char04_m06_stg81_01"
msgstr "Murphy: Praeitą naktį sapnavau, kad visi kartu žvejojome."

msgid "vo_sm_char04_m06_stg81_03"
msgstr "Murphy: Senoje valtyje."

msgid "vo_sm_char04_m06_stg81_05"
msgstr "Murphy: Visuomet giliai širdyje žinojau, kad esi optimistas."

msgid "vo_sm_char04_m06_stg81_05_01"
msgstr "Murphy: Visuomet ieškai ko nors gražaus."

msgid "vo_sm_char04_m06_stg82_01"
msgstr "Murphy: Kapitone, pasakyk gerą juokelį."

msgid "vo_sm_char04_m06_stg82_03"
msgstr "Murphy: Dar kas nors? Kowalski? Keller? Dubois, atleisk, tavęs neklausiu."

msgid "vo_sm_char04_m06_stg82_05"
msgstr "Murphy: Na, gali sakyti, jei labai nori."

msgid "vo_sm_char04_m06_stg82_07"
msgstr "Murphy: ... Štai kodėl."

msgid "vo_sm_char04_m06_stg83_02"
msgstr "Murphy: ''Bailiai iki mirties miršta daugybė kartų.''"

msgid "vo_sm_char04_m06_stg83_02_01"
msgstr "Murphy: ''Narsieji patiria mirtį tik vieną kartą,'' tiesa?"

msgid "vo_sm_char04_m06_stg83_04"
msgstr "Murphy: Ane? Man skambėjo prancūziškai."

msgid "vo_sm_char04_m06_stg84_01"
msgstr "Murphy: Kaip manote, ar kas pavadins gatvę mūsų vardais?"

msgid "vo_sm_char04_m06_stg84_03"
msgstr "Murphy: Tu teisus. Mums reikia įgulos pavadinimo!"

msgid "vo_sm_char04_m06_stg84_05"
msgstr "Murphy: Hmm... per ilgas pavadinimas. Man labiau PROBLEMŲSPRENDĖJAI."

msgid "vo_sm_char04_m06_stg85_01"
msgstr "Murphy: Ei, Kowalski, o tu kada nors nusišypsai?"

msgid "vo_sm_char04_m06_stg85_03"
msgstr "Murphy: Iššūkis priimtas! Aš atitirpinsiu tavo sustingusį veidą!"

msgid "vo_sm_char04_m06_stg85_05"
msgstr "Murphy: Gerai, klausyk: Tuk-tuk."

msgid "vo_sm_char04_m06_stg85_06"
msgstr "Murphy: Tu turi klausti ''Kas ten?''"

msgid "vo_sm_char04_m06_stg85_07"
msgstr "Murphy: Gerai, bus sunkiau, nei galvojau."

msgid "vo_sm_char04_m06_stg87_01"
msgstr "Murphy: Kas ten?!"

msgid "vo_sm_char04_m06_stg87_03"
msgstr "Murphy: Mano bato viduje. O! Tai pieštukas."

msgid "vo_sm_char04_m06_stg88_01"
msgstr "Murphy: Ei Keller, ar nugirdai ką įdomaus vokiškuose kanaluose?"

msgid "vo_sm_char04_m06_stg88_03"
msgstr "Murphy: Taip! Tai mes! Tankas fantomas! Didžiausias vokiečių košmaras!"

msgid "vo_sm_char04_m06_stg88_04"
msgstr "Murphy: Keller, tikriausiai niekada negalvojai, kad taip slapstysiesi amerikiečių tanke!"

msgid "vo_sm_char04_m06_stg88_06"
msgstr "Murphy: Bet ar ne dėl to gyvenimas smagesnis? Kaip šokoladų dėžutė!"

msgid "vo_sm_char04_m06_stg90_03"
msgstr "Murphy: Ak!!! Kowalski! Tau reikia paskaityti La Marsellaise žodžius!"

msgid "vo_sm_char04_m06_stg90_03_01"
msgstr "Murphy: Ten yra... įdomių dalykų... ir daug kraujo!"

msgid "vo_sm_char04_m06_stg91_02"
msgstr "Murphy: Taip!"

msgid "vo_sm_char04_m06_stg92_01"
msgstr "Murphy: Jei kas nors klaus, mes keliaujantis cirkas."

msgid "vo_sm_char04_m06_stg92_03"
msgstr "Murphy: Mums reikia kokio pasiteisinimo: dabar mes šnipai!"

msgid "vo_sm_char04_m06_stg93_01"
msgstr "Murphy: Gal po viso šito galėsiu gauti šnipo pieštuką?"

msgid "vo_sm_char04_m06_stg93_03"
msgstr "Murphy: Tu toks godus, Dubois!"

msgid "vo_sm_char05_m05_stg18_02"
msgstr "Dubois: Bonjour, monsieurs! Kalba kapitonas Dubois."

msgid "vo_sm_char05_m05_stg18_02_01"
msgstr "Dubois: Mes nusileidome H1, bet mus stabdo nesiliaujanti priešo ugnis."

msgid "vo_sm_char05_m05_stg18_02_02"
msgstr "Dubois: Mums skubiai reikia pagalbos!"

msgid "vo_sm_char05_m05_stg19_04"
msgstr "Dubois: Kelias laisvas. Pagaliau! En avant, keliaujam į kovą. Viva la France!"

msgid "vo_sm_char05_m05_stg21_01"
msgstr "Dubois: Merci mon ami! Mes vienu žingsniu arčiau savo tėvynės."

msgid "vo_sm_char05_m05_stg27_01"
msgstr "Dubois: Magnifique! Pakrantės pabūklai nutilo."

msgid "vo_sm_char05_m05_stg27_01_01"
msgstr "Dubois: Dabar karinis laivas gali prisiartinti arčiau ir suteikti reikalingos pagalbos."

msgid "vo_sm_char05_m05_stg27_01_02"
msgstr "Dubois: Pažiūrėkim fejerverkus!"

msgid "vo_sm_char05_m05_stg29_01"
msgstr "Dubois: Pasiruošęs kovai. Aš daugiau nepaliksiu Prancūzijos žemės. Plus jamais de retraite!"

msgid "vo_sm_char05_m05_stg33_03"
msgstr "Dubois: Visa tai tik tai pradžia. Karo pabaiga jau arti."

msgid "vo_sm_char05_m05_stg35_08"
msgstr "Dubois: Pažymėk taikinius dūmais, mes amis. Tegu karinis laivas išlaisvina Prancūziją!"

msgid "vo_sm_char05_m05_stg35_09"
msgstr "Dubois: Signaliniai dūmai tinkamoje vietoje atneša sėkmės mums ir ugnies lietų priešui!"

msgid "vo_sm_char05_m05_stg36_10"
msgstr "Dubois: Metas judėti, Sherman, vite-vite!"

msgid "vo_sm_char05_m05_stg36_11"
msgstr "Dubois: Sherman, mums reikia judėti, allons!"

msgid "vo_sm_char05_m05_stg36_12"
msgstr "Dubois: Sherman, paskubėk! Prancūzija laukia!"

msgid "vo_sm_char05_m05_stg39_02"
msgstr "Dubois: Kapitone Murphy, tai ne varžybos, mes bandome išgelbėti mano šalį."

msgid "vo_sm_char05_m05_stg39_02_01"
msgstr "Dubois: Ir šis klausimas... absurdiškas! Aš su sunkiuoju tanku, kaip galiu būti greitesnis?"

msgid "vo_sm_char05_m05_stg40_03"
msgstr "Dubois: Už Prancūziją!"

msgid "vo_sm_char05_m05_stg41_02"
msgstr "Dubois: Aš niūniuoju 'La Marseillaise.' Ji gana tinkama mūšiui. Jos žodžiai įkvepiantys ir aršūs."

msgid "vo_sm_char05_m05_stg42_02"
msgstr "Dubois: Burgeriai? Murphy, mes Prancūzijoje nevalgome burgerių."

msgid "vo_sm_char05_m05_stg42_02_01"
msgstr "Dubois: Mums labiau patinka klasikinės bagetės sumuštiniai su puikiu sūriu ir mėsa."

msgid "vo_sm_char05_m05_stg43_02"
msgstr "Dubois: Kapitone Murphy, kartais aš svarstau, kaip rimtai tu žiūri į šitą karą."

msgid "vo_sm_char05_m05_stg44_01"
msgstr "Dubois: Sur le risque disparu, sur l’espoir sans souvenir, j’écris ton nom..."

msgid "vo_sm_char05_m05_stg44_03"
msgstr "Dubois: Tai reiškia, kad jiems galas, Murphy."

msgid "vo_sm_char05_m05_stg45_05"
msgstr "Dubois: Sveikas sugrįžęs į kovą. Tavo užsispyrimas žavi."

msgid "vo_sm_char05_m05_stg46_07"
msgstr "Dubois: Mon dieu, mūsų tankui galas. Mes privalome atsitraukti."

msgid "vo_sm_char05_m05_stg46_08"
msgstr "Dubois: Šiam tankui jau viskas. Mes stengėmės kiek galėjome, mes amis."

msgid "vo_sm_char05_m05_stg46_08_01"
msgstr "Dubois: Bet aš toliau bandysiu išlaisvinti Prancūziją!"

msgid "vo_sm_char05_m05_stg46_09"
msgstr "Dubois: Tankas sunaikintas, bet mūsų dvasia ne. Aš dar sugrįšiu!"

msgid "vo_sm_char05_m06_outro_01"
msgstr "Dubois: Vis dėl to tai gali sustabdyti skerdynes."

msgid "vo_sm_char05_m06_outro_03"
msgstr "Dubois: Popieriaus lapas. Vienas paprastas popieriaus lapas gali tai sustabdyti."

msgid "vo_sm_char05_m06_outro_05"
msgstr "Dubois: Tuomet kas?"

msgid "vo_sm_char05_m06_outro_09"
msgstr "Dubois: Plus jamais."

msgid "vo_sm_char05_m06_stg04_02"
msgstr "Užtaisytojas kapitonas Dubois: Taip pone! "

msgid "vo_sm_char05_m06_stg04_03"
msgstr "Dubois: Tankas pastebėtas."

msgid "vo_sm_char05_m06_stg06_11"
msgstr "Dubois: Magnifique! Tai iš ties pavyko!"

msgid "vo_sm_char05_m06_stg08_02"
msgstr "Dubois: Taip pone!"

msgid "vo_sm_char05_m06_stg08_03"
msgstr "Dubois: Radau! Dabar mes galime pravažiuoti pro miestą... merde!"

msgid "vo_sm_char05_m06_stg08_05"
msgstr "Dubois: Visa fronto linija užminuota. Mes negalime pasiekti savo pajėgų."

msgid "vo_sm_char05_m06_stg09_01"
msgstr "Dubois: Radau!"

msgid "vo_sm_char05_m06_stg09_04"
msgstr "Dubois: Aš tau jau paskolinau pieštuką. Tu jį pametei."

msgid "vo_sm_char05_m06_stg09_07"
msgstr "Dubois: Ne. Jis pames ir tavo."

msgid "vo_sm_char05_m06_stg10_01"
msgstr "Dubois: Murphy, kai ką tau turiu. Pasiimk."

msgid "vo_sm_char05_m06_stg11_01"
msgstr "Dubois: Aukso puodas!"

msgid "vo_sm_char05_m06_stg11_03"
msgstr "Dubois: Tai yra... ak... mon Dieu, viskam pasibaigus aš iš ties pasiilgsiu tavo juokelių."

msgid "vo_sm_char05_m06_stg12_01"
msgstr "Dubois: Radau! Dar vienas fragmentas."

msgid "vo_sm_char05_m06_stg12_04"
msgstr "Dubois: Ką aš tau sakiau?"

msgid "vo_sm_char05_m06_stg13_01"
msgstr "Dubois: Čia nieko, mes amis."

msgid "vo_sm_char05_m06_stg14_02"
msgstr "Dubois: Non. Tai nėra mūsų ieškomas vado postas."

msgid "vo_sm_char05_m06_stg15_02"
msgstr "Dubois: Tuščia."

msgid "vo_sm_char05_m06_stg15_04"
msgstr "Dubois: Aš gana nuoseklus."

msgid "vo_sm_char05_m06_stg15_06"
msgstr "Dubois: Mon Dieu... Ar tu lygini įslaptintus karinius dokumentus su... ak... nesvarbu."

msgid "vo_sm_char05_m06_stg15_07"
msgstr "Dubois: Mon Dieu... Ar tu lygini įslaptintus karinius dokumentus su... ak... nesvarbu."

msgid "vo_sm_char05_m06_stg15_07_01"
msgstr "Dubois: Kapitone, čia pažymėta daugiau postų."

msgid "vo_sm_char05_m06_stg16_03"
msgstr "Dubois: Tiesiog prasmuk pro minų lauką, o tada aš pagaliau galėsiu ramiai pailsėti."

msgid "vo_sm_char05_m06_stg16_05"
msgstr "Dubois: Tas taip pat."

msgid "vo_sm_char05_m06_stg17_03"
msgstr "Dubois: Nusiramink, Kowalski. Jei Keller norėtų mus išduoti, jis būtų tą jau padaręs."

msgid "vo_sm_char05_m06_stg19_01"
msgstr "Dubois: Žiūrėk, atrodo kaip vado postas."

msgid "vo_sm_char05_m06_stg21_05"
msgstr "Dubois: Nedaug trūko, mes amis."

msgid "vo_sm_char05_m06_stg24_04"
msgstr "Dubois: Mes privalome kuo greičiau atsitraukti, mes amis. Jie patikrins atidžiau."

msgid "vo_sm_char05_m06_stg25_03"
msgstr "Dubois: Magnifique. Jie atsiliko. Mes galime tęsti misiją."

msgid "vo_sm_char05_m06_stg26_07"
msgstr "Dubois: En avant!"

msgid "vo_sm_char05_m06_stg27_03"
msgstr "Dubois: Taikinys sunaikintas. Ar sviediniai visada buvo tokie sunkūs?"

msgid "vo_sm_char05_m06_stg27_04"
msgstr "Dubois: Ar visi sveiki? Aš sveikas."

msgid "vo_sm_char05_m06_stg28_04"
msgstr "Dubois: Priešas sunaikintas!"

msgid "vo_sm_char05_m06_stg31_01"
msgstr "Dubois: Tikrai taip!"

msgid "vo_sm_char05_m06_stg31_02"
msgstr "Dubois: Keliauju apsižvalgyti."

msgid "vo_sm_char05_m06_stg31_03"
msgstr "Dubois: Aš pažiūrėsiu ir sugrįšiu."

msgid "vo_sm_char05_m06_stg31_04"
msgstr "Dubois: Judu link stebėjimo vietos."

msgid "vo_sm_char05_m06_stg31_05"
msgstr "Dubois: Metas pramankštinti kojas. Pažiūrėsiu, kas priekyje,"

msgid "vo_sm_char05_m06_stg31_06"
msgstr "Dubois: Murphy, nori pakeisti mane?"

msgid "vo_sm_char05_m06_stg31_08"
msgstr "Dubois: Turėjau susiprasti..."

msgid "vo_sm_char05_m06_stg31_09"
msgstr "Dubois: Kowalski, gal būt tau reikėtų..."

msgid "vo_sm_char05_m06_stg31_11"
msgstr "Dubois: Gerai, keliausiu pats."

msgid "vo_sm_char05_m06_stg31_12"
msgstr "Dubois: Gal kas norėtų lengvai pasportuoti?"

msgid "vo_sm_char05_m06_stg31_13"
msgstr "Dubois: Taip ir maniau. Keliauju."

msgid "vo_sm_char05_m06_stg32_01"
msgstr "Dubois: Aptiktas priešas!"

msgid "vo_sm_char05_m06_stg32_02"
msgstr "Dubois: Matau Panzer tankus."

msgid "vo_sm_char05_m06_stg32_03"
msgstr "Dubois: Dėmesio. Šarvuoti priešai."

msgid "vo_sm_char05_m06_stg32_04"
msgstr "Dubois: Aš matau juos."

msgid "vo_sm_char05_m06_stg32_05"
msgstr "Dubois: Matau priešą."

msgid "vo_sm_char05_m06_stg33_01"
msgstr "Dubois: Dar nieko, bet jie jau netoli."

msgid "vo_sm_char05_m06_stg33_02"
msgstr "Dubois: Nematau nieko, bet būkite budrūs."

msgid "vo_sm_char05_m06_stg33_03"
msgstr "Dubois: Nematau nieko judančio. Jie kažkur slepiasi."

msgid "vo_sm_char05_m06_stg33_04"
msgstr "Dubois: Šiuo metu tuščia... bet gal reiktų truputį palaukti?"

msgid "vo_sm_char05_m06_stg33_05"
msgstr "Dubois: Kol kas nieko, bet žiūrėkime toliau, gal kokie patruliai pasirodys."

msgid "vo_sm_char05_m06_stg42_03"
msgstr "Dubois: Messieurs, privalau priminti, kad misija nebus sėkminga be šio žemėlapio."

msgid "vo_sm_char05_m06_stg43_04"
msgstr "Dubois: Mon Dieu, apžiūrinėjant aplinką laikas nesustoja."

msgid "vo_sm_char05_m06_stg48_03"
msgstr "Dubois: Kiekviena sekundė svarbi. Dabar būkite ypač atidūs."

msgid "vo_sm_char05_m06_stg53_03"
msgstr "Dubois: Dėmesio! Priekyje priešų tankas!"

msgid "vo_sm_char05_m06_stg55_03"
msgstr "Dubois: Mon Dieu! Murphy, jau prisikalbėjai!"

msgid "vo_sm_char05_m06_stg55_05"
msgstr "Dubois: O kokiame režime buvai iki šiol?!"

msgid "vo_sm_char05_m06_stg56_01"
msgstr "Dubois: Murphy, dėl dievo meilės, būk atsargus. Mes minų lauke!"

msgid "vo_sm_char05_m06_stg56_05"
msgstr "Dubois: Murphy, tu bent žinai, kur mes važiuojam? Ne tu nupiešei paskutinę žemėlapio dalį!"

msgid "vo_sm_char05_m06_stg56_07"
msgstr "Dubois: Tai mane ir gąsdina!"

msgid "vo_sm_char05_m06_stg59_04"
msgstr "Dubois: Mon Dieu, Tiger tiesiai už mūsų!"

msgid "vo_sm_char05_m06_stg59_05"
msgstr "Dubois: Cette bête jau tuoj mus pagaus! Murphy, greičiau!"

msgid "vo_sm_char05_m06_stg68_03"
msgstr "Dubois: Murphy, aš žinau, kad tai padarei tyčia! Nėra laiko tavo juokams!"

msgid "vo_sm_char05_m06_stg72_05"
msgstr "Dubois: Yra protingesnių būdų įvykdyti misiją, nei šaudyti viską, kas juda."

msgid "vo_sm_char05_m06_stg73_02"
msgstr "Dubois: Taip. Bet į Chaffee ji netilptų."

msgid "vo_sm_char05_m06_stg74_01"
msgstr "Dubois: Murphy, ar kada buvai Paryžiuje?"

msgid "vo_sm_char05_m06_stg74_04"
msgstr "Dubois: Nekreipk į jį dėmesio. Tai jo būdas pasilinksminti."

msgid "vo_sm_char05_m06_stg75_02"
msgstr "Dubois: Ne, nežinojau."

msgid "vo_sm_char05_m06_stg75_04"
msgstr "Dubois: Tai reiškia, kad sapnavau Prancūziją."

msgid "vo_sm_char05_m06_stg76_02"
msgstr "Dubois: Très bien. Kartok paskui mane: '''Comment? Je ne comprends pas.''"

msgid "vo_sm_char05_m06_stg76_04"
msgstr "Dubois: Tu išvertei. Aš prašiau pakartoti."

msgid "vo_sm_char05_m06_stg82_04"
msgstr "Dubois: Kodėl ne?"

msgid "vo_sm_char05_m06_stg82_06"
msgstr "Dubois: Ar žinai, kodėl prancūzai valgo sraiges? Nes jiems nepatinka greitas maistas."

msgid "vo_sm_char05_m06_stg83_01"
msgstr "Dubois: Murphy, tu man primeni vieną veikėją iš Trijų muškietininkų."

msgid "vo_sm_char05_m06_stg83_03"
msgstr "Dubois: Murphy, tai Šekspyras."

msgid "vo_sm_char05_m06_stg86_01"
msgstr "Dubois: Keller, ar tiesa, kad vokiečiai turi daugiau, nei 300 duonos rūšių?"

msgid "vo_sm_char05_m06_stg86_03"
msgstr "Dubois: Neįtikėtina. Bet ar kada nors bandei prancūzišką bagetę?"

msgid "vo_sm_char05_m06_stg86_05"
msgstr "Dubois: Tobula metafora Prancūzijai!"

msgid "vo_sm_char05_m06_stg87_02"
msgstr "Dubois: Kur? Aš nematau nieko."

msgid "vo_sm_char05_m06_stg87_04"
msgstr "Dubois: Mon Dieu..."

msgid "vo_sm_char05_m06_stg90_02"
msgstr "Dubois: La Marseillaise."

msgid "vo_sm_char05_m06_stg91_01"
msgstr "Dubois: Čia į kairę, ar dešinę, Murphy?"

msgid "vo_sm_char05_m06_stg91_03"
msgstr "Dubois: Ak, Murphy..."

msgid "vo_sm_char05_m06_stg92_02"
msgstr "Dubois: Kas?"

msgid "vo_sm_char05_m06_stg93_02"
msgstr "Dubois: Tai tu irgi moki atsipalaiduoti?"

msgid "vo_sm_char06_m05_stg01_01"
msgstr "McCormick: Paklausykite, berniukai! Nekelkite galvos ir judėkite greitai!"

msgid "vo_sm_char06_m05_stg01_01_01"
msgstr "McCormick: Didžiausią dėmesį skirkite bunkeriams, mums reikia sukurti kelią savo pajėgoms."

msgid "vo_sm_char06_m05_stg01_01_02"
msgstr "McCormick: Mums reikia atlikti savo darbą, tegu jis nenueina perniek!"

