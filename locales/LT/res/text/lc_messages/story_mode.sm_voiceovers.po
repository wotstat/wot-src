msgid "vo_sm_char10_m05_stg21_02"
msgstr "Štabo pareigūnas: Pakrantės placdarmas Echo-5 užimtas. Tankai važiuoja toliau. Padėkite jiems."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Štabo pareigūnas: Nukreipkite oro pajėgas arčiau važiuojančių tankų."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Štabo pareigūnas: Inžinierių komandos, pravalykite kliūtis tolesniam važiavimui."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Štabo pareigūnas: Paplūdimys išvalytas. Išsiunčiame pagrindines pajėgas. Puikiai padirbėjote."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Štabo pareigūnas: Laikykite poziciją. Pastiprinimas atvyksta."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Štabo pareigūnas: Apsaugokite pakrantės placdarmą bet kokia kaina."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Štabo pareigūnas: Dar vienas tankas, dar viena proga. Šį kartą būkite atsargesni."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Štabo pareigūnas: Mes nebeturime daug resursų. Naudokite efektyviai, vade."

