msgid "armorPatching/alt/description"
msgstr "Gavę žalos nustosite atgauti patvarumo taškus.\n\nPatvarumo taškų atstatymo greitis ir maksimalus kiekis priklauso nuo maksimalių mašinos patvarumo taškų, pritaikius visus modifikatorius."

msgid "armorPatching/alt/info"
msgstr "Grupiniams įgūdžiams apskaičiuoti nustatomas vidutinis visų įgulos narių treniravimo lygis. Jis pradeda veikti pasiekus bent 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "armorPatching/currentLvlDescription"
msgstr "Panaudoję remonto komplektą per 5 s atstatysite iki %(hpRecover)s mašinos {yellow_Start}patvarumo taškų{yellow_End}, maksimaliai iki 20% patvarumo taškų. Leidžia naudoti remonto komplektus neturint kritinės žalos."

msgid "armorPatching/hudDescription"
msgstr "Patvarumo taškai atstatyti."

msgid "armorPatching/maxLvlDescription"
msgstr "Pilnai ištreniravus visai įgulai panaudojus remonto komplektą per 5 s atstato iki %(hpRecover)s mašinos {yellow_Start}patvarumo taškų{yellow_End}, maksimaliai iki 20% patvarumo taškų. Leidžia naudoti remonto komplektus neturint kritinės žalos."

msgid "armorPatching/name"
msgstr "Šarvų lopymas"

msgid "armorPatching/shortDescription"
msgstr "@ Padidina mašinos bazinę maskuotę."

msgid "brotherhood/alt/description"
msgstr "Įgulos efektyvumo bonusas pagerina įgulos narių efektyvumą mūšyje ir visų jų išmoktų įgūdžių efektyvumą, išskyrus šį. Šį parametrą galite dar labiau padidinti su panašaus efekto įranga ar ekipuote, arba panaudoję instrukciją Ortakių išvalymas. Taip pat šį parametrą gali padidinti vado įgūdis Kritinė padėtis arba Radisto įgūdžiai Petys prie peties ir Komunikacijos ekspertas."

msgid "brotherhood/alt/info"
msgstr "Grupiniams įgūdžiams apskaičiuoti nustatomas vidutinis visų įgulos narių treniravimo lygis. Jis pradeda veikti pasiekus bent 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "brotherhood/currentLvlDescription"
msgstr "Visų įgulos narių {greenBright_Start}įgulos efektyvumo bonusas{greenBright_End} padidinamas %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/maxLvlDescription"
msgstr "Pilnai ištreniruotas visai įgulai, padidina visos įgulos {greenBright_Start}įgūdžių efektyvumo bonusą{greenBright_End} %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/name"
msgstr "Ginklo broliai"

msgid "brotherhood/shortDescription"
msgstr "Pagerina bendrą įgulos darbą."

msgid "camouflage/alt/description"
msgstr "Ši įgūdis pakeičia mašinos maskuotę. Ją galima dar labiau pagerinti su Natūralios priedangos instrukcija.\n\nTaip pat mašinos maskuotę galima pagerinti su kamufliažais, stiliais ar panašų efektą suteikiančia įranga."

msgid "camouflage/alt/info"
msgstr "Grupiniams įgūdžiams apskaičiuoti nustatomas vidutinis visų įgulos narių treniravimo lygis. Jis pradeda veikti pasiekus bent 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "camouflage/currentLvlDescription"
msgstr "Mašinos {greenBright_Start}Maskuotė{greenBright_End} padidinama %(maskingFactor)s&zwnbsp;."

msgid "camouflage/maxLvlDescription"
msgstr "Pilnai ištreniruotas visai įgulai mašinos {greenBright_Start}maskuotę{greenBright_End} padidina %(maskingFactor)s&zwnbsp;."

msgid "camouflage/name"
msgstr "Maskuotė"

msgid "camouflage/shortDescription"
msgstr "Padidina mašinos bazinę maskuotę."

msgid "commander_coordination/alt/description"
msgstr "Efektas aktyvuojamas kiekvieną kartą aptikus mašiną ir jo veikimas nestiprėja aptikus kelias mašinas.\n\nTaikymosi greitį galima dar labiau padidinti treniruojant šaulio įgūdį Greitas taikymasis arba sumontuojant tinkamą įrangą."

msgid "commander_coordination/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "commander_coordination/currentLvlDescription"
msgstr "{yellow_Start}Taikymosi greitis{yellow_End} aptikus priešo mašiną bus 15 s padidintas %(vehicleGunAimSpeed)s."

msgid "commander_coordination/hudDescription"
msgstr "Taikymosi greitis padidintas."

msgid "commander_coordination/maxLvlDescription"
msgstr "Pilnai ištreniruotas 15 s padidina {yellow_Start}taikymosi greitį{yellow_End} %(vehicleGunAimSpeed)s aptikus priešo mašiną.\t"

msgid "commander_coordination/name"
msgstr "Koordinacija"

msgid "commander_coordination/shortDescription"
msgstr "Taikymosi greitis padidintas."

msgid "commander_eagleEye/alt/description"
msgstr "Apžvalgos lauką galima padidinti su radisto įgūdžiu Radio perėmėjas arba sumontuojant panašaus veikimo įrangą. Optikos kalibravimo instrukcija gali pagerinti šį efektą."

msgid "commander_eagleEye/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruotas bent iki 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "commander_eagleEye/currentLvlDescription"
msgstr "{greenBright_Start}Matymo laukas{greenBright_End} padidinamas %(circularVisionRadius)s&zwnbsp;. {greenBright_Start}Nuobauda už pažeistą stebėjimo įrangą{greenBright_End} sumažinama %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/hudDescription"
msgstr "Nuobauda dėl pažeistos stebėjimo įrangos sumažinama."

msgid "commander_eagleEye/maxLvlDescription"
msgstr "Pilnai ištreniruotas padidina {greenBright_Start}matymo lauką{greenBright_End} %(circularVisionRadius)s&zwnbsp; ir sumažina{greenBright_Start}nuobaudą už pažeistą stebėjimo įrangą{greenBright_End} %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/name"
msgstr "Žvalgybininkas"

msgid "commander_eagleEye/shortDescription"
msgstr "Padidina mašinos apžvalgos lauką, ypač su sužalotais apžvalgos prietaisais."

msgid "commander_emergency/alt/description"
msgstr "Pakartotinai gavus žalos iš priešo efektas nestiprėja. Įgulos efektyvumo bonusas pagerina įgulos nario darbą mūšyje. Šį parametrą galima dar labiau padidinti sumontavus įrangą, naudojant panašaus efekto ekipuotę ar naudojant instrukciją Ortakių išvalymas. Šį parametrą taip pat padidina grupinis įgūdis Ginklo broliai ir radisto Petys prie peties ir Komunikacijos ekspertas."

msgid "commander_emergency/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "commander_emergency/currentLvlDescription"
msgstr "{yellow_Start}Įgulos efektyvumo bonusas{yellow_End} gavus žalos iš priešo 15 s bus padidintas %(crewLevelIncrease)s."

msgid "commander_emergency/hudDescription"
msgstr "Įgulos efektyvumo bonusas padidintas."

msgid "commander_emergency/maxLvlDescription"
msgstr "Pilnai ištreniruotas gavus žalos iš priešo 15 s padidina {yellow_Start}įgulos efektyvumo bonusą{yellow_End} %(crewLevelIncrease)s."

msgid "commander_emergency/name"
msgstr "Kritinė padėtis"

msgid "commander_emergency/shortDescription"
msgstr "Įgulos efektyvumo bonusas padidintas."

msgid "commander_enemyShotPredictor/alt/description"
msgstr "Pranešimas apie Artilerijos šūvį aktyvuojamas praėjus šiek tiek laiko nuo iššovimo.\n\nĮgūdžio efektą galima pagerinti su instrukcija Padidintas budrumas."

msgid "commander_enemyShotPredictor/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "commander_enemyShotPredictor/currentLvlDescription"
msgstr "{yellow_Start}Pranešimas apie priešo artilerijos smūgį{yellow_End} ir šūvio kryptis bus parodomi praėjus %(artNotificationDelayFactor)s po šūvio. {greenBright_Start}Gautas apkurtimo efektas{greenBright_End} bus sumažintas %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/maxLvlDescription"
msgstr "Pilnai ištreniruotas, pateikia {yellow_Start}perspėjimą apie priešo artilerijos ugnį{yellow_End} ir nustato šūvio kryptį %(artNotificationDelayFactor)s po šūvio. {greenBright_Start}Gautą apkurtimo efektą{greenBright_End} sumažina %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/name"
msgstr "Garso aptikimas"

msgid "commander_enemyShotPredictor/shortDescription"
msgstr "Informuoja apie priešų artilerijos šūvį."

msgid "commander_holdLine/alt/description"
msgstr "Įgulos efektyvumo bonusas pagerina įgulos narių efektyvumą mūšyje ir visų jų išmoktų įgūdžių efektyvumą, išskyrus šį.\n\nŠį parametrą galite dar labiau padidinti su panašaus efekto įranga ar ekipuote, arba panaudoję instrukciją Ortakių išvalymas. Taip pat šį parametrą gali padidinti įvairūs kiti įgūdžiai."

msgid "commander_holdLine/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "commander_holdLine/currentLvlDescription"
msgstr "{yellow_Start}Įgulos efektyvumo bonusas{yellow_End} bus padidintas %(crewLevelIncrease)s jei priešų komandoje bus bent trijomis mašinomis daugiau, nei jūsų komandoje&zwnbsp;."

msgid "commander_holdLine/hudDescription"
msgstr "Įgulos efektyvumo bonusas padidintas (priešų dauguma)."

msgid "commander_holdLine/maxLvlDescription"
msgstr "Pilnai ištreniruotas %(crewLevelIncrease)s padidina {yellow_Start}įgulos efektyvumo bonusą{yellow_End} jei priešų komandoje yra bent trijomis mašinomis daugiau, nei jūsų komandoje&zwnbsp;."

msgid "commander_holdLine/name"
msgstr "Laikome liniją"

msgid "commander_holdLine/shortDescription"
msgstr "@ Padidina įgulos efektyvumo bonusą"

msgid "commander_practical/alt/description"
msgstr "Įgūdis veikia bet kokio tipo ekipuotei, sumontuotai jūsų mašinoje.\n\nJo efektą galima dar labiau padidinti su instrukcija Atidus pasiruošimas."

msgid "commander_practical/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruotas bent iki 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "commander_practical/currentLvlDescription"
msgstr "{greenBright_Start}Ekipuotės atsistatymo laikas{greenBright_End} sumažinamas %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/maxLvlDescription"
msgstr "Pilnai ištreniruotas, sumažina {greenBright_Start}ekipuotės atsistatymo laiką{greenBright_End} %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/name"
msgstr "Praktiškumas"

msgid "commander_practical/shortDescription"
msgstr "Sumažina ekipuotės atsistatymo laiką."

msgid "commander_sixthSense/alt/description"
msgstr "Jei vadas sužeistas, Šeštasis jausmas neveikia. Jo aktyvavimo laiką galima sumažinti su Radio operatoriaus įgūdžiu Signalo aptikimas."

msgid "commander_sixthSense/alt/info"
msgstr "Tai speciali vado funkcija, kurios nereikia ištreniruoti ir kurią turi visi vadai."

msgid "commander_sixthSense/currentLvlDescription"
msgstr "Leidžia jūsų vadui nustatyti, ar jūsų mašina jau buvo pastebėta priešo. Aktyvuojamas %(delay)s po to, kai esate pastebimi."

msgid "commander_sixthSense/name"
msgstr "Šeštas jausmas"

msgid "commander_sixthSense/shortDescription"
msgstr "Leidžia vadui nustatyti ar jo mašiną pastebėjo priešai."

msgid "commander_staySharp/alt/description"
msgstr "Įgulos efektyvumo bonusas pagerina įgulos narių efektyvumą mūšyje ir visų jų išmoktų įgūdžių efektyvumą, išskyrus šį.\n\nŠį parametrą galite dar labiau padidinti su panašaus efekto įranga ar ekipuote, arba panaudoję instrukciją Ortakių išvalymas. Taip pat šį parametrą gali padidinti įvairūs kiti įgūdžiai."

msgid "commander_staySharp/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "commander_staySharp/currentLvlDescription"
msgstr "{yellow_Start}Įgulos efektyvumo bonusas{yellow_End} bus padidintas %(crewLevelIncrease)s 15&nbsp;s po to, kai panaudosite vaistinėlę. Leidžia naudoti vaistinėles, net jei nė vienas įgulos narys nėra sužeistas&zwnbsp;."

msgid "commander_staySharp/hudDescription"
msgstr "Įgulos efektyvumo bonusas padidintas (panaudota vaistinėlė)."

msgid "commander_staySharp/maxLvlDescription"
msgstr "Pilnai ištreniruotas %(crewLevelIncrease)s padidina {yellow_Start}įgulos efektyvumo bonusą{yellow_End} 15 s po to, kai panaudojate vaistinėlę. Leidžia naudoti vaistinėles, net jei nė vienas įgulos narys nėra sužeistas&zwnbsp;."

msgid "commander_staySharp/name"
msgstr "Išliekame atidūs"

msgid "commander_staySharp/shortDescription"
msgstr "@ Padidina įgulos efektyvumo bonusą"

msgid "commander_tutor/alt/description"
msgstr "Sužalotas vadas negali pakeisti kito įgulos nario. Bonusas suteikiamas tik įgulos patirčiai mūšyje.\n\nDaugiau įgulos patirties galima gauti iš įgulos knygų arba konvertuojant laisvąją patirtį į įgulos patirtį."

msgid "commander_tutor/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruotas bent iki 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "commander_tutor/currentLvlDescription"
msgstr "Uždirbtos {greenBright_Start}patirties{greenBright_End} kiekis visiems nariams padidinamas %(xpBonusFactorPerLevel)s. Vadas gali {greenBright_Start}perimti nukautų įgulos narių darbą{greenBright_End} su %(woundedCrewEfficiency)s efektyvumu."

msgid "commander_tutor/hudDescription"
msgstr "Nukautą įgulos narį pakeičia vadas."

msgid "commander_tutor/maxLvlDescription"
msgstr "Pilnai ištreniruotas %(xpBonusFactorPerLevel)s padidina uždirbamos {greenBright_Start}patirties{greenBright_End} kiekį visiems nariams. Leidžia vadui {greenBright_Start}perimti nukautų įgulos narių darbą{greenBright_End} su %(woundedCrewEfficiency)s efektyvumu."

msgid "commander_tutor/name"
msgstr "Mokytojas"

msgid "commander_tutor/shortDescription"
msgstr "Nukautą įgulos narį pakeičia vadas."

msgid "commander_universalist/alt/description"
msgstr "Vadas gali pakeisti tik pagrindinę nukauto įgulos nario kvalifikaciją. Pakeitimo efektas sumažėja su kiekvienu nukautu įgulos nariu."

msgid "commander_universalist/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruota bent iki 1%. Efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "commander_universalist/currentLvlDescription"
msgstr "Vadas gali {greenBright_Start}pakeisti nukautą{greenBright_End} įgulos narį su %(woundedCrewEfficiency)s efektyvumu."

msgid "commander_universalist/hudDescription"
msgstr "Vadas atlieka nukauto įgulos nario vaidmenį."

msgid "commander_universalist/maxLvlDescription"
msgstr "Pilnai ištreniruotas leidžia vadui {greenBright_Start}pakeisti nukautą{greenBright_End} įgulos narį su %(woundedCrewEfficiency)s efektyvumu."

msgid "commander_universalist/name"
msgstr "Visų galų meistras"

msgid "commander_universalist/shortDescription"
msgstr "Leidžia vadui pakeisti nukautus įgulos narius."

msgid "driver_badRoadsKing/alt/description"
msgstr "Sumažina nuobaudą mašinos manevringumui ir akceleracijai važiuojant vidutiniškai minkštu gruntu. Ženkliai sumažina šias nuobaudas ant minkšto grunto ir prilygina jas nuobaudoms važiuojant vidutiniškai minkštu.\nManevringumas važiuojant vidutiniškai minkštu ir minkštu gruntu negali viršyti manevringumo važiuojant kietu gruntu."

msgid "driver_badRoadsKing/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruotas bent iki 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "driver_badRoadsKing/currentLvlDescription"
msgstr "{greenBright_Start}Greičio praradimas važiuojant vidutiniškai minkštu gruntu{greenBright_End} sumažinamas %(mediumGroundFactor)s&zwnbsp;, {greenBright_Start}greičio praradimas važiuojant minkštu gruntu{greenBright_End} sumažinamas iki %(softGroundFactor)s vertės važiuojant vidutiniškai minkštu."

msgid "driver_badRoadsKing/maxLvlDescription"
msgstr "Pilnai ištreniruotas sumažina {greenBright_Start}greičio praradimą važiuojant vidutiniškai minkštu gruntu{greenBright_End} %(mediumGroundFactor)s&zwnbsp;, sumažina {greenBright_Start}greičio praradimą važiuojant minkštu gruntu{greenBright_End} iki %(softGroundFactor)s vertės važiuojant vidutiniškai minkštu."

msgid "driver_badRoadsKing/name"
msgstr "Bekelės karalius"

msgid "driver_bulletproof/alt/description"
msgstr "Įgulos efektyvumo bonusas pagerina įgulos narių efektyvumą mūšyje ir visų jų išmoktų įgūdžių efektyvumą, išskyrus šį.\n\nŠį parametrą galite dar labiau padidinti su panašaus efekto įranga ar ekipuote, arba panaudoję instrukciją Ortakių išvalymas. Taip pat šį parametrą gali padidinti įvairūs kiti įgūdžiai."

msgid "driver_bulletproof/alt/info"
msgstr "Įgūdis, kuriam aktyvuoti reikia specialių sąlygų, veikia, jei ištreniruotas bent iki 1%, o jo efektyvumas priklauso nuo ištreniravimo lygio. Įgūdis pradeda veikti specialiomis mūšio sąlygomis."

msgid "driver_bulletproof/currentLvlDescription"
msgstr "{yellow_Start}Įgulos efektyvumo bonusas{yellow_End} bus padidintas %(crewLevelIncrease)s, jei jūsų nublokuota žala viršija jūsų mašinos patvarumo taškų kiekį."

msgid "driver_bulletproof/hudDescription"
msgstr "Įgulos efektyvumo bonusas padidintas (nublokuota pakankamai žalos)."

msgid "driver_bulletproof/maxLvlDescription"
msgstr "Pilnai ištreniruotas %(crewLevelIncrease)s padidina {yellow_Start}Įgulos efektyvumo bonusą{yellow_End}, jei jūsų nublokuota žala viršija jūsų mašinos patvarumo taškų kiekį."

msgid "driver_bulletproof/name"
msgstr "Neperšaunamas"

msgid "driver_motorExpert/alt/description"
msgstr "Maksimalų mašinos greitį galite dar labiau padidinti, o nuobaudą pažeistam varikliui galite dar labiau sumažinti naudodami panašaus efekto įrangą."

msgid "driver_motorExpert/alt/info"
msgstr "Įgūdis pradeda veikti, jei ištreniruotas bent iki 1%, o jo efektyvumas didėja su didesniu ištreniravimo lygiu."

msgid "driver_motorExpert/currentLvlDescription"
msgstr "Jūsų mašinos {greenBright_Start}maksimalus greitis į priekį{greenBright_End} ir {greenBright_Start}atgal{greenBright_End} padidinamas %(vehicleForwardMaxSpeed)s. {greenBright_Start}Nuobauda pažeistam varikliui{greenBright_End} sumažinama %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/hudDescription"
msgstr "Nuobauda pažeistam varikliui sumažinama."

msgid "driver_motorExpert/maxLvlDescription"
msgstr "Pilnai ištreniruotas %(vehicleForwardMaxSpeed)s padidina jūsų mašinos {greenBright_Start}maksimalų greitis į priekį{greenBright_End} ir {greenBright_Start}atgal{greenBright_End}. %(vehPenaltyForDamagedEngine)s sumažina {greenBright_Start}nuobaudą pažeistam varikliui{greenBright_End}&zwnbsp;."

msgid "driver_motorExpert/name"
msgstr "Inžinierius"

msgid "driver_motorExpert/shortDescription"
msgstr "Nuobauda pažeistam varikliui sumažinama."

msgid "driver_rammingMaster/alt/description"
