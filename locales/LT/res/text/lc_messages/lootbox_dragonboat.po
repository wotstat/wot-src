msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Drakono laivo dėžės"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRAKONO LAIVO DĖŽĖS"

msgid "entryPoint/tooltip/description"
msgstr "Tai yra specialios dėžės, kuriuose rasite unikalių ir vertingų žaidimo daiktų.\nDėžių galite gauti žaidimo ir Premium parduotuvėse."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Drakono laivo dėžės laikinai nepasiekiamos"

msgid "eventName/lowerCase"
msgstr "Prisijaukinkite drakoną, skriekite su vėju"

msgid "eventName/upperCase"
msgstr "PRISIJAUKINKITE DRAKONĄ, SKRIEKITE SU VEJU"

msgid "infoPage/footer/description/compensation"
msgstr "Jei jau turite visas mašinas, kurias galite gauti iš dėžių, tai toliau iš Drakono laivo dėžių gaunamų mašinų vertė bus pilnai kompensuojama auksu."

msgid "infoPage/footer/description/guaranteed"
msgstr "Kas %(guaranteed0)s Drakono laivo dėžių garantuotai gausite VIII–X lygio mašiną. Jei atidarinėdami jas negaunate tokios mašinos, tai VIII–X lygio mašiną, kurios dar neturite, būtinai gausite atidarę %(guaranteed0)s&zwnbsp;-tą Drakono laivo dėžę. Gavus mašiną dėžės bus skaičiuojamos iš naujo."

msgid "noBoxesView/description/"
msgstr "Jūs neturite dėžių.\nJų galite gauti žaidimo parduotuvėje."
