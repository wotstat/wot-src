msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Kurtas Osaka artilerijos arsenalo specialistų kaip Type 2589 pakaitalas. Chi-Ni ir Chi-Ha kartu išbandyti 1937 metais. Chi-Ha pasirinktas kaip pranašesnis tankas. Pagamintas tik vienas prototipas."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Type 3 Chi-Nu Kai vidutinis tankas yra kombinacija Type 3 Chi-Nu pakabos ir bokštelio , bei Type 4 Chi-To ginklo. Pagamintas tik vienas prototipas. 1945 metų kovą jis buvo parengtas bandymams."

msgid "Chi_Nu_Kai_long_special"
msgstr "Tai standartinis vidutinis tankas, neturintis išskirtinių privalumų ar trūkumų. Jis tinkamas bet kuriose situacijose mūšyje."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Puikus taiklumas, geras pramušimas, tvirti ginklo plokštės šarvai"

