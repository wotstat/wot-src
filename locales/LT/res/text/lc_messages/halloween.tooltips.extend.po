msgid "Contact/status/inBattle/halloween"
msgstr "Babilono: Tamsusis bokštas mūšyje"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Iššauna sviedinį, kuris pažeidžia ir apkurtina taikinį kartu su visomis priešų mašinomis 35 m spinduliu."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Iššauna sviedinį, kuris atstato patvarumo taškų pavogdamas jų iš taikinio ir 35 m spinduliu esančių mašinų."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Iššauna šūvį, kuris apkurtina taikinį ir visas mašinas 35 m spinduliu."

msgid "advanced/hw_damageShield"
msgstr "7 sekundes apsaugo nuo bet kokios žalos (išskyrus taranavimo, skendimo ir smūgio)."

msgid "advanced/hw_fastReload"
msgstr "Padidina šaudymo spartą / užtaiso apkabą."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Atstato patvarumo taškų, užgesina gaisrą, pašalina apkurtimo efektą ir sutaiso pažeistus modulius."

msgid "advanced/hw_invisibility"
msgstr "Laikinai jus padaro nematomais priešams, atstato patvarumo taškų, suremontuoja modulius, užgesiną gaisrą, panaikina apkurtimo efektą ir pasirūpina sužeistais įgulos nariais."

msgid "advanced/hw_teamRepairKit"
msgstr "Sutaiso pažeistus modulius, užgesina ugnį, panaikina apkurtimo efektą ir atstato šiek tiek patvarumo taškų komandos narių mašinoms, esančioms veikimo zonoje."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Koviniai gebėjimai leidžia efektyviau kovoti Babilonas: Tamsusis bokštas mūšiuose, įvykdyti užduotis ir uždirbti vertingų prizų. Pasirinkite juos paspaudę Kovinių gebėjimų vietą."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Kovinių gebėjimų vietos"

msgid "hwShell/alt/description"
msgstr "%(bold)s galima gauti mūšiuose sunaikinus priešą."

msgid "hwShell/alt/description/bold"
msgstr "Alternatyvų sviedinį"
