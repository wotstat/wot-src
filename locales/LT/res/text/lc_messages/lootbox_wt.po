msgstr "Daugiausia modulių iki garantuoto prizo: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Jei iki renginio pabaigos neatidarysite visų modulių, tai jie bus atidaryti automatiškai."

msgid "infoPage/footer/description/compensation"
msgstr "Jei jau turite visas mašinas, kurias galite gauti iš modulių, tai toliau gaunamų mašinų vertė bus pilnai kompensuojama auksu."

msgid "infoPage/footer/description/guaranteed"
msgstr "Kas %(guaranteed0)s modulių garantuotai gausite Premium mašiną. Jei atidarinėdami modulius negaunate tokios mašinos, tai Premium mašiną, kurios dar neturite, būtinai gausite atidarę %(guaranteed0)s-tą modulį. Gavus mašiną moduliai bus skaičiuojami iš naujo."

msgid "infoPage/header/description"
msgstr "Modulių viduje gali būti vertingų žaidimo daiktų! Sužinokite daugiau žemiau."

msgid "multipleRewardView/header/subTitle/"
msgstr "Iš %(name) (atidaryta modulių: %(boxesCount))"

msgid "noBoxesView/description/"
msgstr "Jūs neturite modulių. Jų galite gauti\nžaidimo parduotuvėje arba Premium parduotuvėje."

