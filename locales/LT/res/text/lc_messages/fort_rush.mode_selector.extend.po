msgid "mode/fort_rush_battle/description"
msgstr "Perimkite antenų kontrolę. Palaikykite ryšį. Perduokite žinutę."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Jūsų kompiuterio galingumo šiam režimui nepakanka. Jus galite pamatyti grafikos iškraipymus bei patirti nesklandumų judant mašinai. Gali nulūžti žaidimo klientas."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Žema greitaveika"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Žema greitaveika"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Šis režimas reikalauja daug kompiuterio resursų. Jūs patirsite problemų užkraunant žemėlapį, išvysite grafikos iškraipymus ir patirsite nesklandumų judant mašinai. Jeigu žaidimas veikia lėtai, pabandykite sumažinti grafikos kokybę nustatymuose."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Sumažinta greitaveika"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Sumažinta greitaveika"
