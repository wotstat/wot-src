msgid "G114_Rheinmetall_Skorpian_LS_BOT"
msgstr "Alfa Skorpion"

msgid "G114_Rheinmetall_Skorpian_LS_BOT_descr"
msgstr "Antros serijos savaeigių artilerinių pabūklų Panther tanko pagrindu kūrimas buvo pradėtas 1943 sausį Rheinmetall kompanijoje. Brėžiniai 12,8 cm Skorpion buvo baigti 1943 balandžio 2 dieną. Egzistavo tik brėžiniuose."

msgid "G114_Rheinmetall_Skorpian_LS_BOT_short"
msgstr "Alfa"

msgid "G142_M48RPz_LS_BOT"
msgstr "Sargybinis M48 RPz"

msgid "G142_M48RPz_LS_BOT_descr"
msgstr "Inžinerinių mašinų pirmtakas, pagamintas ant amerikietiško M48 vidutiniojo tanko pagrindo. Apginkluota M8A1 buldozerio mente, ši mašina buvo naudojama Bundesvero inžineriniuose daliniuose iki vėlyvųjų 1990. Iš viso tarnyboje buvo naudojamos 53 šios mašinos."

msgid "G142_M48RPz_LS_BOT_short"
msgstr "Sargybinis"

