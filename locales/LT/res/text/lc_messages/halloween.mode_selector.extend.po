msgid "mode/halloween/battlePassTooltip/body"
msgstr "Tam tikros misijos renginyje {whiteSpanish_open}Babilonas: Tamsusis bokštas{whiteSpanish_close} leis jums uždirbti Kovinio leidimo taškų."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Kovinio leidimo taškai"

msgid "mode/halloween/calendar"
msgstr "Renginys dar tęsis %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Renginys baigsis po %(date)s."

msgid "mode/halloween/description"
msgstr "Kovokite ir rinkite materiją.\nMūšiai specialiomis mašinomis."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Jūsų kompiuterio galingumo šiam režimui nepakanka. Jus galite pamatyti grafikos iškraipymus bei patirti nesklandumų judant mašinai. Gali nulūžti žaidimo klientas."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Žema greitaveika"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Žema greitaveika"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Šis režimas reikalauja daug kompiuterio resursų.\nJūs patirsite problemų užkraunant žemėlapį, išvysite grafikos iškraipymus ir patirsite nesklandumų judant mašinai. Jeigu žaidimas veikia lėtai, pabandykite sumažinti grafikos kokybę nustatymuose."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Sumažinta greitaveika"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Sumažinta greitaveika"
