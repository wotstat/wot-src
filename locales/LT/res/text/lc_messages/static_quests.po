msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Pradėkite Atsitiktinį mūšį su bet kokio lygio mašina."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Sveiki atvykę į žaidimą! Kovokite su kitais fanais iš viso pasaulio ir džiaukitės įspūdingomis pergalėmis!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Pirmas mūšis"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Išraskite ir nusipirkite bet kurią IV lygio mašiną."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Naujos mašinos pirkimas yra svarbus įvykis. Su naujais lygiais, mašinos tampa vis įdomesnės. Treniruota įgula taip pat patobulins bendrą žaidimo pojūtį."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "IV lygio mašina"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Sužaiskite tris Atsitiktinius mūšius su IV–X lygio mašinomis su uždėtu pritaikomu elementu."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Jūs galite modifikuoti mašinas keisdami jų išorę su jau paruoštais stiliais ar sukurdami savo stilių naudodami kamufliažą, užrašus, emblemas ir lipdukus."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Mašinos išvaizda"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Pradėkite treniruoti bet kokį įgūdį bet kuriam įgulos nariui."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Įgulos nariai gali išmokti daugiau įgūdžių, kurie pagerins jų efektyvumą arba suteiks naujų gebėjimų."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Įgulos įgūdžiai"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Uždirbkite 150 000 kreditų Atsitiktiniuose mūšiuose su IV–X lygio mašinomis."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Kuo aukštesnio lygio kova, tuo daugiau kreditų jums reikės, kad išlaikytumėte savo mašiną, atstatytumėte amuniciją ir nusipirktumėte modulius bei įrangą."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Kreditų taupymas"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Išraskite ir nusipirkite bet kurią V lygio mašiną."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "V lygyje pradeda atsirasti rimtesnės mašinos ir jūsų žaidimo įgūdžiai yra iš ties išbandomi. Pilnai treniruota įgula čia tikrai pravers."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "V lygio mašina"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su V–X lygio mašinomis su trimis sumontuotomis įrangomis."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Pašviesinta optika ar Pagerinta ventiliacija? Tinkama įranga gali sustiprinti jūsų mašinos stiprybes ir sumažinti trūkumus."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Įrangos montavimas"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Įvykdykite vieną bazinį scenarijų Topografijos rėžime."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Jei norite įgyti pasitikėjimo mūšio lauke, geriausia yra gerai suprasti pravažiavimus, taktikas ir žemėlapius su jų svarbiomis pozicijomis ir objektais juose."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografija"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Įvykdykite keturis sudėtingus scenarijus viename žemėlapyje režime Topografija."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Kartas nuo karto pažaiskite Topografijos režimą ir išnagrinėkite Atsitiktinių mūšių žemėlapius. Keturi scenarijai leis jums ištirti vietą iš skirtingų kampų."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Sudėtingesnė Topografija"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su V-X Lygio mašinomis ir aktyvuotu asmeniniu rezervu."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Aktyvavus, galite gauti papildomus bonusus įgulos patirčiai, kovinei patirčiai, laisvajai patirčiai ar kreditams po kiekvienos kovos."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Asmeniniai rezervai"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Būkite tarp 10 daugiausia patirties uždirbusių žaidėjų savo komandoje šešis kartus pergalinguose Atsitiktiniuose mūšiuose su V-X lygio mašinomis."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Šios misijos leidžia uždirbti penkis kartus daugiau patirties sėkmingame mūšyje. Tam reikia laimėti ir komandoje būti tarp 10 daugiausia patirties gavusių žaidėjų."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 ×5 patirties misijos"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Išraskite modulį ir sumontuokite bet kokio lygio mašinoje."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Kovinė patirtis suteikiama po kiekvieno mūšio. Rinkite kovinę patirtį ir išraskite naujus modulius, kurie padidina jūsų mašinos efektyvumą."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "kovinės patirties"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Išraskite ir nusipirkite bet kurią VI lygio mašiną."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Kiekvieno didesnio lygio mašinoms išrasti reikės vis daugiau laiko ir pastangų. Laisvoji patirtis padės tobulėti greičiau, o gera įgula pravers visada."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "VI lygio mašinos"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Įvykdykite vieną asmeninę misiją iš bet kurios kampanijos."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanijos yra misijų sekos, skirtos skirtingų tipų mašinoms. Įvykdžius galite gauti naudingų prizų ir unikalių mašinų."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Asmeninės misijos"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Treniruokite savo įgulą su universalia instrukcija."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Įgulos knygos leidžia jums stipriai pagreitinti įgulos treniravimąsi, pridėdamos tam tikrą patirties kiekį vienam ar visiems įgulos nariams."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Įgulos knygos"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su VI-X lygio mašinomis su įgulos instrukcija."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Instrukcijos gali pagerinti įgulos įgūdžius vienam mūšiui. Kaip ekipuotę, instrukcijas galima pirkti ar gauti kaip prizą."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Instrukcijos įgulai"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Nusipirkite specialų Naujoko rinkinį parduotuvėje."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Jūs galite nusipirkti visus reikalingus daiktus žaidimo parduotuvėje, čia rasite aukso, Premium mašinų ir daugiau. Reguliariai rasite nemažų akcijų."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Parduotuvė"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su VI-X lygio Premium mašinomis."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Šių mašinų nereikia išrasti. Jos uždirba daugiau kovinės ir įgulos patirties bei kreditų ir leidžia persikelti įgulą į šias mašinas be pertreniravimo."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium mašinos"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su VI-X lygio mašinomis su instrukcija įrangai."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Instrukcijos leidžia jums sustiprinti sumontuotos įrangos efektyvumą. Kaip ekipuotę, instrukcijas galima pirkti ar gauti kaip prizą."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Instrukcijos įrangai"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Būkite tarp 10 daugiausia patirties uždirbusių žaidėjų savo komandoje 15 kartų Atsitiktiniuose mūšiuose su VI–X lygio mašinomis."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Šios misijos leidžia uždirbti penkis kartus daugiau patirties sėkmingame mūšyje. Tam reikia laimėti ir komandoje būti tarp 10 daugiausia patirties gavusių žaidėjų."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 ×5 patirties misijų"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Išraskite ir nusipirkite bet kurią VII lygio mašiną."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Šiame lygyje jums reikės dar daugiau įgūdžių. Mašinos tampa grėsmingesnės ir efektyvesnės – kaip ir jūsų priešai."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "VII lygio mašina"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Sužaiskite 10 Atsitiktinių mūšių su VII-X lygio mašinomis su didele vaistinėle, dideliu remonto komplektu ir automatiniu gesintuvu."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Naudojama didelė ekipuotė greičiau sutaiso pažeistus modulius, nei mažesnė. Ji taip pat sumažina apkurtimo laiką ir gaisro tikimybę bei greičiau atsistato."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Didelė ekipuotė"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Gaukite dvigubai patirties už pirmą dienos pergalę Atsitiktiniuose mūšiuose su bet kokio lygio mašina."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Jūs galite gauti dvigubai patirties laimėdami pirmą dienos mūšį su kiekviena mašina. Pasinaudokite tuo ir tobulinkite savo mašinas greičiau."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Patirties daugiklis"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Sukurkite brėžinius bet kuriai neišrastai mašinai."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Brėžiniai suteikia nuolaidą patirčiai ir leidžia greičiau išrasti mašiną. Juos galima gauti kaip prizus ar pasigaminti iš universalių ar nacionalinių fragmentų."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Mašinų brėžiniai"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Būkite tarp 10 daugiausia patirties uždirbusių žaidėjų savo komandoje 20 kartų Atsitiktiniuose mūšiuose su VII–X lygio mašinomis."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Šios misijos leidžia uždirbti penkis kartus daugiau patirties sėkmingame mūšyje. Tam reikia laimėti ir komandoje būti tarp 10 daugiausia patirties gavusių žaidėjų."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 ×5 patirties misijų"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Išraskite ir nusipirkite bet kurią VIII lygio mašiną."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "VIII turėsite pasinaudoti visomis savo sukauptomis žiniomis. Priešai neduos progos atsipūsti, turėsite likti budrūs, bet galėsite pasimėgauti įdomiais mūšiais."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "VIII lygio mašina"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Naudokite laisvąją patirtį išrasdami bet kurį modulį."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Jei neturite pakankamai kovinės patirties išrasti mašinai ar moduliui, galite pasinaudoti laisvąja patirtimi, kuri gali būti renkama bet kuriai mašinai."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Laisvoji patirtis"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Pasikraukite šiek tiek alternatyvių sviedinių ir pradėkite Atsitiktinį mūšį su III–X lygio mašina."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Šarvamušiai, fugasiniai ir pokalibriniai šarvamušiai sviediniai yra naudojami skirtingose mūšio situacijose. Pasirinkite išmintingai ir įgykite pranašumą!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Amunicija"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Parduokite nenaudojamą modulį iš Sandėlio."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Nepanaudoti moduliai, sviediniai, įranga, ekipuotė ir kiti daiktai yra kaupiami sandėlyje. Galite parduoti nereikalingus daiktus ir gauti kreditų."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Sandėlis"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Uždirbkite 25 000 kreditų Atsitiktiniuose mūšiuose su III-X lygio mašinomis."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Kreditai naudojami pirkti sviedinius bei naujas mašinas, taisyti mašinas ir daugiau. Svarbu žinoti, kaip juos taupyti ir panaudoti išmintingai."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Kreditai"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Sužaiskite tris Atsitiktinius mūšius su III–X lygio mašinomis su sumontuota ekipuote visose galimose vietose."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Ekipuotė gali sutaisyti kritinius mašinos pažeidimus ir išgydyti įgulos sužalojimus mūšyje. Tinkamu metu panaudota ekipuotė leidžia išgyventi mūšyje."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Ekipuotė"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Sužaiskite tris Atsitiktinius mūšius su III–X lygio mašinomis su bet kokia sumontuota įranga."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Mašinose galima sumontuoti įrangą ir taip sustiprinti tam tikras mašinos charakteristikas. Galima įranga priklausys nuo mašinos ir žaidimo stiliaus."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Įranga"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografija"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Įvykdyti vieną scenarijų bet kuriame žemėlapyje režime Topografija"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Įvykdyti keturis bazinius scenarijus viename žemėlapyje režime Topografija"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Žvalgyba"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Įvykdykite keturis sudėtingus scenarijus viename žemėlapyje režime Topografija"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "10 iš geografijos"
