msgid "Contact/status/inBattle/last_stand"
msgstr "Paskutinio mūšio kovoje"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Iššauna sviedinį, kuris pažeidžia taikinį ir visas mašinas 35 m spinduliu."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Iššauna sviedinį, kuris atstato patvarumo taškų pavogdamas jų iš taikinio ir 35 m spinduliu esančių mašinų."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Iššauna šūvį, kuris apkurtina taikinį ir visas mašinas 35 m spinduliu."

msgid "advanced/ls_damageShield"
msgstr "10 sekundžių apsaugo nuo bet kokios žalos (išskyrus taranavimo, skendimo ir smūgio)."

msgid "advanced/ls_doubleDamage"
msgstr "Jūsų kitas taiklus šūvis padarys dvigubai daugiau žalos."

msgid "advanced/ls_equipment"
msgstr "Taktiniai prietaisai leidžia efektyviau kovoti Paskutinio mūšio kovose, įvykdyti sekos etapus ir uždirbti vertingų prizų. Pasirinkite juos paspaudę taktinių prietaisų vietą."

msgid "advanced/ls_extraDamageSituational"
msgstr "Suteikia šansą priešui padaryti dvigubai daugiau žalos."

msgid "advanced/ls_fastReload"
msgstr "Padidina šaudymo spartą / užtaiso apkabą."

msgid "advanced/ls_healSituational"
msgstr "Atstato patvarumo taškų sunaikinus priešo mašiną."

msgid "advanced/ls_invisibility"
msgstr "Laikinai neleidžia priešams taikytis į jūsų mašiną, atstato patvarumo taškų, suremontuoja modulius, užgesiną gaisrą, panaikina apkurtimo efektą ir pasirūpina sužeistais įgulos nariais."

msgid "advanced/ls_nitro"
msgstr "Laikinai padidina jūsų mašinos mobilumą."

msgid "advanced/ls_nitroSituational"
msgstr "Laikinai padidina jūsų mašinos mobilumą, jei gaunate žalos iš priešo."

msgid "advanced/ls_selfRepairKit"
msgstr "Atstato patvarumo taškų, užgesina gaisrą, pašalina apkurtimo efektą ir sutaiso pažeistus modulius."

msgid "advanced/ls_teamRepairKit"
msgstr "Sutaiso pažeistus modulius, užgesina ugnį, panaikina apkurtimo efektą ir atstato šiek tiek patvarumo taškų komandos narių mašinoms, esančioms veikimo zonoje."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktinius prietaisus galite įsidėti į specialias vietas, nes jie padeda žymiai efektyviau kovoti Paskutinio mūšio kovose, greičiau vykdyti sekos etapus ir uždirbti vertingų prizų."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktinių prietaisų vietos"
