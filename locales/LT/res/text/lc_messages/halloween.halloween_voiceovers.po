msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Anomalijos šaltinis artinasi. Žinoma, kad tai yra didžiulis tankas."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Sunaikinkite jį ir viskas. Nagi, vyrai!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Šaukite į silpnas jo šarvų vietas."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Vyrai, didžiulis ir klaikus siaubūnas važiuoja link mūsų,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "tokio mes dar niekada nesame matę."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Bent jau matosi jo silpnosios vietos. Mums reikia"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "sunaikinti bosą, gauti daviklį ir užbaigti misiją."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Šiandien mums sekasi! Du bosai, vietoje vieno,"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "čia tai kažkas naujo. Bet mes vis tiek nugalėsime. Taikykitės į"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "silpnas jo šarvų vietas ir nepamirškite sunaikinti jo sargybinių."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Tai rimtas priešininkas, bet jis turi silpnų vietų."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Sunaikinkime šį padarą ir viskas. Nagi, vyrai!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Taikykitės į priešo silpnąsias vietas. Ir nepamirškite sunaikinti"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "jo pakalikų, nes kitaip situacija gali tapti nevaldoma."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Jei norime uždaryti anomaliją, privalome sunaikinti bosą."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Taikykitės į silpnas jo šarvų vietas."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Užbaigti misiją galite tik sunaikinę paskutinį priešą."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Šaukite į pažeidžiamas jo vietas."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Tai paskutinė kliūtis mūsų kelyje."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Susiimkime, vyrai! Sunaikinkime šį monstrą!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Šis priešas yra labai pavojingas, bet jis turi silpnų vietų."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Taip paskutinė proga užbaigti tai visiems laikams."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Dabar pamatysime, ką mums paruošė ši anomalija."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Stiprus priešininkas, bet jis turi silpnų vietų."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Susikaupiam ir sunaikiname šią pabaisą!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Tai labai stiprus priešas. Bet mes galime laimėti, aš tai žinau."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Šiandien du bosai už vieno kainą."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Nagi, tai karštas pasiūlymas! Taikykitės į pažeidžiamas"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "šarvų vietas. Sunaikinkime šiuos monstrus!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Panašu, kad šie bosai neapsisprendė, kuris pirmas,"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "ir atėjo čia kartu. Abu turi silpnų vietų, taikykitės į jas."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Dar viena puiki pora bosų. Draugai, žinote, ką reikia daryti."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Šaukite į silpnas vietas ir pravalykite jų pakalikus."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Ir paskubėkite!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Mes visai neblogai jį apdaužėme!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Bet panašu, kad tai dar ne pabaiga."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Puiku! Bet mes dar tik pusiaukelėj."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Jis tuoj sugrįš kartu su savo draugais."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Taip jam ir reikia! Susitaisome savo tankus ir važiuojame toliau."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Jo taip lengvai nepribaigsi. Pasiruoškite antram raundui."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Gerai mes jam smogėme! Bet tai dar ne pabaiga."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Puiku! Bet mes dar tik pusiaukelėj."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Jie tuoj sugrįš kartu su savo draugais."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Taip jam ir reikia! Susitaisome savo tankus ir važiuojame toliau."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Jų taip lengvai nepribaigsi. Pasiruoškite antram raundui."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Kalba kapitonas Smith. Kol mūsų vyrai lauke bando atsilaikyti"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "prieš šiuos šešėlinius tankus, jūs pulkite Babilono kompleksą,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "mūsų misija yra pereiti visas fazes ir užverti anomaliją. "

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Tą padaryti galime pripildę visų fazių kolektorius. Važiuojam!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Giliai Mirium erdvėje pastebėta priešų bazė. "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Jie invazijai ruošia didžiulę armiją. Mūsų vienintelis šansas"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "juos sustabdyti yra užblokuoti jų kelią. Mūsų misija yra nukeliauti"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "iki gilios fazės ir paimti jų daviklį, kuris laiko"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "jų kelią atvirą. Į Magnus atgabenkite pakankamai Mirium, "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "nes mes keliaujame iki pačio galo!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Sveiki visi! Mums reikia užverti šešėliniams tankams kelią"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "į mūsų pasaulį. Žvalgybos biuras gali pasirūpinti šnipais"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "Babilone – mūsų užduotis yra Mirium. Užpildykite kolektorius"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "kiekvienoje fazėje, išspardykite visų mūsų laukiančių priešų subines"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "ir užverkite šią skylę. Užveskite variklius!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Čia kalba Smith. Mūsų užduotis yra užverti portalą,"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "Babilono komplekso teritorijoje. Pripildykite Mirium kolektorius"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "ir sunaikinkite viską, kas juda. Nagi, vyrai, priešai laukia!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Mūsiškiai bando atlaikyti šešėlinius tankus ir neleisti jiems įsiveržti"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "į realų pasaulį. Mūsų misija yra uždaryti kelią."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Kuo greičiau, tuo geriau. Rinkite Mirium ir užblokuokite skylę."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Priešų tankai puola Babilono kompleksą. Visas tas blogis"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "ropščiasi iš portalų, o mūsų darbas yra užtverti jiems kelią."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Nusigaukite gilyn į anomaliją ir sunaikinkite jos šaltinį. Važiuojam!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Kalba Smith. Mūsų misija yra įkalinti vokiškų šešėlinių"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "tankų armiją anomalijos viduje. Mūsų taikinys dabar"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "yra gilioje jos fazėje. Pasiekite jį užpildydami Magnus."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Mirium erdvės gilumoje buvo aptikta priešo bazė."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Jie planuoja pulti būtent iš jos."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Nekreipkite dėmesio į mergaitę. Mūsų misija yra aktyvuoti"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus ir atverti kelią į giliausią fazę"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "kur galėsite įkalinti priešą visiems laikams."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "Pastebėta priešų bazė giliausioje fazėje."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Nors mes jų negalime nugalėti, galime juos ten įkalinti."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Rinkite Mirium ir nukeliaukite į šio portalo gilumą."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Aš tikiu jumis visais! Mes galime tai padaryti!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Vos užsidarius praeitam, atsivėrė naujas portalas."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Mūsų tikslas išlieka tas pats: rinkti materiją,"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "užverti anomaliją ir sustabdyti invaziją į mūsų realybę. Keliaujam!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Portalas atsivėrė dar kartą. Rinkite materiją ir užpildykite kolektorių."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Mums reikia uždaryti tą prakeiktą anomaliją. Visi likę lauke"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "pasikliauja mumis, bet jie ilgai neatsilaikys!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Babilono kompleksą vis dar puola priešiški tankai."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Rinkite materiją ir užkraukite Magnus. Mums reikia užverti"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "anomaliją ir nutraukti šešėlinių tankų invaziją į mūsų pasaulį."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Taikinys jau netoli. Būkite budrūs ir nenuleiskite akių"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "nuo Nemirtingojo detektoriaus."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Puikiai padirbėjote! Taip ir toliau! Mes čia susirinkome"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "ne arbatos gerti. Mums reikia daugiau Mirium."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Puikus komandinis darbas! Judam toliau, mums reikia daugiau Mirium."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Puikiai padirbėjote! Mums reikia aktyvuoti Magnus ir keliauti dar giliau."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium mus sustiprina su kiekviena nauja faze."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Tik nesiblaškykite."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Mums reikia aktyvuoti Magnus. Dabar jau paskutinį kartą!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Mūsų misija vis dar ta pati: mums reikia užpildyti kolektorių."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Mes artėjame prie invazijos šaltinio."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Mūsų tikslas tas pats: užpildyti kolektorių."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Smagi daina. Tačiau likite budrūs."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Mums reikia rinkti Mirium ir keliauti giliau."

msgid "narrator"
msgstr "Smith"
