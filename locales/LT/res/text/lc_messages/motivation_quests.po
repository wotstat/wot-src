msgid "common/congratulation"
msgstr "Sveikiname! Jūs įvykdėte misiją ir gaunate apdovanojimą"

msgid "common/requirements"
msgstr "Įvykdoma su IV ir aukštesnio lygio technika."

msgid "g1/advice"
msgstr "Jūs galite laimėti mūšį sunaikinę visus priešus arba užėmę priešų bazę. Būkite atsargūs ir nelėkite aklai į priekį. Suderinti komandiniai veiksmai - tai geriausias kelias į pergalę."

msgid "g1/description"
msgstr "Įvykdyti sąlygas 3 mūšiuose iš eilės neprivaloma."

msgid "g1/name"
msgstr "Karo dienos"

msgid "g10/advice"
msgstr "Jūs galite padaryti daug žalos su bet kurio tipo technika. Pasirinkite taikinius į kuriuos pataikysite be problemų, stenkitės išgyventi kuo ilgiau ir jūs būsite maloniai nustebinti skaičiais, kurie puikuosis eilutėje \"Padaryta žala\" mūšio rezultatų lange."

msgid "g10/description"
msgstr "Įvykdyti sąlygas 2 mūšiuose iš eilės neprivaloma."

msgid "g10/name"
msgstr "Sektinas pavyzdys: Žala"

msgid "g2/advice"
msgstr "Sunkieji tankai turi galingus pabūklus ir stiprius priekinius šarvus, kuriuos nelengva pramušti. Dėl šių privalumų, jiems tenka atsisakyti manevringumo, kas leidžia sunkiuosius tankai apvažiuoti ir užpulti iš šonų ar nugaros ir lengvai pramušti į pažeidžiamiausias vietas."

msgid "g2/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g2/name"
msgstr "Tiesiai į dešimtuką: sunkieji tankai"

msgid "g3/advice"
msgstr "Vidutiniai tankai - universalūs kariai, kurie naudingi bet kurioje mūšio vietoje. Jie gali atlikti palaikymo funkciją ar užpulti priešus iš flangų. Neleiskite priešų tankams jūsų apvažiuoti ir sunaikinkite juos pirmiau."

msgid "g3/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g3/name"
msgstr "Tiesiai į dešimtuką: vidutiniai tankai"

msgid "g4/advice"
msgstr "Lengvieji tankai turi silpnus šarvus ir pabūklą, bet šiuos trūkumus jie kompensuoja puikiu greičiu ir maskuote. Pagrindinė lengvųjų tankų užduotis - aptikti priešus ir atkreipti bei blaškyti jų dėmesį."

msgid "g4/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g4/name"
msgstr "Tiesiai į dešimtuką: lengvieji tankai"

msgid "g5/advice"
msgstr "Savaeigiai prieštankiniai pabūklai - grėsmingi oponentai, pasižymintys gera ginkluote ir puikia maskuote. Dažniausiai jiems trūksta manevringumo. Pasistenkite juos aptikti ir kuo greičiau sunaikinti."

msgid "g5/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g5/name"
msgstr "Tiesiai į dešimtuką: SPP"

msgid "g6/advice"
msgstr "Kuo mažiau priešų mašinų lieka, tuo arčiau pergalė. Žaiskite protingai, stenkitės išgyventi ir padaryti kuo daugiau žalos. Naudokitės kraštovaizdžio ypatybėmis, kad šaudydami išliktumėte nepastebėti."

msgid "g6/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g6/name"
msgstr "Renkam kolekciją"

msgid "g7/advice"
msgstr "Kiekviena mašina turi vidinius ir išorinius modulius bei įgulą. Kritiniai pataikymai į juos pablogina priešų mašinos efektyvumą mūšyje. Išstudijuokite mašinų pažeidžiamiausias vietas, tam kad padarytumėte kuo daugiau kritinės žalos priešams ir žinotumėte kokias silpnas vietas paslėpti savoje mašinoje."

msgid "g7/description"
msgstr "Sumuojami visų mašinų rezultatai pasiekti visuose mūšiuose."

msgid "g7/name"
msgstr "Pramušantys šūviai"

msgid "g8/advice"
msgstr "Vienas iš būdų laimėti mūšį - užimti priešų bazę. Kai priešų tankai užsiėmę kova, jūs galite nepastebimai prasmukti ir užimti bazę. Nepamirškite, kuo daugiau tankų bazės apskritime, tuo greičiau užimama bazė. Maksimalus bazės užėmimo greitis pasiekiamas, kai bazės apskritime yra 3 mašinos."

msgid "g8/name"
msgstr "Atsarginis planas"

msgid "g9/advice"
msgstr "Jūs gaunate patirtį už priešų aptikimą, žalos darymą priešams, priešų technikos naikinimą, priešų bazės užėmimą, savos bazės gynybą ir už mūšio laimėjimą."

msgid "g9/description"
msgstr "Įvykdyti sąlygas 2 mūšiuose iš eilės neprivaloma."

msgid "g9/name"
msgstr "Sektinas pavyzdys: Patirtis"

msgid "group"
msgstr "Naujoko apmokymai"
