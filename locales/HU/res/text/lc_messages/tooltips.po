msgid "notrecruitedtankman/oow21_strategist_commander/desc"
msgstr "Egy \"régimódi\" tiszt. Hidegvérű és megfontolt, gyorsan, de nem kapkodva hoz döntéseket. Tisztában van azzal, hogy a legapróbb tervezési hiba is milyen nagy árat okozhat."

msgid "notrecruitedtankman/oow21_strategist_commander/event"
