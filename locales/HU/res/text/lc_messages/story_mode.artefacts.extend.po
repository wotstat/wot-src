msgid "battleship/name"
msgstr "Füstjelző"

msgid "battleship/shortDescr"
msgstr "Egy füstjel, ami megjelöli a területet a csatahajó tüzérségi sortüzéhez, amely sebzést okoz az ott található ellenséges felszereléseknek és objektumoknak."

msgid "distraction_ability/name"
msgstr "Hamis parancs"

msgid "distraction_ability/shortDescr"
msgstr "Gefreiter Keller a zsákmányolt német rádió segítségével hamis parancsot küld, amely az ellenséget egy meghatározott hely felderítésére utasítja."

msgid "recon_ability/name"
msgstr "Felderítés"

msgid "recon_ability/shortDescr"
msgstr "Küldd el Dubois századost egy bizonyos terület felderítésére. A felderítés során a harckocsi megáll és mozdulatlan marad. A képesség addig tart, amíg meg nem szakítod."

msgid "scc_airstrike_ability/name"
msgstr "Légi támogatás"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Kérj légicsapást egy kijelölt pozícióra."
