msgstr "AN/GRC-7"

msgid "AN-VRC-7_IGR"
msgstr "AN/VRC-7"

msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Ez a kísérleti tank az AMX 13 egy továbbfejlesztése volt. A jármű átment a teszteken, de nem került sorozatgyártásba és szolgálatba. Mindössze két példány készült el."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

