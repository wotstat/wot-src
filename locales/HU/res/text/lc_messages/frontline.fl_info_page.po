msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}}. vagy {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}}. szint"

msgid "reserveCategories/ranks/captain"
msgstr "Százados"

msgid "reserveCategories/ranks/general"
msgstr "Tábornok"

msgid "reserveCategories/ranks/lieutenant"
msgstr "Hadnagy"

