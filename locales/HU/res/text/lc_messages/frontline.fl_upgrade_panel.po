msgid "alert"
msgstr "Aktív harc közben nem választhatsz harci tartalékot."

msgid "description/one/reserve"
msgstr "A(z) %(reserve_name)s tartalék ismételt kiválasztásával\njavíthatod annak tulajdonságait."

msgid "description/second/reserve"
msgstr "A(z) %(first_reserve_name)s vagy %(second_reserve_name)s tartalék ismételt kiválasztásával\njavíthatod annak tulajdonságait."

