msgid "singleRewardView/tooltip/description/"
msgstr "Ha már rendelkezel az összes járművel a modulok lehetséges tartalmainak listájáról, akkor a modulokból kapott minden további járműért aranykompenzációt kapsz."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) modul"
msgstr[1] "%(remainingCount) modul"
msgstr[2] "%(remainingCount) modul"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "A garantált jutalom egy jármű a modulok lehetséges tartalmainak listájáról.\nHa kinyitsz %(remainingCount) modult anélkül, hogy kapnál egy ilyen járművet, akkor %(count). modulod kinyitásakor kapsz egyet. Amikor járművet kapsz, a számláló visszaáll alaphelyzetbe."
