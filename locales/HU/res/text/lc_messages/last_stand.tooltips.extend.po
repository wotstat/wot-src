msgid "Contact/status/inBattle/last_stand"
msgstr "Túlélő csatában"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Lead egy lövést, amely sebzi a célpontot és minden ellenséges járművet a célpont 35 méteres sugarú körzetében."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Lead egy lövést, amely életerőt állít vissza úgy, hogy ellopja azt a célponttól és az ahhoz közeli ellenséges járművektől egy 35 méteres sugarú körben."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Lead egy lövést, amely elkábítja a célpontot és minden ellenséges járművet a célpont 35 méteres sugarú körzetében."

msgid "advanced/ls_damageShield"
msgstr "10 másodpercig védelmet nyújt bármilyen sérülés ellen (kivéve az ütközést, a fulladást és a leesést)."

msgid "advanced/ls_doubleDamage"
msgstr "A következő sikeres lövésed dupla sebzést okoz."

msgid "advanced/ls_equipment"
msgstr "A taktikai eszközök segítségével hatékonyabban harcolhatsz a Túlélő csatáiban, így könnyebben teljesítheted a szakaszokat, és szerezhetsz értékes jutalmakat. A felszerelésükhöz kattints a taktikai eszközök valamelyik férőhelyére."

msgid "advanced/ls_extraDamageSituational"
msgstr "Esélyt ad arra, hogy megnövelt sebzést okozz egy ellenséges járműnek."

msgid "advanced/ls_fastReload"
msgstr "Növeli a tűzgyorsaságot / újratölti a tárat."

msgid "advanced/ls_healSituational"
msgstr "Visszaállítja a járműved életerejének egy részét egy ellenséges jármű megsemmisítése után."

msgid "advanced/ls_invisibility"
msgstr "Átmenetileg megakadályozza, hogy az ellenség célba vegye a járművedet, életerőpontokat állít vissza, megjavítja a modulokat, eloltja a tüzet, eltávolítja a kábítást, és meggyógyítja a legénység összes sérült tagját."

msgid "advanced/ls_nitro"
msgstr "Átmenetileg növeli a járműved mobilitását."

msgid "advanced/ls_nitroSituational"
msgstr "Átmenetileg megnöveli a járműved mobilitását, miután egy ellenséges járműtől sebzést kaptál."

msgid "advanced/ls_selfRepairKit"
msgstr "Visszaállítja az életerőt, eloltja a tüzet, eltávolítja a kábítást és megjavítja a sérült modulokat."

msgid "advanced/ls_teamRepairKit"
msgstr "Megjavítja a modulokat, eloltja a tüzet, eltávolítja a kábítást és visszaállít valamennyi életerőt a hatósugarában lévő szövetséges járműveknek."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "A taktikai eszközöket különleges férőhelyekre szerelheted fel, hogy hatékonyabban harcolhass a Túlélő csatáiban, teljesíthesd a szakaszokat, és értékes jutalmakat szerezhess."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktikai eszköz férőhely"
