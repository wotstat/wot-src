msgid "mode/halloween/battlePassTooltip/body"
msgstr "A {whiteSpanish_open}Babilon: Sötét torony{whiteSpanish_close} esemény némelyik küldetésében Battle Pass-pontokat is gyűjthetsz."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Battle Pass-pontok"

msgid "mode/halloween/calendar"
msgstr "Az esemény eddig tart: %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Az esemény vége: %(date)s."

msgid "mode/halloween/description"
msgstr "Harcolj, és gyűjts anyagot!\nCsaták különleges járművekkel."

msgid "mode/halloween/performance/highRisk/description"
msgstr "A számítógéped teljesítménye nem megfelelő ehhez a módhoz. Problémákat tapasztalhatsz a grafikával és a jármű mozgásával kapcsolatban. Előfordulhat, hogy a játékkliens összeomlik."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Alacsony teljesítmény"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Alacsony teljesítmény"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Ez a játékmód nagy teljesítményű számítógépet igényel.\nProblémákat tapasztalhatsz a pálya betöltése, a grafika és a jármű mozgása kapcsán. Ha nem megfelelő a teljesítmény, próbáld meg csökkenteni a grafika minőségét a beállításaid között!"

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Csökkentett teljesítmény"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Csökkentett teljesítmény"
