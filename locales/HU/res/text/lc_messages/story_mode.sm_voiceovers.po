msgid "vo_sm_char10_m05_stg28_01"
msgstr "Főhadiszállás: A part tiszta. Küldjük a fő erőket. Kiváló munka."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Főhadiszállás: Tartsák a pozíciót! Úton van az erősítés."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Főhadiszállás: Mindenáron védjék meg a partvonalat!"

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Főhadiszállás: Új tank, újabb esély. Ezúttal óvatosan!"

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Főhadiszállás: Fogynak a tartalékaink. Ezt ne pocsékolja el, parancsnok!"

