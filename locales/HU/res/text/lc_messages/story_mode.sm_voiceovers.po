msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire-pilóta: Rosszak a látási viszonyok, nem tudok segíteni!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire-pilóta: Túl erős a légvédelmi tűz, nem tudok segíteni!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire-pilóta: Erős légvédelmi tűz, a tűz irányítása nem lehetséges."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire-pilóta: Mintha légvédelmi hóvihar lenne idefent, mi?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire-pilóta: Ilyen sortűz alatt nem tudjuk irányítani a hajó tüzét."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire-pilóta: Meg kell semmisíteni azokat a légvédelmi ütegeket a bunkerek mellett."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire-pilóta: Sikerült lejjebb süllyednem."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire-pilóta: Most már elkezdhetem behívni a nagyágyúkat a földi füstjelek segítségével."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire-pilóta: Tankok, ti jöttök!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire-pilóta: Kiszúrtam a füstöt."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire-pilóta: Továbbítom a koordinátákat a csatahajónak, hogy közvetlen csapást mérjenek rá."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire-pilóta: A francba, az egyikünket leszedték! Még mindig nem tudok lejjebb menni."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire-pilóta: Most azonnal ki kell iktatni a többi légvédelmi ágyút!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire-pilóta: A légvédelmi lövegeknek annyi, lejjebb ereszkedem. Készen állunk arra, hogy intenzívebb tüzet irányítsunk a csatahajónkról."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire-pilóta: Figyelem! Egy nagy ellenséges csoportot észleltünk, amely felétek tart."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire-pilóta: Mindent bevetnek, amijük csak van."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire-pilóta: Figyelem! Újabb ellenséges csoport közeledik. Legyetek résen odalent!"

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire-pilóta: Figyelem! Az utolsó, egyben legnagyobb ellenséges hullám közeledik."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire-pilóta: Minden oldalról közelednek. Készüljetek fel!"

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire-pilóta: Tisztán látom a füstjelet. A koordinátákat átadtam a csatahajónak."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire-pilóta: Ott van a füstjelünk. Továbbítom a pozíciót a csatahajónak."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire-pilóta: Füst a célponton. Küldöm a pontos koordinátákat a csatahajónak."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire-pilóta: Úgy tűnik, a barátainknak segítségre van szükségük."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "A USS Frankford parancsnoka: Várom a koordinátákat a tűztámogatáshoz."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "A USS Frankford parancsnoka: Nem tüzelhetünk vakon, mert még eltaláljuk a sajátjainkat."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "A USS Frankford parancsnoka: Pontos célpontok kellenek, addig nem tüzelünk."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "A USS Frankford parancsnoka: Itt a USS Frankford parancsnoka. Negatív."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "A USS Frankford parancsnoka: Nem tudjuk támogatni az előrenyomulást. Túl rosszak a látási viszonyok."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "A USS Frankford parancsnoka: Nem látjuk a szirtet és a bunkereket, csak a tankjainkat látjuk a parton."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "A USS Frankford parancsnoka: A tankok a szirtek felé közelednek."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "A USS Frankford parancsnoka: Támogatjuk őket, és tüzet nyitunk abba az irányba."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "A USS Frankford parancsnoka: Remélem, ez a Sherman tudja, hova lő."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "A USS Frankford parancsnoka: A Sherman célpontot váltott. Hozzáigazítjuk a célpontot."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "A USS Frankford parancsnoka: A Sherman abbahagyta a tüzelést. A munkánk itt befejeződött."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "A USS Frankford parancsnoka: Nem tudjuk elérni a szárazföldön beljebb lévő bunkereket."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "A USS Frankford parancsnoka: Visszahúzódunk biztonságos távolságba. Sok szerencsét a parton!"

