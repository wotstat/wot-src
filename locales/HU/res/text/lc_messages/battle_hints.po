msgid "hint/LSH_FIRE"
msgstr "A füst megnehezíti az ellenséges járművek felderítését és a helyzetük jelentését. A tűz sérülést okoz a járműveknek."

msgid "hint/LSH_FOG"
msgstr "A köd megnehezíti az ellenséges járművek felderítését és a helyzetük jelentését."

msgid "hint/LSH_RAIN"
msgstr "A zivatar megnehezíti az ellenséges járművek felderítését és a helyzetük jelentését."

msgid "hint/LSH_SANDSTORM"
msgstr "A homokvihar megnehezíti az ellenséges járművek felderítését és a helyzetük jelentését."

msgid "hint/LSH_SMOKE"
msgstr "A füst megnehezíti az ellenséges járművek felderítését és a helyzetük jelentését."

msgid "hint/PPH_AIMING_01"
msgstr "A jármű és a torony mozgása csökkenti a <font color='#EE7000'>löveg pontosságát</font>"

msgid "hint/PPH_AIMING_02"
msgstr "A célkereszt körüli kör jelzi a <font color='#EE7000'>löveg pontosságát</font>. Várj egy kicsit, hogy pontosabban tüzelhess."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "Az <font color='#EE7000'>automatikus célzás</font> be van kapcsolva. Kattints a jobb egérgombbal, hogy kikapcsold."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Az automatikus célzás mindig a célba vett jármű <font color='#EE7000'>közepére</font> irányítja a lövegedet"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "<font color='#EE7000'>Foglalják</font> a bázisodat! Ha nem vered vissza az ellenséget, megnyeri a csatát."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Minden ellenséges jármű <font color='#EE7000'>saját</font> foglalási folyamattal rendelkezik"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Az ellenség bázisának <font color='#EE7000'>elfoglalása</font> jelenti a csata megnyerésének egyik módját"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Ha a járműved sebzést szenved el, a foglalási folyamat <font color='#EE7000'>újraindul</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Ha elhagyod a foglalókört, a foglalási folyamat <font color='#EE7000'>elveszik</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Több jármű <font color='#EE7000'>gyorsabban</font> tud elfoglalni egy bázist"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "A <font color='#EE7000'>harmadik</font> jármű után a foglalási sebesség már nem nő"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Majdnem elfoglaltátok az ellenséges bázist!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "A csapatod győzelemre áll a bázisfoglalási versenyben!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "A járműmodul kritikusan megsérült! Használd <font color='#EE7000'>a javítókészletet</font> az alsó panelen, hogy megjavítsd azt."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "A járműmodul kritikusan megsérült! Használd <font color='#EE7000'>a javítókészletet</font> az alsó panelen a megjavításához!"

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Egy harckocsizó megsérült! Használd <font color='#EE7000'>az elsősegélykészletet</font> az alsó panelen, hogy meggyógyítsd őt."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Egy harckocsizó megsérült! Használd <font color='#EE7000'>az elsősegélykészletet</font> az alsó panelen a meggyógyításához!"

msgid "hint/PPH_CONSUMABLES_05"
msgstr "A jármű legénysége elkábult! Használd <font color='#EE7000'>az elsősegélykészletet</font> az alsó panelen, hogy ellásd őket."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "A jármű kigyulladt! Használd <font color='#EE7000'>a tűzoltókészüléket</font> az alsó panelen."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "A jármű kigyulladt! Aktiválódott az automatikus <font color='#EE7000'>tűzoltó készülék</font>."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Egy járműmodul kritikusan megsérült! Ha a csata előtt felszereled a járművet egy <font color='#EE7000'>javítókészlettel</font>, az segíthet a kritikus találatok megjavításában."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Egy harckocsizó megsérült! Ha a csata előtt felszereled a járművet egy <font color='#EE7000'>elsősegélykészlettel</font>, az segíthet a legénység sérüléseinek meggyógyításában."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "A jármű kigyulladt! Ha a csata előtt felszereled a járművet egy <font color='#EE7000'>tűzoltókészülékkel</font>, az segíthet a tűz eloltásában."

msgid "hint/PPH_OTHER_01"
msgstr "Az ellenség <font color='#EE7000'>felderített</font> – a tüzelés felfedheti a pozíciódat!"

msgid "hint/PPH_OTHER_02"
msgstr "A járműved megsemmisült. Az <font color='#EE7000'>Esc</font> billentyű megnyomásával büntetés nélkül elhagyhatod a csatát."

msgid "hint/PPH_OTHER_03"
msgstr "A járműved megsemmisült. Használd az egérgombokat a szövetséges járművek <font color='#EE7000'>megfigyeléséhez</font>."

msgid "hint/PPH_OTHER_04"
msgstr "A <font color='#EE7000'>villanykörte ikon</font> jelzi, ha az ellenség felderítette a járművedet!"

msgid "hint/PPH_OTHER_05"
msgstr "A löveged <font color='#EE7000'>újratöltése</font> még folyamatban van"

msgid "hint/PPH_OTHER_06"
msgstr "Csak akkor sütheted el a lövegedet, ha a célkereszt körüli kör <font color='#EE7000'>teljesen zöld</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Használd az egérgörgőt, hogy <font color='#EE7000'>Mesterlövész módra</font> válts"

msgid "hint/PPH_SNIPER_02"
msgstr "Használd az egérgörgőt, hogy <font color='#EE7000'>kilépj</font> a Mesterlövész módból"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "A <font color='#EE7000'>belső zöld célkereszt</font> azt jelzi, hogy a lövedék nagy eséllyel át fogja ütni az ellenséges jármű páncélzatát"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Az, hogy a belső célkereszt zöld, még <font color='#EE7000'>nem garantálja</font> az átütő találatot"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "A lövegek pontossága nem 100%-os, úgyhogy a lövések <font color='#EE7000'>nem mindig a célkereszt közepén csapódnak be</font>"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "A belső célkereszt megmutatja, hogy mekkora eséllyel ütöd át az ellenség páncélzatát. <font color='#EE7000'>Ezt a Beállítások között kapcsolhatod be</font>."

msgid "penetration/chance/high"
msgstr "Nagy valószínűség"

msgid "penetration/chance/low"
msgstr "Kis valószínűség"

msgid "penetration/chance/medium"
msgstr "Közepes valószínűség"
