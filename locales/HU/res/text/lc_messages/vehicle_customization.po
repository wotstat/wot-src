msgstr "Fehér sivatag"

msgid "special_style/bp2021_2_desc"
msgstr "Egy négyévszakos stílus, amit a Battle Pass: 4. szezonjának egyik szakasza során lehetett megszerezni."

msgid "special_style/bp2021_3"
msgstr "Jégkabát"

msgid "special_style/bp2021_3_desc"
msgstr "Egy négyévszakos stílus, amit a Battle Pass: 4. szezonjának egyik szakasza során lehetett megszerezni."

