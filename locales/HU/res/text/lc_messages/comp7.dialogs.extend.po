msgid "comp7/deserter/cancel"
msgstr "Mégse"

msgid "comp7/deserter/message"
msgstr "Ez a csata még nem ért véget. Ha elhagyod a csatát, mielőtt az véget érne, akkor cserbenhagyod a csapatodat.\n{brown_open}Az értékelésed csökkenni fog, és ki leszel tiltva a mód csatáiból. {brown_close}\nBiztosan el akarod hagyni a csatateret?"

msgid "comp7/deserter/msgTitle"
msgstr "El fogod veszíteni az értékelési pontjaidat!"

msgid "comp7/deserter/submit"
msgstr "Dezertálás"

msgid "comp7/deserter/title"
msgstr "Dezertálás a csatamezőről"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Megsértetted a játékszabályzatot ezen a pályán: {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}, ekkor: {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} értékelési pontot vesztettél, továbbá átmenetileg kitiltottunk a {whiteSpanish_Open}Roham{whiteSpanish_Close} játékmód csatáiból."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Megsértetted a játékszabályzatot ezen a pályán: {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close}, {whiteSpanish_Open}%(time)s{whiteSpanish_Close}-kor.\nÁtmenetileg ki lettél tiltva a {whiteSpanish_Open}Roham{whiteSpanish_Close} játékmód csatáiból, és csökkent az értékelésed."
