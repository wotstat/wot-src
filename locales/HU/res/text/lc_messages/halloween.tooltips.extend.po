msgid "Contact/status/inBattle/halloween"
msgstr "Babilon: Sötét torony csatában"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Lead egy lövést, amely megsebzi és elkábítja a célpontot, valamint minden ellenséges járművet a célpont 35 méteres sugarú körzetében."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Lead egy lövést, amely életerőt állít vissza úgy, hogy ellopja azt a célponttól és az ahhoz közeli ellenséges járművektől egy 35 méteres sugarú körben."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Lead egy lövést, amely elkábítja a célpontot és minden ellenséges járművet a célpont 35 méteres sugarú körzetében."

msgid "advanced/hw_damageShield"
msgstr "Védelmet nyújt bármilyen sérülés ellen 7 másodpercig (kivéve az ütközést, a fulladást és a leesést)."

msgid "advanced/hw_fastReload"
msgstr "Növeli a tűzgyorsaságot / újratölti a tárat."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Visszaállítja az életerőt, eloltja a tüzet, eltávolítja a kábítást és megjavítja a sérült modulokat."

msgid "advanced/hw_invisibility"
msgstr "Átmenetileg láthatatlanná teszi a járművedet az ellenség számára, életerőpontokat állít vissza, megjavítja a modulokat, eloltja a tüzet, eltávolítja a kábítást, és meggyógyítja a legénység összes sérült tagját."

msgid "advanced/hw_teamRepairKit"
msgstr "Megjavítja a modulokat, eloltja a tüzet, eltávolítja a kábítást és visszaállít valamennyi életerőt a hatósugarában lévő szövetséges járműveknek."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "A harci képességek segítségével hatékonyabban harcolhatsz a Babilon: Sötét torony csatáiban, így könnyebben teljesítheted a feladatokat, és értékes jutalmakat szerezhetsz. A felszerelésükhöz kattints a harci képességek valamelyik férőhelyére."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Harciképesség-férőhelyek"

msgid "hwShell/alt/description"
msgstr "%(bold)s a csatában szerezhető egy bizonyos valószínűséggel, miután megsemmisítettél egy ellenséget."

msgid "hwShell/alt/description/bold"
msgstr "Alternatív lőszer"
