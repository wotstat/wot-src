msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Az összes okozott sebzés és a megvívott csaták számának aránya az időszakban. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Megsemmisített ellenséges járművek és megvívott csaták aránya."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "A játékmenet alatt használt járművek átlagos szintje."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Az összes szerzett tapasztalat és a megvívott csaták számának aránya az időszakban. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Az összes felfogott sebzés és a megvívott csaták számának aránya az időszakban. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Az általad felderített és a lánctalp megsemmisítésével mozgásképtelenné tett ellenséges járműveknek okozott összes sebzés a szövetségeseid által és a megvívott csaták számának aránya az időszakban. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Az \"Okozott sebzés\" és \"Elszenvedett sebzés\" paraméterek aránya. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "A játékos által megsemmisített járművek számának és annak az aránya, hogy a játékos járműve hányszor semmisült meg az időszakban. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Felderített ellenséges járművek és megvívott csaták aránya a játékmenetben."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Azon csaták százalékos aránya, melyeken a játékos járműve nem semmisült meg."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Győzelmek százalékos aránya normál csatákban a játékmenetben. A delta jelöli az aktuális játékmenet hatását az összesített paraméterre."

msgid "propertyInfo/prop/descr/wins"
msgstr "A győzelmek száma normál csatákban az időszak alatt. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

msgid "propertyInfo/prop/descr/wtr"
msgstr "A WTR a teljes időszak átlagos értékei alapján. A delta a jelenlegi játékmenet hatását jelöli a teljes paraméterre."

