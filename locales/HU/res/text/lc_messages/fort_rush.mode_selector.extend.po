msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s X-es&nbsp;szint"

msgid "mode/fort_rush_battle/description"
msgstr "Foglald el az antennákat! Tartsd fenn a hálózatot! Biztosítsd az adatátvitelt!"

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "A számítógéped teljesítménye nem megfelelő ehhez a módhoz. Problémákat tapasztalhatsz a grafikában és a jármű mozgásában. Előfordulhat, hogy a játékkliens összeomlik."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Alacsony teljesítmény"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Alacsony teljesítmény"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Ez a játékmód nagy teljesítményű számítógépet igényel. Problémákat tapasztalhatsz a pálya betöltésekor, a grafikában és a jármű mozgásában. Ha nem megfelelő a teljesítmény, akkor próbáld meg csökkenteni a grafika minőségét a beállításokban!"

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Csökkentett teljesítmény"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Csökkentett teljesítmény"
