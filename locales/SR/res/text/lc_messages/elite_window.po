msgid "elite_window/buttons/ok"
msgstr "Potvrdno!"

msgid "elite_window/buttons/post_progression"
msgstr "Ka modifikaciji"

msgid "elite_window/buttons/vanity_progression"
msgstr "Na Elitne nagrade"

msgid "elite_window/elite/description"
msgstr "Elitni status se dodeljuje vozilima sa svim dostupnim modulima, unapređenjima i tehničkim granama izučenim, uključujući vozila iz naknadnog nivoa. Borbeno iskustvo zarađeno u elitnom vozilu može biti pretvoreno u slobodno iskustvo upotrebom zlata ili upotrebljeno da se ubrza trening posade."

msgid "elite_window/elite/title"
msgstr "Elitni status"

msgid "elite_window/post_progression/description"
msgstr "Modifikacija u polju je sada dostupna"

msgid "elite_window/prestige/description"
msgstr "Nakon dobijanja elitnog statusa, vozilo počinje da zarađuje elitne poene i dobija elitne nivoe koji predstavljaju tvoju posvećenost određenom vozilu. Odgovarajući Ševron se prikazuje u borbi nakon što dobiješ prvi elitni nivo."

msgid "elite_window/prestige/title"
msgstr "Elitni sistem"

msgid "elite_window/title"
msgstr "ELITNI STATUS JE DOBIJEN"

msgid "elite_window/vanity_progression/description"
msgstr "Primite ekskluzivne nagrade za vozila nivoa XI uključujući jedinstven volumetrijski stil, pratioc statistike i oblogu topa!"

msgid "elite_window/vanity_progression/title"
msgstr "Sistem elitnih nagrada je sada dostupan"
