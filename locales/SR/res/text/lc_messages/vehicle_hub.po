msgid "abilities/special/shortDescription/accuracyStacks"
msgstr "Povećava preciznost sledećeg pogotka, sa pristojnom stabilizacijom pri punoj kalibraciji."

msgid "abilities/special/shortDescription/autoreloaderSurge"
msgstr "Momentalno smanjuje punjenje granate na kratko fiksirano vreme."

msgid "abilities/special/shortDescription/auxiliaryRocketLauncher"
msgstr "Ispaljuje nevođenu fugasnu raketu sa koaksijalnog lansera nezavisno od glavnog topa."

msgid "abilities/special/shortDescription/battleFury"
msgstr "Svaki pogodak na neprijateljsko vozilo pojačava brzinu punjenja topa na ograničeno vreme."

msgid "abilities/special/shortDescription/bustleFeed"
msgstr "Ispaljuje granate visoke štete po cenu pokretljivosti i hlađenja."

msgid "abilities/special/shortDescription/chargeShot"
msgstr "Skuplja nivoe toplote kako bi izazvao više štete neprijateljskim vozilima sledećim pogotkom."

msgid "abilities/special/shortDescription/chargeableBurst"
msgstr "Rafalna kaseta koja ti dozvoljava da ispališ dve granate brzo."

msgid "abilities/special/shortDescription/concentrationMode"
msgstr "Maksimizuje stabilizaciju tokom kretanja i okretanja za preciznije gađanje."

msgid "abilities/special/shortDescription/extraShotClip"
msgstr "Automatski započinje punjenje poslednje granate, koja se još može ispaliti tokom punjenja."

msgid "abilities/special/shortDescription/heatingZonesGun"
msgstr "Aktivan sistem hlađenja topa koji poboljšava preciznost dok se top hladi."

msgid "abilities/special/shortDescription/improvedRamming"
msgstr "Povećava štetu nanetu udarom na neprijateljskim vozilima."

msgid "abilities/special/shortDescription/lowChargeShot"
msgstr "Specijalna mehanika topa koja dozvoljava ranije pucanje po ceni efikasnosti hica."

msgid "abilities/special/shortDescription/overheatGun"
msgstr "Sistem dozvoljava neprekidnu vatru bez punjenja i kontroliše kako top stvara toplotu prilikom pucanja."

msgid "abilities/special/shortDescription/overheatStacks"
msgstr "Mirovanjem ili kretanjem polako povećava štetu i preciznost sledećeg pogotka."

msgid "abilities/special/shortDescription/pillboxSiegeMode"
msgstr "Drastično povećava preciznost i brzinu punjenja topa, ali ograničava mobilnost."

msgid "abilities/special/shortDescription/powerMode"
msgstr "Pruža pojačanje snazi motora, dodaje maksimalnu brzinu što se duže vozilo kreće."

msgid "abilities/special/shortDescription/propellantAfterburnerGun"
msgstr "Sistem se puni da pojača štetu. Što je veće punjenje, to je veća šteta."

msgid "abilities/special/shortDescription/rechargeableNitro"
msgstr "Busteri koji se mogu aktivirati bilo kada i koji pružaju oštrinu brzine."

msgid "abilities/special/shortDescription/shellCalibration"
msgstr "Pogodak u vidljivo neprijateljsko vozilo povećava štetu ili probojnost sledeće granate."

msgid "abilities/special/shortDescription/shellParamsSwitcher"
msgstr "Top ima specijalan uređaj koji dozvoljava da neki parametri granate budu promenjeni pre pucanja."

msgid "abilities/special/shortDescription/sightPointer"
msgstr "Povećava domet vidokruga i uočava pokretna vozila i vozila sakrivena iza rastinja u uskom sektoru."

msgid "abilities/special/shortDescription/stagedJetBoosters"
msgstr "Potisnici na čvrsto gorivo koji povećavaju ubrzanje, pokretljivost i upravljivost."

msgid "abilities/special/shortDescription/stanceDance"
msgstr "Puni jednu ili dve jedinstvene sposobnosti, povećavajući brzinu i povećavajući preciznost topa."

msgid "abilities/special/shortDescription/stationaryReload"
msgstr "Dozvoljava prekid punjenja i omogućuje pucanje u kritičnim momentima."

msgid "abilities/special/shortDescription/supportWeapon"
msgstr "Dodatna oružja koja pružaju povećanu vatrenu moć uz glavni top."

msgid "abilities/special/shortDescription/targetDesignator"
msgstr "Povećava vreme uočavanja i štetu naprijateljskim vozilima i označava ih specijalnim markerom."

msgid "abilities/special/shortDescription/twinGun"
msgstr "Dozvoljava pucanje iz oba topa odjednom po cenu povećanog vremena punjenja."

msgid "abilities/special/shortDescription/wheeledDash"
msgstr "Specijalna mehanika koja pojačava snagu motora, ubrzanje i maksimalnu brzinu na kratko vreme."

msgid "characteristics/abilities/special/description/accuracyStacks"
msgstr "Ostajući nepokretan ili krećući se ispod određene brzine dozvoljava tvom vozilu da kalibriše svoj analogni balistički kompjuterski uređaj i sakupi nivoe preciznosti povećavajući preciznost tvog sledećeg hica. Ako pređeš granicu brzine, tvoj napredak u građenju preciznosti će biti prekinut dok ne usporiš. Na najvećem nivou preciznosti, tvoje vozilo dobija pristojnu stabilizaciju topa, sa smanjenim rasipanjem zbog kretanja ili rotiranja kupole/trupa. Efekat se uklanja nakon pucanja."

msgid "characteristics/abilities/special/description/auxiliaryRocketLauncher"
msgstr "ovo vozilo je opremljeno sa raketnim lanserom monitranim na štit topa. Aktiviraj sposobnost da pređeš na nišan za sekundarno oružije i zatim lansiraj nevođenu fugasnu raketu dugmetom za paljbu."

msgid "characteristics/abilities/special/description/battleFury"
msgstr "Svaki put kada pogodiš vidljivog protivnika granatom, dobijaš nivo efikasnosti punjenja, koji privremeno pojačavaju brzinu punjenja topa. Nivoi se akumuliraju sa svakim pogotkom, i uništenje neprijatelja granatom dodaje dodatne nivoe efikasnosti punjenja."

msgid "characteristics/abilities/special/description/bustleFeed"
msgstr "Modul za dovod spoljne municije na ovom vozilu mu dozvoljava da ispaljuje snažne jedinstvene granate koje nanose povećanu štetu. Dok je aktivan, modul takođe smanjuje pokretljivost i brzinu vatre."

msgid "characteristics/abilities/special/description/chargeShot"
msgstr "Ako je tvoj top napunjen, možeš da počneš da zagrevaš svoj sledeći hitac. Što je taj nivo toplote veći, to će veći biti bonus na prosečnu štetu biti. Tokom procesa zagrevanja ne možeš da menjaš granate. Kada dostigneš maksimalan nivo zagrejanosti počinje odbrojavanje. Ako ne opališ pre nego što se završi, nećeš moći da pucaš nekoliko sekundi."

msgid "characteristics/abilities/special/description/chargeableBurst"
msgstr "Postizanje da pogotka koji su probili oklop neprijateljskim vozilima aktivira rafalni režim, ubacuje rafalnu kasetu koja omogućava da budu ispaljene dve granate u brzom vremenskom roku sa sledećim hicem."

msgid "characteristics/abilities/special/description/concentrationMode"
msgstr "Pneumatski žiro-stabilizator pruža maksimalnu stabilnost tokom pokreta trupa i kupole na kratko vreme, što dozvoljava preciznije gađanje u pokretu i bržu reakciju na iznenadne napade."

msgid "characteristics/abilities/special/description/extraShotClip"
msgstr "Sistem automatski počinje punjenje nove kasete kada preostane jedna granata u trenutnoj kaseti. Ispaljivanje poslednje granate dok se nova kaseta puni dodaje nekoliko sekundi na preostalo vreme punjenja. Pritiskom na taster \"ponovno punjenje kontejnera granata\" odbacuje sve preostale granate osim poslednje. Pritisni taster dva puta da poništiš potpuno napunjenu kasetu."

msgid "characteristics/abilities/special/description/heatingZonesGun"
msgstr "Sistem drži top ohlađenim, dozvoljavajući veoma precizno pucanje. Top se zagreva tokom pucanja, ali počinje da se hladi i vraća se na poboljšane parametre tokom punjenja. što je veća temperatura, to su više izmenjeni njegovi parametri."

msgid "characteristics/abilities/special/description/improvedRamming"
msgstr "Ovo vozilo je specijalno podešeno za napade udarima, sa serijom modifikacija dizajna koje mu pomažu da nanese više štete prilikom udara neprijateljskih vozila."

msgid "characteristics/abilities/special/description/lowChargeShot"
msgstr "Top ovog vozila može da puca ranije: pucnji jednog punjenja, ispaljeni tokom ponovnog punjenja imaju smanjenu efikasnost, dok regularni pucnji sa punim punjenjem nakon završenog punjenja imaju optimalne balističke parametre."

msgid "characteristics/abilities/special/description/overheatGun"
msgstr "Top može da puca neprekidno bez potrebe za punjenjem. Svaki hitac stvara toplotu: Što je veća temperatura, to se više neki od njegovih parametara menjaju. Konstantno pucanje će dovesti do pregrevanja topa, sprečavajući dalje pucanje dok se ne ohladi."

msgid "characteristics/abilities/special/description/overheatStacks"
msgstr "Ostajući nepokretan ili krećući se ispod određene brzine stvara pregrejanje, koje povećava prosečnu štetu i preciznost tovg sledećeg hica. Prekoračenje brzine postepeno smanjuje bonus dok ga pucanje ili promena granate momentalno poništava. Na maksimalnom nivou pregrejanja oklop neprijateljskog vozila koje ima manje poena izdržljivosti nego tvoja prosečna šteta - uključujući tvoj sakupljeni bonus pregrejanja - će prozrokovati eksploziju njegovog spremišta za municiju, momentalno uništavajući vozilo."

msgid "characteristics/abilities/special/description/pillboxSiegeMode"
msgstr "U ovom režimu, preciznost topa, brzina punjenja i uglovi elevacije/depresije su drastično povećani, ali je pokretljivost (brzina napred/nazad i brzina vertikalnog i horizontalnog pomeranja) ozbiljno ograničena. Procentualne vrednosti su date za poređenje sa opsadnim režimom."

msgid "characteristics/abilities/special/description/powerMode"
msgstr "Režim direktni pogon pruža značajno povećanje snage motora i maksimalne brzine kretanja napred. Što duže voziš napred, veća je skupljena brzina, što ti omogućava da se krećeš preko bojnog polja sa lakoćom."

msgid "characteristics/abilities/special/description/propellantAfterburnerGun"
msgstr "Tokom vremena sistem automatski sakuplja punjenje koje se delimično troši da pojača štetu prilikom pucanja. Što je veće punjenje to je veća bonus šteta. U startu sistem sakuplja punjenje samo do oderđene granice. Gašenje graničnika dozvoljava još veće sakupljanje punjenja što odaje mnogo veći bonus štete ali smanjuje ponašanje topa."

msgid "characteristics/abilities/special/description/rechargeableNitro"
msgstr "Busteri tečnog goriva daju nagli porast snage motora, omogućavajući da stekneš pozicionu prednost na bojnom polju - ali ograničavajući brzinu kretanja unazad i okretanja vozila. Mogu se uključiti ili isključiti u bilo kom trenutku, osim nakon pregrevanja. Busteri se zagrevaju dok su aktivni i postaju nedostupni dok se ne ohlade, što znači da se ne mogu koristiti neprekidno - dok će ih prekoračenje pregrevanja privremeno potpuno onesposobiti. Pažljivo planiraj pokrete kako bi izbegao da te zateknu nespremnog."

msgid "characteristics/abilities/special/description/shellCalibration"
msgstr "Nakon pogotka vidljivog neprijatelja granatom, tempirač upaljača na sledećoj granati je podešen. Ako je početni hitac probio neprijateljski oklop, šteta sledećeg hica je povećana. Ako nije, probojnost sledećeg hica je povećana."

msgid "characteristics/abilities/special/description/shellParamsSwitcher"
msgstr "Top vozila ima specijalan uređaj koji dozvoljava promenu nekih parametara granate pre ispaljivanja. Opremanje prikazuje koji parametri će biti izmenjeni prebacivanjem između režima vatre."

msgid "characteristics/abilities/special/description/sightPointer"
msgstr "Napredni optički uređaj koji povećava domet tvog vidokruga i poboljšava otkrivanje pokretnih vozila i vozila sakrivenih iza rastinja. Kada je aktiviran, pretražuje uzan sektor ispred tvog vozila, otkrivajući sakrivene mete pre perioda hlađenja. Ako otkrije neuočenog neprijatelja, ti takođe postaješ momentalno uočen. Možeš ručno da isključiš pretraživanje nakon kratke zadrške"

msgid "characteristics/abilities/special/description/stagedJetBoosters"
msgstr "Potisnici na čvrsto gorivo koji poboljšavaju ubrzanje, pokretljivost i upravlivost tokom nekoliko sekundi. Za razliku od regularnih mlaznih potisnika, levi i desni potisnik mogu da rade nezavisno jedan od drugog za brze okretanje trupa i ne umanjuju pokretljivost u nazad. Mogu biti korišćeni više puta po borbi ali im treba hlađenje pre ponovnog aktiviranja."

msgid "characteristics/abilities/special/description/stanceDance"
msgstr "U zavisnosti od aktivnog režima i nivoa punjenja, vozilo može da aktivira jednu od dve sposobnosti: dodatno sagorevanje jonskog pražnjenja ili koincidentni elektromehanički nišan.\nDodatno sagorevanje jonskog pražnjenja privremeno povećava snagu motora, maksimalnu brzinu u napred, i brzinu u nazad. Koncidentni elektromehanički nišan privremeno povećava preciznost i smanjuje vreme punjenja."

msgid "characteristics/abilities/special/description/stationaryReload"
msgstr "Eksterni modul snabdevanja municijom ti dozvoljava da prekineš punjenje i počneš da pucaš bilo kada, sve dok i dalje imaš jednu granatu u napunjen u topu. Tokom punjenja, modul zaključava kupolu vozila i spoljašnje kapsule sa municijom, privremeno te sprečavajući da nišaniš ili pucaš osim ako ga ne prekineš."

msgid "characteristics/abilities/special/description/supportWeapon"
msgstr "Ovo vozilo je opremljeno kompletom pomoćnog oružja čiji ciklus punjenja je odvojen od glavnog topa, što ti dozvoljava da naneseš dodatnu štetu u ključnim momentima."

msgid "characteristics/abilities/special/description/targetDesignator"
msgstr "Laserski obeležavač mete dodaje specijalan efekat tvom sledećem hicu, koji se primenjuje na bilo kog neprijatelja koga pogodiš. Efekat varira u zavisnosti od toga da li je neprijatelj uočen u momentu pogotka. Pogodak uočenog neprijateljskog vozila će ga označiti, produžavajući vreme za koje ostaje uočeno i povećavajući štetu koju prima od granata, dok će pogodak neuočenog neprijateljskog vozila označiti njegovu poziciju specijalnim markerom."

msgid "characteristics/abilities/special/description/twinGun"
msgstr "Nudi duplu štetu i poboljšanu stabilizaciju po ceni pokretljivosti, preciznosti, brzine okretanja kupole i vremena nišanjenja. Najbolje je koristiti u bliskoj borbi."

msgid "characteristics/abilities/special/description/wheeledDash"
msgstr "Ova mehanička modifikacija značajno pojačava ubrzanje vozila, snagu motora i maksimalnu brzinu u napred i u nazad na kratko vreme, dozvoljavajući ti da brzo reaguješ na neprijateljski napad i uhvatiš protivnike u raskoraku dinamičnim manevrima. Održavanje veće brzine kretanja ubrzava hlađenje mehanike."

msgid "characteristics/abilities/special/notes"
msgstr "Sve prikazane vrednosti su maksimalno moguće za vozilo. Oprema, direktive i potrošni materijal mogu da promene ove vrednosti ali te promene se ne odražavaju ovde."

