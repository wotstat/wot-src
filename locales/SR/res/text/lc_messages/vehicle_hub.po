msgid "abilities/common/description/autoLoaderGun"
msgstr "Dozvoljava seriji granata da budu ispaljene iz šaržera jedna po jedna, dok se svaka granata automatski puni tokom vremena."

msgid "abilities/common/description/autoLoaderGunBoost"
msgstr "Dozvoljava seriji granata da budu ispaljene iz šaržera jedna po jedna, dok se svaka granata automatski puni tokom vremena. Daje bonus na brzinu punjenja sledeće granate tokom punjenja."

msgid "abilities/common/description/autoShootGun"
msgstr "Puca brze rafale granata da nanese visoku štetu za kratko vreme, po cenu probojnosti i preciznosti. Najefektivniji je u borbama na maloj distanci."

msgid "abilities/common/description/damageMutable"
msgstr "Puca osvetljavajuće granate, nanoseći maksimalnu štetu u krugu od 50 m. Šteta granate se smanjuje tokom razdaljine, što je čini najefikasnijom u bliskoj borbi."

msgid "abilities/common/description/dualAccuracy"
msgstr "Jedinstveni sistem hlađenja koji dozvoljava dvostruko nišanjenje: čekanje nakon punjenja dozvoljava topu da puca preciznije. Poboljšana preciznost je prikazana drugim, manjim nišanskim krugom."

msgid "abilities/common/description/dualGun"
msgstr "Sistem dvostrukog topa sa mogućnošću da puca iz obe cevi odvojeno ili simultano. Dvostruki hici nanose veliku rafalnu štetu, ali dolaze sa dužim vremenom punjenja."

msgid "abilities/common/description/hydraulicChassis"
msgstr "Dozvoljava trupu vozila da menja uglove elevacije, nudeći prilike za pucanje sa više pozicija u borbi. Aktiviranje zavisi od raznih uslova."

msgid "abilities/common/description/hydraulicWheeledChassis"
msgstr "Menja poziciju dodatnih točkova da značajno poveća brzinu ali po cenu upravljivosti. Najbolje je koristiti je za prelazak dužih distanci i za brze napade."

msgid "abilities/common/description/magazineGun"
msgstr "Dozvoljava seriji granata da budu ispaljene iz šaržera pre potrebe za punim popunjavanjem. Nanosi visoku rafalnu štetu ali ostavlja vozilo ranjivim tokom punjenja. Može da napuni samo ceo šaržer odjednom."

msgid "abilities/common/description/overheatGun"
msgstr "Top može da puca neprekidno bez potrebe za punjenjem. Svaki hitac stvara toplotu: Što je veća temperatura, to se više neki od njegovih parametara menjaju. Konstantno pucanje će dovesti do pregrevanja topa, sprečavajući dalje pucanje dok se ne ohladi."

msgid "abilities/common/description/rocketAcceleration"
msgstr "Povećava snagu motora i maksimalnu brzinu za brzo manevrisanje preko bojišta. Kada je aktivirana, mlazni busteri smanjuju pokretljivost i ne mogu biti isključeni ručno."

msgid "abilities/common/description/shellParamsSwitcher"
msgstr "Top ovog vozila ima specijalan uređaj koji dozvoljava promenu nekih parametara granate pre pucanja. Parametri za različite granate variraju u zavisnosti od odabranog režima, a svaki režim ti dozvoljava da se brzo prilagodiš različitim borbenim situacijama."

msgid "abilities/common/description/siegeMode"
msgstr "Priikom aktiviranja, ovaj specijalni režim povećava i/ili menja određene borbene parametre. Najbolje ga je aktivirati kada si u poziciji i spreman da napadneš neprijatelja."

msgid "abilities/common/description/stun"
msgstr "Ošamućuje neprijateljska vozila u određenom krugu, čak i bez direktnog pogodka, na kratko pogoršava njihovu pokretljivost, preciznost i vreme punjenja. Ošamućeni neprijatelji su označeni markerom ošamućenosti."

msgid "abilities/common/description/trackWithinTrack"
msgstr "Dozvoljava vozilu da se kreće smanjenom brzinom kada je glavna gusenica uništena. Gubitak dodatne spoljne gusenice dalje smanjuje pokretljivost, ali vozilo i dalje može da se okreće i pomera."

msgid "abilities/common/description/turboshaftEngine"
msgstr "Dozvoljava vozilu da se kreće značajno brže i ujedno značajno smanjuje parametre ponašanja topa."

msgid "abilities/common/description/twinGun"
msgstr "Prilikom aktiviranja ovaj specijalni režim nudi dvostruku štetu i povećava i/ili menja određene borbene parametre. Najbolje ga je upotrebiti u susretima na malim razdaljinama."

