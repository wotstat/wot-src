msgid "common/congratulation"
msgstr "Čestitamo! Završio si misiju i primio sledeće nagrade"

msgid "common/requirements"
msgstr "Dostupno za kompletiranje u vozilima IV ili višeg nivoa."

msgid "g1/advice"
msgstr "Možeš pobediti u borbi uništenjem svih neprijateljskih vozila ili zauzimanjem neprijateljske baze. Budi pažljiv i ne juri napred. Saradnja sa saveznicima je ključ izbegavanja uništenja."

msgid "g1/description"
msgstr "Ispunjavanje uslova za 3 uzastopne borbe je opcionalno."

msgid "g1/name"
msgstr "Dani Rata"

msgid "g10/advice"
msgstr "Možeš naneti dosta štete bez obzira na tip vozila. Biraj ciljeve koje sigirno možeš oštetiti, pokušaj da preživiš što je duže moguće, i bićeš iznenadjen \"Uzrokovanom Štetom\" u svojim rezultatima nakon bitke."

msgid "g10/description"
msgstr "Ispunjenje uslova za dve uzastopne bitke je opcionalno."

msgid "g10/name"
msgstr "Uzor: Šteta"

msgid "g2/advice"
msgstr "Teški tenkovi imaju snažne topove i debeo prednji oklop kojeg je teško probiti. Ipak, ova prednost je balansirana sporim kretanjem, što može značiti da je lako prići im sa strane ili pozadi i napasti ih na slabim mestima."

msgid "g2/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g2/name"
msgstr "Tačno u cilj: Teški tenkovi"

msgid "g3/advice"
msgstr "Srednji tenkovi su svestrane jedinice koje mogu pokrivati veliki raspon radataka na bojnom polju - od podrške glavnoj udarnoj snazi do napadanja sa bokova. Ne dozvoli da te napadnu sa strane i uništi ih dok prilaze."

msgid "g3/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g3/name"
msgstr "Tačno u cilj: Srednji tenkovi"

msgid "g4/advice"
msgstr "Laki tenkovi imaju slab oklop i topove, ali ovo kompenzuju odličnom brzinom i skrivanjem. Osnovni zadatak lakog tenka uočavanje i odvlačenje pažnje neprijateljskim vozilima."

msgid "g4/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g4/name"
msgstr "Tačno u cilj: Laki tenkovi"

msgid "g5/advice"
msgstr "Lovci tenkova su opasan neprijatelj sa teškim naoružanjem i odličnim skrivanjem, ali u većini slučajeva osrednjom pokretljivošću. Pokušaj da ih uočiš i uništiš što pre."

msgid "g5/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g5/name"
msgstr "Tačno u cilj: Lovci tenkova"

msgid "g6/advice"
msgstr "Što manje neprijateljskih vozila preostane, bliži si pobedi. Igraj mudro, pokušaj da preživiš, i nanesi što više štete. Koristi teren za paljbu bez otkrivanja."

msgid "g6/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g6/name"
msgstr "Izgradnja kolekcije"

msgid "g7/advice"
msgstr "Svako vozilo ima unutrašnje i spoljne module i posadu. Kritični pogodci značajno umanjuju borbene performanse neprijatelja. Pažljivo prouči slabe tačke vozlima kako bi efektivnije izazivao kritični štetu na neprijateljska vozila i izbegavao štetu na svom."

msgid "g7/description"
msgstr "Rezultati u svim borbama sa bilo kojim vozilom se sabiraju."

msgid "g7/name"
msgstr "Probojni pogotci"

msgid "g8/advice"
msgstr "Jedan način za pobedu je osvajanje neprijateljske baze. Kada ne neprijatelj fokusiran na borbu, možeš se provući neopaženo do njihove baze, i brzo je zauzeti. Maksimalna brzina zauzimanja se postiže sa 3 vozila u krugu baze."

msgid "g8/name"
msgstr "Plan B"

msgid "g9/advice"
msgstr "Iskustvo se zaradjuje za otkrivanje, nanošenje štete i uništenje neprijateljskih vozila, oauzimanje baze, odbrana savezničke baze i pobedu."

msgid "g9/description"
msgstr "Ispunjenje uslova za dve uzastopne bitke je opcionalno."

msgid "g9/name"
msgstr "Uzor: Iskustvo"

msgid "group"
msgstr "Trening regruta"
