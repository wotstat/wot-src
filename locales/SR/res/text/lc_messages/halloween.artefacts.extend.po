msgstr "Mirijum cena za upotrebu u borbi:"

msgid "hwAoeDamageInstantShot/always"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/descr"
msgstr "Ispaljuje hitac koji oštećuje i ošamućuje metu i obližnja neprijateljska vozila."

msgid "hwAoeDamageInstantShot/long_special"
msgstr "Borbena sposobnost. Ispaljuje hitac koji oštećuje i ošamućuje metu i sva neprijateljska vozila u radijusu od 35 m. Ako se koristi najmanje jednom u borbi, sposobnost se troši i može se dopuniti za kredite. Ako se ne iskoristi, dopuna nije potrebna.<br/><br/>Dostupno samo tokom događaja <font color='#cbac77'>Vavilon: Mračni toranj</font>.<br/><br/>Sve neiskorišćene sposobnosti će biti uklonjene i kompenzovane za kredite u vrednosti od 50% cene u sledećoj nadogradnji."

msgid "hwAoeDamageInstantShot/name"
msgstr "Energetski hitac"

msgid "hwAoeDamageInstantShot/onUse"
msgstr "Ispaljuje hitac koji oštećuje i ošamućuje metu i sva neprijateljska vozila u krugu od 35 m."

msgid "hwAoeDamageInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/short_special"
msgstr "Ispaljuje hitac koji oštećuje i ošamućuje metu i obližnja neprijateljska vozila."

msgid "hwAoeDrainEnemyHpInstantShot/always"
msgstr "?empty?"

msgid "hwAoeDrainEnemyHpInstantShot/descr"
msgstr "Ispaljuje hitac koji obnavlja poene izdržljivosti tako što ih krade od mete i obližnjih neprijateljskih vozila."

msgid "hwAoeDrainEnemyHpInstantShot/long_special"
msgstr "Borbena sposobnost. Ispaljuje hitac koji obnavlja poene zdravlja kradući ih od mete i obližnjih neprijateljskih vozila u radijusu od 35 m, kao i da popravlja oštećene module i uklanja efekat ošamućenja. Ako se koristi najmanje jednom u borbi, sposobnost se troši i može se dopuniti za kredite. Ako se ne iskoristi, dopuna nije potrebna.<br/><br/>Dostupno samo tokom događaja <font color='#cbac77'>Vavilon: Mračni toranj</font>.<br/><br/>Sve neiskorišćene sposobnosti će biti uklonjene i kompenzovane za kredite u vrednosti od 50% cene u sledećoj nadogradnji."

msgid "hwAoeDrainEnemyHpInstantShot/name"
msgstr "Vampirski hitac"

msgid "hwAoeDrainEnemyHpInstantShot/onUse"
msgstr "Ispaljuje hitac koji obnavlja poene izdržljivosti tako što ih krade od mete i obližnjih neprijateljskih vozila u krugu od 35 m, takođe obnavlja oštećene module i ukanja efekat šoka."

msgid "hwAoeDrainEnemyHpInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDrainEnemyHpInstantShot/short_special"
msgstr "Ispaljuje hitac koji obnavlja poene izdržljivosti tako što ih krade od mete i obližnjih neprijateljskih vozila."

msgid "hwAoeStunInstantShot/always"
msgstr "?empty?"

msgid "hwAoeStunInstantShot/descr"
msgstr "Ispaljuje hitac koji ošamućuje metu i obližnja neprijateljska vozila."

msgid "hwAoeStunInstantShot/long_special"
msgstr "Borbena sposobnost. Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila u krugu od 35 m. Može se koristiti više puta u borbi. Uklanja se nakon što je korišćena bar jednom u borbi.<br /><br />Dostupno samo tokom događaja <font color='#cbac77'>Vavilon projekat</font>.<br /><br /> Sve neiskorišćene sposobnosti biće uklonjene i nadoknađene u kreditima u iznosu od 50% njihove cene sa sledećom verzijom igre."

msgid "hwAoeStunInstantShot/name"
msgstr "Ošamućujući hitac"

msgid "hwAoeStunInstantShot/onUse"
msgstr "Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila u krugu od 35 m."

msgid "hwAoeStunInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeStunInstantShot/short_special"
msgstr "Ispaljuje hitac koji ošamućuje metu i obližnja neprijateljska vozila."

msgid "hwInvisibility/always"
msgstr "?empty?"

msgid "hwInvisibility/descr"
msgstr "Čini tvoje vozilo nevidljivim za neprijatelje, obnavlja poene izdržljivosti, popravlja module i gasi požar."

msgid "hwInvisibility/long_special"
msgstr "Čini tvoje vozilo nevidljivim za neprijatelje tokom 10 s. Obnavlja 35 poena izdržljivosti po sekundi, popravlja module, uklanja sve negativne efekte i daje neranjivost na koroziju. Pucanje ili primanje štete od neprijateljskog vozila (pucanjem, sudarom ili upotrebom borbenih sposobnosti) će otkriti tvoju poziciju odmah. Ne može biti prekinuta neprijateljskim hicima, tokom 3 s nakon aktiviranja. Ako se upotrebi makar jednom u borbi, sposobnost je potrošena i može biti ponovo kupljena za kredite. Ako nije upotrebljena, nema potrebe za ponovnom nabavkom.<br/><br/>Dostupno samo tokom <font color='#cbac77'>Vavilon: Mračni toranj</font> događaja.<br/><br/>Sve neupotrebljene sposobnosti biće uklonjene i kompenzovane u kreditima za vrednost jednaku od 50% cene u sledećoj nadogradnji."

msgid "hwInvisibility/name"
msgstr "Nevidljivo lečenje"

msgid "hwInvisibility/onUse"
msgstr "Čini tvoje vozilo nevidljivim za neprijatelje tokom 10 s. Obnavlja 35 poena izdržljivosti po sekundi, popravlja module, uklanja sve negativne efekte i daje neranjivost na koroziju. Pucanje ili primanje štete od neprijateljskog vozila (pucanjem, sudarom ili upotrebom borbenih sposobnosti) će otkriti tvoju poziciju odmah. Ne može biti prekinuta neprijateljskim hicima, tokom 3 s nakon aktiviranja."

msgid "hwInvisibility/restriction"
msgstr "?empty?"

msgid "hwInvisibility/short_special"
msgstr "Sakriva te od neprijatelja, obnavlja izdržljivost, popravlja module, gasi požar, uklanja efekat šoka i leči posadu."

