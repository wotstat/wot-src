msgid "Contact/status/inBattle/halloween"
msgstr "U borbi Vavilon: Mračni toranj"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Ispaljuje hitac koji oštećuje i ošamućuje metu i sva neprijateljska vozila u krugu od 35m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Ispaljuje hitac koji obnavlja poene izdržljivosti tako što ih krade od mete i obližnjih neprijateljskih vozila u krugu od 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila u krugu od 35m."

msgid "advanced/hw_damageShield"
msgstr "Štiti protiv bilo koje štete (izuzev sudara, davljenja i udara) 7 sekundi."

msgid "advanced/hw_fastReload"
msgstr "Povećava brzinu vatre / punjenja šaržera."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Obnavlja poene izdržljivosti, gasi požar, uklanja efekat šoka i popravlja oštećene module."

msgid "advanced/hw_invisibility"
msgstr "Privremeno čini tvoje vozilo nevidljivim za neprijatelje, obnavlja poene izdržljivosti, popravlja module, gasi požar, uklanja efekat ošamućenosti i tretira sve povređene članove posade."

msgid "advanced/hw_teamRepairKit"
msgstr "Popravlja module, gasi požar, uklanja efekat šoka i obnavlja nešto poena izdržljivosti na savezničkim vozilima u svom dometu."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Borbene sposobnosti ti pomažu da se boriš efikasnije u Vavilon: Mračni toranj borbama, završiš ciljeve i zaradiš vredne nagrade. Da bi ih opremio, klikni na jedan od slotova borbenih sposobnosti."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Slotovi borbenih veština"

msgid "hwShell/alt/description"
msgstr "%(bold)s može biti pronađen u borbi sa određenom verovatnoćom nakon uništenja neprijatelja."

msgid "hwShell/alt/description/bold"
msgstr "Alternativna granata"
