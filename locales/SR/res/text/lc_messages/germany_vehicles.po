msgid "PzI_ausf_C"
msgstr "Pz.Kpfw. I Ausf. C"

msgid "PzI_ausf_C_descr"
msgstr "Početna narudžbina za ovaj tenk je uručena 1939. Originalno je zamišljen kao brzo vozilo za izviđanje za padobranske trupe. Masovna proizvodnja je počela početkom 1942. Početkom 1943 dva vozila su uručena Prvoj Tenkovskoj Diviziji. 38 vozila su uručena 58-oj rezervnoj diviziji u leto 1944."

msgid "PzI_ausf_C_short"
msgstr "Pz. I C"

msgid "PzI_descr"
msgstr "Pz. I Ausf. A je bio prvi masovno proizvođen tenk Nemačke. 1935 dizajn je dobio nadogradnju u obliku produžene šasije i jačeg motora. Masovna proizvodnja ove verzije, Pz. I Ausf B je na kraju brojala 675 tenkova. Standardno naoružanje je bilo slabo, ali su neki tenkovi bili nadograđeni na španskom ratištu na topove od 20 mm."

msgid "PzI_short"
msgstr "Pz. I"

