msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_ausf_F"
msgstr "Pz.Kpfw. III/IV Ausf. A"

msgid "PzIV_ausf_F_short"
msgstr "Pz.Kpfw. III/IV\nAusf. A"

msgid "PzIV_ausf_H"
msgstr "Pz.Kpfw. III/IV Ausf. B"

msgid "PzIV_ausf_H_short"
msgstr "Pz.Kpfw. III/IV\nAusf. B"

msgid "PzIV_descr"
msgstr "Proizveden je u većem broju od bilo kog drugog tenka nemačkih oklopnih snaga. Od marta 1942 ovaj tenk je bio opremljen topom sa dugom cevi. Proizvođen je od oktobra 1937. do marta 1945. Ukupno je napravljeno 8519 tenkova i komandnih vozila."

msgid "PzIV_schmalturm"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_schmalturm_descr"
msgstr "U novembru 1944. Krup kompanija je predstavila nekoliko \"avant\" projekata za unapređenje naoružanja na tenkovima i lovicma tenkova u službi. Među njima je bio i projekat montiranja panterove \"Schmalturm\" kupole na Pz IV Ausf. J. Projekat nije uzet u razmatranje jer bi preopteretio vešanje i jer je proizvodnja Pz IV prestajala."

msgid "PzIV_schmalturm_long_special"
msgstr "Montiranje Pangher-ove kupole na ovo vozilo mu daje prilično snažan top koji že neprijatelj definitivno primetiti. Kao rezultat ovo je sjajno vozilo za podršku koje može da nanose štetu sa bilo koje distance."

msgid "PzIV_schmalturm_short"
msgstr "Pz. IV S."

msgid "PzIV_schmalturm_short_special"
msgstr "Precizan top sa pristojnom penetracijom i visokom brzinom paljbe"

msgid "PzIV_short"
msgstr "Pz. IV"

msgid "PzIVturm"
