msgid "PzIII_IV"
msgstr "Pz.Kpfw. III/IV"

msgid "PzIII_IV_descr"
msgstr "Projekat novog vozila sa kosim pločama oklopa i komponentama Pz. Kpfw. III i Pz. Kpfw. IV je odobren 4 Januara 1944. Marta 1944, ugovor za tri prototipa je potpisan, ali je program prekinut 12 jula. Samo lovac tenkova na sličnoj bazi je ušao u masovnu proizvodnju."

msgid "PzIII_IV_short"
msgstr "Pz. III/IV"

msgid "PzII_J"
msgstr "Pz.Kpfw. II Ausf. J"

msgid "PzII_J_descr"
msgstr "Izviđački tenk sa ojačanim oklopom. Vozilo predstavlja dalji razvoj tenka Pz.Kpfw. II. U oktobru 1939. naručen je probni niz i prvi prototip je napravljen u julu 1940. Od 1943. do 1944. sedam vozila je korišćeno u 12. oklopnoj diviziji na Istočnom frontu. Ukupno je napravljeno 22 tenka."

msgid "PzII_J_short"
msgstr "Pz. II J"

msgid "PzII_ausf_J"
msgstr "Pz.Kpfw. II Ausf. J"

