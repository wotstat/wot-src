msgid "VG158_VK2801_105_SPXXI_descr"
msgstr "Nadograđena verzija VK 28.01 sa snažnim topom i malim naoružanjem napravljen od strane Krupp kompanije. Vozilo je razvijano u periodu od juna do 1943 pod programom kreiranja univerzalne šasije za celu seriju vozila raznih primena. Razvoj ne prekinut u fazi dizajna i vozilo nije nikada napravljeno."

msgid "VK2001DB"
msgstr "VK 20.01 (D)"

msgid "VK2001DB_descr"
msgstr "Prototip srednjeg tenka razvijenog od strane Dajmler-Benc kompanije od 1939. do kraja 1941. Novo vozilo je trebalo da postane standardni srednji tenk Wehrmacht-a. Prototip je upotrebljen na Istočnom frontu. Borbena testiranja su otkrila seriju ozbiljnih problema. 1941. tenk se činio već zastarelim i projekat je otkazan."

msgid "VK2001DB_short"
msgstr "VK 20.01 D"

msgid "VK3001P_Porsche_turm_SH"
msgstr "VK 30.03 Krupp Turm"

msgid "VK3002DB_SH"
msgstr "Walküre"

msgid "VK3002DB_SH_descr"
msgstr "Nemci su stari majstori metalurgije i visoko kvalitetnog sklapanja. Ovo vozilo je perfektan vuk samotnjak - nezavisno, svestrano i lako prilagodivo svim borbenim situacijama kako bi preživelo."

msgid "VK3002DB_SH_short"
msgstr "Walküre"

msgid "VK3002DB_Standardtketten_SH"
msgstr "VK 35.02 (D)"

msgid "VK3002DB_V1"
msgstr "VK 30.01 (D)"

msgid "VK3002DB_V1_descr"
msgstr "Tokom zime 1941-42 odelenje za razvoj tenkova, WaPrüf 6, je izdao tehničke zahtteve za novi tenk od 30 dona. Naređenjaza razvoj su poslata MAN-u i Daimler Benz-u. Prototipvi su trebali da budu spremni do maja 1942. međutim, 13. maja 1942 bile su podnete samo komparativne vrednosti projekata. MAN-ov projekat je izabran i Daimler Benz je otkazan."

msgid "VK3002DB_V1_short"
msgstr "VK 30.01 D"

msgid "VK7201"
msgstr "VK 72.01 (K)"

msgid "VK7201_descr"
msgstr "Superteški tenk sa kupolom postavljenom nazad. Razvijan od strane Krupp kompanije. Novo vozilo je trebalo da ima jače naoružanje i poboljšan oklop u odnosu na VK 70,01. Postojao samo u nacrtima."

msgid "VK7201_short"
msgstr "VK 72.01 K"

