msgid "PzIV_Hydro_descr"
msgstr "Razvoj vozila sa hidrostatičkim pogonom smeštenim pozadi je počeo u Nemačkoj u julu 1944. Šasija Pz. IV Ausf G je korišćena za testove. Prvi prototip je napravljen krajem oktobra 1944. Proizvedeno je samo jedno vozilo."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

msgid "PzIV_Schmalturm_A"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_Standart"
msgstr "Pz.Kpfw. IV Ausf. G"

