msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Razvijan u kompaniji ČKD za potrebe armije Čehoslovačke tokom 1938. Tokom nemačke okupacije, vozilo je bilo u službi u Vermahtu i korišćeno je tokom kampanja u Poljskoj i Francuskoj, kao i na Istočnom frontu. Tenk je bio na borbama na frontu sve do sredina 1942. Približno je napravljeno 1.400 vozila u osam modifikacija (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

