msgid "battleship/name"
msgstr "Dimni signal"

msgid "battleship/shortDescr"
msgstr "Dimni signal koji obeležava oblast za artiljerijsku salvu bojnog broda, nanoseći štetu neprijateljskoj opremi i objektima lociranim tamo."

msgid "distraction_ability/name"
msgstr "Lažno naređenje"

msgid "distraction_ability/shortDescr"
msgstr "Upotrebi podoficira Kelera da iskoristi zarobljen nemački radio da pošalje lažno naređenje, usmeravajući neprijatelje da istraži određenu poziciju."

msgid "recon_ability/name"
msgstr "Izvidi unaokolo"

msgid "recon_ability/shortDescr"
msgstr "Pošalji kapetana Duboa na izviđanje određene pozicije. Kada je na izviđanju tenk se zaustavlja i ostaje nepokretan. Sposobnost nastavlja da funkcioniše dok se ne otkaže."

msgid "scc_airstrike_ability/name"
msgstr "Vazdušna podrška"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Pozovi vazdušni napad na obeleženu poziciju."
