msgid "comp7/deserter/cancel"
msgstr "Otkaži"

msgid "comp7/deserter/message"
msgstr "Ova borba još nije gotova. Ako napustiš borbu pre kraja, izneverićeš svoj tim.\n{brown_open}Tvoj rejting će biti smanjen i bićeš blokiran iz borbi ovog režima.{brown_close}\nDa li si siguran da želiš da napustiš borbu?"

msgid "comp7/deserter/msgTitle"
msgstr "Izgubićeš poene rejtinga!"

msgid "comp7/deserter/submit"
msgstr "Dezertiranje"

msgid "comp7/deserter/title"
msgstr "Dezertiranje iz borbe"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Prekršio si pravila igre na {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} mapi u {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close}poena rejtinga ti je oduzeto i privremeno si blokiran iz borbi u režimu {whiteSpanish_Open}Juriš{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Prekršio si pravila igra na {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} mapi u {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nPrivremeno si blokiran iz borbi u režimu {whiteSpanish_Open}Juriš{whiteSpanish_Close} i tvoj rejting je smanjen."
