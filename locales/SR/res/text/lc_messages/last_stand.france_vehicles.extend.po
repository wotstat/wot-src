msgid "F110_Lynx_6x6_LS_BOT"
msgstr "Trapper"

msgid "F110_Lynx_6x6_LS_BOT_descr"
msgstr "Dalji razvoj Panhard AML oklopnog vozila na vešanju sa pogonom na 6 točkova, novom kupolom i jačim naoružanjem."

msgid "F110_Lynx_6x6_LS_BOT_short"
msgstr "Trapper"

msgid "F17_AMX_13_90_LS_BOT"
msgstr "Corrupted Hornet"

msgid "F17_AMX_13_90_LS_BOT_descr"
msgstr "Brzo i upravljivo vozilo sa šaržerom sistemom punjenja sa 5 granata."

msgid "F17_AMX_13_90_LS_BOT_short"
msgstr "Corrupted"

msgid "F71_AMX_30_prototype_LS_BOT"
msgstr "Guard A.P. AMX 30"

msgid "F71_AMX_30_prototype_LS_BOT_descr"
msgstr "Razvijan kao deo kvalitetne potrage za jedinstvenim Evropskim tenkom. Ispalo je da vozilo ima pokretljivost, snagu motora i efektivnu protivtenkovsku borbenu udaljenost bolju od svih ostalih vozila osim Leoparda I . Oklop vozila je bio dosta tanak, ali je odlučeno da tehnološki napredne anti tenkovske granate čine oklop beskorisnim. Preživljavanje se svodilo na mobilnost i vatrenu moć."

msgid "F71_AMX_30_prototype_LS_BOT_short"
msgstr "Guard"

msgid "F73_M4A1_Revalorise_LS_BOT"
msgstr "Guard M4A1 Rev."

msgid "F73_M4A1_Revalorise_LS_BOT_descr"
msgstr "Tokom pedestih godina M4 sherman u raznim modifikacijama je poslat Francuskoj kao deo MDAP. Francuski konstrukcioni biroi su počeli sa modernizacijom vozila sa ciljem poboljšanja njegove vatrene moći. Ova inicijativa je propraćena programom modernizacije za odbrambene snage Izraela (Sherman M51). Tenk nikada nije ušao u službu u Francuskoj. Broj prototipova koji su napravljeni je nepoznat."

msgid "F73_M4A1_Revalorise_LS_BOT_short"
msgstr "Guard"

msgid "F74_AMX_M4_1949_LS_BOT"
msgstr "Guard AMX M4 49"

msgid "F74_AMX_M4_1949_LS_BOT_descr"
msgstr "Francuski teški tenk, prvobitno nazvan Projekt 141. Razvoj ovog vozila je počeo odmah nakon kraja Drugog Svetskog Rata zbog potreba Francuske za modernim teškim tenkovima. Postojao je samo kao nacrt."

msgid "F74_AMX_M4_1949_LS_BOT_short"
msgstr "Guard"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT"
msgstr "Guard AMX M4 54"

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_descr"
msgstr "Varijanta AMX M4 teškog tenka baziranog na Projektu 141 sa poboljšanim prednjim oklopom. Planirano je da ima poboljšan prednji oklop montiranjem ploče od 280 mm. Postojao je samo u nacrtima."

msgid "F82_AMX_M4_Mle1949_Ter_LS_BOT_short"
msgstr "Guard"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT"
msgstr "Guard AMX M4 51"

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_descr"
msgstr "Projekat 141 je bio varijanta AMX M4 tepkog tenka sa poboljšanim prednjim oklopom. Razvoj je počeo Novembra 1949, ali vozilo nije nikada proizvedeno. Projekat je takodje imao mnoge delove sa različitih trupova sličnih šasija."

msgid "F83_AMX_M4_Mle1949_Bis_LS_BOT_short"
msgstr "Guard"

