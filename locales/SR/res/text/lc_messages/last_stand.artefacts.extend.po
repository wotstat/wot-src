msgid "LS_invisibility/always"
msgstr "?empty?"

msgid "LS_invisibility/descr"
msgstr "Sprečava neprijatelje da nišane u tvoje vozilo, obnavlja poene izdržljivosti, popravlja module i gasi požar."

msgid "LS_invisibility/long_special"
msgstr "Taktički uređaj. Zaustavlja neprijatelje da nišane u tvoje vozilo na 10 s. Obnavlja 32 poena zdravlja po sekundi, trenutno popravlja module, gasi požar, uklanja efekat ošamućivanja i leči sve povređene članove posade. Nanošenje ili primanje štete od neprijateljskog vozila (pucanjem, udarom ili korišćenjem taktičkih uređaja) će odmah otkriti tvoju poziciju. Ako se koristi barem jednom u borbi, uređaj se troši i može se dopuniti za kredite. Ako se ne iskoristi, dopuna nije potrebna.<br/><br/>Dostupno samo tokom događaja <font color='#cbac77'>Poslednje Uporište: Tera Nord</font>.<br/><br/>Svi neiskorišćeni uređaji će biti uklonjeni i kompenzovani za kredite u vrednosti od 50% cene u sledećoj nadogradnji."

msgid "LS_invisibility/name"
msgstr "Lečenje u senci"

msgid "LS_invisibility/onUse"
msgstr "Zaustavlja neprijatelje da nišane u tvoje vozilo na 10 s. Obnavlja 32 poena izdržljivosti po sekundi, momentalno popravlja module, gasi požar, uklanja efekat ošamućenosti i tretira sve povređene članove posade. Nanošenje ili primanje štete od neprijateljskog vozila (pucnjem, sudarom ili upotrebom taktičkih uređaja) otkriva tvoju poziciju odmah."

msgid "LS_invisibility/restriction"
msgstr "?empty?"

msgid "LS_invisibility/short_special"
msgstr "Privremeno zaustavlja neprijatelje da nišane u tvoje vozilo, obnavlja poene izdržljivosti, popravlja module, gasi požar, uklanja efekat ošamućenosti i tretira sve povređene članove posade."

