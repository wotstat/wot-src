msgid "special_style/well_deserved_award_2023_1"
msgstr "Slatka uspomena"

msgid "special_style/well_deserved_award_2023_1_desc"
msgstr "Svesezonski stil sa slikama poznatih lokacija igre."

msgid "special_style/well_deserved_award_2023_1_desc/long"
msgstr "Posle jedne ili dve bitke, mapa postaje malo jasnija. Nakon nekoliko desetina bitaka, postaje lakša za navigaciju. Nakon stotinu borbi na istoj lokaciji, ne možeš a da ne primetiš da su neke od karakteristika postale poznate. Vremenom, svaki komandant dobija omiljenu poziciju - neki neupadljivu, ali definitivno „svoj“ grm - pa čak i muziku koja se ne može pomešati ni sa jednom drugom."

msgid "special_style/well_deserved_award_2023_2"
msgstr "Tenkista veteran"

msgid "special_style/well_deserved_reward_2025"
msgstr "Stara ruka"

msgid "special_style/well_deserved_reward_2025_desc"
msgstr "Višesezonski stil koji proslavlja tvoje World of Tanks putovanje."

msgid "special_style/well_deserved_reward_2025_desc/long"
msgstr "Svesezonski stil koji se dodeljuje World of Tanks igračima u znak njihove posvećenosti umetnosti tenkovanja. Stil evoluira kako tvoje iskustvo napreduje, menjajući boje sa svakim novim nagradnim rangom Dobro zaslužene nagrade tako da svi znaju ko je najiskusniji tenkista od svih!"

msgid "special_style/western_warriors"
msgstr "Ratnik zapada"

msgid "special_style/western_warriors_desc/long"
msgstr "\"Protiv svakog naoštrenog mača postavili smo iskovani oklop. Protiv svakog nategnutog luka, napravili smo neprobojne zidove. A na svaki varvarski urlik, odgovorili smo Njegovom rečju. Došao si po zlato našeg manastira, ali ćeš dobiti samo čelik. Dođi do nas i jedina stvar koju ćeš videti je svoje sopstveno lice iskrivljeno u užasu kako se ogleda na našim sjajnim šlemovima. Kažeš da je naša zemlja žarište rata - dođi do nas i pokazaćemo ti šta podgreva ta žarišta.\nIn nomine Patris\nEt Filii\nEt Spiritus Sancti.\""

