msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Razvijan od strane Osaka Artiljeriskog Arsenala kao zamena za Type 2589. Chi-Ni i Chi-ha su ušči u testiranje 1937. Chi-Ha je izašao kao uspešniji. Jedan prototip je proizveden."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Srednji tenk Type 3 Chi-Nu-Kai je kombinacija Type 3 Chi-Nu vešanja i kupole i Type 4 Chi-To topa. Samo prototip je konstruisan. Bio je spreman za testiranje Marta 1945."

msgid "Chi_Nu_Kai_long_special"
msgstr "Ovo je standardni srednji tenk koji nema ni jednu značajnu prednost ili manu. Pogodan je za bilo koju borbenu situaciju."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Velika preciznost, probojnost, dobra oklopljenost štita topa"

