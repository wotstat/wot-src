msgid "reserveCategories/config/footerText"
msgstr "U {{@ colorLegacy 'FFE4C0'}}Obrt sudbine{{/}} scenariju, red po kome se borbene rezerve otključavaju ne zavisi od tipa vozila."

msgid "reserveCategories/config/header"
msgstr "Konfiguracije rezervi po tipu vozila"

msgid "reserveCategories/config/text"
msgstr "U {{@ colorLegacy 'FFE4C0'}}Standardna borba{{/}} i {{@ colorLegacy 'FFE4C0'}}Operacionalna podrška{{/}} scenarijima, sva tri slota borbenih rezervi su dostupna za sve tipove vozila. Međutim redosled po kom se oni otključavaju zavisi od tipa vozila."

msgid "reserveCategories/config/vehicles/destroyer"
msgstr "Lovci tenkova"

msgid "reserveCategories/config/vehicles/heavy"
msgstr "Teški tenkovi"

