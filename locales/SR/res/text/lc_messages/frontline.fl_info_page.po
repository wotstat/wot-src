msgstr "Srednji tenkovi"

msgid "reserveCategories/config/vehicles/selfPropelled"
msgstr "Artiljeija"

msgid "reserveCategories/levelUpNote"
msgstr "* Poboljšanje ovog nivoa je dostupno samo {{@ colorLegacy 'FFE4C0'}}kupljenim{{/}} borbenim rezervama u scenariju {{@ colorLegacy 'FFE4C0'}}Obrt sudbine{{/}}."

msgid "reserveCategories/levels/header"
msgstr "Kako otključati slotove i poboljšati borbene rezerve"

msgid "reserveCategories/levels/text"
msgstr "U startu jedna borbena rezerva ti je dostupna. Ostale se otključavaju nakon dostizanja ranga narednika i poručnika. Sve tri rezerve će biti poboljšane nakon dostizanja ranga kapetana i majora."

msgid "reserveCategories/progression/tableCell"
msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} ili {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}} nivo"

