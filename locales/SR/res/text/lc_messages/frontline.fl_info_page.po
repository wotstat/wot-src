msgstr "General"

msgid "progression/ranksTable/lieutenant"
msgstr "Poručnik"

msgid "progression/ranksTable/major"
msgstr "Major"

msgid "progression/ranksTable/private"
msgstr "Redov"

msgid "progression/ranksTable/sergeant"
msgstr "Narednik"

msgid "progression/sectionHeader"
msgstr "Napredak u Liniji fronta"

msgid "progression/text"
msgstr "Kada igraš u ovom režimu, penjaćeš se kroz rangove, napredovaćeš kroz progres Linije fronta i zaraditi nagrade."

