msgstr "Ovaj parametar pokazuje trajanje primljenog ošamućenja."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Ovaj parametar pokazuje šansu za minimalnu potencijalnu štetu i potencijalnu penetraciju u odnosu na osnovnu vrednost (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Ovaj parametar pokazuje promenu maksimalne potencijalne štete i potencijalne penetracije u odnosu na osnovnu vrednost (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Ovaj parametar pokazuje količinu štete uzrokovanu sudaranjem. Kada se vozilo sudari, sistem razmatra debljinu oklopa u tački udarca, razliku u težinama vozila i brzinama."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Ovaj parametar pokazuje odlaganje pre nego što komandat otkrije kritičnu štetu neprijateljskom vozilu u nišanu."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Ovaj parametar pokazuje ekspozituru neprijateljima koji su potpuno skroviti rastinjem ( izolovani ili grupno). Nanosi se na vozila u mirovanju i pokretu."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Ovaj parametar pokazuje ekspozituru neprijateljskim vozilima u pokretu. Što je vrednost veća, veća je i šansa za uočavanje."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Ovaj parametar pokazuje promene za šansu nanošenja kritične štete neprijateljskim posudama i modulima. Efekat radi na svim tipovima granata osim u vozilima sa automatskim topovima."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Ovaj parametar pokazuje vreme hlađenja potrošne robe."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Ovaj parametar određuje smanjenje trajanja vatre i količine štete koju šteta uzrokuje."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Ovaj parametar pokazuje efekat skrivanja iza rastinja."

msgid "extraParams/name/hpRecover"
msgstr "Ovaj parametar pokazuje povećanje u poenima izdržljivosti prilikom upotrebe kompleta za popravku. Što je veća vrednost, to će više izdržljivosti biti obnovljeno."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Ovaj parametar pokazuje nosivost vešanja na srednje mekim terenima. Što je vrednost veća, manje vremena je potrebno za dostizanje linearne brzine."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Ovaj parametar smanjuje kaznu na maksimalni vidokrug kada su osmatrački uređaji uništeni. Što je manja vrednost, to je vidljivost bolja."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Ovaj parametar pokazuje povećanje u vrednosti maksimalne potencijalne penetracije za granate ispaljene sa distance manje od 50 m. Što je veća vrednost to je bolja penetracija."

