msgstr "Ovaj parametar pokazuje dodatno vreme prenosa neprijateljskih pozicija nakon što je vozilo uništeno."

msgid "extraParams/name/radiomanHitChance"
msgstr "Ovaj parametar pokazuje šansu za izbegavanje povreda radio operatera."

msgid "extraParams/name/shellVelocity"
msgstr "Ovaj parametar pokazuje povećanje brzine granata za sve tipove. Što je veća vrednost, to je brzina granate veća."

msgid "extraParams/name/softGroundFactor"
msgstr "Ovaj parametar pokazuje nosivost vešanja na mekim terenima. Što je vrednost veća, manje vremena je potrebno za dostizanje linearne brzine."

