msgid "detailsHelp/wheeledVeh/burnout"
msgstr "Pritisni i drži %(key2)s i %(key1)s istovremeno. Nivo na skali snage određuje jačinu pojačanja. Otpusti %(key1)s taster da bi aktivirao pojačanje ili otpusti taster%(key2)s da otkažeš pojačanje. Pojačanje obezbeđuje brže ubrzanje koje može da se koristi za iznenadne napade i trik manevre. Pažnja! Pojačanje može da se koristi samo nakon što se vozilo kompletno zaustavilo. Aktiviranje pojačanja oštećuje motor tvog vozila."

msgid "detailsHelp/wheeledVeh/burnout/title"
msgstr "Pojačanje"

msgid "detailsHelp/wheeledVeh/stableChassis"
msgstr "Vozila sa točkovima trpe manju štetu kada slete na točkove. Vozilo sa točkovima ne staje kada je jedan od točkova uništen. Kako se gubi više točkova brzina i upravljivost vozila se smanjuju. Vozila sa točkovima su teška za zaustavljanje - uništeni točkovi se potpuno popravljaj nakon nekog vremena."

msgid "detailsHelp/wheeledVeh/stableChassis/title"
msgstr "Izdržljivo vešanje"

