msgid "02_malinovka/team1/heavyTank/descr"
msgstr "Ključna tačka ove taktike je %(a_ht_millMountainPhrase1).%(p)Kretanjem pod zaštitom %(a_ht_southernForestPhrase), možeš da se popneš bezbedno do ivice mape. Tada treba da zauzmeš %(a_ht_millMountainPhrase2) gde možeš da gađaš vozila dok skrivaš trup. Kontrolisanje ove planine će ti dozvoliti da otvoriš vatru na puteve ka %(a_ht_villagePhrase) i napadneš sa boka. Stene će pružiti zaštitu od neprijatelja koji se kriju u %(a_ht_northernForestPhrase). Obezbeđivanjem šuma otvaraš put ka Bazi 2."

msgid "02_malinovka/team1/heavyTank/title"
msgstr "Napad vetrenjače"

msgid "02_malinovka/team1/mediumTank/descr"
msgstr "Ključna tačka za ovu taktiku je %(a_mt_ledgePhrase1).%(p)Kretanjem centralnim bokom uz %(a_mt_swampPhrase), zauzmi %(a_mt_elevationPhrase) odakle možeš da gađaš nepreijatelje na %(a_mt_ledgePhrase2). Tada, vožnjom kroz vodu, možeš da se provučeš do litice i gađaš ciljeve koji se spuštaju sa planine. Skrivanje iza planine i grmlja na %(a_mt_ledgePhrase3) će ti dozvoliti da uočiš i gađaš neprijatelje u %(a_mt_northernForestPhrase) i blizu baze. Nakon uništenja neprijatelja sa boka na %(a_mt_fieldPhrase), imaćeš pristup nezaštićenoj Bazi 2."

msgid "02_malinovka/team1/mediumTank/title"
msgstr "Napad litice"

msgid "02_malinovka/team2/heavyTank/descr"
msgstr "Ključna tačka ove taktike je %(b_ht_millMountainPhrase1).%(p)Kretanjem duž %(b_ht_northernForestPhrase), bezbedno možeš da se popneš do ivice mape. Tada treba brzo da zauzmeš %(b_ht_millMountainPhrase2) gde možeš da gađaš skriven terenom. Kontrola ove planine će dozvoliti da otvoriš vatru na rute prilaza %(b_ht_villagePhrase) i napadneš nepriatelja sa boka. Stene će pružiti zaštitu od neprijatelja iz %(b_ht_southernForestPhrase). Zauzeta šuma otvara put ka Bazi 1."

msgid "02_malinovka/team2/heavyTank/title"
msgstr "Napad vetrenjače"

msgid "02_malinovka/team2/mediumTank/descr"
msgstr "Ključna tačka za ovu taktiku je %(b_mt_cowshedsPhrase1).%(p)Kretanjem uz desni bok, možeš da zauzmeš poziije na %(b_mt_northLedgePhrase) odakle možeš da gađaš neprijatelje na otvorenom. Dok si ne otkriven, možeš da stignš do neprijatelja uz ivicu %(b_mt_fieldPhrase) i zauzmeš %(b_mt_cowshedsPhrase2). Budi pažljiv da ne upadneš u vodu. Pod zaštitom struktura, možeš da napadneš nepriatelje blizu baze i bezbedno kreneš ka %(b_mt_swampPhrase) gde možeš da uočiš i pogodiš ciljeve u %(b_mt_southernForestPhrase)."

msgid "02_malinovka/team2/mediumTank/title"
msgstr "Napad na polju"

