msgid "queue/tip/1"
msgstr "Istraži mapu da imaš prednosti u borbi."

msgid "queue/tip/10"
msgstr "Da izbegneš neprijateljsku vatru, postaraj se da promeniš pozicije neotkriven."

msgid "queue/tip/11"
msgstr "Koristi objekte (stene, strukture) na mapi da zaštitiš svoje vozilo."

msgid "queue/tip/12"
msgstr "Oklopna vozila: U nekim slučajevima, možeš da se osloniš na oklop."

msgid "queue/tip/13"
msgstr "Vozila koja manevrišu: Manevrisanje je tvoje glavno oružje."

msgid "queue/tip/14"
msgstr "Ne otkrivaj svoje vozilo neprijateljskoj vatri, menjaj pozicije i ostani skriven od oblasti na mapi gde lako možeš biti pogođen."

msgid "queue/tip/15"
msgstr "Kada puniš, sakrij se i pokušaj da izbegneš neprijateljsku vatru."

msgid "queue/tip/16"
msgstr "Provociraj neprijatelja da puca i gađaj ih kada pune."

msgid "queue/tip/17"
msgstr "Da pobediš, moraš se kretati uz dostupne staze na mapi, probijaj neprijateljsku odbranu i uništi ciljeve."

msgid "queue/tip/18"
msgstr "Topografija pokazuje staze koje se savetuju, moguće borbene scenarije i popularne zone za srednje i teške tenkove."

msgid "queue/tip/19"
msgstr "Vreme je ograničeno. Završi vatrene linije da zaradiš dodatno vreme."

msgid "queue/tip/2"
msgstr "Topografija je režim koji ti pomaže da istražiš mape igre sam bez uticaja na statistiku."

msgid "queue/tip/20"
msgstr "Tok borbe zavisi od mnogo faktora. Prati svoje saveznike i razmisli od specifičnostima svog vozila."

msgid "queue/tip/21"
msgstr "Na poligonu za trening otpor neće biti jak, ali uvek budi na oprezu u pravim borbama i znaj detalje mape i karakteristike neprijateljskih vozila."

msgid "queue/tip/3"
msgstr "Nauči popularne staze i koriti ključne tačke."

msgid "queue/tip/4"
msgstr "Nauči tipične pozicije neprijatelja u borbi i koristi ovu informaciju kao prednost."

msgid "queue/tip/5"
msgstr "Postaraj se da koristiš nepravilnosti terena da gađaš neprijatelje bez primanja štete za uzvrat."

msgid "queue/tip/6"
msgstr "Ciljevi su locirani u oblastima koje su najpopularnije u standardnim borbama."

msgid "queue/tip/7"
msgstr "Saznaj slabe tačke različitih vozila i gađaj neprijatelje."

msgid "queue/tip/8"
msgstr "Linije vatre su pozicije sa zaštitom. Možeš ih koristiti da pratiš manevre neprijatelja ili gađaš vozila."

msgid "queue/tip/9"
msgstr "Prati linije vatre i završi misije da zaradiš dodatno vreme."

msgid "queue/titleTips"
msgstr "Korisni saveti"

