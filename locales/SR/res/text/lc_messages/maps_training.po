msgid "28_desert/team1/heavyTank/descr"
msgstr "<a_ht_mountains>Planine</a_ht_mountains> su ključna tačka za ovu taktiku.%(p) Prolazeći pored <a_ht_easternVillage>istočnog sela</a_ht_easternVillage> možeš da ideš ka <a_ht_mountains>planinama</a_ht_mountains>. Nakon uništenja neprijatelja vatrom sa srednje distance treba da prođeš <a_ht_gorge>klanac</a_ht_gorge> i uđeš u blisku borbu na prilazu ka <a_ht_thoroughfare>prolazu</a_ht_thoroughfare>. Nakon zauzimanja zaklona u <a_ht_dunes>dinama</a_ht_dunes> treba da uništiš branioce baze na <a_ht_balcony>balkonu</a_ht_balcony>. Zatim pređi <a_ht_ravine>uvalu</a_ht_ravine> i dovrši neprijateljska vozila u zapadnoj bazi."

msgid "28_desert/team1/heavyTank/title"
msgstr "Planinski napad"

msgid "28_desert/team1/mediumTank/descr"
msgstr "<a_mt_hills>Brda</a_mt_hills> su ključna tačka za ovu taktiku.%(p)Držeći <a_mt_temple>hram</a_mt_temple> kao orjentir treba da azauzmeš vatrenu poziciju pod okriljem <a_mt_longDune>dugačke dine</a_mt_longDune>. Ovo će ti omogućiti da kontrolišeš neprijatelje pored <a_mt_temple>hram</a_mt_temple> i na <a_mt_hills>brdima</a_mt_hills>. Mnoga vozila se kriju iza <a_mt_hills>brda</a_mt_hills> zato uvek budi pažljiv. Prilazeći neprijateljskoj zapadnoj bazi moraš da uništiš mete na <a_mt_shelf>elevaciji</a_mt_shelf> nakon čega možeš bezbedno da zaobiđeš neprijatelje pored <a_mt_westernVillage>zapadnog sela</a_mt_westernVillage>."

msgid "28_desert/team1/mediumTank/title"
msgstr "Brdski napad"

msgid "28_desert/team2/heavyTank/descr"
msgstr "<b_ht_hills>Brda</b_ht_hills> su ključna tačka za ovu taktiku. %(p)Krećući se duž <b_ht_shelf>elevacije</b_ht_shelf> možeš da zauzmeš poziciju za vatru na neprijatelje pored baze <b_ht_bigDune>velike dine</b_ht_bigDune>. Nakon čišćenja puta kreni ka <b_ht_longDune>velikoj dini</b_ht_longDune>. Koristeći je kao zaklon očisti stazu do neprijateljskih odbrambenih linija. Kreni <b_ht_detour>prečicom</b_ht_detour> do pozadine neprijatelja koji brani istočnu bazu."

msgid "28_desert/team2/heavyTank/title"
msgstr "Brdski napad"

msgid "28_desert/team2/mediumTank/descr"
msgstr "Ključna tačka ove taktike je vožnja do <b_mt_rocks>stena</b_mt_rocks>.%(p)Vozeći pored <b_mt_westernVillage>zapadnog sela</b_mt_westernVillage> treba brzo da zauzmeš vatrenu poziciju na <b_mt_rocks>stenama</b_mt_rocks> a da te ne ometaju moguće mete na putu. Nakon čišćenja neprijateljskih snaga sa ove pozicije treba da kreneš u <b_mt_gorge>klanac</b_mt_gorge> i dovršiš sve mete tu. Potom se popni na <b_mt_mountain>planinu</b_mt_mountain> i brzo se spusti u <b_mt_easternVillage>istočno selo</b_mt_easternVillage>. Nakon uništenja neprijatelja u istočnoj bazi lako ćeš da dovršiš preostali otpor oko <b_mt_river>reke</b_mt_river>."

