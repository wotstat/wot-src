msgid "06_ensk/team1/heavyTank/descr"
msgstr "Ključna tačka ove taktike je <a_ht_centralStreet>centralna ulica</a_ht_centralStreet>.%(p)Pozicije u <a_ht_smallYard>malom dvorištu</a_ht_smallYard> ti dozvoljavaju da se boriš protiv neprijatelja na <a_ht_centralStreet>centralnoj ulici</a_ht_centralStreet> i u <a_ht_largeYard>velikom dvorištu</a_ht_largeYard>. Zapamti da ima mnogo linija vatre na mapi zato kada igraš u <a_ht_smallYard>malom</a_ht_smallYard> ili <a_ht_largeYard> velikom dvorištu</a_ht_largeYard> kao i kada se krećeš ka <a_ht_centralStreet>centralnoj ulici</a_ht_centralStreet> moraš da budeš pažljiv i obratiš pažnju na <a_ht_square>trg</a_ht_square>. Nakon proboja kroz neprijateljsku odbranu u velikom dvorištu možeš da stigneš do neprijateljske baze kroz <a_ht_stadium>stadion</a_ht_stadium>. Odatle možeš da vidiš pozicije branilaca na suprotnom krilu u <a_ht_southernVillage>južnom selu</a_ht_southernVillage>."

msgid "06_ensk/team1/heavyTank/title"
msgstr "Napad u gradu"

msgid "06_ensk/team1/mediumTank/descr"
msgstr "<a_mt_storages>Skladišta</a_mt_storages> su ključna tačka za ovu taktiku.%(p)Kretanjem duž levog krila možeš da zauzmeš pozicije pored <a_mt_industrialArea>industrijske oblasti</a_mt_industrialArea>. Odatle, možeš da pucaš i na <a_mt_forest>Oblast vegetacije</a_mt_forest> i pored <a_mt_storages>skladišta</a_mt_storages>. Pod zaklonom nasipa i zgrada možeš bezbedno da priđeš neprijatelju u <a_mt_southernVillage>južnom selu</a_mt_southernVillage>. Ako ih uništiš sve tu imaš šansu da dodješ do baze i zaobiđeš neprijatelja u <a_mt_stadium>stadijumu</a_mt_stadium> ili pored <a_mt_platform>platforme</a_mt_platform>."

msgid "06_ensk/team1/mediumTank/title"
msgstr "Napad skladišta"

msgid "06_ensk/team2/heavyTank/descr"
msgstr "Ključna tačka ove taktike je <b_ht_centralStreet>centralna ulica</b_ht_centralStreet>.%(p)Pozicije u <b_ht_largeYard>velikom dvorištu</b_ht_largeYard> dozvoljavaju ti da se boriš protiv neprijatelja koji se nalaze na suprotnoj strani <b_ht_centralStreet>centralne ulice</b_ht_centralStreet>, kao i u dubini <b_ht_smallYard>malog dvorišta</b_ht_smallYard>. Imaj na umu da mapa nudi mnoge linije vatre, naročito prilikom izlaska na <b_ht_centralStreet>centralnu ulicu</b_ht_centralStreet> ili na putu od <b_ht_smallYard>malog dvorišta</b_ht_smallYard> do neprijateljske baze. Budi pažljiv i obrati pažnju na <b_ht_square>trg</b_ht_square>. Nakon proboja kroz neprijateljsku odbranu u gradu i dolaska do neprijateljske baze možeš da napadneš branioce na suprotnom krilu u <b_ht_northernVillage>severnom selu</b_ht_northernVillage>."

msgid "06_ensk/team2/heavyTank/title"
msgstr "Napad u gradu"

msgid "06_ensk/team2/mediumTank/descr"
msgstr "Ključna tačka ove taktike je <b_mt_industrialArea>industrijska oblast</b_mt_industrialArea>.%(p)Kretanjem duž desnog krila možeš da zauzmeš poziciju pored <b_mt_storages>skladišta</b_mt_storages> da bi pucao na neprijatelje na suprotnoj strani od industrijske oblasti. Zatim pod zaklonom skladišta treba da kreneš direktno u samu <b_mt_industrialArea>industrijsku oblast</b_mt_industrialArea>. Odatle koristeći razne zaklone možeš uspešno da se boriš protiv neprijatelja u <b_mt_industrialArea>industrijskoj oblasti</b_mt_industrialArea>, <b_mt_forest>oblasti vegetacije</b_mt_forest> i <b_mt_northernVillage>severnog sela</b_mt_northernVillage>. Nakon proboja kroz neprijateljske linije i stizanja do baze moguće je očistiti preostale baze u <b_mt_northernSuburb>severnom predgrađu</b_mt_northernSuburb>."

msgid "06_ensk/team2/mediumTank/title"
msgstr "Napad industrijske zone"

