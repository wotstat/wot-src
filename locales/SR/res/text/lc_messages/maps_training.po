msgid "07_lakeville/team1/heavyTank/descr"
msgstr "Ključna tačka ove taktike je <a_ht_mountainPass>prolaz</a_ht_mountainPass>.%(p)zauzimanjem pozicije na <a_ht_mountainPass>prolazu</a_ht_mountainPass>možeš efikasno da pucaš na neprijatelja i sa druge strane <a_ht_mountainPass>prolaza</a_ht_mountainPass> i sa <a_ht_southernEntrance>južnog prolaza</a_ht_southernEntrance>.Probijanje kroz odbranu u ovom smeru čisti put do neprijateljske baze. Odatle možeš da pucaš na neprijateljska vozila koja brane <a_ht_path>stazu</a_ht_path>kao i na neprijatelje koji se bore u <a_ht_town>gradu</a_ht_town>."

