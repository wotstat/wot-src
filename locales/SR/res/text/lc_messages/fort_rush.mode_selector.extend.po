msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Ovaj režim zahteva visoke performanse kompjutera. Iskusićeš probleme sa učitavanjem mapa, grafikom i pokretom vozila. U slučaju nedovoljnih performansi pokušaj da smanjiš kvalitet grafike u podešavanjima."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Smanjene performanse"

