msgid "notrecruitedtankman/cosm02_Spock/label"
msgstr "Poziv ka finalnoj granici"

msgid "notrecruitedtankman/cosm02_Sulu/desc"
msgstr "Izuzetan kormilar, Hikaru Sulu je takođe sjajan u mačevanju i skakanju iz orbite. Zbog njegove skromnosti, nemoguće je pogoditi koliko je dugačka lista njegovih veština."

msgid "notrecruitedtankman/cosm02_Sulu/howToGetInfo"
