msgid "T26_E4_SuperPershing_descr"
msgstr "Da bi povećali vatrenu moć, novi top sa dugom cevi od 90 mm je montiran na T26E1 Januara 1945. Prototip je označen kao T26E4. Razvoj je prekinut Januara 1947 zbog problema sa topom i mehanizmom punjenja. Ukupno je napravljeno 25 vozila do tada, ali ni jedno nije ušlo u aktivnu službu."

msgid "T26_E4_SuperPershing_long_special"
msgstr "Vozilo ima sjajnu prednju oklopljenost ( i \"ekrane\"!) koja odbija većinu pogodaka i može da uzvrati sa topom koji je sjajan za svoj nivo. Vozilo ima lošu pokretljivost tako da je nužno odabrati dobar pravac napada."

msgid "T26_E4_SuperPershing_short"
msgstr "T26E4"

msgid "T26_E4_SuperPershing_short_special"
msgstr "Precizan top, sjajna prednja oklopljenost"

