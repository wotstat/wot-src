msgstr "Zahtev za laki aero prenosivi tenk je dat u zimu 1941. Vozilo je razvijala Mormon-Herrington kompanija. Ukupno 830 vozila je proizvedeno od Aprila 1943 kroz Februar 1944. 260 vozila je dato britaniju u projektu Lend-Lease."

msgid "M22_Locust_long_special"
msgstr "Izuzetno dinamičan i pritajen izviđački tenk sa dobrim topom. Vozilo praktično nema mana, osim malog kapaciteta spremišta za municiju."

msgid "M22_Locust_short"
msgstr "Locust"

msgid "M22_Locust_short_special"
msgstr "Sjajna maksimalna brzina i dinamika, dobra prikrivenost"

msgid "M24A1"
msgstr "M24A1"

msgid "M2M19"
