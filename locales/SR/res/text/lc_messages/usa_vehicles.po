msgid "T34_hvy_BF_descr"
msgstr "Razvijan 1945 kao modernizacija teškog tenka T30. Vozilo je bilo opremljeno topom 120 mm T53 i novim motorom AV-1790. Kraj drugog svetskog rata je umanjio interesovanje za razvoj teškog tenka, tako da T34 nije nikada ušao u službu. Prototipovi su korišćeni na testiranju."

msgid "T34_hvy_BF_long_special"
msgstr "Teški tenk sa dobro oklopljenom kupolom i snažnim topom koji je sposoban da uništi skoro bilo kog protivnika koji ti stane na put. Vozilo će biti najefikasnije u pozicionoj bliskoj borbi, ako nađeš zaklon za ne tako dobro oklopljen trup."

msgid "T34_hvy_BF_short_special"
