msgid "answer_1"
msgstr "O: Idi u garažu i postavi kupljenu opremu u slobodan slot levo od slotova za municiju."

msgid "answer_10"
msgstr "O: Otkrijte položaj neprijatelja i zatim postavite svoje vozilo u u položaj gde je žbun izmedju vas i neprijatelja. Ne brinite se ako cev topa viri van žbunja - vozilo neće biti lakše uočljivo zbog toga."

msgid "answer_11"
msgstr "O: Ovo je probojnost različitih vrsta granata koje mogu da se koriste uz taj top."

msgid "answer_12"
msgstr "A: Ne neće nestati, ali neće biti efektivne dok član posade nije preobučen za ovo vozilo."

msgid "answer_13"
msgstr "O: Da. Oboje će istovremeno imati efekta."

msgid "answer_14"
msgstr "O: Postavi nišan na neprijateljsko vozilo i pritisni desno dugme miša."

msgid "answer_15"
msgstr "O: Pritisni i drži desno dugme miša i pogledaj u naokolo kamerom."

msgid "answer_16"
msgstr "O: Slabi efekat \"vatre\" fugasnih granata ako granata ne probije oklop. Takodje smanjuje štetu sudaranja, štiti posadu od povreda, i smanjuje vreme ošamućenja."

msgid "answer_17/contains_links"
msgstr "O: {openSupportURL[openTag]:s}Centar Korisničke Podrške{openSupportURL[closeTag]:s} "

msgid "answer_2"
msgstr "O: Desni klik na vozilo, izaberi \"Prodaj\", i ukloni svu opremu."

msgid "answer_3"
msgstr "O: Sam igrač nema nivo, ali vozila imaju. Nivo možete videti u donjem delu garaže u listi prikazanih vozila. Svaki tenk ima u gornjem levom uglu svoj nivo napisan rimskim ciframa."

msgid "answer_4"
msgstr "O: Ne. Nabijač, mehanizam topa i stabilizator se montiraju na vozilo i ostaju na njemu čak i ako se top promeni."

msgid "answer_5"
msgstr "O: Pritisni \"Shift\" da bi uključio ili isključio artiljerijski mod."

msgid "answer_6"
msgstr "O: Tip granate se može izabrati levim klikom na ikonicu pri dnu ekrana."

msgid "answer_7"
msgstr "O: Kamuflažna mreža ima efekt samo na vozilo na koje je postavljena. Postaje efektivna tri sekunde nakon što se vozilo zaustavi i neće nestati nakon borbe."

msgid "answer_8"
msgstr "O: Ne. Aparati za gašenje požara se potroše samo ako su aktivirani u toku borbe."

msgid "answer_9"
msgstr "O: Laki tenkovi su predviđeni da otkrivaju neprijateljska vozila. Izvidjači često završavaju svoju misiju bez direktnog napada na protivnike."

msgid "question_1"
msgstr "P: Kupio sam opremu u radnji. Kako da je montiram na vozilo?"

msgid "question_10"
msgstr "P: kako da najbolje iskoristim žbunje za skrivanje?"

msgid "question_11"
msgstr "P: Koje je značenje parametara probojnosti u karakteristikama topa - na primer \"112/189/29\""

msgid "question_12"
msgstr "P: Ako prebacim člana posade na drugo vozilo, hoće li njegove dodatne veštine nestati?"

msgid "question_13"
msgstr "P: Ako istovremeno kupim premijum nalog i premijum vozilo, hoće li se bonusi sabirati?"

msgid "question_14"
msgstr "P: Kako da uključim auto nišan?"

msgid "question_15"
msgstr "P: Kako da gledam okolo bez rotiranja kupole?"

msgid "question_16"
msgstr "P: Čemu služi dvoslojni oklop?"

msgid "question_17"
msgstr "P: Koga da kontaktiram u slučaju tehničkih ili finansijskih problema?"

msgid "question_2"
msgstr "P: Kako da prodam vozilo?"

msgid "question_3"
msgstr "P: Koji je moj nivo?"

msgid "question_4"
msgstr "P: Da li će se Nabijač, Mehanizam topa, Stabilizator ili Poboljšano nišanjenje uništiti ako zamenim top?"

msgid "question_5"
msgstr "P: Kako da uključim ili isključim artiljerijski mod?"

msgid "question_6"
msgstr "P: kako da izaberem vrstu granate pred početak bitke?"

msgid "question_7"
msgstr "P: Ako kupim kamuflažnu mrežu da li će ona raditi sa svim mojim vozilima? Da li se gubi posle borbe?"

msgid "question_8"
msgstr "P: Da li se aparati za gašenje požara troše posle borbe?"

msgid "question_9"
msgstr "P: Zašto ponekad drugi tipovi vozila nadmašuju moj laki tenk po pitanju vatrene moći?"
