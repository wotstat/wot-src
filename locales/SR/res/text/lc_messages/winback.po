msgstr "Nazad u akciju"

msgid "dailyQuestsIntroView/info/rewards/description"
msgstr "Možeš da zaradiš premijum vozila VIII nivoa za iznajmljivanje, izučiva vozila VI nivoa i popuste na izučavanje i kupovinu vozila kao nagrade. Nakon završetka napretka dobićeš glavnu nagradu."

