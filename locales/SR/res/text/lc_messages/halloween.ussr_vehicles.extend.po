msgid "IS_3_II_Halloween_event"
msgstr "Double"

msgid "IS_3_II_Halloween_event_descr"
msgstr "Kao deo programa Mirijum proširenja, IS-3-II je opremljen portabl sakupljačem materije. Snažan i dobro oklopljen, iako donekle spor, ovaj tenk se pokazao veoma efikasnim unutar anomalije kada njim upravljaju vešti operatori. Kako je izučavanje Mirijuma napredovalo, Double je postao glavna udarna snaga za jedinice koje operišu unutar zone."

msgid "IS_3_II_Halloween_event_long_special"
msgstr "Teški tenk sa dvocevnim topom, pristojnom štetom po hicu i pouzdanim oklopom."

msgid "IS_3_II_Halloween_event_short"
msgstr "Double"

