msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Kutije Zmajevog broda"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "KUTIJE ZMAJEVOG BRODA"

msgid "entryPoint/tooltip/description"
msgstr "Ovo su specijalne kutije koje sadrže jedinstvene i vredne stvari iz igre.\nMožeš da nabaviš kutije u prodavnici u igri ili premijum prodavnici."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kutije Zmajevog broda su trenutno nedostupne"

msgid "eventName/lowerCase"
msgstr "Ukroti zmaja, vozi se na vetru"

msgid "eventName/upperCase"
msgstr "UKROTI ZMAJA, VOZI SE NA VETRU"

msgid "infoPage/footer/description/compensation"
msgstr "Ako već imaš sva vozila sa liste mogućih iz kutije, onda će sva sledeća vozila koja dobiješ iz kutija Zmajevog broda biti kompenzovana u zlatu jednako njihovoj punoj vrednosti."

msgid "infoPage/footer/description/guaranteed"
msgstr "Svaka %(guaranteed0)s kutija Zmajevog broda garantovano sadrži vozila nivoa VIII - IX. Ako ih otvoriš bez dobijenog vozila, onda će vozilo VIII - IX nivoa koje ne poseduješ ispasti kada otvoriš %(guaranteed0)s&zwnbsp;. kutiju Zmajevog broda. Kada se to dogodi, brojač se poništava."

msgid "noBoxesView/description/"
msgstr "Nemaš više kutija.\nMožeš da ih nabaviš u prodavnici u igri."
