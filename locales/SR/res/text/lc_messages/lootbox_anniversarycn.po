msgid "entryPoint/tooltip/description"
msgstr "Ove specijalne kutije sadrže nova i jedinstvena vozila VIII-X nivoa i druge nagrade.\nMožeš da ih dobiješ kao poklon za kupovinu stvari u premijum prodavnici kao i da ih dobiješ otvarajući kutije bilo koje druge vrste."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Kutije trenutno ne mogu biti otvorene zbog tehničkih razloga. Izvinjavamo se zbog neprijatnosti."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Kutije božanskog blagoslova su trenutno nedostupne"

msgid "eventName/lowerCase"
msgstr "Božanski blagoslov"

msgid "eventName/upperCase"
msgstr "BOŽANSKI BLAGOSLOV"

msgid "infoPage/footer/description/autoOpen"
msgstr "Ako ne otvoriš sve kutije pre završetka događaja, biće otvorene automatski kasnije."

msgid "infoPage/footer/description/compensation"
msgstr "Ako već poseduješ sva vozila iz kutije, dobićeš izabranu kutiju kao zagarantovanu nagradu umesto vozila."

msgid "infoPage/footer/description/guaranteed"
msgstr "Svaka %(guaranteed0)s nebeska, %(guaranteed1)s rajska pomoć i %(guaranteed2)s izabrana kutija garantovano sadrže vozilo VIII-X nivoa. Ako ih otvoriš bez dobijenog vozila, onda će vozilo VIII-X nivoa koje ne poseduješ ispasti kada otvoriš %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. kutiju (u zavisnosti od tipa kutije). Kada se to dogodi, brojač se poništava."

msgid "infoPage/footer/title/compensation"
msgstr "Ako su sva vozila primljena"

msgid "infoPage/header/description"
msgstr "Otvorikutije za šansu da dobiješ vredne stvari iz igre!\nPogledaj ispod za listu mogućih nagrada."

msgid "noBoxesView/description/"
msgstr "Nemaš ni jednu kutiju.\nMožeš da ih nabaviš u premijum prodavnici."

msgid "singleRewardView/tooltip/boxName/"
msgstr "Izabrana kutija"

