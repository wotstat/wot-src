msgid "boxTooltip/description/text/bronze"
msgstr "Prilikom otvaranja, ove kutije mogu da ti daju premijum vozila VIII nivoa, valute iz igre i druge vredne nagrade."

msgid "boxTooltip/description/text/gold"
msgstr "Prilikom otvaranja, ove kutije mogu da ti daju premijum vozila X nivoa, valute iz igre i druge vredne nagrade."

msgid "boxTooltip/description/text/silver"
msgstr "Prilikom otvaranja, ove kutije mogu da ti daju premijum vozila IX nivoa, valute iz igre i druge vredne nagrade."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Može biti primljeno kao poklon za kupovinu stvari u premijum prodavnici kao i dobijene prilikom otvaranja kutija bilo koje druge vrste."

msgid "boxTooltip/howGet/text/gold"
msgstr "Može biti primljen prilikom otvaranja kutija bilo koje druge vrste."

msgid "boxTooltip/howGet/text/silver"
msgstr "Može biti primljen prilikom otvaranja kutija bilo koje druge vrste."

