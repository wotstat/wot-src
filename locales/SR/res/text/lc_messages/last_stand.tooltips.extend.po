msgid "Contact/status/inBattle/last_stand"
msgstr "U borbi Poslednjeg uporišta"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Ispaljuje hitac koji oštećuje metu i sva neprijateljska vozila u krugu od 35m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Ispaljuje hitac koji obnavlja poene izdržljivosti tako što ih krade od mete i obližnjih neprijateljskih vozila u krugu od 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Ispaljuje hitac koji ošamućuje metu i sva neprijateljska vozila u krugu od 35m."

msgid "advanced/ls_damageShield"
msgstr "Štiti protiv bilo koje štete (izuzev sudara, davljenja i udara) 10 sekundi."

msgid "advanced/ls_doubleDamage"
msgstr "Tvoj sledeći uspešan hitac nanosi dvostruku štetu."

msgid "advanced/ls_equipment"
msgstr "Taktički uređaji ti pomažu da se boriš efikasnije u borbama Poslednjeg uporišta, završiš etape i zaradiš vredne nagrade. Da bi ih opremio, klikni na jedan od slotova taktičkih uređaja."

msgid "advanced/ls_extraDamageSituational"
msgstr "Daje šansu za nanošenje povećane štete neprijateljskom vozilu."

msgid "advanced/ls_fastReload"
msgstr "Povećava brzinu vatre / punjenja šaržera."

msgid "advanced/ls_healSituational"
msgstr "Obnavlja nešto poena zdravlja nakon uništenja neprijateljskog vozila."

msgid "advanced/ls_invisibility"
msgstr "Privremeno zaustavlja neprijatelje da nišane u tvoje vozilo, obnavlja poene izdržljivosti, popravlja module, gasi požar, uklanja efekat ošamućenosti i tretira sve povređene članove posade."

msgid "advanced/ls_nitro"
msgstr "Privremeno povećava pokretljivost tvog vozila."

msgid "advanced/ls_nitroSituational"
msgstr "Privremeno povećava mobilnost vozila nakon primanja štete od neprijateljskog vozila."

msgid "advanced/ls_selfRepairKit"
msgstr "Obnavlja poene izdržljivosti, gasi požar, uklanja efekat šoka i popravlja oštećene module."

msgid "advanced/ls_teamRepairKit"
msgstr "Popravlja module, gasi požar, uklanja efekat šoka i obnavlja nešto poena izdržljivosti na savezničkim vozilima u svom dometu."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktički uređaji mogu biti opremljene u specijalnim slotovima da ti pomognu da se efikasnije boriš u borbama Poslednjeg uporišta, završiš etape i zaradiš vredne nagrade."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Slotovi taktičkih uređaja"
