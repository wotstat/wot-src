msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "Pojistkina cela pokretna radionica na gusenicama. Oštri uglovi, uređene žice, svaki sistem odgovara na prvi zahtev. Krenuli smo da zaustavimo našeg poludelog naučnika i završili boreći se protiv nečega što on zove električnom inteligencijom. Njegovi Sentineli i dalje uče, gledaju svaki potez koji mi napravimo. Napravio ih je da nas zameni. U redu. Onda je današnja lekcija moja. Pronaći ću greben, usmeriti se ka meti i pustiti ove nasmejane granate da odrade ostalo. Ako zaista veruje da njegova razmišljajuća mašina može da nas nadživi, da vidimo šta će da misli kada se pritisak pojača."

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "Glavna modernizacija glavnog borbenog tenka"

msgid "Turret_1_Cz04_T50_51_Waf_Hound_3DSt"
