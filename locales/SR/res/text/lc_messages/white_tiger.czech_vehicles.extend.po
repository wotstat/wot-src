msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silver Bullet"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "Ponos oklopnika Alijanse"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Svaki preopterećeni generator će napuniti srebrni metak plazmom. Što je više punjenja, to plazma više štete nanosi. Za maksimalnu štetu pucaj kada je štit Blitzträger-a spušten."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Dodatna šteta plazmom"
