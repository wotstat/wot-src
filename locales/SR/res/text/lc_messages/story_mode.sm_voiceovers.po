msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfajer pilot: Vidljivost je loša, ne mogu da pomognem!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfajer pilot: Previše PVO vatre, ne mogu da pomognem!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfajer pilot: Teška PVO vatra, podešavanje vatre je nemoguće."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfajer pilot: Ovde izgleda kao mećava flaka a?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfajer pilot: Ne možemo da podešavamo vatru bojnog broda po ovim baražom."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfajer pilot: Potrebno nam je da uništimo te PVO baterije pored bunkera."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfajer pilot: Uspeo sam da se spustim niže."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfajer pilot: Sada mogu da počnem da pozivam hice sa velikih topova koristeći dimen signale sa zemlje."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfajer pilot: Tenkovi, vi ste na potezu!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfajer pilot: Uočio sam dim."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfajer pilot: Prosleđujem koordinate bojnom brodu za direkatan pogodak."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfajer pilot: Dođavola, jedan od naših pada! I dalje ne mogu niže."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfajer pilot: Moramo da uništimo druge PVO topove sada!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfajer pilot: PVO topovi su uništeni, spuštam se niže. Spreman da navodim gušću vatru sa našeg bojnog broda."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfajer pilot: Pažnja! Velika neprijateljska grupa je uočena kako ide ka vama."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfajer pilot: Napadaju sa svim što imaju."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfajer pilot: Pazite, nova grupa neprijatelja prilazi. Budite pažljivi vi dole."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfajer pilot: Upozorenje, dolazi najveći i poslednji talas neprijatelja."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfajer pilot: Prilaze sa svih strana. Pripremite se."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfajer pilot: Jasno vidim dimni signal. Koordinate su poslate bojnom brodu."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfajer pilot: Eh, evo ga jedan dimni marker. Prenosim lokaciju bojnom brodu."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfajer pilot: Dimni signal je na meti. Šaljem tačnu lokaciju bojnom brodu."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfajer pilot: Vidim dim, izgleda da je našim prijateljima potrebna pomoć."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Kapetan USS Frankforda: Čekamo koordinate za vatrenu podršku."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Kapetan USS Frankforda: Vatra naslepo je riskantna, možda pogodimo svoje."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Kapetan USS Frankforda: Trebaju nam precizne mete, ne pucamo."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Kapetan USS Frankforda: Ovde je kapetan USS Frankforda. Negativno."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Kapetan USS Frankforda: Ne vidimo nastupanje. Vidljivost je previše loša."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Kapetan USS Frankforda: Ne vidimo litice i bunkere, samo su naši tenkovi na plaži vidljivi."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Kapetan USS Frankforda: Vidimo tenkova koji napadaju ka liticama."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Kapetan USS Frankforda: Podržaćemo ih vatrom u tom smeru."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Kapetan USS Frankforda: Nadam se da ovaj Šerman zna u šta puca."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Kapetan USS Frankforda: Šerman je promenio metu. Podešavamo da se poklopimo."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Kapetan USS Frankforda: Šerman je prestao da puca. Posao je završen."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Kapetan USS Frankforda: Ne možemo da dosegnemo bunkere dublje u kopnu."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Kapetan USS Frankforda: Povlačimo se na bezbednu udaljenost sada. Srećno na obali."

