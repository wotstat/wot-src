msgid "vo_sm_char11_m03_stg18_03"
msgstr "Pilot: Hej, zemaljske jedinice, ovde Orao Jedan."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Pilot: Nadlećemo grad, imamo pravu gomilu tenkova na nišanu."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Pilot: A spremili smo takete. Rasčistite se tamo dole."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Pilot:Orao jedan prijem."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Pilot: Ovde Orao Jedan, jasno i glasno."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Pilot: Imaš malu grupu ciljeva na trgu."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Pilot: Spremamo napad sada."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Pilot: Šta ne pretvorimo u vatromet, vaše je. Srećan lov. Prijem.."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Pilot: Odakle ovi? Bio sam siguran da je naša aero podrška očistila nebo."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Pilot: Ovde Orao Jedan, prijem."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Pilot: Imaš dobru grupu oklopnih vozila koja se kreće prema tebi iz sela."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Pilot: Preletećemo i ... Prokletstvo!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Pilot: Lovci na 8 sati... Ne mogu da ga otresem sa repa."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Pilot:Gde je moja prokleta pratnja! A-a-aa!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Pilot: Olujni burenjak ovde."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Pilot: Razumem. King Tiger će uskoro imati baš loš dan."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Pilot: Raznesen!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Pilot: Neprijatelj uništen."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Pilot: Olujni burenjak. Ne galeb."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Pilot: Vidim."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Pilot: Cilj uništen za 3...2...1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Pilot: Čekam nove ciljeve Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Pilot: Prokletstvo!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Pilot: Nije samo Jagdtiger dole. U zgradama su."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Pilot: Treba nam nešto sa više udarca. Vreme je da se pozove nešto veće!"

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Pilot: I to je to! Spreman za sledećeg!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Pilot: Spreman za napad na tvoj signal."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Pilot: Direktan pogodak!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr " Razumem! Napadam!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Pilot:Konačno! Vraćam se na aerodrom. Vidimo se uskoro momci!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Pilot: Spreman i čekam ciljeve."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Pilot: Čekam potvrdu cilja."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Pilot: Koordinate potrebne za napad."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Pilot:Ne mogu da ga pogodim dok ga ne imobilišete."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Pilot: Meta treba da se statična za precizan napad."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Pilot: Imobilizacija je cilj uspešnog pogotka!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Pilot: Okrećem, vraćam se uskoro."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Pilot: Menjam poziciju, vraćam se u akciju uskoro."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Pilot: Spreman za napad."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Pilot: Dajte signal za napad."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Pilot: Još čekam ovde."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Pilot: Nastavljam da čekam instrukcije."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Pilot: Razumem. Pripremam nalet sada."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Pilot: Primljeno. Spremam napad."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Pilot: Razumem. Napadam."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Pilot: Razumeo. Prilazim za napad."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smit: Ne sam papir."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smit: Volja miliona. Ljudi i žena koji su se borili kako bi taj papir nešto značio."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smit: Nikada više."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Komandir, kap. Smit: Pokret. Zapamtite, ovo je tajna operacija."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smit: Izbegavajte nepotrebne sukobe i pucajte samo kada je apsolutno neophodno."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smit: Ako uzbunimo ceo garnizon, naše šanse će biti ravne nuli."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smit: Kada god je moguće, naćićemo obilazak i sakriti se."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smit: Nema vremena za gubljenje. Pokret. Svaka sekunda je bitna."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smit: Prekini. Ovde smo da zaustavimo krvoproliće. Obe strane."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smit: STANI! Unazad!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smit: Vrati se!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smit: Vrati se! Brže!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smit: U nazad, odmah!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smit: Sakrij se"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smit: Izgleda da nas nisu dobro uočili."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smit: Tama radi u našu korist - treba im duže da identifikuju američki tenk."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smit: Ako prođemo brzo, neće nas identifikovati."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smit: Marfi smesti nas iza tog ugla."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smit: Dobro Marfi. Moramo polako napred. I ne pucaj!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smit: Hajde da se prišunjamo još bliže. Tako!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smit: Kreći se brzo i neće nas uočiti."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smit: Što brže idemo, manje vremena imaju da nas primete."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smit: Ako se krećemo brzo, neće imati vremena da nas dobro pogledaju."

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smit: Moramo da izvidimo unapred. Duboa, proveri situaciju."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smit: Rekao sam prekini, Kovalski"

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smit: Kreću se. Duboa, vrati se unutra."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smit: Hajde da uzmemo te mape. Pokret"

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smit: Dođavola! Neprijatelj na 12 sati. Kovalski, pucaj!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smit: Marfi, manevar izbegavanja. Kovalski brzo ga dovrši."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smit: Nemamo vremena za zafrkavanje. Moramo da budemo tihi."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smit: Dosta, Kovalski. Nećemo stići do naših momaka bez Kelera."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smit: Hajde da se pomerimo pre nego što se pojavi neko drugi."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smit: Tigar! U zaklon! Dođavola."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smit: Negativno. Ne smemo da rizikujemo. Keler. Pokušaj da ga ometeš."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smit: Keler, hajde. Uradi to."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smit: Upotrebi radio da ih prevariš."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smit: Pomeri se pre nego što se vrati."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smit: Duboa pronađi tu mapu."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smit: Šta je"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smit: Dakle sakupili smo sve delove mape. Idemo."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smit: Odlično marfi, označi ga."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smit: Hajdemo do sledeće tačke. Vreme ističe."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smit: Hajdemo do sledeće postaje."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smit: Hajde da krenemo. Svaki minut je važan."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smit: Duboa, proveri za mape."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smit: Marfi kako napredujemo?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smit: Sad bar znamo za drugu komandnu postaju. Pokret."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smit: Duboa? Da li si pronašao nešto?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smit: Pokret ka sledećoj tački. Vreme ističe."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smit: Duboa, ti si na redu."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smit: Hajdemo na sledeću poziciju."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smit: Marfi, kako napredujemo?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smit: Hajde da vidimo šta smo pronašli."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smit: Keler, da li je ovo komandno mesto?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smit: Povlači se!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smit: Ne napadaj!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smit: Ne pucaj!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smit: Ne pucaj! Nismo zato ovde!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smit: Polako sad! Naš posao je da isporučimo poruku, ne da započnemo krvoproliće!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smit: U nazad odmah! Primetiće nas!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smit: Povlačenje! Da nas ne vide!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smit: Unazad, Marfi drži nas prikrivene!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smit: Neprimećeni. Ostanimo tako."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smit: Neprijatelj nas ne vidi."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smit: Unazad odmah! Skoro su nas videli!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smit: Povlači se! Videće nas!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smit: Marfi pronađi nam zaklon! Još uvek ne znaju ko smo!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smit: Kreći! I dalje nisu sigurni!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smit: Idi u ove senke! Nisu nas prepoznali!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smit: Marfi okreni unazad! Ili će saznati!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smit: Mislim da bi trebalo da se vratimo."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smit: Ne možemo da rizikujemo misiju. Hajde da se povučemo."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smit: Zapamtite našu misiju! Ako je povlačenje bezbednije, to ćemo da uradimo."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smit: Promena pozicije. Proveriće ovu oblast."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smit: Kreći. Ovo mesto će uskoro vrveti od Pancera."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smit: Promašili su nas. Ostanite nisko i tiho."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smit: Napadni mete!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smit: Na položaje! Ostanite skoncentrisani!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smit: Kontakt!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smit: Čisto! Pokret!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smit: Meta je dole!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smit: Uništeno!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smit: Čvrsto čudo. Sledeći put hajde da nađemo drugi način."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smit: Bolje da izvidimo unapred pre pokreta."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smit: Nazad u tenk. Krećemo."

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smit: Dosta izviđanja. Pokret."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smit: Svi u tenk. Vreme je za pokret."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smit: Hajde da ne traćimo vreme. Pokret."

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smit: Keler može da ih odvuče sa lažnim naređenjem."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smit: Skoncentrišite se na cilj. Trebaju nam ti fragmenti mape da spasemo naše ljude."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smit: Pokret! Ovo nije vreme za dremanje."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smit: Svaka sekunda je bitna. Kreći."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smit: Nema izbora. Moramo da se borimo."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smit: Pronađi nam alternativnu rutu."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smit: Upotrebi radio. Odvedi ih od nas."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smit: Sačekaj da se njihova patrola pomeri."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smit: Tenk je popravljen ali smo izgubili puno vremena. Budi te oprezni."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smit: Na oprezu su. Sada će pucati čim nas ugledaju."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smit: Odakle su došli?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smit: Previše rizikujemo. Guraj napred!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smit: Marfi, samo nas dovezi tamo u jednom komadu."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smit: Tiger! Dođavola!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smit: Lovi nas."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smit: Ne možemo da probijemo njegov prednji oklop, ali on će probiti naš kao papir."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smit: Samo nastavi da se krećeš - brzina je naša jedina prednost!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smit: Neprijateljska artiljerija se budi. Moramo da manevrišemo!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smit: Samo uradi šta možeš."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smit: Tiger je blizu. Drži distancu, Marfi!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smit: Tiger je preblizu! Moramo da se odvojimo!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smit: Povlači se odmah! Ima nas na nišanu!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smit: Nanišanio nas je U Izbegavanje odmah!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smit: Tiger je promašio! Ne daj mu novu priliku!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smit: Čuvaj municiju. Nema svrhe pucati na prednji oklop Tiger-a."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smit: Zaboravi na Tiger - fokusiraj se na manje mete."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smit: Gusenica je raznešena! Imobilizovan je!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smit: Artiljerija! Na desno!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smit: Artiljerijski baraž! Skreni levo!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smit: Artiljerija! Odmah stani!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smit: Artiljerija! Manevar izbegavanja!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smit: Artiljerijski baraž! Okreći odmah!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smit: Ove možemo da savladamo. Kovalski, otvori vatru."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smit: Ovi mogu biti uništeni. Kovalski, pucaj po volji."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smit: Ne troši municiju na Ferdinand-a!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smit: Ignoriši Ferdinand-a, ne možemo da ga oštetimo."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smit: Minsko polje je iza nas. Marfi, gas do daske. Naši momci čekaju."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smit: Keler, prebaci se na savezničku frekvenciju, poveži me."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smit: Pažnja svim jedinicama, ovo je kapetan Džek Smit, 2. oklopna divizija."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smit: Prilazimo u M24 Chaffee-ju sa zapada."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smit: Ne pucajte. Ponavljam, ne pucajte."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smit: Imamo hitno naređenje iz štaba III korpusa. Izazov: \"Baklja\". Gotovo."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smit: Stigli smo momci. Rat je ovde završen."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smit: Dođavola. Izneverili smo ih sve."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smit: Previše buke. Aktiviramo svaki radar odavde do Berlina."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smit: Ovo nije streljana. Moramo da budemo više pritajeni."

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smit: Moramo da se krećemo tiše. Svaki hitac privlači još neželjene pažnje."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smit: Sva ova buka će privući pojačanja. Nećemo stići do naših momaka na vreme."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smit: Da li si uhvatio nešto?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smit: Dobro?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smit: Ne."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smit: Ulica? Kako? Slušajući svanaša imena?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smit: Skoncentriši se na put."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keler: Nie wieder.(Nikada više)"

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Radio operater, podoficir Keler: Postoji komandno mesto tek izvan grada. Tamo drže mape minskog polja."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keler: Izgleda da je patrola. Trebalo bi da se pokrenu uskoro."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keler: Komandno mesto sa mapama, tamo je na brdu."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keler: To je bio komandni tenk."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keler: Ako mi je radio ispravan i na pravoj frekvenciji, mogao bih..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keler: Nein, daj patrolama lažna naređenja. Zbuni ih. Da možemo da prođemo."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keler: Da, kapetane Smit"

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keler: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Pažnja, Panzer četiri! Neprijateljska aktivnostu u sektoru tačka Berta.)"

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keler: Sofort aufklären!\n(Istražite odmah!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keler: Ovo je komandno mesto."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keler: Ove oznake takođe označavaju komandna mesta. Ona imaju fragmente mape prolaza."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keler: Za naše...nemačke izviđače. Trebalo bi da pogledamo tamo."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keler: Ovde."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keler: Nisu svi oficiri odgovorni za minska polja."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keler: Izgleda da smo pronašli još jedno komandno mesto. Trebalo bi da proverimo."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keler: Da možda ima i fragmenat mape takođe."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keler: Ne."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keler: Nisu... nisu nas primetili."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keler: Odustali su od traganja...za sada."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keler: Možda mogu da ih odvučem sa naše putanje."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keler: Idem u etar."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keler: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Pažnja! Zauzmite nove pozicije u sektoru Berta. Izvršite odmah!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keler: Priključujem se."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keler: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Hitno naređenje! Potrebno je pregrupisavanje na tačku Dora!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keler: Prebacujem se na njihovu frekfenciju."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keler: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Neprijateljska aktivnost u sektoru Emil! Istražite odmah!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keler: Emitujem sada."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keler: Zurückziehen auf Stellung Gustav! Schnell! Schnell!\n(Vratite se na poziciju Gustav! Najveći prioritet!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keler: Emitujem."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keler: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Borbena grupa sever prijavljuje neprijateljski kontakt! Potrebna su pojačanja!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keler: Nema nikoga na ovoj frekfenciji u dometu."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keler: Ni jedna jedinica ne odgovara u ovoj oblasti."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keler: Nema nemačkih snaga u blizini da prime naređenja."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keler: Nema odgovora. Nema ni jednog nemačkog tenka u blizini. Mislim."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keler: Negativno."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keler: Ne mogu."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keler: Neće uspeti."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keler: To je tenk komandanta voda, neće primiti naređenja od nas."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keler: Komandir voda... Neće primiti naređenja od nas."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keler: Tenk komandira voda. Oni primaju naređenja samo iz štaba bataljona."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keler: Ovde su ukopani. Beskorisno je da im naređujemo bilo šta."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keler: Ovaj tenk je oštećen. Koriste ga kao bunker."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keler: To je oštećen tenk. Ne mogu da se kreću."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keler: Njihove gusenice su prekinute. Ostaće svakako."

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keler: Achtung! Vraćaju se na poziciju."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keler: Vraćaju se. Budite oprezni."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keler: Oprez! Okrenuli su se unazad."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keler: Možda bi trebalo...hm...da krenemo ka komandnom mestu?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keler: Pre promene patrola?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keler: Pustite me da probam da ih zbunim."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keler: Ovo je patrola. Trebalo bi da se uskoro pomere."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keler: Imamo sreće. Sudbina želi da završimo misiju."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keler: Kapetane, prijavljuju odbegli američki tenk na radiju."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keler: Traže nas sada."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keler: Čujem naređenja da...da pošalju pojačanja."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keler: Specijalna jedinica nas sada lovi..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keler: Ovo je patrola. Ako istempiramo kako treba, možemo da se provučemo."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keler: Patrole prate striktne rute. Možemo da se provučemo kada odu."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keler: Patrola. Napustiće ovu poziciju uskoro."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keler: Ovi tenkovi ne mogu da se kreću više, ali ih koriste kao fiksne pozicije..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keler: Garnizon je bez rezervnih delova ali i dalje koriste ove tenkove kao bunkere."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keler: Nestašica goriva znači da su ovi samo...samo bunkeri sada."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keler: Ali njihovi topovi su i dalje opasni..."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keler: Kapetane...Pancer! Upravo tamo!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keler: Možda...možda bi trebalo da usporimo?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keler: Da, gospodine."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keler: Ali iskrivljenost tornja u Pizi, u...Pizi..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keler: Ovaj radio je za komunikaciju. Koristimo ga da zbunimo patrole."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keler: Ne bih hteo da..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keler: Mogu da pokušam. Ali bi to bila nemačka muzika."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keler: Zapravo preko 1.000."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keler: Jesam. Čvrst spolja, mekan iznutra."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keler: Pa...zapravo...dve posade su raspravljale o duhu koji uhodi grad noću."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keler: Ne...Nikada nisam mislio da ću biti u nekom tenku..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keler: Zapravo, preplašen sam. Samo sam uplašen da to pokažem."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kovalski: Nigdy więcej.(Nikada više)"

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Nišandžija, narednik Kovalski: Zašto smo poveli ovog Švabu sa nama? Odvešće nas pravo u zamku."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kovalski: O svakako, veruj na reč Nemcu koji nas je odveo u grad koji je zamka."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kovalski: Pozvati Nemce ovde?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kovalski: Chaffee nije pravljen za tu borbu. Mada...ako Marfi..."

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kovalski: Pa hajde onda, reci im nešto već jednom."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kovalski: Da li si zaboravio da govoriš nemački Keler?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kovalski: Reci tom Tiger-u da se sklanja odavde!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kovalski: Šta? Mislio sam da svako komandno mesto ima fragment mape. Keler?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kovalski: Pa bar smo dodali još par pancira na našu listu."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kovalski: Pa bar smo dodali još par pancira na našu listu."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kovalski: I pronašli neka lepa komandna mesta takođe."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kovalski: Šta ako je..."

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kovalski: Slepi idioti."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kovalski: Ha! Kako su nas promašili?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kovalski: Hajde da idemo pre nego se još Švaba pojavi."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kovalski: Slepi idioti. Neće dobiti drugu šansu."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kovalski: Konačno! Vreme je za akciju!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kovalski: Čisto. Ko je sledeći?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kovalski: Imam te!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kovalski: Sada nisi tako moćan, zar ne? Ali smo izgubili mnogo vremena."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kovalski: Hajde da ne srljamo na slepo. Šta mislite?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kovalski: Možda Duboa može da izvidi unaokolo?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kovalski: Ne."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kovalski: Prekini sa traćenjem vremena! Ova mapa je naša karta kroz minsko polje."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kovalski: Kreni ili ću sam da počnem da guram tenk!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kovalski: Traže kavgu. Hajde da im pokažemo gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kovalski: Ok, ovaj put hajde da ne idemo pravo na njihove topove."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kovalski: Okej, zagrevanje je gotovo. Sada radimo za stvarno."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kovalski: Vidi šta to imamo ovde!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kovalski: Naši topovi će početi da pucaju svakog momenta. Požuri!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kovalski: Pazite! Primetili su nas!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kovalski: Tiger nišani! Ako ga se ne otarasimo odmah, gotovi smo!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kovalski: Tiger će da zapuca...Znam to nišanjenje!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kovalski: Kurde! Da sam to bio ja ne bih promašio."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kovalski: To je sve što umeš Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kovalski: Świetnie! Tačno tamo gde sam hteo!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kovalski: Vidi šta imamo ovde! Lake mete!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kovalski: Beskorisno. Mogli bi i kamenjem da ga gadjamo!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kovalski: Marfi, da li si zaboravio? Mine su po svuda unaokolo!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kovalski: Dostał"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kovalski: Klanica počinje. Bili smo prespori..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kovalski: Samo na venčanjima."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kovalski: Da li je to prosidba Marfi?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kovalski: Marfi, hajde da popričamo o tvom stilu vožnje."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kovalski: Da li namerno udaraš u svaku neravninu i voziš po nagibima da nagneš tenk?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kovalski: Tvoji saveznici takođe."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kovalski: Ponekada se brinem za tebe Marfi."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kovalski: Ozbiljno. Zaista se brinem za tebe."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kovalski: Ne više."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kovalski: Sumnjam."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kovalski: Za učitelja u tenku, neobično si tih Keler."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kovalski: Hm. To je...iznenađujuće iskreno."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kovalski: Duboa šta to pevušiš tamo?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Da gospodine, razumeo! Idemo na Berta tačku!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Razumeo, idem na Bertu.)"

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Da gospodine, počinjemo regrupisanje.)"

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Da gospodine, započinjemo sa izviđanjem.)"

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Razumem, povlačimo se.)"

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Potvrđeno, dolazimo.)"

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Sharf: Komandante, imamo ograničenu vazdušnu podršku na čekanju."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Možeš da pozoveš napad kad god je potrebno."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Svestan si da imamo radio, zar ne? Čitavo ostrvo zna da si tamo."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Ako je moguće, pokušaj da zarobiš to vozilo u celosti. Komanda želi da ga ispita."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Da li podseća na nešto Nemačko?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Obzirom na broj neprijateljskih vozila, moraju tamo imati objekte za održavanje."

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: Negde na ovom ostrvu."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Ubrzaj se. Raketa neće čekati."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Rekao sam ti da sam trebao da krenem sa tobom. Previše sporo napreduješ."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Pokušaj da ga onesposobiš bez značajne štete. Taj uzorak nam treba ceco."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni. Barem pokušaj. Važi?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Budi ekstremno pažljiv. Sigurno je zamka."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Otkrili smo njihovu radio frekvenciju."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Pratimo njihov radio saobraćaj poslednjih sedam minuta."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Nisi dovoljno prekinuo priču da mogu barem da te obavestim."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Možda da probaš tišinu ponekad Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni. Novi cilj je dobijen: To vozilo mora biti zarobljeno bez oštećenja."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Šta ima? Neki ne-standarni moduli? Neka specijalna oprema?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Komandante, da li si siguran da ne želiš da probaš ovaj novi tenk?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Obzirom na zasedu ispred, dodatna vatrena snaga bi bila prava avantura."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, znaš da te ne čuje?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Ja samo presrećem njihov saobraćaj, ne emitujem naš."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Izveštaj. Da li je samo Nemački oklop?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Kao što sam sumljao. Ovo je komplikovanije nego što smo mislili."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: Na osnovu komunikacija koje smo presreli..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Podsetnik: To vozilo mora biti zarobljeno celo za analizu. I dobro, da..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: I ja želim da ga isprobam."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Ispravka: Nemamo konkretnih dokaza da su Nemci."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Trenutne informacijekažu da je mežunarodna plaćenička grupa."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Taj glas... Nešto mi je poznat njihov komandant. Čuo sam taj glas ranije, negde..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: To bi bilo najljubaznije od tebe."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Da, molim."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Šta se desilo?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Upravo zbog ovog insistiram da se ta vozila zarobe cela."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Donesite mi eksperimentalna vozila, i sagradiću vam nešto... impresivno."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Komandante, savetujem da se proba ovaj novi tenk. Pružiće jedinstvene borbene sposobnosti."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Pa, možda je ostavljanje tamo mudar izbor."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Sigurno će ostati netaknut, a naši inženjeri ga mogu vratiti nakon misije."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Ima li među njima nekih eksperimentalnih mašina? Bilo šta neobično?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Ova Adler grupa... Moramo da ih istražimo."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: Mogli bi pomoći u identifikaciji prošlosti našeg misterioznog komandanta."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Pratimo raketu na našim radarima. Vremenski prozor je uzak."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Novi cilj: Osiguraj centar za kontrolu leta. Možda ćemo moći daljinski da promenimo njegovu putanju."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Momentalno izvrši."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Kakva iznenađenja ovaj tenk ima za nas?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Ovaj nov Teški tenk ima pojačan oklop. Optimalan za sukob sa više neprijatelja."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Komandante, savetujem osvajanje."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Naš tehnički tim kreće ka sobi za kontrolu leta. Zadrži poziciju. Treba nam vremena."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Moramo ih zadržati duže."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Dobro, dobro... Ne sada!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Ne možemo preuzeti kontrolu. Bez obzira šta, ne možemo da promenimo putanju. Ali..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: Nešto je ovde čudno."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Tvoj prozor prilike se zatvara brzo. Nemoj gubiti vreme."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Sat misije otkucava. Kreni."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Što si duže stacionaran, više vremena oni imaju za mobilizaciju snaga."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Nastavi ka cilju."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Izgubili smo vodeći tenk. Zadrži formaciju!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Komandantov tenk je eliminisan. Spremamo nov za njega."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Nemamo neograničena pojačanja. Budi pažljiviji."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Sledeći put budi brži, ili neće biti sledećeg puta."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Njihove baze za popravke sadrže ograničene količine ovih tenkova."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Molim, upravljaj sa više pažnje sledeći put."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Cilj nije uspeo. Ostali smo bez vremena."

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Svi tenkovi su izgubljeni. Gubitak misije potvrđen."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Vazdušna podrška je aktivirana. Spremi se za udar."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Avion je napao cilj. Udar za nekoliko sekundi."

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Lokacija cilja nije dobra za vazdušnu podršku."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Artiljerijski napad je detektovan. Smesta se premesti!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Neprijateljska artiljerija puca. Udar za par sekundi. Beži! Odmah!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Neprijateljski posmatrač poziva vatru na tvoju lokaciju. Beži iz zone udara smesta!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Negativno."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Vremenski uslovi. Oblačno. Temperatura 8 stepeni. Vetar 6 metara u sekundi, sever - severozapad."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni. Imam par teorija. Ali mi je potrebno više dokaza pre nego ih podelim."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Poslednja osoba koja me je zvala dušo je izgubila dva prsta."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Ali mirno veče na pravom mestu... Možda razmislim."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, bespotrebno rizikuješ."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: A život sa previše rizika se brže završi. Kao tvoj prethodnik."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Pametno."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Prihvatiću to kao kompliment."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: Nije magija."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: Fokusiran elektromagnetski puls koji privremeno onesposobljava njihove elektro sisteme."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Samo se vrati živ. Zamena treniranog osoblja je birokratski naporna."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Ako završiš tu rečenicu u komparaciji samnom,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: Lično ću se postarati da ti sledeća misija bude na Artiku."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Preminuo je. Imam ovde kompletnu dokumentaciju."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Ovo izgleda... Proračunato."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Svaka barijera, svaka odbrana - oni kupuju vreme, ne žele da nas potpuno zaustave."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Mislim da igramo ulogu u nečijem proračunu. A ja ne volim da sam varijabla."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Računam šanse za preživljavanje na osnovu varijabli trenutne misije."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Odlučila sam da ne podelim taj rezultat. Moral je takođe varijabla."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Pratim."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Umanjenje od 23% u kvalitetu od kad je misija počela, ali 47% povećanja u frekvenciji."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Znaj svoje saveznike."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Nikad."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Ova eksperimentalna jedinica je prava opasnost. Menjaj taktike shodno."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Komandatov tenk je uništen. Ova mašina je efektivnija nego što smo mislili."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Gledaj ovaj nered! Kao vukovi u toru ovaca."

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Ali kao što kažu u mom selu. \"Drugi talas lomi branu.\""

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Nemci... Ko bi rekao?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: Jedan beži! Moramo ga zaustaviti pre nego dovede prijatelje!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Da, ali sada je sam. Dosta lakše za uništenje nego ako se vrati sa drugarima."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: E to je u mom stilu! Prvo pucaj, skontaj kasnije šta je stvar sa dugom cevi!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Jesi video taj pogodak?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: To će ga naučiti da se pojavi sa svojim otmenim topom ovde!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Zarobiti? Uz svo dužno poštovanje, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: Preferiram da prvo pucam pa kasnije da popunjavam papirologiju."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Ta stvar nas je zamalo pretvorila u otpadni metal! Ali dobro, potrudiću se da ne pogađam ništa bitno..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: samo policu municije."

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Vidi ti to - drugi tenk kojeg nikad video nisam pre!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: Trenutno, Ne znam više ni protiv koga se borimo."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Liči na nešto sasvnim drugačije."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Nadam se da ćemo pronaći depo municije uskoro. Nisam siguran da imam dovoljno granata za sve."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Još jedan! Volim ove momke!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Formiraj liniju, formiraj liniju! Jedan po jedan. Imam mali poklon za svakog."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Nervira me! Čekaj, on to opravlja sebe tamo ili šta?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Samo čekaj - Uskoro te stižem da te rastavim šraf po šraf!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Da li si apsolutno sigurna da se borimo na istoj strani Leni? Ova stvar želi da nas ubije!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Čekaj malo... Vidim... Ti! ne KOMANDA. Ti želiš ovaj tenk."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Luda si za... duge cevi koje mogu da pogode iz daleka!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Stvarno? A kako tačno to misliš, fräulein vidovnjakinjo?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Da li su poslali pozivnicu za svoju zabavu zasede?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Slušaš njihovu komunikaciju? I tek nam SAD kažeš?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: Volim i ja tebe Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Vidi ti tu lepotu! Veličanstvena je!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Oh nein - nein - nein! Ova delikatna oprema nije za mene. Ovoj lepoti treba fin dodir."

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Komandante, preuzmi volan."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Ako ja vozil, naši inženjeri će ga skupljati kofama!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: E to pričam! Spremni smo sada da uskočimo pravo u njihovu zamku!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"Kada imaš najveći čekić, svaki problem ti izgleda kao majušan ekser!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: E to nam treba! Vreme da podelimo par šamara komandante!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Vidi ti ovu zver! Komandante, bio bi zločin da samo prođemo!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Možda da ipak uđemo, a?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Oh ne! Loš znak... Loš za njih, hajde da im upropastimo zasedu!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Ciljevi! Ha! Postaješ predvidljiv Ulysses. Uvek ista obuka."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Neprijatelj? TI si neprijatelj!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Hej, Herr Zločesti tip, zašto ne dođeš ovde da razgovaramo lice u lice?"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Naravno da sam znao! Samo sam... održavao moral tima."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: E, evo ga opasan deo njihove zasede."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: Ne mogu da probiju naš oklop granatama, probaju da nas gađaju kamenjem."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Pametna kopilad!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Ne, to nije čudan deo. Ne mogu više ni da kažem protiv koga se borimo."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Napokon! ZASEDA! Hej Leni, šta još ima na meniju?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Kakva druga iznenađenja nam je Gosn Zločesti isplanirao?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Ne, ne, nemoj mi reći! Bez pomoći, želim sam! Spremni smo za bilo šta!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Beg? Šta znači to \"beg\"? Mi ne bežimo."

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: Idemo na TEBE G. Strašni glas. I da Leni, znam da me ne čuje."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: E, kad se dočepam tog kamper pacova, Rastaviću ga deo po deo!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: E tako. Sam ću Leni."

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! Ode. Predvidivo kao Švajcarski sat, osim što je Nemac."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Vidi, još drugara za igru! Brinuo sam se da nam je nestalo meta za trening!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: Tvoj stari prijatelj? Da ga povedemo?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: Dagodim - želiš ga celog takođe?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Potrudiću se."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Opa! Šta je to dođavola?! Dobro, dobro... našli su me. TO nisam video."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Šta je to bilo kog đavola?! Elektronika tenka je samo... prestala da radi."

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Hej, zašto ne pravimo tenkove sa kecom u rukavu?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Ne bih zamerio nešto špijunske opreme na tenku!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Jeli to obećanje, fräulein? Jer ću te držati za reč!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: Ah vidim. Neprijatelj je prihvatio strategiju \" ostavi tenkove i nadaj se najboljem\"."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Hrabar potez!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: U redu Ulysses. Sačuvaću najbolji materijal za kasnije."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Mein Gott, fräulein! Ti si više opednuta ovim novim tenkovima"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: od mog ujaka Pavela sa njegovom kolekcijom štapova i granja koje je pronalazio širom zemlje!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Iako, moram priznati, ima par baš dobrih."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Uuuu, neko pada! Izgleda da smo mu povredili osećanja. "

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Ne brini, fräulein, Obećao sam ti da će ga doneti zar ne?"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Iako, ne mogu da garantujem da će stići bez par... ogrebotina."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy:Možeš ga kasnije pitati sva ta tvoja pitanja."

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Majko mila... Ta raketa je još veća no što izgleda iz daleka!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Kao priče moj ujaka o ribi koju je ulovio - osim što je ova ZAISTA ogromna!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Ovo... ovo se ne dešava. Bili smo tako blizu! I sve ovo... za šta?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Pocepaću ih sve i sažvakati put pravo do tog komandnog centra."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Onda šaljemo tu raketu pravo u more!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Komandante, preuzmi volan."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: Ovi zlotvori su možda lansirali raketu, ali neće otići sa ovog ostrva čitavi."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Razumem. Takođe volim nešto agilnije nego ove teške zveri."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: Najbolja odbrana je biti u pokretu."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Nigde ti ne ideš prokletniče. Jedino gde ćeš se ti \"evakuisati\" je"

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: naša soba za ispitivanje. A sam ću te tamo odvesti."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Hajde, dovedi sve koji su ostali! Pravo ovde-"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: uštedi nam vreme da vas jurimo sa repovima savijenim međ nogama."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: Hajde da završimo ovo sada i ovde."

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Perfekt tajming! Moram da istresem bes."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: Konačno! Naš stari drugar velikog ega je odlučio da se pridruži zabavi."

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: Vreme je da sredimo naše razmirice jednom za svagda. E sad tu je jedno pitanje-"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: ko će ga od nas poslati na otpad?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Mislim u Leninu radionicu."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Pa, to je to. Leni draga, Znam da si ga želela celog, ali..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: možda smo mu malo ogrebali boju."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter, a? Postaraću se da upamtim to ime."

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Znaš kako zovemo tenkove koji se ne kreću na Češkom? Ciljevi za gađanje!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: I ne želim da postanem nečija meta za vežbu danas."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Korenje raste pod našim gusenicama! Vreme je da se krene!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Kreni ili se izgubi komandante! Avantura čeka!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Duga cev se vratio na svoju poziciju. Odgurajmo ga!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Nazad u jazbinu ti dugocevna napasti!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Šta je to kog đavola?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Cev topa je duža od liste propalih brakova moje ujna Katarine."

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: I veruj mi, to nešto znači!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Šta? On to nosi servis u džepu?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Neverovatno! Duga cev se popravio! Definitivno smo zabušili par dobrih rupa u toj zveri!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Zakrpio se! Kako je to uradio kog đavola?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Prokletstvo! Komandantov tenk je onesposobljen - zadržite ih dok se ne vrati!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Komandant je ispao! Zadrži ih, brzo se vraća!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Menjaš prevoz opet, a? Hajde da nam to ne bude tradicija."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: Dobro je da imamo rezervi - samo ne preteruj."

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Hej! Lakše malo! Ne verujem da su nam ostavili puno igračaka."

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Pokušaj da ovaj ostane ceo."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Prokletstvo! Sredili me - nemojte se previše zabavljati bez mene!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Pa, ja sam gotov - Idem po novi!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Bum - ali ovaj put sam ja! Sedite, evo me!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: Prokletstvo! Prevelika zver me je sredila!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Dobro veliki, pobedio si ovu rundu... vratiću se ja!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Pozdrav svete! Evo mene opet! Sam nedostajao?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Vratio sam se. Novi tenk. Stari je imao neko lupkanje u motoru... i previše rupa."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: Prokletstvo! Gotov sam. Sredi par za mene, može?"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Šta? Kako? Ne, Ne, Ne... Ovo je nemoguće. Izgubili smo? Ne mogu da verujem."

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Pa, odoše nam svi tenkovi... Baš sam ljut! Totalno besan!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Vidi ko nam se pridružio."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Pa, ta stvar izgleda skupo. Hajde da vidimo kako gori."

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BUM! Leni, kakva šteta što ne vidiš kako je komandant sredio prototip."

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Svaka čast komandante! Nadam se da su čuvali račun - nije baš efikasan kao što su mislili."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Toliko priče... Prototip ovo, napredna tehnologija ono..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Uništio sam ga! Njihov test na polju nije uspeo!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Evo nas! Vreme da se krcka oklop!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Zagrej topove! Dajmo im pravu dobrodošlicu!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: To je to, gotovi smo ovde - idemo!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Poslednji - hajde da ne gubimo vreme, pokret, pokret!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Pa, to je gotovo - ko je sledeći?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Bum! Taj nam više neće smetati!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Još jedan ode! Dobar posao!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Tako se to radi - hajde da nađemo još meta!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: Ucrtaj još jednog - ko je sledeći?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Taj je moj!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Gotov je!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Sledeći molim!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Stiže vatromet! Hajde da sednemo da uživamo!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Bombe lete! Hajde da vidimo kako im se sviđa malo kiše od gore."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Naš pilot baš ne može da pravi čuda!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Pa, to je baš šokantno!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Zap! Sad samo sede tamo - hajde da ih sredimo!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Izgleda da malo nemaju struje!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: Pucali su! Vreme da krenemo preko njih!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Modulni oklop radi svoj posao! Kao što moj ujak Pavel kaže,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"Dobar mehaničar može sve da opravi sem slomljenog srca!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Čuda modernog inženjerstva!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Menjanje oklopnih ploča brže nego što baba menja odluke!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Tvoj tenk je kao nov! Sija i nema ekstra rupa."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Zamenuo oklopne ploče, a? Sad tvoj tenk ne izgleda kao Švajcarski sir."

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Mnogo manje ukusno!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Neko nas posmatra sa dvogledom i radiom! Pomeraj gusenice odatle!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Taj lukavi posmatrač artiljerije nas je video! Kreni! Kreni!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Njihov spoter nas je nanišanio! Vreme da ga razočaramo! Kreći!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Stiže bum! Kreni, ako ne želiš da budeš deo pejzaža!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: Pozvali su velike topove! Bolje kreći!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Brzo! Gađaj ih svojim fensi granatama dok se pokazuju!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Taj tenk nešto smera! Gasi ga pre nego završi!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Vidi ti to! Krpe se kao magijom! Hajde da to sredimo!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, svidela bi ti se ova tehnologija! Sami sebe opravljaju u sred bitke!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Da ti donesem primerak?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Au! Ovaj misli da je formula! Ne dozvoljavaj da te poljubi!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Šta kog?! On to stavio rakete na tenk?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: Ispržili su ti te fensi stvarčice komandante! Nazad na staru školu za sad!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Specijalna magija naših tenkova je gotova komandante! Pogodili su te sa anti-zabavnim granatama!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni, brzo pitanje - šta naši obaveštajci znaju koliko je neprijatelja na ostrvu?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Znaju li išta?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: Pa, barem nešto!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy:Ovi plaćenici imaju bolju opremu od nas! Neko ih debelo podmazuje."

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Uuu, misterija! Volim kad si tako skrovita."

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni, draga, kad se ovaj rat završi, vodim te u Prag."

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Tamo ova kafana, ovamo perece, gulaš,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: i sva mesta gde možeš da se zavališ i uživaš u večeri. Previše si stisnuta!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Život bez rizika je kao gulaš bez paprike - mutljav i razočaravajuć!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Čekaj... Šta? Bio je prethodnik? Šta mu se desilo? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Moje je deda govorio: \"Veruj instiktima, ali pregledaj prvo municiju ponovo\"."

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Svidela bi se ti njemu. Uvek je voleo opasne žene."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Apsolutno!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Ova eksperimentalna municija je sjajna! Kako samo gasi sisteme, kao magija!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Mora da si fantastik na dečijim zabavama."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: \"Nije zeka deco, to je odomaćeni Oryctolagus cuniculus.\""

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Hej Leni, kad se sve ovo završi, kakav suvenir želiš?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Mislim se da ti donesem cev onog snajper tenka."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Izgleda da voliš dugometno naoružanje."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Jel to Nemački za \"Brinem za tebe\"? Baš mi drago!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni, da si ovde, cenila bi kako je lep ovaj eksperimentalni tenk."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Oble linije, snažan motor, baš kao..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: ... kao što Nemačko inženjerstvo i treba! Šta ste mislili da ću reći?"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Čuvaj municiju? Šta dalje, da ponovo koristim kesice za čaj? Da perem plastične kašikice? Da sušim papirne ubruse?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Kladim se u pet dolara da naš misteriozni plaćenik komandant sa strašnim glasom ima neke opasne brkove."

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Sve prave zlice imaju brkove."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Deset dolara da ih uvrće kad misli da niko ne gleda."

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Jesi primetio formacije? Naši su prijatelji čitali vojne knjige."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Poglavlje jedan: \"Kako biti oklopljen i uništen u tri koraka\"."

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Previše puni sebe, neodgovorni - oba se završe istom eksplozijom druže moj."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Znaš šta je čudno? Ja baš uživam u ovoj misiji."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Slikoviti pejzaž, neobični novi tenkovi, misteriozni neprijatelji..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Baš bih rekao \"Aktivna rekreacija\"!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Psihološko ispitivanje? Jesmo trebali da prođemo psihološko ispitivanje?!"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: A... Znači onaj razgovor sa tetom je bilo ispitivanje..."

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: O čemu pričaš?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Šališ se, zar ne?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Ha! Njihova elitna jedinica nije više baš toliko elitna!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Samo još par protivnika između nas i te rakete."

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Moja baba bi očistila ovaj put sa njenom drvenom kašikom!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Prokletstvo! Ta ogromna zver je sredila komandanta - ovo je sad lično!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Ta je stvar zaista sredila komandanta? Dobro, e sad sam ljut!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Korvin: Ulysses ovde. Iskrcali smo se. Prokletstvo... plaža je groblje tenkova."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Nema preživelih iz prvog talasa. Ne možemo ovde gubiti vreme."

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Moramo da stignemo do kamandnog centra i zaustavimo to lansiranje po svaku cenu."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Kontakt napred! Nemački tenkovi na 11 sati. Slobodno pucaj."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Novi kontakt! Pokrivanje vatrom!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Povlači se."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Moramo da nastavimo da se krećemo. Sa ove udaljenosti, nemamo šanse protiv takve vatrene moći."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Moramo se približiti, pronaći način da napadnemo sa boka. Guraj napred!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Fokusirajte se! Moramo prvo ovde da eliminišemo otpor."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Sredićemo taj dalekometni problem kasnije."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Novi protivnici ispred."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Prokletstvo, ovaj put ih je više."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Video sam gore šanse u Severnoj Africi. Nastavi napred, probićemo se."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Idemo zajedno. Ciljajte bokove!"

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Duga cev se vratio! Pokrivaj vatrom, SAD!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Nastavi da se krećeš. Najbrži put do rakete je kroz fabriku."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Pozicije. Izgleda da smo našli nešto... zanimljivo."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Napušteni tenkovi. Nepoznati modeli."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: Ove granate izgledaju eksperimentalno. Verovatno privremeno onesposobe protivnika."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Komndante, ovaj eksperimentalni tenk bi nam dao kritično potrebnu prednost."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Čvrsto predlažem da ga preuzmemo."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Pazi!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Pažnja ispred! Više meta!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Jasne komande kao ove nas čuvaju moj veseli prijatelju."

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Pažljivo!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: Idu oko nas. Pozicije!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Nema vremena za razvlačenje. Brzo i odlučno!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Vidi taj proboj u zidu. Naš prijatelj u centru može da nas gađa tuda. Ostani skriven."

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Nema vremena za prepirke. Sat kuca, pokret, pokret!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Nova opasnost indetifikovana. Koriste neku eksperimentalnu municiju"

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: koa privremeno onesposobi našu elektroniku."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Ovo nisu obični plaćenici - imaju naprednu tehnologiju koju nismo viđali do sada."

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Vidi tamo, još jedna servisna stanica... I opet tenkovi koje ne mogu da indetifikujem."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: Odličan pronalazak."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Ovaj tenk je opremljen nekakvim modularnim pločama oklopa koje se brzo mogu menjati u polju."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Biće korisno."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Sada samo da promenimo taktiku."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy i ja ćemo napred dok vi šružate podršku od nazad."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: Sigurniji je novi tenk kod mene, a ti možeš da iskoristiš taj impresivan top."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Izgleda da je ova Adler-Gruppe neka vrsta elitne jedinice,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: daleko opasnije nego bilo šta što smo sretali do sada."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, vreme da ostaviš šalu postrani i pokažeš im ko smo."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Naš primarni cilj je zaustavljanje lansiranja rakete. Sve ostalo je drugo."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Nemojte gubiti pažnju."

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Skoro smo do cilja. Jedan još proboj!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Ne! NE! PROKLETSTVO, NE!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Nismo uspeli da zaustavimo lansiranje. Raketa se penje."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Potvrdno."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: Još jedna baza za opravke ispred. Nepoznati teški tenkovi su tamo."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Izgleda da su daleko više oklopljeni od bilo čega što smo videli do sada."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Iznenađenje je... nema ništa specijalno u vezi njega."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: Pa, osim neobično debelog oklopa i neobično male brzine."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: A to je upravo ono što nam treba."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Mesto lansiranja je obezbeđeno. Držimo poziciju na ulazu u bunker."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Novi protivnici stižu. Promena pozicija za bolju odbranu."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Pa Teddy, ispunila ti se želja. Izgleda da idu ovamo, a ne beže."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Ovo je izgleda najveći talas."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Kretanje u centru! Prototio duge cevi se vratio!"

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, status rakete?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Kako to misliš?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Ako čekamo, proći ćemo kao prvi talas. Krećemo."

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Na vreme. Idemo."

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Ako sedimo, lake smo mete. Pokret."

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Kontakt u centru! Pokrivajte ga!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Snajper se vratio, pritiskajte ga, da ne može da gađa!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Lovac tenkova u centru je pravljen i funkcionalan!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Kako su tako brzo opravili takvu štetu?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Samo oštro! Komandant je ispao, ne zadugo!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Komandant je pogođen! Pritiskajte, brzo se vraća!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Vratio si se u borbu, perfektno! Ali sada budi pažljiviji."

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: Ovo je bilo blizu. Sledeći put, hajde da tenk bude ceo, može?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: Ove baze ze popravke nemaju neograničeno tenkova."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Budi pažljiv sledeći put."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Prokletstvo! Gotov sam! Vraćam se uskoro."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: Sredili su me! Vraćam se brzo!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Pogođen sam! Nastavite da gurate - stižem uskoro!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Gotov sam. Prokleti stvor je jači od ostalih."

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Direktan pogodak... Ovi novi tenkovi se ne šale."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Vratio sam se. Nadam se bez iznenađenja ovaj put."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Nazad u borbu. Prokletstvo... Nekad ih jednostavno ima previše."

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Moji tenkovi su gotovi. Završite misiju po svaku cenu!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Prokletstvo... Bili smo prespori. Mi smo krivci."

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: To je to. Nemamo tenkova. Borba je gotova."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Stižu neprijateljska pojačanja. Spremite se."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Novi neprijatelj. Ovo nije običan tenk - pažljivo."

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Dobar pogodak! Eksperimentalna jedinica uništena. Jedan manje problem."

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Odlično! To je to za njihovu novu igračku. Hajde da nastavimo pritisak."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Velika meta neutralisana. Hajde da vidimo šta još imaju."

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Njihovo najbolje nije bilo dovoljno dobro. Hajde da završimo borbu."

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Kontakt! Slobodna vatra!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Napadam neprijatelja. Budite oštri."

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Poslednja meta uništena, idemo."

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: To je poslednji - zona čista, idemo."

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Neprijateljska grupa neutralisana - vreme za pokret."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Meta sređena."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Neprijatelj eliminisan."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Dobar pogodak!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Eliminisali smo opasnost."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Sredio sam ga."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Držim ti leđa. napred!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Vazdušna podrška stiže. Spremi se za udar."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Napad potvrđen. Ostani dalje od zone praska."

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Vazdušna podrška ne može da napadne tu poziciju. Promeni koordinate ciljanja."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Meta ošamućena - sada imamo šansu!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Neprijateljski sistemi onesposobljeni. Završimo ih!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Neprijateljske specijalne sposobnosti su dole. Napad! Sada!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Tvoj proboj trupa je zatvoren. Borbena efektivnost je na optimalnom nivou."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Modularni oklop zamenjen. Tvoje vozilo je spremno zaborbu opet."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Oklopne ploče zamenjene. Nivo tvoje zaštite je opet na standardu."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Tvoj oklop je popravljen! Nastavi misiju."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Spoter artiljerije uočen! Izađi iz zone praska smesta!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Artiljerija stiže! Pokret - SADA!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Stiže neprijateljska artiljerija! Imamo sekunde pre udara - pokret!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: Aktivirali su eksperimentalne sisteme. Onesposobi ih! Koristi specijalnu municiju sada!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Meta sprema specijalan napad. Ošamuti ih pre završetka."

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Neprijatelj se opravlja. To nije dobro."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: Implementiraju borbene opravke. Moramo praviti štetu brže nego što opravljaju."

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Protivnik ubrzava do brzine sudaranja! Manevri izbegavanja!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Protivnik ide punom brzinom. Ne dozvoli kontakt."

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Komandante, pogodili su tvoj interfejs sistema! Elektronska oprema privremeno isključena."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Direktan pogodak kontrolnh modula. Tvoja elektronima ne funkcioniše."

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, moraš da čuvaš municiju. Manje gađaj, nišani slabe tačke."

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Ne vidim vrednost u spekulacijama i klađenju."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Njihove pozicije govore o preteranom samopouzdanju, ne nesposobnosti. Nemoj ih potcenjivati."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, tvom konceptu rekreacije treba ozbiljno premišljanje."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Da li si sigurno prošao psihiloško testiranje pre ove misije?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Misliš da si manipulisan?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, neobično si tiha. Šta misliš?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: I?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, potrebna mi je iskrena procena. Da li je Teddy gori ili bolji sa svojim šalama?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Stvarno analiziraš njegove šale?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: Hajde da se probijemo - blizu smo mesta lansiranja. Moramo ga osigurati pre lansiranja."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Komandant je dole! To novo vozilo je pravi problem."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Ulysses: Potcenili smo tog stvora. Fokus, komandant se uskoro vraća."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Glavni top ovog tenka izgleda da pojačava štetu."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Pod određenim okolnostima, može da pravi izuzetnu štetu kada se pravilno isporuči."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Baš šta nam treba protiv ovih teških jedinica."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: I pazi naoružanje. Glavni top ozgleda da može da pojačava štetu."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Pod određenim okolnostima, može da pravi izuzetnu štetu kada se pravilno isporuči."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Baš šta nam treba protiv ovih teških jedinica."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Ovaj tenk ima sisteme za precizno nišanjenje."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Izgleda da što duže miruje, precizniji su pogotci."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Perfektno za duge aranžmane."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Ali šta je interesantnije, ovaj tenk ima sisteme za precizno nišanjenje."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Izgleda da što duže miruje, precizniji su pogotci."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Perfektno za duge aranžmane."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Interesantno: Ovaj ima sekundarno naoružanje."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Možeš da pokrivaš vatrom dok se glavni top puni."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Taktička prednost nad slabim oklopom."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: A da. Još jedna stvar. Ovaj ima i sekundarno naoružanje."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Možeš da pokrivaš vatrom dok se glavni top puni."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Taktička prednost nad slabim oklopom."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Ovo vozilo ima ne-standardnu opremu. Ovo nisu konvencionalne modifikacije - "

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: pravili su nešto zaista specijalno ovde. Isprobaj ga komandante."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Vidi šta ta tehnologija može."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: Napredna tehnologija je integrisana u sisteme tenka."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Trebalo bi da je koristimo do maksimuma."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Komandante, eksperimentiši sa kontrolama ove opreme, otkrij šta sve može u borbi."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Inženjerstvo ovog prototipa je fantastično. Ovo nisu standardna borbena pojačanja -"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: ovo menja igru. Isprobaj komandante."

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Poguraj ove sisteme do maksimuma i pokaži protivnicima šta njihova tehnologija može."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "Jedno od naših prototip vozila je zarobio neprijatelj. Indetifikuj mete pažljivo."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta i Dora, napadnite pažljivo. Odlažite ih što više."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Neprijateljske snage dolaze do fabrike. Kampfgruppen Berta i Dora, napad."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Odlažite ih što duže."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Pažnja, tim Zeppelin. Pokret na fabriku. Odbrambene pozicije."

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, održi kontrolu vatre na izlazima. Niko ne sme van fabrike."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Pokreni protokol Valkiriria. Sve jedinice potvrda."

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Sve jedinice, odbrambene pozicije. Adler-Gruppe napad."

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Sve jedinice. Napad neprijatelja. Dvostruka kaucija ko ih eliminiše."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Šta kog đavola? Arhitekta, nismo spremni! Još imamo tenkove u zoni udara!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Sve jedinice, dalje od zone lansiranja SADA!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Prokletstvo! Prokletstvo!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Sve preostale jedinice, dalje od zone praska! Pokrivaj lansiranje! Drži liniju!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Sve preostale jedinice - skup kod komandnog centra. Napad protivnika. Zadržite ih u borbi."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Zadržati odbrambene pozicije do daljnjeg. Po naređenju povlačenje na punktove evakuacije."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Znam da me čuješ. Nisam očekivao takve protivnike."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Ali sada sam proučio tvoje taktike, tvoje sposobnosti. Naš sledeći susret će biti drugačiji."

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter prijem."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "Pre pet dana smo izgubili kontakt sa tajnim vojnim svemirskim kompleksom u Norveškom moru."

msgid "vo_sm_norway_intro_02"
msgstr "Pilot izviđačkog aviona je prijavio tragove borbe"

msgid "vo_sm_norway_intro_03"
msgstr "i delimično uništenje industrijskih zgrada na mestu."

msgid "vo_sm_norway_intro_04"
msgstr "Ali najvažnije, opisao je raketu spremnu za lansiranje na lansirnom postolju,"

msgid "vo_sm_norway_intro_05"
msgstr "upravo pre nego što smo izgubili komunikaciju sa njim."

msgid "vo_sm_norway_intro_06"
msgstr "Tim za brzo reagovanje je poslat na mesto da istraži."

msgid "vo_sm_norway_outro_01"
msgstr "Ono što smo mislili da je oružije se ispostavilo kao nešto daleko opasnije."

msgid "vo_sm_norway_outro_02"
msgstr "Raketa je lansirala veštački satelit u orbitu,"

msgid "vo_sm_norway_outro_03"
msgstr "koji je počeo da emituje tajnu dokumentaciju Rajha:"

msgid "vo_sm_norway_outro_04"
msgstr "nacrte naprednih tehnologija"

msgid "vo_sm_norway_outro_05"
msgstr "i koordinate tajnih vojnih baza sa već spremnim uzorcima oružija."

msgid "vo_sm_norway_outro_06"
msgstr "Čovek iza ovoga sebe naziva Arhitekta."

msgid "vo_sm_norway_outro_07"
msgstr "Njegovi motivi nisu sasvim jasni, ali njegove akcije su već počele da menjaju svetski poredak."

msgid "vo_sm_norway_outro_08"
msgstr "Da bi se suprotstavili ovoj pretnji, treba nam snaga sposobna da brani svet od predstojećeg haosa."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Pažnja! Pažnja!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Obraćamo se svim vojnicima i oficirima Wehrmacht, Luftwaffe and Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Nemačka vrhovna komanda je potpisala bezuslovnu predaju.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Rat je gotov...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Pozivamo sve koji još pružaju uzaludni otpor;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Da polože svoje oružije i predaju se Savezničkim trupama.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Vaši životi su potrebni za izgradnju nove, obnovljene Nemačke...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(Ovo je samo još jedan trik.)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Dok ne dobijemo naređenje komande, borićemo se.)"
