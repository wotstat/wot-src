msgid "vo_sm_char10_m05_stg21_02"
msgstr "Štabni oficir: Eho-5 mostobran je osiguran. Tenkovi napreduju. Obezbedite punu vatrenu podršku."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Štabni oficir: Preusmerite vazdušnu podršku da pomognete tenkovskom napredovanju."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Štabni oficir: Inžinjerski timovi, očistite prepreke za dalje napredovanje."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Štabni oficir: Plaža je čista. Šaljemo glavne snage. Odličan posao."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Štabni oficir: Držite poziciju. Pojačanje stiže."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Štabni oficir: Štitite mostobran po svaku cenu."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Štabni oficir: Novi tenk, nova šansa. Budi pažljiv ovoga puta."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Štabni oficir: Ponestaje nam rezervi. Neka se ovaj računa komandiru."

