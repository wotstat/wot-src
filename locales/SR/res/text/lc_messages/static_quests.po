msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Započni nasumičnu borbu u vozilu bilo kog nivoa."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Dobrodošao u igru! Bori se sa drugim fanovima širom sveta i proslavljaj spektakularne pobede!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Prva bitka"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Istraži i kupi bilo koje vozilo IV nivoa."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Kupovina novog vozila je važan događaj. Sa svakim novim nivoom, vozila postaju interesantnija. Istrenirana posada će takođe poboljšati sveukupno igranje."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Vozilo IV nivoa"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Bori se u 3 nasumične borbe u vozilima IV - X nivoa sa primenjenim bilo kojim elementom prilagođavanja."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Možeš da prilagodiš vozila menjajući njihovu spoljašnost upotrebom već napravljenih stilova ili kreirajući svoj sopstveni stil upotrebom kamuflaže, natpisa, amblema i nalepnica."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Spoljašnjost vozila"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Počni trening bilo koje veštine za bilo kog člana posade."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Članovi posada mogu naučiti dodatne veštine kako bi poboljšali svoju efikasnost ili dobili nove sposobnosti."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Veštine posade"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Zaradi 150.000 kredita u nasumičnim borbama u vozilima IV-X nivoa."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Što je veći nivo borbe to ćeš više trebati kredita da održavaš svoje vozilo, popuniš municiju i kupiš module i opremu."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Sakupljanje kredita"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Izuči i kupi bilo koje vozilo V nivoa."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Nivo V je nivo gde počinju da se pojavljuju ozbiljnija vozila, i gde tvoje igračke veštine zasita dolaze na proveru. Kompletno istrenirana posada će zaista biti od koristi."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Vozilo V nivoa"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Bori se u nasumičnim borbama u vozilima V - X nivoa sa 3 montirane opreme."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Obložena optika ili poboljšana ventilacija? Prava oprema može da pojača prednosti tvog vozila i smanji mane."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montiranje opreme"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Završi jedan osnovni scenario u režimu topografije."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Da bi dobio samopouzdanje na bojištu, najbolje je da imaš dobro razumevanje staza, taktike i mapa, uključujući ključne pozicije i objekte na njima."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografija"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Završi četiri napredna scenarija na jednoj mapi u topografiji."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Uđi u režim topografije sa vremena na vreme da bi proučio mape za nasumične borbe. Četiri scenarija ti omogućavaju da istražiš lokaciju iz različitih uglova."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Napredna topografija"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Bori se u 10 nasumičnih borbi u vozilima V - X nivoa sa aktiviranom ličnom rezervom."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Prilikom aktiviranja, možeš da dobiješ dodatne bonuse na borbeno iskustvo, slobodno iskustvo i iskustvo posade ili kredite nakon svake borbe."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Lične rezerve"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Budi među 10 najboljih igrača u svom timu po zarađenom iskustvu šest puta u pobedničkim nasumičnim borbama u vozilima V - X nivoa."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Ove misije ti dozvoljavaju da zaradiš pet puta više iskustva po uspešnoj borbi. Za ovo, moraš da pobediš i budeš među 10 najboljih igrača u svom timu po zarađenom iskustvu."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 misija za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Izuči modul i montiraj ga na vozilo bilo kog nivoa."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Borbeno iskustvo se dodeljuje nakon svake borbe. Zaradi borbeno iskustvo da bi izučio nove module koji poboljšavaju efikasnost tvog vozila."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Borbeno iskustvo"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Izuči i kupi bilo koje vozilo VI nivoa."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "U svakom sledećem nivou, izučavanje vozila zahteva više vremena i napora. Slobodno iskustvo će pomoći da napreduješ brže a trenirana posada će biti korisna."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Vozilo VI nivoa"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Završi jednu ličnu misiju u bilo kojoj kampanji."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanje su lanac misija za različite tipove vozila. Kada su završene, možeš da dobiješ korisne nagrae i jedinstvena vozila."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Lične Misije"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Istreniraj člana posade univerzalnim priručnikom."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Knjige posade ti dozvoljavaju da značajno ubrzaš trening posade dodavanjem određene količine iskustva jednom ili svim članovima posade."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Knjige posade"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Bori se u 10 nasumičnih borbi u vozilima VI - X nivoa opremljenih direktivom posade."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Direktive mogu da poboljšaju veštine posade tokom jedne borbe. Poput potrošnog materijala, direktive mogu da se kupe ili dobiju kao nagrada."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Direktive posadi"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Kupi specijalan početnički paket u prodavnici u igri."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Možeš da kupiš sve što ti treba u prodavnici u igri, uključujući zlato, premijum vozila i drugo. Redovno ćeš nalaziti promocije koje nude sjajne popuste."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Prodavnica"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Bori se u 10 nasumičnih borbi u premijum vozilima VI - X nivoa."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Ova vozila ne moraju da se izučavaju. Zarađuju više borbenog iskustva, iskustva posade i kredita i dozvoljavaju ti da prebacuješ posadu bez preobuke."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium vozila"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Bori se u 10 nasumičnih borbi u vozilima VI - X nivoa sa direktivom za opremu."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Direktive ti dozvoljvaju da podigneš efikasnost montirane opreme. Poput potrošnog materijala, direktive mogu biti kupljene ili dobijene kao nagrada."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Direktive za opremu"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Budi među 10 najboljih igrača u svom timu po zarađenom iskustvu 15 puta u nasumičnim borbama u vozilima V - X nivoa."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Ove misije ti dozvoljavaju da zaradiš pet puta više iskustva po uspešnoj borbi. Za ovo, moraš da pobediš i budeš među 10 najboljih igrača u svom timu po zarađenom iskustvu."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 misija za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Izuči i kupi bilo koje vozilo VII nivoa."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Za vozilo ovog nivoa, potrebna veština se povećava još više. Vozila postaju opasnija i efikasnija - baš kao i tvoji protivnici."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Vozilo VII nivoa"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Odigraj 10 nasumičnih borbi u vozilima VII-X nivoa opremljenih sa velikim kompletom za prvu pomoć, velikim kompletom za popravke i automatskim PP aparatom."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Kada su opremljeni veliki potrošni materijali popravljaju oštećene module brže nego mali. Takođe smanjuju trajanje efekta šoka i šansu za požar i imaju kraće vreme hlađenja."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Veliki potrošni materijal"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Dobij duplo iskustvo za svoju prvu pobedu dana u nasumičnim borbama u vozilu bilo kog nivoa."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Možeš da dobiješ dvostruko iskustvo za svoju prvu pobedu dana u svakom vozilu. Iskoristi ovu mogućnost da bi unapredio svoje vozilo još brže."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Množitelj iskustva"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Kreiraj fragment nacrta za bilo koje neizučeno vozilo."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Nacrti daju popuste u iskustvu i ubrzavaju izučavanje vozila. Dobijaju se kao nagrada ili pretvoreni iz univerzalnih i nacionalnih fragmenata."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Nacrti vozila"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Budi među 10 najboljih igrača u svom timu po zarađenom iskustvu 20 puta u nasumičnim borbama u vozilima VII - X nivoa."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Ove misije ti dozvoljavaju da zaradiš pet puta više iskustva po uspešnoj borbi. Za ovo, moraš da pobediš i budeš među 10 najboljih igrača u svom timu po zarađenom iskustvu."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 misija za ×5 iskustva"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Izuči i kupi bilo koje vozilo VIII nivoa."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Vozila VIII nivoa zahtevaju da upotrebiš svo stečeno znanje. Neprijatelji neće dozvoliti dosadu, obezbeđujući ti visokoktansko uzbuđenje i vredno iskustvo."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Vozilo VIII nivoa"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Upotrebi slobodno iskustvo da izučiš bilo koji modul."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Ako nemaš dovoljno borbenog iskustva da izučiš modul ili vozilo, možeš da upotrebiš slobodno iskustvo koje može biti zarađeno za bilo koje vozilo."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Slobodno iskustvo"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Utovari nešto alternativnih granata i započni nasumičnu borbu u vozilu III-X nivoa."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Pancirne, fugasne i pancirne kompozitne granate se koriste za različite situacije u borbi. Izaberi mudro da bi stekao prednost!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Municija"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Prodaj module koji nisu u upotrebi iz skladišta."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Neupotrebljeni moduli, granate, oprema, potrošni materijal, i druge stvari su smešteni u depou. Možeš da prodaš višak za kredite."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "depou"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Zaradi 25.000 kredita u nasumičnim borbama u vozilima III - X nivoa."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Krediti se koriste za kupovinu granata i novih vozila, popravku vozila i drugo. Važno je da znaš kako da ih sačuvaš i upotrebiš mudro."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Krediti"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Bori se u 3 nasumične borbe u vozilima III - X nivoa sa montiranim potrošnim materijalom u svim dostupnim slotovima."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Potrošni materijal popravlja kritičnu štetu i leči članove posade u borbi. Upotreba potrošnog materijala u pravo vreme je ključno za preživljavanje na bojištu."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Potrošni materijal"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Bori se u tri nasumične borbe u vozilima III - X nivoa sa bilo kojom montiranom opremom."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Vozila mogu biti opremljena opremom da bi se poboljšale neke od njihovih karakteristika. Oprema zavisi od vozila i stila igranja."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Oprema"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografija"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Završi jedan scenario na bilo kojoj mapi u topografiji"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Tera inkognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Završi četiri osnovna scenarija na jednoj mapi u topografiji"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Izviđanje"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Završi četiri napredna scenarija na jednoj mapi u topografiji"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "A iz geografije"
