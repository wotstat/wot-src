msgid "joke/event_1"
msgstr "Ako tvoj pas ikada krene da svetli, prijavi se bolničaru. Ili nemoj. Ovo nisi čuo od mene."

msgid "joke/event_10"
msgstr "Pas je prošao časove plivanja sa odličnim rezultatom. Vojnik? Pa ne baš."

msgid "joke/event_11"
msgstr "To je bilo taktičko izvlačenje... grickalica."

msgid "joke/event_12"
msgstr "Kome treba sredstva za odbijanje zmija kad imaš rep koji maše i lavež koji uteruje strah?"

msgid "joke/event_13"
msgstr "Sakupljaš đubre? Nikako, više je kao kolekcioniranje artefakta za podizanje morala!"

msgid "joke/event_14"
msgstr "Ne znamo šta ga pogoni, ali mislimo da su teniske loptice i haos."

msgid "joke/event_15"
msgstr "Zaboravi na detektore mina, ponekad ti treba oštro oko i rep koji maše."

msgid "joke/event_16"
msgstr "Tvoj pas je zvanično postao pouzdani skaut za hranu odreda."

msgid "joke/event_17"
msgstr "Niko ne zna odakle je došao, ali moral je skočio i zalihe sira su smanjene."

msgid "joke/event_18"
msgstr "Njihova poslednja poruka? \"Zalaj jednom za opasnost, dva puta za punjenje.\""

msgid "joke/event_19"
msgstr "Nije upadao na posed. Samo je bio veoma izgubljen. I naoružan."

msgid "joke/event_2"
msgstr "Izgleda da je neko napokon otkrio tajnu kako da ubrza birokratiju - četiri šape i nula pitanja."

msgid "joke/event_20"
msgstr "Zaboravi na senzore - postavi psa pored svake cevi umesto njih."

msgid "joke/event_21"
msgstr "Znaš da je stvar ozbiljna kada pas ima bolji lanac snabdevanja od logističkog tima."

msgid "joke/event_22"
msgstr "Čak ni naši najbolji mehaničari ne dodaju ključ tako brzo."

msgid "joke/event_23"
msgstr "Kada priroda udari, pošalji lajuću jedinicu."

msgid "joke/event_24"
msgstr "Jedini član posade koji je zvanično kvalifikovan kao \"borbeno spreman\" i \"veoma dobra kuca.\""

msgid "joke/event_25"
msgstr "Hej, ako igračka počne da se pomera sama od sebe... to je sada tvoja smena."

msgid "joke/event_26"
msgstr "Trening sa bojevom municijom? Dobro je što tvoj pas proverava dvaput."

msgid "joke/event_27"
msgstr "Regrut meseca: četiri noge, bez ašova, puno zemlje."

msgid "joke/event_28"
msgstr "Nazivati psa \"kuvarom\" je nategnuto, ali rep je odlična alatka za mešanje."

msgid "joke/event_29"
msgstr "Doktorova naređenja: Dva pakovanja pilula i jedna dobra kuca po sobi."

msgid "joke/event_3"
msgstr "Bez dozvole za viljuškar ali i dalje puno vožnje."

msgid "joke/event_30"
msgstr "Brisanje? Provereno. Skidanje prašine? Provereno. Cepanje? Dva puta provereno. Održavanje kuće odobreno!"

msgid "joke/event_4"
msgstr "Tvoj pas je ili našao tajni štek... ili je odlučio da započne potpuno novu garažu."

msgid "joke/event_5"
msgstr "Ispostavilo se da je najefektivnija formula za rasturanje mase fermentirana riba plus četiri noge."

msgid "joke/event_6"
msgstr "Pas i mačka rade zajedno? Apokalipsa je verovatno požurila."

msgid "joke/event_7"
msgstr "Ako tvoj pas počne da čuva rezervne delove, ne brini - samo želi unapređenje u mlađeg mehaničara."

msgid "joke/event_8"
msgstr "Kako nazivaš psa koji zavija na pun mesec? \"Vukokuk.\""

msgid "joke/event_9"
msgstr "Protivpožarne vežbe spašavaju živote. Psi, očigledno, spašavaju posade."

msgid "rewards/synergy_value"
msgstr "+"

msgid "rewards/title"
msgstr "Izgubljen, ali ne i nestao:"

msgid "submit"
msgstr "Razumem!"

msgid "text/event_1"
msgstr "{{@ style (color $color)}}Stranac{{/}} u {{@ style (color $color)}}formalnom{{/}}{{@ style (color $color)}} odelu{{/}} ti prilazi. \"Tvoj {{@ style (color $color)}}pas{{/}} je pomogao u {{@ style (color $color)}}potrazi{{/}} i {{@ style (color $color)}}obezbeđivanju{{/}} {{@ style (color $color)}}opasnog{{/}}{{@ style (color $color)}} objekta{{@ style (color $defaultColor)}}.{{/}}{{/}} Podaci o incidentu će biti {{@ style (color $color)}}obrisani{{/}} iz svih {{@ style (color $color)}}dnevnika{{@ style (color $defaultColor)}}.{{/}}{{/}} Hvala vam na pomoći.\" Čovek ti predaje {{@ style (color $color)}}paket{{/}} i odlazi iz {{@ style (color $color)}}garaže{{/}}."

msgid "text/event_10"
msgstr "Tokom {{@ style (color $color)}}borbene{{/}}{{@ style (color $color)}} vežbe{{/}} na {{@ style (color $color)}}vodi{{/}}, jedan od {{@ style (color $color)}}vojnika{{/}} se {{@ style (color $color)}}upetljao{{/}} u {{@ style (color $color)}}sidrene {{/}}{{@ style (color $color)}}konopce{{/}} i {{@ style (color $color)}}upao{{/}}{{@ style (color $color)}}{{@ style (color $defaultColor)}}.{{/}}{{/}} Srećom, tvoj {{@ style (color $color)}}pas{{/}} je bio pored i uspeo je da {{@ style (color $color)}}izvuče{{/}} {{@ style (color $color)}}davljenika{{/}}{{@ style (color $color)}}{{/}} na {{@ style (color $color)}}bezbedno{{/}}{{@ style (color $defaultColor)}}.{{/}} Priča je uskoro postala simbol {{@ style (color $color)}}hrabrosti{{/}} kroz {{@ style (color $color)}}jedinicu{{/}}."

msgid "text/event_11"
msgstr "Primetio si da je tvoj {{@ style (color $color)}}pas{{/}} istrčao iz {{@ style (color $color)}}skladišta{{/}} sa {{@ style (color $color)}}malom vrećom{{/}} u svojim {{@ style (color $color)}}ustima{{@ style (color $defaultColor)}}.{{/}}{{/}} Dok si se spremao da ga {{@ style (color $color)}}ukoriš{{/}} za {{@ style (color $color)}}krađu {{/}}{{@ style (color $color)}}namirnica{{/}}, {{@ style (color $color)}}magacioner {{/}} se smejao, \"Ne mogu a da ne oprostim tako dobroj {{@ style (color $color)}}kuci{{/}}.\" Međutim, izgleda da malo dodatnog {{@ style (color $color)}}treninga{{/}} o {{@ style (color $color)}}manirima{{/}} nebi škodilo."

msgid "text/event_12"
msgstr "Tokom {{@ style (color $color)}}rutinske {{/}}{{@ style (color $color)}}inspekcije{{/}}, {{@ style (color $color)}}vojnici{{/}} su otkrili {{@ style (color $color)}}leglo{{/}}{{@ style (color $color)}} zmija{{/}} pored jedne od {{@ style (color $color)}}baraka{{@ style (color $defaultColor)}}.{{/}}{{/}} Dok su raspravljali kako da {{@ style (color $color)}}ga se reše{{/}}, tvoj verni {{@ style (color $color)}}pas{{/}} je rasterao {{@ style (color $color)}}reptile{{/}} svojim {{@ style (color $color)}}lajanjem{{/}} i {{@ style (color $color)}}neustrašivim napadima{{@ style (color $defaultColor)}}.{{/}}{{/}} Do {{@ style (color $color)}}večeri{{/}}, ceo {{@ style (color $color)}}kraj{{/}} je bio {{@ style (color $color)}}bezbedan{{/}} ponovo. Tvoj {{@ style (color $color)}}hrabri pas{{/}} će svakako biti {{@ style (color $color)}}nagrađen{{/}}."

msgid "text/event_13"
msgstr "Primetio si da tvoj {{@ style (color $color)}}pas{{/}} povremeno {{@ style (color $color)}}odlazi{{/}}{{@ style (color $color)}} trčeći{{/}} negde {{@ style (color $color)}}ujutro{{@ style (color $defaultColor)}}.{{/}}{{/}} Ispostavilo {{@ style (color $color)}}{{/}}se da {{@ style (color $color)}}{{/}}neki {{@ style (color $color)}}piloti{{/}} imaju tradiciju {{@ style (color $color)}}maženja{{/}} {{@ style (color $color)}}psa{{/}} za {{@ style (color $color)}}dobru{{/}}{{@ style (color $color)}} sreću{{/}} pre {{@ style (color $color)}}poletnja{{@ style (color $defaultColor)}}.{{/}}{{/}} Radoznao, {{@ style (color $color)}}pratio si{{/}} svog {{@ style (color $color)}}drugara{{/}}{{@ style (color $color)}} sa mahajućim{{/}}{{@ style (color $color)}} repom{{/}} i otkrio {{@ style (color $color)}}tajni{{/}}{{@ style (color $color)}} štek{{/}} - {{@ style (color $color)}}malu kutiju{{/}} napunjenu {{@ style (color $color)}}čepovima{{/}}{{@ style (color $color)}}{{/}}, {{@ style (color $color)}}dugmićima{{/}} i {{@ style (color $color)}}ižvakanim {{/}}{{@ style (color $color)}}čarapama{{/}}."

msgid "text/event_14"
msgstr "Tvoj {{@ style (color $color)}}pas{{/}} je pronašao {{@ style (color $color)}}čudnu{{/}}{{@ style (color $color)}} spravu{{/}} u {{@ style (color $color)}}staroj{{/}}{{@ style (color $color)}} garaži{{@ style (color $defaultColor)}}.{{/}}{{/}} Nakon što je {{@ style (color $color)}}uključena{{@ style (color $defaultColor)}},{{/}}{{/}} {{@ style (color $color)}}sprava{{/}} je počela {{@ style (color $color)}}da obrađuje{{/}} {{@ style (color $color)}}igračke{{/}} unutar nje, {{@ style (color $color)}}stvarajući {{/}}{{@ style (color $color)}}kompletno {{/}}{{@ style (color $color)}}nove stvari{{@ style (color $defaultColor)}}.{{/}}{{/}} Tokom svih {{@ style (color $color)}}transformacija{{/}}, uspeo si {{@ style (color $color)}}da dobiješ par{{/}} {{@ style (color $color)}}korisnih stvari{{/}}."

msgid "text/event_15"
msgstr "Tokom {{@ style (color $color)}}vežbi{{/}} na {{@ style (color $color)}}poligonu{{/}}, nekoliko {{@ style (color $color)}}tenkova{{/}} je naišlo na polje zasuto {{@ style (color $color)}}školskim {{/}}{{@ style (color $color)}}minama{{@ style (color $defaultColor)}}.{{/}}{{/}} Tvoj {{@ style (color $color)}}pas{{/}} je poleteo {{@ style (color $color)}}napred{{/}}, {{@ style (color $color)}}privlačeći{{/}}{{@ style (color $color)}} pažnju{{/}} i pomažući {{@ style (color $color)}}posadama{{/}} {{@ style (color $color)}}da primete opasnost{{/}} na vreme. Zahvaljujući {{@ style (color $color)}}brzim {{/}}{{@ style (color $color)}}reakcijama{{/}} tvog ljubimca, {{@ style (color $color)}}tenkovi{{/}} {{@ style (color $color)}}su se {{/}}{{@ style (color $color)}}pregrupisali{{/}} i rešili {{@ style (color $color)}}prepreke{{/}} bezbedno. Bez obzira {{@ style (color $color)}}na ishod{{/}}, {{@ style (color $color)}}nagrada {{/}}za takvu {{@ style (color $color)}}hrabrost{{/}} je zagarantovana."

msgid "text/event_16"
msgstr "Tokom {{@ style (color $color)}}istraživanja{{/}} {{@ style (color $color)}}garaže{{/}}, tvoj {{@ style (color $color)}}pas{{/}}, je nanjušio {{@ style (color $color)}}štek{{/}} {{@ style (color $color)}}starih sledovanja{{/}} sakrivenih{{@ style (color $color)}} iza{{/}} nekih {{@ style (color $color)}}sanduka{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Vojnici{{/}} su se lepo nasmejali na {{@ style (color $color)}}{{@ style (color $defaultColor)}}\"blago\"{{/}}{{/}} i predali ga {{@ style (color $color)}}magacioneru{{@ style (color $defaultColor)}}.{{/}}{{/}} Tvom {{@ style (color $color)}}psu{{/}} je obećana {{@ style (color $color)}}nagrada{{/}} za {{@ style (color $color)}}neočekivano otkriće{{/}}."

msgid "text/event_17"
msgstr "Čuo si divlju {{@ style (color $color)}}buku{{/}} koja stiže iz udaljenih {{@ style (color $color)}}baraka{{@ style (color $defaultColor)}}.{{/}}{{/}} Dok si prilazio, {{@ style (color $color)}}{{/}}video si nekoliko {{@ style (color $color)}}vojnika{{/}} okupljenih, gledajući kako se tvoj {{@ style (color $color)}}pas{{/}} žestoko {{@ style (color $color)}}bori{{/}} sa ogromnim, {{@ style (color $color)}}{{/}}belim {{@ style (color $color)}}mišićavim{{/}}{{@ style (color $color)}} mišem{{@ style (color $defaultColor)}}.{{/}}{{/}} U jednom momentu{{@ style (color $color)}}{{/}} svi su bili {{@ style (color $color)}}pometeni{{/}} {{@ style (color $color)}}najavom{{/}} - i kada su se vratili, {{@ style (color $color)}}čudni glodar{{/}} je {{@ style (color $color)}}nestao{{@ style (color $defaultColor)}}.{{/}}{{/}} U znak zahvalnosti{{@ style (color $color)}}{{/}} za tako {{@ style (color $color)}}zabavan spektakl{{/}}, {{@ style (color $color)}}trupe{{/}} su dale tvom {{@ style (color $color)}}psu{{/}} nekoliko {{@ style (color $color)}}korisnih stvari{{/}}."

msgid "text/event_18"
msgstr "Tokom {{@ style (color $color)}}istraživanja{{/}} {{@ style (color $color)}}stare {{/}}{{@ style (color $color)}}komandne{{/}}{{@ style (color $color)}} hale{{/}} tvoj {{@ style (color $color)}}pas{{/}} je počeo da {{@ style (color $color)}}laje{{/}} na {{@ style (color $color)}}prašnjave{{/}}{{@ style (color $color)}} portrete{{@ style (color $defaultColor)}}.{{/}}{{/}} Nakon {{@ style (color $color)}}{{/}}malo {{@ style (color $color)}}čišćenja{{/}} ispala je {{@ style (color $color)}}poruka{{/}} iza {{@ style (color $color)}}rama{{/}}. {{br}}Govorila{{@ style (color $color)}}{{/}} je o {{@ style (color $color)}}zaboravljenoj tenkovskoj jedinici{{/}} koja je {{@ style (color $color)}}nestala{{/}} tokom {{@ style (color $color)}}noćnih manevara{{/}} - njihov poslednji{{@ style (color $color)}}{{/}} poznati {{@ style (color $color)}}pozivni znak{{/}} je bio {{@ style (color $color)}}Gvozdena {{/}}{{@ style (color $color)}}šapa{{/}}."

msgid "text/event_19"
msgstr "Tokom još jedne {{@ style (color $color)}}patrole{{/}} po {{@ style (color $color)}}teritoriji{{/}} tvoj {{@ style (color $color)}}pas{{/}} je iznenada {{@ style (color $color)}}potrčao{{/}} u {{@ style (color $color)}}žbunje{{/}} i {{@ style (color $color)}}isterao{{/}} sakrivenog {{@ style (color $color)}}stranca{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Patrola{{/}} {{@ style (color $color)}}je {{/}}{{@ style (color $color)}}zadržala{{/}} {{@ style (color $color)}}uljeza{{/}}, i {{@ style (color $color)}}incident{{/}} je {{@ style (color $color)}}zabeležen{{/}} za dalju {{@ style (color $color)}}istragu{{/}}."

msgid "text/event_2"
msgstr "{{@ style (color $color)}}Pas{{/}} je dotrčao do tebe, mašući svojim {{@ style (color $color)}}repom{{@ style (color $defaultColor)}}.{{/}}{{/}} U njegovim {{@ style (color $color)}}zubima {{/}}je štos {{@ style (color $color)}}papira{{@ style (color $defaultColor)}}.{{/}}{{/}} Na prvi pogled izgledaju poput {{@ style (color $color)}}izveštaja{{/}}, {{@ style (color $color)}}tabela{{/}} i druge {{@ style (color $color)}}dokumentacije{{@ style (color $defaultColor)}}.{{/}}{{/}} Momci iz {{@ style (color $color)}}kancelarije{{/}} će verovatno biti srećni da ih dobiju nazad."

msgid "text/event_20"
msgstr "Tokom {{@ style (color $color)}}šetnje{{/}} po {{@ style (color $color)}}kraju{{/}}, tvoj {{@ style (color $color)}}pas{{/}} je iznenada {{@ style (color $color)}}{{/}}počeo da {{@ style (color $color)}}laje{{/}} na jednu od {{@ style (color $color)}}cevi za vodu{{@ style (color $defaultColor)}}.{{/}}{{/}} Nakon što su {{@ style (color $color)}}tehničari{{/}} {{@ style (color $color)}}proverili{{/}} {{@ style (color $color)}}mesto{{/}}, otkrili su {{@ style (color $color)}}kvar{{/}} koji je mogao da dovede do velikog {{@ style (color $color)}}kvara sistema{{/}}."

msgid "text/event_21"
msgstr "Tvoj {{@ style (color $color)}}pas{{/}} ti je {{@ style (color $color)}}{{/}}doneo {{@ style (color $color)}}vreću{{/}} punu {{@ style (color $color)}}{{/}}svakojakih {{@ style (color $color)}}čudnih, korisnih stvari{{@ style (color $defaultColor)}}.{{/}}{{/}} Uprkos pokušajima{{@ style (color $color)}}{{/}}, nisi mogao {{@ style (color $color)}}da utvrdiš{{/}} odakle je {{@ style (color $color)}}došla{{@ style (color $defaultColor)}}.{{/}}{{/}} Tvoj {{@ style (color $color)}}četvoronogi {{/}}{{@ style (color $color)}}prijatelj{{/}} je samo{{@ style (color $color)}}{{/}} sedeo pored{{@ style (color $color)}}{{/}}, gledajući {{@ style (color $color)}}zadovoljno{{/}} i savršeno {{@ style (color $color)}}srećno{{/}} za ostatak {{@ style (color $color)}}dana{{/}}."

msgid "text/event_22"
msgstr "{{@ style (color $color)}}Mehaničari{{/}} su uspeli da {{@ style (color $color)}}nauče{{/}} tvog {{@ style (color $color)}}psa{{/}} da {{@ style (color $color)}}donese{{/}} i {{@ style (color $color)}}identifikuje{{/}}{{@ style (color $color)}} alat{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Čudesni pas {{/}}je proveo ceo {{@ style (color $color)}}dan{{/}} {{@ style (color $color)}}radeći {{/}}{{@ style (color $color)}}pored{{/}} njih, {{@ style (color $color)}}samouvereno{{/}} {{@ style (color $color)}}donoseći{{/}}{{@ style (color $color)}} pravu {{@ style (color $color)}}opremu {{/}}poput iskusnog {{@ style (color $color)}}člana {{/}}posade{{/}}."

msgid "text/event_23"
msgstr "{{@ style (color $color)}}Mrtvo {{/}}{{@ style (color $color)}}drvo {{/}}je palo na jednog {{@ style (color $color)}}čuvara {{/}}tokom {{@ style (color $color)}}patrole{{@ style (color $defaultColor)}}. {{/}}{{/}}Tvoj {{@ style (color $color)}}pas {{/}}nije samo {{@ style (color $color)}}otrčao {{/}}{{@ style (color $color)}}po {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}pomoć {{/}}već i {{@ style (color $color)}}pomogao {{/}}{{@ style (color $color)}}da se {{/}}{{@ style (color $color)}}povređeni {{/}}{{@ style (color $color)}}čovek {{/}}izvuče ispod {{@ style (color $color)}}stabla{{@ style (color $defaultColor)}}. {{/}}{{/}}Ova {{@ style (color $color)}}priča {{/}}brzo se {{@ style (color $color)}}raširila {{/}}među {{@ style (color $color)}}patrolama{{/}}{{@ style (color $color)}}{{/}}."

msgid "text/event_24"
msgstr "Tvoj {{@ style (color $color)}}pas{{/}} je učestvovao u {{@ style (color $color)}}nagradnoj ceremoniji{{/}} za najiskusnije {{@ style (color $color)}}tenkiste{{@ style (color $defaultColor)}}.{{/}}{{/}} Savesni {{@ style (color $color)}}pas{{/}} je imao ulogu {{@ style (color $color)}}asistenta{{/}}, dodajući {{@ style (color $color)}}medalje{{/}} i {{@ style (color $color)}}poklone{{/}} {{@ style (color $color)}}domaćinu{{@ style (color $defaultColor)}}. {{/}}{{/}}Ovaj {{@ style (color $color)}}doprinos{{/}} nije {{@ style (color $color)}}{{/}}prošao {{@ style (color $color)}}neprimećen{{/}} - doneo je {{@ style (color $color)}}kuci{{/}} dobro zasluženu {{@ style (color $color)}}nagradu{{/}}."

msgid "text/event_25"
msgstr "Tvoj {{@ style (color $color)}}pas{{/}} se vratio u {{@ style (color $color)}}bazu{{/}} noseći {{@ style (color $color)}}pocepanu{{/}}{{@ style (color $color)}} plišanu lisicu{{@ style (color $defaultColor)}}.{{/}}{{/}} Neki {{@ style (color $color)}}vojnici{{/}} su tvrdili{{@ style (color $color)}}{{/}} da su čuli {{@ style (color $color)}}šapate{{/}} u {{@ style (color $color)}}šumi{{/}} malo pre toga.{{br}}Kasnije to {{@ style (color $color)}}veče{{/}}, jedan od njih je {{@ style (color $color)}}prepoznao{{/}} {{@ style (color $color)}}igračku{{/}} - odgovarala je {{@ style (color $color)}}amblemu {{/}}{{@ style (color $color)}}lisice{{/}} davno {{@ style (color $color)}}napuštene {{/}}{{@ style (color $color)}}izviđačke {{@ style (color $color)}}{{/}}jedinice{{/}} koja je {{@ style (color $color)}}nestala{{/}} godinama ranije tokom {{@ style (color $color)}}zimskih {{/}}{{@ style (color $color)}}manevara{{@ style (color $defaultColor)}}.{{/}}{{/}} Nikakvi {{@ style (color $color)}}dokumenti{{/}} nisu preostali."

msgid "text/event_26"
msgstr "Tokom {{@ style (color $color)}}distibucije {{/}}{{@ style (color $color)}}{{/}}{{@ style (color $color)}}zaliha {{/}}za {{@ style (color $color)}}trening {{/}}na {{@ style (color $color)}}terenu{{/}}, tvoj {{@ style (color $color)}}pas {{/}}je počeo da {{@ style (color $color)}}laje {{/}}{{@ style (color $color)}}agresivno{{@ style (color $defaultColor)}}. {{/}}{{/}}Alarmirani {{@ style (color $color)}}oficiri {{/}}{{@ style (color $color)}}su {{/}}istražili {{@ style (color $color)}}sanduke {{/}}i otkrili da je deo {{@ style (color $color)}}opreme {{/}}za {{@ style (color $color)}}aktivnu {{/}}{{@ style (color $color)}}borbu {{/}}{{@ style (color $color)}}{{/}}greškom pomešan sa {{@ style (color $color)}}školskom {{/}}{{@ style (color $color)}}municijom{{/}}."

msgid "text/event_27"
msgstr "Tokom {{@ style (color $color)}}vojnih {{/}}{{@ style (color $color)}}vežbi{{/}}, tvoj {{@ style (color $color)}}ljubimac {{/}}je postao opsednut {{@ style (color $color)}}kopanjem {{/}}{{@ style (color $color)}}rovova{{@ style (color $defaultColor)}}. {{/}}{{/}}Ovaj {{@ style (color $color)}}entuzijazam {{/}}se brzo {{@ style (color $color)}}proširio {{/}}na {{@ style (color $color)}}regrute{{/}}, koji su počeli da {{@ style (color $color)}}se takmiče {{/}}sa {{@ style (color $color)}}psom {{/}}za {{@ style (color $color)}}brzinu {{/}}i {{@ style (color $color)}}dubinu {{/}}- a sve uz {{@ style (color $color)}}zabavu {{/}}{{@ style (color $color)}}instruktorima{{/}}."

msgid "text/event_28"
msgstr "Danas je dan {{@ style (color $color)}}za {{/}}{{@ style (color $color)}}domaću {{/}}{{@ style (color $color)}}kuhinju {{/}}u {{@ style (color $color)}}kampu{{/}}, gde {{@ style (color $color)}}je vojnicima {{/}}dozvoljeno da {{@ style (color $color)}}pripreme {{/}}{{@ style (color $color)}}lokalna {{/}}{{@ style (color $color)}}jela {{/}}od dostupnih {{@ style (color $color)}}sastojaka{{@ style (color $defaultColor)}}. {{/}}{{/}}Tvoj {{@ style (color $color)}}pas {{/}}je ceo {{@ style (color $color)}}dan {{/}}{{@ style (color $color)}}proveo trčeći {{/}}{{@ style (color $color)}}među {{/}}{{@ style (color $color)}}stanicama {{/}}{{@ style (color $color)}}za kuvanje {{/}}i {{@ style (color $color)}}pomagao da {{/}}{{@ style (color $color)}}se nose {{/}}{{@ style (color $color)}}namirnice {{/}}- čime bi zaradio par {{@ style (color $color)}}zalogaja {{/}}iz {{@ style (color $color)}}ruku {{/}}{{@ style (color $color)}}prijatelja{{/}}."

msgid "text/event_29"
msgstr "Danas je bio {{@ style (color $color)}}važan{{/}}{{@ style (color $color)}} dan{{@ style (color $defaultColor)}}.{{/}}{{/}} Tvoj {{@ style (color $color)}}ljubimac{{/}} ga je proveo u {{@ style (color $color)}}bolnici{{/}}, {{@ style (color $color)}}zabavljajući{{/}} {{@ style (color $color)}}ranjene, {{/}}izvodeći nekoliko {{@ style (color $color)}}trikova{{/}} koje si ga naučio{{@ style (color $color)}}{{/}} i starajući se da {{@ style (color $color)}}poseti{{/}} svakog {{@ style (color $color)}}vojnika{{@ style (color $defaultColor)}}.{{/}}{{/}} Neko vreme, {{@ style (color $color)}}odeljenje{{/}} je bilo puno {{@ style (color $color)}}smeha {{/}}i {{@ style (color $color)}}mahanja {{/}}{{@ style (color $color)}}repom{{/}}."

msgid "text/event_3"
msgstr "Posmatraš dok {{@ style (color $color)}}pas{{/}} srećno pomaže {{@ style (color $color)}}momcima {{/}}iz {{@ style (color $color)}}skladišta{{/}} da nose {{@ style (color $color)}}vreće{{/}} i drugi {{@ style (color $color)}}tovar{{@ style (color $defaultColor)}}.{{/}}{{/}} Na kraju dana, zahvalni {{@ style (color $color)}}šef smene{{/}} ti je predao mali {{@ style (color $color)}}paket{{/}} u znak zahvalnosti za pomoć kuce."

msgid "text/event_30"
msgstr "Danas, tvoj {{@ style (color $color)}}pas{{/}} je pomogao{{@ style (color $color)}}{{/}} često {{@ style (color $color)}}{{/}}zaboravljenom {{@ style (color $color)}}servisnom osoblju{{@ style (color $defaultColor)}}.{{/}}{{/}} Vredan {{@ style (color $color)}}gonič{{/}} je nosio {{@ style (color $color)}}higijenska sredstva{{/}} i čak je pokušao {{@ style (color $color)}}da vuče džoger{{/}} preko {{@ style (color $color)}}poda{{/}} bez ičije {{@ style (color $color)}}{{/}}pomoći. Takvi {{@ style (color $color)}}trapavi{{/}}, ali {{@ style (color $color)}}uporni{{/}}{{@ style (color $color)}} napori{{/}} su podigli svima {{@ style (color $color)}}moral{{/}} tokom {{@ style (color $color)}}{{/}}ostatka {{@ style (color $color)}}dana{{/}}."

msgid "text/event_4"
msgstr "{{@ style (color $color)}}Pas{{/}} je dovukao {{@ style (color $color)}}drveni sanduk{{/}} napunjen čudnim, neuparenim {{@ style (color $color)}}alatkama{{@ style (color $defaultColor)}}.{{/}}{{/}} Niko ne zna odakle{{@ style (color $color)}}{{/}} je došao ali izgleda kao da ga je neko {{@ style (color $color)}}spakovao{{/}} namerno."

msgid "text/event_5"
msgstr "{{@ style (color $color)}}Pas {{/}}je pronašao {{@ style (color $color)}}konzervu {{/}}sa {{@ style (color $color)}}švedskom {{/}}{{@ style (color $color)}}etiketom{{@ style (color $defaultColor)}}. {{/}}{{/}}Nakon što je {{@ style (color $color)}}odgrizao {{/}}{{@ style (color $color)}}deo {{/}}{{@ style (color $color)}}poklopca{{/}}, počeo je da {{@ style (color $color)}}nestašno {{/}}{{@ style (color $color)}}juri {{/}}{{@ style (color $color)}}neke {{/}}{{@ style (color $color)}}vojnike{{/}}, koji su {{@ style (color $color)}}bežali {{/}}od {{@ style (color $color)}}odvratnog {{/}}{{@ style (color $color)}}smrada iz konzerve{{@ style (color $defaultColor)}}. {{/}}{{/}}Jedan od {{@ style (color $color)}}momaka {{/}}u begu ti je ponudio {{@ style (color $color)}}nagradu {{/}}da prekineš {{@ style (color $color)}}ovo mučenje{{/}}."

msgid "text/event_6"
msgstr "Jedan od {{@ style (color $color)}}kuvara{{/}} je potrošio ceo dan{{@ style (color $color)}}{{/}} postavljajući {{@ style (color $color)}}postere{{/}} o {{@ style (color $color)}}nestalom mačetu{{/}} oko {{@ style (color $color)}}garaže{{@ style (color $defaultColor)}}.{{/}}{{/}} Tvoj {{@ style (color $color)}}pas{{/}} je odlučio da pomogne u {{@ style (color $color)}}potrazi{{/}} i nakon nekoliko sati pronašao {{@ style (color $color)}}pufnastog begunca{{/}} sakrivenog {{@ style (color $color)}}{{/}}pored jedne od {{@ style (color $color)}}baraka{{/}}."

msgid "text/event_7"
msgstr "Tvoj {{@ style (color $color)}}pas{{/}} je pronašao {{@ style (color $color)}}čudnu spravu{{/}} i nosio je po {{@ style (color $color)}}garaži{{/}} ceo dan. Eventulano {{@ style (color $color)}}jedan od{{/}} tvojih {{@ style (color $color)}}mehaničara{{/}} je prepoznao kao {{@ style (color $color)}}rezervni deo tenka{{/}} i pažljivo ga odneo u {{@ style (color $color)}}radionicu{{@ style (color $defaultColor)}}.{{/}}{{/}} {{@ style (color $color)}}Pas {{/}}je delovao veoma{{@ style (color $color)}}{{/}} ponosno na{{@ style (color $color)}}{{/}} svoje {{@ style (color $color)}}otkriće{{@ style (color $defaultColor)}}.{{/}}{{/}} Šta god da se ispostavi da jeste, izgleda da ćeš biti {{@ style (color $color)}}nagrađen{{/}} za {{@ style (color $color)}}pronalaženje{{/}}."

msgid "text/event_8"
msgstr "Noćas je bio {{@ style (color $color)}}pun mesec{{@ style (color $defaultColor)}}.{{/}}{{/}} Opčaran {{@ style (color $color)}}mesečinom{{/}}, {{@ style (color $color)}}pas{{/}} je zavijao neprekidno do {{@ style (color $color)}}jutra{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Vojnici{{/}} koji su se probudili {{@ style (color $color)}}su pokušali{{/}} sve da umire {{@ style (color $color)}}kucu{{/}}, ali izgleda da ništa nije delovalo."

msgid "text/event_9"
msgstr "Tokom {{@ style (color $color)}}testiranja{{/}}, {{@ style (color $color)}}požar{{/}} je izbio na jednom od {{@ style (color $color)}}tenkova{{@ style (color $defaultColor)}}.{{/}}{{/}} Pre nego što je iko {{@ style (color $color)}}mogao da reaguje{{/}}, tvoj {{@ style (color $color)}}pas{{/}} je jurnuo ka {{@ style (color $color)}}zapaljenom vozilu{{/}} i pomogao {{@ style (color $color)}}posadi{{/}} da {{@ style (color $color)}}pobegne{{@ style (color $defaultColor)}}.{{/}}{{/}} Priča o takvoj {{@ style (color $color)}}hrabrosti{{/}} brzo se proširila kroz {{@ style (color $color)}}bazu{{/}}."

