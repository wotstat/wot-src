msgid "serviceChannelMessages/resourceWell/enabled/text"
msgstr "Radionica je ponovo otvorena!"

msgid "serviceChannelMessages/resourceWell/end/text"
msgstr "Počinjemo da radimo na sledećem projektu. Obavestićemo te kada završimo sa razvojem. Vidimo se uskoro!"

msgid "serviceChannelMessages/resourceWell/end/title"
msgstr "Radionica se zatvara"

msgid "serviceChannelMessages/resourceWell/noSerialVehicles/text"
msgstr "Isporuka vozila sa brojevima je gotova. Počinjemo da sklapamo %(vehicle)s u standardnoj konfiguraciji. Požuri - broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/noVehicles/text"
msgstr "Sklapanje vozila je gotovo. Sva vozila su isporučena svojim vlasnicima."

msgid "serviceChannelMessages/resourceWell/noVehicles/title"
msgstr "Izveštaj iz radionice"

msgid "serviceChannelMessages/resourceWell/noVehicles/twoParallelProducts/text"
msgstr "Isporuka %(soldOutVehicle)s je gotova. I dalje imaš priliku da kupiš %(availableVehicle)s. Ako si potrošio resurse ali ne završiš kupovinu na vreme, biće vraćeni na tvoj nalog uskoro. Požuri - broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/noVehiclesWithReturn/text"
msgstr "Sklapanje vozila je gotovo. Sva vozila su isporučena do svojih vlasnika. Svi potrošeni resursi će uskoro biti vraćeni na tvoj nalog uskoro."

msgid "serviceChannelMessages/resourceWell/oneVehicleStart/text"
msgstr "Komandire, imaš šansu da postaneš vlasnik %(vehicle)s sa numerisanim 3D stilom. Broj vozila je ograničen!"

msgid "serviceChannelMessages/resourceWell/pause/text"
msgstr "Radionica je trenutno nedostupna zbog održavanja."

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/additionalText"
msgstr "Stil broj: %(serialNumber)s"

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/text"
msgstr "Jedinstveno vozilo %(vehicle)s je primljeno iz radionice."

msgid "serviceChannelMessages/resourceWell/reward/title"
msgstr "Vozilo %(vehicle)s je primljeno!"

msgid "serviceChannelMessages/resourceWell/reward/vehicle/text"
msgstr "Vozilo %(vehicle)s je primljeno iz radionice."

msgid "serviceChannelMessages/resourceWell/start/title"
msgstr "Radionica se otvara"

msgid "serviceChannelMessages/resourceWell/twoVehiclesStart/text"
msgstr "Komandiru, ovo je tvoja šansa da dodješ do %(firstVehicle)s i %(secondVehicle)s! Ali budi brz - količina je ograničena!"
