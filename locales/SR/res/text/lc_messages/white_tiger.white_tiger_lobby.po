msgid "characteristicsPanel/specialInfo/boss"
msgstr "[Alpha i Omega] Blitzträger ima impresivno naoružanje i tehnologiju teleportacije i skoro je neuništiv kada je njegov štit podignut. Takođe služi kao snažna platforma za pristup razornom oružanom sistemu: Hiperion."

msgid "characteristicsPanel/specialInfo/hunter_1"
msgstr "[Kavgadžija] Uopšteno dobar na bliskom odstojanjima.\nVozilo može da nanese veliku štetu grupama sentinela i da popravi sam sebe u pauzama između čarki."

msgid "characteristicsPanel/specialInfo/hunter_2"
msgstr "[Jurišnik] Dobro jurišno vozilo protiv sentinela.\nMože da nanese ozbiljnu rafalnu štetu Blitzträger-u ili sentinelima i ima debeo oklop, ali mora da planira kako će da napadne neprijatelje."

msgid "characteristicsPanel/specialInfo/hunter_3"
msgstr "[Udari i beži] Brz izazivač za manevrisanje oko Blitzträger-a.\nVozilu manjka moć protiv sentinela ali kompenzuje taktikom udari i beži koristeći brzinu i privremeni štit protiv sporog Blitzträger-a."

msgid "characteristicsPanel/specialInfo/hunter_4"
msgstr "[Snajperska podrška] Anđeo čuvar na srednjim i velikim razdaljinama.\nVozilo može da nanese masivnu količinu štete metama iz daljine ali mu manjka način da ih napadne izbliza."

