msgid "welcomeScreen/description_1"
msgstr "Fon Krieger je napravi mašinu koja misli koju on naziva električna inteligencija. Krije se gde naši topovi ne mogu da dosegnu. Svaki hitac koji ispalimo postaje lekcija. Ali nismo završili sa predavanjem."

msgid "welcomeScreen/description_2"
msgstr "Kontroliši legendarni Blitzträger pod kontrolom Maksa Fon Krigera u borbi protiv Herijera - ili predvodi odred modifikovanih Herijera i napadni Blitzträger!"

msgid "welcomeScreen/description_3"
msgstr "Dobićeš vredne nagrade za završavanje etapa progresa. Da završiš ove etape, moraćeš da zaradiš tokene specijalnih misija događaja."

msgid "welcomeScreen/header_1"
msgstr "Rođen iz munje"

msgid "welcomeScreen/header_2"
msgstr "Učenje mašine"

msgid "welcomeScreen/header_3"
msgstr "Progres i nagrade"

