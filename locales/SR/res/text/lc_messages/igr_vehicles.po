msgstr "AN/GRC-7"

msgid "AN-VRC-7_IGR"
msgstr "AN/VRC-7"

msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Ovaj eksperimentalni tenk je nastao daljim razvojem AMX 13 tenka. Vozilo je prošlo testove ali nikada nije ušlo u masovnu proizvodnju ili u službu. Napravljena su samo dva komada."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

