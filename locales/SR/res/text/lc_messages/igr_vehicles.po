msgid "Maus_IGR_descr"
msgstr "Razvijan je od juna 1942. do jula 1944. Samo dva prototipa su napravljena od kojih je samo jedan dobio kupolu i naoružanje."

msgid "Maus_IGR_short"
msgstr "Maus"

