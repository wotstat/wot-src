msgstr "rezultati svake borbe se sabiraju. Ako potrebna vrednost nije dostignuta i nema preostalih pokušaja, misija se smatra neuspelom i napredak se ponišava. Misija će krenuti od početka."

msgid "quest/advice/sumLimiter/info/1/title"
msgstr "Primarni uslov:"

msgid "quest/advice/sumLimiter/info/2/description"
msgstr "slično primarnom uslovu ima svoj sopstveni napredak. Ovaj uslov je kompleksniji i imažeš isti broj pokušaja da ga kompletiraš."

msgid "quest/advice/sumLimiter/info/2/title"
msgstr "Sekundarni uslov:"

msgid "quest/advice/sumLimiter/limiter/1/description"
