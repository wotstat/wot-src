msgid "hint/LSH_FIRE"
msgstr "Dim ometa uočavanje neprijateljskih vozila i prenošenje pozicija. Vatra izaziva štetu vozilima."

msgid "hint/LSH_FOG"
msgstr "Magla ometa uočavanje neprijateljskih vozila i prenošenje njihovih pozicija."

msgid "hint/LSH_RAIN"
msgstr "Teška kiša ometa uočavanje neprijateljskih vozila i prenošenje njihovih pozicija."

msgid "hint/LSH_SANDSTORM"
msgstr "Peščana oluja ometa uočavanje neprijateljskih vozila i prenošenje njihovih pozicija."

msgid "hint/LSH_SMOKE"
msgstr "Dim ometa uočavanje neprijateljskih vozila i prenošenje njihovih pozicija."

msgid "hint/PPH_AIMING_01"
msgstr "Pokretanje kupole i vozila smanjuje <font color='#EE7000'>preciznost topa</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Krug oko nišana pokazuje <font color='#EE7000'>preciznost topa</font>. Sačekaj još malo za precizan hitac."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Automatsko nišanjenje</font> je uključeno. Klikni desno dugme miša da ga isključiš."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatsko nišanjenje uvek nišani tvoj top <font color='#EE7000'>u centar</font> vozila koje je tvoja meta"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Tvoju bazu <font color='#EE7000'>zauzimaju!</font> Ako napad nije odbijen, neprijateljski tim će pobediti u borbi."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Svako neprijateljsko vozilo ima <font color='#EE7000'>svoj sopstveni</font> napredak zauzimanja"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Zauzimanje</font> neprijateljske baze je jedan od načina da se pobedi u borbi."

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Kada pretrpiš štetu, tvoj napredak u zauzimanju <font color='#EE7000'>se poništava</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Kada napustiš krug baze, tvoj napredak u zauzimanju <font color='#EE7000'>je izgubljen</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Više vozila zauzima bazu <font color='#EE7000'>brže</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Nakon <font color='#EE7000'>trećeg</font> vozila, brzina zauzimanja baze se ne povećava"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Neprijateljska baza je skoro zauzeta!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Tvoj tim dobija trku zauzimanja baze!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modul vozila je kritično oštećen! Popravi ga koristeći <font color='#EE7000'>komplet za popravke</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modul vozila je kritično oštećen! Popravi ga koristeći <font color='#EE7000'>komplet za popravke</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Član posade je kritično povređen! Upotrebi na njemu <font color='#EE7000'>komplet za prvu pomoć</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Član posade je kritično povređen! Upotrebi na njemu <font color='#EE7000'>komplet za prvu pomoć</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Posda vozila je ošamućena! Tretiraj ih <font color='#EE7000'>kompletom za prvu pomoć</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Vozilo gori! Upotrebi <font color='#EE7000'>aparat za gašenje požara</font> sa donjeg panela."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Vozilo gori! Automatski <font color='#EE7000'>aparat za gašenje požara</font> je aktiviran."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Modul vozila je kritično oštećen! Opremanje <font color='#EE7000'>kompletom za popravke</font> pre borbe pomaže da se izboriš sa kritičnim pogodcima."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Član posade je kritično povređen! Opremanje <font color='#EE7000'>kompletom za prvu pomoć</font> pre borbe pomaže da se izboriš sa povredama posade."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Vozilo gori! Opremanje <font color='#EE7000'>aparatom za gašenje požara</font> pre borbe pomaže da se izboriš sa vatrom."

msgid "hint/PPH_OTHER_01"
msgstr "Bio si <font color='#EE7000'>uočen</font> - pucanje može da otkrije tvoju poziciju!"

msgid "hint/PPH_OTHER_02"
msgstr "Tvoje vozilo je uništeno. Možeš da pritisneš <font color='#EE7000'>Esc</font> da izađeš iz borbe bez kazne."

msgid "hint/PPH_OTHER_03"
msgstr "Tvoje vozilo je uništeno. Možeš da klikneš dugme miša da <font color='#EE7000'>posmatraš</font> svoje saveznike."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Ikona sijalice</font> označava da si uočen od strane neprijatelja!"

msgid "hint/PPH_OTHER_05"
msgstr "Tvoj top se i dalje <font color='#EE7000'>puni</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Tvoj top može da opali samo ako je krug oko nišana <font color='#EE7000'>potpuno zelen</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Možeš da upotrebiš točak miša da uđeš u <font color='#EE7000'>snajper režim</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Možeš da upotrebiš točak miša da <font color='#EE7000'>napustiš</font> snajper režim"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Unutrašnji zeleni nišan</font> označava visoku šansu probijanja neprijateljskog oklopa"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Čak i kada je unutrašnji nišan zelen, probijanje oklopa <font color='#EE7000'>nije zagarantovano</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Topovi nisu 100% precizni, tako da hici <font color='#EE7000'>ne pogađaju uvek u centar</font> nišana"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Unutrašnji nišan označava šansu probijanja neprijateljskog oklopa.<font color='#EE7000'>Uključi ga u podešavanjima</font>."

msgid "penetration/chance/high"
msgstr "Visoka šansa"

msgid "penetration/chance/low"
msgstr "Mala šansa"

msgid "penetration/chance/medium"
msgstr "Srednja šansa"
