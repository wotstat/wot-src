msgid "battlePassSeasonDescription"
msgstr "NOVI TEMATSKI 3D STILOVI"

msgid "beCareful"
msgstr "Budi pažljiv"

msgid "comp7Core10"
msgstr "Možeš se prebaciti na odgovarajuće vozilo tokom faze priprema za borbu."

msgid "comp7Core10Status"
msgstr "Faza priprema za borbu"

msgid "comp7Core11"
msgstr "Ekran faza priprema za borbu prikazuje tvoje vozilo opremljeno posadom i granatama. Ne zaboravi da ih pripremiš pre borbe."

msgid "comp7Core11Status"
msgstr "Faza priprema za borbu"

msgid "comp7Core12"
msgstr "Jednom kada izabereš vozilo, obavesti saveznike klikom na Potvrdi izbor."

msgid "comp7Core12Status"
msgstr "Faza priprema za borbu"

msgid "comp7Core13"
msgstr "Nakon klika na Potvrdi izbor, nećeš moći da menjaš vozilo."

msgid "comp7Core13Status"
msgstr "Potvrdi izbor"

msgid "comp7Core14"
msgstr "Zarobi specijalne tačke na mapi da dobiješ pristup taktičkim veštinama i dobiješ prednost!"

msgid "comp7Core14Status"
msgstr "Tačke interesa"

msgid "comp7Core15"
msgstr "Tačka interesa na mapi. Zarobi ovu lokaciju kako bi imao pristup taktičkoj veštini radara divizije. Kada se aktivira, sva neprijateljska vozila će ostati uočena na nekoliko sekundi."

msgid "comp7Core15Status"
msgstr "Centar za komunikacije"

msgid "comp7Core16"
msgstr "Tačka interesa na mapi. Zarobi ovu lokaciju kako bi imao pristup taktičkoj veštini artiljerijski napad. Kada se aktivira, igrač može da izabere zonu koja će biti gađana artiljerijskom vatrom."

msgid "comp7Core16Status"
msgstr "Artiljerijska baza"

msgid "comp7Core17"
msgstr "Ako taktička veština artiljerijski napad pogodi saveznika, neće biti oštećen. Ipak, biće ošamućen."

msgid "comp7Core17Status"
msgstr "Artiljerijski napad"

msgid "comp7Core18"
msgstr "Pažnja: Mape u ovom režimu se mogu razlikovati u odnosu na slučajne borbu."

msgid "comp7Core18Status"
msgstr "Mape u događaju"

msgid "comp7Core19"
msgstr "Kreiranje voda od 7 igrača može poboljšati šanse za pobedu."

msgid "comp7Core19Status"
msgstr "Timska igra je ključna"

msgid "comp7Core21"
msgstr "Možeš proveriti nivo punjenja savezničkih veština uloga pritiskom na Tab ili Alt."

msgid "comp7Core21Status"
msgstr "Savezničke veštine uloga"

msgid "comp7Core22"
msgstr "Možeš proveriti listu tima da vidiš da li saveznici imaju taktičke veštine. Neprijateljske taktičke veštine se ne prikazuju."

msgid "comp7Core22Status"
msgstr "Taktičke veštine"

msgid "comp7Core23"
msgstr "Ako veština uloge udari vozilo, odgovarajuća ikona će biti prikazana iznad markera igrača."

msgid "comp7Core23Status"
msgstr "Efekat uloga veštine"

msgid "comp7Core24"
msgstr "H taster (podrazumevano) uključuje glasovni čet. Koristi ovo da komuniciraš sa timom efektivnije."

msgid "comp7Core24Status"
msgstr "Glasovni čet"

msgid "comp7Core25"
msgstr "Ako imaš problema sa glasovnim četom, pogledaj podešavanja klijenta igre."

msgid "comp7Core25Status"
msgstr "Glasovni čet"

msgid "comp7Core29"
msgstr "Kada pritisneš Alt, uloga svakog vozila u vidnom polju je prikazana iznad markera igrača. Za saveznička vozila, takođe ćeš videti punjenja uloga veštine."

msgid "comp7Core29Status"
msgstr "Uloge vozila"

msgid "comp7Core31"
msgstr "Možeš menjati tastere za veštine uloge i taktičke veštine u podešavanjima."

msgid "comp7Core31Status"
msgstr "Podešavanja"

msgid "comp7Core32"
msgstr "Nakon određenog vremena, moći ćeš ponovo da zauzmeš tačku interesa."

msgid "comp7Core32Status"
msgstr "O tačkama interesa"

msgid "comp7Core33"
msgstr "Ne možeš da zarobiš tačku interesa dok koristiš odgovarajuću taktičku veštinu."

msgid "comp7Core33Status"
msgstr "O tačkama interesa"

msgid "comp7Core34"
msgstr "Zarobljavanje tačke interesa donosi broj poena prestiža."

msgid "comp7Core34Status"
msgstr "O tačkama interesa"

msgid "comp7Core35"
msgstr "Pogledaj pravila događaja da saznaš više o poenima prestiža."

msgid "comp7Core35Status"
msgstr "O poenima prestiža"

msgid "comp7Core37"
msgstr "Režim ima modifikatore koji menjaju određene parametre vozila poput poena izdržljivosti vozila, vremena hlađenja potrošnog materijala, vremena koliko je vozilo vidljivo i drugog."

msgid "comp7Core37Status"
msgstr "Modifikatori Juriša"

msgid "comp7Core5"
msgstr "U zavisnosti od uloge, svako vozilo ima specijalnu veštinu sa tri nivoa punjenja. Što je veći nivo kada se veština aktivira, jači je efekat."

msgid "comp7Core5Status"
msgstr "O veštinama uloge"

msgid "comp7Core6"
msgstr "Poeni prestiža se mogu zaraditi za impresivne poerformanse u borbi, zarobljavanje tačaka interesa, korišćenje veština itd."

msgid "comp7Core6Status"
msgstr "O poenima prestiža"

msgid "comp7Core8"
msgstr "Igrači neće imati informacije o protivničkim vozilima dok ih ne uoče."

msgid "comp7Core8Status"
msgstr "Ratna magla"

msgid "comp7Light7"
msgstr "Možeš saznati više o Lakom Jurišu klikom na dugme O DOGAĐAJU na ekranu događaja."

msgid "comp7Light7Status"
msgstr "Detalji režima"

msgid "comp7Light9"
msgstr "Sa kolekcijom vozila VIII nivoa u različitim ulogama, možeš izabrati najbolje vozilo za svaku borbu i prilagoditi se savezničkim vozilima."

msgid "comp7Light9Status"
msgstr "Proširi garažu"

msgid "comp7Ranked0"
msgstr "Bori se za poene rejtinga da dostigneš najveće rangove i dokažeš svoju superiornost."

msgid "comp7Ranked0Status"
msgstr "Sistem rangova"

msgid "comp7Ranked1"
msgstr "Što više poena prestiža zaradiš u borbi, više poena rejtinga ćeš dobiti za pobedu i manje ćeš gubiti za poraz."

msgid "comp7Ranked1Status"
msgstr "Poeni prestiža i poeni rejtinga"

msgid "comp7Ranked2"
msgstr "U Jurišu, igrači sličnih rangova se sukobljavaju."

msgid "comp7Ranked20"
msgstr "Napuštanje borbe pre kraja pravi nedostatak timu. Napuštanje će rezultovati privremenim blokom i umanjenjem poena rejtinga."

msgid "comp7Ranked20Status"
msgstr "Dezertiranje"

msgid "comp7Ranked26"
msgstr "Samo igrači i rangu Šampiona i Legende su prikazani na tabeli. Svi igrači koji su na tabeli dobijaju dnevne nagrade."

msgid "comp7Ranked26Status"
msgstr "Tabela"

msgid "comp7Ranked27"
msgstr "Dezerteri će biti privremeno blokirani iz režima igre. Trajanje bloka raste sa svakim sledećim prekršajem."

msgid "comp7Ranked27Status"
msgstr "Privremeni blok"

msgid "comp7Ranked28"
msgstr "Bori se u režimu da otključaš nove elemente Juriš progresivnog stila."

msgid "comp7Ranked28Status"
msgstr "Progresivni stil"

msgid "comp7Ranked2Status"
msgstr "Dostojni igrači"

msgid "comp7Ranked3"
msgstr "Rang Legende se samo dodeljuje najboljima. Da dobiješ ovaj rang, moraš biti u najboljih 10% igrača na tabeli po broju poena rejtinga."

msgid "comp7Ranked36"
msgstr "Pažnja: Ako napustiš borbu pre kraja, izgubićeš više poena rejtinga nego za katastrofalan poraz."

msgid "comp7Ranked36Status"
msgstr "Dezertiranje"

msgid "comp7Ranked3Status"
msgstr "Legenda"

msgid "comp7Ranked4"
msgstr "Ako prekineš igru u režimu, izgubićeš poene rejtinga. Pravila važe za Srebro, Zlato, Šampion i Legenda rangove."

msgid "comp7Ranked4Status"
msgstr "Neaktivnost ranga"

msgid "comp7Ranked7"
msgstr "Možeš saznati više o Jurišu klikom na O DOGAĐAJU na ekranu događaja."

msgid "comp7Ranked7Status"
msgstr "Detalji režima"

msgid "comp7Ranked9"
msgstr "Sa kolekcijom vozila X nivoa u različitim ulogama, možeš izabrati najbolje vozilo za svaku borbu i prilagoditi se savezničkim vozilima."

msgid "comp7Ranked9Status"
msgstr "Proširi garažu"

msgid "devMaps0"
msgstr "Lokacija slučajnog događaja biće označena sa \ndimom na mapi i markerom na minimapi.\nMape sa slučajnim događajima se mogu isključiti u podešavanjima igre."

msgid "devMaps0Status"
msgstr "Mape sa slučajnim događajima"

msgid "devMaps1"
msgstr "Tvoje vozilo može biti uništeno u zoni slujanog događaja (na primer tokom pada aviona).\nMape sa slučajnim događajima se mogu isključiti u podešavanjima igre."

msgid "devMaps1Status"
msgstr "Mape sa slučajnim događajima"

msgid "dualGunVehicles"
msgstr "Vozila sa sistemom dvocevnog topa"

msgid "epicModeHiddenFeatures"
msgstr "Veteran \"Linije fronta\""

msgid "epicModeIntroduction"
msgstr "Karakteristike režima"

msgid "epicModeUseful"
msgstr "Nauči o \"Liniji fronta\""

msgid "epicRandom0"
msgstr "Možeš da iskusiš mali pad performansi u ovom borbenom režimu."

msgid "epicTip1"
msgstr "Kada je baza zauzeta sva vozila odbrambenog tima koja ostanu u zoni su meta bombardovanja."

msgid "epicTip10"
msgstr "Pored slave i popularnosti, rangovi takođe donose korisne bonuse nakon svake borbe."

msgid "epicTip11"
msgstr "Režim \"Linija fronta\" sadrži mnogo načina da se zarade iskustvo i krediti."

msgid "epicTip12"
msgstr "Linija fronta može biti potiskivanjem drugog tima unazad. Ovo ti dozvoljava da ponovo uđeš u borbu nakon uništenja vozila bliže svojim ciljevima."

msgid "epicTip13"
msgstr "kada vozilo unutar kruga zauzimanja pretrpi štetu, proces zauzimanja za to vozilo je blokiran na neko vreme."

msgid "epicTip14"
msgstr "Aktiviraj i povećaj borbene rezerve na posebnom ekranu. Upotrebi ih da naneseš uništenje neprijatleju na bojištu."

msgid "epicTip15"
msgstr "Uvek možeš da promeniš frontove na ekranu za ponovni ulazak u borbu ako tako zahteva strateška situacija."

msgid "epicTip16"
msgstr "Nemoj da ulaziš u zaštićene zone. Neprijateljska artiljerija će početi da puca po tebi."

msgid "epicTip17"
msgstr "Da li si se zaglavio negde na mapi? Upotrebi opciju izvlačenja (J po početnim podešavanjima) da bi napustio svoje vozilo i krenuo iznova."

msgid "epicTip18"
msgstr "Otvori veliku verziju mape (M po početnim podešavanjima) za bolji pregled bojišta."

msgid "epicTip19"
msgstr "Dobićeš komunikacione poruke samo od igrača koji su vidljivi na tvojoj mini mapi."

msgid "epicTip2"
msgstr "Režim \"Linija fronta\" nudi velike nagrade ako želiš da zaradiš nešto preko."

msgid "epicTip20"
msgstr "Možeš da podesiš vidljivu oblast mini mape točkićem na mišu dok ti se kurzor nalazi iznad mape."

msgid "epicTip21"
msgstr "Možeš da označiš baze ili ciljeve na mapi za svoje saborce tako što ćeš kliknuti na njih na mini mapi."

msgid "epicTip22"
msgstr "Kada ostaneš bez tenkova zapamti da proveriš kameru u slobodnom režimu. Na taj način možeš da planiraš svoju strategiju dok čekaš da se vratiš u borbu."

msgid "epicTip23"
msgstr "Kada se baza zauzima i vreme za bitku istekne, meč ulazi u produžetak. Borba će se nastaviti dok sve baze nisu očišćene."

msgid "epicTip3"
msgstr "U režimu \"Linija fronta\" bojište je 9 km² što je devet puta veće od veličine mapa za nasumične borbe."

msgid "epicTip4"
msgstr "Vreme trajanje bitke se povećava nakon svakog zauzimanja zone. Poslednja zona daje i dodatno vreme preko toga."

msgid "epicTip5"
msgstr "Ako je tvoje vozilo uništeno u borbi, potrebno mu je neko vreme za popravku. Izaberi drugo vozilo i vrati se u borbu."

msgid "epicTip6"
msgstr "Još jedno dodatno vozilo se isporučuje tvojim rezervama svakih 5 minuta."

msgid "epicTip7"
msgstr "Napadači mogu da uđu u zonu u drugoj linij samo ako je prva linija na istom frontu već zauzeta."

msgid "epicTip8"
msgstr "Kada su sve zone u prvoj linij zauzete sve zone u drugoj linij su oslabljene."

msgid "epicTip9"
msgstr "Moguće je pobediti u borbi samo eliminisanjem kompletnog protivničkog tima. Međutim šanse za to su VEOMA male."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Poštuj pravila"

msgid "howToPlay"
msgstr "Kako igrati"

msgid "mapbox0"
msgstr "Vozila unutar lokalne vremenske zone ne mogu da uoče vozila izvan zone i obrnuto, ili da razmene informacije o pozicijama neprijateljskih vozila van zone. Vatra oštećuje vozila."

msgid "mapbox0Status"
msgstr "Lokalno vreme"

msgid "payAttention"
msgstr "Obrati pažnju"

msgid "ranked1"
msgstr "Dobijaš više iskustva ako igraš u skladu sa ulogom vozila! Opis uloge vozila i odgovarajuće akcije u borbi su dostupni u garaži na informacionoj stranici o režimu."

msgid "ranked10"
msgstr "Za uspehu prolazu kroz rangirane borbe bićeš u mogućnosti da kupiš jedinstvena vozila i elemente prilagođavanja za bonove (uključujući one na popustu). Da bi video listu ovih stvari klikni na baner.\nVan sezone ne možeš da pristupiš stvarima ili popustima."

msgid "ranked11"
msgstr "Dnevne bonus borbe su dostupne samo u ligama. Dobijaju se u zavisnosti od rezultata u kvalifikacijama i za završavanje specijalnih misija. Dnevne bonus borbe se ne prenose za sledeći dan."

msgid "ranked12"
msgstr "Na kraju godine, najefikasniji igrači će se pridružiti lestvici. Oni će dobiti dodatnu značku i uživaće u časti i poštovanju zajednice."

msgid "ranked13"
msgstr "Neki rankovi su trajni. Kada je jednom ovaj rang dostignut ne može biti izgubljen. Rang sa sredine etape ima dodatnu indikaciju. Početni rangovi svake od divizija takođe su trajni i ne mogu biti izgubljeni."

msgid "ranked2"
msgstr "Dobijaš standardne i bonus dnevne borbe za dostizanje sledećih divizija i liga. Bonus borba automatski duplira broj ševrona zarađenih u borbi i ne troši se u slučaju neuspeha.Samo jedna bonus borba dnevno je dostupna za svako vozilo X nivoa."

msgid "ranked3"
msgstr "Prati prajm tajm: kada je gotov rangirane borbe su nedostupne do sledećeg dana i dobićeš odgovarajuće obaveštenje."

msgid "ranked4"
msgstr "Neki rankovi imaju takozvane štitove. Kada gubiš na takvim angovima slabiš šti ali ne gubiš rang. Ako štit nije potpuno istrošen dobijanje ševrona na rangu sa štitom potpuno obnavlja šti."

msgid "ranked5"
msgstr "Nikada ne odustaj! Ševron neće biti dodeljen samo najboljim 7 igrača u pobedničkom timu nego i najboljem igraču u timu koji je izgubio. Zapamti da se svaki ševron dobijen u bonus borbi duplira."

msgid "ranked6"
msgstr "Nakon završetka svih divizija igrači dostižu jednu od tri lige: Zlatnu, srebrnu ili bronzanu. Nastavljaju da se bore i njihovi borbeni rezultati će uticati na njihove performanse i na poziciju na tabeli."

msgid "ranked7"
msgstr "Igrači dobijaju žetone ranga za svaku završenu diviziju. Igrači koji su pokazali najbolje performanse tokom tri sezone će dobiti zaslužene finalne nagrade."

msgid "ranked8"
msgstr "Na kraju sezone najbolji igrači će dobiti jedinstvenu značku i stil za vozila. Ove nagrade predstavljaju oznaku ponosa za igrače, simbole njihovog majstorstva."

msgid "ranked9"
msgstr "Za uspeh u rangiranim borbama dobijaš bonove. Bonovi mogu biti razmenjeni za direktive i poboljšanu opremu. Pored toga postoje i druge vredne nagrade: krediti, potrošni mateijal itd."

msgid "rankedStatus1"
msgstr "Iskustvo za poštovanje uloge vozila"

msgid "rankedStatus10"
msgstr "Stvari iz rangiranih borbi"

msgid "rankedStatus11"
msgstr "Dnevne bonus borbe"

msgid "rankedStatus12"
msgstr "Najbolji igrači godine"

msgid "rankedStatus13"
msgstr "Pravila režima"

msgid "rankedStatus2"
msgstr "Bonus borbe"

msgid "rankedStatus3"
msgstr "Udarno Vreme"

msgid "rankedStatus4"
msgstr "Pravila režima"

msgid "rankedStatus5"
msgstr "Pravila režima"

msgid "rankedStatus6"
msgstr "Borbe u ligama"

msgid "rankedStatus7"
msgstr "Godišnje nagrade"

msgid "rankedStatus8"
msgstr "Nagrade za kraj sezone"

msgid "rankedStatus9"
msgstr "Nagrade za rangove"

msgid "security"
msgstr "Bezbednost iznad svega"

msgid "technicalAdvice"
msgstr "Tehnički savet"

msgid "tip0"
msgstr "Močvarno zemljište značajno umanjuje brzinu kretanja i skretanja vozila."

msgid "tip100"
msgstr "Efikasnost člana posade utiče na odgovarajuće karakteristike vozila."

msgid "tip101"
msgstr "Šesto čulo odlika omogućava komandiru da identifikuje da li je vozilo uočeno od strane neprijatelja."

msgid "tip102"
msgstr "Parametar efikasnosti odlike je parametar koji određuje efikasnost svih odlika naučenih od strane člana posade."

msgid "tip103"
msgstr "Možeš da promeniš kvalifikacije člana posade kada ga preobučavaš."

msgid "tip106"
msgstr "Oprema poboljšava efikasnost posade i karakteristike vozila."

msgid "tip107"
msgstr "Vozila kojima su svi moduli i grane razvojnog stabla iuzučeni, dobijaju elitni status."

msgid "tip108"
msgstr "Borbeno iskustvo zarađeno na elitnim vozilima, uključujući i Premijum vozila, može biti pretvoreno u slobodno iskustvo."

msgid "tip11"
msgstr "Koristi rastinje i žbunje da bi učinio svoj lovac tenkova teže uočljivim. Stacionarna vozila su manje primetna."

msgid "tip111"
msgstr "Ponekad je zauzimanje baze lakša i manje opasna opcija nego pokušaj da se unište sva neprijateljska vozila."

msgid "tip114"
msgstr "Delenje naloga je protiv pravila igre i može rezultovati gubitkom pristupa nalogu."

msgid "tip115"
msgstr "Pravila igre zabranjuju delenje naloga. Prekršioci mogu da izgube oba naloga trajno."

msgid "tip116"
msgstr "Što ti je šifra složenija, to je bolje."

msgid "tip117"
msgstr "Menjaj svoju šifru često."

msgid "tip118"
msgstr "Pravila igre strogo zabranjuju kupovinu i prodaju naloga. Ako prekršiš ova pravila možeš da ostaneš bez naloga."

msgid "tip119"
msgstr "Nemoj pratiti linkove ka nepoznatim sajtovima. Rizikuješ prevaru ili da ti neko hakuje nalog."

msgid "tip120"
msgstr "Zlato možeš da kupiš samo na zvaničnom World of Tanks sajtu. Ako pokušaš da kupiš zlato na drugim sajtovima, rizikuješ da izgubiš svoj novac."

msgid "tip121"
msgstr "Opcija čuvanja šifre jeste zgodna ali potencionalno nesigurna."

msgid "tip122"
msgstr "Na portalu možeš pronaći instrukcije kako da dodatno zaštitiš svoj nalog. Pažljivo ih pročitaj."

msgid "tip123"
msgstr "U borbi, drži CTRL da prikažeš kursor miša."

msgid "tip124"
msgstr "Za opravku modula, koristi paket za opravku. Da izlečiš člana posade, koristi paket prve pomoći."

msgid "tip125"
msgstr "Da bi koristio potrošni materijal ili menjao tipove granata koristi tastere (1-6 početna podešavanja)."

msgid "tip126"
msgstr "Da pomeriš kameru smesta u režimu artiljerije, klikni desnim tasterom miša na mapu."

msgid "tip127"
msgstr "Da promeniš prikaz imena timova, pritisni CTRL+TAB."

msgid "tip128"
msgstr "Desni klik na igračevo ime u panelu sa strane da vidiš moguće akcije."

msgid "tip129"
msgstr "Da bi se žalio na nekog igrača, klikni na njegovo ime na panelima sa strane ekrana desnim dugmetom miša i izaberi odgovarajuću opciju iz kontekstnog menija."

msgid "tip130"
msgstr "Komande koje su ti na izboru u komandnom meniju se menjaju u zavisnosti od toga da li ti je kursor na savezniku, neprijatelju, pokazuje na teren ili objekt."

msgid "tip131"
msgstr "Da bi izabrao komandu u komandnom meniju, drži T ili Z i pomeri miša da označiš komandu koja ti treba."

msgid "tip132"
msgstr "Koristi tastere F2 - F8 za brzo biranje komandi iz komandnog menija."

msgid "tip134"
msgstr "Biti bezobrazan nije baš najbolji način da se ubede saveznici ko je u pravu. Pored toga, to je zabranjeno i pravilima igre."

msgid "tip135"
msgstr "Saveznici su u glavnom voljni da pomognu kultirnim saigračima."

msgid "tip136"
msgstr "Glavna borba se mora voditi na mapi, ne u četu."

msgid "tip137"
msgstr "Nemoj slati nepotrebne poruke u četu, one često odvlače pažnju igračima od same borbe."

msgid "tip138"
msgstr "Upotrebi opciju za žalbe kada je bilo koje od pravila igre prekršeno."

msgid "tip139"
msgstr "Dodavanjem igrača na crnu listu prestaćeš da dobijaš poruke i pozive od njega momentalno."

msgid "tip14"
msgstr "Automatsko nišanjenje ne garantuje 100% preciznost. Iskusni igrači koriste ručno nišanjenje."

msgid "tip140"
msgstr "Cenzurisanje poruka može biti uključeno u podešavanjima."

msgid "tip141"
msgstr "Borbeni čet može biti isključen u podešavanjima. Čet u vodu će i dalje biti dostupan."

msgid "tip142"
msgstr "Dok se svađaš sa saveznicima, neprijatelj će preuzeti kontrolu nad bojištem."

msgid "tip143"
msgstr "Vodi računa o toku borbe. Jedna greška može da vodi do poraza."

msgid "tip144"
msgstr "Upotreba ne dozvoljenih modifikacija ili nameštanje mečeva može da dovede do trajnog bana tvog naloga."

msgid "tip146"
msgstr "Kršenje pravila je kažnjivo i igre može rezultovati zaključavanjem tvog naloga."

msgid "tip147"
msgstr "Ukoliko si kažnjen za kršenje pravila igre, preporučujemo da ih pročitaš do bi izbegao slične incidente u buduće."

msgid "tip148"
msgstr "Pravila igre važe za sve igrače, kao i kazne za kršenje istih."

msgid "tip149"
msgstr "Ne možeš da uđeš u borbu? Pokušaj da isključiš modifikacije i restartuješ klijent igre."

msgid "tip150"
msgstr "Mali FPS? Pokušaj sa nižim kvalitetom grafike u podešavanjima."

msgid "tip151"
msgstr "Mali FPS i iskrivljena grafika? Pokušaj da preuzmeš najnovije drajvere za svoju video karticu."

msgid "tip152"
msgstr "Visoko kašnjenje prilikom povezivanja preko 3G ili WiFi konekcije? Pokušaj da koristiš kablovski pristup internetu."

msgid "tip153"
msgstr "Tvoje vozilo se teleportuje ili puca sa zadrškom? Proveri svoju mrežnu konekciju."

msgid "tip154"
msgstr "Dobar antivirusni program garantuje stabilan rad hardvera i klijenta igre."

msgid "tip155"
msgstr "Tvoj tim te ne čuje u borbi? Proveri glasovna podešavanja."

msgid "tip156"
msgstr "Što detaljniji opis svog problema daš korisničkoj podršci, brže će tvoj problem biti razmotren."

msgid "tip157"
msgstr "Pre kontaktiranja korisničke podrške, pobrini se da problem može da se reprodukuje iako su modovi igre isključeni."

msgid "tip158"
msgstr "Dodavanje broja telefona na rpfil naloga čini profil bezbednijim od potencialnih napada."

msgid "tip159"
msgstr "Pobrini se da je broj mobilnog telefona koji si dodao na nalog aktivan. Ovo dozvoljava bez povratak naloga u slučaju problema."

msgid "tip160"
msgstr "Povezivanjem tvog broja mobilnog telefona sa nalogom, možeš da promeniš email adresu na koji je nalog registrovan."

msgid "tip161"
msgstr "Ako sumljaš da je neko neovlašćeno pristupio tvom nalogu, kontaktiraj centar za korisničku podršku smesta."

msgid "tip162"
msgstr "Ne prihvataj poklone od nepoznatih korisnika."

msgid "tip163"
msgstr "Izaberi odgovarajuću sekciju u korisničkoj podršci kako bi garantovao brz odgovor na tvoj problem."

msgid "tip164"
msgstr "Vešt igrač artiljerije može koristiti tragove granata da uništi neprijateljsku artiljeriju koja ne menja svoju poziciju."

msgid "tip165"
msgstr "Automatski aparat za gašenje hitro gasi požar i takodje smanjuje šanse za požar motora."

msgid "tip166"
msgstr "Kada voziš artiljeriju, zapamti da uračunaš brzinu leta granate, kao i nepravilnosti terena."

msgid "tip167"
msgstr "Obrati pažnju na saveznike i neprijatelje na mapi."

msgid "tip168"
msgstr "Pucanje tokom pasivnog otkrivanja otkriva tvoj položaj. Zaradićeš dodatne kredite i iskustvo za uočavanje neprijatelja."

msgid "tip169"
msgstr "Koristi paket za opravku za brz opravak oštećenih gusenica. Kada je tvoje vozilo ponovo pokretno, pokušaj da izbegneš neprijateljske granate."

msgid "tip17"
msgstr "Dobro oklopljena meta koju nepmogu probiti anti oklopnim granatama može ipak biti oštećena upotrebom fugasnih granata."

msgid "tip170"
msgstr "Kako grmlje, tako i pala stabla skrivaju tvoje vozilo."

msgid "tip171"
msgstr "Stene i duboki rovovi mogu imobilisati tvoje vozilo."

msgid "tip173"
msgstr "Možeš prebaciti članove posade u premium vozilo iste nacije i tipa bez potrebe za treningom."

msgid "tip174"
msgstr "Povrede članova posade smanjuju njihovu efikasnost."

msgid "tip176"
msgstr "Za prihvatanje poklona, igrač koji prihvata mora biti ulogovan u podešavanja naloga."

msgid "tip177"
msgstr "Žalbe za sankcije za oštećenje / uništenje savezničkih vozila neće biti pregledane od strane korisničke službe, pod bilo kojim uslovima."

msgid "tip178"
msgstr "Savetujte se sa korisničkom podrškom da bi razjasnio razloge suspenzije svog naloga."

msgid "tip179"
msgstr "Pre slanja tiketa korisničkoj podršci za nestalo vozilo, pobrini se da je filter vozila u klijentu igre isključen."

msgid "tip180"
msgstr "Možeš podesiti jačinu zvuka koristeći opšti nivo jačine ili promenom jačine zvuka na tvom sistemu."

msgid "tip181"
msgstr "Izaberi svoj zvučni uredjaj - \"2.0/2.1 zvučni sistem\" ili \"Slušalice\" u podešavanjima zvuka za bolje pozicioniranje zvuka."

msgid "tip182"
msgstr "Za najbolje performanse na slabijim zvučnim sistemima, izaberi \"laptop\" preset."

msgid "tip183"
msgstr "Koristi noćni režim da umanjiš oštre zvuke."

msgid "tip184"
msgstr "Možeš izabrati opciju pojačavanja niskih frekvencija, ali rezultat će biti drugačiji u zavisnosti od zvučnog sistema."

msgid "tip185"
msgstr "Laka vozila sa točkovima imaju najviše karakteristike dinamike koje im dozvoljavaju da budu prva koja će da zauzmu dobre pozicije ili pronađu siguran zaklon od neprijateljske vatre."

msgid "tip186"
msgstr "Takva vozila su opremljena sa dve potpuno funkcionalne cevi koje obe mogu da pucaju odvojeno ili simultano. Taster za kontrolu pucanja može biti promenjen u podešavanjima."

msgid "tip191"
msgstr "Nekoliko različitih klasa opreme je dostupno u zavisnosti od nivoa vozila na koje se montira."

msgid "tip192"
msgstr "Za nivo VI i gore, montiranje standardne opreme u slot odgovarajuće kategorije pruža poboljšan bonus. Montiranje u drugi slot pruža standardni bonus."

msgid "tip193"
msgstr "Konfiguracija vozila ne utiče na maksimalnu brzinu. Može biti poboljšana montiranjem odgovarajuće opreme, kupovinom modifikacija ili treniranjem posade za odgovarajuće veštine."

msgid "tip194"
msgstr "Poljske modifikacije ti dozvoljavaju da podesiš svoje vozilo kako odgovara tvom stilu igre."

msgid "tip195"
msgstr "Poljske modifikacije otključavaju alternativnu konfiguraciju za vozilo. Odabir odgovarajuće konfiguracije će ti dati prednost u nadolazećoj borbi."

msgid "tip196"
msgstr "Upotrebi Ctrl+1 i Ctrl +2 prečice za promenu između osnovnog i pomoćnog tovara."

msgid "tip197"
msgstr "Nakon dostizanja određenog nivoa poljske modifikacije možeš da dodeliš kategoriju drugom slotu za opremu."

msgid "tip198"
msgstr "Poljska modifikacija je dostupna za vozila VI-X nivoa koja imaju elitni status. Modifikacije postaju dosupne odmah nakon kupovine za specijalna, nagradna, poklon i premijum vozila."

msgid "tip199"
msgstr "Izgled stabla modifikacije zavisi direktno od uloge i tipa vozila."

msgid "tip200"
msgstr "Dozvoljava delimično održanje pokretljivosti kada je glavna gusenica uništena."

msgid "tip200Status"
msgstr "Rezervna gusenica"

msgid "tip201"
msgstr "Dozvoljava delimično održanje pokretljivosti kada je glavna gusenica uništena."

msgid "tip202"
msgstr "Upotreba mlaznih bustera povećava pokretljivost vozila. Dozvoljava ti da zauzmeš pozicije koje daju prednost ili da pređeš opasna područja brže."

msgid "tip202Status"
msgstr "Vozila sa mlaznim busterima"

msgid "tip203"
msgstr "Pritisni TAB ili B tastere da aktiviraš lične rezerve"

msgid "tip204"
msgstr "Ako se top ohladio dovoljno nakon pucanja njegovo rasipanje će biti smanjeno. Drugi krug nišanjenja sa smanjenim prečnikom će se pojaviti što će odrediti oblast udara. Ovaj efekat traje dok sledeći hitac nije ispaljen."

msgid "tip204Status"
msgstr "Duplo nišanjenje"

msgid "tip205"
msgstr "Tip automatskog vatrenog oružija sa veoma visokom brzinom vatre. Efikasnost pucanja je pokazana indikatorom u nišanskom krugu."

msgid "tip205Status"
msgstr "Autotop"

msgid "tip206"
msgstr "Članovi posade mogu da istreniraju maksimum šest veština glavne kvalifikacije."

msgid "tip207"
msgstr "Članovi posade sa višestrukim kvalifikacijama mogu da iztreniraju bonus veštine iz svojih dodatnih kvalifikacija. Ove bonus veštine ne sadrže iskustvo i ne računaju se ka limitu veština."

msgid "tip208"
msgstr "Ako nekoliko članova posade ima istu kvalifikaciju, efekat svih njihovih veština se računa kao prosek. Za veštinu da radi na 100% potrebno je da bude iztrenirana potpuno od strane svih članova posade iste kvalifikacije."

msgid "tip209"
msgstr "Nakon dostizanja limita od šest veština, članovi posade će nastaviti da zarađuju iskustvo, koje će biti pretvoreno u univerzalne vodiče za upotrebu na drugim posadama."

msgid "tip210"
msgstr "Ovo vozilo je opremljeno sistemom topa koji dozvoljava odabir različitih režima vatre u zavisnosti od situacije na bojištu"

msgid "tip210Status"
msgstr "Vozila sa selektivnim režimom vatre"

msgid "tip211"
msgstr "Upotreba mlaznih bustera povećava pokretljivost vozila. Dozvoljava ti da zauzmeš pozicije koje daju prednost ili da pređeš opasna područja brže."

msgid "tip211Status"
msgstr "Vozila sa mlaznim busterima"

msgid "tip23"
msgstr "Laka vozila sa slabim oklopom mogu biti unštena sudaranjem."

msgid "tip25"
msgstr "Koristi fugasne granate za uništenje modula i članova posade neprijateljskih vozila."

msgid "tip28"
msgstr "Fugasne granate su najefektivnije protiv slabo oklopljenih i otvorenih vozila."

msgid "tip29"
msgstr "Da bi zaustavio neprijatlejsko vozilo i učinio ga lakom metom, pogodi ga u gusenice."

msgid "tip30"
msgstr "Nizak profil čini vozilo težim za uočavanje, naročito u žbunju."

msgid "tip31"
msgstr "Probaj da koristiš druge tipove granata ako ne možeš da naneseš štetu neprijatelju izabranom granatom."

msgid "tip32"
msgstr "Bonus efikasnosti posade dozvoljava odlikama posade da budu poboljšane još više, povećavajući osnovne karakteristike vozila u kome ulaze u borbu."

msgid "tip33"
msgstr "Vozilo koje miruje je teže uočiti nego vozilo u pokretu."

msgid "tip36"
msgstr "U bliskoj borbi, artiljerija može uništiti neprijateljsko vozilo direktnom vatrom."

msgid "tip37"
msgstr "Neprijateljska artiljerija može otkriti tvoju poziciju ako uništavaš ograde i druge strukture."

msgid "tip39"
msgstr "Uvek ima smisla koncentrisati vatru."

msgid "tip41"
msgstr "Da otkriješ neprijateljska vozila, prati putanju tragova granata."

msgid "tip42"
msgstr "Što je više vozila unutar kruga neprijateljske baze, brže će baza biti zauzeta. Najbrže zauzimanje se vrši sa tri vozila."

msgid "tip43"
msgstr "Ako nijedan tim ne ostvari prednost u režimu Napada, tim koji se brani pobedjuje kada vreme istekne."

msgid "tip44"
msgstr "Izbegavaj neprijateljske granate prilikom zauzimanja baze. Zauzimanje baze se prekida kada je tvoje vozilo oštećeno."

msgid "tip45"
msgstr "Tip vešanja, snaga motora i ukupna težina montiranih modula utiču na manevrisanje. Može bit nadogradjeno montiranjem odgovarajuće opreme."

msgid "tip47"
msgstr "Zgrade i uništena vozila mogu da blokiraju neprijateljsku vatru. Drveđe i žbunje te mogu sakriti, ali neće blokirati nadolazeće granate."

msgid "tip48"
msgstr "Klik na paket za opravku da opraviš oštećeni modul."

msgid "tip49"
msgstr "Kada je uništen, top nemože da puca. Koristi paket za opravku da bi se funkcionalnost topa povratila."

msgid "tip50"
msgstr "Oštećenje police municije može dovesti do dužeg punjenja, ili u nekim slučajevima instant ekspolozije."

msgid "tip56"
msgstr "Premijum nalog pruža 50% više iskustva i kredita nakon svake borbe."

msgid "tip57"
msgstr "Možeš da iskoristiš slobodno iskustvo za izučavanje bilo kog vozila, modula ili modifikacije."

msgid "tip58"
msgstr "Kada izučavaš module, modifikacije i vozila, borbeno iskustvo se troši prvo, a slobodno iskustvo tek za njim."

msgid "tip6"
msgstr "Vozila različitog tipa često zahtevaju različitu taktiku."

msgid "tip60"
msgstr "Krediti i iskustvo se dodeljuju za otkrivanje, oštećivanje i uništavanje neporijateljskih vozila; za zauzimanje ili odbranu baze, itd."

msgid "tip62"
msgstr "Tvoji hici mogu da smanje poene izdržljivosti neprijateljskog vozila, da oštete ili unište module ili da povrede članove posade."

msgid "tip65"
msgstr "Koristi nepravilnosti u terenu jer ti to može pružiti zaklon od otkrivanja i direktne neprijateljske vatre."

msgid "tip66"
msgstr "Dobro koordinisan tim je pobednički tim."

msgid "tip67"
msgstr "Ako ti ponestaje mesta u garaži, razmisli o prodaji jednog od vozila ili o kupovini novog garažnog mesta."

msgid "tip68"
msgstr "U depou možeš prodavati vozila, module, potrošni materijal, opremu ili municiju koja ti ne treba."

msgid "tip69"
msgstr "Ako te neko pita za tvoju šifru, u pitanju je prevara. Administratorima tvoja šifra nikada neće biti potrebna iz bilo kog razloga. Uvek drži svoju šifru samo za sebe."

msgid "tip70"
msgstr "Premijum vozila su jeftina za popravku."

msgid "tip71"
msgstr "Ne pucaj na svoje saveznike!"

msgid "tip75"
msgstr "Okretanje kupole i trupa smanjuje preciznost vatre, zbog toga nakon manevrisanja sačekaj da se nišan skupi oko mete pre pucanja."

msgid "tip77"
msgstr "Snaga motora, težina vozila i tip terena utiču na ubrzanje. Može biti poboljšano montiranjem odgovarajuće opreme ili upotrebom potrošne robe, modifikacija i veština posade."

msgid "tip78"
msgstr "Moduli vešanja imaju različitu brzinu okretanja i sposobnosti gaza."

msgid "tip79"
msgstr "Efikasno udaranje tenkom u tenk je određeno odnosom težine, brzine i debljine oklopa vozila."

msgid "tip81"
msgstr "Brzina kojom se nišan skuplja oko mete je određen veštinom nišandžije, određenom opremom i potrošnom robom."

msgid "tip83"
msgstr "Automatsko nišanjenje se isključuje ako je pražena meta uništena ili izgubljena."

msgid "tip84"
msgstr "Uništeno vozilo je zaključano i ostaje neraspoloživo u garaži sve do kraja borbe."

msgid "tip85"
msgstr "U bitku možeš da uđeš samo sa kompletnom posadom i potpuno ispravnim vozilom."

msgid "tip86"
msgstr "Možeš uključiti opciju automatske dopune i automatske opravke za svoje vozilo."

msgid "tip87"
msgstr "Kosi oklop povećava šanse za rikošet i pogodak bez penetracije."

msgid "tip88"
msgstr "Članovi posade koji nisu istrenirani za određeno vozilo ne mogu da koriste svoje odlike prilikom borbe u njemu."

msgid "tip89"
msgstr "Možeš da prebaciš članove posade u drugo vozilo ili da ih pošalješ u barake."

msgid "tip9"
msgstr "Kada osetiš opasnost, premesti svoju artiljeriju - duže ćeš živeti."

msgid "tip91"
msgstr "Ne možeš započeti borbu sa nekompletnom posadom."

msgid "tip92"
msgstr "Brzina treninga tvoje posade zavisi direktno od njihovog uspeha u borbi."

msgid "tip93"
msgstr "Komandir daje bonus na efikasnost svih ostalih članova posade. Efikasnost posade takođe može biti povećana upotrebom određenih odlika posade, nekom opremom ili potrošnim materijalom."

msgid "tip95"
msgstr "Svo borbeno iskustvo zarađeno uz uključen ubrzani trening posade ide najmanje iskusnom članu posade."

msgid "tip98"
msgstr "Lista dostupne opreme zavisi od nivoa, tipa i dizajna svakog vozila."

msgid "tip99"
msgstr "Sva oprema može biti skinuta i premeštena na druga vozila."

msgid "usefulFeatures"
msgstr "Korisne opcije"

msgid "wheeledVehicles"
msgstr "Vozila sa točkovia su jedna od najdinamilčnijih u igri"

msgid "winback1"
msgstr "Možeš da izađeš iz režima zagrevanja u meniju odabira režima na podešavanju nasumičnih borbi."

msgid "winback1Status"
msgstr "Obrati pažnju"
