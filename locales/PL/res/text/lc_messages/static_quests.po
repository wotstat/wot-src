msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Rozpocznij bitwę losową w pojeździe dowolnego poziomu."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Witaj w grze! Teraz możesz toczyć bitwy z innymi fanami czołgów z całego świata i świętować spektakularne zwycięstwa!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Pierwsza bitwa"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Zbadaj i kup dowolny pojazd IV poziomu."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Zakup nowego pojazdu to ważny moment. Z każdym kolejnym poziomem pojazdy stają się ciekawsze. Wyszkolona załoga również poprawia ogólną rozgrywkę."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Pojazd IV poziomu"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Stocz trzy bitwy losowe pojazdami IV–X poziomu z zastosowanym dowolnym elementem personalizującym."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Możesz personalizować pojazdy, zmieniając ich wygląd zewnętrzny stylami domyślnymi lub tworząc swój własny styl z kamuflażu, napisów, emblematów i naklejek."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Wygląd pojazdu"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Rozpocznij szkolenie nowego atutu u dowolnego członka załogi."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Załoganci mogą wyszkolić dodatkowe atuty, by poprawić swoją skuteczność lub zdobyć nowe umiejętności."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Atuty załogi"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Zdobądź 150 000 kredytów w bitwach losowych pojazdami IV–X poziomu."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Im wyższy poziom bitwy, tym więcej kredytów jest potrzebne do obsługi pojazdu, uzupełnienia amunicji i zakupu nowych modułów i wyposażenia."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Zbieranie kredytów"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Zbadaj i kup dowolny pojazd V poziomu."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Na poziomie V zaczynają pojawiać się mocniejsze pojazdy, a Twoje umiejętności zaczynają być weryfikowane. W pełni wyszkolona załoga okaże się bardzo pomocna."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Pojazd V poziomu"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami V–X poziomu z zamontowanymi trzema elementami wyposażenia."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Powłoka antyrefleksyjna czy ulepszona wentylacja? Odpowiednie wyposażenie może wzmocnić mocne strony pojazdu i zredukować jego słabości."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Instalowanie wyposażenia"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Ukończ jeden podstawowy scenariusz w trybie Topografia."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Aby czuć się pewnie na polu bitwy, najlepiej jest mieć rozeznanie w terenie, taktyce i mapach, a także znać pozycje kluczowe i obiekty na nich rozmieszczone."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografia"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Ukończ cztery zaawansowane scenariusze na jednej mapie w Topografii."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Od czasu do czasu wejdź do trybu Topografia, by poznać mapy do bitew losowych. Cztery scenariusze pozwolą Ci zbadać miejsce w różnych aspektach."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Zaawansowana topografia"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami V–X poziomu z aktywowaną rezerwą osobistą."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Po ich aktywacji możesz po każdej bitwie uzyskać dodatkowe premie do PD bojowego, wolnych PD i PD załogi lub kredytów."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Rezerwy osobiste"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Znajdź się sześć razy wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD w zwycięskich bitwach losowych stoczonych pojazdami V–X poziomu."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Te misje pozwalają zdobyć pięć razy więcej PD za udaną bitwę. Trzeba w tym celu wygrać i być wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 misji 5× PD"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Zbadaj moduł i zamontuj go na pojeździe dowolnego poziomu."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Punkty doświadczenia bojowego przyznawane są po każdej bitwie. Zdobywaj PD bojowego, by badać nowe moduły, które poprawiają skuteczność Twojego pojazdu."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "PD bojowego"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Zbadaj i kup dowolny pojazd VI poziomu."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Na każdym kolejnym poziomie badanie pojazdów wymaga więcej czasu i wysiłku. Wolne PD pomogą Ci szybciej awansować, a wyszkolona załoga na pewno się przyda."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Pojazd VI poziomu"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Wypełnij jedną misję osobistą w dowolnej kampanii."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanie to sekwencje misji dla różnych rodzajów pojazdów. Po ich ukończeniu możesz otrzymać pożyteczne nagrody i unikalne pojazdy."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Misje osobiste"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Wyszkol załogę, używając podręcznika dla załogi."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Podręczniki dla załogi pozwalają znacząco przyspieszyć szkolenie załogi, dodając określoną liczbę PD jednemu lub wszystkim załogantom."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Podręczniki dla załogi"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami VI–X poziomu z dyrektywą załogi."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Dyrektywy mogą poprawić atuty załogi na jedną bitwę. Tak jak materiały eksploatacyjne, można je kupić lub otrzymać jako nagrodę."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Dyrektywy dla załogi"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Kup w Sklepie w grze specjalny Zestaw żółtodzioba."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "W Sklepie w grze możesz kupić wszystko, czego potrzebujesz, w tym złoto, pojazdy premium i nie tylko. Znajdziesz tu regularne promocje ze świetnymi ofertami."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Sklep"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami premium VI–X poziomu."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Tych pojazdów nie trzeba badać. Zdobywają więcej PD bojowego, PD załogi i kredytów, a także pozwalają na przeniesienie załogi bez potrzeby przeszkalania."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Pojazdy premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami VI–X poziomu z zamontowaną dyrektywą dla wyposażenia."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Dyrektywy pozwalają zwiększyć skuteczność zamontowanego wyposażenia. Podobnie jak materiały eksploatacyjne, dyrektywy można kupić lub otrzymać jako nagrodę."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Dyrektywa dla wyposażenia"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Znajdź się piętnaście razy wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD w bitwach losowych stoczonych pojazdami VI–X poziomu."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Te misje pozwalają zdobyć pięć razy więcej PD za udaną bitwę. Trzeba w tym celu wygrać i być wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 misji 5× PD"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Zbadaj i kup dowolny pojazd VII poziomu."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Na tym poziomie pojazdów wymagania dotyczące umiejętności rosną jeszcze bardziej. Pojazdy stają się potężniejsze i skuteczniejsze – tak jak przeciwnicy."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Pojazd VII poziomu"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Stocz 10 bitew losowych pojazdami VII–X poziomu wyposażonymi w dużą apteczkę, duży zestaw naprawczy i automatyczny system gaśniczy."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Kiedy są wyposażone, duże materiały eksploatacyjne naprawiają uszkodzone moduły szybciej niż małe. Zmniejszają również czas trwania ogłuszenia i ryzyko pożaru, a także mają krótszy czas przygotowania."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Duże materiały eksploatacyjne"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Otrzymaj podwójne PD za pierwsze zwycięstwo dnia w bitwie losowej w pojeździe dowolnego poziomu."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Możesz otrzymać podwójne PD za swoje pierwsze zwycięstwo dnia w każdym pojeździe. Wykorzystaj tę możliwość, by jeszcze szybciej ulepszać pojazdy."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Bonus do PD"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Stwórz fragment schematu dla dowolnego niezbadanego pojazdu."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Schematy dają zniżkę w PD i pozwalają przyspieszyć badanie pojazdu. Można je zdobyć jako nagrodę lub przez konwersję z fragmentów uniwersalnych i narodowych."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Schematy pojazdu"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Znajdź się 20 razy wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD w bitwach losowych stoczonych pojazdami VII–X poziomu."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Te misje pozwalają zdobyć pięć razy więcej PD za udaną bitwę. Trzeba w tym celu wygrać i być wśród 10 najlepszych graczy swojej drużyny pod względem zdobytych PD."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 misji 5× PD"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Zbadaj i kup dowolny pojazd VIII poziomu."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Pojazdy VIII poziomu wymagają wykorzystania całej zgromadzonej dotychczas wiedzy. Przeciwnicy nie pozwolą Ci się nudzić, zapewniając wysokooktanowe emocje i bezcenne doświadczenia."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Pojazd VIII poziomu"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Użyj wolnych PD, by zbadać dowolny moduł."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Jeśli nie masz wystarczająco dużo PD bojowego, by zbadać moduł lub pojazd, możesz użyć wolnych PD, które zdobywa się w każdym pojeździe."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Wolne PD"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Załaduj alternatywną amunicję i rozpocznij bitwę losową w pojeździe III–X poziomu."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Pociski przeciwpancerne, odłamkowo-burzące i pełnokalibrowe z rdzeniem wykorzystuje się w bitwie w różnych sytuacjach. Wybieraj mądrze, by zdobyć przewagę!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Amunicja"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Sprzedaj nieużywany moduł z magazynu."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Nieużywane moduły, pociski, wyposażenie, materiały eksploatacyjne i inne przedmioty zostają umieszczone w magazynie. Nadmiar przedmiotów możesz sprzedać za kredyty."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Magazyn"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Zdobądź 25 000 kredytów w bitwach losowych pojazdami III–X poziomu."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Kredyty wykorzystywane są do kupna pocisków i nowych pojazdów, a także do naprawy pojazdów i nie tylko. Ważna jest wiedza, jak je oszczędzać i mądrze wydawać."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Kredyty"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Stocz trzy bitwy losowe pojazdami III–X poziomu z materiałami eksploatacyjnymi umieszczonymi we wszystkich dostępnych miejscach."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Materiały eksploatacyjne mogą naprawić uszkodzone moduły lub uleczyć członków załogi. Ich użycie w odpowiednim momencie może być kluczowe dla przetrwania w bitwie."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Materiały eksploatacyjne"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Stocz trzy bitwy losowe pojazdami III–X poziomu z zamontowanym dowolnym wyposażeniem."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "W pojazdach można zamontować wyposażenie, by poprawić niektóre z ich charakterystyk. Skład wyposażenia będzie zależał od pojazdu i stylu gry."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Wyposażenie"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Ukończ jeden scenariusz na dowolnej mapie w trybie Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Ukończ cztery podstawowe scenariusze na jednej mapie w trybie Topografia"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Zwiad"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Ukończ cztery zaawansowane scenariusze na jednej mapie w trybie Topografia"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Szóstka z geografii"
