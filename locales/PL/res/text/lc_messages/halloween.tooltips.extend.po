msgid "Contact/status/inBattle/halloween"
msgstr "W bitwie trybu Babilon: Mroczna Wieża"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Wystrzeliwuje pocisk, który uszkadza i ogłusza cel oraz wszystkie pojazdy przeciwnika w promieniu 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Wystrzeliwuje pocisk, który przywraca punkty wytrzymałości, kradnąc je celowi i pobliskim pojazdom przeciwnika w promieniu 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Wystrzeliwuje pocisk, który ogłusza cel i wszystkie pojazdy przeciwnika w promieniu 35 m."

msgid "advanced/hw_damageShield"
msgstr "Chroni przed wszelkimi uszkodzeniami (z wyjątkiem taranowania, utonięcia i upadku) przez 7 sekund."

msgid "advanced/hw_fastReload"
msgstr "Zwiększa szybkostrzelność / przeładowuje magazynek."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Przywraca punkty wytrzymałości, gasi pożar, usuwa efekt ogłuszenia i naprawia uszkodzone moduły."

msgid "advanced/hw_invisibility"
msgstr "Tymczasowo czyni pojazd niewidzialnym dla przeciwników, przywraca punkty wytrzymałości, naprawia moduły, gasi pożar, usuwa efekt ogłuszenia i leczy wszystkich rannych członków załogi."

msgid "advanced/hw_teamRepairKit"
msgstr "Naprawia uszkodzone moduły, gasi pożar, usuwa efekt ogłuszenia i przywraca trochę punktów wytrzymałości pojazdów sojuszników w swoim promieniu."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Zdolności bojowe pozwalają skuteczniej walczyć w bitwach trybu Babilon: Mroczna Wieża, osiągać cele i zdobywać cenne nagrody. Aby je wyposażyć, kliknij jedno z miejsc na zdolności bojowe."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Miejsca na zdolności bojowe"

msgid "hwShell/alt/description"
msgstr "%(bold)s można znaleźć w bitwie z określonym prawdopodobieństwem po zniszczeniu przeciwnika."

msgid "hwShell/alt/description/bold"
msgstr "Alternatywny pocisk"
