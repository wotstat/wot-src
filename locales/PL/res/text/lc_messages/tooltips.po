msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "Dopuszczalna liczba użyć dopalaczy w jednej bitwie."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Czas przygotowania, po którym dopalacze mogą być ponownie aktywowane."

msgid "tank_params/desc/stagedJetBoostersEnginePower"
msgstr "Premia do przyspieszenia pojazdu z aktywnymi dopalaczami."

msgid "tank_params/desc/stagedJetBoostersRotationSpeed"
msgstr "Premia do prędkości obrotu pojazdu z aktywnymi dopalaczami."

msgid "tank_params/desc/stagedJetBoostersSpeedLimits"
msgstr "Prędkość pojazdu w formie zdefiniowanej w jego charakterystykach technicznych."

msgid "tank_params/desc/stagedJetBoostersTopSpeed"
msgstr "Premia do prędkości maksymalnej pojazdu z aktywnymi dopalaczami."

msgid "tank_params/desc/stationaryReloadSwitchOffTime"
msgstr "Czas do odblokowania wieży i ponownego umożliwienia prowadzenia ostrzału po przerwaniu procesu przeładowania."

msgid "tank_params/desc/stationaryReloadSwitchOnTime"
msgstr "Czas do połączenia wieży z zewnętrznymi zasobnikami amunicji i rozpoczęcia procesu przeładowania."

msgid "tank_params/desc/stunMaxDuration"
msgstr "Pokazuje maksymalny czas ogłuszenia załogi pojazdu przeciwnika, jeśli pocisk OB przebije jego pancerz, zadając maksymalne uszkodzenia, a pojazd nie ma żadnego wyposażenia ani materiałów eksploatacyjnych zmniejszających czas ogłuszenia."

msgid "tank_params/desc/stunMinDuration"
msgstr "Wskazuje minimalny czas ogłuszenia załogi pojazdu przeciwnika, jeśli znajdzie się on w promieniu uszkodzeń, a pojazd nie ma żadnego wyposażenia ani materiałów eksploatacyjnych zmniejszających czas ogłuszenia."

msgid "tank_params/desc/switchEngineModeBothModes"
msgstr "Czs przełączania między trybem starcia a trybem turbo."

msgid "tank_params/desc/switchOffTime"
