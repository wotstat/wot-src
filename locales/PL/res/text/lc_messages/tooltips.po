msgid "tank_params/desc/turboSpeedCap"
msgstr "Dodatkowa prędkość zyskiwana przez pojazd w trybie turbo."

msgid "tank_params/desc/turboshaftBurstFireRate"
msgstr "Czas ładowania pomiędzy pociskami w zasobniku. / Liczba zasobników w magazynku. / Liczba pocisków w zasobniku."

msgid "tank_params/desc/turboshaftEnginePower"
