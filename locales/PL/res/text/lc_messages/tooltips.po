msgid "tank_params/desc/twinGunTopSpeed"
msgstr "Nominalna prędkość pojazdu w trybie ognia salwą."

msgid "tank_params/desc/vehicleWeight"
msgstr "Masa decyduje o skuteczności taranowania."

msgid "tank_params/desc/wheeledDashAbilityDuration"
msgstr "Czas trwania efektu mechaniki po aktywacji."

msgid "tank_params/desc/wheeledDashAbilityReloadTime"
msgstr "Czas wymagany przed ponowną aktywacją mechaniki po użyciu."

msgid "tank_params/desc/wheeledDashAbilityReloadTimeBonus"
msgstr "Skrócenie czasu przygotowania mechaniki przyznawane po osiągnięciu progu prędkości."

msgid "tank_params/desc/wheeledDashEnginePower"
msgstr "Zwiększenie mocy silnika przyznawane, gdy mechanika jest aktywna."

msgid "tank_params/desc/wheeledDashReverseSpeed"
msgstr "Bonus do maksymalnej prędkości wstecz zapewniany przez mechanikę."

msgid "tank_params/desc/wheeledDashSpeedLimits"
msgstr "Prędkość, którą pojazd musi osiągnąć, aby skrócić czas przygotowania mechaniki."

msgid "tank_params/desc/wheeledDashTopSpeed"
msgstr "Bonus do maksymalnej prędkości do przodu zapewniany przez mechanikę."

msgid "tank_params/desc/wheeledSpeedModeSpeed"
msgstr "Parametr dla trybu przyspieszonego."

msgid "tank_params/desc/wheeledSwitchOffTime"
