msgid "entryPoint/tooltip/description"
msgstr "Są to specjalne skrzynie zawierające nowe i unikalne przedmioty. Można je nabyć w Sklepie w grze."

msgid "entryPoint/tooltip/timerText"
msgstr "Wydarzenie zakończy się za"

msgid "eventName/lowerCase"
msgstr "Skarbiec szeptów"

msgid "eventName/upperCase"
msgstr "SKARBIEC SZEPTÓW"

msgid "guaranteed/tooltip/description1/"
msgstr "Jeśli już masz wszystkie pojazdy, zamiast tego otrzymasz hojną skrzynię z łupami."

msgid "infoPage/footer/description/compensation"
msgstr "Jeśli masz już wszystkie pojazdy ze skrzyń, jako nagrodę zamiast pojazdu otrzymasz hojną skrzynię z łupami."

msgid "infoPage/footer/description/guaranteed"
msgstr "Każde %(guaranteed0)s hojnych, %(guaranteed1)s łaskawych i %(guaranteed2)s darzących skrzyń z łupami na pewno zawiera pojazd. Jeśli je otworzysz, a pojazd się nie pojawi, to pojazd, którego jeszcze nie masz, pojawi się przy otwarciu %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. skrzyni (zależnie od jej rodzaju). Wtedy licznik zostanie zresetowany."

msgid "infoPage/footer/title/compensation"
msgstr "Rekompensata"

msgid "infoPage/footer/title/guaranteed"
msgstr "Nagroda gwarantowana"

msgid "infoPage/header/rewards/description"
msgstr "Z każdej grupy może zostać wylosowana co najwyżej jedna nagroda"
