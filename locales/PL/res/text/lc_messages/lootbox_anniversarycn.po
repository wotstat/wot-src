msgid "#PluralForms"
msgstr "nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"

msgid "boxTooltip/description/text/bronze"
msgstr "Po otwarciu, z tych skrzyń można otrzymać pojazdy, waluty w grze i inne cenne nagrody."

msgid "boxTooltip/description/text/gold"
msgstr "Po otwarciu, z tych skrzyń można otrzymać pojazdy, waluty w grze, elementy personalizacji i inne cenne nagrody."

msgid "boxTooltip/description/text/silver"
msgstr "Po otwarciu, z tych skrzyń można otrzymać pojazdy, waluty w grze, elementy personalizacji i inne cenne nagrody."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Można je nabyć w Sklepie w grze i otrzymać przy otwieraniu skrzyń dowolnego innego rodzaju."

msgid "boxTooltip/howGet/text/gold"
msgstr "Można otrzymać przy otwieraniu skrzyń dowolnego innego rodzaju."

msgid "boxTooltip/howGet/text/silver"
msgstr "Można otrzymać przy otwieraniu skrzyń dowolnego innego rodzaju."

