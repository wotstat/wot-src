msgid "Contact/status/inBattle/last_stand"
msgstr "W bitwie Ostatniego bastionu"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Wystrzeliwuje pocisk, który uszkadza cel i wszystkie pojazdy przeciwnika w promieniu 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Wystrzeliwuje pocisk, który przywraca punkty wytrzymałości, kradnąc je celowi i pobliskim pojazdom przeciwnika w promieniu 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Wystrzeliwuje pocisk, który ogłusza cel i wszystkie pojazdy przeciwnika w promieniu 35 m."

msgid "advanced/ls_damageShield"
msgstr "Chroni przed wszelkimi uszkodzeniami (z wyjątkiem taranowania, utonięcia i upadku) przez 10 sekund."

msgid "advanced/ls_doubleDamage"
msgstr "Następny udany strzał zada podwójne uszkodzenia."

msgid "advanced/ls_equipment"
msgstr "Urządzenia taktyczne pozwalają skuteczniej walczyć w bitwach Ostatniego bastionu, wypełniać etapy i zdobywać cenne nagrody. Aby je wyposażyć, kliknij jedno z miejsc na urządzenia taktyczne."

msgid "advanced/ls_extraDamageSituational"
msgstr "Daje szansę zadania zwiększonych uszkodzeń pojazdowi przeciwnika."

msgid "advanced/ls_fastReload"
msgstr "Zwiększa szybkostrzelność / przeładowuje magazynek."

msgid "advanced/ls_healSituational"
msgstr "Przywraca część punktów wytrzymałości po zniszczeniu pojazdu przeciwnika."

msgid "advanced/ls_invisibility"
msgstr "Tymczasowo uniemożliwia przeciwnikom celowanie w Twój pojazd, przywraca punkty wytrzymałości, naprawia moduły, gasi pożar, usuwa efekt ogłuszenia i leczy wszystkich rannych członków załogi."

msgid "advanced/ls_nitro"
msgstr "Tymczasowo zwiększa mobilność pojazdu."

msgid "advanced/ls_nitroSituational"
msgstr "Chwilowo podnosi mobilność Twojego pojazdu po tym, jak przyjął uszkodzenia od pojazdu przeciwnika."

msgid "advanced/ls_selfRepairKit"
msgstr "Przywraca punkty wytrzymałości, gasi pożar, usuwa efekt ogłuszenia i naprawia uszkodzone moduły."

msgid "advanced/ls_teamRepairKit"
msgstr "Naprawia uszkodzone moduły, gasi pożar, usuwa efekt ogłuszenia i przywraca trochę punktów wytrzymałości pojazdów sojuszników w swoim promieniu."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Urządzenia taktyczne można wyposażyć w specjalnych miejscach, dzięki czemu pomogą walczyć skuteczniej w bitwach Ostatniego bastionu, wypełniać etapy i zdobywać cenne nagrody."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Miejsca na urządzenia taktyczne"
