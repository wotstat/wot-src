msgid "battleship/name"
msgstr "Sygnał dymny"

msgid "battleship/shortDescr"
msgstr "Sygnał dymny oznaczający obszar dla salwy artyleryjskiej pancernika, która zadaje uszkodzenia znajdującym się tam obiektom i wyposażeniu przeciwnika."

msgid "distraction_ability/name"
msgstr "Fałszywy rozkaz"

msgid "distraction_ability/shortDescr"
msgstr "Niech Gefr. Keller użyje zdobycznego niemieckiego radia, aby nadać fałszywy rozkaz i skierować przeciwnika do zbadania wyznaczonego miejsca."

msgid "recon_ability/name"
msgstr "Zbadanie okolicy"

msgid "recon_ability/shortDescr"
msgstr "Wyślij kpt. Dubois na rekonesans w wyznaczonym miejscu. Podczas zwiadu czołg zatrzymuje się i pozostaje w bezruchu. Zdolność działa do momentu anulowania."

msgid "scc_airstrike_ability/name"
msgstr "Wsparcie lotnicze"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Wezwij nalot na wyznaczoną pozycję."
