msgid "PzVIB_Tiger_II_IGR"
msgstr "Tiger II"

msgid "PzVIB_Tiger_II_IGR_descr"
msgstr "Znany jako \"Tygrys Królewski\". Od stycznia 1944 do marca 1945 wyprodukowano 489 czołgów."

msgid "PzVIB_Tiger_II_IGR_short"
