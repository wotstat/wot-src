msgstr "Pojazd {{level}} poziomu"

msgid "selectableRewardTooltip/discount/description"
msgstr "Zniżka {{researchDiscount}} na badanie i zniżka {{purchaseDiscount}} na zakup pojazdu {{level}} poziomu. Można wybrać dowolny pojazd możliwy do zbadania."

msgid "selectableRewardTooltip/discount/footer"
msgstr "Zniżka na {{@ style (color $color)}}badanie{{/}} jest dodawana do zniżki z fragmentów schematów. Stosowana jest największa dostępna zniżka na {{@ style (color $color)}}zakup{{/}}."

