msgstr "BOSKIE BŁOGOSŁAWIEŃSTWO"

msgid "guaranteed/tooltip/description1/"
msgstr "Jeśli już masz wszystkie pojazdy, zamiast tego otrzymasz wybraną skrzynię z łupami."

msgid "infoPage/footer/description/compensation"
msgstr "Jeśli masz już wszystkie pojazdy ze skrzyń, jako nagrodę zamiast pojazdu otrzymasz wybraną skrzynię z łupami."

msgid "infoPage/footer/description/guaranteed"
msgstr "Każde %(guaranteed0)s niebiańskich, %(guaranteed1)s niebiańskiej pomocy i %(guaranteed2)s wybranych skrzyń z łupami na pewno zawiera pojazd. Jeśli otworzysz je, a pojazd się nie pojawi, to pojazd, którego jeszcze nie masz, pojawi się przy otwarciu %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. skrzyni (zależnie od jej rodzaju). Wtedy licznik zostanie zresetowany."

msgid "infoPage/footer/title/compensation"
msgstr "Rekompensata"

msgid "infoPage/footer/title/guaranteed"
msgstr "Nagroda gwarantowana"

