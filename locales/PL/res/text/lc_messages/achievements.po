msgid "medalRotmistrov_heroInfo"
msgstr "Paweł Rotmistrow, bohater Związku Radzieckiego, był dowódcą wojsk pancernych podczas II WŚ. W późniejszym okresie został marszałkiem wojsk pancernych Z.S.R.R."

msgid "medalStark"
msgstr "Medal Starka"

msgid "medalStark_condition"
