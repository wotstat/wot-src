msgstr "Zniszcz pojazdy przeciwnika:"

msgid "medalRadleyWalters_ext_descr"
msgstr "    %(condition)s — Wielka bitwa."

msgid "medalRadleyWalters_heroInfo"
msgstr "Sydney Valpy Radley-Walters był kanadyjskim asem pancernym, który służył w 27 Pułku Pancernym. W latach 1944-1945 zniszczył 18 niemieckich pojazdów przy użyciu swojego czołgu typu Sherman Firefly."

msgid "medalRadleyWalters_standard_descr"
msgstr "    %(condition)s — Bitwa standardowa, spotkaniowa lub szturm."

msgid "medalRotmistrov"
