msgid "LS_nitroSituational/onUse"
msgstr "Chwilowo <font color='#feab34'>podnosi</font> <font color='#feab34'>mobilność</font> Twojego pojazdu po otrzymaniu uszkodzeń od pojazdu przeciwnika.\nSzansa aktywacji: <font color='#e9e2bf'>50%</font>."

