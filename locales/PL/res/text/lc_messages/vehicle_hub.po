msgstr "Automatyczne ładowanie"

msgid "abilities/common/name/overheatGun"
msgstr "Działko automatyczne z kontrolą przegrzania"

msgid "abilities/common/name/rocketAcceleration"
msgstr "Dopalacze odrzutowe"

