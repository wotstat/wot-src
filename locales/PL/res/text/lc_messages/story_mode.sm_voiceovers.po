msgid "vo_sm_char08_m05_stg01_13"
msgstr "Pilot Spitfire’a: Słaba widoczność, nie mogę zapewnić wsparcia!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Pilot Spitfire’a: Za dużo ognia przeciwlotniczego, nie mogę zapewnić wsparcia!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Pilot Spitfire’a: Ciężki ogień przeciwlotniczy, nie ma możliwości korekty ognia."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Pilot Spitfire’a: Ech, mamy tu u góry prawdziwe gradobicie."

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Pilot Spitfire’a: Nie możemy skorygować ognia okrętu pod tym ostrzałem."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Pilot Spitfire’a: Musicie unieszkodliwić te działa przeciwlotnicze obok bunkrów."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Pilot Spitfire’a: Udało mi się zejść niżej."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Pilot Spitfire’a: Teraz mogę zacząć kierować ostrzałem z dużych dział za pomocą naziemnych sygnałów dymnych."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Pilot Spitfire’a: Czołgi, wasz ruch!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Pilot Spitfire’a: Zauważyłem dym."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Pilot Spitfire’a: Przekazuję współrzędne do pancernika w celu bezpośredniego trafienia."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Pilot Spitfire’a: Cholera, jeden z naszych spadł! Wciąż nie mogę zejść niżej."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Pilot Spitfire’a: Musimy zlikwidować następne działo przeciwlotnicze!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Pilot Spitfire’a: Działa przeciwlotnicze zniszczone, schodzę niżej. Gotowy do skierowania gęstszego ostrzału z naszego pancernika."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Pilot Spitfire’a: Uwaga! Duża grupa przeciwnika poruszającą się w waszą stronę."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Pilot Spitfire’a: Rzucają na nas wszystko, co mają."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Pilot Spitfire’a: Uwaga, zbliża się nowa grupa przeciwnika. Zachowajcie czujność."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Pilot Spitfire’a: Ostrzeżenie, nadciąga ostatnia i największa fala przeciwników."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Pilot Spitfire’a: Zbliżają się ze wszystkich stron. Przygotujcie się."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Pilot Spitfire’a: Mam dobry widok na sygnał dymny. Przesyłam współrzędne do pancernika."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Pilot Spitfire’a: O, tam jest nasz znacznik dymny. Przekazuję położenie do pancernika."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Pilot Spitfire’a: Dym na celu. Przesyłam dokładne położenie do pancernika."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Pilot Spitfire’a: Widzę dym. Wygląda na to, że nasi przyjaciele potrzebują pomocy."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Dowódca USS Frankford: Czekam na współrzędne dla wsparcia ogniowego."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Dowódca USS Frankford: Ostrzał na ślepo jest ryzykowny, moglibyśmy trafić naszych."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Dowódca USS Frankford: Potrzebuję dokładnych celów, wstrzymuję ogień."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Dowódca USS Frankford: Tu dowódca USS Frankford. Odmawiam."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Dowódca USS Frankford: Brak możliwości wsparcia ataku. Zbyt słaba widoczność."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Dowódca USS Frankford: Brak widoczności na klify i bunkry, widzimy tylko nasze czołgi na plaży."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Dowódca USS Frankford: Widać nasze czołgi nacierające na klify."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Dowódca USS Frankford: Zapewnimy wsparcie ogniowe na tym kierunku."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Dowódca USS Frankford: Mam nadzieję, że ten Sherman wie, do czego strzela."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Dowódca USS Frankford: Sherman zmienił cel. Dostosowujemy się do tego."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Dowódca USS Frankford: Sherman wstrzymał ogień. Zadanie wykonane."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Dowódca USS Frankford: Nie możemy sięgnąć bunkrów w głębi lądu."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Dowódca USS Frankford: Wycofujemy się na bezpieczną odległość. Powodzenia na brzegu."

