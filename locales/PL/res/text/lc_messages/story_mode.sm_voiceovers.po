msgid "vo_sm_char10_m05_stg21_02"
msgstr "Oficer sztabu: Przyczółek Echo-5 zabezpieczony. Czołgi posuwają się naprzód. Zapewnić pełne wsparcie ogniowe."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Oficer sztabu: Przekierować wsparcie lotnicze, aby wspomóc atak czołgów."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Oficer sztabu: Zespoły inżynieryjne, usunąć przeszkody do dalszego natarcia."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Oficer sztabu: Plaża jest czysta. Wysyłam główne siły. Świetna robota."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Oficer sztabu: Utrzymać pozycję. Posiłki są w drodze."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Oficer sztabu: Chronić przyczółek za wszelką cenę."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Oficer sztabu: Kolejny czołg, kolejna szansa. Tym razem bądź ostrożny."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Oficer sztabu: Kończą się nam rezerwy. Wykorzystaj go dobrze, dowódco."

