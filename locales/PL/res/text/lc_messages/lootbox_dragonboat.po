msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Skrzynie smoczych łodzi"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "SKRZYNIE SMOCZYCH ŁODZI"

msgid "entryPoint/tooltip/description"
msgstr "Są to specjalne skrzynie zawierające unikalne i cenne przedmioty w grze.\nSkrzynie można otrzymać w Sklepie w grze i Sklepie premium."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Skrzynie smoczych łodzi są tymczasowo niedostępne"

msgid "eventName/lowerCase"
msgstr "Oswój smoka, okiełznaj wiatr"

msgid "eventName/upperCase"
msgstr "OSWÓJ SMOKA, OKIEŁZNAJ WIATR"

msgid "infoPage/footer/description/compensation"
msgstr "Jeśli masz już wszystkie pojazdy z listy możliwej zawartości skrzyń, to za wszystkie kolejne pojazdy otrzymane ze skrzyń smoczych łodzi dostaniesz rekompensatę w złocie w wysokości ich pełnej wartości."

msgid "infoPage/footer/description/guaranteed"
msgstr "Każde %(guaranteed0)s skrzyń smoczych łodzi na pewno zawiera pojazd poziomu VIII–IX. Jeśli je otworzysz, a pojazd się nie pojawi, to pojazd poziomu VIII–IX, którego jeszcze nie masz, pojawi się przy otwarciu %(guaranteed0)s.&zwnbsp; skrzyni smoczych łodzi. Wtedy licznik zostanie zresetowany."

msgid "noBoxesView/description/"
msgstr "Nie masz żadnych skrzyń.\nMożesz je zdobyć w Sklepie w grze."
