msgid "alert"
msgstr "Nie można wybrać rezerwy bojowej w trakcie aktywnej walki."

msgid "description/one/reserve"
msgstr "Częsty wybór rezerwy %(reserve_name)s \npoprawi jej charakterystyki."

msgid "description/second/reserve"
msgstr "Częsty wybór rezerwy %(first_reserve_name)s lub %(second_reserve_name)s\npoprawi charakterystyki tej wybranej."

msgid "number_1"
msgstr "pierwszą"

msgid "number_2"
msgstr "drugą"

msgid "number_3"
msgstr "trzecią"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Na pewien czas rozkłada aktywne pole minowe na wybranym obszarze."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Zadaje znaczne uszkodzenia pojazdom przeciwnika w niewielkim promieniu."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Ogłusza pojazdy przeciwnika i zadaje średnie uszkodzenia na obszarze o dużym promieniu."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Dodaje premię do głównej kwalifikacji załóg gracza i sojuszników."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Zapewnia premię do czasu zajmowania, blokowania zajmowania i odnawiania zapasów."

msgid "shortDescription/reserve/reconAbility"
msgstr "Wykrywa pojazdy przeciwnika i pola minowe."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Przywraca pewien procent punktów wytrzymałości Twojego pojazdu."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Ukrywa wszystkie pojazdy w oraz za obłokiem dymu."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Premia do maskowania i zasięgu widzenia. Zmniejsza maskowanie przeciwnika."

msgid "title"
msgstr "Miejsce na %(number_name)s rezerwę bojową dostępne"
