msgid "hint/LSH_FIRE"
msgstr "Dym utrudnia wykrywanie pojazdów przeciwnika i przekazywanie ich pozycji. Ogień powoduje uszkodzenia pojazdów."

msgid "hint/LSH_FOG"
msgstr "Mgła utrudnia wykrywanie pojazdów przeciwnika i przekazywanie ich pozycji."

msgid "hint/LSH_RAIN"
msgstr "Ulewa utrudnia wykrywanie pojazdów przeciwnika i przekazywanie ich pozycji."

msgid "hint/LSH_SANDSTORM"
msgstr "Burze piaskowe utrudniają wykrywanie pojazdów przeciwnika i przekazywanie ich pozycji."

msgid "hint/LSH_SMOKE"
msgstr "Dym utrudnia wykrywanie pojazdów przeciwnika i przekazywanie ich pozycji."

msgid "hint/PPH_AIMING_01"
msgstr "Ruch pojazdu i wieży zmniejsza <font color='#EE7000'>celność działa</font>."

msgid "hint/PPH_AIMING_02"
msgstr "Okrąg celownika wskazuje <font color='#EE7000'>celność działa</font>. Poczekaj chwilę, by oddać precyzyjny strzał."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "Włączono <font color='#EE7000'>automatyczne celowanie</font>. Kliknij prawym przyciskiem myszy, aby je wyłączyć."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Automatyczne celowanie zawsze naprowadza Twoje działo <font color='#EE7000'>na środek</font> wybranego pojazdu."

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Przeciwnik <font color='#EE7000'>zajmuje</font> Twoją bazę! Jeśli go nie odeprzesz, drużyna przeciwna wygra bitwę."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Każdy pojazd przeciwnika ma <font color='#EE7000'>własny</font> postęp zajmowania."

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Zajęcie</font> bazy przeciwnika to jeden ze sposobów na wygranie bitwy."

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Kiedy otrzymujesz uszkodzenia, Twój postęp zajmowania <font color='#EE7000'>jest zerowany</font>."

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Opuszczenie okręgu bazy powoduje <font color='#EE7000'>utratę </font> postępów w jej zajmowaniu."

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Wiele pojazdów <font color='#EE7000'>szybciej</font> zajmuje bazę."

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Pojazdy powyżej <font color='#EE7000'>trzeciego</font> nie zwiększają szybkości zajmowania bazy."

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Baza przeciwnika jest już prawie zajęta!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Twoja drużyna zwycięża przez zajęcie bazy!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Krytyczne uszkodzenie modułu pojazdu! Użyj <font color='#EE7000'>zestawu naprawczego</font> z dolnego panelu, aby go naprawić."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Krytyczne uszkodzenie modułu pojazdu! Użyj <font color='#EE7000'>zestawu naprawczego</font> z dolnego panelu, aby go naprawić."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Członek załogi zraniony! Użyj <font color='#EE7000'>apteczki</font> z dolnego panelu."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Członek załogi zraniony! Użyj <font color='#EE7000'>apteczki</font> z dolnego panelu, aby go wyleczyć."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Członek załogi ogłuszony! Użyj <font color='#EE7000'>apteczki</font> z dolnego panelu."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Pojazd płonie! Użyj <font color='#EE7000'>gaśnicy</font> z dolnego panelu."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Pojazd płonie! Aktywowano <font color='#EE7000'>automatyczny system gaśniczy</font>."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Krytyczne uszkodzenie modułu pojazdu! Wyposaż pojazd przed bitwą w <font color='#EE7000'>zestaw naprawczy</font>, aby poradzić sobie z trafieniami krytycznymi."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Członek załogi zraniony! Wyposaż pojazd przed bitwą w <font color='#EE7000'>apteczkę</font>, aby zyskać możliwość udzielenia pomocy rannej załodze."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Pojazd płonie! Przed bitwą wyposaż pojazd w <font color='#EE7000'>gaśnicę</font>, aby mieć możliwość ugaszenia pożaru."

msgid "hint/PPH_OTHER_01"
msgstr "Zostałeś <font color='#EE7000'>wykryty</font> – prowadzenie ostrzału może ujawnić Twoją pozycję!"

msgid "hint/PPH_OTHER_02"
msgstr "Twój pojazd został zniszczony. Możesz nacisnąć <font color='#EE7000'>Esc</font>, aby wyjść z bitwy bez ponoszenia kary."

msgid "hint/PPH_OTHER_03"
msgstr "Twój pojazd został zniszczony. Możesz nacisnąć przycisk myszy, aby <font color='#EE7000'>obserwować</font> sojuszników."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Ikona żarówki</font> oznacza, że przeciwnik wykrył Twój pojazd!"

msgid "hint/PPH_OTHER_05"
msgstr "Twoje działo wciąż się <font color='#EE7000'>przeładowuje</font>."

msgid "hint/PPH_OTHER_06"
msgstr "Możesz strzelać z działa jedynie wtedy, gdy okrąg celownika jest <font color='#EE7000'>całkowicie zielony</font>."

msgid "hint/PPH_SNIPER_01"
msgstr "Możesz obrócić kółkiem myszy, aby przejść do <font color='#EE7000'>trybu snajperskiego</font>."

msgid "hint/PPH_SNIPER_02"
msgstr "Możesz obrócić kółkiem myszy, aby <font color='#EE7000'>wyjść</font> z trybu snajperskiego."

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Zielony celownik wewnętrzny</font> oznacza dużą szansę na przebicie pancerza przeciwnika."

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Jednak zielony celownik wewnętrzny <font color='#EE7000'>nie gwarantuje</font> przebicia pancerza."

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Działa nie są stuprocentowo celne, zatem pociski <font color='#EE7000'>nie zawsze trafiają w środek</font> celownika."

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Wewnętrzny celownik wskazuje szansę na przebicie pancerza przeciwnika. <font color='#EE7000'>Włącz go w Ustawieniach</font>."

msgid "penetration/chance/high"
msgstr "Duża szansa"

msgid "penetration/chance/low"
msgstr "Mała szansa"

msgid "penetration/chance/medium"
msgstr "Średnia szansa"
