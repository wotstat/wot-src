msgid "mode/last_stand/battlePassTooltip/body"
msgstr "W trybie {whiteSpanish_open}Ostatni bastion{whiteSpanish_close} można zdobywać punkty Przepustki bitewnej."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Punkty Przepustki bitewnej"

msgid "mode/last_stand/calendar"
msgstr "Wydarzenie potrwa %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "Wydarzenie zakończy się za %(date)s."

msgid "mode/last_stand/description"
msgstr "Walcz z falami przeciwników.\nBitwy w pojazdach VIII poziomu."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Wydajność Twojego komputera nie wystarcza do tego trybu. Możesz zaobserwować problemy z grafiką i ruchem pojazdu. Możliwe są również krytyczne błędy klienta."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Niska wydajność"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Niska wydajność"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Ten tryb wymaga wysokiej wydajności komputera.\nZaobserwujesz problemy z wczytywaniem mapy, grafiką i ruchem pojazdu. W przypadku niewystarczającej wydajności spróbuj obniżyć jakość grafiki w ustawieniach."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Zmniejszona wydajność"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Zmniejszona wydajność"
