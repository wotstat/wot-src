msgid "entryPoint/tooltip/description"
msgstr "Estas são caixas especiais que contêm itens novos e exclusivos, incluindo veículos Premium, estilos 2D e mais. Pode obtê-las na Loja do jogo."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Por motivos técnicos, os Tesouros Ardentes não podem ser abertos ou adquiridos no momento. Pedimos desculpas pelo inconveniente temporário."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Tesouros Ardentes Temporariamente Indisponíveis"

