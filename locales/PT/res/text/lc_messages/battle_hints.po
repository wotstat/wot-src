msgid "hint/LSH_FIRE"
msgstr "O fumo dificulta a deteção de veículos inimigos e a comunicação das suas posições. O fogo provoca dano nos veículos."

msgid "hint/LSH_FOG"
msgstr "O nevoeiro dificulta a deteção de veículos inimigos e a comunicação das suas posições."

msgid "hint/LSH_RAIN"
msgstr "A chuva intensa dificulta a deteção de veículos inimigos e a comunicação das suas posições."

msgid "hint/LSH_SANDSTORM"
msgstr "As tempestades de areia dificultam a deteção de veículos inimigos e a comunicação das suas posições."

msgid "hint/LSH_SMOKE"
msgstr "O fumo dificulta a deteção de veículos inimigos e a comunicação das suas posições."

msgid "hint/PPH_AIMING_01"
msgstr "O movimento do veículo e da torre diminui a <font color='#EE7000'>precisão da arma</font>"

msgid "hint/PPH_AIMING_02"
msgstr "O círculo à volta da retícula indica a <font color='#EE7000'>precisão da arma</font>. Espere um pouco para um tiro mais preciso."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Mira automática</font> ativada.Clique no botão direito do rato para cancelar."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "A mira automática aponta sempre a sua arma <font color='#EE7000'>ao centro</font> do seu veículo alvo"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "A sua base está a ser <font color='#EE7000'>capturada!</font> Se não o parar, a equipa inimiga irá vencer a batalha."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Cada veículo inimigo tem <font color='#EE7000'>o seu próprio</font> progresso de captura"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Capturar</font> a base inimiga é uma das formas de vencer uma batalha"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Quando receber dano, o seu progresso de captura <font color='#EE7000'>é reiniciado</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Quando sai do círculo da base, o seu progresso de captura <font color='#EE7000'>é perdido</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Múltiplos veículos capturam a base <font color='#EE7000'>mais rapidamente</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Após o <font color='#EE7000'>terceiro</font> veículo, a velocidade de captura da base não aumenta"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "A base inimiga está quase capturada!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "A sua equipa está a ganhar a corrida da captura da base!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modulo do veículo criticamente danificado! Repare-o utilizando <font color='#EE7000'>a Caixa de Reparação</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modulo do veículo criticamente danificado! Repare-o utilizando <font color='#EE7000'>a Caixa de Reparação</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Membro da tripulação criticamente ferido! Trate-os com <font color='#EE7000'>a Caixa de Primeiros Socorros</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Membro da tripulação criticamente ferido! Trate-os com <font color='#EE7000'>a Caixa de Primeiros Socorros</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Tripulação do veículo atordoada! Trate-os com <font color='#EE7000'>a Caixa de Primeiros Socorros</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Veículo a arder! Utilize <font color='#EE7000'>o Extintor de Fogo</font> no painel de baixo."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Veículo a arder! <font color='#EE7000'>Extintor de Fogo</font> Automático ativado."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Módulo do veículo criticamente danificado! Equipar <font color='#EE7000'>uma Caixa de Reparação</font> antes da batalha ajuda a tratar de tiros críticos."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Membro da tripulação criticamente ferido! Equipar <font color='#EE7000'>uma Caixa de Primeiros Socorros</font> antes da batalha ajuda a tratar de ferimentos na tripulação."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Veículo a arder! Equipar <font color='#EE7000'>um Extintor de Fogo</font> antes da batalha ajuda a tratar de incêndios."

msgid "hint/PPH_OTHER_01"
msgstr "Foi <font color='#EE7000'>detetado</font> - disparar irá revelar a sua posição!"

msgid "hint/PPH_OTHER_02"
msgstr "O seu veículo foi destruído. pode pressionar em <font color='#EE7000'>Esc</font> para sair da batalha sem penalidade."

msgid "hint/PPH_OTHER_03"
msgstr "O seu veículo foi destruído. Pode clicar no botão do rato para <font color='#EE7000'>ver</font> os seus aliados."

msgid "hint/PPH_OTHER_04"
msgstr "O <font color='#EE7000'>ícone da lâmpada</font> indica que foi detetado pelos adversários!"

msgid "hint/PPH_OTHER_05"
msgstr "A sua arma ainda está a <font color='#EE7000'>recarregar</font>"

msgid "hint/PPH_OTHER_06"
msgstr "A sua arma apenas pode ser disparada se o círculo da retícula estiver <font color='#EE7000'>completamente verde</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Pode rodar a roda do rato para entrar no <font color='#EE7000'>modo de Sniper</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Pode rodar a roda do rato para <font color='#EE7000'>sair</font> do modo de Sniper"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Uma <font color='#EE7000'>retícula verde interior</font> indica uma hipótese alta de penetrar a blindagem do inimigo"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Mesmo que a retícula interior esteja verde, a penetração da blindagem <font color='#EE7000'>não é garantida</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "As armas não são 100% precisas, por isso os tiros <font color='#EE7000'>podem não acertar mesmo no centro</font> da retícula"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Uma retícula interna indica a hipótese de penetrar a blindagem do inimigo. <font color='#EE7000'>Ative-a nas Definições</font>."

msgid "penetration/chance/high"
msgstr "Alta probabilidade"

msgid "penetration/chance/low"
msgstr "Baixa probabilidade"

msgid "penetration/chance/medium"
msgstr "Média probabilidade"
