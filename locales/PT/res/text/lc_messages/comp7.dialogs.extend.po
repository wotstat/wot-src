msgid "comp7/deserter/cancel"
msgstr "Cancelar"

msgid "comp7/deserter/message"
msgstr "Esta batalha ainda não terminou. Se sair da batalha antes de esta terminar, irá decepcionar a sua equipa.\n{brown_open}A sua classificação será reduzida e será bloqueado de batalhas neste modo.{brown_close}\nTem a certeza que quer sair da batalha?"

msgid "comp7/deserter/msgTitle"
msgstr "Irá perder os seus Pontos de Posto!"

msgid "comp7/deserter/submit"
msgstr "Desertar"

msgid "comp7/deserter/title"
msgstr "Deserção do Campo de Batalha"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Você violou as Regras do Jogo no mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} às {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Pontos de Posto foram deduzidos e você foi temporariamente bloqueado das batalhas no modo {whiteSpanish_Open}Massacre{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Você violou as Regras do Jogo no mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} às {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nVocê foi temporariamente bloqueado das batalhas no modo {whiteSpanish_Open}Massacre{whiteSpanish_Close} e o seu Posto foi reduzido."
