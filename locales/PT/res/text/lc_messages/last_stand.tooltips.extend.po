msgid "Contact/status/inBattle/last_stand"
msgstr "Numa batalha da Última Posição"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Disparar um tiro que danifica o alvo e todos os veículos inimigos num raio de 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Dispara um tiro que restaura pontos de energia roubando-os do alvo e dos veículos inimigos num raio de 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Dispara um tiro que atordoa o alvo e todos os veículos inimigos num raio de 35 m."

msgid "advanced/ls_damageShield"
msgstr "Protege contra qualquer dano (exceto abalroamento, afogamento e impacto) por 10 segundos."

msgid "advanced/ls_doubleDamage"
msgstr "O seu próximo tiro bem-sucedido causa o dobro do dano."

msgid "advanced/ls_equipment"
msgstr "Os Dispositivos Táticos ajudam-no a combater com mais eficácia nas batalhas de Última Posição, a concluir Fases e a ganhar recompensas valiosas. Para os equipar, clique numa das slots de Dispositivos Táticos."

msgid "advanced/ls_extraDamageSituational"
msgstr "Oferece uma hipótese de causar dano aumentado a um veículo inimigo."

msgid "advanced/ls_fastReload"
msgstr "Aumenta a cadência de tiro / recarrega o magazine."

msgid "advanced/ls_healSituational"
msgstr "Recupera alguns pontos de energia após destruir um veículo inimigo."

msgid "advanced/ls_invisibility"
msgstr "Impede temporariamente os inimigos de mirar o seu veículo, restaura pontos de vida, repara módulos, extingue incêndios, remove o efeito de atordoamento e trata todos os membros da tripulação feridos."

msgid "advanced/ls_nitro"
msgstr "Aumenta temporariamente a mobilidade do seu veículo."

msgid "advanced/ls_nitroSituational"
msgstr "Aumenta temporariamente a mobilidade do seu veículo depois de sofrer dano de um veículo inimigo."

msgid "advanced/ls_selfRepairKit"
msgstr "Restaura pontos de energia, extingue incêndios, remove o efeito de atordoamento e repara módulos danificados."

msgid "advanced/ls_teamRepairKit"
msgstr "Repara módulos danificados, extingue incêndios, remove o efeito de atordoamento e restaura alguns pontos de energia aos veículos aliados dentro do seu raio."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Os Dispositivos Táticos podem ser equipados em slots especiais para o ajudar a lutar mais eficazmente em batalhas Última Posição, concluir Fases e ganhar recompensas valiosas."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Slots de Dispositivos Táticos"
