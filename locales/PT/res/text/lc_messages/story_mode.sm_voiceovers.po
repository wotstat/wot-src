msgid "vo_sm_char10_m05_stg21_02"
msgstr "Oficial QG: Cabeça-de-praia Echo 5 segura. Os tanques estão a avançar. Providencie apoio de fogo total."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Oficial QG: Redirecione o apoio aéreo para o avanço dos tanques."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Oficial QG: Equipa de engenharia, limpem os obstáculos para um futuro avanço."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Oficial QG: A praia está limpa. A enviar as forças principais. Excelente trabalho."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Oficial QG: Mantenham a posição. Os reforços estão a caminho."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Oficial QG: Protejam a cabeça-de-praia a todo o custo."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Oficial QG: Outro tanque, outra oportunidade. Tenha cuidado desta vez."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Ofical HQ: Estamos a ficar sem reservas. Faça com que esta conte, comandante."

