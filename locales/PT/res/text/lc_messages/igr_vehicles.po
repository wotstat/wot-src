msgstr "AN/VRC-7"

msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Este tanque experimental foi um desenvolvimento posterior do AMX 13. O tanque foi submetido a testes mas nunca foi produzido em massa nem entrou em serviço. Foram manufaturados dois veículos."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

