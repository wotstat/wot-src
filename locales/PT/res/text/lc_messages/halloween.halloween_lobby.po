msgid "storyChoiceConfirm/option_2/confirm"
msgstr "Deixar a Alex Ir"

msgid "storyChoiceConfirm/option_2/title"
msgstr "Deixar a Alex Ir?"

msgid "storyChoiceConfirm/warning"
msgstr "Esta escolha é definitiva. A escolha geral da comunidade irá influenciar o desenrolar do próximo capítulo."

