msgstr "Pz.Kpfw. 38H 735 (f)"

msgid "H39_captured"
msgstr "Pz.Kpfw. 38H 735 (f)"

msgid "H39_captured_descr"
msgstr "No decurso da Campanha Francesa, a Alemanha capturou cerca de 600 veículos Hotchkiss 39. Estes foram modificados e continuaram a servir as unidades da Wehrmacht."

msgid "H39_captured_short"
msgstr "Pz. 38H"

msgid "H39turm"
msgstr "Pz.Kpfw. 38H 735 (f)"

