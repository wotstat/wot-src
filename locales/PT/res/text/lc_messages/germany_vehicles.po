msgid "PzIV_Ausf_1940"
msgstr "Pz.Kpfw. IV Ausf. G"

msgid "PzIV_Hydro"
msgstr "Pz.Kpfw. IV hydrostat."

msgid "PzIV_Hydro_descr"
msgstr "O desenvolvimento de veículos que incorporavam o tractor hidrostático traseiro começou na Alemanha em Julho de 1944. O chassis do Pz. IV Ausf. G foi utilizado para os ensaios relacionados. O primeiro protótipo foi fabricado no final de Outubro de 1944. Apenas um veículo foi produzido."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

msgid "PzIV_Schmalturm_A"
msgstr "Pz.Kpfw. IV Schmalturm"

