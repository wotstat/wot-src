msgid "elite_window/buttons/ok"
msgstr "Afirmativo!"

msgid "elite_window/buttons/post_progression"
msgstr "Para a Modificação"

msgid "elite_window/buttons/vanity_progression"
msgstr "Para Recompensas Elite"

msgid "elite_window/elite/description"
msgstr "O estatuto Elite é atribuído a veículos com todos os módulos disponíveis, Melhorias e ramos técnicos pesquisados, incluindo o(s) veículo(s) do nível seguinte. EXP de Combate ganha em veículos Elite pode ser convertida em EXP Livre por ouro ou usada para acelerar o treino da tripulação."

msgid "elite_window/elite/title"
msgstr "Estatuto Elite"

msgid "elite_window/post_progression/description"
msgstr "A Modificação de Campo já está disponível"

msgid "elite_window/prestige/description"
msgstr "Após receber o estatuto Elite, o veículo passa a ganhar Pontos Elite e a receber Níveis Elite que representam a sua dedicação a um veículo específico. Uma Insígnia correspondente é exibida na batalha após receber o primeiro nível Elite."

msgid "elite_window/prestige/title"
msgstr "Sistema Elite"

msgid "elite_window/title"
msgstr "ESTATUTO ELITE ADQUIRIDO"

msgid "elite_window/vanity_progression/description"
msgstr "Receba recompensas exclusivas para veículos de Nível XI, incluindo um estilo volumétrico único, Rastreador de Estatísticas e capa de arma!"

msgid "elite_window/vanity_progression/title"
msgstr "Sistema Recompensas Elite já disponível"
