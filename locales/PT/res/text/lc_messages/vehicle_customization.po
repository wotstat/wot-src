msgstr "14º Aniversário do World of Tanks"

msgid "special_style/14th_anniversary_01_desc"
msgstr "Um estilo para todas as estações desenvolvido para celebrar o 14º Aniversário do World of Tanks."

msgid "special_style/14th_anniversary_02"
msgstr "Veado Ousado"

msgid "special_style/14th_anniversary_03"
