msgstr "Deserto Branco"

msgid "special_style/bp2021_2_desc"
msgstr "Um estilo para todas as estações atribuído numa determinada Fase do Passe de Batalha: Temporada 4."

msgid "special_style/bp2021_3"
msgstr "Camada de Gelo"

msgid "special_style/bp2021_3_desc"
msgstr "Um estilo para todas as estações atribuído numa determinada Fase do Passe de Batalha: Temporada 4."

msgid "special_style/bp2021_5_2"
msgstr "Corrosão"

msgid "special_style/bp2021_5_2_desc"
msgstr "Um estilo para todas as estações atribuído numa determinada Fase do Passe de Batalha Temporada 5."

msgid "special_style/bp2021_5_3"
msgstr "Vento Sul"

msgid "special_style/bp2021_5_3_desc"
msgstr "Um estilo para todas as estações atribuído numa determinada Fase do Passe de Batalha Temporada 5."

