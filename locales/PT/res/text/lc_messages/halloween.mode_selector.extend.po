msgid "mode/halloween/battlePassTooltip/body"
msgstr "Certas missões no evento {whiteSpanish_open}Babilónia: Torre Negra{whiteSpanish_close} vai permitir-lhe ganhar Pontos do Passe de Batalha."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Pontos do Passe de Batalha"

msgid "mode/halloween/calendar"
msgstr "O evento vai durar por %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "O evento vai terminar em %(date)s."

msgid "mode/halloween/description"
msgstr "Combata e recolha matéria.\nBatalhas em veículos especiais."

msgid "mode/halloween/performance/highRisk/description"
msgstr "O desempenho do seu computador é insuficiente para este modo. Poderá ter alguns problemas com os gráficos e o movimento do veículo. Falhas do cliente de jogo são também prováveis."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Baixo Desempenho"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Baixo Desempenho"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Este modo requer um alto desempenho do computador.\nIrá sofrer problemas no carregamento dos mapas, gráficos e movimento do veículo. No caso de desempenho insuficiente, tente uma qualidade gráfica mais baixa nas suas Definições."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Desempenho Reduzido"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Desempenho Reduzido"
