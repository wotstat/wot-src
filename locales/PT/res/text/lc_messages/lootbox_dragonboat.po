msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Caixas Barco Dragão"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "CAIXAS BARCO DRAGÃO"

msgid "entryPoint/tooltip/description"
msgstr "Estas são caixas especiais contendo itens exclusivos e valiosos do jogo.\nPode obter caixas na Loja do jogo ou na Loja Premium."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Caixas Barco Dragão Temporariamente Indisponíveis"

msgid "eventName/lowerCase"
msgstr "Dome o Dragão, Cavalgue no Vento"

msgid "eventName/upperCase"
msgstr "DOME O DRAGÃO, VIAJE NO VENTO"

msgid "infoPage/footer/description/compensation"
msgstr "Se já possuir todos os veículos da lista de possíveis conteúdos da caixa, todos os veículos subsequentes que receber das Caixas Barco Dragão serão compensados em ouro igual ao seu valor total."

msgid "infoPage/footer/description/guaranteed"
msgstr "A cada %(guaranteed0)s Caixas Barco Dragão é garantido sair um veículo de Nível VIII–IX. Se as abrir sem uma delas conter tal veículo, então, um veículo de Nível VIII–IX que ainda não possua vai sair quando abrir a %(guaranteed0)s&zwnbsp;ª Caixa Barco Dragão. Quando sair, o contador é reiniciado."

msgid "noBoxesView/description/"
msgstr "Não tem nenhuma caixa.\nPode obtê-las na Loja do jogo."
