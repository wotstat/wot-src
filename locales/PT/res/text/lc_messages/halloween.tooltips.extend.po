msgid "Contact/status/inBattle/halloween"
msgstr "Numa batalha da Babilónia: Torre Negra"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Dispara um tiro que danifica e atordoa o alvo e todos os veículos inimigos num raio de 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Dispara um tiro que restaura pontos de energia roubando-os do alvo e dos veículos inimigos num raio de 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Dispara um tiro que atordoa o alvo e todos os veículos inimigos num raio de 35 m."

msgid "advanced/hw_damageShield"
msgstr "Protege contra qualquer dano (exceto abalroamento, afogamento e impacto) por 7 segundos."

msgid "advanced/hw_fastReload"
msgstr "Aumenta a cadência de tiro / recarrega o magazine."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Restaura pontos de energia, extingue incêndios, remove o efeito de atordoamento e repara módulos danificados."

msgid "advanced/hw_invisibility"
msgstr "Torna temporariamente o seu veículo invisível para os inimigos, restaura pontos de vida, repara módulos, apaga o fogo, remove o efeito de atordoamento e trata todos os tripulantes feridos."

msgid "advanced/hw_teamRepairKit"
msgstr "Repara módulos danificados, extingue incêndios, remove o efeito de atordoamento e restaura alguns pontos de energia aos veículos aliados dentro do seu raio."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "As Habilidades de Combate ajudam-no a lutar mais eficazmente nas batalhas da Babilónia: Torre Negra, conclua Objetivos e ganhe recompensas valiosas. Para as equipar, clique numa das slots de Habilidade de Combate."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Slots de Habilidades de Combate"

msgid "hwShell/alt/description"
msgstr "%(bold)s pode ser encontrado em batalha com uma determinada probabilidade após destruir um inimigo."

msgid "hwShell/alt/description/bold"
msgstr "Uma munição alternativa"
