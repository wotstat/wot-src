msgstr "Ficar no top %(desiredPosition)s de jogadores na sua equipa por experiência ganha."

msgid "regular_1_1_10_title_topByExp"
msgstr "Top 3"

msgid "regular_1_1_11_description_damage"
msgstr "Causar %(goal)s PE de dano a veículos inimigos disparando sobre eles."

msgid "regular_1_1_11_description_damageAdv"
msgstr "Causar %(goal)s PE de dano a veículos inimigos disparando sobre eles"

msgid "regular_1_1_11_description_hits"
msgstr "Causar %(goal)s vezes dano a veículos inimigos do mesmo nível ou superior disparando sobre eles"

msgid "regular_1_1_11_title_damage"
msgstr "Dano"

msgid "regular_1_1_11_title_damageAdv"
msgstr "Dano"

msgid "regular_1_1_11_title_hits"
msgstr "Dano"

msgid "regular_1_1_12_description_assist"
msgstr "Permitir aos seus aliados causarem %(goal)s PE de dano a veículos detectados por si. Permaneça oculto no momento em que o dano é causado."

msgid "regular_1_1_12_description_installedCamouflage"
msgstr "Entre numa batalha com a camuflagem aplicada pelo menos no chassis"

msgid "regular_1_1_12_description_installedModules"
msgstr "Entre numa batalha com a Rede de Camuflagem"

msgid "regular_1_1_12_title_assist"
