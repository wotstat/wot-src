msgid "#PluralForms"
msgstr "nplurals=2; plural=(n != 1);"

msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s Nível&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Assuma o controlo das antenas. Mantenha a rede. Proteja a transmissão."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "O desempenho do seu computador é insuficiente para este modo. Poderá ter alguns problemas com os gráficos e o movimento do veículo. Falhas do cliente de jogo são também prováveis."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Baixo Desempenho"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Baixo Desempenho"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Este modo requer um alto desempenho do computador. Irá sofrer problemas no carregamento dos mapas, gráficos e movimento do veículo. No caso de desempenho insuficiente, tente uma qualidade gráfica mais baixa nas suas Definições."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Desempenho Reduzido"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Desempenho Reduzido"
