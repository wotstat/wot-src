msgid "br_minefield/battleDescr"
msgstr "Lança um campo de minas ativo na área selecionada durante %(duration)s s. Os veículos inimigos que entrarem em contacto com as minas ficarão atordoados e sofrerão dano explosivo.\n\n*As minas podem ser destruídas com tiros. As minas lançadas sob veículos inimigos NÃO explodem."

msgid "br_minefield/descr"
msgstr "Lança um campo de minas ativo na área selecionada durante %(duration)s s. Os veículos inimigos que entrarem em contacto com as minas ficarão atordoados e sofrerão dano explosivo.\n\n*As minas podem ser destruídas com tiros. As minas lançadas sob veículos inimigos NÃO explodem."

msgid "br_minefield/longDescr"
msgstr "Lança um campo de minas ativo na área selecionada {whiteSpanish_Open}durante %(duration)s s{whiteSpanish_Close}. Os veículos inimigos que entrarem em contacto com as minas ficarão atordoados e sofrerão dano explosivo.\n\n*As minas podem ser destruídas com tiros. As minas lançadas sob veículos inimigos NÃO explodem."

msgid "br_minefield/name"
msgstr "Campo de Minas"

