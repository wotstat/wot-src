msgid "battleship/name"
msgstr "Sinal de Fumo"

msgid "battleship/shortDescr"
msgstr "Um sinal de fumo que marca uma área para uma salva de artilharia de couraçado, causando dano ao equipamento inimigo e objetos localizados ali."

msgid "distraction_ability/name"
msgstr "Ordem Falsa"

msgid "distraction_ability/shortDescr"
msgstr "Faz o Gefr. Keller utilizar o rádio Alemão capturado para transmitir uma ordem falsa, ordenando aos inimigos que investiguem um determinado local."

msgid "recon_ability/name"
msgstr "Explorar"

msgid "recon_ability/shortDescr"
msgstr "Envia o Capitão Dubois em reconhecimento para um local específico. Quando em reconhecimento, o tanque para e permanece estacionário. A habilidade continua a funcionar até ser cancelada."

msgid "scc_airstrike_ability/name"
msgstr "Suporte Aéreo"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Solicite um ataque aéreo numa posição designada."
