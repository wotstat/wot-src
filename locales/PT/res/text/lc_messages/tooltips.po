msgstr "Valor mínimo-máximo %(units)s"

msgid "tank_params/desc/accuracyDispersionCap"
msgstr "O bónus de dispersão a 100 m atribuído no nível máximo de precisão."

msgid "tank_params/desc/accuracyDispersionPerLevel"
msgstr "O bónus de dispersão a 100 m atribuído por nível de precisão."

msgid "tank_params/desc/accuracyLevelGainTime"
msgstr "Tempo necessário para obter um nível de precisão."

msgid "tank_params/desc/accuracySpeedLimit"
msgstr "Exceder esta velocidade impede a geração do nível de precisão."

msgid "tank_params/desc/accuracyWhileMovingDispersionCap"
msgstr "O bónus de dispersão durante o movimento ou rotação do chassis/arma concedido no nível máximo de precisão."

msgid "tank_params/desc/activeCoincideceShootingCharge"
msgstr "A quantidade de carga adicional de Mira Eletromecânica de Coincidência gerada por um impacto num veículo inimigo no modo Combate."

msgid "tank_params/desc/aimingTime"
msgstr "Tempo para o diâmetro do círculo da mira reduzir em 60% (modo standard / especial)."

msgid "tank_params/desc/aimingTimeCoincidenceElectromechanicalSight"
msgstr "O bónus no tempo para o diâmetro do círculo da mira diminuir em 60% concedido pela mira."

msgid "tank_params/desc/aimingTimeTurbo"
msgstr "Tempo de mira adicional necessário no modo Turbo."

msgid "tank_params/desc/attainableSpeed"
msgstr "Velocidade de um veículo após 5 segundos de aceleração desde uma posição estática a um nível morto.\nOs valores mostrados são para terreno duro/moderadamente suave/suave."

msgid "tank_params/desc/autoReloadTime"
msgstr "Tempo para auto-recarregar sucessivamente cada munição no carregador."

msgid "tank_params/desc/autoReloadTime/boost"
msgstr "Tempo normal para o autocarregamento sucessivo para cada munição no magazine"

msgid "tank_params/desc/autoReloadTime/boost/description"
msgstr "O sistema melhorado reduz o tempo normal para o autocarregamento da próxima munição após dispara a munição carregada assim que o indicador correspondente for mostrado."

msgid "tank_params/desc/autoReloadTime/boost/shortDescription"
msgstr "O sistema melhorado de autocarregamento reduz o tempo normal para o autocarregamento das munições."

msgid "tank_params/desc/autoShootClipFireRate"
msgstr "Tempo entre disparar o último projétil do carregador (ou ambas as armas) e carregar o novo carregador. / Número de armas ou munições no carregador."

msgid "tank_params/desc/avgDamage"
msgstr "Dano médio causado por um projétil standard após um tiro penetrante de blindagem. A dispersão potencial do dano é de +/- 25% do valor médio."

msgid "tank_params/desc/avgDamagePerMinute"
msgstr "Quantidade de dano que pode potencialmente ser causado a um veículo inimigo em 1 minuto se todos os tiros penetrarem a blindagem."

msgid "tank_params/desc/avgDamagePerSecond"
msgstr "Quantidade de dano potencialmente causado a um veículo inimigo em 1 segundo ao disparar continuamente se todos os tiros penetrarem na blindagem."

msgid "tank_params/desc/avgPiercingPower"
msgstr "Espessura média da blindagem penetrada por um projétil standard, ajustada para normalização do projétil. A dispersão é de +/- 25% do valor médio."

msgid "tank_params/desc/boosterCoolingTime"
msgstr "Tempo necessário para que os propulsores arrefeçam completamente após o seu nível crítico de aquecimento ser atingido."

msgid "tank_params/desc/boosterDuration"
msgstr "Duração máxima do efeito do jato após a ativação."

msgid "tank_params/desc/burstFireRate"
msgstr "Tempo de carregamento entre munições no clip. / Número de clips no carregador. / Número de munições no clip."

msgid "tank_params/desc/chargeTime"
msgstr "Tempo de preparação para disparar as duas armas ao mesmo tempo. / Duração do bloqueio do recarregamento da arma após disparar a salva."

msgid "tank_params/desc/chargeableBurstDispersion"
msgstr "Dispersão do segundo disparo no modo Rajada, caracterizada pelo desvio máximo do projétil do ponto de mira a uma distância de 100 m."

msgid "tank_params/desc/chargeableBurstPenetrationCount"
msgstr "Número de impactos penetrantes em veículos inimigos necessários para ativar o modo."

msgid "tank_params/desc/chargeableBurstReload"
msgstr "Temp para recarregar entre o primeiro e o segundo disparo no modo Rajada."

msgid "tank_params/desc/chargeableBurstSize"
msgstr "Número de projéteis armazenados no cartucho de rajada."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Tempo para reparar uma lagarta danificada."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Tempo para reparar uma lagarta principal/reserva danificada."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "Velocidade da rotação do chassis sobre o seu eixo e velocidade de mudança de direcção em movimento (manobrabilidade)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "O alcance de visão actual do seu veículo. Nenhum veículo inimigo pode ser detectado numa distância excedendo 445 m. Aumentar mais o alcance de visão permite-lhe detectar mais facilmente os veículos inimigos dentro do saio de 445 m (modo standard/especial)."

msgid "tank_params/desc/clipFireRate"
msgstr "Tempo entre o disparo da última munição no carregador (ou ambas as armas) e carregar o novo carregador. / Tempo entre o disparo de uma munição e carregar a próxima munição no carregador, arma ou clip. / Número de armas ou munições no carregador."

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Duração do efeito da Visão Eletromecânica de Coincidência após a ativação."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Tempo necessário antes que o estabilizador possa ser novamente ativado após a utilização."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Tempo que o estabilizador permanece ativo após a ativação."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Número de tiros por minuto, sem incluir o tempo de recarregamento."

msgid "tank_params/desc/coolingDelay"
msgstr "Tempo após o disparo antes que a arma comece a arrefecer."

msgid "tank_params/desc/coolingTime"
msgstr "Tempo necessário para a arma totalmente aquecida arrefecer. A arma pode ser utilizada durante este período."

msgid "tank_params/desc/damage"
msgstr "Dano causado por uma munição normal após penetrar a blindagem inimiga."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Tempo necessário antes que o designador possa ser utilizado novamente. O tempo de recarga começa após o disparo."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Tempo necessário após o início da batalha para que o designador possa ser utilizado pela primeira vez."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Tempo em que os veículos inimigos marcados permanecem visíveis e recebem mais dano de projéteis."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "A quantidade de dano adicional que os veículos inimigos marcados recebem dos projéteis."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "O bónus de dispersão a 100 m concedido pela mira."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Mostra quanto tempo após o disparo demora para a arma arrefecer o suficiente para melhorar a precisão."

msgid "tank_params/desc/enginePower"
msgstr "Este parâmetro afecta a aceleração, velocidade máxima e velocidade de rotação do chassis do veículo."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Este parâmetro afecta a aceleração e desempenho do veículo em diferentes tipos de terreno (modo standard / especial)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "O bónus de aceleração do veículo concedido pelos propulsores."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Este parâmetro afeta a aceleração do veículo, a velocidade máxima e a velocidade de deslocação do chassis no modo Turbo."

msgid "tank_params/desc/explosionRadius"
msgstr "O raio de dano após a explosão da munição HE, mostrando a habilidade de causar dano a uma distância desde o ponto de impacto."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Tempo adicionado ao tempo restante de carregamento do cartucho após disparar o último projétil."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Velocidade do veículo como está definido nas suas características técnicas."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "O bónus ao dano médio por minuto no nível máximo de eficiência do carregamento."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "O número máximo de níveis de eficiência do carregamento que podem ser acumulados."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "A quantidade de tempo que um nível de eficiência de carregamento dura antes de expirar."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "O número de níveis de eficiência de carregamento ganhos após destruir um veículo inimigo com um tiro."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "O número de níveis de eficiência de recarga ganhos para cada impacto de tiro num veículo inimigo detectado."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "A quantidade pela qual o tempo de carregamento da arma é reduzido por nível de eficiência de recarga."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "A penalização na dispersão durante o movimento da arma no modo Turbo."

msgid "tank_params/desc/gunYawLimits"
msgstr "Ângulos máximos para a rotação horizontal da arma (para a esquerda e para a direita da posição por defeito) quando o chassis está estacionário."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "O bónus de dano médio por cada nível de aquecimento acumulado."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Tempo em que o veículo fica impossibilitado de disparar ou trocar projéteis."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Tempo que o veículo pode permanecer no nível máximo de aquecimento antes que a carga sobreaqueça."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Tempo necessário para atingir cada nível de aquecimento."

msgid "tank_params/desc/heatingPerShot"
msgstr "A quantidade de calor que a arma gera por disparo."

msgid "tank_params/desc/hullArmor"
msgstr "Espessura da blindagem do chassis: frente / laterais / traseira respectivamente."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "A penalização na dispersão durante o movimento do chassis no modo Turbo."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Este parâmetro mostra o montante de dano causado por abalroamento. Quando os veículos colidem, o sistema considera a espessura da blindagem no ponto de impacto, a diferença entre o peso dos veículos e as suas velocidades."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Este parâmetro mostra o montante de dano que a suspensão causado por abalroamento. Quando os veículos colidem, o sistema considera a espessura da blindagem no ponto de impacto, a diferença entre o peso dos veículos e as suas velocidades."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Mostra a ocultação de um veículo em movimento. Quanto maior for o parâmetro, mais oculto está o veículo. Os parâmetros seguintes são indicados: para um veículo em movimento / para um veículo em movimento, após o disparo."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Mostra a ocultação de um veículo parado. Quanto maior for o parâmetro, mais oculto está o veículo. Os parâmetros seguintes são indicados: para um veículo estacionário / para um veículo estacionário, após o disparo."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "A quantidade de carregamento do Pós-Combustor de Descarga Iónica gerada por segundo a mais de 40 km/h no modo Turbo."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Este parâmetro afeta a duração do pós-combustor de Descarga Iónica após a ativação."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Este parâmetro afeta a aceleração, a velocidade máxima e a velocidade de rotação do chassis do veículo após a ativação do Pós-Combustor de Descarga de Iões."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "Velocidade adicional obtida após ativar o Pós-Combustor de Descarga de Iões."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "A quantidade de carregamento do Pós-Combustor de Descarga Iónica gerada por segundo no modo Turbo."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Dano médio causado por um disparo de carga única após um tiro com penetração de blindagem. A dispersão potencial de dano é de +/- 25% do valor médio."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Tempo antes do recarregamento total durante o qual os disparos de carga única não podem ser efetuados."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Aumento da dispersão da arma ao efetuar um disparo de carga única. Caracterizado pelo desvio máximo do projétil em relação ao ponto de mira a uma distância de 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Espessura média de blindagem que pode ser penetrada por um disparo de carga única, ajustada para a normalização do projétil. A dispersão é de +/- 25% do valor médio."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Aumento de disparos por minuto ao efetuar disparos de carga única (em comparação com disparos regulares)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Velocidade de um disparo de carga única."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "O número máximo de níveis de precisão que podem ser acumulados."

msgid "tank_params/desc/maxHealth"
msgstr "Número de pontos de durabilidade do veículo."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "O ângulo máximo que as rodas podem virar. Afecta a manobrabilidade e o manuseamento do veículo."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "A penalização na dispersão durante o movimento no modo Turbo."

msgid "tank_params/desc/overheatDuration"
msgstr "Tempo necessário para que a arma sobreaquecida arrefeça completamente. A arma não pode ser utilizada enquanto estiver a arrefecer."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "A quantidade de carga da Mira Eletromecânica de Coincidência gerada por segundo no modo Combate."

msgid "tank_params/desc/piercingPower"
msgstr "Espessura da blindagem que pode ser penetrada com uma munição normal, ajustada pela normalização da mesma."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Velocidade da rotação do chassis sobre o seu eixo e velocidade de mudança de direção em movimento (manobrabilidade)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "O tempo necessário para mudar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para mudar. Mudar de modo fica indisponível quando o motor é destruído."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "O tempo necessário para mudar entre os modos depende da condição do motor. Um motor danificado aumenta o tempo necessário para mudar. Mudar de modo fica indisponível quando o motor é destruído."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Velocidade para inclinar o chassis para cima e para baixo enquanto o veículo está no modo Casamata."

msgid "tank_params/desc/pitchLimits"
msgstr "Ângulos verticais máximos que a arma pode percorrer em relação ao chassis do veículo e considerando a sua suspensão."

msgid "tank_params/desc/powerModeDuration"
msgstr "Tempo necessário para atingir a velocidade máxima de avanço e a potência do motor no modo Transmissão Direta."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Tempo necessário para ativar o modo Transmissão Direta."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "O bónus para a dispersão a 100 m em pré-aquecimento máximo."

msgid "tank_params/desc/preheatDmgCap"
msgstr "O bónus ao dano médio causado no pré-aquecimento máximo."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Exceder esta velocidade impede a geração de pré-aquecimento e pode fazer com que esta diminua."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Tempo necessário para o seu veículo atingir o pré-aquecimento total a partir do zero."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Tempo necessário para o seu veículo voltar a zero a partir do pré-aquecimento total."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Durante este atraso, o pré-aquecimento do seu veículo não aumentará nem diminuirá."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "O nível máximo de carga que pode ser alcançado sem desativar o limitador."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "A quantidade de carga perdida após disparar."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "A quantidade de carga gerada automaticamente por segundo."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "A quantidade de carga perdida por segundo após a ativação do limitador, até atingir o limite."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "O atraso após o qual o limitador pode ser alternado novamente."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "A penalidade ao tempo de mira quando o limite é excedido."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "O bónus ao dano médio concedido na carga total quando o limite é excedido."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "O aumento súbito no dano causado pelos disparos quando o limite é excedido."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "A penalidade à dispersão a 100 m quando o limite é excedido."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "O bónus ao dano médio concedido na carga máxima enquanto o limitador está ativo."

msgid "tank_params/desc/radioDistance"
msgstr "Partilha de informação sobre comunicações com os aliados sobre a posição dos veículos. O alcance da comunicação é representado por um círculo com um raio que é calculado para este parâmetro. Quando diversos círculos se sobrepõem, a informação é partilhada a qualquer distância."

msgid "tank_params/desc/reactivationDelay"
msgstr "Tempo de arrefecimento antes que os jatos possam ser novamente ativados após a utilização."

msgid "tank_params/desc/reactivationLimit"
msgstr "O nível máximo de aquecimento que pode ser atingido antes que os propulsores fiquem indisponíveis para reativação."

msgid "tank_params/desc/relativeArmor"
msgstr "Um conjunto de parâmetros que mostram a resiliência do veículo ao dano causado."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Um conjunto de parâmetros que mostram a eficácia da ocultação quando o seu veículo está estacionário, em movimento ou a disparar. A camuflagem aplicada aumenta o parâmetro da ocultação."

msgid "tank_params/desc/relativeMobility"
msgstr "Um conjunto de parâmetros que mostram como o seu veículo pode mudar de posição no campo de batalha rapidamente."

msgid "tank_params/desc/relativePower"
msgstr "Um conjunto de parâmetros que mostra a eficácia na destruição de veículos inimigos."

msgid "tank_params/desc/relativeVisibility"
msgstr "Um conjunto de parâmetros que mostra a eficácia na detecção de veículos inimigos."

msgid "tank_params/desc/reloadTime"
msgstr "Número de tiros por minuto."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Bónus no tempo de recarga da arma concedido enquanto a mira estiver ativa."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Tempo que demora a recarregar a arma (ou ambas as armas em veículos com sistema com arma de cano duplo) após disparar."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
msgstr "Tempo para recarregar a arma após disparar (modo de tiro único/modo de tiro de salva)."

msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
