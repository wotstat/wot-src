msgid "personalMissions/awards/camouflage/alliance/body"
msgstr "Um conjunto de três padrões de camuflagem (Verão, Inverno e Deserto).\n\nAtribuído grátis para um veículo de recompensa quando as condições principais de todas as 60 missões de uma operação estiverem concluídas. \n\nPode ser aplicada em qualquer veículo da nação à qual o veículo de recompensa pertence quando as 60 missões de uma operação forem concluídas com honras.\n\nPode pesquisar por padrões de camuflagem raros no ecrã Exterior."

msgid "personalMissions/awards/camouflage/alliance/header"
msgstr "Conjunto Raro de Camuflagem"

msgid "personalMissions/awards/camouflage/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto).\n\nAtribuída gratuitamente para um veículo de recompensa quando as condições primárias de todas as 75 missões de uma operação estiverem cumpridas.\n\nPodem ser aplicados em qualquer veículo da nação à qual o veículo de recompensa pertence quando todas as 75 missões de uma operação forem concluídas com honras.\n\nPode procurar por padrões de camuflagem exclusivos no ecrã Exterior."

msgid "personalMissions/awards/camouflage/header"
msgstr "Conjunto Raro de Camuflagem"

msgid "personalMissions/awards/camouflageAll/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto). Pode ser aplicado ao veículo premiado gratuitamente ou adquirido para qualquer veículo da mesma nação."

msgid "personalMissions/awards/camouflageAll/header"
msgstr "Conjunto Raro de Camuflagem"

msgid "personalMissions/awards/camouflageNation/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto). Pode ser adquirido para qualquer veículo da mesma nação."

msgid "personalMissions/awards/camouflageNation/header"
msgstr "Conjunto Raro de Camuflagem"

msgid "personalMissions/awards/camouflageOnly/body"
msgstr "Um conjunto de três padrões de Camuflagem (verão, inverno e deserto). Pode ser aplicado a qualquer veículo do mesmo país que o veículo premiado."

msgid "personalMissions/awards/camouflageOnly/header"
msgstr "Conjunto Raro de Camuflagem"

