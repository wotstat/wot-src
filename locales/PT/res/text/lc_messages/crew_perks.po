msgid "driver_suspensionRepair/alt/description"
msgstr "Esta aptidão afeta a velocidade de reparação da suspensão, levando-a do estado vermelho para o amarelo num raio de 50 metros de um veículo aliado."

msgid "driver_suspensionRepair/alt/info"
msgstr "Uma aptidão com um efeito situacional entra em ação quando treinada a pelo menos 1% e a sua eficácia aumenta com mais treino. O efeito situacional é acionado quando diversas condições são cumpridas em batalha."

msgid "driver_suspensionRepair/currentLvlDescription"
msgstr "{yellow_Start}A velocidade de reparação da suspensão{yellow_End} irá ser aumentada em %(suspensionRepairSpeed)s a distâncias inferiores a 50 m de um veículo aliado."

