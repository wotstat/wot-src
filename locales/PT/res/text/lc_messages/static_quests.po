msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Comece uma Batalha Aleatória num veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Bem-vindo ao jogo! Lute com outros fãs de todo o mundo e celebre vitórias espetaculares!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Primeira Batalha"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Pesquise e adquira qualquer veículo de Nível IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Adquirir um veículo novo é uma ocasião importante. A cada novo nível, os veículos ficam mais interessantes. Uma tripulação treinada vai também melhorar a jogabilidade geral."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Veículo de Nível IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Travar três Batalhas Aleatórias em veículos de Nível IV–X com qualquer elemento de personalização aplicado."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Pode personalizar veículos alterando o seu exterior com estilos predefinidos ou criando o seu próprio estilo utilizando camuflagem, inscrições, emblemas e decalques."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Exteriores dos Veículos"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Comece a treinar qualquer aptidão para qualquer membro da tripulação."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Os membros da tripulação podem treinar aptidões adicionais para aumentar a sua eficácia ou obter novas capacidades."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Aptidões da Tripulação"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Ganhar 150 000 créditos em Batalhas Aleatórias em veículos de Nível IV–X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Quanto mais alto o nível da batalha, mais créditos vai precisar para manter o seu veículo, reabastecer munição e adquirir módulos e equipamento."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Acumular Créditos"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Pesquise e adquira qualquer veículo de Nível V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "O Nível V é onde os veículos mais sérios começam a aparecer e onde as suas habilidades de jogo são realmente postas à prova. Uma tripulação totalmente treinada será realmente útil."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Veículo de Nível V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos de Nível V–X com três itens de equipamento montados."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Ópticas Revestidas ou Ventilação Melhorada? O equipamento certo pode impulsionar os pontos fortes do seu veículo e reduzir as suas desvantagens."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montar Equipamento"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Conclua um cenário básico no modo Topografia."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Para ganhar confiança no campo de batalha, o melhor é entender bem os caminhos, táticas e mapas, incluindo as posições chave e objetos existentes."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografia"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Complete quatro cenários avançados num mapa em Topografia."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Entre no modo Topografia de vez em quando para estudar mapas para Batalhas Aleatórias. Os quatro cenários permitem explorar o local de diferentes ângulos."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Topografia Avançada"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos de Nível V-X com uma Reserva Pessoal ativada."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Quando ativadas, pode obter bónus adicionais para EXP de Combate, Livre e de Tripulação ou créditos após cada batalha."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Reservas Pessoais"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha seis vezes em Batalhas Aleatórias vitoriosas em veículos de Nível V-X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Estas missões permitem-lhe ganhar cinco vezes mais EXP por batalha bem-sucedida. Para isso, precisa vencer e ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 Missões para ×5 EXP"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Pesquise um módulo e monte-o num veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "A EXP de Combate é atribuída após cada batalha. Ganhe EXP de Combate para pesquisar novos módulos que melhoram a eficiência do seu veículo."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "EXP de Combate"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Pesquise e adquira qualquer veículo de Nível VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "A cada nível subsequente, pesquisar veículos irá requerer mais tempo e esforço. EXP Livre irá ajudar a avançar mais rápido e uma tripulação treinada será útil."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Veículo de Nível VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Conclua uma Missão Pessoal em qualquer campanha."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "As campanhas são cadeias de missões para diferentes tipos de veículos. Quando concluídas, pode obter recompensas úteis e veículos exclusivos."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Missões Pessoais"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Treine uma tripulação com um Manual Universal."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Livros da Tripulação permitem acelerar significativamente o treino da tripulação adicionando uma quantidade de EXP a um ou a todos os membros da tripulação."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Livros da Tripulação"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos de Nível VI-X equipados com uma diretiva de tripulação."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Diretivas podem melhorar as aptidões da tripulação por uma batalha. Como os consumíveis, diretivas são adquiridas ou recebidas como recompensa."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Diretivas para a Tripulação"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Adquira um Pacote de Iniciante especial na Loja do jogo."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Pode adquirir tudo o que precisa na Loja do jogo, incluindo ouro, veículo Premium e mais. Irá encontrar promoções regulares com óptimos negócios."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Loja"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos Premium de Nível VI-X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Estes veículos não precisam ser pesquisados. Eles ganham mais EXP de Combate, EXP de Tripulação e créditos e permitem transferir uma tripulação sem retreinar."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Veículos Premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos de Nível VI-X equipados com uma diretiva para equipamento."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "As diretivas permitem aumentar a eficácia do equipamento montado. Assim como os consumíveis, as diretivas podem ser adquiridas ou recebidas como recompensa."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Diretivas para Equipamento"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha 15 vezes em Batalhas Aleatórias em veículos de Nível VI-X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Estas missões permitem-lhe ganhar cinco vezes mais EXP por batalha bem-sucedida. Para isso, precisa vencer e ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 Missões para ×5 EXP"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Pesquise e adquira qualquer veículo de Nível VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Para o nível deste veículo, os requisitos de habilidade aumentam ainda mais. Veículos tornam-se mais formidáveis e mais eficientes - como os seus adversários."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Veículo de Nível VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Travar 10 Batalhas Aleatórias em veículos Nível VII–X com uma Caixa de Primeiros Socorros Grande, Caixa de Reparações Grande e Extintor de Incêndio Automático."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Quando equipados, os consumíveis grandes reparam os módulos danificados mais rapidamente do que os pequenos. Também reduzem a duração do atordoamento e a probabilidade de disparo, e têm um tempo de cooldown mais curto."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Consumíveis Grandes"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Recebe o dobro da EXP pela sua primeira vitória do dia em Batalhas Aleatórias num veículo de qualquer nível."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Pode receber o dobro da EXP pela sua primeira vitória do dia em cada veículo. Utilize este recurso para melhorar os seus veículos ainda mais depressa."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Multiplicador de EXP"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Crie um fragmento de diagrama para qualquer veículo não pesquisado."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Diagramas dão-lhe descontos em EXP e aceleram a pesquisa de um veículo. Podem ser recebidos como recompensa ou convertidos de fragmentos universais e nacionais."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Diagramas de Veículo"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha 20 vezes em Batalhas Aleatórias em veículos de Nível VII-X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Estas missões permitem-lhe ganhar cinco vezes mais EXP por batalha bem-sucedida. Para isso, precisa vencer e ficar no top 10 dos melhores jogadores na sua equipa por EXP ganha."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 Missões para ×5 EXP"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Pesquise e adquira qualquer veículo de Nível VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Veículos de Nível VIII requerem que utilize todo o conhecimento adquirido. Os inimigos não o vão deixar ficar aborrecido, providenciando emoções de altas octanas e uma experiência valiosa."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Veículo de Nível VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Utilize EXP Livre para pesquisar qualquer módulo."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Se não tiver EXP de Combate suficiente para pesquisar um módulo ou veículo, pode utilizar EXP Livre, que pode ser ganha para qualquer veículo."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "EXP Livre"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Carregue umas munições alternativos e inicie uma Batalha Aleatória num veículo de Nível III–X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Munições Perfurantes, Explosivas e Perfurantes de Componente Rígido, são utilizadas para diferentes situações em batalha. Escolha bem para obter uma vantagem!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munição"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Venda um módulo não utilizado do Armazém."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Módulos não utilizados, munições, equipamento, consumíveis e outros itens são armazenados no Armazém. Pode vender itens extra por créditos."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Armazém"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Ganhe 25 000 créditos em Batalhas Aleatórias em veículos de Nível III-X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Os créditos são utilizados para adquirir munições e veículos novos, reparar veículos e mais. É importante saber como poupar e utilizá-los com sabedoria."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Créditos"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Travar três Batalhas Aleatórias em veículos de Nível III–X com consumíveis montados em todas as slots disponíveis."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Os consumíveis podem reparar danos críticos no veículo e curar a tripulação em batalha. Utilizar consumíveis na hora certa é crucial para sobreviver no campo de batalha."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Consumíveis"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Travar três Batalhas Aleatórias em veículos de Nível III–X com qualquer equipamento montado."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Os veículos podem ser equipados com equipamento para melhorar algumas das características. O carregamento do equipamento depende do veículo e do estilo de jogo."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Equipamento"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Conclua um cenário em qualquer mapa da Topografia"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incógnita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Complete quatro cenários básicos num mapa em Topografia"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Reconhecimento"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Complete quatro cenários avançados num mapa em Topografia"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Um 5 a Geografia"
