msgid "alert"
msgstr "Não pode escolher uma Reserva de Combate no decorrer de uma luta."

msgid "description/one/reserve"
msgstr "Escolher repetidamente a Reserva %(reserve_name)s\nirá melhorar as suas características."

msgid "description/second/reserve"
msgstr "Escolher repetidamente a Reserva %(first_reserve_name)s ou %(second_reserve_name)s\n irá melhorar as características da que estiver selecionada."

msgid "number_1"
msgstr "1º"

msgid "number_2"
msgstr "2º"

msgid "number_3"
msgstr "3º"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Constrói um campo de minas activo na área seleccionada por um certo período de tempo."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Causa dano considerável a veículos inimigos num raio pequeno."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Atordoa veículos inimigos e causa dano médio numa área grande."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Adiciona um bónus à qualificação principal da tripulação do jogador e tripulações aliadas."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Fornece um bónus à velocidade de captura, bloqueio da captura e reabastecimento."

msgid "shortDescription/reserve/reconAbility"
msgstr "Detecta veículos inimigos e campos de minas."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restaura uma certa percentagem dos pontos de energia do seu veículo."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Oculta todos os veículos dentro e atrás do fumo."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Fornece um bónus de ocultação e alcance de visão. Reduz a ocultação dos veículos inimigos."

msgid "title"
msgstr "A %(number_name)s Slot de Reserva Disponível"
