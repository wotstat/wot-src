msgid "propertyInfo/prop/descr/averageDamage"
msgstr "O rácio entre o dano total causado e o número de batalhas combatidas na sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Rácio entre veículos inimigos destruídos e batalhas travadas."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Nível médio de veículos que conduziu na sessão do jogo."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "O rácio entre a experiência total recebida e o número de batalhas combatidas na sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "O rácio entre o dano total bloqueado e o número de batalhas combatidas na sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "O rácio de dano após a sua detecção e o dano causado por aliados após a sua destruição de uma lagarta e imobilização do veículo inimigo ou atordoamento para o número de batalhas travadas numa sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "O rácio entre os parâmetros \"Dano causado\" e o \"Dano recebido\". Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "O rácio entre os veículos inimigos destruídos e o número de vezes que o veículo do jogador foi destruído. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Rácio entre veículos inimigos detectados e batalhas travadas na sessão."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Percentagem total de batalhas combatidas nas quais o veículo do jogador não foi destruído."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Percentagem de vitórias em Batalhas Aleatórias na sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/wins"
msgstr "O número de vitórias em Batalhas Aleatórias na sessão. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

msgid "propertyInfo/prop/descr/wtr"
msgstr "O WTR pelos valores médios da sessão inteira. Delta mostra o efeito da sessão de jogo actual no parâmetro total."

