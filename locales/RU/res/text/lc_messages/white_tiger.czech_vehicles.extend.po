msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Серебряная пуля"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "Гордость оружейников Альянса"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Перегруженные генераторы заряжают «Серебряную пулю» плазмой. Чем больше зарядов, тем больше урона наносит плазма. Чтобы нанести максимальный урон, стреляйте только когда щит Blitzträger отключён."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Дополнительный урон с плазмой"
