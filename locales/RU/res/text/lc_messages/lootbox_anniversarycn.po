msgid "entryPoint/tooltip/description"
msgstr "Это специальные Коробки, которые содержат новые и уникальные предметы. Их можно получить во внутриигровом Магазине."

msgid "entryPoint/tooltip/timerText"
msgstr "Событие продлится до"

msgid "eventName/lowerCase"
msgstr "Сокровищница шёпота"

msgid "eventName/upperCase"
msgstr "СОКРОВИЩНИЦА ШЁПОТА"

msgid "guaranteed/tooltip/description1/"
msgstr "Если у вас уже есть все машины, вы получите Щедрую коробку."

msgid "infoPage/footer/description/compensation"
msgstr "Если у вас уже есть вся техника из коробок, вы получите Щедрую коробку в качестве гарантированной награды вместо машины."

msgid "infoPage/footer/description/guaranteed"
msgstr "Каждые %(guaranteed0)s Трофейных, %(guaranteed1)s Щедрых и %(guaranteed2)s Одаряющих коробок гарантированно содержат машину. Если при их открытии вам не выпадет такая техника, то машина, которой у вас ещё нет, выпадет при открытии %(guaranteed0)s-й/%(guaranteed1)s-й/%(guaranteed2)s-й коробки (в зависимости от типа). При выпадении машины счётчик обнуляется."

msgid "infoPage/footer/title/compensation"
msgstr "Компенсация"

msgid "infoPage/footer/title/guaranteed"
msgstr "Гарантированная награда"

msgid "infoPage/header/rewards/description"
msgstr "Может выпасть не более одной награды из группы"
