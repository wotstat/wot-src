msgstr "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"

msgid "boxTooltip/description/text/bronze"
msgstr "При открытии коробок вы можете получить технику, внутриигровую валюту и другие ценные награды."

msgid "boxTooltip/description/text/gold"
msgstr "При открытии коробок вы можете получить технику, внутриигровую валюту, элементы внешнего вида и другие ценные награды."

msgid "boxTooltip/description/text/silver"
msgstr "При открытии коробок вы можете получить технику, внутриигровую валюту, элементы внешнего вида и другие ценные награды."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Можно купить во внутриигровом Магазине или получить из коробок любого типа."

msgid "boxTooltip/howGet/text/gold"
msgstr "Могут быть получены из коробок любого другого типа."

msgid "boxTooltip/howGet/text/silver"
msgstr "Могут быть получены из коробок любого другого типа."

