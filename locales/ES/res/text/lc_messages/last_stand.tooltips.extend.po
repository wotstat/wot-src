msgid "Contact/status/inBattle/last_stand"
msgstr "En una batalla de Última defensa"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Dispara un tiro que daña al objetivo y a todos los enemigos en un radio de 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Dispara un tiro que roba PV al objetivo y los vehículos enemigos en un radio de 35 m para restaurárselos a tu vehículo."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Dispara un tiro que aturde al objetivo y a todos los vehículos enemigos en un radio de 35 m."

msgid "advanced/ls_damageShield"
msgstr "Protege contra cualquier daño (excepto embestidas, hundimientos y caídas) durante 10 segundos."

msgid "advanced/ls_doubleDamage"
msgstr "El siguiente disparo que alcance al objetivo causa el doble de daño."

msgid "advanced/ls_equipment"
msgstr "Los dispositivos tácticos te ayudan a luchar con más eficacia en las batallas de Última defensa, a completar etapas y ganar recompensas valiosas. Para equiparlas, haz clic en uno de los espacios de dispositivos tácticos."

msgid "advanced/ls_extraDamageSituational"
msgstr "Otorga una probabilidad de infligir más daño a un vehículo enemigo."

msgid "advanced/ls_fastReload"
msgstr "Aumenta la cadencia de tiro/recarga el cargador."

msgid "advanced/ls_healSituational"
msgstr "Restaura puntos de vida tras destruir un vehículo enemigo."

msgid "advanced/ls_invisibility"
msgstr "Impide que los enemigos ataquen tu vehículo, restaura puntos de vida, repara módulos, extingue incendios, elimina los efectos de aturdimiento y cura a todos los tripulantes heridos."

msgid "advanced/ls_nitro"
msgstr "Aumenta temporalmente la movilidad de tu vehículo."

msgid "advanced/ls_nitroSituational"
msgstr "Aumenta la movilidad de tu vehículo temporalmente tras recibir daño de un vehículo enemigo."

msgid "advanced/ls_selfRepairKit"
msgstr "Restaura PV, extingue los incendios, elimina los efectos de aturdimiento y repara los módulos dañados."

msgid "advanced/ls_teamRepairKit"
msgstr "Repara los módulos, extingue los incendios, elimina los efectos de aturdimiento y restaura parte de los PV de los vehículos aliados dentro del radio de efecto."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Los dispositivos tácticos pueden equiparse en espacios especiales y te ayudan a luchar de forma más eficaz en las batallas de Última defensa, a completar etapas y ganar recompensas valiosas."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Espacios de dispositivos tácticos"
