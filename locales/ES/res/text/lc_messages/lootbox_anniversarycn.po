msgid "guaranteed/tooltip/description1/"
msgstr "Si ya tienes todos los vehículos, recibirás una caja de bendición como compensación."

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos de las cajas, recibirás una caja de bendición como recompensa garantizada en lugar de un vehículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza la entrega de un vehículo cada %(guaranteed0)s cajas de botín, %(guaranteed1)s cajas de ofrenda y %(guaranteed2)s cajas de bendición. Si las abres sin que aparezca ninguno de estos blindados, recibirás un vehículo que no tengas al abrir la %(guaranteed0)s.ª/%(guaranteed1)s.ª/%(guaranteed2)s.ª caja (en función del tipo de caja). Después de cada aparición, el contador se reinicia."

msgid "infoPage/footer/title/compensation"
msgstr "Compensación"

msgid "infoPage/footer/title/guaranteed"
msgstr "Recompensa garantizada"

msgid "infoPage/header/rewards/description"
msgstr "No más de una recompensa por grupo"
