msgid "boxTooltip/description/text/silver"
msgstr "Cuando se abren, estas cajas pueden otorgar vehículos, divisas del juego, elementos de personalización y otras recompensas de valor."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Pueden adquirirse en la tienda del juego y recibirse al abrir cajas de cualquier otro tipo."

