msgid "entryPoint/tooltip/description"
msgstr "Estas son unas cajas especiales que incluyen vehículos nuevos y únicos de nivel VIII a X y otras recompensas.\nPuedes recibir las cajas de regalo por comprar artículos en la tienda premium o al abrir cajas de cualquier otro tipo."

msgid "entryPoint/tooltip/warningDescription"
msgstr "En este momento, la apertura o la compra de cajas no está disponible por problemas técnicos. Sentimos las molestias temporales."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Cajas de Bendición divina no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "BENDICIÓN DIVINA"

msgid "eventName/upperCase"
msgstr "BENDICIÓN DIVINA"

msgid "infoPage/footer/description/autoOpen"
msgstr "Si no abres todas las cajas antes de que acabe el evento, se abrirán automáticamente después."

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos de la caja, recibirás una caja elegida como recompensa garantizada en lugar de un vehículo."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza la entrega de un vehículo del nivel VIII al X cada %(guaranteed0)s cajas celestiales, %(guaranteed1)s cajas de ayuda divina y %(guaranteed2)s cajas elegidas. Si las abres sin que aparezca ninguno de estos blindados, recibirás un vehículo del nivel VIII al X que no tengas al abrir la %(guaranteed0)s.ª/%(guaranteed1)s.ª/%(guaranteed2)s.ª caja (en función del tipo de caja). Después de cada aparición, el contador se reinicia."

msgid "infoPage/footer/title/compensation"
msgstr "Si has recibido todos los vehículos"

msgid "infoPage/header/description"
msgstr "¡Abre cajas para optar a recibir artículos del juego!\nTienes la lista de posibles recompensas a continuación."

msgid "noBoxesView/description/"
msgstr "No tienes ninguna caja.\nPuedes comprarlas en la tienda premium."

msgid "singleRewardView/tooltip/boxName/"
msgstr "Caja elegida"

msgid "singleRewardView/tooltip/description/"
msgstr "Si ya tienes todos los vehículos de la caja, recibirás una caja elegida como recompensa garantizada en lugar de un vehículo."

