msgid "boxTooltip/description/text/bronze"
msgstr "Cuando se abren, estas cajas pueden otorgar vehículos premium de nivel VIII, divisas del juego y otras recompensas de valor."

msgid "boxTooltip/description/text/gold"
msgstr "Cuando se abren, estas cajas pueden otorgar vehículos insólitos de nivel X, divisas del juego y otras recompensas de valor."

msgid "boxTooltip/description/text/silver"
msgstr "Cuando se abren, estas cajas pueden otorgar vehículos premium de nivel IX, divisas del juego y otras recompensas de valor."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Puede recibirse de regalo al comprar artículos en la tienda premium, así como al abrir cajas de cualquier otro tipo."

msgid "boxTooltip/howGet/text/gold"
msgstr "Puede recibirse al abrir cajas de cualquier otro tipo."

msgid "boxTooltip/howGet/text/silver"
msgstr "Puede recibirse al abrir cajas de cualquier otro tipo."

