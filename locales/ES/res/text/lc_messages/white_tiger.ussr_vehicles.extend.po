msgid "_100mm_UBR-412PB_WT"
msgstr "Bala de plata"

msgid "_100mm_UBR-412PB_WT_descr"
msgstr "El orgullo de los armeros de la Alianza"

msgid "_100mm_UBR-412PB_WT_long_special"
msgstr "Cada generador sobrecargado cargará Bala de plata con plasma. Cuantas más cargas tenga, más daño causará el plasma. Dispara cuando el escudo del Blitzträger haya caído para causar el daño máximo."

msgid "_100mm_UBR-412PB_WT_short_special"
