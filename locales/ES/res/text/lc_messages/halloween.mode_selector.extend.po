msgid "mode/halloween/battlePassTooltip/body"
msgstr "Algunas misiones del evento «{whiteSpanish_open}Babylon: Torre oscura{whiteSpanish_close}» te permitirán ganar puntos de Pase de batalla."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Puntos de Pase de batalla"

msgid "mode/halloween/calendar"
msgstr "El evento durará hasta el %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "El evento acabará el %(date)s."

msgid "mode/halloween/description"
msgstr "Lucha y recoge materia.\nBatallas en vehículos especiales."

msgid "mode/halloween/performance/highRisk/description"
msgstr "El rendimiento de tu ordenador es insuficiente para este modo. Puedes tener problemas gráficos y con los movimientos de los vehículos. Es probable que el juego se cuelgue."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Bajo rendimiento"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Bajo rendimiento"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Este modo exige un alto rendimiento del ordenador.\nPuedes experimentar problemas gráficos, al cargar los mapas y con los movimientos de los vehículos. Si el rendimiento es insuficiente, reduce los ajustes de calidad gráfica."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Rendimiento reducido"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Rendimiento reducido"
