msgid "alert"
msgstr "No puedes elegir una reserva de combate durante un enfrentamiento activo."

msgid "description/one/reserve"
msgstr "Elegir varias veces la reserva «%(reserve_name)s»\nmejorará sus características."

msgid "description/second/reserve"
msgstr "Elegir varias veces la reserva «%(first_reserve_name)s» o «%(second_reserve_name)s»\nmejorará las características de la que se haya seleccionado."

msgid "number_1"
msgstr "1.er"

msgid "number_2"
msgstr "2.º"

msgid "number_3"
msgstr "3.er"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Despliega un campo de minas activas durante un tiempo determinado en la zona seleccionada."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Causa daños considerables a los enemigos en un radio reducido."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Aturde a los vehículos enemigos y causa daño medio en un radio amplio."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Ofrece una bonificación a la acreditación principal de la tripulación del jugador y sus aliados."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Una bonificación a la captura/defensa de la base y abastecimiento."

msgid "shortDescription/reserve/reconAbility"
msgstr "Detecta vehículos enemigos y campos de minas."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Restaura un cierto porcentaje de los puntos de vida de tu vehículo."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Oculta todos los vehículos dentro y detrás del humo."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Una bonificación a la ocultación y el alcance de visión. Reduce la ocultación de enemigos."

msgid "title"
msgstr "%(number_name)s espacio de reserva disponible"
