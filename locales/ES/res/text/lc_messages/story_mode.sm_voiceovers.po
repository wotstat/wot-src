msgid "vo_sm_char10_m05_stg21_02"
msgstr "Oficial del Cuartel General: Cabeza de playa Eco-5 asegurada. Blindados en avance. Ofrezcan el máximo fuego de apoyo."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Oficial del Cuartel General: Redirijan el apoyo aéreo para asistir en el avance de los blindados."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Oficial del Cuartel General: Equipos de ingeniería, limpien los obstáculos para seguir avanzando."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Oficial del Cuartel General: La playa está limpia. Vamos a enviar las fuerzas principales. Excelente trabajo."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Oficial del Cuartel General: Mantengan la posición. Los refuerzos están en camino."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Oficial del Cuartel General: Protejan la cabeza de playa a toda costa."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Oficial del Cuartel General: Otro blindado, otra oportunidad. Esta vez, vaya con cuidado."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Oficial del Cuartel General: Nuestras reservas escasean. Haga que este cuente, comandante."

