msgid "elite_window/buttons/ok"
msgstr "¡Afirmativo!"

msgid "elite_window/buttons/post_progression"
msgstr "A Modificación"

msgid "elite_window/buttons/vanity_progression"
msgstr "A las recompensas de élite"

msgid "elite_window/elite/description"
msgstr "El estado de élite se otorga a vehículos que hayan desarrollado todos los módulos, mejoras y ramas técnicas disponibles, incluidos los vehículos del siguiente nivel. La EXP de combate obtenida en vehículos de élite se puede convertir en EXP libre con oro o invertirse en el entrenamiento acelerado de la tripulación."

msgid "elite_window/elite/title"
msgstr "Estado de élite"

msgid "elite_window/post_progression/description"
msgstr "Mejora de campo ya disponible"

msgid "elite_window/prestige/description"
msgstr "Tras recibir el estado de élite, el vehículo empieza a ganar puntos de élite y recibir niveles de élite. Estos representan tu consagración a un determinado vehículo. Una vez que alcances el primer nivel de élite, aparecerá el galón correspondiente en la batalla."

msgid "elite_window/prestige/title"
msgstr "Sistema de élite"

msgid "elite_window/title"
msgstr "ESTADO DE ÉLITE ADQUIRIDO"

msgid "elite_window/vanity_progression/description"
msgstr "¡Recibe recompensas exclusivas para vehículos de nivel XI, incluido un estilo volumétrico único, un registrador de estadísticas y una funda para el cañón!"

msgid "elite_window/vanity_progression/title"
msgstr "Sistema de recompensas de élite ya disponible"
