msgid "battleship/name"
msgstr "Señal de humo"

msgid "battleship/shortDescr"
msgstr "Una señal de humo que marca la zona para que el buque de guerra dispare una salva de artillería que causa daño al equipamiento enemigo y los objetos que se encuentran en ella."

msgid "distraction_ability/name"
msgstr "Orden falsa"

msgid "distraction_ability/shortDescr"
msgstr "Haz que el soldado Keller use la radio alemana capturada para transmitir una orden falsa a los enemigos, haciendo así que investiguen una ubicación específica."

msgid "recon_ability/name"
msgstr "Exploración circundante"

msgid "recon_ability/shortDescr"
msgstr "Envía al capitán Dubois a explorar una ubicación específica. Al estar en plena labor de reconocimiento, el carro se detendrá y permanecerá inmóvil. La habilidad sigue activa hasta que se cancela."

msgid "scc_airstrike_ability/name"
msgstr "Apoyo aéreo"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Solicita un ataque aéreo en una posición específica."
