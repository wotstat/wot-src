msgid "radioman_battleTempered/alt/description"
msgstr "Si dos operadores de radio tienen esta cualificación, se aplica el valor medio de su nivel de entrenamiento.\n\nEl efecto se puede mejorar más con la cualificación de comandante «Detección de sonido»."

msgid "radioman_battleTempered/alt/info"
msgstr "Una cualificación surte efecto cuando está entrenada al 1 % como mínimo. Su efectividad mejora a medida que se entrena."

msgid "radioman_battleTempered/currentLvlDescription"
msgstr "Si la tripulación queda aturdida, el {greenBright_Start}efecto negativo del aturdimiento{greenBright_End} se reduce en %(stunResistanceEffectFactor)s, hasta un máximo del 30 %."

msgid "radioman_battleTempered/maxLvlDescription"
