msgstr "TESORO ARDIENTE"

msgid "common/getButton/lowerCase"
msgstr "Obtener tesoros"

msgid "common/getButton/upperCase"
msgstr "OBTENER TESOROS"

msgid "common/loader"
msgstr "Abriendo tesoro ardiente..."

msgid "common/statistics/emptyHeader"
msgstr "Abre tesoros para ver las estadísticas."

msgid "common/statistics/header"
msgstr "Tesoros ardientes abiertos: %(count)"

msgid "confirmResetLootBoxStatistics/description"
msgstr "Toda la información sobre los tesoros ardientes abiertos se eliminará."

msgid "entryPoint/boxes"
msgstr "A LOS TESOROS"

msgid "entryPoint/tooltip/description"
msgstr "Estas son unas cajas especiales que incluyen artículos nuevos y únicos, como vehículos premium, estilos 2D y más. Puedes comprarlas en la tienda del juego."

msgid "entryPoint/tooltip/warningDescription"
msgstr "En este momento, la apertura o la compra de tesoros ardientes no está disponible por problemas técnicos. Sentimos las molestias temporales."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Tesoros ardientes no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "Botín lunar"

msgid "eventName/upperCase"
msgstr "BOTÍN LUNAR"

msgid "guaranteedTitle/nextBox"
msgstr "¡Recompensa garantizada en el próximo tesoro!"

msgid "guaranteedTitle/text"
msgstr "Tesoros ardientes máximos antes de una recompensa garantizada: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Si no abres los tesoros ardientes antes de que acabe el evento, se abrirán automáticamente."

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos de la lista de contenido posible de los tesoros ardientes, recibirás oro como compensación por el valor total de los siguientes vehículos que aparezcan en los tesoros."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza la entrega de un vehículo del nivel VIII al X cada %(guaranteed0)s tesoros. Si los abres sin que aparezca ninguno de estos blindados, recibirás un vehículo del nivel VIII al X que no tengas al abrir la %(guaranteed0)s&zwnbsp;.º tesoro. Después de cada aparición, el contador se reinicia."

msgid "infoPage/header/description"
msgstr "¡Abre tesoros ardientes y podrás recibir artículos valiosos del juego! Más detalles a continuación."

msgid "multipleRewardView/header/subTitle/"
msgstr "De %(name) (%(boxesCount) tesoros ardientes abiertos)"

msgid "noBoxesView/description/"
msgstr "No tienes ningún tesoro ardiente.\nPuedes comprarlos en la tienda del juego."

msgid "preview/backLabel"
msgstr "A LOS TESOROS"

msgid "quantityTitle/boxesAvailable"
msgstr "Tesoros disponibles: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No hay tesoros disponibles"

msgid "singleRewardView/tooltip/description/"
msgstr "Si ya tienes todos los vehículos de la lista de posible contenido de los tesoros ardientes, recibirás oro como compensación por los siguientes vehículos que aparezcan en los tesoros."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) tesoro ardiente"
msgstr[1] "%(remainingCount) tesoros ardientes"
msgstr[2] "%(remainingCount) tesoros ardientes"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "La recompensa garantizada es un vehículo de la lista de contenido de los tesoros ardientes.\nSi abres %(remainingCount) tesoros sin que aparezca uno de estos vehículos, este aparecerá cuando abras el %(count).º tesoro. Cuando esto suceda, se reiniciará el contador."
