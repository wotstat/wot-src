msgstr "No tienes suficientes módulos para abrir cinco simultáneamente"

msgid "common/statistics/emptyHeader"
msgstr "Abre módulos para ver las estadísticas."

msgid "common/statistics/header"
msgstr "Módulos abiertos:"

msgid "confirmRerollLootBox/description/wt"
msgstr "El módulo se volverá a abrir para tener la oportunidad de recibir recompensas diferentes."

msgid "confirmResetLootBoxStatistics/description"
msgstr "Toda la información sobre los módulos abiertos se eliminará."

msgid "entryPoint/boxes"
msgstr "A LOS MÓDULOS"

msgid "entryPoint/tooltip/description"
msgstr "Estos son módulos especiales que contienen artículos nuevos y únicos. Puedes obtenerlos en la tienda del juego."

msgid "entryPoint/tooltip/warningDescription"
msgstr "En este momento, la apertura u obtención de módulos no está disponible por problemas técnicos. Sentimos las molestias temporales."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Módulos no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "Monta la tormenta"

msgid "eventName/upperCase"
msgstr "MONTA LA TORMENTA"

msgid "guaranteedTitle/nextBox"
msgstr "¡Recompensa garantizada en el próximo módulo!"

msgid "guaranteedTitle/text"
msgstr "Módulos máximos antes de una recompensa garantizada: %(count)"

msgid "infoPage/footer/description/autoOpen/wt"
msgstr "Si no abres los módulos antes de que acabe el evento, se abrirán automáticamente."

msgid "infoPage/footer/description/compensation/wt"
msgstr "Si ya tienes todos los vehículos de la lista de contenido posible del módulo, recibirás oro como compensación por el valor total de los siguientes vehículos que aparezcan en los módulos."

msgid "infoPage/footer/description/guaranteed/wt"
msgstr "Se garantiza la entrega de un vehículo cada %(guaranteed)s módulos. Si los abres sin que aparezca uno de estos vehículos, recibirás un vehículo que no tengas al abrir el %(guaranteed)s.º módulo. Cuando esto suceda, se reiniciará el contador."

msgid "infoPage/footer/description/reroll/wt"
msgstr "Si no te satisfacen las recompensas de un módulo, puedes volver a abrirla para tener la oportunidad de recibir artículos diferentes de la misma lista. Cada módulo solo se puede volver a abrir un número limitado de veces:"

msgid "infoPage/footer/title/autoOpen"
msgstr "Apertura automática"

msgid "infoPage/footer/title/compensation"
msgstr "Compensación"

msgid "infoPage/header/description"
msgstr "¡Abre el módulo y podrás recibir artículos valiosos del juego! Más detalles a continuación."

msgid "multipleRewardView/header/subTitle/"
msgstr "De %(name) (%(boxesCount) módulos abiertos)"

msgid "noBoxesView/description/"
msgstr "Los módulos están disponibles en la tienda del juego"

msgid "noBoxesView/goToButton/"
msgstr "A los módulos disponibles"

msgid "preview/backLabel"
msgstr "A LOS MÓDULOS"

msgid "quantityTitle/boxesAvailable"
msgstr "Módulos disponibles: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "No hay más módulos"

msgid "singleRewardView/tooltip/description/"
msgstr "Si ya tienes todos los vehículos de la lista de posible contenido del módulo, recibirás oro como compensación por los siguientes vehículos que aparezcan en los módulos."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) módulo"
msgstr[1] "%(remainingCount) módulos"
msgstr[2] "%(remainingCount) módulos"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "La recompensa garantizada es un vehículo de la lista de contenido de los módulos.\nSi abres %(remainingCount) módulos sin que aparezca uno de estos vehículos, este aparecerá cuando abras el %(count).º módulo. Cuando esto suceda, se reiniciará el contador."

msgid "tooltip/reroll/text/wt"
msgstr "Volver a abrir un módulo te da la oportunidad de recibir recompensas diferentes de la misma lista."
