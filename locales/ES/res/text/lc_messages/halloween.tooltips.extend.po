msgid "Contact/status/inBattle/halloween"
msgstr "En una batalla de Babylon: Torre oscura"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Dispara un tiro que daña y aturde al objetivo y a todos los vehículos enemigos en un radio de 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Dispara un tiro que roba PV al objetivo y los vehículos enemigos en un radio de 35 m para restaurárselos a tu vehículo."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Dispara un tiro que aturde al objetivo y a todos los vehículos enemigos en un radio de 35 m."

msgid "advanced/hw_damageShield"
msgstr "Protege contra cualquier daño (excepto embestidas, hundimientos y caídas) durante 7 segundos."

msgid "advanced/hw_fastReload"
msgstr "Aumenta la cadencia de tiro/recarga el cargador."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Restaura PV, extingue los incendios, elimina los efectos de aturdimiento y repara los módulos dañados."

msgid "advanced/hw_invisibility"
msgstr "Hace que tu vehículo se vuelva invisible temporalmente para los enemigos, restaura puntos de vida, repara módulos, extingue incendios, elimina los efectos de aturdimiento y cura a todos los tripulantes heridos."

msgid "advanced/hw_teamRepairKit"
msgstr "Repara los módulos, extingue los incendios, elimina los efectos de aturdimiento y restaura parte de los PV de los vehículos aliados dentro del radio de efecto."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Las habilidades de combate te ayudan a luchar con más eficacia en las batallas del evento «Babylon: Torre oscura», completar objetivos y ganar valiosas recompensas. Para equiparlas, haz clic en uno de los espacios de habilidades de combate."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Espacios de habilidades de combate"

msgid "hwShell/alt/description"
msgstr "Hay cierta probabilidad de encontrar %(bold)s en batalla tras destruir a un enemigo."

msgid "hwShell/alt/description/bold"
msgstr "Un proyectil alternativo"
