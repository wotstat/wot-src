msgid "propertyInfo/prop/descr/averageDamage"
msgstr "El índice de daño total causado en relación con el número de batallas libradas durante la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Índice de vehículos destruidos por batallas libradas."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Nivel medio de vehículos usados en la sesión de juego."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "El índice de experiencia total obtenida en relación con el número de batallas libradas durante la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "El índice de daño total bloqueado en relación con el número de batallas libradas durante la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "El índice de daño por detección y daño causado por los aliados cuando destruyes una oruga e inmovilizas el vehículo enemigo o lo aturdes con respecto al número de batallas libradas en la sesión. El delta muestra el efecto de la sesión de juego actual sobre el parámetro total."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "El índice de los parámetros de «Daño causado» y «Daño recibido». El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "El índice de vehículos destruidos por veces que el vehículo del jugador ha sido destruido. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Índice de vehículos detectados por batallas libradas en la sesión de juego."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Porcentaje total de batallas libradas en las que el vehículo del jugador no fue destruido."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Porcentaje de victorias en Batallas aleatorias de la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/wins"
msgstr "El número de victorias en Batallas aleatorias de la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

msgid "propertyInfo/prop/descr/wtr"
msgstr "Los valores medios de WTR para toda la sesión. El delta muestra el efecto de la sesión de juego actual en el parámetro total."

