msgid "comp7/deserter/cancel"
msgstr "Cancelar"

msgid "comp7/deserter/message"
msgstr "El combate aún no ha terminado. Si abandonas la batalla antes de que acabe, decepcionarás a tu equipo.\n{brown_open}Se reducirá tu clasificación y no tendrás acceso a las batallas de este modo. {brown_close}\n¿Seguro que quieres salir de la batalla?"

msgid "comp7/deserter/msgTitle"
msgstr "¡Perderás tus puntos de clasificación!"

msgid "comp7/deserter/submit"
msgstr "Desertar"

msgid "comp7/deserter/title"
msgstr "Deserción del campo de batalla"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Has infringido las reglas del juego en el mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} a las {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Tus puntos de clasificación se han reducido y has recibido un bloqueo temporal para las batallas del modo {whiteSpanish_Open}Asedio{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Has infringido las reglas del juego en el mapa {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} a las {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nHas recibido un bloqueo temporal para las batallas del modo {whiteSpanish_Open}Asedio{whiteSpanish_Close} y se han reducido tus puntos de clasificación."
