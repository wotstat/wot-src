msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Cajas bote del dragón"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "CAJAS BOTE DEL DRAGÓN"

msgid "entryPoint/tooltip/description"
msgstr "Son cajas especiales que contienen artículos únicos y valiosos del juego.\nPuedes conseguirlas en la tienda del juego o en la tienda premium."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Cajas bote del dragón no disponibles temporalmente"

msgid "eventName/lowerCase"
msgstr "Doma al dragón, monta el viento"

msgid "eventName/upperCase"
msgstr "DOMA AL DRAGÓN, MONTA EL VIENTO"

msgid "infoPage/footer/description/compensation"
msgstr "Si ya tienes todos los vehículos de la lista de contenido posible de la caja, recibirás oro como compensación por el valor total de los siguientes vehículos que aparezcan en las cajas bote del dragón."

msgid "infoPage/footer/description/guaranteed"
msgstr "Se garantiza la entrega de un vehículo del nivel VIII o IX cada %(guaranteed0)s cajas bote de dragón. Si las abres sin que aparezca ninguno de estos blindados, recibirás un vehículo del nivel VIII o IX que no tengas al abrir la %(guaranteed0)s&zwnbsp;.ª caja. Después de cada aparición, el contador se reinicia."

msgid "noBoxesView/description/"
msgstr "No tienes ninguna caja.\nPuedes comprarlas en la tienda del juego."
