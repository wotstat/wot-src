msgstr "Consigue puntos de Pase de batalla en el modo {whiteSpanish_open}Última defensa{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Puntos de Pase de batalla"

msgid "mode/last_stand/calendar"
msgstr "El evento durará hasta el %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "El evento acabará el %(date)s."

msgid "mode/last_stand/description"
msgstr "Lucha contra oleadas de enemigos.\nBatallas en vehículos de nivel VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "El rendimiento de tu ordenador es insuficiente para este modo. Puedes tener problemas gráficos y con los movimientos de los vehículos. Es probable que el juego se cuelgue."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Bajo rendimiento"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Bajo rendimiento"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Este modo exige un alto rendimiento del ordenador.\nPuedes experimentar problemas gráficos, al cargar los mapas y con los movimientos de los vehículos. Si el rendimiento es insuficiente, reduce los ajustes de calidad gráfica."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Rendimiento reducido"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Rendimiento reducido"
