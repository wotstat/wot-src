msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Este carro experimental fue un desarrollo posterior del AMX 13. El carro fue sometido a pruebas, pero nunca entró en la producción en masa ni en servicio. Se fabricaron dos vehículos."

