msgid "Panther_II_IGR"
msgstr "Panther II"

msgid "Panther_II_IGR_descr"
msgstr "El vehículo fue concebido en 1943. Se ordenaron dos prototipos con las torretas existentes del Panther I. En 1945 solo uno de ellos había sido construido por la compañía MAN."

msgid "Panther_II_IGR_short"
msgstr "Panther II"

msgid "Pershing_IGR"
msgstr "M26 Pershing"

msgid "Pershing_IGR_descr"
msgstr "El Pershing fue desarrollado para luchar contra carros pesados, y él mismo estaba inicialmente clasificado como pesado. Tras la SGM fue reclasificado como medio. Unos cuantos entraron en combate en la etapa final de la SGM."

msgid "Pershing_IGR_short"
