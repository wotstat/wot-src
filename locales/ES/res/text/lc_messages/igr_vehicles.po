msgid "Maus_IGR"
msgstr "Maus"

msgid "Maus_IGR_descr"
msgstr "Desarrollado desde junio de 1942 hasta julio de 1944, con dos prototipos producidos, de los cuales únicamente uno fue equipado con torreta y armamento."

msgid "Maus_IGR_short"
msgstr "Maus"

