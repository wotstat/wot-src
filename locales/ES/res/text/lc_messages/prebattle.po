msgstr "Los disparos impactan en un punto aleatorio en su interior"

msgid "hints/hint10/spread/header"
msgstr "Círculo de dispersión del cañón"

msgid "hints/hint12/description"
msgstr "La cantidad de blindaje que debe penetrar un proyectil depende del ángulo en el que lo alcanza; ¡el ángulo de impacto es un factor crucial que afecta a la penetración del disparo!"

msgid "hints/hint12/header"
msgstr "Ángulo del blindaje"

msgid "hints/hint12/notPenetrated/description"
msgstr "Ángulo inclinado; blindaje más grueso"

msgid "hints/hint12/notPenetrated/header"
msgstr "No penetrado"

msgid "hints/hint12/penetrated/description"
msgstr "Ángulo recto; blindaje más fino"

msgid "hints/hint12/penetrated/header"
msgstr "Penetración"

msgid "hints/hint13/description"
