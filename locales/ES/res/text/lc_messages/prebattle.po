msgid "hints/confirmDialog/confirm"
msgstr "¡Afirmativo!"

msgid "hints/confirmDialog/message"
msgstr "¡Vas por buen camino para convertirte en un profesional! A partir de ahora, las pantallas de carga de la batalla te mostrarán composiciones de equipo en lugar de consejos para principiantes. Siempre puedes volver a activar los consejos en los Ajustes del menú del juego."

msgid "hints/confirmDialog/title"
msgstr "Nuevas pantallas de carga"

msgid "hints/hint1/description"
msgstr "Presta atención al indicador de penetración en el centro de la retícula del cañón. Su color indica dónde puedes penetrar el blindaje enemigo."

msgid "hints/hint1/green/description"
msgstr "Alta probabilidad de penetración"

msgid "hints/hint1/green/header"
msgstr "Indicador verde"

msgid "hints/hint1/header"
msgstr "Penetración del blindaje"

msgid "hints/hint1/red/description"
msgstr "Baja probabilidad de penetración"

msgid "hints/hint1/red/header"
msgstr "Indicador rojo"

msgid "hints/hint10/description"
msgstr "El cañón del vehículo siempre gira hacia el centro de la pantalla, pero su velocidad de giro limitada implica que puede llevar algún tiempo."

msgid "hints/hint10/header"
msgstr "Retícula del cañón"

msgid "hints/hint10/penetration/description"
msgstr "El verde indica los puntos débiles del blindaje del enemigo"

msgid "hints/hint10/penetration/header"
msgstr "Indicador de penetración"

