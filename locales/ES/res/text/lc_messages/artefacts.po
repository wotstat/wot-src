msgid "deluxeAdditionalInvisibilityDevice/short_special"
msgstr "Aumenta la ocultación de un vehículo en movimiento o estacionario un {colorTagOpen}6{colorTagClose}/{colorTagOpen}8{colorTagClose}/{colorTagOpen}10 %{colorTagClose}"

