msgid "aimingStabilizer_tier2/name"
msgstr "Estabilizador vertical clase 2"

msgid "antifragmentationLining/long_special"
msgstr "Las planchas antifragmentación absorben el daño; esto quiere decir que reducen el daño de las embestidas y los proyectiles de alto explosivo. Las planchas antifragmentación beneficiarán a los carros pesados con un blindaje robusto y un gran potencial de embestida que combaten normalmente a corta distancia."

msgid "antifragmentationLining/name"
msgstr "Planchas antifragmentación"

msgid "antifragmentationLining/short_special"
msgstr "Protegen al vehículo y a la tripulación de proyectiles AE, lesiones, aturdimientos y embestidas"

msgid "antifragmentationLining_tier1/name"
