msgid "adaptationHealthRestore/battleDescr"
msgstr "Restaura %(immediatelyRestore)s de los puntos de vida del vehículo al instante. Durante los %(duration)s s que dura la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida, además de %(restoringCoefficient)s adicionales del daño total recibido en cuanto el efecto de la habilidad termine.\n\n* La recuperación de PV convertida también afecta a los vehículos aliados que se encuentren dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/descr"
msgstr "Restaura %(immediatelyRestore)s de los puntos de vida del vehículo al instante. Durante los %(duration)s s que dura la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida, además de %(restoringCoefficient)s adicionales del daño total recibido en cuanto el efecto de la habilidad termine.\n\n* La recuperación de PV convertida también afecta a los vehículos aliados que se encuentren dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/longDescr"
msgstr "{green_Open}Restaura %(immediatelyRestore)s{green_Close} de los puntos de vida del vehículo al instante. Durante los {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} que dura la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida, además de {green_Open}%(restoringCoefficient)s adicionales del daño total recibido{green_Close} en cuanto el efecto de la habilidad termine.\n\n* La recuperación de PV convertida también afecta a los vehículos aliados que se encuentren dentro de un radio de acción pequeño."

msgid "adaptationHealthRestore/name"
msgstr "Blindaje adaptable"

msgid "adaptationHealthRestore/shortDescr"
msgstr "{green_Open}Restaura %(immediatelyRestore)s{green_Close} de los puntos de vida del vehículo al instante. Durante los {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} que dura la habilidad, todo el daño recibido de proyectiles y habilidades de combate se acumulará y se convertirá en puntos de vida, además de {green_Open}%(restoringCoefficient)s adicionales del daño total recibido{green_Close} en cuanto el efecto de la habilidad termine.\n\n* La recuperación de PV convertida también afecta a los vehículos aliados que se encuentren dentro de un radio de acción pequeño."

msgid "additInvisibilityDeviceBattleBooster/descr"
msgstr "%s a la ocultación del vehículo, parado o en movimiento, cuando se ha equipado Sistema de extracción silencioso (de cualquier clase) o Sistema de extracción de prima"

msgid "additInvisibilityDeviceBattleBooster/gain/deluxe"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/gain/simple"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/long_special"
msgstr "Mejora el efecto del Sistema de extracción silencioso o el Sistema de extracción de prima durante la batalla. La directiva solo funciona si se ha montado el equipamiento correspondiente."

msgid "additInvisibilityDeviceBattleBooster/name"
msgstr "Aislamiento de escape"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Aumenta la ocultación de un vehículo parado o en movimiento"

msgid "additionalInvisibilityDevice/long_special"
msgstr "Su efectividad depende del tipo de vehículo. Aumenta la ocultación de los vehículos parados o en movimiento. Es útil para la detección activa y pasiva desde posiciones peligrosas."

msgid "additionalInvisibilityDevice/name"
msgstr "Sistema de extracción silencioso"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Aumenta la ocultación de un vehículo parado o en movimiento."

msgid "additionalInvisibilityDevice_tier1/name"
msgstr "Sistema de extracción silencioso clase 1"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Sistema de extracción silencioso clase 2"

