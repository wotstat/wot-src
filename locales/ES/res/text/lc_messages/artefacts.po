msgid "afterburning/descr"
msgstr "Potencia la velocidad y aceleración de tu vehículo durante un tiempo limitado."

msgid "afterburning/name"
msgstr "Turbocompresor"

msgid "aimingStabilizer/long_special"
msgstr "Es muy importante reducir la dispersión de tu cañón: cuanto menor sea la dispersión inicial, menor será la retícula y menos tiempo requerirá el cierre completo de retícula. Además, un disparo no preparado (es decir, el realizado sin la retícula completamente cerrada o en movimiento) tiene una mayor oportunidad de impactar al objetivo."

msgid "aimingStabilizer/name"
msgstr "Estabilizador vertical"

msgid "aimingStabilizerBattleBooster/descr"
msgstr "%s a la dispersión tras disparar, durante el movimiento y el giro de la torreta con el Estabilizador vertical, el Sistema de equipamiento estabilizador o el Estabilizador de prima equipados."

msgid "aimingStabilizerBattleBooster/gain/deluxe"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Mejora el efecto del Estabilizador vertical (de cualquier clase), el Sistema de equipamiento estabilizador y el Estabilizador de prima durante la batalla. Para equipar y activar esta directiva, las piezas de equipamiento deben estar montadas en el vehículo."

msgid "aimingStabilizerBattleBooster/name"
msgstr "Estabilizador engrasado"

msgid "aimingStabilizerBattleBooster/short_special"
msgstr "Mejora el efecto del estabilizador"

