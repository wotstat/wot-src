msgid "tank_params/avgParamComment/damage"
msgstr "Daño mínimo-máximo %(units)s"

msgid "tank_params/avgParamComment/maxMutableDamage"
msgstr "Daño mínimo–máximo a 50 m %(units)s"

msgid "tank_params/avgParamComment/maxPiercingPower"
msgstr "Valor mínimo–máximo a 50 m %(units)s"

msgid "tank_params/avgParamComment/minMutableDamage"
msgstr "Daño mínimo–máximo a %(distance)s m %(units)s"

msgid "tank_params/avgParamComment/minPiercingPower"
msgstr "Valor mínimo–máximo a %(distance)s m %(units)s"

msgid "tank_params/avgParamComment/piercingPower"
msgstr "Valor mínimo-máximo %(units)s"

msgid "tank_params/desc/accuracyDispersionCap"
msgstr "La bonificación a la dispersión a 100 m con el nivel máximo de precisión."

msgid "tank_params/desc/accuracyDispersionPerLevel"
msgstr "La bonificación a la dispersión a 100 m por cada nivel de precisión."

msgid "tank_params/desc/accuracyLevelGainTime"
msgstr "Tiempo necesario para obtener un nivel de precisión."

msgid "tank_params/desc/accuracySpeedLimit"
msgstr "Si se supera esta velocidad, no se generan niveles de precisión."

msgid "tank_params/desc/accuracyWhileMovingDispersionCap"
msgstr "La bonificación a la dispersión en movimiento o al girar el casco/la torreta con el nivel máximo de precisión."

msgid "tank_params/desc/activeCoincideceShootingCharge"
msgstr "La cantidad de carga de la Mira electromecánica de coincidencia que se genera por impacto en un vehículo enemigo en el modo combate."

msgid "tank_params/desc/aimingTime"
msgstr "Tiempo hasta que el diámetro de la retícula se reduce en un 60 % (modo estándar/especial)."

msgid "tank_params/desc/aimingTimeCoincidenceElectromechanicalSight"
msgstr "La bonificación al tiempo otorgada por la mira hasta que el diámetro de la retícula se reduzca en un 60 %."

msgid "tank_params/desc/aimingTimeTurbo"
msgstr "El tiempo de apuntamiento adicional necesario en el modo turbo."

msgid "tank_params/desc/attainableSpeed"
msgstr "Velocidad de un vehículo tras 5 segundos de aceleración desde una posición estática a nivel.\nLos valores se muestran para terreno duro/moderadamente blando/blando."

msgid "tank_params/desc/autoReloadTime"
msgstr "Tiempo para la autorrecarga sucesiva de cada proyectil en la recámara."

msgid "tank_params/desc/autoReloadTime/boost"
msgstr "Tiempo estándar para la autorrecarga sucesiva de cada proyectil en la recámara"

msgid "tank_params/desc/autoReloadTime/boost/description"
msgstr "El sistema mejorado reduce el tiempo estándar de autorrecarga del siguiente proyectil al disparar el que está cargado cuando aparece el indicador correspondiente."

msgid "tank_params/desc/autoReloadTime/boost/shortDescription"
msgstr "El sistema de autorrecarga mejorado reduce el tiempo estándar para recargar proyectiles automáticamente."

msgid "tank_params/desc/autoShootClipFireRate"
msgstr "Tiempo entre el disparo del último proyectil del cargador (o de ambos cañones) y la recarga del nuevo cargador. / Número de cañones o proyectiles en el cargador."

msgid "tank_params/desc/autoreloaderSurgeBoostedReloadTime"
msgstr "Tiempo que sustituye al tiempo de recarga restante cuando se usa el mecanismo."

msgid "tank_params/desc/autoreloaderSurgeChargeTimeFast"
msgstr "Tiempo necesario para reponer una carga si el cargador está lleno."

msgid "tank_params/desc/autoreloaderSurgeChargeTimeSlow"
msgstr "Tiempo necesario para reponer una carga si el cargador no está lleno."

msgid "tank_params/desc/autoreloaderSurgeInitCharges"
msgstr "El número de cargas disponibles al principio de la batalla."

msgid "tank_params/desc/autoreloaderSurgeMaxCharges"
msgstr "El número máximo de cargas para acelerar la carga de proyectiles que se pueden tener a la vez."

msgid "tank_params/desc/auxiliaryRocketLauncherAvgDamage"
msgstr "Daño medio causado por un proyectil de lanzacohetes tras un impacto de alta penetración. La dispersión del daño potencial es de +/−25 % del valor medio."

msgid "tank_params/desc/auxiliaryRocketLauncherDispersion"
msgstr "Dispersión caracterizada por la desviación máxima del proyectil respecto del punto de puntería a una distancia de 100 m."

msgid "tank_params/desc/auxiliaryRocketLauncherPenetration"
msgstr "Grosor medio del blindaje penetrado por un proyectil de cohete. La dispersión es de +/−25 % del valor medio."

msgid "tank_params/desc/auxiliaryRocketLauncherReloadTime"
msgstr "Tiempo de recarga del lanzacohetes."

msgid "tank_params/desc/auxiliaryRocketLauncherVelocity"
msgstr "Determina la velocidad de desplazamiento del cohete no guiado."

msgid "tank_params/desc/avgDamage"
msgstr "Daño medio causado por un proyectil estándar tras un impacto de alta penetración. La dispersión del daño potencial es de +/- 25 % del valor medio."

msgid "tank_params/desc/avgDamagePerMinute"
msgstr "La cantidad de daño que se puede causar potencialmente a un vehículo enemigo en un minuto si todos los impactos penetran el blindaje."

msgid "tank_params/desc/avgDamagePerSecond"
msgstr "La cantidad de daño que se le puede infligir a un vehículo enemigo en 1 segundo al disparar continuamente si todos los impactos penetran el blindaje."

msgid "tank_params/desc/avgPiercingPower"
msgstr "El grosor medio penetrado por un proyectil estándar, ajustado a la normalización del proyectil. La dispersión es de +/- 25 % del valor medio."

msgid "tank_params/desc/boosterCoolingTime"
msgstr "El tiempo necesario para que los propulsores se enfríen tras alcanzar el nivel de calor crítico."

msgid "tank_params/desc/boosterDuration"
msgstr "Duración máxima del efecto del propulsor tras su activación."

msgid "tank_params/desc/burstFireRate"
msgstr "Tiempo de recarga entre proyectiles del contenedor./Cantidad de contenedores por cargador./Cantidad de proyectiles en el contenedor."

msgid "tank_params/desc/bustleFeedDamagePerShot"
msgstr "Daño medio causado por un proyectil unitario de alta carga tras un impacto de alta penetración. La dispersión del daño potencial es de ±25 % del valor medio."

msgid "tank_params/desc/bustleFeedMaxSpeed"
msgstr "Reducción de la velocidad de avance nominal del vehículo en el modo de alimentación de munición externa. La velocidad marcha atrás no se ve afectada."

msgid "tank_params/desc/bustleFeedRateOfFire"
msgstr "Reducción del número de disparos por minuto en el modo de alimentación de munición externa."

msgid "tank_params/desc/bustleFeedSwitchingToEASMMode"
msgstr "Tiempo mínimo necesario para preparar el cañón para disparar tras activar el modo Suministro de munición externo. Durante este tiempo, no puedes cambiar de modo."

msgid "tank_params/desc/bustleFeedSwitchingToStandardMode"
msgstr "Tiempo mínimo necesario para preparar el cañón para disparar tras volver al modo estándar. Durante este tiempo, no puedes cambiar de modo."

msgid "tank_params/desc/chargeTime"
msgstr "Tiempo de preparación para disparar con dos cañones simultáneamente./Duración del bloqueo de recarga del cañón tras disparar una salva."

msgid "tank_params/desc/chargeableBurstDispersion"
msgstr "Dispersión del segundo disparo en el modo ráfaga, que consiste en la desviación máxima del proyectil con respecto al punto de apuntamiento a una distancia de 100 m."

msgid "tank_params/desc/chargeableBurstPenetrationCount"
msgstr "Número de impactos penetrantes en vehículos enemigos que se necesitan para activar el modo."

msgid "tank_params/desc/chargeableBurstReload"
msgstr "Tiempo de recarga entre el primer y segundo disparo en el modo ráfaga."

msgid "tank_params/desc/chargeableBurstSize"
msgstr "Número de proyectiles almacenados en el cargador de ráfaga."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Tiempo para reparar una oruga dañada."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Tiempo para reparar una oruga principal/de reserva dañada."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "La velocidad de giro del casco sobre su eje, y la velocidad para cambiar de dirección en movimiento (maniobrabilidad)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "El alcance de visión actual de tu vehículo. El alcance máximo al que puedes detectar vehículos enemigos es de 445 m. Aumentar más el alcance de visión facilita la detección de vehículos enemigos a una distancia de 445 m o menos (modo estándar/especial)."

msgid "tank_params/desc/clipFireRate"
msgstr "Tiempo entre el disparo del último proyectil del cargador (o de ambos cañones) y la recarga del nuevo cargador./Tiempo entre el disparo de un proyectil y la recarga del siguiente proyectil en el cargador, el cañón o el contenedor./Número de cañones o proyectiles en el cargador."

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Duración del efecto de la Mira electromecánica de coincidencia tras su activación."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Tiempo hasta que el estabilizador se pueda usar de nuevo tras su activación."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Duración del estabilizador tras su activación."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Cantidad de proyectiles por minuto sin incluir el tiempo de recarga."

msgid "tank_params/desc/coolingDelay"
msgstr "Tiempo que tarda el cañón en empezar a enfriarse tras disparar."

msgid "tank_params/desc/coolingTime"
msgstr "Tiempo que tarda en enfriarse el cañón cuando se calienta por completo. El cañón puede usarse en este periodo."

msgid "tank_params/desc/damage"
msgstr "Daño causado por un proyectil estándar tras penetrar en el blindaje enemigo."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Retraso antes de que el indicador se pueda usar de nuevo. El tiempo de enfriamiento empieza tras disparar."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Tiempo hasta que el indicador se pueda usar por primera vez tras empezar la batalla."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Tiempo durante el cual los vehículos enemigos marcados permanecen detectados y reciben daño adicional de los proyectiles."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "La cantidad de daño adicional que infligen los proyectiles a los vehículos enemigos marcados."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "La bonificación a la dispersión a 100 m que otorga la mira."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Muestra el tiempo necesario tras un disparo para que el cañón se enfríe bastante para mejorar la precisión."

msgid "tank_params/desc/enginePower"
msgstr "Este parámetro afecta a la aceleración, velocidad punta y velocidad de giro del casco del vehículo."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Este parámetro afecta a la aceleración y rendimiento del vehículo en diferentes tipos de terreno (modo estándar/especial)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "La bonificación a la aceleración del vehículo que otorgan los propulsores."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Este parámetro influye en la aceleración, la velocidad punta la velocidad al girar el casco del vehículo en el modo turbo."

msgid "tank_params/desc/explosionRadius"
msgstr "El radio de daño tras la explosión AE, muestra la capacidad de causar daños a cierta distancia del punto de impacto."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Tiempo añadido a la recarga restante del cargador tras disparar el último proyectil."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "La velocidad del vehículo tal y como se define en sus características técnicas."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "La bonificación al daño medio por minuto en el nivel máximo de eficacia de recarga."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Número máximo de niveles de eficacia de recarga que se pueden acumular."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "La duración de un nivel de eficacia de recarga antes de agotarse."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "El número de niveles de eficiencia de recarga obtenidos al destruir un vehículo enemigo con un proyectil."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "El número de niveles de eficiencia de recarga obtenidos por cada impacto con un proyectil en un vehículo enemigo detectado."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "El valor de reducción del tiempo de carga del cañón por nivel de eficacia de recarga."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "La penalización a la dispersión al girar el cañón en el modo turbo."

msgid "tank_params/desc/gunYawLimits"
msgstr "Ángulos máximos de giro horizontal del cañón (a la izquierda y derecha de la posición por defecto) cuando el casco está parado."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "La bonificación al daño medio por cada nivel de calor acumulado."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Tiempo durante el cual el vehículo no puede disparar ni cambiar de proyectiles."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Tiempo durante el cual el vehículo puede conservar el nivel máximo de calor antes del sobrecalentamiento de carga."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Tiempo necesario para obtener un nivel de calor."

msgid "tank_params/desc/heatingPerShot"
msgstr "La cantidad de calor que genera el cañón con cada disparo."

msgid "tank_params/desc/hullArmor"
msgstr "Espesor del blindaje del casco: frontal / laterales / trasero respectivamente."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "La penalización a la dispersión al girar el casco en el modo turbo."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Este parámetro muestra la cantidad de daño causado por embestidas. Cuando los vehículos chocan, el sistema tiene en cuenta el grosor del blindaje en el punto de impacto, la diferencia de peso entre vehículos y sus velocidades."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Este parámetro muestra la cantidad de daño que recibe la suspensión por embestidas. Cuando los vehículos chocan, el sistema tiene en cuenta el grosor del blindaje en el punto de impacto, la diferencia de peso entre vehículos y sus velocidades."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Muestra la ocultación de un vehículo en movimiento. Cuanto más alto sea el parámetro, más camuflado estará el vehículo. Se indican los siguientes parámetros: de un vehículo en movimiento / de un vehículo en movimiento tras disparar."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Muestra la ocultación de un vehículo parado. Cuanto más alto sea el parámetro, más camuflado estará el vehículo. Se indican los siguientes parámetros: de un vehículo parado / de un vehículo parado tras disparar."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "La cantidad de carga del Posquemador de descarga iónica que se genera por segundo a más de 40 km/h en el modo turbo."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Este parámetro influye en la duración del Posquemador de descarga iónica tras su activación."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Este parámetro influye en la aceleración, velocidad punta y velocidad al girar el casco del vehículo tras activar el Posquemador de descarga iónica."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "La velocidad adicional obtenida tras activar el Posquemador de descarga iónica."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "La cantidad de carga del Posquemador de descarga iónica que se genera por segundo en el modo turbo."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Daño medio causado por un disparo de carga individual tras un impacto de alta penetración. La dispersión del daño potencial es de +/−25 % del valor medio."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Tiempo transcurrido antes de que se complete la recarga y durante el que no se pueden lanzar disparos de carga individual."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Aumento de la dispersión del cañón al lanzar un disparo de carga individual. Se caracteriza por la desviación máxima del proyectil respecto al punto de mira a una distancia de 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "El grosor medio penetrado por un disparo de carga individual, ajustado a la normalización del proyectil. La dispersión es de +/−25 % del valor medio."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Aumento de la cantidad de disparos por minuto al disparar con carga individual (en comparación con los disparos habituales)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Velocidad de un disparo de carga individual."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Número máximo de niveles de precisión que se pueden acumular."

msgid "tank_params/desc/maxHealth"
msgstr "Número de los puntos de durabilidad del vehículo."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "El ángulo máximo en el que pueden girar las ruedas. Afecta a la maniobrabilidad y el manejo del vehículo."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "La penalización a la dispersión en movimiento en el modo turbo."

msgid "tank_params/desc/overheatDuration"
msgstr "Tiempo que tarda en enfriarse por completo el cañón sobrecalentado. El cañón no se puede usar mientras se enfría."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "La cantidad de carga de la Mira electromecánica de coincidencia que se genera por segundo en el modo combate."

msgid "tank_params/desc/piercingPower"
msgstr "Espesor del blindaje que puede penetrar un proyectil estándar ajustado por la normalización del proyectil."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "La velocidad de giro del casco sobre su eje, y la velocidad para cambiar de dirección en movimiento (maniobrabilidad)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "El tiempo necesario para cambiar entre modos depende de la condición del motor. Un motor dañado aumenta el tiempo necesario para cambiar. El cambio no está disponible cuando el motor es destruido."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "El tiempo necesario para cambiar entre modos depende de la condición del motor. Un motor dañado aumenta el tiempo necesario para cambiar. El cambio no está disponible cuando el motor es destruido."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Velocidad para inclinar el casco hacia arriba y hacia abajo mientras el vehículo está en el modo fortín."

msgid "tank_params/desc/pitchLimits"
msgstr "El ángulo máximo vertical de giro del cañón en relación con el casco del vehículo y teniendo en cuenta su suspensión."

msgid "tank_params/desc/powerModeDuration"
msgstr "Tiempo necesario alcanzar la velocidad de avance y la potencia del motor máximas en el modo conducción directa."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Tiempo necesario para activar el modo conducción directa."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "La bonificación a la dispersión a 100 m con precalentamiento completo."

msgid "tank_params/desc/preheatDmgCap"
msgstr "La bonificación al daño medio causado con precalentamiento completo."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Si se supera esta velocidad, el vehículo no genera precalentamiento y puede perder el que tenía."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Tiempo hasta que tu vehículo pase de precalentamiento cero a completo."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Tiempo hasta que tu vehículo vuelva a cero cuando está en precalentamiento completo."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Durante este periodo, el precalentamiento de tu vehículo no aumenta ni disminuye."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "El nivel máximo de carga disponible sin desactivar el limitador."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "La cantidad de carga perdida tras disparar."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "La cantidad de carga que se genera automáticamente por segundo."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "La cantidad de carga que se pierde por segundo tras la activación del limitador hasta que se alcanza el límite."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "El tiempo de espera tras el que se puede volver a activar el limitador."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "El tiempo de espera tras el que se puede volver a activar el limitador."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "La bonificación de daño medio que se otorga con la carga completa cuando se excede el límite."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "El aumento repentino al daño que causan los disparos cuando se excede el límite."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "La penalización a la dispersión a 100 m cuando se excede el límite."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "La bonificación de daño medio que se otorga al alcanzar la carga máxima mientras el limitador está activo."

msgid "tank_params/desc/radioDistance"
msgstr "La comunicación y transmisión de información entre aliados sobre la posición de los vehículos. El alcance de comunicación está representado por un círculo, cuyo radio se establece para este parámetro. Cuando varios círculos se solapan, la información se transmite a cualquier distancia."

msgid "tank_params/desc/reactivationDelay"
msgstr "Tiempo de enfriamiento hasta que los propulsores se puedan usar de nuevo tras su activación."

msgid "tank_params/desc/reactivationLimit"
msgstr "El nivel máximo de calor que se puede alcanzar antes de que se deshabilite la reactivación de los propulsores."

msgid "tank_params/desc/relativeArmor"
msgstr "Un grupo de parámetros que muestra la resistencia del vehículo al daño causado por vehículos enemigos."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Un grupo de parámetros que muestra la efectividad de la ocultación cuando tu vehículo está parado, moviéndose y disparando. El camuflaje aplicado aumenta el parámetro de la ocultación."

msgid "tank_params/desc/relativeMobility"
