msgid "JagdTiger_SdKfz_185"
msgstr "8,8 cm Pak 43 Jagdtiger"

msgid "JagdTiger_SdKfz_185_descr"
msgstr "En 1945 se aumentó la orden de producción del Jagdtiger y el suministro de cañones compatibles fue insuficiente. Como resultado, aproximadamente 20 vehículos fueron equipados con el cañón 8,8 cm PaK 43 L/71."

msgid "JagdTiger_SdKfz_185_long_special"
msgstr "Una plataforma autopropulsada ideal para un cañón que no tiene ninguna desventaja. Su bajo daño por disparo queda compensado con una precisión perfecta, una buena cadencia de tiro y un apuntado rápido. Además, este cazacarros puede sobrevivir en situaciones peligrosas gracias a su cabina bien blindada."

msgid "JagdTiger_SdKfz_185_short"
msgstr "JgTig.8,8 cm"

msgid "JagdTiger_SdKfz_185_short_special"
msgstr "Un excelente cañón con buena precisión, cadencia de disparo y apuntamiento"

