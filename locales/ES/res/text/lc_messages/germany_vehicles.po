msgid "Pz38t_Standardketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. A"

msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Desarrollado por la compañía ČKD para el ejército checoslovaco en 1938. Durante la ocupación alemana, el vehículo entró en servicio en la Wehrmacht, siendo usado en las campañas de Polonia y Francia, así como en el Frente Oriental. El carro estuvo en combate en primera línea del frente hasta mediados de 1942. Se fabricaron aproximadamente 1400 vehículos en ocho modificaciones (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

