msgstr "Jagdpanther II"

msgid "JagdPantherII_descr"
msgstr "Desarrollado sobre la base del Panther II. El vehículo iba a estar equipado con un cañón de 128 mm, con el compartimento de combate localizado en la parte trasera. Existió solo en planos."

msgid "JagdPantherII_short"
msgstr "JPanther II"

msgid "JagdTigerH_cn"
msgstr "Jagdtiger Prototype"

msgid "JagdTigerH_cn_descr"
msgstr "Uno de los dos primeros prototipos del cazacarros pesado Jagdtiger. Se desarrolló a partir del chasis Henschel, mientras que el vehículo que usó el chasis Porsche fue designado Prototype No. 2."

msgid "JagdTigerH_cn_short"
msgstr "Jagdtiger Pr"

msgid "JagdTigerH_cn_short_special"
msgstr "Cañón potente y blindaje fiable"

