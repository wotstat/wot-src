msgid "Contact/status/inBattle/last_stand"
msgstr "Bir Son Direniş savaşında"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Hedefe ve 35 m yarıçapındaki tüm düşman araçlarına hasar veren bir atış yapar."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Can puanını hedeften ve 35 m yarıçapındaki düşman araçlarından çalarak geri kazandıran bir atış yapar."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Hedefi ve 35 m yarıçapındaki tüm düşman araçlarını şoka sokan bir atış yapar."

msgid "advanced/ls_damageShield"
msgstr "10 saniye boyunca çarpma, boğulma ve darbe hariç her türlü hasara karşı korur."

msgid "advanced/ls_doubleDamage"
msgstr "Bir sonraki başarılı atışınız iki kat hasar verir."

msgid "advanced/ls_equipment"
msgstr "Tahtik Cihazlar, Son Direniş savaşlarında daha etkili çatışmanıza, Hedefleri tamamlamanıza ve değerli ödüller kazanmanıza yardımcı olur. Bunları takmak için Taktik Cihaz yuvalarından birine tıklayın."

msgid "advanced/ls_extraDamageSituational"
msgstr "Bir düşman aracına daha yüksek hasar verme şansı sağlar."

msgid "advanced/ls_fastReload"
msgstr "Atış hızını artırır / magazini doldurur."

msgid "advanced/ls_healSituational"
msgstr "Bir düşman aracı yok ettikten sonra biraz can puanı geri kazandırır."

msgid "advanced/ls_invisibility"
msgstr "Geçici olarak düşmanların aracınızı hedeflemesini engeller, can puanı geri kazanır, parçaları onarır, yangını söndürür, şok etkisini kaldırır ve tüm yaralı mürettebat üyelerini iyileştirir."

msgid "advanced/ls_nitro"
msgstr "Geçici olarak aracınızın hareket kabiliyetini artırır."

msgid "advanced/ls_nitroSituational"
msgstr "Bir düşman aracından hasar aldıktan sonra geçici olarak aracınızın hareket kabiliyetini artırır."

msgid "advanced/ls_selfRepairKit"
msgstr "Can puanı geri kazandırır, yangını söndürür, şok etkisini kaldırır ve hasarlı parçaları onarır."

msgid "advanced/ls_teamRepairKit"
msgstr "Hasarlı parçaları onarır, yangını söndürür, şok etkisini kaldırır ve yarıçapı içindeki müttefik araçlara biraz can puanı geri kazandırır."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Özel yuvalara yerleştirilebilen Taktik Cihazlar, Son Direniş savaşlarında daha etkili çatışmanıza, Aşamaları tamamlamanıza ve değerli ödüller kazanmanıza yardımcı olur."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktik Cihaz Yuvaları"
