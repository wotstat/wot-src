msgid "02_malinovka/team1/heavyTank/descr"
msgstr "Bu taktiğin kilit noktası %(a_ht_millMountainPhrase1).%(p)%(a_ht_southernForestPhrase) perdesinin altında ilerleyip harita kenarına mümkün olduğu kadar yakın hareket ederek güvenli şekilde yukarı tırmanabilirsiniz. Ardından hemen %(a_ht_millMountainPhrase2) bölgesini ele geçirmelisiniz. Aracın gövdesini arazide saklayarak buradan ateş edebilirsiniz. Bu dağın kontrolünü ele geçirmek size ayrıca %(a_ht_villagePhrase) yoluna ateş açmanıza ve düşmanın kanadına sarkmanıza imkan sağlayacaktır. Taşlar sizi %(a_ht_northernForestPhrase) bölgesinde saklanan düşmanlardan saklayacaktır. Ele geçirilen orman 2 Üssüne giden yolu açacaktır."

msgid "02_malinovka/team1/heavyTank/title"
msgstr "Değirmen Saldırısı"

msgid "02_malinovka/team1/mediumTank/descr"
msgstr "Bu taktiğin kilit noktası %(a_mt_ledgePhrase1).%(p)%(a_mt_swampPhrase) boyunca orta kanatta ilerleyerek %(a_mt_elevationPhrase) kısmını ele geçirip buradan %(a_mt_ledgePhrase2) üzerindeki düşmanı vurabilirsiniz. Ardından sudan geçerek çıkıntının kenarına yapışıp dağa tırmanan hedeflere ateş edebilirsiniz. %(a_mt_ledgePhrase3) üzerindeki tepelerin ardında ve çalılarda gizlenerek %(a_mt_northernForestPhrase) ve üs yakınındaki düşman araçlarını tespit edip onlara ateş edebilirsiniz. %(a_mt_fieldPhrase) üzerindeki düşmanı kanatlardan yok ettikten sonra savunmasız kalan 2 Üssüne erişebileceksiniz."

msgid "02_malinovka/team1/mediumTank/title"
msgstr "Çıkıntı Saldırısı"

msgid "02_malinovka/team2/heavyTank/descr"
msgstr "Bu taktiğin kilit noktası %(b_ht_millMountainPhrase1).%(p)%(b_ht_southernForestPhrase) perdesinin altında ilerleyip harita kenarına mümkün olduğu kadar yakın hareket ederek güvenli şekilde yukarı tırmanabilirsiniz. Ardından hemen %(b_ht_millMountainPhrase2) bölgesini ele geçirmelisiniz. Aracın gövdesini arazide saklayarak buradan ateş edebilirsiniz. Bu dağın kontrolünü ele geçirmek size ayrıca %(b_ht_villagePhrase) yoluna ateş açmanıza ve düşmanın kanadına sarkmanıza imkan sağlayacaktır. Taşlar sizi %(b_ht_northernForestPhrase) bölgesinde saklanan düşmanlardan saklayacaktır. Ele geçirilen orman, 1 Numaralı Üsse giden yolu açacaktır."

msgid "02_malinovka/team2/heavyTank/title"
msgstr "Değirmen Saldırısı"

msgid "02_malinovka/team2/mediumTank/descr"
msgstr "Bu taktiğin kilit noktası %(b_mt_cowshedsPhrase1).%(p)Sağ kanatta ilerleyerek %(b_mt_northLedgePhrase) üzerinde konum alıp düşmanı ters yönden ateş altına alabilirsiniz. Tespit edilmeden kalarak %(b_mt_fieldPhrase) kenarındaki düşman araçlarına ulaşıp %(b_mt_cowshedsPhrase2) bölgesini ele geçirebilirsiniz. Dikkatli olun ve suya düşmeyin. Binaları siper yaparak üs yakınlarındaki düşman konumlarına saldırabilir ve güvenle %(b_mt_swampPhrase) bölgesine geçip %(b_mt_southernForestPhrase) bölgesindeki hedefleri tespit edebilir ve vurabilirsiniz."

msgid "02_malinovka/team2/mediumTank/title"
msgstr "Tarla Saldırısı"

