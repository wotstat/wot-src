msgid "hint/LSH_FIRE"
msgstr "Duman, düşman araçlarının tespitini ve konumlarının iletilmesini zorlaştırır. Yangın, araçlara hasar verir."

msgid "hint/LSH_FOG"
msgstr "Sis, düşman araçlarının tespitini ve konumlarının iletilmesini zorlaştırır."

msgid "hint/LSH_RAIN"
msgstr "Şiddetli yağmur, düşman araçlarının tespitini ve konumlarının iletilmesini zorlaştırır."

msgid "hint/LSH_SANDSTORM"
msgstr "Kum fırtınaları, düşman araçlarının tespitini ve konumlarının iletilmesini zorlaştırır."

msgid "hint/LSH_SMOKE"
msgstr "Duman, düşman araçlarının tespitini ve konumlarının iletilmesini zorlaştırır."

msgid "hint/PPH_AIMING_01"
msgstr "Araç ve kule hareketi <font color='#EE7000'>topun isabetliliğini</font> azaltır."

msgid "hint/PPH_AIMING_02"
msgstr "Nişangâhın etrafındaki çember <font color='#EE7000'>topun isabetliliğini</font> gösterir. Daha isabetli atış yapmak için biraz bekleyin."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Otomatik Nişan Alma</font> açık. İptal etmek için sağ fare tuşuna tıklayın."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Otomatik Nişan Alma her zaman topunuzu hedefinizdeki aracın <font color='#EE7000'>ortasına</font> yöneltir"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Üssünüz <font color='#EE7000'>ele geçiriliyor</font>! Düşman ekibini püskürtmezseniz savaşı kazanacaklar."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Her düşman aracının <font color='#EE7000'>kendi</font> ele geçirme ilerlemesi vardır"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "Düşman üssünü <font color='#EE7000'>ele geçirmek</font>, savaşı kazanmanın yollarından biridir"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Hasar aldığınızda ele geçirme ilerlemeniz <font color='#EE7000'>sıfırlanır</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Üs çemberini terk ettiğinizde ele geçirme ilerlemeniz <font color='#EE7000'>kaybolur</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Çok sayıda araç üssü <font color='#EE7000'>daha hızlı</font> ele geçirir"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "<font color='#EE7000'>Üçüncü</font> araçtan fazlası üs ele geçirme hızını artırmaz"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Düşman üssü neredeyse ele geçirildi!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Ekibiniz, üs ele geçirme yarışını kazanıyor!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Aracın parçası kritik hasar aldı! Alt paneldeki <font color='#EE7000'>Tamir Çantasını</font> kullanarak onarın."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Aracın parçası kritik hasar aldı! Alt paneldeki <font color='#EE7000'>Tamir Çantasını</font> kullanarak onarın."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Mürettebat üyesi kritik yara aldı! Alt paneldeki <font color='#EE7000'>İlk Yardım Çantası</font> ile iyileştirin."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Mürettebat üyesi kritik yara aldı! Alt paneldeki <font color='#EE7000'>İlk Yardım Çantası</font> ile iyileştirin."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Araç mürettebatı şoka girdi! Alt paneldeki <font color='#EE7000'>İlk Yardım Çantası</font> ile iyileştirin."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Araçta yangın çıktı! Alt paneldeki <font color='#EE7000'>Yangın Söndürücüyü</font> kullanın."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Araçta yangın çıktı! Otomatik <font color='#EE7000'>Yangın Söndürücü</font> devreye girdi."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Aracın parçası kritik hasar aldı. Savaştan önce bir <font color='#EE7000'>Tamir Çantası</font> takmak kritik isabetlere müdahalede yardımcı olur."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Mürettebat üyesi kritik yara aldı! Savaştan önce bir <font color='#EE7000'>İlk Yardım Çantası</font> takmak, mürettebat yaralanmalarına müdahalede yardımcı olur."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Araçta yangın çıktı! Savaştan önce bir <font color='#EE7000'>Yangın Söndürücü</font> takmak yangınlara müdahale etmede yardımcı olur."

msgid "hint/PPH_OTHER_01"
msgstr "<font color='#EE7000'>Tespit edildiniz</font>. Ateş etmek konumunuzu ortaya çıkarabilir!"

msgid "hint/PPH_OTHER_02"
msgstr "Aracınız yok edildi. <font color='#EE7000'>Esc</font> tuşuna basarak ceza almadan savaştan çıkabilirsiniz."

msgid "hint/PPH_OTHER_03"
msgstr "Aracınız yok edildi. Fare tuşuna tıklayarak müttefiklerinizi <font color='#EE7000'>izleyebilirsiniz</font>."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Ampul simgesi</font>, düşmanlar tarafından tespit edildiğinizi gösterir!"

msgid "hint/PPH_OTHER_05"
msgstr "Topunuz hâlâ <font color='#EE7000'>yükleniyor</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Topunuzu ancak nişangâhın etrafındaki çember <font color='#EE7000'>tamamen yeşile</font> döndüğünde ateşleyebilirsiniz"

msgid "hint/PPH_SNIPER_01"
msgstr "Fare tekerini kaydırarak <font color='#EE7000'>Keskin Nişancı moduna</font> geçebilirsiniz"

msgid "hint/PPH_SNIPER_02"
msgstr "Fare tekerini kaydırarak Keskin Nişancı modundan <font color='#EE7000'>çıkabilirsiniz</font>"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>İç yeşil nişangâh</font>, düşmanın zırhını delme olasılığının yüksek olduğunu gösterir"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "İç nişangâh yeşil olsa bile zırhı delmek <font color='#EE7000'>garanti değildir</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Top %100 isabetli değildir, o yüzden atışlar <font color='#EE7000'>her zaman nişangâhın ortasına düşmeyebilir</font>"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "İç nişangâh, düşman zırhını delme olasılığını gösterir. <font color='#EE7000'>Ayarlar kısmından açın</font>."

msgid "penetration/chance/high"
msgstr "Yüksek olasılık"

msgid "penetration/chance/low"
msgstr "Düşük olasılık"

msgid "penetration/chance/medium"
msgstr "Orta olasılık"
