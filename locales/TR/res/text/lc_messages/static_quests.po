msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Herhangi bir seviyeden araçla bir Rastgele Savaş başlatın."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Oyuna hoş geldiniz! Tüm dünyadan diğer fanlarla birlikte savaşlara girin ve muhteşem zaferlerinizi kutlayın!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "İlk Savaş"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Herhangi bir Seviye IV aracı araştırın ve satın alın."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Yeni bir araç satın almak önemli bir olaydır. Her yeni seviyeyle araçlar daha ilginç hale gelir. Eğitimli bir mürettebat da genel oynayışınızı iyileştirecektir."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Seviye IV Araç"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Seviye IV-X araçlarla, herhangi bir özelleştirme ögesi uygulanmış olarak üç Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Araçların dış görünümünü, hazır stillerle veya kamuflaj, yazılar, amblemler ve çıkartmalar kullanıp kendi stilinizi oluşturarak özelleştirebilirsiniz."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Aracın Dış Görünümü"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "İstediğiniz bir mürettebat üyesi için istediğiniz bir yeteneği eğitmeye başlayın."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Mürettebat üyeleri ek yetenekler öğrenerek etkinliklerini artırabilir veya yeni beceriler edinebilirler."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Mürettebat Yetenekleri"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Seviye IV-X araçlarla Rastgele Savaşlarda 150.000 kredi kazanın."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Savaş seviyesi ne kadar yüksekse aracınızın bakımı, mühimmat ikmali, parça ve donanım satın almak için o kadar çok krediye ihtiyacınız olacak."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Kredi Biriktirme"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Herhangi bir Seviye V aracı araştırın ve satın alın."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Seviye V, daha ciddi araçların görülmeye başladığı ve oyun becerilerinizin gerçekten sınandığı seviyedir. Tam eğitimli mürettebat gerçekten işe yarayacaktır."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Seviye V Araç"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Seviye V-X araçlarla, üç parça donanım takılı olarak 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Kaplı Optikler mi İyileştirilmiş Havalandırma mı? Doğru donanım aracınızın güçlü yönlerini takviye ederken zayıf yönlerini telafi edebilir."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Donanım Takma"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Topoğrafya kipinde bir temel senaryo tamamlayın."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Savaş alanında güven kazanmak için yolları, taktikleri, kilit konumlar ve üzerindeki cisimler dâhil haritaları iyi bilmek çok önemlidir."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topoğrafya"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Topoğrafya'daki bir haritada dört gelişmiş senaryo tamamlayın."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Zaman zaman Topoğrafya kipine girerek Rastgele Savaşlar için haritaları inceleyin. Dört senaryo, mekanı farklı açılardan keşfetmenize imkan sunar."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Gelişmiş Topoğrafya"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Seviye V-X araçlarla, etkinleştirilmiş bir Kişisel Yedekle 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Etkinleştirildiğinde her savaştan sonra Savaş DP'sine, Serbest DP ve Mürettebat DP'sine veya krediye ek bonuslar alabilirsiniz."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Kişisel Yedekler"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Seviye V-X araçlarla galip geldiğiniz Rastgele Savaşlar'da kazanılan DP açısından altı kez ekibinizdeki ilk 10 oyuncu arasında yer alın."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Bu görevler başarılı savaş başına beş kat fazla DP kazanmanızı sağlar. Bunun için galip gelip ekibinizde kazanılan DP açısından ilk 10 oyuncu arasına girmelisiniz"

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 adet ×5 DP Görevi"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Bir parça araştırın ve herhangi seviyeden bir araca takın."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Savaş DP'si her savaştan sonra verilir. Savaş DP'si kazanarak aracınızın etkinliğini iyileştiren yeni parçalar araştırın."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Savaş DP'si"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Herhangi bir Seviye VI aracı araştırın ve satın alın."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Sonraki her seviyede araç araştırmak daha çok zaman ve çaba gerektirecek. Serbest DP daha hızlı ilerlemenizi sağlayacak. Eğitimli mürettebat ise çok işe yarar."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Seviye VI Araç"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Herhangi bir harekâttan bir Kişisel Görev tamamlayın."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Harekâtlar, farklı araç türleri için görev zincirleridir. Tamamlandıklarında faydalı ödüller ve özgün araçlar elde edebilirsiniz."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Kişisel Görevler"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Genel Kılavuz kullanarak bir mürettebatı eğitin."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Mürettebat Kitapları, bir veya tüm mürettebat üyelerine belirli miktarda DP ekleyerek mürettebat eğitimini oldukça hızlandırmanızı sağlar."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Mürettebat Kitapları"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Seviye VI-X araçlarla, bir mürettebat yönergesi takılı olarak 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Yönergeler bir savaş için mürettebat yeteneklerini iyileştirir. Yönergeler, sarflar gibi satın alınabilir veya ödül olarak alınabilir."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Mürettebat Yönergeleri"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Oyun içi Dükkândan özel bir Acemi Paketi satın alın."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Altın, Premium araçlar, vb. gibi ihtiyacınız olan her şeyi oyun içi Dükkândan satın alabilirsiniz. Düzenli olarak harika fırsatlar sunan promosyonlar göreceksiniz."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Dükkân"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Seviye VI-X Premium araçlarla 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Bu araçların araştırılması gerekmez. Daha fazla Savaş DP'si, Mürettebat DP'si ve kredi kazanır, yeniden eğitim gerektirmeden mürettebat aktarmanıza imkan sağlar"

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium Araçlar"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Seviye VI-X araçlarla, donanım için bir yönerge takılı olarak 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Yönergeler, takılı donanımın etkinliğini artırmanızı sağlar. Sarf malzemeleri gibi yönergeler de satın alınabilir veya ödül olarak elde edilebilir."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Donanım Yönergeleri"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Seviye VI-X araçlarla Rastgele Savaşlarda kazanılan DP açısından ekibinizde 15 kere ilk 10 oyuncu arasında yer alın."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Bu görevler başarılı savaş başına beş kat fazla DP kazanmanızı sağlar. Bunun için galip gelip ekibinizde kazanılan DP açısından ilk 10 oyuncu arasına girmelisiniz"

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 Adet ×5 DP Görevi"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Herhangi bir Seviye VII aracı araştırın ve satın alın."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Bu araç seviyesi için beceri gereksinimi daha da artıyor. Araçlar çok daha güçlü ve çok daha etkili, aynı rakipleriniz gibi."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Seviye VII Araç"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Seviye VII-X araçlarla, Büyük İlk Yardım Çantası, Büyük Tamir Çantası ve Otomatik Yangın Söndürücü takılı olarak 10 Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Büyük sarf malzemeleri takıldığında hasarlı parçaları küçüklerinden daha hızlı onarır. Ayrıca şok süresini ve yangın olasılığını azaltır. Soğuma süresi de daha kısadır."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Büyük Sarf Malzemeleri"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Herhangi seviyeden bir araçla Rastgele Savaşlarda günün ilk zaferi için iki kat DP alın."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Her araçta günün ilk zaferi için iki kat DP alabilirsiniz. Bu özelliği kullanarak araçlarınızı daha da hızlı yükseltin."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "DP Çarpanı"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Herhangi bir araştırılmamış araç için bir taslak kesiti oluşturun."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Taslaklar, aracın araştırılmasını gereken DP'de indirim sağlayarak hızlandırır. Ödül olarak alınabilir, genel veya ulusal kesitlerden dönüştürülebilir."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Araç Taslakları"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Seviye VII-X araçlarla Rastgele Savaşlarda 20 kere kazanılan DP açısından ekibinizde ilk 10 oyuncu arasında yer alın."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Bu görevler başarılı savaş başına beş kat fazla DP kazanmanızı sağlar. Bunun için galip gelip ekibinizde kazanılan DP açısından ilk 10 oyuncu arasına girmelisiniz"

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 Adet ×5 DP Görevi"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Herhangi bir Seviye VIII aracı araştırın ve satın alın."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Seviye VIII araçlar tüm bilgilerinizi kullanmanızı gerektirir. Düşmanlar rahat vermeyecek, bol heyecan ile oldukça değerli deneyim kazanmanızı sağlayacak."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Seviye VIII Araç"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Herhangi bir parçayı araştırmak için Serbest DP kullanın."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Bir parçayı veya aracı araştırmak için yeterli Savaş DP'niz yoksa herhangi bir araçta kazanabileceğiniz Serbest DP kullanın."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Serbest DP"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Seviye III-X bir araçla alternatif mermiler yükleyin ve bir Rastgele Savaş başlatın."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Zırh Delici, Yüksek Patlayıcı ve Sert Başlıklı Zırh Delici mermiler savaşta farklı durumlarda kullanılır. Avantaj elde etmek için doğru kullanın!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Mühimmat"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Depodan kullanılmayan bir parça satın."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Kullanılmayan parçalar, mermiler, donanım, sarf malzemeleri ve diğer ürünler Depoda saklanır. Fazla ürünleri kredi karşılığında satabilirsiniz."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depo"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Seviye III-X araçlarla Rastgele Savaşlarda 25.000 kredi kazanın."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Kredi, mühimmat ve yeni araçlar satın almada, araçları onarmada ve başka işlerde kullanılır. Nasıl tasarruf edeceğinizi ve akıllıca kullanmayı bilmek önemlidir."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Kredi"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Seviye III-X araçlarla, kullanılabilir tüm yuvalarına sarf malzemeleri takılı olarak üç Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Sarf malzemeleri savaşta kritik araç hasarını düzeltebilir, mürettebatı iyileştirebilir. Sarfları doğru kullanmak savaşta hayatta kalmak için çok önemlidir."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Sarf Malzemeleri"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Seviye III-X araçlarla, herhangi bir donanım takılı olarak üç Rastgele Savaş yapın."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Araçlara, bazı niteliklerini iyileştirmek için donanım takabilirsiniz. Donanım yükü araca ve oyun tarzınıza bağlı olacaktır."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Donanım"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topoğrafya"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Topoğrafya'daki herhangi bir haritada bir senaryo tamamlayın"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Bilinmeyen Bölgeler"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Topoğrafya'daki bir haritada dört temel senaryo tamamlayın"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Keşif Kolu"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Topoğrafya'daki bir haritada dört gelişmiş senaryo tamamlayın"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Coğrafyadan Tam Not"
