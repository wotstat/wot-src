msgid "Contact/status/inBattle/halloween"
msgstr "Babil: Kara Kule savaşında"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Hedefe ve 35 m yarıçapındaki tüm düşman araçlarına hasar verip şoka sokan bir atış yapar."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Can puanını hedeften ve 35 m yarıçapındaki düşman araçlarından çalarak geri kazandıran bir atış yapar."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Hedefi ve 35 m yarıçapındaki tüm düşman araçlarını şoka sokan bir atış yapar."

msgid "advanced/hw_damageShield"
msgstr "7 saniye boyunca çarpma, boğulma ve darbe hariç her türlü hasara karşı korur."

msgid "advanced/hw_fastReload"
msgstr "Atış hızını artırır / magazini doldurur."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Can puanı geri kazandırır, yangını söndürür, şok etkisini kaldırır ve hasarlı parçaları onarır."

msgid "advanced/hw_invisibility"
msgstr "Geçici olarak aracınızı düşmanlara karşı görünmez kılar, can puanı kazandırır, parçaları onarır, yangını söndürür, şok etkisini kaldırır ve tüm yaralı mürettebat üyelerini iyileştirir."

msgid "advanced/hw_teamRepairKit"
msgstr "Hasarlı parçaları onarır, yangını söndürür, şok etkisini kaldırır ve yarıçapı içindeki müttefik araçlara biraz can puanı geri kazandırır."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Savaş Yetenekleri, Babil: Kara Kule savaşlarında daha etkili çatışmanıza, Hedefleri tamamlamanıza ve değerli ödüller kazanmanıza yardımcı olur. Bunları takmak için Savaş Yeteneği yuvalarından birine tıklayın."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Savaş Yeteneği Yuvaları"

msgid "hwShell/alt/description"
msgstr "%(bold)s, bir düşmanı yok ettikten sonra belirli bir olasılıkla savaşta ortaya çıkabilir."

msgid "hwShell/alt/description/bold"
msgstr "Alternatif bir mermi"
