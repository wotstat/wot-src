msgid "vo_sm_char10_m05_stg21_02"
msgstr "Karargâh Subayı: Echo-5 köprübaşı ele geçirildi. Tanklar ilerliyor. Tam ateş desteği verin."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Karargâh Subayı: Tank ilerleyişini desteklemek için hava desteği yönlendirin."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Karargâh Subayı: İstihkâm ekipleri, ilerleyişi devam ettirmek için engelleri temizleyin."

msgid "vo_sm_char10_m05_stg21_05"
