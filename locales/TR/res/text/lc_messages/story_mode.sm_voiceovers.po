msgid "vo_ob_char01_intro_01"
msgstr "Brooks: Tigerlardan nefret ediyorum."

msgid "vo_ob_char01_intro_03"
msgstr "Brooks: Çavuş Brooks, 2. Zırhlı. Biz de bir Tiger'a rastladık."

msgid "vo_ob_char01_intro_03_01"
msgstr "Brooks: Şimdi iki olduk."

msgid "vo_ob_char01_intro_05"
msgstr "Brooks: Bizimle gel. Kasabaya taarruz başladı bile..."

msgid "vo_ob_char01_intro_05_01"
msgstr "Brooks: Acele etmemiz lazım."

msgid "vo_ob_char01_intro_07"
msgstr "Brooks: Onun gibi bir şey."

msgid "vo_ob_char01_intro_09"
msgstr "Brooks: 'Betsy'nin düşmanlarımızın yüreğine korku mu salması gerekiyor?"

msgid "vo_ob_char01_intro_11"
msgstr "Brooks: Saat 3 yönünde düşman!"

msgid "vo_ob_char01_intro_12"
msgstr "Brooks: Önce Stug'u avlayın!"

msgid "vo_ob_char01_intro_17"
msgstr "Brooks: Önce kasabayı ele geçirelim. Sonra bakarız..."

msgid "vo_ob_char01_m01_stg00_01"
msgstr "Brooks: Kaybedecek vakit yok. Yola koyulalım."

msgid "vo_ob_char01_m01_stg00_02"
msgstr "Brooks: Uyan! İlerliyoruz."

msgid "vo_ob_char01_m01_stg00_03"
msgstr "Brooks: Arayı açma, Sherman."

msgid "vo_ob_char01_m01_stg00_04"
msgstr "Brooks: Kasabada bize ihtiyaçları var. Hadi."

msgid "vo_ob_char01_m01_stg00_05"
msgstr "Brooks: İleri, ileri, ileri!"

msgid "vo_ob_char01_m01_stg010_01"
msgstr "Brooks: Saat 12 yönünde kundağı motorlu top. Hemen yok et!"

msgid "vo_ob_char01_m01_stg010_04"
msgstr "Brooks: İşlerini bitirdik! Aferin, Sherman."

msgid "vo_ob_char01_m01_stg011_01"
msgstr "Brooks: Takım, yeni düşman!"

msgid "vo_ob_char01_m01_stg012_02"
msgstr "Brooks: Merkeze git. Odağını kaybetme."

msgid "vo_ob_char01_m01_stg014_01"
msgstr "Brooks: İyi işti. Şimdi son kareyi temizleyelim. İleri!"

msgid "vo_ob_char01_m01_stg015_01"
msgstr "Brooks: Dikkat! Umduğumuzdan daha fazla düşman var!"

msgid "vo_ob_char01_m01_stg015_05"
msgstr "Brooks: Yeni düşman grubu! Şanslı, etrafını sarmalarına izin verme!"

msgid "vo_ob_char01_m01_stg016_02"
msgstr "Brooks: Yardımın için sağ ol. Bu dövüşü kazandık ama önümüzde daha çok savaş var."

msgid "vo_ob_char01_m01_stg016_04"
msgstr "Brooks: Az bekle, Betsy."

msgid "vo_ob_char01_m01_stg01_01"
msgstr "Brooks: Taarruz başladı bile. Acele etmemiz lazım."

msgid "vo_ob_char01_m01_stg01_03"
msgstr "Brooks: Büyükbabanın şerefine mi?"

msgid "vo_ob_char01_m01_stg01_07"
msgstr "Brooks: Sherman, bizi takip et. Daha fazla zaman kaybetmeyelim."

msgid "vo_ob_char01_m01_stg02_04"
msgstr "Brooks: Kulağa fazla Almanca geliyor."

msgid "vo_ob_char01_m01_stg03_01"
msgstr "Brooks: Düşman saat 2 yönünde! Atış serbest!"

msgid "vo_ob_char01_m01_stg03_02"
msgstr "Brooks: Düşman saat 12 yönünde! Atış serbest!"

msgid "vo_ob_char01_m01_stg04_01"
msgstr "Brooks: Yok edildi. Kasabaya gidelim."

msgid "vo_ob_char01_m01_stg04_03"
msgstr "Brooks: Korku salıyor… Ama pek orijinal değil."

msgid "vo_ob_char01_m01_stg05_01"
msgstr "Brooks: Hadi hadi hadi! Müttefiklerimiz bizi bekliyor."

msgid "vo_ob_char01_m01_stg06_01"
msgstr "Brooks: Saat 12 yönünde iki rakip. Ateş!"

msgid "vo_ob_char01_m01_stg07_02"
msgstr "Brooks: Gözlerini dört aç, Komutan! Sağdan dolaşalım."

msgid "vo_ob_char01_m01_stg08_01"
msgstr "Brooks: Bu bir Alman Panzeri. AP mermiler ateşle!"

msgid "vo_ob_char01_m02_stg01_01"
msgstr "Brooks: Haydi gidelim. Herkes tetikte olsun. Hava kuvvetleri kasabayı vuruyor."

msgid "vo_ob_char01_m02_stg01_01_01"
msgstr "Brooks: Ama yine de bir sürü düşman aracı olacak."

msgid "vo_ob_char01_m02_stg01_03"
msgstr "Brooks: Fazla heyecanlanma MacLeod. Bu..."

msgid "vo_ob_char01_m02_stg01_03_01"
msgstr "Brooks: Hay lanet! İşte birinci taarruz takımımız. Tiger mıydı acaba?"

msgid "vo_ob_char01_m02_stg02_01"
msgstr "Brooks: İşte geliyorlar!"

msgid "vo_ob_char01_m02_stg02_03"
msgstr "Brooks: Odağını kaybetme, MacLeod!"

msgid "vo_ob_char01_m02_stg03_01"
msgstr "Brooks: Diğer kıyıda bir VK! Atış serbest!"

msgid "vo_ob_char01_m02_stg04_02"
msgstr "Brooks: Bir hedef için yalvardığını ilk kez duyuyorum."

msgid "vo_ob_char01_m02_stg05_01"
msgstr "Brooks: Köprü kapalı. Etrafından dolaşmamız lazım."

msgid "vo_ob_char01_m02_stg05_03"
msgstr "Brooks: Göreve hazırlanırken iyimser olmak faydalıdır. Yakınlarda bir nehir geçidi var."

msgid "vo_ob_char01_m02_stg05_04"
msgstr "Brooks: Sen de tam bir falcı çıktın. Nasıl yaptın bunu?"

msgid "vo_ob_char01_m02_stg05_06"
msgstr "Brooks: O hâlde bizi neden uyarmadın? Düşmandı o."

msgid "vo_ob_char01_m02_stg06_01"
msgstr "Brooks: Saat 12 yönünde düşman!"

msgid "vo_ob_char01_m02_stg06_01_01"
msgstr "Brooks: Şanslı, mermilerini boşa harcama! Rastgele ateş etme, optikleri kullan."

msgid "vo_ob_char01_m02_stg06_03"
msgstr "Brooks: İşlerini bitirip devam edelim."

msgid "vo_ob_char01_m02_stg06_03_01"
msgstr "Brooks: İkinci taarruz takımını yakalamamız lazım."

msgid "vo_ob_char01_m02_stg07_02"
msgstr "Brooks: Paniğe kapılma yeter. Tigersa Tiger."

msgid "vo_ob_char01_m02_stg07_02_01"
msgstr "Brooks: İnanılmaz tehlikeliler."

msgid "vo_ob_char01_m02_stg07_04"
msgstr "Brooks: Taktın gene madalyana! Sadece nişan için mi buradasın?"

msgid "vo_ob_char01_m02_stg08_01"
msgstr "Brooks: Haberler iyi: İkinci gruba yetiştik."

msgid "vo_ob_char01_m02_stg08_02"
msgstr "Brooks: Lanet olsun! Etrafını sar! Etrafını sar!"

msgid "vo_ob_char01_m02_stg08_04"
msgstr "Brooks: Lanet olsun! Adam gibi ateş et!"

msgid "vo_ob_char01_m02_stg08_05"
msgstr "Brooks: Takım, dikkat: Tüm müttefik gruplar yok edildi."

msgid "vo_ob_char01_m02_stg08_05_01"
msgstr "Brooks: Artık tek başımızayız. Görevi tamamlamamız gerekiyor. Haydi harekete geçelim."

msgid "vo_ob_char01_m02_stg09_01"
msgstr "Brooks: Düşman! Saat 12 yönünde!"

msgid "vo_ob_char01_m02_stg09_03"
msgstr "Brooks: Bunların sonuncu olduğunu sanmıyorum."

msgid "vo_ob_char01_m02_stg09_03_01"
msgstr "Brooks: Keşif daha fazla Tigerla karşılaşacağımızı söylemişti."

msgid "vo_ob_char01_m02_stg10_01"
msgstr "Brooks: Yok artık... Bu bir Panther değil. King Tiger."

msgid "vo_ob_char01_m02_stg10_03"
msgstr "Brooks: Bunun için kesinlikle bir madalya almalısın."

msgid "vo_ob_char01_m02_stg10_05"
msgstr "Brooks: Önden delemiyoruz. Etrafını saralım."

msgid "vo_ob_char01_m02_stg11_01"
msgstr "Brooks: Yürü! Nişan almalarına izin verme!"

msgid "vo_ob_char01_m02_stg11_03"
msgstr "Brooks: Lanet olsun! Paletim isabet aldı. Hareket edemiyorum!"

msgid "vo_ob_char02_intro_02"
msgstr "MacLeod: Ama çok güzel yanıyorlar."

msgid "vo_ob_char02_intro_04"
msgstr "MacLeod: O Tiger da gayet güzel yanıyordu."

msgid "vo_ob_char02_intro_06"
msgstr "MacLeod: Hey, Çavuş Brooks - 'Yıldırım' ne iş?"

msgid "vo_ob_char02_intro_06_01"
msgstr "MacLeod: Elimizde sözcükten başka bir şey yokken düşmanın kalbine korku salmak için mi?"

msgid "vo_ob_char02_intro_08"
msgstr "MacLeod: Hmm. Benim Firefly'a da isim koymak lazım. Ona 'Betsy' diyeceğim."

msgid "vo_ob_char02_intro_10"
msgstr "MacLeod: Ninemin şerefine. Ondan çok korkardım..."

msgid "vo_ob_char02_intro_13"
msgstr "MacLeod: Hey, Sherman, uyanık mısın ha? Tam zamanında!"

msgid "vo_ob_char02_intro_14"
msgstr "MacLeod: Seni böcek!"

msgid "vo_ob_char02_intro_15"
msgstr "MacLeod: İyi atıştı, Sherman! Ayağa kalktığına sevindim!"

msgid "vo_ob_char02_intro_16"
msgstr "MacLeod: Bana iki puan daha yaz! Çavuş Brooks, madalyam nerede?"

msgid "vo_ob_char02_intro_18"
msgstr "MacLeod: Tipik..."

msgid "vo_ob_char02_m01_stg00_01"
msgstr "MacLeod: Sherman, haydi harekete geçelim."

msgid "vo_ob_char02_m01_stg00_02"
msgstr "MacLeod: Sherman, uyan."

msgid "vo_ob_char02_m01_stg00_03"
msgstr "MacLeod: Orada öylece dikilme! Sür!"

msgid "vo_ob_char02_m01_stg00_04"
msgstr "MacLeod: Tankın gene arıza falan mı yaptı?"

msgid "vo_ob_char02_m01_stg00_05"
msgstr "MacLeod: Acele edelim, yoksa şovu kaçıracağız!"

msgid "vo_ob_char02_m01_stg010_02"
msgstr "MacLeod: Ahh, seni lanet... Bunun hesabını soracağım!"

msgid "vo_ob_char02_m01_stg010_03"
msgstr "MacLeod: Şanslı, optiklerini kullan!"

msgid "vo_ob_char02_m01_stg010_03_01"
msgstr "MacLeod: Ah, ağzımdan çıkıverdi. Sanırım bundan sonra sana Şanslı diyeceğim!"

msgid "vo_ob_char02_m01_stg012_01"
msgstr "MacLeod: Her şey yolunda, Şanslı. Buralarda senin tarzının eksikliğini çekiyorduk."

msgid "vo_ob_char02_m01_stg013_01"
msgstr "MacLeod: Vay canına! Herkese yetecek kadar var."

msgid "vo_ob_char02_m01_stg015_02"
msgstr "MacLeod: Biraz rekabete ne dersin, Şanslı?"

msgid "vo_ob_char02_m01_stg015_03"
msgstr "MacLeod: Devam et, yak onları!"

msgid "vo_ob_char02_m01_stg015_04"
msgstr "MacLeod: Aleve bak be!"

msgid "vo_ob_char02_m01_stg016_01"
msgstr "MacLeod: Bayağı sıkıydı! Saygımı kazandın."

msgid "vo_ob_char02_m01_stg016_01_01"
msgstr "MacLeod: Böyle bir şey görmeyeli bayağı olmuştu!"

msgid "vo_ob_char02_m01_stg016_03"
msgstr "MacLeod: Hey, Çavuş Brooks, bizim madalya işi ne oldu?"

msgid "vo_ob_char02_m01_stg016_05"
msgstr "MacLeod: Ha!"

msgid "vo_ob_char02_m01_stg01_02"
msgstr "MacLeod: Sherman için de bir isim bulalım."

msgid "vo_ob_char02_m01_stg01_04"
msgstr "MacLeod: Hah! Adı Ruaraidh'di."

msgid "vo_ob_char02_m01_stg01_05"
msgstr "MacLeod: Düşmanı korkutacağı kesin."

msgid "vo_ob_char02_m01_stg01_05_01"
msgstr "MacLeod: Ama dilin dönmeyecek diye endişeleniyorum!"

msgid "vo_ob_char02_m01_stg01_06"
msgstr "MacLeod: Pekâlâ, Sherman, hadi gidelim. Gösteri başladı bile!"

msgid "vo_ob_char02_m01_stg02_01"
msgstr "MacLeod: Yanından geç, Sherman."

msgid "vo_ob_char02_m01_stg02_02"
msgstr "MacLeod: Yakalanırsan hız kaybedersin ve kolay bir hedef olursun."

msgid "vo_ob_char02_m01_stg02_03"
msgstr "MacLeod: 'Battlewagon' olabilir mi? Bu ad nasıl?"

msgid "vo_ob_char02_m01_stg03_03"
msgstr "MacLeod: Hadi bakalım! Şu külüstürde birkaç delik daha açalım!"

msgid "vo_ob_char02_m01_stg04_02"
msgstr "MacLeod: Peki 'Ölüm Makinesi' nasıl?"

msgid "vo_ob_char02_m01_stg04_04"
msgstr "MacLeod: Thunderbolt'un dediğine bak!"

msgid "vo_ob_char02_m01_stg05_02"
msgstr "MacLeod: Bizimkiler ellerinden geleni yapıyor! Ne görkemli alev gösterisi ama!"

msgid "vo_ob_char02_m01_stg06_02"
msgstr "MacLeod: Ateş, Ölüm Makinesi, ateş!"

msgid "vo_ob_char02_m01_stg06_03"
msgstr "MacLeod: Daha kısa bir ad lazım."

msgid "vo_ob_char02_m01_stg06_04"
msgstr "MacLeod: Hadisene! Kuleni çevir! Kızart şu külüstürleri!"

msgid "vo_ob_char02_m01_stg07_01"
msgstr "MacLeod: Of be! Kıl payı kurtulduk."

msgid "vo_ob_char02_m01_stg09_01"
msgstr "MacLeod: Bizden kaçamazsınız! Peşlerinden gidelim…"

msgid "vo_ob_char02_m01_stg09_01_01"
msgstr "MacLeod: Biçerdöver? Biçerdöver nasıl?"

msgid "vo_ob_char02_m02_stg01_02"
msgstr "MacLeod: Av başlasın!"

msgid "vo_ob_char02_m02_stg01_02_01"
msgstr "MacLeod: Evet, Şanslı, bugün MacLeod'un 'Tiger Avcısı' unvanını senden aldığı gün olacak!"

msgid "vo_ob_char02_m02_stg01_04"
msgstr "MacLeod: Yok. Delik boyutları farklı. Bunlar orta tankmış."

msgid "vo_ob_char02_m02_stg02_02"
msgstr "MacLeod: Pfff... Küçük lokma. İlginç bir şey yok."

msgid "vo_ob_char02_m02_stg02_04"
msgstr "MacLeod: Emredersiniz! Arayı açma, Şanslı!"

msgid "vo_ob_char02_m02_stg03_02"
msgstr "MacLeod: Pek akıllıca davranmadılar. Optiklerimizle onları ördek gibi avlarız."

msgid "vo_ob_char02_m02_stg04_01"
msgstr "MacLeod: İşte ikincisi geliyor. Hey, Şanslı! Bari bir tane de bana bırak, olur mu?"

msgid "vo_ob_char02_m02_stg04_03"
msgstr "MacLeod: Lanet olsun! Çok mu yüksek sesle söyledim?"

msgid "vo_ob_char02_m02_stg05_02"
msgstr "MacLeod: Bu kadar karamsar olma, Çavuş! Şimdi bir geçit açılacak."

msgid "vo_ob_char02_m02_stg05_05"
msgstr "MacLeod: Gözlerim keskindir. Uçağı gördüm."

msgid "vo_ob_char02_m02_stg05_07"
msgstr "MacLeod: Valla mı? Bizimkilerden sandım."

msgid "vo_ob_char02_m02_stg06_02"
msgstr "MacLeod: Poligondayız sanki. Akıllarından ne geçiyor?"

msgid "vo_ob_char02_m02_stg07_01"
msgstr "MacLeod: Arayı kapatmaya çalışan onlar olacak galiba."

msgid "vo_ob_char02_m02_stg07_01_01"
msgstr "MacLeod: Çok dolambaçlı yola girdiler. Senin nehir geçidinden."

msgid "vo_ob_char02_m02_stg07_01_02"
msgstr "MacLeod: O Tigerlerin üstünde bizim isimlerimiz var."

msgid "vo_ob_char02_m02_stg07_03"
msgstr "MacLeod: Bu da iyi bir şey."

msgid "vo_ob_char02_m02_stg07_03_01"
msgstr "MacLeod: Madalya almak için kaç tane patlatmam lazım?"

msgid "vo_ob_char02_m02_stg07_05"
msgstr "MacLeod: Umrumda değil."

msgid "vo_ob_char02_m02_stg07_05_01"
msgstr "MacLeod: Anama göndermek istiyorum sadece. Mutlu olsun, değil mi?"

msgid "vo_ob_char02_m02_stg07_05_02"
msgstr "MacLeod: Tüm komşularımıza gösterir. Benimle gurur duyar."

msgid "vo_ob_char02_m02_stg07_05_03"
msgstr "MacLeod: Sonunda."

msgid "vo_ob_char02_m02_stg08_03"
msgstr "MacLeod: Amma dayanıklı bir it bu."

msgid "vo_ob_char02_m02_stg08_03_01"
msgstr "MacLeod: Şanslı, zayıf noktalarına nişan al! Yanları ve arkası!"

msgid "vo_ob_char02_m02_stg08_04"
msgstr "MacLeod: Bu güzel yanıyor!"

msgid "vo_ob_char02_m02_stg08_05"
msgstr "MacLeod: Amma dayanıklı bir it bu! Şanslı, zayıf noktalarını kolla."

msgid "vo_ob_char02_m02_stg08_05_01"
msgstr "MacLeod: Karnına nişan al. Ön zırh altı her zaman incedir!"

msgid "vo_ob_char02_m02_stg08_06"
msgstr "MacLeod: Amma dayanıklı bir it bu! Şanslı, zayıf noktalarını kolla!"

msgid "vo_ob_char02_m02_stg08_07"
msgstr "MacLeod: Karnına nişan al. Ön zırh altı her zaman incedir!"

msgid "vo_ob_char02_m02_stg08_08"
msgstr "MacLeod: Kupolalara nişan al. Buraları vurması zor ama delmesi kolay."

msgid "vo_ob_char02_m02_stg09_02"
msgstr "MacLeod: Şanslı, hareket etmeyi unutma. Yoksa seni zayıf noktalarından vururlar."

msgid "vo_ob_char02_m02_stg09_02_01"
msgstr "MacLeod: Ya da gövdeni tank hurdalarının arkasına saklayabilirsin."

msgid "vo_ob_char02_m02_stg09_02_02"
msgstr "MacLeod: O zaman seni avlayamazlar. Sağlam bir kulen var."

msgid "vo_ob_char02_m02_stg09_04"
msgstr "MacLeod: Şu keşifçi çocuklar... Herhalde hiçbir şey bilmiyorlar."

msgid "vo_ob_char02_m02_stg09_04_01"
msgstr "MacLeod: Başka kim olabilir ki? Pantherler mi?"

msgid "vo_ob_char02_m02_stg10_02"
msgstr "MacLeod: Bundan daha önce hiç görmemiştim."

msgid "vo_ob_char02_m02_stg10_04"
msgstr "MacLeod: He ya, sonunda!"

msgid "vo_ob_char02_m02_stg10_06"
msgstr "MacLeod: Şanslı! Yanlar! Arka! Zayıf noktaları vur!"

msgid "vo_ob_char02_m02_stg11_02"
msgstr "MacLeod: Bu mankafa bizim Shermanlara yetişemez."

msgid "vo_ob_char02_m02_stg11_04"
msgstr "MacLeod: Şanslı, işlerini bitir. Hemen!"

msgid "vo_ob_char02_m02_stg12_01"
msgstr "MacLeod: Brooks! Lanet olsun Brooks, cevap ver!"

msgid "vo_ob_char02_m02_stg13_01"
msgstr "MacLeod: Etraflarını sar! Zayıf noktalarına vur!"

msgid "vo_ob_char02_m02_stg13_02"
msgstr "MacLeod: Şanslı, yanlarına ve arkalarına geç!"

msgid "vo_ob_char02_m02_stg13_03"
msgstr "MacLeod: Kule yalnızca önden dayanıklı. Hareket etmeye devam et!"

msgid "vo_ob_char02_m02_stg14_01"
msgstr "MacLeod: İşte bu."

msgid "vo_ob_char02_m02_stg14_02"
msgstr "MacLeod: Yanıyorlar. Çok güzel yanıyorlar."

msgid "vo_ob_char02_m02_stg14_03"
msgstr "MacLeod: Tiger Avcısı: Bu unvan artık resmen senin, dostum."

msgid "vo_sm_char01_m03_stg01_02"
msgstr "Brooks: Burası Karargâh. Çavuş Brooks'tan Tiger Avcılarına."

msgid "vo_sm_char01_m03_stg01_02_01"
msgstr "Brooks: Şehir ve banliyöleri mayınlarla dolu. Dikkatli gidin."

msgid "vo_sm_char01_m03_stg01_04"
msgstr "Brooks: Bunu duyduğuma sevindim, MacLeod."

msgid "vo_sm_char01_m03_stg01_04_01"
msgstr "Brooks: Tetikte olun. Yol boyunca devasa mayın tarlalarıyla karşılaşacaksınız."

msgid "vo_sm_char01_m03_stg01_06"
msgstr "Brooks: Neyi ovacakmışım?"

msgid "vo_sm_char01_m03_stg03_02"
msgstr "Brooks: Lucky'nin de totemi olduğunu nereden çıkardın?"

msgid "vo_sm_char01_m03_stg04_02"
msgstr "Brooks: Kendinize çok güvenmeyin sakın. Aynı hedefe nişan alın. Birlikte hareket edin."

msgid "vo_sm_char01_m03_stg07_03"
msgstr "Brooks: Kocamış mı? Ciddi misin?"

msgid "vo_sm_char01_m03_stg07_05"
msgstr "Brooks: MacLeod, senden sadece altı yaş daha büyüğüm."

msgid "vo_sm_char01_m03_stg08_02"
msgstr "Brooks: Bence kibarlık ediyorlar, tüm konuşmaları senin yapmana izin veriyorlar MacLeod!"

msgid "vo_sm_char01_m03_stg10_02"
msgstr "Brooks: MacLeod, durum raporu ver."

msgid "vo_sm_char01_m03_stg10_04"
msgstr "Brooks: Bildiğimiz yaşlı MacLeod."

msgid "vo_sm_char01_m03_stg11_02"
msgstr "Brooks: Sende Lucky var. Her türlü nazarlıktan daha fazla şans getiriyor."

msgid "vo_sm_char01_m03_stg11_02_01"
msgstr "Brooks: Beyler, alternatif yol bulun!"

msgid "vo_sm_char01_m03_stg14_02"
msgstr "Brooks: Avcılar, dikkat!"

msgid "vo_sm_char01_m03_stg14_02_01"
msgstr "Brooks: Müttefik bombardıman uçakları konumunuza yaklaşıyor. Dikkatli olun."

msgid "vo_sm_char01_m03_stg14_02_02"
msgstr "Brooks: O düşman tanklarıyla aranızdaki mesafeyi koruyun."

msgid "vo_sm_char01_m03_stg15_02"
msgstr "Brooks: İyi misiniz?"

msgid "vo_sm_char01_m03_stg18_02"
msgstr "Brooks: Tavsiye yok, MacLeod. Ama hava desteğimiz var. Pilota ulaşıyorum şimdi."

msgid "vo_sm_char01_m03_stg21_02"
msgstr "Brooks: Hedefte kal MacLeod. Temizlememiz gereken son bir meydan var."

msgid "vo_sm_char01_m03_stg21_02_01"
msgstr "Brooks: Batıl inançlarını sonra çay içerken tartışırız."

msgid "vo_sm_char01_m03_stg21_04"
msgstr "Brooks: Dediğin gibi olsun."

msgid "vo_sm_char01_m03_stg25_03"
msgstr "Brooks: Salaklık etme, bana şanslı nazarlık filan lazım değil."

msgid "vo_sm_char01_m03_stg25_05"
msgstr "Brooks: Planlama ve Strateji, MacLeod, Planlama ve Strateji."

msgid "vo_sm_char01_m03_stg26_02"
msgstr "Brooks: Masabaşı nesi?"

msgid "vo_sm_char01_m03_stg28_03"
msgstr "Brooks: Hay lanet, istihbarat bundan bahsetmemişti..."

msgid "vo_sm_char01_m03_stg28_07"
msgstr "Brooks: Elimizden geleni yapıyoruz."

msgid "vo_sm_char01_m03_stg30_02"
msgstr "Brooks: Eagle One hayatta bilgisi aldım. Teşekkürler çocuklar."

msgid "vo_sm_char01_m03_stg30_03"
msgstr "Brooks: Haklısın MacLeod, bazen o şanslı nazarlıklara ihtiyacımız var galiba."

msgid "vo_sm_char01_m03_stg30_03_01"
msgstr "Brooks: Ve evet bende de var. Aparatlı çıngırak."

msgid "vo_sm_char01_m03_stg30_05"
msgstr "Brooks: (gülüyor)"

msgid "vo_sm_char01_m03_stg32_04"
msgstr "Brooks: Lucky, harekete geçme zamanı. Buraya gezmeye gelmedik."

msgid "vo_sm_char01_m03_stg32_05"
msgstr "Brooks: İlerle Lucky! Bu çatışmada her saniye önemli."

msgid "vo_sm_char01_m03_stg32_06"
msgstr "Brooks: Lucky, tamamlamamız gereken bir görevimiz var. Haydi harekete geçelim."

msgid "vo_sm_char01_m03_stg33_02"
msgstr "Brooks: Betsy gerçekten bunu dedi mi?"

msgid "vo_sm_char01_m03_stg34_01"
msgstr "Brooks: Zaman aleyhimize işliyor. Kahramanlığa kalkışmayın."

msgid "vo_sm_char01_m03_stg34_01_01"
msgstr "Brooks: Mümkünse her zaman düşmanı mengenede sıkıştırın. Onlar çırpınsın, siz yanlardan vurun."

msgid "vo_sm_char01_m03_stg40_01"
msgstr "Brooks: Size takviye gönderiyorum. Dayanın."

msgid "vo_sm_char01_m03_stg40_02"
msgstr "Brooks: Destek yolda. Yakında orada olur."

msgid "vo_sm_char01_m03_stg40_03"
msgstr "Brooks: Yeni müttefik tanklar yolda."

msgid "vo_sm_char01_m03_stg42_05"
msgstr "Brooks: Her şey yoluna girdi, komutan. Dikkat çekmeyin ve ilerlemeye devam edin."

msgid "vo_sm_char01_m03_stg42_06"
msgstr "Brooks: Bu tankı dikkatli kullanın. Yedeklerimiz azalıyor."

msgid "vo_sm_char01_m03_stg42_07"
msgstr "Brooks: Bir şansınız daha var. İyi değerlendirin."

msgid "vo_sm_char01_m04_stg01_02"
msgstr "Brooks: Burası Karargâh. Ben Çavuş Brooks."

msgid "vo_sm_char01_m04_stg01_04"
msgstr "Brooks: Yok, açmayacaklar."

msgid "vo_sm_char01_m04_stg01_04_01"
msgstr "Brooks: Umarım."

msgid "vo_sm_char01_m04_stg02_02"
msgstr "Brooks: Hayır. Büyük ve ağır bir şey. Müttefikler birkaç girişimde bulundu bile."

msgid "vo_sm_char01_m04_stg02_02_01"
msgstr "Brooks: Birkaç tank takımı gönderdiler. Hiçbiri dönmedi."

msgid "vo_sm_char01_m04_stg03_02"
msgstr "Brooks: Hayır, istihbarat, hedefimizin hâlâ şehirde olduğunu bildiriyor."

msgid "vo_sm_char01_m04_stg05_01"
msgstr "Brooks: Bekleyin! Şimdi risk alma zamanı değil! Odaklanmanız gereken farklı bir göreviniz var."

msgid "vo_sm_char01_m04_stg06_02"
msgstr "Brooks: Şu elinizdeki kozu kullanmanızı öneririm."

msgid "vo_sm_char01_m04_stg07_01"
msgstr "Brooks: Karargâhtan Storm Petrel'e. Cevap ver."

msgid "vo_sm_char01_m04_stg07_03"
msgstr "Brooks: Hedef, C3 karesindeki köprüde bulunan bir King Tiger."

msgid "vo_sm_char01_m04_stg08_03"
msgstr "Brooks: Bekle MacLeod. Çok riskli."

msgid "vo_sm_char01_m04_stg08_03_01"
msgstr "Brooks: Birlikte çalışın. Tiger'ı hareketsiz bırakın. Storm Petrel bir sorti daha yapacak."

msgid "vo_sm_char01_m04_stg08_03_02"
msgstr "Brooks: Tiger'ı hareketsiz bırakın. Storm Petrel bir sorti daha yapacak."

msgid "vo_sm_char01_m04_stg13_03"
msgstr "Brooks: Net bilgimiz yok MacLeod."

msgid "vo_sm_char01_m04_stg13_03_01"
msgstr "Brooks: Deneysel bir şey. Bir prototip. İyi bir prototip."

msgid "vo_sm_char01_m04_stg14_02"
msgstr "Brooks: MacLeod, bunun için zamanın yok. Bu senin derdin değil."

msgid "vo_sm_char01_m04_stg15_01"
msgstr "Brooks: Ara sokakları kullanıp atlat. Bennett'a da koordinatları ver."

msgid "vo_sm_char01_m04_stg15_03"
msgstr "Brooks: Storm Petrel."

msgid "vo_sm_char01_m04_stg17_02"
msgstr "Brooks: Typ 205."

msgid "vo_sm_char01_m04_stg17_04"
msgstr "Brooks: Neden 'Minik Fare'?"

msgid "vo_sm_char01_m04_stg19_02"
msgstr "Brooks: O, istihbarat. Şimdiye üsse dönmüş olmaları gerekiyordu."

msgid "vo_sm_char01_m04_stg23_02"
msgstr "Brooks: Özür dilerim MacLoad. Ağzımdan kaçıverdi işte."

msgid "vo_sm_char01_m04_stg24_06"
msgstr "Brooks: Olabilir ama ayarlamak biraz zaman alacak."

msgid "vo_sm_char01_m04_stg26_02"
msgstr "Brooks: Gizli operasyondu."

msgid "vo_sm_char01_m04_stg26_02_01"
msgstr "Brooks: Ama o Jagdtiger'ı illa kendin halletmek istedin."

msgid "vo_sm_char01_m04_stg26_04"
msgstr "Brooks: Cephe taarruzlarında takılıp kaldılar."

msgid "vo_sm_char01_m04_stg27_01"
msgstr "Brooks: Bombardıman uçakları taarruza hazırlanıyor şimdi. Havai fişek gösterisine hazırlanın."

msgid "vo_sm_char01_m04_stg28_02"
msgstr "Brooks: MacLeod, ne zamandan beri dırdır eder oldun?"

msgid "vo_sm_char01_m04_stg30_03"
msgstr "Brooks: İlk Tigerları olduğunu nereden çıkardın? Onu neden bu göreve getirdim sanıyorsun?"

msgid "vo_sm_char01_m04_stg31_02"
msgstr "Brooks: İyi bir ekip oldunuz MacLeod."

msgid "vo_sm_char01_m04_stg33_02"
msgstr "Brooks: Hay lanet! Lucky, aman dikkatli ol ve... bol şans!"

msgid "vo_sm_char01_m04_stg35_01"
msgstr "Brooks: Takviyeler konumunuza doğru geliyor."

msgid "vo_sm_char01_m04_stg35_01_01"
msgstr "Brooks: Kurtardığınız o müttefik tanklar. MacLeod, çabaların boşa gitmedi."

msgid "vo_sm_char01_m04_stg42_02"
msgstr "Brooks: Yeni bir grup müttefik geldi."

msgid "vo_sm_char01_m04_stg42_02_01"
msgstr "Brooks: Umarım onların yardımıyla bu Minik Fareyi alaşağı etmek daha kolay olur."

msgid "vo_sm_char01_m04_stg42_03"
msgstr "Brooks: Unutmayın sakın, son atış bizim olmalı."

msgid "vo_sm_char01_m04_stg42_03_01"
msgstr "Brooks: Bizim avımız olmalı. Lucky, Bennett, bizi utandırmayın."

msgid "vo_sm_char01_m04_stg47_01"
msgstr "Brooks: Müthişsiniz dostlar. Tahliye için ekip gönderiyorum."

msgid "vo_sm_char01_m04_stg47_01_01"
msgstr "Brooks: MacLeod, sizi ve Fareyi çıkarmamız lazım. Bizim elimize geçmesi çok önemli."

msgid "vo_sm_char01_m04_stg47_01_02"
msgstr "Brooks: Madalyaları hak ettiniz."

msgid "vo_sm_char01_m04_stg47_03"
msgstr "Brooks: Peki ne istersin o zaman MacLeod? Yeni bir rütbe mi?"

msgid "vo_sm_char02_m03_stg01_01"
msgstr "MacLeod: Evet beyler, harekete geçip şu kasabayı temizleme zamanı geldi!"

msgid "vo_sm_char02_m03_stg01_03"
msgstr "MacLeod: Brooks mu?! Çavuş Brooks mu?! İşte bu! Emin ellerdeyiz!"

msgid "vo_sm_char02_m03_stg01_05"
msgstr "MacLeod: Emret komutanım!"

msgid "vo_sm_char02_m03_stg01_05_01"
msgstr "MacLeod: Çocuklar, ilk atışınızı yapmadan önce şu uğurlu paralarınızı sıkıca bir ovun! "

msgid "vo_sm_char02_m03_stg01_07"
msgstr "MacLeod: Ne var? Batıl inanç değil, sadece gelenek!"

msgid "vo_sm_char02_m03_stg02_01"
msgstr "MacLeod: İşte kumrularımız geliyor."

msgid "vo_sm_char02_m03_stg02_01_01"
msgstr "MacLeod: En fazla düşman yok edene ilk tur İskoç 'çayı' benden!"

msgid "vo_sm_char02_m03_stg02_01_02"
msgstr "MacLeod: Lucky, hadi şu iş nasıl yapılır gösterelim!"

msgid "vo_sm_char02_m03_stg03_01"
msgstr "MacLeod: Çok sessiz, hiç hoşlanmadım. Karşımızda niye kimse yok?"

msgid "vo_sm_char02_m03_stg03_01_01"
msgstr "MacLeod: Her neyse... Lucky, dökül bakalım. Senin totemin ne?"

msgid "vo_sm_char02_m03_stg03_03"
msgstr "MacLeod: Hepimizin iyi şans için kullandığı yollar var, değil mi Lucky?"

msgid "vo_sm_char02_m03_stg03_03_01"
msgstr "MacLeod: Belki bir dans? Çatışmaya dalmadan önce biraz hoplamak mesela?"

msgid "vo_sm_char02_m03_stg04_01"
msgstr "MacLeod: Hah şimdi oldu! Bu tipler savaşacak gibi görünüyorlar."

msgid "vo_sm_char02_m03_stg05_01"
msgstr "MacLeod: Bilge konuştu, kocamış Brooks. Lucky, şunun için bir el atsana!"

msgid "vo_sm_char02_m03_stg05_01_01"
msgstr "MacLeod: Ben canavarın dikkatini çekeceğim, sen de sağına sız."

msgid "vo_sm_char02_m03_stg05_01_02"
msgstr "MacLeod: Güzel bir sürpriz hazırlayalım, var mısın?"

msgid "vo_sm_char02_m03_stg06_01"
msgstr "MacLeod: Bu da amma çetin cevizmiş, Lucky! Parçala onu!"

msgid "vo_sm_char02_m03_stg07_01"
msgstr "MacLeod: Şunun kaçmasına izin vermeyin! Tüm sürprizimizin içine edecek!"

msgid "vo_sm_char02_m03_stg07_02"
msgstr "MacLeod: Oldu ve bitti!"

msgid "vo_sm_char02_m03_stg07_04"
msgstr "MacLeod: Sadece takılıyorum işte sayın \"gomtanım\"!"

msgid "vo_sm_char02_m03_stg07_06"
msgstr "MacLeod: Tamam, tamam, biliyorum."

msgid "vo_sm_char02_m03_stg08_01"
msgstr "MacLeod: Çocuklar, hayrola? Bugün ağzınızı bıçak açmıyor?"

msgid "vo_sm_char02_m03_stg08_03"
msgstr "MacLeod: Ha!"

msgid "vo_sm_char02_m03_stg09_00"
msgstr "MacLeod: Anlaşılan bu kargaşada arı kovanına çomak soktuk."

msgid "vo_sm_char02_m03_stg09_00_01"
msgstr "MacLeod: Lucky, gövdeni şu tepeciklerin veya yanmış düşmanların arkasına saklamayı unutma."

msgid "vo_sm_char02_m03_stg09_00_02"
msgstr "MacLeod: Sadece kulen görünsün, tankının en sağlam kısmı orası."

msgid "vo_sm_char02_m03_stg09_01"
msgstr "MacLeod: Evet, bu ciddi bir rakip, şakası yok."

msgid "vo_sm_char02_m03_stg09_01_01"
msgstr "MacLeod: Doğrudan baş edemeyiz o yüzden plana uyalım."

msgid "vo_sm_char02_m03_stg09_01_02"
msgstr "MacLeod: Ben dikkatini çekeceğim, sen de kanadına sız. Aman kendine dikkat et, Lucky."

msgid "vo_sm_char02_m03_stg09_02"
msgstr "MacLeod: Nişangâhını sana çevirirse kahramanlık etmeye kalkışma, hemen kaç."

msgid "vo_sm_char02_m03_stg09_02_01"
msgstr "MacLeod: Topu, Shermanlarımızı kıtır kıtır doğrar."

msgid "vo_sm_char02_m03_stg09_03"
msgstr "MacLeod: Sen meşgul et, ben de dalıp arkadan ısırayım."

msgid "vo_sm_char02_m03_stg10_01"
msgstr "MacLeod: Of be, amma zordu!"

msgid "vo_sm_char02_m03_stg10_03"
msgstr "MacLeod: Henüz tek bir Tiger bile görmedik. Kimin en iyi olduğunu belirlemek için onlara ihtiyacımız var!"

msgid "vo_sm_char02_m03_stg10_05"
msgstr "MacLeod: Yaşlı! Ha!"

msgid "vo_sm_char02_m03_stg11_01"
msgstr "MacLeod: Aman, durun çocuklar!"

msgid "vo_sm_char02_m03_stg11_01_01"
msgstr "MacLeod: Mayın var. Brooks, sen de orada nazarlık diye gülüp duruyorsun."

msgid "vo_sm_char02_m03_stg11_01_02"
msgstr "MacLeod: Burada şansa çok ihtiyacımız var!"

msgid "vo_sm_char02_m03_stg12_01"
msgstr "MacLeod: Hey Lucky! Farklı bir yol buldum. Haydi devam edelim."

msgid "vo_sm_char02_m03_stg12_01_01"
msgstr "MacLeod: MacLeod'unuz olmasa ne yapardınız acaba?"

msgid "vo_sm_char02_m03_stg12_02"
msgstr "MacLeod: Gece olana kadar burada kalırdınız herhâlde! Ha!"

msgid "vo_sm_char02_m03_stg12_03"
msgstr "MacLeod: Oo! Yan yol bulmuşsun! Harika!"

msgid "vo_sm_char02_m03_stg12_03_01"
msgstr "MacLeod: Ben de akşama kadar burada istihkâmcıları bekleyeceğiz diye düşünüyordum."

msgid "vo_sm_char02_m03_stg13_01"
msgstr "MacLeod: Şuna bak Lucky! İki Tiger! Yarışma devam ediyor."

msgid "vo_sm_char02_m03_stg14_01"
msgstr "MacLeod: Ama bu sokak çok dar. Tiger'ın ön zırhını delmek kolay değil."

msgid "vo_sm_char02_m03_stg14_03"
msgstr "MacLeod: Güzel! Bekle bak şimdi şahane bir iş göreceksin."

msgid "vo_sm_char02_m03_stg14_03_01"
msgstr "MacLeod: Gökteki dostlarımız şu çelik canavarları cerrah gibi alacak."

msgid "vo_sm_char02_m03_stg15_01"
msgstr "MacLeod: Off, o neydi öyle?! Çok gürültülüydü!"

msgid "vo_sm_char02_m03_stg15_01_01"
msgstr "MacLeod: Off, o neydi öyle?!"

msgid "vo_sm_char02_m03_stg15_03"
msgstr "MacLeod: Evet, tek parçayız ama uğurlu paramı düşürdüm!"

msgid "vo_sm_char02_m03_stg15_03_01"
msgstr "MacLeod: Bir de az önce burada olan bazı binaları göremiyorum."

msgid "vo_sm_char02_m03_stg16_01"
msgstr "MacLeod: Lucky! Bak, şu ikinci Tiger hâlâ ayakta."

msgid "vo_sm_char02_m03_stg16_01_01"
msgstr "MacLeod: Şu yeni aralıktan faydalanalım. İki taraftan sıkıştıralım."

msgid "vo_sm_char02_m03_stg17_01"
msgstr "MacLeod: Güzel atış! Hanemize bir Tiger daha yazdık!"

msgid "vo_sm_char02_m03_stg18_01"
msgstr "MacLeod: Şu işe bak! Başka Tigerlar da var! Bu kadar hediyeyi hak edecek ne yaptık acaba?"

msgid "vo_sm_char02_m03_stg18_01_01"
msgstr "MacLeod: Hay lanet, burası hâlâ çok kalabalık. Brooks, tavsiyen var mı?"

msgid "vo_sm_char02_m03_stg19_01"
msgstr "MacLeod: Bu adamın tarzını sevdim! Lucky, planımıza uyalım. Şu yeni geçidi kullan."

msgid "vo_sm_char02_m03_stg19_01_01"
msgstr "MacLeod: Ben önden bastıracağım, sen de yanına sız."

msgid "vo_sm_char02_m03_stg20_01"
msgstr "MacLeod: Şu keratayı kızgın tavadaymış gibi dans ettirelim."

msgid "vo_sm_char02_m03_stg20_01_01"
msgstr "MacLeod: İkimiz de yükleyene kadar bekle ki darbenin hangi taraftan geleceğini bilemesin."

msgid "vo_sm_char02_m03_stg20_02"
msgstr "MacLeod: Önden sağlam görünüyorlar. Oysa yanları ve arkaları yumuşak ve tatlı!"

msgid "vo_sm_char02_m03_stg21_01"
msgstr "MacLeod: Lucky, sana şans getiren bir şey vardır mutlaka. Belki de..."

msgid "vo_sm_char02_m03_stg21_03"
msgstr "MacLeod: Gelenekler, Brooks. Batıl inançlar değil."

msgid "vo_sm_char02_m03_stg21_05"
msgstr "MacLeod: Peki, bu büyük turu tamamlama zamanı geldi. Eagle One, duyuyor musun?"

msgid "vo_sm_char02_m03_stg21_05_01"
msgstr "MacLeod: Bize kuş bakışı ne gördüğünü söyle. Meydanda dolanan kaç hayranımız var?"

msgid "vo_sm_char02_m03_stg22_02"
msgstr "MacLeod: Bu çocuğu sevdim!"

msgid "vo_sm_char02_m03_stg22_02_01"
msgstr "MacLeod: Tankçı olmaması ne yazık. Ekibimize çok iyi uyardı."

msgid "vo_sm_char02_m03_stg23_01"
msgstr "MacLeod: Son uçuşunu yaptı galiba."

msgid "vo_sm_char02_m03_stg23_01_01"
msgstr "MacLeod: Eagle One, dikkatli ol, gökten düşman avcı uçakları dalıyor."

msgid "vo_sm_char02_m03_stg24_01"
msgstr "MacLeod: Mayın! Mayınlardan nefret ediyorum. Lucky başka yol bul. Ben dikkatlerini çekeceğim."

msgid "vo_sm_char02_m03_stg25_01"
msgstr "MacLeod: Bizim Lucky anlaşılan şanslı yıldız altında doğmuş."

msgid "vo_sm_char02_m03_stg25_01_01"
msgstr "MacLeod: Ya sen, Brooks? Senin nazarlığın var mı?"

msgid "vo_sm_char02_m03_stg25_02"
msgstr "MacLeod: Cebinde at nalı? Ya da aparatlı bir çıngırak?"

msgid "vo_sm_char02_m03_stg25_04"
msgstr "MacLeod: Dur bi dakika. Doğru mu tahmin ettim yani?"

msgid "vo_sm_char02_m03_stg26_01"
msgstr "MacLeod: İşte çocuklar, efsaneler bu işi böyle yapar!"

msgid "vo_sm_char02_m03_stg26_01_01"
msgstr "MacLeod: Yaralanmamış olsaydı Brooks da burada bizimle olurdu!"

msgid "vo_sm_char02_m03_stg26_01_02"
msgstr "MacLeod: Üçümüz birlikte... Her neyse, yapacak bir şey yok. O şimdi masabaşı..."

msgid "vo_sm_char02_m03_stg26_03"
msgstr "MacLeod: Masabaşı efsanesi, komutanım!"

msgid "vo_sm_char02_m03_stg27_01"
msgstr "MacLeod: Hay bin lanet! Bi' topçunun işe karışmadığı kalmıştı."

msgid "vo_sm_char02_m03_stg27_01_01"
msgstr "MacLeod: Lucky, orada put gibi durma, hareket et! Kendi adamlarını vurma riskine girmeye zorlayalım."

msgid "vo_sm_char02_m03_stg28_02"
msgstr "MacLeod: Brooks, bu davetsiz misafirler nereden geldi?"

msgid "vo_sm_char02_m03_stg28_02_01"
msgstr "MacLeod: Brifingde bunların bahsi geçmiyordu."

msgid "vo_sm_char02_m03_stg28_04"
msgstr "MacLeod: Hay canını sevdiğimin istihbaratı... Geleneklerine çok sadıklar."

msgid "vo_sm_char02_m03_stg28_04_01"
msgstr "MacLeod: Eagle One, kaçını üstümüzden alabilirsin?"

msgid "vo_sm_char02_m03_stg28_06"
msgstr "MacLeod: Eagle One, tamam! Eagle One! Hay lanet!"

msgid "vo_sm_char02_m03_stg28_06_01"
msgstr "MacLeod: Brooks, şunlara yardım edecek avcı uçaklarının olduğunu söyle!"

msgid "vo_sm_char02_m03_stg28_08"
msgstr "MacLeod: Lucky, onu görebiliyor musun? Hadi Eagle One, atlat şunları. Hay lanet olası!"

msgid "vo_sm_char02_m03_stg28_08_01"
msgstr "MacLeod: Lucky, haydi buradaki işi bitirelim. İki taraftan sıkıştıracağız. Kibarlık yok."

msgid "vo_sm_char02_m03_stg29_01"
msgstr "MacLeod: Galiba beklediğimizden fazla misafir var."

msgid "vo_sm_char02_m03_stg29_01_01"
msgstr "MacLeod: Aynı hedefe odaklanalım. Lucky, teker teker avlayacağız."

msgid "vo_sm_char02_m03_stg29_01_02"
msgstr "MacLeod: Puding olarak da şu topçudan bir parça koyarız."

msgid "vo_sm_char02_m03_stg30_01"
msgstr "MacLeod: Oh be... Ne zordu ama. Aa, şuna bak! uğurlu paramı buldum!"

msgid "vo_sm_char02_m03_stg30_04"
msgstr "MacLeod: Dur, dur, dur. Ne dedin??? Ciddi misin? Mutlaka görmem lazım!"

msgid "vo_sm_char02_m03_stg31_01"
msgstr "MacLeod: Hadi Lucky, devam, yoksa çayımız İskoçya kışı gibi soğuk ve sevimsiz olacak."

msgid "vo_sm_char02_m03_stg31_02"
msgstr "MacLeod: Haydi Lucky, harekete geçelim! O Tigerlar kendi kendine imha olmayacak!"

msgid "vo_sm_char02_m03_stg31_03"
msgstr "MacLeod: Lucky, burada mayın yok. Harekete geç."

msgid "vo_sm_char02_m03_stg31_04"
msgstr "MacLeod: Lucky, buraya pikniğe gelmedik. Hadi gidelim!"

msgid "vo_sm_char02_m03_stg31_05"
msgstr "MacLeod: Lucky, orada put gibi durma. Topçu uyumaz."

msgid "vo_sm_char02_m03_stg32_01"
msgstr "MacLeod: Lucky, şu mayınların etrafından bir yol bulalım."

msgid "vo_sm_char02_m03_stg32_02"
msgstr "MacLeod: Lucky, orada öyle durma. Alternatif bir yol bul."

msgid "vo_sm_char02_m03_stg32_03"
msgstr "MacLeod: Lucky, o mayınları baka baka ortadan kaldıramazsın."

msgid "vo_sm_char02_m03_stg32_03_01"
msgstr "MacLeod: Kendimize yan yol bulalım."

msgid "vo_sm_char02_m03_stg33_01"
msgstr "MacLeod: Nenem derdi ki 'Her zaman düşmanının kanadına geç, yanlarını zırh delici mermilerle doldur'."

msgid "vo_sm_char02_m03_stg33_03"
msgstr "MacLeod: Yani onun gibi bir şey."

msgid "vo_sm_char02_m03_stg35_01"
msgstr "MacLeod: Unutma: Düşmanı iki taraftan sıkıştır, her zaman birimize zayıf bir tarafını açık eder."

msgid "vo_sm_char02_m03_stg35_02"
msgstr "MacLeod: Kapanı kapatalım. İki taraftan kıstıralım."

msgid "vo_sm_char02_m03_stg35_02_01"
msgstr "MacLeod: Böylece mutlaka bir zayıf noktayı açık edecekler."

msgid "vo_sm_char02_m03_stg35_03"
msgstr "MacLeod: Kuralına göre yapalım: İki taraftan saldıracağız, birimiz mutlaka o tatlı ve ince yan zırhtan koparma şansı yakalayacak!"

msgid "vo_sm_char02_m03_stg36_01"
msgstr "MacLeod: Nereye gittiğine dikkat et Lucky!"

msgid "vo_sm_char02_m03_stg36_02"
msgstr "MacLeod: Mayınlara dikkat et!"

msgid "vo_sm_char02_m03_stg36_03"
msgstr "MacLeod: Dur! Bu mayınlar tanklarımızı pek sevmiyor!"

msgid "vo_sm_char02_m03_stg36_04"
msgstr "MacLeod: Mayınlar. Mayınlardan nefret ediyorum."

msgid "vo_sm_char02_m03_stg36_05"
msgstr "MacLeod: Aman dikkat! Bu mayınların siniri tepesinde."

msgid "vo_sm_char02_m03_stg36_06"
msgstr "MacLeod: İleride mayın var! En iyisi başka bir yol bulalım."

msgid "vo_sm_char02_m03_stg37_01"
msgstr "MacLeod: Lucky! Sıkı patlamaydı! İyi misin?"

msgid "vo_sm_char02_m03_stg37_02"
msgstr "MacLeod: Dur bakalım! Böyle acele acele nereye gidiyorsun?"

msgid "vo_sm_char02_m03_stg37_02_01"
msgstr "MacLeod: Paletlerini tamir et ve geri geri çık!"

msgid "vo_sm_char02_m03_stg37_03"
msgstr "MacLeod: Lucky, çukur kazmak istiyorsan daha kolay yolları da var!"

msgid "vo_sm_char02_m03_stg37_04"
msgstr "MacLeod: Sert hatlar, Lucky. Bu mayınlar çok sinsi."

msgid "vo_sm_char02_m03_stg37_05"
msgstr "MacLeod: Eh, bu da mayın bulmanın bir yolu tabii. En iyi yol değil ama işe yarıyor."

msgid "vo_sm_char02_m03_stg37_06"
msgstr "MacLeod: Lucky, kendine gel. Hepimiz bir, iki mayına denk geldik."

msgid "vo_sm_char02_m03_stg38_01"
msgstr "MacLeod: Dikkat et Lucky! Bir sonraki mayın sonun olabilir."

msgid "vo_sm_char02_m03_stg38_02"
msgstr "MacLeod: Lucky, palet tamir etmeyi seviyorsun galiba."

msgid "vo_sm_char02_m03_stg38_03"
msgstr "MacLeod: Ne?! Yine mi? Lucky, bu mayın aşkı nereden geliyor?"

msgid "vo_sm_char02_m03_stg39_01"
msgstr "MacLeod: Hay lanet, bir tankımızı daha kaybettik."

msgid "vo_sm_char02_m03_stg39_02"
msgstr "MacLeod: Kahretsin! Birimiz daha gitti!"

msgid "vo_sm_char02_m03_stg39_03"
msgstr "MacLeod: Bir müttefik tank kaybettik. Şimdi daha çok çabalamamız gerekiyor."

msgid "vo_sm_char02_m03_stg41_01"
msgstr "MacLeod: Tankım imha oldu. Yenisiyle hemen döneceğim! Özletmem kendimi."

msgid "vo_sm_char02_m03_stg41_02"
msgstr "MacLeod: Hay lanet! Bu favori tankımdı. Peki, ikinci tur geliyor şimdi!"

msgid "vo_sm_char02_m03_stg41_03"
msgstr "MacLeod: Vuruldum. Sorun yok, başka bir taneyle döneceğim. Umarım favori rengimden vardır."

msgid "vo_sm_char02_m03_stg41_04"
msgstr "MacLeod: Hiç iyi değil. Bir tank daha gitti. Bana bir dakika müsaade, döneceğim hemen."

msgid "vo_sm_char02_m03_stg41_05"
msgstr "MacLeod: Yine yeni bir tanka ihtiyacım var."

msgid "vo_sm_char02_m03_stg41_05_01"
msgstr "MacLeod: Sıkı durun, 'MacLeod da nereye kayboldu?' diyene kadar döneceğim."

msgid "vo_sm_char02_m03_stg42_01"
msgstr "MacLeod: Kendine geldin mi? Göster kendini!"

msgid "vo_sm_char02_m03_stg42_02"
msgstr "MacLeod: Haydi canlan, ikinci tur başlıyor! Halledersin sen."

msgid "vo_sm_char02_m03_stg42_03"
msgstr "MacLeod: Tank bayisi değiliz. Buna iyi bak lütfen."

msgid "vo_sm_char02_m03_stg42_04"
msgstr "MacLeod: Ha! Dur durak bilmiyorsun, değil mi? Dahasına varsın yani!"

msgid "vo_sm_char02_m04_stg01_01"
msgstr "MacLeod: Tiger Avcıları buluşma noktasında."

msgid "vo_sm_char02_m04_stg01_01_01"
msgstr "MacLeod: Brooks, açıktan adını kullanabilirsem, orada mısın?"

msgid "vo_sm_char02_m04_stg01_03"
msgstr "MacLeod: Brooks, ne bu ciddilik? Hepimiz sen olduğunu biliyoruz."

msgid "vo_sm_char02_m04_stg01_03_01"
msgstr "MacLeod: Şimdi söyle bakalım, müttefiklerimiz şehirde olduğumuzu biliyor mu?"

msgid "vo_sm_char02_m04_stg01_03_02"
msgstr "MacLeod: Üstümüze ateş açmayacaklar, değil mi?"

msgid "vo_sm_char02_m04_stg01_05"
msgstr "MacLeod: Bu cevap hiç güven vermiyor!"

msgid "vo_sm_char02_m04_stg02_01"
msgstr "MacLeod: Brooks, ne arıyoruz burada? Bu döküntüleri değil inşallah?"

msgid "vo_sm_char02_m04_stg03_01"
msgstr "MacLeod: Birisi dönmüş. Bir müttefik tank görüyorum. Aksiyonu kaçırdık mı yoksa?"

msgid "vo_sm_char02_m04_stg03_03"
msgstr "MacLeod: Ah canımın içi istihbarat..."

msgid "vo_sm_char02_m04_stg04_01"
msgstr "MacLeod: Hay lanet! Bir tane daha var."

msgid "vo_sm_char02_m04_stg04_01_01"
msgstr "MacLeod: Bu bir... Brooks, yine o canavar. King Tiger."

msgid "vo_sm_char02_m04_stg04_01_02"
msgstr "MacLeod: Lucky, ne yapacağımızı biliyoruz. Hazır mısın?"

msgid "vo_sm_char02_m04_stg06_01"
msgstr "MacLeod: Ne önerirsin? Kaçalım mı? Burada mı bırakalım?"

msgid "vo_sm_char02_m04_stg08_02"
msgstr "MacLeod: İyi denemeydi ama görünüşe göre..."

msgid "vo_sm_char02_m04_stg09_01"
msgstr "MacLeod: Lucky, hadi şu kocamış Brooks'un yüzünü güldürecek bir şey yapalım."

msgid "vo_sm_char02_m04_stg09_01_01"
msgstr "MacLeod: Ön veya arka sürücü dişlisine nişan al. Düşmanı durdurmanın en kolay yolu."

msgid "vo_sm_char02_m04_stg09_01_02"
msgstr "MacLeod: Ön veya arka sürücü dişlisine nişan al. Düşmanı durdurmanın en kolay yolu."

msgid "vo_sm_char02_m04_stg10_01"
msgstr "MacLeod: Ateş etmeye devam et. Eninde sonunda o palet çıkacak."

msgid "vo_sm_char02_m04_stg10_01_01"
msgstr "MacLeod: ve bu araç balkabağına dönüşecek."

msgid "vo_sm_char02_m04_stg10_01_02"
msgstr "MacLeod: Ateş etmeye devam et. Eninde sonunda o palet çıkacak."

msgid "vo_sm_char02_m04_stg11_01"
msgstr "MacLeod: İşte böyle! Harika atış. Martı, hamle sırası sende."

msgid "vo_sm_char02_m04_stg13_01"
msgstr "MacLeod: Eski biyoloji hocam Mrs. McFuddlebrains gibisin."

msgid "vo_sm_char02_m04_stg13_02"
msgstr "MacLeod: Lucky, bir tane daha King Kedicik gelmeden buradan gidelim."

msgid "vo_sm_char02_m04_stg13_02_01"
msgstr "MacLeod: Brooks, biraz tüyo ver, nasıl bir şey arıyoruz?"

msgid "vo_sm_char02_m04_stg13_02_02"
msgstr "MacLeod: King Tiger'dan daha büyük bir şey mi? İmparator filan mı?"

msgid "vo_sm_char02_m04_stg14_01"
msgstr "MacLeod: İleride Müttefik tankları görüyorum. Her zamanki gibi toplu hâlde yarmaya çalışıyorlar."

msgid "vo_sm_char02_m04_stg14_01_01"
msgstr "MacLeod: Jagdtiger'ı öyle geçemezler. Lucky, Jagdtigerları da sayıyor muyuz?"

msgid "vo_sm_char02_m04_stg14_03"
msgstr "MacLeod: Brooks, sen Karargâhta fazla uzun kalmışsın."

msgid "vo_sm_char02_m04_stg14_03_01"
msgstr "MacLeod: Anlıyorum, yazman gereken raporlar var ama burada da müttefiklerimizin yardıma ihtiyacı var."

msgid "vo_sm_char02_m04_stg15_02"
msgstr "MacLeod: Bennett?"

msgid "vo_sm_char02_m04_stg15_04"
msgstr "MacLeod: İşte bu. Lucky, hadi kanatlı dostumuzun puan kazanmasına yardım edelim!"

msgid "vo_sm_char02_m04_stg16_01"
msgstr "MacLeod: Şu tenekelerin işini hızlıca bitirelim. O Jagdtiger'a hızla ulaşmamız lazım."

msgid "vo_sm_char02_m04_stg16_01_01"
msgstr "MacLeod: Daha çetin cevizlere rastlarsak sürücü dişlilere nişan al."

msgid "vo_sm_char02_m04_stg16_01_02"
msgstr "MacLeod: 'Deniz kuşumuza' biraz hedef talimi yaptıralım."

msgid "vo_sm_char02_m04_stg16_01_03"
msgstr "MacLeod: Sürücü dişlilerine nişan al. 'Deniz kuşumuza' biraz hedef talimi yaptıralım."

msgid "vo_sm_char02_m04_stg17_01"
msgstr "MacLeod: Bu prototipin adı neymiş?"

msgid "vo_sm_char02_m04_stg17_01_01"
msgstr "MacLeod: Kod adı filan var mı? Yoksa ben mi uydurayım?"

msgid "vo_sm_char02_m04_stg17_03"
msgstr "MacLeod: Çok sıkıcı. Ben ona... Minik Fare diyeceğim."

msgid "vo_sm_char02_m04_stg17_05"
msgstr "MacLeod: Alman bir mühendis olsam eğlencesine öyle ad takardım."

msgid "vo_sm_char02_m04_stg18_01"
msgstr "MacLeod: Kaç tanesiniz yahu? Jagdtiger ile randevuma geç kalıyorum."

msgid "vo_sm_char02_m04_stg18_01_01"
msgstr "MacLeod: Lucky, tempoyu yükseltelim. Hatunları bekletmek çok ayıp."

msgid "vo_sm_char02_m04_stg19_01"
msgstr "MacLeod: Offf! Sen de nesin öyle?"

msgid "vo_sm_char02_m04_stg19_01_01"
msgstr "MacLeod: Brooks! Bize burada dost birliklerin olduğunu niye söylemedin?"

msgid "vo_sm_char02_m04_stg19_01_02"
msgstr "MacLeod: İstihbarat yine çuvalladı deme!"

msgid "vo_sm_char02_m04_stg19_03"
msgstr "MacLeod: İstihbaratımız bu yani."

msgid "vo_sm_char02_m04_stg19_03_01"
msgstr "MacLeod: Bizimle gel, şehirden tek başına çıkmak akıllıca değil."

msgid "vo_sm_char02_m04_stg19_05"
msgstr "MacLeod: Son operasyondakiler kadar gevezesin sen de."

msgid "vo_sm_char02_m04_stg19_05_01"
msgstr "MacLeod: Peki, haydi gidelim, toplantıya geç kalıyoruz."

msgid "vo_sm_char02_m04_stg20_01"
msgstr "MacLeod: Martı!"

msgid "vo_sm_char02_m04_stg20_01_01"
msgstr "MacLeod: Storm Petrel demek istedim! Sana tatlı bir hedef bulduk. Bunu kaçırmazsın."

msgid "vo_sm_char02_m04_stg20_01_02"
msgstr "MacLeod: Lucky, sürücü dişlisine nişan al!"

msgid "vo_sm_char02_m04_stg20_01_03"
msgstr "MacLeod: Lucky, sürücü dişlisine nişan al!"

msgid "vo_sm_char02_m04_stg23_01"
msgstr "MacLeod: Anladım. Yakında bir hede...bir dakika. Ne dedin sen?!"

msgid "vo_sm_char02_m04_stg23_01_01"
msgstr "MacLeod: Aa... Brooks, seni eş... O bizim sırrımızdı!"

msgid "vo_sm_char02_m04_stg23_03"
msgstr "MacLeod: E tabii. Yaşlandın, anlıyorum."

msgid "vo_sm_char02_m04_stg24_01"
msgstr "MacLeod: Dostlar, yakınlaştık. Koruyucu melekleriniz üzerinizdeki laneti kaldırmak üzere."

msgid "vo_sm_char02_m04_stg24_03"
msgstr "MacLeod: Şimdi ne oldu?"

msgid "vo_sm_char02_m04_stg24_05"
msgstr "MacLeod: Brooks, bir kozun daha var mı acaba, şöyle bombardıman uçağı boyutlarında?"

msgid "vo_sm_char02_m04_stg24_07"
msgstr "MacLeod: Bekleriz. Değil mi Lucky?"

msgid "vo_sm_char02_m04_stg25_01"
msgstr "MacLeod: Brooks? Biraz hızlandırmak mümkün mü?"

msgid "vo_sm_char02_m04_stg25_01_01"
msgstr "MacLeod: Burada misafirlerimiz var. Bir sürü misafir. İstihbarat, sen de katıl, orada durma öyle!"

msgid "vo_sm_char02_m04_stg26_01"
msgstr "MacLeod: Brooks, şehre bizden ve şu çocuklardan başka saldıran var mı?"

msgid "vo_sm_char02_m04_stg26_01_01"
msgstr "MacLeod: Buraya gizli operasyon için geldik sanıyordum, tam kapsamlı şehir temizle işine değil."

msgid "vo_sm_char02_m04_stg26_03"
msgstr "MacLeod: Hâlâ da istiyorum. Bir şehri ele geçirmek için biraz daha destek olur diye düşünmüştüm."

msgid "vo_sm_char02_m04_stg26_05"
msgstr "MacLeod: Peki o zaman. Şans bizden yana! Doğru değil mi Lucky?"

msgid "vo_sm_char02_m04_stg27_02"
msgstr "MacLeod: Zamanı gelmişti!"

msgid "vo_sm_char02_m04_stg28_01"
msgstr "MacLeod: Niye hep işi bitirmek bize kalıyor?"

msgid "vo_sm_char02_m04_stg28_03"
msgstr "MacLeod: Ha! Sanırım ikimiz de yaşlanıyoruz Brooks!"

msgid "vo_sm_char02_m04_stg28_03_01"
msgstr "MacLeod: Emekli kulübünde Tombalaya ne dersin?"

msgid "vo_sm_char02_m04_stg29_01"
msgstr "MacLeod: Lucky, yapman gerekeni biliyorsun. Şu paletleri hallet."

msgid "vo_sm_char02_m04_stg29_01_01"
msgstr "MacLeod: Jagdtiger'ı Bennett'la tanıştırmalıyız. Eminim çok iyi anlaşırlar."

msgid "vo_sm_char02_m04_stg29_01_02"
msgstr "MacLeod: Lucky, yapman gerekeni biliyorsun. Şu paletleri hallet."

msgid "vo_sm_char02_m04_stg30_02"
msgstr "MacLeod: İşte bu! Senin üç oldu Bennett!"

msgid "vo_sm_char02_m04_stg30_02_01"
msgstr "MacLeod: Bizimle şehirde yarım gün geçirirsen bizi yakalayabilirsin."

msgid "vo_sm_char02_m04_stg31_01"
msgstr "MacLeod: Eşit olduğumuzu söylemeyeceksin inşallah! Brooks, bizim kadar çok Tigerı var mı?"

msgid "vo_sm_char02_m04_stg31_03"
msgstr "MacLeod: Bana doğru dürüst cevap vermemenden nefret ediyorum."

msgid "vo_sm_char02_m04_stg32_01"
msgstr "MacLeod: Ne feci bir görüntü. Anlaşılan bizim Minik Fare keskin dişlere sahip."

msgid "vo_sm_char02_m04_stg32_01_01"
msgstr "MacLeod: Lucky, tetikte ol. Bennett, bizimle misin?"

msgid "vo_sm_char02_m04_stg33_01"
msgstr "MacLeod: Hay bin lanet! Şu külüstür motor bozuldu!"

msgid "vo_sm_char02_m04_stg33_01_01"
msgstr "MacLeod: Lucky, ben olmadan devam etmen gerekiyor."

msgid "vo_sm_char02_m04_stg33_01_02"
msgstr "MacLeod: Buradan sana koruma sağlamak ve Bennett'ın saldırılarını yönlendirmek için elimden geleni yapacağım."

msgid "vo_sm_char02_m04_stg33_01_03"
msgstr "MacLeod: Lanet olası motor!"

msgid "vo_sm_char02_m04_stg34_01"
msgstr "MacLeod: Gördüm. Hay bin lanet, bu çok obez bir fare. Kaç ton ki bu?"

msgid "vo_sm_char02_m04_stg34_01_01"
msgstr "MacLeod: Amaan, önemi yok. Ne kadar ağırsa paketlere binen yük de o kadar fazla demek."

msgid "vo_sm_char02_m04_stg34_01_02"
msgstr "MacLeod: Değil mi Lucky? Nereye nişan alacağını biliyorsun."

msgid "vo_sm_char02_m04_stg36_01"
msgstr "MacLeod: Her tarafı zırhla kaplı. Bunu delemeyiz."

msgid "vo_sm_char02_m04_stg36_01_01"
msgstr "MacLeod: Ama bizim bir kozumuz var. Tepesi bariz şekilde ince."

msgid "vo_sm_char02_m04_stg36_01_02"
msgstr "MacLeod: Lucky, paletlere odaklan."

msgid "vo_sm_char02_m04_stg36_01_03"
msgstr "MacLeod: Lucky, paletlere odaklan."

msgid "vo_sm_char02_m04_stg37_01"
msgstr "MacLeod: Şimdi işin bitti Fare! Storm Petrel, işini bitir de eve dönelim."

msgid "vo_sm_char02_m04_stg38_01"
msgstr "MacLeod: Nası yani... düşman imha olmadı."

msgid "vo_sm_char02_m04_stg38_01_01"
msgstr "MacLeod: Lucky, Bennett tekrar gelene kadar şu davetsiz misafirleri halledelim."

msgid "vo_sm_char02_m04_stg39_01"
msgstr "MacLeod: Arkadaşları da geldi. Önce onları halledelim de araya girmesinler."

msgid "vo_sm_char02_m04_stg40_01"
msgstr "MacLeod: Ne yapıyor bu? Saklanıyor mu? Lucky, korkutup kaçırdın."

msgid "vo_sm_char02_m04_stg40_01_01"
msgstr "MacLeod: Bennett'tan bir tur selam turu daha, sonra işimiz hallolacak."

msgid "vo_sm_char02_m04_stg41_01"
msgstr "MacLeod: Orada. Yakaladım onu. Bennett, bu heyecanlı ama yorucu macerayı sonlandır lütfen."

msgid "vo_sm_char02_m04_stg42_01"
msgstr "MacLeod: Aaaa... can sıkar artık."

msgid "vo_sm_char02_m04_stg42_01_01"
msgstr "MacLeod: Nasıl bir şeysin sen? Şimdiye alev alev olman gerekiyordu."

msgid "vo_sm_char02_m04_stg42_01_02"
msgstr "MacLeod: Hay lanet! Lucky, sanırım onu kızdırdık."

msgid "vo_sm_char02_m04_stg43_01"
msgstr "MacLeod: Lucky, dikkatli ol, yeni bir grup düşman var burada."

msgid "vo_sm_char02_m04_stg44_01"
msgstr "MacLeod: Lucky, sadece paletlere nişan al. Boşa mermi harcama, o zırhı delemeyiz."

msgid "vo_sm_char02_m04_stg45_01"
msgstr "MacLeod: Bennett, fare gibi kıstırıldı! Ne var ne yok dal!"

msgid "vo_sm_char02_m04_stg46_01"
msgstr "MacLeod: İşte! Oldu!"

msgid "vo_sm_char02_m04_stg46_03"
msgstr "MacLeod: Bennett, yardımın için teşekkürler. Sana borcumuz var!"

msgid "vo_sm_char02_m04_stg47_02"
msgstr "MacLeod: Pfft, madalyaymış. Onlardan çok var bende."

msgid "vo_sm_char02_m04_stg47_04"
msgstr "MacLeod: Tombala! Tombala oynamaya ne dersin? Lucky, var mısın?"

msgid "vo_sm_char02_m04_stg53_01"
msgstr "MacLeod: Bennett, hareketsiz bıraktık. Saldırmak serbest."

msgid "vo_sm_char02_m04_stg54_01"
msgstr "MacLeod: Storm Petrel, hedefin paletleri gidik. Sana teslim ediyoruz."

msgid "vo_sm_char02_m04_stg55_01"
msgstr "MacLeod: Paletleri gitti. Hava kuvvetleri, dans sırası sende."

msgid "vo_sm_char02_m04_stg56_01"
msgstr "MacLeod: Bennett, hedef hareketsiz kaldı."

msgid "vo_sm_char02_m05_stg59_02"
msgstr "MacLeod: Arada bir espri, ekibe motor yağı gibi! Dağılmadan çalışmasını sağlar."

msgid "vo_sm_char02_m05_stg60_02"
msgstr "MacLeod: Yani konuşmalarım önemli değil miydi? Kalbimi kırdın dostum!"

msgid "vo_sm_char03_m05_stg01_02"
msgstr "Connolly: Vay canına! Komutanımızı kaybettik! Çocuklar, iş bize düştü."

msgid "vo_sm_char03_m05_stg01_02_01"
msgstr "Connolly: Herkes çok dikkatli olsun. Etrafımız mayınlarla çevrili."

msgid "vo_sm_char03_m05_stg03_01"
msgstr "Connolly: Lanet olsun! Koruganlar mayın temizleme tankını yok etti!"

msgid "vo_sm_char03_m05_stg03_03"
msgstr "Connolly: Lanet olsun! Mayınlar! Mayınlardan nefret ediyorum!"

msgid "vo_sm_char03_m05_stg04_01"
msgstr "Connolly: Şu lanet koruganları yok etmemiz gerekiyor."

msgid "vo_sm_char03_m05_stg04_01_01"
msgstr "Connolly: Tanklarla çizik atmak bile zor ama başka seçeneğimiz yok."

msgid "vo_sm_char03_m05_stg04_01_02"
msgstr "Connolly: Belki şansımız yaver gider, aralıktan bir mermi sokup tüm şeyi indirebiliriz."

msgid "vo_sm_char03_m05_stg04_04"
msgstr "Connolly: Şu koruganlara ateş etmeye devam edin, yok etmek zorundayız. Tek şansımız bu."

msgid "vo_sm_char03_m05_stg08_01"
msgstr "Connolly: Koruganlar sustu. Mayın temizleme tankı artık yol açabilir."

msgid "vo_sm_char03_m05_stg09_01"
msgstr "Connolly: Yol açıldı... sonunda! Hemen ilerleyin!"

msgid "vo_sm_char03_m05_stg11_01"
msgstr "Connolly: İleride düşman tankları tespit edildi. Çatışmaya hazırlanın."

msgid "vo_sm_char03_m05_stg12_01"
msgstr "Connolly: Lanet olsun, bu koruganı hızla yok etmemiz lazım. Uçaksavar toplarına hemen ulaşmamız gerek."

msgid "vo_sm_char03_m05_stg13_01"
msgstr "Connolly: Ha ha! Sinirleri bozuldu galiba!"

msgid "vo_sm_char03_m05_stg13_01_01"
msgstr "Connolly: Tanklarımızın sesini duyunca sıvışıp uçaksavar toplarını arkalarında bıraktılar."

msgid "vo_sm_char03_m05_stg18_01"
msgstr "Connolly: Bir sonraki korugan çetin ceviz olacak."

msgid "vo_sm_char03_m05_stg18_01_01"
msgstr "Connolly: Duman ile işaretleyin de bir zırhlının üstüne ateş açmasını isteyelim."

msgid "vo_sm_char03_m05_stg19_01"
msgstr "Connolly: Bu sonraki korugan iyi savunuluyor. İki taraftan birden tam güçle vurmamız lazım."

msgid "vo_sm_char03_m05_stg19_01_01"
msgstr "Connolly: Yüzbaşı Murphy ve ben onları burada meşgul ederken Fransızın hamlesini yapmasına yardım edin."

msgid "vo_sm_char03_m05_stg20_01"
msgstr "Connolly: Yüzbaşı Dubois'e desteğimizi de verdik, artık o tepe üstündeki koruganı halledecek kadar ateş gücümüz var."

msgid "vo_sm_char03_m05_stg22_01"
msgstr "Connolly: Bir sonraki hedefimiz o büyük sahil topu."

msgid "vo_sm_char03_m05_stg22_01_01"
msgstr "Connolly: Onu yok edebilirsek zırhlımız tam topçu desteği verecek şekilde konuşlanabilir."

msgid "vo_sm_char03_m05_stg25_01"
msgstr "Connolly: Ah, şuna bakın çocuklar! Kraliyet Hava Kuvvetleri vurmaya geliyor."

msgid "vo_sm_char03_m05_stg25_01_01"
msgstr "Connolly: Ne görüntü ama! Şahane uçuyorlar!"

msgid "vo_sm_char03_m05_stg32_01"
msgstr "Connolly: Toplanın çocuklar. Düşman bize adım attırmayacak o yüzden biz de onlara aynısını yapacağız."

msgid "vo_sm_char03_m05_stg33_01"
msgstr "Connolly: İşte bu! Durumu tersine çevirdik."

msgid "vo_sm_char03_m05_stg35_01"
msgstr "Connolly: Zırhlı için hedefleri dumanla işaretleyin."

msgid "vo_sm_char03_m05_stg35_02"
msgstr "Connolly: Duman atmayı unutmayın."

msgid "vo_sm_char03_m05_stg35_03"
msgstr "Connolly: Duman işaretlerinizi kullanın. Pilot o koordinatları aktarabilir."

msgid "vo_sm_char03_m05_stg35_04"
msgstr "Connolly: Bu zorlu bir hedef. Dumanla işaretleyin."

msgid "vo_sm_char03_m05_stg36_01"
msgstr "Connolly: Sherman, harekete geçme zamanı! Savaş bizi beklemiyor."

msgid "vo_sm_char03_m05_stg36_02"
msgstr "Connolly: Sherman, uyan artık!"

msgid "vo_sm_char03_m05_stg36_03"
msgstr "Connolly: Sherman, neden durdun? Mekanik sorun mu var?"

msgid "vo_sm_char03_m05_stg36_04"
msgstr "Connolly: Sherman, hadi, oyalanacak vakit yok. Ön cephe ileride!"

msgid "vo_sm_char03_m05_stg36_05"
msgstr "Connolly: Sherman, zaman bizden yana değil! Hadi gidelim!"

msgid "vo_sm_char03_m05_stg37_02"
msgstr "Connolly: Çay tercih ederim ama kahve de olur."

msgid "vo_sm_char03_m05_stg38_02"
msgstr "Connolly: Yüzbaşı Murphy, yere yapışın derim. Daha güvenli. Herkes için."

msgid "vo_sm_char03_m05_stg40_01"
msgstr "Connolly: Hazırda bekleyin beyler. Yeni bir düşman grubu yaklaşıyor."

msgid "vo_sm_char03_m05_stg45_01"
msgstr "Connolly: Seni tekrar hareket halinde görmek güzel! Tetikte ol."

msgid "vo_sm_char03_m05_stg45_02"
msgstr "Connolly: Küllerinden "

msgid "vo_sm_char03_m05_stg46_01"
msgstr "Connolly: Lanet olsun! Tankım devre dışı kaldı. Bensiz devam edin."

msgid "vo_sm_char03_m05_stg46_02"
msgstr "Connolly: Eh, bu yol da buraya kadarmış. Yine de elimizden geldiğince iyi gittik."

msgid "vo_sm_char03_m05_stg46_03"
msgstr "Connolly: Tankım yitik ama daha işimiz bitmedi. Yakında çatışmaya döneceğiz."

msgid "vo_sm_char04_m05_stg03_02"
msgstr "Bizi birer birer avlıyorlar! Falezlere gidin!"

msgid "vo_sm_char04_m05_stg03_02_01"
msgstr "Açıkta keklik gibi durmak intihar demek."

msgid "vo_sm_char04_m05_stg03_02_02"
msgstr "Falezler biraz siper sağlayabilir."

msgid "vo_sm_char04_m05_stg16_02"
msgstr "Murphy: Ben Yüzbaşı Murphy. Şimdi sahile çıktık ama yamaçtaki koruganlar nedeniyle mıhlanıp kaldık."

msgid "vo_sm_char04_m05_stg16_02_01"
msgstr "Murphy: Yukarı ilerlemek için biraz desteğe ihtiyacımız var!"

msgid "vo_sm_char04_m05_stg17_01"
msgstr "Murphy: Korugan tahrip oldu! Yol apaçık artık. Hadi gidelim!"

msgid "vo_sm_char04_m05_stg17_01_01"
msgstr "Murphy: Hey, şuna bakın! Bizimkiler yukarıda onları kıymaya çeviriyor! Biz de katılalım!"

msgid "vo_sm_char04_m05_stg19_02"
msgstr "Murphy: Anlaştık, güzel plan. Hadi canlarına okuyalım!"

msgid "vo_sm_char04_m05_stg20_02"
msgstr "Murphy: Tamam, haydi harekete geçip günlerini gösterelim!"

msgid "vo_sm_char04_m05_stg22_02"
msgstr "Murphy: Ho ho! Arkamızda böyle ateş gücü varken durmaksızın içeri ilerleyebiliriz."

msgid "vo_sm_char04_m05_stg23_01"
msgstr "Murphy: Uçaksavarlar sustu galiba."

msgid "vo_sm_char04_m05_stg23_01_01"
msgstr "Murphy: Sanırım topçular bizi görünce tavşandan hızlı tüymeye başladı."

msgid "vo_sm_char04_m05_stg23_01_02"
msgstr "Murphy: Çekiciliğimizden olmalı, ne dersiniz?"

msgid "vo_sm_char04_m05_stg28_02"
msgstr "Murphy: İşte bu! Başardık!"

msgid "vo_sm_char04_m05_stg28_02_01"
msgstr "Murphy: Azıcık dinlenin sonra devam edelim, düşmana sıkı bir ders verelim."

msgid "vo_sm_char04_m05_stg30_02"
msgstr "Murphy: Hadi konum alalım. Unutmayın, arkamızda zırhlının topları var."

msgid "vo_sm_char04_m05_stg33_02"
msgstr "Murphy: Çetin bir çatışmaydı ama başardık! Bu hızı koruyalım!"

msgid "vo_sm_char04_m05_stg35_05"
msgstr "Murphy: Duman işaretin nerede? Kuzenim o gemide ve ateş etmeyi seviyor!"

msgid "vo_sm_char04_m05_stg35_06"
msgstr "Murphy: Ah bende de şu duman işaretlerinden bir tane olacaktı. Hep daha büyük top desteği talep etmek istemişimdir."

msgid "vo_sm_char04_m05_stg35_07"
msgstr "Murphy: Duman ile işaretleyin ve bırakın gerisini zırhlı halletsin."

msgid "vo_sm_char04_m05_stg36_06"
msgstr "Murphy: Sherman, neden durdun? Bas şu gaza!"

msgid "vo_sm_char04_m05_stg36_07"
msgstr "Murphy: Sherman, bütün gün seni bekleyemeyiz! Harekete geçiyoruz, hemen!"

msgid "vo_sm_char04_m05_stg36_08"
msgstr "Murphy: Sherman, ilerlememiz gerekiyor!"

msgid "vo_sm_char04_m05_stg36_09"
msgstr "Murphy: Sherman, oyalanacak vaktimiz yok. Haydi gidiyoruz!"

msgid "vo_sm_char04_m05_stg37_01"
msgstr "Murphy: Şu anda bir fincan kahve çok iyi olurdu."

msgid "vo_sm_char04_m05_stg38_01"
msgstr "Murphy: Bir dahaki sefere şu bombardıman uçaklarından birini uçurmak isterim. Gökyüzünü seviyorum."

msgid "vo_sm_char04_m05_stg39_01"
msgstr "Murphy: Hey Dubois, tankını benimkinden hızlı sürebilir misin?"

msgid "vo_sm_char04_m05_stg40_02"
msgstr "Murphy: Saldırın! Gezegenin en iyi bağları için!"

msgid "vo_sm_char04_m05_stg40_04"
msgstr "Murphy: Bir dakika, ben ne dedim?"

msgid "vo_sm_char04_m05_stg41_01"
msgstr "Murphy: Hey Dubois, moralimizi yükseltecek Fransız ezgin var mı?"

msgid "vo_sm_char04_m05_stg41_03"
msgstr "Murphy: Cidden mi? Sözlerinin ne anlama geldiğini biliyordum."

msgid "vo_sm_char04_m05_stg42_01"
msgstr "Murphy: Paris'te Quarter Pounderwith Cheese'e ne diyorlar?"

msgid "vo_sm_char04_m05_stg43_01"
msgstr "Murphy: Dubois, Fransız tanklarında levye yerine baget olduğu doğru mu?"

msgid "vo_sm_char04_m05_stg43_03"
msgstr "Murphy: Senin kadar ciddi, ama gülümseyerek."

msgid "vo_sm_char04_m05_stg44_02"
msgstr "Murphy: O ne demek Dubois?"

msgid "vo_sm_char04_m05_stg45_03"
msgstr "Murphy: Tekrar aksiyona döndün, öyle mi? İlerlemeye devam et, sana güveniyoruz."

msgid "vo_sm_char04_m05_stg45_04"
msgstr "Murphy: Geri döndün mü? işte bu! Canlarına oku."

msgid "vo_sm_char04_m05_stg46_04"
msgstr "Murphy: Tank gitti! Anlaşılan artık yürüyoruz çocuklar."

msgid "vo_sm_char04_m05_stg46_05"
msgstr "Murphy: Demek buymuş. Tankım devre dışı ama döneceğim!"

msgid "vo_sm_char04_m05_stg46_06"
msgstr "Murphy: Aracımız dağıldı. Ben iyiyim, merak etmeyin. Yeni bir araçda döneceğim!"

msgid "vo_sm_char04_m06_outro_02"
msgstr "Murphy: Ne? Beş çılgının manyakça kahramanlığı mı?"

msgid "vo_sm_char04_m06_outro_11"
msgstr "Murphy: Bir daha asla."

msgid "vo_sm_char04_m06_stg02_01"
msgstr "Sürücü, Yzb. Murphy: Aman, dur! İleride mayın tarlası var!"

msgid "vo_sm_char04_m06_stg02_02"
msgstr "Murphy: Hey Keller, eskiden buralarda görev yapıyordun, parlak bir fikrin var mı?"

msgid "vo_sm_char04_m06_stg02_04"
msgstr "Murphy: O zaman kasabaya! Biraz gazete, pretzel ve şnitzel!"

msgid "vo_sm_char04_m06_stg06_06"
msgstr "Murphy: Hadi Profesör, şu telsizini konuştur."

msgid "vo_sm_char04_m06_stg06_12"
msgstr "Murphy: Keşke altı ay önce böyle bir Keller'ım olsaydı..."

msgid "vo_sm_char04_m06_stg06_14"
msgstr "Murphy: Lanet olsun. Bu gerçekten bir gizlilik görevi."

msgid "vo_sm_char04_m06_stg06_14_01"
msgstr "Murphy: Mecazen konuştuğumuzu sanıyordum."

msgid "vo_sm_char04_m06_stg07_02"
msgstr "Murphy: Üstelik görünürde muhafız yok! Şans bugün gerçekten bizden yana."

msgid "vo_sm_char04_m06_stg08_08"
msgstr "Murphy: Haydaa, dostlar sürpriz yumurta arıyoruz anlaşılan!"

msgid "vo_sm_char04_m06_stg09_03"
msgstr "Murphy: Emret Yüzbaşı, bir saniye. Lanet olsun. Dubois, bana bir kalem ver, benimkini kaybettim."

msgid "vo_sm_char04_m06_stg09_05"
msgstr "Murphy: Ha tamam. Keller, şey var mı...Bleistift?"

msgid "vo_sm_char04_m06_stg09_08"
msgstr "Murphy: Ha! Teşekkürler Keller."

msgid "vo_sm_char04_m06_stg10_02"
msgstr "Murphy: Oh! Yeni bir bulmaca parçası! Dubois senden hediye almak ne güzel!"

msgid "vo_sm_char04_m06_stg11_02"
msgstr "Murphy: Mösyö Delacroix, Jack Murphy bu! Adımı ne zaman doğru söyleyeceksin?"

msgid "vo_sm_char04_m06_stg12_03"
msgstr "Murphy: Bir saniye. Kalemim neredeydi..."

msgid "vo_sm_char04_m06_stg12_05"
msgstr "Murphy: Tamam, tamam, sana koca bir kutu kalem alacağım Dubois!"

msgid "vo_sm_char04_m06_stg12_05_01"
msgstr "Murphy: Yüzbaşım! Başarıyoruz! Bu parça benim favorim!"

msgid "vo_sm_char04_m06_stg15_03"
msgstr "Murphy: Her yere baktığından emin misin?"

msgid "vo_sm_char04_m06_stg15_05"
msgstr "Murphy: Hey, çoraplarım gibi de olabilir, hep en son baktığın yerde!"

msgid "vo_sm_char04_m06_stg16_02"
msgstr "Murphy: Bir saniye... Hepsi birbirine uydu. Of be, ne dolambaçlı ama!"

msgid "vo_sm_char04_m06_stg16_02_01"
msgstr "Murphy: Ben buna MAYIN-otor labirenti derdim! Haha. Anladın mı? Hayır mı? "

msgid "vo_sm_char04_m06_stg16_02_02"
msgstr "Murphy: Hadi ama, iyi espriydi!"

msgid "vo_sm_char04_m06_stg16_04"
msgstr "Murphy: Dubois, mermi yüklemekten yoruldun mu?"

msgid "vo_sm_char04_m06_stg18_03"
msgstr "Murphy: Hadi bakalım. Herkes hazır olsun."

msgid "vo_sm_char04_m06_stg19_02"
msgstr "Murphy: Aaa, ben de gizli Alman altın zulası bulmayı umuyordum."

msgid "vo_sm_char04_m06_stg19_02_01"
msgstr "Murphy: Hey Keller, buralarda altın tutuyor musunuz?"

msgid "vo_sm_char04_m06_stg19_04"
msgstr "Murphy: Ben de burada altın saklıyor olsam tam da bunu derdim."

msgid "vo_sm_char04_m06_stg19_04_01"
msgstr "Murphy: Yüzbaşı Smith: şu haritayı arayalım mı?"

msgid "vo_sm_char04_m06_stg21_03"
msgstr "Murphy: Aralarından sızıp geçtik!"

msgid "vo_sm_char04_m06_stg21_04"
msgstr "Murphy: Gördün mü? Gö-rün-mez olduk!"

msgid "vo_sm_char04_m06_stg23_04"
msgstr "Murphy: Eee, Yüzbaşı? Geri mi çekilsek? Hani işler fazla kızışmadan?"

msgid "vo_sm_char04_m06_stg23_05"
msgstr "Murphy: Oyum taktik geri çekilmeden yana. Bana katılan var mı?"

msgid "vo_sm_char04_m06_stg24_03"
msgstr "Murphy: Hoş geldin ekibi gelmeden yeni bir gizlenme yeri bulsak iyi olur!"

msgid "vo_sm_char04_m06_stg25_02"
msgstr "Murphy: Üf! Sinsi tank operasyonumuz işe yarıyor! Hiç tahmin etmezdim!"

msgid "vo_sm_char04_m06_stg26_04"
msgstr "Murphy: Şu Panzerlerle dans edelim!"

msgid "vo_sm_char04_m06_stg26_05"
msgstr "Murphy: Onlara bu Chaffee'nin neler yapabileceğini gösterelim!"

msgid "vo_sm_char04_m06_stg26_06"
msgstr "Murphy: Baylar, bayanlar, başlıyoruz!"

msgid "vo_sm_char04_m06_stg27_02"
msgstr "Murphy: Hoohoo! İşte böyle!"

msgid "vo_sm_char04_m06_stg28_03"
msgstr "Murphy: Tam isabet!"

msgid "vo_sm_char04_m06_stg29_02"
msgstr "Murphy: Amanın, o hedef devasaydı!"

msgid "vo_sm_char04_m06_stg30_02"
msgstr "Murphy: Yüzbaşı, önce Dubois incelese daha iyi olmaz mı?"

msgid "vo_sm_char04_m06_stg31_07"
msgstr "Murphy: Buralar çok serin, ben de ceketimi almayı unutmuşum."

msgid "vo_sm_char04_m06_stg35_02"
msgstr "Murphy: Profesörümüze şu telsiz büyüsünü yaptırma zamanı geldi sanki."

msgid "vo_sm_char04_m06_stg42_02"
msgstr "Murphy: Hey Yüzbaşı, gezmek çok güzel de şu harita parçaları hazine avına çıksak daha iyi değil mi?"

msgid "vo_sm_char04_m06_stg43_03"
msgstr "Murphy: Uyan, uyan, tank zamanı!"

msgid "vo_sm_char04_m06_stg44_02"
msgstr "Murphy: Anlaşılan bu işi gürültülü halledeceğiz!"

msgid "vo_sm_char04_m06_stg45_02"
msgstr "Murphy: Eminim bu kargaşanın etrafndan dolanmanın bir yolu vardır!"

msgid "vo_sm_char04_m06_stg46_02"
msgstr "Murphy: Hey Keller, onlara şu telsiz numaranı göstersene!"

msgid "vo_sm_char04_m06_stg47_02"
msgstr "Murphy: Sıkılıp gitmelerini beklesek?"

msgid "vo_sm_char04_m06_stg48_02"
msgstr "Murphy: Hey millet, gelecek sefer patlamamaya çalışsak?"

msgid "vo_sm_char04_m06_stg53_02"
msgstr "Murphy: Birileri sinsi olmaya çalışıyor! Vay haylaz!"

msgid "vo_sm_char04_m06_stg54_02"
msgstr "Murphy: Süre hızla akıyor, daha hızlı gitmemiz lazım."

msgid "vo_sm_char04_m06_stg55_01"
msgstr "Murphy: Ha! Bunu hallettik! Bir de zor olacak demişlerdi."

msgid "vo_sm_char04_m06_stg55_04"
msgstr "Murphy: Endişelenmeyin çocuklar, Murphy'niz çılgın sürüş moduna geçiyor."

msgid "vo_sm_char04_m06_stg56_02"
msgstr "Murphy: Hay... Dubois, fazla endişeleniyorsun! En kötü ne olabilir ki?"

msgid "vo_sm_char04_m06_stg56_04"
msgstr "Murphy: Yok olmaz, profesör! Ya tam gaz ya tam tabut, arası yok!"

msgid "vo_sm_char04_m06_stg56_06"
msgstr "Murphy: Sakin ol mon ami! Harita kafamda benim."

msgid "vo_sm_char04_m06_stg57_02"
msgstr "Murphy: Tiger mı? Bu kadar mı? Hep duyduğum şu mucize silahlar nerede?"

msgid "vo_sm_char04_m06_stg58_02"
msgstr "Murphy: Manevra mı? MANEVRA MI?"

msgid "vo_sm_char04_m06_stg58_02_01"
msgstr "Murphy: Tam tamına bir buçuk Chaffee genişliğindeki bu dar koridorda mı?"

msgid "vo_sm_char04_m06_stg58_02_02"
msgstr "Murphy: Nerede manevra yapacağım?"

msgid "vo_sm_char04_m06_stg59_03"
msgstr "Murphy: Haydaaa! Tiger, peşine düşecek başka tank bulamadın mı?"

msgid "vo_sm_char04_m06_stg60_03"
msgstr "Murphy: Tiger'ın namlusunun bize dönük olması hiç hoş değil!"

msgid "vo_sm_char04_m06_stg61_02"
msgstr "Murphy: Rüzgârı hissettiniz mi? Ben kesinlikle hissettim!"

msgid "vo_sm_char04_m06_stg62_01"
msgstr "Murphy: Sadece sıyırdı! Neredeyse hissetmedim bile!"

msgid "vo_sm_char04_m06_stg62_02"
msgstr "Murphy: Hey! Tankı daha yeni cilalamıştım!"

msgid "vo_sm_char04_m06_stg63_03"
msgstr "Murphy: Kowalski, paletlere nişan al!"

msgid "vo_sm_char04_m06_stg64_02"
msgstr "Murphy: Paletler olmayınca kabadayılık bitti, değil mi?"

msgid "vo_sm_char04_m06_stg68_01"
msgstr "Murphy: Hay aksi! O mayın haritada yoktu!"

msgid "vo_sm_char04_m06_stg68_02"
msgstr "Murphy: Mayınlar! Ha doğru. Zaten biliyordunuz."

msgid "vo_sm_char04_m06_stg69_01"
msgstr "Murphy: Amanın! Bu minik de nereden geldi?!"

msgid "vo_sm_char04_m06_stg70_02"
msgstr "Murphy: Ne bu ciddiyet? Keyiften patladık! Anladın mı? Mayınlardan yani?"

msgid "vo_sm_char04_m06_stg70_02_01"
msgstr "Murphy: A hadi ama çocuklar!..."

msgid "vo_sm_char04_m06_stg71_02"
msgstr "Murphy: Lanet olsun... O kadar adam... çok da yaklaşmıştık!"

msgid "vo_sm_char04_m06_stg73_01"
msgstr "Murphy: Dubois, Fransız tanklarında espresso makineleri olduğu doğru mu?"

msgid "vo_sm_char04_m06_stg73_03"
msgstr "Murphy: Çok ciddi cevap verdin, neredeyse inandım. Şaka yapıyordun, değil mi?"

msgid "vo_sm_char04_m06_stg74_02"
msgstr "Murphy: Yoo, ben ve çocuklar daha kuzeye gittik."

msgid "vo_sm_char04_m06_stg74_02_01"
msgstr "Murphy: Savaştan sonra mutlaka gideceğim."

msgid "vo_sm_char04_m06_stg74_02_02"
msgstr "Murphy: Mutlaka Pizza Kulesi'ne de çıkacağım."

msgid "vo_sm_char04_m06_stg75_01"
msgstr "Murphy: Dubois, uykunda konuştuğunu biliyor muydun?"

msgid "vo_sm_char04_m06_stg75_03"
msgstr "Murphy: \"Viii, viii, ma şeriii\" ne demek?"

msgid "vo_sm_char04_m06_stg76_01"
msgstr "Murphy: Dubois, bana Fransızca öğretmeye ne dersin?"

msgid "vo_sm_char04_m06_stg76_03"
msgstr "Murphy: Ne? Anlamıyorum."

msgid "vo_sm_char04_m06_stg76_05"
msgstr "Murphy: Ne? Oh... Vaaay... şakacıya şaka yapmaya çalışıyorsun, öyle mi?"

msgid "vo_sm_char04_m06_stg76_05_01"
msgstr "Murphy: İyi denemeydi Dubois ama ateşle oynuyorsun!"

msgid "vo_sm_char04_m06_stg77_01"
msgstr "Murphy: Kowalski, polka oynar mısın?"

msgid "vo_sm_char04_m06_stg77_03"
msgstr "Murphy: Hadi yapalım! Herkesin polka dansı yaptığı bir parti düzenleyelim!"

msgid "vo_sm_char04_m06_stg77_05"
msgstr "Murphy: Tabii ki! Yani... öyle değil. Ne demek istediğimi anlıyorsun. Umarım."

msgid "vo_sm_char04_m06_stg78_02"
msgstr "Murphy: Sorun ne?"

msgid "vo_sm_char04_m06_stg78_04"
msgstr "Murphy: Ben buna \"Taktik Manevra\" diyorum. Düşman hep tahmin etmeye çalışsın!"

msgid "vo_sm_char04_m06_stg79_01"
msgstr "Murphy: Kowalski, müzik grubunda olsak hangi enstrümanı kullanırdın?"

msgid "vo_sm_char04_m06_stg79_03"
msgstr "Murphy: Ee... Ben baş gitarist olurdum..."

msgid "vo_sm_char04_m06_stg80_01"
msgstr "Murphy: Keller, şu telsizi ayarlayıp radyo dinletebilir misin?"

msgid "vo_sm_char04_m06_stg80_03"
msgstr "Murphy: Birazcık? Müzik moralimize iyi gelirdi!"

msgid "vo_sm_char04_m06_stg80_05"
msgstr "Murphy: Ah. Evet. Ayarlarla oynamamak lazım o zaman."

msgid "vo_sm_char04_m06_stg81_01"
msgstr "Murphy: Geçen gece hepimizin balığa çıktığı bir rüya gördüm."

msgid "vo_sm_char04_m06_stg81_03"
msgstr "Murphy: Eski bir bot."

msgid "vo_sm_char04_m06_stg81_05"
msgstr "Murphy: He, gizliden bir optimist olduğunu biliyordum."

msgid "vo_sm_char04_m06_stg81_05_01"
msgstr "Murphy: Hep ümit arıyorsun."

msgid "vo_sm_char04_m06_stg82_01"
msgstr "Murphy: Yüzbaşı, bize komik bir şaka anlatsana."

msgid "vo_sm_char04_m06_stg82_03"
msgstr "Murphy: Başka kim? Kowalski? Keller? Dubois, kusura bakma, sana sormuyorum."

msgid "vo_sm_char04_m06_stg82_05"
msgstr "Murphy: Eee... istiyorsan başla."

msgid "vo_sm_char04_m06_stg82_07"
msgstr "Murphy: ... İşte bu yüzden."

msgid "vo_sm_char04_m06_stg83_02"
msgstr "Murphy: \"Korkaklar bin defa ölür;\""

msgid "vo_sm_char04_m06_stg83_02_01"
msgstr "Murphy: \"Cesurlar ölümle sadece bir kere yüzleşir,\" doğru değil mi?"

msgid "vo_sm_char04_m06_stg83_04"
msgstr "Murphy: Cidden mi? Bana fazlasıyla Fransızca geldi."

msgid "vo_sm_char04_m06_stg84_01"
msgstr "Murphy: Bizim adımızı da bir sokağa verirler mi?"

msgid "vo_sm_char04_m06_stg84_03"
msgstr "Murphy: Haklısın. Mürettebatımızın bir ismi olmalı!"

msgid "vo_sm_char04_m06_stg84_05"
msgstr "Murphy: Mmm... isim için çok uzun. BELA AVCILARI'nı beğendim."

msgid "vo_sm_char04_m06_stg85_01"
msgstr "Murphy: Hey Kowalski, sen hiç güler misin?"

msgid "vo_sm_char04_m06_stg85_03"
msgstr "Murphy: Meydan okumanı kabul ediyorum! O kabuğunu kıracağım!"

msgid "vo_sm_char04_m06_stg85_05"
msgstr "Murphy: Peki, dinleyin: Tak-tak."

msgid "vo_sm_char04_m06_stg85_06"
msgstr "Murphy: \"Kim o?\" diye sorman gerekiyor"

msgid "vo_sm_char04_m06_stg85_07"
msgstr "Murphy: Peki, bu tahmin ettiğimden daha zor olabilir."

msgid "vo_sm_char04_m06_stg87_01"
msgstr "Murphy: O ne yahu?!"

msgid "vo_sm_char04_m06_stg87_03"
msgstr "Murphy: Botumun içinde. Aa! Kalemmiş."

msgid "vo_sm_char04_m06_stg88_01"
msgstr "Murphy: Hey Keller, şu Alman kanallarında ilginç bir şey var mı?"

msgid "vo_sm_char04_m06_stg88_03"
msgstr "Murphy: Ha! Bu biziz! Hayalet Tank! Almanların karabasanı!"

msgid "vo_sm_char04_m06_stg88_04"
msgstr "Murphy: Keller, eminim bir Amerikan tankında gizli gizli dolaşacağını tahmin etmemişsindir!"

msgid "vo_sm_char04_m06_stg88_06"
msgstr "Murphy: Hayat ne garip, değil mi? Çikolata kutusu gibi!"

msgid "vo_sm_char04_m06_stg90_03"
msgstr "Murphy: Ah!!! Kowalski! La Marseillaise'in sözlerini mutlaka okumalısın!"

msgid "vo_sm_char04_m06_stg90_03_01"
msgstr "Murphy: Bayağı bir şeyler var orada, ciddi kanlı bir şeyler!"

msgid "vo_sm_char04_m06_stg91_02"
msgstr "Murphy: Evet!"

msgid "vo_sm_char04_m06_stg92_01"
msgstr "Murphy: Soran olursa gezgin sirkiz."

msgid "vo_sm_char04_m06_stg92_03"
msgstr "Murphy: İyi bir hikâyeye ihtiyacımız var, şimdi casus olduk!"

msgid "vo_sm_char04_m06_stg93_01"
msgstr "Murphy: Bu görevden sonra casus kalemi alabilir miyim dersin?"

msgid "vo_sm_char04_m06_stg93_03"
msgstr "Murphy: Dubois, hiç tahammülün yok!"

msgid "vo_sm_char05_m05_stg18_02"
msgstr "Dubouis: Bonjour, monsieurs! Capitaine Dubois konuşuyor."

msgid "vo_sm_char05_m05_stg18_02_01"
msgstr "Dubois: H1'e çıktık ama yoğun düşman ateşi tarafından mıhlanıp kaldık."

msgid "vo_sm_char05_m05_stg18_02_02"
msgstr "Dubois: Acil destek istiyoruz!"

msgid "vo_sm_char05_m05_stg19_04"
msgstr "Dubois: Aha, yol temizlendi. Sonunda! En avant, haydi çatışmaya katılalım. Vive la France!"

msgid "vo_sm_char05_m05_stg21_01"
msgstr "Dubois: Merci mon ami! Anavatanımı kurtarmaya bir adım daha yaklaştık."

msgid "vo_sm_char05_m05_stg27_01"
msgstr "Dubois: Magnifique! Sahil topları. Sustu."

msgid "vo_sm_char05_m05_stg27_01_01"
msgstr "Dubois: Artık zırhlı daha yakına gelip bize sağlam destek verebilir."

msgid "vo_sm_char05_m05_stg27_01_02"
msgstr "Dubois: Ateş gösterisini izleyelim!"

msgid "vo_sm_char05_m05_stg29_01"
msgstr "Dubois: Savaşa hazırım. Fransız topraklarını bir daha asla terk etmeyeceğim. Plus jamais de retraite!"

msgid "vo_sm_char05_m05_stg33_03"
msgstr "Dubois: Bu daha başlangıç. Savaşın sonu göründü."

msgid "vo_sm_char05_m05_stg35_08"
msgstr "Dubois: Hedefleri dumanla işaretleyin, mes amis. Zırhlı La France'ı kurtarsın!"

msgid "vo_sm_char05_m05_stg35_09"
msgstr "Dubois: İyi konumlandırılmış bir duman sinyali şans ve düşmanın üstüne ateş yağmuru getirir!"

msgid "vo_sm_char05_m05_stg36_10"
msgstr "Dubois: Sherman, hareket etme zamanı, vite-vite!"

msgid "vo_sm_char05_m05_stg36_11"
msgstr "Dubois: Sherman, gitmemiz gerekiyor, allons!"

msgid "vo_sm_char05_m05_stg36_12"
msgstr "Dubois: Sherman, acele et! La France bizi bekliyor!"

msgid "vo_sm_char05_m05_stg39_02"
msgstr "Dubois: Yüzbaşı Murphy, bu bir yarışma değil, anavatanımı kurtarmaya çalışıyoruz."

msgid "vo_sm_char05_m05_stg39_02_01"
msgstr "Dubois: Ve bu soru.... Absürt! Bende ağır tank var, nasıl daha hızlı olabilirim?"

msgid "vo_sm_char05_m05_stg40_03"
msgstr "Dubois: Fransa İçin!"

msgid "vo_sm_char05_m05_stg41_02"
msgstr "Dubois: 'La Marseillaise'i mırıldanıyorum. Savaş için uygun. Sözleri coşturucu, hatta vahşi."

msgid "vo_sm_char05_m05_stg42_02"
msgstr "Dubois: Burger mi? Murphy, biz Fransa'da burger yemeyiz."

msgid "vo_sm_char05_m05_stg42_02_01"
msgstr "Dubois: Klasik baget sandviçlerimizi tercih ederiz, içinde kaliteli peynir ve şarküteri ürünleriyle."

msgid "vo_sm_char05_m05_stg43_02"
msgstr "Dubois: Yüzbaşı Murphy, bazen bu savaşı ne kadar ciddiye aldığınızı sorguluyorum."

msgid "vo_sm_char05_m05_stg44_01"
msgstr "Dubois: Sur le risque disparu, sur l’espoir sans souvenir, j’écris ton nom..."

msgid "vo_sm_char05_m05_stg44_03"
msgstr "Dubois: Bittiler demek, Murphy."

msgid "vo_sm_char05_m05_stg45_05"
msgstr "Dubois: Savaşa tekrar hoş geldin. Dayanıklılığın teşvik edici."

msgid "vo_sm_char05_m05_stg46_07"
msgstr "Dubois: Mon dieu, tankımızın işi bitti! Geri çekilmemiz gerekiyor."

msgid "vo_sm_char05_m05_stg46_08"
msgstr "Dubois: Bu tankın işi bitti. Elimizden geleni yaptık, mes amis."

msgid "vo_sm_char05_m05_stg46_08_01"
msgstr "Dubois: Ama Fransa'nın kurtuluşu için devam edeceğim!"

msgid "vo_sm_char05_m05_stg46_09"
msgstr "Dubois: Tank yok edildi ama şevkimiz kırılmadı. Geri döneceğim!"

msgid "vo_sm_char05_m06_outro_01"
msgstr "Dubois: Kan dökülmesini durdurabiliyormuş."

msgid "vo_sm_char05_m06_outro_03"
msgstr "Dubois: Bir kağıt parçası. Basit bir kağıt parçası hepsini durdurabiliyor."

msgid "vo_sm_char05_m06_outro_05"
msgstr "Dubois: Peki ne?"

msgid "vo_sm_char05_m06_outro_09"
msgstr "Dubois: Plus jamais."

msgid "vo_sm_char05_m06_stg04_02"
msgstr "Yükleyici, Yzb. Dubois: Emret komutanım!"

msgid "vo_sm_char05_m06_stg04_03"
msgstr "Dubois: Tanklar tespit edildi."

msgid "vo_sm_char05_m06_stg06_11"
msgstr "Dubois: Magnifique! İşe yaradı!"

msgid "vo_sm_char05_m06_stg08_02"
msgstr "Dubois: Emret komutanım!"

msgid "vo_sm_char05_m06_stg08_03"
msgstr "Dubois: Buldum! Şimdi kasabadan geçebiliriz...merde!"

msgid "vo_sm_char05_m06_stg08_05"
msgstr "Dubois: Tüm ön cepheye mayın döşenmiş. Geçip kuvvetlerimize ulaşamıyoruz."

msgid "vo_sm_char05_m06_stg09_01"
msgstr "Dubois: Buldum!"

msgid "vo_sm_char05_m06_stg09_04"
msgstr "Dubois: Zaten kalemimi sana verdim. Benimkini kaybettin."

msgid "vo_sm_char05_m06_stg09_07"
msgstr "Dubois: Yapma. Seninkini de kaybeder."

msgid "vo_sm_char05_m06_stg10_01"
msgstr "Dubois: Murphy: Senin için bir şey ayırdım. Al."

msgid "vo_sm_char05_m06_stg11_01"
msgstr "Dubois: İkramiyeyi vurdum!"

msgid "vo_sm_char05_m06_stg11_03"
msgstr "Dubois: Demek istediğim...ah...mon Dieu, bu iş bittiğinde saçma şakalarını özleyeceğim galiba."

msgid "vo_sm_char05_m06_stg12_01"
msgstr "Dubois: Buldum! Bir parça daha."

msgid "vo_sm_char05_m06_stg12_04"
msgstr "Dubois: Ben demiştim."

msgid "vo_sm_char05_m06_stg13_01"
msgstr "Dubois: Burada bir şey yok, mes amis."

msgid "vo_sm_char05_m06_stg14_02"
msgstr "Dubois: Non. Aradığımız komuta merkezi burası değil."

msgid "vo_sm_char05_m06_stg15_02"
msgstr "Dubois: Boş."

msgid "vo_sm_char05_m06_stg15_04"
msgstr "Dubois: Oldukça titizim."

msgid "vo_sm_char05_m06_stg15_06"
msgstr "Dubois: Mon Dieu...Gizli askerî belgeleri şeyle mi kıyaslıyorsun....ah...boşver."

msgid "vo_sm_char05_m06_stg15_07"
msgstr "Dubois: Mon Dieu...Gizli askerî belgeleri şeyle mi kıyaslıyorsun....ah...boşver."

msgid "vo_sm_char05_m06_stg15_07_01"
msgstr "Dubois: Yüzbaşı, burada işaretlenmiş başka komuta merkezleri var."

msgid "vo_sm_char05_m06_stg16_03"
msgstr "Dubois: Sadece mayın tarlasından gizlice geçeceğiz, ardından biraz... huzur ve sessizlik bulabilirim."

msgid "vo_sm_char05_m06_stg16_05"
msgstr "Dubois: O da var."

msgid "vo_sm_char05_m06_stg17_03"
msgstr "Dubois: Rahat ol Kowalski. Keller bize ihanet etmek isteseydi çoktan yapmış olurdu."

msgid "vo_sm_char05_m06_stg19_01"
msgstr "Dubois: Bakın, komuta merkezine bekliyor."

msgid "vo_sm_char05_m06_stg21_05"
msgstr "Dubois: Ucuz atlattık, mes amis."

msgid "vo_sm_char05_m06_stg24_04"
msgstr "Dubois: Hemen yer değiştirmemiz gerekiyor, mes amis. İncelemeye gelecekler."

msgid "vo_sm_char05_m06_stg25_03"
msgstr "Dubois: Magnifique. Geride kaldılar. Görevimize devam edebiliriz."

msgid "vo_sm_char05_m06_stg26_07"
msgstr "Dubois: En avant!"

msgid "vo_sm_char05_m06_stg27_03"
msgstr "Dubois: Hedef imha edildi. Mermiler hep böyle ağır mıydı?"

msgid "vo_sm_char05_m06_stg27_04"
msgstr "Dubois: Herkes iyi mi? Ben iyiyim."

msgid "vo_sm_char05_m06_stg28_04"
msgstr "Dubois: Düşmanın sırtı yere geldi!"

msgid "vo_sm_char05_m06_stg31_01"
msgstr "Dubois: Olumlu!"

msgid "vo_sm_char05_m06_stg31_02"
msgstr "Dubois: Keşfe çıkıyorum."

msgid "vo_sm_char05_m06_stg31_03"
msgstr "Dubois: Bakıp rapor vereceğim."

msgid "vo_sm_char05_m06_stg31_04"
msgstr "Dubois: Gözetleme noktasına geçiyorum."

msgid "vo_sm_char05_m06_stg31_05"
msgstr "Dubois: Bacakları çalıştırma zamanı geldi. Bakalım ileride ne var."

msgid "vo_sm_char05_m06_stg31_06"
msgstr "Dubois: Murphy, yerimi almak ister misin?"

msgid "vo_sm_char05_m06_stg31_08"
msgstr "Dubois: Tahmin etmeliydim..."

msgid "vo_sm_char05_m06_stg31_09"
msgstr "Dubois: Kowalski, şöyle yapsan..."

msgid "vo_sm_char05_m06_stg31_11"
msgstr "Dubois: Tamam, ben giderim."

msgid "vo_sm_char05_m06_stg31_12"
msgstr "Dubois: Hafif egzersiz yapmaya başka kim var?"

msgid "vo_sm_char05_m06_stg31_13"
msgstr "Dubois: Tahmin etmiştim. Yola çıkıyorum."

msgid "vo_sm_char05_m06_stg32_01"
msgstr "Dubois: Düşman tespit edildi!"

msgid "vo_sm_char05_m06_stg32_02"
msgstr "Dubois: Panzerler göründü."

msgid "vo_sm_char05_m06_stg32_03"
msgstr "Dubois: Dikkat. Düşman zırhlıları."

msgid "vo_sm_char05_m06_stg32_04"
msgstr "Dubois: Onları görebiliyorum."

msgid "vo_sm_char05_m06_stg32_05"
msgstr "Dubois: Düşman göründü."

msgid "vo_sm_char05_m06_stg33_01"
msgstr "Dubois: Şimdilik bir şey yok ama yakında olmalılar."

msgid "vo_sm_char05_m06_stg33_02"
msgstr "Dubois: Görüş hattı boş ama tetikte kalın."

msgid "vo_sm_char05_m06_stg33_03"
msgstr "Dubois: Herhangi bir hareket görünmüyor. Bir yerlerde saklanıyorlar."

msgid "vo_sm_char05_m06_stg33_04"
msgstr "Dubois: Şimdlik boş...biraz daha beklesek iyi olur."

msgid "vo_sm_char05_m06_stg33_05"
msgstr "Dubois: Şimdlik bir şey yok. Biraz bekleyelim, bakalım devriyeleri görünecek mi."

msgid "vo_sm_char05_m06_stg42_03"
msgstr "Dubois: Messieurs, görevimizin başarısının bu haritayı toplamaya bağlı olduğunu hatırlatmak isterim."

msgid "vo_sm_char05_m06_stg43_04"
msgstr "Dubois: Mon Dieu, biz manzara seyrediyoruz diye zaman durmuyor."

msgid "vo_sm_char05_m06_stg48_03"
msgstr "Dubois: Her saniye önemli. Şimdi çok dikkatli olun."

msgid "vo_sm_char05_m06_stg53_03"
msgstr "Dubois: Dikkat! İleride düşman tankı var!"

msgid "vo_sm_char05_m06_stg55_03"
msgstr "Dubois: Mon Dieu! Murphy, nazar değdirdin!"

msgid "vo_sm_char05_m06_stg55_05"
msgstr "Dubois: Peki bundan önce hangi moddaydın?"

msgid "vo_sm_char05_m06_stg56_01"
msgstr "Dubois: Murphy, Allah aşkına dikkatli ol! Mayın tarlası içindeyiz!"

msgid "vo_sm_char05_m06_stg56_05"
msgstr "Dubois: Murphy, nereye gittiğini biliyor musun? Haritanın son parçasını çizmedin!"

msgid "vo_sm_char05_m06_stg56_07"
msgstr "Dubois: Ben de ondan korkuyorum!"

msgid "vo_sm_char05_m06_stg59_04"
msgstr "Dubois: Mon Dieu, Tiger tam arkamızda!"

msgid "vo_sm_char05_m06_stg59_05"
msgstr "Dubois: Cette bête bizi her an yakalayacak! Murphy, daha hızlı!"

msgid "vo_sm_char05_m06_stg68_03"
msgstr "Dubois: Murphy, isteyerek yaptın bunu, biliyorum! Lütfen bırak şu şakaları!"

msgid "vo_sm_char05_m06_stg72_05"
msgstr "Dubois: Bu görevi bitirmenin hareket eden her şeyi vurmaktan daha akıllıca yolları var."

msgid "vo_sm_char05_m06_stg73_02"
msgstr "Dubois: Evet. Ama Chaffee'ye sığmaz."

msgid "vo_sm_char05_m06_stg74_01"
msgstr "Dubois: Murphy, hiç Paris'e gittin mi?"

msgid "vo_sm_char05_m06_stg74_04"
msgstr "Dubois: Ona aldırma, böyle eğleniyor."

msgid "vo_sm_char05_m06_stg75_02"
msgstr "Dubois: Yok, bilmiyordum."

msgid "vo_sm_char05_m06_stg75_04"
msgstr "Dubois: Rüyamda Fransa'yı görüyordum demek."

msgid "vo_sm_char05_m06_stg76_02"
msgstr "Dubois: Très bien. Tekrarla bakayım: ''Comment? Je ne comprends pas.''"

msgid "vo_sm_char05_m06_stg76_04"
msgstr "Dubois: Tercüme ettin. Tekrar et demiştim."

msgid "vo_sm_char05_m06_stg82_04"
msgstr "Dubois: Niye?"

msgid "vo_sm_char05_m06_stg82_06"
msgstr "Dubois: Fransızlar niye salyangoz yer biliyor musun? Çünkü hızlı yemekleri sevmeyiz."

msgid "vo_sm_char05_m06_stg83_01"
msgstr "Dubois: Murphy, bana Üç Silahşörler'den bir karakteri anımsatıyorsun."

msgid "vo_sm_char05_m06_stg83_03"
msgstr "Dubois: Murphy, o Shakespeare."

msgid "vo_sm_char05_m06_stg86_01"
msgstr "Dubois: Keller, Almanların 300'den fazla ekmek türü olduğu doğru mu?"

msgid "vo_sm_char05_m06_stg86_03"
msgstr "Dubois: Etkileyici. Peki hiç Fransız bageti denedin mi?"

msgid "vo_sm_char05_m06_stg86_05"
msgstr "Dubois: Fransa için mükemmel bir metafor!"

msgid "vo_sm_char05_m06_stg87_02"
msgstr "Dubois: Nerede? Bir şey görmüyorum."

msgid "vo_sm_char05_m06_stg87_04"
msgstr "Dubois: Mon Dieu..."

msgid "vo_sm_char05_m06_stg90_02"
msgstr "Dubois: La Marseillaise."

msgid "vo_sm_char05_m06_stg91_01"
msgstr "Dubois: Murphy, buradan sağa mı sola mı?"

msgid "vo_sm_char05_m06_stg91_03"
msgstr "Dubois: Ah, Murphy..."

msgid "vo_sm_char05_m06_stg92_02"
msgstr "Dubois: Ne?"

msgid "vo_sm_char05_m06_stg93_02"
msgstr "Dubois: Onu da kaybedesin diye mi?"

msgid "vo_sm_char06_m05_stg01_01"
msgstr "McCormick: Dinleyin çocuklar! Kafanızı kaldırmayın ve hızlı hareket edin!"

msgid "vo_sm_char06_m05_stg01_01_01"
msgstr "McCormick: Koruganlara odaklanın, kuvvetlerimiz için yolu açmalıyız."

msgid "vo_sm_char06_m05_stg01_01_02"
msgstr "McCormick: Yapmamız gereken bir iş var, hakkını verelim!"

msgid "vo_sm_char07_m04_stg19_04"
msgstr "Olumlu!"

msgid "vo_sm_char07_m05_stg01_03"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_04"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_05"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_06"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_07"
msgstr "Düşman topçusuna dikkat edin!"

msgid "vo_sm_char07_m05_stg01_08"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_09"
msgstr "?empty?"

msgid "vo_sm_char07_m05_stg01_10"
msgstr "?empty?"

