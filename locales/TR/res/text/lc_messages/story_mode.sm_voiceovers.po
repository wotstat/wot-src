msgid "vo_sm_char10_m05_stg28_01"
msgstr "Karargâh Subayı: Sahil temizlendi. Ana kuvvetleri gönderiyoruz. Mükemmel iş çıkardınız."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Karargâh Subayı: Konumunuzu koruyun. Destek kuvvetleri yolda."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Karargâh Subayı: Ne pahasına olursa olsun köprübaşını savunun."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Karargâh Subayı: Bir tank daha, bir şans daha. Bu sefer dikkatli olun."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Karargâh Subayı: Yedeklerimiz azalıyor. Komutan, bu sefer işe yarasın."

