msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire pilotu: Görüş koşulları kötü, destek olamıyorum!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire pilotu: Çok fazla uçaksavar ateşi var, destek olamıyorum!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire pilotu: Ağır uçaksavar ateşi var, atış düzeltme yapmak mümkün değil."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire pilotu: Burada sanki uçaksavar fırtınası var gibi."

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire pilotu: Bu ateş altında geminin ateşini düzeltemeyiz."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire pilotu: Koruganların yakındaki o uçaksavar bataryalarının susması lazım."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire pilotu: Daha aşağı inmeyi başardım."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire pilotu: Artık yerdeki duman işaretlerini kullanarak büyük topların atışlarını yönlendirebilirim."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire pilotu: Tanklar, hamle sırası sizde!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire pilotu: Dumanı tespit ettim."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire pilotu: Doğrudan isabet için koordinatları zırhlıya aktarıyorum."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire pilotu: Lanet olsun, bizimkilerden biri düştü! Hâlâ daha alçalamıyorum."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire pilotu: Hemen bir uçaksavar topunu daha susturmamız lazım!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire pilotu: Uçaksavar silahları sustu, alçalıyorum. Zırhlımızdan daha yoğun ateş yönlendirmeye hazırım."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire pilotu: Dikkat! Size doğru ilerleyen büyük bir düşman grubu tespit edildi."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire pilotu: Ellerindeki her şeyle saldırıyorlar."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire pilotu: Dikkat, yeni bir düşman grubu yaklaşıyor. Tetikte kalın."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire pilotu: Dikkat, son ve en büyük düşman dalgası geliyor."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire pilotu: Tüm yönlerden geliyorlar. Sıkı durun."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire pilotu: Duman sinyalini net görüyorum. Koordinatlar zırhlıya gönderiliyor."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire pilotu: İşte duman işaretimiz. Konumu zırhlıya iletiyorum."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire pilotu: Duman hedefin üstünde. Tam konumu zırhlıya gönderiyorum."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire pilotu: Dumanı görüyorum, sanırım dostlarımızın yardıma ihtiyacı var."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "USS Frankford komutanı: Ateş desteği için koordinat bekliyoruz."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "USS Frankford komutanı: Kör atış tehlikeli, kendi adamlarımızı vurabiliriz."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "USS Frankford komutanı: Kesin hedef gerekiyor, ateş etmiyoruz."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "USS Frankford komutanı: Burası USS Frankford Komutanı. Olumsuz."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "USS Frankford komutanı: İlerlemeye destek veremiyoruz. Görüş imkanları çok kötü."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "USS Frankford komutanı: Falezleri ve koruganları göremiyoruz, sadece sahildeki tanklarımız görünüyor."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "USS Frankford komutanı: Tankların falezlere doğru çatıştığını görüyoruz."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "USS Frankford komutanı: O yönde ateşle destek vereceğiz."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "USS Frankford komutanı: Umarım bu Sherman nereye ateş ettiğini biliyordur."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "USS Frankford komutanı: Sherman hedef değiştirdi. Biz de ona uyuyoruz."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "USS Frankford komutanı: Sherman ateş etmeyi durdurdu. Burada iş bitti."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "USS Frankford komutanı: Daha içerideki koruganlara ulaşamıyoruz."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "USS Frankford komutanı: Şimdi güvenli mesafeye çekiliyoruz. Sahilde şansınız açık olsun."

