msgid "special_style/st_patricks_day_2024_3_desc"
msgstr "Yonca Yüzleşmesi şerefine, Zümrüt Ada'nın ruhunu yakalayan her mevsimlik bir stil."

msgid "special_style/st_patricks_day_2025"
msgstr "Kaderin Ocağı"

