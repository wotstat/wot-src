msgstr "Devre Kartı"

msgid "special_style/white_tiger_2020_hounds_desc"
msgstr "Son Waffenträger 2020 etkinliği sırasında alınabilen her mevsimlik bir stil."

msgid "special_style/white_tiger_2021"
msgstr "Transdüktör (Açık)"

msgid "special_style/white_tiger_2021_desc"
msgstr "Waffenträger'in Dönüşü 2021 etkinliği sırasında alınabilen her mevsimlik bir stil."

msgid "special_style/white_tiger_2021_engineer"
msgstr "Endüksiyon Bobini"

