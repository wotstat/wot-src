msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Oturumda tespitiniz sayesinde verilen hasarın ve palet yok edip hareketsiz bırakmanız veya şoka sokmanız sayesinde müttefiklerin verdiği hasarın yapılan savaş sayısına oranı. Delta, mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "\"Verilen hasar\" ile \"Alınan hasar\" parametrelerinin oranı. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Yok edilen düşman araçlarının oyuncunun aracının yok edilme sayısına oranı. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Oturum için tespit edilen düşman araçlarının yapılan savaş sayısına oranı."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Oyuncunun aracının yok edilmediği toplam savaş yüzdesi."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Bir oturumdaki Rastgele Savaş zaferlerinin yüzdesi. Delta, mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/wins"
msgstr "Bir oturumdaki Rastgele Savaş zaferlerinin sayısı. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/wtr"
msgstr "Tüm oturum için ortalama değerlere göre WTR. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

