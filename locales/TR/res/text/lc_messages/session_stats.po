msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Oturumda verilen toplam hasarın yapılan savaş sayısına oranı. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Yok edilen araçların yapılan savaş sayısına oranı."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Oyun oturumu için kullandığınız araçların ortalama Seviyesi."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Oturumda toplam deneyimin yapılan savaş sayısına oranı. Delta mevcut oyun oturumunun toplam parametre üzerindeki etkisini gösterir."

