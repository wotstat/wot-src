msgid "T26_E4_SuperPershing_FL_short"
msgstr "T26E4 FL"

msgid "T26_E4_SuperPershing_descr"
msgstr "Ateş gücünü artırmak için Ocak 1945'de T26E1'e yeni uzun namlulu bir 90 mm'lik top monte edildi. Prototip T26E4 olarak isimlendirildi. Geliştirilmesi Ocak 1947'de top ve yükleme mekanizmasındaki problemlerden dolayı durduruldu. O tarihe kadar toplam 25 adet üretilmişti ancak asla hizmete girmedi."

msgid "T26_E4_SuperPershing_long_special"
msgstr "Araç birçok atışı püskürtebilecek harika ön zırha (ve kalkana!) sahiptir ve seviyesi için harika olan bir top ile karşılık verebilir. Araç vasat hareket kabiliyetine sahiptir o yüzden saldırı yönünüzü dikkatli seçin."

msgid "T26_E4_SuperPershing_short"
msgstr "T26E4"

msgid "T26_E4_SuperPershing_short_special"
msgstr "İsabetli top, harika ön zırh"

