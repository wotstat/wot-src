msgid "battleship/name"
msgstr "Duman İşareti"

msgid "battleship/shortDescr"
msgstr "Zırhlılardan topçu salvosunun alanını gösteren bir duman işareti. Salvo orada bulunan düşman donanımına ve cisimlere hasar verir."

msgid "distraction_ability/name"
msgstr "Sahte Emir"

msgid "distraction_ability/shortDescr"
msgstr "Gefr. Keller'ın ele geçirilen Alman telsizi ile bir sahte emir vermesini ve düşmanları belirli bir konumu incelemeye yönlendirmesini sağlayın."

msgid "recon_ability/name"
msgstr "Bölge Keşfi"

msgid "recon_ability/shortDescr"
msgstr "Yzb. Dubois'yı belirli bir konuma keşfe gönderin. Tank, keşfe gittiğinde durur ve sabit kalır. Yetenek iptal edilene kadar işlemeye devam eder."

msgid "scc_airstrike_ability/name"
msgstr "Hava Desteği"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Belirtilen konuma hava saldırısı isteyin."
