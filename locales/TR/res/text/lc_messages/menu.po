msgid "extraParams/multiDesc"
msgstr "Toplam bonus, hem toplanan hem de çarpan değiştiriciler kullanılarak hesaplanır, dolayısıyla burada gösterilenden daha büyük veya küçük olabilir."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Bu parametre KMT'nin atışı ile uyarıyı almanız arasında geçen süreyi gösterir."

msgid "extraParams/name/commanderLampDelay"
msgstr "Bu parametre, Komutanın aracınızın düşman tarafından tespit edildiğini anlamasına kadar geçen gecikmeyi gösterir. Değer ne kadar yüksekse gecikme o kadar kısa olur."

msgid "extraParams/name/crewHitChance"
msgstr "Bu parametre mürettebat üyelerinizin yaralanmadan kaçınma şansını gösterir."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Bu parametre zaten şoktaki bir araç için ek şok süresini gösterir."

msgid "extraParams/name/crewStunDuration"
msgstr "Bu parametre alınan şokun süresini gösterir."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Bu parametre minimum potansiyel hasar ve potansiyel delme değerinin temel değere oranla değişimini (-%25) gösterir."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Bu parametre maksimum potansiyel hasar ve potansiyel delme değerinin temel değere oranla değişimini (+%25) gösterir."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Bu parametre çarpma yoluyla verilen hasar miktarını gösterir. Araçlar çarpıştığında sistem darbe noktasındaki zırh kalınlığını, araçların ağırlığı arasındaki farkı ve araçların hızlarını dikkate alır."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Bu parametre Komutanın nişangâhınızdaki düşman aracının aldığı kritik hasarı tespit etmesine kadar geçen gecikmeyi gösterir."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Bu parametre yeşillik tarafından tamamen gizlenmiş (hem tek başına hem gruplaşmış yeşillik) düşmanları keşfetme değerini gösterir. Hem sabit duran hem hareket eden araçlar için geçerlidir."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Bu parametre hareket halindeki araçları keşfetme gösterir."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Bu parametre, düşman mürettebatına ve parçalarına kritik hasar verme olasılığındaki değişiklikleri gösterir. Etkisi, otomatik topu olan araçlar hariç tüm mermi türleri için geçerlidir."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Bu parametre sarf malzemelerinin soğuma süresini gösterir."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Bu parametre yangının süresindeki ve vereceği hasar miktarındaki düşüşü belirler."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Bu parametre yeşillik arkasında gizlenmenin etkisini gösterir."

msgid "extraParams/name/hpRecover"
msgstr "Bu parametre Tamir Çantası kullanıldığında CP geri kazanımındaki artışı gösterir. Değer ne kadar yüksekse o kadar çok DP geri kazanılır."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Bu parametre süspansiyonun orta yumuşaklıktaki zeminde geçiş kapasitesini gösterir. Değer ne kadar yüksekse düz hıza ulaşmak için gereken süre o kadar kısa olur."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Bu parametre, gözetleme cihazları imha edildiğinde maksimum görüş mesafesine gelen cezayı azaltır. Değer ne kadar düşükse görüş imkânı o kadar iyi olur."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Bu parametre 50 m'den kısa mesafelerde mermilerin maksimum potansiyel delme değerlerindeki artışı gösterir. Değer ne kadar yüksekse delme gücü de o kadar iyi olur."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Bu parametre aracınız yok edildikten sonra düşman konumlarını bildirmedeki ek süreyi gösterir."

msgid "extraParams/name/radiomanHitChance"
msgstr "Bu parametre Telsiz Operatörünüzün yaralanmadan kaçınma şansını gösterir."

msgid "extraParams/name/shellVelocity"
msgstr "Bu parametre, her tür mermi için mermi hızındaki artışı gösterir. Değer ne kadar yüksekse mermi hızı o kadar yüksek olur."

msgid "extraParams/name/softGroundFactor"
msgstr "Bu parametre, süspansiyonun yumuşak zeminde geçiş kapasitesini gösterir. Değer ne kadar yüksekse düz hıza ulaşmak için gereken süre o kadar kısa olur."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Bu parametre mürettebatın şoka girmesinin olumsuz etkilerinin derecesini gösterir."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Bu parametre süspansiyona gelen hasardaki indirimi gösterir. Değer ne kadar yüksekse o kadar az hasar alınır."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Bu parametre, hasarlı cephanelik nedeniyle top yükleme süresine gelen cezadaki indirimi gösterir. Değer ne kadar yüksekse yükleme süresi o kadar kısa olur."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Bu parametre, hasarlı bir motor nedeniyle kaybedilen motor gücündeki azalmayı gösterir. Değer ne kadar yüksekse motor o kadar az güç kaybeder."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Bu parametre cephaneliğin, benzin depolarının ve motorun dayanıklılığını gösterir. Değer ne kadar yüksekse parçalarınız o kadar dayanıklı olur."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Bu parametre cephaneliğin dayanıklılığını gösterir. Değer ne kadar yüksekse cephaneliğiniz o kadar dayanıklı olur."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Bu parametre darbe sırasında süspansiyon tarafından yol açılan hasarı gösterir. Darbe sırasında kulenin yanına veya tepesine verilen hasarı etkilemez."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Bu parametre süspansiyon onarımının hızını gösterir. Değer ne kadar yüksekse onarım hızı o kadar yüksek olur."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Bu parametre süspansiyonun dayanıklılığını gösterir. Değer ne kadar yüksekse süspansiyonunuz hem mermilere hem darbeye/çarpmaya o kadar dayanıklı olur."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Bu parametre düşmanların görüş mesafenizden çıktıktan sonra görünür kalacakları süreyi gösterir. Normal değer 10 saniyedir."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Bu parametre, bir aracın darbe sonucu alacağı hasardaki indirimi gösterir. Değer ne kadar yüksekse o kadar az hasar alınır."

msgid "extraParams/name/vehicleFireChance"
msgstr "Bu parametre hasar aldığında motorda yangın çıkma olasılığını gösterir."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Bu parametre yakıt tanklarının kritik hasara karşı dayanıklılığını gösterir. Yakıt tankları yok edildiğinde mutlaka yangına yol açar."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Bu parametre hareket, gövde ve kule dönüşü durumunda topun isabetliliğindeki azalmayı gösterir. Değer ne kadar düşükse nişan alma çemberinin dağılımı o kadar az olur."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Bu parametre, ateş ettikten sonra nişan alma çemberinin boyutunu gösterir."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Bu parametre hareket sırasında dağılımı gösterir. Değer ne kadar düşükse top o kadar isabetli olur."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Bu parametre gövde dönüşü sırasında dağılımı gösterir. Değer ne kadar düşükse top o kadar isabetli olur."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Bu parametre top dönüşü sırasında dağılımı gösterir. Değer ne kadar düşükse top o kadar isabetli olur."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Bu parametre hasarlı bir topun dağılımını gösterir. Değer ne kadar yüksekse isabetlilik o kadar düşük olur."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Bu parametre, HE mermilerden alınan hasarı gösterir. Darbe noktasındaki zırh ne kadar kalınsa etkisi o kadar yüksek olur."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Bu parametre, ateş ettikten sonraki gizliliği gösterir."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Bu parametre aracınızın düşmanın görüş mesafesinden çıktıktan sonra görünür kalacağı süreyi gösterir. Normal değer 10 sn.dir."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Bu parametre çarpma yoluyla süspansiyonun alacağı hasar miktarını gösterir. Araçlar çarpıştığında sistem darbe noktasındaki zırh kalınlığını, araçların ağırlığı arasındaki farkı ve araçların hızlarını dikkate alır."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Bu parametre çarpma yoluyla alınan hasar miktarını gösterir. Araçlar çarpıştığında sistem darbe noktasındaki zırh kalınlığını, araçların ağırlığı arasındaki farkı ve araçların hızlarını dikkate alır."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Bu parametre yüklü bir topta mermi türleri arasında değişim yapma hızını gösterir."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Bu parametre iç ve dış parça onarımlarının \"kırmızı\" durumdan \"sarı\" duruma geçme hızını gösterir. Değer ne kadar yüksekse onarım o kadar hızlı olur."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Bu parametre süspansiyonun geçiş kapasitesini gösterir. Değer ne kadar yüksekse düz hıza ulaşmak için gereken süre o kadar kısa olur."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Bu parametre tekerlekli bir aracın yön değiştirme hızını gösterir."

