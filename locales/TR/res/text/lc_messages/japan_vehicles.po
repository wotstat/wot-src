msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Osaka Topçu Arsenali tarafından Type 2589'un yerine geliştirildi. Chi-Ni ve Chi-Ha 1937'de birleşik denemelere girdi. Chi-Ha'nın daha başarılı olduğuna karar verildi. Bir prototip üretildi."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Type 3 Chi-Nu Kai orta tank Type 3 Chi-Nu süspansiyonu ve kulesi ile Type 4 Chi-To topunun bir bileşimidir. Sadece bir prototip üretildi. Mart 1945'de denemelere hazırdı."

msgid "Chi_Nu_Kai_long_special"
msgstr "Bu herhangi belirgin bir avantajı veya dezavantajı olmayan standart bir orta tanktır. Her türlü savaş durumuna uygundur."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Yüksek isabetlilik, delme, top kalkanında iyi zırh"

