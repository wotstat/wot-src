msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Anomali kaynağı yaklaşıyor. Tabii ki koca bir tank."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Yok edersek bu iş biter. Hadi arkadaşlar!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Zırhındaki zayıf noktalara ateş edin."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Arkadaşlar, dev, çirkin bir canavar bize doğru geliyor,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "benzeri görülmemiş bir şey."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Zayıf noktaları görünüyor gibi. Röleyi alıp"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "görevi bitirmek için boss'u yok etmeliyiz."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Şanslı günümüzdeyiz! Bir yerine iki boss?"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "Bu görülmemiş. Yine de kazanacağız. Zırhındaki zayıf noktalara"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "ateş edin ve korumalarını yok etmeyi unutmayın."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Bu zorlu bir düşman ama zayıf noktaları var."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Bu yaratığı yok edersek iş biter. Hadi dostlar, gidelim!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Düşmanın zayıf noktalarına ateş edin. Çömezlerini de"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "yok etmeyi unutmayın yoksa işler zorlaşacak."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Anomaliyi kapatmak için boss'u yok etmeliyiz."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Zırhındaki zayıf noktalara nişan alın."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Görevi tamamlamak için son düşmanı da yok etmemiz gerekiyor."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Zayıf noktalarına ateş edin."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Yolumuzdaki son engel bu."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Hadi dostlar, toparlanın! Şu canavarı yok edelim!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Düşman çok tehlikeli ama zayıf noktaları var."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "İşte bu işi kesin bir şekilde bitirme şansımız."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Bakalım anomali bizim için neler hazırlamış."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Zorlu bir düşman ama zayıf noktaları var."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Hadi dostlar, şu canavarı alt edelim!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Bu çok güçlü bir düşman. Yine de başarabiliriz, eminim."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Bugün bir fiyatına iki boss var."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Hadi, böyle fırsat kaçmaz! Zırhındaki zayıf"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "noktalara nişan alın. Bu canavarları yok edelim!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Anlaşılan bosslar sıralarını karıştırıp buraya beraber"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "gelmişler. İkisinin de zayıf noktaları var, oralara nişan alın."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Yine bir çift tatlı boss. Dostlar, ne yapacağınızı biliyorsunuz."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Zayıf noktalarına ateş edin, çömezlerini temizleyin."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Acele edin!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Dostlar, fena dövdük onu!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Ama görünüşe göre işimiz bitmedi."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Güzel! Ama daha işin yarısındayız."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Arkadaşları ile birlikte dönmek üzere."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "İşte böyle! Hadi tanklarımızı onarıp tekrar gidelim."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "O kadar kolay yenilmeyecek. İkinci raunda hazırlanın."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Dostlar, fena vurduk onları! Ama henüz bitmedi."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Güzel! Ama daha işin yarısındayız."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Arkadaşları ile birlikte dönmek üzereler."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "İşte böyle! Hadi tanklarımızı onarıp tekrar gidelim."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "O kadar kolay yenilmeyecekler. İkinci raunda hazırlanın."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Ben Yüzbaşı Smith. Yarığın dışındaki dostlarımız"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "yankı tanklarının Babil tesisine saldırılarını durdurmakla meşgulken"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "bizim görevimiz tüm fazlardan geçip anomaliyi kapatmak."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Bunu yapmak için tüm fazlarda toplayıcıları doldurmamız gerekiyor. Harekete geçin!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Mirium uzayının derinliklerinde bir düşman üssü tespit edildi."

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "İstila için devasa bir ordu hazırlıyorlar. Onları durdurmak için"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "tek şansımız, yollarını kapatmak. Görevimiz, anomalinin"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "derin bir fazına geçip yollarını açık tutan bir röleyi "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "çıkarmak. Magnus'u Mirium ile şarj edin,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "son noktaya gidiyoruz!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Herkese merhaba! Yankı tanklarının bizim gerçekliğimize"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "olan yolunu kapatmamız gerekiyor. Karşı istihbarat, Babil'deki"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "casusları halleder, bizim ödevimiz ise Mirium. Tüm fazlardaki toplayıcıları doldurun,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "bizi aşağıda bekleyen o şeyleri tepeleyin,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "ve şu deliği kapatın. Motorları çalıştırın!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Ben Smith. Ödevimiz Babil tesis bölgesindeki yarığı"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "kapatmak. Toplayıcıları Mirium'la doldurun ve bizden olmayan"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "her şeyi yok edin. Hadi dostlar, düşman bizi bekliyor!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Bizimkiler yankı tanklarının gerçek dünyaya yarıp geçmesini"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "engelliyor. Sizin göreviniz yarığı kapatmak."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Ne kadar çabuk, o kadar iyi. Mirium toplayın ve o deliği tıkayın."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Düşman tankları Babil tesisine saldırıyor. O pislik yarıktan"

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "çıkıyor, bizim de yollarını kapatmamız gerek."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Anomalinin derinliklerine inin ve kaynağını etkisiz hâle getirin. Hadi gidelim!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Ben Smith. Görevimiz, Alman yankı tank ordusunu anomali"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "içine hapsetmek. Hedefimiz hâlihazırda"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "derin fazda. Oraya ulaşmak için Magnus'u doldurun."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Mirium uzayının derinliklerinde bir düşman üssü keşfedildi."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Taarruzlarını oradan planlıyorlar."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Küçük kızı dikkate almayın. Görevimiz Magnus'u"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "etkinleştirmek ve en derin faza yolu açmak, böylece"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "düşmanı kesin bir şekilde oraya hapsedebiliriz."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "En derin fazda bir düşman üssü tespit edildi."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Şimdilik onları yenemeyiz ama oraya hapsedebiliriz."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Bu yarığın en dibine gitmek için Mirium toplayın."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Dostlar, size güveniyorum! Bunu yapabiliriz!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Sonuncusu kapandıktan kısa süre sonra yeni bir yarık açıldı."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Görevimiz aynı: Maddeyi toplayıp anomaliyi kapatarak"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "gerçekliğimize yönelik istilayı durdurmak. Hadi gidelim!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Yarık yine açıldı. Madde toplayın ve toplayıcıyı doldurun."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Şu lanet anomaliyi kapatmamız gerek. Dışarıdakiler"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "bize güveniyor ama çok uzun süre dayanamazlar!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Babil tesisi hâlâ düşman tanklarının saldırısı altında."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Madde toplayın ve Magnus'u şarj edin. Yankı tanklarının"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "dünyamızı istilasını durdurmak için anomaliyi kapatmalıyız."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Hedefimiz yakında. Dikkatli olun ve gözünüz"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "Ölümsüz tarayıcısında olsun."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Çok iyi dostlar! Tempoyu koruyun! Buraya çay"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "içmeye gelmedik. Daha çok Mirium'a ihtiyacımız var."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Çok iyi ekip çalışması! Devam edelim, daha çok Mirium'a ihtiyacımız var."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Çok iyi! Daha da derine inmek için Magnus'u etkinleştirmemiz gerekiyor."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium her fazda bizi daha da güçlendiriyor."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Sakın kopup gitmeyin."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Magnus'u etkinleştirmemiz gerek. Son bir gayret daha!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Görevimiz aynı: Toplayıcıyı doldurmamız gerekiyor."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "İstilanın kaynağına yaklaşıyoruz."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Ödevimiz aynı: Toplayıcıyı doldurmak."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Güzel şarkı. Dostlar, dikkatinizi dağıtmayın."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Mirium toplayıp daha derine inmemiz gerek."

msgid "narrator"
msgstr "Smith"
