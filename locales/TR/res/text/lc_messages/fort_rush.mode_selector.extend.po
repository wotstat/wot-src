msgid "mode/fort_rush_battle/description"
msgstr "Antenlerin kontrolünü ele alın. Ağı elinizde tutun. İletimi güvenceye alın."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Bilgisayarınızın performansı bu kip için yeterli değil. Grafikler ve araç hareketi ile ilgili sorunlar yaşayabilirsiniz. Oyun istemcisinin çökmesi de olasıdır."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Düşük Performans"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Düşük Performans"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Bu kip yüksek bilgisayar performansı gerektirir. Harita yüklenmesi, grafikler ve araç hareketi ile ilgili sorunlar yaşayacaksınız. Yetersiz performans durumunda Ayarlarınızdan daha düşük grafik kalitesi kullanmayı deneyin."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Düşürülmüş Performans"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Düşürülmüş Performans"
