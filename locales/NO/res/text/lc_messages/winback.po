msgid "dailyQuestsIntroView/info/mode/description"
msgstr "Warm-Up vil minne deg på spillets basisregler. Kamper spilles mot KI-kontrollerte kjøretøy og resultatene teller ikke med i din statistikk. Du kan forlate Warm-Up når som helst for å fortsette å spille i tilfeldige kamper."

msgid "dailyQuestsIntroView/info/mode/title"
msgstr "Warm-Up"

msgid "dailyQuestsIntroView/info/quests/description"
msgstr "Fullfør oppdrag, avslutt fremgangstrinnene i Back in Action og få verdifulle belønninger til bruk i spillet. Hvert fullførte standard-, premium- eller bonusoppdrag teller med i forhold til belønningen. Oppdrag kan fullføres i Warm-Up og tilfeldige kamper."

msgid "dailyQuestsIntroView/info/quests/descriptionBP"
msgstr "Fullfør oppdrag, avslutt fremgangstrinnene i Back in Action og få verdifulle belønninger. I løpet av Battle Pass vil poeng til Battle Pass legges til i belønningene dine. Oppdrag kan fullføres i Warm-Up og tilfeldige kamper."

msgid "dailyQuestsIntroView/info/quests/title"
msgstr "Back in Action"

msgid "dailyQuestsIntroView/info/rewards/description"
msgstr "Du kan få premium leiekjøretøy på nivå 8, utviklingsbare kjøretøy på nivå 6 og rabatter på utvikling og kjøp av kjøretøy i belønning. Etter fullførelse av fremgangen, får du hovedbelønningen."

msgid "dailyQuestsIntroView/info/rewards/title"
msgstr "Belønninger"

msgid "dailyQuestsIntroView/title"
msgstr "BACK IN ACTION"

