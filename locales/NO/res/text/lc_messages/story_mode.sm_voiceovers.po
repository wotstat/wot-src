msgid "vo_sm_char11_m03_stg18_03"
msgstr "Pilot: Hei der, bakkestyrker, dette er Eagle-One."

msgid "vo_sm_char11_m03_stg18_03_01"
msgstr "Pilot: Vi sveiper over byen nå, har en haug med tanks i siktene våre."

msgid "vo_sm_char11_m03_stg18_03_02"
msgstr "Pilot: Og vi er klare til å regne ned noen pakker. Kom dere vekk der nede."

msgid "vo_sm_char11_m03_stg18_03_03"
msgstr "Pilot: Eagle-One ut."

msgid "vo_sm_char11_m03_stg22_01"
msgstr "Pilot: Dette er Eagle One, høyt og tydelig."

msgid "vo_sm_char11_m03_stg22_01_01"
msgstr "Pilot: Du har en mindre gruppe mål på torget."

msgid "vo_sm_char11_m03_stg22_01_02"
msgstr "Pilot: Vi gjør oss klare til en overflyvning nå."

msgid "vo_sm_char11_m03_stg22_01_03"
msgstr "Pilot: Det vi ikke gjør om til fyrverkeri, blir deres jobb å avslutte. God jakt! Over."

msgid "vo_sm_char11_m03_stg23_02"
msgstr "Pilot: Hvor kom de fra? Jeg var sikker på at vår luftstøtte hadde klarert himmelrommet."

msgid "vo_sm_char11_m03_stg28_01"
msgstr "Pilot: Dette er Eagle One, over."

msgid "vo_sm_char11_m03_stg28_01_01"
msgstr "Pilot: Du har en heftig gruppe pansrede kjøretøy som ruller din vei fra landsbyen."

msgid "vo_sm_char11_m03_stg28_05"
msgstr "Pilot: Vi tar en overflyvning og... Faen!"

msgid "vo_sm_char11_m03_stg28_05_01"
msgstr "Pilot: Kampfly kl. 8… Klarer ikke riste av meg denne fyren."

msgid "vo_sm_char11_m03_stg28_05_02"
msgstr "Pilot: Hvor er eskorten vår for helvete! A-a-ahh!"

msgid "vo_sm_char12_m04_stg07_02"
msgstr "Pilot: Storm Petrel her."

msgid "vo_sm_char12_m04_stg07_04"
msgstr "Pilot: Mottatt. King Tigerne kommer til å ha en dårlig dag."

msgid "vo_sm_char12_m04_stg08_01"
msgstr "Pilot: Knus den!"

msgid "vo_sm_char12_m04_stg12_01"
msgstr "Pilot: Fiende bekjempet."

msgid "vo_sm_char12_m04_stg12_02"
msgstr "Pilot: Storm Petrel. Ikke Seagull."

msgid "vo_sm_char12_m04_stg21_01"
msgstr "Pilot: Jeg ser den."

msgid "vo_sm_char12_m04_stg21_01_01"
msgstr "Pilot: Mål bekjempet om 3... 2... 1..."

msgid "vo_sm_char12_m04_stg22_01"
msgstr "Pilot: Klar for nye mål, Betsy."

msgid "vo_sm_char12_m04_stg24_02"
msgstr "Pilot: Helvete!"

msgid "vo_sm_char12_m04_stg24_04"
msgstr "Pilot: Det er ikke bare en Jagdtiger der nede. De gjemmer seg i bygninger."

msgid "vo_sm_char12_m04_stg24_04_01"
msgstr "Pilot: Vi trenger noe mer slagkraftig. På tide å tilkalle noe større!"

msgid "vo_sm_char12_m04_stg30_01"
msgstr "Pilot: Sånn skal det gjøres! Klar for den neste!"

msgid "vo_sm_char12_m04_stg32_02"
msgstr "Pilot: Klar til å angripe på ditt signal."

msgid "vo_sm_char12_m04_stg41_02"
msgstr "Pilot: Direkte treff!"

msgid "vo_sm_char12_m04_stg45_02"
msgstr "Pilot: Bekreftes! Engasjerer!"

msgid "vo_sm_char12_m04_stg46_02"
msgstr "Pilot: Endelig! Drar tilbake til flystripa. Sees snart, folkens!"

msgid "vo_sm_char12_m04_stg48_01"
msgstr "Pilot: Klar og venter på målangivelse."

msgid "vo_sm_char12_m04_stg48_02"
msgstr "Pilot: Avventer bekreftelse på mål."

msgid "vo_sm_char12_m04_stg48_03"
msgstr "Pilot: Koordinater er påkrevet for et målangrep."

msgid "vo_sm_char12_m04_stg49_01"
msgstr "Pilot: Kan ikke treffe den før du immobiliserer den."

msgid "vo_sm_char12_m04_stg49_02"
msgstr "Pilot: Trenger at det målet står i ro for å få inn et presist angrep."

msgid "vo_sm_char12_m04_stg49_03"
msgstr "Pilot: Immobilitet er nøkkelen til et vellykket treff!"

msgid "vo_sm_char12_m04_stg50_01"
msgstr "Pilot: Snur rundt, jeg er straks tilbake."

msgid "vo_sm_char12_m04_stg50_02"
msgstr "Pilot: Reposisjonerer meg, straks tilbake."

msgid "vo_sm_char12_m04_stg51_01"
msgstr "Pilot: Klar til å angripe."

msgid "vo_sm_char12_m04_stg51_02"
msgstr "Pilot: Gi signal for når jeg skal angripe."

msgid "vo_sm_char12_m04_stg52_01"
msgstr "Pilot: Er fremdeles klar her."

msgid "vo_sm_char12_m04_stg52_02"
msgstr "Pilot: Venter fremdeles på instruksjoner."

msgid "vo_sm_char12_m04_stg53_02"
msgstr "Pilot: Bekreftes. Gjør meg klar til angrepet nå."

msgid "vo_sm_char12_m04_stg54_02"
msgstr "Pilot: Mottatt. Kommer inn for angrepet."

msgid "vo_sm_char12_m04_stg55_02"
msgstr "Pilot: Bekreftes. Engasjerer målet."

msgid "vo_sm_char12_m04_stg56_02"
msgstr "Pilot: Det stemmer. Nærmer meg målet."

msgid "vo_sm_char13_m06_outro_04"
msgstr "Smith: Ikke papirer i seg selv."

msgid "vo_sm_char13_m06_outro_06"
msgstr "Smith: Millioners vilje. Menn og kvinner som kjempet for å gi det papiret en betydning."

msgid "vo_sm_char13_m06_outro_07"
msgstr "Smith: Aldri igjen."

msgid "vo_sm_char13_m06_stg01_01"
msgstr "Kommandør, kaptein Smith: Rull ut. Husk, dette er et skjult oppdrag."

msgid "vo_sm_char13_m06_stg01_01_01"
msgstr "Smith: Unngå unødvendige engasjeringer og skyt kun når du absolutt må."

msgid "vo_sm_char13_m06_stg01_02"
msgstr "Smith: Dersom vi varsler hele garnisonen, er sjansene våre svært dårlige."

msgid "vo_sm_char13_m06_stg01_02_01"
msgstr "Smith: Når vi kan, finner vi omveier og skjuler oss."

msgid "vo_sm_char13_m06_stg01_03"
msgstr "Smith: Ingen tid å kaste vekk. Kjør ut. Hvert sekund teller."

msgid "vo_sm_char13_m06_stg02_06"
msgstr "Smith: Dropp det. Vi er alle her for å stanse krigshandlingene. Begge sider."

msgid "vo_sm_char13_m06_stg02_07"
msgstr "Smith: STOPP! Revers!"

msgid "vo_sm_char13_m06_stg02_08"
msgstr "Smith: Rygg!"

msgid "vo_sm_char13_m06_stg03_01"
msgstr "Smith: Rygg! Raskere!"

msgid "vo_sm_char13_m06_stg03_02"
msgstr "Smith: Revers, nå!"

msgid "vo_sm_char13_m06_stg03_03"
msgstr "Smith: Gå i skjul!"

msgid "vo_sm_char13_m06_stg03_04"
msgstr "Smith: Ser ut til at de ikke så oss godt nok."

msgid "vo_sm_char13_m06_stg03_04_01"
msgstr "Smith: Mørket er til vår fordel—gjør at det tar lenger tid å identifisere en amerikansk tanks."

msgid "vo_sm_char13_m06_stg03_05"
msgstr "Smith: Dersom vi kommer oss raskt gjennom vil de ikke klare å identifisere oss."

msgid "vo_sm_char13_m06_stg03_05_01"
msgstr "Smith: Murphy, få oss bak det hjørnet der."

msgid "vo_sm_char13_m06_stg03_06"
msgstr "Smith: Bra, Murphy. Vi må komme oss sakte nærmere. Og ikke skyt!"

msgid "vo_sm_char13_m06_stg03_07"
msgstr "Smith: La oss snike oss enda nærmere. Der!"

msgid "vo_sm_char13_m06_stg03_08"
msgstr "Smith: Hvis vi beveger oss raskt vil de ikke oppdage oss."

msgid "vo_sm_char13_m06_stg03_09"
msgstr "Smith: Jo raskere vi beveger oss, jo mindre tid får de til å legge merke til oss."

msgid "vo_sm_char13_m06_stg03_10"
msgstr "Smith: Om vi flytter raskt på oss får de ikke tid til å se godt etter hvem vi er."

msgid "vo_sm_char13_m06_stg04_01"
msgstr "Smith: Må rekognosere. Dubois, skaff deg et overblikk."

msgid "vo_sm_char13_m06_stg04_06"
msgstr "Smith: Jeg sa du skulle droppe det, Kowalski."

msgid "vo_sm_char13_m06_stg04_07"
msgstr "Smith: De flytter på seg. Dubois, kom deg inn igjen."

msgid "vo_sm_char13_m06_stg04_09"
msgstr "Smith: La oss skaffe oss disse kartbitene. Kjør."

msgid "vo_sm_char13_m06_stg05_01"
msgstr "Smith: Fillern! Fiende klokken 12. Kowalski, skyt!"

msgid "vo_sm_char13_m06_stg05_02"
msgstr "Smith: Murphy, unnvikende manøvre. Kowalski, avslutt ham raskt."

msgid "vo_sm_char13_m06_stg05_02_01"
msgstr "Smith: Vi har ikke tid til å rote rundt. Må holde oss lydløse."

msgid "vo_sm_char13_m06_stg05_06"
msgstr "Smith: Nok, Kowalski. Vi kommer oss ikke frem til guttene våre uten Keller."

msgid "vo_sm_char13_m06_stg05_06_01"
msgstr "Smith: La oss flytte på oss før noen andre dukker opp."

msgid "vo_sm_char13_m06_stg06_01"
msgstr "Smith: Tiger! Gå i dekning! Helvete."

msgid "vo_sm_char13_m06_stg06_03"
msgstr "Smith: Negativ. Kan ikke risikere det. Keller. Prøv å distraher ham."

msgid "vo_sm_char13_m06_stg06_04"
msgstr "Smith: Keller, kom igjen. Gjør det."

msgid "vo_sm_char13_m06_stg06_05"
msgstr "Smith: Bruk radioen for å lure dem."

msgid "vo_sm_char13_m06_stg06_13"
msgstr "Smith: Kjør vekk før han kommer tilbake."

msgid "vo_sm_char13_m06_stg08_01"
msgstr "Smith: Dubois, finn det kartet."

msgid "vo_sm_char13_m06_stg08_04"
msgstr "Smith: Hva er det?"

msgid "vo_sm_char13_m06_stg08_07"
msgstr "Smith: Vi skal samle inn kartbiter. La oss komme i gang."

msgid "vo_sm_char13_m06_stg09_02"
msgstr "Smith: Utmerket. Murphy, skriv det ned."

msgid "vo_sm_char13_m06_stg09_09"
msgstr "Smith: La oss komme oss til det neste punktet. Vi har lite tid."

msgid "vo_sm_char13_m06_stg10_03"
msgstr "Smith: La oss komme oss til den neste posten."

msgid "vo_sm_char13_m06_stg11_04"
msgstr "Smith: La oss flytte på oss. Hvert minutt teller."

msgid "vo_sm_char13_m06_stg11_05"
msgstr "Smith: Dubois, se etter kartet."

msgid "vo_sm_char13_m06_stg12_02"
msgstr "Smith: Murphy, hva slags fremgang har vi?"

msgid "vo_sm_char13_m06_stg13_04"
msgstr "Smith: I det minste vet vi om andre kommandoposter nå. Kjør ut."

msgid "vo_sm_char13_m06_stg14_01"
msgstr "Smith: Dubois? Fant du noe?"

msgid "vo_sm_char13_m06_stg14_05"
msgstr "Smith: Kjør til det neste punktet. Vi har lite tid."

msgid "vo_sm_char13_m06_stg15_01"
msgstr "Smith: Dubois, din tur."

msgid "vo_sm_char13_m06_stg15_08"
msgstr "Smith: La oss komme oss til den neste posisjonen."

msgid "vo_sm_char13_m06_stg16_01"
msgstr "Smith: Murphy, hva er status?"

msgid "vo_sm_char13_m06_stg17_04"
msgstr "Smith: La oss se hva vi kan finne."

msgid "vo_sm_char13_m06_stg18_01"
msgstr "Smith: Keller, er dette en kommandopost?"

msgid "vo_sm_char13_m06_stg20_01"
msgstr "Smith: Trekk tilbake!"

msgid "vo_sm_char13_m06_stg20_02"
msgstr "Smith: Ikke engasjer!"

msgid "vo_sm_char13_m06_stg20_03"
msgstr "Smith: Ikke skyt!"

msgid "vo_sm_char13_m06_stg20_04"
msgstr "Smith: Ikke skyt! Det er ikke derfor vi er her!"

msgid "vo_sm_char13_m06_stg20_05"
msgstr "Smith: Ta det med ro nå! Jobben vår er å levere et budskap, ikke starte mer krigshandlinger!"

msgid "vo_sm_char13_m06_stg20_06"
msgstr "Smith: Trekk tilbake nå! De kommer til å oppdage oss!"

msgid "vo_sm_char13_m06_stg20_07"
msgstr "Smith: Trekk tilbake! Ikke la dem se oss!"

msgid "vo_sm_char13_m06_stg20_08"
msgstr "Smith: Rygg, Murphy! Hold oss skjult!"

msgid "vo_sm_char13_m06_stg21_01"
msgstr "Smith: Uoppdaget. Hold det sånn."

msgid "vo_sm_char13_m06_stg21_02"
msgstr "Smith: Fienden ser oss ikke."

msgid "vo_sm_char13_m06_stg22_01"
msgstr "Smith: Rygg, nå! De har nesten oppdaget oss!"

msgid "vo_sm_char13_m06_stg22_02"
msgstr "Smith: Trekk tilbake! De er i ferd med å oppdage oss!"

msgid "vo_sm_char13_m06_stg22_03"
msgstr "Smith: Murphy, finn dekning til oss! De har ikke skjønt hvem vi er ennå!"

msgid "vo_sm_char13_m06_stg22_04"
msgstr "Smith: Kjør! De er fremdeles usikre!"

msgid "vo_sm_char13_m06_stg22_05"
msgstr "Smith: Kom deg inn i de skyggene! De så ikke hvem vi er!"

msgid "vo_sm_char13_m06_stg22_06"
msgstr "Smith: Murphy, snu! Ellers vil de skjønne det!"

msgid "vo_sm_char13_m06_stg23_01"
msgstr "Smith: Jeg tror vi burde trekke oss tilbake."

msgid "vo_sm_char13_m06_stg23_02"
msgstr "Smith: Vi kan ikke risikere oppdraget. La oss trekke oss tilbake."

msgid "vo_sm_char13_m06_stg23_03"
msgstr "Smith: Husk oppdraget vårt! Dersom tilbaketrekning er tryggere er det det lureste."

msgid "vo_sm_char13_m06_stg24_01"
msgstr "Smith: Bytt posisjon. De kommer til å søke gjennom dette området."

msgid "vo_sm_char13_m06_stg24_02"
msgstr "Smith: Kjør. Dette stedet kommer til å kry med Panzere snart."

msgid "vo_sm_char13_m06_stg25_01"
msgstr "Smith: De fant oss ikke. Hold oss lavt og i ro."

msgid "vo_sm_char13_m06_stg26_01"
msgstr "Smith: Engasjer målene!"

msgid "vo_sm_char13_m06_stg26_02"
msgstr "Smith: Kampstasjoner! Hold fokus!"

msgid "vo_sm_char13_m06_stg26_03"
msgstr "Smith: Kontakt!"

msgid "vo_sm_char13_m06_stg27_01"
msgstr "Smith: Klart! Kjør ut!"

msgid "vo_sm_char13_m06_stg28_01"
msgstr "Smith: Mål nede!"

msgid "vo_sm_char13_m06_stg28_02"
msgstr "Smith: Bekjempet!"

msgid "vo_sm_char13_m06_stg29_01"
msgstr "Smith: Tøff jævel. Neste gang må vi finne en annen løsning."

msgid "vo_sm_char13_m06_stg30_01"
msgstr "Smith: Vi bør rekognosere i forkant før vi kjører inn."

msgid "vo_sm_char13_m06_stg34_01"
msgstr "Smith: Tilbake i tanksen. La oss kjøre."

msgid "vo_sm_char13_m06_stg34_02"
msgstr "Smith: Nok speiding. Kom i gang."

msgid "vo_sm_char13_m06_stg34_03"
msgstr "Smith: Gjør dere klar, alle sammen. På tide å rulle ut."

msgid "vo_sm_char13_m06_stg34_04"
msgstr "Smith: La oss ikke kaste vekk tid. Kjør ut."

msgid "vo_sm_char13_m06_stg35_01"
msgstr "Smith: Keller kan trekke dem vekk med en falsk ordre."

msgid "vo_sm_char13_m06_stg42_01"
msgstr "Smith: Fokus på målet. Vi trenger de kartbitene for å redde mennene våre."

msgid "vo_sm_char13_m06_stg43_01"
msgstr "Smith: Kjør! Dette er ikke sovetid."

msgid "vo_sm_char13_m06_stg43_02"
msgstr "Smith: Hvert sekund teller. Kjør i vei."

msgid "vo_sm_char13_m06_stg44_01"
msgstr "Smith: Ikke noe valg. Vi må kjempe."

msgid "vo_sm_char13_m06_stg45_01"
msgstr "Smith: Finn en alternativ rute for oss."

msgid "vo_sm_char13_m06_stg46_01"
msgstr "Smith: Bruk radioen. Lokk dem vekk fra oss."

msgid "vo_sm_char13_m06_stg47_01"
msgstr "Smith: Vent til patruljen deres flytter seg vekk."

msgid "vo_sm_char13_m06_stg48_01"
msgstr "Smith: Tanksen er reparert, men vi mistet mye tid. Hold fokus."

msgid "vo_sm_char13_m06_stg50_01"
msgstr "Smith: De er i høy beredskap. Nå kommer de til å skyte med en gang de oppdager oss."

msgid "vo_sm_char13_m06_stg53_01"
msgstr "Smith: Hvor kom de fra?"

msgid "vo_sm_char13_m06_stg54_01"
msgstr "Smith: Vi har for små marginer. Press forover!"

msgid "vo_sm_char13_m06_stg55_06"
msgstr "Smith: Murphy, bare få oss dit i ett stykke."

msgid "vo_sm_char13_m06_stg57_01"
msgstr "Smith: Tiger! Helvete!"

msgid "vo_sm_char13_m06_stg57_03"
msgstr "Smith: Han jakter på oss."

msgid "vo_sm_char13_m06_stg57_03_01"
msgstr "Smith: Kan ikke penetrere frontpansringen hans, men han kommer til å skjære gjennom vår som papir."

msgid "vo_sm_char13_m06_stg57_03_02"
msgstr "Smith: Bare fortsett å bevege oss—farten er vår eneste fordel!"

msgid "vo_sm_char13_m06_stg58_01"
msgstr "Smith: Fiendens artilleri våkner. Vi er nødt til å manøvrere!"

msgid "vo_sm_char13_m06_stg58_03"
msgstr "Smith: Bare gjør det du kan."

msgid "vo_sm_char13_m06_stg59_01"
msgstr "Smith: Tiger tanksen er nærme. Hold oss langt unna, Murphy!"

msgid "vo_sm_char13_m06_stg59_02"
msgstr "Smith: Tiger tanksen er for nærme! Vi trenger å komme oss vekk!"

msgid "vo_sm_char13_m06_stg60_01"
msgstr "Smith: Få oss vekk nå! Han har oss i siktet sitt!"

msgid "vo_sm_char13_m06_stg60_02"
msgstr "Smith: Han har siktet seg inn! Unnvikende manøver nå!"

msgid "vo_sm_char13_m06_stg61_01"
msgstr "Smith: Tiger tanksen bommet! Ikke gi ham enda en sjanse!"

msgid "vo_sm_char13_m06_stg63_01"
msgstr "Smith: Spar på ammunisjonen. Det er ikke noe poeng å skyte på frontalpansringen på en Tiger tanks."

msgid "vo_sm_char13_m06_stg63_02"
msgstr "Smith: Glem Tiger tanksen—fokuser på mindre mål."

msgid "vo_sm_char13_m06_stg64_01"
msgstr "Smith: Beltet er ødelagt! Han er immobilisert!"

msgid "vo_sm_char13_m06_stg65_01"
msgstr "Smith: Artilleri! Hardt til høyre!"

msgid "vo_sm_char13_m06_stg65_02"
msgstr "Smith: Artilleriangrep! Bryt venstre!"

msgid "vo_sm_char13_m06_stg65_03"
msgstr "Smith: Innkommende! Stans helt!"

msgid "vo_sm_char13_m06_stg65_04"
msgstr "Smith: Artilleri! Unnvikende manøvre!"

msgid "vo_sm_char13_m06_stg65_05"
msgstr "Smith: Artillerisalve! Vend nå!"

msgid "vo_sm_char13_m06_stg66_01"
msgstr "Smith: Vi kan håndtere disse. Kowalski, fritt våpen."

msgid "vo_sm_char13_m06_stg66_02"
msgstr "Smith: Disse kan bekjempes. Kowalski, skyt fritt."

msgid "vo_sm_char13_m06_stg67_01"
msgstr "Smith: Ikke kast bort ammunisjon på Ferdinand tanksen!"

msgid "vo_sm_char13_m06_stg67_02"
msgstr "Smith: Ignorer Ferdinand—vi kan ikke skade den."

msgid "vo_sm_char13_m06_stg70_01"
msgstr "Smith: Minefeltet bak oss. Murphy, full gass. Våre gutter venter."

msgid "vo_sm_char13_m06_stg70_03"
msgstr "Smith: Keller, bytt til alliert frekvens, sett meg i forbindelse."

msgid "vo_sm_char13_m06_stg70_05"
msgstr "Smith: Alle enheter, hør etter, dette er kaptein Jack Smith, 2nd Armored Division."

msgid "vo_sm_char13_m06_stg70_05_01"
msgstr "Smith: Vi nærmer oss i en M24 Chaffee fra vest."

msgid "vo_sm_char13_m06_stg70_05_02"
msgstr "Smith: Ikke skyt. Jeg gjentar, ikke skyt."

msgid "vo_sm_char13_m06_stg70_05_03"
msgstr "Smith: Vi har ordrer som haster fra hovedkvarteret til III Corps. Passord: ''Torch''. Over."

msgid "vo_sm_char13_m06_stg70_06"
msgstr "Smith: Vi er hjemme gutter. Denne krigen er over her."

msgid "vo_sm_char13_m06_stg71_01"
msgstr "Smith: Helvete. Vi sviktet dem alle."

msgid "vo_sm_char13_m06_stg72_01"
msgstr "Smith: For mye støy. Vi lyser opp på hver eneste radar fra her til Berlin."

msgid "vo_sm_char13_m06_stg72_02"
msgstr "Smith: Dette er ingen skytebane. Vi må skjule oss bedre."

msgid "vo_sm_char13_m06_stg72_03"
msgstr "Smith: Vi må forflytte oss mer stille. Hvert skudd bringer mer uønsket oppmerksomhet."

msgid "vo_sm_char13_m06_stg72_04"
msgstr "Smith: Alt dette brøker gjør at de sender forsterkninger. Vi kommer ikke til å klare å komme oss til guttene våre i tide."

msgid "vo_sm_char13_m06_stg81_02"
msgstr "Smith: Fant du ut noe?"

msgid "vo_sm_char13_m06_stg81_04"
msgstr "Smith: En god en?"

msgid "vo_sm_char13_m06_stg82_02"
msgstr "Smith: Nei."

msgid "vo_sm_char13_m06_stg84_02"
msgstr "Smith: En gate? Hvordan? Ved å skrive ned alle navnene våre?"

msgid "vo_sm_char13_m06_stg84_04"
msgstr "Smith: Fokus på veien."

msgid "vo_sm_char14_m06_outro_08"
msgstr "Keller: Nie wieder."

msgid "vo_sm_char14_m06_stg02_03"
msgstr "Radiooperatør, Gefr. Keller: Det er en... kommandopost rett på utsiden av byen. De har kart over minefeltene sine der."

msgid "vo_sm_char14_m06_stg04_04"
msgstr "Keller: Ser ut som en patrulje. De burde kjøre videre ganske snart."

msgid "vo_sm_char14_m06_stg04_08"
msgstr "Keller: Kommandoposten med kartene, det er der oppe, på åsen."

msgid "vo_sm_char14_m06_stg05_03"
msgstr "Keller: Det var en kommandotanks."

msgid "vo_sm_char14_m06_stg05_03_01"
msgstr "Keller: Dersom radioen dens fremdeles er intakt og innstilt på de riktige frekvensene kunne jeg..."

msgid "vo_sm_char14_m06_stg05_05"
msgstr "Keller: Nein, gi patrulje falske ordre. Distraher dem. Så vi kan komme oss forbi."

msgid "vo_sm_char14_m06_stg06_09a"
msgstr "Keller: Ja, kaptein Smith."

msgid "vo_sm_char14_m06_stg06_09b"
msgstr "Keller: Achtung, Panzer Vier! Feindliche Aktivität im Punkt Berta.\n(Panzer fire, hør etter! Fiendtlig aktivitet i sektor Punkt Berta.)"

msgid "vo_sm_char14_m06_stg06_09b_01"
msgstr "Keller: Sofort aufklären!\n(Undersøk umiddelbart!)"

msgid "vo_sm_char14_m06_stg07_01"
msgstr "Keller: Dette er kommandoposten."

msgid "vo_sm_char14_m06_stg08_06"
msgstr "Keller: Disse merkene viser også kommandoposter. De har biter av kartene vi trenger for å komme oss frem."

msgid "vo_sm_char14_m06_stg08_06_01"
msgstr "Keller: Til våre... Tyske speidere. Vi burde se der."

msgid "vo_sm_char14_m06_stg09_06"
msgstr "Keller: Her."

msgid "vo_sm_char14_m06_stg13_03"
msgstr "Keller: Ikke alle offiserer er ansvarlige for minefeltene."

msgid "vo_sm_char14_m06_stg17_01"
msgstr "Keller: Ser ut som at vi har funnet enda en kommandopost. Vi burde sjekke den."

msgid "vo_sm_char14_m06_stg18_02"
msgstr "Keller: Ja, det kan være en kartbit der også."

msgid "vo_sm_char14_m06_stg19_03"
msgstr "Keller: Nei."

msgid "vo_sm_char14_m06_stg21_06"
msgstr "Keller: De... de la ikke merke til oss."

msgid "vo_sm_char14_m06_stg25_05"
msgstr "Keller: De har gitt opp søket... for nå."

msgid "vo_sm_char14_m06_stg35_03"
msgstr "Keller: Det kan hende jeg kan lokke dem vekk fra oss."

msgid "vo_sm_char14_m06_stg36_01"
msgstr "Keller: Går på luften."

msgid "vo_sm_char14_m06_stg36_02"
msgstr "Keller: Achtung! Neue Stellung in Sektor Berta beziehen. Sofort ausführen!\n(Hør etter! Ta ny posisjon i Sektor Berta. Utfør umiddelbart!)"

msgid "vo_sm_char14_m06_stg36_04"
msgstr "Keller: Setter deg over."

msgid "vo_sm_char14_m06_stg36_05"
msgstr "Keller: Dringender Befehl! Umgruppierung nach Punkt Dora erforderlich!\n(Hasteordre! Det er påkrevet å regruppere til punkt Dora!)"

msgid "vo_sm_char14_m06_stg36_07"
msgstr "Keller: Bytter til frekvensen deres."

msgid "vo_sm_char14_m06_stg36_08"
msgstr "Keller: Feindliche Aktivität im Sektor Emil! Sofort untersuchen!\n(Fiendtlig aktivitet i Sektor Emil! Undersøk umiddelbart!)"

msgid "vo_sm_char14_m06_stg36_10"
msgstr "Keller: Sender signaler nå."

msgid "vo_sm_char14_m06_stg36_11"
msgstr "Keller: Zurückziehen auf Stellung Gustav! Schnell! Schnell!\n(Trekk tilbake til posisjon Gustav! Raskt! Raskt!)"

msgid "vo_sm_char14_m06_stg36_13"
msgstr "Keller: Sender."

msgid "vo_sm_char14_m06_stg36_14"
msgstr "Keller: Gruppe Nord meldet Feindkontakt! Verstärkung benötigt!\n(Kampgruppe Nord rapporterer kontakt med fiendtlige! Trenger forsterkninger!)"

msgid "vo_sm_char14_m06_stg37_01"
msgstr "Keller: Det er ingen innen rekkevidde på denne frekvensen."

msgid "vo_sm_char14_m06_stg37_02"
msgstr "Keller: Ingen enheter som svarer i dette området."

msgid "vo_sm_char14_m06_stg37_03"
msgstr "Keller: Det er ingen tyske styrker i nærheten til å motta ordrer."

msgid "vo_sm_char14_m06_stg37_04"
msgstr "Keller: Ingen respons. Det er ikke en eneste tysk tanks i nærheten. Tror jeg."

msgid "vo_sm_char14_m06_stg38_01"
msgstr "Keller: Negativ."

msgid "vo_sm_char14_m06_stg38_02"
msgstr "Keller: Jeg kan ikke."

msgid "vo_sm_char14_m06_stg38_03"
msgstr "Keller: Vil ikke fungere."

msgid "vo_sm_char14_m06_stg39_01"
msgstr "Keller: Det er troppskommandørens tanks, han kommer ikke til å ta ordrer fra oss."

msgid "vo_sm_char14_m06_stg39_02"
msgstr "Keller: Troppskommandør... Han vil ikke ta ordrer fra oss."

msgid "vo_sm_char14_m06_stg39_03"
msgstr "Keller: Troppskommandørens tanks. De tar kun ordrer fra bataljonens hovedkvarter."

msgid "vo_sm_char14_m06_stg40_01"
msgstr "Keller: De har gravd seg ned her. Det er ingen vits i å beordre dem til noe som helst."

msgid "vo_sm_char14_m06_stg40_02"
msgstr "Keller: Denne tanksen er skadet. De bruker den som en ildpost."

msgid "vo_sm_char14_m06_stg40_03"
msgstr "Keller: Det er en skadd tanks. De kan ikke flytte på seg."

msgid "vo_sm_char14_m06_stg40_04"
msgstr "Keller: Beltene deres er ødelagt. De vil holde seg på plass uansett."

msgid "vo_sm_char14_m06_stg41_01"
msgstr "Keller: Achtung! De kommer tilbake til posisjonene sine."

msgid "vo_sm_char14_m06_stg41_02"
msgstr "Keller: De kommer tilbake. Pass på."

msgid "vo_sm_char14_m06_stg41_03"
msgstr "Keller: Følg med! Du snur seg rundt."

msgid "vo_sm_char14_m06_stg42_04"
msgstr "Keller: Kanskje vi burde... ehh... komme oss til kommandoposten?"

msgid "vo_sm_char14_m06_stg42_04_01"
msgstr "Keller: Før de bytter patruljer?"

msgid "vo_sm_char14_m06_stg46_03"
msgstr "Keller: La meg prøve å distrahere dem."

msgid "vo_sm_char14_m06_stg47_03"
msgstr "Keller: Det er en patrulje. De drar videre snart."

msgid "vo_sm_char14_m06_stg48_04"
msgstr "Keller: Det var flaks. Skjebnen ønsker at vi skal fullføre oppdraget."

msgid "vo_sm_char14_m06_stg49_01"
msgstr "Keller: Kaptein, de rapporterer en amerikansk tanks på radioen."

msgid "vo_sm_char14_m06_stg49_01_01"
msgstr "Keller: Nå kommer de til å lete etter oss."

msgid "vo_sm_char14_m06_stg49_02"
msgstr "Keller: Jeg hører ordrer om... å sende forsterkninger."

msgid "vo_sm_char14_m06_stg49_02_01"
msgstr "Keller: Spesialenhet jakter på oss nå..."

msgid "vo_sm_char14_m06_stg51_01"
msgstr "Keller: Det er en patrulje. Hvis vi timer det riktig kan vi snike oss forbi."

msgid "vo_sm_char14_m06_stg51_02"
msgstr "Keller: Patruljene følger rutene sine strengt. Vi kan snike oss forbi når de drar."

msgid "vo_sm_char14_m06_stg51_03"
msgstr "Keller: En patrulje. De kommer til å forlate den posisjonen straks."

msgid "vo_sm_char14_m06_stg52_01"
msgstr "Keller: Disse tanksene kan ikke flytte seg mer, men de bruker dem som faste posisjoner..."

msgid "vo_sm_char14_m06_stg52_02"
msgstr "Keller: Garnisonen er i ferd med å gå tomme for reservedeler, men de bruker fremdeles disse tanksene som bunkerser."

msgid "vo_sm_char14_m06_stg52_03"
msgstr "Keller: Mangelen på drivstoff betyr at disse er bare... maskingeværreder nå."

msgid "vo_sm_char14_m06_stg52_03_01"
msgstr "Keller: Men kanonene på dem er fremdeles farlige..."

msgid "vo_sm_char14_m06_stg53_04"
msgstr "Keller: Kaptein... Panzer! Akkurat der!"

msgid "vo_sm_char14_m06_stg56_03"
msgstr "Keller: Kanskje... kanskje vi burde gå saktere frem?"

msgid "vo_sm_char14_m06_stg70_04"
msgstr "Keller: Ja, sir."

msgid "vo_sm_char14_m06_stg74_03"
msgstr "Keller: Men det skjeve tårnet i Pisa er i... Pisa..."

msgid "vo_sm_char14_m06_stg80_02"
msgstr "Keller: Denne radioen er til kommunikasjon. Vi bruker den til å distrahere patruljene."

msgid "vo_sm_char14_m06_stg80_02_01"
msgstr "Keller: Jeg vil ikke..."

msgid "vo_sm_char14_m06_stg80_04"
msgstr "Keller: Jeg kan prøve. Men det måtte vært med tysk musikk."

msgid "vo_sm_char14_m06_stg86_02"
msgstr "Keller: Faktisk så er det mer enn 1000."

msgid "vo_sm_char14_m06_stg86_04"
msgstr "Keller: Jeg har. Hard på utsiden, myk inni."

msgid "vo_sm_char14_m06_stg88_02"
msgstr "Keller: Vel... faktisk... to besetninger diskuterte spøkelsesjakt i landsbyen om natten."

msgid "vo_sm_char14_m06_stg88_05"
msgstr "Keller: Nei... Jeg trodde aldtri jeg kom til å ende opp inne i en tanks..."

msgid "vo_sm_char14_m06_stg89_02"
msgstr "Keller: Faktisk så er jeg vettskremt. Jeg er bare for redd til å vise det."

msgid "vo_sm_char15_m06_outro_10"
msgstr "Kowalski: Nigdy więcej."

msgid "vo_sm_char15_m06_stg02_05"
msgstr "Skytter, sersjant Kowalski: Hvorfor tok vi med oss denne Kraut-fyren? Han kommer til å føre oss rett inn i en felle."

msgid "vo_sm_char15_m06_stg04_05"
msgstr "Kowalski: Åh selvsagt, stol på tyskerens ord som førte oss inn i denne fellen av en landsby."

msgid "vo_sm_char15_m06_stg05_04"
msgstr "Kowalski: Anrope alle tyskerne her?"

msgid "vo_sm_char15_m06_stg06_02"
msgstr "Kowalski: Chaffee tanksen er ikke akkurat bygd for den kampen. Men... hvis Murphy..."

msgid "vo_sm_char15_m06_stg06_07"
msgstr "Kowalski: Vel, kom igjen da, si noe til dem."

msgid "vo_sm_char15_m06_stg06_08"
msgstr "Kowalski: Glemte du tysken din, Keller?"

msgid "vo_sm_char15_m06_stg06_08_01"
msgstr "Kowalski: Si til den Tiger tanksen at han skal komme seg til helvete vekk herfra!"

msgid "vo_sm_char15_m06_stg13_02"
msgstr "Kowalski: Hva? Jeg trodde alle postene hadde en kartbit. Keller?"

msgid "vo_sm_char15_m06_stg14_03"
msgstr "Kowalski: Vel, i det minste la vi til et par flere Panzer tanks som vi fikk poeng for."

msgid "vo_sm_char15_m06_stg14_04"
msgstr "Kowalski: Vel, i det minste la vi til et par flere Panzer tanks som vi fikk poeng for."

msgid "vo_sm_char15_m06_stg14_04_01"
msgstr "Kowalski: Og fant oss noen fancy nye kommandoposter også."

msgid "vo_sm_char15_m06_stg17_02"
msgstr "Kowalski: Hva om det er en..."

msgid "vo_sm_char15_m06_stg21_07"
msgstr "Kowalski: Blinde idioter."

msgid "vo_sm_char15_m06_stg21_08"
msgstr "Kowalski: Ha! Hvordan klarte det å ikke se oss?"

msgid "vo_sm_char15_m06_stg24_05"
msgstr "Kowalski: La oss stikke før det dukker opp flere Kraut-folk."

msgid "vo_sm_char15_m06_stg25_04"
msgstr "Kowalski: Blinde idioter. De får ingen flere sjanser."

msgid "vo_sm_char15_m06_stg26_08"
msgstr "Kowalski: Endelig! Tid for litt action!"

msgid "vo_sm_char15_m06_stg27_05"
msgstr "Kowalski: Klart. Hvem er neste?"

msgid "vo_sm_char15_m06_stg28_05"
msgstr "Kowalski: Fant deg!"

msgid "vo_sm_char15_m06_stg29_03"
msgstr "Kowalski: Ikke så mektig nå, er du? Men vi har mistet mye tid."

msgid "vo_sm_char15_m06_stg30_03"
msgstr "Kowalski: La oss ikke fare frem i blinde. Hva tenker du?"

msgid "vo_sm_char15_m06_stg30_03_01"
msgstr "Kowalski: Kanskje Dubois kan speide litt rundt?"

msgid "vo_sm_char15_m06_stg31_10"
msgstr "Kowalski: Nei."

msgid "vo_sm_char15_m06_stg42_05"
msgstr "Kowalski: Slutt å kaste bort mer tid! Dette kartet er vår billett gjennom minefeltet."

msgid "vo_sm_char15_m06_stg43_05"
msgstr "Kowalski: Flytt, eller så begynner jeg å dytte på denne tanksen sjøl!"

msgid "vo_sm_char15_m06_stg44_03"
msgstr "Kowalski: De ber om det. La oss vise dem gdzie raki zimują!"

msgid "vo_sm_char15_m06_stg45_03"
msgstr "Kowalski: Ok, la oss denne gang ikke gå rett inn i skuddlinjen deres."

msgid "vo_sm_char15_m06_stg48_05"
msgstr "Kowalski: Okei, oppvarming overstått. Nå gjør vi det på ekte."

msgid "vo_sm_char15_m06_stg53_05"
msgstr "Kowalski: Se hva vi har her!"

msgid "vo_sm_char15_m06_stg54_03"
msgstr "Kowalski: Kanonene våre vil begynne å skyte når som helst nå. Skynd dere!"

msgid "vo_sm_char15_m06_stg55_02"
msgstr "Kowalski: Innkommende! De har sett oss!"

msgid "vo_sm_char15_m06_stg60_04"
msgstr "Kowalski: Tiger tanksen sikter! Hvis vi ikke rister ham av oss nå, tar han oss ut!"

msgid "vo_sm_char15_m06_stg60_05"
msgstr "Kowalski: Tiger tanksen er i ferd med å skyte... Jeg kjenner igjen den måten å sikte på!"

msgid "vo_sm_char15_m06_stg61_03"
msgstr "Kowalski: Kurde! Dersom det var meg vill jeg ikke ha bommet."

msgid "vo_sm_char15_m06_stg62_03"
msgstr "Kowalski: Er det alt du har, Tiger?"

msgid "vo_sm_char15_m06_stg64_03"
msgstr "Kowalski: Świetnie! Akkurat der jeg ville ha den!"

msgid "vo_sm_char15_m06_stg66_03"
msgstr "Kowalski: Se hva vi har her! Enkle mål!"

msgid "vo_sm_char15_m06_stg67_03"
msgstr "Kowalski: Ubrukelig. Kunne like gjerne kastet steiner på den!"

msgid "vo_sm_char15_m06_stg68_04"
msgstr "Kowalski: Murphy, glemte du? Det er miner overalt her!"

msgid "vo_sm_char15_m06_stg69_02"
msgstr "Kowalski: Dostał!"

msgid "vo_sm_char15_m06_stg71_03"
msgstr "Kowalski: Slakten begynner. Vi var for treige..."

msgid "vo_sm_char15_m06_stg77_02"
msgstr "Kowalski: Bare i bryllup."

msgid "vo_sm_char15_m06_stg77_04"
msgstr "Kowalski: Er det et frieri, Murphy?"

msgid "vo_sm_char15_m06_stg78_01"
msgstr "Kowalski: Murphy, la oss snakke om kjørestilen din."

msgid "vo_sm_char15_m06_stg78_03"
msgstr "Kowalski: Går du bevisst etter hver eneste dump og kjører i skråninger for å få tanksen til å bli skjev?"

msgid "vo_sm_char15_m06_stg78_05"
msgstr "Kowalski: Dine allierte også."

msgid "vo_sm_char15_m06_stg79_02"
msgstr "Kowalski: Noen ganger blir jeg bekymret for deg, Murphy."

msgid "vo_sm_char15_m06_stg79_04"
msgstr "Kowalski: Virkelig. Jeg bekymrer meg for deg på ekte."

msgid "vo_sm_char15_m06_stg85_02"
msgstr "Kowalski: Ikke nå mer."

msgid "vo_sm_char15_m06_stg85_04"
msgstr "Kowalski: Jeg tviler på det."

msgid "vo_sm_char15_m06_stg89_01"
msgstr "Kowalski: Til en skolelærer i en tanks å være, er du merkelig rolig, Keller."

msgid "vo_sm_char15_m06_stg89_03"
msgstr "Kowalski: Hæh. Det er... overraskende ærlig."

msgid "vo_sm_char15_m06_stg90_01"
msgstr "Kowalski: Dubois, hva er det du nynner på over der?"

msgid "vo_sm_char16_m06_stg06_10"
msgstr "Jawohl, verstanden! Bewegen uns zum Punkt Berta!\n(Ja, forstått! Flytter oss til punkt Berta!)"

msgid "vo_sm_char16_m06_stg36_03"
msgstr "Verstanden, bewegen uns nach Berta.\n(Forstått, flytter oss til Berta.)"

msgid "vo_sm_char16_m06_stg36_06"
msgstr "Jawohl, beginnen Umgruppierung.\n(Ja, begynner på omgrupperingen.)"

msgid "vo_sm_char16_m06_stg36_09"
msgstr "Zu Befehl, starten Aufklärung.\n(Ja, begynner på rekognoseringen.)"

msgid "vo_sm_char16_m06_stg36_12"
msgstr "Verstanden, ziehen uns zurück.\n(Forstått, trekker oss tilbake.)"

msgid "vo_sm_char16_m06_stg36_15"
msgstr "Bestätigt, sind unterwegs.\n(Bekreftet, vi er underveis.)"

msgid "vo_sm_char17_m07_stg02_03"
msgstr "Leni \"Nebel\" Sharf: Kommandør, vi har begrenset luftstøtte stående klar."

msgid "vo_sm_char17_m07_stg02_03_01"
msgstr "Leni: Du kan be om et angrep når du trenger det."

msgid "vo_sm_char17_m07_stg02_05"
msgstr "Leni: Du vet om radioteknologien, ikke sant? Hele øya vet allerede at du er der."

msgid "vo_sm_char17_m07_stg04_06"
msgstr "Leni: Hvis mulig, forsøk å erobre kjøretøyet intakt. Hovedkvarteret ønsker å undersøke det."

msgid "vo_sm_char17_m07_stg05_03"
msgstr "Leni: Likner det på noe tysk?"

msgid "vo_sm_char17_m07_stg06_03"
msgstr "Leni: Gitt antall fiendtlige kjøretøy må de ha etablert vedlikeholdsfasiliteter"

msgid "vo_sm_char17_m07_stg06_03_01"
msgstr "Leni: et eller annet sted på denne øya."

msgid "vo_sm_char17_m07_stg07_05"
msgstr "Leni: Få opp farta. Raketten venter ikke."

msgid "vo_sm_char17_m07_stg07_06"
msgstr "Leni: Jeg sa jeg burde ha blitt sendt ut sammen med deg. Du rykker ikke raskt nok frem."

msgid "vo_sm_char17_m07_stg08_03"
msgstr "Leni: Prøv å sette det ut av spill uten å forårsake betydelig skade. Vi trenger den nogenlunde intakt."

msgid "vo_sm_char17_m07_stg08_05"
msgstr "Leni: Bare prøv. Ok?"

msgid "vo_sm_char17_m07_stg09_02"
msgstr "Leni: Pass veldig godt på. Det er en felle."

msgid "vo_sm_char17_m07_stg09_04"
msgstr "Leni: Vi har funnet radiofrekvensen deres."

msgid "vo_sm_char17_m07_stg09_04_01"
msgstr "Leni: Overvåket radiotrafikken deres de siste syv minuttene."

msgid "vo_sm_char17_m07_stg09_06"
msgstr "Leni: Du har ikke stoppet å snakke lenge nok til at jeg kan informere deg."

msgid "vo_sm_char17_m07_stg09_06_01"
msgstr "Leni: Kanskje prøv litt radiotaushet i blant, Teddy."

msgid "vo_sm_char17_m07_stg10_03"
msgstr "Leni: Ny målsetning nådd: Det kjøretøyet må erobres intakt."

msgid "vo_sm_char17_m07_stg11_02"
msgstr "Leni: Hva har det? Noen ikke-standard moduler? Noe spesialutstyr?"

msgid "vo_sm_char17_m07_stg13_01"
msgstr "Leni: Kommandør, er du sikker på at du ikke vil prøve denne nye tanksen?"

msgid "vo_sm_char17_m07_stg13_01_01"
msgstr "Leni: Siden det venter et bakholdsangrep forut vil den ekstra ildkraften være fordelaktig."

msgid "vo_sm_char17_m07_stg15_07"
msgstr "Leni: Teddy, er du klar over at vi ikke hører deg?"

msgid "vo_sm_char17_m07_stg15_07_01"
msgstr "Leni: Jeg får bare inn hans sending, får ikke sendt ut vår."

msgid "vo_sm_char17_m07_stg17_01"
msgstr "Leni: Statusrapport. Er det bare tysk pansring vi står overfor?"

msgid "vo_sm_char17_m07_stg17_03"
msgstr "Leni: Som jeg tenkte. Dette er mer komplisert enn vi trodde."

msgid "vo_sm_char17_m07_stg18_03"
msgstr "Leni: I følge oppfangede radiomeldinger..."

msgid "vo_sm_char17_m07_stg19_03"
msgstr "Leni: Husk: Det kjøreøtyet må erobres uskadd for videre analyse. Og greitt, ja..."

msgid "vo_sm_char17_m07_stg19_03_01"
msgstr "Leni: Jeg vil undersøke det selv også."

msgid "vo_sm_char17_m07_stg20_02"
msgstr "Leni: Korrigering: Vi har ingen bevis for at de er tyske."

msgid "vo_sm_char17_m07_stg20_02_01"
msgstr "Leni: Tilgjengelig informasjon tilsier at det er en internasjonal gruppe med leiesoldater."

msgid "vo_sm_char17_m07_stg21_03"
msgstr "Leni: Den stemmen... Noe kjent med kommandøren deres. Jeg har hørt den før, et eller annet sted..."

msgid "vo_sm_char17_m07_stg21_05"
msgstr "Leni: Det vil være svært snilt av deg."

msgid "vo_sm_char17_m07_stg21_07"
msgstr "Leni: Ja, takk."

msgid "vo_sm_char17_m07_stg23_02"
msgstr "Leni: Hva skjedde?"

msgid "vo_sm_char17_m07_stg23_05"
msgstr "Leni: Dette er akkurat hvorfor jeg stadig insisterer på å erobre de kjøretøyene intakt."

msgid "vo_sm_char17_m07_stg23_05_01"
msgstr "Leni: Gi meg de eksperimentelle kjøretøyene så bygger jeg noe... imponerende."

msgid "vo_sm_char17_m07_stg24_03"
msgstr "Leni: Kommandør, jeg anbefaler at du tester ut denne nye tanksen. Den har unike kampevner."

msgid "vo_sm_char17_m07_stg26_01"
msgstr "Leni: Vel, kanskje det å la den være igjen er det lureste."

msgid "vo_sm_char17_m07_stg26_01_01"
msgstr "Leni: Den vil helt bestemt forbli intakt, og våre ingeniører kan hente den etter oppdraget."

msgid "vo_sm_char17_m07_stg28_04"
msgstr "Leni: Noen eksperimentelle maskiner blant dem? Noe uvanlig?"

msgid "vo_sm_char17_m07_stg29_03"
msgstr "Leni: Denne Adler gruppen... Vi må finne ut mer om dem."

msgid "vo_sm_char17_m07_stg29_03_01"
msgstr "Leni: Kan hende det vil hjelpe oss med å identifisere denne mystiske kommandøren."

msgid "vo_sm_char17_m07_stg31_07"
msgstr "Leni: Vi sporer rakettene på radarsystemet vårt. Tidsvinduet er lite."

msgid "vo_sm_char17_m07_stg31_07_01"
msgstr "Leni: Ny målsetning: Sikre flykontrollsenteret. Det er mulig vi kan endre missilets bane."

msgid "vo_sm_char17_m07_stg31_07_02"
msgstr "Leni: Utfør med det samme."

msgid "vo_sm_char17_m07_stg33_01"
msgstr "Leni: Hvilke overraskelser har denne tanksen til oss?"

msgid "vo_sm_char17_m07_stg34_01"
msgstr "Leni: Denne nye tunge tanksen har forbedret pansring. Optimal til å konfrontere flere samtidige mål."

msgid "vo_sm_char17_m07_stg34_01_01"
msgstr "Leni: Kommandør, jeg anbefaler at vi får tak i den."

msgid "vo_sm_char17_m07_stg35_02"
msgstr "Leni: Det tekniske laget vårt er på vei til flykontrollrommet. Hold posisjonene deres. Vi trenger tid."

msgid "vo_sm_char17_m07_stg37_03"
msgstr "Leni: Vi må stå i mot litt lengre."

msgid "vo_sm_char17_m07_stg38_02"
msgstr "Leni: Fint, fint... ikke nå!"

msgid "vo_sm_char17_m07_stg40_02"
msgstr "Leni: Vi klarer ikke å overstyre kontrollen. Uansett hva vi prøver, kan vi ikke endre missilets bane. Men..."

msgid "vo_sm_char17_m07_stg40_02_01"
msgstr "Leni: det er noe rart her."

msgid "vo_sm_char17_m07_stg41_04"
msgstr "Leni: Mulighetsvinduet ditt lukker seg raskt. Ikke kast bort tid."

msgid "vo_sm_char17_m07_stg41_05"
msgstr "Leni: Oppdragsklokka tikker. Sett i gang nå."

msgid "vo_sm_char17_m07_stg41_06"
msgstr "Leni: Jo lenger du blir stående stasjonært, jo mer tid har de til å mobilisere forsvaret sitt."

msgid "vo_sm_char17_m07_stg41_06_01"
msgstr "Leni: Fortsett til målet."

msgid "vo_sm_char17_m07_stg43_05"
msgstr "Leni: Vi mistet den førende tanksen. Hold formasjon!"

msgid "vo_sm_char17_m07_stg43_06"
msgstr "Leni: Kommandørens tanks er eliminert. Vi gjør klar en ny tanks til ham."

msgid "vo_sm_char17_m07_stg44_07"
msgstr "Leni: Vi har ikke ubegrenset med forsterkninger. Vær mer forsiktig."

msgid "vo_sm_char17_m07_stg44_08"
msgstr "Leni: Neste gang må det reageres raskere, ellers blir det ingen neste gang."

msgid "vo_sm_char17_m07_stg44_09"
msgstr "Leni: Deres reparasjonsbaser inneholder et begrenset antall av disse tanksene."

msgid "vo_sm_char17_m07_stg44_09_01"
msgstr "Leni: Vennligst utfør oppgavene med større forsiktighet neste gang."

msgid "vo_sm_char17_m07_stg49_03"
msgstr "Leni: Målsetning feilet. Vi hadde ikke mer tid igjen."

msgid "vo_sm_char17_m07_stg50_03"
msgstr "Leni: Alle tanks tapt. Forfeilet oppdrag bekreftet."

msgid "vo_sm_char17_m07_stg59_05"
msgstr "Leni: Luftstøtte tilkalt. Gjør klar til innslag."

msgid "vo_sm_char17_m07_stg59_06"
msgstr "Leni: Fly har angrepet målet. Innslag om noen sekunder."

msgid "vo_sm_char17_m07_stg60_03"
msgstr "Leni: Målangivelse ikke gyldig for luftstøtte."

msgid "vo_sm_char17_m07_stg63_09"
msgstr "Leni: Artilleriangrep oppdaget. Relokaliser umiddelbart!"

msgid "vo_sm_char17_m07_stg63_10"
msgstr "Leni: Fiendtlig artilleri avfyrt. Nedslag om sekunder. Flytt! Med det samme!"

msgid "vo_sm_char17_m07_stg63_11"
msgstr "Leni: Fiendtlig observatør dirigerer ild mot vår stilling. Kom deg ut av sprengsonen nå!"

msgid "vo_sm_char17_m07_stg68_02"
msgstr "Leni: Negativ."

msgid "vo_sm_char17_m07_stg68_04"
msgstr "Leni: Værforhold. Overskyet. Temperatur 8 grader. Vindhastighet 6 meter per sekund, nord-nordøst."

msgid "vo_sm_char17_m07_stg69_02"
msgstr "Leni: Jeg har teorier. Men jeg trenger mer bevis for jeg deler dem."

msgid "vo_sm_char17_m07_stg70_02"
msgstr "Leni: Den forrige personen som kalte meg \"kjære\" mistet to fingre."

msgid "vo_sm_char17_m07_stg70_02_01"
msgstr "Leni: Men er rolig ettermiddag på rett sted... Kan jeg vurdere."

msgid "vo_sm_char17_m07_stg71_01"
msgstr "Leni: Teddy, du tar unødvendige risikoer."

msgid "vo_sm_char17_m07_stg71_03"
msgstr "Leni: Og liv med for mye risiko ender plutselig. Som din forgjenger."

msgid "vo_sm_char17_m07_stg72_02"
msgstr "Leni: Smart mann."

msgid "vo_sm_char17_m07_stg72_04"
msgstr "Leni: Jeg tar det som et kompliment."

msgid "vo_sm_char17_m07_stg74_02"
msgstr "Leni: Det er ikke magi."

msgid "vo_sm_char17_m07_stg74_02_01"
msgstr "Leni: Det er en fokusert elektromagnetisk puls som midlertidig forstyrrer de elektriske systemene deres."

msgid "vo_sm_char17_m07_stg75_02"
msgstr "Leni: Bare få deg selv tilbake i live. Å erstatte trente operatører er administrativt slitsomt."

msgid "vo_sm_char17_m07_stg76_02"
msgstr "Leni: Hvis du fullfører den setninge med noen som helst sammenlikning på meg,"

msgid "vo_sm_char17_m07_stg76_02_01"
msgstr "Leni: Vil jeg personlig sikre at ditt neste oppdrag er til Arktis."

msgid "vo_sm_char17_m07_stg80_04"
msgstr "Leni: Han forsvant. Jeg har all dokumentasjonen her."

msgid "vo_sm_char17_m07_stg81_01"
msgstr "Leni: Alt dette føles... kalkulert."

msgid "vo_sm_char17_m07_stg81_01_01"
msgstr "Leni: Hver barriere, hvert forsvar-de kjøper seg tid, prøver ikke å stanse oss fullstendig."

msgid "vo_sm_char17_m07_stg81_03"
msgstr "Leni: Jeg tror vi er en del i noen andres likning. Og jeg liker ikke å være en variabel."

msgid "vo_sm_char17_m07_stg82_02"
msgstr "Leni: Jeg beregner sjansen for overlevelse basert på nåværende oppdragsvariabler."

msgid "vo_sm_char17_m07_stg82_04"
msgstr "Leni: Jeg har bestemt meg for ikke å dele resultatene. Moral er også en variabel."

msgid "vo_sm_char17_m07_stg83_02"
msgstr "Leni: Jeg har sporet dem."

msgid "vo_sm_char17_m07_stg83_02_01"
msgstr "Leni: Det er en 23% nedgang i kvalitet siden oppdraget startet, men en 47% økning i frekvens."

msgid "vo_sm_char17_m07_stg83_04"
msgstr "Leni: Kjenn dine allierte."

msgid "vo_sm_char17_m07_stg83_06"
msgstr "Leni: Aldri."

msgid "vo_sm_char17_m07_stg86_05"
msgstr "Leni: Denne eksperimentelle enheten er en reell trussel. Juster taktikk umiddelbart."

msgid "vo_sm_char17_m07_stg86_06"
msgstr "Leni: Kommandørens tanks er bekjempet. Den maskinen er mer effektiv enn forventet."

msgid "vo_sm_char18_m07_stg01_02"
msgstr "Miroslav \"Teddy\" Kotva: Se på dette rotet! Som ulver gjennom en sauebinge."

msgid "vo_sm_char18_m07_stg01_02_01"
msgstr "Teddy: Men som vi sier i landsbyen min: \"Den andre bølgen bryter demningen.\""

msgid "vo_sm_char18_m07_stg02_02"
msgstr "Teddy: Tyskere... Hvem skulle trodd det?"

msgid "vo_sm_char18_m07_stg02_04"
msgstr "Teddy: En stikker! Vi må stoppe ham før han henter venner!"

msgid "vo_sm_char18_m07_stg02_06"
msgstr "Teddy: Ja, men han er alene nå. Mye lettere å bekjempe ham enn når han kommer tilbake med gutta sine."

msgid "vo_sm_char18_m07_stg03_02"
msgstr "Teddy: Det mer min stil! Skyt først, finn ut hva den langløpede tingen er senere!"

msgid "vo_sm_char18_m07_stg04_01"
msgstr "Teddy: Ha! Så du det skuddet?"

msgid "vo_sm_char18_m07_stg04_03"
msgstr "Teddy: Det skal lære ham å vise frem den fancy kanonen sin her!"

msgid "vo_sm_char18_m07_stg04_07"
msgstr "Teddy: Erobre? Med all respekt, fräulein,"

msgid "vo_sm_char18_m07_stg04_07_01"
msgstr "Teddy: Jeg foretrekker å skyte først og fylle ut spørreskjemaer etterpå."

msgid "vo_sm_char18_m07_stg04_07_02"
msgstr "Teddy: Den tingen gjorde oss nesten til skrapmetall! Men greit, jeg skal prøve å ikke treffe noe viktig..."

msgid "vo_sm_char18_m07_stg04_07_03"
msgstr "Teddy: bare ammunisjonsstativet hans."

msgid "vo_sm_char18_m07_stg05_02"
msgstr "Teddy: Se der-en annen tanks jeg aldri har sett før!"

msgid "vo_sm_char18_m07_stg05_02_01"
msgstr "Teddy: På dette tidspunktet vet jeg ikke engang hvem vi kjemper mot lenger."

msgid "vo_sm_char18_m07_stg05_04"
msgstr "Teddy: Det ligner på noe helt motsatt."

msgid "vo_sm_char18_m07_stg06_02"
msgstr "Teddy: Jeg håper vi finner ammunisjonsdepotet deres snart. Jeg er ikke sikker på om jeg har nok granater til alle sammen."

msgid "vo_sm_char18_m07_stg07_03"
msgstr "Teddy: Enda en nede! Jeg liker de her!"

msgid "vo_sm_char18_m07_stg07_04"
msgstr "Teddy: Lag en linje, lag en linje! Kom en om gangen. Jeg har en liten gave til hver av dere."

msgid "vo_sm_char18_m07_stg08_02"
msgstr "Teddy: Han går meg på nervene! Vent, reparerer han seg selv der ute eller hva?"

msgid "vo_sm_char18_m07_stg08_02_01"
msgstr "Teddy: Bare vent-jeg kommer frem til deg snart nok og skal demontere deg bolt for bolt!"

msgid "vo_sm_char18_m07_stg08_04"
msgstr "Teddy: Er du helt sikker på at du kjemper på vår side, Leni? Denne greia prøver å drepe oss!"

msgid "vo_sm_char18_m07_stg08_05"
msgstr "Teddy: Vent et minutt. Jeg ser... Deg! Ikke HOVEDKVARTERET. Det er du som ønsker å erobre denne tanksen."

msgid "vo_sm_char18_m07_stg08_05_01"
msgstr "Teddy: Du er sprø om... lange kanonløp som kan treffe på langt hold!"

msgid "vo_sm_char18_m07_stg09_03"
msgstr "Teddy: Åh, virkelig? Og hvordan vet du egentlig det, fräulein synsk?"

msgid "vo_sm_char18_m07_stg09_03_01"
msgstr "Teddy: Sendte de deg en invitasjon til bakholdangrepsfesten?"

msgid "vo_sm_char18_m07_stg09_05"
msgstr "Teddy: Hører du kommunikasjonen deres? Og du bestemte deg for å nevne det NÅ?"

msgid "vo_sm_char18_m07_stg09_07"
msgstr "Teddy: Jeg elsker deg også, Leni!"

msgid "vo_sm_char18_m07_stg10_02"
msgstr "Teddy: Se på den skjønnheten! Hun er nydelig!"

msgid "vo_sm_char18_m07_stg10_04"
msgstr "Teddy: Ah, nein-nein-nein! Dette delikate utstyret er ikke til meg. Denne skjønnheten trenger en myk hånd."

msgid "vo_sm_char18_m07_stg10_04_01"
msgstr "Teddy: Kommandør, du burde ta styringen."

msgid "vo_sm_char18_m07_stg10_04_02"
msgstr "Teddy: Hvis jeg kjører denne greie vil våre ingeniører samle opp delene i bøtter!"

msgid "vo_sm_char18_m07_stg11_01"
msgstr "Teddy: Nå snakker vi! Vi er klar til å kjøre rett inn i den lille fella deres!"

msgid "vo_sm_char18_m07_stg11_01_01"
msgstr "Teddy: \"Når du har den største hammeren ser hvert eneste problem ut som en liten spiker!\""

msgid "vo_sm_char18_m07_stg12_02"
msgstr "Teddy: Det er hva vi trenger! På tide å dele ut noen ørefiker, kommandør!"

msgid "vo_sm_char18_m07_stg13_03"
msgstr "Teddy: Bare se på dette beistet! Kommandør, å kjøre forbi ville vært kriminelt!"

msgid "vo_sm_char18_m07_stg13_03_01"
msgstr "Teddy: Kanskje du burde sette deg inn likevel, eh?"

msgid "vo_sm_char18_m07_stg14_02"
msgstr "Teddy: Åh nei!.. Det er et dårlig tegn! ... Et dårlig tegn for dem, la oss ruinere bakholdsangrepet deres!"

msgid "vo_sm_char18_m07_stg15_02"
msgstr "Teddy: Mål! Ha! Du begynner å bli forutsigbar, Ulysses. Alltid de samme drillkommandoene."

msgid "vo_sm_char18_m07_stg15_06"
msgstr "Teddy: Fiende? DU er fienden!"

msgid "vo_sm_char18_m07_stg15_06_01"
msgstr "Teddy: Hei, herr Slem Fyr, hvorfor vil du ikke komme ned hit og snakke med oss ansikt til ansikt?"

msgid "vo_sm_char18_m07_stg15_08"
msgstr "Teddy: Selvfølgelig visste jeg det! Jeg bare... holdt lagmoralen oppe."

msgid "vo_sm_char18_m07_stg16_02"
msgstr "Teddy: Ah, her er den mest slue delen av bakholdsangrepet deres."

msgid "vo_sm_char18_m07_stg16_02_01"
msgstr "Teddy: De kan ikke penetrere pansringen vår med granater, så de prøver å kaste stein på oss i stedet."

msgid "vo_sm_char18_m07_stg16_02_02"
msgstr "Teddy: Slue jævler!"

msgid "vo_sm_char18_m07_stg17_02"
msgstr "Teddy: Nei, det er det som er så rart. Kan ikke en gang si hvem det er vi slåss mot lenger."

msgid "vo_sm_char18_m07_stg18_02"
msgstr "Teddy: Endelig! SELVESTE BAKHOLDSANGREPET! Hei Leni, hva er ellers på menyen?"

msgid "vo_sm_char18_m07_stg18_02_01"
msgstr "Teddy: Hvilke andre overraskelser har vår mr. Ond planlagt for oss?"

msgid "vo_sm_char18_m07_stg18_04"
msgstr "Teddy: Nei, nei, ikke fortell meg! Ingen hint, jeg vil se med egne øyne! Vi er klare for alt de hiver mot oss!"

msgid "vo_sm_char18_m07_stg18_06"
msgstr "Teddy: Flykte? Hva mener han 'flykte'? Vi prøver ikke å flykte."

msgid "vo_sm_char18_m07_stg18_06_01"
msgstr "Teddy: Vi kommer etter DEG, mr. Skummel Stemme. Og ja, Leni, jeg vet han ikke kan høre meg."

msgid "vo_sm_char18_m07_stg19_02"
msgstr "Teddy: Åh, når jeg får hendene mine på den parkerte rotta skal jeg demontere ham del for del!"

msgid "vo_sm_char18_m07_stg19_04"
msgstr "Teddy: Det er bedre. Jeg skal gjøre så godt jeg kan, Leni."

msgid "vo_sm_char18_m07_stg20_01"
msgstr "Teddy: Ha! Og ned kommer den. Forutsigbar som en sveitsisk klokke-bortsett fra at den er tysk."

msgid "vo_sm_char18_m07_stg21_02"
msgstr "Teddy: Åh se, flere lekevenner! Jeg begynte å bli bekymret for at vi slapp opp for mål å trene på!"

msgid "vo_sm_char18_m07_stg21_04"
msgstr "Teddy: En gammel venn av deg? Vil du jeg skal ta ham med også?"

msgid "vo_sm_char18_m07_stg21_06"
msgstr "Teddy: La meg gjette-du ønsker ham intakt også?"

msgid "vo_sm_char18_m07_stg21_08"
msgstr "Teddy: Jeg skal gjøre så godt jeg kan."

msgid "vo_sm_char18_m07_stg22_01"
msgstr "Teddy: Whoa! Hva i helvete var det?! Ok, ok... de overrasket meg der. Så ikke DEN komme."

msgid "vo_sm_char18_m07_stg23_01"
msgstr "Teddy: Hva i heiteste helvete var det?! Elektronikken på tanksen bare... slutta å funke!"

msgid "vo_sm_char18_m07_stg23_04"
msgstr "Teddy: Hei, hvorfor begynner ikke vi også å lage tanks som har ess oppi ermet sitt?"

msgid "vo_sm_char18_m07_stg23_04_01"
msgstr "Teddy: Jeg ville ikke hatt noe i mot spiondingser på tanksen min!"

msgid "vo_sm_char18_m07_stg23_06"
msgstr "Teddy: Er det et løfte, fräulein? Fordi jeg forventer at du holder det!"

msgid "vo_sm_char18_m07_stg24_02"
msgstr "Teddy: Ah, jeg skjønner. Fienden har tatt i bruk strategien \"la tanksene stå igjen og håp på det beste\"."

msgid "vo_sm_char18_m07_stg24_02_01"
msgstr "Teddy: Modig trekk!"

msgid "vo_sm_char18_m07_stg28_03"
msgstr "Teddy: Mottatt, Ulysses. Jeg tar var på det beste materialet til senere."

msgid "vo_sm_char18_m07_stg28_05"
msgstr "Teddy: Mein Gott, fräulein! Du er enda mer besatt av disse nye tanksene"

msgid "vo_sm_char18_m07_stg28_05_01"
msgstr "Teddy: enn det min onkel Pavel er med sin samling med pinner og grener som han har funnet over hele landet!"

msgid "vo_sm_char18_m07_stg28_05_02"
msgstr "Teddy: Selv om jeg må innrømme at han har flere utrolige."

msgid "vo_sm_char18_m07_stg29_02"
msgstr "Teddy: Ooooh, noen føler seg nedfor! Ser ut til at vi såret følelsene hans. "

msgid "vo_sm_char18_m07_stg29_04"
msgstr "Teddy: Ikke bekymre deg, fräulein, jeg lovte å levere ham til deg, gjorde jeg ikke?"

msgid "vo_sm_char18_m07_stg29_04_01"
msgstr "Teddy: Selv om jeg ikke kan garantere at han kommer frem uten noen få... skrammer."

msgid "vo_sm_char18_m07_stg29_04_02"
msgstr "Teddy: Du kan spørre ham om alt du lurer på selv."

msgid "vo_sm_char18_m07_stg30_02"
msgstr "Teddy: Herrejemini... Den raketten er mye større enn den så ut på avstand!"

msgid "vo_sm_char18_m07_stg30_02_01"
msgstr "Teddy: Som min onkels historier om fisken han fanget-bortsett fra at denne faktisk ER så stor!"

msgid "vo_sm_char18_m07_stg31_05"
msgstr "Teddy: Dette... dette kan ikke skje. Vi var så nære! Alt dette... for ingenting?"

msgid "vo_sm_char18_m07_stg31_09"
msgstr "Teddy: Jeg skal brøyte meg gjennom hver eneste en av dem og tygge meg en vei rett til kontrollsenteret."

msgid "vo_sm_char18_m07_stg31_09_01"
msgstr "Teddy: Så sender vi den fordømte raketten rett ned i havet!"

msgid "vo_sm_char18_m07_stg32_02"
msgstr "Teddy: Kommandør, du bør ta det beistet."

msgid "vo_sm_char18_m07_stg32_02_01"
msgstr "Teddy: De jævlene har kanskje skutt opp raketten sin, men de kommer ikke til å forlate denne øya intakt."

msgid "vo_sm_char18_m07_stg34_02"
msgstr "Teddy: Jeg skjønner. Jeg foretrekker også noe mer smidig enn disse tunge beistene."

msgid "vo_sm_char18_m07_stg34_02_01"
msgstr "Teddy: Det beste forsvaret er å holde seg i bevegelse."

msgid "vo_sm_char18_m07_stg35_04"
msgstr "Teddy: Du skal ingen steder, din jævel. Det eneste stedet du skal \"evakuere\" til"

msgid "vo_sm_char18_m07_stg35_04_01"
msgstr "Teddy: er vårt forhørsrom. Og jeg skal hjelpe dem med å levere deg dit personlig."

msgid "vo_sm_char18_m07_stg36_02"
msgstr "Teddy: Kom igjen, ta med alle du har igjen! Marsjer rett hit-"

msgid "vo_sm_char18_m07_stg36_02_01"
msgstr "Teddy: spar oss bryet med å jakte på deg når du prøver å stikke av med halen mellom beina."

msgid "vo_sm_char18_m07_stg36_02_02"
msgstr "Teddy: La oss avslutte dette her og nå!"

msgid "vo_sm_char18_m07_stg37_02"
msgstr "Teddy: Perfekt timing! Jeg må slippe ut litt damp."

msgid "vo_sm_char18_m07_stg37_05"
msgstr "Teddy: Ah, endelig! Vår gamle venn med et stort egokompleks bestemmer seg for å bli med på moroa."

msgid "vo_sm_char18_m07_stg37_05_01"
msgstr "Teddy: På tide å avgjøre vårt lille veddemål en gang for alle. Nå er det bare ett spørsmål igjen-"

msgid "vo_sm_char18_m07_stg37_05_02"
msgstr "Teddy: hvem av oss skal få sende ham til skraphaugen?"

msgid "vo_sm_char18_m07_stg37_05_03"
msgstr "Teddy: Jeg mener, til Leni sitt verksted."

msgid "vo_sm_char18_m07_stg38_01"
msgstr "Teddy: Vel, sånn er det. Åh, Leni, min kjære, jeg vet du ønsket å ha ham intakt, men..."

msgid "vo_sm_char18_m07_stg38_01_01"
msgstr "Teddy: det kan hende vi skrapet lakken bittelitt."

msgid "vo_sm_char18_m07_stg39_02"
msgstr "Teddy: Ritter, eh? Det navnet skal jeg sørge for at jeg husker."

msgid "vo_sm_char18_m07_stg41_07"
msgstr "Teddy: Vet du hva vi kaller tanks om ikke beveger på seg på tsjekkoslovakisk? Skytetrening!"

msgid "vo_sm_char18_m07_stg41_07_01"
msgstr "Teddy: Og jeg er ikke ute etter å bli noen andres skytegalleri i dag."

msgid "vo_sm_char18_m07_stg41_08"
msgstr "Teddy: Røtter vokser under beltene våre! På tide å rulle!"

msgid "vo_sm_char18_m07_stg41_09"
msgstr "Teddy: Kom deg av flekken, kommandør! Eventyret venter!"

msgid "vo_sm_char18_m07_stg42_03"
msgstr "Teddy: Det lange kanonløpet er tilbake i posisjonen sin igjen. Hold ham nede!"

msgid "vo_sm_char18_m07_stg42_04"
msgstr "Teddy: Tilbake til hiet ditt, din langløpede plage!"

msgid "vo_sm_char18_m07_stg42_05"
msgstr "Teddy: Hva i helvete er den greia?"

msgid "vo_sm_char18_m07_stg42_05_01"
msgstr "Teddy: Kanonløpet er lengre enn min tante Katarina sin liste over havarerte ekteskap."

msgid "vo_sm_char18_m07_stg42_05_02"
msgstr "Teddy: Og stol på meg, det sier litt!"

msgid "vo_sm_char18_m07_stg42_08"
msgstr "Teddy: Hva? Hadde han med seg et verksted i lomma si?"

msgid "vo_sm_char18_m07_stg42_09"
msgstr "Teddy: Utrolig! Det lange kanonløpet er reparert! Vi lagde definitivt noen pene hull i det beistet!"

msgid "vo_sm_char18_m07_stg42_10"
msgstr "Teddy: Han er lappet sammen! Hvordan i helvete klarte han det?"

msgid "vo_sm_char18_m07_stg43_03"
msgstr "Teddy: Pokker! Er kommandørens tanks nede—hold dem engasjert til han kommer tilbake!"

msgid "vo_sm_char18_m07_stg43_04"
msgstr "Teddy: Kommandøren er nede! Hold ut, han kommer tilbake på null tid!"

msgid "vo_sm_char18_m07_stg44_04"
msgstr "Teddy: Bytter du kjøretøy igjen? La oss ikke gjøre det til en tradisjon."

msgid "vo_sm_char18_m07_stg44_05"
msgstr "Teddy: Bra vi har reservedeler-bare ikke tøy strikken."

msgid "vo_sm_char18_m07_stg44_06"
msgstr "Teddy: Hei! Ta det rolig! Jeg tror ikke de etterlot så veldig mange av leketøyene sine."

msgid "vo_sm_char18_m07_stg44_06_01"
msgstr "Teddy: Prøv å ikke ødelegge den."

msgid "vo_sm_char18_m07_stg45_04"
msgstr "Teddy: Faen! De tok meg-ikke ha det for moro uten meg!"

msgid "vo_sm_char18_m07_stg45_05"
msgstr "Teddy: Vel, der forsvant doningen min-Jeg henter en annen!"

msgid "vo_sm_char18_m07_stg45_06"
msgstr "Teddy: Boom-men denne gang er det meg! Bare vent, jeg kommer tilbake!"

msgid "vo_sm_char18_m07_stg46_03"
msgstr "Teddy: Faen ta! Det forvokste beistet tok meg faktisk!"

msgid "vo_sm_char18_m07_stg46_04"
msgstr "Teddy: Ok, storegutt, du vinner denne runden... Men jeg kommer tilbake!"

msgid "vo_sm_char18_m07_stg47_03"
msgstr "Teddy: Hallo, verden! Det er meg igjen! Savnet meg?"

msgid "vo_sm_char18_m07_stg47_04"
msgstr "Teddy: Jeg er tilbake. Ny tanks. Den gamle hadde en rar bankelyd i motoren... og altfor mange hull."

msgid "vo_sm_char18_m07_stg48_02"
msgstr "Teddy: Helvete! Jeg er ute. Ta ut noen for meg, vil du?"

msgid "vo_sm_char18_m07_stg49_02"
msgstr "Teddy: Hva? Hvordan? Nei, nei, nei... Dette kan ikke være sant. Tapte vi? Jeg tror det ikke."

msgid "vo_sm_char18_m07_stg50_02"
msgstr "Teddy: Vel, da er alle tanksene våre borte... Jeg er rasende! Helt forbanna!"

msgid "vo_sm_char18_m07_stg51_02"
msgstr "Teddy: Vel, se hvem som dukket opp til festen."

msgid "vo_sm_char18_m07_stg52_02"
msgstr "Teddy: Vel, den greia ser dyr ut. La oss se hvor godt den brenner."

msgid "vo_sm_char18_m07_stg53_03"
msgstr "Teddy: BOOM! Leni, så synd du ikke kan se hvordan kommandøren akkurat tok ut den prototypen."

msgid "vo_sm_char18_m07_stg53_04"
msgstr "Teddy: Bra jobba, kommandør! Jeg håper de beholdt kvitteringen-den er ikke så effektiv som de trodde."

msgid "vo_sm_char18_m07_stg54_03"
msgstr "Teddy: Ha! Så mye preik... Prototype ditt, avansert teknologi datt..."

msgid "vo_sm_char18_m07_stg54_04"
msgstr "Teddy: Jeg bekjempet den! Feltprøven deres feilet!"

msgid "vo_sm_char18_m07_stg55_03"
msgstr "Teddy: Nå kjører vi! På tide å knekke litt pansring!"

msgid "vo_sm_char18_m07_stg55_04"
msgstr "Teddy: Våpen klare! La oss gi dem en skikkelig velkomst!"

msgid "vo_sm_char18_m07_stg56_04"
msgstr "Teddy: Sånn, vi er ferdig her-la oss rulle!"

msgid "vo_sm_char18_m07_stg56_05"
msgstr "Teddy: Siste er tatt ut-la oss ikke kaste bort tiden, kjør, kjør!"

msgid "vo_sm_char18_m07_stg56_06"
msgstr "Teddy: Vel, det var det-hvem er neste?"

msgid "vo_sm_char18_m07_stg57_04"
msgstr "Teddy: Boom! Den kommer ikke til å bry oss mer!"

msgid "vo_sm_char18_m07_stg57_05"
msgstr "Teddy: Enda en biter i gresset! Bra jobba!"

msgid "vo_sm_char18_m07_stg57_06"
msgstr "Teddy: Sånn skal det gjøres-la oss finne et nytt mål til deg!"

msgid "vo_sm_char18_m07_stg57_07"
msgstr "Teddy: En til unnagjort-hvem er ditt neste mål?"

msgid "vo_sm_char18_m07_stg58_04"
msgstr "Teddy: Ha! Den der er min!"

msgid "vo_sm_char18_m07_stg58_05"
msgstr "Teddy: Tok ham ut!"

msgid "vo_sm_char18_m07_stg58_06"
msgstr "Teddy: Værsågod neste!"

msgid "vo_sm_char18_m07_stg59_03"
msgstr "Teddy: Innkommende fyrverkeri! La oss lene oss tilbake og nyte forestillingen!"

msgid "vo_sm_char18_m07_stg59_04"
msgstr "Teddy: Nå smeller det! La oss se hvordan de liker en liten hilsen fra lufta."

msgid "vo_sm_char18_m07_stg60_02"
msgstr "Teddy: Piloten vår kan ikke utføre mirakler!"

msgid "vo_sm_char18_m07_stg61_04"
msgstr "Teddy: Vel, det er en sjokkerende utvikling!"

msgid "vo_sm_char18_m07_stg61_05"
msgstr "Teddy: Zap! Nå er de bare målskiver-la oss ta dem ut!"

msgid "vo_sm_char18_m07_stg61_06"
msgstr "Teddy: Ser ut som de har litt strømbrudd!"

msgid "vo_sm_char18_m07_stg61_07"
msgstr "Teddy: De er knust! Nå er det bare å valse over dem!"

msgid "vo_sm_char18_m07_stg62_05"
msgstr "Teddy: Modulær rustning gjør underverker! Som min onkel Pavel sier,"

msgid "vo_sm_char18_m07_stg62_05_01"
msgstr "Teddy: \"En god mekaniker kan fikse alt unntatt et knust hjerte!\""

msgid "vo_sm_char18_m07_stg62_06"
msgstr "Teddy: Den moderne ingeniørkunstens underverker!"

msgid "vo_sm_char18_m07_stg62_06_01"
msgstr "Teddy: Bytter pansringsplater raskere enn bestemoren min ombestemmer seg!"

msgid "vo_sm_char18_m07_stg62_07"
msgstr "Teddy: Tanksen din er som ny! Skinnende og uten ekstra hull."

msgid "vo_sm_char18_m07_stg62_08"
msgstr "Teddy: Byttet ut de pansringsplatene, ja? Nå ser ikke tanken din ut som sveitserost lenger."

msgid "vo_sm_char18_m07_stg62_08_01"
msgstr "Teddy: Mye mindre appetittvekkende!"

msgid "vo_sm_char18_m07_stg63_04"
msgstr "Teddy: Noen ser på oss med kikkert og en radio! Flytt beltene dine vekk derfra!"

msgid "vo_sm_char18_m07_stg63_05"
msgstr "Teddy: Den sleipe artilleriobservatøren har sett oss! Gå! Gå!"

msgid "vo_sm_char18_m07_stg63_06"
msgstr "Teddy: Speideren deres setter usynlige sikter på tanksen din! På tide å skuffe ham! Kjør!"

msgid "vo_sm_char18_m07_stg63_07"
msgstr "Teddy: Smell kommer! Flytt deg, med mindre du vil bli en del av landskapet!"

msgid "vo_sm_char18_m07_stg63_08"
msgstr "Teddy: De har kalt inn de store kanonene! Du bør flytte på deg!"

msgid "vo_sm_char18_m07_stg64_03"
msgstr "Teddy: Fort deg! Treff dem med de fancy granatene dine mens de viser seg frem!"

msgid "vo_sm_char18_m07_stg64_04"
msgstr "Teddy: Den tanksen pønsker på noe! Stopp den før den blir ferdig!"

msgid "vo_sm_char18_m07_stg65_03"
msgstr "Teddy: Se på det! De lapper seg selv sammen som magi! Det skal vi gjøre noe med!"

msgid "vo_sm_char18_m07_stg65_04"
msgstr "Teddy: Leni, du kommer til å elske denne teknologien! De fikser seg selv midt i kampen!"

msgid "vo_sm_char18_m07_stg65_04_01"
msgstr "Teddy: Skal jeg ta med en prøve tilbake?"

msgid "vo_sm_char18_m07_stg66_03"
msgstr "Teddy: Whoa! Denne fyren tror han er en racerbil! Ikke la ham komme nær pansringen din!"

msgid "vo_sm_char18_m07_stg66_04"
msgstr "Teddy: Hva i all verden?! Har han festet raketter til tanksen sin?"

msgid "vo_sm_char18_m07_stg67_03"
msgstr "Teddy: De har fritert de fancy dingsene dine, kommandør! Tilbake til gammeldags tankskjøring foreløpig!"

msgid "vo_sm_char18_m07_stg67_04"
msgstr "Teddy: Tanksens spesielle magi er vekk, kommandør! De traff deg med sine anti-moro granater!"

msgid "vo_sm_char18_m07_stg68_01"
msgstr "Teddy: Leni, et kjapt spørsmål-vet etterretningen vår egentlig hvor mange fiender det er på denne øya?"

msgid "vo_sm_char18_m07_stg68_03"
msgstr "Teddy: Vet de noe som helst?"

msgid "vo_sm_char18_m07_stg68_05"
msgstr "Teddy: Vel, det er i hvert fall noe!"

msgid "vo_sm_char18_m07_stg69_01"
msgstr "Teddy: Disse leiesoldatene har bedre utstyr enn oss! Noen støtter dem med seriøse penger."

msgid "vo_sm_char18_m07_stg69_03"
msgstr "Teddy: Åh, mystisk! Jeg elsker når du er så hemmelighetsfull."

msgid "vo_sm_char18_m07_stg70_01"
msgstr "Teddy: Leni, kjære, når dette er over, tar jeg deg med til Praha."

msgid "vo_sm_char18_m07_stg70_01_01"
msgstr "Teddy: Det er en liten taverna der-de beste kringlene, gulasj,"

msgid "vo_sm_char18_m07_stg70_01_02"
msgstr "Teddy: og det er type stedet hvor du bare kan lene deg tilbake og nyte kvelden. Du er for anspent!"

msgid "vo_sm_char18_m07_stg71_02"
msgstr "Teddy: Et liv uten risiko er som gulasj uten paprika-kjedelig og skuffende!"

msgid "vo_sm_char18_m07_stg71_04"
msgstr "Teddy: Vent litt... Hva? Fantes det en forgjenger? Hva skjedde med ham? Leni?"

msgid "vo_sm_char18_m07_stg72_01"
msgstr "Teddy: Bestefaren min sa alltid: \"Stol på instinktene dine, men sjekk ammunisjonen din to ganger.\""

msgid "vo_sm_char18_m07_stg72_03"
msgstr "Teddy: Han ville ha likt deg. Han satte alltid pris på farlige kvinner."

msgid "vo_sm_char18_m07_stg72_05"
msgstr "Teddy: Det var det absolutt!"

msgid "vo_sm_char18_m07_stg74_01"
msgstr "Teddy: Denne eksperimentelle ammunisjonen er fantastisk! Måten den slår ut systemene deres på er som magi!"

msgid "vo_sm_char18_m07_stg74_03"
msgstr "Teddy: Du er nok fantastisk i barnebursdager."

msgid "vo_sm_char18_m07_stg74_03_01"
msgstr "Teddy: \"Det er ikke en kanin, barn, det er bare en domestisert Oryctolagus cuniculus.\""

msgid "vo_sm_char18_m07_stg75_01"
msgstr "Teddy: Hei Leni, når dette er over, hva slags suvenir vil du ha?"

msgid "vo_sm_char18_m07_stg75_01_01"
msgstr "Teddy: Jeg tenker å ta med den snikskyttertanksens kanonløp til deg."

msgid "vo_sm_char18_m07_stg75_01_02"
msgstr "Teddy: Du ser ut til å like alle disse langdistansevåpnene."

msgid "vo_sm_char18_m07_stg75_03"
msgstr "Teddy: Er det tysk for \"jeg bryr meg om deg\"? Jeg blir rørt!"

msgid "vo_sm_char18_m07_stg76_01"
msgstr "Teddy: Leni, hvis du hadde vært her, ville du satt pris på hvor vakker denne eksperimentelle tanksen er."

msgid "vo_sm_char18_m07_stg76_01_01"
msgstr "Teddy: Slanke linjer, kraftig motor, akkurat som..."

msgid "vo_sm_char18_m07_stg76_03"
msgstr "Teddy: ...akkurat som tysk ingeniørkunst skal være! Hva trodde du jeg skulle si?"

msgid "vo_sm_char18_m07_stg77_02"
msgstr "Teddy: Spare på ammunisjon? Hva blir det neste, gjenbruke teposer? Vaske plastskjeer? Tørke papirhåndklær?"

msgid "vo_sm_char18_m07_stg78_01"
msgstr "Teddy: Jeg vedder fem dollar på at vår mystiske leiesoldatkommandør med den skumle stemmen har en fancy bart."

msgid "vo_sm_char18_m07_stg78_01_01"
msgstr "Teddy: Alle skikkelige skurker har bart."

msgid "vo_sm_char18_m07_stg78_03"
msgstr "Teddy: Ti dollar på at han snurrer den når han tror ingen ser på."

msgid "vo_sm_char18_m07_stg79_01"
msgstr "Teddy: Har du lagt merke til formasjonen deres! Vennene våre har lest militære lærebøker."

msgid "vo_sm_char18_m07_stg79_01_01"
msgstr "Teddy: Første kapittel: «Hvordan bli omringet og bekjempet i tre enkle trinn.»"

msgid "vo_sm_char18_m07_stg79_03"
msgstr "Teddy: Overmot, inkompetanse-begge ender med samme eksplosjon, min venn."

msgid "vo_sm_char18_m07_stg80_01"
msgstr "Teddy: Vet du hva som er rart? Jeg liker faktisk dette oppdraget."

msgid "vo_sm_char18_m07_stg80_01_01"
msgstr "Teddy: Pittoreske landskap, uvanlige nye tanks, mystiske fiender..."

msgid "vo_sm_char18_m07_stg80_01_02"
msgstr "Teddy: Jeg vil kalle dette \"aktiv rekreasjon\"!"

msgid "vo_sm_char18_m07_stg80_03"
msgstr "Teddy: Psykologisk evaluering? Skulle vi ha en psykologisk evaluering?!"

msgid "vo_sm_char18_m07_stg80_05"
msgstr "Teddy: Ah... så den praten med den hyggelige damen var en evaluering..."

msgid "vo_sm_char18_m07_stg81_04"
msgstr "Teddy: Hva er det du snakker om?"

msgid "vo_sm_char18_m07_stg83_05"
msgstr "Teddy: Kødder du, eller?"

msgid "vo_sm_char18_m07_stg85_01"
msgstr "Teddy: Ha! Eliteenheten deres var ikke så elite likevel!"

msgid "vo_sm_char18_m07_stg85_03"
msgstr "Teddy: Bare noen få fiender til mellom oss og den raketten."

msgid "vo_sm_char18_m07_stg85_03_01"
msgstr "Teddy: Bestemora mi kunne ryddet denne stien med tresleiva si!"

msgid "vo_sm_char18_m07_stg86_03"
msgstr "Teddy: Faen! Det overdimensjonerte beistet tok kommandøren-dette ble nå personlig!"

msgid "vo_sm_char18_m07_stg86_04"
msgstr "Teddy: Tok den tingen faktisk ut kommandøren? Ok, nå er jeg forbanna!"

msgid "vo_sm_char19_m07_stg01_01"
msgstr "James \"Ulysses\" Corvin: Ulysses her. Vi har landet. Pokker... stranden er en kirkegård for tanks."

msgid "vo_sm_char19_m07_stg01_01_01"
msgstr "Ulysses: Ingen overlevende fra den første bølgen. Vi kan ikke kaste bort tid."

msgid "vo_sm_char19_m07_stg01_01_02"
msgstr "Ulysses: Vi må nå kommandosentralen og stoppe den oppskytingen for enhver pris."

msgid "vo_sm_char19_m07_stg02_01"
msgstr "Ulysses: Kontakt i front! Tyske tanks, klokka elleve. Fri ildgivning."

msgid "vo_sm_char19_m07_stg03_01"
msgstr "Ulysses: Ny kontakt! Dekningsild!"

msgid "vo_sm_char19_m07_stg04_02"
msgstr "Ulysses: Han trekker seg tilbake."

msgid "vo_sm_char19_m07_stg04_04"
msgstr "Ulysses: Vi må fortsette å bevege oss. På denne avstanden har vi ikke en sjanse mot den ildkraften."

msgid "vo_sm_char19_m07_stg04_04_01"
msgstr "Ulysses: Vi må få mindre avstand, finne en måte å flankere den på. Fremover!"

msgid "vo_sm_char19_m07_stg04_05"
msgstr "Ulysses: Hold fokus! Vi må eliminere fiendene her først."

msgid "vo_sm_char19_m07_stg04_05_01"
msgstr "Ulysses: Vi tar oss av den langløpede bråkmakeren senere."

msgid "vo_sm_char19_m07_stg05_01"
msgstr "Ulysses: Nye fiender oppdaget forut."

msgid "vo_sm_char19_m07_stg06_01"
msgstr "Ulysses: Pokker, denne gangen er det flere av dem."

msgid "vo_sm_char19_m07_stg07_01"
msgstr "Ulysses: Jeg har sett verre odds i Nord-Afrika. Fortsett å presse på, vi kommer til å bryte gjennom."

msgid "vo_sm_char19_m07_stg07_02"
msgstr "Ulysses: Jobb sammen. Angrip flankene deres!"

msgid "vo_sm_char19_m07_stg08_01"
msgstr "Ulysses: Langløpet er tilbake! Dekningsild, NÅ!"

msgid "vo_sm_char19_m07_stg09_01"
msgstr "Ulysses: Fortsett å bevege deg. Den raskeste veien til raketten er gjennom denne fabrikken."

msgid "vo_sm_char19_m07_stg10_01"
msgstr "Ulysses: Hold posisjonen. Ser ut som vi har funnet noe... interessant."

msgid "vo_sm_char19_m07_stg10_01_01"
msgstr "Ulysses: Forlatte tanks. Ukjente modeller."

msgid "vo_sm_char19_m07_stg12_01"
msgstr "Ulysses: Disse granatene ser eksperimentelle ut. De vil sannsynligvis deaktivere fiendtlige kjøretøy midlertidig."

msgid "vo_sm_char19_m07_stg13_02"
msgstr "Ulysses: Kommandør, den eksperimentelle tanksen kan gi oss en kritisk taktisk fordel."

msgid "vo_sm_char19_m07_stg13_02_01"
msgstr "Ulysses: Jeg anbefaler på det sterkeste at du tar kommandoen over den."

msgid "vo_sm_char19_m07_stg14_01"
msgstr "Ulysses: Pass på!"

msgid "vo_sm_char19_m07_stg15_01"
msgstr "Ulysses: Pass på forut! Flere!"

msgid "vo_sm_char19_m07_stg15_03"
msgstr "Ulysses: Klare kommandoer som disse holder oss i live, min muntre venn."

msgid "vo_sm_char19_m07_stg16_01"
msgstr "Ulysses: Forsiktig!"

msgid "vo_sm_char19_m07_stg18_01"
msgstr "Ulysses: De prøver å omringe oss. Innta posisjonene deres!"

msgid "vo_sm_char19_m07_stg18_07"
msgstr "Ulysses: Ingen tid til langtrukne kamper. Gjør det kjapt og bestemt!"

msgid "vo_sm_char19_m07_stg19_01"
msgstr "Ulysses: Se på det hullet i veggen. Vennen vår i midten kan skyte på oss gjennom det. Hold deg i dekning."

msgid "vo_sm_char19_m07_stg20_03"
msgstr "Ulysses: Ingen tid til å krangle. Klokka tikker-beveg deg, beveg deg!"

msgid "vo_sm_char19_m07_stg23_03"
msgstr "Ulysses: Ny trussel identifisert. De bruker en slags eksperimentell ammunisjon."

msgid "vo_sm_char19_m07_stg23_03_01"
msgstr "Ulysses: som midlertidig lammer elektronikken i kjøretøyene våre."

msgid "vo_sm_char19_m07_stg23_03_02"
msgstr "Ulysses: Dette er ikke vanlige leiesoldater-de har avansert teknologi vi aldri har sett før."

msgid "vo_sm_char19_m07_stg24_01"
msgstr "Ulysses: Se der, enda en servicestasjon i felten... og igjen tanks jeg ikke kan identifisere."

msgid "vo_sm_char19_m07_stg25_01"
msgstr "Ulysses: Utmerket funn."

msgid "vo_sm_char19_m07_stg25_01_01"
msgstr "Ulysses: Denne tanksen er utstyrt med en slags modulære panserplater som raskt kan byttes ut i felten."

msgid "vo_sm_char19_m07_stg25_01_02"
msgstr "Ulysses: Det kunne vært nyttig."

msgid "vo_sm_char19_m07_stg27_01"
msgstr "Ulysses: Nå bør vi justere taktikken vår."

msgid "vo_sm_char19_m07_stg27_01_01"
msgstr "Ulysses: Teddy og jeg går i front mens dere gir dekningsild bakfra."

msgid "vo_sm_char19_m07_stg27_01_02"
msgstr "Ulysses: Det vil sikre den nye tanksen bedre og gjør at du får mest mulig ut av den imponerende kanonen."

msgid "vo_sm_char19_m07_stg28_02"
msgstr "Ulysses: Ser ut til at denne Adler-Gruppen er en eller annen type eliteenhet,"

msgid "vo_sm_char19_m07_stg28_02_01"
msgstr "Ulysses: mye farligere enn noe annet vi har møtt så langt."

msgid "vo_sm_char19_m07_stg28_02_02"
msgstr "Ulysses: Teddy, på tide å legge vitsene til side og vise dem hva vi egentlig er laget av."

msgid "vo_sm_char19_m07_stg29_05"
msgstr "Ulysses: Hovedmålet vårt er å stoppe den rakettutskytningen. Alt annet kommer i andre rekke."

msgid "vo_sm_char19_m07_stg29_05_01"
msgstr "Ulysses: Ikke bli distrahert."

msgid "vo_sm_char19_m07_stg30_01"
msgstr "Ulysses: Vi er nesten ved målet. En siste fremrykking!"

msgid "vo_sm_char19_m07_stg31_04"
msgstr "Ulysses: Nei! NEI! FOR HELVETE, NEI!"

msgid "vo_sm_char19_m07_stg31_06"
msgstr "Ulysses: Vi klarte ikke å forhindre oppskytingen. Missilet er på vei opp."

msgid "vo_sm_char19_m07_stg31_08"
msgstr "Ulysses: Bekreftes."

msgid "vo_sm_char19_m07_stg32_01"
msgstr "Ulysses: Enda en feltreparasjonsbase er oppdaget foran. Det er ukjente tunge tanks der."

msgid "vo_sm_char19_m07_stg32_01_01"
msgstr "Ulysses: Ser ut til å være betydelig tyngre pansret enn noe vi har møtt så langt."

msgid "vo_sm_char19_m07_stg33_02"
msgstr "Ulysses: Overraskelsen er... det er ikke noe spesielt med det."

msgid "vo_sm_char19_m07_stg33_02_01"
msgstr "Ulysses: Vel, bortsett fra uvanlig sterk pansring og uvanlig lav hastighet."

msgid "vo_sm_char19_m07_stg33_02_02"
msgstr "Ulysses: Og det er akkurat det vi trenger nå."

msgid "vo_sm_char19_m07_stg35_01"
msgstr "Ulysses: Oppskytningssted sikret. Vi holder posisjonen ved bunkerinngangen."

msgid "vo_sm_char19_m07_stg36_01"
msgstr "Ulysses: Nye fiender på vei. Flytter meg til en bedre forsvarsposisjon."

msgid "vo_sm_char19_m07_stg37_01"
msgstr "Ulysses: Vel Teddy, du fikk ønsket ditt oppfylt. Det ser ut som de alle kommer hit i stedet for å evakuere."

msgid "vo_sm_char19_m07_stg37_01_01"
msgstr "Ulysses: Dette ser ut til å være deres største bølge hittil."

msgid "vo_sm_char19_m07_stg37_04"
msgstr "Ulysses: Bevegelse oppdaget i midten! Den langløpede prototypen er tilbake."

msgid "vo_sm_char19_m07_stg40_01"
msgstr "Ulysses: Leni, hva er status på den raketten?"

msgid "vo_sm_char19_m07_stg40_03"
msgstr "Ulysses: Hva mener du?"

msgid "vo_sm_char19_m07_stg41_01"
msgstr "Ulysses: Stå stille og vi ender opp som den første bølgen. La oss komme oss ut."

msgid "vo_sm_char19_m07_stg41_02"
msgstr "Ulysses: Vi har dårlig tid. På tide å komme seg videre."

msgid "vo_sm_char19_m07_stg41_03"
msgstr "Ulysses: Å sitte stille gjør oss til lette mål. Kjør ut."

msgid "vo_sm_char19_m07_stg42_01"
msgstr "Ulysses: Kontakt i sentrum! Hold ham i sjakk!"

msgid "vo_sm_char19_m07_stg42_02"
msgstr "Ulysses: Den snikskytteren er tilbake-hold presset oppe, ikke la ham få et uforstyrret skudd!"

msgid "vo_sm_char19_m07_stg42_06"
msgstr "Ulysses: Panserjager i midten-reparert og operativ!"

msgid "vo_sm_char19_m07_stg42_07"
msgstr "Ulysses: Hvordan fikset han den skaden så raskt?"

msgid "vo_sm_char19_m07_stg43_01"
msgstr "Ulysses: Vær på vakt! Kommandøren er ute, men ikke lenge!"

msgid "vo_sm_char19_m07_stg43_02"
msgstr "Ulysses: Kommandøren er truffet! Fortsett å presse, han kommer straks tilbake!"

msgid "vo_sm_char19_m07_stg44_01"
msgstr "Ulysses: Du er tilbake i kampen, perfekt! Men nå skal vi være mer forsiktige."

msgid "vo_sm_char19_m07_stg44_02"
msgstr "Ulysses: Det var nære på. La oss holde tanksen intakt neste gang, ok?"

msgid "vo_sm_char19_m07_stg44_03"
msgstr "Ulysses: Disse reparasjonsbasene har ikke ubegrenset tilgang på nye tanks."

msgid "vo_sm_char19_m07_stg44_03_01"
msgstr "Ulysses: Vær mer forsiktig neste gang."

msgid "vo_sm_char19_m07_stg45_01"
msgstr "Ulysses: Pokker! Jeg er nede! Jeg kommer straks tilbake."

msgid "vo_sm_char19_m07_stg45_02"
msgstr "Ulysses: De tok meg! Hold ut, jeg kommer tilbake!"

msgid "vo_sm_char19_m07_stg45_03"
msgstr "Ulysses: Jeg er truffet! Fortsett å presse på-jeg kommer straks tilbake!"

msgid "vo_sm_char19_m07_stg46_01"
msgstr "Ulysses: Jeg er nede. Pokker, den greia er venskeligere å håndtere enn de andre."

msgid "vo_sm_char19_m07_stg46_02"
msgstr "Ulysses: Fikk en direkte treffer... Disse nye tanksene er ikke til å spøke med."

msgid "vo_sm_char19_m07_stg47_01"
msgstr "Ulysses: Jeg er tilbake i aksjon. Forhåpentligvis ingen overraskelser denne gangen."

msgid "vo_sm_char19_m07_stg47_02"
msgstr "Ulysses: Tilbake i kampen. Pokker... Noen ganger er det bare for mange av dem."

msgid "vo_sm_char19_m07_stg48_01"
msgstr "Ulysses: Tanksen min er nede. Jeg er ute av kampen-fullfør oppdraget for enhver pris!"

msgid "vo_sm_char19_m07_stg49_01"
msgstr "Ulysses: Pokker... Vi var for trege. Vår feil."

msgid "vo_sm_char19_m07_stg50_01"
msgstr "Ulysses: Det var det. Vi er tomme for tanks. Denne kampen er over."

msgid "vo_sm_char19_m07_stg51_01"
msgstr "Ulysses: Fiendtlige forsterkninger på vei. Gjør deg klar."

msgid "vo_sm_char19_m07_stg52_01"
msgstr "Ulysses: Ny fiende observert. Det er ingen vanlig tanks-vær på vakt."

msgid "vo_sm_char19_m07_stg53_01"
msgstr "Ulysses: Pent skudd! Eksperimentell enhet ødelagt. Det er ett problem mindre å hanskes med."

msgid "vo_sm_char19_m07_stg53_02"
msgstr "Ulysses: Bra jobba! Det var det for den fancy leken deres. La oss holde presset oppe."

msgid "vo_sm_char19_m07_stg54_01"
msgstr "Ulysses: Stort mål nøytralisert. La oss se hva annet de har."

msgid "vo_sm_char19_m07_stg54_02"
msgstr "Ulysses: Det beste de hadde var bare ikke godt nok. La oss avslutte denne kampen."

msgid "vo_sm_char19_m07_stg55_01"
msgstr "Ulysses: Kontakt! Skyt fritt!"

msgid "vo_sm_char19_m07_stg55_02"
msgstr "Ulysses: Engasjerer fienden. Hold dere våkne."

msgid "vo_sm_char19_m07_stg56_01"
msgstr "Ulysses: Siste målet nede-kjør ut."

msgid "vo_sm_char19_m07_stg56_02"
msgstr "Ulysses: Det er den siste-området er klarert, la oss kjøre."

msgid "vo_sm_char19_m07_stg56_03"
msgstr "Ulysses: Fiendegruppe nøytralisert-på tide å rykke fremover."

msgid "vo_sm_char19_m07_stg57_01"
msgstr "Ulysses: Mål nede."

msgid "vo_sm_char19_m07_stg57_02"
msgstr "Ulysses: Fiende eliminert."

msgid "vo_sm_char19_m07_stg57_03"
msgstr "Ulysses: Godt skudd!"

msgid "vo_sm_char19_m07_stg58_01"
msgstr "Ulysses: Jeg har eliminert trusselen."

msgid "vo_sm_char19_m07_stg58_02"
msgstr "Ulysses: Jeg tar ham."

msgid "vo_sm_char19_m07_stg58_03"
msgstr "Ulysses: Jeg dekker deg, angrip dem!"

msgid "vo_sm_char19_m07_stg59_01"
msgstr "Ulysses: Innkommende luftstøtte. Vent på innslag."

msgid "vo_sm_char19_m07_stg59_02"
msgstr "Ulysses: Angrep bekreftet. Hold deg vekk fra innslagssonen."

msgid "vo_sm_char19_m07_stg60_01"
msgstr "Ulysses: Luftstøtte kan ikke treffe den posisjonen. Juster målkoordinatene dine."

msgid "vo_sm_char19_m07_stg61_01"
msgstr "Ulysses: Målet er sjokket-nå har vi sjansen til å slå hardt til!"

msgid "vo_sm_char19_m07_stg61_02"
msgstr "Ulysses: Fiendens systemer er lammet. Gjør det slutt på dem!"

msgid "vo_sm_char19_m07_stg61_03"
msgstr "Ulysses: Fiendens spesielle evner er deaktivert. Angrip! Nå!"

msgid "vo_sm_char19_m07_stg62_01"
msgstr "Ulysses: Hullet i skroget ditt er tettet igjen. Kampdyktigheten er tilbake på optimalt nivå."

msgid "vo_sm_char19_m07_stg62_02"
msgstr "Ulysses: Modulær pansring erstattet. Kjøretøyet ditt er kampklart igjen."

msgid "vo_sm_char19_m07_stg62_03"
msgstr "Ulysses: Pansringsplater byttet ut. Beskyttelsen din er tilbake til normalen."

msgid "vo_sm_char19_m07_stg62_04"
msgstr "Ulysses: Pansringen din er fiksa! Fortsett med oppdraget."

msgid "vo_sm_char19_m07_stg63_01"
msgstr "Ulysses: Artilleriobservatør oppdaget! Rydd innslagsområdet umiddelbart!"

msgid "vo_sm_char19_m07_stg63_02"
msgstr "Ulysses: Innkommende artiller! Kjør-NÅ!"

msgid "vo_sm_char19_m07_stg63_03"
msgstr "Ulysses: Fiendtlig artilleri på vei! Vi har sekunder før det treffer-flytt deg!"

msgid "vo_sm_char19_m07_stg64_01"
msgstr "Ulysses: De utplasserer eksperimentelle systemer. Forstyrr dem! Bruk spesialammunisjonen din nå!"

msgid "vo_sm_char19_m07_stg64_02"
msgstr "Ulysses: Målet forbereder spesialangrep. Sjokk dem før han blir klar."

msgid "vo_sm_char19_m07_stg65_01"
msgstr "Ulysses: Fienden reparerer seg selv. Det er ikke bra."

msgid "vo_sm_char19_m07_stg65_02"
msgstr "Ulysses: De driver med reparasjoner på slagmarken. Vi må påføre dem skade raskere enn de kan fikse det."

msgid "vo_sm_char19_m07_stg66_01"
msgstr "Ulysses: Fienden akselererer til kollisjonshastighet! Unnvik!"

msgid "vo_sm_char19_m07_stg66_02"
msgstr "Ulysses: Fiender nærmer seg i full fart. Ikke la dem få kontakt."

msgid "vo_sm_char19_m07_stg67_01"
msgstr "Ulysses: Kommandør, de har truffet systemgrensesnittet ditt! Elektronisk utstyr midlertidig frakoblet."

msgid "vo_sm_char19_m07_stg67_02"
msgstr "Ulysses: Direkte treff på kontrollmodulene. Den fancy elektronikken din er midlertidig ute av drift."

msgid "vo_sm_char19_m07_stg77_01"
msgstr "Ulysses: Teddy, du må spare på ammunisjonen. Skyt mindre, sikt på svake punkter."

msgid "vo_sm_char19_m07_stg78_02"
msgstr "Ulysses: Jeg ser ingen verdi i meningsløs spekulasjon og veddemål."

msgid "vo_sm_char19_m07_stg79_02"
msgstr "Ulysses: Posisjoneringen deres tyder på overmot, ikke inkompetanse. Ikke undervurder dem."

msgid "vo_sm_char19_m07_stg80_02"
msgstr "Ulysses: Teddy, du må seriøst revurdere konseptet ditt om rekreasjon."

msgid "vo_sm_char19_m07_stg80_02_01"
msgstr "Ulysses: Er du sikker på at du besto den psykologiske evalueringen før dette oppdraget?"

msgid "vo_sm_char19_m07_stg81_02"
msgstr "Ulysses: Tror du vi blir manipulert?"

msgid "vo_sm_char19_m07_stg82_01"
msgstr "Ulysses: Leni, du er uvanlig stille. Hva tenker du?"

msgid "vo_sm_char19_m07_stg82_03"
msgstr "Ulysses: Og?"

msgid "vo_sm_char19_m07_stg83_01"
msgstr "Ulysses: Leni, jeg trenger din ærlige mening. Blir Teddy værre eller bedre med vitsene sine?"

msgid "vo_sm_char19_m07_stg83_03"
msgstr "Ulysses: Analyserer du faktisk vitsene hans?"

msgid "vo_sm_char19_m07_stg85_02"
msgstr "Ulysses: La oss presse på-vi nærmer oss oppskytningsstedet. Vi må sikre det før oppskytingen."

msgid "vo_sm_char19_m07_stg86_01"
msgstr "Ulysses: Kommandøren er nede! De nye kjøretøyene viser seg å være et skikkelig problem."

msgid "vo_sm_char19_m07_stg86_02"
msgstr "Ulysses: Vi undervurderte den greia. Hold fokus, kommandøren er snart tilbake."

msgid "vo_sm_char19_m07_stg87_01"
msgstr "Ulysses: Hovedkanonen på denne tanksen ser ut til å ha skadeforsterkende egenskaper."

msgid "vo_sm_char19_m07_stg87_01_01"
msgstr "Ulysses: Under visse forhold kan den levere eksepsjonell skade når den er riktig utplassert."

msgid "vo_sm_char19_m07_stg87_01_02"
msgstr "Ulysses: Akkurat det vi trenger mot de tunge enhetene."

msgid "vo_sm_char19_m07_stg87_02"
msgstr "Ulysses: Og se på bestykningen. Denne tanksens hovedkanon ser ut til å ha skadeforsterkende evner."

msgid "vo_sm_char19_m07_stg87_02_01"
msgstr "Ulysses: Under visse forhold kan den levere eksepsjonell skade når den er riktig utplassert."

msgid "vo_sm_char19_m07_stg87_02_02"
msgstr "Ulysses: Akkurat det vi trenger mot de tunge enhetene."

msgid "vo_sm_char19_m07_stg87_03"
msgstr "Ulysses: Denne tanksen har systemer for presisjonsmålangivelse."

msgid "vo_sm_char19_m07_stg87_03_01"
msgstr "Ulysses: Det virker som jo lenger du står stille, jo mer presise blir skuddene dine."

msgid "vo_sm_char19_m07_stg87_03_02"
msgstr "Ulysses: Perfekt til engasjementer på lang avstand."

msgid "vo_sm_char19_m07_stg87_04"
msgstr "Ulysses: Men det som er enda mer interessant er at denne tanksen har systemer for presisjonsmålangivelse."

msgid "vo_sm_char19_m07_stg87_04_01"
msgstr "Ulysses: Det virker som jo lenger du står stille, jo mer presise blir skuddene dine."

msgid "vo_sm_char19_m07_stg87_04_02"
msgstr "Ulysses: Perfekt til engasjementer på lang avstand."

msgid "vo_sm_char19_m07_stg87_05"
msgstr "Ulysses: Interessant: Denne har installert sekundærbestykning."

msgid "vo_sm_char19_m07_stg87_05_01"
msgstr "Ulysses: Du kan opprettholde undertrykkende ild mens hovedkanonen din lades om."

msgid "vo_sm_char19_m07_stg87_05_02"
msgstr "Ulysses: Taktisk fordel mot svak pansring."

msgid "vo_sm_char19_m07_stg87_06"
msgstr "Ulysses: Åh, stemmer. Én ting til. Denne har også sekundær bestykning installert."

msgid "vo_sm_char19_m07_stg87_06_01"
msgstr "Ulysses: Du kan opprettholde undertrykkende ild mens hovedkanonen din lades om."

msgid "vo_sm_char19_m07_stg87_06_02"
msgstr "Ulysses: Taktisk fordel mot svak pansring."

msgid "vo_sm_char19_m07_stg87_07"
msgstr "Ulysses: Dette kjøretøyet har noe uoriginalt utstyr. Dette er ikke vanlige modifikasjoner-"

msgid "vo_sm_char19_m07_stg87_07_01"
msgstr "Ulysses: de har laget noe spesielt her. Ta den med på en prøvetur, kommandør."

msgid "vo_sm_char19_m07_stg87_07_02"
msgstr "Ulysses: Finn ut hva denne teknologien kan gjøre."

msgid "vo_sm_char19_m07_stg87_08"
msgstr "Ulysses: Det er avansert teknologi integrert i systemene til denne tanksen."

msgid "vo_sm_char19_m07_stg87_08_01"
msgstr "Ulysses: Vi burde utnytte disse egenskapene til sitt fulle potensial."

msgid "vo_sm_char19_m07_stg87_08_02"
msgstr "Ulysses: Kommandør, eksperimenter med kontrollene-finn ut hva disse systemene virkelig kan gjøre i kamp."

msgid "vo_sm_char19_m07_stg87_09"
msgstr "Ulysses: Ingeniørarbeidet på denne prototypen er bemerkelsesverdig. Dette er ikke standard forbedringer for slagmarken-"

msgid "vo_sm_char19_m07_stg87_09_01"
msgstr "Ulysses: de er banebrytende. Prøv det, kommandør."

msgid "vo_sm_char19_m07_stg87_09_02"
msgstr "Ulysses: Press disse systemene til det ytterste og vis motstanderne våre hva deres egen teknologi kan gjøre."

msgid "vo_sm_char20_m07_stg15_04"
msgstr "Et av prototypkjøretøyene våre ble tatt av fienden. Identifiser mål nøye."

msgid "vo_sm_char20_m07_stg15_04_01"
msgstr "Kampfgruppe Berta og Dora, engasjer med forsiktighet. Forsink dem så mye som mulig."

msgid "vo_sm_char20_m07_stg15_05"
msgstr "Fiendtlige styrker nærmer seg fabrikken. Kampfgruppen Berta og Dora, engasjer."

msgid "vo_sm_char20_m07_stg15_05_01"
msgstr "Forsink dem så mye som mulig."

msgid "vo_sm_char20_m07_stg18_05"
msgstr "Hør etter, Team Zeppelin. Flytt til fabrikken. Ta defensive posisjoner og hold."

msgid "vo_sm_char20_m07_stg18_05_01"
msgstr "Jager, oppretthold ildkontroll over utgangene. Ikke la dem slippe ut fra anlegget."

msgid "vo_sm_char20_m07_stg21_01"
msgstr "Start Protocol Valkyrie. Alle enheter bekreft."

msgid "vo_sm_char20_m07_stg28_01"
msgstr "Alle enheter, ta defensive posisjoner. Adler-Gruppe engasjer."

msgid "vo_sm_char20_m07_stg29_01"
msgstr "Alle enheter. Engasjer fienden. Dobbel skuddpremie gis til de som eliminerer dem."

msgid "vo_sm_char20_m07_stg31_01"
msgstr "Hva i helvete?! Architect, vi er ikke klare! Jeg har fortsatt tanks i innslagssonen!"

msgid "vo_sm_char20_m07_stg31_01_01"
msgstr "Alle enheter, kom dere vekk fra oppskytningsplattformen-NÅ!"

msgid "vo_sm_char20_m07_stg31_02"
msgstr "Faen! Faen!"

msgid "vo_sm_char20_m07_stg31_03"
msgstr "Alle gjenværende enheter, kom dere vekk fra sprengningsradiusen! Dekk oppskytingen! Hold linjen!"

msgid "vo_sm_char20_m07_stg35_03"
msgstr "Alle gjenværende enheter-konverger mot kommandosentralen. Angrip fienden. Hold dem opptatt i kamp."

msgid "vo_sm_char20_m07_stg35_03_01"
msgstr "Hold defensive posisjoner inntil videre. Trekk dere tilbake til evakueringspunkter når kommandoen gis."

msgid "vo_sm_char20_m07_stg39_01"
msgstr "Jeg vet du kan høre meg. Jeg forventet ikke å møte slike motstandere."

msgid "vo_sm_char20_m07_stg39_01_01"
msgstr "Men nå har jeg studert taktikken din, evnene dine. Vårt neste møte blir ganske annerledes."

msgid "vo_sm_char20_m07_stg39_01_02"
msgstr "Ritter ut."

msgid "vo_sm_dday_intro"
msgstr "Ich habe eine Stunde lang mit diesem Karpfen gerungen!"

msgid "vo_sm_dday_intro_01"
msgstr "Hab ihn fast rausgeholt."

msgid "vo_sm_dday_intro_02"
msgstr "Er wog zwanzig Kilo."

msgid "vo_sm_dday_intro_03"
msgstr "Scheiße!"

msgid "vo_sm_dday_intro_04"
msgstr "Was? Du glaubst mir nicht?"

msgid "vo_sm_dday_intro_05"
msgstr "Scheiße!! ALARM!"

msgid "vo_sm_dday_intro_06"
msgstr "Panzer! Panzer!"

msgid "vo_sm_norway_intro_01"
msgstr "For fem dager siden mistet vi kontakten med et hemmelig militært romfartskompleks i Norskehavet."

msgid "vo_sm_norway_intro_02"
msgstr "Piloten i et rekognoseringsfly rapporterte spor etter kamper"

msgid "vo_sm_norway_intro_03"
msgstr "og delvis ødelagte industrielle bygninger på stedet."

msgid "vo_sm_norway_intro_04"
msgstr "Men aller viktigst rapporterte han om en rakett som sto klar for utskyting på rakettrampen,"

msgid "vo_sm_norway_intro_05"
msgstr "rett før vi mistet kommunikasjonen med ham også."

msgid "vo_sm_norway_intro_06"
msgstr "En innsatsgruppe ble sendt til stedet for å undersøke."

msgid "vo_sm_norway_outro_01"
msgstr "Det vi tolket som et våpen viste seg å være noe langt farligere."

msgid "vo_sm_norway_outro_02"
msgstr "Raketten sendte en kunstig satelitt ut i bane,"

msgid "vo_sm_norway_outro_03"
msgstr "som begynte å overføre hemmelig Reich dokumentasjon:"

msgid "vo_sm_norway_outro_04"
msgstr "Tegninger med avanserte teknologier"

msgid "vo_sm_norway_outro_05"
msgstr "og koordinater for hemmelige militærbaser med klargjorte våpenprototyper."

msgid "vo_sm_norway_outro_06"
msgstr "Mannen bake dette kaller seg selv for arkitetekten."

msgid "vo_sm_norway_outro_07"
msgstr "Motivene hans er ikke helt tydelige, men handlingene hans har allerede begynt å endre på verdensordenen."

msgid "vo_sm_norway_outro_08"
msgstr "For å møte denne trusselen trenger vi en styrke som er i stand til å forsvare verden fra forestående kaos."

msgid "vo_sm_vday_intro_01"
msgstr "Achtung! Achtung!\n(Obs! Obs!)"

msgid "vo_sm_vday_intro_01_01"
msgstr "Wir wenden uns an alle Soldaten und Offiziere der Wehrmacht, Luftwaffe und Kriegsmarine!\n(Dette er en melding til alle soldater og offiserer i Wehrmacht, Luftwaffe samt Kriegsmarine!)"

msgid "vo_sm_vday_intro_01_02"
msgstr "Das deutsche Oberkommando, hat die bedingungslose Kapitulation unterzeichnet.\n(Den tyske overkommandoen har skrevet under på en betingelsesløs overgivelse.)"

msgid "vo_sm_vday_intro_01_03"
msgstr "Der Krieg ist vorbei...\n(Krigen er over...)"

msgid "vo_sm_vday_intro_02"
msgstr "Wir rufen alle auf, die noch sinnlosen Widerstand leisten;\n(Vi kaller alle de som fremdeles byr på meningsløs motstand;)"

msgid "vo_sm_vday_intro_02_01"
msgstr "Ihre Waffen niederzulegen und sich den alliierten Truppen zu ergeben.\n(Til å legge ned våpnene og overgi seg til allierte tropper.)"

msgid "vo_sm_vday_intro_03"
msgstr "Ihr Leben wird für den Aufbau eines neuen, erneuerten Deutschlands benötigt werden...\n(Deres liv trengs til å bygge opp en nytt og fornyet Tyskland...)"

msgid "vo_sm_vday_intro_04"
msgstr "Das ist bloß ein Trick!\n(Dette er bare lureri.)"

msgid "vo_sm_vday_intro_04_01"
msgstr "Wir kämpfen weiter, bis wir vom Kommando einen Befehl erhalten!\n(Til vi får en ordre fra kommandoen, kommer vil til å fortsette å kjempe.)"
