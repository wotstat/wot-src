msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire pilot: Sikten er dårlig, kan ikke yte assistanse!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire pilot: For mye antiluftskyts (AA), kan ikke yte assistanse!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire pilot: Tung antiluftskyts (AA), ikke mulig å justere ildangivelse."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire pilot: Er som en snøstorm med flak her oppe, eh?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire pilot: Vi kan ikke justere ildangivelse for skipet i denne sperreilden."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire pilot: Vi må få tatt ut det antiluftskytset (AA) ved siden av bunkersene."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire pilot: Jeg klarte å fly litt lavere."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire pilot: Nå kan jeg begynne å tilkalle ildstøtte fra storkanonene ved hjelp av røyksignaler på bakken."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire pilot: Tanks, ditt trekk!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire pilot: Jeg ser røyken."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire pilot: Videresender koordinater til slagskipet for et direkte treff."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire pilot: Pokker, ene flyet vårt går ned! Kan fremdeles ikke fly noe lavere."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire pilot: Vi er nødt til å få tatt ut enda et antiluftskyts (AA) nå!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire pilot: Antiluftskyts (AA) kanoner tatt ut, jeg flyr lavere. Klar til å dirigere inn tettere ildgivning fra slagskipet vårt."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire pilot: Viktig melding! Stor gruppe fiender sett på vei mot deg."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire pilot: De kaster inn alt de har."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire pilot: Pass på, det er en nye gruppe fiender som nærmer seg deg. Hold fokus der nede."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire pilot: Advarsel, den siste og største bølgen med fiender er innkommende."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire pilot: De nærmer seg fra alle sidene. Gjør dere klare."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire pilot: Fått direkte sikt til røyksignalet. Koordinater blir sendt til slagskipet."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire pilot: Ah, der er røykmarkøren vår. Jeg videresender lokasjonen til slagskipet."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire pilot: Røyken viser målet. Sender nøyaktige koordinater til slagskipet."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire pilot: Jeg ser røyken, later til at vår venn trenger litt hjelp."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "Kommandør på USS Frankford: Venter på koordinater for ildstøtte."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "Kommandør på USS Frankford: Å skyte i blinde er risikabelt, kan treffe våre egne."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "Kommandør på USS Frankford: Må ha presise koordinater på mål, holder tilbake ilden for nå."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "Kommandør på USS Frankford: Dette er kommandøren på USS Frankford. Avslås."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "Kommandør på USS Frankford: Kan ikke støtte fremrykking. Dårlig sikt."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "Kommandør på USS Frankford: Kan ikke se klipper og bunkers, bare våre tanks på strendene er synlige."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "Kommandør på USS Frankford: Ser tanks som rykker frem mot klippene."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "Kommandør på USS Frankford: Vi støtter med ildgivning i den retningen."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "Kommandør på USS Frankford: Håper denne Shermanen vet hvor han skyter."

msgid "vo_sm_char09_m05_stg06_01"
msgstr "Kommandør på USS Frankford: Shermanen har byttet mål. Vi justerer tilsvarende."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "Kommandør på USS Frankford: Ildgivning fra Sherman har opphørt. Jobben er gjort her."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "Kommandør på USS Frankford: Vi rekker ikke frem til bunkersene lenger inn på land."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "Kommandør på USS Frankford: Trekker oss tilbake til trygg avstand nå. Lykke til på land."

