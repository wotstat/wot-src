msgid "vo_sm_char10_m05_stg21_02"
msgstr "Offisér på HK: Brohode Echo-5 på stranden er sikret. Tanks rykker frem. Gi full ildstøtte."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Offisér på HK: Omdirigér luftstøtte for å assistere fremrykkende tanks."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Offisér på HK: Ingeniørstyrker, klarér hindringer for videre fremrykking."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Offisér på HK: Strand klarert. Sender hovedstyrkene. Utmerket arbeid."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Offisér på HK: Forsvar din posisjon. Forsterkninger er underveis."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Offisér på HK: Beskytt brohodet på stranden for enhver pris."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Offisér på HK: Enda en tanks, enda en sjanse. Vær forsiktig denne gangen."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Offisér på HK: Vi har lite reserver. Få denne til å telle, kommandør."

