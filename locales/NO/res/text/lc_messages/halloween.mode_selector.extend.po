msgid "mode/halloween/battlePassTooltip/body"
msgstr "Visse oppdrag i eventet {whiteSpanish_open}Babylon: Dark Tower{whiteSpanish_close} vil la deg få tjene poeng til Battle Pass."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Battle Pass poeng"

msgid "mode/halloween/calendar"
msgstr "Eventet vil vare i %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Eventet avsluttes om %(date)s."

msgid "mode/halloween/description"
msgstr "Kjemp og samle inn materie.\nKamper i spesialkjøretøy."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Ytelsen på din datamaskin er ikke god nok for denne modusen. Det kan hende du vil oppleve feil på grafikk og kjøretøybevegelser. Det er også mulig at spillklienten vil krasje."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Lav ytelse"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Lav ytelse"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Denne modusen krever høy ytelse fra datamaskinen.\nDu vil oppleve problemer med kartvisning, grafikk og kjøretøybevegelser. I tilfelle utilstrekkelig ytelse, prøv lavere grafikkinnstillinger."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Redusert ytelse"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Redusert ytelse"
