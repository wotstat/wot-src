msgid "LS_aoeDamageInstantShot/always"
msgstr "?empty?"

msgid "LS_aoeDamageInstantShot/descr"
msgstr "Avfyrer et skudd som skader målet og fiendtlige kjøretøy som er nærme."

msgid "LS_aoeDamageInstantShot/long_special"
msgstr "Taktisk enhet. Avfyrer et skudd som skader målet og alle fiendtlige kjøretøy innenfor en radius på 35 m. Hvis den brukes minst én gang i en kamp, er enheten brukt og kan etterfylles for credits. Hvis den ikke brukes, er ingen etterfylling nødvendig.<br/><br/>Kun tilgjengelig under <font color='#cbac77'>Last Stand: Terra Nord</font> eventet.<br/><br/>Alle ubrukte enheter blir fjernet og kompensert i credits tilsvarende 50 % av kostnaden i neste oppdatering."

msgid "LS_aoeDamageInstantShot/name"
msgstr "Energiskudd"

msgid "LS_aoeDamageInstantShot/onUse"
msgstr "Avfyrer et skudd som skader målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "LS_aoeDamageInstantShot/restriction"
msgstr "?empty?"

