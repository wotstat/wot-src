msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Begynn en tilfeldig kamp i et kjøretøy på et hvilket som helst nivå."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Velkommen til spillet! Kjemp med andre fans fra hele verden og feire utrolige seiere!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Første kamp"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Utvikle og kjøp et kjøretøy på nivå 4."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Å kjøpe et nytt kjøretøy er viktig. For hvert nye nivå blir kjøretøyene mer interessante. En trent besetning vil også forbedre resultatet av spillingen."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Kjøretøy på nivå 4"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Kjemp i tre tilfeldige kamper i kjøretøy på nivå 4–10 med et påsatt tilpasningselement."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Du kan tilpasse kjøretøy ved å endre eksteriører med ferdiglagde stiler eller ved å lage din egen stil med kamuflasje, inskripsjoner, emblemer og dekaler."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Eksteriør på kjøretøy"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Begynn å trene en hvilken som helst fordel til et hvilket som helst besetningsmedlem."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Besetningsmedlemmer kan trene flere fordeler for  forsterke sin effektivitet eller oppnå nye ferdigheter."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Besetningsfordeler"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Tjen 150 000 credits i tilfeldige kamper i kjøretøy på nivå 4–10."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Jo høyere kampnivå, jo mer credits trenger du for å vedlikeholde kjøretøyet ditt, etterforsyne ammunisjon og kjøpe moduler og utstyr."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Akkumulering av credits"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Utvikle og kjøp et hvilket som helst kjøretøy på nivå 5."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "På nivå 5 begynner de mer seriøse kjøretøyene å komme og dine spilleferdigheter blir satt ordentlig på prøve. En trent besetning vil virkelig utgjøre en forskjell."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Kjøretøy på nivå 5"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Kjemp i 10 tilfeldige kamper i kjøretøy på nivå 5–10 med tre utstyrsenheter påmontert."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Forbedret optikk eller forbedret ventilasjon? Det riktige utstyret kan booste ditt kjøretøys sterke sider og redusere dens svakheter."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Montering av utstyr"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Fullfør ett basisscenario i topografimodusen."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "For å få selvtillit på slagmarken er det best å ha en god forståelse av stier, taktikk og kart, inkludert nøkkelposisjonene og objekter på dem."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topografi"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Fullfør fire avanserte scenarioer på et kart i topografi."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Gå til topografimodusen fra tid til annen for å studere kart i tilfeldige kamper. De fire scenarioene gjør at du kan utforske stedet fra ulike retninger."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Avansert topografi"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Kjemp 10 tilfeldige kamper i kjøretøy på nivå 5-10 med en aktivert personlig reserve."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Når aktivert kan du få ytterligere bonuser på erfaringspoeng, besetnings- og fri erfaring eller credits etter hver kamp."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Personlige reserver"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Bli blant de 10 beste spillerne på laget ditt basert på erfaringspoeng seks ganger i tilfeldige seierskamper i kjøretøy på nivå 5-10."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Disse oppdragene gir deg fem ganger mer erfaringspoeng per seierskamp. Da må du vinne og bli blant de 10 beste spillerne på laget ditt etter erfaringspoeng."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 oppdrag m. ×5 erfaringspoeng"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Utvikle en modul på et kjøretøy på et hvilket som helst nivå, og monter modulen på kjøretøyet."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Erfaringspoeng tildeles etter hver kamp. Tjen erfaringspoeng for å kunne utvikle nye moduler som forbedrer effektiviteten på ditt kjøretøy."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Erfaringspoeng"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Utvikle og kjøp et hvilket som helst kjøretøy på nivå 6."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "På hvert påfølgende nivå vil utvikling av kjøretøy kreve mer tid og innsats. Fri erfaring vil hjelpe deg og en trent besetning vil komme godt med."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Nivå 6 kjøretøy"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Fullfør ett personlig oppdrag i en hvilken som helst kampanje."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampanjer er serier med oppdrag til ulike typer kjøretøy. Når de fullføres får du nyttige belønninger og unike kjøretøy."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Personlige oppdrag"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Tren en besetning med en universell manual."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Besetningsbøker lar deg få raskere besetningstrening ved å legge til en bestemt mengde erfaringspoeng til en eller alle besetningsmedlemmene."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Besetningsbøker"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Kjemp 10 tilfeldige kamper i kjøretøy på nivå 6-10 utstyrt med et besetningsdirektiv."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Direktiver kan forbedre besetningsferdigheter i én kamp. Akkurat som forbruksmateriell, kan direktiver kjøpes eller fås som belønning."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Direktiver til besetningen"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Kjøp en spesiell Nybegynnerpakke i butikken."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Du kan kjøpe alt du trenger i butikken i spillet, inkludert gull, premiumkjøretøy og mer. Du vil ofte se reklame som byr på gode tilbud."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Butikk"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Kjemp 10 tilfeldige kamper i premiumkjøretøy på nivå 6-10."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Disse kjøretøyene trenger ikke å utvikles. De tjener inn mer erfaringspoeng, besetningserfaring og credits, og lar deg overføre en besetning uten omskolering."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premiumkjøretøy"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Kjemp 10 tilfeldige kamper i kjøretøy på nivå 6-10 utstyrt med et utstyrsdirektiv."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Direktiver gjør at du får økt effektivitet fra påmontert utstyr. Akkurat som forbruksmateriell kan direktiver kjøpes eller fås som belønninger."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Direktiver for utstyr"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Bli blant de 10 beste spillerne på laget ditt basert på erfaringspoeng 15 ganger i tilfeldige kamper i kjøretøy på nivå 6-10."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Disse oppdragene gir deg fem ganger mer erfaringspoeng per seierskamp. Da må du vinne og bli blant de 10 beste spillerne på laget ditt etter erfaringspoeng."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 oppdrag med ×5 erfaringspoeng"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Utvikle og kjøp et hvilket som helst kjøretøy på nivå 7."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "For dette kjøretøysnivået øker ferdighetskravet enda mer. Kjøretøy blir mer formidable og effektive—akkurat som motstanderne dine."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Kjøretøy på nivå 7"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Kjemp 10 tilfeldige kamper i kjøretøy på nivå 7–10 med et stort førstehjelpssett, stort reparasjonssett og automatisk brannslukker."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Når ferdig utstyrt reparerer stort forbruksmateriell skadde moduler raskere enn de mindre. De reduserer også sjokkvarigheten og brannfaren, og har en kortere nedkjølingstid."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Store forbruksmateriell"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Få dobbelt så mye erfaringspoeng for dagens første seier i tilfeldige kamper i et kjøretøy på et hvilket som helst nivå."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Du kan få doble erfaringspoeng for dagens første seier i hvert kjøretøy. Benytt deg av denne muligheten til å oppgradere kjøretøyene dine enda raskere."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Erfaringsmultiplikator"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Opprett en tegningsdel til et hvilket som helst kjøretøy som ikke er utviklet."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Tegninger gir en rabatt på erfaringspoeng og lar deg utvikle et kjøretøy raskere. Fås som belønning eller konverteres fra universale og nasjonale tegningsdeler."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Kjøretøytegninger"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Bli blant de 10 beste spillerne på laget ditt basert på erfaringspoeng 20 ganger i tilfeldige kamper i kjøretøy på nivå 7-10."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Disse oppdragene gir deg fem ganger mer erfaringspoeng per seierskamp. Da må du vinne og bli blant de 10 beste spillerne på laget ditt etter erfaringspoeng."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 oppdrag med ×5 erfaringspoeng"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Utvikle og kjøp et hvilket som helst kjøretøy på nivå 8."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Kjøretøy på nivå 8 krever at du benytter all din kunnskap. Fiender vil ikke la deg kjede deg, og det vil gi høyoktan spenning og uvurderlig erfaring."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Nivå 8 kjøretøy"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Bruk fri erfaring til å utvikle en hvilken som helst modul."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Dersom du ikke har nok erfaringspoeng til å utvikle en modul eller et kjøretøy, kan du bruke fri erfaring som kan benyttes til et hvilket som helst kjøretøy."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Fri erfaring"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Fyll på med alternative granater og begynn en tilfeldig kamp i et kjøretøy på nivå 3–10."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Panserpenetrerende (AP), høyeksplosiv (HE) og panserpenetrerende komposittgranater (APCR) brukes i ulike situasjoner i kamp. Velg med omhu for å få en fordel!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Ammunisjon"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Selg en ubrukt modul fra depotet."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Ubenyttede moduler, granater, utstyr, forbruksmateriell og andre ting er lagret i depotet. Du kan selge overskuddsting for credits."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Depotet"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Tjen 25 000 credits i tilfeldige kamper i kjøretøy på nivå 3-10."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Credits brukes til å kjøpe granater og nye kjøretøy, reparere kjøretøy og mer. Det er viktig å vite hvordan man kan spare og bruke dem klokt."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Credits"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Kjemp i tre tilfeldige kamper i kjøretøy på nivå 3–10 med forbruksmateriell montert i alle de tilgjengelige plassholderne."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Forbruksmateriell kan reparere kritisk kjøretøyskade og helbrede skadde besetningsmedlemmer i kamp. Å benytte forbruksmateriell er kritisk for å kunne overleve."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Forbruksmateriell"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Kjemp tre tilfeldige kamper i et kjøretøy på nivå 3–10 med et hvilket som helst påmontert utstyr."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Kjøretøy kan utstyres med utstyr for å forbedre noen av karakteristikaene. Utstyrets plassering vil avhenge av kjøretøyet og spillestilen."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Utstyr"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Fullfør et scenario på et hvilket som helst kart i Topografi"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Fullfør fire grunnleggende scenarioer på et kart i Topografi"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Rekognosering"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Fullfør fire avanserte scenarioer på et kart i topografi"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Karakteren A i geografi"
