msgid "battleship/name"
msgstr "Røyksignal"

msgid "battleship/shortDescr"
msgstr "Et røyksignal som markerer stedet for en artillerisalve fra et slagskip som forårsaker skade på fiendtlig utstyr og gjenstander som befinner seg der."

msgid "distraction_ability/name"
msgstr "Falsk ordre"

msgid "distraction_ability/shortDescr"
msgstr "Få Gefr. Keller til å bruke den erobrede tyske radioen til å sende ut en falsk ordre, der fienden blir sendt for å undersøke en spesifikk lokasjon."

msgid "recon_ability/name"
msgstr "Speid området"

msgid "recon_ability/shortDescr"
msgstr "Send kaptein Dubois på rekognosering til en spesifikk lokasjon. Mens han er på rekognoseringen stanser tanksen og forblir stasjonær. Evnen fortsetter å fungere frem til den blir avbrutt."

msgid "scc_airstrike_ability/name"
msgstr "Luftstøtte"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Kall inn luftstøtte mot en designert posisjon."
