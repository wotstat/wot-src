msgid "entryPoint/tooltip/description"
msgstr "Dette er spesialesker som inneholder nye og unike enheter. De kan fås fra butikken i spillet."

msgid "entryPoint/tooltip/timerText"
msgstr "Eventet avsluttes om"

msgid "eventName/lowerCase"
msgstr "VAULT OF WHISPERS"

msgid "eventName/upperCase"
msgstr "VAULT OF WHISPERS"

msgid "guaranteed/tooltip/description1/"
msgstr "Dersom alle kjøretøy allerede eies, får du en velsignelseseske i stedet."

msgid "infoPage/footer/description/compensation"
msgstr "Dersom du allerede eier alle kjøretøyene fra eskene får du en valgt velsignelseseske i belønning i stedet for et kjøretøy."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hvert %(guaranteed0)s. utbytte, %(guaranteed1)s. tildeling, og %(guaranteed2)s. valgte velsignelseseske garanteres å inneholde et kjøretøy. Dersom du åpner dem uten at et slikt kjøretøy blir sluppet, så vil et kjøretøy som du ikke har fra før bli sluppet når du åpner den %(guaranteed0)s./%(guaranteed1)s./%(guaranteed2)s. esken (avhengig av type eske). Når den så slipper et kjøretøy, nullstilles telleren."

msgid "infoPage/footer/title/compensation"
msgstr "Kompensasjon"

msgid "infoPage/footer/title/guaranteed"
msgstr "Garantert belønning"

msgid "infoPage/header/rewards/description"
msgstr "Ikke mer en én belønning per gruppe kan bli sluppet"
