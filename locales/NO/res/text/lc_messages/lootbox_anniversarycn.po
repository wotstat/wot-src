msgid "boxTooltip/description/text/bronze"
msgstr "Når de blir åpnet kan disse eskene gi deg premiumkjøretøy på nivå 8, valuta til bruk i spillet og andre verdifulle belønninger."

msgid "boxTooltip/description/text/gold"
msgstr "Når de blir åpnet kan disse eskene gi deg sjeldne kjøretøy på nivå 10, valuta til bruk i spillet og andre verdifulle belønninger."

msgid "boxTooltip/description/text/silver"
msgstr "Når de blir åpnet kan disse eskene gi deg premiumkjøretøy på nivå 9, valuta til bruk i spillet og andre verdifulle belønninger."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Kan får som gave for kjøpe av enheter i Premium Shop i tillegg til at de kan fås når man åpner esker av en hvilkens om helst annen type."

msgid "boxTooltip/howGet/text/gold"
msgstr "Kan fås mens man åpner esker av en hvilken som helst annen type."

msgid "boxTooltip/howGet/text/silver"
msgstr "Kan fås mens man åpner esker av en hvilken som helst annen type."

