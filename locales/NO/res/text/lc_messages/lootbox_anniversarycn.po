msgid "boxTooltip/description/text/bronze"
msgstr "Når de åpnes kan disse eskene gi deg kjøretøy, valuta til bruk i spillet og andre verdifulle belønninger."

msgid "boxTooltip/description/text/gold"
msgstr "Når de åpnes kan disse eskene gi deg kjøretøy, valuta til bruk i spillet, tilpasningselementer og andre verdifulle belønninger."

msgid "boxTooltip/description/text/silver"
msgstr "Når de åpnes kan disse eskene gi deg kjøretøy, valuta til bruk i spillet, tilpasningselementer og andre verdifulle belønninger."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Kan fås i butikken i spillet og når man åpner esker av en hvilken som helst type."

msgid "boxTooltip/howGet/text/gold"
msgstr "Kan fås mens man åpner esker av en hvilken som helst annen type."

msgid "boxTooltip/howGet/text/silver"
msgstr "Kan fås mens man åpner esker av en hvilken som helst annen type."

