msgstr "En av snøjomfruene og maskotten for julesamlingen. Tildelt under &nbsp;Høytidsoperasjoner&nbsp;2020."

msgid "tankman/lore/ny20_girl_Fairytale"
msgstr "En av snøjomfruene og maskotten for den magiske samlingen. Tildelt under &nbsp;Høytidsoperasjoner&nbsp;2020."

msgid "tankman/lore/ny20_girl_NewYear"
