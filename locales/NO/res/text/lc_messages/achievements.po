msgid "scout_descr"
msgstr "Oppdag minst 9 fiendtlige kjøretøy."

msgid "se12019Medal"
msgstr "Holding the Line"

msgid "se12019Medal_condition"
msgstr "• Tildelt alle spillere som oppfylte de respektive vilkårene i løpet av eventet."

msgid "se12019Medal_descr"
msgstr "Vinn 10 kamper i løpet av Homefront eventet."

