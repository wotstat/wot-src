msgstr "Bonusen på besetningseffektivitet økes (når alliert med samme type kjøretøy er nærme)."

msgid "radioman_sideBySide/maxLvlDescription"
msgstr "Når den er ferdigtrent økes {yellow_Start}bonus på besetningseffektivitet{yellow_End} med %(crewLevelIncrease)s ved avstander på mindre enn 50 m fra et alliert kjøretøy av samme type&zwnbsp;."

