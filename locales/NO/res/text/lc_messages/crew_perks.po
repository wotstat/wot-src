msgid "armorPatching/alt/description"
msgstr "Å ta skade avbryter gjenopprettingen helsepoeng helsepoeng.\n\nGjenopprettingshastigheten og grense for maksimal gjenoppretting er basert på kjøretøyets totale mengde helsepoeng, inkludert alle påsatte modifikatorer."

msgid "armorPatching/alt/info"
msgstr "Gruppefordeler beregnes fra det gjennomsnittlige treningsnivået for hele besetningen. Den trer i effekt når den er blitt trent til minst 1% og effektiviteten øker med mer trening."

msgid "armorPatching/currentLvlDescription"
msgstr "Bruk av et reparasjonssett gjenoppretter %(hpRecover)s av kjøretøyets {yellow_Start}helsepoeng{yellow_End} i løpet av 5 sekunder, opp til maksimalt 20% per kamp. Tillater bruk av reparasjonssett uten kritisk skade."

msgid "armorPatching/hudDescription"
msgstr "Helsepoeng gjenopprettes."

msgid "armorPatching/maxLvlDescription"
msgstr "Når den er fulltrent for alle besetningsmedlemmer, gjenoppretter den %(hpRecover)s av kjøretøyets {yellow_Start}helsepoeng{yellow_End} i løpet av 5 s etter bruk av et reparasjonssett, opp til maksimum 20% per kamp. Tillater bruk av reparasjonssett uten kritisk skade."

msgid "armorPatching/name"
msgstr "Lapping av pansring"

msgid "armorPatching/shortDescription"
msgstr "@ Øker basis skjuleevne for kjøretøy."

msgid "brotherhood/alt/description"
msgstr "Bonusen på besetningseffektivitet forbedrer besetningsmedlemmets effektivitet i kamp, i tillegg til effektiviteten for alle deres lærte fordeler, bortsett fra denne. Denne parameteren kan økes ytterligere ved å montere på utstyr eller forbruksmateriell med lik effekt, eller ved å benytte direktivet for ventilasjonsutblåsning. Kommandørens nødpakke, i tillegg til radiooperatørens fordeler side ved side og kommunikasjonsekspert, kan også øke parameteren."

msgid "brotherhood/alt/info"
msgstr "Gruppefordeler beregnes fra det gjennomsnittlige treningsnivået for hele besetningen. Den trer i effekt når den er blitt trent til minst 1% og effektiviteten øker med mer trening."

msgid "brotherhood/currentLvlDescription"
msgstr "{greenBright_Start}Bonusen på besetningseffektivitet{greenBright_End} for hele besetningen øker med %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/maxLvlDescription"
msgstr "Når den er ferdig trent for alle besetningsmedlemmer, økes {greenBright_Start}bonusen på besetningens effektivitet{greenBright_End} med %(crewLevelIncrease)s&zwnbsp;."

msgid "brotherhood/name"
msgstr "Våpenbrødre"

msgid "brotherhood/shortDescription"
msgstr "Øker besetningens generelle ytelse."

msgid "camouflage/alt/description"
msgstr "Denne fordelen påvirker skjuleevnen til kjøretøyet. Den kan bli ytterligere forbedret med direktivet naturlig dekke.\n\nI tillegg kan kjøretøyets skjuleevne økes ved å sette på et kamuflasjemønster eller en stil, i tillegg til å montere på utstyr med liknende effekt."

msgid "camouflage/alt/info"
msgstr "Gruppefordeler beregnes fra det gjennomsnittlige treningsnivået for hele besetningen. Den trer i effekt når den er blitt trent til minst 1% og effektiviteten øker med mer trening."

msgid "camouflage/currentLvlDescription"
msgstr "Kjøretøyets {greenBright_Start}skjuleevne{greenBright_End} er økt med %(maskingFactor)s&zwnbsp;."

msgid "camouflage/maxLvlDescription"
msgstr "Når den er ferdigtrent for alle besetningsmedlemmene, økes kjøretøyets {greenBright_Start}skjuleevne{greenBright_End} med %(maskingFactor)s&zwnbsp;."

msgid "camouflage/name"
msgstr "Skjuleevne"

msgid "camouflage/shortDescription"
msgstr "Øker basis skjuleevne for kjøretøy."

msgid "commander_coordination/alt/description"
msgstr "Effekten aktiveres hver gang et fiendtlig kjøretøy oppdages og økes ikke ved oppdagelse av flere fiendtlige kjøretøy samtidig.\n\nSiktehastighet kan økes ytterligere ved å trene skytterens rask siktetid fordel, eller ved å montere utstyr med liknende effekt."

msgid "commander_coordination/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "commander_coordination/currentLvlDescription"
msgstr "{yellow_Start}Siktehastighet{yellow_End} bedres med %(vehicleGunAimSpeed)s i 15 s etter at du oppdager et fiendtlig kjøretøy."

msgid "commander_coordination/hudDescription"
msgstr "Siktehastighet er bedre."

msgid "commander_coordination/maxLvlDescription"
msgstr "Når den er ferdigtrent, bedres {yellow_Start}siktehastighet{yellow_End} med %(vehicleGunAimSpeed)s i 15 s etter at du oppdager et fiendtlig kjøretøy.\t"

msgid "commander_coordination/name"
msgstr "Koordinering"

msgid "commander_coordination/shortDescription"
msgstr "Siktehastighet er bedre."

msgid "commander_eagleEye/alt/description"
msgstr "Synsrekkevidde kan økes ytterligere ved å trene opp radiooperatørens fordel situasjonsnærvær eller ved å montere utstyr med liknende effekt. Bruk av direktivet optisk kalibrering forbedrer effekten."

msgid "commander_eagleEye/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "commander_eagleEye/currentLvlDescription"
msgstr "{greenBright_Start}Synsrekkevidden{greenBright_End} er økt med %(circularVisionRadius)s&zwnbsp;. {greenBright_Start}Virkningen av ødelagte obervasjonsenheter{greenBright_End} gir reduksjon på %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/hudDescription"
msgstr "Ødelagte obervasjonsenheter gir reduksjon i observasjonsevne."

msgid "commander_eagleEye/maxLvlDescription"
msgstr "Når den er ferdigtrent, økes {greenBright_Start}synsrekkevidden{greenBright_End} med %(circularVisionRadius)s&zwnbsp; og reduserer {greenBright_Start}virkningen av skadde observasjonsenheter {greenBright_End} med %(penaltyToDamagedSurveyingDevice)s&zwnbsp;."

msgid "commander_eagleEye/name"
msgstr "Rekognosering"

msgid "commander_eagleEye/shortDescription"
msgstr "Øker synsrekkevidden, spesielt når observasjonsenheter er skadd."

msgid "commander_emergency/alt/description"
msgstr "Når man får gjentatte skader fra fiender, blir ikke effekten økt. Bonusen på besetningseffektiviteten forbedrer kampevne. Denne parameteren kan økes ytterligere ved å montere utstyr eller forbruksmateriell med liknende effekt, eller ved å benytte direktivet ventilasjonsutblåsning. Gruppefordelen våpenbrødre, i tillegg til radiooperatørens ferdigheter side ved side og kommunikasjonsekspert, kan også øke parameteren."

msgid "commander_emergency/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "commander_emergency/currentLvlDescription"
msgstr "{yellow_Start}Effektivtetsbonusen for besetningen{yellow_End} blir økt med %(crewLevelIncrease)s i 15 s etter å ha mottatt skade fra en fiende."

msgid "commander_emergency/hudDescription"
msgstr "Bonusen på besetningseffektiviteten økes."

msgid "commander_emergency/maxLvlDescription"
msgstr "Når den er ferdigtrent øker {yellow_Start}effektivtetsbonusen for besetningen{yellow_End} med %(crewLevelIncrease)s i 15 s etter å ha mottatt skade fra en fiende."

msgid "commander_emergency/name"
msgstr "Nødstilfelle"

msgid "commander_emergency/shortDescription"
msgstr "Bonusen på besetningseffektiviteten økes."

msgid "commander_enemyShotPredictor/alt/description"
msgstr "Et varsel om fiendtlig ild fra SPG aktiveres med en liten forsinkelse etter at det har blitt skutt.\n\nFordelen kan forbedres med direktivet alarmberedskap."

msgid "commander_enemyShotPredictor/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "commander_enemyShotPredictor/currentLvlDescription"
msgstr "En {yellow_Start}varsling om fiendtlig ild fra SPG{yellow_End} og fra hvilken retning skuddet kommer, med en forsinkelse på %(artNotificationDelayFactor)s. Den {greenBright_Start}negative effekten av sjokk{greenBright_End} reduseres med %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/maxLvlDescription"
msgstr "Når den er ferdigtrent, viser den en {yellow_Start}varsling om fiendtlig ild fra SPGer{yellow_End} med en forsinkelse på %(artNotificationDelayFactor)s og hvilken retning skuddet kommer fra. Reduserer den {greenBright_Start}negative sjokkeffekten{greenBright_End} med %(stunResistanceEffectFactor)s&zwnbsp;."

msgid "commander_enemyShotPredictor/name"
msgstr "Lydoppdagelse"

msgid "commander_enemyShotPredictor/shortDescription"
msgstr "Indikerer et fiendtlig SPG skudd."

msgid "commander_holdLine/alt/description"
msgstr "Mannskapets effektivitetsbonus forbedrer mannskapsmedlemmets effektivitet i kamp.\n\nDenne parameteren kan ytterligere økes ved å montere utstyr eller forbruksmateriell med lignende effekt, eller ved å bruke direktivet ventilasjonsutblåsning. Ulike andre mannskapsfordeler kan også øke parameteren."

msgid "commander_holdLine/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "commander_holdLine/currentLvlDescription"
msgstr "{yellow_Start}Bonusen for besetningseffektivitet{yellow_End} vil øke med %(crewLevelIncrease)s så lenge fiendens lag har minst tre flere kjøretøy i kamp enn ditt&zwnbsp;."

msgid "commander_holdLine/hudDescription"
msgstr "Bonusen for besetningseffektivitet økes (når fienden er i overtall)."

msgid "commander_holdLine/maxLvlDescription"
msgstr "Når den er ferdigtrent, øker den {yellow_Start}besetningens effektivitetsbonus{yellow_End} med %(crewLevelIncrease)s når fiendens lag har minst tre flere kjøretøy i kamp enn ditt&zwnbsp;."

msgid "commander_holdLine/name"
msgstr "Hold linjen"

msgid "commander_holdLine/shortDescription"
msgstr "@ Øker besetningseffektivitetsbonus"

msgid "commander_practical/alt/description"
msgstr "Fordelen virker på alle typer utstyr som er montert på kjøretøyet ditt.\n\nDens effekt kan forbedres ytterligere ved at du benytter direktivet grundige forberedelser."

msgid "commander_practical/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "commander_practical/currentLvlDescription"
msgstr "{greenBright_Start}Nedkjølingstid for forbruksmateriell{greenBright_End} reduseres med %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/maxLvlDescription"
msgstr "Når den er ferdigtrent, reduseres {greenBright_Start}nedkjølingstiden på forbruksmateriellet{greenBright_End} som er montert på ditt kjøretøy med %(equipmentPreparationTime)s&zwnbsp;."

msgid "commander_practical/name"
msgstr "Praktiskhet"

msgid "commander_practical/shortDescription"
msgstr "Reduserer nedkjølingstiden på forbruksmateriell."

msgid "commander_sixthSense/alt/description"
msgstr "Sjette sans fungerer ikke så lenge kommandøren er skadd. Dens aktiveringstid kan reduseres med radiooperatørens fordel signalforsterker."

msgid "commander_sixthSense/alt/info"
msgstr "Det er en spesiell egenskap for kommandøren som ikke krever trening og er tilgjengelig for kommandøren i utgangspunktet."

msgid "commander_sixthSense/currentLvlDescription"
msgstr "Gjør at kommandøren legger merke til om kjøretøyet har blitt oppdaget av fienden. Aktiveres %(delay)s etter at kjøretøyet ditt har blitt oppdaget."

msgid "commander_sixthSense/name"
msgstr "Sjette sans"

msgid "commander_sixthSense/shortDescription"
msgstr "Lar kommandøren få vite om kjøretøyet har blitt oppdaget av fienden."

msgid "commander_staySharp/alt/description"
msgstr "Mannskapets effektivitetsbonus forbedrer mannskapsmedlemmets effektivitet i kamp.\n\nDenne parameteren kan ytterligere økes ved å montere utstyr eller forbruksmateriell med lignende effekt, eller ved å bruke direktivet ventilasjonsutblåsning. Ulike andre mannskapsfordeler kan også øke parameteren."

msgid "commander_staySharp/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "commander_staySharp/currentLvlDescription"
msgstr "{yellow_Start} Mannskapseffektivitetsbonusen {yellow_End} øker med %(crewLevelIncrease)s i 15&nbsp;s etter bruk av et førstehjelpssett. Lar et førstehjelpssett brukes selv om ingen besetningsmedlemmer er skadet&zwnbsp;."

msgid "commander_staySharp/hudDescription"
msgstr "Bonusen på besetningseffektivitet er økt (Førstehjelpssett ble brukt)."

msgid "commander_staySharp/maxLvlDescription"
msgstr "Når den er ferdigtrent, øker den {yellow_Start}besetningens effektivitetsbonus{yellow_End} med %(crewLevelIncrease)s i 15 s etter bruk av et førstehjelpssett. Lar et førstehjelpssett brukes selv om ingen besetningsmedlemmer er skadet&zwnbsp;."

msgid "commander_staySharp/name"
msgstr "Hold fokus"

msgid "commander_staySharp/shortDescription"
msgstr "@ Øker besetningseffektivitetsbonus"

msgid "commander_tutor/alt/description"
msgstr "En skadd kommandør kan ikke erstatte et annet besetningsmedlem. Bonusen gjelder kun mengden basis besetningserfaring tjent i kamp.\n\nYtterligere besetningserfaring kan fås ved å benytte besetningsbøker eller ved å konvertere fri erfaring til besetningserfaring."

msgid "commander_tutor/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "commander_tutor/currentLvlDescription"
msgstr "Mengden {greenBright_Start}erfaringspoeng{greenBright_End} tjent øker med %(xpBonusFactorPerLevel)s for alle besetningsmedlemmer. Kommandøren kan {greenBright_Start}ta rollen til besetningsmedlemmer som er slått ut{greenBright_End} med en effektivitet på %(woundedCrewEfficiency)s."

msgid "commander_tutor/hudDescription"
msgstr "Besetningsmedlemmer som er slått ut kan erstattes av kommandøren."

msgid "commander_tutor/maxLvlDescription"
msgstr "Når fordelen er ferdigtrent øker mengden {greenBright_Start}erfaringspoeng{greenBright_End} som tjenes med %(xpBonusFactorPerLevel)s for alle besetningsmedlemmer. Kommandøren kan {greenBright_Start}ta rollen til besetningsmedlemmer som er slått ut{greenBright_End} med en effektivitet på %(woundedCrewEfficiency)s."

msgid "commander_tutor/name"
msgstr "Læremester"

msgid "commander_tutor/shortDescription"
msgstr "Besetningsmedlemmer som er slått ut kan erstattes av kommandøren."

msgid "commander_universalist/alt/description"
msgstr "Kommandøren kan kun erstatte hovedkvalifikasjonen til hvert av de utslåtte besetningsmedlemmene. Effekten på erstatningen reduseres for hvert besetningsmedlem som er slått ut."

msgid "commander_universalist/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "commander_universalist/currentLvlDescription"
msgstr "Kommandøren kan {greenBright_Start}erstatte utslåtte{greenBright_End} besetningsmedlemmer med %(woundedCrewEfficiency)s effektivitet."

msgid "commander_universalist/hudDescription"
msgstr "Kommandøren utfører rollen til det utslåtte besetningsmedlemmet."

msgid "commander_universalist/maxLvlDescription"
msgstr "Når den er fulltrent, gjør den at kommandøren kan {greenBright_Start}erstatte utslåtte{greenBright_End} besetningsmedlemmer med %(woundedCrewEfficiency)s effektivitet."

msgid "commander_universalist/name"
msgstr "Joker"

msgid "commander_universalist/shortDescription"
msgstr "Gjør at kommandøren kan erstatte utslåtte besetningsmedlemmer."

msgid "driver_badRoadsKing/alt/description"
msgstr "Reduserer ulempen for kjøretøyets manøvrerbarhet og akselerasjon ved kjøring i moderat mykt terreng. Reduserer disse ulempene betydelig når du kjører i mykt terreng, og gir dem egenskaper på linje med moderat mykt terreng.\nManøvrerbarhet i moderat mykt og mykt terreng kan ikke overstige manøvrerbarheten på hardt terreng."

msgid "driver_badRoadsKing/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "driver_badRoadsKing/currentLvlDescription"
msgstr "{greenBright_Start}Tap av fart på moderat mykt terreng{greenBright_End} reduseres med %(mediumGroundFactor)s&zwnbsp;, {greenBright_Start}tap av fart på mykt terreng{greenBright_End} reduseres til %(softGroundFactor)s verdien for det moderat myke terrenget."

msgid "driver_badRoadsKing/maxLvlDescription"
msgstr "Når den er ferdigtrent reduseres {greenBright_Start}tap av fart på moderat mykt terreng{greenBright_End} med %(mediumGroundFactor)s&zwnbsp;, og reduserer {greenBright_Start}tap av fart på mykt terreng{greenBright_End} til %(softGroundFactor)s verdien for det moderat myke terrenget."

msgid "driver_badRoadsKing/name"
msgstr "Offroadsjåfør"

msgid "driver_bulletproof/alt/description"
msgstr "Mannskapets effektivitetsbonus forbedrer mannskapsmedlemmets effektivitet i kamp.\n\nDenne parameteren kan ytterligere økes ved å montere utstyr eller forbruksmateriell med lignende effekt, eller ved å bruke direktivet ventilasjonsutblåsning. Ulike andre mannskapsfordeler kan også øke parameteren."

msgid "driver_bulletproof/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "driver_bulletproof/currentLvlDescription"
msgstr "{yellow_Start}Bonus på besetningseffektivitet{yellow_End} økes med %(crewLevelIncrease)s dersom mengden skade du blokkerer overstiger ditt kjøretøys opprinnelige helsepoeng."

msgid "driver_bulletproof/hudDescription"
msgstr "Bonusen på besetningseffektivitet øker (når det er blokkert stor nok mengde skade)."

msgid "driver_bulletproof/maxLvlDescription"
msgstr "Når den er ferdigtrent økes {yellow_Start}bonus på besetningseffektivitet{yellow_End} med %(crewLevelIncrease)s dersom mengden skade du blokkerer overstiger ditt kjøretøys opprinnelige helsepoeng."

msgid "driver_bulletproof/name"
msgstr "Skuddsikker"

msgid "driver_motorExpert/alt/description"
msgstr "Toppfarten til kjøretøyet ditt kan økes ytterligere og skade på motor kan reduseres enda mer ved å montere utstyr med liknende effekt."

msgid "driver_motorExpert/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "driver_motorExpert/currentLvlDescription"
msgstr "{greenBright_Start}Toppfarten{greenBright_End} og {greenBright_Start}reversfarten{greenBright_End} til ditt kjøretøy økes med %(vehicleForwardMaxSpeed)s. {greenBright_Start}Skaden på en motor {greenBright_End} reduseres med %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/hudDescription"
msgstr "Skaden på en motor reduseres."

msgid "driver_motorExpert/maxLvlDescription"
msgstr "Når den er ferdigtrent blir {greenBright_Start}toppfarten{greenBright_End} og {greenBright_Start}reversfarten{greenBright_End} til ditt kjøretøy økt med %(vehicleForwardMaxSpeed)s. {greenBright_Start}Skaden på en motor {greenBright_End} reduseres med %(vehPenaltyForDamagedEngine)s&zwnbsp;."

msgid "driver_motorExpert/name"
msgstr "Ingeniør"

msgid "driver_motorExpert/shortDescription"
msgstr "Skaden på en motor reduseres."

msgid "driver_rammingMaster/alt/description"
msgstr "Fordelen har ingen effekt når to allierte kjøretøy kolliderer.\n\nKollisjonsskade på ditt eget kjøretøy kan reduseres ytterligere ved å montere utstyr med lignende effekt."

msgid "driver_rammingMaster/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "driver_rammingMaster/currentLvlDescription"
msgstr "{greenBright_Start}Kollisjonsskade på fiendtlige kjøretøy{greenBright_End} økes med %(damageEnemiesByRamming)s&zwnbsp;. {greenBright_Start}Kollisjonsskade på ditt kjøretøy{greenBright_End} reduseres med %(vehicleRamDamageResistance)s&zwnbsp; og på {greenBright_Start}opphenget ditt{greenBright_End} med %(vehicleRamChassisDamageResistance)s&zwnbsp;."

msgid "driver_rammingMaster/maxLvlDescription"
msgstr "Når den er ferdigtrent økes {greenBright_Start}kollisjonsskade på fiendtlige kjøretøy{greenBright_End} med %(damageEnemiesByRamming)s&zwnbsp;. Reduserer {greenBright_Start}kollisjonsskade for ditt kjøretøy{greenBright_End} med %(vehicleRamDamageResistance)s&zwnbsp;, og på {greenBright_Start}opphenget ditt{greenBright_End} med %(vehicleRamChassisDamageResistance)s&zwnbsp;."

msgid "driver_rammingMaster/name"
msgstr "Kontrollert kollisjon"

msgid "driver_rammingMaster/shortDescription"
msgstr "Reduserer kollisjonsskade på ditt kjøretøy og øker kollisjonsskade på fiendtlige kjøretøy."

msgid "driver_reliablePlacement/alt/description"
msgstr "Skade fra HE granater kan reduseres ytterligere ved å montere utstyr med liknende effekt."

msgid "driver_reliablePlacement/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "driver_reliablePlacement/currentLvlDescription"
msgstr "{greenBright_Start}Skadeabsorpsjon fra HE granater{greenBright_End} økes med %(vehicleHEShellDamageResistance)s&zwnbsp;.{greenBright_Start}&nbsp;Sannsynligheten for motorbrann{greenBright_End} reduseres med %(vehicleFireChance)s og {greenBright_Start}skade på opphenget{greenBright_End} med %(suspensionDamageReduction)s&zwnbsp;."

msgid "driver_reliablePlacement/maxLvlDescription"
msgstr "Når den er ferdigtrent, øker den {greenBright_Start}skadeabsorpsjon fra HE granater {greenBright_End} med %(vehicleHEShellDamageResistance)s&zwnbsp;. Reduserer {greenBright_Start}sannsynligheten for motorbrann{greenBright_End} med %(vehicleFireChance)s og {greenBright_Start}skaden på opphenget ditt{greenBright_End} med %(suspensionDamageReduction)s&zwnbsp;."

msgid "driver_reliablePlacement/name"
msgstr "Pålitelig plassering"

msgid "driver_smoothDriving/alt/description"
