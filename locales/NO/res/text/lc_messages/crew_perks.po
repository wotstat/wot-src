msgstr "Når den er ferdigtrent, økes {greenBright_Start}synsrekkevidden{greenBright_End} med %(vehicleCircularVisionRadius)s&zwnbsp;."

msgid "radioman_finder/name"
msgstr "Situasjonsoversikt"

msgid "radioman_finder/shortDescription"
msgstr "Øker synsrekkevidde."

msgid "radioman_interference/alt/description"
msgstr "Dersom to radiooperatører har denne fordelen er det gjennomsnittet av treningsverdiene som gjelder.\n\nTiden ditt kjøretøy forblir synlig kan reduseres ytterligere ved å montere utstyr med en liknende effekt."

msgid "radioman_interference/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

msgid "radioman_interference/currentLvlDescription"
msgstr "{greenBright_Start}Tiden ditt kjøretøy forblir synlig{greenBright_End} hos fienden reduseres med %(vehicleOwnSpottingTime)s&zwnbsp;."

msgid "radioman_interference/maxLvlDescription"
msgstr "Når den er ferdigtrent reduseres {greenBright_Start}tiden ditt kjøretøy forblir synlig{greenBright_End} hos fienden reduseres med %(vehicleOwnSpottingTime)s&zwnbsp;."

msgid "radioman_interference/name"
msgstr "Radioforstyrrelse"

msgid "radioman_interference/shortDescription"
msgstr "Reduserer tiden ditt kjøretøy er synlig for fienden."

msgid "radioman_lastEffort/alt/description"
msgstr "Dersom to radiooperatører har fordelen, gjelder kun den høyeste verdien. Effekten er kun aktiv dersom radiooperatøren ikke er skadet når kjøretøyet blir bekjempet.\n\nFordelen kan forbedres ytterligere med direktivet plikten kommer først."

msgid "radioman_lastEffort/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1%. Effektivitet øker med mer trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "radioman_lastEffort/currentLvlDescription"
msgstr "Radiooperatøren kan {yellow_Start}rapportere fiendtlige posisjoner{yellow_End} i ytterligere %(radiomanDurationPerLevel)s etter at ditt kjøretøy har blitt bekjempet."

msgid "radioman_lastEffort/hudDescription"
msgstr "Rapportering av fiendtlige stillinger."

msgid "radioman_lastEffort/maxLvlDescription"
msgstr "Når den er ferdig trent, kan {yellow_Start}fiendtlige posisjoner rapporteres{yellow_End} i ytterligere %(radiomanDurationPerLevel)s etter at ditt kjøretøy har blitt bekjempet."

