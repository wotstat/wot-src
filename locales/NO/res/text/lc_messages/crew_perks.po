msgstr "{yellow_Start}Synsrekkevidde{yellow_End} økes med %(vehicleCircularVisionRadius)s i 5 s etter å ha fått Sjette sans varsling."

msgid "radioman_threatSearch/hudDescription"
msgstr "Synsrekkevidde er redusert."

msgid "radioman_threatSearch/maxLvlDescription"
msgstr "Når den er ferdigtrent, økes {yellow_Start}synsrekkevide{yellow_End} med %(vehicleCircularVisionRadius)s i 5 s etter å ha fått Sjette sans varsling."

msgid "radioman_threatSearch/name"
msgstr "Trusselsøk"

msgid "repair/alt/description"
msgstr "Denne fordelen påvirker hastigheten på reparasjon av interne og eksterne moduler fra \"rød\" til \"gul\" status.\n\nDenne parameteren kan forbedres ytterligere ved å montere utstyr eller forbruksmateriell med liknende effekt."

msgid "repair/alt/info"
msgstr "Gruppefordeler beregnes fra det gjennomsnittlige treningsnivået for hele besetningen. Den trer i effekt når den er blitt trent til minst 1% og effektiviteten øker med mer trening."

msgid "repair/currentLvlDescription"
msgstr "{greenBright_Start}Hastigheten på reparasjoner{greenBright_End} av kjøretøyets moduler økes med %(vehicleRepairSpeed)s&zwnbsp;."

msgid "repair/maxLvlDescription"
