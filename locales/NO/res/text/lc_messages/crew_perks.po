msgid "radioman_battleTempered/name"
msgstr "Kampherdet"

msgid "radioman_expert/alt/description"
msgstr "Bonus på besetningseffektivitet i kamp. Dersom to radiooperatører har denne fordelen, er det gjennomsnittet av treningsverdiene som gjelder. Denne parameteren kan økes ytterligere ved å montere utstyr eller forbruksmateriell med liknende effekt, eller ved å benytte direktivet ventilasjonsutblåsning. Gruppefordelen våpenbrødre i tillegg til kommandørs alarmberedskap eller radiooperatørs side ved side fordel kan også øke parameteren."

msgid "radioman_expert/alt/info"
msgstr "En fordel påvirket av situasjoner begynner å få effekt når den er trent til minst 1% og effektivitet blir bedre med ytterligere trening. Effekten på situasjonen trer i funksjon når visse vilkår oppstår i kamp."

msgid "radioman_expert/currentLvlDescription"
msgstr "{yellow_Start}Bonus på besetningseffektivitet{yellow_End} økes med %(crewLevelIncrease)s dersom mengden assistert skade du står for, overstiger ditt kjøretøys opprinnelige helsepoeng&zwnbsp;."

msgid "radioman_expert/hudDescription"
msgstr "Bonusen på besetningseffektivitet øker (når det er oppnådd stor nok mengde rekogniseringsbidrag)."

msgid "radioman_expert/maxLvlDescription"
msgstr "Når den er ferdigtrent økes {yellow_Start}bonus på besetningseffektivitet{yellow_End} med %(crewLevelIncrease)s dersom mengden bidragsskade du står for overstiger ditt kjøretøys opprinnelige helsepoeng&zwnbsp;."

msgid "radioman_expert/name"
msgstr "Kommunikasjonsekspert"

msgid "radioman_expert/shortDescription"
msgstr "Forbedrer besetningsytelse."

msgid "radioman_finder/alt/description"
msgstr "Dersom to radiooperatører har fordelen er det gjennomsnittet av treningsverdiene som gjelder.\n\nSynsrekkevidden kan økes ytterligere ved å trene opp fordelen rekognosering eller ved å montere utstyr som har liknende effekt. Å benytte seg av direktivet optisk kalibrering forbedrer effekten."

msgid "radioman_finder/alt/info"
msgstr "En fordel trer i effekt når den er trent til minst 1%. Effektiviteten øker med mer trening."

