msgid "tooltip/battleType/hasBattles/body"
msgstr "Kamper kjempet: %(value)s. Statistikk oppdateres etter hver kamp og nullstilles ikke automatisk."

msgid "tooltip/battleType/hasBattles/daily/body"
msgstr "Kamper kjempet: %(value)s. Statistikk oppdateres etter hver kamp. Verdiene blir automatisk nullstilt hver 24. time."

msgid "tooltip/battleType/header"
msgstr "Statistikk for runden i %(battleType)s modusen"

msgid "tooltip/battleType/noBattles/body"
msgstr "Statistikk vises etter den første kampen som er kjempet. Statistikken oppdateres etter hver kamp og nullstilles ikke automatisk. Frekvensen for automatisk nullstilling kan endres i innstillingene. Verdiene kan nullstilles manuelt i tillegg."

msgid "tooltip/battleType/noBattles/daily/body"
msgstr "Statistikkene vises etter den første kjempede kampen og oppdateres etter hver påfølgende kamp. Verdiene blir automatisk nullstilt hver 24. time."

msgid "tooltip/clearButton/available/body"
msgstr "Klikk for å nullstille statistikken for inneværende runde."

msgid "tooltip/clearButton/available/daily/body"
msgstr "Klikk for å nullstille statistikkverdiene for den inneværende runden. Statistikkene for runden blir automatisk nullstilt om %(time)s"

msgid "tooltip/clearButton/header"
msgstr "Nullstill"

msgid "tooltip/clearButton/unavailable/body"
msgstr "Nullstilling av statistikken for inneværende runde er ikke tilgjengelig akkurat nå."

msgid "tooltip/clearButton/unavailable/daily/body"
msgstr "Det er for tiden ikke mulig å nullstille statistikken for runden. Verdiene blir automatisk nullstilt på slutten av dagen."

