msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Raten for total skade forårsaket i forhold til antall kamper kjempet denne runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Rate for fiendtlige kjøretøy bekjempet i forhold til antall kamper."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Gjennomsnittlig nivå på kjøretøy du kjørte denne spillrunden."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Raten for total erfaring forårsaket i forhold til antall kamper kjempet denne runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Raten for total skade blokkert i forhold til antall kamper kjempet denne runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Raten for skade forårsaket etter din oppdagelse og skade forårsaket av allierte etter at du har ødelagt et belte og immoblisert det fiendtlige kjøretøyet eller sjokket besetningen i forhold til antall kamper kjempet i en runde. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Raten for parameteren på \"skade forårsaket\" i forhold \"skade mottatt\". Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Raten for antall bekjempede fiendlige kjøretøy i forhold til antall kamper ganger spillerens kjøretøy ble bekjempet. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Rate for fiendtlige kjøretøy oppdaget i forhold til kamper kjempet denne runden."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Prosent for det totale antall kamper der spillerens kjøretøy ikke ble bekjempet."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Prosent antall seiere i tilfeldige kamper for denne runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/wins"
msgstr "Antall seiere i tilfeldige kamper for denne runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

msgid "propertyInfo/prop/descr/wtr"
msgstr "WTR etter gjennomsnittlige verdier for hele runden. Delta viser effekten av den inneværende spillrunden for parameteren totalt."

