msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Kilden for avviket nærmer seg. Selvfølgelig er det en diger feit tanks."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Bekjemp den og dette er over. Kom igjen gutter!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Skyt på svake punkter i pansringen."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Folkens, en diger stygg monstrøsitet kommer mot oss,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "likner ikke noe vi har sett før."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Dens svake punkter ser ut til å være synlige. Vi må"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "bekjempe bossen for å få tak i reléet og fullføre oppdraget."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "I dag er vi heldige folkens! To bosser istedet for én—"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "det er noe nytt. Men vi vinner uansett. Sikt på de svake"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "punktene i pansringen og husk å bekjempe vokterne."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Dette er en seriøs motstander, men den har svake punkter."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Bekjemp denne skapningen og det hele er over. Kom igjen folkens!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Skyt på fiends svake punkter. Og husk å bekjempe"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "vokterne dens, ellers blir det vrient."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Vi er nødt til å bekjempe bossen for å lukke avviket."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Sikt på de svake punktene i pansringen dens."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Vi er nødt til å bekjempe den siste motstanderen for å avslutte oppdraget."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Skyt på dens svake punkter."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Dette er det siste hinderet i vår vei."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Konsentrer dere folkens! La oss få bekjempet dette monsteret!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Fienden er meget farlig, men den har svake punkter."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Dette er vår mulighet til å avslutte dette en gang for alle."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Nå får vi se hva avviket har på lur til oss."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "En sterk motstander, men den har svake punkter."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "La oss bekjempe dette beistet folkens!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Dette er en meget sterk motstander. Men vi kan klare det, det er jeg sikker på."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "To bosser til prisen for én i dag."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Kom igjen, det er nå eller aldri! Sikt på de svake punktene"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "i pansringen deres. La oss bekjempe disse monstrene!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Ser ut som at bossene ikke klarte å finne ut av rekkefølgen og"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "kom hit sammen. Begge har svake punkter, sikt på disse."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Et pent par med bosser igjen. Folkens, dere vet hva dere har å gjøre."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Skyt på de svake punktene deres og bekjemp vokterne rundt dem."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Og ikke kast bort tiden!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Vi ga dem bra juling folkens!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Men det ser ut til at vi ikke er helt ferdige ennå."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Digg! Men vi er bare halvveis."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Den kommer tilbake med vennene sine."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Sånn skal det være! La oss reparere tanksene våre så kan vi gå løs på dem igjen."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Den blir ikke bekjempet så lett. Gjør klar til runde nummer to."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Vi ga dem bank folkens! Men det er ikke over ennå."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Digg! Men vi er bare halvveis."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "De kommer tilbake med vennene sine."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Sånn skal det være! La oss reparere tanksene våre så kan vi gå løs på dem igjen."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "De blir ikke bekjempet så lett. Gjør klar til runde nummer to."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Kaptein Smith snakker. Mens folkene våre på utsiden av riften"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "står i mot ekkotanksenes angrep på Babylonkomplekset,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "er vårt oppdrag at vi kommer oss gjennom alle fasene og får lukket igjen avviket. "

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "For å gjøre det må vi fylle opp innsamlerne i alle fasene. Rull ut!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "En av fiendens baser ble observert dypt inne i Mirium-underrommet. "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "De gjør klar en svær styrke til en invasjon. Vår eneste sjanse"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "til å stanse dem er å blokkere passasjen for dem. Vårt oppdrag er å komme oss"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "til en dyp fase i avviket og få vekk et relé som"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "holder passasjen åpen for dem. Fyll Magnus med Mirium,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "vi går på helt til slutten!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Hei alle sammen! Vi er nødt til å lukke passasjen til vår dimensjon for"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "ekkotanksene. Kontraetterretningen kan ta seg av spionene"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "i Babylon—vår oppgave er Mirium. Fyll samlerne i alle fasene,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "gi de tingene som venter på oss under oss juling,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "og lukk igjen denne åpningen. Start motorene deres!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Smith her. Vår oppgave er å stenge riften ved Babylon"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "komplekset. Fyll samlerne med Mirium, og bekjemp"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "alt som ikke er oss. Kom igjen folkens, fienden venter på oss!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Våre folk holder stand mot Mirium tanksene så de ikke bryter gjennom"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "til den virkelige verdenen. Ditt oppdrag er å lukke åpningen."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Jo fortere jo bedre. Samle Mirium og lukk det hullet."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Fiendtlige tanks angriper Babylon komplekset. Den møkka "

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "kravler ut fra åpningen og vi er nødt til å stenge passasjen."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Gå dypt inn i avviket og nøytralisér kilden. Kom igjen!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Smith her. Vårt oppdrag er å stenge den tyske hærens"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "ekkotanks inne i avviket. Vårt mål er nå"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "i den dype fasen. Fyll opp Magnus for å nå den."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "En fiendtlig base ble oppdaget dypt inne i Miriums underrom."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "De planlegger angrepene sine der."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Ikke bry dere om den lille jenta. Vårt oppdrag er å aktivere"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus og åpne passasjen til den dypeste fasen"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "så vi kan stenge fienden inne der for godt."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "En fiendtlig base ble oppdaget i den dypeste fasen."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Vi kan ikke overvinne dem nå, men vi kan stenge dem inne der."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Samle Mirium for å komme helt til bunns i denne riften."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Jeg tror på dere folkens! Dette klarer vi!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "En ny rift åpnet seg raskt etter at den siste ble lukket."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Oppdraget vårt er det samme: Samle materien og"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "steng avviket for å hindre invasjonen av vår virkelighet. Kom igjen!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Riften ble åpnet igjen. Sank materie og fyll samleren."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Vi er nødt til å få stengt det fordømte avviket. Folk på utsiden"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "stoler på oss, men de vil ikke klare å stå i mot mye lengre!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Babylonkomplekset er fremdeles under angrep fra fiendtlige tanks."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Samle materie og lad opp Magnus. Vi må få stengt"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "avviket for å stanse ekkotanksene fra å invadere vår verden."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Målet vårt er nærme. Vær årvåkne og hold et øye"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "med Immortal-detektoren."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Bra jobba folkens! Hold tempoet oppe! Vi er ikke"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "her for å ha en te-pause. Vi trenger mer Mirium."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Bra samarbeid! La oss fortsette, vi trenger mer Mirium."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Bra jobba! Vi må aktivere Magnus for å komme oss enda dypere."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium gjør oss sterkere for hver fase."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Bare ikke bli for ivrig."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Vi må aktivere Magnus. Bare hold ut litt mer!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Oppdraget vårt er det samme: Vi må fylle samleren."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Vi nærmer oss invasjonens kilde."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Oppgaven vår er den samme: Fyll samleren."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Fin sang. Behold fokuset folkens."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Vi må samle Mirium og gå dypere."

msgid "narrator"
msgstr "Smith"
