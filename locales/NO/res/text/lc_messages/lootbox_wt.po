msgid "infoPage/footer/description/autoOpen/wt"
msgstr "Dersom du ikke åpner moduler før eventet er over, blir de åpnet automatisk."

msgid "infoPage/footer/description/compensation/wt"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i modulene, vil alle påfølgende kjøretøy du får fra modulene bli kompensert med gull tilsvarende deres fulle verdi."

msgid "infoPage/footer/description/guaranteed/wt"
msgstr "Hver %(guaranteed)s. modul garanteres å inneholde et kjøretøy. Dersom du åpner dem uten at et slikt kjøretøy blir sluppet, så vil et kjøretøy som du ikke har fra før bli sluppet når du åpner den %(guaranteed)s. modulen. Når den så slipper et kjøretøy, nullstilles telleren."

msgid "infoPage/footer/description/reroll/wt"
msgstr "Hvis du ikke er fornøyd med belønningene fra en modul kan du gjenåpne den for en sjanse til å få andre enheter fra den samme listen. Hver modul kan bare gjenåpnes et begrenset antall ganger:"

msgid "infoPage/footer/title/autoOpen"
msgstr "Autoåpne"

msgid "infoPage/footer/title/compensation"
msgstr "Kompensasjon"

msgid "infoPage/header/description"
msgstr "Åpne modulen for sjansen til å få verdifulle enheter til bruk i spillet! Se flere detaljer under."

