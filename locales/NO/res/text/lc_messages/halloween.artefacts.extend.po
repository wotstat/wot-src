msgstr " \nMirium pris: {whiteSpanish_open}%(cost)s{whiteSpanish_close}"

msgid "hwAbility/usageCost/default"
msgstr "Mirium kostnad for bruk i kamp:"

msgid "hwAoeDamageInstantShot/always"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/descr"
msgstr "Avfyrer et skudd som skader og sjokker målet samt fiendtlige kjøretøy som er nærme."

msgid "hwAoeDamageInstantShot/long_special"
msgstr "Kampevne. Avfyrer et skudd som skader målet og alle fiendtlige kjøretøy innenfor en radius på 35 m. Hvis den brukes minst én gang i en kamp er evnen brukt opp og kan etterfylles for credits. Hvis den ikke brukes er ingen etterfylling nødvendig.<br/><br/>Kun tilgjengelig under <font color='#cbac77'>Babylon: Dark Tower</font> eventet.<br/><br/>Alle ubrukte evner blir fjernet og kompensert i credits tilsvarende 50 % av kostnaden i neste oppdatering."

msgid "hwAoeDamageInstantShot/name"
msgstr "Energiskudd"

msgid "hwAoeDamageInstantShot/onUse"
msgstr "Avfyrer et skudd som sakder og sjokker målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "hwAoeDamageInstantShot/restriction"
msgstr "?empty?"

msgid "hwAoeDamageInstantShot/short_special"
msgstr "Avfyrer et skudd som skader og sjokker målet samt fiendtlige kjøretøy som er nærme."

msgid "hwAoeDrainEnemyHpInstantShot/always"
