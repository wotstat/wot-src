msgid "Contact/status/inBattle/last_stand"
msgstr "I en Last Stand kamp"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Avfyrer et skudd som skader målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Avfyrer et skudd som gjenoppretter helsepoeng ved å stjele dem fra målet og fiendtlige kjøretøy som befinner seg innenfor en radius på 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Avfyrer et skudd som sjokker målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "advanced/ls_damageShield"
msgstr "Beskytter mot en hvilken som helst skade (bortsett fra kollisjon, drukning og fallstøt) i 10 sekunder."

msgid "advanced/ls_doubleDamage"
msgstr "Ditt neste vellykkede skudd forårsaker dobbel skade."

msgid "advanced/ls_equipment"
msgstr "Taktiske enheter hjelper deg å kjempe mer effektivt i kamper i Last Stand, fullføre trinn og tjene verdifulle belønninger. For å utstyre dem, klikk på en av plassholderne for taktiske enheter."

msgid "advanced/ls_extraDamageSituational"
msgstr "Gir en sjanse til å påføre større grad av skade på et fiendtlig kjøretøy."

msgid "advanced/ls_fastReload"
msgstr "Øker skuddtakt / lader nytt magasin."

msgid "advanced/ls_healSituational"
msgstr "Gjenoppretter noen helsepoeng etter å ha bekjempet et fiendtlig kjøretøy."

msgid "advanced/ls_invisibility"
msgstr "Hindrer fiender midlertidig i å sikte på kjøretøyet ditt, gjenoppretter helsepoeng, reparerer moduler, slukker brann, fjerner sjokkeffekt og behandler alle skadde besetningsmedlemmer."

msgid "advanced/ls_nitro"
msgstr "Øker ditt kjøretøys mobilitet midlertidig."

msgid "advanced/ls_nitroSituational"
msgstr "Øker ditt kjøretøys mobilitet midlertidig etter at du har tatt skade fra et fiendtlig kjøretøy."

msgid "advanced/ls_selfRepairKit"
msgstr "Gjenoppretter helsepoeng, slukker brann, fjerner sjokkeffekt og reparerer skadde moduler."

msgid "advanced/ls_teamRepairKit"
msgstr "Reparerer moduler umiddelbart, slukker brann, fjerner sjokkeffekt og gjenoppretter noen helsepoeng for allierte kjøretøy innenfor dens radius."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktiske enheter kan utstyres i spesielle plassholdere, noe som vil hjelpe deg med å kjempe mer effektivt i Last Stand kamper, fullføre trinn og tjene verdifulle belønninger."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Plassholdere for taktiske enheter"
