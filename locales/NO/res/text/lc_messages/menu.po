msgid "roleExp/roleDescr/role_ATSPG_assault"
msgstr "Kjøretøy med lav mobilitet og pålitelig frontalpansring. De yter godt når de kjemper på frontlinjene."

msgid "roleExp/roleDescr/role_ATSPG_sniper"
msgstr "Kjøretøy med svak pansring og greie kanoner passer til bakholdsangrep i de fleste kampsituasjoner."

msgid "roleExp/roleDescr/role_ATSPG_support"
msgstr "Kjøretøy med perfekte kanoner, der effektiv bruk krever etterfølgelse av bestemte vilkår. De kan forårsake en stor mengde skade på kort tid."

msgid "roleExp/roleDescr/role_ATSPG_universal"
msgstr "Panserjagere med gjennomsnittlige kjøretøykarakteristika som er like effektive på en hvilken som helst avstand."

msgid "roleExp/roleDescr/role_HT_assault"
msgstr "Tungt pansrede kjøretøy som utholdende både kan avgi og ta helsepoeng og stanse fiendens fremrykking ved å holde seg på relevant sted i forhold til angrepslinja."

msgid "roleExp/roleDescr/role_HT_break"
msgstr "Kjøretøy med god mobilitet og pålitelig pansring som gjør dem effektive i både førstelinjes angrep i posisjonelle nærkamper og under flankemanøvre."

msgid "roleExp/roleDescr/role_HT_support"
msgstr "Kjøretøy med perfekte kanoner, der effektiv bruk krever etterfølgelse av bestemte vilkår. De kan forårsake en stor mengde skade på kort tid."

msgid "roleExp/roleDescr/role_HT_universal"
msgstr "Flerbrukstanks som enkelt kan tilpasse seg en hvilken som helst kampsituasjon."

msgid "roleExp/roleDescr/role_LT_universal"
msgstr "Raske og manøvrerbare kjøretøy som både kan speide og forårsake skade under flankemanøvre."

msgid "roleExp/roleDescr/role_LT_wheeled"
msgstr "Kjøretøy med fremragende dynamiske karakteristika, der effektiv bruk avhenger av kartet eller den taktiske situasjonen."

msgid "roleExp/roleDescr/role_MT_assault"
msgstr "Kjøretøy med grei pansring som gjør at de passer best til nærkamp og til å stå imot fiendtlige tunge tanks."

msgid "roleExp/roleDescr/role_MT_sniper"
msgstr "Kjøretøy med fremragende kanoner og svak pansring som viser effektiv ytelse på lange avstander."

msgid "roleExp/roleDescr/role_MT_support"
msgstr "Kjøretøy med perfekte kanoner, der effektiv bruk krever etterfølgelse av bestemte vilkår. De kan forårsake en stor mengde skade på kort tid."

msgid "roleExp/roleDescr/role_MT_universal"
msgstr "Godt balanserte kjøretøy som kan utføre et vidt spekter av kampoppgaver. De kan enkelt tilpasse seg kartet og den taktiske situasjonen."

msgid "roleExp/roleDescr/role_SPG"
msgstr "En langdistanse-støtte for allierte i angrep. Støttekjøretøy hvis effektivitet vanligvis avhenger av kampsituasjonen og handlingene til laget."

