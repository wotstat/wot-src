msgid "extraParams/desc"
msgstr "En parameter som ikke påvirker effektiviteten til å bekjempe fiendtlige kjøretøy direkte."

msgid "extraParams/header"
msgstr "Bonus %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Den totale bonusen beregnes ved å benytte både additive og multiplikative modifikatorer, så den kan ende opp enten høyere eller lavere enn verdiene indikert her."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Denne parameteren viser tiden mellom skuddet fra SPGen og mottaket av varselet."

msgid "extraParams/name/commanderLampDelay"
msgstr "Denne parameteren viser forsinkelsen før kommandøren oppdager at kjøretøyet har blitt oppdaget av fienden. Jo høyere verdi, jo kortere forsinkelse."

msgid "extraParams/name/crewHitChance"
msgstr "Denne parameteren viser sjansen for å unngå skader på besetningsmedlemmene dine."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Denne parameteren viser varigheten på et nytt sjokk på et kjøretøy som er sjokket fra før."

msgid "extraParams/name/crewStunDuration"
msgstr "Denne parameteren viser varigheten på det mottatte sjokket."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Denne parameteren viser endringen av minimum potensiell skade og potensiell penetrasjonsverdi sammenlikned med basisverdien (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Denne parameteren viser endringen på maksimal potensiell skade og potensiell penetrasjonsverdi sammenliknet med basisverdien (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Denne parameteren viser mengden skade forårsaket av kollisjon. Når kjøretøy kolliderer, finner systemet tykkelsen på pansringen på det punktet der sammenstøtet begynte, ulikheten i kjøretøyenes vekt og hastigheten de hadde."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Denne parameteren viser forsinkelsen før kommandøren oppdager kritisk skade på det fiendtlige kjøretøyet i siktet ditt."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Denne parameteren viser eksponeringen for fiender som er helt skjult av vegetasjon (både enkel- og gruppert vegetasjon). Gjelder både stasjonære og kjøretøy i bevegelse."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Denne parameteren viser eksponeringen for fiendtlige kjøretøy i bevegelse. Jo høyere verdi, jo større sjanse for oppdagelse."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Denne parameteren viser endringene på sjansen for å påføre kritisk skade på fiendtlige besetninger og moduler. Den påvirker alle typer granater bortsettt fra for kjøretøy med autokanoner."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Denne parameteren viser nedkjølingstiden på forbruksmateriell."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Denne parameteren styrer reduksjonen på en branns varighet og mengden skade det forårsaker."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Denne parameteren viser effekten for skjuleevne bak vegetasjon."

msgid "extraParams/name/hpRecover"
msgstr "Denne parameteren viser økningen i gjenopprettet helsepoeng når reparasjonssett benyttes. Jo høyere verdi jo mer helsepoeng blir gjenopprettet."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Denne parameteren viser opphengets kapasitet på moderat mykt terreng. Jo høyere verdi, jo mindre tid kreves for å nå jevn hastighet."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Denne parameteren gjør reduksjonen av maksimal synsrekkevidde mindre når obervasjonsenheter blir ødelagt. Jo lavere verdi, jo klarere utsyn."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Denne parameteren viser økningen i maksimal potensiell penetrasjonsverdi for granater på avstander under 50 m. Jo høyere verdien er, desto bedre er penetrasjonsevnen."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Denne parameterem viser den ekstra tiden med overføring av fiendtlige posisjoner etter at ditt kjøretøy har blitt bekjempet."

msgid "extraParams/name/radiomanHitChance"
msgstr "Denne parameteren viser sjansen for å unngå skader på radiooperatøren din."

msgid "extraParams/name/shellVelocity"
msgstr "Denne parameteren viser økningen i granathastighet for alle typer granater. Jo høyere verdi, jo høyre granathastighet."

msgid "extraParams/name/softGroundFactor"
msgstr "Denne parameteren viser opphengets kapasitet på mykt terreng. Jo høyere verdi, jo mindre tid kreves for å nå jevn hastighet."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Denne parameteren viser graden av negative effekter på sjokk på besetningen."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Denne parameteren viser reduksjonen i innkommende skade på opphenget. Jo høyere verdien er, desto mindre skade vil bli mottatt."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Denne parameteren viser reduksjonen i ladetiden for kanonen på grunn av ødelagt ammunisjonsstativ. Jo høyere verdi, desto kortere ladetid."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Denne parameteren viser reduksjonen i kraft fra en skadd motor. Jo høyere verdi, desto mindre kraft mister motoren."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Denne parameteren viser motstandsdyktigheten for ammunisjonsstativ, drivstofftanker og motor. Jo høyere verdi, jo mer motstandsdyktige er modulene dine."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Denne parameteren viser motstandsdyktigheten på ammunisjonsstativet. Jo høyere verdi, jo mer motstandsdyktig ammunisjonsstativ."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Denne parameteren viser skaden forårsaket av skade på opphenget ved kollisjon. Den påvirker ikke skaden forårsaket på sidene eller toppen av tårnet under sammenstøtet."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Denne parameteren viser hvor raskt opphenget repareres. Jo høyere verdi, jo raskere reparasjoner."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Denne parameteren viser opphengets motstandsdyktighet. Jo høyere verdi, jo mer juling kan opphenget tåle fra både granater og sammenstøt/kollisjon."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Denne parameteren viser hvor lenge fiender er synlige etter at de forlater din synlighetsrekkevidde. Standardverdien er 10 sekunder."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Denne parameteren viser reduksjon på mottatt skade av et kjøretøy ved kollisjon. Jo høyere verdi, desto mindre skade får du."

msgid "extraParams/name/vehicleFireChance"
msgstr "Denne parameteren viser sjansen for motorbrann når motoren er skadd."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Denne parameteren viser motstandsdyktigheten på drivstofftankene mot kritisk skade. Når drivstofftanker blir ødelagt, tar de alltid fyr."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Denne parameteren viser reduksjonen på kanonpresisjonen ved bevegelse, skrog og tårndreining. Jo lavere verdi, jo mindre spredning på siktesirkelen."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Denne parameteren viser størrelsen på siktesirkelen etter å ha avfyrt et skudd."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Denne parameteren viser skuddspredning i bevegelse. Jo lavere verdi, jo mer presis kanon (mindre siktesirkel)."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Denne parameteren viser skuddspredning under skrogdreining. Jo lavere verdi, jo mer presis kanon (mindre siktesirkel)."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Denne parameteren viser skuddspredning under tårndreining. Jo lavere verdi, jo mer presis kanon (mindre siktesirkel)."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Denne parameteren viser skuddspredning med en skadd kanon. Jo høyere verdi, desto mer kompensert kanon, jo mindre skuddspredning."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Denne parameteren viser skade mottatt fra HE granater. Jo mer pansring i treffområdet, jo høyere effekt."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Denne parameteren viser skjuleevnen etter å ha avfyrt et skudd."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Denne parameteren viser varigheten på hvor lenge ditt kjøretøy er synlig for fiender etter at du forlater deres synsrekkvidde. Standardverdien er 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Denne parameteren viser mengden skade på opphenget etter kollisjon. Når kjøretøy kolliderer, finner systemet tykkelsen på pansringen på det punktet der sammenstøtet begynte, ulikheten i kjøretøyenes vekt og hastigheten de hadde."

msgid "extraParams/name/vehicleRamDamageResistance"
msgstr "Denne parameteren viser mengden skade mottatt fra kollisjon. Når kjøretøy kolliderer, finner systemet tykkelsen på pansringen på det punktet der sammenstøtet begynte, ulikheten i kjøretøyenes vekt og hastigheten de hadde."

msgid "extraParams/name/vehicleReloadTimeAfterShellChange"
msgstr "Denne parameteren viser tiden det tar å bytte granattyper i en ferdig ladet kanon."

msgid "extraParams/name/vehicleRepairSpeed"
msgstr "Denne parameteren viser hvor raskt reparasjon av interne og eksterne moduler fra \"rød\" status til \"gul\" status skjer. Jo høyere verdi, jo raskere reparasjon."

msgid "extraParams/name/vehicleSpeedGain"
msgstr "Denne parameteren viser opphengets kapasitet. Jo høyere verdi, jo mindre tid kreves for å nå jevn hastighet."

msgid "extraParams/name/wheelsRotationSpeed"
msgstr "Denne parameteren viser hvor raskt et kjøretøy med hjul kan endre retning."

msgid "extraParams/name/woundedCrewEfficiency"
msgstr "Denne parameteren viser reduksjonen på hovedkvalifikasjonene for et hvilket som helst besetningsmedlemm når de blir skadd (bortsett fra for kommandøren)."

