msgid "Contact/status/inBattle/halloween"
msgstr "I en kamp i Babylon: Dark Tower"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Avfyrer et skudd som sakder og sjokker målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Avfyrer et skudd som gjenoppretter helsepoeng ved å stjele dem fra målet og fiendtlige kjøretøy som befinner seg innenfor en radius på 35 m."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Avfyrer et skudd som sjokker målet og alle fiendtlige kjøretøy som er innenfor en radius på 35 m."

msgid "advanced/hw_damageShield"
msgstr "Beskytter mot en hvilken som helst skade (bortsett fra kollisjon, drukning og fallstøt) i 7 sekunder."

msgid "advanced/hw_fastReload"
msgstr "Øker skuddtakt / lader nytt magasin."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Gjenoppretter helsepoeng, slukker brann, fjerner sjokkeffekt og reparerer skadde moduler."

msgid "advanced/hw_invisibility"
msgstr "Gjør kjøretøyet ditt midlertidig usynlig for fiender, gjenoppretter helsepoeng, reparerer moduler, slukker brann, fjerner sjokkeffekt og behandler skadde besetningsmedlemmer."

msgid "advanced/hw_teamRepairKit"
msgstr "Reparerer moduler umiddelbart, slukker brann, fjerner sjokkeffekt og gjenoppretter noen helsepoeng for allierte kjøretøy innenfor dens radius."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Kampevner hjelper deg å kjempe mer effektivt i kamper i Babylon: Dark Tower, fullføre målsetninger og tjene verdifulle belønninger. For å utstyre dem, klikk på en av plassholderne for kampevner."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Plassholdere for kampevner"

msgid "hwShell/alt/description"
msgstr "%(bold)s kan finnes i kamp etter en bestemt sannsynlighet etter å ha bekjempet en fiende."

msgid "hwShell/alt/description/bold"
msgstr "En alternativ granat"
