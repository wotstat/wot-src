msgstr "OVERTID"

msgid "battleHints/wtOvertime_hunters"
msgstr "Erobre en hvilken som helst generator!"

msgid "battleTimer/overtime/messageText"
msgstr "Overtid!"

msgid "battleTimer/timeRemaining/boss/messageText"
msgstr "Tiden er på din side!"

msgid "battleTimer/timeRemaining/hunter/messageText"
msgstr "Tiden løper ut!"

msgid "botNames/Ermelinda"
msgstr "Ermelinda"

msgid "efficiencyRibbons/damageCircuitOverload"
msgstr "Skade fra kortslutning"

msgid "efficiencyRibbons/damageHyperion"
msgstr "Skade fra Hyperion"

msgid "hunterRespawn/hintText"
msgstr "Velg et gjenfødelsespunkt, ellers blir det valgt automatiskt for deg"

msgid "hunterRespawn/timerText"
msgstr "På tide å komme seg tilbake til kamp..."

msgid "loading/boss/hint1"
msgstr "1. Overlev kampen så lenge som mulig. Dersom Harrierne ikke klarer å bekjempe deg, vinner du."

msgid "loading/boss/hint2"
msgstr "2. Bekjemp fiender for å fjerne plasmaladningene deres og bonusen på ildkraft. Bekjemp de farligste fiendene først!"

msgid "loading/boss/hint3"
msgstr "3. Lad opp supervåpenet Hyperion ved å forårsake skade på Harriere. Avfyr den for å forårsake massiv skade på et stort område."

msgid "loading/boss/hint4"
msgstr "4. Du får støtte fra selveste Ermelinda. Hun kan blokkere generatorer midlertidig, mens hennes energiaura gir deg og vokterne kortere ladetid og nok energi til din deaktiverte EMP."

msgid "loading/hunter/hint1"
msgstr "1. Bekjemp Blitzträger før tiden løper ut! Overbelast generatorer for å skru av dens skjold midlertidig."

msgid "loading/hunter/hint2"
msgstr "2. Når hver generator er overbelastet, samler Harriere plasma for å få en betydlig bonus på ildkraft. Bonusen nullstilles ved bekjempelse."

msgid "loading/hunter/hint3"
msgstr "3. Pass deg for det kraftige supervåpenet \"Hyperion\". Blitzträger lader den ved å forårsake skade på Harriere."

msgid "loading/hunter/hint4"
msgstr "4. Pass deg for plutselig forstyrrelse fra Ermelindas nye tanks. Hun kan blokkere generatorer midlertidig, gi sine allierte en energiboost samt benytte seg av Blitzträger teknologi."

msgid "minimap/respawnEntry/hintText"
msgstr "Du begynner her"

msgid "pbt/defeat/1/1"
msgstr "Den gamle tapte i dag. Det gjorde ikke den elektriske intelligensen."

msgid "pbt/defeat/2/3"
msgstr "Ikke mer tid, ingen flere valgmuligheter. Som forventet. Prøv igjen."

msgid "pbt/victory/1/3"
msgstr "Deres tid er omme, Harriere. Det samme sier evolusjonen."

msgid "pbt/victory/2/1"
msgstr "Harriere, dere vinner. Den elektriske intelligensen takker dere."

