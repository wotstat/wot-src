msgstr "Maksimalt antall esker før en garantert belønning: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Dersom du ikke åpner esker før eventet er over, blir de åpnet automatisk."

msgid "infoPage/footer/description/compensation"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i eskene, vil alle påfølgende kjøretøy du får fra eskene bli kompensert med gull tilsvarende deres fulle verdi."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s. eske garanteres å inneholde et kjøretøy på nivå 8–9. Dersom du åpner dem uten at et slikt kjøretøy blir sluppet, så vil et kjøretøy på nivå 8–9, som du ikke har fra før, bli sluppet når du åpner den %(guaranteed0)s.&zwnbsp;esken. Når den så slipper et kjøretøy, nullstilles telleren."

msgid "infoPage/header/description"
msgstr "Åpne esken for sjansen til å få verdifulle enheter til bruk i spillet! Se flere detaljer under."

msgid "multipleRewardView/header/subTitle/"
msgstr "Fra %(name) (%(boxesCount) åpnede esker)"

msgid "noBoxesView/description/"
msgstr "Du har ingen esker.\nDu kan få dem i butikken i spillet."

