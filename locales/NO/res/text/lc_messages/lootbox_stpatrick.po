msgid "singleRewardView/tooltip/description/"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i eskene, vil alle påfølgende kjøretøy du får fra eskene bli kompensert med gull."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) eske"
msgstr[1] "%(remainingCount) esker"
msgstr[2] "%(remainingCount) esker"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Den garanterte belønningen er et kjøretøy fra listen over mulig innhold i eskene.\nDersom du åpner %(remainingCount) uten å få et slikt kjøretøy, får du den når du åpner den %(count). esken. Når den gjør det, nullstilles telleren."
