msgstr "Pojistka"

msgid "_100mm_Prurazny_vz_50_WT"
msgstr "Silver Bullet"

msgid "_100mm_Prurazny_vz_50_WT_descr"
msgstr "De alliertes våpensmeders stolthet"

msgid "_100mm_Prurazny_vz_50_WT_long_special"
msgstr "Hver overbelastede generator vil lade opp sølvkulen med plasma. Jo flere ladninger, jo mer skade forårsaker plasmaen. Skyt når Blitzträgerens skjold er nede for å påføre maksimal skade."

msgid "_100mm_Prurazny_vz_50_WT_short_special"
msgstr "Ytterligere skade med plasma"
