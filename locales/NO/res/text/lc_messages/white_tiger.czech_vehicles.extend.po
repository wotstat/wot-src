msgid "Chassis_Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_descr"
msgstr "Denne Pojistkaen er et helt mobilt verksted på belter. Skarpe vinkler, ryddige ledninger og hvert eneste system svarer på første forsøk. Vi rykket ut for å stoppe én gal vitenskapsmann og endte opp mot noe han kaller elektrisk intelligens. Vokterne hans lærer fortsatt og følger med på hvert eneste trekk vi gjør. Han bygde dem for å erstatte oss. Greit. Da er dagens leksjon min. Jeg finner en åsrygg, sikter meg inn på et mål og lar disse glisende granatene gjøre resten. Hvis han virkelig tror at tenkemaskinen hans kan overleve oss så får vi se hva den pønsker ut når presset øker."

msgid "Cz04_T50_51_Waf_Hound_3DSt_short"
msgstr "Pojistka"

msgid "Cz04_T50_51_Waf_Hound_3DSt_short_special"
msgstr "Større modernisering av hovedtanksen"

