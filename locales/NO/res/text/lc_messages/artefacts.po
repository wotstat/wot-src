msgstr "Eksospolstring"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Øker skjuleevnen for et stasjonært eller mobilt kjøretøy"

msgid "additionalInvisibilityDevice/long_special"
msgstr "Effektiviteten avhenger av kjøretøytypen. Øker skjuleevnen for et stasjonært eller kjøretøy i bevegelse. Nyttig til aktiv oppdagelse, og også for passiv oppdagelse fra risikable posisjoner."

msgid "additionalInvisibilityDevice/name"
msgstr "Lyddempet eksossystem"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Øker skjuleevnen for et stasjonært eller kjøretøy i bevegelse."

msgid "additionalInvisibilityDevice_tier1/name"
msgstr "Lyddempet eksossystem 1. klasse"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Lyddempet eksossystem 2. klasse"

msgid "additionalInvisibilityDevice_tier3/name"
