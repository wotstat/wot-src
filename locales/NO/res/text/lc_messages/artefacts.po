msgid "artillery/longDescr"
msgstr "Beordrer artilleri til å skyte på et mindre område med HE granater. Kjøretøy i midten av nedslagsområdet får mest skade. Spesielt effektiv mot tungt pansrede kjøretøy."

msgid "artillery/name"
msgstr "Artilleriangrep"

msgid "artillery/shortDescr"
msgstr "Forårsaker betydelig skade på fiendtlige kjøretøy innenfor en liten radius."

msgid "autoExtinguishers/always"
msgstr "%(vehicleFireChance)s mindre sjanse for motorbrann"

msgid "autoExtinguishers/descr"
msgstr "Slukker brann automatisk i kjøretøyet ditt."

msgid "autoExtinguishers/long_special"
msgstr "Slukker automatisk brann i tillegg til at sjansen for at kjøretøyet kommer i brann reduseres. Dette forbruksmateriellet passer til alle typer kjøretøy fra en hvilken som helst nasjon."

msgid "autoExtinguishers/name"
msgstr "Automatisk brannslukkingsanlegg"

msgid "autoExtinguishers/onUse"
msgstr "Automatisk brannslukking i ditt kjøretøy. Kan benyttes flere ganger i én kamp. Forbruksvaren fjernes etter en kamp hvis den ble benyttet minst én gang."

msgid "autoExtinguishers/restriction"
msgstr "?empty?"

msgid "autoExtinguishers/short_special"
msgstr "Automatisk brannslukking"

msgid "berserker/battleDescr"
msgstr "Øker penetrasjon og skuddtakt %(gunPiercing)s ganger, samtidig med at den også øker kanonkontrollerens og stabilisatorens effektivitet med %(gunAimingTime)s, men fjerner %(healthDebuff)s av ditt kjøretøys helsepoeng under dets %(duration)s s varighet.\n\n*Skade forårsaket av berserker evnen kan ikke bekjempe ditt kjøretøy."

msgid "berserker/descr"
msgstr "Øker penetration og skuddtakt %(gunPiercing)s ganger, samtidig med at den også øker effektviteten for kanonkontrollerens effektivitet og stabilitet med %(gunAimingTime)s, men tar vekk %(healthDebuff)s av ditt kjøretøys helsepoeng under dets %(duration)s s varighet.\n\n*Skade forårsaket av berserker evnen kan ikke bekjempe ditt kjøretøy."

msgid "berserker/longDescr"
msgstr "Øker penetrasjon og skuddtakt {green_Open}%(gunPiercing)s ganger{green_Close}, samtidig med at den også øker kanonkontrollerens effektivitet og stabilitet {green_Open}med %(gunAimingTime)s{green_Close}, men tar vekk {red_Open}%(healthDebuff)s{red_Close} av ditt kjøretøys totale mengde helsepoeng under dets {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} varighet.\n\n*Skade forårsaket av berserker evnen kan ikke bekjempe ditt kjøretøy."

msgid "berserker/name"
msgstr "Berserker"

msgid "berserker/shortDescr"
msgstr "Øker penetrasjon og skuddtakt {green_Open}%(gunPiercing)s ganger{green_Close}, samtidig med at den også øker kanonkontrollerens effektivitet og stabilitet {green_Open}med %(gunAimingTime)s{green_Close}, men tar vekk {red_Open}%(healthDebuff)s{red_Close} av ditt kjøretøys totale mengde helsepoeng under dets {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} varighet.\n\n*Skade forårsaket av berserker evnen kan ikke bekjempe ditt kjøretøy."

msgid "blackout_headlights_1/name"
msgstr "Frontlyktdimming (Type 1)"

msgid "bomber/longDescr"
msgstr "Beordrer et bakkeangrep fra fly til å slippe bomber i det utvalgte området, sjokker og forårsaker skade på fiendtlige kjøretøy. Kjøretøy i midten av nedslagsområdet får mest skade. Spesielt effektiv mot lett og medium pansrede kjøretøy."

msgid "bomber/name"
msgstr "Luftangrep"

msgid "bomber/shortDescr"
msgstr "Sjokker fiendtlige kjøretøy og forårsaker medium skade i et stort område."

msgid "brRegenerationKit/battleDescr"
msgstr "Gjenoppretter gradvis %(healPerTickDuration)s av kjøretøyets helsepoeng i løpet av %(duration)s s. Kan bli avbrutt/utsatt dersom man tar skade."

msgid "brRegenerationKit/descr"
msgstr "Gjenoppretter gradvis %(healPerTickDuration)s av kjøretøyets helsepoeng i løpet av %(duration)s s. Kan bli avbrutt/utsatt dersom man tar skade."

msgid "brRegenerationKit/long_special"
msgstr "{green_Open}Gjenoppretter gradvis %(healPerTickDuration)s{green_Close} av kjøretøyets helsepoeng {whiteSpanish_Open}i løpet av %(duration)s s{whiteSpanish_Close}. Kan bli avbrutt/utsatt dersom man tar skade."

msgid "brRegenerationKit/name"
msgstr "Gjenfødelse"

msgid "brRegenerationKit/short_special"
msgstr "{green_Open}Gjenoppretter gradvis %(healPerTickDuration)s{green_Close} av kjøretøyets helsepoeng {whiteSpanish_Open}i løpet av %(duration)s s{whiteSpanish_Close}. Kan bli avbrutt/utsatt dersom man tar skade."

msgid "brRepairkit/descr"
msgstr "Reparer moduler og fjerner negative effekter."

msgid "brRepairkit/long_special"
msgstr "Reparer moduler og fjerner negative effekter."

msgid "brRepairkit/name"
msgstr "Reparasjonssett"

msgid "brRepairkit/short_special"
msgstr "Reparer moduler og fjerner negative effekter."

msgid "br_bomber/battleDescr"
msgstr "Sjokker og forårsaker %(minDamage)s til %(maxDamage)s helsepoeng i skade på fiendtlige kjøretøy. Kjøretøy i midten av nedslagsområdet skades mer alvorlig.\n\n*Det er en %(delay)s s forsinkelse før nedslaget kommer."

msgid "br_bomber/descr"
msgstr "Sjokker og forårsaker %(minDamage)s til %(maxDamage)s helsepoeng i skade på fiendtlige kjøretøy. Kjøretøy i midten av nedslagsområdet skades mer alvorlig.\n\n*Det er en %(delay)s s forsinkelse før nedslaget kommer."

msgid "br_bomber/longDescr"
msgstr "Sjokker og forårsaker {whiteSpanish_Open}%(minDamage)s til %(maxDamage)s helsepoeng i skade{whiteSpanish_Close} på fiendtlige kjøretøy. Kjøretøy i midten av nedslagsområdet skades mer alvorlig.\n\n*Det er en %(delay)s s forsinkelse før nedslaget kommer."

msgid "br_bomber/name"
msgstr "Luftangrep"

msgid "br_bomber/shortDescr"
msgstr "Sjokker og forårsaker {whiteSpanish_Open}%(minDamage)s til %(maxDamage)s helsepoeng i skade{whiteSpanish_Close} på fiendtlige kjøretøy. Kjøretøy i midten av nedslagsområdet skades mer alvorlig.\n\n*Det er en %(delay)s s forsinkelse før nedslaget kommer."

msgid "br_minefield/battleDescr"
msgstr "Utplasserer et aktivt minefelt i det valgte området i %(duration)s s. Fiendtlige kjøretøy som kommer i kontakt med minene vil bli lammet og ta skade fra eksplosiver.\n\n*Miner kan ødelegges ved å skyte på dem. Miner som plasseres rett under fiendtlige kjøretøy vil IKKE eksplodere."

msgid "br_minefield/descr"
msgstr "Utplasserer et aktivt minefelt i det valgte området i %(duration)s s. Fiendtlige kjøretøy som kommer i kontakt med minene vil bli lammet og ta skade fra eksplosiver.\n\n*Miner kan ødelegges ved å skyte på dem. Miner som plasseres rett under fiendtlige kjøretøy vil IKKE eksplodere."

msgid "br_minefield/longDescr"
msgstr "Utplasserer et aktivt minefelt i det valgte området {whiteSpanish_Open}i %(duration)s s{whiteSpanish_Close}. Fiendtlige kjøretøy som kommer i kontakt med minene vil bli lammet og ta skade fra eksplosiver.\n\n*Miner kan ødelegges ved å skyte på dem. Miner som plasseres rett under fiendtlige kjøretøy vil IKKE eksplodere."

msgid "br_minefield/name"
msgstr "Minefelt"

msgid "br_minefield/shortDescr"
msgstr "Utplasserer et aktivt minefelt i det valgte området {whiteSpanish_Open}i %(duration)s s{whiteSpanish_Close}. Fiendtlige kjøretøy som kommer i kontakt med minene vil bli lammet og ta skade fra eksplosiver.\n\n*Miner kan ødelegges ved å skyte på dem. Miner som plasseres rett under fiendtlige kjøretøy vil IKKE eksplodere."

msgid "br_respawn/name"
msgstr "Gjenfødelse"

msgid "br_respawn/platoon/descr"
msgstr "Gjør at du kan komme deg tilbake i kamp etter at kjøretøyet ditt har blitt bekjempet. Denne mekanismen fungerer de første %(duration)s min i en kamp.\n\nFor at en alliert skal kunne bli gjenfødt, ikke delta i kamphandlinger i %(timeToResurrect)s s. Gjenfødelsesladninger deles mellom troppsmedlemmer."

msgid "br_respawn/solo/descr"
msgstr "Gjør at du kan komme deg tilbake til kamp etter at kjøretøyet ditt har blitt bekjempet. Denne mekanismen fungerer de første %(duration)s min av en kamp.\n\nSå snart du blir bekjempet, gjenfødes kjøretøyet ditt automatisk."

msgid "br_smoke/battleDescr"
msgstr "Legger til %(duration)s sekunders bonus på skjuleevnen på alle kjøretøy innen forbruksmateriellets rekkevidde."

msgid "br_smoke/descr"
msgstr "Legger til en bonus på skjuleevnen på alle kjøretøy innen forbruksmateriellets rekkevidde."

msgid "br_smoke/longDescr"
msgstr "Legger til %(duration)s sekunders bonus på skjuleevnen på alle kjøretøy innen forbruksmateriellets rekkevidde."

msgid "br_smoke/name"
msgstr "Røykteppe"

msgid "br_smoke/shortDescr"
msgstr "Legger til en bonus på skjuleevnen på alle kjøretøy innen forbruksmateriellets rekkevidde."

msgid "br_smoke_with_damage/battleDescr"
msgstr "Legger til en bonus på skjuleevne for alle kjøretøy innenfor rekkevidden til forbruksmateriellet, i tillegg til at det skader ALLE kjøretøy innenfor dets rekkevidde med %(damagePerTick)s av deres totale mengde helsepoeng per sekund. Varer i %(duration)s s.\n\n*Skade fra korrosiv tåke forstyrrer ikke innsamling av gevinst og bekjemper ikke kjøretøy, de får alltid beholde minst 1 helsepoeng."

msgid "br_smoke_with_damage/descr"
msgstr "Legger til en bonus på skjuleevne for alle kjøretøy innenfor rekkevidden til forbruksmateriellet, i tillegg til at det skader ALLE kjøretøy innenfor dets rekkevidde med %(damagePerTick)s av deres totale mengde helsepoeng per sekund. Varer i %(duration)s s.\n\n*Skade fra korrosiv tåke forstyrrer ikke innsamling av gevinst og bekjemper ikke kjøretøy, de får alltid beholde minst 1 helsepoeng."

msgid "br_smoke_with_damage/longDescr"
msgstr "Legger til en bonus på skjuleevne for alle kjøretøy innenfor rekkevidden til forbruksmateriellet, i tillegg til at det skader ALLE kjøretøy innenfor dets rekkevidde {whiteSpanish_Open}med %(damagePerTick)s{whiteSpanish_Close} av deres totale mengde helsepoeng per sekund. Varer i {whiteSpanish_Open}%(duration)s s.{whiteSpanish_Close}\n\n*Korrosiv tåke hverken forstyrrer innsamling av gevinst eller bekjemper kjøretøy, de får alltid beholde minst 1 helsepoeng."

msgid "br_smoke_with_damage/name"
msgstr "Korroderende tåke"

msgid "br_smoke_with_damage/shortDescr"
msgstr "Legger til en bonus på skjuleevne for alle kjøretøy innenfor rekkevidden til forbruksmateriellet, i tillegg til at det skader ALLE kjøretøy innenfor dets rekkevidde {whiteSpanish_Open}med %(damagePerTick)s{whiteSpanish_Close} av deres totale mengde helsepoeng per sekund. Varer i {whiteSpanish_Open}%(duration)s s.{whiteSpanish_Close}\n\n*Korrosiv tåke hverken forstyrrer innsamling av gevinst eller bekjemper kjøretøy, de får alltid beholde minst 1 helsepoeng."

msgid "builtinRepairkit/always"
msgstr "%(vehicleRepairSpeed)s raskere reparasjon av modul"

msgid "builtinRepairkit/long_special"
msgstr "Reparerer alle skadede moduler ved aktivering. Den passive effekten øker reparasjonshastigheten. Dette forbruksmateriellet passer til noen bestemte kjøretøy."

msgid "builtinRepairkit/name"
msgstr "Stort standard reparasjonssett"

msgid "builtinRepairkit/onUse"
msgstr "Reparasjon av alle skadde moduler. Kan benyttes flere ganger i løpet av én kamp. Kan ikke brukes opp.\nDette forbruksmateriellet kan ikke fjernes, men den kan flyttes til en annen plassholder."

msgid "builtinRepairkit/restriction"
msgstr "?empty?"

msgid "camouflageBattleBooster/action/boost"
msgstr "Gir ytterligere 10% skjuleevne på kjøretøy"

msgid "camouflageBattleBooster/action/perk"
msgstr "Gjør at fordelen skjuleevne er trent til 100% for alle besetningsmedlemmene"

msgid "camouflageBattleBooster/long_special"
msgstr "Fordelen skjuleevne reduserer hvor synlig et kjøretøy er, både under bevegelse og stasjonært, gjennom hele kampen. Så snart fordelen er trent til 100%, vil direktivet øke dens effekt; hvis ikke, gjør direktivet at ditt kjøretøy har fordelen trent til 100%."

msgid "camouflageBattleBooster/name"
msgstr "Naturlig dekke"

msgid "camouflageBattleBooster/short_special"
msgstr "Gjør at fordelen skjuleevne er trent til 100% eller øker dets effekt"

msgid "camouflageNet/battleDescr"
msgstr "Øker skjuleevnen til et stasjonært kjøretøy 3 s etter at det stoppet"

msgid "camouflageNet/long_special"
msgstr "Effektiviteten avhenger av kjøretøytypen. Kamuflasjenett er hovedsaklig nyttig for kjøretøy som har behov for å gjemme seg: SPGer og panserjagere med lav silhouett. Det øker effekten på skjuleevnen. Å kombinere dem vil gavne ditt kjøretøy med en god bonus. Kamuflasjenett aktiveres 3 sekunder etter at kjøretøyet har stoppet."

msgid "camouflageNet/name"
msgstr "Kamuflasjenett"

msgid "camouflageNet/short_special"
msgstr "Øker skjuleevnen for et stasjonært kjøretøy"

msgid "camouflageNet_tier2/name"
msgstr "Kamuflasjenett 2. klasse"

msgid "camouflageNet_tier3/name"
msgstr "Kamuflasjenett 3. klasse"

msgid "chocolate/always"
msgstr "{colorTagOpen}%(crewLevel)s{colorTagClose}på bonusen for besetningseffektivitet gjennom hele kampen."

msgid "chocolate/descr"
msgstr "{colorTagOpen}+10%{colorTagClose} på bonusen for besetningseffektivitet."

msgid "chocolate/long_special"
msgstr "Automatisk aktivert i begynnelsen av kampen og gir effekt gjennom hele kampen. Passer kun til tyske kjøretøy."

msgid "chocolate/name"
msgstr "Sjokolade"

msgid "chocolate/onUse"
