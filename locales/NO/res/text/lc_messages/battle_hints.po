msgid "hint/LSH_FIRE"
msgstr "Røyk gjør det vanskeligere å oppdage fiendtlige kjøretøy og å kommunisere posisjonene deres. Brann forårsaker skade på kjøretøy."

msgid "hint/LSH_FOG"
msgstr "Tåke kompliserer oppdagelse av fiendtlige kjøretøy og kommunisere posisjonene deres."

msgid "hint/LSH_RAIN"
msgstr "Tungt regn kompliserer oppdagelse av fiendtlige kjøretøy og kommunisere posisjonene deres."

msgid "hint/LSH_SANDSTORM"
msgstr "Sandstormer kompliserer oppdagelse av fiendtlige kjøretøy og kommunisere posisjonene deres."

msgid "hint/LSH_SMOKE"
msgstr "Røyk kompliserer oppdagelse av fiendtlige kjøretøy og kommunisere posisjonene deres."

msgid "hint/PPH_AIMING_01"
msgstr "Kjøretøyet og tårnets bevegelse reduserer <font color='#EE7000'>kanonens presisjon</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Sirkelen rundt siktet indikerer <font color='#EE7000'>kanonens presisjon</font>. Vent litt lenger for å få et mer presist skudd."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Autosikte</font> er aktivert. Klikk høyre museknapp for å deaktivere."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Autosiktet sikter alltid kanonen din <font color='#EE7000'>mot midten</font> av det målangitte kjøretøyet"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Basen din blir <font color='#EE7000'>erobret!</font> Dersom ingen fra ditt lag slår tilbake, vil fienden vinne kampen."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Hvert fiendtlige kjøretøy har <font color='#EE7000'>sin egen</font> erobringsfremgang"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Å erobre</font> fiendens base er en av måtene du kan vinne kampen på"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Når du tar skade, blir erobringsprosessen din <font color='#EE7000'>nullstilt</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Når du førlater basesirkelen, <font color='#EE7000'>forsvinner</font> erobringsfremgangen din"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Flere kjøretøy erobrer en base <font color='#EE7000'>raskere</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Etter det <font color='#EE7000'>tredje</font> kjøretøyet, øker ikke erobringshastigheten mer"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Fiendens base er nesten erobret!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Laget ditt vinner baseerobringskappløpet!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Modul på kjøretøyet har kritisk skade! Reparer den med <font color='#EE7000'>reparasjonssettet</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Modul på kjøretøyet har kritisk skade! Reparer den med <font color='#EE7000'>reparasjonssettet</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Besetningsmedlem skadd! Behandle dem med <font color='#EE7000'>førstehjelpssettet</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Besetningsmedlem skadd! Behandle dem med <font color='#EE7000'>førstehjelpssettet</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Kjøretøyets besetningsmedlemmer har blitt sjokket! Behandle dem med <font color='#EE7000'>førstehjelpssettet</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Kjøretøyet brenner! Bruk <font color='#EE7000'>brannslukkeren</font> fra panelet nederst."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Kjøretøyet brenner! Automatisk <font color='#EE7000'>brannslukker</font> aktivert."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "En modul på kjøretøyet har kritisk skade! Å utstyre det med <font color='#EE7000'>et reparasjonssett</font> før kamp hjelper deg med å håndtere kritiske treff."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Besetningsmedlem er skadd! Å utstyre kjøretøyet med <font color='#EE7000'>et førstehjelpssett</font> før kamp gjør det mulig å behandle skadde besetningsmedlemmer."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Kjøretøyet brenner! Å utstyre kjøretøyet med <font color='#EE7000'>en brannslukker</font> før kamp gjør det mulig å slukke branner."

msgid "hint/PPH_OTHER_01"
msgstr "Du har blitt <font color='#EE7000'>oppdaget</font>—å avfyre skudd kan avsløre posisjonen din!"

msgid "hint/PPH_OTHER_02"
msgstr "Kjøretøyet ditt ble bekjempet. Du kan trykke <font color='#EE7000'>Esc</font> for å forlate kampen uten å bli straffet for det."

msgid "hint/PPH_OTHER_03"
msgstr "Kjøretøyet ditt ble bekjempet. Du kan trykke på museknappen for å <font color='#EE7000'>se på</font> dine allierte."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Lyspæreikonet</font> viser at du har blitt oppdaget av fiender!"

msgid "hint/PPH_OTHER_05"
msgstr "Kanonen din holder fremdeles på med å <font color='#EE7000'>lade om</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Kanonen din kan kun avfyres dersom sirkelen rundt siktet er <font color='#EE7000'>helt grønn</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Du kan skrolle musehjulet for å komme inn i <font color='#EE7000'>snikskyttermodus</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Du kan skrolle musehjulet for å <font color='#EE7000'>forlate</font> snikskyttermodusen"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Et <font color='#EE7000'>grønt indre siktepunkt</font> indikerer en høy sjanse for penetrasjon av fiendens pansring"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Selv når det indre siktepunktet er grønt, er panserpenetrasjon <font color='#EE7000'>ikke garantert</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Kanoner er ikke 100% presise, så skudd <font color='#EE7000'>havner ikke alltid i midten</font> av siktet"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Det indre siktepunktet indikerer sjansen for penetrasjon av fiendtlig pansring. <font color='#EE7000'>Aktiver det i innstillingene</font>."

msgid "penetration/chance/high"
msgstr "Høy sjanse"

msgid "penetration/chance/low"
msgstr "Lav sjanse"

msgid "penetration/chance/medium"
msgstr "Medium sjanse"
