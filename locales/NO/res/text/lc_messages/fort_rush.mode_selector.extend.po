msgid "mode/fort_rush_battle/condition"
msgstr "7 mot 7 %(parSecondary_open)sI%(parSecondary_close)s nivå&nbsp;10"

msgid "mode/fort_rush_battle/description"
msgstr "Ta kontroll over antennene. Behold kontrollen over nettverket. Sikre deg sendingen."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Ytelsen på din datamaskin er ikke god nok for denne modusen. Det kan hende du vil oppleve feil på grafikk og kjøretøybevegelser. Det er også mulig at spillklienten vil krasje."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Lav ytelse"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Lav ytelse"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Denne modusen krever høy ytelse fra datamaskinen. Du vil oppleve problemer med kartvisning, grafikk og kjøretøybevegelser. I tilfelle utilstrekkelig ytelse, prøv lavere grafikkinnstillinger."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Redusert ytelse"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Redusert ytelse"
