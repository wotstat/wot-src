msgid "punishmentWindow/message/ban/comp7"
msgstr "Du brøt reglene i spillet på {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartet klokken {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Rangeringspoeng har blitt fjernet og du har midlertidig blitt blokkert fra å spille kamper i {whiteSpanish_Open}Onslaught{whiteSpanish_Close} modusen."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Du brøt reglene i spillet på {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartet klokken {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nDu har midlertidig blitt blokkert fra å spille kamper i {whiteSpanish_Open}Onslaught{whiteSpanish_Close} modusen og rangeringen din har blitt redusert."
