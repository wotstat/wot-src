msgid "serviceChannelMessages/resourceWell/enabled/text"
msgstr "Monteringsbutikken er åpen igjen!"

msgid "serviceChannelMessages/resourceWell/end/text"
msgstr "Vi begynner å jobbe på det neste prosjektet. Vi lar deg få vite når vi avslutter utviklingen. Ser deg snart!"

msgid "serviceChannelMessages/resourceWell/end/title"
msgstr "Monteringsbutikken stenger"

msgid "serviceChannelMessages/resourceWell/noSerialVehicles/text"
msgstr "Levering av kjøretøy i tallserie er komplett. Vi begynner å sette sammen %(vehicle)s i en standard konfigurasjon. Skynd deg—antall kjøretøy er begrenset!"

msgid "serviceChannelMessages/resourceWell/noVehicles/text"
msgstr "Monteringen av kjøretøy er fullført. Alle kjøretøyene har blitt levert til sine eiere."

msgid "serviceChannelMessages/resourceWell/noVehicles/title"
msgstr "Rapport fra monteringsbutikken"

msgid "serviceChannelMessages/resourceWell/noVehicles/twoParallelProducts/text"
msgstr "Leveringen av %(soldOutVehicle)s er fullført. Du har fremdeles muligheten til å kjøpe %(availableVehicle)s. Dersom du har brukt ressurser men ikke fullfører kjøpet i tide, blir de returnert kontoen din snarlig. Skynd deg—antall kjøretøy er begrenset!"

msgid "serviceChannelMessages/resourceWell/noVehiclesWithReturn/text"
msgstr "Montering av kjøretøy er fullført. Alle kjøretøyene har blitt levert til sine eiere. Alle brukte ressurser blir returnert til kontoen din snarlig."

msgid "serviceChannelMessages/resourceWell/oneVehicleStart/text"
msgstr "Kommandør, du har sjansen til å bli eieren av %(vehicle)s i en tallserie med 3D stil. Antall kjøretøy er begrenset!"

msgid "serviceChannelMessages/resourceWell/pause/text"
msgstr "Monteringsbutikken er midlertidig utilgjengelig på grunn av vedlikehold."

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/additionalText"
msgstr "Stil nummer: %(serialNumber)s"

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/text"
msgstr "Den unike %(vehicle)s er mottatt fra monteringsbutikken."

msgid "serviceChannelMessages/resourceWell/reward/title"
msgstr "%(vehicle)s mottatt!"

msgid "serviceChannelMessages/resourceWell/reward/vehicle/text"
msgstr "%(vehicle)s er mottatt fra monteringsbutikken."

msgid "serviceChannelMessages/resourceWell/start/title"
msgstr "Monteringsbutikken åpner"

msgid "serviceChannelMessages/resourceWell/twoVehiclesStart/text"
msgstr "Kommandør, dette er din mulighet til å skaffe deg %(firstVehicle)s og %(secondVehicle)s! Men vær rask—begrenset antall på lager!"
