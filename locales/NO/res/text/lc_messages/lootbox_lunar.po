msgid "confirmResetLootBoxStatistics/description"
msgstr "All informasjon om åpnede Blazing Treasures vil bli slettet."

msgid "entryPoint/boxes"
msgstr "TIL BLAZING TREASURES"

msgid "entryPoint/tooltip/description"
msgstr "Dette er spesielle esker som inneholder nye og unike enheter, inkludert premiumkjøretøy, 2D stiler og mer. Du kan få dem i butikken i spillet."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Blazing Treasures kan ikke åpnes eller kjøpes akkurat nå av tekniske årsaker. Vi beklager den midlertidige ulempen."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Blazing Treasures midlertidig utilgjengelig"

msgid "eventName/lowerCase"
msgstr "MÅNEUTBYTTE"

msgid "eventName/upperCase"
msgstr "MÅNEUTBYTTE"

msgid "guaranteedTitle/nextBox"
msgstr "Garantert belønning i den neste Blazing Treasure!"

msgid "guaranteedTitle/text"
msgstr "Maksimalt antall Blazing Treasures før en garantert belønning: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Dersom du ikke åpner Blazing Treasures før eventet er over, blir de åpnet automatisk."

msgid "infoPage/footer/description/compensation"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i Blazing Treasures, vil alle påfølgende kjøretøy du får fra Blazing Treasures bli kompensert med gull tilsvarende deres fulle verdi."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s. Blazing Treasure garanteres å inneholde et kjøretøy på nivå 8–9. Dersom du åpner dem uten at et slikt kjøretøy blir sluppet, så vil et kjøretøy på nivå 8–9 som du ikke har fra før bli sluppet når du åpner den %(guaranteed0)s&zwnbsp;. Blazing Treasure. Når den så slipper et kjøretøy, nullstilles telleren."

msgid "infoPage/header/description"
msgstr "Åpne Blazing Treasures for sjansen til å få verdifulle enheter til bruk i spillet! Se flere detaljer under."

msgid "multipleRewardView/header/subTitle/"
msgstr "Fra %(name) (%(boxesCount) åpnede Blazing Treasures)"

msgid "noBoxesView/description/"
msgstr "Du har ingen Blazing Treasures.\nDu kan få dem i butikken i spillet."

msgid "preview/backLabel"
msgstr "TIL BLAZING TREASURES"

msgid "quantityTitle/boxesAvailable"
msgstr "Tilgjengelige Blazing Treasures: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "Ingen tilgjengelige Blazing Treasures"

msgid "singleRewardView/tooltip/description/"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i Blazing Treasures, vil alle påfølgende kjøretøy du får fra Blazing Treasures bli kompensert med gull."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) Blazing Treasure"
msgstr[1] "%(remainingCount) Blazing Treasures"
msgstr[2] "%(remainingCount) Blazing Treasures"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Den garanterte belønningen er et kjøretøy fra listen over mulig innhold i Blazing Treasures.\nDersom du åpner %(remainingCount) uten å få et slikt kjøretøy, får du den når du åpner den %(count). Blazing Treasure. Når den gjør det, nullstilles telleren."
