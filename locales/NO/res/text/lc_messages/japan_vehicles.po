msgid "Chi_Ni"
msgstr "Chi-Ni"

msgid "Chi_Ni_descr"
msgstr "Utviklet av Osaka Artilleriarsenal for å erstatte Type 2589. Chi-Ni og Chi-Ha gjennomgikk kombinerte tester i 1937. Chi-Ha ble vurdert til å være best. Én prototype ble laget."

msgid "Chi_Ni_short"
msgstr "Chi-Ni"

msgid "Chi_Nu_Kai"
msgstr "Type 3 Chi-Nu Kai"

msgid "Chi_Nu_Kai_descr"
msgstr "Type 3 Chi-Nu Kai medium tanks er en kombinasjon av Type 3 Chi-Nu sitt oppheng og tårn med Type 4 Chi-To sin kanon. Bare én prototype ble laget. Den var klar for testing i mars 1945."

msgid "Chi_Nu_Kai_long_special"
msgstr "Dette er en standard medium tanks som ikke har noen betydelige fordeler eller ulemper. Den passer til de fleste kampsituasjoner."

msgid "Chi_Nu_Kai_short"
msgstr "Chi-Nu Kai"

msgid "Chi_Nu_Kai_short_special"
msgstr "Høy presisjon, penetrasjon, god pansring av kanonfestet"

msgid "Continental_AOSI_1195_6"
msgstr "Continental AOSI-1195-6"

