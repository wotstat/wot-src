msgid "alert"
msgstr "Du kan ikke velge en kampreserve mens du er i aktiv kamp."

msgid "description/one/reserve"
msgstr "Å velge reserven %(reserve_name)s gjentatte ganger\nforbedrer dens karakteristika."

msgid "description/second/reserve"
msgstr "Å velge %(first_reserve_name)s eller %(second_reserve_name)s gjentatte ganger\nvil forbedre karakteristikaene for den som aktiveres."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Setter ut et aktivt minefelt i det valgte området i en viss tidsperiode."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Forårsaker betydelig skade på fiendtlige kjøretøy innenfor en liten radius."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Sjokker fiendtlige kjøretøy og forårsaker medium skade i et stort område."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Legger til en bonus på hovedkvalifikasjonene til spillerens og alliertes besetninger."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Gir bonus på erobringshastighet, erobringsblokkering og etterforsyning."

msgid "shortDescription/reserve/reconAbility"
msgstr "Oppdager fiendtlige kjøretøy og minefelt."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Gjenoppretter en bestemt prosentandel av ditt kjøretøys helsepoeng."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Skjuler alle kjøretøy som er inne i og bak røykteppet."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Gir en bonus på skjuleevne og synsrekkevidde. Reduserer skjuleevnen på fiendtlige kjøretøy."

msgid "title"
msgstr "Den %(number_name)s reserveplassholderen er tilgjengelig"
