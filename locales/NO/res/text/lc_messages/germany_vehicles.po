msgid "PzVI_MapsTraining_Player_HT_2"
msgstr "Tiger I (tr.)"

msgid "PzVI_Porsche_Turm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_Porsche_Turm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger\nAusf. E"

msgid "PzVI_Standardketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H1"

msgid "PzVI_Vetstaerktketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "Utviklingen av Tiger I ble påbegynt i 1937 av Henschel. Satt i masseproduksjon i 1942, med totalt 1354 ferdigstilte vogner. Stridsvognen så sine første kamphandlinger i kampene om Leningrad, og Tigere var i første linje i kamper fra Tunis til Kursk. Selv om produksjonen ble avsluttet sommeren 1944, var Tiger I i aksjon til slutten av krigen."

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

msgid "PzV_PzIV_CN"
msgstr "Pz.Kpfw. V Berge-Panther"

msgid "PzV_PzIV_CN_descr"
msgstr "Kjøretøyet ble produsert av Maintenance and Recovery Company of the 653rd Heavy Panzerjäger Battalion basert på Bergepanther ARV og tårnet til Pz. IV."

msgid "PzV_PzIV_CN_short"
msgstr "Pz. V BP"

msgid "PzV_PzIV_ausf_Alfa"
msgstr "Pz.Kpfw. V/IV Alpha"

msgid "PzV_PzIV_ausf_Alfa_CN"
