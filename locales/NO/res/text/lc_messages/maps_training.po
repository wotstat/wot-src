msgid "05_prohorovka/team1/heavyTank/descr"
msgstr "Nøkkelmålet for denne taktikken er å bryte gjennom via %(a_ht_alleyPhrase1).%(p)Langsmed %(a_ht_railwayPhrase) kan du ta skuddposisjoner i nærheten av %(a_ht_villagePhrase) som vil la deg kontrollere fienden på %(a_ht_mountainPhrase). Klarér disse stillingene og beveg deg trygt til %(a_ht_alleyPhrase2). Etter å ha vunnet i denne retningen, anbefales det at du benytter deg av ujevnheter i terrenget og selve vegetasjonen for å ta for deg de siste fiendtlige styrkene på %(a_ht_southernFieldsPhrase)."

msgid "05_prohorovka/team1/heavyTank/title"
msgstr "Angrep via avenyen"

msgid "05_prohorovka/team1/mediumTank/descr"
msgstr "Nøkkelmålet for denne taktikken er %(a_mt_mountainPhrase2).%(p)Mot den østre flanken, etter at du har krysset %(a_mt_railwayPhrase), anbefales det at du tar skuddposisjon på %(a_mt_mountainPhrase1). Herredømme i denne retningen gjør at du kan vinne kontroll over fiendtlige stillinger i %(a_mt_villagePhrase) og bak jernbanen. Hvis du kommer deg forover og bekjemper gjenværende motstand langsmed jernbanen kan du finne trygge posisjoner i terrenget på %(a_mt_southernFieldsPhrase) for å skyte mot fiendtlige kjøretøy på %(a_mt_alleyPhrase)."

msgid "05_prohorovka/team1/mediumTank/title"
msgstr "Angrep på fjellet"

msgid "05_prohorovka/team2/heavyTank/descr"
msgstr "Nøkkelmålet for denne taktikken er å bryte gjennom via %(b_ht_alleyPhrase1).%(p)Langsmed %(b_ht_railwayPhrase) kan du ta skuddposisjoner i nærheten av %(b_ht_villagePhrase) som vil la deg kontrollere fienden på %(b_ht_mountainPhrase). Klarér disse stillingene og beveg deg trygt til %(b_ht_alleyPhrase2). Etter å ha vunnet i denne retningen, anbefales det at du benytter deg av ujevnheter i terrenget og selve vegetasjonen for å ta for deg de siste fiendtlige styrkene på %(b_ht_northernFieldsPhrase)."

