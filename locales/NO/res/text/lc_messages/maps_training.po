msgid "02_malinovka/team1/heavyTank/descr"
msgstr "Nøkkelmålet for denne taktikken er %(a_ht_millMountainPhrase1).%(p)Du kan forflytte deg i dekning av den %(a_ht_southernForestPhrase), du kan klatre trygt opp ved å bevege deg så nær kartgrensen som mulig. Derettet må du umiddelbart ta %(a_ht_millMountainPhrase2) der du kan avfyre skudd mens du skjuler kjøretøyets skrog i terrenget. Å kontrollere dette fjellet vil også gjøre at du kan skyte på ankomstrutene til %(a_ht_villagePhrase) og flankere fienden. Steinene vil dekke deg for fiender som skjuler seg i den %(a_ht_northernForestPhrase). De sikrede skogene åpner opp ruta til Base 2."

msgid "02_malinovka/team1/heavyTank/title"
msgstr "Angrep på vindmølla"

msgid "02_malinovka/team1/mediumTank/descr"
msgstr "Nøkkelmålet for denne taktikken er %(a_mt_ledgePhrase1).%(p)Å komme seg til %(a_mt_swampPhrase), gjør at du kan ta %(a_mt_elevationPhrase) der du kan treffe fienden på %(a_mt_ledgePhrase2). Deretter, mens du kjører gjennom vann, kan du klemme deg opp mot kanten og skyte på mål som kommer ned fra fjellet. Ved å ligge bak åsene og buskene på %(a_mt_ledgePhrase3) kan du oppdage og skyte på fiendtlige kjøretøy i den %(a_mt_northernForestPhrase) og i nærheten av basen. Etter å ha bekjempet fienden på flanken på %(a_mt_fieldPhrase), får du tilgang til en ubeskyttet Base 2."

msgid "02_malinovka/team1/mediumTank/title"
msgstr "Angrep på kanten"

msgid "02_malinovka/team2/heavyTank/descr"
msgstr "Nøkkelmålet for denne taktikken er %(b_ht_millMountainPhrase1).%(p)Du kan forflytte deg i dekning av den %(b_ht_southernForestPhrase), du kan klatre trygt opp ved å bevege deg så nær kartgrensen som mulig. Derettet må du umiddelbart ta %(b_ht_millMountainPhrase2) der du kan avfyre skudd mens du skjuler kjøretøyets skrog i terrenget. Å kontrollere dette fjellet vil også gjøre at du kan skyte på ankomstrutene til %(b_ht_villagePhrase) og flankere fienden. Steinene vil dekke deg for fiender som skjuler seg i den %(b_ht_northernForestPhrase). De sikrede skogene åpner opp ruta til Base 1."

msgid "02_malinovka/team2/heavyTank/title"
msgstr "Angrep på vindmølla"

msgid "02_malinovka/team2/mediumTank/descr"
msgstr "Nøkkelmålet for denne taktikken er %(b_mt_cowshedsPhrase1).%(p)Mens du forflytter deg på høyreflanken, kan du stille deg opp på den %(b_mt_northLedgePhrase) der du kan få fienden i motsatt oppstilling. Mens du fremdeles ikke er oppdaget kan du nå fiendtlige kjøretøy langs kanten av %(b_mt_fieldPhrase) og ta %(b_mt_cowshedsPhrase2). Vær forsiktig så du ikke faller ut i vannet. I dekning bak bygninger kan du angripe fiendtlige stillinger i nærheten av basen og deretter trygt forflytte deg til %(b_mt_swampPhrase) der kan du oppdage og treffe mål i den %(b_mt_southernForestPhrase)."

msgid "02_malinovka/team2/mediumTank/title"
msgstr "Feltangrep"

