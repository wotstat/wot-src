msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "DRAGEBÅTESKER"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "DRAGEBÅTESKER"

msgid "entryPoint/tooltip/description"
msgstr "Dette er spesialesker som inneholder unike og verdifulle enheter til bruk i spillet.\nDu kan skaffe deg esker i butikken i spillet eller i Premium Shop."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Dragebåtesker midlertidig utilgjengelig"

msgid "eventName/lowerCase"
msgstr "TEM DRAGEN, RI VINDEN"

msgid "eventName/upperCase"
msgstr "TEM DRAGEN, RI VINDEN"

msgid "infoPage/footer/description/compensation"
msgstr "Dersom du allerede eier alle kjøretøyene fra listen over mulig innhold i eskene, vil alle påfølgende kjøretøy du får fra dragebåteskene bli kompensert med gull tilsvarende deres fulle verdi."

msgid "infoPage/footer/description/guaranteed"
msgstr "Hver %(guaranteed0)s. dragebåteske garanteres å inneholde et kjøretøy på nivå 8–9. Dersom du åpner dem uten at et slikt kjøretøy blir sluppet, så vil et kjøretøy på nivå 8–9 som du ikke har fra før bli sluppet når du åpner den %(guaranteed0)s&zwnbsp;. dragebåtesken. Når den så slipper et kjøretøy, nullstilles telleren."

msgid "noBoxesView/description/"
msgstr "Du har ingen esker.\nDu kan få dem i butikken i spillet."
