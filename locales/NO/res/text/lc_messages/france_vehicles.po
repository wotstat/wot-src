msgid "RenaultFT_AC_descr"
msgstr "Da den franske hærens store beholdning av Renault FT tanks ble utdatert etter den 1. verdenskrig, ble det gjort noen forsøk på å oppgradere kjøretøyene. Ett forslag var å konvertere de til panserjagere, men planen ble aldri utført."

msgid "RenaultFT_AC_short"
msgstr "FT AC"

msgid "RenaultR35"
