msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_1"
msgstr "Anomālijas avots tuvojas. Protams tas ir liels resns tanks."

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_2"
msgstr "Iznīciniet to, un tās būs beigas. Uz priekšu puiši!"

msgid "ev_hw_24_bossfightIntroExposition_easy_Smith_1_3"
msgstr "Šaujiet pa vājajām vietām bruņās."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_1"
msgstr "Čaļi, liels neglīts monstrs tuvojas mūsu virzienā,"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_2"
msgstr "tāds, kādu mēs vēl nekad neesam redzējuši."

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_3"
msgstr "Šķiet, ka tā vājās vietas ir redzamas. Mums vajag"

msgid "ev_hw_24_bossfightIntroExposition_hard_Smith_1_4"
msgstr "iznīcināt bosu, lai iegūtu releju un pabeigtu misiju."

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_1"
msgstr "Šī ir mūsu laimīgā diena, puiši! Divi bosi viena vietā—"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_2"
msgstr "tas ir kaut kas jauns. Bet mēs tik un tā uzvarēsim. Uguni uz neaizsargātajām"

msgid "ev_hw_24_bossfightIntroExposition_medium_Smith_2_3"
msgstr "vietām viņu bruņās un atcerieties iznīcināt to miesassargus."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_1"
msgstr "Tas ir nopietns pretinieks, bet tam ir vājie punkti."

msgid "ev_hw_24_bossfightIntro_easy_Smith_1_2"
msgstr "Iznīcini šo radījumu, un viss būs beidzies. Ejam, puiši!"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_1"
msgstr "Šaujiet pa pretinieka vājajām vietām. Un atcerieties iznīcināt"

msgid "ev_hw_24_bossfightIntro_easy_Smith_2_2"
msgstr "tā pavadoņus, pretējā gadījumā lietas kļūs sarežģītas."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_1"
msgstr "Mums ir jāiznīcina boss, lai novērstu anomāliju."

msgid "ev_hw_24_bossfightIntro_easy_Smith_3_2"
msgstr "Mērķējiet uz tā bruņu vājajām vietām."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_1"
msgstr "Mums ir jāiznīcina pēdējais pretinieks, lai pabeigtu misiju."

msgid "ev_hw_24_bossfightIntro_hard_Smith_1_2"
msgstr "Šaujiet pa tā neaizsargātajām vietām."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_1"
msgstr "Šis ir pēdējais šķērslis mūsu ceļā."

msgid "ev_hw_24_bossfightIntro_hard_Smith_2_2"
msgstr "Savācieties, puiši! Iznīcināsim šo briesmoni!"

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_1"
msgstr "Ienaidnieks ir ļoti bīstams, taču tam ir savas vājās vietas."

msgid "ev_hw_24_bossfightIntro_hard_Smith_3_2"
msgstr "Šī ir mūsu iespēja to vienreiz un uz visiem laikiem piebeigt."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_1"
msgstr "Tagad redzēsim, ko anomālija mums ir sagatavojusi."

msgid "ev_hw_24_bossfightIntro_medium_Smith_1_2"
msgstr "Spēcīgs pretinieks, bet tam ir savas vājās vietas."

msgid "ev_hw_24_bossfightIntro_medium_Smith_2_1"
msgstr "Iznīcināsim šo zvēru, puiši!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_3_1"
msgstr "Šis ir ļoti spēcīgs pretinieks. Bet mēs to varam, es to zinu."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_1"
msgstr "Divi bosi par viena cenu šodien."

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_2"
msgstr "Nu, tas ir karsts darījums! Mērķējiet uz neaizsargātajām vietām"

msgid "ev_hw_24_bossfightIntro_medium_Smith_4_3"
msgstr "to bruņās. Iznīcināsim šos monstrus!"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_1"
msgstr "Izskatās, ka bosi nevarēja izdomāt kārtību un"

msgid "ev_hw_24_bossfightIntro_medium_Smith_5_2"
msgstr "ieradās šeit kopā. Abiem ir vājās vietas, mērķējiet uz tām."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_1"
msgstr "Atkal jauks bosu pāris. Puiši, jūs zināt ko darīt."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_2"
msgstr "Šaujiet pa viņu vājajām vietām un iznīciniet to palīgus."

msgid "ev_hw_24_bossfightIntro_medium_Smith_6_3"
msgstr "Esiet ātri!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_1"
msgstr "Mēs to sasitām diezgan spēcīgi, puiši!"

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_1_2"
msgstr "Bet izskatās, ka mēs vēl neesam pabeiguši."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_1"
msgstr "Forši! Bet mēs esam tikai pusceļā."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_2_2"
msgstr "Tas gatavojas atgriezties ar saviem draugiem."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_3_1"
msgstr "Tā to izdarīt! Saremontēsim tankus un dosimies atkal."

msgid "ev_hw_24_bossfightPhase2_easyHard_Smith_4_1"
msgstr "Tas nebūs tik viegli sakaujams. Sagatavojies otrajai kārtai."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_1_1"
msgstr "Mēs tiem smagi iesitām, puiši! Bet tas vēl nav beidzies."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_1"
msgstr "Forši! Bet mēs esam tikai pusceļā."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_2_2"
msgstr "Viņi gatavojas atgriezties ar saviem draugiem."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_3_1"
msgstr "Tā to izdarīt! Saremontēsim tankus un dosimies atkal."

msgid "ev_hw_24_bossfightPhase2_medium_Smith_4_1"
msgstr "Tie nebūs tik viegli sakaujami. Sagatavojies otrajai kārtai."

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_1"
msgstr "Runā kapteinis Smits. Kamēr mūsu puiši ārpus plaisas"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_2"
msgstr "aizkavē atbalss tanku uzbrukumu Babilonas kompleksam,"

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_3"
msgstr "mūsu misija ir iziet cauri visām fāzēm un novērst anomāliju. "

msgid "ev_hw_24_phase1introExposition_easy_Smith_1_4"
msgstr "Lai to izdarītu, mums ir jāpiepilda kolektori visās fāzēs. Braucam!"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_1"
msgstr "Dziļi Mirium telpā tika pamanīta ienaidnieka bāze. "

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_2"
msgstr "Viņi gatavo milzīgu armiju iebrukumam. Mūsu vienīgā iespēja"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_3"
msgstr "viņus apturēt nozīmē bloķēt viņu ceļu. Mūsu misija ir tikt"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_4"
msgstr "dziļā anomālijas fāzē un izvilkt releju, kas"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_5"
msgstr "noturot viņu ceļu vaļā. Uzlādējiet Magnus ar Mirium,"

msgid "ev_hw_24_phase1introExposition_hard_Smith_1_6"
msgstr "mēs dodamies uz beigām!"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_1"
msgstr "Sveicieni, visi! Mums ir jānoslēdz ceļš uz mūsu realitāti"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_2"
msgstr "atbalss tankiem. Par spiegiem var parūpēties pretizlūkošana"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_3"
msgstr "Babilonā — mūsu uzdevums ir Mirium. Uzpildiet kolektorus visās fāzēs,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_4"
msgstr "sasitiet tās lietas, kas mūs gaida lejā,"

msgid "ev_hw_24_phase1introExposition_medium_Smith_1_5"
msgstr "un aizveriet šo caurumu. Iedarbiniet savus dzinējus!"

msgid "ev_hw_24_phase1intro_easy_Smith_1_1"
msgstr "Smits runā. Mūsu uzdevums ir aiztaisīt plaisu Babilonas"

msgid "ev_hw_24_phase1intro_easy_Smith_1_2"
msgstr "kompleksā. Piepildiet kolektorus ar Mirium un iznīciniet"

msgid "ev_hw_24_phase1intro_easy_Smith_1_3"
msgstr "visu, kas neesam mēs. Ejam, puiši, ienaidnieks gaida!"

msgid "ev_hw_24_phase1intro_easy_Smith_2_1"
msgstr "Mūsu puiši neļauj Mirium tankiem izlauzties cauri"

msgid "ev_hw_24_phase1intro_easy_Smith_2_2"
msgstr "uz reālo pasauli. Tava misija ir aizvērt plaisu."

msgid "ev_hw_24_phase1intro_easy_Smith_2_3"
msgstr "Jo ātrāk, jo labāk. Savāc Mirium un aizlāpi šo caurumu."

msgid "ev_hw_24_phase1intro_easy_Smith_3_1"
msgstr "Ienaidnieka tanki uzbrūk Babilonas kompleksam. Tā netīrība "

msgid "ev_hw_24_phase1intro_easy_Smith_3_2"
msgstr "rāpo ārā no plaisas, un mums ir jābloķē viņu ceļš."

msgid "ev_hw_24_phase1intro_easy_Smith_3_3"
msgstr "Ejiet dziļi anomālijā un neitralizējiet tās avotu. Uz priekšu!"

msgid "ev_hw_24_phase1intro_hard_Smith_1_1"
msgstr "Smits runā. Mūsu misija ir noslēgt Vācu"

msgid "ev_hw_24_phase1intro_hard_Smith_1_2"
msgstr "atbalss tanku armiju anomālijas iekšpusē. Mūsu mērķis šobrīd ir"

msgid "ev_hw_24_phase1intro_hard_Smith_1_3"
msgstr "dziļajā fāzē. Piepildiet Magnus, lai to sasniegtu."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_1"
msgstr "Mirium telpas dziļumos tika atklāta ienaidnieka bāze."

msgid "ev_hw_24_phase1intro_hard_Smith_2_1_2"
msgstr "Viņi plāno savu uzbrukumu no turienes."

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_1"
msgstr "Nepievērsiet uzmanību mazajai meitenei. Mūsu misija ir aktivizēt"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_2"
msgstr "Magnus un atvērt ceļu visdziļākajā fāzē"

msgid "ev_hw_24_phase1intro_hard_Smith_2_3_3"
msgstr "lai mēs varētu iesprostot ienaidnieku tur iekšā uz visiem laikiem."

msgid "ev_hw_24_phase1intro_hard_Smith_3_1"
msgstr "Visdziļākajā fāzē tika pamanīta ienaidnieka bāze."

msgid "ev_hw_24_phase1intro_hard_Smith_3_2"
msgstr "Mēs nevaram viņus sakaut tagad, bet mēs varam viņus tur iesprostot."

msgid "ev_hw_24_phase1intro_hard_Smith_3_3"
msgstr "Savāc Mirium, lai pārietu uz šīs plaisas apakšdaļu."

msgid "ev_hw_24_phase1intro_hard_Smith_3_4"
msgstr "Es ticu jums, puiši! Mēs to varam!"

msgid "ev_hw_24_phase1intro_medium_Smith_1_1"
msgstr "Jauna plaisa atklājās drīz pēc pēdējās aizvēršanas."

msgid "ev_hw_24_phase1intro_medium_Smith_1_2"
msgstr "Mūsu misija paliek nemainīga: savākt matēriju un"

msgid "ev_hw_24_phase1intro_medium_Smith_1_3"
msgstr "aiztaisīt anomāliju, lai apturētu iebrukumu mūsu realitātē. Ejam!"

msgid "ev_hw_24_phase1intro_medium_Smith_2_1"
msgstr "Plaisa atkal ir atvērusies. Savāc matēriju un piepildi kolektoru."

msgid "ev_hw_24_phase1intro_medium_Smith_2_2"
msgstr "Mums ir jānovērš šī sasodītā anomālija. Puiši ārā"

msgid "ev_hw_24_phase1intro_medium_Smith_2_3"
msgstr "paļaujas uz mums, bet viņi nevarēs ilgi izturēt!"

msgid "ev_hw_24_phase1intro_medium_Smith_3_1"
msgstr "Babilonas kompleksam joprojām uzbrūk ienaidnieka tanki."

msgid "ev_hw_24_phase1intro_medium_Smith_3_2"
msgstr "Savāc matēriju un uzlādē Magnus. Mums jāslēdz"

msgid "ev_hw_24_phase1intro_medium_Smith_3_3"
msgstr "anomālija, lai apturētu atbalss tankus, kas iebrūk mūsu pasaulē."

msgid "ev_hw_24_phase2intro__Smith_2_1"
msgstr "Mūsu mērķis ir tuvu. Esiet modri un paturiet aci uz"

msgid "ev_hw_24_phase2intro__Smith_2_2"
msgstr "Nemirstīgā detektoru."

msgid "ev_hw_24_phase2intro__Smith_3_1"
msgstr "Labi darīts, puiši! Turiet tempu! Mēs neesam"

msgid "ev_hw_24_phase2intro__Smith_3_2"
msgstr "šeit tējas pauzē. Mums vajag vairāk Mirium."

msgid "ev_hw_24_phase2intro__Smith_4_1"
msgstr "Lielisks komandas darbs! Ejam tālāk, mums vajag vairāk Mirium."

msgid "ev_hw_24_phase2intro__Smith_5_1"
msgstr "Labs darbs! Mums ir jāaktivizē Magnus, lai dotos vēl dziļāk."

msgid "ev_hw_24_phase2intro_all_Smith_1_1"
msgstr "Mirium padara mūs stiprākus ar katru jaunu fāzi."

msgid "ev_hw_24_phase2intro_all_Smith_1_2"
msgstr "Tikai neaizraujies."

msgid "ev_hw_24_phase3intro__Smith_1_1"
msgstr "Mums jāaktivizē Magnus. Vēl tikai pēdējais grūdiens!"

msgid "ev_hw_24_phase3intro__Smith_2_1"
msgstr "Mūsu misija paliek nemainīga: mums ir jāpiepilda kolektors."

msgid "ev_hw_24_phase3intro__Smith_3_1"
msgstr "Mēs tuvojamies iebrukuma avotam."

msgid "ev_hw_24_phase3intro__Smith_3_2"
msgstr "Mūsu uzdevums ir tāds pats: piepildīt kolektoru."

msgid "ev_hw_24_phase3intro__Smith_4_2_1"
msgstr "Jauka dziesma. Palieciet koncentrējušies, puiši."

msgid "ev_hw_24_phase3intro__Smith_4_2_2"
msgstr "Mums ir jāsavāc Mirium un jāiet dziļāk."

msgid "narrator"
msgstr "Smits"
