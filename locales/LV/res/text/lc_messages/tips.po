msgstr "JAUNI TEMATISKI 3D STILI"

msgid "beCareful"
msgstr "Esiet uzmanīgi"

msgid "comp7Core10"
msgstr "Jūs variet mainīt uz piemērotāku tanku Pirmss Kaujas Sagatavošanās laikā."

msgid "comp7Core10Status"
msgstr "Pirms Kaujas Sagatavošanās"

msgid "comp7Core11"
msgstr "Pirms Kaujas Sagatavošanās ekrāns parāda jūsu tankus piepildītus ar apkalpi un čaulītēm. Neaizmirstiet sagatavot tos pirms došanās kaujā."

msgid "comp7Core11Status"
msgstr "Pirms Kaujas Sagatavošanās"

msgid "comp7Core12"
msgstr "Pēc jūsu tanka izvēlēšanās, ļaujiet jūsu sabiedrotajiem zināt noklikšķinot Apstiprināt Izvēli pogu."

msgid "comp7Core12Status"
msgstr "Pirms Kaujas Sagatavošanās"

msgid "comp7Core13"
msgstr "Pēc Apstiprināt Izvēli pogas nospiešanas, jūs nevarēsiet mainīt tankus."

msgid "comp7Core13Status"
msgstr "Apstipriniet Jūsu Izvēli"

msgid "comp7Core14"
msgstr "Sagūstiet īpašus punktus kartē, lai piekļūtu Taktiskajām Spējām un iegūtu pārākumu!"

msgid "comp7Core14Status"
msgstr "Galvenie Punkti"

msgid "comp7Core15"
msgstr "Galvenais Punkts kartē. Šīs lokācijas sagūstīšana ļaus jums izmantot Divīzijas Radara Taktisko Spēju. Pēc aktivizācijas, visi pretinieku tanki paliks pamanīti uz dažām sekundēm."

msgid "comp7Core15Status"
msgstr "Komunikācijas Centrs"

msgid "comp7Core16"
msgstr "Galvenais Punkts kartē. Šīs lokācijas sagūstīšana ļaus jums izmantot Artilērijas Trieciena Taktisko Spēju. Pēc aktivizācijas, spēlētājs var izvēlēties zonu, kur šaut ar artilērijas triecienu."

msgid "comp7Core16Status"
msgstr "Artilērijas Štābs"

msgid "comp7Core17"
msgstr "Ja Artilērijas Trieciena Taktiskā Spēja trāpa jūsu sabiedrotajiem, tie netiks bojāti. Taču tie tiks apdullināti."

msgid "comp7Core17Status"
msgstr "Artilērijas Trieciens"

msgid "comp7Core18"
msgstr "Lūdzu atcerieties: Kartes šajā režīmā var atšķirties no to Nejaušo Kauju līdziniekiem."

msgid "comp7Core18Status"
msgstr "Kartes Pasākumā"

msgid "comp7Core19"
msgstr "7 spēlētāju Vada izveidošana var uzlabot jūsu iespējas uzvarēt."

msgid "comp7Core19Status"
msgstr "Komandas Sadarbošanās ir Atslēga"

msgid "comp7Core21"
msgstr "Jūs variet apskatīt uzlādes līmeni jūsu sabiedroto Lomu Spējām kaujā nospiežot Tab vai Alt pogas."

msgid "comp7Core21Status"
msgstr "Visas Lomu Spējas"

msgid "comp7Core22"
msgstr "Jūs variet apskatīt komandas sarakstu, lai redzētu, vai jūsu sabiedrotie ir ieguvuši jebkādu Taktisko Spēju. Pretinieku Taktiskās Spējas netiek rādītas."

msgid "comp7Core22Status"
msgstr "Taktiskās Spējas"

msgid "comp7Core23"
msgstr "Ja Lomas Spēja ietekmē tanku, attiecīgā ikona tiks parādīta virs spēlētāja marķiera."

msgid "comp7Core23Status"
msgstr "Lomas Spējas Efekts"

msgid "comp7Core24"
msgstr "H poga (pēc noklusējuma) ieslēdz balss čatu. Izmantojiet šo funkciju, lai efektīvāk komunicētu ar jūsu komandu."

msgid "comp7Core24Status"
msgstr "Balss Čats"

msgid "comp7Core25"
msgstr "Ja jums ir problēmas ar balss čatu, apskatiet jūsu iestatījumus spēles klientā."

msgid "comp7Core25Status"
msgstr "Balss Čats"

msgid "comp7Core29"
msgstr "Nospiežot Alt, jebkura tanka loma jūsu redzamībā tiks parādīta virs spēlētāja marķiera. Sabiedroto spēlētājiem, jūs arī redzēsiet to Lomu Spējas uzlādes līmeni."

msgid "comp7Core29Status"
msgstr "Tanka Lomas"

msgid "comp7Core31"
msgstr "Jūs variet atkārtoti piešķirt pogas priekš Lomas un Taktiskajām Spējām spēles iestatījumos."

msgid "comp7Core31Status"
msgstr "Kontroles Iestatījumi"

msgid "comp7Core32"
msgstr "Pēc noteikta laika, jūs varēsiet atkārtoti sagūstīt Galveno Punktu."

msgid "comp7Core32Status"
msgstr "Par Galvenajiem Punktiem"

msgid "comp7Core33"
msgstr "Jūs nevariet sagūstīt Galveno Punktu līdz jūs izmantojiet attiecīgo Taktisko Spēju."

msgid "comp7Core33Status"
msgstr "Par Galvenajiem Punktiem"

msgid "comp7Core34"
msgstr "Galvenā Punkta sagūstīšana nopelna jums Prestiža Punktus."

msgid "comp7Core34Status"
msgstr "Par Galvenajiem Punktiem"

msgid "comp7Core35"
msgstr "Apskatiet pasākuma noteikumus, lai uzzināt vairāk par Prestiža Punktu pelnīšanu."

msgid "comp7Core35Status"
msgstr "Par Prestiža Punktiem"

msgid "comp7Core37"
msgstr "Režīmā ir modifikatori, kas maina noteiktus tanka parametrus, kā piemēram tanka dzīvības punktus, palīgmateriālu atjaunošanās laiku, atlikušo redzamības laiku un vairāk."

msgid "comp7Core37Status"
msgstr "Uzbrukuma Modifikatori"

msgid "comp7Core5"
msgstr "Atkarībā no lomas, katram tankam ir īpaša spēja ar trīs uzlādes līmeņiem. Jo augstāks uzlādes līmenis, kad tiek aktivizēta spēja, jo stiprāks efekts."

msgid "comp7Core5Status"
msgstr "Par Lomas Spējām"

msgid "comp7Core6"
msgstr "Prestiža Punktus var nopelnīt par iespaidīgu sniegumu kaujā, Galveno Punktu sagūstīšanu, spēju izmantošanu, utt."

msgid "comp7Core6Status"
msgstr "Par Prestiža Punktiem"

msgid "comp7Core8"
msgstr "Spēlētājiem nebūs informācijas par to pretinieku tankiem līdz tie tiks pamanīti."

msgid "comp7Core8Status"
msgstr "Kara Migla"

msgid "comp7Light7"
msgstr "Jūs variet uzzināt vairāk par Vieglo Uzbrukumu noklikšķinot uz PAR PASĀKUMU pogas pasākuma ekrānā."

msgid "comp7Light7Status"
msgstr "Režīma Detaļas"

msgid "comp7Light9"
msgstr "Ar VIII Līmeņa tanku kolekciju dažādās lomās, jūs variet vienmēr izvēlēties labākos tankus jebkurai kaujai un arī pielāgoties jūsu sabiedroto tankiem."

msgid "comp7Light9Status"
msgstr "Garāžas Paplašināšana"

msgid "comp7Ranked0"
msgstr "Cīnieties par Reitinga Punktiem, lai sasniegtu augstākos rangus un pierādītu jūsu pārākumu."

msgid "comp7Ranked0Status"
msgstr "Ranga Sistēma"

msgid "comp7Ranked1"
msgstr "Jo vairāk Prestiža Punktus jūsu nopelniet kaujā, jo vairāk Reitinga Punktus jūsu saņemsiet par uzvaru, un mazāk zaudēsiet par sakāvi."

msgid "comp7Ranked1Status"
msgstr "Prestiža Punkti un Reitinga Punkti"

msgid "comp7Ranked2"
msgstr "Uzbrukumā, kaujas tiek saliktas starp līdzīgu rangu spēlētājiem."

msgid "comp7Ranked20"
msgstr "Kaujas pamešana pirms tās beigām atstās jūsu sabiedrotos neizdevīgā stāvoklī. Šādi rīkojoties, tiks īslaicīgi bloķēti un noņemti Reitinga Punkti."

msgid "comp7Ranked20Status"
msgstr "Dezertācija"

msgid "comp7Ranked26"
msgstr "Tikai spēlētāji Čempiona un Leģendas rangos tiek rādīti Līderu Sarakstā. Visi spēlētāji, kas tiek Līderu Sarakstā saņems ikdienas balvas."

msgid "comp7Ranked26Status"
msgstr "Līderu Saraksts"

msgid "comp7Ranked27"
msgstr "Dezertieri tiks īslaicīgi bloķēti no piedalīšanās spēles režīmā. Bloķēšanas ilgums tiks palielināts par katru secīgu pārkāpumu."

msgid "comp7Ranked27Status"
msgstr "Īslaicīgs Bloks"

msgid "comp7Ranked28"
msgstr "Cīnieties spēles režīmā, lai atslēgtu jaunus Uzbrukuma progresīvā stila elementus."

msgid "comp7Ranked28Status"
msgstr "Progresīvs Stils"

msgid "comp7Ranked2Status"
msgstr "Cienīgi Spēlētāji"

msgid "comp7Ranked3"
msgstr "Leģendas rangs ir apbalvots tikai labākajiem no labākajiem. Lai sasniegtu šo rangu, jums vajag būt starp top 10% no spēlētājiem Līderu Sarakstā pēc nopelnītajiem Reitinga Punktiem."

msgid "comp7Ranked36"
msgstr "Lūdzu atcerieties: Ja jūs pameties kauju pirms tās beigām, jūs zaudēsiet vairāk Reitinga Punktus nekā tad, ja jūs smagi zaudētu."

msgid "comp7Ranked36Status"
msgstr "Dezertācija"

msgid "comp7Ranked3Status"
msgstr "Leģenda"

msgid "comp7Ranked4"
msgstr "Ja jūs beidziet spēlēt šo režīmu, jūs zaudēsiet Reitinga Punktus. Šis noteikums attiecas uz Sudraba, Zelta, Čempiona un Leģendas rangiem."

msgid "comp7Ranked4Status"
msgstr "Ranga Neaktivitāte"

msgid "comp7Ranked7"
msgstr "Jūs variet uzzināt vairāk par Uzbrukumu noklikšķinot uz PAR PASĀKUMU pogas pasākuma ekrānā."

msgid "comp7Ranked7Status"
msgstr "Režīma Detaļas"

msgid "comp7Ranked9"
msgstr "Ar X Līmeņa tanku kolekciju dažādās lomās, jūs variet vienmēr izvēlēties labākos tankus jebkurai kaujai un arī pielāgoties jūsu sabiedroto tankiem."

msgid "comp7Ranked9Status"
msgstr "Garāžas Paplašināšana"

msgid "devMaps0"
msgstr "Nejaušā notikuma vieta kartē tiks atzīmēta \nar dūmiem un minimapē ar marķieri. \nKartes ar nejaušiem notikumiem var atspējot, izmantojot iestatījumus spēles cilnē."

msgid "devMaps0Status"
msgstr "Karte ar nejaušiem notikumiem"

msgid "devMaps1"
msgstr "Jūsu tanks var tikt iznīcināts nejauša notikuma zonā (piemēram, lidmašīnas avārijas laikā). \nKartes ar nejaušiem notikumiem var atspējot, izmantojot iestatījumus spēles cilnē."

msgid "devMaps1Status"
msgstr "Karte ar nejaušiem notikumiem"

msgid "dualGunVehicles"
msgstr "Tanki ar divstobru ieroča sistēmu"

msgid "epicModeHiddenFeatures"
msgstr "Frontes līnijas veterānam"

msgid "epicModeIntroduction"
msgstr "Režīma iezīmes"

msgid "epicModeUseful"
msgstr "Apgūt Frontes līniju"

msgid "epicRandom0"
msgstr "Šajā kaujas režīmā jūs varat piedzīvot nelielu veiktspējas samazinājumu."

msgid "epicTip1"
msgstr "Kad bāze tiek ieņemta, visi aizsargājošās komandas tanki, kas palikuši zonā tiek mērķēti bombardēšanai."

msgid "epicTip10"
msgstr "Pakāpes jums dod ne tikai slavu un reputāciju, bet arī noderīgus bonusus pēc katras kaujas."

msgid "epicTip11"
msgstr "Režīms „Frontes līnija” iekļauj daudz jaunus veidus, kā pelnīt pieredzi un kredītus."

msgid "epicTip12"
msgstr "Frontes līnija var tikt pārvietota, atstumjot pretinieku komandu atpakaļ. Tas ļauj jums atdzimt tuvāk mērķiem."

msgid "epicTip13"
msgstr "Kad bruņutehnika ieņemšanas aplī saņem bojājumus, ieņemšanas progress šai bruņutehnikas vienībai uz laiku tiek bloķēts."

msgid "epicTip14"
msgstr "Aktivizējiet un palieliniet Kaujas rezerves īpašajā ekrānā. Izmantojiet tās, lai nestu iznīcību kaujas laukā."

msgid "epicTip15"
msgstr "Ja stratēģija to prasa, jūs vienmēr varat atdzimšanas ekrānā nomainīt frontes."

msgid "epicTip16"
msgstr "Nešķērsojiet aizsargātās zonas. Pretinieka artilērija sāks šaut uz jums."

msgid "epicTip17"
msgstr "Ja jūsu bruņutehnika kartē ir iestrēgusi, pametiet to (pēc noklusējuma taustiņš J). Jūs varēsiet iziet kaujā ar jaunu bruņutehnikas vienību."

msgid "epicTip18"
msgstr "Atveriet lielu minikartes versiju (pēc noklusējuma M), lai labāk pārskatītu kaujas lauku."

msgid "epicTip19"
msgstr "Jūs saņemsiet ziņojumus tikai no sabiedrotajiem, kas ir redzami minikartē."

msgid "epicTip2"
msgstr "Spēlējot režīmā „Frontes līnija”, jūs varat nopelnīt daudz papildus atlīdzības."

msgid "epicTip20"
msgstr "Jūs varat pielāgot savas minikartes redzamo daļu ar kursoru un peles rulli."

msgid "epicTip21"
msgstr "Uzklikšķinot uz bāzēm vai mērķiem minikartē, jūs tos varat parādīt komandas biedriem."

msgid "epicTip22"
msgstr "Kad jums izbeidzās tanki, izmantojiet brīvās kameras režīmu. Tādā veidā jūs varēsiet plānot savu stratēģiju gaidot atgriešanos kaujā."

msgid "epicTip23"
msgstr "Kad bāzes ieņemšanas laikā iztek kaujai atvēlētais laiks, sākas papildlaiks. Kauja turpināsies tik ilgi, kamēr visas bāzes netiks iztīrītas."

msgid "epicTip3"
msgstr "Frontes līnijas režīmā kaujas lauks ir 9 km², kas ir deviņas reizes lielāks nekā jebkura parastā kaujas karte."

msgid "epicTip4"
msgstr "Kaujas ilgums tiek palielināts katru reizi, kad zona tiek ieņemta. Pēdējā zona dod papildus laiku."

msgid "epicTip5"
msgstr "Ja jūsu bruņutehnika tiek iznīcināta kaujas laikā, tai būs nepieciešams zināms laiks remontam. Izvēlieties citu bruņutehniku un izbaudiet kauju."

msgid "epicTip6"
msgstr "Viena bruņutehnikas vienība tiek piegādāta jūsu rezervē katras piecas minūtes."

msgid "epicTip7"
msgstr "Uzbrucēji saņem pieeju otrās līnijas zonai tikai tad, kad ir ieņemta zona pirmajā īnijā tajā pašā virzienā."

msgid "epicTip8"
msgstr "Kad visas zonas pirmajā līnijā tiek ieņemtas, visas zonas otrajā līnijā kļūst vājākas."

msgid "epicTip9"
msgstr "Ir iespējams uzvarēt kaujā, iznīcinot visu pretinieku komandu. Tikai šī varbūtība ir ĻOTI maza."

