msgid "extraParams/desc"
msgstr "Parametrs, kas tieši neietekmē pretinieku tanku iznīcināšanas efektivitāti."

msgid "extraParams/header"
msgstr "Bonuss %(paramName)s"

msgid "extraParams/multiDesc"
msgstr "Kopējais bonuss tiek aprēķināts, izmantojot gan aditīvos, gan multiplikatīvos koeficientus, tāpēc faktiskā vērtība var būt gan lielāka, gan mazāka par šeit norādīto."

msgid "extraParams/name/artNotificationDelayFactor"
msgstr "Šis parametrs parāda laiku starp Artilērijas šāviena un saņemto brīdinājumu."

msgid "extraParams/name/commanderLampDelay"
msgstr "Šis parametrs rāda aizturi pirms Komandieris identificē, vai pretinieks pamanīja jūsu tanku. Jo augstāka vērtība, jo īsāka aizture."

msgid "extraParams/name/crewHitChance"
msgstr "Šis parametrs parāda iespēju izvairīties no ievainojumiem jūsu apkalpes locekļiem."

msgid "extraParams/name/crewRepeatedStunDuration"
msgstr "Šis parametrs rāda papildus apdullināšanas ilgumu jau apdullinātam tankam."

msgid "extraParams/name/crewStunDuration"
msgstr "Šis parametrs rāda saņemtā apdullinājuma ilgumu."

msgid "extraParams/name/damageAndPiercingDistributionLowerBound"
msgstr "Šis parametrs parāda minimālo potenciālo bojājumu un potenciālās cauršaušanas vērtības izmaiņas salīdzinājumā ar pamata vērtību (-25%)."

msgid "extraParams/name/damageAndPiercingDistributionUpperBound"
msgstr "Šis parametrs parāda maksimālo potenciālo bojājumu un potenciālās cauršaušanas vērtības izmaiņas salīdzinājumā ar pamata vērtību (+25%)."

msgid "extraParams/name/damageEnemiesByRamming"
msgstr "Šis parametrs parāda taranēšanas radīto bojājumu daudzumu. Tankiem saduroties, sistēma ņem vērā bruņu biezumu trieciena punktā, tanku svara atšķirību un ātrumu."

msgid "extraParams/name/damagedModulesDetectionTime"
msgstr "Šis parametrs parāda aizkavi, pirms Komandieris konstatē kritiskus bojājumus pretinieka tankam jūsu mērķī."

msgid "extraParams/name/demaskFoliageFactor"
msgstr "Šis parametrs rāda pretinieku atklāšanu, kas ir pilnībā maskēti ar lapotnēm (gan izolētas gan grupētas lapotnes). Pielietojas stacionāriem un kustošiem tankiem."

msgid "extraParams/name/demaskMovingFactor"
msgstr "Šis parametrs rāda kustošu pretinieku tanku atklāšanu. Jo lielāka vērtība, jo lielāka pamanīšanas iespēja."

msgid "extraParams/name/enemyModulesCrewCritChance"
msgstr "Šis parametrs parāda izmaiņas iespējamībā radīt kritiskus bojājumus pretinieka apkalpei un moduļiem. Efekts darbojas visu veidu čaulītēm, izņemot tankos ar automātiskajiem lielgabaliem."

msgid "extraParams/name/equipmentPreparationTime"
msgstr "Šis parametrs parāda palīgmateriālu atjaunošanās laiku."

msgid "extraParams/name/fireExtinguishingRate"
msgstr "Šis parametrs nosaka ugunsgrēka ilguma samazināšanos un tā radīto bojājumu apjomu."

msgid "extraParams/name/foliageMaskingFactor"
msgstr "Šis parametrs parāda aiz lapotnes maskēšanās efektu."

msgid "extraParams/name/hpRecover"
msgstr "Šis parametrs parāda HP atjaunošanas pieaugumu, izmantojot Remonta komplektu. Jo augstāka vērtība, jo vairāk HP tiks atjaunots."

msgid "extraParams/name/mediumGroundFactor"
msgstr "Šis parametrs rāda balstiekārtas šķērsošanas jaudu pa mēreni mīkstu reljefu. Jo lielāka vērtība, jo mazāk laika ir nepieciešams, lai sasniegtu lineāru ātrumu."

msgid "extraParams/name/penaltyToDamagedSurveyingDevice"
msgstr "Šis parametrs samazina sodu maksimālajai redzamībai, kad ir iznīcinātas novērošanas iekārtas. Jo zemāka vērtība, jo labāka redzamība."

msgid "extraParams/name/piercingHEShellsDistributionUpperBound"
msgstr "Šis parametrs parāda maksimālās iespējamās šāviņu caursišanas vērtības pieaugumu attālumā, kas ir mazāks par 50 m. Jo augstāka vērtība, jo labāka caursišana."

msgid "extraParams/name/radiomanActivityTimeAfterVehicleDestroy"
msgstr "Šis parametrs parāda pretinieka pozīciju papildu pārraides laiku pēc jūsu tanka iznīcināšanas."

msgid "extraParams/name/radiomanHitChance"
msgstr "Šis parametrs parāda iespēju izvairīties no ievainojumiem jūsu Radio Operatoram."

msgid "extraParams/name/shellVelocity"
msgstr "Šis parametrs rāda palielinājumu čaulīšu ātrumā visiem čaulīšu veidiem. Jo augstāka vērtība, jo lielāks čaulīšu ātrums."

msgid "extraParams/name/softGroundFactor"
msgstr "Šis parametrs rāda balstiekārtas šķērsošanas jaudu pa mīkstu reljefu. Jo lielāka vērtība, jo mazāk laika ir nepieciešams, lai sasniegtu lineāru ātrumu."

msgid "extraParams/name/stunResistanceEffectFactor"
msgstr "Šis parametrs parāda apkalpes apdullināšanas negatīvās ietekmes pakāpi."

msgid "extraParams/name/suspensionDamageReduction"
msgstr "Šis parametrs parāda ienākošā bojājuma samazinājumu piekarei. Jo augstāka vērtība, jo mazāk bojājumu tiks saņemts."

msgid "extraParams/name/vehPenaltyForDamagedAmmorack"
msgstr "Šis parametrs rāda samazinājumu sodā ieroča pārlādes laikam bojāta munīcijas plaukta dēļ. Jo augstāka vērtība, jo īsāks pārlādes laiks."

msgid "extraParams/name/vehPenaltyForDamagedEngine"
msgstr "Šis parametrs rāda samazinājumu zaudētā jaudā bojāta dzinēja dēļ. Jo augstāka vērtība, jo mazāk jaudas dzinējs zaudēs."

msgid "extraParams/name/vehicleAmmoBayEngineFuelStrength"
msgstr "Šis parametrs rāda munīcijas plaukta, degvielas tvertņu un dzinēja izturību. Jo lielāka vērtība, jo izturīgāki jūsu moduļi."

msgid "extraParams/name/vehicleAmmoBayStrength"
msgstr "Šis parametrs rāda munīcijas plaukta izturību. Jo lielāka vērtība, jo izturīgāks jūku munīcijas plaukts."

msgid "extraParams/name/vehicleChassisFallDamage"
msgstr "Šis parametrs rāda balstiekārtas bojājumu izraisītos bojājumus trieciena laikā. Tas neietekmē izdarītos bojājumus sāniem vai torņa augšai trieciena laikā."

msgid "extraParams/name/vehicleChassisRepairSpeed"
msgstr "Šis parametrs rāda balstiekārtas remonta ātrumu. Jo lielāka vērtība, jo lielāks remonta ātrums."

msgid "extraParams/name/vehicleChassisStrength"
msgstr "Šis parametrs rāda balstiekārtas izturību. Jo lielāka vērtība, jo izturīgāka jūsu balstiekārta pret čaulītēm un trieciena/taranēšanas."

msgid "extraParams/name/vehicleEnemySpottingTime"
msgstr "Šis parametrs rāda pretinieku redzamības ilgumu pēc tam, kad tie pamet jūsu skata attālumu. Noklusējuma vērtība ir 10 sekundes."

msgid "extraParams/name/vehicleFallingDamageResistance"
msgstr "Šis parametrs rāda samazinājumu saņemtajos bojājumos no tanka trieciena. Jo augstāka vērtība, jo mazāk bojājumi tiks saņemti."

msgid "extraParams/name/vehicleFireChance"
msgstr "Šis parametrs parāda dzinēja aizdegšanās iespēju, ja tas ir bojāts."

msgid "extraParams/name/vehicleFuelTankLesionChance"
msgstr "Šis parametrs parāda degvielas tvertņu izturību pret kritiskiem bojājumiem. Pēc iznīcināšanas degvielas tvertnes vienmēr izraisa ugunsgrēku."

msgid "extraParams/name/vehicleGunShotDispersion"
msgstr "Šis parametrs rāda ieroča precizitātes samazināšanu kustības, korpusa un torņa griešanās laikā. Jo mazāka vērtība, jo mazāka tēmēšanas apļa izkliede."

msgid "extraParams/name/vehicleGunShotDispersionAfterShot"
msgstr "Šis parametrs rāda tēmēšanas apļa izmēru pēc šaušanas."

msgid "extraParams/name/vehicleGunShotDispersionChassisMovement"
msgstr "Šis parametrs parāda izkliedi kustības laikā. Jo zemāka vērtība, jo precīzāks ir ierocis."

msgid "extraParams/name/vehicleGunShotDispersionChassisRotation"
msgstr "Šis parametrs norāda izkliedi korpusa pagrieziena laikā. Jo mazāka vērtība, jo precīzāks ir lielgabals."

msgid "extraParams/name/vehicleGunShotDispersionTurretRotation"
msgstr "Šis parametrs norāda izkliedi stobra pagrieziena laikā. Jo mazāka vērtība, jo precīzāks ir lielgabals."

msgid "extraParams/name/vehicleGunShotDispersionWhileGunDamaged"
msgstr "Šis parametrs parāda izkliedi ar bojātu ieroci. Jo lielāka vērtība, jo mazāka izkliede."

msgid "extraParams/name/vehicleHEShellDamageResistance"
msgstr "Šis parametrs rāda saņemtos bojājumus no HE čaulītēm. Jo vairāk bruņu trieciena vietā, jo lielāks efekts."

msgid "extraParams/name/vehicleInvisibilityAfterShot"
msgstr "Šis parametrs rāda maskēšanos pēc šāviena."

msgid "extraParams/name/vehicleOwnSpottingTime"
msgstr "Šis parametrs rāda jūsu tanka redzamības laiku pretiniekiem pēc tam, kad jūs pametiet to redzamības attālumu. Noklusējuma vērtība ir 10 s."

msgid "extraParams/name/vehicleRamChassisDamageResistance"
msgstr "Šis parametrs parāda taranēšanas radīto bojājumu daudzumu balstiekārtai. Tankiem saduroties, sistēma ņem vērā bruņu biezumu trieciena punktā, tanku svara atšķirību un ātrumu."

msgid "extraParams/name/vehicleRamDamageResistance"
