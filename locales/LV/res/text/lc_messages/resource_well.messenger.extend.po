msgid "serviceChannelMessages/resourceWell/enabled/text"
msgstr "Montāžas Veikals atkal ir atvērts!"

msgid "serviceChannelMessages/resourceWell/end/text"
msgstr "Mēs sākam strādāt pie nākamā projekta. Mēs paziņosim jums, kad pabeigsim izstrādi. Redzēsimies drīzumā!"

msgid "serviceChannelMessages/resourceWell/end/title"
msgstr "Montāžas Veikals veras ciet"

msgid "serviceChannelMessages/resourceWell/noSerialVehicles/text"
msgstr "Numuru tanku piegāde pabeigta. Mēs sākam salikt %(vehicle)s standarta konfigurācijā. Pasteidzieties - tanku skaits ir ierobežots!"

msgid "serviceChannelMessages/resourceWell/noVehicles/text"
msgstr "Tanku salikšana pabeigta. Visi tanki nogādāti to īpašniekiem."

msgid "serviceChannelMessages/resourceWell/noVehicles/title"
msgstr "Montāžas Veikala Atskaite"

msgid "serviceChannelMessages/resourceWell/noVehicles/twoParallelProducts/text"
msgstr "%(soldOutVehicle)s piegāde pabeigta. Joprojām ir iespēja iegādāties %(availableVehicle)s. Ja esi iztērējis resursus, bet nepabeigsi pirkumu laikā, tie tiks atgriezti tavā kontā drīz. Pasteidzies – transportlīdzekļu skaits ir ierobežots!"

msgid "serviceChannelMessages/resourceWell/noVehiclesWithReturn/text"
msgstr "Tanku salikšana pabeigta. Visi tanki nogādāti to īpašniekiem. Visi iztērētie resursi tikt atgriezti jūsu kontam drīzumā."

msgid "serviceChannelMessages/resourceWell/oneVehicleStart/text"
msgstr "Komandieri, jums ir iespēja kļūt par %(vehicle)s īpašnieku ar numura 3D stilu. Tanku skaits ir ierobežots!"

msgid "serviceChannelMessages/resourceWell/pause/text"
msgstr "Montāžas Veikals īslaicīgi nav pieejams uzturēšanas dēļ."

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/additionalText"
msgstr "Stila numurs: %(serialNumber)s"

msgid "serviceChannelMessages/resourceWell/reward/serialVehicle/text"
msgstr "Unikālais %(vehicle)s saņemts no Montāžas Veikala."

msgid "serviceChannelMessages/resourceWell/reward/title"
msgstr "%(vehicle)s saņemts!"

msgid "serviceChannelMessages/resourceWell/reward/vehicle/text"
msgstr "%(vehicle)s saņemts no Montāžas Veikala."

msgid "serviceChannelMessages/resourceWell/start/title"
msgstr "Montāžas Veikals Veras Vaļā"

msgid "serviceChannelMessages/resourceWell/twoVehiclesStart/text"
msgstr "Komandieri, šī ir jūsu iespēja iegūt %(firstVehicle)s un %(secondVehicle)s! Bet esiet ātrs - krājumi ir ierobežoti!"
