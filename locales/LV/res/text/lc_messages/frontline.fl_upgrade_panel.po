msgid "alert"
msgstr "Jūs nevariet izvēlēties Kaujas Rezervi aktīvās cīnīšanās laikā."

msgid "description/one/reserve"
msgstr "Atkārtota %(reserve_name)s Rezerves\nizvēle uzlabos tās īpašības."

msgid "description/second/reserve"
msgstr "Atkārtota %(first_reserve_name)s vai %(second_reserve_name)s Rezerves\nizvēle uzlabos izvēlētā īpašības."

msgid "number_1"
msgstr "1."

msgid "number_2"
msgstr "2."

msgid "number_3"
msgstr "3."

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Izvieto aktīvu mīnu lauku izvēlētajā zonā uz noteiktu laika periodu."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Izraisa ievērojamus bojājumus pretinieku tankiem iekš maza rādiusa."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Apdullina pretinieku tankus un izraisa vidējus bojājumus lielā rādiusā."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Pievieno bonusu spēlētāja apkalpes un sabiedroto apkalpju galvenajai kvalifikācijai."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Sniedz bonusu ieņemšanas ātrumam, ieņemšanas bloķēšanai un papildināšanai."

msgid "shortDescription/reserve/reconAbility"
msgstr "Pamana pretinieku tankus un mīnu laukus."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Atjauno jūsu tanka dzīvības punktu noteiktus procentus."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Apslēpj visus tankus iekš un aiz dūmiem."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Sniedz bonusu maskēšanai un skata attālumam. Samazina pretinieku tanku maskēšanos."

msgid "title"
msgstr "%(number_name)s Rezerves Vieta Pieejama"
