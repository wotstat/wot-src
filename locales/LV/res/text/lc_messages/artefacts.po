msgid "berserker/battleDescr"
msgstr "Palielina cauršaušanas spēju un uguns intensitāti par %(gunPiercing)s reizēm, kā arī uzlabo šāviņa uzlikšanas efektivitāti un stabilizāciju par %(gunAimingTime)s, bet samazina tava tanka HP par %(healthDebuff)stā %(duration)s s darbības laikā.\n\n*Berserker spējas radītie bojājumi nevar iznīcināt tavu tanku."

msgid "berserker/descr"
msgstr "Palielina cauršaušanas un uguns ātrumu %(gunPiercing)s reizes, tikmēr arī palielinot ieroča nolikšanas efektivitāti un stabilizāciju par %(gunAimingTime)s, bet noņem %(healthDebuff)s no jūsu dzīvības punktiem tā %(duration)s s ilguma laikā.\n\n*Izdarītie bojājumi no Berserkera spējas nevar iznīcināt jūsu tanku."

msgid "berserker/longDescr"
msgstr "Palielina caursišanu un šaušanas ātrumu {green_Open}par %(gunPiercing)s reizēm{green_Close}, vienlaikus palielinot ieroča mērķēšanas efektivitāti un stabilizāciju {green_Open}par %(gunAimingTime)s{green_Close}, bet atņem {red_Open}%(healthDebuff)s{red_Close} no jūsu tanka kopējās HP tā {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} ilguma laikā.\n\n*Berserker spējas radītais bojājums nevar iznīcināt jūsu tanku."

msgid "berserker/name"
msgstr "Berserkeris"

msgid "berserker/shortDescr"
