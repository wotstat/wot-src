msgid "action/full/paidRemovalCost"
msgstr "Demontējiet iekārtas par zemāku cenu: atlaide demontāžai pašreiz ir %(discount)s. Ar šo akcijas piedāvājumu jūs variet ietaupīt zeltu demontējot iekārtas."

msgid "action/full/passportChangeCost"
