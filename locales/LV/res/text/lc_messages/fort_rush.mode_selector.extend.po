msgid "mode/fort_rush_battle/description"
msgstr "Pārņemiet kontroli pār antenām. Uzturiet tīklu. Nodrošiniet pārraidi."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Jūsu datorsistēmas veiktspēja nav pietiekama šim režīmam. Jūs variet piedzīvot problēmas ar grafiku un tanku pārvietošanos. Ir iespējama arī spēles klienta nobrukšana."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Zema veiktspēja"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Zema veiktspēja"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Šim režīmam nepieciešama augsta datora veiktspēja. Jums var rasties problēmas ar kartes ielādi, grafiku un tanku pārvietošanos. Nepietiekamas veiktspējas gadījumā Iestatījumos mēģiniet samazināt grafikas kvalitāti."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Samazināta veiktspēja"

