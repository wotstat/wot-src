msgid "invites/note/change_and_leave/PREBATTLE_FUN_RANDOM"
msgstr "Tiklīdz apstiprināsiet ielūgumu, jūs tiksiet automātiski izslēgts no %(modeName)s Vada un nosūtīts uz %(host)s serveri."

msgid "invites/note/change_and_leave/QUEUE_FUN_RANDOM"
msgstr "Ja akceptēsiet uzaicinājumu, jūs iziesiet no %(modeName)s režīma un būsiet pārvietots uz %(host)s serveri."

