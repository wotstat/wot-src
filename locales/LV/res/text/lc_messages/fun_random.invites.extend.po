msgid "invites/note/leave/QUEUE_FUN_RANDOM"
msgstr "Ja akceptēsiet uzaicinājumu, jūs iziesiet no %(modeName)s režīma."

msgid "invites/prebattle/alreadyJoined/FUN_RANDOM"
msgstr "Jūs jau esiet pievienojies šim Vadam."

