msgid "comp7/deserter/cancel"
msgstr "Atcelt"

msgid "comp7/deserter/message"
msgstr "Šī kauja vēl nav beigusies. Ja pametīsi kauju pirms tās beigām, tu pievils savu komandu.\n{brown_open} Tavs reitings tiks samazināts un tu tiksi bloķēts no kaujām šajā režīmā. {brown_close}\nVai tiešām vēlies pamest kauju?"

msgid "comp7/deserter/msgTitle"
msgstr "Jūs zaudēsiet jūsu Reitinga Punktus!"

msgid "comp7/deserter/submit"
msgstr "Bēgt"

msgid "comp7/deserter/title"
msgstr "Bēgšana No Kaujas Lauka"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Jūs pārkāpāt Spēles Noteikumus {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartē {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Reitinga Punkti tika noņemti un jūs īslaicīgi esiet bloķēts no kaujām {whiteSpanish_Open}Uzbrukuma{whiteSpanish_Close} režīmā."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Jūs pārkāpāt Spēles Noteikumus {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} kartē {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nJūs esiet īslaicīgi bloķēts no kaujām {whiteSpanish_Open}Uzbrukuma{whiteSpanish_Close} režīmā un jūsu Reitings tika samazināts."
