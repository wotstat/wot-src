msgid "battleship/name"
msgstr "Dūmu Signāls"

msgid "battleship/shortDescr"
msgstr "Dūmu signāls, kas atzīmē zonu priekš kaujas kuģa artilērijas šāvieniem, izdarot bojājumus pretinieku iekārtām un tur atrodamiem objektiem."

msgid "distraction_ability/name"
msgstr "Nepareizs Rīkojums"

msgid "distraction_ability/shortDescr"
msgstr "Lūdziet Gefr. Keller izmantot sagūstīto Vācijas radio, lai pārraidītu nepareizu rīkojumu, norādot ienaidniekiem izmeklēt norādīto vietu."

msgid "recon_ability/name"
msgstr "Izlūkot Apkārt"

msgid "recon_ability/shortDescr"
msgstr "Sūtiet kapteini Dubois uz izlūkošanu norādītajā vietā. Izlūkošanas laikā tanks apstājas un paliek nekustīgs. Spēja turpina darboties līdz tā tiek atcelta."

msgid "scc_airstrike_ability/name"
msgstr "Gaisa atbalsts"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Izsauc aviācijas triecienu norādītajā pozīcijā."
