msgid "Contact/status/inBattle/last_stand"
msgstr "Pēdējā Pretošanās kaujā"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Izšauj šāvienu, kas izdara bojājumus mērķim un visiem pretinieku tankiem 35 m rādiusā."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Izšauj šāvienu, kas atjauno dzīvības punktus nozogot tos no mērķa un tuvējiem pretinieka tankiem 35 m rādiusā."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Izšauj šāvienu, kas apdullina mērķi un visus pretinieku tankus 35 m rādiusā."

msgid "advanced/ls_damageShield"
msgstr "Aizsargā pret jebkādiem bojājumiem (izņemot taranēšanu, slīkšanu un sadursmi) uz 10 sekundēm."

msgid "advanced/ls_doubleDamage"
msgstr "Jūsu nākamais veiksmīgais šāviens izdara dubultus bojājumus."

msgid "advanced/ls_equipment"
msgstr "Taktiskās Ierīces palīdz efektīvāk cīnīties Pēdējā Pretestība kaujās, pabeigt posmus un iegūt vērtīgas atlīdzības. Lai tās uzstādītu, noklikšķini uz kāda no taktisko ierīču slotiem."

msgid "advanced/ls_extraDamageSituational"
msgstr "Dod iespēju nodarīt palielinātu bojājumu pretinieka tankam."

msgid "advanced/ls_fastReload"
msgstr "Palielina šaušanas ātrumu / pārlādes magazīnu."

msgid "advanced/ls_healSituational"
msgstr "Atjauno daļu dzīvības punktu pēc pretinieka tanka iznīcināšanas."

msgid "advanced/ls_invisibility"
msgstr "Uz laiku neļauj ienaidniekiem mērķēt tavu tanku, atjauno izturības punktus, salabo moduļus, nodzēš uguni, noņem apdullināšanas efektu un ārstē visus ievainotos apkalpes locekļus."

msgid "advanced/ls_nitro"
msgstr "Īslaicīgi palielina jūsu tanka mobilitāti."

msgid "advanced/ls_nitroSituational"
msgstr "Uz laiku palielina tanka mobilitāti pēc tam, kad tas ir cietis no ienaidnieka tanka uguns."

msgid "advanced/ls_selfRepairKit"
msgstr "Atjauno dzīvības punktus, nodzēš uguni, noņem apdullināšanas efektu un salabo bojātus moduļus."

msgid "advanced/ls_teamRepairKit"
msgstr "Salabo bojātus moduļus, nodzēš uguni un noņem apdullināšanas efektu, un atjauno nedaudz dzīvības punktus sabiedroto tankiem tās rādiusā."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Taktiskās ierīces var uzstādīt īpašos slotos, lai efektīvāk cīnītos Pēdējā Pretestība kaujās, pabeigtu posmus un iegūtu vērtīgas atlīdzības."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Taktisko ierīču sloti"
