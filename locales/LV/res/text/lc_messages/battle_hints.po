msgid "hint/LSH_FIRE"
msgstr "Dūmi apgrūtina ienaidnieka tanku pamanīšanu un to pozīciju paziņošanu. Uguns nodara bojājumus tankiem."

msgid "hint/LSH_FOG"
msgstr "Migla apgrūtina ienaidnieka tanku pamanīšanu un to pozīciju paziņošanu."

msgid "hint/LSH_RAIN"
msgstr "Stiprs Lietus apgrūtina ienaidnieka tanku pamanīšanu un to pozīciju paziņošanu."

msgid "hint/LSH_SANDSTORM"
msgstr "Smilšu Vētras apgrūtina ienaidnieka tanku pamanīšanu un to pozīciju paziņošanu."

msgid "hint/LSH_SMOKE"
msgstr "Dūmi apgrūtina ienaidnieka tanku pamanīšanu un to pozīciju paziņošanu."

msgid "hint/PPH_AIMING_01"
msgstr "Tanka un torņa kustība samazina <font color='#EE7000'>ieroča precizitāti</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Aplis ap tīklojumu norāda <font color='#EE7000'>ieroča precizitāti</font>. Nedaudz uzgaidiet priekš lielākas precizitātes šāviena."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Auto-Tēmēšana</font> ieslēgta. Nospiediet labo peles pogu, lai atceltu."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "Auto-Tēmēšana vienmēr tēmē jūsu ieroci <font color='#EE7000'>uz centru</font> jūsu mērķa tankam"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Jūsu bāze tiek <font color='#EE7000'>ieņemta!</font> Ja tas netiks atvairīts, pretinieku komanda uzvarēs kauju."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Katram pretinieku tankam ir <font color='#EE7000'>savs</font> ieņemšanas progress"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Ieņemt</font> pretinieku bāzi ir viens no veidiem kā uzvarēt kauju"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Kad jūs saņemsiet bojājumus, jūsu ieņemšanas progress <font color='#EE7000'>tiek atiestatīts</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Kad jūs pametiet bāzes apli, jūsu ieņemšanas progress <font color='#EE7000'>tiek zaudēts</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "Vairāki tanki ieņem bāzi <font color='#EE7000'>ātrāk</font>"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "Pēc <font color='#EE7000'>trešā</font> tanka, bāzes ieņemšanas ātrums nepalielinās"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "Pretinieku bāze ir gandrīz ieņemta!"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Jūsu komanda uzvar bāzes ieņemšanas sacīkstēs!"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Tanka modulis kritiski bojāts! Salabojiet to izmantojot <font color='#EE7000'>Remonta Komplektu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Tanka modulis kritiski bojāts! Salabojiet to izmantojot <font color='#EE7000'>Remonta Komplektu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Apkalpes loceklis kritiski ievainots! Ārstējiet viņu ar <font color='#EE7000'>Aptieciņu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Apkalpes loceklis kritiski ievainots! Ārstējiet viņu ar <font color='#EE7000'>Aptieciņu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Tanka apkalpe apdullināta! Ārstējiet viņus ar <font color='#EE7000'>Aptieciņu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Tanks aizdedzies! Izmantojiet <font color='#EE7000'>Ugunsdzēšamo Aparātu</font> apakšējā panelī."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Tanks aizdedzies! Automātiskais <font color='#EE7000'>Ugunsdzēšamais Aparāts</font> aktivizēts."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Tanka modulis kritiski bojāts! <font color='#EE7000'>Remonta Komplekta</font> uzstādīšana pirms kaujas palīdz tikt galā ar kritiskiem šāvieniem."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Apkalpes loceklis kritiski ievainots! <font color='#EE7000'>Aptieciņas</font> uzstādīšana pirms kaujas palīdz tikt galā ar apkalpes ievainojumiem."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Tanka aizdedzies! <font color='#EE7000'>Ugunsdzēšamā Aparāta</font> uzstādīšana pirms kaujas palīdz tikt galā ar uguni."

msgid "hint/PPH_OTHER_01"
msgstr "Jūs tikāt <font color='#EE7000'>pamanīts</font> - šaušana var atklāt jūsu pozīciju!"

msgid "hint/PPH_OTHER_02"
msgstr "Tava kaujas mašīna tika iznīcināta. Nospied <font color='#EE7000'>Esc</font>, lai izietu no kaujas bez soda."

msgid "hint/PPH_OTHER_03"
msgstr "Jūsu tanks tiks iznīcināts. Jūs variet nospiest peles pogu, lai <font color='#EE7000'>skatītos</font> jūsu sabiedrotos."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>Spuldzes ikona</font> norāda, ka pretinieks jūs pamanīja!"

msgid "hint/PPH_OTHER_05"
msgstr "Jūsu ierocis vēl tiek <font color='#EE7000'>pārlādēts</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Jūsu ieroci var izšaut tikai tad, ja aplis apkārt tīklojumu ir <font color='#EE7000'>pilnībā zaļš</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Jūs variet paritināt peli, lai ieietu <font color='#EE7000'>Snaipera režīmā</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Jūs variet paritināt peli, lai <font color='#EE7000'>atstātu</font> Snaipera režīmu"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "<font color='#EE7000'>Zaļš iekšējais tēmēklis</font> norāda uz lielu iespējamību caursist ienaidnieka bruņas"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Pat tad, ja iekšējais tēmēklis ir zaļš, bruņu caursišana <font color='#EE7000'>nav garantēta</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Ieroči nav 100% precīzi, tāpēc šāvieni var <font color='#EE7000'>ne vienmēr trāpīt tīklojuma centrā</font>"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Iekšējais tēmēklis norāda iespējamību caursist ienaidnieka bruņas. <font color='#EE7000'>Iespējo to iestatījumos</font>."

msgid "penetration/chance/high"
msgstr "Liela iespēja"

msgid "penetration/chance/low"
msgstr "Zema iespēja"

msgid "penetration/chance/medium"
msgstr "Vidēja iespēja"
