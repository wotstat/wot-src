msgstr "*Uzlabot līdz šim līmenim var tikai {{@ colorLegacy 'FFE4C0'}}iegādātās{{/}} Kaujas rezerves {{@ colorLegacy 'FFE4C0'}}Likteņa pavērsiena{{/}} scenārijā."

msgid "reserveCategories/levels/header"
msgstr "Kā Atslēgt Vietas un Uzlabot Kaujas Rezerves"

msgid "reserveCategories/levels/text"
msgstr "Pēc noklusējuma, viena Kaujas Rezerve ir pieejama jums. Citas tiek atslēgtas sasniedzot Seržanta un Leitnanta pakāpes. Visas trīs Rezerves tiks uzlabotas sasniedzot Kapteiņa un Majora pakāpes."

msgid "reserveCategories/progression/tableCell"
msgstr "{{@ colorLegacy 'FFE4C0'}}{{level}}{{/}} or {{@ colorLegacy 'FFE4C0'}}{{levelNext}}*{{/}} Līmenis"

