msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Kopējo izdarīto bojājumu attiecība pret aizvadīto kauju skaitu sesijā. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Iznīcināto pretinieku tanku pret cīnīto kauju attiecība."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Vidējais tanku līmenis, kurus jūs vadījāt spēles sesijā."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Kopējās nopelnītās pieredzes attiecība pret aizvadīto kauju skaitu sesijā. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Kopējo bloķēto bojājumu attiecība pret aizvadīto kauju skaitu sesijā. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Izdarīto bojājumu jūsu izlūkošanas dēļ un sabiedroto izdarīto bojājumu jūsu kāpurķēžu iznīcināšanas un pretinieka tanka imobilizēšanas vai apdullināšanas dēļ attiecība pret aizvadīto kauju skaitu sesijā. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "\"Izdarītie bojājumi\" attiecība pret \"Bojājumi saņemti\" parametri. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Iznīcināto pretinieku tanku attiecība pret spēlētāja tanka iznīcības skaita. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Pamanīto pretinieku tanku pret cīnīto kauju attiecība sesijā."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Kopējo cīnīto kauju procentuālā attiecība, kurās spēlētāja tanks netika iznīcināts."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Uzvaras Nejaušajās Kaujās sesijā procentuālā attiecība. Delta parāda pašreizējās spēles sesijas efektu kopējā parametrā."

msgid "propertyInfo/prop/descr/wins"
msgstr "Uzvaru skaits Nejaušajās kaujās sesijā. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

msgid "propertyInfo/prop/descr/wtr"
msgstr "WTR pēc vidējām vērtībām visai sesijai. Delta parāda pašreizējās spēles sesijas efektu kopējos parametros."

