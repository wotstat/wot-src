msgid "vo_sm_char10_m05_stg21_02"
msgstr "Štāba Virsnieks: Echo-5 pludmales pozīcija nodrošināta. Tanki virzās uz priekšu. Nodrošiniet pilnīgu uguns atbalstu."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Štāba Virsnieks: Pārvirziet gaisa atbalstu, lai palīdzētu tankiem virzīties uz priekšu."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Štāba Virsnieks: Inženieru komandas, notīriet šķēršļus tālākai virzībai."

