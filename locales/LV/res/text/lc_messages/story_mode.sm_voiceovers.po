msgid "vo_ob_char01_intro_01"
msgstr "Brūks: Es ienīstu Tīģerus."

msgid "vo_ob_char01_intro_03"
msgstr "Brūks: Seržants Brūks, 2. Bruņotā. Mēs arī satikām Tīģeri."

msgid "vo_ob_char01_intro_03_01"
msgstr "Brūks: Tagad mēs esam divi."

msgid "vo_ob_char01_intro_05"
msgstr "Brūks: Nāc ar mums. Uzbrukums pilsētai jau ir sācies..."

msgid "vo_ob_char01_intro_05_01"
msgstr "Brūks: Mums vajag pasteigties."

msgid "vo_ob_char01_intro_07"
msgstr "Brūks: Kaut kā tā."

msgid "vo_ob_char01_intro_09"
msgstr "Brūks: Un vai \"Betsijai\" vajadzētu iedvest bailes mūsu pretinieka sirdīs?"

msgid "vo_ob_char01_intro_11"
msgstr "Brūks: Pretinieks uz pulksten 3!"

msgid "vo_ob_char01_intro_12"
msgstr "Brūks: Iznīciniet vispirms Stug!"

msgid "vo_ob_char01_intro_17"
msgstr "Brūks: Vispirms ieņemsim pilsētu. Tad redzēsim..."

msgid "vo_ob_char01_m01_stg00_01"
msgstr "Brūks: Nav laika tērēt. Kustamies."

msgid "vo_ob_char01_m01_stg00_02"
msgstr "Brūks: Celies! Mēs virzāmies uz priekšu."

msgid "vo_ob_char01_m01_stg00_03"
msgstr "Brūks: Turi līdzi, Sherman."

msgid "vo_ob_char01_m01_stg00_04"
msgstr "Brūks: Viņiem vajag mūs pilsētā - uz priekšu."

msgid "vo_ob_char01_m01_stg00_05"
msgstr "Brūks: Uz priekšu, uz priekšu, uz priekšu!"

msgid "vo_ob_char01_m01_stg010_01"
msgstr "Brūks: Pašpiedziņas lielgabals uz pulksten 12. Iznīcini to ātri!"

msgid "vo_ob_char01_m01_stg010_04"
msgstr "Brūks: Dabūji! Labi pastrādāts, Sherman."

msgid "vo_ob_char01_m01_stg011_01"
msgstr "Brūks: Vads - jauns pretinieks!"

msgid "vo_ob_char01_m01_stg012_02"
msgstr "Brūks: Kustieties uz centru. Koncentrējies."

msgid "vo_ob_char01_m01_stg014_01"
msgstr "Brūks: Labi pastrādāts. Tagad iztīrīsim pēdējo laukumu. Uz priekšu!"

msgid "vo_ob_char01_m01_stg015_01"
msgstr "Brūks: Uzmanību! Vairāk pretinieki nekā gaidījām!"

msgid "vo_ob_char01_m01_stg015_05"
msgstr "Brūks: Jauna pretinieku grupa! Neļaujiet tiem ielenkt jūs, Veiksmīgais!"

msgid "vo_ob_char01_m01_stg016_02"
msgstr "Brūks: Paldies par palīdzību. Mēs uzvarējām šajā cīņā, bet mums vēl ir gaidāmas vairāk kaujas."

msgid "vo_ob_char01_m01_stg016_04"
msgstr "Brūks: Mierīgi, Betsija."

msgid "vo_ob_char01_m01_stg01_01"
msgstr "Brūks: Uzbrukums jau ir sācies - mums vajag pasteigties."

msgid "vo_ob_char01_m01_stg01_03"
msgstr "Brūks: Par godu savam vectēvam?"

msgid "vo_ob_char01_m01_stg01_07"
msgstr "Brūks: Sherman, seko mums. Netērēsim vairāk laiku."

msgid "vo_ob_char01_m01_stg02_04"
msgstr "Brūks: Tas izklausās pārāk Vāciski."

msgid "vo_ob_char01_m01_stg03_01"
msgstr "Brūks: Pretinieks uz pulksten 2! Šaujiet pēc iespējas!"

msgid "vo_ob_char01_m01_stg03_02"
msgstr "Brūks: Pretinieks uz pulksten 12! Šaujiet pēc iespējas!"

msgid "vo_ob_char01_m01_stg04_01"
msgstr "Brūks: Iznīcināts. Dosimies uz pilsētu."

msgid "vo_ob_char01_m01_stg04_03"
msgstr "Brūks: Tas iedveš bailes... Bet tas nav diezko oriģināls."

msgid "vo_ob_char01_m01_stg05_01"
msgstr "Brūks: Braucam, braucam! Mūsu sabiedrotie gaida mūs."

msgid "vo_ob_char01_m01_stg06_01"
msgstr "Brūks: Divi pretinieki uz pulksten 12. Uguni!"

msgid "vo_ob_char01_m01_stg07_02"
msgstr "Brūks: Acis atvērtas, Komandieri! Braucam apkārt no labāk puses."

msgid "vo_ob_char01_m01_stg08_01"
msgstr "Brūks: Tur ir Vācu Panzer. Šaujiet AP čaulītes!"

msgid "vo_ob_char01_m02_stg01_01"
msgstr "Brūks: Kustamies. Visi, palieciet modri. Gaisa spēki uzbrūk pilsētai."

msgid "vo_ob_char01_m02_stg01_01_01"
msgstr "Brūks: Bet būs atlikuši pietiekami daudz pretinieku tanki."

msgid "vo_ob_char01_m02_stg01_03"
msgstr "Brūks: Neesi pārāk sajūsmināts, MacLeod. Tas ir..."

msgid "vo_ob_char01_m02_stg01_03_01"
msgstr "Brūks: Sasodīts! Lūk mūsu pirmā uzbrukuma nodaļa. Vai tas bija Tīģeris?"

msgid "vo_ob_char01_m02_stg02_01"
msgstr "Brūks: Un lūk viņi nāk!"

msgid "vo_ob_char01_m02_stg02_03"
msgstr "Brūks: Koncentrējieties, MacLeod!"

msgid "vo_ob_char01_m02_stg03_01"
msgstr "Brūks: VK otrā krastā! Uguni pēc vēlēšanās!"

msgid "vo_ob_char01_m02_stg04_02"
msgstr "Brūks: Pirmo reizi dzirdu jūs lūdzam mērķi."

msgid "vo_ob_char01_m02_stg05_01"
msgstr "Brūks: Tilts ir bloķēts. Mums vajag iet apkārt."

msgid "vo_ob_char01_m02_stg05_03"
msgstr "Brūks: Optimisms ir laba sagatavošanās misijai. Blakus ir fords."

msgid "vo_ob_char01_m02_stg05_04"
msgstr "Brūks: Tu esi sasodīts zīlnieks. Kā tu to izdarīji?"

msgid "vo_ob_char01_m02_stg05_06"
msgstr "Brūks: Tad kāpēc jūs mūs nebrīdinājāt? Tas bija pretinieks."

msgid "vo_ob_char01_m02_stg06_01"
msgstr "Brūks: Pretinieks uz pulksten 12!"

msgid "vo_ob_char01_m02_stg06_01_01"
msgstr "Brūks: Pataupiet savas čaulītes, Veiksmīgais! Nešaujiet gribot negribot; izmantojiet optiku."

msgid "vo_ob_char01_m02_stg06_03"
msgstr "Brūks: Piebeigsim tos un turpināsim."

msgid "vo_ob_char01_m02_stg06_03_01"
msgstr "Brūks: Mums jāpanāk otrā uzbrukuma komandai."

msgid "vo_ob_char01_m02_stg07_02"
msgstr "Brūks: Tikai nepazaudē galvu. Tīģeris ir Tīģeris."

msgid "vo_ob_char01_m02_stg07_02_01"
msgstr "Brūks: Tie ir neticami bīstami."

msgid "vo_ob_char01_m02_stg07_04"
msgstr "Brūks: Atkal runājiet par savu medaļu! Vai jūs šeit esiet tikai dekorācijas dēļ?"

msgid "vo_ob_char01_m02_stg08_01"
msgstr "Brūks: Labas ziņas: Mēs panācām otro grupu. "

msgid "vo_ob_char01_m02_stg08_02"
msgstr "Brūks: Sasodīts! Ielenciet to! Ielenciet to!"

msgid "vo_ob_char01_m02_stg08_04"
msgstr "Brūks: Sasodīts! Šaujiet ar pārliecību!"

msgid "vo_ob_char01_m02_stg08_05"
msgstr "Brūks: Vads, jūsu uzmanību: Visas sabiedroto grupas tika iznīcinātas."

msgid "vo_ob_char01_m02_stg08_05_01"
msgstr "Brūks: Mēs tagad esam vieni. Mums vajag izpildīt misiju. Braucam."

msgid "vo_ob_char01_m02_stg09_01"
msgstr "Brūks: Brūks: Pretinieks uz pulksten 12!"

msgid "vo_ob_char01_m02_stg09_03"
msgstr "Brūks: Es nedomāju, ka tie bija pēdējie."

msgid "vo_ob_char01_m02_stg09_03_01"
msgstr "Brūks: Izlūkošana teica, ka mēs redzēsim vairāk nekā Tīģerus."

msgid "vo_ob_char01_m02_stg10_01"
msgstr "Brūks: Svētais... Tā nav Pantera. Tas ir Karalis Tīģeris."

msgid "vo_ob_char01_m02_stg10_03"
msgstr "Brūks: Jums vajadzētu iegūt medaļu par to, noteikti."

msgid "vo_ob_char01_m02_stg10_05"
msgstr "Brūks: Mēs nevaram cauršaut to no priekšas. Ielenksim to."

msgid "vo_ob_char01_m02_stg11_01"
msgstr "Brūks: Kustieties! Neļaujiet viņiem tēmēt!"

msgid "vo_ob_char01_m02_stg11_03"
msgstr "Brūks: Sasodīts! Trāpīja manām kāpurķēdēm. Esmu imobilizēts!"

msgid "vo_ob_char02_intro_02"
msgstr "MacLeod: Bet viņi deg tik jauki."

msgid "vo_ob_char02_intro_04"
msgstr "MacLeod: Tas arī dega jauki."

msgid "vo_ob_char02_intro_06"
msgstr "MacLeod: Hej, Seržant Brūks - kāpēc \"Pērkons\"?"

msgid "vo_ob_char02_intro_06_01"
msgstr "MacLeod: Lai iedvestu bailes mūsu pretinieku sirdīs ar tikai nosaukumu?"

msgid "vo_ob_char02_intro_08"
msgstr "MacLeod: Hm... Manam Firefly arī vajag nosaukumu. Es saukšu to par \"Betsiju\"."

msgid "vo_ob_char02_intro_10"
msgstr "MacLeod: Par godu manai vecmāmiņai. Es no viņas baidījos..."

msgid "vo_ob_char02_intro_13"
msgstr "MacLeod: Hej, Sherman, tu nomodā? Tieši laikā!"

msgid "vo_ob_char02_intro_14"
msgstr "MacLeod: Tu parazīts!"

msgid "vo_ob_char02_intro_15"
msgstr "MacLeod: Labs šāviens, Sherman! Prieks redzēt tevi atpakaļ uz kājām!"

msgid "vo_ob_char02_intro_16"
msgstr "MacLeod: Vēl divi manam rezultātam! Seržant Brūks, kur ir mana medaļa?"

msgid "vo_ob_char02_intro_18"
msgstr "MacLeod: Tipiski..."

msgid "vo_ob_char02_m01_stg00_01"
msgstr "MacLeod: Braucam, Sherman."

msgid "vo_ob_char02_m01_stg00_02"
msgstr "MacLeod: Sherman, celies."

msgid "vo_ob_char02_m01_stg00_03"
msgstr "MacLeod: Nestāvi tur. Brauc!"

msgid "vo_ob_char02_m01_stg00_04"
msgstr "MacLeod: Vai tavs tanks atkal ir apstājies vai kas?"

msgid "vo_ob_char02_m01_stg00_05"
msgstr "MacLeod: Kustamies, vai arī palaidīsim garām šovu!"

msgid "vo_ob_char02_m01_stg010_02"
msgstr "MacLeod: Ah, tu sasodītais... Tu par to atbildēsi!"

msgid "vo_ob_char02_m01_stg010_03"
msgstr "MacLeod: Izmanto optiku, Veiksmīgais!"

msgid "vo_ob_char02_m01_stg010_03_01"
msgstr "MacLeod: Ā! Tas tikko iznāca. Laikam saukšu tevi par Veiksmīgo!"

msgid "vo_ob_char02_m01_stg012_01"
msgstr "MacLeod: Viss labi, Veiksmīgais. Mums noteikti pietrūka tavs stils šeit."

msgid "vo_ob_char02_m01_stg013_01"
msgstr "MacLeod: Wow! Ir pietiekami visiem."

msgid "vo_ob_char02_m01_stg015_02"
msgstr "MacLeod: Gribi nedaudz konkurenci, Veiksmīgais?"

msgid "vo_ob_char02_m01_stg015_03"
msgstr "MacLeod: Uz priekšu, sadedziniet tos!"

msgid "vo_ob_char02_m01_stg015_04"
msgstr "MacLeod: Kas par liesmu!"

msgid "vo_ob_char02_m01_stg016_01"
msgstr "MacLeod: Tas bija karsti! Tev ir mana cieņa."

msgid "vo_ob_char02_m01_stg016_01_01"
msgstr "MacLeod: Ir pagājis kāds laiks kopš es redzēju kaut ko tādu!"

msgid "vo_ob_char02_m01_stg016_03"
msgstr "MacLeod: Ej, Seržant Brūks, kā ar to medaļu?"

msgid "vo_ob_char02_m01_stg016_05"
msgstr "MacLeod: Ha!"

msgid "vo_ob_char02_m01_stg01_02"
msgstr "MacLeod: Izdomāsim arī nosaukumu priekš Sherman."

msgid "vo_ob_char02_m01_stg01_04"
msgstr "MacLeod: Ha! Viņa nosaukums bija Ruaraidh."

msgid "vo_ob_char02_m01_stg01_05"
msgstr "MacLeod: Tas noteikti nobiedēs pretinieku."

msgid "vo_ob_char02_m01_stg01_05_01"
msgstr "MacLeod: Bet es šaubos, ka varēsi to uzrakstīt!"

msgid "vo_ob_char02_m01_stg01_06"
msgstr "MacLeod: Labi, Shermam, ejam. Šovs jau ir sācies!"

msgid "vo_ob_char02_m01_stg02_01"
msgstr "MacLeod: Brauc apkārt, Sherman."

msgid "vo_ob_char02_m01_stg02_02"
msgstr "MacLeod: Ja to noķersi, tu zaudēsi ātrumu un kļūsi par vieglu mērķi."

msgid "vo_ob_char02_m01_stg02_03"
msgstr "MacLeod: Varbūt \"Kaujas Vagons\"? Kā ar to nosaukumu?"

msgid "vo_ob_char02_m01_stg03_03"
msgstr "MacLeod: Uz priekšu! Izveidosim dažus ekstra caurumus tajā lūznī!"

msgid "vo_ob_char02_m01_stg04_02"
msgstr "MacLeod: Kā ar \"Nāves Mašīna\"?"

msgid "vo_ob_char02_m01_stg04_04"
msgstr "MacLeod: Pērkons!"

msgid "vo_ob_char02_m01_stg05_02"
msgstr "MacLeod: Mūsu puiši zina, ko viņi dara! Kāds iespaidīgs uguns šovs!"

msgid "vo_ob_char02_m01_stg06_02"
msgstr "MacLeod: Uguni, Nāves Mašīna, uguni!"

msgid "vo_ob_char02_m01_stg06_03"
msgstr "MacLeod: Mums vajag īsāku nosaukumu."

msgid "vo_ob_char02_m01_stg06_04"
msgstr "MacLeod: Nu! Pagriez torni! Sacep tos rūsas spaiņus!"

msgid "vo_ob_char02_m01_stg07_01"
msgstr "MacLeod: Jēziņ! Tas bija tuvu."

msgid "vo_ob_char02_m01_stg09_01"
msgstr "MacLeod: Jūs neaizbēgsiet no mums! Ķeram tos..."

msgid "vo_ob_char02_m01_stg09_01_01"
msgstr "MacLeod: Pļāvējs? Kā ar Pļāvējs?"

msgid "vo_ob_char02_m02_stg01_02"
msgstr "MacLeod: Lai medības sākas!"

msgid "vo_ob_char02_m02_stg01_02_01"
msgstr "MacLeod: Nu, Veiksmīgais, izskatās, ka šī būs diena, kad MacLeod paķers titulu \"Tīģeru Mednieks\" no tevis!"

msgid "vo_ob_char02_m02_stg01_04"
msgstr "MacLeod: Nē. Dažādi caurumu izmēri. Tie bija vidējie tanki."

msgid "vo_ob_char02_m02_stg02_02"
msgstr "MacLeod: Pff... Mazas medības. Nekas interesants."

msgid "vo_ob_char02_m02_stg02_04"
msgstr "MacLeod: Ser, jā ser! Tā turpini, Veiksmīgais!"

msgid "vo_ob_char02_m02_stg03_02"
msgstr "MacLeod: Nav nebija gudri no viņiem. Ar mūsu optiku, viņi ir sēdošas pīles."

msgid "vo_ob_char02_m02_stg04_01"
msgstr "MacLeod: Lūk nāk otrais. Hej, Veiksmīgais - atstāj man pēdējo, ja?"

msgid "vo_ob_char02_m02_stg04_03"
msgstr "MacLeod: Sasodīts! Vai es to teicu skaļi?"

msgid "vo_ob_char02_m02_stg05_02"
msgstr "MacLeod: Esi optimistiskāks, Seržant! Tagad būs pāreja."

msgid "vo_ob_char02_m02_stg05_05"
msgstr "MacLeod: Man ir labas acis. Redzēju lidmašīnu."

msgid "vo_ob_char02_m02_stg05_07"
msgstr "MacLeod: Jā? Domāju tā ir mūsu."

msgid "vo_ob_char02_m02_stg06_02"
msgstr "MacLeod: It kā mēs būtu šautuvē. Ko viņi domā?"

msgid "vo_ob_char02_m02_stg07_01"
msgstr "MacLeod: Es domāju ka viņi būs tie, kas spēlēs turēšanos līdzi."

msgid "vo_ob_char02_m02_stg07_01_01"
msgstr "MacLeod: Viņi veica diezgan lielu apkārtceļu. Caur tavu fordu."

msgid "vo_ob_char02_m02_stg07_01_02"
msgstr "MacLeod: Tiem Tīģeriem ir mūsu nosaukumi uz tiem."

msgid "vo_ob_char02_m02_stg07_03"
msgstr "MacLeod: Un tas ir labi."

msgid "vo_ob_char02_m02_stg07_03_01"
msgstr "MacLeod: Cik daudz man vajag aizšaut, lai beidzot nopelnītu manu medaļu?"

msgid "vo_ob_char02_m02_stg07_05"
msgstr "MacLeod: Par to galīgi neraizējos."

msgid "vo_ob_char02_m02_stg07_05_01"
msgstr "MacLeod: Es vienkārši gribu viņu padarīt laimīgu, saproti?"

msgid "vo_ob_char02_m02_stg07_05_02"
msgstr "MacLeod: Viņa to izrādīs visiem mūsu kaimiņiem. Un viņa ar mani leposies."

msgid "vo_ob_char02_m02_stg07_05_03"
msgstr "MacLeod: Beidzot."

msgid "vo_ob_char02_m02_stg08_03"
msgstr "MacLeod: Tas ir viens izturīgs jauktenis."

msgid "vo_ob_char02_m02_stg08_03_01"
msgstr "MacLeod: Tēmējiet uz vājajiem punktiem, Veiksmīgais! Sāni un aizmugure!"

msgid "vo_ob_char02_m02_stg08_04"
msgstr "MacLeod: Tas jauki deg!"

msgid "vo_ob_char02_m02_stg08_05"
msgstr "MacLeod: Tas ir izturīgs jauktenis! Meklējiet tā vājās vietas, Veiksmīgais."

msgid "vo_ob_char02_m02_stg08_05_01"
msgstr "MacLeod: Tēmējiet uz tā vēderu - tas vienmēr ir plāns zem priekšējām bruņām!"

msgid "vo_ob_char02_m02_stg08_06"
msgstr "MacLeod: Tas ir izturīgs jauktenis! Meklējiet tā vājās vietas, Veiksmīgais!"

msgid "vo_ob_char02_m02_stg08_07"
msgstr "MacLeod: Tēmējiet uz tā vēderu - tas vienmēr ir plāns zem priekšējām bruņām!"

msgid "vo_ob_char02_m02_stg08_08"
msgstr "MacLeod: Tēmējiet uz kupolu - tiem grūti trāpīt, bet viegli cauršaut."

msgid "vo_ob_char02_m02_stg09_02"
msgstr "MacLeod: Atcerieties kustēties, Veiksmīgais. Vai viņi trāpīt tavos vājajos punktos."

msgid "vo_ob_char02_m02_stg09_02_01"
msgstr "MacLeod: Vai tu vari slēpt savu korpusu aiz tanku vrakiem."

msgid "vo_ob_char02_m02_stg09_02_02"
msgstr "MacLeod: Viņi tev netrāpīs tādā veidā - tev ir izturīgs tornis."

msgid "vo_ob_char02_m02_stg09_04"
msgstr "MacLeod: Tie izlūkošanas puiši... Droši vien nezina neko."

msgid "vo_ob_char02_m02_stg09_04_01"
msgstr "MacLeod: Kas vēl tur var būt? Panteras?"

msgid "vo_ob_char02_m02_stg10_02"
msgstr "MacLeod: Neesmu to redzējis iepriekš."

msgid "vo_ob_char02_m02_stg10_04"
msgstr "MacLeod: Jā, beidzot!"

msgid "vo_ob_char02_m02_stg10_06"
msgstr "MacLeod: Veiksmīgais! Sāni! Aizmugure! Šaujiet pa vājajiem punktiem!"

msgid "vo_ob_char02_m02_stg11_02"
msgstr "MacLeod: Nav izredžu, ka šis muļķis spēs sekot līdzi mums Sherman."

msgid "vo_ob_char02_m02_stg11_04"
msgstr "MacLeod: Veiksmīgais, daboniet viņus - ātri!"

msgid "vo_ob_char02_m02_stg12_01"
msgstr "MacLeod: Brūks! Sasodīts, Brūks, saki kaut ko!"

msgid "vo_ob_char02_m02_stg13_01"
msgstr "MacLeod: Ielenciet tos! Trāpiet to vājajiem punktiem!"

msgid "vo_ob_char02_m02_stg13_02"
msgstr "MacLeod: Veiksmīgais, šaujiet to sāniem un aizmugurei!"

msgid "vo_ob_char02_m02_stg13_03"
msgstr "MacLeod: Tornis ir izturīgs tikai no priekšpuses. Turpiniet kustēties!"

msgid "vo_ob_char02_m02_stg14_01"
msgstr "MacLeod: Tieši tā."

msgid "vo_ob_char02_m02_stg14_02"
msgstr "MacLeod: Tie deg. Jauki deg."

msgid "vo_ob_char02_m02_stg14_03"
msgstr "MacLeod: Tīģeru Mednieks: Tas oficiāli ir tavs tituls."

msgid "vo_sm_char01_m03_stg01_02"
msgstr "Brūks: Šeit štābs. Seržants Brūks izsauc Tīģeru Medniekus."

msgid "vo_sm_char01_m03_stg01_02_01"
msgstr "Brūks: Pilsēta un tās nomale ir mīnās. Virzieties uzmanīgi."

msgid "vo_sm_char01_m03_stg01_04"
msgstr "Brūks: Es priecājos to dzirdēt, Makleod."

msgid "vo_sm_char01_m03_stg01_04_01"
msgstr "Brūks: Bet palieciet uzmanīgi tur. Pa ceļam sagaidiet milzīgus mīnu laukus."

msgid "vo_sm_char01_m03_stg01_06"
msgstr "Brūks: Ko labi parīvēt?"

msgid "vo_sm_char01_m03_stg03_02"
msgstr "Brūks: Kas liek jums domāt, ka Veiksmīgajam arī ir rituāls?"

msgid "vo_sm_char01_m03_stg04_02"
msgstr "Brūks: Tagad nekļūsti pārāk pašpārliecināts. Tēmējiet uz to pašu mērķi. Palieciet kopā."

msgid "vo_sm_char01_m03_stg07_03"
msgstr "Brūks: Vecais vīrs? Tiešām?"

msgid "vo_sm_char01_m03_stg07_05"
msgstr "Brūks: Esmu tikai sešus gadus vecāks par tevi, Makleod."

msgid "vo_sm_char01_m03_stg08_02"
msgstr "Brūks: Varbūt viņi vienkārši ir pieklājīgi, ļaujot tev visu runāt, Makleod!"

msgid "vo_sm_char01_m03_stg10_02"
msgstr "Brūks: Makleod, dod man statusa ziņojumu."

msgid "vo_sm_char01_m03_stg10_04"
msgstr "Brūks: Tas pats vecais Makleods."

msgid "vo_sm_char01_m03_stg11_02"
msgstr "Brūks: Tev ir Veiksmīgais. Viņš nes veiksmi labāk par jebkuru amuletu."

msgid "vo_sm_char01_m03_stg11_02_01"
msgstr "Brūks: Atrodiet alternatīvu maršrutu, zēni!"

msgid "vo_sm_char01_m03_stg14_02"
msgstr "Brūks: Uzmanību, Mednieki."

msgid "vo_sm_char01_m03_stg14_02_01"
msgstr "Brūks: Sabiedroto bumbvedēji tuvojas jūsu pozīcijai. Esiet piesardzīgi."

msgid "vo_sm_char01_m03_stg14_02_02"
msgstr "Brūks: Turiet distanci no šiem ienaidnieka tankiem."

msgid "vo_sm_char01_m03_stg15_02"
msgstr "Brūks: Vai jums viss kārtībā?"

msgid "vo_sm_char01_m03_stg18_02"
msgstr "Brūks: Nav padoma, Makleod. Bet mums ir gaisa atbalsts. Gatavo pilotu tagad."

msgid "vo_sm_char01_m03_stg21_02"
msgstr "Brūks: Paliec uz mērķi, Makleod. Mums ir jāatbrīvo pēdējais laukums."

msgid "vo_sm_char01_m03_stg21_02_01"
msgstr "Brūks: Vēlāk pie tējas tases varat apspriest savas māņticības."

msgid "vo_sm_char01_m03_stg21_04"
msgstr "Brūks: Lai ko tu teiktu."

msgid "vo_sm_char01_m03_stg25_03"
msgstr "Brūks: Neesi stulbs, man nevajag laimes piekariņus."

msgid "vo_sm_char01_m03_stg25_05"
msgstr "Brūks: Plānošana un Stratēģija, Makleod, Plānošana un Stratēģija."

msgid "vo_sm_char01_m03_stg26_02"
msgstr "Brūks: Galda kas?"

msgid "vo_sm_char01_m03_stg28_03"
msgstr "Brūks: Sasodīts, izlūkošana par to neziņoja…"

msgid "vo_sm_char01_m03_stg28_07"
msgstr "Brūks: Mēs darām visu, ko varam."

msgid "vo_sm_char01_m03_stg30_02"
msgstr "Brūks: Es saņēmu ziņojumu, ka Ērglis Viens ir dzīvs. Labs darbs, puiši."

msgid "vo_sm_char01_m03_stg30_03"
msgstr "Brūks: Tev taisnība, Makleod, dažreiz mums ir vajadzīgi šie laimīgie piekariņi."

msgid "vo_sm_char01_m03_stg30_03_01"
msgstr "Brūks: Un jā, man tāds ir. Tintinnabulum ar fascinus."

msgid "vo_sm_char01_m03_stg30_05"
msgstr "Brūks: (smejas)"

msgid "vo_sm_char01_m03_stg32_04"
msgstr "Brūks: Veiksmīgais, laiks ripot. Mēs neesam šeit, lai apskatītu apskates vietas."

msgid "vo_sm_char01_m03_stg32_05"
msgstr "Brūks: Uz priekšu, Veiksmīgais! Šajā cīņā katra sekunde ir svarīga."

msgid "vo_sm_char01_m03_stg32_06"
msgstr "Brūks: Veiksmīgais, mums ir jāpabeidz misija. Sāksim kustēties."

msgid "vo_sm_char01_m03_stg33_02"
msgstr "Brūks: Betsija tiešām to teica?"

msgid "vo_sm_char01_m03_stg34_01"
msgstr "Brūks: Laiks ir pret mums. Tagad bez varoņdarbiem."

msgid "vo_sm_char01_m03_stg34_01_01"
msgstr "Brūks: Ja iespējams, vienmēr iespied ienaidniekam netiklā. Lieciet viņiem locīties un sitiet pa sāniem."

msgid "vo_sm_char01_m03_stg40_01"
msgstr "Brūks: Sūtu papildspēkus tavā ceļā. Turies cieši."

msgid "vo_sm_char01_m03_stg40_02"
msgstr "Brūks: Papildspēki ir ceļā. Drīz vajadzētu būt klāt."

msgid "vo_sm_char01_m03_stg40_03"
msgstr "Brūks: Ceļā ir jauni sabiedroto tanki."

msgid "vo_sm_char01_m03_stg42_05"
msgstr "Brūks: Atpakaļ uz ceļa, komandieri. Turiet galvu uz leju un virzieties uz priekšu."

msgid "vo_sm_char01_m03_stg42_06"
msgstr "Brūks: Ar šo tanku rīkojieties uzmanīgi. Mums beidzas rezerves."

msgid "vo_sm_char01_m03_stg42_07"
msgstr "Brūks: Tev ir vēl viena iespēja. Izmanto to."

msgid "vo_sm_char01_m04_stg01_02"
msgstr "Brūks: Šeit Štābs, runā Seržants Brūks."

msgid "vo_sm_char01_m04_stg01_04"
msgstr "Brūks: Nē."

msgid "vo_sm_char01_m04_stg01_04_01"
msgstr "Brūks: Es ceru."

msgid "vo_sm_char01_m04_stg02_02"
msgstr "Brūks: Nē. Kaut kas liels un smags. Sabiedrotie jau ir veikuši vairākus mēģinājumus."

msgid "vo_sm_char01_m04_stg02_02_01"
msgstr "Brūks: Nosūtīju dažus tanku pulkus. Neviens neatgriezās."

msgid "vo_sm_char01_m04_stg03_02"
msgstr "Brūks: Nē, izlūkošana ziņo, ka mūsu mērķis joprojām atrodas pilsētā."

msgid "vo_sm_char01_m04_stg05_01"
msgstr "Brūks: Turies! Tagad nav īstais laiks riskēt! Tev ir cita misija, uz kuru koncentrēties."

msgid "vo_sm_char01_m04_stg06_02"
msgstr "Brūks: Es iesaku izmantot dūzi piedurknē."

msgid "vo_sm_char01_m04_stg07_01"
msgstr "Brūks: Štābs izsauc Storm Petrel, atsaucies."

msgid "vo_sm_char01_m04_stg07_03"
msgstr "Brūks: Mērķis ir Karalis Tīģeris uz tilta pie tīkla C3."

msgid "vo_sm_char01_m04_stg08_03"
msgstr "Brūks: Pagaidi, Makleod. Likmes ir pārāk augstas."

msgid "vo_sm_char01_m04_stg08_03_01"
msgstr "Brūks: Strādājiet kopā. Imobilizējiet Tīģeri. Storm Petrel izveidos citu ceļu."

msgid "vo_sm_char01_m04_stg08_03_02"
msgstr "Brūks: Imobilizējiet Tīģeri. Storm Petrel izveidos citu ceļu."

msgid "vo_sm_char01_m04_stg13_03"
msgstr "Brūks: Mums nav skaidras informācijas, Makleod."

msgid "vo_sm_char01_m04_stg13_03_01"
msgstr "Brūks: Kaut kas eksperimentāls. Prototips. Un tas ir labs. "

msgid "vo_sm_char01_m04_stg14_02"
msgstr "Brūks: Makleod, tev nav laika tam. Tā nav tava problēma."

msgid "vo_sm_char01_m04_stg15_01"
msgstr "Brūks: Apejiet to pa sānielām. Un iedod Benetam koordinātas."

msgid "vo_sm_char01_m04_stg15_03"
msgstr "Brūks: Storm Petrel."

msgid "vo_sm_char01_m04_stg17_02"
msgstr "Brūks: Typ 205."

msgid "vo_sm_char01_m04_stg17_04"
msgstr "Brūks: Kāpēc \"Mazā Pele\"?"

msgid "vo_sm_char01_m04_stg19_02"
msgstr "Brūks: Tā ir izlūkošana. Viņiem jau vajadzēja būt atpakaļ bāzē."

msgid "vo_sm_char01_m04_stg23_02"
msgstr "Brūks: Atvaino, Makleod. Laikam izslīdēja."

msgid "vo_sm_char01_m04_stg24_06"
msgstr "Brūks: Varētu, bet tā organizēšana prasīs kādu laiku."

msgid "vo_sm_char01_m04_stg26_02"
msgstr "Brūks: Tā bija slēpena operācija."

msgid "vo_sm_char01_m04_stg26_02_01"
msgstr "Brūks: Bet tu nolēmi, ka vēlies pats parūpēties par to Jagdtiger."

msgid "vo_sm_char01_m04_stg26_04"
msgstr "Brūks: Viņi iestrēga frontālos uzbrukumos."

msgid "vo_sm_char01_m04_stg27_01"
msgstr "Brūks: Bumbvedēji šobrīd ierindojas skrējienā. Gatavojieties uguņošanai."

msgid "vo_sm_char01_m04_stg28_02"
msgstr "Brūks: Kopš kura laika tu sāki čīkstēt, Makleod?"

msgid "vo_sm_char01_m04_stg30_03"
msgstr "Brūks: Kurš teica, ka tie bija viņa pirmie Tīģeri? Kāpēc domā es viņu atvedu uz šo misiju?"

msgid "vo_sm_char01_m04_stg31_02"
msgstr "Brūks: Tu veido labu komandu, Makleod."

msgid "vo_sm_char01_m04_stg33_02"
msgstr "Brūks: Sasodīts! Veiksmīgais, esi uzmanīgs un… lai veicas!"

msgid "vo_sm_char01_m04_stg35_01"
msgstr "Brūks: Papildspēki ir ceļā uz jūsu vietu."

msgid "vo_sm_char01_m04_stg35_01_01"
msgstr "Brūks: Sabiedroto tanki, kurus tu izglābi. Makleod, tavas pūles nebija veltīgas."

msgid "vo_sm_char01_m04_stg42_02"
msgstr "Brūks: Ir ieradusies jauna sabiedroto grupa."

msgid "vo_sm_char01_m04_stg42_02_01"
msgstr "Brūks: Cerams, ka ar viņu palīdzību būs vieglāk sakaut šo Mazo Peli."

msgid "vo_sm_char01_m04_stg42_03"
msgstr "Brūks: Bet atceries, ka pēdējam šāvienam ir jābūt mūsu."

msgid "vo_sm_char01_m04_stg42_03_01"
msgstr "Brūks: Tam ir jābūt mūsu trofejai. Veiksmīgais, Benet, nepievil mūs."

msgid "vo_sm_char01_m04_stg47_01"
msgstr "Brūks: Lielisks darbs, puiši. Nosūtu komandu evakuācijai."

msgid "vo_sm_char01_m04_stg47_01_01"
msgstr "Brūks: Makleod, mums vajag tevi un Peli dabūt ārā. Ir svarīgi, lai tas nonāktu mūsu rokās."

msgid "vo_sm_char01_m04_stg47_01_02"
msgstr "Brūks: Uzskati ka tavas medaļas ir iegūtas."

msgid "vo_sm_char01_m04_stg47_03"
msgstr "Brūks: Ko tad tu gribi, Makleod? Jaunu rangu?"

msgid "vo_sm_char02_m03_stg01_01"
msgstr "Makleods: Labi, kungi, ir pienācis laiks izbraukt un atbrīvot šo pilsētu!"

msgid "vo_sm_char02_m03_stg01_03"
msgstr "Makleods: Brūks?! Seržants Brūks?! Tā ir laba ziņa! Esam drošās rokās!"

msgid "vo_sm_char02_m03_stg01_05"
msgstr "Makleods: Ser, jā, ser!"

msgid "vo_sm_char02_m03_stg01_05_01"
msgstr "Makleods: Puiši! Pirms pirmā šāviena paberzējiet savas laimīgās monētas!"

msgid "vo_sm_char02_m03_stg01_07"
msgstr "Makleods: Ko? Es neesmu māņticīgs, tā ir tikai tradīcija!"

msgid "vo_sm_char02_m03_stg02_01"
msgstr "Makleods: Lūk nāk mūsu mīluļi."

msgid "vo_sm_char02_m03_stg02_01_01"
msgstr "Makleods: Pirmā Skotu \"tējas\" kārta ir uz manis tam, kurš iznīcina visvairāk!"

msgid "vo_sm_char02_m03_stg02_01_02"
msgstr "Makleods: Parādīsim viņiem, kā mēs to darām, Veiksmīgais!"

msgid "vo_sm_char02_m03_stg03_01"
msgstr "Makleods: Nedaudz pārāk kluss manai gaumei. Kur ir izaicinājums?"

msgid "vo_sm_char02_m03_stg03_01_01"
msgstr "Makleods: Katrā ziņā...Veiksmīgais, pastāsti – kāds ir tavs laimīgais rituāls?"

msgid "vo_sm_char02_m03_stg03_03"
msgstr "Makleods: Mums visiem ir savi mazie triki veiksmei, vai ne, Veiksmīgais?"

msgid "vo_sm_char02_m03_stg03_03_01"
msgstr "Makleods: Varbūt deja? Ātra džiga, pirms ķeraties pie cīņas?"

msgid "vo_sm_char02_m03_stg04_01"
msgstr "Makleods: Ak, to es saprotu! Izskatās, ka šie džeki ir gatavi cīņai."

msgid "vo_sm_char02_m03_stg05_01"
msgstr "Makleods: Gudri vārdi, vecais Brūks. Veiksmīgais, palīdzi man ar šo."

msgid "vo_sm_char02_m03_stg05_01_01"
msgstr "Makleods: Es paturēšu zvēru aizņemtu, un jūs piezodzieties apkārt tam labajā pusē."

msgid "vo_sm_char02_m03_stg05_01_02"
msgstr "Makleods: Sagādāsim viņiem kārtīgu pārsteigumu, vai ne?"

msgid "vo_sm_char02_m03_stg06_01"
msgstr "Makleods: Šis ir ciets rieksts, Veiksmīgais! Saplosiet to!"

msgid "vo_sm_char02_m03_stg07_01"
msgstr "Makleods: Neļaujiet tam aizmukt! Viņš sagraus visu mūsu pārsteigumu!"

msgid "vo_sm_char02_m03_stg07_02"
msgstr "Makleods: Gatavs un noputināts!"

msgid "vo_sm_char02_m03_stg07_04"
msgstr "Makleods: Tikai mazliet draudzīgas izjokošanas ar visu cieņu, \"se-e-e-er\"!"

msgid "vo_sm_char02_m03_stg07_06"
msgstr "Makleods: Labi, labi, es zinu."

msgid "vo_sm_char02_m03_stg08_01"
msgstr "Makleods: Puiši, kāpēc jūs šodien esat tik mazrunīgi?"

msgid "vo_sm_char02_m03_stg08_03"
msgstr "MacLeod: Ha!"

msgid "vo_sm_char02_m03_stg09_00"
msgstr "Makleods: Šķiet, ka šajā juceklī mēs esam nogāzuši dažus lapseņu pūžņus."

msgid "vo_sm_char02_m03_stg09_00_01"
msgstr "Makleods: Atceries noslēpt savu korpusu aiz šiem pauguriem vai sadedzinātiem ienaidniekiem, Veiksmīgais."

msgid "vo_sm_char02_m03_stg09_00_02"
msgstr "Makleods: Uzmetiet aci ar jūsu torni - tā ir izturīgākā vieta jūsu tankā."

msgid "vo_sm_char02_m03_stg09_01"
msgstr "Makleods: Pareizi, šis ir nopietns sāncensis, bez jokiem."

msgid "vo_sm_char02_m03_stg09_01_01"
msgstr "Makleods: Mēs nevaram cīnīties ar viņu aci pret aci, tāpēc pieturieties pie plāna."

msgid "vo_sm_char02_m03_stg09_01_02"
msgstr "Makleods: Es piesaistīšu viņa uzmanību, un tu iesi uz flangu. Bet esi uzmanīgs, Veiksmīgais."

msgid "vo_sm_char02_m03_stg09_02"
msgstr "Makleods: Ja tas vērš uzmanību pret jums, nemēģiniet tēlot varoni — slēpieties."

msgid "vo_sm_char02_m03_stg09_02_01"
msgstr "Makleods: Tā lielgabals kā pa sviestu griezīsies cauri mūsu Sherman."

msgid "vo_sm_char02_m03_stg09_03"
msgstr "Makleods: Vienkārši turiet to aizņemtu, un es ķeršos, lai iekostu no aizmugures."

msgid "vo_sm_char02_m03_stg10_01"
msgstr "Makleods: Fu, tas bija grūti!"

msgid "vo_sm_char02_m03_stg10_03"
msgstr "Makleods: Vēl neesmu saskāries ar nevienu Tīģeri. Mums viņi ir vajadzīgi, lai noskaidrotu, kurš ir labākais!"

msgid "vo_sm_char02_m03_stg10_05"
msgstr "Makleods: Vecs! Ha!"

msgid "vo_sm_char02_m03_stg11_01"
msgstr "Makleods: Uzgaidiet puiši!"

msgid "vo_sm_char02_m03_stg11_01_01"
msgstr "Makleods: Mīnas. Un šeit tu smējies par laimes piekariņiem, Brūks."

msgid "vo_sm_char02_m03_stg11_01_02"
msgstr "Makleods: Mums ir vajadzīga visa veiksme, ko mēs šeit varam iegūt!"

msgid "vo_sm_char02_m03_stg12_01"
msgstr "Makleods: Hej, Veiksmīgais! Atradām mums citu maršrutu. Braucam."

msgid "vo_sm_char02_m03_stg12_01_01"
msgstr "Makleods: Ko jūs darītu bez vecā labā Makleoda!"

msgid "vo_sm_char02_m03_stg12_02"
msgstr "Makleods: Jūs sēdētu šeit līdz vakaram! Ha!"

msgid "vo_sm_char02_m03_stg12_03"
msgstr "Makleods: Jūs atradāt apkārtceļu! Izcili!"

msgid "vo_sm_char02_m03_stg12_03_01"
msgstr "Makleods: Es sāku domāt, ka mēs paliksim šeit, gaidot inženierus līdz vakaram."

msgid "vo_sm_char02_m03_stg13_01"
msgstr "Makleods: Paskaties uz to, Veiksmīgais! Divi Tīģeri! Mūsu sacensības ir atgriezušās."

msgid "vo_sm_char02_m03_stg14_01"
msgstr "Makleods: Bet šī iela ir pārāk šaura. Uzlauzt Tīģera frontālās bruņas nav viegls uzdevums."

msgid "vo_sm_char02_m03_stg14_03"
msgstr "Makleods: Forši! Pagaidiet, mēs būsim liecinieki kādam lieliskam darbam."

msgid "vo_sm_char02_m03_stg14_03_01"
msgstr "Makleods: Mūsu zēni debesīs iznīcinās šos tērauda zvērus ar ķirurģisku precizitāti."

msgid "vo_sm_char02_m03_stg15_01"
msgstr "Makleods: Ak, kas tas bija?! Tas bija pārāk skaļi!"

msgid "vo_sm_char02_m03_stg15_01_01"
msgstr "Makleods: Ak, kas tas bija?!"

msgid "vo_sm_char02_m03_stg15_03"
msgstr "Makleods: Jā, mēs esam neskarti, bet es nometu savu laimes monētu!"

msgid "vo_sm_char02_m03_stg15_03_01"
msgstr "Makleods: Un es nevaru redzēt dažas ēkas, kas šeit bija agrāk."

msgid "vo_sm_char02_m03_stg16_01"
msgstr "Makleods: Veiksmīgais! Paskaties, tur ir otrais Tīģeris, kurš joprojām spārdās."

msgid "vo_sm_char02_m03_stg16_01_01"
msgstr "Makleods: Izmantosim šo jauno spraugu savā labā. Saspiediet to no abām pusēm."

msgid "vo_sm_char02_m03_stg17_01"
msgstr "Makleods: Labs šāviens! Tas ir vēl viens Tīģeris, kas tika pieskaitīts mūsu skaitītājam!"

msgid "vo_sm_char02_m03_stg18_01"
msgstr "Makleods: Ak vai! Vairāk Tīģeru! Ko mēs izdarījām, lai būtu pelnījuši visas šīs dāvanas?"

msgid "vo_sm_char02_m03_stg18_01_01"
msgstr "Makleods: Sasodīts, šeit joprojām ir pārpildīts. Brūks, kāds padoms?"

msgid "vo_sm_char02_m03_stg19_01"
msgstr "Makleods: Man patīk šī puiša stils! Veiksmīgais, pieturēsimies pie mūsu rokasgrāmatas. Izmanto šo jauno eju."

msgid "vo_sm_char02_m03_stg19_01_01"
msgstr "Makleods: Es piespiedīšu no priekšpuses, un tu ložņāsi uz sāniem."

msgid "vo_sm_char02_m03_stg20_01"
msgstr "Makleods: Liksim šim nelietim dejot kā uz karstas pannas."

msgid "vo_sm_char02_m03_stg20_01_01"
msgstr "Makleods: Pagaidi līdz mēs abi esam pārlādējuši, lai viņš nezinātu, no kuras puses nāk šāviens."

msgid "vo_sm_char02_m03_stg20_02"
msgstr "Makleods: Viņi var būt izskatītās skarbi no priekšpuses. Bet to sāni un mugura ir maiga un sulīga!"

msgid "vo_sm_char02_m03_stg21_01"
msgstr "Makleods: Ir jābūt kaut kam, kas tev nes veiksmi, Veiksmīgais. Varbūt tev ir…"

msgid "vo_sm_char02_m03_stg21_03"
msgstr "Makleods: Tradīcijas, Brūks. Nevis māņticības."

msgid "vo_sm_char02_m03_stg21_05"
msgstr "Makleods: Labi, ir pienācis laiks pabeigt šo grandiozo turneju. Ērglis Viens, vai tu dzirdi?"

msgid "vo_sm_char02_m03_stg21_05_01"
msgstr "Makleods: Dodiet mums putna skatu — cik daudz mīlošu līdzjutēju mums joprojām ir laukumā?"

msgid "vo_sm_char02_m03_stg22_02"
msgstr "Makleods: Jāsaka, man patīk šis puisis!"

msgid "vo_sm_char02_m03_stg22_02_01"
msgstr "Makleods: Žēl, ka viņš nenodarbojas ar tanku biznesu. Mēs savā komandā būtu varējuši izmantot tādu puisi kā viņš."

msgid "vo_sm_char02_m03_stg23_01"
msgstr "Makleods: Nu tad tas ir tas, kurš lidoja pēdējo reizi."

msgid "vo_sm_char02_m03_stg23_01_01"
msgstr "Makleods: Ērglis Viens, esiet uzmanīgi tur augšā, ienaidnieka cīnītāji krīt no debesīm."

msgid "vo_sm_char02_m03_stg24_01"
msgstr "Makleods: Mīnas! Es ienīstu mīnas. Atrodi apkārtceļu, Veiksmīgais. Es pievērsīšu viņu uzmanību."

msgid "vo_sm_char02_m03_stg25_01"
msgstr "Makleods: Pieņemsim, ka Veiksmīgais ir dzimis zem laimīgas zvaigznes."

msgid "vo_sm_char02_m03_stg25_01_01"
msgstr "Makleods: Bet kā ar tevi, Brūks? Vai tev ir savs laimīgais amulets?"

msgid "vo_sm_char02_m03_stg25_02"
msgstr "Makleods: Pakavs kabatā? Varbūt tintinnabulum ar fascinus?"

msgid "vo_sm_char02_m03_stg25_04"
msgstr "Makleods: Pagaidi. Vai es uzminēju pareizi?"

msgid "vo_sm_char02_m03_stg26_01"
msgstr "Makleods: Skatieties, puiši, tā leģendas to dara!"

msgid "vo_sm_char02_m03_stg26_01_01"
msgstr "Makleods: Ja nebūtu viņa ievainojuma, arī Brūks būtu šeit ar mums!"

msgid "vo_sm_char02_m03_stg26_01_02"
msgstr "Makleods: Mēs trīs kopā... Nu, nevar neko darīt. Tagad viņš ir rakstāmgalda..."

msgid "vo_sm_char02_m03_stg26_03"
msgstr "Makleods: Rakstāmgalda leģenda, ser!"

msgid "vo_sm_char02_m03_stg27_01"
msgstr "Makleods: Sasodītā elle! Pēdējā lieta, kas mums tagad vajadzīga, ir Artilērija, kas pievienojas ballītei."

msgid "vo_sm_char02_m03_stg27_01_01"
msgstr "Makleods: Vienkārši nesēdi tur, Veiksmīgais — kusties! Liksim viņiem riskēt šaut pa savējiem."

msgid "vo_sm_char02_m03_stg28_02"
msgstr "Makleods: Brūks, no kurienes uzradās šie nelūgtie viesi?"

msgid "vo_sm_char02_m03_stg28_02_01"
msgstr "Makleods: Instruktāžā par tiem nebija ne vārda."

msgid "vo_sm_char02_m03_stg28_04"
msgstr "Makleods: Ak, mana mīļā izlūkošana... vienmēr pieturas pie savām tradīcijām."

msgid "vo_sm_char02_m03_stg28_04_01"
msgstr "Makleods: Ērglis Viens, cik daudz jūs varat noņemt no mūsu rokām?"

msgid "vo_sm_char02_m03_stg28_06"
msgstr "Makleods: Ērglis Viens, beidzu! Ērglis-Viens! Sasodīts!"

msgid "vo_sm_char02_m03_stg28_06_01"
msgstr "Makleods: Brūks, saki, ka tev ir daži cīnītāji, kas viņiem palīdzēs!"

msgid "vo_sm_char02_m03_stg28_08"
msgstr "Makleods: Laimīgais, vai tu viņu redzi? Nu, Ērglis Viens, tu tos vari atkratīt. Sasodīts!"

msgid "vo_sm_char02_m03_stg28_08_01"
msgstr "Makleods: Pabeigsim to, Veiksmīgais. Mēs tos izspiedīsim no abām pusēm. Bez jaukumiem."

msgid "vo_sm_char02_m03_stg29_01"
msgstr "Makleods: Šķiet, ka mums ir nedaudz vairāk kompānijas, nekā gaidīts."

msgid "vo_sm_char02_m03_stg29_01_01"
msgstr "Makleods: Koncentrēšanās uz to pašu mērķi. Mēs tos iznīcināsim pa vienam, Veiksmīgais."

msgid "vo_sm_char02_m03_stg29_01_02"
msgstr "Makleods: Un pudiņam mēs pasniegsim jauku šīs artilērijas šķēli!"

msgid "vo_sm_char02_m03_stg30_01"
msgstr "Makleods: Fū.. Tas bija grūti. Ak, paskaties uz šo! Es atradu savu laimes monētu!"

msgid "vo_sm_char02_m03_stg30_04"
msgstr "Makleods: Pagaidi. Ko??? Nopietni? Man tas ir jāredz!"

msgid "vo_sm_char02_m03_stg31_01"
msgstr "Makleods: Izbraucam Veiksmīgais, pretējā gadījumā mūsu tēja būs tik auksta un nejauka kā Skotijas ziema."

msgid "vo_sm_char02_m03_stg31_02"
msgstr "Makleods: Sākam braukt Veiksmīgais! Tie Tīģeri paši sevi neiznīcinās!"

msgid "vo_sm_char02_m03_stg31_03"
msgstr "Makleods: Šeit nav mīnu, Veiksmīgais. Laiks kustēties."

msgid "vo_sm_char02_m03_stg31_04"
msgstr "Makleods: Veiksmīgais, mēs neesam šeit piknika dēļ. Ejam!"

msgid "vo_sm_char02_m03_stg31_05"
msgstr "Makleods: Nestāvi tikai tur, Veiksmīgais. Artilērija nekad neguļ."

msgid "vo_sm_char02_m03_stg32_01"
msgstr "Makleods: Veiksmīgais, atradīsim ceļu apkārt šīm mīnām."

msgid "vo_sm_char02_m03_stg32_02"
msgstr "Makleods: Nesēdi tur, Veiksmīgais. Izpēti alternatīvu maršrutu."

msgid "vo_sm_char02_m03_stg32_03"
msgstr "Makleods: Skatoties uz šīm mīnām, tās nepazudīs, Veiksmīgais."

msgid "vo_sm_char02_m03_stg32_03_01"
msgstr "Makleods: Atradīsim sev apkārtceļu."

msgid "vo_sm_char02_m03_stg33_01"
msgstr "Makleods: Kā mana nana mēdza teikt: \"Vienmēr ielenciet savu pretinieku un sitiet viņu sānos ar bruņas caurdurošiem lādiņiem.\""

msgid "vo_sm_char02_m03_stg33_03"
msgstr "Makleods: Nu, vairāk vai mazāk."

msgid "vo_sm_char02_m03_stg35_01"
msgstr "Makleods: Atcerieties: Saspiediet ienaidnieku no abām pusēm, un viņi vienmēr kādam no mums atklās vājo vietu."

msgid "vo_sm_char02_m03_stg35_02"
msgstr "Makleods: Ieliksim tos kastē, ielencam no abām pusēm."

msgid "vo_sm_char02_m03_stg35_02_01"
msgstr "Makleods: Tādā veidā viņi noteikti atklās neaizsargātu vietu."

msgid "vo_sm_char02_m03_stg35_03"
msgstr "Makleods: Darīsim to pēc grāmatas: uzbrūk no abām pusēm, un viens no mums noteikti iegūs sulīgu šķēli no šīm plānām sānu bruņām!"

msgid "vo_sm_char02_m03_stg36_01"
msgstr "Makleods: Skaties kur ej, Veiksmīgais!"

msgid "vo_sm_char02_m03_stg36_02"
msgstr "Makleods: Uzmanieties no mīnām!"

msgid "vo_sm_char02_m03_stg36_03"
msgstr "Makleods: Paga! Šīs mīnas nav gluži sajūsmā par mūsu tankiem!"

msgid "vo_sm_char02_m03_stg36_04"
msgstr "Makleods: Mīnas. Es ienīstu mīnas."

msgid "vo_sm_char02_m03_stg36_05"
msgstr "Makleods: Uzmanīgi! Šeit esošajām mīnām ir nepatīkams raksturs."

msgid "vo_sm_char02_m03_stg36_06"
msgstr "Makleods: Mīnas priekšā! Labāk atrast citu ceļu."

msgid "vo_sm_char02_m03_stg37_01"
msgstr "Makleods: Veiksmīgais! Tas bija liels sprādziens! Tev tur viss kārtībā?"

msgid "vo_sm_char02_m03_stg37_02"
msgstr "Makleods: Pagaidi! Kur tu tā steidzies?"

msgid "vo_sm_char02_m03_stg37_02_01"
msgstr "Makleods: Salabo savas kāpurķēdes un brauc atpakaļ!"

msgid "vo_sm_char02_m03_stg37_03"
msgstr "Makleods: Veiksmīgais, ja gribēji izrakt bedri, ir vienkāršāki veidi!"

msgid "vo_sm_char02_m03_stg37_04"
msgstr "Makleods: Stingras līnijas, Veiksmīgais. Šīs mīnas ir zaglīgas."

msgid "vo_sm_char02_m03_stg37_05"
msgstr "Makleods: Tas ir viens no veidiem, kā atrast mīnu. Nav labākais, bet tas darbojas."

msgid "vo_sm_char02_m03_stg37_06"
msgstr "Makleods: Nopurinies, Veiksmīgais. Mēs visi esam dejojuši ar mīnu vai divām."

msgid "vo_sm_char02_m03_stg38_01"
msgstr "Makleods: Uzmanies, Veiksmīgais! Nākamā mīna varētu būt tava pēdējā."

msgid "vo_sm_char02_m03_stg38_02"
msgstr "Makleods: Šķiet, ka tev patīk labot kāpurķēdes, Veiksmīgais."

msgid "vo_sm_char02_m03_stg38_03"
msgstr "Makleods: Ko?! Atkal? No kurienes šī mīlestība pret mīnām, Veiksmīgais?"

msgid "vo_sm_char02_m03_stg39_01"
msgstr "Makleods: Sasodīts, mēs tikko pazaudējām vienu no mūsu tankiem."

msgid "vo_sm_char02_m03_stg39_02"
msgstr "Makleods: Tur aiziet vēl viens no mūsu tankiem!"

msgid "vo_sm_char02_m03_stg39_03"
msgstr "Makleods: Pazaudējām sabiedroto tanku. Mums tagad būs jādubulto pūles."

msgid "vo_sm_char02_m03_stg41_01"
msgstr "Makleods: Mans tanks ir iznīcināts. Drīz būšu atpakaļ ar jaunu! Neskumstiet pēc manis pārāk daudz."

msgid "vo_sm_char02_m03_stg41_02"
msgstr "Makleods: Ak, sasodīts! Tas bija mans mīļākais tanks. Labi, drīzumā būs otrā kārta!"

msgid "vo_sm_char02_m03_stg41_03"
msgstr "Makleods: Man trāpīja. Neuztraucieties, es atgriezīšos ar citu — ceru, ka viņiem būs mana mīļākā krāsa."

msgid "vo_sm_char02_m03_stg41_04"
msgstr "Makleods: Nu, tas ir vienkārši lieliski. Vēl viens tanks pagalam. Uzgaidiet brīdi, es drīz atgriezīšos."

msgid "vo_sm_char02_m03_stg41_05"
msgstr "Makleods: Šķiet, ka es atkal meklēju jaunu tanku."

msgid "vo_sm_char02_m03_stg41_05_01"
msgstr "Makleods: Turies, es atgriezīšos ātrāk, nekā tu spēsi pateikt: \"Kur ir Makleods?\""

msgid "vo_sm_char02_m03_stg42_01"
msgstr "Makleods: Atpakaļ seglos, vai ne? Parādi viņiem, no kā tu esi veidots!"

msgid "vo_sm_char02_m03_stg42_02"
msgstr "Makleods: Celies un spīdi, laiks otrajai kārtai! Tev tas izdosies."

msgid "vo_sm_char02_m03_stg42_03"
msgstr "Makleods: Mēs šeit nedarbinām tanku veikalu. Parūpējies par šo."

msgid "vo_sm_char02_m03_stg42_04"
msgstr "Makleods: Ha! Tevi nekas neaptur, vai ne? Atgriezies priekš vēl viena, es tā skatos!"

msgid "vo_sm_char02_m04_stg01_01"
msgstr "Makleods: Tīģeru Mednieki tikšanās vietā."

msgid "vo_sm_char02_m04_stg01_01_01"
msgstr "Makleods: Brūks, ja es varu tevi tā saukt ēterā, vai tu tur?"

msgid "vo_sm_char02_m04_stg01_03"
msgstr "Makleods: Kāpēc tik formāli, Brūks? Mēs visi zinām, ka tas esi tu."

msgid "vo_sm_char02_m04_stg01_03_01"
msgstr "Makleods: Tagad saki man, vai mūsu sabiedrotie zina, ka esam pilsētā?"

msgid "vo_sm_char02_m04_stg01_03_02"
msgstr "Makleods: Viņi taču nešaus uz mums, vai ne?"

msgid "vo_sm_char02_m04_stg01_05"
msgstr "Makleods: Kāpēc šī atbilde nepiepilda mani ar pārliecību?"

msgid "vo_sm_char02_m04_stg02_01"
msgstr "Makleods: Ko mēs meklējam, Brūks? Ne jau šo mazo, vai ne?"

msgid "vo_sm_char02_m04_stg03_01"
msgstr "Makleods: Kāds atgriezās. Es redzu sabiedroto tanku. Vai esam palaiduši garām cīņu?"

msgid "vo_sm_char02_m04_stg03_03"
msgstr "Makleods: Ak, izlūkošana..."

msgid "vo_sm_char02_m04_stg04_01"
msgstr "Makleods: Sasodīts! Mums šeit ir vēl viens."

msgid "vo_sm_char02_m04_stg04_01_01"
msgstr "Makleods: Tas ir... ak, Brūks, tas atkal ir tas zvērs. Karalis Tīģeris."

msgid "vo_sm_char02_m04_stg04_01_02"
msgstr "Makleods: Veiksmīgais, mēs zinām, ko darīt. Gatavs?"

msgid "vo_sm_char02_m04_stg06_01"
msgstr "Makleods: Ko tu iesaki? Bēgt prom? Atstāt to šeit?"

msgid "vo_sm_char02_m04_stg08_02"
msgstr "Makleods: Labs mēģinājums, bet izskatās..."

msgid "vo_sm_char02_m04_stg09_01"
msgstr "Makleods: Dosim vecajam vīram Brūksam par ko pasmaidīt, Veiksmīgais."

msgid "vo_sm_char02_m04_stg09_01_01"
msgstr "Makleods: Mērķējiet uz priekšējo vai aizmugurējo piedziņas riteni. Vienkāršākais veids, kā apstādināt pretinieku."

msgid "vo_sm_char02_m04_stg09_01_02"
msgstr "Makleods: Mērķējiet uz priekšējo vai aizmugurējo piedziņas riteni. Vienkāršākais veids, kā apstādināt pretinieku."

msgid "vo_sm_char02_m04_stg10_01"
msgstr "Makleods: Turpiniet šaut. Agrāk vai vēlāk kāpurķēdes nokritīs."

msgid "vo_sm_char02_m04_stg10_01_01"
msgstr "Makleods: Un šī kariete pārvērtīsies par ķirbi."

msgid "vo_sm_char02_m04_stg10_01_02"
msgstr "Makleods: Turpiniet šaut. Agrāk vai vēlāk kāpurķēdes nokritīs."

msgid "vo_sm_char02_m04_stg11_01"
msgstr "Makleods: Tā turpināt! Lielisks šāviens. Kaija, tavs gājiens."

msgid "vo_sm_char02_m04_stg13_01"
msgstr "Makleods: Tu izklausies pēc manas vecās bioloģijas skolotājas. Makfudlebrainsas kundzes."

msgid "vo_sm_char02_m04_stg13_02"
msgstr "Makleods: Veiksmīgais, izbraucam pirms parādīsies cits Karalis Kaķis."

msgid "vo_sm_char02_m04_stg13_02_01"
msgstr "Makleods: Brūks, dod mums pavedienu, ko mēs meklējam?"

msgid "vo_sm_char02_m04_stg13_02_02"
msgstr "Makleods: Kaut kas lielāks par Karali Tīģeri? Imperators?"

msgid "vo_sm_char02_m04_stg14_01"
msgstr "Makleods: Es redzu priekšā Sabiedroto tankus. Kā parasti, viņi pulcējas un cenšas izspiesties cauri."

msgid "vo_sm_char02_m04_stg14_01_01"
msgstr "Makleods: Tā viņi netiks garām Jagdtiger. Veiksmīgais, vai mēs skaitām Jagdtiger?"

msgid "vo_sm_char02_m04_stg14_03"
msgstr "Makleods: Brūks, šķiet, ka tu pārāk ilgi esi bijis Štābā."

msgid "vo_sm_char02_m04_stg14_03_01"
msgstr "Makleods: Es saprotu, tev ir jāraksta ziņojumi. Bet mūsu sabiedrotajiem šeit ir vajadzīga palīdzība."

msgid "vo_sm_char02_m04_stg15_02"
msgstr "Makleods: Benet?"

msgid "vo_sm_char02_m04_stg15_04"
msgstr "Makleods: Tā labāk. Veiksmīgais, palīdzēsim mūsu spārnotam draugam iegūt dažus punktus!"

msgid "vo_sm_char02_m04_stg16_01"
msgstr "Makleods: Ātri pagatavosim šīs skārda kārbas. Ātri jāsasniedz tas Jagdtiger."

msgid "vo_sm_char02_m04_stg16_01_01"
msgstr "Makleods: Ja mēs saskaramies ar cietākiem riekstiem, mērķējiet uz piedziņas riteņiem."

msgid "vo_sm_char02_m04_stg16_01_02"
msgstr "Makleods: Dodiet mūsu \"jūras putnam\" mazliet mērķa praksi."

msgid "vo_sm_char02_m04_stg16_01_03"
msgstr "Makleods: Mērķējiet uz piedziņas riteņiem. Dodiet mūsu \"jūras putnam\" mazliet mērķa praksi."

msgid "vo_sm_char02_m04_stg17_01"
msgstr "Makleods: Kā vispār sauc šo prototipu?"

msgid "vo_sm_char02_m04_stg17_01_01"
msgstr "Makleods: Vai jums ir koda nosaukums? Vai arī man pašam tādu vajadzētu izdomāt?"

msgid "vo_sm_char02_m04_stg17_03"
msgstr "Makleods: Garlaicīgs vārds. Es to saukšu par Mazo Peli."

msgid "vo_sm_char02_m04_stg17_05"
msgstr "Makleods: Ja es būtu Vācu inženieris, es to tā nosauktu tikai prieka pēc."

msgid "vo_sm_char02_m04_stg18_01"
msgstr "Makleods: Cik no jums tur ir? Es kavēju savu randiņu ar Jagdtiger."

msgid "vo_sm_char02_m04_stg18_01_01"
msgstr "Makleods: Veiksmīgais, uzņemsim tempu. Tas nav pieklājīgi likt dāmai gaidīt."

msgid "vo_sm_char02_m04_stg19_01"
msgstr "Makleods: Ak vai! Un kas tu varētu būt?"

msgid "vo_sm_char02_m04_stg19_01_01"
msgstr "Makleods: Brūks! Kāpēc tu nebrīdināji mūs par draudzīgām vienībām šeit?"

msgid "vo_sm_char02_m04_stg19_01_02"
msgstr "Makleods: Nesaki man, ka izlūkošana atkal sajauca kaut ko!"

msgid "vo_sm_char02_m04_stg19_03"
msgstr "Makleods: Tātad mūsu izlūkošana izskatās šādi."

msgid "vo_sm_char02_m04_stg19_03_01"
msgstr "Makleods: Nāc mums līdzi, nav prātīgi atstāt pilsētu vienam."

msgid "vo_sm_char02_m04_stg19_05"
msgstr "Makleods: Tu esi tikpat pļāpīgs kā puiši no pēdējās operācijas."

msgid "vo_sm_char02_m04_stg19_05_01"
msgstr "Makleods: Labi, kustamies, mēs kavējamies uz tikšanos."

msgid "vo_sm_char02_m04_stg20_01"
msgstr "Makleods: Kaija!"

msgid "vo_sm_char02_m04_stg20_01_01"
msgstr "Makleods: Es domāju Storm Petrel! Mēs esam atraduši jums sulīgu mērķi. Grūti palaist garām šo."

msgid "vo_sm_char02_m04_stg20_01_02"
msgstr "Makleods: Veiksmīgais, mērķē uz piedziņas riteni!"

msgid "vo_sm_char02_m04_stg20_01_03"
msgstr "Makleods: Veiksmīgais, mērķē uz piedziņas riteni!"

msgid "vo_sm_char02_m04_stg23_01"
msgstr "Makleods: Sapratu. Drīz mums būs mērķ...pagaidi. Ko?!"

msgid "vo_sm_char02_m04_stg23_01_01"
msgstr "Makleods: Ak... Brūks, tu b... Tas bija mūsu mazais noslēpums!"

msgid "vo_sm_char02_m04_stg23_03"
msgstr "Makleods: Jā, protams. Vecums, es saprotu."

msgid "vo_sm_char02_m04_stg24_01"
msgstr "Makleods: Tagad esam tuvu, draugi. Jūsu sargeņģeļi gatavojas parūpēties par tavu lāstu."

msgid "vo_sm_char02_m04_stg24_03"
msgstr "Makleods: Kas tagad par lietu?"

msgid "vo_sm_char02_m04_stg24_05"
msgstr "Makleods: Brūks, tev taču nebūtu piedurknes vēl viens dūzis, kaut kas bumbvedēja lielumā, vai ne?"

msgid "vo_sm_char02_m04_stg24_07"
msgstr "Makleods: Mēs to nogaidīsim. Vai ne, Veiksmīgais?"

msgid "vo_sm_char02_m04_stg25_01"
msgstr "Makleods: Brūks? Kā būtu, ja kaut nedaudz paātrinātu lietas?"

msgid "vo_sm_char02_m04_stg25_01_01"
msgstr "Makleods: Mums šeit ir kompānija. Daudz kompānijas. Izlūkošana, iesaistieties, nestāviet tikai tur!"

msgid "vo_sm_char02_m04_stg26_01"
msgstr "Makleods: Brūks, izņemot mūs un šos puišus, vēl kāds uzbrūk pilsētai?"

msgid "vo_sm_char02_m04_stg26_01_01"
msgstr "Makleods: Man šķita, ka mēs esam šeit, lai pildītu slēptu operāciju, nevis pilna mēroga pilsētas slaucīšanu."

msgid "vo_sm_char02_m04_stg26_03"
msgstr "Makleods: Un es joprojām daru. Vienkārši domāju, ka pilsētas pārņemšanai būtu nedaudz vairāk atbalsta."

msgid "vo_sm_char02_m04_stg26_05"
msgstr "Makleods: Nu labi tad. Veiksme ir mūsu pusē! Vai ne, Veiksmīgais?"

msgid "vo_sm_char02_m04_stg27_02"
msgstr "Makleods: Pēdējais laiks!"

msgid "vo_sm_char02_m04_stg28_01"
msgstr "Makleods: Kāpēc mums vienmēr ir jāpiebeidz darbs?"

msgid "vo_sm_char02_m04_stg28_03"
msgstr "Makleods: Ha! Laikam ka mēs abi kļūstam veci, Brūks!"

msgid "vo_sm_char02_m04_stg28_03_01"
msgstr "Makleods: Kā būtu ar Bingo spēli mūsu pensionāru klubā?"

msgid "vo_sm_char02_m04_stg29_01"
msgstr "Makleods: Veiksmīgais, tu zini, ko darīt. Iznīcini tās kāpurķēdes."

msgid "vo_sm_char02_m04_stg29_01_01"
msgstr "Makleods: Mums ir jāiepazīstina Benets ar Jagdtiger. Esmu pārliecināts, ka viņi sapratīsies."

msgid "vo_sm_char02_m04_stg29_01_02"
msgstr "Makleods: Veiksmīgais, tu zini, ko darīt. Iznīcini tās kāpurķēdes."

msgid "vo_sm_char02_m04_stg30_02"
msgstr "Makleods: Tā turpināt! Tas ir trīs tev, Benet."

msgid "vo_sm_char02_m04_stg30_02_01"
msgstr "Makleods: Pavadi pusi dienas kopā ar mums šajā pilsētā, un tu mūs panāksi."

msgid "vo_sm_char02_m04_stg31_01"
msgstr "Makleods: Nestāsti, ka esam līmenī! Brūks, vai viņam ir tikpat daudz Tīģeru kā mums?"

msgid "vo_sm_char02_m04_stg31_03"
msgstr "Makleods: Es ienīstu, kad tu man nesniedz tiešu atbildi."

msgid "vo_sm_char02_m04_stg32_01"
msgstr "Makleods: Kāds drūms skats. Šķiet, ka mūsu Mazajai Pelītei ir asi zobi."

msgid "vo_sm_char02_m04_stg32_01_01"
msgstr "Makleods: Esi modrs, Veiksmīgais. Benet, tu ar mums?"

msgid "vo_sm_char02_m04_stg33_01"
msgstr "Makleods: Sasodīts, šis dzinējs man ir padevies!"

msgid "vo_sm_char02_m04_stg33_01_01"
msgstr "Makleods: Veiksmīgais, tev būs jāturpina bez manis."

msgid "vo_sm_char02_m04_stg33_01_02"
msgstr "Makleods: Es darīšu visu iespējamo, lai no šejienes piesegtu jūs un vadītu Beneta triecienus."

msgid "vo_sm_char02_m04_stg33_01_03"
msgstr "Makleods: Sasodīts, tas nolādētais dzinējs!"

msgid "vo_sm_char02_m04_stg34_01"
msgstr "Makleods: Es to redzu. Pie velna, tā ir viena pārbarota pele. Cik tonnas tai ir?"

msgid "vo_sm_char02_m04_stg34_01_01"
msgstr "Makleods: Ak, vienalga. Jo smagāks tas ir, jo lielāka slodze uz kāpurķēdēm."

msgid "vo_sm_char02_m04_stg34_01_02"
msgstr "Makleods: Vai ne, Veiksmīgais? Tu zini, kur mērķēt."

msgid "vo_sm_char02_m04_stg36_01"
msgstr "Makleods: Tas ir ietērpts bruņās no visām pusēm. Mēs nevaram to cauršaut."

msgid "vo_sm_char02_m04_stg36_01_01"
msgstr "Makleods: Bet mums ir dūzis. Jumts noteikti ir plāns."

msgid "vo_sm_char02_m04_stg36_01_02"
msgstr "Makleods: Veiksmīgais, koncentrējies uz kāpurķēdēm."

msgid "vo_sm_char02_m04_stg36_01_03"
msgstr "Makleods: Veiksmīgais, koncentrējies uz kāpurķēdēm."

msgid "vo_sm_char02_m04_stg37_01"
msgstr "Makleods: Noķērām tevi, Pele! Storm Petrel, piebeidz to un ejam mājās."

msgid "vo_sm_char02_m04_stg38_01"
msgstr "Makleods: Kas... ienaidnieks nav iznīcināts."

msgid "vo_sm_char02_m04_stg38_01_01"
msgstr "Makleods: Veiksmīgais, kamēr Benets riņķo atpakaļ, parūpēsimies par šiem nelūgtajiem viesiem."

msgid "vo_sm_char02_m04_stg39_01"
msgstr "Makleods: Viņa draugi ir ieradušies. Vispirms tiksim ar viņiem galā, lai tie netraucētu."

msgid "vo_sm_char02_m04_stg40_01"
msgstr "Makleods: Kur viņš dodas? Vai viņš slēpjas? Par laimi, tu viņu nobiedēji."

msgid "vo_sm_char02_m04_stg40_01_01"
msgstr "Makleods: Vēl viens sveiciens no Beneta, un mēs būsim galā."

msgid "vo_sm_char02_m04_stg41_01"
msgstr "Makleods: Tur. Noķērām viņu. Benet, izbeidz šo aizraujošo, bet nogurdinošo piedzīvojumu."

msgid "vo_sm_char02_m04_stg42_01"
msgstr "Makleods: Hmm...tas kļūst par sāpēm."

msgid "vo_sm_char02_m04_stg42_01_01"
msgstr "Makleods: Kas ar tevi notiek? Tagad tev vajadzētu būt liesmās."

msgid "vo_sm_char02_m04_stg42_01_02"
msgstr "Makleods: Sasodīts! Veiksmīgais, es domāju, ka esam viņu sadusmojuši."

msgid "vo_sm_char02_m04_stg43_01"
msgstr "Makleods: Veiksmīgais, esi uzmanīgs, mums šeit ir jauna ienaidnieku partija."

msgid "vo_sm_char02_m04_stg44_01"
msgstr "Makleods: Veiksmīgais, mērķē tikai uz kāpurķēdēm. Netērē patronas, mēs nevaram cauršaut tā bruņas."

msgid "vo_sm_char02_m04_stg45_01"
msgstr "Makleods: Benet, viņš ir iesprostots kā žurka! Dod visu, kas tev ir!"

msgid "vo_sm_char02_m04_stg46_01"
msgstr "Makleods: Jā! Izdarīts!"

msgid "vo_sm_char02_m04_stg46_03"
msgstr "Makleods: Paldies par palīdzību, Benet. Mēs tev esam parādā!"

msgid "vo_sm_char02_m04_stg47_02"
msgstr "Makleods: Pff, medaļas. Man tādu ir daudz."

msgid "vo_sm_char02_m04_stg47_04"
msgstr "Makleods: Bingo! Kā būtu ar bingo spēli? Veiksmīgais, tu spēlēsi?"

msgid "vo_sm_char02_m04_stg53_01"
msgstr "Makleods: Mēs esam to imobilizējuši, Benet. Tu vari šaut."

msgid "vo_sm_char02_m04_stg54_01"
msgstr "Makleods: Storm Petrel, mērķa kāpurķēdes ir iznīcinātas. Tas ir jūsu."

msgid "vo_sm_char02_m04_stg55_01"
msgstr "Makleods: Kāpurķēdes iznīcinātas. Gaisa spēki, jūsu kārta dejot."

msgid "vo_sm_char02_m04_stg56_01"
msgstr "Makleods: Mērķis ir imobilizēts, Benet."

msgid "vo_sm_char02_m05_stg59_02"
msgstr "Makleods: Joks vai divi komandai ir kā motoreļļa! Palīdz tai darboties, nesadaloties."

msgid "vo_sm_char02_m05_stg60_02"
msgstr "Makleods: Tātad, manas runas nav svarīgas? Tu ievainoji manu sirdi, mans draugs!"

msgid "vo_sm_char03_m05_stg01_02"
msgstr "Konolijs: Ak vai! Mēs pazaudējām mūsu komandieri! Puiši, tagad viss ir mūsu rokās."

msgid "vo_sm_char03_m05_stg01_02_01"
msgstr "Konolijs: Visi, esiet uzmanīgi - šeit visapkārt mums ir mīnas."

msgid "vo_sm_char03_m05_stg03_01"
msgstr "Konolijs: Sasodīts! Bunkuri iznīcināja mīnu attīrīšanas tanku!"

msgid "vo_sm_char03_m05_stg03_03"
msgstr "Konolijs: Sasodīts! Mīnas Es ienīstu mīnas!"

msgid "vo_sm_char03_m05_stg04_01"
msgstr "Konolijs: Mums jāiznīcina tie sasodītie bunkuri."

msgid "vo_sm_char03_m05_stg04_01_01"
msgstr "Konolijs: Mēs diez vai varam tos uzlauzt no tanka, taču nav tā, ka mums ir izvēle."

msgid "vo_sm_char03_m05_stg04_01_02"
msgstr "Konolijs: Varbūt mums būs veiksmes daļa, izslidināsim vienu cauri spraugai un sagrausim to visu!"

msgid "vo_sm_char03_m05_stg04_04"
msgstr "Konolijs: Turpiniet šaut pa tiem bunkuriem, mums tie ir jāiznīcina. Tā ir mūsu vienīgā cerība."

msgid "vo_sm_char03_m05_stg08_01"
msgstr "Konolijs: Bunkuri iznīcināti. Mīnu attīrīšanas tanks tagad var taisīt ceļu."

msgid "vo_sm_char03_m05_stg09_01"
msgstr "Konolijs: Ceļš atbrīvots...beidzot! Uz priekšu!"

msgid "vo_sm_char03_m05_stg11_01"
msgstr "Konolijs: Pretinieku tanki pamanīti priekšā. Gatavojieties cīnīties."

msgid "vo_sm_char03_m05_stg12_01"
msgstr "Konolijs: Sasodīts, mums jāiznīcina šis bunkurs ātri. Mums vajag tagad sasniegt pretgaisa ieročus."

msgid "vo_sm_char03_m05_stg13_01"
msgstr "Konolijs: Ha ha! Izskatās, ka viņi ir zaudējuši nervus!"

msgid "vo_sm_char03_m05_stg13_01_01"
msgstr "Konolijs: Viņi aizmuka un atstāja pretgaisa ieročus izdzirdot mūsu tankus."

msgid "vo_sm_char03_m05_stg18_01"
msgstr "Konolijs: Nākamais bunkurs būs ciets rieksts."

msgid "vo_sm_char03_m05_stg18_01_01"
msgstr "Konolijs: Atzīmējiet to ar dūmiem un lai tam šauj kaujas kuģis."

msgid "vo_sm_char03_m05_stg19_01"
msgstr "Konolijs: Šis nākamis bunkurs ir labi nosargāts. Mums vajag šaut tam no abām pusēm, ar pilnu spēku."

msgid "vo_sm_char03_m05_stg19_01_01"
msgstr "Konolijs: Palīdziet Francūzim izdarīt savu gājienu kamēr mēs ar kapteini Mērfiju viņus šeit nodarbinām."

msgid "vo_sm_char03_m05_stg20_01"
msgstr "Konolijs: Tagad, kad esam atbalstījuši kapteini Dibuā, mums ir pietiekami daudz uguns, lai uzņemtu šo kalna bunkuru."

msgid "vo_sm_char03_m05_stg22_01"
msgstr "Konolijs: Mūsu nākamis mērķis ir lielais krasta ierocis."

msgid "vo_sm_char03_m05_stg22_01_01"
msgstr "Konolijs: Ja mēs to iznīcināsim, mūsu kaujas kuģis var pozicionēties priekš pilna artilērijas atbalsta."

msgid "vo_sm_char03_m05_stg25_01"
msgstr "Konolijs: Ak, paskatieties uz to puiši! Karaliskie Gaisa Spēki nāk karsti."

msgid "vo_sm_char03_m05_stg25_01_01"
msgstr "Konolijs: Kas par skatu! Tā ir laba lidošana!"

msgid "vo_sm_char03_m05_stg32_01"
msgstr "Konolijs: Sapulcējieties, puiši. Pretinieks mums nedos ne milimetru, tāpēc arī mēs viņiem nedosim."

msgid "vo_sm_char03_m05_stg33_01"
msgstr "Konolijs: Tieši tā! Mēs esam pagriezuši gaitu."

msgid "vo_sm_char03_m05_stg35_01"
msgstr "Konolijs: Atzīmējiet mērķus priekš kaujas kuģa ar dūmiem."

msgid "vo_sm_char03_m05_stg35_02"
msgstr "Konolijs: Neaizmirstiet nomest dūmus."

msgid "vo_sm_char03_m05_stg35_03"
msgstr "Konolijs: Izmantojiet jūsu dūmu marķierus. Pilots var pārraidīt to koordinātes."

msgid "vo_sm_char03_m05_stg35_04"
msgstr "Konolijs: Tas ir izturīgs mērķis. Atzīmējiet to ar dūmiem."

msgid "vo_sm_char03_m05_stg36_01"
msgstr "Konolijs: Šerman, laiks kustēties! Kauja uz mums negaidīs."

msgid "vo_sm_char03_m05_stg36_02"
msgstr "Konolijs: Šerman, mosties!"

msgid "vo_sm_char03_m05_stg36_03"
msgstr "Konolijs: Kāpēc tu apstājies, Šerman? Vai ir mehāniska problēma?"

msgid "vo_sm_char03_m05_stg36_04"
msgstr "Konolijs: Nu, Šerman, nav laika mīņāties. Priekš ir frontes līnija!"

msgid "vo_sm_char03_m05_stg36_05"
msgstr "Konolijs: Šerman, laiks nav mūsu pusē! Braucam!"

msgid "vo_sm_char03_m05_stg37_02"
msgstr "Konolijs: Tēja būtu vēlama, bet kafija derēs."

msgid "vo_sm_char03_m05_stg38_02"
msgstr "Konolijs: Es teiktu, turieties pie zemes, kapteini Mērfij. Tas ir drošāk. Visiem iesaistītajiem."

msgid "vo_sm_char03_m05_stg40_01"
msgstr "Konolijs: Uzgaidiet, kungi. Tuvojas jauna pretinieku grupa."

msgid "vo_sm_char03_m05_stg45_01"
msgstr "Konolijs: Prieks redzēt ka tu atkal brauc! Paliec modrs tur ārā."

msgid "vo_sm_char03_m05_stg45_02"
msgstr "Konolijs: Augšāmcēlies no pelniem, stiprāks nekā agrāk. Dodamies uz priekšu!"

msgid "vo_sm_char03_m05_stg46_01"
msgstr "Konolijs: Ak vai! Mans tanks tika izsists. Turpiniet bez manis."

msgid "vo_sm_char03_m05_stg46_02"
msgstr "Konolijs: Nu, tās ir šī brauciena beigas. Taču tas bija labs mēģinājums."

msgid "vo_sm_char03_m05_stg46_03"
msgstr "Konolijs: Mans tanks ir izsists, bet mēs neesam ārā. Mēs drīz būsim atpakaļ cīņā."

msgid "vo_sm_char04_m05_stg03_02"
msgstr "Viņi iznīcina mūs vienu pa vienam! Dodieties uz klintīm!"

msgid "vo_sm_char04_m05_stg03_02_01"
msgstr "Tā ir pašnāvība stāvēt klajumā kā sēdošas pīles."

msgid "vo_sm_char04_m05_stg03_02_02"
msgstr "Klintis var piedāvāt kādu aizsegu."

msgid "vo_sm_char04_m05_stg16_02"
msgstr "Mērfijs: Kapteinis Mērfijs, šeit. Tikko tikām krastā, bet mūs apšauda bunkuri augšā nogāzē."

msgid "vo_sm_char04_m05_stg16_02_01"
msgstr "Mērfijs: Šeit ir vajadzīgs atbalsts, lai virzītos uz augšu!"

msgid "vo_sm_char04_m05_stg17_01"
msgstr "Mērfijs: Bunkurs ir iznīcināts! Tagad ceļš brīvs. Braucam!"

msgid "vo_sm_char04_m05_stg17_01_01"
msgstr "Mērfijs: Hej, apskaties uz to! Mūsu puiši tur augšā gatavo no tiem malto gaļu! Laiks pievienoties!"

msgid "vo_sm_char04_m05_stg19_02"
msgstr "Mērfijs: Izklausās pēc plāna. Dosim viņiem elli!"

msgid "vo_sm_char04_m05_stg20_02"
msgstr "Mērfijs: Labi, izbraucam un sitam viņiem stipri!"

msgid "vo_sm_char04_m05_stg22_02"
msgstr "Mērfijs: Ho-ho! Ar šādu uguns spēku aiz muguras mēs varam bez apstājas virzīties iekšzemē."

msgid "vo_sm_char04_m05_stg23_01"
msgstr "Mērfijs: Izskatās, ka pretgaisa ieroči ir klusi."

msgid "vo_sm_char04_m05_stg23_01_01"
msgstr "Mērfijs: Laikam ka tie šāvēji bēg projām ātrāk nekā trusis mūs ieraugot."

msgid "vo_sm_char04_m05_stg23_01_02"
msgstr "Mērfijs: Laikam dēļ mūsu burvīgajām personībām, vai ne?"

msgid "vo_sm_char04_m05_stg28_02"
msgstr "Mērfijs: Jā! Mēs to izdarījām!"

msgid "vo_sm_char04_m05_stg28_02_01"
msgstr "Mērfijs: Atpūtieties, tad iesim uz priekšu un dosim pretiniekam īstu pērienu."

msgid "vo_sm_char04_m05_stg30_02"
msgstr "Mērfijs: Dodamies pozīcijā. Atcerieties, mūsu pusē ir kaujas kuģa ieroči."

msgid "vo_sm_char04_m05_stg33_02"
msgstr "Mērfijs: Tā bija smaga cīņa. Bet mēs to izdarījām! Turpināsim tādā garā!"

msgid "vo_sm_char04_m05_stg35_05"
msgstr "Mērfijs: Kur ir tavs dūmu marķieris? Mans brālēns ir uz kuģa. Un viņam patīk šaut!"

msgid "vo_sm_char04_m05_stg35_06"
msgstr "Mērfijs: Es vēlos, lai man būtu kāds no šiem dūmu marķieriem. Vienmēr gribēju izsaukt kādus lielākus ieročus."

msgid "vo_sm_char04_m05_stg35_07"
msgstr "Mērfijs: Atzīmējiet tos ar dūmiem un ļaujiet kaujas kuģim tikt galā ar pārējo."

msgid "vo_sm_char04_m05_stg36_06"
msgstr "Mērfijs: Šerman, kas par aizturi? Laiks spiest pedāli grīdā!"

msgid "vo_sm_char04_m05_stg36_07"
msgstr "Mērfijs: Šerman, mums nav visa diena! Sākam braukt, tagad!"

msgid "vo_sm_char04_m05_stg36_08"
msgstr "Mērfijs: Šerman, mums vajag virzīties uz priekšu!"

msgid "vo_sm_char04_m05_stg36_09"
msgstr "Mērfijs: Nav laika sēdēt uz vietas, Šerman, Kustamies!"

msgid "vo_sm_char04_m05_stg37_01"
msgstr "Mērfijs: Es šobrīd varētu izdzert labu kafijas tasi."

msgid "vo_sm_char04_m05_stg38_01"
msgstr "Mērfijs: Nākamreiz es gribētu lidot ar kādu no šiem bumbvedējiem. Man patīk debesis."

msgid "vo_sm_char04_m05_stg39_01"
msgstr "Mērfijs: Paklau, Dibuā, vai domā, ka ar savu tanku vari sacensties ātrāk par manu?"

msgid "vo_sm_char04_m05_stg40_02"
msgstr "Mērfijs: Uzbrukumā! Par labākajiem vīna dārziem uz planētas!"

msgid "vo_sm_char04_m05_stg40_04"
msgstr "Mērfijs: Pagaidi, ko es teicu?"

msgid "vo_sm_char04_m05_stg41_01"
msgstr "Mērfijs: Hei, Dubuā, vai zini kādu Franču melodiju, kas uzlabo mūsu morāli?"

msgid "vo_sm_char04_m05_stg41_03"
msgstr "Mērfijs: Tiešām? Nekad nezināju, ko šie vārdi nozīmē."

msgid "vo_sm_char04_m05_stg42_01"
msgstr "Mērfijs: Kā Parīzē sauc Ceturtdaļas Mārciņu ar Sieru?"

msgid "vo_sm_char04_m05_stg43_01"
msgstr "Mērfijs: Dubuā, vai tā ir taisnība, ka Franču tankiem sviru vietā ir bagetes?"

msgid "vo_sm_char04_m05_stg43_03"
msgstr "Mērfijs: Tikpat nopietni kā tu, tikai ar smaidu."

msgid "vo_sm_char04_m05_stg44_02"
msgstr "Mērfijs: Ko tas nozīmē, Dibuā?"

msgid "vo_sm_char04_m05_stg45_03"
msgstr "Mērfijs: Atpakaļ darbībā, vai ne? Tā turpiniet, mēs jums ticam."

msgid "vo_sm_char04_m05_stg45_04"
msgstr "Mērfijs: Tu esi atgriezies? Tā tik turēt! Dodiet viņiem elli."

msgid "vo_sm_char04_m05_stg46_04"
msgstr "Mērfijs: Tanks iznīcināts! Izskatās ka mēs tagad iesim ar kājām puiši."

msgid "vo_sm_char04_m05_stg46_05"
msgstr "Mērfijs: Nu tas ir viss. Mans tanks nedarbojas, bet es atgriezīšos!"

msgid "vo_sm_char04_m05_stg46_06"
msgstr "Mērfijs: Mūsu braucamais ir salauzts. Man viss ir kārtībā, neuztraucieties. Es atgriezīšos jaunā!"

msgid "vo_sm_char04_m06_outro_02"
msgstr "Mērfijs: Kas? Piecu drošinieku neprātīgā drosme?"

msgid "vo_sm_char04_m06_outro_11"
msgstr "Mērfijs: Nekad vairs."

msgid "vo_sm_char04_m06_stg02_01"
msgstr "Vadītājs, kapteinis Mērfijs: Oho, turieties! Mīnu lauki priekšā!"

msgid "vo_sm_char04_m06_stg02_02"
msgstr "Mērfijs: Hei, Kellere, tu taču dienēji šeit — vai tev ir kādas labas idejas?"

msgid "vo_sm_char04_m06_stg02_04"
msgstr "Mērfijs: Tad uz pilsētu! Laiks kartēm, kliņģeriem un šnicelēm!"

msgid "vo_sm_char04_m06_stg06_06"
msgstr "Mērfijs: Nu, Profesor, dari savu radio maģiju."

msgid "vo_sm_char04_m06_stg06_12"
msgstr "Mērfijs: Kaut man būtu bijusi tāda Kellere pirms sešiem mēnešiem..."

msgid "vo_sm_char04_m06_stg06_14"
msgstr "Mērfijs: Sasodīts. Šī tiešām ir slepenības misija."

msgid "vo_sm_char04_m06_stg06_14_01"
msgstr "Mērfijs: Es domāju, ka mēs runājām metaforiski."

msgid "vo_sm_char04_m06_stg07_02"
msgstr "Mērfijs: Un neviens sargs nav redzams! Laimes Dāma šodien spēlē mūsu komandā."

msgid "vo_sm_char04_m06_stg08_08"
msgstr "Mērfijs: Oho, puiši, mums ir īsta Lieldienu olu medība!"

msgid "vo_sm_char04_m06_stg09_03"
msgstr "Mērfijs: Jā, kapteini, tikai mirklīti. Pie velna. Dubois, aizdod man zīmuli. Esmu pazaudējis savu."

msgid "vo_sm_char04_m06_stg09_05"
msgstr "Mērfijs: Ah, pareizi. Keller, ir tev...Bleistift?"

msgid "vo_sm_char04_m06_stg09_08"
msgstr "Mērfijs: Ha! Paldies, Keller."

msgid "vo_sm_char04_m06_stg10_02"
msgstr "Mērfijs: Ak! Jauns puzles gabals! Tik jauki saņemt dāvanas no tevis, Dubois!"

msgid "vo_sm_char04_m06_stg11_02"
msgstr "Mērfijs: Tas ir Džeks Mērfijs tev, monsieur Delacroix! Kad beidzot pareizi uzrakstīsi manu vārdu?"

msgid "vo_sm_char04_m06_stg12_03"
msgstr "Mērfijs: Pagaidi minūti. Kur ir mans zīmulis..."

msgid "vo_sm_char04_m06_stg12_05"
msgstr "Mērfijs: Labi, labi, es tev nopirkšu veselu zīmuļu kasti, Dubois!"

msgid "vo_sm_char04_m06_stg12_05_01"
msgstr "Mērfijs: Kapteini! Mēs tuvojamies! Šis fragments ir mans mīļākais!"

msgid "vo_sm_char04_m06_stg15_03"
msgstr "Mērfijs: Tu tiešām esi pārskatījis visu?"

msgid "vo_sm_char04_m06_stg15_05"
msgstr "Mērfijs: Hei, varbūt tas ir kā manas zeķes — vienmēr pēdējā vietā, kur tu paskaties!"

msgid "vo_sm_char04_m06_stg16_02"
msgstr "Mērfijs: Vienu mirkli... Viss sakrīt kopā. Kas par labirintu!"

msgid "vo_sm_char04_m06_stg16_02_01"
msgstr "Mērfijs: Es to nosauktu par MĪNU-taura labirintu! Ha-ha. Sapratāt? Nē?"

msgid "vo_sm_char04_m06_stg16_02_02"
msgstr "Mērfijs: Nu taču, tas bija zelta joks!"

msgid "vo_sm_char04_m06_stg16_04"
msgstr "Mērfijs: Noguris no čaulīšu ielādēšanas, Dubois?"

msgid "vo_sm_char04_m06_stg18_03"
msgstr "Mērfijs: Apskatīsim to. Stāviet gatavībā, visi."

msgid "vo_sm_char04_m06_stg19_02"
msgstr "Mērfijs: Ak, un es jau cerēju uz slepenu Vācu zelta krātuvi."

msgid "vo_sm_char04_m06_stg19_02_01"
msgstr "Mērfijs: Saki, Keller, vai jums šeit ir kāds zelts?"

msgid "vo_sm_char04_m06_stg19_04"
msgstr "Mērfijs: Tieši tā es teiktu, ja slēptu zeltu šeit."

msgid "vo_sm_char04_m06_stg19_04_01"
msgstr "Mērfijs: Kapteini Smit, vai meklēsim...karti?"

msgid "vo_sm_char04_m06_stg21_03"
msgstr "Mērfijs: Paslīdēja tieši garām!"

msgid "vo_sm_char04_m06_stg21_04"
msgstr "Mērfijs: Vai redzēji to? Mēs esam neredzami!"

msgid "vo_sm_char04_m06_stg23_04"
msgstr "Mērfijs: Uh...Kapteini? Varbūt mums vajadzētu atkāpties? Pirms lietas kļūst pārāk karstas?"

msgid "vo_sm_char04_m06_stg23_05"
msgstr "Mērfijs: Es balsoju par taktisko atkāpšanos. Kāds ir ar mani?"

msgid "vo_sm_char04_m06_stg24_03"
msgstr "Mērfijs: Laiks atrast jaunu slēpšanās vietu, pirms ierodas uzņemšanas komanda!"

msgid "vo_sm_char04_m06_stg25_02"
msgstr "Mērfijs: Uf! Mūsu slepenā tanka operācija patiešām darbojas! Kas to būtu domājis?"

msgid "vo_sm_char04_m06_stg26_04"
msgstr "Mērfijs: Laiks dejot ar šiem Panzeriem!"

msgid "vo_sm_char04_m06_stg26_05"
msgstr "Mērfijs: Parādīsim viņiem, ko šis Chaffee spēj!"

msgid "vo_sm_char04_m06_stg26_06"
msgstr "Mērfijs: Sāksim, dāmas un kungi!"

msgid "vo_sm_char04_m06_stg27_02"
msgstr "Mērfijs: Juhū! Tā tas jāizdara!"

msgid "vo_sm_char04_m06_stg28_03"
msgstr "Mērfijs: Trāpīts!"

msgid "vo_sm_char04_m06_stg29_02"
msgstr "Mērfijs: Svētais dūms, mērķis bija milzīgs!"

msgid "vo_sm_char04_m06_stg30_02"
msgstr "Mērfijs: Kapteini, varbūt Dubois vajadzētu vispirms to pārbaudīt?"

msgid "vo_sm_char04_m06_stg31_07"
msgstr "Mērfijs: Tur ārā pārāk auksti, un es aizmirsu savu jaku."

msgid "vo_sm_char04_m06_stg35_02"
msgstr "Mērfijs: Varbūt ir laiks paskatīties, kā mūsu profesors darbojas ar savu radio burvību?"

msgid "vo_sm_char04_m06_stg42_02"
msgstr "Mērfijs: Hei, kapteini, apskate ir lieliska, bet vai mums nevajadzētu meklēt dārgumus un tās kartes gabalus?"

msgid "vo_sm_char04_m06_stg43_03"
msgstr "Mērfijs: Celies, celies, olas un tanki!"

msgid "vo_sm_char04_m06_stg44_02"
msgstr "Mērfijs: Izskatās, ka mēs to darīsim skaļi!"

msgid "vo_sm_char04_m06_stg45_02"
msgstr "Mērfijs: Es deru, ka ir labāks veids, kā tikt cauri šai ķezai!"

msgid "vo_sm_char04_m06_stg46_02"
msgstr "Mērfijs: Hei, Keller, parādi viņiem savu radio triku!"

msgid "vo_sm_char04_m06_stg47_02"
msgstr "Mērfijs: Kā būtu, ja mēs ļautu viņiem apnikt un aiziet?"

msgid "vo_sm_char04_m06_stg48_02"
msgstr "Mērfijs: Hei, cilvēki, varbūt nākamreiz mēģināsim neeksplodēt?"

msgid "vo_sm_char04_m06_stg53_02"
msgstr "Mērfijs: Kāds mēģina būt slepens! Slikts puika!"

msgid "vo_sm_char04_m06_stg54_02"
msgstr "Mērfijs: Laiks skrien ātri, mums jāvirzās ātrāk."

msgid "vo_sm_char04_m06_stg55_01"
msgstr "Mērfijs: Ha! Mums tas ir rokā! Un viņi teica, ka tas būs grūti."

msgid "vo_sm_char04_m06_stg55_04"
msgstr "Mērfijs: Neuztraucieties, puiši, vecais Mērfijs pāriet uz savu pārdrošo braukšanas režīmu."

msgid "vo_sm_char04_m06_stg56_02"
msgstr "Mērfijs: Sasodīts...Dubois, tu pārlieku uztraucies! Kas sliktākais, kas var notikt?"

msgid "vo_sm_char04_m06_stg56_04"
msgstr "Mērfijs: Nē, profesor! Vai pilns gāziens, vai pilns zārks!"

msgid "vo_sm_char04_m06_stg56_06"
msgstr "Mērfijs: Atpūties, mon ami! Karte ir manā galvā."

msgid "vo_sm_char04_m06_stg57_02"
msgstr "Mērfijs: Tīģeris? Tas ir viss? Kur ir visi tie brīnumieroči, par kuriem es visu laiku dzirdu?"

msgid "vo_sm_char04_m06_stg58_02"
msgstr "Mērfijs: Manevrs? MANEVRS?"

msgid "vo_sm_char04_m06_stg58_02_01"
msgstr "Mērfijs: Šajā šaurajā koridorā, kas ir tieši pusotra Chaffee plats?"

msgid "vo_sm_char04_m06_stg58_02_02"
msgstr "Mērfijs: Kur tieši man vajadzētu manevrēt?"

msgid "vo_sm_char04_m06_stg59_03"
msgstr "Mērfijs: Nu taču! Tīģer, vai tev nav citu tanku, ko vajāt?"

msgid "vo_sm_char04_m06_stg60_03"
msgstr "Mērfijs: Man nepatīk, ka Tīģera stobrs ir vērsts uz mums!"

msgid "vo_sm_char04_m06_stg61_02"
msgstr "Mērfijs: Vai tu sajuti to vēju? Es noteikti to sajutu!"

msgid "vo_sm_char04_m06_stg62_01"
msgstr "Mērfijs: Tikai skrāpējums! Gandrīz nemaz nejutu!"

msgid "vo_sm_char04_m06_stg62_02"
msgstr "Mērfijs: Hei! Es tikko uzspodrināju šo tanku!"

msgid "vo_sm_char04_m06_stg63_03"
msgstr "Mērfijs: Mērķē uz kapurķēdēm, Kowalski!"

msgid "vo_sm_char04_m06_stg64_02"
msgstr "Mērfijs: Ne tik stiprs bez savām kapurķēdēm, vai ne?"

msgid "vo_sm_char04_m06_stg68_01"
msgstr "Mērfijs: Oi! Tā mīna nebija kartē!"

msgid "vo_sm_char04_m06_stg68_02"
msgstr "Mērfijs: Mīnas! Ak, jā. Tu jau to zināji."

msgid "vo_sm_char04_m06_stg69_01"
msgstr "Mērfijs: Svētie dūmi! No kurienes šis mazais čalis parādījās?!"

msgid "vo_sm_char04_m06_stg70_02"
msgstr "Mērfijs: Kāpēc tik nopietns? Tas bija jautri! Sapratāt? Tāpēc, ka mīnas?"

msgid "vo_sm_char04_m06_stg70_02_01"
msgstr "Mērfijs: Ak, nu, puiši!..."

msgid "vo_sm_char04_m06_stg71_02"
msgstr "Mērfijs: Daaaamn...visi tie vīri...mēs bijām tik tuvu!"

msgid "vo_sm_char04_m06_stg73_01"
msgstr "Mērfijs: Dubois, vai ir taisnība, ka Franču tankiem ir espresso aparāti?"

msgid "vo_sm_char04_m06_stg73_03"
msgstr "Mērfijs: Tu atbildēji tik nopietni, ka gandrīz noticēju. Tu taču jokoji, vai ne?"

msgid "vo_sm_char04_m06_stg74_02"
msgstr "Mērfijs: Nē, mani puiši un es devāmies tālāk uz ziemeļiem."

msgid "vo_sm_char04_m06_stg74_02_01"
msgstr "Mērfijs: Bet es noteikti apmeklēšu pēc kara."

msgid "vo_sm_char04_m06_stg74_02_02"
msgstr "Mērfijs: Un es noteikti uzkāpšu Pizas tornī."

msgid "vo_sm_char04_m06_stg75_01"
msgstr "Mērfijs: Dubois, vai tu zināji, ka runā miega laikā?"

msgid "vo_sm_char04_m06_stg75_03"
msgstr "Mērfijs: Ko nozīmē \"Wee, wee, ma share-ee\"?"

msgid "vo_sm_char04_m06_stg76_01"
msgstr "Mērfijs: Dubois, vai esi kādreiz domājis man iemācīt nedaudz Franču valodas?"

msgid "vo_sm_char04_m06_stg76_03"
msgstr "Mērfijs: Ko? Es nesaprotu."

msgid "vo_sm_char04_m06_stg76_05"
msgstr "Mērfijs: Ko? Ak...Vau...Mēģini pārspēt jokdari, vai ne?"

msgid "vo_sm_char04_m06_stg76_05_01"
msgstr "Mērfijs: Labs mēģinājums, bet tu spēlējies ar uguni, Duboi!"

msgid "vo_sm_char04_m06_stg77_01"
msgstr "Mērfijs: Vai tu dejo polku, Kowalski?"

msgid "vo_sm_char04_m06_stg77_03"
msgstr "Mērfijs: Darām to! Rīkosim ballīti, kurā visi dejo polku!"

msgid "vo_sm_char04_m06_stg77_05"
msgstr "Mērfijs: Protams! Nu... ne tā, kā tu domā. Tu saproti, ko es domāju. Ceru."

msgid "vo_sm_char04_m06_stg78_02"
msgstr "Mērfijs: Kāda ir problēma?"

msgid "vo_sm_char04_m06_stg78_04"
msgstr "Mērfijs: Es to saucu par \"Taktisko manevrēšanu\". Vienmēr liec ienaidniekam minēt!"

msgid "vo_sm_char04_m06_stg79_01"
msgstr "Mērfijs: Kowalski, ja mēs būtu grupā, kādu instrumentu tu spēlētu?"

msgid "vo_sm_char04_m06_stg79_03"
msgstr "Mērfijs: Ehh...es būtu galvenais ģitārists..."

msgid "vo_sm_char04_m06_stg80_01"
msgstr "Mērfijs: Keller, vai tu domā, ka vari uzstādīt šo radio, lai uztvertu kādu mūziku?"

msgid "vo_sm_char04_m06_stg80_03"
msgstr "Mērfijs: Tikai uz brīdi? Mūzika uzlabotu mūsu morāli!"

msgid "vo_sm_char04_m06_stg80_05"
msgstr "Mērfijs: Ak, jā. Varbūt labāk nemaisīt iestatījumus tad."

msgid "vo_sm_char04_m06_stg81_01"
msgstr "Mērfijs: Man bija sapnis pagājušajā naktī, ka mēs visi bijām aizgājuši makšķerēt."

msgid "vo_sm_char04_m06_stg81_03"
msgstr "Mērfijs: Vecs zābaks."

msgid "vo_sm_char04_m06_stg81_05"
msgstr "Mērfijs: Heh, es zināju, ka tu iekšēji esi optimists."

msgid "vo_sm_char04_m06_stg81_05_01"
msgstr "Mērfijs: Vienmēr meklēju sudraba maliņu."

msgid "vo_sm_char04_m06_stg82_01"
msgstr "Mērfijs: Kapteini, pastāsti mums kādu joku!"

msgid "vo_sm_char04_m06_stg82_03"
msgstr "Mērfijs: Kāds cits? Kowalski? Keller? Dubois, atvainojos, neprasu tev."

msgid "vo_sm_char04_m06_stg82_05"
msgstr "Mērfijs: Nu...dari to, ja gribi."

msgid "vo_sm_char04_m06_stg82_07"
msgstr "Mērfijs: ... Tāpēc."

msgid "vo_sm_char04_m06_stg83_02"
msgstr "Mērfijs: \"Bailīgie mirst daudzas reizes pirms savas nāves;\""

msgid "vo_sm_char04_m06_stg83_02_01"
msgstr "Mērfijs: \"Drosmīgie izjūt nāvi, tikai vienreiz,\" vai ne?"

msgid "vo_sm_char04_m06_stg83_04"
msgstr "Mērfijs: Jā? Tas man šķita pārāk Franciski."

msgid "vo_sm_char04_m06_stg84_01"
msgstr "Mērfijs: Domā, ka viņi nosauks ielu mūsu vārdā?"

msgid "vo_sm_char04_m06_stg84_03"
msgstr "Mērfijs: Tev taisnība. Mums vajag komandas nosaukumu!"

msgid "vo_sm_char04_m06_stg84_05"
msgstr "Mērfijs: Mmm...par garu nosaukumam. Man patīk TROUBLESHOOTERS."

msgid "vo_sm_char04_m06_stg85_01"
msgstr "Mērfijs: Hei, Kowalski, vai tu kādreiz smaidi?"

msgid "vo_sm_char04_m06_stg85_03"
msgstr "Mērfijs: Izaicinājums pieņemts! Es sasistīšu to tavu čaulu!"

msgid "vo_sm_char04_m06_stg85_05"
msgstr "Mērfijs: Labi, klausies: Tuk-tuk."

msgid "vo_sm_char04_m06_stg85_06"
msgstr "Mērfijs: Tev jāprasa: \"Kas tur?\""

msgid "vo_sm_char04_m06_stg85_07"
msgstr "Mērfijs: Labi, šķiet, ka tas būs grūtāk, nekā es domāju."

msgid "vo_sm_char04_m06_stg87_01"
msgstr "Mērfijs: Kas tas ir?!"

msgid "vo_sm_char04_m06_stg87_03"
msgstr "Mērfijs: Tas ir manā zābakā. Ak! Tas ir zīmulis."

msgid "vo_sm_char04_m06_stg88_01"
msgstr "Mērfijs: Hei, Keller, vai tu uztver kaut ko interesantu no tiem Vācu kanāliem?"

msgid "vo_sm_char04_m06_stg88_03"
msgstr "Mērfijs: Ha! Tie esam mēs! Fantoma Tanks! Vāciešu sliktākais murgs!"

msgid "vo_sm_char04_m06_stg88_04"
msgstr "Mērfijs: Keller, noteikti nebiji domājis, ka slēpsies Amerikāņu tankā!"

msgid "vo_sm_char04_m06_stg88_06"
msgstr "Mērfijs: Dzīve ir smieklīga tādā veidā, vai ne? Tāpat kā šokolādes kārba!"

msgid "vo_sm_char04_m06_stg90_03"
msgstr "Mērfijs: Oh!!! Kowalski! Tev jāizlasa La Marseillaise vārdi!"

msgid "vo_sm_char04_m06_stg90_03_01"
msgstr "Mērfijs: Tur ir dažas... lietas, īsti asiņainas lietas!"

msgid "vo_sm_char04_m06_stg91_02"
msgstr "Mērfijs: Jā!"

msgid "vo_sm_char04_m06_stg92_01"
msgstr "Mērfijs: Ja kāds prasa, mēs esam ceļojošais cirks."

msgid "vo_sm_char04_m06_stg92_03"
msgstr "Mērfijs: Mums vajag aizseg stāstu; mēs tagad esam spiegi!"

msgid "vo_sm_char04_m06_stg93_01"
msgstr "Mērfijs: Vai domā ka es varu dabūt spiegu pildspalvu pēc šīs misijas?"

msgid "vo_sm_char04_m06_stg93_03"
msgstr "Mērfijs: Tu esi tik sīkumains, Dubois!"

msgid "vo_sm_char05_m05_stg18_02"
msgstr "Dibuā: Bonjour, monsieurs! Runā kapteinis Dibuā."

msgid "vo_sm_char05_m05_stg18_02_01"
msgstr "Dibuā: Mēs esam nolaidušies H1, bet mūs nomāc intensīva ienaidnieka uguns."

msgid "vo_sm_char05_m05_stg18_02_02"
msgstr "Dibuā: Mums steidzami nepieciešama palīdzība!"

msgid "vo_sm_char05_m05_stg19_04"
msgstr "Dibuā: Ak, ceļš ir brīvs. Beidzot! En avant, pievienosimies cīņai. Vive la France!"

msgid "vo_sm_char05_m05_stg21_01"
msgstr "Dibuā: Merci mon ami! Mēs esam soli tuvāk manas dzimtenes atbrīvošanai."

msgid "vo_sm_char05_m05_stg27_01"
msgstr "Dibuā: Magnifique! Krasta ieroči, tie ir klusi."

msgid "vo_sm_char05_m05_stg27_01_01"
msgstr "Dibuā: Tagad kaujas kuģis var pietuvoties un sniegt mums milzīgu atbalstu."

msgid "vo_sm_char05_m05_stg27_01_02"
msgstr "Dibuā: Skatāmies salūtu!"

msgid "vo_sm_char05_m05_stg29_01"
msgstr "Dibuā: Gatavs cīnīties. Es nekad vairs nepametīšu Francijas zemi. Plus jamais de retraite!"

msgid "vo_sm_char05_m05_stg33_03"
msgstr "Dibuā: Šis ir tikai sākums. Kara beigas ir redzamas."

msgid "vo_sm_char05_m05_stg35_08"
msgstr "Dibuā: Atzīmējiet mērķus ar dūmiem, mes amis. Lai kaujas kuģis atbrīvo La France!"

msgid "vo_sm_char05_m05_stg35_09"
msgstr "Dibuā: Pareizi novietots dūmu signāls nes veiksmi un uguns lietu ienaidniekam!"

msgid "vo_sm_char05_m05_stg36_10"
msgstr "Dibuā: Ir pienācis laiks kustēties, Šerman, vite-vite!"

msgid "vo_sm_char05_m05_stg36_11"
msgstr "Dibuā: Šerman, mums jāiet, allons!"

msgid "vo_sm_char05_m05_stg36_12"
msgstr "Dibuā: Šerman, pasteidzies! La France gaida!"

msgid "vo_sm_char05_m05_stg39_02"
msgstr "Dibuā: Kaptein Mērfij, šīs nav sacensības; tas ir par manas dzimtenes atbrīvošanu."

msgid "vo_sm_char05_m05_stg39_02_01"
msgstr "Dibuā: Un šis jautājums... Smieklīgi! Man ir smagais tanks, kā es varu būt ātrāks?"

msgid "vo_sm_char05_m05_stg40_03"
msgstr "Dibuā: Par Franciju!"

msgid "vo_sm_char05_m05_stg41_02"
msgstr "Dibuā: Es dungoju \"La Marseillaise\". Tas ir piemērots cīņai. Tās vārdi ir aizkustinoši, pat nikni."

msgid "vo_sm_char05_m05_stg42_02"
msgstr "Dibuā: Burgeri? Mēs Francijā neēdam burgerus, Mērfij."

msgid "vo_sm_char05_m05_stg42_02_01"
msgstr "Dibuā: Mēs dodam priekšroku mūsu klasiskajām bagetes sviestmaizēm ar izsmalcinātu sieru un gaļas izstrādājumiem."

msgid "vo_sm_char05_m05_stg43_02"
msgstr "Dibuā: Kaptein Mērfij, dažreiz es domāju, cik nopietni jūs uztverat šo karu."

msgid "vo_sm_char05_m05_stg44_01"
msgstr "Dibuā: Sur le risque disparu, sur l’espoir sans souvenir, j’écris ton nom..."

msgid "vo_sm_char05_m05_stg44_03"
msgstr "Dibuā: Tas nozīmē, ka viņiem ir beigas, Mērfij."

msgid "vo_sm_char05_m05_stg45_05"
msgstr "Dibuā: Sveicināts atpakaļ cīņā. Jūsu noturība ir iedvesmojoša."

msgid "vo_sm_char05_m05_stg46_07"
msgstr "Dibuā: Mon dieu, mūsu tankam ir beigas! Mums tagad jāatkāpjas."

msgid "vo_sm_char05_m05_stg46_08"
msgstr "Dibuā: Šim tankam ir beigas. Mēs darījām visu iespējamo, mes amis."

msgid "vo_sm_char05_m05_stg46_08_01"
msgstr "Dibuā: Bet es turpināšu Francijas atbrīvošanu!"

msgid "vo_sm_char05_m05_stg46_09"
msgstr "Dibuā: Tanks ir iznīcināts, bet ne mūsu gars. Es atgriezīšos!"

msgid "vo_sm_char05_m06_outro_01"
msgstr "Dubois: Tātad tas var tomēr apturēt asins izliešanu."

msgid "vo_sm_char05_m06_outro_03"
msgstr "Dubois: Papīra gabals. Viens vienkāršs papīrs var visu apturēt."

msgid "vo_sm_char05_m06_outro_05"
msgstr "Dubois: Kas tad?"

msgid "vo_sm_char05_m06_outro_09"
msgstr "Dubois: Plus jamais."

msgid "vo_sm_char05_m06_stg04_02"
msgstr "Lādētājs, Kapteinis Dubois: Jā, ser!"

msgid "vo_sm_char05_m06_stg04_03"
msgstr "Dubois: "

msgid "vo_sm_char05_m06_stg06_11"
msgstr "Dubois: Magnifique! Tas nostrādāja!"

msgid "vo_sm_char05_m06_stg08_02"
msgstr "Dubois: Jā, ser!"

msgid "vo_sm_char05_m06_stg08_03"
msgstr "Dubois: Atradu to! Tagad mēs varam tikt cauri pilsētai...merde!"

msgid "vo_sm_char05_m06_stg08_05"
msgstr "Dubois: Visa frontes līnija ir nomīnēta. Mēs nevaram tikt cauri līdz mūsu spēkiem."

msgid "vo_sm_char05_m06_stg09_01"
msgstr "Dubois: Atradu to!"

msgid "vo_sm_char05_m06_stg09_04"
msgstr "Dubois: Es jau tev aizdevu manu zīmuli. Tu pazaudēji manu."

msgid "vo_sm_char05_m06_stg09_07"
msgstr "Dubois: Nē. Viņš pazaudēs arī tavu."

msgid "vo_sm_char05_m06_stg10_01"
msgstr "Dubois: Mērfij, man ir kaut kas priekš tevis. Ņem."

msgid "vo_sm_char05_m06_stg11_01"
msgstr "Dubois: Džekpots!"

msgid "vo_sm_char05_m06_stg11_03"
msgstr "Dubois: Es domāju...ah...mon Dieu, man varbūt pat pietrūks tavi jociņi kad viss beigsies."

msgid "vo_sm_char05_m06_stg12_01"
msgstr "Dubois: Es to atradu! Vēl viens gabals."

msgid "vo_sm_char05_m06_stg12_04"
msgstr "Dubois: Es tev teicu."

msgid "vo_sm_char05_m06_stg13_01"
msgstr "Dubois: Šeit nekas, mes amis."

msgid "vo_sm_char05_m06_stg14_02"
msgstr "Dubois: Non. Šis nav komandpunkts ko mums vajag."

msgid "vo_sm_char05_m06_stg15_02"
msgstr "Dubois: Tukšs"

msgid "vo_sm_char05_m06_stg15_04"
msgstr "Dubois: Es esmu diezgan rūpīgs."

msgid "vo_sm_char05_m06_stg15_06"
msgstr "Dubois: Mon Dieu...Vai tu salīdzini klasificētus militāros dokumentus ar...ah...neko."

msgid "vo_sm_char05_m06_stg15_07"
msgstr "Dubois: Mon Dieu...Vai tu salīdzini klasificētus militāros dokumentus ar...ah...neko."

msgid "vo_sm_char05_m06_stg15_07_01"
msgstr "Dubois: Kapteini, šeit ir vēl atzīmēti komandpunkti."

msgid "vo_sm_char05_m06_stg16_03"
msgstr "Dubois: Vienkārši tieciet cauri mīnu laukam un es beidzot varu dabūt...mieru un klusumu."

msgid "vo_sm_char05_m06_stg16_05"
msgstr "Dubois: To arī."

msgid "vo_sm_char05_m06_stg17_03"
msgstr "Dubois: Nomierinies, Kowalski. Ja Keller gribēja nodot mūs, viņš jau to būtu izdarījis."

msgid "vo_sm_char05_m06_stg19_01"
msgstr "Dubois: Skaties, izskatās pēc komandpunkta."

msgid "vo_sm_char05_m06_stg21_05"
msgstr "Dubois: Tas bija tuvu, mes amis."

msgid "vo_sm_char05_m06_stg24_04"
msgstr "Dubois: Mums ir jāpārvietojas nekavējoties, mes amis. Viņi izmeklēs."

msgid "vo_sm_char05_m06_stg25_03"
msgstr "Dubois: Magnifique. Viņi atpaliek. Mēs varam turpināt mūsu misiju."

msgid "vo_sm_char05_m06_stg26_07"
msgstr "Dubois: En avant!"

msgid "vo_sm_char05_m06_stg27_03"
msgstr "Dubois: Mērķis iznīcināts. Vai čaulītes vienmēr bija tik smagas?"

msgid "vo_sm_char05_m06_stg27_04"
msgstr "Dubois: Vai visiem viss kārtībā? Man jā."

msgid "vo_sm_char05_m06_stg28_04"
msgstr "Dubois: Pretinieks iznīcināts!"

msgid "vo_sm_char05_m06_stg31_01"
msgstr "Dubois: Jā!"

msgid "vo_sm_char05_m06_stg31_02"
msgstr "Dubois: Dodos izlūkot."

msgid "vo_sm_char05_m06_stg31_03"
msgstr "Dubois: Es apskatīšu un ziņošu atpakaļ."

msgid "vo_sm_char05_m06_stg31_04"
msgstr "Dubois: Eju uz novērošanas punktu."

msgid "vo_sm_char05_m06_stg31_05"
msgstr "Dubois: Laiks izstaipīt manas kājas. Paskatīsimies kas priekšā."

msgid "vo_sm_char05_m06_stg31_06"
msgstr "Dubois: Mērfij, vai vēlies mani aizvietot?"

msgid "vo_sm_char05_m06_stg31_08"
msgstr "Dubois: Man to vajadzēja zināt..."

msgid "vo_sm_char05_m06_stg31_09"
msgstr "Dubois: Kowalski, varbūt tev vajadzētu..."

msgid "vo_sm_char05_m06_stg31_11"
msgstr "Dubois: Labi, es iešu pats."

msgid "vo_sm_char05_m06_stg31_12"
msgstr "Dubois: Vai kāds cits ir ieinteresēts vieglā treniņā?"

msgid "vo_sm_char05_m06_stg31_13"
msgstr "Dubois: Tā arī domāju. Esmu ceļā."

msgid "vo_sm_char05_m06_stg32_01"
msgstr "Dubois: Pretinieks pamanīts!"

msgid "vo_sm_char05_m06_stg32_02"
msgstr "Dubois: Panzeri redzami."

msgid "vo_sm_char05_m06_stg32_03"
msgstr "Dubois: Uzmanību. Pretinieku bruņas."

msgid "vo_sm_char05_m06_stg32_04"
msgstr "Dubois: Es viņus redzu."

msgid "vo_sm_char05_m06_stg32_05"
msgstr "Dubois: Ienaidnieks redzeslokā."

msgid "vo_sm_char05_m06_stg33_01"
msgstr "Dubois: Vēl nekas, bet viņiem jābūt tuvumā."

msgid "vo_sm_char05_m06_stg33_02"
msgstr "Dubois: Tukša redzamības līnija, taču esiet modri."

msgid "vo_sm_char05_m06_stg33_03"
msgstr "Dubois: Nevar redzēt nevienu kustību. Viņi kaut kur slēpjas."

msgid "vo_sm_char05_m06_stg33_04"
msgstr "Dubois: Tukš uz šo brīdi...bet var būt mums vajadzētu vēl uzgaidīt."

msgid "vo_sm_char05_m06_stg33_05"
msgstr "Dubois: Pagaidām nekas. Bet pagaidīsim un redzēsim, vai viņu patruļa parādās."

msgid "vo_sm_char05_m06_stg42_03"
msgstr "Dubois: Messieurs, man jāatgādina jums, ka mūsu misijas izdošanās ir atkarīga no karšu savākšanas."

msgid "vo_sm_char05_m06_stg43_04"
msgstr "Dubois: Mon Dieu, laiks neapstājas kamēr mēs apbrīnojam skatus."

msgid "vo_sm_char05_m06_stg48_03"
msgstr "Dubois: Katra sekunde skaitās. Tagad esiet ļoti modri."

msgid "vo_sm_char05_m06_stg53_03"
msgstr "Dubois: Uzmanību! Pretinieku tanks priekšā!"

msgid "vo_sm_char05_m06_stg55_03"
msgstr "Dubois: Mon Dieu! Mērfij, tu mūs nolādēji!"

msgid "vo_sm_char05_m06_stg55_05"
msgstr "Dubois: Un kādā režīmā tu biji pirms šī?!"

msgid "vo_sm_char05_m06_stg56_01"
msgstr "Dubois: Mērfij, sasodīts esi uzmanīgs! Mēs esam mīnu laukā!"

msgid "vo_sm_char05_m06_stg56_05"
msgstr "Dubois: Mērfij, vai zini kur mēs dodamies? Tu neuzzīmēji pēdējo kartes gabalu!"

msgid "vo_sm_char05_m06_stg56_07"
msgstr "Dubois: Tas mani satrauc!"

msgid "vo_sm_char05_m06_stg59_04"
msgstr "Dubois: Mon Dieu, Tīģeris ir tieši aiz mums!"

msgid "vo_sm_char05_m06_stg59_05"
msgstr "Dubois: Cette bête noķers mūs kur katru brīdi! Mērfij, ātrāk!"

msgid "vo_sm_char05_m06_stg68_03"
msgstr "Dubois: Mērfij, es zinu ka to izdarīti tīšām! Lūdzu beidz ar saviem jokiem!"

msgid "vo_sm_char05_m06_stg72_05"
msgstr "Dubois: Ir gudrāki veidi kā pabeigt šo misiju, nekā šaut pa visu kas kustas."

msgid "vo_sm_char05_m06_stg73_02"
msgstr "Dubois: Jā. Bet tas neielīstu Chaffee."

msgid "vo_sm_char05_m06_stg74_01"
msgstr "Dubois: Mērfij, vai esi jebkad bijis uz Parīzi?"

msgid "vo_sm_char05_m06_stg74_04"
msgstr "Dubois: Neņem viņu galvā. Tas ir viņa veids kā izpriecāties."

msgid "vo_sm_char05_m06_stg75_02"
msgstr "Dubois: Nē."

msgid "vo_sm_char05_m06_stg75_04"
msgstr "Dubois: Tas nozīmē, ka sapņoju par Franciju."

msgid "vo_sm_char05_m06_stg76_02"
msgstr "Dubois: Très bien. Atkārto pēc manis: \"Comment? Je ne comprends pas.\""

msgid "vo_sm_char05_m06_stg76_04"
msgstr "Dubois: Tu pārtulkoji. Es prasīju tev atkārtot."

msgid "vo_sm_char05_m06_stg82_04"
msgstr "Dubois: Kāpēc ne?"

msgid "vo_sm_char05_m06_stg82_06"
msgstr "Dubois: Vai zini kāpēc Francūži ēd gliemežus? Jo mums nepatīk ātrais ēdiens."

msgid "vo_sm_char05_m06_stg83_01"
msgstr "Dubois: Tu atgādini man tēlu no Trīs Musketieriem, Mērfij."

msgid "vo_sm_char05_m06_stg83_03"
msgstr "Dubois: Tas ir Šekspīrs, Mērfij."

msgid "vo_sm_char05_m06_stg86_01"
msgstr "Dubois: Keller, vai ir taisnība, ka Vāciešiem ir vairāk kā 300 maizes veidi?"

msgid "vo_sm_char05_m06_stg86_03"
msgstr "Dubois: Iespaidīgi. Bet vai esi pamēģinājis Franču bageti?"

msgid "vo_sm_char05_m06_stg86_05"
msgstr "Dubois: Perfekta metafora priekš Francijas!"

msgid "vo_sm_char05_m06_stg87_02"
msgstr "Dubois: Kur? Es neko neredzu."

msgid "vo_sm_char05_m06_stg87_04"
msgstr "Dubois: Mon Dieu..."

msgid "vo_sm_char05_m06_stg90_02"
msgstr "Dubois: La Marseillaise."

msgid "vo_sm_char05_m06_stg91_01"
msgstr "Dubois: Šeit pa labi vai pa kreisi, Mērfij?"

msgid "vo_sm_char05_m06_stg91_03"
msgstr "Dubois: Ah, Mērfij..."

msgid "vo_sm_char05_m06_stg92_02"
msgstr "Dubois: Ko?"

msgid "vo_sm_char05_m06_stg93_02"
msgstr "Dubois: Lai tu arī to varētu pazaudēt?"

msgid "vo_sm_char06_m05_stg01_01"
msgstr "Makkormiks: Klausieties, puiši! Nolaidiet galvu un virzieties ātri!"

msgid "vo_sm_char06_m05_stg01_01_01"
msgstr "Makkormiks: Koncentrējieties uz bunkuriem; mums ir jāatbrīvo ceļš saviem spēkiem."

msgid "vo_sm_char06_m05_stg01_01_02"
msgstr "Makkormiks: Mums ir darāms darbs, padarīsim to labi!"

msgid "vo_sm_char07_m04_stg19_04"
msgstr "Sapratu!"

