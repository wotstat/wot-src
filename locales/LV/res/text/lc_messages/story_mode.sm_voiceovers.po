msgid "vo_sm_char08_m05_stg01_13"
msgstr "Spitfire pilots: Redzamība ir slikta, nevar palīdzēt!"

msgid "vo_sm_char08_m05_stg01_14"
msgstr "Spitfire pilots: Pārāk daudz pretgaisa uguns, nevar palīdzēt!"

msgid "vo_sm_char08_m05_stg01_15"
msgstr "Spitfire pilots: Smaga pretgaisa uguns, nav iespējama uguns pielāgošana."

msgid "vo_sm_char08_m05_stg10_02"
msgstr "Spitfire pilots: Jūtas kā sniega vētra šeit augšā, vai ne?"

msgid "vo_sm_char08_m05_stg10_02_01"
msgstr "Spitfire pilots: Mēs nevaram pielāgot kuģa uguni zem šiem šāvieniem."

msgid "vo_sm_char08_m05_stg10_02_02"
msgstr "Spitfire pilots: Mums vajag tos pretgaisa ieročus blakus bunkuriem."

msgid "vo_sm_char08_m05_stg15_01"
msgstr "Spitfire pilots: Man ir izdevies ienirt zemāk."

msgid "vo_sm_char08_m05_stg15_01_01"
msgstr "Spitfire pilots: Tagad es varu sākt komandēt lielos ieročus, izmantojot zemes dūmu signālus."

msgid "vo_sm_char08_m05_stg15_01_02"
msgstr "Spitfire pilots: Tanki, jūsu gājiens!"

msgid "vo_sm_char08_m05_stg16_01"
msgstr "Spitfire pilots: Es pamanīju dūmus."

msgid "vo_sm_char08_m05_stg16_01_01"
msgstr "Spitfire pilots: Nododu koordinātas kaujas kuģim tiešai trāpīšanai."

msgid "vo_sm_char08_m05_stg19_03"
msgstr "Spitfire pilots: Sasodīts, viens no mūsējiem ejiet zemāk! Joprojām nevar tikt zemāk."

msgid "vo_sm_char08_m05_stg19_03_01"
msgstr "Spitfire pilots: Mums tagad jāiznīcina vēl viens pretgaisa ierocis!"

msgid "vo_sm_char08_m05_stg24_01"
msgstr "Spitfire pilots: Pretgaisa ieroči iznīcināti, es eju zemāk. Gatavs vadīt blīvāku uguni no mūsu kaujas kuģa."

msgid "vo_sm_char08_m05_stg28_03"
msgstr "Spitfire pilots: Uzmanību! Liela ienaidnieku grupa pamanīta virzoties uz jums."

msgid "vo_sm_char08_m05_stg28_03_01"
msgstr "Spitfire pilots: Viņi izmet visu, kas viņiem ir."

msgid "vo_sm_char08_m05_stg30_01"
msgstr "Spitfire pilots: Uzmanību, tuvojas jauna ienaidnieku grupa. Esiet modri tur apakšā."

msgid "vo_sm_char08_m05_stg31_01"
msgstr "Spitfire pilots: Brīdinājums, tuvojas pēdējais un lielākais ienaidnieku vilnis."

msgid "vo_sm_char08_m05_stg31_01_01"
msgstr "Spitfire pilots: Viņi tuvojas no visām pusēm. Gatavojieties."

msgid "vo_sm_char08_m05_stg34_01"
msgstr "Spitfire pilots: Man ir skaidrs skats uz dūmu signālu. Koordinātas tiek nosūtītas uz kaujas kuģi."

msgid "vo_sm_char08_m05_stg34_02"
msgstr "Spitfire pilots: Eh, tur ir mūsu dūmu marķieris. Es nododu lokāciju kaujas kuģim."

msgid "vo_sm_char08_m05_stg34_03"
msgstr "Spitfire pilots: Dūmi uz mērķi. Precīzas vietas nosūtīšana uz kaujas kuģi."

msgid "vo_sm_char08_m05_stg34_04"
msgstr "Spitfire pilots: Es redzu dūmus, izskatās, ka mūsu draugiem vajag palīdzību."

msgid "vo_sm_char09_m05_stg01_16"
msgstr "USS Frankford komandieris: Gaida koordinātas uguns atbalstam."

msgid "vo_sm_char09_m05_stg01_17"
msgstr "USS Frankford komandieris: Akla uguns ir riskanta, var skart mūsējos."

msgid "vo_sm_char09_m05_stg01_18"
msgstr "USS Frankford komandieris: Nepieciešami precīzi mērķi, aptur uguni."

msgid "vo_sm_char09_m05_stg04_03"
msgstr "USS Frankford komandieris: Šis ir USS Frankford Komandieris. Negatīvs."

msgid "vo_sm_char09_m05_stg04_03_01"
msgstr "USS Frankford komandieris: Nevar atbalstīt uzbrukumu. Pārāk slikta redzamība."

msgid "vo_sm_char09_m05_stg04_03_02"
msgstr "USS Frankford komandieris: Nav redzamība uz klintīm un bunkuriem, redzami tikai mūsu tanki pludmalē."

msgid "vo_sm_char09_m05_stg04_05"
msgstr "USS Frankford komandieris: Redzami tanki cīņā uz klints pusi."

msgid "vo_sm_char09_m05_stg04_05_01"
msgstr "USS Frankford komandieris: Mēs atbalstīsim ar uguni šajā virzienā."

msgid "vo_sm_char09_m05_stg05_01"
msgstr "USS Frankford komandieris: Cerams, ka šis Sherman zina, kur viņš šauj. "

msgid "vo_sm_char09_m05_stg06_01"
msgstr "USS Frankford komandieris: Sherman nomainīja mērķi. Mēs pielāgojamies, lai atbilstu."

msgid "vo_sm_char09_m05_stg07_01"
msgstr "USS Frankford komandieris: Sherman beidza šaut. Šeit darbs ir padarīts."

msgid "vo_sm_char09_m05_stg07_01_01"
msgstr "USS Frankford komandieris: Mēs nevaram sasniegt bunkurus tālāk iekšzemē."

msgid "vo_sm_char09_m05_stg07_01_02"
msgstr "USS Frankford komandieris: Tagad atkāpjamies drošā attālumā. Lai veicas krastā."

