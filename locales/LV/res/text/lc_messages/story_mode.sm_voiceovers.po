msgid "vo_sm_char10_m05_stg28_01"
msgstr "Štāba Virsnieks: Pludmale ir tīra. Sūta galvenos spēkus. Lielisks darbs."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Štāba Virsnieks: Turiet savu pozīciju. Papildspēki ir ceļā."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Štāba Virsnieks: Aizsargājiet pludmales pozīciju par katru cenu."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Štāba Virsnieks: Vēl viens tanks, vēl viena iespēja. Šoreiz esiet uzmanīgi."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Štāba Virsnieks: Mums beidzas rezerves. Izdariet to, komandieri."

