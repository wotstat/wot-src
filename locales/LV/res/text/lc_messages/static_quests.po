msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Sāciet Nejaušās Kaujas jebkura līmeņa tankā."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Sveicināti spēlē! Cīnieties ar citiem faniem no visas pasaules un sviniet iespaidīgas uzvaras!"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Pirmā Kauja"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Izpētiet un pērciet jebkuru III Līmeņa tanku."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "Jauna tanka pirkšana ir svarīgs notikums. Ar katru jaunu līmeni, tanki kļūst interesantāki. Trenēta apkalpe arī uzlabos kopējo spēlēšanu."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "IV Līmeņa Tanks"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Cīnieties trīs Nejaušajās Kaujās IV-X Līmeņa tankos ar jebkuru uzstādītu pielāgošanas elementu."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Jūs variet pielāgot tankus mainot to ārējo izskatu ar iepriekš iestatītiem stiliem vai izveidojot savus stilus izmantojot kamuflāžas, ierakstus, emblēmas un dekalus."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Tanku Ārējais Izskats"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Sāciet trenēt jebkuru iemaņu jebkuram apkalpes loceklim."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Apkalpes locekļi var trenēt papildus iemaņas, lai uzlabotu to efektivitātes vai iegūtu jaunas spējas."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Apkalpes Iemaņas"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Nopelniet 150000 kredītus Nejaušajās Kaujās IV-X Līmeņa tankos."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Jo lielāks kaujas līmenis, jo vairāk kredītus jums vajadzēs, lai uzturētu jūsu tanku, papildinātu munīciju un nopirktu moduļus un iekārtas."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Uzkrājoši Kredīti"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Izpētiet un pērciet jebkuru V Līmeņa tanku."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "V Līmenis ir vieta, kur vairāk nopietni tanki sāk parādīties, un, kur jūsu spēles spējas patiesi tiek testētas. Pavisam trenēta apkalpe būs patiesi noderīga."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "V Līmeņa Tanks"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās V-X Līmeņa tankos ar uzstādītām trīs iekārtām."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Pārklāta Optika vai Uzlabota Ventilācija? Pareizā iekārta var uzlabot jūsu tanka stipros punktus un samazināt tā trūkumus."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Iekārtu Uzstādīšana"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Izpildiet vienu parasto scenāriju Topogrāfijas režīmā."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Lai iegūtu pārliecību kaujas laukā, vislabāk ir labi izprast ceļus, taktiku un kartes, tostarp galvenās pozīcijas un objektus uz tiem."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topogrāfija"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Izpildiet četrus uzlabotos scenārijus vienā kartē Topogrāfijā."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Ieejiet Topogrāfijas režīma reizi pa reizei, lai izpētītu kartes Nejaušajām Kaujām. Četri scenāriji ļauj jums izpētīt lokācijas no dažādiem leņķiem."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Uzlabota Topogrāfija"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās V-X Līmeņa tankos ar aktivizētu Personālo Rezervi."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Pēc aktivizācijas, jūs variet iegūt papildus bonusus Kaujas, Brīvajai un Apkalpes Pieredzei vai kredītiem pēc katras kaujas."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Personālās Rezerves"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Esiet starp top 10 spēlētājiem jūsu komandā pēc nopelnītās Pieredzes sešas reizes uzvarošās Nejaušās Kaujās V-X Līmeņa tankos."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Šīs misijas ļauj pelnīt piecas reizes vairāk Pieredzi par katru veiksmīgu kauju. Priekš tā vajag uzvarēt un būt starp top 10 spēlētājiem komandā pēc nopelnītās Pieredzes."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 Misijas priekš ×5 Pieredzes"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Izpētiet moduli un uzstādiet to uz jebkura līmeņa tanka."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "Kaujas Pieredze tiek apbalvota pēc katras kaujas. Pelniet Kaujas Pieredzi, lai izpētītu jaunus moduļus, kas uzlabo jūsu tanka efektivitāti."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "Kaujas Pieredze"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Izpētiet un pērciet jebkuru VI Līmeņa tanku."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "Katrā secīgā līmenī, tanku izpētei vajadzēs vairāk laika un pūles. Brīvā Pieredze palīdzēs jums virzīties ātrāk, un trenēta apkalpe noteikti noderēs."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "VI Līmeņa Tanks"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Izpildiet vienu Personīgo Misiju jebkurā kampaņā."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Kampaņas ir misiju ķēdes dažādiem tanku veidiem. Pēc izpildes, jūs variet iegūt noderīgas balvas un unikālus tankus."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Personīgās misijas"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Trenējiet apkalpi ar Universālo Pamācību."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Apkalpes Grāmatas ļauj jums ievērojami paātrināt apkalpes treniņu pievienojot noteiktu Pieredzes daudzumu vienam vai visiem apkalpes locekļiem."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Apkalpes Grāmatas"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās VI-X Līmeņa tankos aprīkotos ar apkalpes direktīvu."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Direktīvas var uzlabot apkalpes iemaņas uz vienu kauju. Kā palīgmateriālus, direktīvas var nopirkt vai saņemt kā balvu."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Direktīvas Apkalpei"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Nopērciet īpašu Iesācēja Saišķi spēles Veikalā."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Jūs variet nopirkt visu ko jums vajag spēles Veikalā, ieskaitot zeltu, Premium tankus un vairāk. Jūs atradīsiet regulārus piedāvājumus ar lieliskiem darījumiem."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Veikals"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās VI-X Līmeņa Premium tankos."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Šos tankus nevajag izpētīt. Tie pelna vairāk Kaujas Pieredzi, Apkalpes Pieredzi un kredītus, un tieļauj jums pārvietot apkalpi bez pārtrenēšanas."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Premium Tanki"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās VI-X Līmeņa tankos ar uzstādītu iekārtu direktīvu."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Direktīvas ļauj jums palielināt uzstādīto iekārtu efektivitāti. Kā palīgmateriālus, direktīvas var nopirkt vai saņemt kā balvu."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Direktīvas Iekārtām"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Esiet starp top 10 spēlētājiem jūsu komandā pēc nopelnītās Pieredzes 15 reizes Nejaušajās Kaujās VI-X Līmeņa tankos."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Šīs misijas ļauj pelnīt piecas reizes vairāk Pieredzi par katru veiksmīgu kauju. Priekš tā vajag uzvarēt un būt starp top 10 spēlētājiem komandā pēc nopelnītās Pieredzes."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 Misijas priekš ×5 Pieredzes"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Izpētiet un pērciet jebkuru VII Līmeņa tanku."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Šim tanka līmenim, spēju prasības palielinās vēl vairāk. Tanki kļūst biedējošāki un efektīvāki - tā pat kā jūsu pretinieki."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "VII Līmeņa Tanks"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Cīnieties 10 Nejaušajās Kaujās VII-X Līmeņa tankos aprīkotos ar Lielo Aptieciņu, Lielo Remonta Komplektu un Automātisko Ugunsdzēšamo Aparātu."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Kad uzstādīts, lielie palīgmateriāli salabo bojātos moduļus ātrāk nekā mazie. Tie arī samazina apdullināšanas ilgumu un iespēju aizdegties, un ir īsāk atjaunošanās laiks."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Lielie Palīgmateriāli"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Saņemiet dubultu Pieredzi par jūsu pirmo dienas uzvaru Nejaušajās Kaujās jebkura līmeņa tankā."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Jūs variet saņemt divreiz vairāk Pieredzi par jūsu pirmo dienas uzvaru katrā tankā. Izmantojiet šo funkciju, lai uzlabotu jūsu tankus vēl vairāk."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Pieredzes Reizinātājs"

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Izveidojiet rasējumu fragmentu jebkuram neizpētītam tankam."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Rasējumi sniedz Pieredzes atlaidi un paātrina izpēti tankam. Tos var saņemt kā balvu vai pārvērst no universālajiem un nacionālajiem fragmentiem."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Tanka Rasējumi"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Esiet starp top 10 spēlētājiem jūsu komandā pēc nopelnītās Pieredzes 20 reizes Nejaušajās Kaujās VII-X Līmeņa tankos."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Šīs misijas ļauj pelnīt piecas reizes vairāk Pieredzi par katru veiksmīgu kauju. Priekš tā vajag uzvarēt un būt starp top 10 spēlētājiem komandā pēc nopelnītās Pieredzes."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 Misijas priekš ×5 Pieredzes"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Izpētiet un pērciet jebkuru VIII Līmeņa tanku."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "VIII Līmeņa tankiem ir jāizmanto visas iegūtās zināšanas. Pretinieki neļaus jums garlaikoties, nodrošinot aizraujošus satraukumus un nenovērtējamu pieredzi."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "VIII Līmeņa Tanks"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Izmantojiet Brīvo Pieredzi, lai izpētītu jebkuru moduli."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Ja jums nav pietiekami daudz Kaujas Pieredzes, lai izpētītu moduli vai tanku, jūs variet izmantot Brīvo Pieredzi, ko var nopelnīt jebkuram tankam."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "Brīvā Pieredze"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Ielādējiet alternatīvas čaulītes un sāciet Nejaušo Kauju III-X Līmeņa tankā."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Bruņu Cauršaujošas, Eksplozīvās un Bruņu Cauršaujošās Kompozīta Cietās čaulītes tiek izmantotas dažādām situācijām. Izvēlies uzmanīgi, lai iegūtu priekšrocību!"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munīcija"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Pārdodiet neizmantotu moduli no Noliktavas."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Neizmantoti moduļi, čaulītes, iekārtas, palīgmateriāli un citas lietas tiek glabātas Noliktavā. Jūs variet pārdot ekstra lietas par kredītiem."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Noliktavā"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Nopelniet 25000 kredītus Nejaušajās Kaujās III-X Līmeņa tankos."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Kredīti tiek izmantoti, lai pirktu čaulītes un jaunus tankus, remontētu tankus un vairāk. Ir svarīgi zināt, kā ietaupīt un izmantot tos saprātīgi."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Kredīti"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Cīnieties trīs Nejaušajās Kaujās III-X Līmeņa tankos ar palīgmateriāliem uzstādītiem visās pieejamās vietās."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Palīgmateriāli var labot kritiskus tanka bojājumus un dziedēt apkalpes ievainojumus kaujā. Palīgmateriālu izmantošana pareizajā laikā ir kritiska izdzīvošanai."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Palīgmateriāli"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Cīnieties trīs Nejaušajās Kaujās III-X Līmeņa tankos ar jebkuru uzstādītu iekārtu."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Tankus var aprīkot ar iekārtām, lai uzlabotu dažas to īpašības. Iekārtu vietas būs atkarīgas no tanka un spēles stila."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Iekārtas"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topogrāfija"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Izpildiet vienu scenāriju jebkurā kartē Topogrāfijā"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Izpildiet četrus pamata scenārijus vienā kartē Topogrāfijā"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Izlūkošana"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Izpildiet četrus uzlabotos scenārijus vienā kartē Topogrāfijā"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "A Ģeogrāfijā"
