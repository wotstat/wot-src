msgid "mode/halloween/battlePassTooltip/body"
msgstr "Atsevišķas misijas {whiteSpanish_open}Babilona: Tumšais tornis{whiteSpanish_close} pasākumā ļaus jums nopelnīt Kaujas Caurlaides punktus."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Kaujas Caurlaides Punkti"

msgid "mode/halloween/calendar"
msgstr "Pasākums ilgs %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Pasākums beigsies pēc %(date)s."

msgid "mode/halloween/description"
msgstr "Cīnieties un savāciet matēriju.\nKaujas īpašos tankos."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Jūsu datorsistēmas veiktspēja nav pietiekama šim režīmam. Jūs variet piedzīvot problēmas ar grafiku un tanku pārvietošanos. Ir iespējama arī spēles klienta nobrukšana."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Zema Veiktspēja"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Zema Veiktspēja"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Šim režīmam ir nepieciešama augsta datorsistēmas veiktspēja.\nJūs piedzīvosiet problēmas ar karšu ielādi, grafiku, tanku pārvietošanos. Nepietiekamas veiktspējas gadījumā pamēģiniet zemākus grafikas Iestatījumus."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Samazināta Veiktspēja"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Samazināta Veiktspēja"
