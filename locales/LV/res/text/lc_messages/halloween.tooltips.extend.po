msgid "Contact/status/inBattle/halloween"
msgstr "Babilona: Tumšais tornis kaujā"

msgid "advanced/hw_aoeDamageInstantShot"
msgstr "Izšauj šāvienu, kas bojā un apstulbina mērķi un visus ienaidnieka tankus 35 m rādiusā."

msgid "advanced/hw_aoeDrainEnemyHpInstantShot"
msgstr "Izšauj šāvienu, kas atjauno dzīvības punktus nozogot tos no mērķa un tuvējiem pretinieka tankiem 35 m rādiusā."

msgid "advanced/hw_aoeStunInstantShot"
msgstr "Izšauj šāvienu, kas apdullina mērķi un visus pretinieku tankus 35 m rādiusā."

msgid "advanced/hw_damageShield"
msgstr "Aizsargā pret jebkādiem bojājumiem (izņemot taranēšanu, slīkšanu un sadursmi) uz 7 sekundēm."

msgid "advanced/hw_fastReload"
msgstr "Palielina šaušanas ātrumu / pārlādes magazīnu."

msgid "advanced/hw_hpRepairAndCrewHeal"
msgstr "Atjauno dzīvības punktus, nodzēš uguni, noņem apdullināšanas efektu un salabo bojātus moduļus."

msgid "advanced/hw_invisibility"
msgstr "Īslaicīgi padara jūsu tanku neredzamu pretiniekiem, atjauno dzīvības punktus, salabo moduļus, nodzēš uguni, noņem apdullināšanas efektu un izārstē visus ievainotos apkalpes locekļus."

msgid "advanced/hw_teamRepairKit"
msgstr "Salabo bojātus moduļus, nodzēš uguni un noņem apdullināšanas efektu, un atjauno nedaudz dzīvības punktus sabiedroto tankiem tās rādiusā."

msgid "hangar/ammo_panel/hw_equipment/empty/body"
msgstr "Kaujas spējas palīdz jums efektīvāk cīnīties Babilona: Tumšais tornis kaujās, izpildīt mērķus un iegūt vērtīgas balvas. Lai tās aprīkotu, noklikšķiniet uz viena no kaujas spēju laukumiem."

msgid "hangar/ammo_panel/hw_equipment/empty/header"
msgstr "Kaujas Spēju Vietas"

msgid "hwShell/alt/description"
msgstr "%(bold)s var atrast kaujā ar noteiktu varbūtību pēc pretinieka iznīcināšanas."

msgid "hwShell/alt/description/bold"
msgstr "Alternatīva čaulīte"
