msgid "T14_descr"
msgstr "Izstrādāja no 1942. gada maija līdz 1943. gada maijam. Pēc izmēģinājumiem sākotnēji tika pieņemts lēmums par tanka sērijveida ražošanu, tomēr vēlāk tas tika atcelts, tādējādi T14 tā arī palika kā eksperimentāla bruņutehnika. Tika uzbūvēti divi prototipi."

msgid "T14_descr_MapsTraining_Player_HT_1"
msgstr "Izstrādāja no 1942. gada maija līdz 1943. gada maijam. Pēc izmēģinājumiem sākotnēji tika pieņemts lēmums par tanka sērijveida ražošanu, tomēr vēlāk tas tika atcelts, tādējādi T14 tā arī palika kā eksperimentāla bruņutehnika. Tika uzbūvēti divi prototipi."

