msgid "joke/event_1"
msgstr "Ja tavs suns kādreiz sāk spīdēt—ziņo mediķiem. Vai arī nē. Tu to nedzirdēji no manis."

msgid "joke/event_10"
msgstr "Suns peldēšanas nodarbības nokārtoja ar izcilību. Kareivis? Ne gluži."

msgid "joke/event_11"
msgstr "Tā bija taktiska evakuācija... uzkodu dēļ."

msgid "joke/event_12"
msgstr "Kam vajag čūsku atbaidītājus, ja tev ir astes mājiens un rējieni, kas biedē?"

msgid "joke/event_13"
msgstr "Kraut krāmu? Nē, tā ir morāli stiprinošu artefaktu kolekcija!"

msgid "joke/event_14"
msgstr "Nezinām, ar ko tas darbojas, bet, šķiet, ar tenisa bumbiņām un haosu."

msgid "joke/event_15"
msgstr "Aizmirsti mīnu meklētājus—dažkārt pietiek ar asu skatienu un kustīgu asti."

msgid "joke/event_16"
msgstr "Tavs suns oficiāli kļuvis par vienības uzticamāko pārtikas izlūku."

msgid "joke/event_17"
msgstr "Neviens nezina, no kurienes tas nācis, bet morāle aug, un siera krājumi krītas."

msgid "joke/event_18"
msgstr "Pēdējais pārraidītais ziņojums? \"Rēj vienu reizi—briesmas, divas—pārlāde.\""

msgid "joke/event_19"
msgstr "Viņš nelīda svešā teritorijā. Viņš vienkārši ļoti apmaldījās. Un bija bruņots."

msgid "joke/event_2"
msgstr "Izskatās, ka kāds beidzot atklāja veidu, kā paātrināt birokrātiju—četras ķepas un nekādu jautājumu."

msgid "joke/event_20"
msgstr "Aizmirsti sensorus—pie katras caurules uzstādi suni."

msgid "joke/event_21"
msgstr "Tu saproti, ka viss ir nopietni, ja sunim ir labāka piegādes ķēde nekā loģistikas komandai."

msgid "joke/event_22"
msgstr "Pat mūsu labākie mehāniķi tik ātri atslēgu nepārsniedza."

msgid "joke/event_23"
msgstr "Kad daba uzbrūk—iesaisti riešanas vienību."

msgid "joke/event_24"
msgstr "Vienīgais ekipāžas loceklis ar oficiālu statusu gan “gatavs kaujai”, gan “ļoti labs suns”."

msgid "joke/event_25"
msgstr "Hei, ja rotaļlieta sāk kustēties pati no sevis... tagad tava maiņa."

msgid "joke/event_26"
msgstr "Kaujas munīcija treniņā? Labi, ka tavs suns visu pārbauda vēlreiz."

msgid "joke/event_27"
msgstr "Mēneša jaunais rekrūts: četras kājas, bez lāpstas, bet ar daudz dubļu."

msgid "joke/event_28"
msgstr "Saukt suni par “pavāru” ir pārspīlējums, bet aste ir lielisks maisīšanas rīks."

msgid "joke/event_29"
msgstr "Ārsta norādījumi: divas tablešu porcijas un viens labs sunītis uz katru telpu."

msgid "joke/event_3"
msgstr "Autoiekrāvēja apliecības nav, bet dzinējspēka pietiek."

msgid "joke/event_30"
msgstr "Mazgāšana? Pārbaudīts. Putekļi? Pārbaudīts. Apmatojums? Divreiz pārbaudīts. Uzkopšana apstiprināta!"

msgid "joke/event_4"
msgstr "Tavs suns vai nu atrada slepenu krājumu… vai arī nolēma iekārtot jaunu garāžu."

msgid "joke/event_5"
msgstr "Izrādās, visefektīvākā formula pūļa izklīdināšanai ir raudzēta zivs un četras kājas."

msgid "joke/event_6"
msgstr "Suns un kaķis strādā kopā? Acīmredzot, apokalipse tuvojas ātrāk nekā plānots."

msgid "joke/event_7"
msgstr "Ja tavs suns sāk sargāt rezerves daļas, neuztraucies—viņš vienkārši vēlas paaugstinājumu līdz jaunākajam mehāniķim."

msgid "joke/event_8"
msgstr "Kā sauc gaudojošu suni pilnmēness laikā?—\"Vilkraudziens\"."

msgid "joke/event_9"
msgstr "Ugunsgrēka mācības glābj dzīvības. Suņi, acīmredzot, glābj apkalpes."

msgid "rewards/synergy_value"
msgstr "+"

msgid "rewards/title"
msgstr "Pazudis, bet ne pazudis:"

msgid "submit"
msgstr "Sapratu!"

msgid "text/event_1"
msgstr "{{@ style (color $color)}}Svešinieks {{/}}{{@ style (color $color)}}oficiālā {{/}}{{@ style (color $color)}}uzvalkā {{/}}tuvojas tev. \"Jūsu {{@ style (color $color)}}suns {{/}}ir palīdzējis {{@ style (color $color)}}meklēšanas {{/}}un {{@ style (color $color)}}ierobežošanas operācijā{{/}}, kurā tika atrasts {{@ style (color $color)}}bīstams {{/}}{{@ style (color $color)}}objekts{{@ style (color $defaultColor)}}. {{/}}{{/}}Informācija par šo incidentu tiks {{@ style (color $color)}}dzēsta {{/}}no visiem {{@ style (color $color)}}žurnāliem{{@ style (color $defaultColor)}}. {{/}}{{/}}Paldies par palīdzību.\" Vīrietis jums pasniedz {{@ style (color $color)}}sūtījumu{{/}} un pamet {{@ style (color $color)}}Garāžu{{/}}."

msgid "text/event_10"
msgstr "{{@ style (color $color)}}Mācību{{/}}{{@ style (color $color)}}kaujas {{/}}laikā uz {{@ style (color $color)}}ūdens{{/}} viens no {{@ style (color $color)}}karavīriem{{/}}{{@ style (color $color)}}sapinās{{/}} {{@ style (color $color)}}piestiprinājuma{{/}}{{@ style (color $color)}}virvēs{{/}}un {{@ style (color $color)}}iekrita{{/}} {{@ style (color $color)}}ūdenī{{@ style (color $defaultColor)}}. {{/}}{{/}}Par laimi, jūsu {{@ style (color $color)}}suns{{/}} atradās tuvumā un spēja {{@ style (color $color)}}izvilkt {{/}}{{@ style (color $color)}}slīkstošo{{/}}{{@ style (color $color)}}karavīru{{/}} līdz {{@ style (color $color)}}drošībai{{@ style (color $defaultColor)}}. {{/}}{{/}}Šis stāsts ātri kļuva par {{@ style (color $color)}}drosmes{{/}} simbolu visā {{@ style (color $color)}}vienībā{{/}}."

msgid "text/event_11"
msgstr "Jūs pamanījāt savu {{@ style (color $color)}}suni{{/}}, kas izskrēja no {{@ style (color $color)}}noliktavas {{/}}ar {{@ style (color $color)}}mazu maisiņu {{/}}{{@ style (color $color)}}mutē{{@ style (color $defaultColor)}}. {{/}}{{/}}Kad gatavojāties viņu {{@ style (color $color)}}norāt {{/}}par {{@ style (color $color)}}piegāžu {{/}}{{@ style (color $color)}}zagšanu{{/}}, {{@ style (color $color)}}uzraugs {{/}}pasmaidīja: \"Es nevaru ne piedot tik labam {{@ style (color $color)}}sunim{{/}}.\" Tomēr izskatās, ka nedaudz papildu {{@ style (color $color)}}apmācības {{/}}{{@ style (color $color)}}uzvedībā {{/}}nenāktu par ļaunu."

msgid "text/event_12"
msgstr "{{@ style (color $color)}}Kārtējās {{/}}{{@ style (color $color)}}pārbaudes laikā{{/}}, {{@ style (color $color)}}karavīri {{/}}atrada {{@ style (color $color)}}čūsku {{/}}{{@ style (color $color)}}ligzdu {{/}}pie vienas {{@ style (color $color)}}kazarmas{{@ style (color $defaultColor)}}. {{/}}{{/}}Kamēr viņi sprieda, kā {{@ style (color $color)}}rīkoties {{/}}ar to, jūsu uzticīgais {{@ style (color $color)}}suns {{/}}{{@ style (color $color)}}rāpuļus {{/}}aizbaidīja ar {{@ style (color $color)}}riešanu {{/}}un {{@ style (color $color)}}bezbailīgu mešanos virsū{{@ style (color $defaultColor)}}. {{/}}{{/}}Līdz {{@ style (color $color)}}vakaram{{/}}, {{@ style (color $color)}}apkārtne {{/}}atkal bija {{@ style (color $color)}}droša{{/}}. Jūsu {{@ style (color $color)}}suņa drosme {{/}}noteikti tiks {{@ style (color $color)}}atalgota{{/}}."

msgid "text/event_13"
msgstr "Jūs pamanījāt, ka jūsu {{@ style (color $color)}}suns {{/}}{{@ style (color $color)}}dažkārt {{/}}{{@ style (color $color)}}aizskrien {{/}}{{@ style (color $color)}}prom {{/}}agrā {{@ style (color $color)}}rītā{{@ style (color $defaultColor)}}. {{/}}{{/}}Izrādījās, ka daži {{@ style (color $color)}}piloti {{/}}ievēro tradīciju {{@ style (color $color)}}paglaudīt {{/}}{{@ style (color $color)}}kucēnu {{/}}{{@ style (color $color)}}veiksmei {{/}}pirms {{@ style (color $color)}}pacelšanās{{@ style (color $defaultColor)}}. {{/}}{{/}}Ziņkārības vadīti, jūs {{@ style (color $color)}}sekojāt {{/}}{{@ style (color $color)}}savam astes-{{/}}{{@ style (color $color)}}šūpojošajam {{/}}{{@ style (color $color)}}draugam {{/}}un atklājāt {{@ style (color $color)}}slepenu {{/}}{{@ style (color $color)}}krājumu{{/}}—{{@ style (color $color)}}nelielu {{/}}{{@ style (color $color)}}lādi{{/}}, kas bija pilna ar {{@ style (color $color)}}pudeļu {{/}}{{@ style (color $color)}}korķīšiem{{/}}, {{@ style (color $color)}}pogām{{/}} un {{@ style (color $color)}}saplēstām {{/}}{{@ style (color $color)}}zeķēm{{/}}."

msgid "text/event_14"
msgstr "Jūsu {{@ style (color $color)}}suns {{/}}atrada {{@ style (color $color)}}dīvainu {{/}}{{@ style (color $color)}}ierīci {{/}}{{@ style (color $color)}}vecā {{/}}{{@ style (color $color)}}garāžā{{@ style (color $defaultColor)}}. {{/}}{{/}}Kad tā tika {{@ style (color $color)}}ieslēgta{{/}}{{@ style (color $color)}}{{@ style (color $defaultColor)}},{{/}}{{/}}{{@ style (color $color)}} ierīce {{/}}sāka {{@ style (color $color)}}apstrādāt {{/}}tajā esošās {{@ style (color $color)}}rotaļlietas{{/}}, radot pilnīgi {{@ style (color $color)}}jaunus {{/}}{{@ style (color $color)}}priekšmetus{{@ style (color $defaultColor)}}. {{/}}{{/}}Visu šo {{@ style (color $color)}}pārvērtību {{/}}laikā jums izdevās iegūt pāris {{@ style (color $color)}}noderīgus {{/}}{{@ style (color $color)}}priekšmetus{{/}}."

msgid "text/event_15"
msgstr "{{@ style (color $color)}}Mācību {{/}}laikā {{@ style (color $color)}}poligonā {{/}}{{@ style (color $color)}}vairāki {{/}}{{@ style (color $color)}}tanki {{/}}iebrauca laukā, kur bija izkaisītas {{@ style (color $color)}}mācību {{/}}{{@ style (color $color)}}mīnas{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}suns {{/}}{{@ style (color $color)}}strauji {{/}}izrāvās priekšā, {{@ style (color $color)}}novēršot {{/}}{{@ style (color $color)}}uzmanību {{/}}un palīdzot {{@ style (color $color)}}apkalpēm {{/}}laikus {{@ style (color $color)}}pamanīt {{/}}{{@ style (color $color)}}briesmas{{/}}. Pateicoties jūsu mājdzīvnieka {{@ style (color $color)}}ātrajai {{/}}{{@ style (color $color)}}reakcijai{{/}}, {{@ style (color $color)}}tanki {{/}}savācās un {{@ style (color $color)}}droši {{/}}pārvarēja {{@ style (color $color)}}šķēršļus{{/}}. Neatkarīgi no iznākuma, {{@ style (color $color)}}atalgojums {{/}}par tādu {{@ style (color $color)}}drosmi {{/}}ir garantēts."

msgid "text/event_16"
msgstr "Kamēr {{@ style (color $color)}}izpētiet {{/}}{{@ style (color $color)}}Garāžu{{/}}, jūsu {{@ style (color $color)}}suns {{/}}ieoda {{@ style (color $color)}}slēptuvi {{/}}ar {{@ style (color $color)}}vecām devām{{/}}, kas bija paslēptas aiz dažām {{@ style (color $color)}}kastēm{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Karavīri {{/}}kārtīgi pasmējās par {{@ style (color $color)}}{{@ style (color $defaultColor)}}\"{{/}}dārgumu{{@ style (color $defaultColor)}}\"{{/}}{{/}} un nodeva to {{@ style (color $color)}}apgādes priekšniekam{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}suns {{/}}tika apsolīts {{@ style (color $color)}}atalgojums {{/}}par {{@ style (color $color)}}negaidīto {{/}}{{@ style (color $color)}}atradumu{{/}}."

msgid "text/event_17"
msgstr "Jūs dzirdējāt {{@ style (color $color)}}troksni{{/}}, kas nāca no {{@ style (color $color)}}kazarmām{{@ style (color $defaultColor)}}. {{/}}{{/}}Kad tuvojāties, jūs redzējāt {{@ style (color $color)}}karavīrus{{/}}, kas sapulcējušies apkārt, vērojot, kā jūsu {{@ style (color $color)}}suns {{/}}{{@ style (color $color)}}cīnās {{/}}ar milzīgu, {{@ style (color $color)}}muskuļiem {{/}}{{@ style (color $color)}}apvītu {{/}}{{@ style (color $color)}}peli{{@ style (color $defaultColor)}}. {{/}}{{/}}Vienā brīdī visi tika {{@ style (color $color)}}novērsti {{/}}ar {{@ style (color $color)}}paziņojumu{{/}}—un kad viņi atgriezās, {{@ style (color $color)}}dīvainais {{/}}{{@ style (color $color)}}grauzējs {{/}}bija {{@ style (color $color)}}pazudis{{@ style (color $defaultColor)}}. {{/}}{{/}}Pateicībā par tik {{@ style (color $color)}}izklaidējošu {{/}}{{@ style (color $color)}}izrādi{{/}}, {{@ style (color $color)}}karavīri {{/}}jūsu {{@ style (color $color)}}sunim {{/}}deva dažus {{@ style (color $color)}}noderīgus {{/}}{{@ style (color $color)}}priekšmetus{{/}}."

msgid "text/event_18"
msgstr "Kamēr {{@ style (color $color)}}izpētiet {{/}}{{@ style (color $color)}}veco {{/}}{{@ style (color $color)}}komandes {{/}}{{@ style (color $color)}}zāli{{/}}, jūsu {{@ style (color $color)}}suns {{/}}sāka {{@ style (color $color)}}rēt {{/}}uz {{@ style (color $color)}}putekļainu portretu{{@ style (color $defaultColor)}}. {{/}}{{/}}Mazliet {{@ style (color $color)}}notīrīšanas{{/}}, un {{@ style (color $color)}}piezīme {{/}}nokrita no {{@ style (color $color)}}rāmja{{/}}.{{br}}Tā runāja par {{@ style (color $color)}}aizmirstu {{/}}{{@ style (color $color)}}tanku {{/}}{{@ style (color $color)}}vienību{{/}}, kas {{@ style (color $color)}}pazuda {{/}}{{@ style (color $color)}}nakts {{/}}{{@ style (color $color)}}manevru{{/}} laikā—viņu pēdējais zināmais {{@ style (color $color)}}izsaukuma {{/}}{{@ style (color $color)}}zīmes {{/}}bija {{@ style (color $color)}}Dzelzs {{/}}{{@ style (color $color)}}Pēda{{/}}."

msgid "text/event_19"
msgstr "{{@ style (color $color)}}Patrulēšanas {{/}}laikā ap {{@ style (color $color)}}teritoriju{{/}}, jūsu {{@ style (color $color)}}suns {{/}}pēkšņi {{@ style (color $color)}}ieskrēja {{/}}{{@ style (color $color)}}krūmos {{/}}un {{@ style (color $color)}}izdzina {{/}}{{@ style (color $color)}}slēpjošu {{/}}{{@ style (color $color)}}svešinieku{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Patrulēšana {{/}}{{@ style (color $color)}}aizturēja {{/}}{{@ style (color $color)}}iebrucēju{{/}}, un {{@ style (color $color)}}incidents {{/}}tika {{@ style (color $color)}}reģistrēts {{/}}turpmākai {{@ style (color $color)}}izmeklēšanai{{/}}."

msgid "text/event_2"
msgstr "{{@ style (color $color)}}Suns {{/}}skrien jums pretī, luncinot {{@ style (color $color)}}asti{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Papīru {{/}}kaudze ir sakrauta tā {{@ style (color $color)}}zobos{{@ style (color $defaultColor)}}. {{/}}{{/}}Pirmajā acu uzmetienā tie izskatās pēc {{@ style (color $color)}}ziņojumiem{{/}}, {{@ style (color $color)}}tabulām {{/}}un citas {{@ style (color $color)}}dokumentācijas{{@ style (color $defaultColor)}}. {{/}}{{/}}Puiši {{@ style (color $color)}}birojā {{/}}droši vien būs priecīgi tos atgūt."

msgid "text/event_20"
msgstr "Kamēr {{@ style (color $color)}}staigājot {{/}}pa {{@ style (color $color)}}apkaimi{{/}}, jūsu {{@ style (color $color)}}suns {{/}}pēkšņi sāka {{@ style (color $color)}}rēt {{/}}uz vienu no {{@ style (color $color)}}ūdens caurulēm{{@ style (color $defaultColor)}}. {{/}}{{/}}Pēc tam, kad {{@ style (color $color)}}tehniķi {{/}}{{@ style (color $color)}}pārbaudīja {{/}}{{@ style (color $color)}}teritoriju{{/}}, viņi atklāja {{@ style (color $color)}}kļūdu{{/}}, kas varēja novest pie lielas {{@ style (color $color)}}sistēmas {{/}}{{@ style (color $color)}}kļūmes{{/}}. "

msgid "text/event_21"
msgstr "Jūsu {{@ style (color $color)}}suns {{/}}atnesa jums {{@ style (color $color)}}somiņu{{/}}, kas bija pilna ar visdažādākajām {{@ style (color $color)}}dīvainām, {{/}}{{@ style (color $color)}}noderīgām {{/}}{{@ style (color $color)}}lietām{{@ style (color $defaultColor)}}. {{/}}{{/}}Neskatoties uz jūsu pūlēm, jūs nevarējāt {{@ style (color $color)}}izdomāt{{/}}, no kurienes tā varētu {{@ style (color $color)}}būt {{/}}{{@ style (color $color)}}nākusi{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}četru {{/}}{{@ style (color $color)}}kāju {{/}}{{@ style (color $color)}}draugs {{/}}vienkārši sēdēja tuvumā, izskatoties {{@ style (color $color)}}pašapmierināts {{/}}un pilnīgi {{@ style (color $color)}}apmierināts {{/}}pārējā {{@ style (color $color)}}dienas {{/}}daļā."

msgid "text/event_22"
msgstr "{{@ style (color $color)}}Mehāniķi {{/}}spēja {{@ style (color $color)}}iemācīt {{/}}jūsu {{@ style (color $color)}}sunim {{/}}{{@ style (color $color)}}atnest {{/}}un {{@ style (color $color)}}atpazīt {{/}}{{@ style (color $color)}}instrumentus{{@ style (color $defaultColor)}}. {{/}}{{/}}Šis {{@ style (color $color)}}izcilais {{/}}{{@ style (color $color)}}suns {{/}}pavadīja visu {{@ style (color $color)}}dienu{{/}}, {{@ style (color $color)}}strādājot {{/}}{{@ style (color $color)}}kopā {{/}}ar viņiem, pārliecinoši {{@ style (color $color)}}atnesot {{/}}pareizo {{@ style (color $color)}}aprīkojumu {{/}}kā pieredzējis {{@ style (color $color)}}apkalpes {{/}}{{@ style (color $color)}}loceklis{{/}}."

msgid "text/event_23"
msgstr "{{@ style (color $color)}}Miris {{/}}{{@ style (color $color)}}koks {{/}}uzkrita uz viena no {{@ style (color $color)}}sargiem {{/}}{{@ style (color $color)}}patruļas {{@ style (color $defaultColor)}}laikā. {{/}}{{/}}Jūsu {{@ style (color $color)}}suns {{/}}ne tikai {{@ style (color $color)}}aizskrēja {{/}}{{@ style (color $color)}}saukt {{/}}{{@ style (color $color)}}pēc {{/}}{{@ style (color $color)}}palīdzības{{/}}, bet arī {{@ style (color $color)}}palīdzēja {{/}}{{@ style (color $color)}}izvilkt {{/}}{{@ style (color $color)}}ievainoto {{/}}{{@ style (color $color)}}vīru {{/}}no zem {{@ style (color $color)}}stumbra{{@ style (color $defaultColor)}}. {{/}}{{/}}Šis {{@ style (color $color)}}stāsts {{/}}ātri {{@ style (color $color)}}izplatījās {{/}}starp {{@ style (color $color)}}patruļas {{/}}{{@ style (color $color)}}vienībām{{/}}."

msgid "text/event_24"
msgstr "Jūsu {{@ style (color $color)}}suns {{/}}piedalījās {{@ style (color $color)}}apbalvošanas {{/}}{{@ style (color $color)}}ceremonijā {{/}}par vispieredzējušākajiem {{@ style (color $color)}}tankistiem{{@ style (color $defaultColor)}}. {{/}}{{/}}Uzticīgais {{@ style (color $color)}}suns {{/}}darbojās kā {{@ style (color $color)}}asistents{{/}}, pasniedzot {{@ style (color $color)}}medaļas {{/}}un {{@ style (color $color)}}dāvanas {{/}}uz {{@ style (color $color)}}saimnieku{{@ style (color $defaultColor)}}. {{/}}{{/}}Šis {{@ style (color $color)}}ieguldījums {{/}}nepalika {{@ style (color $color)}}nepamanīts{{/}}—tas nopelnīja {{@ style (color $color)}}kucēnam {{/}}pelnītu {{@ style (color $color)}}balvu{{/}}."

msgid "text/event_25"
msgstr "Jūsu {{@ style (color $color)}}suns {{/}}atgriezās uz {{@ style (color $color)}}bāzi {{/}}nesot {{@ style (color $color)}}saplēstu {{/}}{{@ style (color $color)}}plīša {{/}}{{@ style (color $color)}}lapsu{{@ style (color $defaultColor)}}. {{/}}{{/}}Daži {{@ style (color $color)}}karavīri {{/}}apgalvoja, ka viņi dzirdējuši {{@ style (color $color)}}čukstus {{/}}{{@ style (color $color)}}mežā {{/}}īsi pirms tam.{{br}}Vēlāk tajā {{@ style (color $color)}}vakarā{{/}}, viens no viņiem {{@ style (color $color)}}atpazina {{/}}{{@ style (color $color)}}rotaļlietu{{/}}—tā atbilda {{@ style (color $color)}}lapsas {{/}}{{@ style (color $color)}}emblēmai {{/}}ilgi {{@ style (color $color)}}izformētai {{/}}{{@ style (color $color)}}izlūkošanas {{/}}{{@ style (color $color)}}vienībai{{/}}, kas {{@ style (color $color)}}pazuda {{/}}pirms gadiem {{@ style (color $color)}}ziemas {{/}}{{@ style (color $color)}}manevros{{@ style (color $defaultColor)}}. {{/}}{{/}}Nav {{@ style (color $color)}}ierakstu {{/}}palikuši."

msgid "text/event_26"
msgstr "{{@ style (color $color)}}Mācību {{/}}{{@ style (color $color)}}krājumu {{/}}{{@ style (color $color)}}izsniegšanas {{/}}laikā {{@ style (color $color)}}laukā {{/}}jūsu {{@ style (color $color)}}suns {{/}}sāka {{@ style (color $color)}}sparīgi {{/}}{{@ style (color $color)}}riet {{/}}uz {{@ style (color $color)}}kastēm{{@ style (color $defaultColor)}}. {{/}}{{/}}Satraucoši, {{@ style (color $color)}}virsnieki {{/}}{{@ style (color $color)}}pārbaudīja {{/}}{{@ style (color $color)}}konteinerus {{/}}un atklāja, ka daļa no {{@ style (color $color)}}aprīkojuma {{/}}bija {{@ style (color $color)}}dzīva {{/}}{{@ style (color $color)}}kaujas {{/}}{{@ style (color $color)}}tehnika{{/}}, kas kļūdaini sajaukta ar {{@ style (color $color)}}izmēģinājuma {{/}}{{@ style (color $color)}}partiju{{/}}."

msgid "text/event_27"
msgstr "{{@ style (color $color)}}Militāro {{/}}{{@ style (color $color)}}mācību {{/}}laikā jūsu {{@ style (color $color)}}mājdzīvnieks {{/}}kļuva apsēsts ar {{@ style (color $color)}}tranšeju {{/}}{{@ style (color $color)}}rakšanu{{@ style (color $defaultColor)}}. {{/}}{{/}}Šī {{@ style (color $color)}}entuziasma {{/}}ātri {{@ style (color $color)}}izplatījās {{/}}starp {{@ style (color $color)}}iesaucamajiem{{/}}, kuri sāka {{@ style (color $color)}}sacensties {{/}}ar {{@ style (color $color)}}suni {{/}}{{@ style (color $color)}}ātrumā {{/}}un {{@ style (color $color)}}dziļumā{{/}}—par {{@ style (color $color)}}instruktoru{{/}}{{@ style (color $color)}}izklaidi{{/}}."

msgid "text/event_28"
msgstr "Šodien bija {{@ style (color $color)}}mājas {{/}}{{@ style (color $color)}}gatavošanas{{/}}{{@ style (color $color)}}diena {{/}}{{@ style (color $color)}}nometnē{{/}}, kad {{@ style (color $color)}}karavīriem {{/}}bija atļauts {{@ style (color $color)}}gatavot {{/}}{{@ style (color $color)}}vietējos {{/}}{{@ style (color $color)}}ēdienus {{/}}no pieejamajām {{@ style (color $color)}}ingredientiem{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}suns {{/}}pavadīja visu {{@ style (color $color)}}dienu{{/}}, {{@ style (color $color)}}skrienot {{/}}{{@ style (color $color)}}starp {{/}}{{@ style (color $color)}}gatavošanas {{/}}{{@ style (color $color)}}stacijām {{/}}un {{@ style (color $color)}}palīdzot{{/}}{{@ style (color $color)}}nest {{/}}{{@ style (color $color)}}piederumus{{/}}—nopelnot vairāk nekā dažus {{@ style (color $color)}}kumosus {{/}}no {{@ style (color $color)}}draudzīgām {{/}}{{@ style (color $color)}}rokām{{/}}."

msgid "text/event_29"
msgstr "Šodien bija {{@ style (color $color)}}svarīga {{/}}{{@ style (color $color)}}diena{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}mīlulis {{/}}pavadīja to {{@ style (color $color)}}slimnīcā{{/}}, {{@ style (color $color)}}cenšoties {{/}}{{@ style (color $color)}}uzmundrinot {{/}}{{@ style (color $color)}}ievainotos{{/}}, izpildot dažus {{@ style (color $color)}}trikus{{/}}, ko biji iemācījis, un pārliecinoties, ka {{@ style (color $color)}}apmeklē {{/}}katru {{@ style (color $color)}}karavīru{{@ style (color $defaultColor)}}. {{/}}{{/}}Uz brīdi {{@ style (color $color)}}nodaļa {{/}}bija piepildīta ar {{@ style (color $color)}}smiekliem {{/}}un {{@ style (color $color)}}astes vēzieniem{{/}}."

msgid "text/event_3"
msgstr "Jūs vērojat, kā {{@ style (color $color)}}suns {{/}}priecīgi palīdz {{@ style (color $color)}}zēniem {{/}}no {{@ style (color $color)}}noliktavas {{/}}nest {{@ style (color $color)}}somas {{/}}un citus {{@ style (color $color)}}kravas{{@ style (color $defaultColor)}}. {{/}}{{/}}Dienas beigās pateicīgais {{@ style (color $color)}}priekšnieks {{/}}jums pasniedz nelielu {{@ style (color $color)}}paku {{/}}kā pateicību par izpalīdzīgā suņa darbu."

msgid "text/event_30"
msgstr "Šodien jūsu {{@ style (color $color)}}suns {{/}}palīdzēja bieži nepamanītajam {{@ style (color $color)}}apkalpojošajam {{/}}{{@ style (color $color)}}personālam{{@ style (color $defaultColor)}}. {{/}}{{/}}Strādīgais {{@ style (color $color)}}suns {{/}}nesa {{@ style (color $color)}}tīrīšanas {{/}}{{@ style (color $color)}}piederumus {{/}}un pat mēģināja {{@ style (color $color)}}vilkt {{/}}{{@ style (color $color)}}kādu {{/}}{{@ style (color $color)}}mopu {{/}}pāri {{@ style (color $color)}}grīdai {{/}}bez jebkādas palīdzības. Šādi {{@ style (color $color)}}neveikli{{/}}, bet {{@ style (color $color)}}apņēmīgi {{/}}{{@ style (color $color)}}centieni {{/}}pacēla visiem {{@ style (color $color)}}garastāvokli {{/}}uz visu atlikušo {{@ style (color $color)}}dienu{{/}}."

msgid "text/event_4"
msgstr "{{@ style (color $color)}}Suns {{/}}ievilka {{@ style (color $color)}}koka {{/}}{{@ style (color $color)}}kasti{{/}}, kas bija piepildīta ar dīvainiem, nesaderīgiem {{@ style (color $color)}}instrumentiem{{@ style (color $defaultColor)}}. {{/}}{{/}}Neviens nezina, no kurienes tā nākusi, bet izskatās, ka kāds to ir {{@ style (color $color)}}sapakojis {{/}}apzināti."

msgid "text/event_5"
msgstr "{{@ style (color $color)}}Suns {{/}}atrada {{@ style (color $color)}}bundžu {{/}}ar {{@ style (color $color)}}zviedru {{/}}{{@ style (color $color)}}etiķeti{{@ style (color $defaultColor)}}. {{/}}{{/}}Pēc tam, kad {{@ style (color $color)}}bija{{/}}{{@ style (color $color)}}sakodis {{/}}{{@ style (color $color)}}vāku{{/}}, tas sāka blēņoties un {{@ style (color $color)}}skriet {{/}}{{@ style (color $color)}}pakaļ {{/}}{{@ style (color $color)}}visiem {{/}}{{@ style (color $color)}}karavīriem{{/}}, kuri {{@ style (color $color)}}bēga {{/}}no bundžas {{@ style (color $color)}}briesmīgās {{/}}{{@ style (color $color)}}smakas{{@ style (color $defaultColor)}}. {{/}}{{/}}Viens no garām skrienošajiem {{@ style (color $color)}}vīriem {{/}} piedāvāja tev {{@ style (color $color)}}atlīdzību{{/}}, lai apturētu šo {{@ style (color $color)}}mocību{{/}}."

msgid "text/event_6"
msgstr "Viens no {{@ style (color $color)}}pavāriem {{/}}visu dienu pavadīja, izliekot {{@ style (color $color)}}plakātus {{/}}par {{@ style (color $color)}}pazudušo {{/}}{{@ style (color $color)}}pazudušo {{/}}ap {{@ style (color $color)}}Garāžu{{@ style (color $defaultColor)}}. {{/}}{{/}}Jūsu {{@ style (color $color)}}suns {{/}}nolēma palīdzēt {{@ style (color $color)}}meklēšanā {{/}}un pēc dažām stundām atrada {{@ style (color $color)}}pūkaino {{/}}{{@ style (color $color)}}bēgli{{/}}, slēpjamies pie vienas no {{@ style (color $color)}}kazarmām{{/}}."

msgid "text/event_7"
msgstr "Jūsu {{@ style (color $color)}}suns {{/}}atrada {{@ style (color $color)}}dīvainu {{/}}{{@ style (color $color)}}ierīci {{/}}un nesa to apkārt pa {{@ style (color $color)}}garāžu {{/}}visu dienu. Galu galā viens no {{@ style (color $color)}}mehāniķiem {{/}}atpazina to kā {{@ style (color $color)}}rezerves {{/}}{{@ style (color $color)}}tvertnes {{/}}{{@ style (color $color)}}komponentu {{/}}un uzmanīgi aiznesa to uz {{@ style (color $color)}}darbnīcu{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Suns {{/}}izskatījās ļoti lepns par savu {{@ style (color $color)}}atklājumu{{@ style (color $defaultColor)}}. {{/}}{{/}}Lai kas tas arī būtu, izskatās, ka jūs tiksiet {{@ style (color $color)}}atalgots {{/}}par {{@ style (color $color)}}atradumu{{/}}."

msgid "text/event_8"
msgstr "Šonakt bija {{@ style (color $color)}}pilns {{/}}{{@ style (color $color)}}mēness{{@ style (color $defaultColor)}}. {{/}}{{/}}Apburts ar {{@ style (color $color)}}mēnessgaismu{{/}}, {{@ style (color $color)}}suns {{/}}gandrīz nepārtraukti gaudoja līdz {{@ style (color $color)}}rītam{{@ style (color $defaultColor)}}. {{/}}{{/}}{{@ style (color $color)}}Karavīri{{/}}, kas pamodās, izmēģināja visu, lai nomierinātu {{@ style (color $color)}}kucēnu{{/}}, bet nekas nešķita darbojoties."

msgid "text/event_9"
msgstr "{{@ style (color $color)}}Testēšanas {{/}}laikā vienā no {{@ style (color $color)}}tankiem {{/}}izcēlās {{@ style (color $color)}}uguns{{@ style (color $defaultColor)}}. {{/}}{{/}}Pirms kāds varēja reaģēt, jūsu {{@ style (color $color)}}suns {{/}}ieskrēja {{@ style (color $color)}}degošajā {{/}}{{@ style (color $color)}}tanka {{/}}un palīdzēja {{@ style (color $color)}}apkalpei {{/}}{{@ style (color $color)}}izbēgt{{@ style (color $defaultColor)}}. {{/}}{{/}}Stāsts par šādu {{@ style (color $color)}}drosmi {{/}}ātri izplatījās pa {{@ style (color $color)}}bāzi{{/}}."

