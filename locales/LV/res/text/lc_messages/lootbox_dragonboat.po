msgid "common/boxCategory/lowerCase/dragonboat"
msgstr "Pūķu Laivu Kastes"

msgid "common/boxCategory/upperCase/dragonboat"
msgstr "PŪĶU LAIVU KASTES"

msgid "entryPoint/tooltip/description"
msgstr "Tās ir īpašas kastes ar unikāliem un vērtīgiem spēles priekšmetiem.\n Kastes var iegūt spēles Veikalā vai Premium veikalā."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Pūķu Laivu Kastes Uz Laiku Nav Pieejamas"

msgid "eventName/lowerCase"
msgstr "Pieradiniet Pūķi, Brauciet pa Vēju"

msgid "eventName/upperCase"
msgstr "PIERADINIET PŪĶI, BRAUCIET PA VĒJU"

msgid "infoPage/footer/description/compensation"
msgstr "Ja jums jau pieder visi tanki no iespējamo kastu saturu saraksta, tad visi nākamie tanki, ko saņemsiet no Pūķu Laivu Kastēm, tiks kompensēti zeltā, kas atbilst to pilnajai vērtībai."

msgid "infoPage/footer/description/guaranteed"
msgstr "Katras %(guaranteed0)s Pūķa laivas kastes garantē VIII–IX līmeņa tanku. Ja neiegūsti tanku atvēršanas laikā, VIII–IX līmeņa tanks, kurš tev vēl nepieder, izkritīs, atverot %(guaranteed0)s&zwnbsp;. Pūķa laivas kasti. Pēc tam skaitītājs tiek atiestatīts."

msgid "noBoxesView/description/"
msgstr "Jums nav nevienas kastes.\n Tās var iegūt spēles Veikalā."
