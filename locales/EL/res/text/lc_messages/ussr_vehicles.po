msgid "T-127"
msgstr "T-127"

msgid "T-127_descr"
msgstr "Αναπτύχθηκε παράλληλα με το Τ-126 στο εργοστάσιο Νο. 174 το καλοκαίρι του 1940. Η ανάπτυξή του διακόπηκε κατά την προκριματική φάση και στη συνέχεια ματαιώθηκε λόγω προβλημάτων με τον κινητήρα ντίζελ V-3."

msgid "T-127_long_special"
msgstr "Ένα μικρό, συμπαγές, καλά θωρακισμένο όχημα για τη βαθμίδα του, συγχωρεί πολλά λάθη στη μάχη, ικανό να του ανατεθεί οποιοσδήποτε ρόλος."

msgid "T-127_short_special"
msgstr "Πολλαπλών ρόλων στη μάχη, καλή θωράκιση"

