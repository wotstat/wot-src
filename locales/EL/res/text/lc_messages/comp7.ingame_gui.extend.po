msgid "player_errors/equipment/roleSkill/unavailable"
msgstr "Η Ικανότητα Ρόλου %(name)s δεν είναι διαθέσιμη: καμία διαθέσιμη επανάληψη."

msgid "player_messages/equipment/roleSkill/applied"
msgstr "Η Ικανότητα Ρόλου %(name)s ενεργοποιήθηκε!"

msgid "player_messages/equipment/roleSkill/promoted"
msgstr "Το επίπεδο της Ικανότητας Ρόλου %(name)s μεγάλωσε!"

