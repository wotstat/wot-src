msgstr[2] "Απομένουν %(count) συσκευές"

msgid "awardViews/footer/backButton/"
msgstr "Πίσω στα Κοντέινερ"

msgid "boxTooltip/description/text/wt"
msgstr "Όταν ανοίγετε συσκευές, μπορεί να βρείτε Προνομιακά Οχήματα, νομίσματα του παιχνιδιού και άλλα πολύτιμα αγαθά."

msgid "boxTooltip/howGet/text/wt"
msgstr "Τις συσκευές Paradoxmoduls μπορείτε να τις αγοράσετε από τον Εφοδιασμό του παιχνιδιού ή από το Premium Shop."

msgid "common/boxCategory/lowerCase/wt"
msgstr "Paradoxmodul"

msgid "common/boxCategory/upperCase/wt"
msgstr "PARADOXMODUL"

msgid "common/getButton/lowerCase"
msgstr "Αποκτήστε Συσκευές"

msgid "common/getButton/upperCase"
msgstr "ΑΠΟΚΤΗΣΤΕ ΣΥΣΚΕΥΕΣ"

msgid "common/loader"
msgstr "Άνοιγμα συσκευής..."

msgid "common/statistics/emptyHeader"
msgstr "Ανοίξτε συσκευές για να δείτε στατιστικά."

msgid "common/statistics/header"
msgstr "Συσκευές που ανοίχθηκαν: %(count)"

msgid "confirmResetLootBoxStatistics/description"
msgstr "Όλες οι πληροφορίες από το άνοιγμα των συσκευών θα μηδενιστεί."

msgid "entryPoint/boxes"
msgstr "ΣΤΙΣ ΣΥΣΚΕΥΕΣ"

msgid "entryPoint/tooltip/description"
msgstr "Σε αυτές τις ειδικές συσκευές μπορείτε να βρείτε πολύτιμα αγαθά του παιχνιδιού, όπως Προνομιακά Οχήματα και μοναδικά στοιχεία προσαρμογής.\nΑγοράστε τις από τον Εφοδιασμό ή το Premium Shop."

msgid "entryPoint/tooltip/warningDescription"
msgstr "Η λειτουργία των συσκευών είναι προσωρινά μη διαθέσιμη για τεχνικούς λόγους. Μας συγχωρείτε για την ταλαιπωρία."

msgid "entryPoint/tooltip/warningTitle"
msgstr "Συσκευές Προσωρινά Μη Διαθέσιμες"

msgid "eventName/lowerCase"
msgstr "Break the Paradox"

msgid "eventName/upperCase"
msgstr "BREAK THE PARADOX"

msgid "guaranteedTitle/nextBox"
msgstr "Εγγυημένο Έπαθλο στην επόμενη συσκευή!"

msgid "guaranteedTitle/text"
msgstr "Μέγιστο πλήθος συσκευών πριν το Εγγυημένο Έπαθλο: %(count)"

msgid "infoPage/footer/description/autoOpen"
msgstr "Εάν δεν ανοίξετε όλα τις συσκευές έως το τέλος της διοργάνωσης, θα ανοιχτούν αυτόματα για λογαριασμό σας."

msgid "infoPage/footer/description/compensation"
msgstr "Εάν έχετε ήδη στην κατοχή σας όλα τα οχήματα από τη λίστα με τα πιθανά έπαθλα, θα λάβετε ως αντιστάθμισμα την πλήρη αξία σε gold όσων οχημάτων βρείτε στις συσκευές."

msgid "infoPage/footer/description/guaranteed"
msgstr "Σε κάθε %(guaranteed0)s συσκευές, θα βρείτε εγγυημένα ένα Προνομιακό Όχημα. Αλλά αν δεν βρείτε κάποιο τέτοιο όχημα, τότε με το άνοιγμα της %(guaranteed0)sης συσκευής θα λάβετε εγγυημένα ένα Προνομιακό Όχημα που δεν έχετε ήδη στην κατοχή σας. Όταν βρείτε κάποιο τέτοιο όχημα, τότε η αντίστροφη μέτρηση ξεκινά και πάλι από την αρχή."

msgid "infoPage/header/description"
msgstr "Ανοίξτε τις συσκευές για να βρείτε πολύτιμα αγαθά του παιχνιδιού! Δείτε περισσότερες λεπτομέρειες παρακάτω."

msgid "multipleRewardView/header/subTitle/"
msgstr "Περιεχόμενα %(name) (Ανοίξατε %(boxesCount) συσκευές)"

msgid "noBoxesView/description/"
msgstr "Δεν έχετε καμία συσκευή. Αγοράστε τις\nαπό τον Εφοδιασμό του παιχνιδιού ή από το Premium Shop."

msgid "preview/backLabel"
msgstr "ΣΤΙΣ ΣΥΣΚΕΥΕΣ"

msgid "quantityTitle/boxesAvailable"
msgstr "Διαθέσιμες συσκευές: %(boxesCount)"

msgid "quantityTitle/noBoxes"
msgstr "Καμία διαθέσιμη συσκευή"

msgid "singleRewardView/tooltip/description/"
msgstr "Εάν έχετε ήδη στην κατοχή σας όλα τα οχήματα από τη λίστα με τα πιθανά έπαθλα, θα λάβετε αντιστάθμισμα σε gold για όσα οχήματα βρείτε στις συσκευές."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) συσκευή"
msgstr[1] "%(remainingCount) συσκευές"
msgstr[2] "%(remainingCount) συσκευές"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "Το Εγγυημένο Έπαθλο είναι ένα όχημα από τη λίστα με τα διαθέσιμα έπαθλα.\nΕάν ανοίξετε %(remainingCount) συσκευές αλλά δεν βρείτε κάποιο τέτοιο όχημα, τότε με το άνοιγμα της %(count)ης συσκευής θα λάβετε εγγυημένα ένα όχημα από τη λίστα με τα διαθέσιμα έπαθλα. Όταν βρείτε κάποιο τέτοιο όχημα, τότε η αντίστροφη μέτρηση ξεκινά και πάλι από την αρχή."
