msgid "notrecruitedtankman/wt_2024_vonkrieger/label"
msgstr "Waffenträger: Reckoning"

msgid "notrecruitedtankman/wt_CN2024_bmeng/desc"
msgstr "战争是一门艺术，而我则赋予了艺术灵魂！"

