msgid "advanced/gamemodeRandom"
msgstr "Μάχη με αυτόματο ταίριασμα συμπαικτών και αντιπάλων."

msgid "advanced/gamemodeSpecial"
msgstr "Συμμετοχή σε πρωταθλήματα, τουρνουά και μάχες στον Παγκόσμιο Χάρτη."

msgid "advanced/gamemodeStronghold"
msgstr "Μάχες για Βιομηχανικούς Πόρους εναντίον εχθρικών αποσπασμάτων."

msgid "advanced/gamemodeTeam"
msgstr "Μάχη μεταξύ προκαθορισμένων ισοδύναμων ομάδων."

msgid "advanced/gamemodeTraining"
msgstr "Μάχη με επιλογή συμπαικτών και αντιπάλων."

msgid "advanced/grousers"
msgstr "Αυξάνει την ταχύτητα περιστροφής του οχήματος. Μειώνει την απώλεια της επιτάχυνσης σε κάθε τύπο εδάφους."

msgid "advanced/gunner"
msgstr "Επηρεάζει τις ταχύτητες στόχευσης, περιστροφής πυργίσκου και πυροβόλου."

msgid "advanced/handExtinguishers"
msgstr "Σβήνει τη φωτιά στο όχημά σας όταν επιλεχθεί."

msgid "advanced/header/shellType/ARMOR_PIERCING"
msgstr "Βλήμα Armor-Piercing"

msgid "advanced/header/shellType/ARMOR_PIERCING_CR"
