msgid "Pz38t_Standardketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. A"

msgid "Pz38t_Vetstaerktketten"
msgstr "Pz.Kpfw. 38 (t) Ausf. E"

msgid "Pz38t_descr"
msgstr "Κατασκευάστηκε από την εταιρία ČKD για λογαριασμό του Τσεχοσλοβάκικου Στρατού το 1938. Κατά τη διάρκεια της Γερμανικής κατοχής, το όχημα τέθηκε στη υπηρεσία της Wehrmacht και χρησιμοποιήθηκε στις εκστρατείες σε Πολωνία, Γαλλία και στο Ανατολικό Μέτωπο. Έλαβε μέρος σε μάχες μέχρι τα μέσα του 1942. Κατασκευάστηκαν περίπου 1.400 οχήματα σε 8 εκδόσεις (Ausf. A/B/C/D/E/F/S/G)."

msgid "Pz38t_short"
msgstr "Pz. 38 (t)"

