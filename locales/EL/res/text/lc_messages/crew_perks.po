msgid "gunner_smoothTurret/maxLvlDescription"
msgstr "Όταν φτάσει στο 100%, θα μειώσει τη {greenBright_Start}διασπορά των πυρών{greenBright_End} όταν περιστρέφεται ο πυργίσκος κατά %(turretAimingDispersion)s&zwnbsp;."

