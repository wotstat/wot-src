msgid "gunner_loneWolf/maxLvlDescription"
msgstr "Όταν φτάσει στο 100%, θα μειώσει την {yellow_Start}διασπορά των πυρών{yellow_End} και θα αυξήσει την {yellow_Start}ταχύτητα στόχευσης{yellow_End} κατά %(vehicleGunAimSpeed)s όταν δεν υπάρχει όχημα της ίδιας ομάδας σε ακτίνα 300 μέτρων."

msgid "gunner_loneWolf/name"
msgstr "Μοναχικός Λύκος"

msgid "gunner_loneWolf/shortDescription"
