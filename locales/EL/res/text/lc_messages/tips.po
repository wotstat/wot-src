msgid "battlePassSeasonDescription"
msgstr "ΝΕΕΣ ΘΕΜΑΤΙΚΕΣ ΤΕΧΝΟΤΡΟΠΙΕΣ 3D"

msgid "beCareful"
msgstr "Να Είστε Προσεκτικός"

msgid "comp7Core10"
msgstr "Μπορείτε να αλλάξετε όχημα κατά τη φάση προετοιμασίας της μάχης."

msgid "comp7Core10Status"
msgstr "Προετοιμασία Μάχης"

msgid "comp7Core11"
msgstr "Κατά την προετοιμασίας της μάχης, ανεφοδιάστε τα οχήματά σας και ετοιμάστε τα πληρώματά σας."

msgid "comp7Core11Status"
msgstr "Προετοιμασία Μάχης"

msgid "comp7Core12"
msgstr "Όταν επιλέξετε το όχημά σας, ενημερώστε τους συμπαίκτες σας για την επιλογή σας κάνοντας κλικ στο Επικύρωση Επιλογής."

msgid "comp7Core12Status"
msgstr "Προετοιμασία Μάχης"

msgid "comp7Core13"
msgstr "Αφότου πατήσετε το Επικύρωση Επιλογής, δεν θα μπορείτε να αλλάξετε όχημα."

msgid "comp7Core13Status"
msgstr "Επικυρώστε Την Επιλογή Σας"

msgid "comp7Core14"
msgstr "Καταλάβετε σημαντικά σημεία στο πεδίο της μάχης για να έχετε πλεονέκτημα, αποκτώντας πρόσβαση στις Στρατηγικές Ικανότητες!"

msgid "comp7Core14Status"
msgstr "Σημεία-Κλειδιά"

msgid "comp7Core15"
msgstr "Ένα Σημείο-Κλειδί. Εάν καταλάβετε το σημείο αυτό, θα αποκτήσετε πρόσβαση στην Στρατηγική Ικανότητα \"Ραντάρ Μεραρχίας\". Όταν ενεργοποιήσετε τη συγκεκριμένη ικανότητα, όλα τα εχθρικά οχήματα θα παραμείνουν εντοπισμένα για αρκετά δευτερόλεπτα."

msgid "comp7Core15Status"
msgstr "Κέντρο Διαβιβάσεων"

msgid "comp7Core16"
msgstr "Ένα Σημείο-Κλειδί. Εάν καταλάβετε το σημείο αυτό, θα αποκτήσετε πρόσβαση στην Στρατηγική Ικανότητα \"Μπαράζ Πυροβολικού\". Όταν ενεργοποιήσετε τη συγκεκριμένη ικανότητα, ένα μπαράζ πυροβολικού θα πλήξει την επιλεγμένη περιοχή."

msgid "comp7Core16Status"
msgstr "Αρχηγείο Πυροβολικού"

msgid "comp7Core17"
msgstr "Εάν το Μπαράζ Πυροβολικού χτυπήσει οχήματα συμπαικτών, δεν θα λάβουν φθορά, αλλά θα προκληθεί σοκ σε αυτά."

msgid "comp7Core17Status"
msgstr "Μπαράζ Πυροβολικού"

msgid "comp7Core18"
msgstr "Σημείωση: Οι χάρτες σε αυτό το είδος μάχης μπορεί να διαφέρουν από τους αντίστοιχους χάρτες που θα βρείτε στις Τυχαίες Μάχες."

msgid "comp7Core18Status"
msgstr "Χάρτες Διοργάνωσης"

msgid "comp7Core19"
msgstr "Η δημιουργία ενός Ουλαμού 7 παικτών μπορεί να αυξήσει τις πιθανότητές σας για νίκη."

msgid "comp7Core19Status"
msgstr "Η Ομαδικότητα Είναι Το Κλειδί"

msgid "comp7Core21"
msgstr "Μπορείτε να τσεκάρετε το επίπεδο των Ικανοτήτων Ρόλου των συμπαικτών σας με τα πλήκτρα Tab ή Alt."

msgid "comp7Core21Status"
msgstr "Ικανότητες Ρόλου Συμπαικτών"

msgid "comp7Core22"
msgstr "Από τη λίστα των ομάδων, μπορείτε να δείτε τις Στρατηγικές Ικανότητες που έχουν αποκτήσει οι συμπαίκτες σας. Οι Στρατηγικές Ικανότητες των αντιπάλων δεν εμφανίζονται."

msgid "comp7Core22Status"
msgstr "Στρατηγικές Ικανότητες"

msgid "comp7Core23"
msgstr "Εάν μία Ικανότητα Ρόλου επηρεάζει ένα όχημα, τότε αυτό το όχημα θα έχει μία ειδική σήμανση επάνω από το όνομα του παίκτη."

msgid "comp7Core23Status"
msgstr "Επιρροή Ικανότητας Ρόλου"

msgid "comp7Core24"
msgstr "Με την προκαθορισμένη επιλογή του πλήκτρου H ενεργοποιείται η φωνητική συνομιλία. Αξιοποιήστε αυτήν τη λειτουργία για να έχετε καλύτερη συνεργασία με την ομάδα σας."

msgid "comp7Core24Status"
msgstr "Φωνητική Συνομιλία"

msgid "comp7Core25"
msgstr "Εάν αντιμετωπίζετε κάποιο πρόβλημα με τη φωνητική συνομιλία, ελέγξτε τις ρυθμίσεις του client."

msgid "comp7Core25Status"
msgstr "Φωνητική Συνομιλία"

msgid "comp7Core29"
msgstr "Με το πλήκτρο Alt, ο ρόλος του κάθε οχήματος μέσα στο εύρος ορατότητάς σας, θα εμφανιστεί επάνω από το όνομα του παίκτη. Στους συμπαίκτες σας, θα εμφανίζεται και το επίπεδο της Ικανότητας Ρόλου."

msgid "comp7Core29Status"
msgstr "Ρόλοι Οχημάτων"

msgid "comp7Core31"
msgstr "Από τις ρυθμίσεις του παιχνιδιού, μπορείτε να αλλάξετε τα πλήκτρα των Ικανοτήτων Ρόλου και των Στρατηγικών Ικανοτήτων."

msgid "comp7Core31Status"
msgstr "Ρυθμίσεις Χειρισμών"

msgid "comp7Core32"
msgstr "Μετά από ένα συγκεκριμένο χρονικό διάστημα, μπορείτε να ανακαταλάβετε ένα Σημείο-Κλειδί."

msgid "comp7Core32Status"
msgstr "Σημεία-Κλειδιά"

msgid "comp7Core33"
msgstr "Δεν μπορείτε να καταλάβετε ένα Σημείο-Κλειδί μέχρι να χρησιμοποιήσετε την αντίστοιχη Στρατηγική Ικανότητα."

msgid "comp7Core33Status"
msgstr "Σημεία-Κλειδιά"

msgid "comp7Core34"
msgstr "Όταν καταλαμβάνετε Σημεία-Κλειδιά, κερδίζετε Πόντους Αίγλης."

msgid "comp7Core34Status"
msgstr "Σημεία-Κλειδιά"

msgid "comp7Core35"
msgstr "Διαβάστε τους κανόνες της διοργάνωσης για να μάθετε περισσότερα για τους Πόντους Αίγλης."

msgid "comp7Core35Status"
msgstr "Πόντοι Αίγλης"

msgid "comp7Core37"
msgstr "Σε αυτό το είδος μάχης έχουν αλλάξει παράμετροι των οχημάτων, όπως η αντοχή, ο χρόνος επαναφοράς των αναλώσιμων, ο χρόνος που ένα όχημα παραμένει εντοπισμένο, κλπ."

msgid "comp7Core37Status"
msgstr "Χαρακτηριστικά Μάχης"

msgid "comp7Core5"
msgstr "Ανάλογα με τον ρόλο του στη μάχη, το κάθε όχημα έχει μία μοναδική ικανότητα, τριών επιπέδων. Όσο μεγαλύτερο το επίπεδο της ικανότητας, τόσο μεγαλύτερη η επίδρασή της όταν ενεργοποιηθεί."

msgid "comp7Core5Status"
msgstr "Σχετικά Με Τις Ικανότητες Ρόλου"

msgid "comp7Core6"
msgstr "Τους Πόντους Αίγλης τους κερδίζετε με βάση τις επιδόσεις σας στη μάχη, από την κατάληψη Σημείων-Κλειδιών, από τη χρήση ικανοτήτων, κλπ."

msgid "comp7Core6Status"
msgstr "Πόντοι Αίγλης"

msgid "comp7Core8"
msgstr "Οι παίκτες δεν έχουν πρόσβαση σε πληροφορίες σχετικές με τους αντιπάλους τους, μέχρι τα οχήματα των αντιπάλων να εντοπιστούν στη μάχη."

msgid "comp7Core8Status"
msgstr "Fog of War"

msgid "comp7Light7"
msgstr "Μάθετε περισσότερα για τις μάχες Ελαφράς Επέλασης από το link: ΣΧΕΤΙΚΑ ΜΕ ΤΗ ΔΙΟΡΓΑΝΩΣΗ."

msgid "comp7Light7Status"
msgstr "Λεπτομέρειες"

msgid "comp7Light9"
msgstr "Έχοντας στο οπλοστάσιό σας οχήματα διαφορετικών ρόλων της Βαθμίδας VIII, μπορείτε να επιλέξετε κάθε φορά το καταλληλότερο με βάση τον χάρτη και τη σύσταση της ομάδας σας."

msgid "comp7Light9Status"
msgstr "Επέκταση Γκαράζ"

msgid "comp7Ranked0"
msgstr "Μπείτε στη μάχη για να μαζέψετε Πόντους Κατάταξης και να δείξετε την ανωτερότητά σας."

msgid "comp7Ranked0Status"
msgstr "Σύστημα Κατάταξης"

msgid "comp7Ranked1"
msgstr "Όσους περισσότερους Πόντους Αίγλης κερδίζετε σε μία μάχη, τόσους περισσότερους Πόντους Κατάταξης θα λάβετε σε νίκη και τόσους λιγότερους να χάσετε σε ήττα."

msgid "comp7Ranked1Status"
msgstr "Πόντοι Αίγλης & Πόντοι Κατάταξης"

msgid "comp7Ranked2"
msgstr "Στις μάχες Επέλασης, οι ομάδες συγκροτούνται από παίκτες παρόμοιας δυναμικότητας."

msgid "comp7Ranked20"
msgstr "Εγκατάλειψη της μάχης πριν από το τέλος της ή πριν καταστραφεί το όχημά σας θεωρείται λιποταξία και μπορεί να σας επιβληθεί πειθαρχική ποινή, όπως προσωρινός αποκλεισμός και αφαίρεση Πόντων Κατάταξης."

msgid "comp7Ranked20Status"
msgstr "Λιποταξία"

msgid "comp7Ranked26"
msgstr "Μόνο οι παίκτες με τον βαθμό του Πρωταθλητή και του Θρύλου θα εμφανίζονται στον Πίνακα Κατάταξης. Όλοι οι παίκτες που καταλαμβάνουν μία θέση στον Πίνακα Κατάταξης θα κερδίζουν ημερήσια έπαθλα."

msgid "comp7Ranked26Status"
msgstr "Πίνακας Κατάταξης"

msgid "comp7Ranked27"
msgstr "Όσοι διαπράττουν λιποταξία θα αποκλείονται προσωρινά από το συγκεκριμένο είδος μάχης. Η διάρκεια του αποκλεισμού θα μεγαλώνει σε κάθε ακόλουθη παράβαση."

msgid "comp7Ranked27Status"
msgstr "Προσωρινός Αποκλεισμός"

msgid "comp7Ranked28"
msgstr "Λάβετε μέρος σε μάχες αυτού του είδους για να ξεκλειδώσετε νέα στοιχεία την προοδευτικής τεχνοτροπίας των μαχών Επέλασης."

msgid "comp7Ranked28Status"
msgstr "Προοδευτική Τεχνοτροπία"

msgid "comp7Ranked2Status"
msgstr "Οι Καλύτεροι Παίκτες"

msgid "comp7Ranked3"
msgstr "Ο βαθμός του Θρύλου απονέμεται μόνο στους καλύτερους των καλύτερων. Για να σας απονεμηθεί ο βαθμός αυτός, πρέπει να καταλάβετε μία θέση ανάμεσα στο 10% των κορυφαίων παικτών του Πίνακα Κατάταξης με βάση τους κερδισμένους Πόντους Κατάταξης."

msgid "comp7Ranked36"
msgstr "Να θυμάστε: Εάν εγκαταλείψετε τη μάχη πριν από το τέλος της ή πριν καταστραφεί το όχημά σας, θα χάσετε περισσότερους Πόντους Κατάταξης από όσους θα χάνατε σε μία φρικτή ήττα."

msgid "comp7Ranked36Status"
msgstr "Λιποταξία"

msgid "comp7Ranked3Status"
msgstr "Θρύλος"

msgid "comp7Ranked4"
msgstr "Εάν σταματήσετε να λαμβάνετε μέρος σε μάχες Επέλασης έχοντας τον βαθμό του Αργυρού, του Χρυσού, του Πρωταθλητή και του Θρύλου, θα χάσετε Πόντους Κατάταξης."

msgid "comp7Ranked4Status"
msgstr "Αδράνεια"

msgid "comp7Ranked7"
msgstr "Μάθετε περισσότερα για τις μάχες Επέλασης από το link ΣΧΕΤΙΚΑ ΜΕ ΤΗ ΔΙΟΡΓΑΝΩΣΗ."

msgid "comp7Ranked7Status"
msgstr "Λεπτομέρειες"

msgid "comp7Ranked9"
msgstr "Έχοντας στο οπλοστάσιό σας οχήματα διαφορετικών ρόλων της Βαθμίδας X, μπορείτε να επιλέξετε κάθε φορά το καταλληλότερο με βάση τον χάρτη και τη σύσταση της ομάδας σας."

msgid "comp7Ranked9Status"
msgstr "Επέκταση Γκαράζ"

msgid "devMaps0"
msgstr "Η τοποθεσία των τυχαίων γεγονότων θα σημειώνεται\nμε καπνούς μέσα στο πεδίο της μάχης και με ειδική σήμανση στο minimap.\nΟι χάρτες με τυχαία γεγονότα μπορούν να απενεργοποιηθούν μέσα από την καρτέλα Γενικά των ρυθμίσεων του παιχνιδιού."

msgid "devMaps0Status"
msgstr "Χάρτες Με Τυχαία Γεγονότα"

msgid "devMaps1"
msgstr "Το όχημά σας μπορεί να καταστραφεί αν παραμείνει στην περιοχή ενός τυχαίου γεγονότος (για παράδειγμα, από πτώση αεροπλάνου).\nΟι χάρτες με τυχαία γεγονότα μπορούν να απενεργοποιηθούν μέσα από την καρτέλα Γενικά των ρυθμίσεων του παιχνιδιού."

msgid "devMaps1Status"
msgstr "Χάρτες Με Τυχαία Γεγονότα"

msgid "dualGunVehicles"
msgstr "Οχήματα με διπλό πυροβόλο"

msgid "epicModeHiddenFeatures"
msgstr "Βετεράνος Πρώτης Γραμμής"

msgid "epicModeIntroduction"
msgstr "Χαρακτηριστικά Στοιχεία"

msgid "epicModeUseful"
msgstr "Μάθετε για την Πρώτη Γραμμή"

msgid "epicRandom0"
msgstr "Μπορεί να έχετε μικρή πτώση στις επιδόσεις του συστήματός σας σε αυτόν τον τύπο μάχης."

msgid "epicTip1"
msgstr "Όταν καταληφθεί μία βάση, όλα τα οχήματα της αμυνόμενης ομάδας που παραμένουν στη ζώνη γίνονται στόχοι βομβαρδισμού."

msgid "epicTip10"
msgstr "Εκτός από δόξα και φήμη, οι βαθμοί σας δίνουν και χρήσιμα μπόνους μετά από κάθε μάχη."

msgid "epicTip11"
msgstr "Στις μάχες της Πρώτης Γραμμής υπάρχουν πολλοί νέοι τρόποι για να κερδίσετε XP και credits."

msgid "epicTip12"
msgstr "Το μέτωπο της μάχης μπορεί να μετακινηθεί εξωθώντας την αντίπαλη ομάδα προς τα πίσω. Έτσι, η επανεκκίνηση θα γίνεται πλησιέστερα στους κύριους στόχους."

msgid "epicTip13"
msgstr "Όταν ένα όχημα μέσα στον κύκλο κατάληψης δεχθεί φθορά, η πρόοδος της κατάληψης γι αυτό το όχημα παρεμποδίζεται για κάποιο χρονικό διάστημα."

msgid "epicTip14"
msgstr "Ενεργοποιήστε και βελτιώστε τις Εφεδρείες σας από την αντίστοιχη οθόνη. Χρησιμοποιήστε τις για να γίνετε πιο αποτελεσματικοί στη μάχη."

msgid "epicTip15"
msgstr "Μπορείτε να αλλάξετε μέτωπο από την οθόνη Επανεκκίνησης εάν το επιβάλει η στρατηγική σας."

msgid "epicTip16"
msgstr "Μην εισέρχεστε σε προστατευόμενες ζώνες. Το εχθρικό πυροβολικό θα αρχίσει να βάλει εναντίον σας."

msgid "epicTip17"
msgstr "Εάν κολλήσατε σε κάποιο σημείο του χάρτη, χρησιμοποιήστε τη δυνατότητα εγκατάλειψης του οχήματος (προκαθορισμένα με το J) για να ξεκινήσετε και πάλι τη μάχη με νέο όχημα."

msgid "epicTip18"
msgstr "Ανοίξτε έναν μεγαλύτερο χάρτη (προκαθορισμένα με το Μ) για να έχετε καλύτερη αντίληψη του πεδίου της μάχης."

msgid "epicTip19"
msgstr "Θα έχετε επικοινωνία μόνο με τους συμπαίκτες που βρίσκονται στο ορατό σημείο του χάρτη."

msgid "epicTip2"
msgstr "Οι μάχες στην Πρώτη Γραμμή προσφέρουν μεγάλα έπαθλα σε όσους ψάχνουν το κάτι παραπάνω."

msgid "epicTip20"
msgstr "Μπορείτε να προσαρμόσετε την ορατή περιοχή στο minimap με τον τροχό του ποντικιού σας, ενώ έχετε το κέρσορα του ποντικιού σας πάνω σε αυτό."

msgid "epicTip21"
msgstr "Μπορείτε να υποδείξετε βάσεις και κύριους στόχους στους συμπαίκτες σας κάνοντας κλικ πάνω τους."

msgid "epicTip22"
msgstr "Όταν σας τελειώσουν τα διαθέσιμα οχήματα χρησιμοποιήστε την Ελεύθερη Κάμερα, για να χαράξετε τη στρατηγική σας μέχρι να ξαναγυρίσετε στη μάχη."

msgid "epicTip23"
msgstr "Όταν γίνεται κατάληψη μίας βάσης και ο χρόνος της μάχης τελειώσει, τότε η μάχη πάει σε παράταση και συνεχίζεται μέχρι όλες οι βάσεις να είναι καθαρές."

msgid "epicTip3"
msgstr "Στις μάχες Πρώτης Γραμμής, το πεδίο της μάχης έχει έκταση 9 km², το οποίο είναι 9 φορές μεγαλύτερο από τα κανονικά πεδία μάχης."

msgid "epicTip4"
msgstr "Ο διαθέσιμος χρόνος αυξάνεται κάθε φορά που μία ζώνη καταλαμβάνεται. Η τελευταία ζώνη δίνει πρόσθετο χρόνο."

msgid "epicTip5"
msgstr "Εάν το όχημά σας καταστραφεί στη μάχη, χρειάζεται κάποιον χρόνο για να επισκευαστεί. Επιλέξτε άλλο όχημα και ξαναμπείτε στη μάχη."

msgid "epicTip6"
msgstr "Ένα νέο όχημα προστίθεται στα εφεδρικά σας κάθε 5 λεπτά."

msgid "epicTip7"
msgstr "Οι επιτιθέμενοι μπορούν να εισέλθουν στη δεύτερη γραμμή μία ζώνης μόλις καταληφθεί η πρώτη γραμμή στο ίδιο μέτωπο."

msgid "epicTip8"
msgstr "Όταν γίνει κατάληψη όλων των ζωνών της πρώτης γραμμής τότε όλες οι ζώνες της δεύτερης γραμμής εξασθενούν."

msgid "epicTip9"
msgstr "Είναι δυνατόν να κερδίσετε καταστρέφοντας όλα τα εχθρικά οχήματα αλλά είναι απίθανο."

msgid "eventMessage"
msgstr "++++ eventMessage ++++"

msgid "eventTitle"
msgstr "++++ eventTitle ++++"

msgid "followTheRules"
msgstr "Ακολουθήστε τους Κανόνες"

msgid "howToPlay"
msgstr "Πως να Παίξετε"

msgid "mapbox0"
msgstr "Τα οχήματα εντός μιας ζώνης με τοπικά καιρικά φαινόμενα δεν μπορούν να εντοπίζουν οχήματα εκτός της ζώνης, να εντοπίζονται από οχήματα εκτός ζώνης, καθώς και να ανταλλάξουν πληροφορίες για τις θέσεις των εχθρικών οχημάτων έξω από τη ζώνη. Η φωτιά προκαλεί φθορά στα οχήματα."

msgid "mapbox0Status"
msgstr "Τοπικά Καιρικά Φαινόμενα"

msgid "payAttention"
msgstr "Προσοχή"

msgid "ranked1"
msgstr "Κερδίζετε περισσότερο experience όταν παίζετε σωστά τον ρόλο του οχήματός σας! Η περιγραφή του ρόλου των οχημάτων στη μάχη και των ενεργειών που τον υπηρετούν, είναι διαθέσιμη από την ενημερωτική σελίδα Πληροφορίες Μάχης στο Γκαράζ."

msgid "ranked10"
msgstr "Μέσα από την πρόοδό σας στις Μάχες Κατάταξης θα μπορείτε να ανταλλάξετε bonds (και με έκπτωση) για να αποκτήσετε μοναδικά οχήματα και στοιχεία προσαρμογής. Για να δείτε τη λίστα των αντικειμένων αυτών, κάντε κλικ στο αντίστοιχο banner.\nΔεν είναι δυνατή η πρόσβαση σε αυτά τα αντικείμενα όταν δεν διεξάγονται Μάχες Κατάταξης."

msgid "ranked11"
msgstr "Τα ημερήσια Μπόνους Μάχης είναι διαθέσιμα μόνο στις Λίγκες. ΤΑ αποκτάτε με βάση τις επιδόσεις σας στα Προκριματικά και από την ολοκλήρωση ειδικών αποστολών. Τα ημερήσια Μπόνους Μάχης δεν μεταφέρονται στην επόμενη ημέρα."

msgid "ranked12"
msgstr "Στο τέλος της χρονιάς, οι πιο αποτελεσματικοί παίκτες θα μπουν στον Πίνακα Κατάταξης. Θα λάβουν ένα ειδικό παράσημο και θα λαμβάνουν την αναγνώριση της κοινότητας των παικτών."

msgid "ranked13"
msgstr "Μερικές Θέσεις Κατάταξης είναι μόνιμες. Μόλις τις καταλάβετε δεν μπορεί να τις χάσετε με κανέναν τρόπο. Οι ενδιάμεσες μόνιμες Θέσεις Κατάταξης έχουν ειδική σήμανση. Όλες οι αρχικές Θέσεις σε κάθε Κατηγορία είναι επίσης μόνιμες και δεν μπορεί να χαθούν."

msgid "ranked2"
msgstr "Κερδίζετε κανονικά και ημερήσια Μπόνους Μάχης από την ολοκλήρωση κάθε Κατηγορίας και Λίγκας. Ένα Μπόνους Μάχης αυτομάτως διπλασιάζει τα κερδισμένα γαλόνια από τη μάχη, ενώ δεν ξοδεύεται σε περίπτωση αποτυχίας. Μόνο 1 Μπόνους Μάχης ανά ημέρα είναι διαθέσιμο για κάθε όχημα της Βαθμίδας X."

msgid "ranked3"
msgstr "Να γνωρίζετε την Ώρα Διεξαγωγής των μαχών: εάν τελειώσουν οι Μάχες Κατάταξης θα είναι ξανά διαθέσιμες την επόμενη ημέρα και θα λάβετε σχετική ειδοποίηση."

msgid "ranked4"
msgstr "Μερικές Θέσεις έχουν ασπίδα. Αυτό σημαίνει ότι σε περίπτωση ήττας δεν χάνετε τη Θέση αλλά εξασθενεί η ασπίδα. Όταν όμως κερδίζετε γαλόνι σε Θέση που έχει ασπίδα, ενώ η ασπίδα δεν έχει εξαντληθεί εντελώς, γίνεται πλήρης επαναφορά της δύναμης της ασπίδας."

msgid "ranked5"
msgstr "Μην τα παρατάτε ποτέ! Γαλόνι δεν κερδίζουν μόνο οι 7 καλύτεροι παίκτες της νικήτριας ομάδας, αλλά και οι καλύτεροι παίκτες της χαμένης ομάδας. Να θυμάστε ότι κάθε κερδισμένο γαλόνι διπλασιάζεται με Μπόνους Μάχης."

msgid "ranked6"
msgstr "Αφού ολοκληρώσουν όλες τις Κατηγορίες, οι παίκτες φτάνουν στις Λίγκες. Υπάρχει η Χρυσή, η Ασημένια και η Χάλκινη Λίγκα. Η συνέχιση των μαχών και τα αποτελέσματά τους καθορίζουν τη θέση στον Πίνακα Κατάταξης."

msgid "ranked7"
msgstr "Οι παίκτες κερδίζουν 1 Token Θέσης κάθε φορά που ολοκληρώνουν μία Κατηγορία. Οι παίκτες με τις συνολικά καλύτερες επιδόσεις από 3 Περιόδους θα κερδίσουν τα τελικά έπαθλα."

msgid "ranked8"
msgstr "Στο τέλος της Περιόδου, οι καλύτεροι παίκτες θα κερδίσουν ένα μοναδικό παράσημο και ένα καμουφλάζ για τα οχήματά τους. Τα έπαθλα αυτά συμβολίζουν τις απαράμιλλες δεξιότητές τους στη μάχη."

msgid "ranked9"
msgstr "Κερδίζετε bonds από τα επιτεύγματά σας στις Μάχες Κατάταξης. Μπορείτε να ανταλλάξετε τα bonds για οδηγίες και βελτιωμένο εξοπλισμό. Επίσης, υπάρχουν και άλλα πολύτιμα έπαθλα: credits, αναλώσιμα, κλπ."

msgid "rankedStatus1"
msgstr "Experience για συμμόρφωση με τον ρόλο του οχήματος"

msgid "rankedStatus10"
msgstr "Αντικείμενα Μαχών Κατάταξης"

msgid "rankedStatus11"
msgstr "Ημερήσια Μπόνους Μάχης"

msgid "rankedStatus12"
msgstr "Κορυφαίοι Παίκτες της Χρονιάς"

msgid "rankedStatus13"
msgstr "Κανόνες Μάχης"

msgid "rankedStatus2"
msgstr "Μπόνους Μάχης"

msgid "rankedStatus3"
msgstr "Ώρα Διεξαγωγής"

msgid "rankedStatus4"
msgstr "Κανόνες Μάχης"

msgid "rankedStatus5"
msgstr "Κανόνες Μάχης"

msgid "rankedStatus6"
msgstr "Μάχες σε Λίγκα"

msgid "rankedStatus7"
msgstr "Ετήσια Έπαθλα"

msgid "rankedStatus8"
msgstr "Έπαθλα Στο Τέλος Της Περιόδου"

msgid "rankedStatus9"
msgstr "Έπαθλα Θέσεων"

msgid "security"
msgstr "Η Ασφάλεια Πάνω Από Όλα"

msgid "technicalAdvice"
msgstr "Τεχνική Συμβουλή"

msgid "tip0"
msgstr "Το βαλτώδες έδαφος μειώνει την ταχύτητα του οχήματος και την ταχύτητα περιστροφής."

msgid "tip100"
msgstr "Το μπόνους επιδόσεων κάποιου μέλους του πληρώματος επηρεάζει τα αντίστοιχα χαρακτηριστικά του οχήματος."

msgid "tip101"
msgstr "Η Έκτη Αίσθηση κάνει τον Αρχηγό Πληρώματος ικανό να αντιλαμβάνεται πότε το όχημα έχει εντοπιστεί από τον εχθρό."

msgid "tip102"
msgstr "Η επίδραση ικανοτήτων είναι μία παράμετρος που επηρεάζει όλες τις ικανότητες που κατέχει ένα μέλος του πληρώματος."

msgid "tip103"
msgstr "Μπορείτε να αλλάξετε την ειδικότητα ενός μέλους του πληρώματος κατά την επανεκπαίδευση του."

msgid "tip106"
msgstr "Ο εξοπλισμός βελτιώνει την αποτελεσματικότητα του πληρώματος και τα χαρακτηριστικά του οχήματος."

msgid "tip107"
msgstr "Οχήματα στα οποία έχουν ανακαλυφθεί όλα τα εξαρτήματα όλοι οι κλάδοι τεχνολογίας γίνονται Επίλεκτα."

msgid "tip108"
msgstr "Το κερδισμένο Combat Experience από Επίλεκτα οχήματα, συμπεριλαμβανομένων και των Προνομιακών οχημάτων, μπορεί να μετατραπεί σε Free Experience."

msgid "tip11"
msgstr "Χρησιμοποιήστε τους θάμνους και τα φυλλώματα έτσι ώστε οι αντίπαλοι να ανιχνεύουν δυσκολότερα το αντιαρματικό σας. Να θυμάστε ότι οχήματα που δεν κινούνται εντοπίζονται δυσκολότερα."

msgid "tip111"
msgstr "Μερικές φορές η κατάληψη της βάσης είναι ασφαλέστερος και ευκολότερος τρόπος για να επιτευχθεί η νίκη από το να καταστρέψετε όλους τους αντιπάλους."

msgid "tip114"
msgstr "Είναι παραβίαση των κανονισμών του παιχνιδιού να μοιράζεστε έναν λογαριασμό και μπορεί αν επιφέρει την απαγόρευση πρόσβασης στον λογαριασμό."

msgid "tip115"
msgstr "Οι κανονισμοί του παιχνιδιού απαγορεύουν το να μοιράζεστε λογαριασμούς. Οι παραβάτες μπορεί να χάσουν τους λογαριασμούς τους."

msgid "tip116"
msgstr "Όσο πιο περίπλοκος είναι ο κωδικός σας, τόσο το καλύτερο."

msgid "tip117"
msgstr "Να αλλάζετε τον κωδικό σας συχνά."

msgid "tip118"
msgstr "Οι κανονισμοί του παιχνιδιού απαγορεύουν την αγοροπωλησία λογαριασμών. Οι παραβάτες μπορεί να χάσουν τους λογαριασμούς τους."

msgid "tip119"
msgstr "Μην ακολουθείτε συνδέσμους (links) από άγνωστες ιστοσελίδες. Κινδυνεύετε να σας εξαπατήσουν."

msgid "tip120"
msgstr "Μπορείτε να αγοράσετε gold μόνο από την επίσημη ιστοσελίδα του World of Tanks. Εάν προσπαθήσετε να αγοράσετε gold από άλλες ιστοσελίδες, κινδυνεύετε να χάσετε τα χρήματά σας."

msgid "tip121"
msgstr "Η επιλογή της αποθήκευσης του κωδικού είναι κάτι το βολικό αλλά και λιγότερο ασφαλές."

msgid "tip122"
msgstr "Στο portal μας μπορείτε να βρείτε οδηγίες για το πώς να διατηρείτε τον λογαριασμό σας ασφαλή. Διαβάστε τις οδηγίες προσεκτικά."

msgid "tip123"
msgstr "Μέσα στη μάχη, κρατήστε πατημένο το Ctrl για να εμφανιστεί ο κέρσορας του ποντικιού."

msgid "tip124"
msgstr "Για να επισκευάσετε ένα εξάρτημα, χρησιμοποιήστε το Κουτί Επισκευών. Για να θεραπεύσετε ένα μέλος του πληρώματος, χρησιμοποιήστε Κουτί Πρώτων Βοηθειών."

msgid "tip125"
msgstr "Για χρήση των αναλώσιμων και εναλλαγή μεταξύ διαφορετικών τύπων βλημάτων, χρησιμοποιήστε τα προκαθορισμένα πλήκτρα 1-6."

msgid "tip126"
msgstr "Για να μεταβείτε άμεσα σε κάμερα Πυροβολικού, κάντε δεξί-κλικ στην μικρογραφία του χάρτη."

msgid "tip127"
msgstr "Για αλλαγή του τρόπου εμφάνισης της λίστας των ομάδων, πατήστε Ctrl+Tab."

msgid "tip128"
msgstr "Κάντε δεξί-κλικ στο όνομα ενός παίκτη για προβολή των πιθανών ενεργειών."

msgid "tip129"
msgstr "Για να υποβάλετε ένα παράπονο για έναν παίκτη, κάντε δεξί-κλικ στο όνομά του από το πάνελ της ομάδας και επιλέξτε την αντίστοιχη επιλογή από το μενού."

msgid "tip130"
msgstr "Οι διαθέσιμες εντολές στο Μενού Εντολών αλλάζουν ανάλογα εάν ο κέρσορας είναι πάνω σε συμπαίκτη, σε αντίπαλο, σε αντικείμενο ή στον χάρτη."

msgid "tip131"
msgstr "Για να επιλέξετε κάποια εντολή από το Μενού Εντολών, κρατήστε πατημένο το T ή το Ζ και κινήστε το ποντίκι πάνω στην εντολή που θέλετε."

msgid "tip132"
msgstr "Χρησιμοποιήστε τα πλήκτρα F2–F8 για πιο γρήγορη επιλογή εντολών από το Μενού Εντολών."

msgid "tip134"
msgstr "Με το να είστε αγενής δεν θα πείσετε τους συμπαίκτες σας ότι έχετε δίκαιο. Επιπροσθέτως, δεν επιτρέπεται από τους κανονισμούς."

msgid "tip135"
msgstr "Οι συμπαίκτες σας είναι πιθανότερο να βοηθήσουν έναν ευγενικό παίκτη."

msgid "tip136"
msgstr "Η μάχη διεξάγεται στο πεδίο της μάχης και όχι στη συνομιλία."

msgid "tip137"
msgstr "Μην γράφετε μη-χρήσιμα μηνύματα στη συνομιλία γιατί αποσπάται η προσοχή των παικτών από τη μάχη."

msgid "tip138"
msgstr "Χρησιμοποιήστε την επιλογή Παράπονο όταν παραβιάζονται οι κανονισμοί του παιχνιδιού."

msgid "tip139"
msgstr "Με την προσθήκη παικτών στη Μαύρη Λίστα, σταματάει άμεσα η αποστολή μηνυμάτων και προσκλήσεων από αυτούς προς εσάς."

msgid "tip14"
msgstr "Η αυτόματη στόχευση δεν εξασφαλίζει 100% ευστοχία. Οι έμπειροι παίκτες χρησιμοποιούν την δική τους στόχευση."

msgid "tip140"
msgstr "Η λογοκρισία των μηνυμάτων μπορεί να ενεργοποιηθεί από τις Ρυθμίσεις."

msgid "tip141"
msgstr "Η συνομιλία στη μάχη μπορεί να απενεργοποιηθεί από τις Ρυθμίσεις. Η συνομιλία του Ουλαμού θα παραμείνει ενεργή."

msgid "tip142"
msgstr "Ενώ εσείς μαλώνετε με τους συμπαίκτες σας, οι αντίπαλοι το εκμεταλλεύονται."

msgid "tip143"
msgstr "Παρακολουθείτε συνεχώς την πορεία της μάχης. Ακόμα και ένα λάθος μπορεί να οδηγήσει στη ήττα."

msgid "tip144"
msgstr "Όταν χρησιμοποιείτε απαγορευμένα προγράμματα ή συμμετέχετε σε στημένες μάχες κινδυνεύετε να χάσετε τον λογαριασμό σας αμετάκλητα."

msgid "tip146"
msgstr "Η παραβίαση των κανόνων του παιχνιδιού τιμωρείται και μπορεί αν έχει ως αποτέλεσμα το κλείδωμα του λογαριασμού σας."

msgid "tip147"
msgstr "Εάν σας επιβλήθηκε ποινή για παραβίαση των κανονισμών του παιχνιδιού, σας προτείνουμε να τους ξαναδιαβάσετε έτσι ώστε να αποφύγετε παρόμοιες καταστάσεις στο μέλλον."

msgid "tip148"
msgstr "Οι κανονισμοί του παιχνιδιού αφορούν όλους τους παίκτες καθώς και η ευθύνη για την παραβίασή τους."

msgid "tip149"
msgstr "Δεν μπορείτε να λάβετε μέρος σε μάχη? Απενεργοποιήστε όλα τα mods και κάντε επανεκκίνηση του παιχνιδιού."

msgid "tip150"
msgstr "Έχετε χαμηλά FPS? Δοκιμάστε τη χρήση χαμηλότερης ποιότητας γραφικών από τις ρυθμίσεις."

msgid "tip151"
msgstr "Έχετε χαμηλά FPS και διαστρέβλωση γραφικών? Προσπαθήστε να ενημερώσετε τους drivers της κάρτας γραφικών σας."

msgid "tip152"
msgstr "Έχετε μεγάλη καθυστέρηση όταν συνδέεστε μέσω 3G ή Wi-Fi? Δοκιμάστε να συνδεθείτε μέσω ενσύρματης σύνδεσης."

msgid "tip153"
msgstr "Το όχημά σας μεταφέρεται απότομα σε άλλο σημείο του χάρτη και πυροβολεί με καθυστέρηση? Ελέγξτε τη σύνδεση του δικτύου σας."

msgid "tip154"
msgstr "Αξιόπιστα προγράμματα antivirus εγγυώνται τη σταθερή λειτουργία του συστήματός σας και του παιχνιδιού."

msgid "tip155"
msgstr "Η ομάδα σας δεν σας ακούει στη μάχη? Ελέγξτε τις ρυθμίσεις της φωνητικής επικοινωνίας."

msgid "tip156"
msgstr "Όσο πιο λεπτομερή περιγραφή παρέχετε στην Υποστήριξη Παικτών, τόσο πιο γρήγορα θα δοθεί λύση στο πρόβλημά σας."

msgid "tip157"
msgstr "Πριν την επικοινωνία σας με την Υποστήριξη Παικτών, σιγουρευτείτε ότι το πρόβλημα παραμένει με απενεργοποιημένα τα mods του παιχνιδιού."

msgid "tip158"
msgstr "Η προσθήκη του κινητού σας τηλεφώνου στο λογαριασμό σας τον κάνει πιο ασφαλή ενάντια σε πιθανό hacking."

msgid "tip159"
msgstr "Σιγουρευτείτε ότι το κινητό τηλέφωνο που δηλώσατε στον λογαριασμό σας είναι ενεργοποιημένο για γρηγορότερη αποκατάσταση της πρόσβασης σε αυτόν."

msgid "tip160"
msgstr "Η σύνδεση του κινητού σας τηλεφώνου με τον λογαριασμό, σας επιτρέπει να αλλάξετε το email με το οποίο δημιουργήσατε τον λογαριασμό."

msgid "tip161"
msgstr "Εάν υποπτεύεστε ότι κάποιος που άλλος μπήκε στον λογαριασμό σας, επικοινωνήστε άμεσα με τη Υπηρεσία Εξυπηρέτησης Πελατών."

msgid "tip162"
msgstr "Μην αποδέχεστε δώρα από άγνωστους σε εσάς χρήστες."

msgid "tip163"
msgstr "Επιλέξτε τον κατάλληλο τομέα της Υποστήριξης Παικτών για να εξασφαλίσετε την γρήγορη εξυπηρέτησή σας."

msgid "tip164"
msgstr "Ένας έμπειρος χειριστής πυροβολικού μπορεί να ανιχνεύσει τα Α/Κ Πυροβόλα των αντιπάλων που δεν αλλάζουν θέση από τα ίχνη των βολών τους."

msgid "tip165"
msgstr "Οι Αυτόματοι Πυροσβεστήρες σβήνουν την φωτιά άμεσα και μειώνουν την πιθανότητα να πάρει φωτιά ο κινητήρας."

msgid "tip166"
msgstr "Όταν παίζετε με πυροβολικό, να γνωρίζεται την τροχιά και την ταχύτητα του βλήματος καθώς και τις ιδιαιτερότητες του χάρτη."

msgid "tip167"
msgstr "Πάντα να γνωρίζετε που βρίσκονται οι συμπαίκτες και οι αντίπαλοι, από τη Μικρογραφία του Χάρτη."

msgid "tip168"
msgstr "Η ρίψη πυρών ενώ ανιχνεύετε αντιπάλους θα αποκαλύψει τη θέση σας. Να γνωρίζετε ότι κερδίζετε experience και credits και από τον εντοπισμό αντιπάλων."

msgid "tip169"
msgstr "Χρησιμοποιήστε το Κουτί Επισκευών για να επισκευάσετε γρήγορα τις ερπύστριές σας. Όταν το όχημά σας μπορεί να κινηθεί, προσπαθήστε να αποφύγετε τα εχθρικά πυρά."

msgid "tip17"
msgstr "Ένας στόχος με καλή θωράκιση που δεν μπορεί να νικηθεί με βλήματα Armor Piercing μπορεί να είναι ευάλωτος σε βλήματα High-Explosive."

msgid "tip170"
msgstr "Όπως και οι θάμνοι, έτσι και τα πεσμένα δέντρα κρύβουν το όχημά σας."

msgid "tip171"
msgstr "Μεγάλοι βράχοι και βαθιά χαντάκια μπορεί να ακινητοποιήσουν το όχημά σας."

msgid "tip173"
msgstr "Μπορείτε να μεταφέρετε πλήρωμα σε Προνομιακό όχημα του ιδίου έθνους και τύπου χωρίς να απαιτείται επανεκπαίδευση."

msgid "tip174"
msgstr "Τα τραυματισμένα μέλη πληρώματος έχουν μειωμένη απόδοση στη μάχη."

msgid "tip176"
msgstr "Για να λάβει το δώρο σας ο παραλήπτης, θα πρέπει να συνδεθεί στην Διαχείριση Λογαριασμού του."

msgid "tip177"
msgstr "Δεν πρέπει να επιδοκιμάζονται η φθορά και η καταστροφή συμπαικτών, σε καμία περίπτωση."

msgid "tip178"
msgstr "Συμβουλευτείτε την Υποστήριξη Παικτών για να διευκρινίσετε τους λόγους αναστολής του λογαριασμού σας."

msgid "tip179"
msgstr "Πριν επικοινωνήσετε με την Υποστήριξη Παικτών για χαμένα οχήματα, σιγουρευτείτε ότι έχετε απενεργοποιήσει τα φίλτρα των οχημάτων στο Γκαράζ."

msgid "tip180"
msgstr "Μπορείτε να καθορίσετε την ένταση των ήχων από τη μπάρα της Γενικής Έντασης ή αλλάζοντας την ένταση ήχου του συστήματός σας."

msgid "tip181"
msgstr "Επιλέξτε συσκευή ήχου—\"Σύστημα Ήχου 2.0/2.1\" ή \"Ακουστικά\"—από τις ρυθμίσεις ήχου για καλύτερη απόδοση των ήχων."

msgid "tip182"
msgstr "Για καλύτερη απόδοση σε συστήματα ήχου μικρών δυνατοτήτων, χρησιμοποιήστε την επιλογή \"Laptop\"."

msgid "tip183"
msgstr "Χρησιμοποιήστε τη νυχτερινή λειτουργία για να μειώσετε την οξύτητα των ήχων."

msgid "tip184"
msgstr "Μπορείτε να επιλέξετε την \"Ενίσχυση χαμηλής συχνότητας\" αλλά το αποτέλεσμα θα διαφέρει για διαφορετικά συστήματα ήχου."

msgid "tip185"
msgstr "Τα ελαφρά τροχήλατα οχήματα έχουν μεγάλη ευκινησία, η οποία τους δίνει τη δυνατότητα να φτάνουν πιο γρήγορα απ' όλους στις καλύτερες θέσεις ή να ξεφεύγουν άμεσα από τον κίνδυνο."

msgid "tip186"
msgstr "Τα οχήματα αυτά είναι εξοπλισμένα με 2 πλήρως-λειτουργικά πυροβόλα, τα οποία μπορούν να ρίξουν πυρά είτε ταυτόχρονα είτε ξεχωριστά. Το πλήκτρο για τη ρίψη πυρών μπορεί να αλλάξει από τις Ρυθμίσεις."

msgid "tip191"
msgstr "Υπάρχουν διαφορετικές κλάσεις μερικών στοιχείων εξοπλισμού, η χρήση των οποίων εξαρτάται από τη βαθμίδα του επιλεγμένου οχήματος."

msgid "tip192"
msgstr "Στα οχήματα των Βαθμίδων VI και πάνω, η τοποθέτηση κανονικού εξοπλισμού σε θέση της αντίστοιχης κατηγορίας παρέχει μεγαλύτερο μπόνους. Η τοποθέτηση σε θέση από άλλη κατηγορία δίνει μόνο το βασικό μπόνους."

msgid "tip193"
msgstr "Η μέγιστη ταχύτητα δεν επηρεάζεται από τη διαμόρφωση του οχήματος. Μπορεί να βελτιωθεί μόνο με τοποθέτηση κατάλληλου εξοπλισμού, επιλογή τροποποιήσεων μάχης, ή εκπαίδευση κατάλληλων ικανοτήτων πληρώματος."

msgid "tip194"
msgstr "Οι Τροποποιήσεις Μάχης σας δίνουν τη δυνατότητα να προσαρμόσετε το όχημά σας στον τρόπο παιχνιδιού που σας αρέσει."

msgid "tip195"
msgstr "Με τις Τροποποιήσεις Μάχης ξεκλειδώνετε την Εναλλασσόμενη Διαμόρφωση για το συγκεκριμένο όχημα. Επιλέξτε την κατάλληλη διαμόρφωση που θα σας δώσει πλεονέκτημα στην επόμενη μάχη."

msgid "tip196"
msgstr "Χρησιμοποιήστε τις συντομεύσεις Ctrl+1 και Ctrl+2 για εναλλαγή των Φορτίου μεταξύ Βασικού και Επικουρικού."

msgid "tip197"
msgstr "Αφότου ανακαλύψετε ένα συγκεκριμένο επίπεδο Τροποποίησης Μάχης, θα μπορείτε να ορίσετε κατηγορία για τη 2η θέση εξοπλισμού στο συγκεκριμένο όχημα."

msgid "tip198"
msgstr "Οι Τροποποιήσεις Μάχης είναι διαθέσιμες για οχήματα των Βαθμίδων VI–X που γίνονται Επίλεκτα. Οι Τροποποιήσεις είναι άμεσα διαθέσιμες με την απόκτηση ενός ειδικού οχήματος ή ενός οχήματος επιβράβευσης, καθώς και με την αγορά ενός Προνομιακού οχήματος."

msgid "tip199"
msgstr "Ο Πίνακας Τροποποιήσεων εξαρτάται άμεσα από το τύπο του οχήματος και τον ρόλο του."

msgid "tip200"
msgstr "Διατηρεί μέρος της ευκινησίας όταν έχει καταστραφεί η βασική ερπύστρια."

msgid "tip200Status"
msgstr "Εφεδρική Ερπύστρια"

msgid "tip201"
msgstr "Διατηρεί μέρος της ευκινησίας όταν έχει καταστραφεί η βασική ερπύστρια."

msgid "tip202"
msgstr "Οι Προωθητήρες Αερίου αυξάνουν την ευκινησία του οχήματος. Δίνουν τη δυνατότητα γρηγορότερης κατάληψης σημαντικών θέσεων ή γρηγορότερης διάβασης επικίνδυνων περιοχών."

msgid "tip202Status"
msgstr "Οχήματα Με Προωθητήρες Αερίου"

msgid "tip203"
msgstr "Πιέστε τα πλήκτρα TAB ή B για να ενεργοποιήσετε Προσωπικά Αποθέματα"

msgid "tip204"
msgstr "Με επαρκή ψύξη του πυροβόλου μετά από βολές, η ευστοχία του θα βελτιωθεί. Θα εμφανιστεί ένας δεύτερος κύκλος στόχευσης, με μικρότερη διάμετρο, ο οποίος θα καθορίζει την περιοχή προσβολής του στόχου. Η επίδραση αυτή διαρκεί μέχρι την επόμενη βολή."

msgid "tip204Status"
msgstr "Διπλή Στόχευση"

msgid "tip205"
msgstr "Τύπος αυτόματων πυροβόλων με εξαιρετικά μεγάλη ταχυβολία. Η αποτελεσματικότητα των πυρών σημειώνεται στον κύκλο στόχευσης."

msgid "tip205Status"
msgstr "Αυτόματο Πυροβόλο"

msgid "tip206"
msgstr "Τα μέλη πληρώματος μπορούν να κατέχουν μέχρι και 6 ικανότητες κύριας ειδικότητας."

msgid "tip207"
msgstr "Τα μέλη πληρώματος με πολλαπλές ειδικότητες μπορούν να μάθουν πρόσθετες ικανότητες με βάση τις επιπλέον ειδικότητες που έχουν. Οι ικανότητες αυτές δεν απαιτούν πρόσθετα XP και δεν υπολογίζονται στο όριο των διαθέσιμων ικανοτήτων."

msgid "tip208"
msgstr "Εάν πολλαπλά μέλη ενός πληρώματος έχουν την ίδια ειδικότητα, ως επίδραση των ικανοτήτων τους θα λαμβάνεται ο μέσος όρος αυτών. Για να επιδρά μία ικανότητα στο 100% θα πρέπει να είναι πλήρως εκπαιδευμένη από όλα τα μέλη με την ίδια ειδικότητα."

msgid "tip209"
msgstr "Αφότου αποκτήσουν 6 ικανότητες, τα μέλη πληρώματος θα συνεχίσουν να κερδίζουν XP, τα οποία θα μετατρέπονται σε Οδηγούς Γενικής Χρήσης, οι οποίοι θα μπορούν να αξιοποιηθούν σε άλλα πληρώματα."

msgid "tip210"
msgstr "Στο όχημα αυτό, μπορείτε να αλλάξετε φάση πυρών μέσα στη μάχη επιλέγοντας μονή βολή ή ομοβροντία, ανάλογα με την περίσταση."

msgid "tip210Status"
msgstr "Οχήματα με πολλαπλές φάσεις πυρών"

msgid "tip211"
msgstr "Οι Προωθητήρες Αερίου αυξάνουν την ευκινησία του οχήματος. Δίνουν τη δυνατότητα γρηγορότερης κατάληψης σημαντικών θέσεων ή γρηγορότερης διάβασης επικίνδυνων περιοχών."

msgid "tip211Status"
msgstr "Οχήματα Με Προωθητήρες Αερίου"

msgid "tip23"
msgstr "Τα ελαφρά οχήματα με ισχνή θωράκιση μπορούν εύκολα να καταστραφούν με εμβολισμό."

msgid "tip25"
msgstr "Χρησιμοποιήστε βλήματα High-Explosive για να καταστρέφετε εξαρτήματα και να βγάζετε εκτός μάχης μέλη του αντίπαλου πληρώματος."

msgid "tip28"
msgstr "Τα βλήματα High-Explosive είναι πολύ αποτελεσματικά εναντίον λεπτής θωράκισης και ανοικτών οχημάτων."

msgid "tip29"
msgstr "Για να σταματήσετε ένα εχθρικό όχημα και να το κάνετε εύκολο στόχο, πυροβολήστε τις ερπύστριές του."

msgid "tip30"
msgstr "Οχήματα με χαμηλό προφίλ είναι δυσκολότερο να εντοπιστούν, ιδιαίτερα πίσω από θάμνους."

msgid "tip31"
msgstr "Προσπαθήστε με άλλον τύπο βλήματος αν δεν μπορείτε να προκαλέσετε φθορά με το επιλεγμένο βλήμα."

msgid "tip32"
msgstr "Το μπόνους επιδόσεων του πληρώματος αναβαθμίζει περαιτέρω τις ικανότητες του πληρώματος και βελτιώνει τα βασικά χαρακτηριστικά του οχήματος."

msgid "tip33"
msgstr "Τα ακίνητα οχήματα εντοπίζονται πιο δύσκολα από αυτά που είναι σε κίνηση."

msgid "tip36"
msgstr "Σε κοντινή απόσταση, ένα Α/Κ Πυροβόλο μπορεί να καταστρέψει ένα εχθρικό όχημα με άμεσες βολές."

msgid "tip37"
msgstr "Το εχθρικό πυροβολικό μπορεί να μαντέψει τη θέση σας όταν καταστρέφετε φράκτες και κτίρια."

msgid "tip39"
msgstr "Είναι πάντα καλό να ρίχνετε συγκεντρωτικά πυρά."

msgid "tip41"
msgstr "Για να εντοπίσετε εχθρικά οχήματα, παρατηρήστε την τροχιά των βολών τους."

msgid "tip42"
msgstr "Όσα περισσότερα οχήματα βρίσκονται μέσα στον κύκλο της εχθρικής βάσης, τόσο πιο γρήγορα θα γίνει κατάληψη αυτής. Ο πιο γρήγορος τρόπος κατάληψης είναι με τρία οχήματα."

msgid "tip43"
msgstr "Εάν καμία ομάδα δεν υπερισχύσει σε μάχες Επίθεσης, τότε η αμυνόμενη ομάδα κερδίζει μόλις λήξει ο χρόνος της μάχης."

msgid "tip44"
msgstr "Αποφύγετε τα εχθρικά πυρά όταν καταλαμβάνετε μία βάση. Η κατάληψη της βάσης διακόπτεται εάν προκληθεί φθορά στο όχημά σας."

msgid "tip45"
msgstr "Η ευκινησία επηρεάζεται από τον τύπο της ανάρτησης, την ισχύ του κινητήρα και το συνολικό βάρος του οχήματος. Μπορεί να βελτιωθεί με την τοποθέτηση του κατάλληλου εξοπλισμού."

msgid "tip47"
msgstr "Κτίρια και κατεστραμμένα οχήματα μπορούν να μπλοκάρουν τα εχθρικά πυρά. Δέντρα και θάμνοι μπορούν αν παρέχουν κάλυψη αλλά δεν θα σταματήσουν τις εισερχόμενες βολές."

msgid "tip48"
msgstr "Κάντε κλικ στο Κουτί Επισκευών για αν επισκευάσετε ένα χαλασμένο εξάρτημα."

msgid "tip49"
msgstr "Εάν καταστραφεί το πυροβόλο, δεν μπορεί να ρίξει πυρά. Κάντε κλικ στο Κουτί Επισκευών γα να μπορέσει να λειτουργήσει ξανά."

msgid "tip50"
msgstr "Η φθορά στα πυρομαχικά μπορεί να έχει ως αποτέλεσμα το πιο αργό γέμισμα του πυροβόλου ή σε μερικές περιπτώσεις την άμεση καταστροφή του οχήματος."

msgid "tip56"
msgstr "Ο Προνομιακός Λογαριασμός σας παρέχει 50% περισσότερα xp και credits από την κάθε μάχη."

msgid "tip57"
msgstr "Μπορείτε χρησιμοποιώντας Free XP να ανακαλύψετε οποιοδήποτε όχημα, εξάρτημα ή οποιαδήποτε τροποποίηση."

msgid "tip58"
msgstr "Όταν ανακαλύπτετε οχήματα, εξαρτήματα ή τροποποιήσεις, πρώτα ξοδεύεται το Combat Experience και μετά το Free Experience."

msgid "tip6"
msgstr "Οχήματα διαφορετικού τύπου απαιτούν διαφορετικές τακτικές μάχης."

msgid "tip60"
msgstr "Κερδίζετε experience και credits από εντοπισμό αντιπάλων, πρόκληση φθοράς και καταστροφή εχθρικών οχημάτων, για τη κατάληψη ή την υπεράσπιση βάσης, κλπ."

msgid "tip62"
msgstr "Οι βολές σας μπορούν να μειώσουν τα hit points ενός εχθρικού οχήματος, να φθείρουν ή να καταστρέψουν εξαρτήματα, ή να τραυματίσουν μέλη του πληρώματος."

msgid "tip65"
msgstr "Εκμεταλλευτείτε τις ιδιαιτερότητες του χάρτη για να βρείτε θέσεις προστατευμένες από τα εχθρικά πυρά ή θέσεις ανίχνευσης αντιπάλων."

msgid "tip66"
msgstr "Μία ομάδα που συνεργάζεται καλά, κερδίζει."

msgid "tip67"
msgstr "Εάν σας τελειώνουν οι θέσεις στο Γκαράζ, πουλήστε ένα από τα οχήματά σας ή αγοράστε μία νέα θέση."

msgid "tip68"
msgstr "Χρησιμοποιήστε την Αποθήκη για να πωλήσετε οχήματα, εξαρτήματα, αναλώσιμα και εξοπλισμό που δεν χρειάζεστε."

msgid "tip69"
msgstr "Εάν κάποιος ρωτήσει ποιος είναι ο κωδικός σας, θέλει να σας εξαπατήσει. Οι Administrators δεν θα χρειαστούν τον κωδικό σας για οποιονδήποτε λόγο. Πάντα να κρατάτε τον κωδικό σας μυστικό."

msgid "tip70"
msgstr "Οι επισκευές στα Προνομιακά οχήματα κοστίζουν λιγότερο."

msgid "tip71"
msgstr "Μην πυροβολείτε συμπαίκτες σας!"

msgid "tip75"
msgstr "Η περιστροφή του πυργίσκου και του σκάφους μειώνει την ευστοχία των βολών. Μόλις τελειώσετε τον ελιγμό σας, περιμένετε μέχρις ότου ο κύκλος στόχευσης κλείσει πάνω στον στόχο."

msgid "tip77"
msgstr "Η επιτάχυνση επηρεάζεται από την ισχύ του κινητήρα, το βάρος του οχήματος και τον τύπο του εδάφους. Μπορεί να βελτιωθεί με την τοποθέτηση του κατάλληλου εξοπλισμού, με τη χρήση αναλώσιμων, με τις κατάλληλες τροποποιήσεις του οχήματος και ικανότητες του πληρώματος."

msgid "tip78"
msgstr "Οι διάφορες αναρτήσεις έχουν διαφορετικούς χρόνους περιστροφής και διαφορετική πρόσφυση."

msgid "tip79"
msgstr "Ένας αποτελεσματικός εμβολισμός εξαρτάται από την αναλογία βάρους, την ταχύτητα και το πάχος της θωράκισης των οχημάτων."

msgid "tip81"
msgstr "Η ταχύτητα με την οποία κλείνει ο κύκλος στόχευσης πάνω στον στόχο εξαρτάται από τις ικανότητες του Πυροβολητή και από την τοποθέτηση συγκεκριμένου εξοπλισμού και αναλώσιμων."

msgid "tip83"
msgstr "Η αυτόματη στόχευση ματαιώνεται όταν ο στόχος καταστραφεί ή χαθεί από το οπτικό πεδίο."

msgid "tip84"
msgstr "Ένα όχημα που καταστράφηκε, κλειδώνεται και παραμένει, χωρίς να είναι διαθέσιμο, στο Γκαράζ μέχρι το τέλος της μάχης."

msgid "tip85"
msgstr "Μπορείτε να λάβετε μέρος σε μάχη μόνο με πλήρως επισκευασμένο όχημα και με πλήρες πλήρωμα."

msgid "tip86"
msgstr "Είναι βολικό να τσεκάρετε τις επιλογές Αυτόματος Ανεφοδιασμός και Αυτόματη Επισκευή για το όχημά σας."

msgid "tip87"
msgstr "Η κεκλιμένη θωράκιση αυξάνει τις πιθανότητες μη διάτρησης και εξοστρακισμού του βλήματος."

msgid "tip88"
msgstr "Τα μέλη πληρώματος που δεν είναι εκπαιδευμένα για ένα συγκεκριμένο όχημα δεν μπορούν να χρησιμοποιήσουν τις ικανότητές τους όταν μπαίνουν στη μάχη με το όχημα αυτό."

msgid "tip89"
msgstr "Μπορείτε να μεταφέρετε μέλη του πληρώματος σε άλλο όχημα ή να τα στείλετε στον Στρατώνα."

msgid "tip9"
msgstr "Μόλις διαισθανθείτε κίνδυνο, αλλάξτε θέση στο πυροβολικό σας. Θα επιβιώσετε περισσότερη ώρα."

msgid "tip91"
msgstr "Δεν μπορείτε να λάβετε μέρος σε μάχη με ημιτελές πλήρωμα."

msgid "tip92"
msgstr "Το πόσο γρήγορα εκπαιδεύεται το πλήρωμά σας εξαρτάται από την επιτυχία σας στις μάχες."

msgid "tip93"
msgstr "Ο Αρχηγός αυξάνει το μπόνους επιδόσεων των υπόλοιπων μελών του πληρώματος. Το μπόνους επιδόσεων του πληρώματος μπορεί επίσης να αυξηθεί από τις ικανότητες του πληρώματος ή με χρήση εξοπλισμού και αναλώσιμων."

msgid "tip95"
msgstr "Όλο το κερδισμένο Combat Experience πηγαίνει στην εκπαίδευση του λιγότερου εκπαιδευμένου μέλους του πληρώματος, όταν έχει ενεργοποιηθεί η επιλογή Επιτάχυνση Εκπαίδευσης Πληρώματος."

msgid "tip98"
msgstr "Ο διαθέσιμος εξοπλισμός εξαρτάται από τη βαθμίδα, τον τύπο και τα ιδιαίτερα χαρακτηριστικά του οχήματος."

msgid "tip99"
msgstr "Όλος ο εξοπλισμός μπορεί να αφαιρεθεί και να μεταφερθεί σε άλλο όχημα."

msgid "usefulFeatures"
msgstr "Χρήσιμες Επιλογές"

msgid "wheeledVehicles"
msgstr "Τα τροχήλατα οχήματα είναι από τα πιο γρήγορα του παιχνιδιού"

msgid "winback1"
msgstr "Μπορείτε να βγείτε από την Προθέρμανση από το μενού των Τυχαίων Μαχών."

msgid "winback1Status"
msgstr "Προσοχή"
