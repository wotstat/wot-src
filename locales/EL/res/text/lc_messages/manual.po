msgstr "Video: Γρήγορη Επικοινωνία"

msgid "chapter-7/video-lesson-2/title"
msgstr "Video: Προνομιακός Λογαριασμός"

msgid "chapter-7/video-lesson-3/title"
msgstr "Video: Νομίσματα Του Παιχνιδιού"

