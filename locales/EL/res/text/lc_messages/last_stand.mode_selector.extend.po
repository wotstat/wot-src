msgid "mode/last_stand/battlePassTooltip/body"
msgstr "Μπορείτε να κερδίζετε Πόντους Battle Pass από τις μάχες της διοργάνωσης {whiteSpanish_open}Last Stand{whiteSpanish_close}."

msgid "mode/last_stand/battlePassTooltip/header"
msgstr "Πόντοι Battle Pass"

msgid "mode/last_stand/calendar"
msgstr "Η διοργάνωση θα διαρκέσει για %(date)s."

msgid "mode/last_stand/calendarDay"
msgstr "Λήξη διοργάνωσης σε %(date)s."

msgid "mode/last_stand/description"
msgstr "Αποκρούστε τα εχθρικά κύματα επιθέσεων.\nΜάχες με οχήματα Βαθμίδας VIII."

msgid "mode/last_stand/performance/highRisk/description"
msgstr "Οι επιδόσεις του υπολογιστή σας δεν επαρκούν γι αυτήν τη λειτουργία. Θα έχετε προβλήματα με τα γραφικά και με την κίνηση των οχημάτων. Είναι πιθανό να κλείσει εντελώς ο client."

msgid "mode/last_stand/performance/highRisk/header"
msgstr "Χαμηλές Επιδόσεις"

msgid "mode/last_stand/performance/highRisk/headerIcon"
msgstr "%(icon) Χαμηλές Επιδόσεις"

msgid "mode/last_stand/performance/mediumRisk/description"
msgstr "Αυτές οι μάχες απαιτούν υπολογιστή υψηλών επιδόσεων.\nΘα έχετε προβλήματα με τη φόρτωση του χάρτη, τα γραφικά και την κίνηση των οχημάτων. Σε περίπτωση ανεπάρκειας, χαμηλώστε την ποιότητα των γραφικών από τις Ρυθμίσεις."

msgid "mode/last_stand/performance/mediumRisk/header"
msgstr "Μειωμένη Απόδοση"

msgid "mode/last_stand/performance/mediumRisk/headerIcon"
msgstr "%(icon) Μειωμένη Απόδοση"
