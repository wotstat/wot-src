msgid "alert"
msgstr "Δεν μπορείτε να επιλέξετε Εφεδρεία όταν έχετε εμπλακεί σε μάχη."

msgid "description/one/reserve"
msgstr "Η επαναλαμβανόμενη επιλογή της Εφεδρείας %(reserve_name)s\nθα βελτιώσει τα χαρακτηριστικά της."

msgid "description/second/reserve"
msgstr "Η επαναλαμβανόμενη επιλογή της Εφεδρείας %(first_reserve_name)s ή της Εφεδρείας %(second_reserve_name)s\nθα βελτιώσει τα χαρακτηριστικά τους."

msgid "number_1"
msgstr "1η"

msgid "number_2"
msgstr "2η"

msgid "number_3"
msgstr "3η"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Τοποθετεί νάρκες στην επιλεγμένη περιοχή για συγκεκριμένο χρονικό διάστημα."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Προκαλεί μεγάλη φθορά στα εχθρικά οχήματα μέσα σε μία μικρή περιοχή."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Προκαλεί μέση φθορά αλλά και σοκ στα εχθρικά οχήματα μέσα σε μία μεγάλη περιοχή."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Βελτιώνει την κύρια ειδικότητα των μελών όλων των πληρωμάτων"

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Αυξάνει την ταχύτητα κατάληψης, υπεράσπισης και ανεφοδιασμού."

msgid "shortDescription/reserve/reconAbility"
msgstr "Εντοπίζει εχθρικά οχήματα και ναρκοπέδια."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Αποκαθιστά ένα προκαθορισμένο ποσοστό των hit points του οχήματος."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Παρέχει μπόνους στους συντελεστές κάλυψης όλων των οχημάτων, μέσα και πίσω από το παραπέτασμα καπνού."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Αυξάνει τους συντελεστές κάλυψης και το εύρος ορατότητας. Μειώνει τους συντελεστές κάλυψης των εχθρικών οχημάτων."

msgid "title"
msgstr "Διαθέσιμη η %(number_name)s Θέση Εφεδρείας"
