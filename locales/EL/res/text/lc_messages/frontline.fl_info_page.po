msgid "progression/sectionHeader"
msgstr "Πρόοδος Πρώτης Γραμμής"

msgid "progression/text"
msgstr "Σε αυτό το είδος μαχών, προάγεστε σε υψηλότερους βαθμούς, καταλαμβάνετε μεγαλύτερες Βαθμίδες και κερδίζετε έπαθλα."

msgid "reserveCategories/categories/additional"
msgstr "Δευτερεύουσα"

msgid "reserveCategories/categories/cell_1"
msgstr "Θέση Εφεδρείας 1"

msgid "reserveCategories/categories/cell_2"
