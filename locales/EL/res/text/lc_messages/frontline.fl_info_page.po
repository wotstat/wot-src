msgid "reserveCategories/categories/main"
msgstr "Πρωταρχική"

msgid "reserveCategories/categories/support"
msgstr "Επικουρική"

msgid "reserveCategories/config/footerText"
msgstr "Στο σενάριο {{@ colorLegacy 'FFE4C0'}}Twist of Fate{{/}}, η σειρά με την οποία ξεκλειδώνονται οι Εφεδρείες δεν εξαρτάται από τον τύπο του οχήματος."

msgid "reserveCategories/config/header"
msgstr "Διαμόρφωση Εφεδρειών ανά Τύπο Οχήματος"

msgid "reserveCategories/config/text"
msgstr "Στα σενάρια {{@ colorLegacy 'FFE4C0'}}Standard Battle{{/}} και {{@ colorLegacy 'FFE4C0'}}Operational Support{{/}}, όλα τα οχήματα θα έχουν πρόσβαση και στις 3 θέσεις Εφεδρειών. Ωστόσο, η σειρά με την οποία ξεκλειδώνονται οι θέσεις είναι διαφορετική για κάθε τύπο οχήματος."

msgid "reserveCategories/config/vehicles/destroyer"
msgstr "Αντιαρματικά"

