msgstr "Desertion From Battlefield"

msgid "punishmentWindow/message/ban/comp7"
msgstr "You violated Game Rules on the {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} map at {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} Rating Points have been deducted and you have temporarily been blocked from battles in the {whiteSpanish_Open}Onslaught{whiteSpanish_Close} mode."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "You violated Game Rules on the {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} map at {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nYou have temporarily been blocked from battles in the {whiteSpanish_Open}Onslaught{whiteSpanish_Close} mode and your Rating has been reduced."
