msgid "Panther_II_IGR"
msgstr "Panther II"

msgid "Panther_II_IGR_descr"
msgstr "Les premiers plans de construction de ce véhicule apparurent en 1943. Deux prototypes avec la tourelle du Panther I furent commandés en 1944. En 1945, un seul fut construit par la société MAN."

msgid "Panther_II_IGR_short"
msgstr "Panther II"

msgid "Pershing_IGR"
msgstr "M26 Pershing"

msgid "Pershing_IGR_descr"
msgstr "Développé spécifiquement pour combattre les chars lourds Allemands. Au début, il fut standardisé en tant que lourd, mais fut reclassifié après la guerre en char moyen. Il a combattu en Europe dans le cadre de tests de première ligne."

msgid "Pershing_IGR_short"
msgstr "Pershing"

msgid "Pershingchassis2_IGR"
