msgid "AN-VRC-7_IGR"
msgstr "AN/VRC-7"

msgid "Bat_Chatillon25t_IGR"
msgstr "Bat.-Châtillon 25 t"

msgid "Bat_Chatillon25t_IGR_descr"
msgstr "Ce char expérimental était un développement ultérieur de l'AMX 13. Le char a été mis à l'essai, mais jamais produit en série ni vu en service. Deux véhicules ont été fabriqués."

msgid "Bat_Chatillon25t_IGR_short"
msgstr "B-C 25 t"

