msgid "S27_UDES_16_LS_BOT"
msgstr "Garde UDES 16"

msgid "S27_UDES_16_LS_BOT_descr"
msgstr "Un développement ultérieur du projet UDES 14E2 a été proposé par la société Hägglunds. Ce véhicule devait présenter une silhouette plus basse et être équipé d'un canon à barillet de 105 mm. En 1974, le projet fut fusionné avec celui de Bofors, devenant ainsi le projet UDES 15/16. Aucun prototype n'a été fabriqué."

msgid "S27_UDES_16_LS_BOT_short"
msgstr "Garde"

msgid "S29_UDES_14_5_LS_BOT"
msgstr "Garde UDES 14 Alt 5"

msgid "S29_UDES_14_5_LS_BOT_descr"
msgstr "Le projet d'un char UDES 14 développé par Bofors. Ce projet devait disposer d'un canon à chargement automatique et d'une suspension hydraulique, ainsi que de la possibilité de charger manuellement le canon. Il n'a pas dépassé le stade de la planche à dessin."

msgid "S29_UDES_14_5_LS_BOT_short"
msgstr "Garde"

