msgid "alert"
msgstr "Vous ne pouvez pas choisir une Réserve de combat durant un combat actif."

msgid "description/one/reserve"
msgstr "Le choix renouvelé de la Réserve %(reserve_name)s\naméliorera ses caractéristiques."

msgid "description/second/reserve"
msgstr "Le choix renouvelé de la Réserve %(first_reserve_name)s ou %(second_reserve_name)s\naméliorera les caractéristiques de celle sélectionnée."

msgid "number_1"
msgstr "1er"

msgid "number_2"
msgstr "2e"

msgid "number_3"
msgstr "3e"

msgid "shortDescription/reserve/acrcadeMinefieldEpicBattle"
msgstr "Déploie un champ de mines actif dans la zone sélectionnée pendant un certain temps."

msgid "shortDescription/reserve/artilleryAbility"
msgstr "Inflige des dégâts considérables aux véhicules ennemis dans un petit rayon."

msgid "shortDescription/reserve/bomberAbility"
msgstr "Étourdit des véhicules ennemis et inflige des dégâts moyens dans un grand rayon."

msgid "shortDescription/reserve/inspireAbility"
msgstr "Ajoute un bonus à la qualification principale de l'équipage du joueur et de ceux des alliés."

msgid "shortDescription/reserve/passiveEngineering"
msgstr "Apporte un bonus à la vitesse de capture, au blocage de la capture et au ravitaillement."

msgid "shortDescription/reserve/reconAbility"
msgstr "Repère les véhicules ennemis et les champs de mines."

msgid "shortDescription/reserve/regenerationKitFL"
msgstr "Rétablit un certain pourcentage de points de structure de votre véhicule."

msgid "shortDescription/reserve/smokeAbility"
msgstr "Dissimule tous les véhicules à l'intérieur et derrière la fumée."

msgid "shortDescription/reserve/stealthRadarAbility"
msgstr "Octroie un bonus à la dissimulation et à la portée de vue. Réduit la dissimulation des véhicules ennemis."

msgid "title"
msgstr "Le %(number_name)s emplacement de Réserve est disponible"
