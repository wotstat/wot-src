msgid "comp7/deserter/cancel"
msgstr "Annuler"

msgid "comp7/deserter/message"
msgstr "Cette bataille n'est pas encore terminée. Si vous quittez la bataille avant la fin, vous abandonnerez votre équipe.\n{brown_open}Votre rang sera réduit et vous ne pourrez plus participer aux batailles dans ce mode.{brown_close}\nÊtes-vous sûr de vouloir quitter la bataille ?"

msgid "comp7/deserter/msgTitle"
msgstr "Vous perdrez vos points de rang !"

msgid "comp7/deserter/submit"
msgstr "Déserter"

msgid "comp7/deserter/title"
msgstr "Désertion du champ de bataille"

msgid "punishmentWindow/message/ban/comp7"
msgstr "Vous avez enfreint le règlement du jeu sur la carte {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} à {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\n{whiteSpanish_Open}%(penalty)s{whiteSpanish_Close} points de rang vous ont été retirés et vous avez été temporairement suspendu des batailles en mode {whiteSpanish_Open}Offensive{whiteSpanish_Close}."

msgid "punishmentWindow/message/ban/comp7/qualification"
msgstr "Vous avez enfreint le règlement du jeu sur la carte {whiteSpanish_Open}%(arenaName)s{whiteSpanish_Close} à {whiteSpanish_Open}%(time)s{whiteSpanish_Close}.\nVous avez été temporairement suspendu des batailles en mode {whiteSpanish_Open}Offensive{whiteSpanish_Close} et votre rang a été diminué."
