msgid "comp7_light/deserter/cancel"
msgstr "Annuler"

msgid "comp7_light/deserter/message"
msgstr "Votre équipe a besoin de vous ! Quitter une bataille avant qu'elle se termine ou avant que votre véhicule ne soit détruit est considéré comme une désertion.\nCela peut {brown_open}entraîner l'imposition d'une sanction disciplinaire.{brown_close}"

msgid "comp7_light/deserter/submit"
msgstr "Déserter"

msgid "comp7_light/deserter/title"
msgstr "Déserter le champ de bataille ?"

msgid "punishmentWindow/reason/comp7_light_deserter"
msgstr "Inaction en bataille ou sortie de la bataille avant sa fin/avant la destruction du véhicule."
