msgid "player_errors/equipment/fastRecharge/gunTemperatureLow"
msgstr "Indisponible : le canon de ce véhicule n'est pas brûlant."

msgid "player_errors/equipment/fastRecharge/vehicleIsNotRecharged"
msgstr "Indisponible : le canon de ce véhicule n'est pas en train de se recharger."

msgid "player_errors/equipment/fastRecharge/vehicleIsOnFastRecharge"
msgstr "Indisponible : le temps de rechargement a déjà été réduit."

msgid "player_errors/equipment/hunter/noDamagedEnemyVehicles"
msgstr "Indisponible : aucun véhicule ennemi n'a été endommagé par un tir."

msgid "player_errors/equipment/hunter/vehicleIsNotDamaged"
msgstr "Indisponible : vous n'avez pas besoin de restaurer vos points de structure."

msgid "player_errors/equipment/roleSkill/alreadyActivated"
msgstr "La compétence de rôle %(name)s est déjà active."

msgid "player_errors/equipment/roleSkill/cooldown"
msgstr "La compétence de rôle %(name)s est indisponible : en rechargement."

msgid "player_errors/equipment/roleSkill/unavailable"
msgstr "La compétence de rôle %(name)s est indisponible : aucune charge."

msgid "player_messages/equipment/roleSkill/applied"
msgstr "La compétence de rôle %(name)s a été activée !"

msgid "player_messages/equipment/roleSkill/promoted"
msgstr "Le niveau de charge de la compétence de rôle %(name)s a été augmenté !"

msgid "player_messages/equipment/roleSkill/ready"
msgstr "La compétence de rôle %(equipment)s est prête à être activée."
