msgid "_100mm_UBR-412PB_WT_descr"
msgstr "Fierté des armuriers de l'Alliance"

msgid "_100mm_UBR-412PB_WT_long_special"
msgstr "Chaque Générateur surchargé chargera les Projectiles en argent de Plasma. Plus il y a de charges, plus le Plasma infligera de dégâts. Tirez lorsque le bouclier du Blitzträger est désactivé pour infliger un maximum de dégâts."

msgid "_100mm_UBR-412PB_WT_short_special"
msgstr "Dégâts supplémentaires avec le Plasma"
