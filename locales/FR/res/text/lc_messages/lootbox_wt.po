msgid "singleRewardView/tooltip/description/"
msgstr "Si vous possédez déjà tous les véhicules de la liste du contenu possible du module, alors tous les véhicules suivants reçus dans les modules feront l'objet d'une compensation en pièces d'or."

msgid "singleRewardView/tooltip/remainingCount"
msgid_plural "plural/singleRewardView/tooltip/remainingCount"
msgstr[0] "%(remainingCount) module"
msgstr[1] "%(remainingCount) modules"
msgstr[2] "%(remainingCount) modules"

msgid "singleRewardView/tooltip/subtitle/"
msgstr "La Récompense garantie est un véhicule de la liste du contenu possible du module.\nSi vous en ouvrez %(remainingCount) sans obtenir un tel véhicule, il sera acquis en ouvrant le %(count)e module. Quand cela se produit, le compteur est remis à zéro."

msgid "tooltip/reroll/text/wt"
msgstr "La réouverture d'un module vous donne une chance de recevoir des récompenses différentes de la même liste."
