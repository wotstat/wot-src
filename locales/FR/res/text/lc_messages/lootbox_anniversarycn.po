msgid "#PluralForms"
msgstr "nplurals=2; plural=(n > 1);"

msgid "boxTooltip/description/text/bronze"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules, des devises du jeu et d'autres récompenses précieuses."

msgid "boxTooltip/description/text/gold"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules, des devises du jeu, des éléments de personnalisation et d'autres récompenses précieuses."

msgid "boxTooltip/description/text/silver"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules, des devises du jeu, des éléments de personnalisation et d'autres récompenses précieuses."

msgid "boxTooltip/howGet/text/bronze"
msgstr "Peut être obtenue dans le Magasin en jeu ou en ouvrant des boîtes de tout autre type."

msgid "boxTooltip/howGet/text/gold"
msgstr "Peut être reçue en ouvrant des boîtes de n'importe quel autre type."

msgid "boxTooltip/howGet/text/silver"
msgstr "Peut être reçue en ouvrant des boîtes de n'importe quel autre type."

msgid "common/boxCategory/lowerCase/bronze"
msgstr "Boîte du butin"

msgid "common/boxCategory/lowerCase/gold"
msgstr "Boîte de la faveur"

msgid "common/boxCategory/lowerCase/silver"
msgstr "Boîte de l'offrande"

msgid "common/boxCategory/upperCase/bronze"
msgstr "BOÎTE DU BUTIN"

msgid "common/boxCategory/upperCase/gold"
msgstr "BOÎTE DE LA FAVEUR"

msgid "common/boxCategory/upperCase/silver"
msgstr "BOÎTE DE L'OFFRANDE"

msgid "entryPoint/tooltip/description"
msgstr "Il s'agit de boîtes spéciales contenant des objets nouveaux et uniques. Elles peuvent être obtenues dans le Magasin en jeu."

msgid "entryPoint/tooltip/timerText"
msgstr "L'évènement se terminera dans"

msgid "eventName/lowerCase"
msgstr "Trésor des Murmures"

msgid "eventName/upperCase"
msgstr "TRÉSOR DES MURMURES"

msgid "guaranteed/tooltip/description1/"
msgstr "Si vous possédez déjà tous les véhicules, vous recevrez une Boîte de la faveur à la place."

msgid "infoPage/footer/description/compensation"
msgstr "Si vous possédez déjà tous les véhicules disponibles dans ces boîtes, vous recevrez une Boîte de la faveur en récompense à la place d'un véhicule."

msgid "infoPage/footer/description/guaranteed"
msgstr "Chaque %(guaranteed0)s Boîte du butin, %(guaranteed1)s Boîte de la faveur et %(guaranteed2)s Boîte de l'offrande contient assurément un véhicule. Si vous en ouvrez une qui ne contient pas un tel véhicule, alors un véhicule que vous ne possédez pas encore sera obtenu en ouvrant la %(guaranteed0)se/%(guaranteed1)se/%(guaranteed2)se boîte (en fonction du type de boîte). Lorsque cela se produit, le compteur est réinitialisé."

msgid "infoPage/footer/title/compensation"
msgstr "Compensation"

msgid "infoPage/footer/title/guaranteed"
msgstr "Récompense garantie"

msgid "infoPage/header/rewards/description"
msgstr "Il n'est pas possible d'obtenir plus d'une récompense par groupe"
