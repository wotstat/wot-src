msgid "mode/halloween/battlePassTooltip/body"
msgstr "Certaines missions de l'évènement {whiteSpanish_open}Babylone : Tour sombre{whiteSpanish_close} vous permettront de gagner des Points du Passe de combat."

msgid "mode/halloween/battlePassTooltip/header"
msgstr "Points du Passe de combat"

msgid "mode/halloween/calendar"
msgstr "Cet évènement durera %(date)s."

msgid "mode/halloween/calendarDay"
msgstr "Cet évènement se terminera dans %(date)s."

msgid "mode/halloween/description"
msgstr "Combattez et récoltez de la matière.\nBatailles à bord de véhicules spéciaux."

msgid "mode/halloween/performance/highRisk/description"
msgstr "Les performances de votre ordinateur sont insuffisantes pour ce mode. Vous risquez de subir des problèmes avec les graphismes et le déplacement du véhicule. Des plantages du client du jeu sont également probables."

msgid "mode/halloween/performance/highRisk/header"
msgstr "Faibles performances"

msgid "mode/halloween/performance/highRisk/headerIcon"
msgstr "%(icon) Faibles performances"

msgid "mode/halloween/performance/mediumRisk/description"
msgstr "Ce mode nécessite des performances élevées de l'ordinateur.\nVous allez subir des problèmes avec le chargement des cartes, les graphismes et le déplacement du véhicule. Si les performances ne sont pas suffisantes, essayez de diminuer la qualité graphique dans vos paramètres."

msgid "mode/halloween/performance/mediumRisk/header"
msgstr "Performances réduites"

msgid "mode/halloween/performance/mediumRisk/headerIcon"
msgstr "%(icon) Performances réduites"
