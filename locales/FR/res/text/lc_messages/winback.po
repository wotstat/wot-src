msgid "selectableRewardTooltip/basic/description"
msgstr "Tout véhicule recherchable de rang {{level}} peut être sélectionné. Le véhicule est livré avec ses éléments recherchés, un équipage et une place de garage."

msgid "selectableRewardTooltip/basic/title"
msgstr "Véhicule de rang {{level}}"

msgid "selectableRewardTooltip/discount/description"
msgstr "Une réduction de {{researchDiscount}} sur la recherche et une réduction de {{purchaseDiscount}} sur l'achat d'un véhicule de rang {{level}}. Tout véhicule à rechercher peut être sélectionné."

msgid "selectableRewardTooltip/discount/footer"
msgstr "La réduction sur la {{@ style (color $color)}}recherche{{/}} se cumule avec la réduction des fragments de plan du véhicule. La plus grande réduction disponible sur {{@ style (color $color)}}l'achat{{/}} s'applique."

