msgid "tank_params/desc/chargeableBurstSize"
msgstr "Nombre d'obus stockés dans le chargeur de tir en rafale."

msgid "tank_params/desc/chassisRepairTime"
msgstr "Temps pour réparer une chenille endommagée."

msgid "tank_params/desc/chassisRepairTimeYoh"
msgstr "Temps pour réparer une chenille principale/de réserve endommagée."

msgid "tank_params/desc/chassisRotationSpeed"
msgstr "Vitesse de rotation de la caisse sur son axe et vitesse de changement de direction en mouvement (maniabilité)."

msgid "tank_params/desc/circularVisionRadius"
msgstr "La portée de vue actuelle de votre véhicule. Aucun véhicule ennemi ne peut être repéré au-delà de 445 m. Augmenter davantage la portée de vue améliore la capacité à détecter plus facilement des véhicules ennemis à l'intérieur du rayon de 445 m (mode standard/spécial)."

msgid "tank_params/desc/clipFireRate"
msgstr "Temps entre le tir du dernier obus du barillet (ou des deux canons) et le chargement du barillet suivant. / Temps entre le tir d'un obus et le chargement de l'obus suivant dans le barillet, le canon ou le conteneur. / Nombre de canons ou d'obus dans le barillet."

msgid "tank_params/desc/coincidenceElectromechanicalSightDuration"
msgstr "Durée de l'effet de Coïncidence du viseur électromécanique après activation."

msgid "tank_params/desc/concentrationModeCooldown"
msgstr "Temps nécessaire avant que le stabilisateur puisse être à nouveau activé après utilisation."

msgid "tank_params/desc/concentrationModeDuration"
msgstr "Temps pendant lequel le stabilisateur reste actif après activation."

msgid "tank_params/desc/continuousShotsPerMinute"
msgstr "Le nombre de tirs par minute sans prendre en compte le temps de rechargement."

msgid "tank_params/desc/coolingDelay"
msgstr "Temps après avoir tiré avant que le canon ne commence à refroidir."

msgid "tank_params/desc/coolingTime"
msgstr "Temps nécessaire pour qu'un canon brûlant se refroidisse. Le canon peut être utilisé durant ce laps de temps."

msgid "tank_params/desc/damage"
msgstr "Dégâts infligés par un obus standard s'il pénètre le blindage ennemi."

msgid "tank_params/desc/designatorCooldownS"
msgstr "Temps nécessaire avant que l'identificateur puisse à nouveau être utilisé. Le temps de rechargement commence après avoir tiré un obus."

msgid "tank_params/desc/designatorInitialCooldownS"
msgstr "Temps nécessaire après le lancement de la bataille avant que l'identificateur puisse être utilisé pour la première fois."

msgid "tank_params/desc/designatorMarkDurationS"
msgstr "Temps pendant lequel les véhicules ennemis marqués restent repérés et subissent davantage de dégâts par les obus."

msgid "tank_params/desc/designatorMarkedEnemiesAdditionalDamage"
msgstr "La quantité de dégâts supplémentaires que les véhicules ennemis marqués subissent par les obus."

msgid "tank_params/desc/dispersionAt100mCoincidenceElectromechanicalSight"
msgstr "Le bonus à la dispersion à 100 m octroyé par le viseur."

msgid "tank_params/desc/dualAccuracyCoolingDelay"
msgstr "Montre combien de temps met le canon pour se refroidir assez après avoir tiré pour améliorer sa précision."

msgid "tank_params/desc/enginePower"
msgstr "Ce paramètre affecte l'accélération, la vitesse maximale et la vitesse de rotation de la caisse du véhicule."

msgid "tank_params/desc/enginePowerPerTon"
msgstr "Ce paramètre affecte l'accélération du véhicule et les performances sur divers types de sols (mode standard / spécial)."

msgid "tank_params/desc/enginePowerWithBoosters"
msgstr "Le bonus à l'accélération du véhicule octroyé par les propulseurs."

msgid "tank_params/desc/engineTurboPowerCap"
msgstr "Ce paramètre affecte l'accélération du véhicule, sa vitesse maximale et sa vitesse de rotation de la caisse en mode turbo."

msgid "tank_params/desc/explosionRadius"
msgstr "Le rayon des dégâts après explosion d'un obus explosif, montrant la capacité d'infliger des dégâts à une certaine distance du point d'impact."

msgid "tank_params/desc/extraShotClipReloadTime"
msgstr "Temps ajouté au rechargement du chargeur restant après avoir tiré le dernier obus."

msgid "tank_params/desc/forwardMaxSpeed"
msgstr "Vitesse du véhicule telle que définie dans ses caractéristiques techniques."

msgid "tank_params/desc/furyMaxReloadEffAvgDpm"
msgstr "Le bonus aux dégâts moyens par minute au niveau d'efficacité du rechargement maximal."

msgid "tank_params/desc/furyMaxReloadEfficiencyLevel"
msgstr "Le nombre maximal de niveaux d'efficacité du rechargement pouvant être accumulés."

msgid "tank_params/desc/furyReloadEfficiencyLevelDuration"
msgstr "La durée pendant laquelle un niveau d'efficacité du rechargement dure avant d'expirer."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerDestruction"
msgstr "Le nombre de niveaux d'efficacité du rechargement gagnés en détruisant un véhicule ennemi avec un obus."

msgid "tank_params/desc/furyReloadEfficiencyLevelPerHit"
msgstr "Le nombre de niveaux d'efficacité du rechargement gagnés pour chaque coup avec un obus sur un véhicule ennemi repéré."

msgid "tank_params/desc/furyReloadSpeedBonusPerEfficiencyLevel"
msgstr "La durée pendant laquelle le temps de chargement du canon est réduit par niveau d'efficacité du rechargement."

msgid "tank_params/desc/gunTraverseDispersionTurbo"
msgstr "La pénalité à la dispersion lors du pivot du canon en mode turbo."

msgid "tank_params/desc/gunYawLimits"
msgstr "Angles maximaux de la rotation horizontale du canon (vers la gauche et la droite de la position par défaut) lorsque la caisse est immobile."

msgid "tank_params/desc/heatAvgDmgPerLvl"
msgstr "Le bonus aux dégâts moyens pour chaque niveau de chaleur accumulé."

msgid "tank_params/desc/heatChargeOverheatDuration"
msgstr "Temps pendant lequel le véhicule n'est pas en mesure de tirer ni de changer d'obus."

msgid "tank_params/desc/heatTimeBeforeOverheat"
msgstr "Temps pendant lequel le véhicule reste au niveau de chaleur maximal avant la surchauffe de la charge."

msgid "tank_params/desc/heatTimeToReachLevel"
msgstr "Temps nécessaire pour atteindre chaque niveau de chaleur."

msgid "tank_params/desc/heatingPerShot"
msgstr "La quantité de chaleur que le canon génère par tir."

msgid "tank_params/desc/hullArmor"
msgstr "Épaisseur du blindage de la caisse : avant / flancs / arrière respectivement."

msgid "tank_params/desc/hullTraverseDispersionTurbo"
msgstr "La pénalité à la dispersion lors de la rotation de la caisse en mode turbo."

msgid "tank_params/desc/improvedDamageEnemiesByRamming"
msgstr "Ce paramètre montre la quantité de dégâts infligés en cas de collision. Lorsque des véhicules se percutent, le système prend en compte l'épaisseur du blindage au point d'impact, la différence entre les poids des véhicules et leurs vitesses."

msgid "tank_params/desc/improvedDamageEnemiesChassisByRamming"
msgstr "Ce paramètre montre la quantité de dégâts infligés à la suspension en cas de collision. Lorsque des véhicules se percutent, le système prend en compte l'épaisseur du blindage au point d'impact, la différence entre les poids des véhicules et leurs vitesses."

msgid "tank_params/desc/invisibilityMovingFactor"
msgstr "Affiche la dissimulation du véhicule en mouvement. Plus le paramètre est élevé, mieux le véhicule est dissimulé. Les paramètres suivants sont indiqués : pour un véhicule en mouvement / pour un véhicule en mouvement après avoir tiré."

msgid "tank_params/desc/invisibilityStillFactor"
msgstr "Affiche la dissimulation du véhicule à l'arrêt. Plus le paramètre est élevé, mieux le véhicule est dissimulé. Les paramètres suivants sont indiqués : pour un véhicule à l'arrêt / pour un véhicule à l'arrêt après avoir tiré."

msgid "tank_params/desc/ionAfterburnerActiveTurboCharge"
msgstr "La quantité de charge de Postcombustion à décharge ionique générée par seconde à plus de 40 km/h en mode turbo."

msgid "tank_params/desc/ionAfterburnerDuration"
msgstr "Ce paramètre affecte la durée de Postcombustion à décharge ionique après activation."

msgid "tank_params/desc/ionAfterburnerDurationEnginePower"
msgstr "Ce paramètre affecte l'accélération, la vitesse de pointe et la vitesse de rotation de la caisse du véhicule après activation de la postcombustion à décharge ionique."

msgid "tank_params/desc/ionAfterburnerDurationSpeedCap"
msgstr "Vitesse supplémentaire gagnée après activation de la postcombustion à décharge ionique."

msgid "tank_params/desc/ionAfterburnerPassiveTurboCharge"
msgstr "La quantité de charge de Postcombustion à décharge ionique générée par seconde en mode turbo."

msgid "tank_params/desc/lowChargeShotAvgDamage"
msgstr "Dégâts moyens infligés par un tir de charge unique après un coup pénétrant. La plage des dégâts potentiels est de +/- 25 % de la valeur moyenne."

msgid "tank_params/desc/lowChargeShotBlockDuration"
msgstr "Temps avant rechargement complet pendant lequel les tirs de charge unique ne peuvent pas être effectués."

msgid "tank_params/desc/lowChargeShotDispertion"
msgstr "Augmente la dispersion du canon durant un tir de charge unique. Caractérisé par la déviation maximale des obus par rapport au point de visée à une distance de 100 m."

msgid "tank_params/desc/lowChargeShotPenetration"
msgstr "Épaisseur moyenne du blindage pouvant être pénétrée par un tir de charge unique, ajustée avec la normalisation des obus. La plage est de +/- 25 % de la valeur moyenne."

msgid "tank_params/desc/lowChargeShotRateOfFire"
msgstr "Augmente les coups par minute en utilisant des tirs de charge unique (par rapport aux tirs normaux)."

msgid "tank_params/desc/lowChargeShotVelocity"
msgstr "Vitesse d'un tir de charge unique."

msgid "tank_params/desc/maxAccuracyLevel"
msgstr "Le nombre maximal de niveaux de précision pouvant être accumulés."

msgid "tank_params/desc/maxHealth"
msgstr "Nombre de points de durabilité du véhicule."

msgid "tank_params/desc/maxSteeringLockAngle"
msgstr "L'angle maximal auquel les roues peuvent tourner. Affecte la maniabilité et le comportement du véhicule."

msgid "tank_params/desc/movementTraverseDispersionTurbo"
msgstr "La pénalité à la dispersion en mouvement en mode turbo."

msgid "tank_params/desc/overheatDuration"
msgstr "Temps nécessaire pour qu'un canon en surchauffe se refroidisse complètement. Le canon ne peut pas être utilisé pendant le refroidissement."

msgid "tank_params/desc/passiveCoincideceShootingCharge"
msgstr "La quantité de charge de Coïncidence du viseur électromécanique générée par seconde en mode engagement."

msgid "tank_params/desc/piercingPower"
msgstr "Épaisseur du blindage pouvant être pénétrée par un obus standard ajusté par la normalisation de l'obus."

msgid "tank_params/desc/pillboxHorizontalRotationSpeed"
msgstr "Vitesse de rotation de la caisse sur son axe et vitesse de changement de direction en mouvement (maniabilité)."

msgid "tank_params/desc/pillboxSwitchOffTime"
msgstr "Le temps nécessaire au basculement entre les modes dépend de l'état du moteur. Un moteur endommagé augmente le temps nécessaire pour basculer. Il devient impossible de basculer lorsque le moteur est détruit."

msgid "tank_params/desc/pillboxSwitchOnTime"
msgstr "Le temps nécessaire au basculement entre les modes dépend de l'état du moteur. Un moteur endommagé augmente le temps nécessaire pour basculer. Il devient impossible de basculer lorsque le moteur est détruit."

msgid "tank_params/desc/pillboxVerticalRotationSpeed"
msgstr "Vitesse pour basculer la caisse en avant et en arrière quand le véhicule est en mode casemate."

msgid "tank_params/desc/pitchLimits"
msgstr "Les angles verticaux maximums que le canon peut parcourir par rapport à la caisse du véhicule et en prenant en compte sa suspension."

msgid "tank_params/desc/powerModeDuration"
msgstr "Temps mis pour atteindre la vitesse maximale en marche avant et la puissance maximale du moteur en mode entraînement direct."

msgid "tank_params/desc/powerModeThreshold"
msgstr "Temps mis pour activer le mode entraînement direct."

msgid "tank_params/desc/preheatDispersionCap"
msgstr "Le bonus à la dispersion à 100 m avec une préchauffe complète."

msgid "tank_params/desc/preheatDmgCap"
msgstr "Le bonus aux dégâts moyens infligés avec une préchauffe complète."

msgid "tank_params/desc/preheatSpeedLimit"
msgstr "Dépasser cette vitesse empêche l'accumulation de préchauffe et peut entraîner sa réduction."

msgid "tank_params/desc/preheatTimeToFull"
msgstr "Temps mis par votre véhicule pour atteindre la préchauffe complète en partant de zéro."

msgid "tank_params/desc/preheatTimeToZero"
msgstr "Temps mis par votre véhicule pour retomber à zéro après une préchauffe complète."

msgid "tank_params/desc/preheatTransitionDelay"
msgstr "Durant ce délai, la préchauffe de votre véhicule n'augmente pas ni ne se réduit."

msgid "tank_params/desc/propellantChargeLimit"
msgstr "Le niveau de charge maximal pouvant être atteint sans désactiver le limiteur."

msgid "tank_params/desc/propellantChargeSpendingAfterShot"
msgstr "La quantité de charge perdue après le tir."

msgid "tank_params/desc/propellantChargingPerSec"
msgstr "La quantité de charge générée automatiquement par seconde."

msgid "tank_params/desc/propellantDischargingPerSec"
msgstr "La quantité de charge perdue par seconde après activation du limiteur, jusqu'à ce que la limite soit atteinte."

msgid "tank_params/desc/propellantOverchargeSwitchCooldown"
msgstr "Le délai après lequel le limiteur peut à nouveau être basculé."

msgid "tank_params/desc/propellantPostLimitAimingTime"
msgstr "La pénalité au temps de visée quand la limite est dépassée."

msgid "tank_params/desc/propellantPostLimitDamageBonus"
msgstr "Le bonus aux dégâts moyens octroyé par une charge complète quand la limite est dépassée."

msgid "tank_params/desc/propellantPostLimitDamageSpike"
msgstr "L'augmentation soudaine des dégâts provoquée par les tirs quand la limite est dépassée."

msgid "tank_params/desc/propellantPostLimitDispersion"
msgstr "La pénalité à la dispersion à 100 m quand la limite est dépassée."

msgid "tank_params/desc/propellantPreLimitDamageBonus"
msgstr "Le bonus aux dégâts moyens octroyé par une charge maximale quand le limiteur est actif."

msgid "tank_params/desc/radioDistance"
msgstr "Communication et transmission des informations sur la position des véhicules avec les alliés. La portée de communication est représentée par un cercle dont le rayon est défini par ce paramètre. Lorsque plusieurs cercles se superposent, les informations sont transmises à n'importe quelle distance."

msgid "tank_params/desc/reactivationDelay"
msgstr "Temps de rechargement nécessaire avant que les propulseurs puissent être à nouveau activés après utilisation."

msgid "tank_params/desc/reactivationLimit"
msgstr "Le niveau de chaleur maximal pouvant être atteint avant que les propulseurs ne puissent plus être réactivés."

msgid "tank_params/desc/relativeArmor"
msgstr "Un ensemble de paramètres indiquant la résistance du véhicule aux dégâts infligés par les véhicules ennemis."

msgid "tank_params/desc/relativeCamouflage"
msgstr "Un ensemble de paramètres indiquant l'efficacité de la dissimulation lorsque votre véhicule est à l'arrêt, en mouvement ou qu'il tire. Le camouflage appliqué augmente le paramètre de dissimulation."

msgid "tank_params/desc/relativeMobility"
msgstr "Un ensemble de paramètres indiquant la vitesse à laquelle le véhicule peut changer de position sur le champ de bataille."

msgid "tank_params/desc/relativePower"
msgstr "Un ensemble de paramètres indiquant l'efficacité de la destruction de véhicules ennemis."

msgid "tank_params/desc/relativeVisibility"
msgstr "Un ensemble de paramètres indiquant l'efficacité de la détection des véhicules ennemis."

msgid "tank_params/desc/reloadTime"
msgstr "Nombre de coups par minute."

msgid "tank_params/desc/reloadTimeCoincidence"
msgstr "Le bonus au temps de rechargement du canon octroyé tant que le viseur est actif."

msgid "tank_params/desc/reloadTimeSecs"
msgstr "Temps nécessaire pour recharger le canon (ou les deux canons pour les véhicules équipés d'un système de canon jumelé) après avoir tiré."

msgid "tank_params/desc/reloadTimeSecs/twinGun"
msgstr "Temps de rechargement du canon après avoir tiré (mode tir unique/mode tir salve)."

msgid "tank_params/desc/reverseSpeedReductionWithBoosters"
msgstr "La réduction de la vitesse en marche arrière du véhicule tant que les propulseurs sont actifs."

msgid "tank_params/desc/rocketAccelerationEnginePower"
msgstr "Ce paramètre affecte l'accélération, la vitesse maximale et la vitesse de rotation de la caisse du véhicule."

msgid "tank_params/desc/rocketAccelerationReuseAndDuration"
msgstr "Des propulseurs pouvant augmenter la puissance du moteur et la vitesse maximale. Une fois activés, les propulseurs réduisent la maniabilité et ils ne peuvent pas être éteints manuellement."

msgid "tank_params/desc/rocketAccelerationSpeedLimits"
msgstr "Vitesse nominale du véhicule avec propulseurs activés."

msgid "tank_params/desc/secondaryAvgDamage"
msgstr "Dégâts moyens infligés par un obus d'un armement auxiliaire après un coup pénétrant. La plage des dégâts potentiels est de +/- 25 % de la valeur moyenne."

msgid "tank_params/desc/secondaryAvgPiercingPower"
msgstr "Épaisseur moyenne du blindage pénétrée par un obus d'un armement auxiliaire ajustée avec la normalisation des obus. La plage est de +/- 25 % de la valeur moyenne."

msgid "tank_params/desc/secondaryReloadTimeSecs"
msgstr "Temps de rechargement des armements auxiliaires après avoir tiré."

msgid "tank_params/desc/secondaryTotalBurstSize"
msgstr "Nombre d'obus disponibles pour les armements auxiliaires durant chaque activation."

msgid "tank_params/desc/shellLoadingTime"
msgstr "Temps nécessaire pour charger des obus au début de la bataille et pour basculer entre les différents types d'obus."

msgid "tank_params/desc/shotDispersionAngle"
msgstr "La dispersion du canon est caractérisée par la déviation maximale de l'obus depuis le point de visée à une distance de 100 mètres."

msgid "tank_params/desc/shotDispersionAngle/twinGun"
msgstr "La dispersion du canon caractérisée par la déviation maximale de l'obus depuis le point de visée à une distance de 100 m (mode standard/spécial)."

msgid "tank_params/desc/shotDispersionAngle/withDualAccuracy"
msgstr "Montre dans quelle mesure l'obus peut dévier du point de visée en mètres à 100 mètres de la cible. La valeur standard (la première) correspond à un canon chauffé, la valeur améliorée (la deuxième) correspond à un canon refroidi."

msgid "tank_params/desc/speedLimits"
msgstr "Vitesse du véhicule telle que définie dans ses caractéristiques techniques."

msgid "tank_params/desc/stagedJetBoostersChargeDuration"
msgstr "Durée maximale du boost après activation du réacteur."

msgid "tank_params/desc/stagedJetBoostersChargesCount"
msgstr "Nombre d'activations possibles des réacteurs par bataille."

msgid "tank_params/desc/stagedJetBoostersCooldownTime"
msgstr "Temps de rechargement après utilisation avant de pouvoir activer à nouveau les réacteurs."

msgid "tank_params/desc/stagedJetBoostersEnginePower"
msgstr "Le bonus à l'accélération du véhicule quand les réacteurs sont actifs."

msgid "tank_params/desc/stagedJetBoostersRotationSpeed"
msgstr "Le bonus à la vitesse de rotation de la caisse du véhicule quand les réacteurs sont actifs."

msgid "tank_params/desc/stagedJetBoostersSpeedLimits"
msgstr "Vitesse du véhicule telle que définie dans ses caractéristiques techniques."

msgid "tank_params/desc/stagedJetBoostersTopSpeed"
msgstr "Le bonus à la vitesse maximale du véhicule quand les réacteurs sont actifs."

msgid "tank_params/desc/stationaryReloadSwitchOffTime"
msgstr "Temps avant que la tourelle soit déverrouillée et que le véhicule puisse à nouveau tirer après avoir interrompu le processus de rechargement."

msgid "tank_params/desc/stationaryReloadSwitchOnTime"
msgstr "Temps mis pour lier la tourelle avec les capsules de munitions externes et lancer le processus de rechargement."

msgid "tank_params/desc/stunMaxDuration"
msgstr "Affiche la durée maximale d'étourdissement appliquée à un équipage ennemi si l'obus explosif pénètre le blindage d'un véhicule sans équipement ni consommable réduisant la durée de l'étourdissement et infligeant le maximum de dégâts."

msgid "tank_params/desc/stunMinDuration"
msgstr "Affiche la durée minimale d'étourdissement appliquée à un équipage ennemi si le véhicule ennemi est situé dans le rayon des dégâts et qu'il n'est pas équipé d'équipement ni de consommable réduisant la durée d'étourdissement."

msgid "tank_params/desc/switchEngineModeBothModes"
msgstr "Temps mis pour basculer entre les modes engagement et turbo."

msgid "tank_params/desc/switchOffTime"
msgstr "Le temps nécessaire au basculement entre les modes dépend de l'état du moteur. Un moteur endommagé augmente le temps nécessaire pour basculer. Il devient impossible de basculer lorsque le moteur est détruit."

msgid "tank_params/desc/switchOnTime"
msgstr "Le temps nécessaire au basculement entre les modes dépend de l'état du moteur. Un moteur endommagé augmente le temps nécessaire pour basculer. Il devient impossible de basculer lorsque le moteur est détruit."

msgid "tank_params/desc/switchTime"
msgstr "Le temps nécessaire au basculement entre les modes dépend de l'état du moteur. Un moteur endommagé augmente le temps nécessaire pour basculer. Il devient impossible de basculer lorsque le moteur est détruit."

msgid "tank_params/desc/temperatureAimingTime"
msgstr "Temps de visée pour un canon brûlant et complètement refroidi."

msgid "tank_params/desc/temperatureAvgDamagePerMinute"
msgstr "La quantité de dégâts qui peut potentiellement être infligée à un véhicule ennemi en une minute si tous les obus pénètrent le blindage."

msgid "tank_params/desc/temperatureReloadTime"
msgstr "Nombre de coups par minute."

msgid "tank_params/desc/temperatureShotDispersionAngle"
msgstr "Taille du cercle de visée à 100 m pour un canon brûlant et complètement refroidi."

msgid "tank_params/desc/timeOfReaching"
msgstr "Ce paramètre est un coefficient de résistance du sol exprimé par le temps que met un véhicule à parcourir 100 m depuis une position arrêtée, sur du plat.\nLes valeurs sont indiquées pour les sols fermes, moyens et meubles."

msgid "tank_params/desc/timeToOverheat"
msgstr "Durée maximale pendant laquelle le canon peut tirer en continu avant sa surchauffe et qu'il ne puisse plus tirer."

msgid "tank_params/desc/topSpeedWithBoosters"
msgstr "Le bonus à la vitesse maximale du véhicule octroyé par les propulseurs."

msgid "tank_params/desc/traverseSpeedReductionWithBoosters"
msgstr "La réduction de la vitesse de rotation de la caisse tant que les propulseurs sont actifs."

msgid "tank_params/desc/turboSpeedCap"
msgstr "Vitesse supplémentaire acquise par le véhicule en mode turbo."

msgid "tank_params/desc/turboshaftBurstFireRate"
msgstr "Temps de chargement entre les obus du conteneur. / Nombre de conteneurs dans le barillet. / Nombre d'obus dans un conteneur."

msgid "tank_params/desc/turboshaftEnginePower"
msgstr "Ce paramètre affecte l'accélération, la vitesse maximale et la vitesse de rotation de la caisse du véhicule avec une turbine chargée."

msgid "tank_params/desc/turboshaftInvisibilityMovingFactor"
msgstr "Affiche la dissimulation du véhicule en mouvement avec une turbine chargée. Plus le paramètre est élevé, mieux le véhicule est dissimulé. Les paramètres suivants sont indiqués : pour un véhicule en mouvement / pour un véhicule en mouvement après avoir tiré."

msgid "tank_params/desc/turboshaftInvisibilityStillFactor"
msgstr "Affiche la dissimulation du véhicule immobile avec une turbine chargée. Plus le paramètre est élevé, mieux le véhicule est dissimulé. Les paramètres suivants sont indiqués : pour un véhicule à l'arrêt / pour un véhicule à l'arrêt après avoir tiré."

msgid "tank_params/desc/turboshaftSpeedModeSpeed"
msgstr "Vitesse nominale du véhicule avec une turbine chargée."

msgid "tank_params/desc/turboshaftSwitchTime"
msgstr "Temps nécessaire pour charger la turbine au maximum. / Temps pour revenir en mode de fonctionnement standard."

msgid "tank_params/desc/turretArmor"
msgstr "Épaisseur du blindage de la tourelle : avant / flancs / arrière respectivement."

msgid "tank_params/desc/turretRotationSpeed"
msgstr "Degrés de rotation du canon par seconde dans l'arc de tir dans une tourelle ou casemate stationnaire (mode standard/spécial)."

msgid "tank_params/desc/turretYawLimits"
msgstr "Angles maximaux de la rotation de la tourelle en respectant l'axe longitudinal du véhicule lorsque la caisse est immobile."

msgid "tank_params/desc/twinGunSwitchFireModeTime"
msgstr "Temps pour passer du mode tir unique au mode tir salve et inversement."

