msgid "#PluralForms"
msgstr "nplurals=2; plural=(n > 1);"

msgid "boxTooltip/description/text/fractal_cn_common"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules, des devises du jeu et d'autres récompenses précieuses."

msgid "boxTooltip/description/text/fractal_cn_epic"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules rares, des devises du jeu, des éléments de personnalisation et d'autres récompenses précieuses."

msgid "boxTooltip/description/text/fractal_cn_rare"
msgstr "À leur ouverture, ces boîtes peuvent vous rapporter des véhicules, des devises du jeu, des éléments de personnalisation et d'autres récompenses précieuses."

msgid "boxTooltip/howGet/text/fractal_cn_common"
msgstr "Peut être obtenue dans le Magasin en jeu ou en ouvrant des boîtes de tout autre type."

msgid "boxTooltip/howGet/text/fractal_cn_epic"
msgstr "Peut être reçue en ouvrant des boîtes de n'importe quel autre type."

msgid "boxTooltip/howGet/text/fractal_cn_rare"
msgstr "Peut être reçue en ouvrant des boîtes de n'importe quel autre type."

msgid "common/boxCategory/lowerCase/fractal_cn_common"
msgstr "Boîte céleste"

msgid "common/boxCategory/lowerCase/fractal_cn_epic"
msgstr "Boîte de l'élu"

msgid "common/boxCategory/lowerCase/fractal_cn_rare"
msgstr "Boîte de l'aide divine"

msgid "common/boxCategory/upperCase/fractal_cn_common"
msgstr "BOÎTE CÉLESTE"

msgid "common/boxCategory/upperCase/fractal_cn_epic"
msgstr "BOÎTE DE L'ÉLU"

msgid "common/boxCategory/upperCase/fractal_cn_rare"
msgstr "BOÎTE DE L'AIDE DIVINE"

msgid "entryPoint/tooltip/description"
msgstr "Il s'agit de boîtes spéciales contenant des objets nouveaux et uniques. Elles peuvent être obtenues dans le Magasin en jeu."

msgid "entryPoint/tooltip/timerText"
msgstr "L'évènement se terminera dans"

msgid "eventName/lowerCase"
msgstr "Bénédiction divine"

msgid "eventName/upperCase"
msgstr "BÉNÉDICTION DIVINE"

msgid "guaranteed/tooltip/description1/"
msgstr "Si vous possédez déjà tous les véhicules, vous recevrez une Boîte de l'élu à la place."

msgid "infoPage/footer/description/compensation"
msgstr "Si vous possédez déjà tous les véhicules disponibles dans ces boîtes, vous recevrez une Boîte de l'élu en récompense à la place d'un véhicule."

msgid "infoPage/footer/description/guaranteed"
msgstr "Chaque %(guaranteed0)s Boîte céleste, %(guaranteed1)s Boîte de l'aide divine et %(guaranteed2)s Boîte de l'élu contient assurément un véhicule. Si vous en ouvrez une qui ne contient pas un tel véhicule, alors un véhicule que vous ne possédez pas encore sera obtenu en ouvrant la %(guaranteed0)se/%(guaranteed1)se/%(guaranteed2)se boîte (en fonction du type de boîte). Lorsque cela se produit, le compteur est réinitialisé."

msgid "infoPage/footer/title/compensation"
msgstr "Compensation"

msgid "infoPage/footer/title/guaranteed"
msgstr "Récompense garantie"

msgid "infoPage/header/rewards/description"
msgstr "Il n'est pas possible d'obtenir plus d'une récompense par groupe"
