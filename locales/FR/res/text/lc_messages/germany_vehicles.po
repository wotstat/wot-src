msgid "H39_captured_descr"
msgstr "Au cours de la bataille de France, l'Allemagne a capturé environ 600 véhicules Hotchkiss 39. Ils ont été modifiés et ont continué à servir au sein des unités de la Wehrmacht."

msgid "H39_captured_short"
msgstr "Pz. 38H"

