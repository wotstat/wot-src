msgid "PzII_J"
msgstr "Pz.Kpfw. II Ausf. J"

msgid "PzII_J_descr"
msgstr "Char de reconnaissance avec blindage renforcé. Le véhicule était un développement ultérieur du Pz.Kpfw. II. En octobre 1939, un lot de préproduction fut commandé, et le premier prototype fut fabriqué en juillet 1940. De 1943 à 1944, sept véhicules furent utilisés par la 12e division Panzer sur le Front de l'Est. Un total de 22 chars ont été fabriqués."

msgid "PzII_J_short"
msgstr "Pz. II J"

msgid "PzII_ausf_J"
msgstr "Pz.Kpfw. II Ausf. J"

