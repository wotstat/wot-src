msgid "PzVI_MapsTraining_Player_HT_2"
msgstr "Tiger I (tr.)"

msgid "PzVI_Porsche_Turm_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_Porsche_Turm_short_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger\nAusf. E"

msgid "PzVI_Standardketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. VI H Ausf. H1"

msgid "PzVI_Vetstaerktketten_MapsTraining_Player_HT_2"
msgstr "Pz.Kpfw. Tiger Ausf. E"

msgid "PzVI_descr_MapsTraining_Player_HT_2"
msgstr "Le développement a débuté en 1937 par la compagnie Henschel. Il est entré en production en série en 1942, avec un total de 1 354 véhicules fabriqués. Il a été vu en combat pour la première fois dans les batailles de Leningrad. Il a pris part à des actions en Tunisie et dans la bataille de Koursk. Bien que sa production a été arrêtée pendant l'été 1944, le Tiger I a été utilisé jusqu'à la fin de la guerre."

msgid "PzV_PzIV"
msgstr "Pz.Kpfw. V/IV"

msgid "PzV_PzIV_CN"
msgstr "Pz.Kpfw. V Berge-Panther"

msgid "PzV_PzIV_CN_descr"
msgstr "Le véhicule a été produit par la société de maintenance et récupération du 653e bataillon lourd Panzerjäger sur la base du Bergepanther ARV et de la tourelle du Pz. IV."

msgid "PzV_PzIV_CN_short"
