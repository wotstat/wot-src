msgid "PzIV_Hydro"
msgstr "Pz.Kpfw. IV hydrostat."

msgid "PzIV_Hydro_descr"
msgstr "Le développement de véhicules incorporant une transmission hydrostatique placée à l'arrière a débuté en Allemagne en 1944. Le châssis du Pz. IV Ausf. G a été utilisé pour des essais à ce sujet. Le premier prototype a été fabriqué fin octobre 1944. Seul un véhicule a été fabriqué."

msgid "PzIV_Hydro_short"
msgstr "Pz. IV hydr."

msgid "PzIV_Schmalturm_A"
msgstr "Pz.Kpfw. IV Schmalturm"

msgid "PzIV_Standart"
