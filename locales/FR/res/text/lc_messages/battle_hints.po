msgid "hint/LSH_FIRE"
msgstr "La fumée rend difficile la détection des véhicules ennemis et la communication de leurs positions. L'incendie inflige des dégâts aux véhicules."

msgid "hint/LSH_FOG"
msgstr "Le brouillard rend difficile la détection des véhicules ennemis et la communication de leurs positions."

msgid "hint/LSH_RAIN"
msgstr "La pluie battante rend difficile la détection des véhicules ennemis et la communication de leurs positions."

msgid "hint/LSH_SANDSTORM"
msgstr "Les tempêtes de sable rendent difficile la détection des véhicules ennemis et la communication de leurs positions."

msgid "hint/LSH_SMOKE"
msgstr "La fumée rend difficile la détection des véhicules ennemis et la communication de leurs positions."

msgid "hint/PPH_AIMING_01"
msgstr "Le mouvement du véhicule et de la tourelle réduisent la <font color='#EE7000'>précision du canon</font>"

msgid "hint/PPH_AIMING_02"
msgstr "Le cercle situé autour du réticule indique la <font color='#EE7000'>précision du canon</font>. Attendez un instant pour profiter d'un tir plus précis."

msgid "hint/PPH_AUTO_AIMING_01"
msgstr "<font color='#EE7000'>Visée automatique</font> activée. Cliquez sur le bouton droit de la souris pour annuler."

msgid "hint/PPH_AUTO_AIMING_02"
msgstr "La Visée automatique pointe toujours votre canon <font color='#EE7000'>au centre</font> du véhicule ciblé"

msgid "hint/PPH_BASE_CAPTURE_01"
msgstr "Votre base se fait <font color='#EE7000'>capturer !</font> Si vous ne parvenez pas à repousser les ennemis, la bataille sera perdue."

msgid "hint/PPH_BASE_CAPTURE_02"
msgstr "Chaque véhicule ennemi possède <font color='#EE7000'>sa propre</font> progression de capture"

msgid "hint/PPH_BASE_CAPTURE_03"
msgstr "<font color='#EE7000'>Capturer</font> la base ennemie est une des façons de remporter la partie"

msgid "hint/PPH_BASE_CAPTURE_04"
msgstr "Lorsque vous subissez des dégâts, votre progression de capture <font color='#EE7000'>est remise à zéro</font>"

msgid "hint/PPH_BASE_CAPTURE_05"
msgstr "Lorsque vous quittez le cercle de capture de la base, votre progression de capture <font color='#EE7000'>est perdue</font>"

msgid "hint/PPH_BASE_CAPTURE_06"
msgstr "La capture de la base est <font color='#EE7000'>plus rapide</font> lorsque plusieurs véhicules sont présents"

msgid "hint/PPH_BASE_CAPTURE_07"
msgstr "La vitesse de capture de la base n'augmente plus après le <font color='#EE7000'>troisième</font> véhicule"

msgid "hint/PPH_BASE_CAPTURE_08"
msgstr "La base ennemie est presque capturée !"

msgid "hint/PPH_BASE_CAPTURE_09"
msgstr "Votre équipe est en train de gagner la course à la capture de base !"

msgid "hint/PPH_CONSUMABLES_01"
msgstr "Élément du véhicule sérieusement endommagé ! Réparez-le à l'aide <font color='#EE7000'>d'un Kit de réparation</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_02"
msgstr "Élément du véhicule sérieusement endommagé ! Réparez-le à l'aide <font color='#EE7000'>du Kit de réparation</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_03"
msgstr "Membre d'équipage grièvement blessé ! Soignez-le à l'aide <font color='#EE7000'>d'une Trousse de premiers secours</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_04"
msgstr "Membre d'équipage grièvement blessé ! Soignez-le à l'aide <font color='#EE7000'>de la Trousse de premiers secours</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_05"
msgstr "Équipage du véhicule étourdi ! Soignez-les à l'aide <font color='#EE7000'>d'une Trousse de premiers secours</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_06"
msgstr "Véhicule en feu ! Utilisez <font color='#EE7000'>un Extincteur</font> dans le panneau du bas."

msgid "hint/PPH_CONSUMABLES_07"
msgstr "Véhicule en feu ! <font color='#EE7000'>Extincteur automatique</font> activé."

msgid "hint/PPH_CONSUMABLES_08"
msgstr "Élément du véhicule sérieusement endommagé ! Équiper <font color='#EE7000'>un Kit de réparation</font> avant la bataille permet de remédier aux dégâts critiques."

msgid "hint/PPH_CONSUMABLES_09"
msgstr "Membre d'équipage grièvement blessé ! Équiper <font color='#EE7000'>une Trousse de premiers secours</font> avant la bataille permet de remédier aux blessures de l'équipage."

msgid "hint/PPH_CONSUMABLES_10"
msgstr "Véhicule en feu ! Équiper <font color='#EE7000'>un Extincteur</font> avant la bataille permet de remédier aux incendies."

msgid "hint/PPH_OTHER_01"
msgstr "Vous avez été <font color='#EE7000'>repéré</font> : effectuer un tir peut révéler votre position !"

msgid "hint/PPH_OTHER_02"
msgstr "Votre véhicule a été détruit. Vous pouvez appuyer sur la touche <font color='#EE7000'>Échap</font> pour quitter la bataille sans pénalité."

msgid "hint/PPH_OTHER_03"
msgstr "Votre véhicule a été détruit. Vous pouvez cliquer sur le bouton de la souris pour passer en <font color='#EE7000'>mode Spectateur</font> et suivre vos coéquipiers."

msgid "hint/PPH_OTHER_04"
msgstr "<font color='#EE7000'>L'icône ampoule</font> indique que vous avez été repéré par les ennemis !"

msgid "hint/PPH_OTHER_05"
msgstr "Votre canon est encore <font color='#EE7000'>en cours de rechargement</font>"

msgid "hint/PPH_OTHER_06"
msgstr "Votre canon ne peut tirer que si le cercle autour du réticule est <font color='#EE7000'>entièrement vert</font>"

msgid "hint/PPH_SNIPER_01"
msgstr "Vous pouvez faire défiler la molette de la souris pour passer en <font color='#EE7000'>mode tireur de précision</font>"

msgid "hint/PPH_SNIPER_02"
msgstr "Vous pouvez faire défiler la molette de la souris pour <font color='#EE7000'>quitter</font> le mode tireur de précision"

msgid "hint/PPH_WEAK_SPOTS_01"
msgstr "Un <font color='#EE7000'>réticule intérieur vert</font> indique une chance élevée de pénétrer le blindage de l'ennemi"

msgid "hint/PPH_WEAK_SPOTS_02"
msgstr "Même lorsque le réticule intérieur est vert, la pénétration du blindage <font color='#EE7000'>n'est pas garantie</font>"

msgid "hint/PPH_WEAK_SPOTS_03"
msgstr "Les canons ne sont pas précis à 100 % et les tirs ne finissent <font color='#EE7000'>pas toujours au centre</font> du réticule"

msgid "hint/PPH_WEAK_SPOTS_04"
msgstr "Le réticule intérieur indique la chance de pénétrer le blindage ennemi. <font color='#EE7000'>Activez-le dans Paramètres</font>."

msgid "penetration/chance/high"
msgstr "Forte probabilité"

msgid "penetration/chance/low"
msgstr "Faible probabilité"

msgid "penetration/chance/medium"
msgstr "Moyenne probabilité"
