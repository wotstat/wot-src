msgstr "Jeu de l'Abracadabra"

msgid "projection_decals/special/projection_decal_127/description"
msgstr "Comment choisit-on le nom d'un char suédois ? C'est simple ! Mettez toutes les lettres dans une boîte, remuez-les et jetez-les sur la table. Bonne chance pour essayer de le prononcer."

msgid "projection_decals/special/projection_decal_128"
msgstr "Étourdissement ultime"

msgid "projection_decals/special/projection_decal_128/description"
msgstr "L'effet d'étourdissement d'un obus de T92 HMC est si puissant qu'il vous fera voir des étoiles en plein jour."

