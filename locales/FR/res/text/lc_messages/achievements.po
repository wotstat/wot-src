msgstr "Maître de l'attaque"

msgid "occupyingForce_condition"
msgstr "• Uniquement en Ligne de front."

msgid "occupyingForce_descr"
msgstr "En tant qu'attaquant, gagner un total de 100 points de capture de base ou détruire un objectif principal ennemi."

msgid "october19"
msgstr "Toujours attentif"

msgid "october19_descr"
msgstr "Une médaille unique décernée lors de l'évènement spécial."

msgid "october20"
msgstr "Reine Maeve"

msgid "october20_descr"
msgstr "Une médaille unique incluse avec Prime Gaming."

