msgstr "Chasseur de Tiger"

msgid "onboardingMedal_condition"
msgstr "Décernée pour avoir terminé l'Opération Avalanche d'acier et l'Opération Trappeur dans l'histoire Chasseur de Tiger."

msgid "onboardingMedal_descr"
msgstr "Terminez les histoires d'ouverture de Chasseur de Tiger"

msgid "oowCBTParticipant"
msgstr "Répétition"

msgid "oowCBTParticipant_condition"
msgstr "Décernée lors du bêta-test d'Ordre de guerre 2021."

msgid "oowCBTParticipant_descr"
msgstr "Disputer au moins une bataille lors du bêta-test d'Ordre de guerre."

msgid "oowCompetetiveWin"
msgstr "Échec et mat"

msgid "oowCompetetiveWin_condition"
msgstr "Décernée lors d'Art de la Stratégie 2022."

msgid "oowCompetetiveWin_descr"
msgstr "Remporter une bataille face à un Stratège en jouant en tant que Stratège."

msgid "oowStrategistWins"
msgstr "Génie tactique"

