msgid "vo_sm_char10_m05_stg21_02"
msgstr "Officier du QG : La tête de pont Echo-5 est sécurisée. Les chars progressent. Offrez-leur des tirs de soutien."

msgid "vo_sm_char10_m05_stg21_03"
msgstr "Officier du QG : Redirigez le soutien aérien pour aider la progression des chars."

msgid "vo_sm_char10_m05_stg21_04"
msgstr "Officier du QG : Aux équipes du génie, dégagez les obstacles pour que la progression reprenne."

msgid "vo_sm_char10_m05_stg21_05"
msgstr "?empty?"

msgid "vo_sm_char10_m05_stg28_01"
msgstr "Officier du QG : La plage est dégagée. Envoi des forces principales. Excellent travail."

msgid "vo_sm_char10_m05_stg28_04"
msgstr "Officier du QG : Tenez bon. Les renforts sont en route."

msgid "vo_sm_char10_m05_stg28_04_01"
msgstr "Officier du QG : Protégez la tête de pont coûte que coûte."

msgid "vo_sm_char10_m05_stg45_06"
msgstr "Officier du QG : Un autre char, une autre chance. Soyez prudent cette fois."

msgid "vo_sm_char10_m05_stg45_07"
msgstr "Officier du QG : Nos réserves s'amenuisent. Ne gâchez pas cette occasion, commandant."

