msgid "teamRepairKit/name"
msgstr "Réparations de groupe"

msgid "teamRepairKit/onUse"
msgstr "Répare instantanément les éléments, éteint les incendies, retire les effets d'étourdissement et restaure une partie des points de structure des véhicules alliés dans son rayon."

msgid "teamRepairKit/restriction"
msgstr "?empty?"

msgid "teamRepairKit/short_special"
msgstr "Répare et rétablit une partie des points de structure des véhicules alliés dans son rayon."
