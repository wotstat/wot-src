msgid "adaptationHealthRestore/battleDescr"
msgstr "Rétablit instantanément %(immediatelyRestore)s des points de structure du véhicule. Durant les %(duration)s s de la durée de cette capacité, tous les dégâts subis par des obus et des capacités de combat s'accumuleront et seront convertis en points de structure et %(restoringCoefficient)s du total reçu en plus lorsque la capacité prendra fin.\n\n*La récupération des PS convertis affecte également les véhicules alliés dans un petit rayon."

msgid "adaptationHealthRestore/descr"
msgstr "Rétablit instantanément %(immediatelyRestore)s des points de structure du véhicule. Durant les %(duration)s s de la durée de cette capacité, tous les dégâts subis par des obus et des capacités de combat s'accumuleront et seront convertis en points de structure et %(restoringCoefficient)s du total reçu en plus lorsque la capacité prendra fin.\n\n*La récupération des PS convertis affecte également les véhicules alliés dans un petit rayon."

msgid "adaptationHealthRestore/longDescr"
msgstr "{green_Open}Rétablit instantanément %(immediatelyRestore)s{green_Close} des points de structure du véhicule. Durant les {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} de la durée de cette capacité, tous les dégâts subis par des obus et des capacités de combat s'accumuleront et seront convertis en points de structure et {green_Open}%(restoringCoefficient)s du total des dégâts reçus en plus{green_Close} lorsque la capacité prendra fin.\n\n*La récupération des PS convertis affecte également les véhicules alliés dans un petit rayon."

msgid "adaptationHealthRestore/name"
msgstr "Blindage adaptatif"

msgid "adaptationHealthRestore/shortDescr"
msgstr "{green_Open}Rétablit instantanément %(immediatelyRestore)s{green_Close} des points de structure du véhicule. Durant les {whiteSpanish_Open}%(duration)s s{whiteSpanish_Close} de la durée de cette capacité, tous les dégâts subis par des obus et des capacités de combat s'accumuleront et seront convertis en points de structure et {green_Open}%(restoringCoefficient)s du total des dégâts reçus en plus{green_Close} lorsque la capacité prendra fin.\n\n*La récupération des PS convertis affecte également les véhicules alliés dans un petit rayon."

msgid "additInvisibilityDeviceBattleBooster/descr"
msgstr "%s à la dissimulation d'un véhicule immobile ou en mouvement avec Silencieux de système d'échappement (toute classe) ou Silencieux de système d'échappement de prime installé."

msgid "additInvisibilityDeviceBattleBooster/gain/deluxe"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/gain/simple"
msgstr "+2 %"

msgid "additInvisibilityDeviceBattleBooster/long_special"
msgstr "Améliore les effets de Silencieux de système d'échappement ou Silencieux de système d'échappement de prime au cours de la bataille. Cette directive ne fonctionnera que si l'équipement correspondant est installé."

msgid "additInvisibilityDeviceBattleBooster/name"
msgstr "Isolation d'échappement"

msgid "additInvisibilityDeviceBattleBooster/short_special"
msgstr "Augmente la dissimulation du véhicule immobile ou en mouvement"

msgid "additionalInvisibilityDevice/long_special"
msgstr "L'efficacité dépend du type de véhicule. Augmente la dissimulation d'un véhicule immobile ou en mouvement. Utile pour la reconnaissance active, ainsi que pour la reconnaissance passive à des positions risquées."

msgid "additionalInvisibilityDevice/name"
msgstr "Silencieux de système d'échappement"

msgid "additionalInvisibilityDevice/short_special"
msgstr "Augmente la dissimulation du véhicule immobile ou en mouvement."

msgid "additionalInvisibilityDevice_tier1/name"
msgstr "Silencieux de système d'échappement Classe 1"

msgid "additionalInvisibilityDevice_tier2/name"
msgstr "Silencieux de système d'échappement Classe 2"

msgid "additionalInvisibilityDevice_tier3/name"
msgstr "Silencieux de système d'échappement Classe 3"

msgid "additional_armor_plates_1/name"
msgstr "Plaques de blindage supplémentaires (Type 1)"

msgid "additional_armor_plates_2/name"
msgstr "Plaques de blindage supplémentaires (Type 2)"

msgid "afterburning/descr"
msgstr "Augmente la vitesse et l'accélération de votre véhicule pour une durée limitée."

msgid "afterburning/name"
msgstr "Turbocompresseur"

msgid "aimingStabilizer/long_special"
msgstr "La réduction de la dispersion de votre canon est importante : plus la dispersion initiale est petite, plus le cercle de visée est petit et moins il faut de temps pour viser complètement. En outre, un tir à la volée (qui est tiré sans viser complètement ou en mouvement) a de meilleures chances d'atteindre sa cible."

msgid "aimingStabilizer/name"
msgstr "Stabilisateur vertical"

msgid "aimingStabilizerBattleBooster/descr"
msgstr "%s à la dispersion après avoir tiré, en mouvement et lors de la rotation de la tourelle avec un Stabilisateur vertical, un Système de stabilisation d'équipement ou un Stabilisateur de prime installé."

msgid "aimingStabilizerBattleBooster/gain/deluxe"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/gain/simple"
msgstr "-5 %"

msgid "aimingStabilizerBattleBooster/long_special"
msgstr "Améliore les effets du Stabilisateur vertical (n'importe quelle classe), du Système de stabilisation et du Stabilisateur de prime au cours de la bataille. Ces pièces d'équipement doivent être installées à bord du véhicule pour équiper cette directive."

msgid "aimingStabilizerBattleBooster/name"
msgstr "Graissage du stabilisateur"

msgid "aimingStabilizerBattleBooster/short_special"
msgstr "Améliore les effets du stabilisateur"

msgid "aimingStabilizer_Mk1/name"
msgstr "Stabilisateur vertical Classe 1"

msgid "aimingStabilizer_Mk2/name"
msgstr "Stabilisateur vertical Classe 2"

msgid "aimingStabilizer_tier1/name"
msgstr "Stabilisateur vertical Classe 1"

msgid "aimingStabilizer_tier2/name"
msgstr "Stabilisateur vertical Classe 2"

msgid "antifragmentationLining/long_special"
msgstr "Les revêtements anti-éclats absorbent les dégâts ; cela signifie qu'ils réduisent les dégâts lors des collisions ou ceux infligés par les obus explosifs. Les revêtements anti-éclats seront profitables sur les chars lourds au blindage fiable et au fort potentiel de dégâts par collision puisqu'ils combattent en combat rapproché."

msgid "antifragmentationLining/name"
msgstr "Revêtement anti-éclats"

msgid "antifragmentationLining/short_special"
msgstr "Protège le véhicule et l'équipage contre les obus explosifs, les blessures, l'étourdissement et les collisions"

msgid "antifragmentationLining_tier1/name"
msgstr "Revêtement anti-éclats (Très lourd)"

msgid "antifragmentationLining_tier2/name"
msgstr "Revêtement anti-éclats (Lourd)"

msgid "antifragmentationLining_tier3/name"
msgstr "Revêtement anti-éclats (Moyen)"

msgid "antifragmentationLining_tier4/name"
msgstr "Revêtement anti-éclats (Léger)"

