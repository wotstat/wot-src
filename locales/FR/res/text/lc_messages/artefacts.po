msgid "artillery/longDescr"
msgstr "Demande à l'artillerie de tirer des obus explosifs sur une petite zone. Les véhicules au centre de la zone d'impact subissent le plus de dégâts. Particulièrement efficace contre les véhicules lourdement blindés."

msgid "artillery/name"
msgstr "Frappe d'artillerie"

msgid "artillery/shortDescr"
msgstr "Inflige des dégâts considérables aux véhicules ennemis dans un petit rayon."

msgid "autoExtinguishers/always"
msgstr "%(vehicleFireChance)s à la probabilité que le moteur prenne feu"

msgid "autoExtinguishers/descr"
msgstr "Éteint le feu automatiquement dans votre véhicule."

msgid "autoExtinguishers/long_special"
msgstr "Éteint automatiquement un incendie tout en réduisant la probabilité que le véhicule ne reprenne feu. Ce consommable convient à tous les types de véhicules de toutes les nations."

msgid "autoExtinguishers/name"
msgstr "Extincteur automatique"

msgid "autoExtinguishers/onUse"
msgstr "Éteint automatiquement l'incendie dans votre véhicule. Peut être utilisé à plusieurs reprises lors d'une bataille. Le consommable est retiré à la fin de la bataille s'il a été utilisé au moins une fois."

msgid "autoExtinguishers/restriction"
msgstr "?empty?"

msgid "autoExtinguishers/short_special"
msgstr "Éteint automatiquement les incendies"

msgid "berserker/battleDescr"
msgstr "Multiplie la pénétration et la cadence de tir par %(gunPiercing)s tout en augmentant l'efficacité de la visée et la stabilisation du canon de %(gunAimingTime)s, mais retire %(healthDebuff)s du total de PS de votre véhicule sur sa durée de %(duration)s s.\n\n*Les dégâts infligés par la capacité Berserker ne peuvent pas détruire votre véhicule."

msgid "berserker/descr"
msgstr "Multiplie la pénétration et la cadence de tir par %(gunPiercing)s tout en augmentant l'efficacité de la visée et la stabilisation du canon de %(gunAimingTime)s, mais retire %(healthDebuff)s du total de PS de votre véhicule sur sa durée de %(duration)s s.\n\n*Les dégâts infligés par la capacité Berserker ne peuvent pas détruire votre véhicule."

msgid "berserker/longDescr"
msgstr "Multiplie la pénétration et la cadence de tir {green_Open}par %(gunPiercing)s{green_Close} tout en augmentant l'efficacité de la visée et la stabilisation du canon {green_Open}de %(gunAimingTime)s{green_Close}, mais retire {red_Open}%(healthDebuff)s{red_Close} du total de PS de votre véhicule sur sa durée {whiteSpanish_Open}de %(duration)s s{whiteSpanish_Close}.\n\n*Les dégâts infligés par la capacité Berserker ne peuvent pas détruire votre véhicule."

msgid "berserker/name"
msgstr "Berserker"

msgid "berserker/shortDescr"
msgstr "Multiplie la pénétration et la cadence de tir {green_Open}par %(gunPiercing)s{green_Close} tout en augmentant l'efficacité de la visée et la stabilisation du canon {green_Open}de %(gunAimingTime)s{green_Close}, mais retire {red_Open}%(healthDebuff)s{red_Close} du total de PS de votre véhicule sur sa durée {whiteSpanish_Open}de %(duration)s s{whiteSpanish_Close}.\n\n*Les dégâts infligés par la capacité Berserker ne peuvent pas détruire votre véhicule."

msgid "blackout_headlights_1/name"
msgstr "Atténuation des phares (Type 1)"

msgid "bomber/longDescr"
msgstr "Demande à un avion d'attaque au sol de larguer des bombes dans une zone sélectionnée, étourdissant et infligeant des dégâts aux véhicules ennemis. Les véhicules au centre de la zone d'impact subissent le plus de dégâts. Particulièrement efficace contre les véhicules faiblement et moyennement blindés."

msgid "bomber/name"
msgstr "Frappe aérienne"

msgid "bomber/shortDescr"
msgstr "Étourdit des véhicules ennemis et inflige des dégâts moyens dans un grand rayon."

msgid "brRegenerationKit/battleDescr"
msgstr "Rétablit progressivement %(healPerTickDuration)s des PS du véhicule en %(duration)s s. Peut être interrompue en subissant des dégâts."

msgid "brRegenerationKit/descr"
msgstr "Rétablit progressivement %(healPerTickDuration)s des PS du véhicule en %(duration)s s. Peut être interrompue en subissant des dégâts."

msgid "brRegenerationKit/long_special"
msgstr "{green_Open}Rétablit progressivement %(healPerTickDuration)s{green_Close} des PS du véhicule {whiteSpanish_Open}en %(duration)s s{whiteSpanish_Close}. Peut être interrompue en subissant des dégâts."

msgid "brRegenerationKit/name"
msgstr "Récupération"

msgid "brRegenerationKit/short_special"
msgstr "{green_Open}Rétablit progressivement %(healPerTickDuration)s{green_Close} des PS du véhicule {whiteSpanish_Open}en %(duration)s s{whiteSpanish_Close}. Peut être interrompue en subissant des dégâts."

msgid "brRepairkit/descr"
msgstr "Répare les éléments et retire les effets négatifs."

msgid "brRepairkit/long_special"
msgstr "Répare les éléments et retire les effets négatifs."

msgid "brRepairkit/name"
msgstr "Kit de réparation"

msgid "brRepairkit/short_special"
msgstr "Répare les éléments et retire les effets négatifs."

msgid "br_bomber/battleDescr"
msgstr "Étourdit et inflige entre %(minDamage)s et %(maxDamage)s PS de dégâts aux véhicules ennemis. Les véhicules situés au centre de la zone d'impact subissent des dégâts plus importants.\n\n*Il y a un délai de %(delay)s s avant l'impact."

msgid "br_bomber/descr"
msgstr "Étourdit et inflige entre %(minDamage)s et %(maxDamage)s PS de dégâts aux véhicules ennemis. Les véhicules situés au centre de la zone d'impact subissent des dégâts plus importants.\n\n*Il y a un délai de %(delay)s s avant l'impact."

msgid "br_bomber/longDescr"
msgstr "Étourdit et inflige entre {whiteSpanish_Open}%(minDamage)s et %(maxDamage)s PS de dégâts{whiteSpanish_Close} aux véhicules ennemis. Les véhicules situés au centre de la zone d'impact subissent des dégâts plus importants.\n\n*Il y a un délai de %(delay)s s avant l'impact."

