msgid "battle_matters_quests/battle_matters_1/conditions/description"
msgstr "Lancer une Bataille aléatoire à bord d'un véhicule de tout rang."

msgid "battle_matters_quests/battle_matters_1/description"
msgstr "Bienvenue dans le jeu ! Affrontez d'autres passionnés du monde entier et célébrez vos victoires spectaculaires !"

msgid "battle_matters_quests/battle_matters_1/name"
msgstr "Première bataille"

msgid "battle_matters_quests/battle_matters_10/conditions/description"
msgstr "Rechercher et acheter n'importe quel véhicule de rang IV."

msgid "battle_matters_quests/battle_matters_10/description"
msgstr "L'achat d'un véhicule est un grand moment. À chaque nouveau rang, les véhicules deviennent plus intéressants. Un équipage entraîné améliorera aussi le gameplay général."

msgid "battle_matters_quests/battle_matters_10/name"
msgstr "Véhicule de rang IV"

msgid "battle_matters_quests/battle_matters_11/conditions/description"
msgstr "Disputer trois Batailles aléatoires à bord de véhicules de rangs IV à X avec n'importe quel élément de personnalisation appliqué."

msgid "battle_matters_quests/battle_matters_11/description"
msgstr "Vous pouvez personnaliser les véhicules en plaçant des styles prédéfinis ou en créant le vôtre à partir de camouflages, d'inscriptions, d'emblèmes et de pochoirs."

msgid "battle_matters_quests/battle_matters_11/name"
msgstr "Apparence du véhicule"

msgid "battle_matters_quests/battle_matters_12/conditions/description"
msgstr "Commencer à maîtriser n'importe quelle aptitude avec n'importe quel membre d'équipage."

msgid "battle_matters_quests/battle_matters_12/description"
msgstr "Les membres d'équipage peuvent s'entraîner à des aptitudes supplémentaires pour améliorer leur efficacité ou acquérir de nouvelles capacités."

msgid "battle_matters_quests/battle_matters_12/name"
msgstr "Aptitudes de l'équipage"

msgid "battle_matters_quests/battle_matters_13/conditions/description"
msgstr "Gagner 150 000 crédits en Batailles aléatoires à bord de véhicules de rangs IV à X."

msgid "battle_matters_quests/battle_matters_13/description"
msgstr "Plus le niveau de la bataille est élevé, plus il vous faut de crédits pour entretenir votre véhicule, et acheter des obus, des éléments et de l'équipement."

msgid "battle_matters_quests/battle_matters_13/name"
msgstr "Accumuler des crédits"

msgid "battle_matters_quests/battle_matters_14/conditions/description"
msgstr "Rechercher et acheter n'importe quel véhicule de rang V."

msgid "battle_matters_quests/battle_matters_14/description"
msgstr "Au rang V, des véhicules plus sérieux apparaissent et votre talent est mis à l'épreuve. Un équipage entièrement entraîné devient vraiment utile."

msgid "battle_matters_quests/battle_matters_14/name"
msgstr "Véhicule de rang V"

msgid "battle_matters_quests/battle_matters_15/conditions/description"
msgstr "Disputer 10 Batailles aléatoires à bord de véhicules de rangs V à X avec trois pièces d'équipement installées."

msgid "battle_matters_quests/battle_matters_15/description"
msgstr "Optiques traitées ou Ventilation améliorée ? Le bon équipement peut renforcer les points forts de votre véhicule ou réduire ses points faibles."

msgid "battle_matters_quests/battle_matters_15/name"
msgstr "Installer de l'équipement"

msgid "battle_matters_quests/battle_matters_16/conditions/description"
msgstr "Terminer un scénario de base en mode Topographie."

msgid "battle_matters_quests/battle_matters_16/description"
msgstr "Pour se sentir à l'aise sur le champ de bataille, il faut connaître les accès, les tactiques et les cartes, dont les positions clés et objets présents."

msgid "battle_matters_quests/battle_matters_16/name"
msgstr "Topographie"

msgid "battle_matters_quests/battle_matters_17/conditions/description"
msgstr "Terminer quatre scénarios avancés sur une carte dans Topographie."

msgid "battle_matters_quests/battle_matters_17/description"
msgstr "Entrez en mode Topographie de temps en temps pour étudier les cartes des Batailles aléatoires. Les quatre scénarios permettent d'explorer les lieux autrement."

msgid "battle_matters_quests/battle_matters_17/name"
msgstr "Topographie avancée"

msgid "battle_matters_quests/battle_matters_18/conditions/description"
msgstr "Disputer 10 Batailles aléatoires à bord de véhicules de rangs V à X avec une Réserve personnelle active."

msgid "battle_matters_quests/battle_matters_18/description"
msgstr "Une fois activées, elles octroient des bonus à l'EXP. de bataille, l'EXP. libre et l'EXP. d'équipage ou aux crédits après chaque bataille."

msgid "battle_matters_quests/battle_matters_18/name"
msgstr "Réserves personnelles"

msgid "battle_matters_quests/battle_matters_19/conditions/description"
msgstr "Faire partie six fois des 10 meilleurs joueurs de votre équipe en termes d'EXP. gagnée lors de Batailles aléatoires remportées à bord de véhicules de rangs V à X."

msgid "battle_matters_quests/battle_matters_19/description"
msgstr "Ces missions permettent de gagner cinq fois plus d'EXP. en cas de victoire. Gagnez en figurant parmi les 10 meilleurs de votre équipe en termes d'EXP. gagnée."

msgid "battle_matters_quests/battle_matters_19/name"
msgstr "6 missions d'EXP. ×5"

msgid "battle_matters_quests/battle_matters_2/conditions/description"
msgstr "Rechercher un élément et l'installer sur un véhicule de n'importe quel rang."

msgid "battle_matters_quests/battle_matters_2/description"
msgstr "L'EXP. de bataille est décernée après chaque bataille. Gagnez de l'EXP. de bataille pour rechercher de nouveaux éléments améliorant l'efficacité du véhicule."

msgid "battle_matters_quests/battle_matters_2/name"
msgstr "EXP. de bataille"

msgid "battle_matters_quests/battle_matters_20/conditions/description"
msgstr "Rechercher et acheter n'importe quel véhicule de rang VI."

msgid "battle_matters_quests/battle_matters_20/description"
msgstr "La recherche de véhicules demandera de plus en plus de temps et d'efforts. L'EXP. libre aide à progresser plus vite, et un équipage entraîné est bien pratique."

msgid "battle_matters_quests/battle_matters_20/name"
msgstr "Véhicule de rang VI"

msgid "battle_matters_quests/battle_matters_21/conditions/description"
msgstr "Accomplir une mission personnelle de n'importe quelle campagne."

msgid "battle_matters_quests/battle_matters_21/description"
msgstr "Les campagnes sont des séries de missions pour différents types de véhicules. En les terminant, vous obtenez des récompenses utiles et des véhicules uniques."

msgid "battle_matters_quests/battle_matters_21/name"
msgstr "Missions personnelles"

msgid "battle_matters_quests/battle_matters_22/conditions/description"
msgstr "Entraîner un équipage avec un Manuel universel."

msgid "battle_matters_quests/battle_matters_22/description"
msgstr "Les Livres d'équipage vous permettent d'accélérer l'entraînement de l'équipage en donnant une certaine quantité d'EXP. à un ou tous les membres d'un équipage."

msgid "battle_matters_quests/battle_matters_22/name"
msgstr "Livres d'équipage"

msgid "battle_matters_quests/battle_matters_23/conditions/description"
msgstr "Disputer 10 Batailles aléatoires à bord de véhicules de rangs VI à X équipés d'une directive d'équipage."

msgid "battle_matters_quests/battle_matters_23/description"
msgstr "Les Directives peuvent améliorer les aptitudes pour une bataille. Comme les consommables, elles s'achètent ou s'obtiennent en récompense."

msgid "battle_matters_quests/battle_matters_23/name"
msgstr "Directives pour l'équipage"

msgid "battle_matters_quests/battle_matters_24/conditions/description"
msgstr "Acheter un lot Débutant spécial dans le Magasin en jeu."

msgid "battle_matters_quests/battle_matters_24/description"
msgstr "Vous pouvez acheter tout ce dont vous avez besoin dans le Magasin en jeu, y compris des pièces d'or, des véhicules premium et bien plus encore. Vous trouverez des promotions périodiques pour de belles affaires."

msgid "battle_matters_quests/battle_matters_24/name"
msgstr "Magasin"

msgid "battle_matters_quests/battle_matters_25/conditions/description"
msgstr "Disputer 10 Batailles aléatoires à bord de véhicules premium de rangs VI à X."

msgid "battle_matters_quests/battle_matters_25/description"
msgstr "Ces chars ne sont pas recherchables. Ils rapportent plus d'EXP. de bataille, d'EXP. d'équipage et de crédits, et on peut y transférer un équipage sans le réentraîner."

msgid "battle_matters_quests/battle_matters_25/name"
msgstr "Véhicules premium"

msgid "battle_matters_quests/battle_matters_26/conditions/description"
msgstr "Disputer 10 Batailles aléatoires à bord de véhicules de rangs VI à X dotés d'une Directive d'équipement."

msgid "battle_matters_quests/battle_matters_26/description"
msgstr "Les Directives permettent d'augmenter l'efficacité de l'équipement installé. Comme les consommables, elles peuvent être achetées ou reçues en récompense."

msgid "battle_matters_quests/battle_matters_26/name"
msgstr "Directives pour l'équipement"

msgid "battle_matters_quests/battle_matters_27/conditions/description"
msgstr "Faire partie 15 fois des 10 meilleurs joueurs de votre équipe en termes d'EXP. gagnée lors de Batailles aléatoires à bord de véhicules de rangs VI à X."

msgid "battle_matters_quests/battle_matters_27/description"
msgstr "Ces missions permettent de gagner cinq fois plus d'EXP. en cas de victoire. Gagnez en figurant parmi les 10 meilleurs de votre équipe en termes d'EXP. gagnée."

msgid "battle_matters_quests/battle_matters_27/name"
msgstr "15 missions d'EXP. ×5"

msgid "battle_matters_quests/battle_matters_28/conditions/description"
msgstr "Rechercher et acheter n'importe quel véhicule de rang VII."

msgid "battle_matters_quests/battle_matters_28/description"
msgstr "Les compétences nécessaires pour ce rang de véhicule augmentent encore. Vos chars deviennent meilleurs et plus efficaces, tout comme ceux de vos adversaires."

msgid "battle_matters_quests/battle_matters_28/name"
msgstr "Véhicule de rang VII"

msgid "battle_matters_quests/battle_matters_29/conditions/description"
msgstr "Disputer 10 Batailles aléatoires en véhicules de rangs VII à X équipés d'une Grande trousse de premiers secours, d'un Grand kit de réparation et d'un Extincteur automatique."

msgid "battle_matters_quests/battle_matters_29/description"
msgstr "Une fois équipés, les grands consommables réparent les éléments endommagés plus rapidement que les petits. Ils réduisent également la durée d'étourdissement et le risque de prendre feu, et possèdent un temps de rechargement plus court."

msgid "battle_matters_quests/battle_matters_29/name"
msgstr "Grands consommables"

msgid "battle_matters_quests/battle_matters_3/conditions/description"
msgstr "Recevoir le double d'EXP. lors de votre première victoire du jour en Batailles aléatoires à bord d'un véhicule de n'importe quel rang."

msgid "battle_matters_quests/battle_matters_3/description"
msgstr "Vous pouvez recevoir deux fois plus d'EXP. lors de votre première victoire du jour dans chaque véhicule. Utilisez cet avantage pour améliorer vos véhicules plus vite."

msgid "battle_matters_quests/battle_matters_3/name"
msgstr "Multiplicateur d'EXP."

msgid "battle_matters_quests/battle_matters_30/conditions/description"
msgstr "Créer un fragment de plan de n'importe quel véhicule non recherché."

msgid "battle_matters_quests/battle_matters_30/description"
msgstr "Les plans octroient une réduction d'EXP. pour accélérer la recherche d'un char. Ils s'obtiennent en récompense ou à partir de fragments universels et nationaux."

msgid "battle_matters_quests/battle_matters_30/name"
msgstr "Plans de véhicules"

msgid "battle_matters_quests/battle_matters_31/conditions/description"
msgstr "Faire partie 20 fois des 10 meilleurs joueurs de votre équipe en termes d'EXP. gagnée lors de Batailles aléatoires à bord de véhicules de rangs VII à X."

msgid "battle_matters_quests/battle_matters_31/description"
msgstr "Ces missions permettent de gagner cinq fois plus d'EXP. en cas de victoire. Gagnez en figurant parmi les 10 meilleurs de votre équipe en termes d'EXP. gagnée."

msgid "battle_matters_quests/battle_matters_31/name"
msgstr "20 missions d'EXP. ×5"

msgid "battle_matters_quests/battle_matters_32/conditions/description"
msgstr "Rechercher et acheter n'importe quel véhicule de rang VIII."

msgid "battle_matters_quests/battle_matters_32/description"
msgstr "Les véhicules de rang VIII vous demandent d'utiliser toutes les connaissances que vous avez acquises. Les ennemis ne vous laisseront aucun temps mort, les parties sont ardues."

msgid "battle_matters_quests/battle_matters_32/name"
msgstr "Véhicule de rang VIII"

msgid "battle_matters_quests/battle_matters_4/conditions/description"
msgstr "Utiliser de l'EXP. libre pour rechercher n'importe quel élément."

msgid "battle_matters_quests/battle_matters_4/description"
msgstr "Si vous n'avez pas assez d'EXP. de bataille pour rechercher un élément ou un véhicule, utilisez de l'EXP. libre qui s'obtient pour n'importe quel véhicule."

msgid "battle_matters_quests/battle_matters_4/name"
msgstr "EXP. libre"

msgid "battle_matters_quests/battle_matters_5/conditions/description"
msgstr "Charger des obus alternatifs et lancer une Bataille aléatoire à bord d'un véhicule de rangs III à X."

msgid "battle_matters_quests/battle_matters_5/description"
msgstr "Les obus perforants, explosifs et perforants rigides composites sont à utiliser dans différentes situations de combat. Choisissez le bon type pour prendre l'avantage !"

msgid "battle_matters_quests/battle_matters_5/name"
msgstr "Munitions"

msgid "battle_matters_quests/battle_matters_6/conditions/description"
msgstr "Vendre un élément inutilisé du Dépôt."

msgid "battle_matters_quests/battle_matters_6/description"
msgstr "Les éléments, obus, équipements, consommables et autres objets inutilisés sont stockés dans le Dépôt. Vous pouvez vendre les objets en trop contre des crédits."

msgid "battle_matters_quests/battle_matters_6/name"
msgstr "Dépôt"

msgid "battle_matters_quests/battle_matters_7/conditions/description"
msgstr "Gagner 25 000 crédits en Batailles aléatoires à bord de véhicules de rangs III à X."

msgid "battle_matters_quests/battle_matters_7/description"
msgstr "Les crédits servent à acheter des obus et des véhicules, à réparer des véhicules et plus encore. Apprenez comment les économiser et les utiliser au mieux."

msgid "battle_matters_quests/battle_matters_7/name"
msgstr "Crédits"

msgid "battle_matters_quests/battle_matters_8/conditions/description"
msgstr "Disputer trois Batailles aléatoires à bord de véhicules de rangs III à X avec des consommables placés dans tous les emplacements."

msgid "battle_matters_quests/battle_matters_8/description"
msgstr "Les consommables réparent un véhicule ou soignent des membres d'équipage en bataille. Utilisés au bon moment, ils permettent de survivre sur le champ de bataille."

msgid "battle_matters_quests/battle_matters_8/name"
msgstr "Consommables"

msgid "battle_matters_quests/battle_matters_9/conditions/description"
msgstr "Disputer trois Batailles aléatoires à bord de véhicules de rangs III à X doté de n'importe quelle pièce d'équipement."

msgid "battle_matters_quests/battle_matters_9/description"
msgstr "Les véhicules peuvent être pourvus de pièces d'équipement afin d'améliorer certaines caractéristiques. L'équipement à installer dépend du véhicule et du style de jeu."

msgid "battle_matters_quests/battle_matters_9/name"
msgstr "Équipement"

msgid "mt_battle_quests/MTBattleQuestsGroup/name"
msgstr "Topographie"

msgid "mt_battle_quests/mt_battle_quest_0/conditions/postBattle/description"
msgstr "Terminer un scénario sur n'importe quelle carte dans Topographie"

msgid "mt_battle_quests/mt_battle_quest_0/name"
msgstr "Terra Incognita"

msgid "mt_battle_quests/mt_battle_quest_1/conditions/postBattle/description"
msgstr "Terminer quatre scénarios de base sur une carte dans Topographie"

msgid "mt_battle_quests/mt_battle_quest_1/name"
msgstr "Reconnaissance"

msgid "mt_battle_quests/mt_battle_quest_2/conditions/postBattle/description"
msgstr "Terminer quatre scénarios avancés sur une carte dans Topographie"

msgid "mt_battle_quests/mt_battle_quest_2/name"
msgstr "Un A en géographie"
