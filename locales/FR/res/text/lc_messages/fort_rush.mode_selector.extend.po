msgid "mode/fort_rush_battle/condition"
msgstr "7v7 %(parSecondary_open)sI%(parSecondary_close)s rang&nbsp;X"

msgid "mode/fort_rush_battle/description"
msgstr "Prenez le contrôle des antennes. Défendez le réseau. Sécurisez la transmission."

msgid "mode/fort_rush_battle/performance/highRisk/description"
msgstr "Les performances de votre ordinateur sont insuffisantes pour ce mode. Vous risquez de subir des problèmes avec les graphismes et le déplacement du véhicule. Des plantages du client du jeu sont également probables."

msgid "mode/fort_rush_battle/performance/highRisk/header"
msgstr "Faibles performances"

msgid "mode/fort_rush_battle/performance/highRisk/headerIcon"
msgstr "%(icon) Faibles performances"

msgid "mode/fort_rush_battle/performance/mediumRisk/description"
msgstr "Ce mode nécessite des performances élevées de l'ordinateur. Vous allez subir des problèmes avec le chargement des cartes, les graphismes et le déplacement du véhicule. Si les performances ne sont pas suffisantes, essayez de diminuer la qualité graphique dans vos paramètres."

msgid "mode/fort_rush_battle/performance/mediumRisk/header"
msgstr "Performances réduites"

msgid "mode/fort_rush_battle/performance/mediumRisk/headerIcon"
msgstr "%(icon) Performances réduites"
