msgid "battleship/name"
msgstr "Signal de fumée"

msgid "battleship/shortDescr"
msgstr "Un signal de fumée qui marque une zone pour une salve d'artillerie de cuirassé, ce qui inflige des dégâts à l'équipement et aux objets ennemis situés ici."

msgid "distraction_ability/name"
msgstr "Faux ordre"

msgid "distraction_ability/shortDescr"
msgstr "Le Gefr. Keller utilise la radio allemande capturée pour transmettre un faux ordre, poussant ainsi les ennemis à enquêter sur un lieu en particulier."

msgid "recon_ability/name"
msgstr "Repérer les environs"

msgid "recon_ability/shortDescr"
msgstr "Envoie le Capt. Dubois en mission de reconnaissance à l'endroit indiqué. Lorsqu'il est en reconnaissance, le char s'arrête et reste immobile. Cette capacité reste en fonction jusqu'à ce qu'elle soit annulée."

msgid "scc_airstrike_ability/name"
msgstr "Soutien aérien"

msgid "scc_airstrike_ability/shortDescr"
msgstr "Appelle une frappe aérienne à la position indiquée."
