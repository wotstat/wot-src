msgid "Contact/status/inBattle/last_stand"
msgstr "En bataille Ultime combat"

msgid "advanced/ls_aoeDamageInstantShot"
msgstr "Un tir qui endommage la cible et tous les véhicules ennemis dans un rayon de 35 m."

msgid "advanced/ls_aoeDrainEnemyHpInstantShot"
msgstr "Un tir qui rétablit les points de structure en volant ceux de la cible et des véhicules ennemis à proximité dans un rayon de 35 m."

msgid "advanced/ls_aoeStunInstantShot"
msgstr "Un tir qui étourdit la cible et tous les véhicules ennemis dans un rayon de 35 m."

msgid "advanced/ls_damageShield"
msgstr "Protège de tous les dégâts (à l'exception des collisions, des immersions et des impacts) durant 10 secondes."

msgid "advanced/ls_doubleDamage"
msgstr "Votre prochain tir réussi inflige le double de dégâts."

msgid "advanced/ls_equipment"
msgstr "Les Dispositifs tactiques vous aident à combattre plus efficacement lors des batailles d'Ultime combat, à terminer les Phases et à gagner de précieuses récompenses. Cliquez sur l'un des emplacements de Dispositif tactique pour vous en équiper."

msgid "advanced/ls_extraDamageSituational"
msgstr "Donne la possibilité d'infliger des dégâts accrus à un véhicule ennemi."

msgid "advanced/ls_fastReload"
msgstr "Augmente la cadence de tir / recharge le barillet."

msgid "advanced/ls_healSituational"
msgstr "Rétablit des points de structure après avoir détruit un véhicule ennemi."

msgid "advanced/ls_invisibility"
msgstr "Empêche temporairement les ennemis de cibler votre véhicule, rétablit des points de structure, répare les éléments, éteint les incendies, retire l'effet d'étourdissement et soigne tous les membres d'équipage blessés."

msgid "advanced/ls_nitro"
msgstr "Augmente temporairement la mobilité de votre véhicule."

msgid "advanced/ls_nitroSituational"
msgstr "Augmente temporairement la mobilité de votre véhicule après avoir subi des dégâts de la part d'un véhicule ennemi."

msgid "advanced/ls_selfRepairKit"
msgstr "Rétablit les points de structure, éteint les incendies, retire les effets d'étourdissement et répare les éléments endommagés."

msgid "advanced/ls_teamRepairKit"
msgstr "Répare les éléments endommagés, éteint les incendies, retire les effets d'étourdissement et rétablit une partie des points de structure des véhicules alliés dans son rayon."

msgid "hangar/ammo_panel/ls_equipment/empty/body"
msgstr "Les Dispositifs tactiques peuvent être équipés dans des emplacements spéciaux pour vous aider à combattre plus efficacement lors des batailles d'Ultime combat, à terminer les Phases et à gagner de précieuses récompenses."

msgid "hangar/ammo_panel/ls_equipment/empty/header"
msgstr "Emplacements de Dispositif tactique"
