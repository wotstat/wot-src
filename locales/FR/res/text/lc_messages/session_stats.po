msgid "propertyInfo/prop/descr/averageDamage"
msgstr "Le rapport du total des dégâts infligés sur le nombre des batailles disputées au cours de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/averageFrags"
msgstr "Taux du nombre de véhicules ennemis détruits sur le nombre de batailles jouées."

msgid "propertyInfo/prop/descr/averageVehiclesLevel"
msgstr "Rang moyen des véhicules pilotés au cours de la session de jeu."

msgid "propertyInfo/prop/descr/averageXp"
msgstr "Le rapport d'expérience totale obtenue sur le nombre des batailles disputées au cours de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/blockedDamage"
msgstr "Le rapport du total des dégâts bloqués sur le nombre des batailles disputées au cours de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/helpDamage"
msgstr "Le taux de dégâts grâce à votre détection et les dégâts infligés par vos alliés grâce à votre destruction de chenilles et l'immobilisation des véhicules ennemis ou l'étourdissement sur le nombre total de batailles disputées en une session. Le delta indique l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/ratioDamage"
msgstr "Le rapport des paramètres « dégâts infligés » sur les « dégâts subis ». Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/ratioKill"
msgstr "Le rapport des véhicules ennemis détruits sur le nombre de fois où le véhicule du joueur a été détruit. Delta représente l'effet de session actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/spotted"
msgstr "Taux de véhicules ennemis repérés sur le nombre de batailles jouées au cours de la session."

msgid "propertyInfo/prop/descr/survivedRate"
msgstr "Pourcentage du total des batailles jouées lors desquelles le véhicule du joueur n'a pas été détruit."

msgid "propertyInfo/prop/descr/winRate"
msgstr "Pourcentage de victoires en Batailles aléatoires au cours de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/wins"
msgstr "Le nombre de victoires en batailles aléatoires au cours de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

msgid "propertyInfo/prop/descr/wtr"
msgstr "Le WTR par valeurs moyennes pour l'ensemble de la session. Delta représente l'effet de la session de jeu actuelle sur le paramètre total."

